---
// Work page for both languages: every case follows the same six-part structure.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import SystemsChain from '../components/SystemsChain.astro';
import ExternalLinks from '../components/ExternalLinks.astro';

interface Props { lang?: 'en' | 'ru' }
const { lang = 'en' } = Astro.props;

const cases = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const t = {
  en: {
    title: 'Selected Work',
    meta: 'Case studies in production LLM systems, local Text-to-SQL, multi-agent operations and AI transformation.',
    index: '02 / Work', eyebrow: 'Selected case studies', heading: 'Applied AI, in operating context.',
    intro: 'Each case follows the same path: operational problem, engineering decision, system, measurable effect. Details stay bounded to protect confidential work.',
    fields: ['Problem', 'Context', 'My role', 'Approach', 'Result', 'What I learned'],
    includes: 'Work included',
    diagram: ['User request', 'Coordinator agent', 'Supply agent', 'Transit agent', 'Export agent', 'Internal systems & tools', 'Proposed action → explicit confirmation'],
    diagramLabel: 'Multi-agent inventory architecture',
  },
  ru: {
    title: 'Работа',
    meta: 'Кейсы: production LLM-системы, локальный Text-to-SQL, мультиагентные операции и AI-трансформация.',
    index: '02 / Работа', eyebrow: 'Избранные кейсы', heading: 'Прикладной AI в рабочем контексте.',
    intro: 'Каждый кейс идёт по одной схеме: операционная задача, инженерное решение, система, измеримый эффект. Детали намеренно ограничены, чтобы не раскрывать конфиденциальную информацию.',
    fields: ['Задача', 'Контекст', 'Моя роль', 'Подход', 'Результат', 'Что я вынес'],
    includes: 'Что входило в работу',
    diagram: ['Запрос пользователя', 'Агент-координатор', 'Агент снабжения', 'Агент транзита', 'Агент экспорта', 'Внутренние системы и инструменты', 'Предложенное действие → явное подтверждение'],
    diagramLabel: 'Архитектура мультиагентной платформы управления запасами',
  },
}[lang];
const anchor = (id: string) => (id === 'multi-agent-inventory' ? 'multi-agent' : id);
---

<BaseLayout lang={lang} title={t.title} description={t.meta}>
  <PageIntro index={t.index} eyebrow={t.eyebrow} title={t.heading} description={t.intro} />
  <section class="case-list shell">
    {cases.map((item, index) => {
      const c = lang === 'ru' ? item.data.ru : item.data;
      const values = [c.problem, c.context, c.role, c.approach, c.result, c.lessons];
      return (
        <article class="case-study" id={anchor(item.id)}>
          <header class="case-heading">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <p class="eyebrow">{c.tags.slice(0, 3).join(' · ')}</p>
              <h2>{c.title}</h2>
              <p>{c.summary}</p>
              {c.metrics.length > 0 && (
                <dl class="case-metrics">{c.metrics.map((m) => <div><dt>{m.value}</dt><dd>{m.label}</dd></div>)}</dl>
              )}
              {item.data.links.length > 0 && <p class="case-links"><ExternalLinks links={item.data.links} lang={lang} long /></p>}
            </div>
          </header>
          <dl class="case-details">
            {t.fields.map((field, i) => <div><dt>{field}</dt><dd>{values[i]}</dd></div>)}
          </dl>
          {c.includes.length > 0 && (
            <div class="case-includes"><p class="eyebrow">{t.includes}</p><ul class="tag-list">{c.includes.map((x) => <li>{x}</li>)}</ul></div>
          )}
          {item.id === 'multi-agent-inventory' && (
            <div class="agent-diagram" aria-label={t.diagramLabel}>
              <div class="diagram-node wide">{t.diagram[0]}</div><span>↓</span>
              <div class="diagram-node coordinator">{t.diagram[1]}</div><span>↓</span>
              <div class="agent-row"><div class="diagram-node">{t.diagram[2]}</div><div class="diagram-node">{t.diagram[3]}</div><div class="diagram-node">{t.diagram[4]}</div></div>
              <span>↓</span><div class="diagram-node wide">{t.diagram[5]}</div><span>↓</span>
              <div class="diagram-node wide">{t.diagram[6]}</div>
            </div>
          )}
          {item.id === 'ai-transformation' && (
            <div class="case-chain"><SystemsChain lang={lang} /></div>
          )}
        </article>
      );
    })}
  </section>
</BaseLayout>
