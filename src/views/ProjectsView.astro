---
// Projects page for both languages, grouped into research, engineering and notes.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ExternalLinks from '../components/ExternalLinks.astro';

interface Props { lang?: 'en' | 'ru' }
const { lang = 'en' } = Astro.props;
const p = lang === 'ru' ? '/ru' : '';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const t = {
  en: {
    title: 'Projects',
    meta: 'Research, publications, engineering projects and technical notes by Fedor Pakhurov.',
    index: '03 / Projects', eyebrow: 'Research & experiments', heading: 'Projects outside the org chart.',
    intro: 'Research, engineering experiments and technical education. Employment work lives separately in case studies.',
    outcome: 'Outcome',
    status: { completed: 'completed', active: 'active', ongoing: 'ongoing' },
    groups: [
      { id: 'research', category: 'research', index: 'Research & publications', title: 'Questions taken to a tested answer.', text: 'Papers, theses and articles. Links appear only where the material is public.' },
      { id: 'engineering', category: 'engineering', index: 'Engineering & infrastructure', title: 'Systems work beyond the model.', text: 'Streaming pipelines, containers and cluster scheduling.' },
      { id: 'notes', category: 'notes', index: 'Notes & teaching', title: 'Course notes with permanent URLs.', text: 'Collections written for the courses taught at the HSE Faculty of Computer Science.' },
    ],
  },
  ru: {
    title: 'Проекты',
    meta: 'Исследования, публикации, инженерные проекты и технические конспекты Фёдора Пахурова.',
    index: '03 / Проекты', eyebrow: 'Исследования и эксперименты', heading: 'Проекты вне оргструктуры.',
    intro: 'Исследования, инженерные эксперименты и техническое образование. Рабочие проекты описаны отдельно, в кейсах.',
    outcome: 'Итог',
    status: { completed: 'завершён', active: 'в работе', ongoing: 'пополняется' },
    groups: [
      { id: 'research', category: 'research', index: 'Исследования и публикации', title: 'Вопросы, доведённые до проверенного ответа.', text: 'Статьи, выпускные работы и публикации. Ссылки есть только там, где материалы публичны.' },
      { id: 'engineering', category: 'engineering', index: 'Инженерия и инфраструктура', title: 'Системная работа за пределами модели.', text: 'Потоковые конвейеры, контейнеры и планировщики кластеров.' },
      { id: 'notes', category: 'notes', index: 'Конспекты и преподавание', title: 'Конспекты курсов с постоянными адресами.', text: 'Коллекции для курсов, которые читаются на ФКН ВШЭ. Доступны на английском.' },
    ],
  },
}[lang];
let number = 0;
---

<BaseLayout lang={lang} title={t.title} description={t.meta}>
  <PageIntro index={t.index} eyebrow={t.eyebrow} title={t.heading} description={t.intro} />
  {t.groups.map((group) => (
    <section class="project-group shell" id={group.id} aria-labelledby={`${group.id}-heading`}>
      <div class="section-head">
        <p class="section-index">{group.index}</p>
        <h2 id={`${group.id}-heading`}>{group.title}</h2>
        <p>{group.text}</p>
      </div>
      <div class="project-list">
        {projects.filter((item) => item.data.category === group.category).map((item) => {
          const d = item.data;
          const c = lang === 'ru' ? d.ru : d;
          // Notes collections are English-only, so their internal links stay unprefixed.
          const path = d.path && (d.path.startsWith('/notes') ? d.path : `${p}${d.path}`);
          number += 1;
          return (
            <article class="project-row" id={item.id}>
              <p class="project-number">{String(number).padStart(2, '0')}</p>
              <div class="project-main">
                <p class="eyebrow">{c.label ?? t.status[d.status]} / {d.year}</p>
                <h3>{c.title}</h3>
                <p>{c.description}</p>
                {c.highlights.length > 0 && <ul class="project-highlights">{c.highlights.map((h) => <li>{h}</li>)}</ul>}
                {c.outcome && <p class="project-outcome"><strong>{t.outcome}</strong> {c.outcome}</p>}
              </div>
              <ul class="tag-list">{c.tags.map((tag) => <li>{tag}</li>)}</ul>
              <div class="project-links">
                <ExternalLinks links={d.links} lang={lang} />
                {d.github && <a href={d.github}>GitHub ↗</a>}
                {d.demo && <a href={d.demo}>Demo ↗</a>}
                {path && <a href={path} hreflang={lang === 'ru' && path.startsWith('/notes') ? 'en' : undefined}>{c.pathLabel}</a>}
              </div>
            </article>
          );
        })}
      </div>
    </section>
  ))}
</BaseLayout>
