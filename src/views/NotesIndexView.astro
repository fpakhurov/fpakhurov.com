---
import { getCollection } from 'astro:content';
import PageIntro from '../components/PageIntro.astro';
import { courseNumber, courses, learningOrder, type CourseKey } from '../utils/courses';
import { dataTrackOrder } from '../utils/dataEngineering';

interface Props { lang?: 'en' | 'ru' }
const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const prefix = ru ? '/ru/notes' : '/notes';

const notes = await getCollection('notes', ({ data }) => data.status === 'published');
const keys = learningOrder;
const count = (key: CourseKey) => notes.filter((note) => note.data.course === key).length;

// Layer of a course = length of the longest chain of prerequisites before it.
const depth = new Map<CourseKey, number>();
const layerOf = (key: CourseKey, seen: CourseKey[] = []): number => {
  if (depth.has(key)) return depth.get(key)!;
  if (seen.includes(key)) throw new Error(`Course prerequisites form a cycle: ${[...seen, key].join(' → ')}`);
  const d = courses[key].requires.length ? 1 + Math.max(...courses[key].requires.map((r) => layerOf(r, [...seen, key]))) : 0;
  depth.set(key, d);
  return d;
};
keys.forEach((key) => layerOf(key));
const layers: CourseKey[][] = [];
for (const key of keys) (layers[depth.get(key)!] ??= []).push(key);
const ordered = layers.flat();

const plural = (n: number) => {
  if (!ru) return `${n} ${n === 1 ? 'note' : 'notes'}`;
  const m10 = n % 10, m100 = n % 100;
  const word = m10 === 1 && m100 !== 11 ? 'заметка' : m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14) ? 'заметки' : 'заметок';
  return `${n} ${word}`;
};
const title = (key: CourseKey) => (ru ? courses[key].ru.title : courses[key].title);
const status = (key: CourseKey) => (count(key) ? plural(count(key)) : ru ? 'готовится' : 'in preparation');
const index = courseNumber;

// Graph geometry: the courses sit on a diamond. Wide, it runs left to right (Probability, then ML
// above Generative Models, then NLP); narrow, top to bottom (Probability, then ML beside Generative
// Models, then NLP). Every course needs a cell; edges leave and enter cards on the sides facing each other.
type Box = { x: number; y: number; w: number; h: number; lines: string[] };
const place: Record<CourseKey, { wide: [number, number]; narrow: [number, number] }> = {
  math: { wide: [0, 0], narrow: [0, 0] },
  probability: { wide: [0, 1], narrow: [2, 0] },
  python: { wide: [0, 2], narrow: [0, 1] },
  ml: { wide: [1, 1], narrow: [2, 1] },
  'bayesian-methods': { wide: [2, 0], narrow: [0, 2] },
  'deep-learning': { wide: [2, 2], narrow: [2, 2] },
  'generative-models': { wide: [3, 1], narrow: [0, 3] },
  nlp: { wide: [3, 2], narrow: [2, 3] },
  agents: { wide: [3, 3], narrow: [2, 4] },
  // A course with no prerequisite among the others sits apart, under the first column.
  acos: { wide: [0, 3], narrow: [0, 4] },
  devops: { wide: [1, 3], narrow: [0, 5] },
  mlops: { wide: [2, 3], narrow: [2, 5] },
  sql: { wide: [1, 4], narrow: [0, 6] },
  databases: { wide: [2, 4], narrow: [2, 6] },
  'big-data': { wide: [3, 4], narrow: [2, 7] },
};
for (const key of keys) if (!place[key]) throw new Error(`Course ${key} has no place on the /notes graph`);
// A narrow edge that skips rows runs down the lane between the side columns, so no row it passes may hold a centre card.
for (const key of keys) for (const from of courses[key].requires) {
  const [r0, r1] = [place[from].narrow[1], place[key].narrow[1]];
  for (const other of keys) if (place[other].narrow[0] === 1 && place[other].narrow[1] > r0 && place[other].narrow[1] < r1) throw new Error(`Edge ${from} → ${key} would cross ${other} in the narrow /notes graph`);
}
// In the narrow layout the centre card is wide, so a row holds either one centre card or side cards only.
for (const a of keys) for (const b of keys) if (a < b && place[a].narrow[1] === place[b].narrow[1] && (place[a].narrow[0] === 1 || place[b].narrow[0] === 1 || place[a].narrow[0] === place[b].narrow[0])) throw new Error(`Courses ${a} and ${b} overlap in the narrow /notes graph`);
// Titles wrap onto as many lines as they need to fit the card (an estimate of the glyph width).
const wrap = (text: string, maxChars: number) => {
  const lines: string[] = [];
  for (const word of text.split(' ')) {
    const last = lines[lines.length - 1];
    if (last !== undefined && `${last} ${word}`.length <= maxChars) lines[lines.length - 1] = `${last} ${word}`;
    else lines.push(word);
  }
  return lines;
};
// The number of columns comes from the places; a title wider than its card wraps onto a second line.
const cols = Math.max(...keys.map((key) => place[key].wide[0])) + 1;
const W = { w: 0, cardW: 270, colGap: 64, rowUnit: 66, cardH: 92, pad: 12, lineH: 22 };
W.w = 2 * W.pad + cols * W.cardW + (cols - 1) * W.colGap;
const wideBox = new Map<CourseKey, Box>();
// Rows are half a card apart so that neighbouring columns interleave; a card that would overlap the
// card above it in its own column moves down below it instead.
const colBottom = new Map<number, number>();
[...keys].sort((a, b) => place[a].wide[1] - place[b].wide[1]).forEach((key) => {
  const [c, r] = place[key].wide;
  const lines = wrap(title(key), Math.floor((W.cardW - 36) / 9.6));
  const h = W.cardH + (lines.length - 1) * W.lineH;
  const y = Math.max(W.pad + r * W.rowUnit, (colBottom.get(c) ?? -Infinity) + W.colGap / 2);
  colBottom.set(c, y + h);
  wideBox.set(key, { x: W.pad + c * (W.cardW + W.colGap), y, w: W.cardW, h, lines });
});
const wideH = Math.max(...[...wideBox.values()].map((b) => b.y + b.h)) + W.pad;
const N = { w: 360, side: 160, center: 224, gapX: 24, gapY: 46, pad: 8, lineH: 19 };
const narrowBox = new Map<CourseKey, Box>();
const rowHeight = (lines: number) => 80 + (lines - 1) * N.lineH;
const narrowRows: CourseKey[][] = Array.from({ length: Math.max(...keys.map((key) => place[key].narrow[1])) + 1 }, () => []);
keys.forEach((key) => narrowRows[place[key].narrow[1]].push(key));
let rowY = N.pad;
narrowRows.forEach((row) => {
  const boxes = row.map((key) => {
    const c = place[key].narrow[0];
    const w = c === 1 ? N.center : N.side;
    const x = c === 0 ? N.pad : c === 2 ? N.w - N.pad - N.side : (N.w - N.center) / 2;
    return { key, x, w, lines: wrap(title(key), Math.floor((w - 26) / 8.6)) };
  });
  const h = Math.max(...boxes.map((b) => rowHeight(b.lines.length)));
  boxes.forEach((b) => narrowBox.set(b.key, { x: b.x, y: rowY, w: b.w, h, lines: b.lines }));
  rowY += h + N.gapY;
});
const narrowH = rowY - N.gapY + N.pad;
const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
// An edge between cards in one row runs side to side; otherwise it runs along the main direction.
function edgePath(a: Box, b: Box, vertical: boolean) {
  const sameRow = Math.abs(a.y - b.y) < 1, sameCol = Math.abs(a.x - b.x) < 1;
  // Narrow: an edge that skips rows would cross the cards between, so it runs down the free lane
  // between the two side columns and turns into the target at the end.
  if (vertical && b.y - (a.y + a.h) > N.gapY + 1) {
    const lane = N.w / 2 + (b.x + b.w / 2 > N.w / 2 ? 6 : -6);
    const x1 = clamp(lane, a.x + 34, a.x + a.w - 34), x2 = clamp(lane, b.x + 34, b.x + b.w - 34);
    const y1 = a.y + a.h, y2 = b.y - 4;
    return `M ${x1} ${y1} C ${x1} ${y1 + 16}, ${lane} ${y1 + 8}, ${lane} ${y1 + 26} L ${lane} ${y2 - 26} C ${lane} ${y2 - 8}, ${x2} ${y2 - 16}, ${x2} ${y2}`;
  }
  if ((vertical && !sameRow) || (!vertical && sameCol)) {
    const x1 = clamp(b.x + b.w / 2, a.x + 34, a.x + a.w - 34), x2 = clamp(a.x + a.w / 2, b.x + 34, b.x + b.w - 34);
    const y1 = a.y + a.h, y2 = b.y - 4, my = (y1 + y2) / 2;
    return `M ${x1} ${y1} C ${x1} ${my}, ${x2} ${my}, ${x2} ${y2}`;
  }
  const y1 = clamp(b.y + b.h / 2, a.y + 22, a.y + a.h - 22), y2 = clamp(a.y + a.h / 2, b.y + 22, b.y + b.h - 22);
  const x1 = a.x + a.w, x2 = b.x - 4, mx = (x1 + x2) / 2;
  return `M ${x1} ${y1} C ${mx} ${y1}, ${mx} ${y2}, ${x2} ${y2}`;
}
const edges = keys.flatMap((key) => courses[key].requires.map((from) => ({ from, to: key })));
// The roles add reading recommendations to the prerequisite graph.
const prerequisiteRoute = (key: CourseKey): CourseKey[] => [key, ...courses[key].requires.flatMap(prerequisiteRoute)];
const roles = [
  { id: 'all', label: ru ? 'Все курсы' : 'All courses', core: new Set<CourseKey>(), extra: [] },
  { id: 'data', label: 'Data Engineer', core: new Set<CourseKey>(dataTrackOrder), extra: [] },
  { id: 'mlops', label: 'MLOps Engineer', core: new Set(prerequisiteRoute('mlops')), extra: ['sql', 'big-data'] },
  { id: 'nlp', label: 'NLP Engineer', core: new Set(prerequisiteRoute('nlp')), extra: ['agents', 'mlops'] },
];
const coreRoles = (key: CourseKey) => roles.filter((role) => role.core.has(key)).map((role) => role.id).join(' ');
const extraRoles = (key: CourseKey) => roles.filter((role) => role.extra.includes(key)).map((role) => role.id).join(' ');
const edgeRoles = (from: CourseKey, to: CourseKey) => roles.filter((role) => role.core.has(from) && role.core.has(to)).map((role) => role.id).join(' ');
const dataRoute = dataTrackOrder.map((key) => ru ? courses[key].ru.shortTitle : courses[key].shortTitle).join(' → ');
const prerequisiteDescription = edges.map(({ from, to }) => `${title(from)} → ${title(to)}`).join('. ');
const t = ru
  ? { index: '04 / Конспекты', eyebrow: 'Технические знания', heading: 'Курсы и порядок их прохождения.', intro: 'Курсы связаны пререквизитами: стрелка ведёт от курса, который стоит пройти раньше. Для теории вероятностей нужны школьная алгебра, производные и интегралы и немного линейной алгебры; на странице каждого курса сказано, что нужно знать до него. Внутри курса заметки идут по одной линии вопросов: заметка либо исправляет ограничение предыдущей, либо открывает ответвление с новой задачей или целью, и говорит, что именно.', graph: 'Граф курсов', requires: 'Сначала', none: 'Можно начинать отсюда', open: 'Открыть курс →' }
  : { index: '04 / Notes', eyebrow: 'Technical knowledge', heading: 'Courses, and the order to take them in.', intro: 'The courses are linked by prerequisites: an arrow leads from the course to take first. Probability Theory assumes school algebra, derivatives and integrals, and some matrix algebra; each course page says what to know before it. Inside a course the notes follow one line of questions: a note either fixes a limitation of the one before or opens a branch with a new task or objective, and says which.', graph: 'Graph of the courses', requires: 'Take first', none: 'A starting point', open: 'Open the course →' };
---

<PageIntro index={t.index} eyebrow={t.eyebrow} title={t.heading} description={t.intro} />
<section class="course-graph shell" aria-label={t.graph} data-role="all">
  <fieldset class="graph-role-switch" data-role-switch hidden>
    <legend>{ru ? 'Маршрут на графе' : 'Route on the graph'}</legend>
    <div class="graph-role-options">
      {roles.map(({ id, label }) => (
        <label class="graph-role-option">
          <input type="radio" name="course-role" value={id} checked={id === 'all'} />
          <span>{label}</span>
        </label>
      ))}
    </div>
  </fieldset>
  <div class="graph-role-details" aria-live="polite" aria-atomic="true" data-role-details hidden>
    <div data-role-summary="all">
      <p>{ru ? 'Выберите роль, чтобы подсветить маршрут на графе.' : 'Choose a role to highlight its route on the graph.'}</p>
    </div>
    <div data-role-summary="data" hidden>
      <p><span class="graph-role-key" aria-hidden="true"></span>{dataRoute}</p>
    </div>
    <div data-role-summary="mlops" hidden>
      <p><span class="graph-role-key" aria-hidden="true"></span>{ru ? 'Две ветки сходятся в MLOps. Python, математика и теория вероятностей ведут через ML к глубокому обучению. Архитектура и ОС вместе с Python ведут к DevOps.' : 'Two branches meet in MLOps. Python, mathematics and probability lead through ML to deep learning. Computer architecture and operating systems, together with Python, lead to DevOps.'}</p>
      <p><span class="graph-role-key graph-role-key-extra" aria-hidden="true"></span>{ru ? 'Дополнительно для работы с данными' : 'Optional for data pipelines'} · <a href={`${prefix}/sql`}>SQL</a>, <a href={`${prefix}/big-data`}>{title('big-data')}</a></p>
    </div>
    <div data-role-summary="nlp" hidden>
      <p><span class="graph-role-key" aria-hidden="true"></span>{ru ? 'Python, математика и теория вероятностей → ML → Глубокое обучение → NLP' : 'Python, mathematics and probability → ML → Deep learning → NLP'}</p>
      <p><span class="graph-role-key graph-role-key-extra" aria-hidden="true"></span>{ru ? 'Дополнительные ветки' : 'Optional branches'} · <a href={`${prefix}/agents`}>{title('agents')}</a>, <a href={`${prefix}/mlops/llm-inference-systems`}>{ru ? 'инференс LLM' : 'LLM inference'}</a>, <a href={`${prefix}/mlops/llmops`}>LLMOps</a></p>
    </div>
  </div>
  <svg class="graph-wide" viewBox={`0 0 ${W.w} ${wideH}`} role="group" aria-labelledby="course-graph-w-t" aria-describedby="course-graph-w-d">
    <title id="course-graph-w-t">{t.graph}</title>
    <desc id="course-graph-w-d">{prerequisiteDescription}</desc>
    {edges.map(({ from, to }) => <path class="graph-edge" data-core-roles={edgeRoles(from, to)} d={edgePath(wideBox.get(from)!, wideBox.get(to)!, false)} marker-end="url(#graph-arrow)" />)}
    {keys.map((key) => {
      const { x, y, w, h, lines } = wideBox.get(key)!;
      return (
        <a href={`${prefix}/${key}`} aria-label={`${title(key)} · ${status(key)}`} class:list={['graph-node', { planned: !count(key) }]} data-core-roles={coreRoles(key)} data-extra-roles={extraRoles(key)}>
          <rect x={x} y={y} width={w} height={h} rx="14" />
          <text class="graph-index" x={x + 18} y={y + 28}>{index(key)}</text>
          {lines.map((line, i) => <text class="graph-title" x={x + 18} y={y + 56 + i * W.lineH}>{line}</text>)}
          <text class="graph-status" x={x + 18} y={y + 78 + (lines.length - 1) * W.lineH}>{status(key)}</text>
        </a>
      );
    })}
    <defs>
      <marker id="graph-arrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="10" markerHeight="10" markerUnits="userSpaceOnUse" orient="auto"><path d="M 0 0.8 L 9.5 5 L 0 9.2 L 2.6 5 Z" /></marker>
      <marker id="graph-arrow-role" class="graph-arrow-role" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="10" markerHeight="10" markerUnits="userSpaceOnUse" orient="auto"><path d="M 0 0.8 L 9.5 5 L 0 9.2 L 2.6 5 Z" /></marker>
    </defs>
  </svg>
  <svg class="graph-narrow" viewBox={`0 0 ${N.w} ${narrowH}`} role="group" aria-labelledby="course-graph-n-t" aria-describedby="course-graph-n-d">
    <title id="course-graph-n-t">{t.graph}</title>
    <desc id="course-graph-n-d">{prerequisiteDescription}</desc>
    {edges.map(({ from, to }) => <path class="graph-edge" data-core-roles={edgeRoles(from, to)} d={edgePath(narrowBox.get(from)!, narrowBox.get(to)!, true)} marker-end="url(#graph-arrow-n)" />)}
    {ordered.map((key) => {
      const { x, y, w, h, lines } = narrowBox.get(key)!;
      return (
        <a href={`${prefix}/${key}`} aria-label={`${title(key)} · ${status(key)}`} class:list={['graph-node', { planned: !count(key) }]} data-core-roles={coreRoles(key)} data-extra-roles={extraRoles(key)}>
          <rect x={x} y={y} width={w} height={h} rx="12" />
          <text class="graph-index" x={x + 13} y={y + 25}>{index(key)}</text>
          {lines.map((line, i) => <text class="graph-title graph-title-n" x={x + 13} y={y + 47 + i * N.lineH}>{line}</text>)}
          <text class="graph-status" x={x + 13} y={y + 47 + (lines.length - 1) * N.lineH + 21}>{status(key)}</text>
        </a>
      );
    })}
    <defs>
      <marker id="graph-arrow-n" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto"><path d="M 0 0.8 L 9.5 5 L 0 9.2 L 2.6 5 Z" /></marker>
      <marker id="graph-arrow-role-n" class="graph-arrow-role" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto"><path d="M 0 0.8 L 9.5 5 L 0 9.2 L 2.6 5 Z" /></marker>
    </defs>
  </svg>
</section>
<section class="notes-index shell">
  {ordered.map((key) => {
    const config = courses[key];
    const stages = ru ? config.ru.progression ?? config.progression.map((s) => s.label) : config.progression.map((s) => s.label);
    return (
      <a class={count(key) ? 'collection-card' : 'collection-card planned'} href={`${prefix}/${key}`}>
        <div class="collection-meta"><span>{ru ? 'Курс' : 'Course'} / {index(key)}</span><span>{status(key)}</span></div>
        <h2>{title(key)}</h2>
        <p>{ru ? config.ru.description : config.description}</p>
        <p class="collection-stages">{stages.join(' → ')}</p>
        <p class="collection-requires">{config.requires.length ? `${t.requires}: ${config.requires.map(title).join(', ')}` : t.none}</p>
        <span class="collection-action">{t.open}</span>
      </a>
    );
  })}
</section>

<script>
  const graph = document.querySelector<HTMLElement>('.course-graph');
  const controls = graph?.querySelector<HTMLFieldSetElement>('[data-role-switch]');
  const details = graph?.querySelector<HTMLElement>('[data-role-details]');

  if (graph && controls && details) {
    const summaries = details.querySelectorAll<HTMLElement>('[data-role-summary]');
    const nodes = graph.querySelectorAll<SVGAElement>('.graph-node');
    const diagrams = graph.querySelectorAll<SVGSVGElement>('.graph-wide, .graph-narrow');

    const updateRole = () => {
      const role = controls.querySelector<HTMLInputElement>('input:checked')?.value ?? 'all';
      graph.dataset.role = role;
      for (const summary of summaries) summary.hidden = summary.dataset.roleSummary !== role;
      for (const node of nodes) {
        node.classList.toggle('graph-core', node.dataset.coreRoles?.split(' ').includes(role) ?? false);
        node.classList.toggle('graph-extra', node.dataset.extraRoles?.split(' ').includes(role) ?? false);
      }
      for (const diagram of diagrams) {
        const normalArrow = diagram.querySelector('marker')?.id;
        const roleArrow = diagram.querySelector('marker.graph-arrow-role')?.id;
        for (const edge of diagram.querySelectorAll<SVGPathElement>('.graph-edge')) {
          const highlighted = edge.dataset.coreRoles?.split(' ').includes(role) ?? false;
          edge.classList.toggle('graph-core', highlighted);
          edge.setAttribute('marker-end', `url(#${highlighted ? roleArrow : normalArrow})`);
        }
      }
    };

    updateRole();
    controls.hidden = false;
    details.hidden = false;
    controls.addEventListener('change', updateRole);
    window.addEventListener('pageshow', updateRole);
  }
</script>
