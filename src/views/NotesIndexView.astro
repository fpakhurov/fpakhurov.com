---
import { getCollection } from 'astro:content';
import PageIntro from '../components/PageIntro.astro';
import { courses, type CourseKey } from '../utils/courses';

interface Props { lang?: 'en' | 'ru' }
const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const prefix = ru ? '/ru/notes' : '/notes';

const notes = await getCollection('notes', ({ data }) => data.status === 'published');
const keys = Object.keys(courses) as CourseKey[];
const count = (key: CourseKey) => notes.filter((note) => note.data.course === key).length;

// Layer of a course = length of the longest chain of prerequisites before it.
const depth = new Map<CourseKey, number>();
const layerOf = (key: CourseKey, seen: CourseKey[] = []): number => {
  if (depth.has(key)) return depth.get(key)!;
  if (seen.includes(key)) throw new Error(`Course prerequisites form a cycle: ${[...seen, key].join(' → ')}`);
  const d = courses[key].requires.length ? 1 + Math.max(...courses[key].requires.map((r) => layerOf(r, [...seen, key]))) : 0;
  depth.set(key, d);
  return d;
};
keys.forEach((key) => layerOf(key));
const layers: CourseKey[][] = [];
for (const key of keys) (layers[depth.get(key)!] ??= []).push(key);
const ordered = layers.flat();

const plural = (n: number) => {
  if (!ru) return `${n} ${n === 1 ? 'note' : 'notes'}`;
  const m10 = n % 10, m100 = n % 100;
  const word = m10 === 1 && m100 !== 11 ? 'заметка' : m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14) ? 'заметки' : 'заметок';
  return `${n} ${word}`;
};
const title = (key: CourseKey) => (ru ? courses[key].ru.title : courses[key].title);
const status = (key: CourseKey) => (count(key) ? plural(count(key)) : ru ? 'готовится' : 'in preparation');
const index = (key: CourseKey) => String(keys.indexOf(key) + 1).padStart(2, '0');

// Graph geometry. Wide: layers are columns, left to right. Narrow: layers are rows, top to bottom.
const W = { cardW: 318, cardH: 92, colGap: 78, rowGap: 28, pad: 12, lane: 34 };
const wideW = 2 * W.pad + layers.length * W.cardW + (layers.length - 1) * W.colGap;
// The top lane carries edges that skip a layer, above the cards.
const wideH = Math.max(...layers.map((l) => l.length)) * (W.cardH + W.rowGap) - W.rowGap + 2 * W.pad + W.lane;
const widePos = new Map<CourseKey, { x: number; y: number }>();
layers.forEach((layer, li) => {
  const total = layer.length * (W.cardH + W.rowGap) - W.rowGap;
  layer.forEach((key, i) => widePos.set(key, { x: W.pad + li * (W.cardW + W.colGap), y: W.lane + (wideH - W.lane - total) / 2 + i * (W.cardH + W.rowGap) }));
});
const N = { w: 360, cardW: 300, cardH: 76, rowGap: 34, pad: 8 };
const narrowPos = new Map<CourseKey, { x: number; y: number }>();
ordered.forEach((key, i) => narrowPos.set(key, { x: 48, y: N.pad + i * (N.cardH + N.rowGap) }));
const narrowH = ordered.length * (N.cardH + N.rowGap) - N.rowGap + 2 * N.pad;
const edges = keys.flatMap((key) => courses[key].requires.map((from) => ({ from, to: key })));
const t = ru
  ? { index: '04 / Конспекты', eyebrow: 'Технические знания', heading: 'Курсы и порядок их прохождения.', intro: 'Курсы связаны пререквизитами: стрелка ведёт от курса, который стоит пройти раньше. Внутри каждого курса заметки идут по одной линии, где каждый метод отвечает на провал предыдущего.', graph: 'Граф курсов', requires: 'Сначала', none: 'Можно начинать отсюда', open: 'Открыть курс →' }
  : { index: '04 / Notes', eyebrow: 'Technical knowledge', heading: 'Courses, and the order to take them in.', intro: 'The courses are linked by prerequisites: an arrow leads from the course to take first. Inside each course the notes follow one line, each method answering the failure of the previous one.', graph: 'Graph of the courses', requires: 'Take first', none: 'A starting point', open: 'Open the course →' };
---

<PageIntro index={t.index} eyebrow={t.eyebrow} title={t.heading} description={t.intro} />
<section class="course-graph shell" aria-label={t.graph}>
  <svg class="graph-wide" viewBox={`0 0 ${wideW} ${wideH}`} role="img" aria-labelledby="course-graph-w-t">
    <title id="course-graph-w-t">{t.graph}: {edges.map((e) => `${title(e.from)} → ${title(e.to)}`).join('; ')}</title>
    {edges.map(({ from, to }) => {
      const a = widePos.get(from)!, b = widePos.get(to)!;
      const x1 = a.x + W.cardW, y1 = a.y + W.cardH / 2, x2 = b.x - 4, y2 = b.y + W.cardH / 2;
      const span = depth.get(to)! - depth.get(from)!;
      if (span > 1) {
        // Skip the layers in between along the top lane.
        const top = W.pad + 6, g = W.colGap / 2;
        return <path class="graph-edge" d={`M ${x1} ${y1} C ${x1 + g} ${y1}, ${x1 + g} ${top}, ${x1 + g + 16} ${top} H ${x2 - g - 16} C ${x2 - g} ${top}, ${x2 - g} ${y2}, ${x2} ${y2}`} marker-end="url(#graph-arrow)" />;
      }
      const mx = (x1 + x2) / 2;
      return <path class="graph-edge" d={`M ${x1} ${y1} C ${mx} ${y1}, ${mx} ${y2}, ${x2} ${y2}`} marker-end="url(#graph-arrow)" />;
    })}
    {keys.map((key) => {
      const { x, y } = widePos.get(key)!;
      return (
        <a href={`${prefix}/${key}`} class={count(key) ? 'graph-node' : 'graph-node planned'}>
          <rect x={x} y={y} width={W.cardW} height={W.cardH} rx="14" />
          <text class="graph-index" x={x + 18} y={y + 28}>{index(key)}</text>
          <text class="graph-title" x={x + 18} y={y + 56}>{title(key)}</text>
          <text class="graph-status" x={x + 18} y={y + 78}>{status(key)}</text>
        </a>
      );
    })}
    <defs><marker id="graph-arrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="10" markerHeight="10" markerUnits="userSpaceOnUse" orient="auto"><path d="M 0 0.8 L 9.5 5 L 0 9.2 L 2.6 5 Z" /></marker></defs>
  </svg>
  <svg class="graph-narrow" viewBox={`0 0 ${N.w} ${narrowH}`} role="img" aria-labelledby="course-graph-n-t">
    <title id="course-graph-n-t">{t.graph}: {edges.map((e) => `${title(e.from)} → ${title(e.to)}`).join('; ')}</title>
    {edges.map(({ from, to }) => {
      const a = narrowPos.get(from)!, b = narrowPos.get(to)!;
      // One vertical lane per source course, so all edges leaving a course share it.
      const sources = [...new Set(edges.map((e) => e.from))];
      const lane = 38 - 16 * sources.indexOf(from);
      const y1 = a.y + N.cardH / 2, y2 = b.y + N.cardH / 2;
      return <path class="graph-edge" d={`M ${a.x} ${y1} H ${lane} V ${y2} H ${b.x - 4}`} marker-end="url(#graph-arrow-n)" />;
    })}
    {ordered.map((key) => {
      const { x, y } = narrowPos.get(key)!;
      return (
        <a href={`${prefix}/${key}`} class={count(key) ? 'graph-node' : 'graph-node planned'}>
          <rect x={x} y={y} width={N.cardW} height={N.cardH} rx="12" />
          <text class="graph-index" x={x + 14} y={y + 24}>{index(key)}</text>
          <text class="graph-title" x={x + 14} y={y + 47}>{title(key)}</text>
          <text class="graph-status" x={x + 14} y={y + 66}>{status(key)}</text>
        </a>
      );
    })}
    <defs><marker id="graph-arrow-n" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto"><path d="M 0 0.8 L 9.5 5 L 0 9.2 L 2.6 5 Z" /></marker></defs>
  </svg>
</section>
<section class="notes-index shell">
  {ordered.map((key) => {
    const config = courses[key];
    const stages = ru ? config.ru.progression ?? config.progression.map((s) => s.label) : config.progression.map((s) => s.label);
    return (
      <a class={count(key) ? 'collection-card' : 'collection-card planned'} href={`${prefix}/${key}`}>
        <div class="collection-meta"><span>{ru ? 'Курс' : 'Course'} / {index(key)}</span><span>{status(key)}</span></div>
        <h2>{title(key)}</h2>
        <p>{ru ? config.ru.description : config.description}</p>
        <p class="collection-stages">{stages.join(' → ')}</p>
        <p class="collection-requires">{config.requires.length ? `${t.requires}: ${config.requires.map(title).join(', ')}` : t.none}</p>
        <span class="collection-action">{t.open}</span>
      </a>
    );
  })}
</section>
