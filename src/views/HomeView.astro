---
// Homepage for both languages. The structure is shared; only the text differs.
import BaseLayout from '../layouts/BaseLayout.astro';
import SystemsChain from '../components/SystemsChain.astro';
import { impact } from '../data/profile';

interface Props { lang?: 'en' | 'ru' }
const { lang = 'en' } = Astro.props;
const p = lang === 'ru' ? '/ru' : '';

const t = {
  en: {
    meta: { title: undefined, description: undefined },
    kicker: ['Profile / 01', 'AI systems · research · notes'],
    first: 'Fedor', last: 'Pakhurov',
    lead: 'LLM systems, agents and applied AI products.',
    intro: 'Builds production AI systems around LLMs, retrieval and agents, together with the infrastructure, evaluation and human control they need to be useful.',
    actions: ['Selected work', 'Technical notes'], contact: 'Contact',
    impactIndex: '02 / Impact', impactTitle: 'Selected impact.',
    impactText: 'Figures from production work. System and client names are left out.',
    impactLink: 'How these were achieved',
    selectedIndex: '03 / Selected', selectedTitle: 'Work at the intersection of models and operations.',
    selectedText: 'Selected areas of practice, from production LLM services to the systems around them.',
    cards: [
      { eyebrow: 'Applied LLM products', title: 'From prototype to dependable internal service.', text: 'RAG, agents, multimodal prototypes, local model deployment and the production integration required to make them useful.', link: 'Read case studies', href: '/work' },
      { eyebrow: 'Multi-agent systems', title: 'Coordinated agents for inventory operations.', text: 'Supply, transit and export specialists, coordinated around context, proposed actions and explicit confirmation.', link: 'View architecture', href: '/work#multi-agent' },
      { eyebrow: 'Research', title: 'From diffusion-model evaluation to connectome wiring priors.', text: 'Two research lines carried through to tested conclusions, negative results included.', link: 'Research & publications', href: '/projects#research' },
    ],
    chainIndex: '04 / Systems', chainTitle: 'AI transformation is a chain, not a feature.',
    notesIndex: '05 / Knowledge', notesTitle: 'Notes built to be studied, not scrolled.',
    notesText: 'Course notes for Generative Models and NLP, taught at the HSE Faculty of Computer Science. Prerequisites, equations, permanent URLs and a clear progression.',
    courses: [
      { code: 'NLP / 01', title: 'Natural Language Processing', text: 'From tokenization and representations to Transformers, RAG and agents.', link: 'Open collection →' },
      { code: 'GEN / 02', title: 'Generative Models', text: 'Likelihoods, latent variables, VAEs, GANs, flows and diffusion models.', link: 'Open collection →' },
    ],
  },
  ru: {
    meta: { title: 'Фёдор Пахуров — AI / ML Engineer', description: 'AI / ML инженер: production LLM-системы, агенты, RAG, инфраструктура, исследования и технические конспекты.' },
    kicker: ['Профиль / 01', 'AI-системы · исследования · конспекты'],
    first: 'Фёдор', last: 'Пахуров',
    lead: 'LLM-системы, агенты и прикладные AI-продукты.',
    intro: 'Строит production AI-системы вокруг LLM, поиска и агентов — вместе с инфраструктурой, оценкой качества и контролем человека, которые делают их полезными.',
    actions: ['Избранные работы', 'Конспекты'], contact: 'Контакт',
    impactIndex: '02 / Эффект', impactTitle: 'Измеримый результат.',
    impactText: 'Показатели из production-работы. Названия систем и клиентов не раскрываются.',
    impactLink: 'Как это достигнуто',
    selectedIndex: '03 / Практика', selectedTitle: 'Модели, встроенные в реальные процессы.',
    selectedText: 'Производственные LLM-сервисы, мультиагентные системы и инфраструктура вокруг них.',
    cards: [
      { eyebrow: 'Прикладные LLM', title: 'От прототипа к надёжному внутреннему сервису.', text: 'RAG, агенты, мультимодальные прототипы, локальное развёртывание моделей и производственная интеграция.', link: 'К кейсам', href: '/ru/work' },
      { eyebrow: 'Мультиагентные системы', title: 'Специализированные агенты для управления запасами.', text: 'Снабжение, транзит и экспорт под координацией общего агента, с предложенными действиями и явным подтверждением.', link: 'Архитектура', href: '/ru/work#multi-agent' },
      { eyebrow: 'Исследования', title: 'От оценки диффузионных моделей до приоров из коннектомов.', text: 'Два исследовательских направления, доведённых до проверенных выводов, включая отрицательные.', link: 'Исследования и публикации', href: '/ru/projects#research' },
    ],
    chainIndex: '04 / Системы', chainTitle: 'AI-трансформация — это цепочка, а не функция.',
    notesIndex: '05 / Знания', notesTitle: 'Конспекты, которые изучают, а не пролистывают.',
    notesText: 'Конспекты курсов по генеративным моделям и NLP, которые читаются на ФКН ВШЭ. Пререквизиты, формулы, постоянные адреса и понятная последовательность. Доступны на английском.',
    courses: [
      { code: 'NLP / 01', title: 'Обработка естественного языка', text: 'От токенизации и представлений до трансформеров, RAG и агентов.', link: 'Открыть на английском →' },
      { code: 'GEN / 02', title: 'Генеративные модели', text: 'Правдоподобие, латентные переменные, VAE, GAN, потоки и диффузионные модели.', link: 'Открыть на английском →' },
    ],
  },
}[lang];
const courseHrefs = ['/notes/nlp', '/notes/generative-models'];
---

<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description}>
  <section class="hero shell">
    <div class="hero-kicker"><span>{t.kicker[0]}</span><span>{t.kicker[1]}</span></div>
    <div class="hero-grid">
      <div>
        <p class="eyebrow">AI / ML Engineer</p>
        <h1>{t.first}<br />{t.last}</h1>
      </div>
      <div class="hero-copy">
        <h2>{t.lead}</h2>
        <p>{t.intro}</p>
        <nav class="hero-actions" aria-label={lang === 'ru' ? 'Ссылки профиля' : 'Profile links'}>
          <a class="button primary" href={`${p}/work`}>{t.actions[0]} <span>→</span></a>
          <a class="button" href={`${p}/notes`}>{t.actions[1]} <span>→</span></a>
        </nav>
        <div class="text-links">
          <a href={`${p}/cv`}>CV</a><a href="https://github.com/fpakhurov">GitHub ↗</a><a href={`${p}/contact`}>{t.contact}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section shell impact-section" aria-labelledby="impact-heading">
    <div class="section-head">
      <p class="section-index">{t.impactIndex}</p>
      <h2 id="impact-heading">{t.impactTitle}</h2>
      <p>{t.impactText}</p>
    </div>
    <dl class="impact-list">
      {impact.map((item) => (
        <div><dt>{item.value[lang]}</dt><dd>{item.label[lang]}</dd></div>
      ))}
    </dl>
    <a class="impact-link" href={`${p}/work`}>{t.impactLink} →</a>
  </section>

  <section class="section shell" aria-labelledby="selected-heading">
    <div class="section-head">
      <p class="section-index">{t.selectedIndex}</p>
      <h2 id="selected-heading">{t.selectedTitle}</h2>
      <p>{t.selectedText}</p>
    </div>
    <div class="highlight-grid">
      {t.cards.map((card, index) => (
        <article class:list={['highlight-card', { 'accent-card': index === 0 }]}>
          <p class="card-number">{String(index + 1).padStart(2, '0')}</p>
          <div><p class="eyebrow">{card.eyebrow}</p><h3>{card.title}</h3></div>
          <p>{card.text}</p>
          <a href={card.href}>{card.link} <span>↗</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="section shell chain-section" aria-labelledby="chain-heading">
    <div class="section-head compact">
      <p class="section-index">{t.chainIndex}</p>
      <h2 id="chain-heading">{t.chainTitle}</h2>
    </div>
    <SystemsChain lang={lang} />
  </section>

  <section class="section shell notes-preview" aria-labelledby="notes-heading">
    <div class="section-head">
      <p class="section-index">{t.notesIndex}</p>
      <h2 id="notes-heading">{t.notesTitle}</h2>
      <p>{t.notesText}</p>
    </div>
    <div class="course-grid">
      {t.courses.map((course, index) => (
        <a class="course-card" href={courseHrefs[index]} hreflang={lang === 'ru' ? 'en' : undefined}><span class="course-code">{course.code}</span><h3>{course.title}</h3><p>{course.text}</p><span class="course-link">{course.link}</span></a>
      ))}
    </div>
  </section>
</BaseLayout>
