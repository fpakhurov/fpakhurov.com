---
// Homepage for both languages. The structure is shared; only the text differs.
import BaseLayout from '../layouts/BaseLayout.astro';
import SystemsChain from '../components/SystemsChain.astro';
import { examples } from '../data/profile';
import { channelLabel, externalLink, github } from '../config/profile';

interface Props { lang?: 'en' | 'ru' }
const { lang = 'en' } = Astro.props;
const p = lang === 'ru' ? '/ru' : '';

const t = {
  en: {
    meta: { title: undefined, description: undefined },
    kicker: ['Profile / 01', 'AI systems · research · notes'],
    first: 'Fedor', last: 'Pakhurov',
    lead: 'I build AI systems around real workflows.',
    intro: 'Most of my work starts with a process, not a model: something is slow, manual or hard to scale. I use LLMs, retrieval and agents where they actually improve it, and take the result from a prototype to something measurable that runs in production.',
    actions: ['View work', 'Read the notes'], contact: 'Contact',
    sidesIndex: '02 / Focus', sidesTitle: 'Three sides of the same work.',
    sidesText: 'The model is usually only one part of it.',
    cards: [
      { eyebrow: 'Applied AI', title: 'LLM systems inside a workflow.', text: 'Retrieval, agents and multimodal prototypes, built around a decision someone makes every day. Where an action has consequences, the model proposes and a person confirms.', link: 'Read the cases', href: '/work' },
      { eyebrow: 'Systems', title: 'Serving, latency and everything around the model.', text: 'Local inference, quantization, integrations and telemetry. A prototype is not finished until it is fast enough, observable and allowed to touch the data it needs.', link: 'Engineering projects', href: '/projects#engineering' },
      { eyebrow: 'Research', title: 'Why models fail, measured.', text: 'Evaluating diffusion-model errors and testing wiring rules from C. elegans connectomes.', link: 'Research', href: '/projects#research' },
    ],
    examplesIndex: '03 / In practice', examplesTitle: 'Three examples, with the numbers.',
    examplesText: 'From production work. Employer, system and client names are left out.',
    examplesLink: 'Read the case',
    chainIndex: '04 / Systems', chainTitle: 'What has to exist before a model can help.',
    notesIndex: '05 / Knowledge', notesTitle: 'Twelve courses of notes.',
    notesText: 'From probability and Python to generative models, agents and MLOps, in English and Russian. The Generative Models and NLP notes accompany the classes I teach at the HSE Faculty of Computer Science. Every course says what to know before it and links to the courses it builds on.',
    courses: [
      { code: 'ML / 01', title: 'From probability to language models', text: 'Probability, mathematics and Python, then machine learning, deep learning, Bayesian methods, generative models, NLP and agents.', link: 'Start with probability →' },
      { code: 'SYS / 02', title: 'From the processor to production', text: 'Computer architecture and operating systems, DevOps and MLOps: how a program runs, ships and stays up, and what changes when it is a model.', link: 'Start with ACOS →' },
    ],
  },
  ru: {
    meta: { title: 'Фёдор Пахуров — AI / ML Engineer', description: 'AI-системы вокруг реальных процессов: поиск, агенты, локальные модели и инфраструктура вокруг них. Кейсы, исследования и конспекты курсов.' },
    kicker: ['Профиль / 01', 'AI-системы · исследования · конспекты'],
    first: 'Фёдор', last: 'Пахуров',
    lead: 'Строю AI-системы вокруг реальных процессов.',
    intro: 'Обычно всё начинается не с модели, а с процесса: что-то работает медленно, вручную или плохо масштабируется. LLM, поиск и агентов я использую там, где они действительно это улучшают, и довожу результат от прототипа до измеримой системы в продакшене.',
    actions: ['Смотреть работы', 'Читать конспекты'], contact: 'Контакт',
    sidesIndex: '02 / Фокус', sidesTitle: 'Три стороны одной работы.',
    sidesText: 'Модель обычно лишь одна из её частей.',
    cards: [
      { eyebrow: 'Прикладной AI', title: 'LLM-системы внутри рабочего процесса.', text: 'Поиск, агенты и мультимодальные прототипы вокруг решения, которое кто-то принимает каждый день. Где у действия есть последствия, модель предлагает, а человек подтверждает.', link: 'Кейсы', href: '/ru/work' },
      { eyebrow: 'Системы', title: 'Инференс, задержка и всё вокруг модели.', text: 'Локальный инференс, квантизация, интеграции и телеметрия. Прототип не готов, пока он недостаточно быстрый, его работу не видно или у него нет доступа к нужным данным.', link: 'Инженерные проекты', href: '/ru/projects#engineering' },
      { eyebrow: 'Исследования', title: 'Почему модели ошибаются, в цифрах.', text: 'Оценка ошибок диффузионных моделей и проверка правил формирования связей в коннектомах C. elegans.', link: 'Исследования', href: '/ru/projects#research' },
    ],
    examplesIndex: '03 / На практике', examplesTitle: 'Три примера с цифрами.',
    examplesText: 'Из работы в продакшене. Названия работодателя, систем и клиентов не раскрываются.',
    examplesLink: 'Читать кейс',
    chainIndex: '04 / Системы', chainTitle: 'Что должно появиться до того, как модель сможет помочь.',
    notesIndex: '05 / Знания', notesTitle: 'Двенадцать курсов конспектов.',
    notesText: 'От теории вероятностей и Python до генеративных моделей, агентов и MLOps, на русском и английском. Конспекты по генеративным моделям и NLP сопровождают занятия, которые я веду на ФКН ВШЭ. Каждый курс говорит, что нужно знать до него, и ссылается на курсы, на которые опирается.',
    courses: [
      { code: 'ML / 01', title: 'От вероятностей к языковым моделям', text: 'Теория вероятностей, математика и Python, затем машинное обучение, глубокое обучение, байесовские методы, генеративные модели, NLP и агенты.', link: 'Начать с теорвера →' },
      { code: 'SYS / 02', title: 'От процессора до продакшена', text: 'Архитектура компьютера и операционные системы, DevOps и MLOps: как программа работает, выкатывается и не падает и что меняется, когда это модель.', link: 'Начать с АКОС →' },
    ],
  },
}[lang];
const courseHrefs = [`${p}/notes/probability`, `${p}/notes/acos`];
---

<BaseLayout lang={lang} title={t.meta.title} description={t.meta.description}>
  <section class="hero shell">
    <div class="hero-kicker"><span>{t.kicker[0]}</span><span>{t.kicker[1]}</span></div>
    <div class="hero-grid">
      <div>
        <p class="eyebrow">AI / ML Engineer</p>
        <h1>{t.first}<br />{t.last}</h1>
      </div>
      <div class="hero-copy">
        <h2>{t.lead}</h2>
        <p>{t.intro}</p>
        <nav class="hero-actions" aria-label={lang === 'ru' ? 'Ссылки профиля' : 'Profile links'}>
          <a class="button primary" href={`${p}/work`}>{t.actions[0]} <span>→</span></a>
          <a class="button" href={`${p}/notes`}>{t.actions[1]} <span>→</span></a>
        </nav>
        <div class="text-links">
          <a href={`${p}/cv`}>CV</a>{github && <a href={github.href} aria-label={channelLabel(github, lang, false)} {...externalLink}>GitHub ↗</a>}<a href={`${p}/contact`}>{t.contact}</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section shell" aria-labelledby="sides-heading">
    <div class="section-head">
      <p class="section-index">{t.sidesIndex}</p>
      <h2 id="sides-heading">{t.sidesTitle}</h2>
      <p>{t.sidesText}</p>
    </div>
    <div class="highlight-grid">
      {t.cards.map((card, index) => (
        <article class:list={['highlight-card', { 'accent-card': index === 0 }]}>
          <p class="card-number">{String(index + 1).padStart(2, '0')}</p>
          <div><p class="eyebrow">{card.eyebrow}</p><h3>{card.title}</h3></div>
          <p>{card.text}</p>
          <a href={card.href}>{card.link} <span>→</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="section shell" aria-labelledby="examples-heading">
    <div class="section-head">
      <p class="section-index">{t.examplesIndex}</p>
      <h2 id="examples-heading">{t.examplesTitle}</h2>
      <p>{t.examplesText}</p>
    </div>
    <ul class="practice-list">
      {examples.map((item) => (
        <li>
          <p class="eyebrow">{item.label[lang]}</p>
          <p set:html={item.text[lang]} />
          <a href={`${p}${item.href}`}>{t.examplesLink} →</a>
        </li>
      ))}
    </ul>
  </section>

  <section class="section shell chain-section" aria-labelledby="chain-heading">
    <div class="section-head compact">
      <p class="section-index">{t.chainIndex}</p>
      <h2 id="chain-heading">{t.chainTitle}</h2>
    </div>
    <SystemsChain lang={lang} />
  </section>

  <section class="section shell notes-preview" aria-labelledby="notes-heading">
    <div class="section-head">
      <p class="section-index">{t.notesIndex}</p>
      <h2 id="notes-heading">{t.notesTitle}</h2>
      <p>{t.notesText}</p>
    </div>
    <div class="course-grid">
      {t.courses.map((course, index) => (
        <a class="course-card" href={courseHrefs[index]}><span class="course-code">{course.code}</span><h3>{course.title}</h3><p>{course.text}</p><span class="course-link">{course.link}</span></a>
      ))}
    </div>
  </section>
</BaseLayout>
