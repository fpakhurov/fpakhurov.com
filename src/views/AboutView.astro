---
// About page for both languages: profile, how the work is done, and the public record.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { principles, writing } from '../data/profile';
import { hse } from '../config/profile';

interface Props { lang?: 'en' | 'ru' }
const { lang = 'en' } = Astro.props;

const t = {
  en: {
    title: 'About',
    meta: 'About Fedor Pakhurov, an AI / ML engineer working on production LLM systems, agents, research and teaching.',
    index: '05 / About', eyebrow: 'Profile', heading: 'Engineer, researcher, systems thinker.',
    intro: 'I work on applied AI products and the surrounding architecture that turns promising models into useful, accountable systems.',
    focusLabel: 'Focus',
    focus: ['LLM systems', 'Agents', 'RAG', 'Local model deployment', 'Generative models', 'MLOps'],
    methodIndex: '01 / Method', methodTitle: 'How I build AI systems',
    methodLead: 'I start from the decision or workflow, not from the model. Before building an AI system, I want a baseline, an observable metric and a clear boundary between model autonomy and human responsibility.',
    writingIndex: '02 / Public record', writingTitle: 'Writing & talks',
    writingText: 'Public articles, talks and theses. The talks were given in Russian.',
  },
  ru: {
    title: 'Обо мне',
    meta: 'Фёдор Пахуров — AI / ML инженер: production LLM-системы, агенты, исследования и преподавание.',
    index: '05 / Обо мне', eyebrow: 'Профиль', heading: 'Инженер, исследователь, системный мыслитель.',
    intro: 'Работаю над прикладными AI-продуктами и архитектурой, которая превращает сильные модели в полезные и подотчётные системы.',
    focusLabel: 'Фокус',
    focus: ['LLM-системы', 'Агенты', 'RAG', 'Локальное развёртывание моделей', 'Генеративные модели', 'MLOps'],
    methodIndex: '01 / Метод', methodTitle: 'Как я строю AI-системы',
    methodLead: 'Я начинаю с решения или рабочего процесса, а не с модели. Прежде чем строить AI-систему, мне нужны базовая линия, наблюдаемая метрика и чёткая граница между автономией модели и ответственностью человека.',
    writingIndex: '02 / Публично', writingTitle: 'Тексты и выступления',
    writingText: 'Публичные статьи, доклады и выпускные работы.',
  },
}[lang];
---

<BaseLayout lang={lang} title={t.title} description={t.meta}>
  <PageIntro index={t.index} eyebrow={t.eyebrow} title={t.heading} description={t.intro} />
  <section class="reading-layout shell">
    <aside><p class="eyebrow">{t.focusLabel}</p><p set:html={t.focus.join('<br />')} /></aside>
    {lang === 'ru' ? (
      <article class="prose large-prose">
        <h2>Весь путь вокруг модели.</h2>
        <p>Моя работа находится между машинным обучением, продуктовой инженерией и операционными процессами. Мне интересны системы, где контекст нужно найти, несколько инструментов или агентов должны согласованно работать, а у человека остаётся понятная точка контроля.</p>
        <p>Этот взгляд выходит за пределы отдельной модели. Полезный AI зависит от понятных процессов, истории решений, хороших данных, инфраструктуры развёртывания и оценки, которая отражает реальную задачу.</p>
        <h2>Исследования и преподавание как инженерные инструменты.</h2>
        <p>Исследую генеративные модели и структурные приоры: от оценки галлюцинаций диффузионных моделей до правил формирования синапсов в коннектомах C. elegans. Отрицательные результаты описываю наравне с положительными. Преподаю генеративные модели и NLP на <a href={hse?.href}>факультете компьютерных наук ВШЭ</a>; <a href="/ru/notes">конспекты</a> на этом сайте написаны для этих курсов.</p>
        <blockquote>Выбирая между сложностью и простотой, выбирай простоту. Главная ценность — содержание.</blockquote>
      </article>
    ) : (
      <article class="prose large-prose">
        <h2>Building the whole path around the model.</h2>
        <p>My work sits between machine learning, product engineering and operations. I am interested in systems where context must be retrieved, multiple tools or agents must coordinate, and a person still needs a clear point of control.</p>
        <p>That perspective extends beyond individual models. Useful AI depends on legible processes, decision history, good datasets, deployment infrastructure and evaluation that reflects the actual job being done.</p>
        <h2>Research and teaching as engineering tools.</h2>
        <p>My research covers generative models and structural priors, from evaluating hallucinations in diffusion models to synapse-formation rules in C. elegans connectomes. Negative results are reported alongside positive ones. I teach generative models and NLP at the <a href={hse?.href}>HSE Faculty of Computer Science</a>, and the <a href="/notes">notes</a> on this site are written for those courses.</p>
        <blockquote>When deciding between complexity and simplicity, choose simplicity. The important asset is the content.</blockquote>
      </article>
    )}
  </section>

  <section class="section shell method-section" id="how-i-build" aria-labelledby="method-heading">
    <div class="section-head">
      <p class="section-index">{t.methodIndex}</p>
      <h2 id="method-heading">{t.methodTitle}</h2>
      <p>{t.methodLead}</p>
    </div>
    <ol class="principles">
      {principles.map((item, index) => (
        <li><span>{String(index + 1).padStart(2, '0')}</span><div><h3>{item.title[lang]}</h3><p>{item.text[lang]}</p></div></li>
      ))}
    </ol>
  </section>

  <section class="section shell writing-section" id="writing" aria-labelledby="writing-heading">
    <div class="section-head">
      <p class="section-index">{t.writingIndex}</p>
      <h2 id="writing-heading">{t.writingTitle}</h2>
      <p>{t.writingText}</p>
    </div>
    <ul class="writing-list">
      {writing.map((item) => (
        <li>
          <span class="writing-year">{item.year}</span>
          <div><h3>{item.title[lang]}</h3><p>{item.type[lang]}</p></div>
          <div class="writing-links">
            {item.links.map((link) => <a href={link.href} hreflang={link.hreflang && link.hreflang !== lang ? link.hreflang : undefined}>{link.label[lang]} ↗</a>)}
          </div>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
