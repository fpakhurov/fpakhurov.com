---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FigureDefs from '../components/figures/FigureDefs.astro';
import { courses } from '../utils/courses';

interface Heading { depth: number; slug: string; text: string }
type NoteEntry = CollectionEntry<'notes'> | CollectionEntry<'notesRu'>;
interface Props {
  note: NoteEntry;
  allNotes: NoteEntry[];
  headings: Heading[];
  lang?: 'en' | 'ru';
  /** Set on a Russian page that shows the English text because no translation exists yet. */
  untranslated?: boolean;
}
const { note, allNotes, headings, lang = 'en', untranslated = false } = Astro.props;
const ru = lang === 'ru';
const prefix = ru ? '/ru/notes' : '/notes';
const altHref = ru ? `/notes/${note.id}` : `/ru/notes/${note.id}`;
const course = courses[note.data.course];
const courseTitle = ru ? course.ru?.title ?? course.title : course.title;
const courseShort = ru ? course.ru?.shortTitle ?? course.shortTitle : course.shortTitle;
const t = ru
  ? { contents: 'Содержание курса', prereq: 'Что нужно знать', prev: '← Назад', next: 'Дальше →', onPage: 'На этой странице', nav: 'Навигация по заметкам' }
  : { contents: 'Course contents', prereq: 'Prerequisites', prev: '← Previous', next: 'Next →', onPage: 'On this page', nav: 'Article navigation' };
const ordered = [...allNotes].sort((a, b) => a.data.order - b.data.order);
const currentIndex = ordered.findIndex((entry) => entry.id === note.id);
const previous = currentIndex > 0 ? ordered[currentIndex - 1] : undefined;
const next = currentIndex < ordered.length - 1 ? ordered[currentIndex + 1] : undefined;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: note.data.title,
  description: note.data.description,
  author: { '@type': 'Person', name: 'Fedor Pakhurov', url: 'https://fpakhurov.com' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<BaseLayout title={note.data.title} description={note.data.description} lang={lang} altHref={altHref}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <div class="docs-shell shell">
    <details class="mobile-course-nav">
      <summary>{t.contents}</summary>
      <nav>{ordered.map((entry) => <a href={`${prefix}/${entry.id}`} aria-current={entry.id === note.id ? 'page' : undefined}>{entry.data.title}</a>)}</nav>
    </details>
    <aside class="course-tree">
      <a class="tree-course" href={`${prefix}/${note.data.course}`}>{courseTitle}</a>
      <p>{note.data.section}</p>
      <nav>{ordered.map((entry, index) => <a href={`${prefix}/${entry.id}`} aria-current={entry.id === note.id ? 'page' : undefined}><span>{String(index + 1).padStart(2, '0')}</span>{entry.data.title}</a>)}</nav>
    </aside>
    <article class="note-article">
      <header class="note-header">
        <p class="eyebrow">{courseShort} / {note.data.section}</p>
        <h1>{note.data.title}</h1>
        <p class="note-dek">{note.data.description}</p>
        {untranslated && <p class="callout">Перевод этой заметки готовится; ниже английский оригинал.</p>}
        <div class="prerequisites"><span>{t.prereq}</span><p>{note.data.prerequisites.join(' · ')}</p></div>
      </header>
      <FigureDefs />
      <div class="prose"><slot /></div>
      <nav class="note-pagination" aria-label={t.nav}>
        {previous ? <a href={`${prefix}/${previous.id}`}><span>{t.prev}</span><strong>{previous.data.title}</strong></a> : <span />}
        {next ? <a class="next" href={`${prefix}/${next.id}`}><span>{t.next}</span><strong>{next.data.title}</strong></a> : <span />}
      </nav>
    </article>
    <aside class="on-page">
      <p>{t.onPage}</p>
      <nav>{headings.filter((heading) => heading.depth === 2).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav>
    </aside>
  </div>
</BaseLayout>
