---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { courses } from '../utils/courses';

interface Heading { depth: number; slug: string; text: string }
interface Props {
  note: CollectionEntry<'notes'>;
  allNotes: CollectionEntry<'notes'>[];
  headings: Heading[];
}
const { note, allNotes, headings } = Astro.props;
const course = courses[note.data.course];
const ordered = [...allNotes].sort((a, b) => a.data.order - b.data.order);
const currentIndex = ordered.findIndex((entry) => entry.id === note.id);
const previous = currentIndex > 0 ? ordered[currentIndex - 1] : undefined;
const next = currentIndex < ordered.length - 1 ? ordered[currentIndex + 1] : undefined;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: note.data.title,
  description: note.data.description,
  author: { '@type': 'Person', name: 'Fedor Pakhurov', url: 'https://fpakhurov.com' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
---

<BaseLayout title={note.data.title} description={note.data.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <div class="docs-shell shell">
    <details class="mobile-course-nav">
      <summary>Course contents</summary>
      <nav>{ordered.map((entry) => <a href={`/notes/${entry.id}`} aria-current={entry.id === note.id ? 'page' : undefined}>{entry.data.title}</a>)}</nav>
    </details>
    <aside class="course-tree">
      <a class="tree-course" href={`/notes/${note.data.course}`}>{course.title}</a>
      <p>{note.data.section}</p>
      <nav>{ordered.map((entry, index) => <a href={`/notes/${entry.id}`} aria-current={entry.id === note.id ? 'page' : undefined}><span>{String(index + 1).padStart(2, '0')}</span>{entry.data.title}</a>)}</nav>
    </aside>
    <article class="note-article">
      <header class="note-header">
        <p class="eyebrow">{course.shortTitle} / {note.data.section}</p>
        <h1>{note.data.title}</h1>
        <p class="note-dek">{note.data.description}</p>
        <div class="prerequisites"><span>Prerequisites</span><p>{note.data.prerequisites.join(' · ')}</p></div>
      </header>
      <div class="prose"><slot /></div>
      <nav class="note-pagination" aria-label="Article navigation">
        {previous ? <a href={`/notes/${previous.id}`}><span>← Previous</span><strong>{previous.data.title}</strong></a> : <span />}
        {next ? <a class="next" href={`/notes/${next.id}`}><span>Next →</span><strong>{next.data.title}</strong></a> : <span />}
      </nav>
    </article>
    <aside class="on-page">
      <p>On this page</p>
      <nav>{headings.filter((heading) => heading.depth === 2).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav>
    </aside>
  </div>
</BaseLayout>
