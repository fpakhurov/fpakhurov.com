---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FigureDefs from '../components/figures/FigureDefs.astro';
import { courses, sectionOf } from '../utils/courses';
import { prerequisiteLinks } from '../utils/prerequisites';

interface Heading { depth: number; slug: string; text: string }
type NoteEntry = CollectionEntry<'notes'> | CollectionEntry<'notesRu'>;
interface Props {
  note: NoteEntry;
  allNotes: NoteEntry[];
  headings: Heading[];
  lang?: 'en' | 'ru';
  /** Set on a Russian page that shows the English text because no translation exists yet. */
  untranslated?: boolean;
}
const { note, allNotes, headings, lang = 'en', untranslated = false } = Astro.props;
const ru = lang === 'ru';
const prefix = ru ? '/ru/notes' : '/notes';
const altHref = ru ? `/notes/${note.id}` : `/ru/notes/${note.id}`;
const course = courses[note.data.course];
const courseTitle = ru ? course.ru.title : course.title;
const courseShort = ru ? course.ru.shortTitle : course.shortTitle;
const tr = (text: string) => (ru ? course.ru.labels[text] ?? text : text);
const t = ru
  ? { notes: 'Конспекты', contents: 'Содержание курса', prereq: 'Что нужно знать', prev: '← Назад', next: 'Дальше →', onPage: 'На этой странице', nav: 'Навигация по заметкам', crumbs: 'Навигационная цепочка' }
  : { notes: 'Notes', contents: 'Course contents', prereq: 'Prerequisites', prev: '← Previous', next: 'Next →', onPage: 'On this page', nav: 'Article navigation', crumbs: 'Breadcrumb' };
// The page outline: the note's top-level sections. The side column shows it on wide screens; narrower
// screens get it as a collapsible list under the note header.
// End matter is left out: every note has it, and it would fill half of every outline.
const endMatter = new Set(['what-changed', 'limitations', 'what-you-should-remember', 'summary', 'next', 'references']);
const sections = headings.filter((heading) => heading.depth === 2 && !endMatter.has(heading.slug));
const ordered = [...allNotes].sort((a, b) => a.data.order - b.data.order);
const currentIndex = ordered.findIndex((entry) => entry.id === note.id);
const previous = currentIndex > 0 ? ordered[currentIndex - 1] : undefined;
const next = currentIndex < ordered.length - 1 ? ordered[currentIndex + 1] : undefined;
const sectionTitle = tr(sectionOf(note.data.course, note.id) ?? note.data.section);
// Group the ordered notes by course section, keeping the course order.
const groups: { title: string; entries: typeof ordered }[] = [];
for (const entry of ordered) {
  const title = tr(sectionOf(entry.data.course, entry.id) ?? entry.data.section);
  const last = groups[groups.length - 1];
  if (last && last.title === title) last.entries.push(entry);
  else groups.push({ title, entries: [entry] });
}
const position = (entry: NoteEntry) => String(ordered.indexOf(entry) + 1).padStart(2, '0');
// Prerequisites link to the note that covers them (see src/utils/prerequisites.ts).
const topicTargets = new Map<string, string>();
for (const section of course.sections) {
  for (const topic of section.topics) {
    if (typeof topic !== 'string') topicTargets.set(topic.title.toLowerCase(), `${topic.note}${topic.anchor ? `#${topic.anchor}` : ''}`);
  }
}
// A note shown untranslated on a Russian page names its prerequisites by their English titles.
const englishTitles = ru
  ? (await getCollection('notes', ({ data }) => data.course === note.data.course && data.status === 'published')).map((entry) => [entry.data.title.toLowerCase(), entry.id] as const)
  : [];
const prerequisites = prerequisiteLinks(note.data.prerequisites, {
  prefix,
  titles: new Map([...englishTitles, ...allNotes.map((entry) => [entry.data.title.toLowerCase(), entry.id] as const)]),
  labels: ru ? course.ru.labels : {},
  topics: topicTargets,
  lenient: process.env.COURSE_LENIENT === '1',
});
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: note.data.title,
  description: note.data.description,
  keywords: note.data.tags.join(', '),
  inLanguage: lang,
  isPartOf: { '@type': 'Course', name: courseTitle, url: new URL(`${prefix}/${note.data.course}`, Astro.site).toString() },
  author: { '@type': 'Person', name: 'Fedor Pakhurov', url: 'https://fpakhurov.com' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.notes, item: new URL(prefix, Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: courseTitle, item: new URL(`${prefix}/${note.data.course}`, Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: note.data.title, item: new URL(Astro.url.pathname, Astro.site).toString() },
  ],
};
---

<BaseLayout title={`${note.data.title} — ${courseShort}`} description={note.data.description} lang={lang} altHref={altHref}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="docs-shell shell">
    <details class="mobile-course-nav">
      <summary>{t.contents} <small>{position(note)} / {ordered.length}</small></summary>
      <nav>
        {groups.map((group) => (
          <div class="tree-group">
            <p>{group.title}</p>
            {group.entries.map((entry) => <a href={`${prefix}/${entry.id}`} aria-current={entry.id === note.id ? 'page' : undefined}><span>{position(entry)}</span>{entry.data.title}</a>)}
          </div>
        ))}
      </nav>
    </details>
    <aside class="course-tree">
      <a class="tree-course" href={`${prefix}/${note.data.course}`}>{courseTitle}</a>
      <nav aria-label={t.contents}>
        {groups.map((group) => (
          <div class="tree-group" aria-current={group.title === sectionTitle ? 'true' : undefined}>
            <p>{group.title}</p>
            {group.entries.map((entry) => <a href={`${prefix}/${entry.id}`} aria-current={entry.id === note.id ? 'page' : undefined}><span>{position(entry)}</span>{entry.data.title}</a>)}
          </div>
        ))}
      </nav>
    </aside>
    <article class="note-article">
      <header class="note-header">
        <nav class="breadcrumb" aria-label={t.crumbs}>
          <a href={prefix}>{t.notes}</a>
          <span aria-hidden="true">/</span>
          <a href={`${prefix}/${note.data.course}`}>{courseShort}</a>
          <span aria-hidden="true">/</span>
          <span>{sectionTitle}</span>
        </nav>
        <p class="eyebrow">{position(note)} / {ordered.length} · {sectionTitle}</p>
        <h1>{note.data.title}</h1>
        <p class="note-dek">{note.data.description}</p>
        {untranslated && <p class="callout">Перевод этой заметки готовится; ниже английский оригинал.</p>}
        {prerequisites.length > 0 && <div class="prerequisites"><span>{t.prereq}</span><p>{prerequisites.map((item, index) => (
          <>{index > 0 && ' · '}{item.href
            ? <a href={item.href} {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{item.label}{item.external && ' ↗'}</a>
            : item.label}</>
        ))}</p></div>}
        {sections.length >= 4 && (
          <details class="mobile-on-page">
            <summary>{t.onPage} <small>{sections.length}</small></summary>
            <nav>{sections.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav>
          </details>
        )}
      </header>
      <FigureDefs />
      <div class="prose"><slot /></div>
      <nav class="note-pagination" aria-label={t.nav}>
        {previous ? <a href={`${prefix}/${previous.id}`} rel="prev"><span>{t.prev}</span><strong>{previous.data.title}</strong></a> : <span />}
        {next ? <a class="next" href={`${prefix}/${next.id}`} rel="next"><span>{t.next}</span><strong>{next.data.title}</strong></a> : <span />}
      </nav>
    </article>
    <aside class="on-page">
      <p>{t.onPage}</p>
      <nav>{sections.map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav>
    </aside>
  </div>
</BaseLayout>
