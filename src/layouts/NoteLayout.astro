---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import FigureDefs from '../components/figures/FigureDefs.astro';
import { courses, sectionOf } from '../utils/courses';

interface Heading { depth: number; slug: string; text: string }
interface Props {
  note: CollectionEntry<'notes'>;
  allNotes: CollectionEntry<'notes'>[];
  headings: Heading[];
}
const { note, allNotes, headings } = Astro.props;
const course = courses[note.data.course];
const ordered = [...allNotes].sort((a, b) => a.data.order - b.data.order);
const currentIndex = ordered.findIndex((entry) => entry.id === note.id);
const previous = currentIndex > 0 ? ordered[currentIndex - 1] : undefined;
const next = currentIndex < ordered.length - 1 ? ordered[currentIndex + 1] : undefined;
const sectionTitle = sectionOf(note.data.course, note.id) ?? note.data.section;
// Group the ordered notes by course section, keeping the course order.
const groups: { title: string; entries: typeof ordered }[] = [];
for (const entry of ordered) {
  const title = sectionOf(entry.data.course, entry.id) ?? entry.data.section;
  const last = groups[groups.length - 1];
  if (last && last.title === title) last.entries.push(entry);
  else groups.push({ title, entries: [entry] });
}
const position = (entry: CollectionEntry<'notes'>) => String(ordered.indexOf(entry) + 1).padStart(2, '0');
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'TechArticle',
  headline: note.data.title,
  description: note.data.description,
  keywords: note.data.tags.join(', '),
  isPartOf: { '@type': 'Course', name: course.title, url: new URL(`/notes/${note.data.course}`, Astro.site).toString() },
  author: { '@type': 'Person', name: 'Fedor Pakhurov', url: 'https://fpakhurov.com' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
};
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Notes', item: new URL('/notes', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: course.title, item: new URL(`/notes/${note.data.course}`, Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: note.data.title, item: new URL(Astro.url.pathname, Astro.site).toString() },
  ],
};
---

<BaseLayout title={`${note.data.title} — ${course.shortTitle}`} description={note.data.description}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(articleSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  <div class="docs-shell shell">
    <details class="mobile-course-nav">
      <summary>Course contents <small>{position(note)} / {ordered.length}</small></summary>
      <nav>
        {groups.map((group) => (
          <div class="tree-group">
            <p>{group.title}</p>
            {group.entries.map((entry) => <a href={`/notes/${entry.id}`} aria-current={entry.id === note.id ? 'page' : undefined}><span>{position(entry)}</span>{entry.data.title}</a>)}
          </div>
        ))}
      </nav>
    </details>
    <aside class="course-tree">
      <a class="tree-course" href={`/notes/${note.data.course}`}>{course.title}</a>
      <nav aria-label="Course contents">
        {groups.map((group) => (
          <div class="tree-group" aria-current={group.title === sectionTitle ? 'true' : undefined}>
            <p>{group.title}</p>
            {group.entries.map((entry) => <a href={`/notes/${entry.id}`} aria-current={entry.id === note.id ? 'page' : undefined}><span>{position(entry)}</span>{entry.data.title}</a>)}
          </div>
        ))}
      </nav>
    </aside>
    <article class="note-article">
      <header class="note-header">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <a href="/notes">Notes</a>
          <span aria-hidden="true">/</span>
          <a href={`/notes/${note.data.course}`}>{course.shortTitle}</a>
          <span aria-hidden="true">/</span>
          <span>{sectionTitle}</span>
        </nav>
        <p class="eyebrow">{position(note)} / {ordered.length} · {sectionTitle}</p>
        <h1>{note.data.title}</h1>
        <p class="note-dek">{note.data.description}</p>
        <div class="prerequisites"><span>Prerequisites</span><p>{note.data.prerequisites.join(' · ')}</p></div>
      </header>
      <FigureDefs />
      <div class="prose"><slot /></div>
      <nav class="note-pagination" aria-label="Article navigation">
        {previous ? <a href={`/notes/${previous.id}`} rel="prev"><span>← Previous</span><strong>{previous.data.title}</strong></a> : <span />}
        {next ? <a class="next" href={`/notes/${next.id}`} rel="next"><span>Next →</span><strong>{next.data.title}</strong></a> : <span />}
      </nav>
    </article>
    <aside class="on-page">
      <p>On this page</p>
      <nav>{headings.filter((heading) => heading.depth === 2).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav>
    </aside>
  </div>
</BaseLayout>
