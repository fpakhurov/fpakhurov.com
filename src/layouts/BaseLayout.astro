---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sameAs } from '../config/profile';
import { counterpart, hasTranslation } from '../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'ru';
  /** The same page in the other language, for the language switch. */
  altHref?: string;
}

const {
  title = 'Fedor Pakhurov — AI / ML Engineer',
  description = 'Applied AI systems built around real workflows: retrieval, agents, local models and the infrastructure around them. Case studies, research and course notes by Fedor Pakhurov.',
  lang = 'en',
  altHref,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/og.png', Astro.site);
const name = lang === 'ru' ? 'Фёдор Пахуров' : 'Fedor Pakhurov';
const fullTitle = title.includes(name) ? title : `${title} — ${name}`;
// hreflang alternates only for pages that exist in both languages.
const alternate = hasTranslation(Astro.url.pathname) ? new URL(counterpart(Astro.url.pathname), Astro.site) : undefined;
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Fedor Pakhurov',
  url: 'https://fpakhurov.com',
  jobTitle: 'AI / ML Engineer',
  sameAs,
  knowsAbout: ['Large language models', 'Natural language processing', 'AI agents', 'Retrieval-augmented generation', 'Generative models'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {alternate && <link rel="alternate" hreflang={lang} href={canonicalURL} />}
    {alternate && <link rel="alternate" hreflang={lang === 'ru' ? 'en' : 'ru'} href={alternate} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Fedor Pakhurov" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Fedor Pakhurov — AI / ML Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Fedor Pakhurov — AI / ML Engineer" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <Header lang={lang} altHref={altHref} />
    <main id="content"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
