---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { sameAs } from '../config/profile';
import { counterpart, hasTranslation } from '../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  lang?: 'en' | 'ru';
  /** The same page in the other language, for the language switch. */
  altHref?: string;
}

const {
  title = 'Fedor Pakhurov — AI / ML Engineer',
  description = 'Applied AI systems built around real workflows: retrieval, agents, local models and the infrastructure around them. Case studies, research and course notes by Fedor Pakhurov.',
  lang = 'en',
  altHref,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL('/og.png', Astro.site);
const name = lang === 'ru' ? 'Фёдор Пахуров' : 'Fedor Pakhurov';
const fullTitle = title.includes(name) ? title : `${title} — ${name}`;
// hreflang alternates only for pages that exist in both languages.
const alternate = hasTranslation(Astro.url.pathname) ? new URL(counterpart(Astro.url.pathname), Astro.site) : undefined;
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Fedor Pakhurov',
  url: 'https://fpakhurov.com',
  jobTitle: 'AI / ML Engineer',
  sameAs,
  knowsAbout: ['Large language models', 'Natural language processing', 'AI agents', 'Retrieval-augmented generation', 'Generative models'],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {alternate && <link rel="alternate" hreflang={lang} href={canonicalURL} />}
    {alternate && <link rel="alternate" hreflang={lang === 'ru' ? 'en' : 'ru'} href={alternate} />}
    <link rel="icon" href="/favicon.ico" type="image/x-icon" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-light-16x16.png" type="image/png" sizes="16x16" />
    <link rel="icon" href="/favicon-dark-16x16.png" type="image/png" sizes="16x16" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon-light-32x32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon-dark-32x32.png" type="image/png" sizes="32x32" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon-light-48x48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/favicon-dark-48x48.png" type="image/png" sizes="48x48" media="(prefers-color-scheme: dark)" />
    <!-- SVG-capable browsers prefer the adaptive SVG, which follows the light/dark preference itself. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#F4F4F7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1B1B1B" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={name} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${name} — AI / ML Engineer`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={`${name} — AI / ML Engineer`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">{lang === 'ru' ? 'Перейти к содержанию' : 'Skip to content'}</a>
    <Header lang={lang} altHref={altHref} />
    <main id="content"><slot /></main>
    <Footer lang={lang} />
  </body>
</html>
