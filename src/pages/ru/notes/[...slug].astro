---
import { getCollection, render } from 'astro:content';
import NoteLayout from '../../../layouts/NoteLayout.astro';

// Every published note gets a Russian URL. Notes without a translation yet show
// the English text with a notice, so links between Russian notes never break.
export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => data.status === 'published');
  const translations = new Map((await getCollection('notesRu', ({ data }) => data.status === 'published')).map((note) => [note.id, note]));
  const localized = notes.map((note) => translations.get(note.id) ?? note);
  return notes.map((note) => ({
    params: { slug: note.id },
    props: {
      note: translations.get(note.id) ?? note,
      untranslated: !translations.has(note.id),
      allNotes: localized.filter((entry) => entry.data.course === note.data.course),
    },
  }));
}

const { note, untranslated, allNotes } = Astro.props;
const { Content, headings } = await render(note);
---

<NoteLayout note={note} allNotes={allNotes} headings={headings} lang="ru" untranslated={untranslated}>
  <Content />
</NoteLayout>
