---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseOverview from '../../../components/CourseOverview.astro';
import { courses, type CourseKey } from '../../../utils/courses';

export function getStaticPaths() {
  return (Object.keys(courses) as CourseKey[]).map((course) => ({ params: { course } }));
}

const course = Astro.params.course as CourseKey;
const notes = (await getCollection('notes', ({ data }) => data.course === course && data.status === 'published')).sort((a, b) => a.data.order - b.data.order);
const translated = new Set((await getCollection('notesRu', ({ data }) => data.status === 'published')).map((note) => note.id));
const config = courses[course].ru;
---

<BaseLayout title={`${config.title}: конспекты`} description={config.description} lang="ru" altHref={`/notes/${course}`}>
  <CourseOverview course={course} notes={notes} lang="ru" translated={translated} />
</BaseLayout>
