---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';

const cases = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Selected Work" description="Case studies in production LLM systems, multi-agent operations and AI transformation.">
  <PageIntro index="02 / Work" eyebrow="Selected case studies" title="Applied AI, in operating context." description="A small set of case studies organized around problems, decisions and lessons—not a chronology. Details stay intentionally bounded to protect confidential work." />
  <section class="case-list shell">
    {cases.map((item, index) => (
      <article class="case-study" id={item.id === 'multi-agent-inventory' ? 'multi-agent' : item.id}>
        <header class="case-heading"><span>{String(index + 1).padStart(2, '0')}</span><div><p class="eyebrow">{item.data.tags.slice(0, 3).join(' · ')}</p><h2>{item.data.title}</h2><p>{item.data.summary}</p></div></header>
        <dl class="case-details">
          <div><dt>Problem</dt><dd>{item.data.problem}</dd></div>
          <div><dt>Context</dt><dd>{item.data.context}</dd></div>
          <div><dt>My role</dt><dd>{item.data.role}</dd></div>
          <div><dt>Approach</dt><dd>{item.data.approach}</dd></div>
          <div><dt>Result</dt><dd>{item.data.result}</dd></div>
          <div><dt>Lessons</dt><dd>{item.data.lessons}</dd></div>
        </dl>
        {item.id === 'multi-agent-inventory' && (
          <div class="agent-diagram" aria-label="Multi-agent inventory architecture">
            <div class="diagram-node wide">User request</div><span>↓</span>
            <div class="diagram-node coordinator">Coordinator agent</div><span>↓</span>
            <div class="agent-row"><div class="diagram-node">Supply agent</div><div class="diagram-node">Transit agent</div><div class="diagram-node">Export agent</div></div>
            <span>↓</span><div class="diagram-node wide">Internal systems &amp; tools</div><span>↓</span>
            <div class="diagram-node wide">Proposed action → explicit confirmation</div>
          </div>
        )}
        {item.id === 'ai-transformation' && (
          <ol class="mini-chain">{['Paper', 'Digitalization', 'Decision history', 'Business rules', 'Dataset', 'ML', 'MLOps', 'Infrastructure', 'LLM', 'Agents'].map((step) => <li>{step}</li>)}</ol>
        )}
      </article>
    ))}
  </section>
</BaseLayout>
