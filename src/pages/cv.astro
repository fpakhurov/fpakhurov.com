---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import { profiles } from '../data/profile';
---

<BaseLayout title="CV" description="CV of Fedor Pakhurov, AI / ML engineer.">
  <PageIntro index="06 / CV" eyebrow="Curriculum vitae" title="Fedor Pakhurov" description="AI / ML Engineer focused on LLM systems, agents, retrieval and applied AI products." />
  <div class="cv shell">
    <aside class="cv-sidebar">
      <div><p class="eyebrow">Location</p><p>Moscow</p></div>
      <div><p class="eyebrow">Profiles</p><p><a href={profiles.github}>GitHub ↗</a><br /><a href={profiles.habr}>Habr ↗</a><br /><a href={profiles.hse}>HSE ↗</a></p></div>
      <div><p class="eyebrow">Core stack</p><p>Python · TypeScript · ML systems · LLM applications · RAG · Agents · MLOps</p></div>
    </aside>
    <div class="cv-main">
      <section><h2>Summary</h2><p>AI / ML engineer building systems around large language models, retrieval, agents and multimodal models, with an emphasis on production integration and operational usefulness.</p></section>
      <section><h2>Selected experience</h2><div class="cv-entry"><h3>Applied LLM systems</h3><p>Production-oriented NLP and LLM systems for e-commerce operations, spanning RAG, agents, multimodal prototypes and internal AI services.</p></div><div class="cv-entry"><h3>Local Text-to-SQL</h3><p>Moved an analytics assistant to open-weight models inside the company perimeter; vLLM and FP8 quantization cut SQL generation from 2 minutes to 3 seconds on a single A100.</p></div><div class="cv-entry"><h3>Multi-agent inventory operations</h3><p>Designed a coordinator-led platform with specialist supply, transit and export agents, tool access and explicit confirmation for critical operations.</p></div><div class="cv-entry"><h3>AI transformation</h3><p>Worked on AI-first maturity strategy linking process digitization, decision data, business rules, ML platforms, LLM systems and agents.</p></div></section>
      <section><h2>Research & education</h2><div class="cv-entry"><h3>Methods of Evaluation of Diffusion Model Hallucinations</h3><p>Bachelor thesis at HSE covering diffusion models, complexity–entropy analysis, Rényi entropy, Bandt–Pompe methods, clustering and hallucination severity estimation.</p></div><div class="cv-entry"><h3>Connectome Rewiring Rule</h3><p>Developmental synapse-formation rules learned from C. elegans connectomes, tested on held-out neuron pairs and as a frozen structural prior for learning.</p></div></section>
      <section><h2>Teaching</h2><div class="cv-entry"><h3>HSE Faculty of Computer Science</h3><p>Visiting lecturer: generative models and natural language processing. The <a href="/notes">notes</a> on this site accompany these courses.</p></div></section>
      <section><h2>Technical skills</h2><div class="skill-columns"><p><strong>Applied AI</strong><br />LLM systems, RAG, agents, multimodal models, evaluation</p><p><strong>ML engineering</strong><br />NLP, generative models, experimentation, MLOps, production integration</p><p><strong>Systems</strong><br />Architecture, tool interfaces, human-in-the-loop workflows, operational AI</p></div></section>
    </div>
  </div>
</BaseLayout>
