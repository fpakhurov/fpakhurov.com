---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseOverview from '../../../components/CourseOverview.astro';

const notes = (await getCollection('notes', ({ data }) => data.course === 'python' && data.status === 'published')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Programming in Python Notes" description="Structured notes on programming in Python: values and names, data structures, functions and classes, the data model, packaging and type hints, testing, CPython internals and concurrency, NumPy, pandas and Matplotlib." altHref="/ru/notes/python">
  <CourseOverview course="python" notes={notes} />
</BaseLayout>
