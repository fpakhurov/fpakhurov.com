---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseOverview from '../../../components/CourseOverview.astro';

const notes = (await getCollection('notes', ({ data }) => data.course === 'generative-models' && data.status === 'published')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Generative Models Notes" description="Structured notes on latent-variable, adversarial, flow-based and diffusion models." altHref="/ru/notes/generative-models">
  <CourseOverview course="generative-models" notes={notes} />
</BaseLayout>
