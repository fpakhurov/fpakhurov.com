---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseOverview from '../../../components/CourseOverview.astro';

const notes = (await getCollection('notes', ({ data }) => data.course === 'mlops' && data.status === 'published')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="MLOps Notes" description="Structured notes on MLOps: ML system design, data pipelines and validation, features, reproducible and distributed training, serving and LLM inference, rollouts, monitoring and drift, retraining, LLMOps, fairness and cost." altHref="/ru/notes/mlops">
  <CourseOverview course="mlops" notes={notes} />
</BaseLayout>
