---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseOverview from '../../../components/CourseOverview.astro';

const notes = (await getCollection('notes', ({ data }) => data.course === 'math' && data.status === 'published')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Mathematics for Machine Learning Notes" description="Structured notes on the mathematics of machine learning: linear algebra and matrix decompositions, multivariable and matrix calculus, convex optimization and duality, numerical conditioning." altHref="/ru/notes/math">
  <CourseOverview course="math" notes={notes} />
</BaseLayout>
