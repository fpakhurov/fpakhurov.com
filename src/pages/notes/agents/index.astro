---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseOverview from '../../../components/CourseOverview.astro';

const notes = (await getCollection('notes', ({ data }) => data.course === 'agents' && data.status === 'published')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="AI Agents Notes" description="Structured notes on AI agents: search and Markov decision processes, reinforcement learning, language-model agents with reasoning, tools, memory and planning, coding and computer-use agents, training with reinforcement learning, evaluation and safety." altHref="/ru/notes/agents">
  <CourseOverview course="agents" notes={notes} />
</BaseLayout>
