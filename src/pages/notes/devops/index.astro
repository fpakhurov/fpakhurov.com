---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseOverview from '../../../components/CourseOverview.astro';

const notes = (await getCollection('notes', ({ data }) => data.course === 'devops' && data.status === 'published')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="DevOps Notes" description="Structured notes on DevOps: the shell and Git, builds and containers, CI/CD, networking and infrastructure as code, Kubernetes, observability, SLOs, resilience and incident response." altHref="/ru/notes/devops">
  <CourseOverview course="devops" notes={notes} />
</BaseLayout>
