---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourseOverview from '../../components/CourseOverview.astro';
import { courses } from '../../utils/courses';
import { dataCoursePlans, type DataCourseKey } from '../../utils/dataEngineering';

export function getStaticPaths() {
  return dataCoursePlans.map(({ key }) => ({ params: { course: key } }));
}
const course = Astro.params.course as DataCourseKey;
const config = courses[course];
const notes = (await getCollection('notes', ({ data }) => data.course === course && data.status === 'published')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={`${config.title} Notes`} description={config.description} altHref={`/ru/notes/${course}`}>
  <CourseOverview course={course} notes={notes} />
</BaseLayout>
