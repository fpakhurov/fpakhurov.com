---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseOverview from '../../../components/CourseOverview.astro';

const notes = (await getCollection('notes', ({ data }) => data.course === 'ml' && data.status === 'published')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Machine Learning Notes" description="Structured notes on machine learning: the learning problem, linear models, trees and ensembles, neural networks and learning without labels." altHref="/ru/notes/ml">
  <CourseOverview course="ml" notes={notes} />
</BaseLayout>
