---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseOverview from '../../../components/CourseOverview.astro';

const notes = (await getCollection('notes', ({ data }) => data.course === 'probability' && data.status === 'published')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Probability Theory Notes" description="Structured notes on probability theory: events, random variables, limit theorems, estimation and sampling, with what each gives to machine learning." altHref="/ru/notes/probability">
  <CourseOverview course="probability" notes={notes} />
</BaseLayout>
