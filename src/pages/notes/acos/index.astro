---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseOverview from '../../../components/CourseOverview.astro';

const notes = (await getCollection('notes', ({ data }) => data.course === 'acos' && data.status === 'published')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Computer Architecture and Operating Systems Notes" description="Structured notes on how a computer runs a program: data representation, RISC-V assembly, caches and virtual memory, the processor pipeline, parallelism, and the operating system from system calls to sockets." altHref="/ru/notes/acos">
  <CourseOverview course="acos" notes={notes} />
</BaseLayout>
