---
import { getCollection, render } from 'astro:content';
import NoteLayout from '../../layouts/NoteLayout.astro';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => data.status === 'published');
  return notes.map((note) => ({
    params: { slug: note.id },
    props: { note, allNotes: notes.filter((entry) => entry.data.course === note.data.course) },
  }));
}

const { note, allNotes } = Astro.props;
const { Content, headings } = await render(note);
---

<NoteLayout note={note} allNotes={allNotes} headings={headings}>
  <Content />
</NoteLayout>
