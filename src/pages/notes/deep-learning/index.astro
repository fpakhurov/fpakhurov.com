---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseOverview from '../../../components/CourseOverview.astro';

const notes = (await getCollection('notes', ({ data }) => data.course === 'deep-learning' && data.status === 'published')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Deep Learning Notes" description="Structured notes on deep learning: training neural networks in PyTorch, convolutional networks for vision, self-supervised learning and Vision Transformers, robustness and model compression." altHref="/ru/notes/deep-learning">
  <CourseOverview course="deep-learning" notes={notes} />
</BaseLayout>
