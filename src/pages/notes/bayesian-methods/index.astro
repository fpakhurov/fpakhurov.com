---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseOverview from '../../../components/CourseOverview.astro';

const notes = (await getCollection('notes', ({ data }) => data.course === 'bayesian-methods' && data.status === 'published')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Bayesian Methods Notes" description="Structured notes on Bayesian methods in machine learning: conjugate priors and model evidence, Bayesian linear models, EM, variational inference and Gibbs sampling, Gaussian and Dirichlet processes, and scalable variational inference." altHref="/ru/notes/bayesian-methods">
  <CourseOverview course="bayesian-methods" notes={notes} />
</BaseLayout>
