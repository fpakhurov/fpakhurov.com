---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CourseOverview from '../../../components/CourseOverview.astro';

const notes = (await getCollection('notes', ({ data }) => data.course === 'nlp' && data.status === 'published')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="NLP Notes" description="A structured set of notes from NLP foundations to Transformers and modern LLM systems." altHref="/ru/notes/nlp">
  <CourseOverview course="nlp" notes={notes} />
</BaseLayout>
