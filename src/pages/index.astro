---
import BaseLayout from '../layouts/BaseLayout.astro';
import SystemsChain from '../components/SystemsChain.astro';
import { channelLabel, externalLink, github } from '../config/profile';
---

<BaseLayout>
  <section class="hero shell">
    <div class="hero-kicker"><span>Profile / 01</span><span>AI systems · research · notes</span></div>
    <div class="hero-grid">
      <div>
        <p class="eyebrow">AI / ML Engineer</p>
        <h1>Fedor<br />Pakhurov</h1>
      </div>
      <div class="hero-copy">
        <h2>LLM systems, agents and applied AI products.</h2>
        <p>Builds applied AI systems around LLMs, retrieval, agents and multimodal models—with a focus on turning prototypes into useful products.</p>
        <nav class="hero-actions" aria-label="Profile links">
          <a class="button primary" href="/work">Selected work <span>→</span></a>
          <a class="button" href="/notes">Technical notes <span>→</span></a>
        </nav>
        <div class="text-links">
          <a href="/cv">CV</a>{github && <a href={github.href} aria-label={channelLabel(github, 'en', false)} {...externalLink}>GitHub ↗</a>}<a href="/contact">Contact</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section shell" aria-labelledby="selected-heading">
    <div class="section-head">
      <p class="section-index">02 / Selected</p>
      <h2 id="selected-heading">Work at the intersection of models and operations.</h2>
      <p>Selected areas of practice, from production LLM services to the systems around them.</p>
    </div>
    <div class="highlight-grid">
      <article class="highlight-card accent-card">
        <p class="card-number">01</p>
        <div><p class="eyebrow">Applied LLM products</p><h3>From prototype to dependable internal service.</h3></div>
        <p>RAG, agents, multimodal prototypes and the production integration required to make them useful.</p>
        <a href="/work">Read case studies <span>↗</span></a>
      </article>
      <article class="highlight-card">
        <p class="card-number">02</p>
        <div><p class="eyebrow">Multi-agent systems</p><h3>Coordinated agents for inventory operations.</h3></div>
        <p>Supply, transit and export specialists, coordinated around context, proposed actions and explicit confirmation.</p>
        <a href="/work#multi-agent">View architecture <span>↗</span></a>
      </article>
      <article class="highlight-card research-card">
        <p class="card-number">03</p>
        <div><p class="eyebrow">Research</p><h3>Evaluating diffusion model hallucinations.</h3></div>
        <p>Complexity–entropy analysis, Rényi entropy, Bandt–Pompe and clustering for hallucination severity estimation.</p>
        <a href="/projects">Explore projects <span>↗</span></a>
      </article>
    </div>
  </section>

  <section class="section shell chain-section" aria-labelledby="chain-heading">
    <div class="section-head compact">
      <p class="section-index">03 / Systems</p>
      <h2 id="chain-heading">AI transformation is a chain, not a feature.</h2>
    </div>
    <SystemsChain />
  </section>

  <section class="section shell notes-preview" aria-labelledby="notes-heading">
    <div class="section-head">
      <p class="section-index">04 / Knowledge</p>
      <h2 id="notes-heading">Notes built to be studied, not scrolled.</h2>
      <p>Structured technical collections with prerequisites, equations, permanent URLs and clear progression.</p>
    </div>
    <div class="course-grid">
      <a class="course-card" href="/notes/nlp"><span class="course-code">NLP / 01</span><h3>Natural Language Processing</h3><p>From tokenization and representations to Transformers, RAG and agents.</p><span class="course-link">Open collection →</span></a>
      <a class="course-card" href="/notes/generative-models"><span class="course-code">GEN / 02</span><h3>Generative Models</h3><p>Likelihoods, latent variables, VAEs, GANs, flows and diffusion models.</p><span class="course-link">Open collection →</span></a>
    </div>
  </section>
</BaseLayout>
