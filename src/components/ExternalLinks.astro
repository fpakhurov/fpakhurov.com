---
// Compact external actions (Paper / Code / PDF / BibTeX / Article / Results). Only real links are passed in.
interface Props {
  links: { kind: 'paper' | 'code' | 'pdf' | 'bibtex' | 'article' | 'results'; href: string; lang: 'en' | 'ru' }[];
  lang?: 'en' | 'ru';
  long?: boolean;
}
const { links, lang = 'en', long = false } = Astro.props;
const labels = {
  en: { paper: 'Paper', code: 'Code', pdf: 'PDF', bibtex: 'BibTeX', article: long ? 'Read article' : 'Article', results: 'Results' },
  ru: { paper: 'Публикация', code: 'Код', pdf: 'PDF', bibtex: 'BibTeX', article: long ? 'Читать статью' : 'Статья', results: 'Результаты' },
}[lang];
---

{links.map((link) => (
  <a href={link.href} hreflang={link.lang !== lang ? link.lang : undefined}>
    {labels[link.kind]}{link.lang !== lang && <span class="link-lang">{link.lang.toUpperCase()}</span>} ↗
  </a>
))}
