---
import type { CollectionEntry } from 'astro:content';
import { courses, type CourseKey } from '../utils/courses';

interface Props {
  course: CourseKey;
  notes: CollectionEntry<'notes'>[];
}
const { course, notes } = Astro.props;
const config = courses[course];
const noteByTitle = new Map(notes.map((note) => [note.data.title.toLowerCase(), note]));
---

<section class="course-overview shell">
  <div class="course-summary">
    <p class="eyebrow">Course / {course === 'nlp' ? '01' : '02'}</p>
    <h1>{config.title}</h1>
    <p>{config.description}</p>
    <div class="course-stats">
      <span><strong>{config.sections.length}</strong> sections</span>
      <span><strong>{notes.length}</strong> published notes</span>
      <span><strong>∞</strong> permanent URLs</span>
    </div>
  </div>
  <section class="available-notes" aria-labelledby="available-notes-heading">
    <p class="eyebrow">Available now</p>
    <div>
      <h2 id="available-notes-heading">Published notes</h2>
      <ol>
        {notes.map((note, index) => (
          <li><a href={`/notes/${note.id}`}><span>{String(index + 1).padStart(2, '0')}</span><strong>{note.data.title}</strong><em>{note.data.section}</em><i>Read →</i></a></li>
        ))}
      </ol>
    </div>
  </section>
  <ol class="syllabus">
    {config.sections.map((section, sectionIndex) => (
      <li class="syllabus-section">
        <div class="syllabus-heading"><span>{String(sectionIndex + 1).padStart(2, '0')}</span><h2>{section.title}</h2></div>
        <ul>
          {section.topics.map((topic) => {
            const note = noteByTitle.get(topic.toLowerCase());
            return <li class={note ? 'available' : ''}>{note ? <a href={`/notes/${note.id}`}>{topic}<span>Read →</span></a> : <span>{topic}<small>Planned</small></span>}</li>;
          })}
        </ul>
      </li>
    ))}
  </ol>
</section>
