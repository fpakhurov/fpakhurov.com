---
import type { CollectionEntry } from 'astro:content';
import { courses, type CourseKey } from '../utils/courses';

interface Props {
  course: CourseKey;
  notes: CollectionEntry<'notes'>[];
  lang?: 'en' | 'ru';
  /** Ids of notes that have a Russian translation. */
  translated?: Set<string>;
}
const { course, notes, lang = 'en', translated } = Astro.props;
const config = courses[course];
const ru = lang === 'ru';
const tr = (text: string) => (ru ? config.ru.labels[text] ?? text : text);
const prefix = ru ? '/ru/notes' : '/notes';
const translatedCount = translated ? notes.filter((note) => translated.has(note.id)).length : 0;
const noteById = new Map(notes.map((note) => [note.id, note]));
const allTopics = config.sections.flatMap((section) => section.topics);
// COURSE_LENIENT=1 lets a partially written course build while notes are drafted;
// the published build always runs the strict checks.
const lenient = process.env.COURSE_LENIENT === '1';
const linkedTopics = allTopics.filter((topic) => typeof topic !== 'string').filter((topic) => {
  if (noteById.has(topic.note)) return true;
  if (lenient) return false;
  throw new Error(`Course topic "${topic.title}" references an unavailable note: ${topic.note}`);
});
const linkedNoteIds = new Set(linkedTopics.map((topic) => topic.note));
for (const note of notes) {
  if (!linkedNoteIds.has(note.id)) throw new Error(`Published note is missing from the course plan: ${note.id}`);
}
// Every published note must declare the section it is listed under, so the
// course map and the note sidebars agree.
for (const section of config.sections) {
  for (const topic of section.topics) {
    if (typeof topic === 'string') continue;
    const note = noteById.get(topic.note);
    if (!note) continue;
    if (!topic.anchor && note.data.section !== section.title) {
      throw new Error(`Note ${note.id} declares section "${note.data.section}" but is listed under "${section.title}"`);
    }
  }
}
const publishedTopics = linkedTopics.length;
const plannedTopics = allTopics.length - publishedTopics;
const progress = Math.round((publishedTopics / allTopics.length) * 100);
const courseIndex = Object.keys(courses).indexOf(course) + 1;
---

<section class="course-overview shell">
  <div class="course-summary">
    <p class="eyebrow">{ru ? 'Курс' : 'Course'} / {String(courseIndex).padStart(2, '0')}</p>
    <h1>{ru ? config.ru.title : config.title}</h1>
    <div class="course-intro">
      <p>{ru ? config.ru.description : config.description}</p>
      <p class="course-tagline">{ru ? config.ru.tagline ?? config.tagline : config.tagline}</p>
    </div>
    <div class="course-stats">
      <span><strong>{config.sections.length}</strong> {ru ? 'разделов' : 'sections'}</span>
      <span><strong>{notes.length}</strong> {ru ? 'опубликованных заметок' : 'published notes'}</span>
      {ru && translated && <span><strong>{translatedCount}</strong> переведено</span>}
      <span><strong>{plannedTopics}</strong> {ru ? 'тем в планах' : 'planned topics'}</span>
      <span class="course-progress" role="img" aria-label={ru ? `Опубликовано ${progress}% запланированных тем` : `${progress}% of planned topics are published`}>
        <span class="course-progress-bar"><span style={`width:${progress}%`} /></span>
        <strong>{progress}%</strong> {ru ? 'опубликовано' : 'published'}
      </span>
    </div>
    <ol class="course-progression" aria-label={ru ? 'Последовательность курса' : 'Course progression'}>
      {(ru ? config.ru.progression ?? config.progression : config.progression).map((stage) => <li>{stage}</li>)}
    </ol>
  </div>
  <ol class="syllabus">
    {config.sections.map((section, sectionIndex) => {
      const sectionPublished = section.topics.filter((topic) => typeof topic !== 'string').length;
      return (
        <li class="syllabus-section" id={`section-${sectionIndex + 1}`}>
          <div class="syllabus-heading">
            <span>{String(sectionIndex + 1).padStart(2, '0')}</span>
            <div>
              <h2>{tr(section.title)}</h2>
              {section.summary && <p>{tr(section.summary)}</p>}
              <small>{ru ? `Опубликовано ${sectionPublished} из ${section.topics.length}` : `${sectionPublished} of ${section.topics.length} published`}</small>
            </div>
          </div>
          <ul>
            {section.topics.map((topic) => {
              const title = tr(typeof topic === 'string' ? topic : topic.title);
              const note = typeof topic === 'string' ? undefined : noteById.get(topic.note);
              const anchor = typeof topic === 'string' || !topic.anchor ? '' : `#${topic.anchor}`;
              return <li class={note ? 'available' : 'planned'}>{note ? <a href={`${prefix}/${note.id}${anchor}`}>{title}{ru && translated && !translated.has(note.id) && <small>EN</small>}<span aria-hidden="true">{ru ? (anchor ? 'Раздел →' : 'Читать →') : (anchor ? 'Section →' : 'Read →')}</span></a> : <span>{title}<small>{ru ? 'В планах' : 'Planned'}</small></span>}</li>;
            })}
          </ul>
        </li>
      );
    })}
  </ol>
</section>
