---
interface Props {
  index: string;
  eyebrow: string;
  title: string;
  description: string;
}
const { index, eyebrow, title, description } = Astro.props;
---

<header class="page-intro shell">
  <div class="page-intro-meta"><span>{index}</span><span>{eyebrow}</span></div>
  <div class="page-intro-grid">
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</header>
