---
import { channelLabel, externalLink, footerProfiles, type Lang } from '../config/profile';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <p>© {new Date().getFullYear()} {lang === 'ru' ? 'Фёдор Пахуров' : 'Fedor Pakhurov'}</p>
    <p>{lang === 'ru' ? 'Москва · создаю полезные AI-системы' : 'Moscow · building useful AI systems'}</p>
    <nav aria-label={lang === 'ru' ? 'Профили и контакт' : 'Profiles and contact'}>
      <ul class="footer-links">
        {footerProfiles.map((item) => <li><a href={item.href} aria-label={channelLabel(item, lang, false)} {...externalLink}>{item.name}</a></li>)}
        <li><a href={lang === 'ru' ? '/ru/contact' : '/contact'}>{lang === 'ru' ? 'Контакт' : 'Contact'}</a></li>
      </ul>
    </nav>
  </div>
</footer>
