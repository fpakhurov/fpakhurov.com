  <div class="shell footer-inner">
    <p>© {new Date().getFullYear()} Fedor Pakhurov</p>
    <p>{lang === 'ru' ? 'Москва · создаю полезные AI-системы' : 'Moscow · building useful AI systems'}</p>
    <a href="https://github.com/fpakhurov">GitHub ↗</a>
  </div>
</footer>
