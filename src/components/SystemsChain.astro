---
const stages = [
  { title: 'Foundation', description: 'Capture and structure decisions.', start: 1, steps: ['Paper', 'Digitalization', 'Decision history', 'Business rules'] },
  { title: 'Delivery', description: 'Train, operate and support models.', start: 5, steps: ['Dataset', 'ML', 'MLOps', 'Infrastructure'] },
  { title: 'Agency', description: 'Connect models to action.', start: 9, steps: ['LLM', 'Agents'] },
];
---

<div class="systems-chain" aria-label="AI transformation maturity chain">
  {stages.map((stage, stageIndex) => (
    <div class="chain-stage">
      {stageIndex > 0 && <span class="chain-stage-connector" aria-hidden="true">↓</span>}
      <div class="chain-stage-heading"><h3>{stage.title}</h3><p>{stage.description}</p></div>
      <ol class="chain-steps" start={stage.start} aria-label={stage.title}>
        {stage.steps.map((step, index) => (
          <li class="chain-node">
            <span class="chain-number" aria-hidden="true">{String(stage.start + index).padStart(2, '0')}</span>
            <span class="chain-label">{step}</span>
            {index < stage.steps.length - 1 && <span class="chain-arrow" aria-hidden="true">→</span>}
          </li>
        ))}
      </ol>
    </div>
  ))}
</div>
