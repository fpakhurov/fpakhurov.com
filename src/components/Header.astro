---
import { counterpart } from '../utils/i18n';
import { channelLabel, externalLink, github, type Lang } from '../config/profile';

interface Props { lang?: Lang; altHref?: string }
const { lang = 'en', altHref } = Astro.props;
const prefix = lang === 'ru' ? '/ru' : '';
const nav = lang === 'ru'
  ? [['Работа', '/ru/work'], ['Проекты', '/ru/projects'], ['Конспекты', '/ru/notes'], ['Обо мне', '/ru/about'], ['CV', '/ru/cv']]
  : [['Work', '/work'], ['Projects', '/projects'], ['Notes', '/notes'], ['About', '/about'], ['CV', '/cv']];
const current = Astro.url.pathname.replace(/(.)\/$/, '$1');
const other = altHref ?? counterpart(Astro.url.pathname);
const currentState = (href: string) => current === href ? 'page' : current.startsWith(`${href}/`) ? 'location' : undefined;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={prefix || '/'} aria-label={lang === 'ru' ? 'Фёдор Пахуров, главная' : 'Fedor Pakhurov, home'}>
      <!-- The favicon's FP outlines (brand assets rev. 3), coloured by the accent so it follows the theme. -->
      <span class="wordmark-mark" aria-hidden="true"><svg viewBox="0 0 64 64" focusable="false"><g transform="translate(2 0)" fill="currentColor"><path d="M10.875 47.75Q9.559 47.75 8.808 46.974Q8.057 46.197 8.057 44.817V19.183Q8.057 17.796 8.808 17.023Q9.559 16.25 10.875 16.25H25.719Q26.883 16.25 27.591 16.89Q28.3 17.53 28.3 18.629Q28.3 19.729 27.584 20.369Q26.869 21.009 25.719 21.009H13.692V30.124H24.605Q25.726 30.124 26.402 30.738Q27.077 31.353 27.077 32.417Q27.077 33.481 26.405 34.095Q25.733 34.71 24.605 34.71H13.692V44.817Q13.692 46.197 12.941 46.974Q12.19 47.75 10.875 47.75Z"/><path d="M36.117 47.75Q34.802 47.75 34.051 46.974Q33.3 46.197 33.3 44.817V19.183Q33.3 17.796 34.051 17.023Q34.802 16.25 36.117 16.25H45.441Q48.554 16.25 50.915 17.562Q53.276 18.874 54.61 21.217Q55.943 23.561 55.943 26.688Q55.943 29.8 54.574 32.155Q53.204 34.509 50.789 35.821Q48.374 37.133 45.204 37.133H38.935V44.817Q38.935 46.197 38.184 46.974Q37.433 47.75 36.117 47.75ZM38.935 32.582H43.931Q46.922 32.582 48.564 31.044Q50.207 29.506 50.207 26.695Q50.207 23.899 48.568 22.371Q46.929 20.843 43.953 20.843H38.935Z"/></g></svg></span>
      <span>{lang === 'ru' ? 'Фёдор Пахуров' : 'Fedor Pakhurov'}</span>
    </a>
    <nav class="desktop-nav" aria-label={lang === 'ru' ? 'Основная навигация' : 'Primary navigation'}>
      {nav.map(([label, href]) => (
        <a href={href} aria-current={currentState(href)}>{label}</a>
      ))}
    </nav>
    <div class="header-meta">
      <a class="language-link" href={other} hreflang={lang === 'ru' ? 'en' : 'ru'} lang={lang === 'ru' ? 'en' : 'ru'}>{lang === 'ru' ? 'EN' : 'RU'}</a>
      {github && <a class="github-link" href={github.href} aria-label={channelLabel(github, lang, false)} {...externalLink}>GitHub ↗</a>}
    </div>
    <details class="mobile-menu">
      <summary aria-label={lang === 'ru' ? 'Открыть навигацию' : 'Open navigation'}>{lang === 'ru' ? 'Меню' : 'Menu'}</summary>
      <nav aria-label={lang === 'ru' ? 'Мобильная навигация' : 'Mobile navigation'}>
        {nav.map(([label, href]) => <a href={href} aria-current={currentState(href)}>{label}</a>)}
        <a href={other} hreflang={lang === 'ru' ? 'en' : 'ru'} lang={lang === 'ru' ? 'en' : 'ru'}>{lang === 'ru' ? 'English' : 'Русский'}</a>
        {github && <a href={github.href} aria-label={channelLabel(github, lang, false)} {...externalLink}>GitHub ↗</a>}
      </nav>
    </details>
  </div>
</header>
