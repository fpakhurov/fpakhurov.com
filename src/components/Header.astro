---
import { channelLabel, externalLink, github, type Lang } from '../config/profile';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const prefix = lang === 'ru' ? '/ru' : '';
const nav = lang === 'ru'
  ? [['Работа', '/ru/work'], ['Проекты', '/ru/projects'], ['Конспекты', '/ru/notes'], ['Обо мне', '/ru/about'], ['CV', '/ru/cv']]
  : [['Work', '/work'], ['Projects', '/projects'], ['Notes', '/notes'], ['About', '/about'], ['CV', '/cv']];
const current = Astro.url.pathname;
const currentState = (href: string) => current === href ? 'page' : current.startsWith(`${href}/`) ? 'location' : undefined;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="wordmark" href={prefix || '/'} aria-label="Fedor Pakhurov, home">
      <span class="wordmark-mark" aria-hidden="true">FP</span>
      <span>Fedor Pakhurov</span>
    </a>
    <nav class="desktop-nav" aria-label="Primary navigation">
      {nav.map(([label, href]) => (
        <a href={href} aria-current={currentState(href)}>{label}</a>
      ))}
    </nav>
    <div class="header-meta">
      <a class="language-link" href={lang === 'ru' ? '/' : '/ru/'}>{lang === 'ru' ? 'EN' : 'RU'}</a>
      {github && <a class="github-link" href={github.href} aria-label={channelLabel(github, lang, false)} {...externalLink}>GitHub ↗</a>}
    </div>
    <details class="mobile-menu">
      <summary aria-label="Open navigation">Menu</summary>
      <nav aria-label="Mobile navigation">
        {nav.map(([label, href]) => <a href={href} aria-current={currentState(href)}>{label}</a>)}
        <a href={lang === 'ru' ? '/' : '/ru/'}>{lang === 'ru' ? 'English' : 'Русский'}</a>
        {github && <a href={github.href} aria-label={channelLabel(github, lang, false)} {...externalLink}>GitHub ↗</a>}
      </nav>
    </details>
  </div>
</header>
