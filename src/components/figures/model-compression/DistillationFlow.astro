---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Op from '../seqflow/Op.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Three classes, the true class is the first. Teacher logits v = (5, 2, 0) as in the worked example of the note;
// student logits z = (3, 0, 1): right about the class, wrong about which wrong class is closer. T = 4, α = 0.5.
const v = [5, 2, 0], z = [3, 0, 1], T = 4, alpha = 0.5;
const softmax = (a: number[]) => {
  const m = Math.max(...a), e = a.map((x) => Math.exp(x - m)), s = e.reduce((p, c) => p + c, 0);
  return e.map((x) => x / s);
};
const q = softmax(v.map((x) => x / T)), p = softmax(z.map((x) => x / T));
const soft = T * T * q.reduce((s, qi, i) => s + qi * Math.log(qi / p[i]), 0);
const hard = -Math.log(softmax(z)[0]);
const total = alpha * hard + (1 - alpha) * soft;
const f3 = (x: number) => x.toFixed(3);
const quoted = [q.map(f3).join(','), p.map(f3).join(','), f3(soft), f3(hard), f3(total)].join(' ');
if (quoted !== '0.569,0.269,0.163 0.481,0.227,0.292 0.720 0.170 0.445') throw new Error(`DistillationFlow: numbers drifted (${quoted})`);
const S = (a: number[]) => a.map(String);

const t = ru
  ? {
      title: 'Дистилляция: мягкие цели учителя и функция потерь ученика',
      teacher: 'учитель', frozen: 'заморожен', student: 'ученик', trained: 'обучается', sm: 'softmax(·/4)', ce: 'CE с y',
      soft: `мягкие потери ${f3(soft)}`, hard: `жёсткие потери ${f3(hard)}`, mix: 'α·жёст. + (1−α)·мягк.', total: `= ${f3(total)}`,
      steps: ['логиты учителя делятся на T = 4: мягкие цели q', 'логиты ученика делятся на ту же T: его предсказание p', 'мягкие потери: KL(q ‖ p), умноженная на T² = 16', 'жёсткие потери: кросс-энтропия логитов ученика при T = 1 с меткой', 'сумма с весом α = 0.5; градиент идёт только в ученика'],
      desc: 'Сверху учитель: логиты (5, 2, 0) после softmax с температурой 4 дают мягкие цели (0.569, 0.269, 0.163). Ниже ученик: логиты (3, 0, 1) дают (0.481, 0.227, 0.292). KL-дивергенция между ними, умноженная на 16, равна 0.720; кросс-энтропия ученика с меткой — 0.170; их среднее — 0.445.',
    }
  : {
      title: 'Distillation: the teacher’s soft targets and the student’s loss',
      teacher: 'teacher', frozen: 'frozen', student: 'student', trained: 'trained', sm: 'softmax(·/4)', ce: 'CE with y',
      soft: `soft ${f3(soft)}`, hard: `hard ${f3(hard)}`, mix: 'α·hard + (1−α)·soft', total: `= ${f3(total)}`,
      steps: ['the teacher’s logits are divided by T = 4: the soft targets q', 'the student’s logits are divided by the same T: its prediction p', 'the soft loss: KL(q ‖ p), multiplied by T² = 16', 'the hard loss: cross-entropy of the student’s logits at T = 1 with the label', 'the sum with weight α = 0.5; the gradient flows only into the student'],
      desc: 'Top, the teacher: logits (5, 2, 0) through a softmax at temperature 4 give the soft targets (0.569, 0.269, 0.163). Below, the student: logits (3, 0, 1) give (0.481, 0.227, 0.292). The KL divergence between them times 16 is 0.720; the student’s cross-entropy with the label is 0.170; their average is 0.445.',
    };
const id = 'compress-distillation-flow';
// Op draws a pill 14 + 7.6 px per character wide; the arrows into and out of the two named ops end at its edges.
const ceHalf = (14 + t.ce.length * 7.6) / 2, mixHalf = (14 + t.mix.length * 7.6) / 2;
const hardEnd = 312 + t.hard.length * 6.6 + 6;
const caption = ru
  ? `Три класса, верный — первый. Логиты учителя v = (5, 2, 0) из разобранного примера, логиты ученика z = (3, 0, 1), T = 4, α = 0.5. Ученик уверен в верном классе, поэтому жёсткие потери малы (${f3(hard)}), но считает третий класс ближе второго, а учитель — наоборот; это замечают только мягкие потери (${f3(soft)}). Логиты делятся на T в обеих ветках; мягкие потери умножаются на T², чтобы их градиент не уменьшался как 1/T². После обучения ученик работает при T = 1.`
  : `Three classes, the first is correct. Teacher logits v = (5, 2, 0) from the worked example, student logits z = (3, 0, 1), T = 4, α = 0.5. The student is confident in the correct class, so the hard loss is small (${f3(hard)}), but it ranks the third class above the second where the teacher does the opposite; only the soft loss sees this (${f3(soft)}). Both branches divide the logits by T; the soft loss is multiplied by T² so that its gradient does not shrink like 1/T². After training the student runs at T = 1.`;
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 356" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <Box x={16} y={117} w={44} h={36} label="x" tone="x" />
    <g data-s="1">
      <Arrow pts={[[60, 128], [76, 128], [76, 70], [94, 70]]} />
      <Box x={96} y={48} w={96} h={44} label={t.teacher} sub={t.frozen} />
      <Arrow pts={[[192, 70], [214, 70]]} />
      <Vec x={216} y={37} values={S(v)} tone="y" cw={44} label="v" />
      <Arrow pts={[[260, 70], [291, 70]]} />
      <Op x={346} y={70} sym={t.sm} />
      <Arrow pts={[[399, 70], [424, 70]]} />
      <Vec x={426} y={37} values={q.map(f3)} tone="y" cw={56} label="q" />
      <Badge x={144} y={34} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[60, 142], [76, 142], [76, 200], [94, 200]]} />
      <Box x={96} y={178} w={96} h={44} label={t.student} sub={t.trained} />
      <Arrow pts={[[192, 200], [214, 200]]} />
      <Vec x={216} y={167} values={S(z)} tone="y" cw={44} label="z" />
      <Arrow pts={[[260, 200], [291, 200]]} />
      <Op x={346} y={200} sym={t.sm} />
      <Arrow pts={[[399, 200], [424, 200]]} />
      <Vec x={426} y={167} values={p.map(f3)} tone="y" cw={56} label="p" />
      <Badge x={144} y={164} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[482, 70], [540, 70], [540, 120]]} />
      <Arrow pts={[[482, 200], [540, 200], [540, 150]]} />
      <Op x={540} y={135} sym="KL · T²" tone="amber" />
      <Arrow pts={[[574, 135], [600, 135]]} tone="amber" />
      <text class="f-small" x="606" y="140">{t.soft}</text>
      <Badge x={590} y={112} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[238, 233], [238, 275]]} />
      <Op x={238} y={290} sym={t.ce} />
      <Arrow pts={[[238 + ceHalf, 290], [306, 290]]} />
      <text class="f-small" x="312" y="295">{t.hard}</text>
      <Badge x={180} y={290} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[hardEnd, 290], [570 - mixHalf - 1, 290]]} />
      <Arrow pts={[[630, 148], [630, 275]]} tone="amber" />
      <Op x={570} y={290} sym={t.mix} tone="amber" />
      <text class="f-label" x="570" y="327" text-anchor="middle">{t.total}</text>
      <Badge x={570} y={257} n={5} />
    </g>
    <Legend x={16} y={348} step={120} rows={1} />
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 470" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <Box x={16} y={6} w={40} h={30} label="x" tone="x" />
    <g data-s="1">
      <Arrow pts={[[36, 36], [36, 52]]} />
      <Box x={10} y={54} w={80} h={44} label={t.teacher} sub={t.frozen} />
      <Arrow pts={[[90, 76], [104, 76]]} />
      <Vec x={106} y={43} values={S(v)} tone="y" cw={36} label="v" />
      <Arrow pts={[[142, 76], [158, 76]]} />
      <Op x={212} y={76} sym={t.sm} />
      <Arrow pts={[[265, 76], [280, 76]]} />
      <Vec x={282} y={43} values={q.map(f3)} tone="y" cw={56} label="q" />
      <Badge x={160} y={42} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[16, 21], [4, 21], [4, 206], [8, 206]]} />
      <Box x={10} y={184} w={80} h={44} label={t.student} sub={t.trained} />
      <Arrow pts={[[90, 206], [104, 206]]} />
      <Vec x={106} y={173} values={S(z)} tone="y" cw={36} label="z" />
      <Arrow pts={[[142, 206], [158, 206]]} />
      <Op x={212} y={206} sym={t.sm} />
      <Arrow pts={[[265, 206], [280, 206]]} />
      <Vec x={282} y={173} values={p.map(f3)} tone="y" cw={56} label="p" labelPos="below" />
      <Badge x={160} y={172} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[310, 109], [310, 127]]} />
      <Arrow pts={[[310, 173], [310, 155]]} />
      <Op x={310} y={141} sym="KL · T²" tone="amber" />
      <Arrow pts={[[344, 141], [352, 141], [352, 300]]} tone="amber" head={false} />
      <text class="f-small f-halo" x="346" y="282" text-anchor="end">{t.soft}</text>
      <Badge x={256} y={141} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[124, 239], [124, 285]]} />
      <Op x={124} y={300} sym={t.ce} />
      <Arrow pts={[[124 + ceHalf, 300], [184, 300]]} />
      <text class="f-small" x="190" y="305">{t.hard}</text>
      <Badge x={60} y={300} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[124, 313], [124, 362]]} />
      <Arrow pts={[[352, 300], [352, 377], [190 + mixHalf + 1, 377]]} tone="amber" />
      <Op x={190} y={377} sym={t.mix} tone="amber" />
      <text class="f-label" x="190" y="414" text-anchor="middle">{t.total}</text>
      <Badge x={60} y={377} n={5} />
    </g>
    <Legend x={16} y={444} step={170} rows={2} />
  </svg>
  <Stepper steps={t.steps} />
</Figure>
