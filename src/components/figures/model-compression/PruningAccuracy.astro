---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The Code section of the note (one run): a teacher 64 -> 512 -> 512 -> 10 with 301,066 parameters, test accuracy 0.976
// on 540 digits. Unstructured: global magnitude pruning of the weights at sparsity s, kept fraction 1 - s.
// Structured: hidden units kept by incoming-weight norm, 256 / 128 / 64 / 32 per layer, as a smaller dense network.
// "Pruned" is before fine-tuning, "fine-tuned" after 10 epochs (with the mask fixed for unstructured pruning).
const teacherAcc = 0.976, teacherParams = 301066;
const unKept = [0.5, 0.2, 0.1, 0.05, 0.02];
const unPruned = [0.978, 0.967, 0.887, 0.444, 0.126];
const unTuned = [0.98, 0.981, 0.981, 0.963, 0.7];
const stParams = [256, 128, 64, 32].map((k) => 64 * k + k + k * k + k + 10 * k + 10);
if (stParams.join(' ') !== '85002 26122 8970 3466') throw new Error(`PruningAccuracy: parameter counts drifted (${stParams.join(' ')})`);
const stKept = stParams.map((p) => p / teacherParams);
const stPruned = [0.956, 0.869, 0.656, 0.369];
const stTuned = [0.978, 0.97, 0.957, 0.922];
if (Math.abs(stKept[1] - 0.0868) > 5e-4) throw new Error('PruningAccuracy: 128 units should keep 8.7% of the parameters');

const t = ru
  ? { title: 'Доля правильных ответов после неструктурированного и структурированного прунинга', x: 'доля оставленных параметров (лог. шкала)', y: 'доля правильных ответов',
      series: ['по весам, сразу', 'по весам, дообучена', 'по нейронам, сразу', 'по нейронам, дообучена', `учитель ${teacherAcc}`],
      desc: 'Доля правильных ответов на тесте в зависимости от доли оставленных параметров, от 1% до 100%. Без дообучения доля правильных ответов падает уже при 10% весов (0.887); после 10 эпох дообучения 10% весов дают 0.981. Структурированный прунинг до 128 нейронов в слое (8.7% параметров) после дообучения даёт 0.970; 32 нейрона (1.2%) — 0.922.' }
  : { title: 'Accuracy after pruning: unstructured and structured', x: 'fraction of parameters kept (log scale)', y: 'test accuracy',
      series: ['unstructured, pruned', 'unstructured, fine-tuned', 'structured, pruned', 'structured, fine-tuned', `teacher ${teacherAcc}`],
      desc: 'Test accuracy against the fraction of parameters kept, from 1% to 100%. Without fine-tuning, accuracy drops already at 10% of the weights (0.887); after 10 epochs of fine-tuning, 10% of the weights give 0.981. Structured pruning to 128 units per layer (8.7% of the parameters) gives 0.970 after fine-tuning; 32 units (1.2%) give 0.922.' };
const series = [
  { cls: 'f-line f-blue f-dash', dot: 'f-solid-blue', xs: unKept, ys: unPruned },
  { cls: 'f-line f-blue', dot: 'f-solid-blue', xs: unKept, ys: unTuned },
  { cls: 'f-line f-red f-dash', dot: 'f-solid-red', xs: stKept, ys: stPruned },
  { cls: 'f-line f-red', dot: 'f-solid-red', xs: stKept, ys: stTuned },
];
const id = 'compress-pruning-accuracy';
const caption = ru
  ? 'Учитель 64 → 512 → 512 → 10 (301 066 параметров, доля правильных ответов 0.976) на 540 тестовых цифрах, один запуск из раздела «Код». Синие линии — неструктурированный глобальный прунинг по модулю веса (по горизонтали доля оставленных весов), красные — структурированный: удаление нейронов скрытых слоёв (доля параметров меньшей плотной сети). Пунктир — сразу после прунинга, сплошные — после 10 эпох дообучения. Дообучение почти полностью восстанавливает долю правильных ответов, пока не удалено больше 95% весов.'
  : 'The teacher 64 → 512 → 512 → 10 (301,066 parameters, accuracy 0.976) on 540 test digits, one run of the Code section. Blue: global magnitude pruning (horizontal axis: the fraction of weights kept); red: removing hidden units (the fraction of parameters of the smaller dense network). Dashed: right after pruning; solid: after 10 epochs of fine-tuning. Fine-tuning recovers almost all the accuracy until more than 95% of the weights are gone.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 320, px: [70, 520] as [number, number], py: [30, 250] as [number, number], leg: [548, 50] as [number, number] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 440, px: [56, 340] as [number, number], py: [30, 250] as [number, number], leg: [20, 316] as [number, number] },
];
const ticks = [0.01, 0.02, 0.05, 0.1, 0.2, 0.5, 1];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => {
    const sxl = scale([-2, 0], Ly.px), sx = (v: number) => sxl(Math.log10(v)), sy = scale([0, 1], [Ly.py[1], Ly.py[0]]);
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
        {[0.25, 0.5, 0.75, 1].map((v) => <path class="f-grid" d={`M ${Ly.px[0]} ${sy(v)} H ${Ly.px[1]}`} />)}
        <path class="f-axis" d={`M ${Ly.px[0]} ${Ly.py[0]} V ${Ly.py[1]} H ${Ly.px[1]}`} />
        {ticks.map((v) => <text class="f-note" x={sx(v)} y={Ly.py[1] + 18} text-anchor="middle">{`${Math.round(v * 100)}%`}</text>)}
        {[0, 0.5, 1].map((v) => <text class="f-note" x={Ly.px[0] - 7} y={sy(v) + 5} text-anchor="end">{v === 0 ? '0' : v.toFixed(1)}</text>)}
        <text class="f-small f-t-muted" x={(Ly.px[0] + Ly.px[1]) / 2} y={Ly.py[1] + 40} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={Ly.px[0] - 44} y={Ly.py[0] - 14}>{t.y}</text>
        <path class="f-thin f-muted f-dot" d={`M ${Ly.px[0]} ${sy(teacherAcc)} H ${Ly.px[1]}`} />
        <circle cx={sx(1)} cy={sy(teacherAcc)} r="4" class="f-fill-ink" />
        {series.map((s) => (
          <g>
            <path class={s.cls} d={polyline(s.xs.map((x, i) => [sx(x), sy(s.ys[i])]))} />
            {s.xs.map((x, i) => <circle cx={sx(x)} cy={sy(s.ys[i])} r="3.4" class={s.dot} />)}
          </g>
        ))}
        {series.map((s, i) => (
          <g>
            <path class={s.cls} d={`M ${Ly.leg[0]} ${Ly.leg[1] + 22 * i - 4} h 26`} />
            <text class="f-small" x={Ly.leg[0] + 34} y={Ly.leg[1] + 22 * i}>{t.series[i]}</text>
          </g>
        ))}
        <path class="f-thin f-muted f-dot" d={`M ${Ly.leg[0]} ${Ly.leg[1] + 22 * 4 - 4} h 26`} />
        <text class="f-small" x={Ly.leg[0] + 34} y={Ly.leg[1] + 22 * 4}>{t.series[4]}</text>
      </svg>
    );
  })}
</Figure>
