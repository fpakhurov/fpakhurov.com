---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { normals } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// An 8 x 8 weight matrix with standard normal entries (seeded), pruned to 50% in three ways.
const n = 8;
const w = normals(n * n, 11);
const W = Array.from({ length: n }, (_, i) => w.slice(i * n, i * n + n));
const abs = W.map((r) => r.map(Math.abs));
const total = w.reduce((s, x) => s + x * x, 0);
// unstructured: keep the 32 largest |w| of the whole matrix
const thr = [...w].map(Math.abs).sort((a, b) => b - a)[n * n / 2 - 1];
const unstructured = abs.map((r) => r.map((a) => a >= thr));
// 2:4: in every group of four consecutive weights of a row, keep the two largest
const twoFour = abs.map((r) => r.map((a, j) => {
  const g = r.slice(j - (j % 4), j - (j % 4) + 4);
  return g.filter((b) => b > a).length < 2;
}));
// structured: keep the four rows with the largest norms
const norms = W.map((r) => r.reduce((s, x) => s + x * x, 0));
const keepRows = [...norms.keys()].sort((a, b) => norms[b] - norms[a]).slice(0, n / 2);
const structured = W.map((r, i) => r.map(() => keepRows.includes(i)));
const dense = W.map((r) => r.map(() => true));
const count = (m: boolean[][]) => m.flat().filter(Boolean).length;
const share = (m: boolean[][]) => W.flat().reduce((s, x, k) => s + (m.flat()[k] ? x * x : 0), 0) / total;
if ([unstructured, twoFour, structured].some((m) => count(m) !== n * n / 2)) throw new Error('PruningPatterns: every pattern must keep 32 weights');
const sh = [dense, unstructured, twoFour, structured].map(share);
if (!(sh[1] >= sh[2] && sh[2] >= sh[3])) throw new Error(`PruningPatterns: unexpected order of kept norms (${sh.join(' ')})`);
const pct = (x: number) => `${Math.round(100 * x)}%`;
const maxAbs = Math.max(...w.map(Math.abs));

const t = ru
  ? {
      title: 'Три способа выбросить половину весов',
      heads: ['плотная', 'неструктурированная, 50%', '2:4', 'структур.: 4 строки'],
      line1: ['64 веса', '32 в любых местах', '32, по 2 из каждых 4', '32 как плотная 4 × 8'],
      of: 'от ‖W‖²',
      steps: ['плотная матрица весов слоя, 8 выходов × 8 входов', 'неструктурированная: обнуляются 32 наименьших по модулю веса всей матрицы', '2:4: в каждой четвёрке соседних весов строки обнуляются два наименьших', 'структурированная: удаляются 4 строки с наименьшей нормой, остаётся плотная матрица 4 × 8'],
      desc: `Четыре матрицы 8 × 8; насыщенность клетки — модуль веса, пунктирные клетки — обнулённые веса. Каждый способ оставляет 32 веса из 64: неструктурированный прунинг — ${pct(sh[1])} квадрата нормы, 2:4 — ${pct(sh[2])}, удаление четырёх строк — ${pct(sh[3])}.`,
    }
  : {
      title: 'Three ways to remove half of the weights',
      heads: ['dense', 'unstructured, 50%', '2:4', 'structured: 4 rows'],
      line1: ['64 weights', '32 kept, anywhere', '32 kept, 2 in each 4', '32 kept as 4 × 8'],
      of: 'of ‖W‖²',
      steps: ['the dense weight matrix of a layer, 8 outputs × 8 inputs', 'unstructured: the 32 smallest weights of the whole matrix are zeroed', '2:4: in every four consecutive weights of a row, the two smallest are zeroed', 'structured: the 4 rows with the smallest norms are removed, leaving a dense 4 × 8'],
      desc: `Four 8 × 8 matrices; the shade of a cell is the magnitude of its weight, dashed cells are zeroed weights. Each pattern keeps 32 of 64 weights: unstructured keeps ${pct(sh[1])} of the squared norm, 2:4 keeps ${pct(sh[2])}, removing four rows ${pct(sh[3])}.`,
    };
const id = 'compress-pruning-patterns';
const caption = ru
  ? `Матрица 8 × 8 со стандартными нормальными весами; насыщенность клетки пропорциональна модулю веса, пунктир — нули. Все три способа оставляют 32 веса, но разную долю квадрата нормы: выбор без ограничений — наибольшую (${pct(sh[1])}), 2:4 — чуть меньше (${pct(sh[2])}), целые строки — меньше всех (${pct(sh[3])}). Зато только структурированная версия — обычная плотная матрица меньшего размера, которую любое оборудование умножает быстрее; шаблон 2:4 ускоряют разреженные тензорные ядра GPU, а разбросанные нули не ускоряют плотное умножение вовсе.`
  : `An 8 × 8 matrix of standard normal weights; the shade of a cell is proportional to the magnitude of its weight, dashed cells are zeros. All three patterns keep 32 weights, but different shares of the squared norm: the unconstrained choice keeps the most (${pct(sh[1])}), 2:4 slightly less (${pct(sh[2])}), whole rows the least (${pct(sh[3])}). In exchange, only the structured version is an ordinary smaller dense matrix, which any hardware multiplies faster; 2:4 is accelerated by the sparse tensor cores of GPUs, and scattered zeros do not speed up a dense product at all.`;
const masks = [dense, unstructured, twoFour, structured];
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 236, c: 17, panels: [[24, 44], [214, 44], [404, 44], [594, 44]] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 424, c: 15, panels: [[36, 40], [204, 40], [36, 248], [204, 248]] },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => (
    <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
      <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
      {masks.map((mask, k) => {
        const [x0, y0] = Ly.panels[k];
        const side = n * Ly.c;
        return (
          <g data-s={String(k + 1)}>
            <text class="f-small" x={x0 + side / 2} y={y0 - 12} text-anchor="middle">{t.heads[k]}</text>
            {W.map((row, i) => row.map((x, j) => (
              mask[i][j]
                ? <rect x={x0 + j * Ly.c} y={y0 + i * Ly.c} width={Ly.c} height={Ly.c} style={`fill: var(--fig-amber); fill-opacity: ${(0.12 + 0.78 * Math.abs(x) / maxAbs).toFixed(3)}; stroke: var(--fig-amber); stroke-width: 0.8`} />
                : <rect x={x0 + j * Ly.c + 1.5} y={y0 + i * Ly.c + 1.5} width={Ly.c - 3} height={Ly.c - 3} style="fill: var(--paper); stroke: var(--muted); stroke-width: 0.8; stroke-dasharray: 2 2" />
            )))}
            {k === 2 && <path class="f-thin" style="stroke: var(--ink); stroke-width: 1.6" d={`M ${x0 + 4 * Ly.c} ${y0 - 3} V ${y0 + side + 3}`} />}
            <text class="f-small f-t-muted" x={x0 + side / 2} y={y0 + side + 20} text-anchor="middle">{t.line1[k]}</text>
            <text class="f-small" x={x0 + side / 2} y={y0 + side + 38} text-anchor="middle">{`${pct(sh[k])} ${t.of}`}</text>
            <Badge x={x0 - 14} y={y0 + 10} n={k + 1} />
          </g>
        );
      })}
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
