---
import Figure from '../Figure.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The calculator of the note: five sources, three objects, the program and its test.
// Edges point from a prerequisite to the target built from it.
const nodes = ['parse.c', 'parse.h', 'main.c', 'eval.h', 'eval.c', 'parse.o', 'main.o', 'eval.o', 'calc', 'test'] as const;
type Id = (typeof nodes)[number];
const edges: [Id, Id][] = [
  ['parse.c', 'parse.o'], ['parse.h', 'parse.o'], ['parse.h', 'main.o'], ['main.c', 'main.o'],
  ['eval.h', 'main.o'], ['eval.h', 'eval.o'], ['eval.c', 'eval.o'],
  ['parse.o', 'calc'], ['main.o', 'calc'], ['eval.o', 'calc'], ['calc', 'test'],
];
const changed: Id = 'eval.h';

// The rebuild set: everything reachable from the changed file; the step of a node is its distance from it.
const depth = new Map<Id, number>([[changed, 0]]);
const queue: Id[] = [changed];
while (queue.length) {
  const u = queue.shift()!;
  for (const [a, b] of edges) if (a === u && !depth.has(b)) { depth.set(b, depth.get(u)! + 1); queue.push(b); }
}
const rebuilt = nodes.filter((n) => depth.has(n) && n !== changed);
if (rebuilt.join(' ') !== 'main.o eval.o calc test') throw new Error(`rebuild set is ${rebuilt.join(' ')}`);
const stepOf = (n: Id) => depth.get(n)! + 1;
const status = (n: Id) => (n === changed ? 'changed' : depth.has(n) ? 'rebuilt' : 'kept');
const fill: Record<string, string> = { changed: 'var(--fig-amber)', rebuilt: 'var(--fig-red)', kept: 'var(--muted)' };
const steps = ru
  ? ['изменён заголовок eval.h', 'перекомпилировать объектные файлы, исходники которых его включают: eval.o и main.o; parse.o остаётся', 'перекомпоновать calc из двух новых объектных файлов и старого parse.o', 'снова запустить тест']
  : ['the header eval.h is edited', 'recompile the objects whose sources include it, eval.o and main.o; parse.o is kept', 'relink calc from the two new objects and the old parse.o', 'run the test again'];
const legend = ru ? [['changed', 'изменён'], ['rebuilt', 'пересобирается'], ['kept', 'остаётся']] : [['changed', 'changed'], ['rebuilt', 'rebuilt'], ['kept', 'kept']];

interface Box { x: number; y: number }
interface Layout {
  cls: string; W: number; H: number; w: number; h: number; mono: number; sans: number; horizontal: boolean;
  pos: Record<Id, Box>; badge: Record<number, [number, number]>; legendY: number; legendX: number;
}
// Legend items sit one after another: a swatch, its label, then a gap of 18.
function legendXs(L: { legendX: number; sans: number }) {
  const xs: number[] = [];
  let x = L.legendX;
  for (const [, label] of legend) { xs.push(x); x += 20 + label.length * L.sans + 18; }
  return xs;
}
// Wide: columns from left to right. Narrow: rows from top to bottom.
const rowY = (i: number) => 25 + i * 46;
const colX = (i: number) => 5 + i * 71;
const layouts: Layout[] = [
  {
    cls: 'fig-wide', W: 760, H: 290, w: 96, h: 30, mono: 9, sans: 6.5, horizontal: true,
    pos: {
      'parse.c': { x: 40, y: rowY(0) }, 'parse.h': { x: 40, y: rowY(1) }, 'main.c': { x: 40, y: rowY(2) },
      'eval.h': { x: 40, y: rowY(3) }, 'eval.c': { x: 40, y: rowY(4) },
      'parse.o': { x: 270, y: (rowY(0) + rowY(1)) / 2 }, 'main.o': { x: 270, y: rowY(2) }, 'eval.o': { x: 270, y: (rowY(3) + rowY(4)) / 2 },
      'calc': { x: 470, y: rowY(2) }, 'test': { x: 640, y: rowY(2) },
    },
    badge: { 1: [22, rowY(3) + 15], 2: [318, rowY(2) - 14], 3: [518, rowY(2) - 14], 4: [688, rowY(2) - 14] },
    legendY: 272, legendX: 40,
  },
  {
    cls: 'fig-narrow seq-narrow', W: 360, H: 340, w: 66, h: 30, mono: 8.4, sans: 7.3, horizontal: false,
    pos: {
      'parse.c': { x: colX(0), y: 25 }, 'parse.h': { x: colX(1), y: 25 }, 'main.c': { x: colX(2), y: 25 },
      'eval.h': { x: colX(3), y: 25 }, 'eval.c': { x: colX(4), y: 25 },
      'parse.o': { x: (colX(0) + colX(1)) / 2, y: 115 }, 'main.o': { x: colX(2), y: 115 }, 'eval.o': { x: (colX(3) + colX(4)) / 2, y: 115 },
      'calc': { x: colX(2), y: 195 }, 'test': { x: colX(2), y: 265 },
    },
    badge: { 1: [colX(3) + 33, 11], 2: [colX(2) + 66 + 18, 130], 3: [colX(2) + 66 + 18, 210], 4: [colX(2) + 66 + 18, 280] },
    legendY: 330, legendX: 8,
  },
];
for (const L of layouts) {
  for (const n of nodes) {
    const b = L.pos[n];
    if (n.length * L.mono > L.w - 6) throw new Error(`label ${n} too wide at ${L.W}`);
    if (b.x < 0 || b.x + L.w > L.W || b.y < 0 || b.y + L.h > L.H) throw new Error(`node ${n} outside at ${L.W}`);
  }
  const xs = legendXs(L);
  if (xs[xs.length - 1] + 20 + legend[legend.length - 1][1].length * L.sans > L.W - 4) throw new Error(`legend overflows at ${L.W}`);
}
// An edge leaves the right (or bottom) side of its source and ends at the left (or top) side of its target.
const ends = (L: Layout, a: Id, b: Id): [number, number][] => {
  const p = L.pos[a], q = L.pos[b];
  return L.horizontal
    ? [[p.x + L.w, p.y + L.h / 2], [q.x - 2, q.y + L.h / 2]]
    : [[p.x + L.w / 2, p.y + L.h], [q.x + L.w / 2, q.y - 2]];
};
const id = 'build-graph';
---

<Figure
  id={id}
  title={ru ? 'Граф сборки калькулятора и что пересобирается после правки eval.h' : 'The build graph of the calculator, and what an edit to eval.h rebuilds'}
  caption={ru
    ? 'Стрелки идут от зависимости к цели, которая из неё собирается. Изменённый заголовок eval.h (1) включают eval.c и main.c, поэтому перекомпилируются eval.o и main.o (2); parse.o от него не зависит и остаётся. Программа calc перекомпоновывается из двух новых объектных файлов и старого parse.o (3), и тест запускается снова (4). Множество пересборки — всё, что достижимо из изменённого файла по стрелкам; make находит его по временам изменения, а сборка по хешам содержимого может остановиться раньше, если новый объектный файл совпал со старым.'
    : 'Arrows point from a prerequisite to the target built from it. The edited header eval.h (1) is included by eval.c and main.c, so eval.o and main.o are recompiled (2); parse.o does not depend on it and is kept. The program calc is relinked from the two new objects and the old parse.o (3), and the test runs again (4). The rebuild set is everything reachable from the changed file along the arrows; make finds it by modification times, while a content-hash build can stop earlier if a new object comes out identical to the old one.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Граф сборки и множество пересборки' : 'A build graph and its rebuild set'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Пять исходных файлов ведут к трём объектным файлам, те к программе calc, а она к тесту. Изменён заголовок eval.h; выделены eval.o, main.o, calc и test, которые пересобираются, а parse.o остаётся прежним.'
        : 'Five source files lead to three object files, those to the program calc, and calc to the test. The header eval.h is changed; eval.o, main.o, calc and test are highlighted as rebuilt, while parse.o is kept.'}</desc>
      {edges.map(([a, b]) => {
        const hot = depth.has(a) && depth.has(b);
        return hot
          ? <g data-s={String(stepOf(b))}><Arrow pts={ends(L, a, b)} tone="red" bold /></g>
          : <Arrow pts={ends(L, a, b)} tone="muted" />;
      })}
      {nodes.map((n) => {
        const b = L.pos[n], st = status(n), c = fill[st];
        const box = (
          <g>
            <rect x={b.x} y={b.y} width={L.w} height={L.h} rx="6" style={`fill: ${st === 'kept' ? 'var(--paper-strong)' : c}; fill-opacity: ${st === 'kept' ? 1 : 0.14}; stroke: ${c}; stroke-width: ${st === 'kept' ? 1.1 : 1.8}`} />
            <text class={L.horizontal ? 'f-label' : 'f-small'} x={b.x + L.w / 2} y={b.y + L.h / 2 + 5} text-anchor="middle" style="font-family: var(--mono)">{n}</text>
          </g>
        );
        return st === 'kept' ? box : <g data-s={String(stepOf(n))}>{box}</g>;
      })}
      {[1, 2, 3, 4].map((k) => <g data-s={String(k)}><Badge x={L.badge[k][0]} y={L.badge[k][1]} n={k} /></g>)}
      {legend.map(([st, label], i) => {
        const x = legendXs(L)[i];
        return (
          <g>
            <rect x={x} y={L.legendY - 10} width="14" height="12" rx="2" style={`fill: ${st === 'kept' ? 'var(--paper-strong)' : fill[st]}; fill-opacity: ${st === 'kept' ? 1 : 0.14}; stroke: ${fill[st]}; stroke-width: 1.3`} />
            <text class="f-small f-t-muted" x={x + 20} y={L.legendY}>{label}</text>
          </g>
        );
      })}
    </svg>
  ))}
  <Stepper steps={steps} />
</Figure>
