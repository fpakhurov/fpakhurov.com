---
import Figure from '../Figure.astro';

// Three unrolled time steps of an RNN with recurrent weight w = 2.
const w = 2;
const rows = [86, 190, 294];
const inputX = 70;
const inputW = 92;
const cellX = 222;
const cellW = 62;
const cellH = 40;
const outX = 342;
const outW = 72;
const boxH = 34;

// Cumulative factor carried along the recurrent path after t steps: w^t.
const factors = [1, 2, 3].map((t) => w ** t);

// Recurrent (hidden-state) arrow from the bottom of cell t into the left side of cell t+1.
const hidden = (y1: number, y2: number) => {
  const sx = cellX + cellW - 12;
  const sy = y1 + cellH / 2;
  const ex = cellX - 3;
  const ey = y2 - 9;
  return `M ${sx} ${sy} C ${sx + 6} ${sy + 52}, ${cellX - 46} ${ey - 46}, ${ex} ${ey}`;
};
// Point on the hidden-state curve at parameter u (cubic Bézier), for the annotation arrow.
const hiddenAt = (y1: number, y2: number, u: number) => {
  const p = [
    [cellX + cellW - 12, y1 + cellH / 2],
    [cellX + cellW - 6, y1 + cellH / 2 + 52],
    [cellX - 46, y2 - 9 - 46],
    [cellX - 3, y2 - 9],
  ];
  const c = [(1 - u) ** 3, 3 * (1 - u) ** 2 * u, 3 * (1 - u) * u ** 2, u ** 3];
  return [0, 1].map((d) => c.reduce((acc, ci, i) => acc + ci * p[i][d], 0)) as [number, number];
};
const lastY = rows[2] + cellH / 2;
const squiggle = `M ${cellX + cellW - 12} ${lastY} C ${cellX + cellW - 4} ${lastY + 30}, ${cellX - 30} ${lastY + 14}, ${cellX + 2} ${lastY + 44} S ${cellX + 40} ${lastY + 56}, ${cellX + 18} ${lastY + 70}`;
---

<Figure
  id="training-background-rnn"
  title="Unrolled RNN with recurrent weight w = 2"
  caption="The same weight is applied at every time step, so the sensitivity of a later hidden state to an earlier one, and with it the backpropagated gradient, is multiplied by 2, then 4, then 8 and so on. Intermediate outputs are dashed because only the last one is used here."
  origin="redrawn"
  pages="14"
>
  <svg class="fig-medium" viewBox="0 0 590 420" role="img" aria-labelledby="training-background-rnn-t training-background-rnn-d">
    <title id="training-background-rnn-t">Unrolled recurrent network with exploding factors</title>
    <desc id="training-background-rnn-d">Three time steps stacked vertically. In each, an input box feeds a recurrent cell drawn with a ReLU icon; the first two cells feed dashed output boxes and the third a solid output box. Curved arrows carry the hidden state from each cell to the next, labelled times 2 and times 4; a dashed red squiggle continues below the third cell, labelled times 8 and so on, exploding. A note explains that after t steps the factor is w to the power t.</desc>

    <text class="f-title" x={inputX + inputW / 2} y="36" text-anchor="middle">input</text>
    <text class="f-math f-upright" x={cellX + cellW / 2} y="38" text-anchor="middle">w = 2</text>
    <text class="f-title" x={outX + outW / 2} y="36" text-anchor="middle">output</text>

    {rows.map((y, i) => (
      <g>
        <rect class="f-box" x={inputX} y={y - boxH / 2} width={inputW} height={boxH} rx="3" />
        <text class="f-math" x={inputX + inputW / 2} y={y + 6} text-anchor="middle">x<tspan dy="5" font-size="13">{i + 1}</tspan></text>
        <path class="f-line" d={`M ${inputX + inputW} ${y} H ${cellX - 3}`} marker-end="url(#f-arrow)" />
        <rect class="f-box" x={cellX} y={y - cellH / 2} width={cellW} height={cellH} rx="4" />
        <path class="f-line f-blue" d={`M ${cellX + 12} ${y + 9} H ${cellX + 31} L ${cellX + 50} ${y - 10}`} />
        <path class={i < 2 ? 'f-line f-muted f-dash' : 'f-line'} d={`M ${cellX + cellW} ${y} H ${outX - 3}`} marker-end={i < 2 ? 'url(#f-arrow-muted)' : 'url(#f-arrow)'} />
        <rect class={i < 2 ? 'f-thin f-muted f-dash' : 'f-box'} x={outX} y={y - boxH / 2} width={outW} height={boxH} rx="3" />
      </g>
    ))}

    <text class="f-note" x={cellX + cellW / 2} y={rows[0] - cellH / 2 - 10} text-anchor="middle">ReLU cell</text>

    <path class="f-line f-red" d={hidden(rows[0], rows[1])} marker-end="url(#f-arrow-red)" />
    <path class="f-line f-red" d={hidden(rows[1], rows[2])} marker-end="url(#f-arrow-red)" />
    <path class="f-line f-red f-dash" d={squiggle} marker-end="url(#f-arrow-red)" />
    <text class="f-math f-t-red" x={cellX + cellW + 6} y={rows[0] + 52}>×{factors[0]}</text>
    <text class="f-math f-t-red" x={cellX + cellW + 6} y={rows[1] + 52}>×{factors[1]}</text>
    <text class="f-math f-t-red" x={cellX + cellW + 6} y={rows[2] + 50}>×{factors[2]} …</text>
    <text class="f-label f-t-red" x={cellX + cellW + 6} y={rows[2] + 74}>exploding</text>

    <text class="f-note" x="440" y={rows[1] - 6}>hidden state h</text>
    <text class="f-note" x="440" y={rows[1] + 12}>passes through</text>
    <text class="f-note" x="440" y={rows[1] + 30}>the same w</text>
    <path class="f-thin f-muted" d={`M 436 ${rows[1] + 22} Q 340 ${rows[1] + 14} ${hiddenAt(rows[1], rows[2], 0.14)[0] + 7} ${hiddenAt(rows[1], rows[2], 0.14)[1]}`} marker-end="url(#f-arrow-muted)" />

    <text class="f-note" x="440" y={rows[2] + 52}>after t steps:</text>
    <text class="f-math" x="440" y={rows[2] + 76}>×wᵗ</text>
  </svg>
</Figure>
