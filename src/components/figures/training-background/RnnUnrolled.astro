---
import Figure from '../Figure.astro';

// Three unrolled time steps of an RNN with recurrent weight w = 2.
// Every recurrent arrow multiplies by the same w; after τ steps the factor is w^τ.
const w = 2;
const cellW = 62;
const cellH = 40;
const outW = 72;
const boxH = 34;

interface Layout {
  cls: string;
  w: number;
  h: number;
  rows: number[];
  inputX: number;
  inputW: number;
  cellX: number;
  outX: number;
  side: boolean; // explanatory notes in a right-hand column (wide) or below the diagram (narrow)
}

const layouts = ([
  { cls: 'fig-medium fig-wide', w: 590, h: 420, rows: [86, 190, 294], inputX: 70, inputW: 92, cellX: 222, outX: 342, side: true },
  { cls: 'fig-narrow', w: 360, h: 452, rows: [92, 192, 292], inputX: 12, inputW: 80, cellX: 150, outX: 270, side: false },
] as Layout[]).map((L) => {
  const { cellX, rows } = L;
  // Recurrent (hidden-state) arrow from the bottom of cell t into the left side of cell t+1.
  const ctrl = (y1: number, y2: number) => [
    [cellX + cellW - 12, y1 + cellH / 2],
    [cellX + cellW - 6, y1 + cellH / 2 + 52],
    [cellX - 46, y2 - 9 - 46],
    [cellX - 3, y2 - 9],
  ];
  const hidden = (y1: number, y2: number) => {
    const p = ctrl(y1, y2);
    return `M ${p[0][0]} ${p[0][1]} C ${p[1][0]} ${p[1][1]}, ${p[2][0]} ${p[2][1]}, ${p[3][0]} ${p[3][1]}`;
  };
  // Point on the hidden-state curve at parameter u (cubic Bézier), for the annotation arrow.
  const hiddenAt = (y1: number, y2: number, u: number) => {
    const p = ctrl(y1, y2);
    const c = [(1 - u) ** 3, 3 * (1 - u) ** 2 * u, 3 * (1 - u) * u ** 2, u ** 3];
    return [0, 1].map((d) => c.reduce((acc, ci, i) => acc + ci * p[i][d], 0)) as [number, number];
  };
  const lastY = rows[2] + cellH / 2;
  const squiggle = `M ${cellX + cellW - 12} ${lastY} C ${cellX + cellW - 4} ${lastY + 30}, ${cellX - 30} ${lastY + 14}, ${cellX + 2} ${lastY + 44} S ${cellX + 40} ${lastY + 56}, ${cellX + 18} ${lastY + 70}`;
  return { ...L, hidden, hiddenAt, squiggle };
});
---

<Figure
  id="training-background-rnn"
  title="Unrolled RNN with recurrent weight w = 2"
  caption="The same weight w = 2 is applied at every time step, so every red recurrent arrow multiplies by 2. The sensitivity of a later hidden state to an earlier one, and with it the backpropagated gradient, is therefore 2 after one step, 4 after two, 8 after three, and w raised to the power τ after τ steps. Intermediate outputs are dashed because only the last one is used here."
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`training-background-rnn-${L.w}-t training-background-rnn-${L.w}-d`}>
      <title id={`training-background-rnn-${L.w}-t`}>Unrolled recurrent network with exploding factors</title>
      <desc id={`training-background-rnn-${L.w}-d`}>Three time steps stacked vertically. In each, an input box feeds a recurrent cell drawn with a ReLU icon; the first two cells feed dashed output boxes and the third a solid output box. Curved red arrows carry the hidden state from each cell to the next, each labelled times 2; a dashed red squiggle continues below the third cell, also labelled times 2 and so on, exploding. A note explains that after tau steps the factor is w to the power tau.</desc>

      <text class="f-title" x={L.inputX + L.inputW / 2} y="36" text-anchor="middle">input</text>
      <text class="f-math f-upright" x={L.cellX + cellW / 2} y="38" text-anchor="middle">w = {w}</text>
      <text class="f-title" x={L.outX + outW / 2} y="36" text-anchor="middle">output</text>

      {L.rows.map((y, i) => (
        <g>
          <rect class="f-box" x={L.inputX} y={y - boxH / 2} width={L.inputW} height={boxH} rx="3" />
          <text class="f-math" x={L.inputX + L.inputW / 2} y={y + 6} text-anchor="middle">x<tspan dy="5" font-size="13">{i + 1}</tspan></text>
          <path class="f-line" d={`M ${L.inputX + L.inputW} ${y} H ${L.cellX - 3}`} marker-end="url(#f-arrow)" />
          <rect class="f-box" x={L.cellX} y={y - cellH / 2} width={cellW} height={cellH} rx="4" />
          <path class="f-line f-blue" d={`M ${L.cellX + 12} ${y + 9} H ${L.cellX + 31} L ${L.cellX + 50} ${y - 10}`} />
          <path class={i < 2 ? 'f-line f-muted f-dash' : 'f-line'} d={`M ${L.cellX + cellW} ${y} H ${L.outX - 3}`} marker-end={i < 2 ? 'url(#f-arrow-muted)' : 'url(#f-arrow)'} />
          <rect class={i < 2 ? 'f-thin f-muted f-dash' : 'f-box'} x={L.outX} y={y - boxH / 2} width={outW} height={boxH} rx="3" />
        </g>
      ))}

      <text class="f-note" x={L.cellX + cellW / 2} y={L.rows[0] - cellH / 2 - 10} text-anchor="middle">ReLU cell</text>

      <path class="f-line f-red" d={L.hidden(L.rows[0], L.rows[1])} marker-end="url(#f-arrow-red)" />
      <path class="f-line f-red" d={L.hidden(L.rows[1], L.rows[2])} marker-end="url(#f-arrow-red)" />
      <path class="f-line f-red f-dash" d={L.squiggle} marker-end="url(#f-arrow-red)" />
      <text class="f-math f-t-red" x={L.cellX + cellW + 6} y={L.rows[0] + 52}>×{w}</text>
      <text class="f-math f-t-red" x={L.cellX + cellW + 6} y={L.rows[1] + 52}>×{w}</text>
      <text class="f-math f-t-red" x={L.cellX + cellW + 6} y={L.rows[2] + 50}>×{w} …</text>
      <text class="f-label f-t-red" x={L.cellX + cellW + 6} y={L.rows[2] + 74}>exploding</text>

      {L.side ? (
        <g>
          <text class="f-note" x="440" y={L.rows[1] - 6}>hidden state h</text>
          <text class="f-note" x="440" y={L.rows[1] + 12}>passes through</text>
          <text class="f-note" x="440" y={L.rows[1] + 30}>the same w</text>
          <path class="f-thin f-muted" d={`M 436 ${L.rows[1] + 22} Q 340 ${L.rows[1] + 14} ${L.hiddenAt(L.rows[1], L.rows[2], 0.14)[0] + 7} ${L.hiddenAt(L.rows[1], L.rows[2], 0.14)[1]}`} marker-end="url(#f-arrow-muted)" />
          <text class="f-note" x="440" y={L.rows[2] + 52}>after τ steps:</text>
          <text class="f-math" x="440" y={L.rows[2] + 76}>×w<tspan dy="-8" font-size="13">τ</tspan></text>
        </g>
      ) : (
        <g>
          <text class="f-note" x={L.inputX} y={L.rows[2] + 112}>Red arrows: the hidden state h passes</text>
          <text class="f-note" x={L.inputX} y={L.rows[2] + 132}>through the same w at every step.</text>
          <text class="f-note" x={L.inputX} y={L.rows[2] + 152}>After τ steps the factor is w<tspan dy="-6" font-size="10">τ</tspan><tspan dy="6">.</tspan></text>
        </g>
      )}
    </svg>
  ))}
</Figure>
