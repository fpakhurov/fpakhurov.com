---
import Figure from '../Figure.astro';

// One output channel j of a 2-D convolution layer:
// out[j] = Σ_c W_{j,c} ⋆ in[c] + b_j, drawn for a 6×6 input, 3×3 kernels, stride 1, no padding,
// so H_out = H − k + 1 = 4.
const H = 6;
const k = 3;
const Hout = H - k + 1;

// Five-pointed star (the ⋆ operator), drawn as a path because the font glyph is tiny.
function star(cx: number, cy: number, R: number) {
  const pts = Array.from({ length: 10 }, (_, i) => {
    const r = i % 2 === 0 ? R : R * 0.42;
    const a = -Math.PI / 2 + (i * Math.PI) / 5;
    return `${(cx + r * Math.cos(a)).toFixed(2)} ${(cy + r * Math.sin(a)).toFixed(2)}`;
  });
  return `M ${pts.join(' L ')} Z`;
}

function gridPath(x: number, y: number, cells: number, s: number) {
  const parts: string[] = [];
  for (let i = 1; i < cells; i += 1) {
    parts.push(`M ${x + i * s} ${y} V ${y + cells * s}`, `M ${x} ${y + i * s} H ${x + cells * s}`);
  }
  return parts.join(' ');
}

interface Layout {
  cls: string;
  w: number;
  h: number;
  s: number; // cell size
  rowTops: number[];
  dotsY: number;
  rowLabelX: number;
  inX: number;
  starX: number;
  kerX: number;
  arrow: [number, number];
  partX: number;
  sum: [number, number];
  bias: [number, number];
  outX: number;
  outY: number;
  headerY: number;
  footY: number;
  small: boolean;
}

const wide: Layout = {
  cls: 'fig-wide', w: 680, h: 432, s: 12,
  rowTops: [62, 162, 292], dotsY: 262, rowLabelX: 6,
  inX: 64, starX: 152, kerX: 174, arrow: [226, 262], partX: 270,
  sum: [440, 212], bias: [440, 128], outX: 516, outY: 188,
  headerY: 30, footY: 424, small: false,
};
const narrow: Layout = {
  cls: 'fig-narrow', w: 360, h: 392, s: 9,
  rowTops: [70, 146, 238], dotsY: 229, rowLabelX: 2,
  inX: 46, starX: 112, kerX: 132, arrow: [170, 191], partX: 197,
  sum: [306, 176], bias: [306, 104], outX: 290, outY: 238,
  headerY: 24, footY: 360, small: true,
};

const layouts = [wide, narrow].map((L) => {
  const inSize = H * L.s;
  const kerSize = k * L.s;
  const partSize = Hout * L.s;
  const rows = L.rowTops.map((top, i) => {
    const cy = top + inSize / 2;
    return {
      i,
      top,
      cy,
      label: ['1', '2', 'in_c'][i],
      inGrid: gridPath(L.inX, top, H, L.s),
      kerTop: cy - kerSize / 2,
      kerGrid: gridPath(L.kerX, cy - kerSize / 2, k, L.s),
      partTop: cy - partSize / 2,
      partGrid: gridPath(L.partX, cy - partSize / 2, Hout, L.s),
    };
  });
  const [sx, sy] = L.sum;
  const r = L.small ? 16 : 20;
  // Arrows from each partial map to the Σ node, ending on its rim.
  const toSum = rows.map((row) => {
    const x0 = L.partX + partSize + 6;
    const y0 = row.cy;
    const ang = Math.atan2(y0 - sy, x0 - sx);
    const ex = sx + (r + 3) * Math.cos(ang);
    const ey = sy + (r + 3) * Math.sin(ang);
    const cx = (x0 + ex) / 2;
    return `M ${x0} ${y0} C ${cx} ${y0}, ${cx} ${ey}, ${ex.toFixed(1)} ${ey.toFixed(1)}`;
  });
  const back = [3, 2, 1].map((m) => ({ dx: m * (L.small ? 6 : 8), dy: -m * (L.small ? 6 : 8) }));
  const kerBox = {
    x: L.kerX - 7,
    y: rows[0].kerTop - 8,
    w: kerSize + 14,
    h: rows[2].kerTop + kerSize + 8 - (rows[0].kerTop - 8),
  };
  return { L, inSize, kerSize, partSize, rows, r, toSum, back, kerBox };
});
---

<Figure
  id="training-background-conv"
  title="Shapes in a convolution layer: one output channel"
  caption="Each output channel j has its own filter: one k × k kernel slice per input channel. The slice for channel c is slid over that channel, the results for all in_channels are summed, and the scalar bias of channel j is added. The amber window and cell show which inputs produce one output value. Repeating this with all out_channels filters gives one output plane per filter, so the weight tensor has shape out_channels × in_channels × k × k. Drawn with a 6 × 6 input, k = 3, stride 1 and no padding, so the output planes are 4 × 4."
  origin="illustrative"
  pages="15"
>
  {layouts.map(({ L, inSize, kerSize, partSize, rows, r, toSum, back, kerBox }) => (
    <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`training-background-conv-${L.cls}-t training-background-conv-${L.cls}-d`}>
      <title id={`training-background-conv-${L.cls}-t`}>Computing one output channel of a convolution</title>
      <desc id={`training-background-conv-${L.cls}-d`}>Rows for input channels 1, 2 up to in_c. In each row a 6 by 6 input plane in[c] of size H_in by W_in is cross-correlated with a 3 by 3 kernel slice W j c, giving a 4 by 4 partial map. The three kernel slices are boxed together as filter W j of shape in_c by k by k. Arrows bring all partial maps into a summation node, a bias b j is added from above, and the result is output plane out[j] of size H_out by W_out, drawn in front of a stack of out_c planes, one per filter.</desc>

      <text class={L.small ? 'f-small f-title' : 'f-title'} x={L.inX + inSize / 2} y={L.headerY} text-anchor="middle">in[c]</text>
      <text class="f-note" x={L.inX + inSize / 2} y={L.headerY + 18} text-anchor="middle">H<tspan dy="4" font-size="10">in</tspan><tspan dy="-4"> × W</tspan><tspan dy="4" font-size="10">in</tspan></text>
      <text class={L.small ? 'f-small f-title' : 'f-title'} x={L.kerX + kerSize / 2} y={L.headerY} text-anchor="middle">W<tspan dy="4" font-size="11">j,c</tspan></text>
      <text class="f-note" x={L.kerX + kerSize / 2} y={L.headerY + 18} text-anchor="middle">k × k</text>
      <text class={L.small ? 'f-small f-title' : 'f-title'} x={L.partX + partSize / 2 - 9} y={L.headerY} text-anchor="end">W<tspan dy="4" font-size="11">j,c</tspan></text>
      <path class="f-fill-ink" d={star(L.partX + partSize / 2, L.headerY - 5, L.small ? 5 : 6)} />
      <text class={L.small ? 'f-small f-title' : 'f-title'} x={L.partX + partSize / 2 + 9} y={L.headerY}>in[c]</text>

      {rows.map((row) => (
        <g>
          <text class={L.small ? 'f-small' : 'f-label'} x={L.rowLabelX} y={row.cy + 5}>c = {row.label === 'in_c' ? <tspan>in<tspan dy="4" font-size="10">c</tspan></tspan> : row.label}</text>
          <rect class="f-box" x={L.inX} y={row.top} width={inSize} height={inSize} />
          <rect class="f-fill-amber" x={L.inX} y={row.top} width={kerSize} height={kerSize} />
          <path class="f-grid" d={row.inGrid} />
          <rect class="f-thin f-amber" x={L.inX} y={row.top} width={kerSize} height={kerSize} />
          <path class="f-fill-ink" d={star(L.starX, row.cy, L.small ? 6 : 7.5)} />
          <rect class="f-box" x={L.kerX} y={row.kerTop} width={kerSize} height={kerSize} />
          <rect class="f-fill-blue" x={L.kerX} y={row.kerTop} width={kerSize} height={kerSize} />
          <path class="f-thin f-blue" style="opacity: 0.55" d={row.kerGrid} />
          <path class="f-line" d={`M ${L.arrow[0]} ${row.cy} H ${L.arrow[1]}`} marker-end="url(#f-arrow)" />
          <rect class="f-box" x={L.partX} y={row.partTop} width={partSize} height={partSize} />
          <rect class="f-fill-amber" x={L.partX} y={row.partTop} width={L.s} height={L.s} />
          <path class="f-grid" d={row.partGrid} />
        </g>
      ))}
      <text class="f-label f-t-muted" x={L.inX + inSize / 2} y={L.dotsY} text-anchor="middle">⋮</text>
      <text class="f-label f-t-muted" x={L.partX + partSize / 2} y={L.dotsY} text-anchor="middle">⋮</text>

      <rect class="f-thin f-blue f-dash" x={kerBox.x} y={kerBox.y} width={kerBox.w} height={kerBox.h} rx="5" />
      <text class={`${L.small ? 'f-small' : 'f-label'} f-t-blue`} x={kerBox.x + kerBox.w / 2} y={kerBox.y + kerBox.h + 18} text-anchor="middle">filter W<tspan dy="4" font-size="10">j</tspan></text>
      <text class="f-small f-t-blue" x={kerBox.x + kerBox.w / 2} y={kerBox.y + kerBox.h + 34} text-anchor="middle">in<tspan dy="4" font-size="9">c</tspan><tspan dy="-4"> × k × k</tspan></text>

      {toSum.map((d) => <path class="f-thin" d={d} marker-end="url(#f-arrow)" />)}
      <circle class="f-box" cx={L.sum[0]} cy={L.sum[1]} r={r} />
      <text class="f-math f-upright" x={L.sum[0]} y={L.sum[1] + 7} text-anchor="middle">Σ</text>
      {!L.small && <text class="f-note" x={L.sum[0] + r + 6} y={L.sum[1] - 9}>over c</text>}

      <text class="f-math" x={L.bias[0]} y={L.bias[1]} text-anchor="middle">b<tspan dy="5" font-size="13">j</tspan></text>
      <path class="f-line f-green" d={`M ${L.bias[0]} ${L.bias[1] + 16} V ${L.sum[1] - r - 3}`} marker-end="url(#f-arrow-green)" />
      <text class="f-note" x={L.bias[0] + 10} y={L.bias[1] + 30}>+ bias</text>

      {L.small ? (
        <path class="f-line" d={`M ${L.sum[0]} ${L.sum[1] + r} V ${L.outY + back[0].dy - 4}`} marker-end="url(#f-arrow)" />
      ) : (
        <path class="f-line" d={`M ${L.sum[0] + r} ${L.sum[1]} H ${L.outX - 4}`} marker-end="url(#f-arrow)" />
      )}
      {back.map((b) => (
        <rect class="f-thin f-muted f-fill-paper" x={L.outX + b.dx} y={L.outY + b.dy} width={partSize} height={partSize} />
      ))}
      <rect class="f-box" x={L.outX} y={L.outY} width={partSize} height={partSize} />
      <rect class="f-fill-amber" x={L.outX} y={L.outY} width={L.s} height={L.s} />
      <path class="f-grid" d={gridPath(L.outX, L.outY, Hout, L.s)} />
      <text class={L.small ? 'f-small f-title' : 'f-title'} x={L.outX + partSize / 2} y={L.outY + partSize + 20} text-anchor="middle">out[j]</text>
      <text class="f-note" x={L.outX + partSize / 2} y={L.outY + partSize + 38} text-anchor="middle">H<tspan dy="4" font-size="10">out</tspan><tspan dy="-4"> × W</tspan><tspan dy="4" font-size="10">out</tspan></text>
      {!L.small && <text class="f-note" x={L.outX + partSize + 30} y={L.outY - 16}>out<tspan dy="4" font-size="10">c</tspan><tspan dy="-4"> planes</tspan></text>}

      {L.small ? (
        <>
          <text class="f-small" x={L.w / 2} y={L.footY} text-anchor="middle">repeat with each of the out<tspan dy="4" font-size="9">c</tspan><tspan dy="-4"> filters W</tspan><tspan dy="4" font-size="9">1</tspan><tspan dy="-4">, …, W</tspan><tspan dy="4" font-size="9">out</tspan><tspan dy="3" font-size="7">c</tspan></text>
          <text class="f-small" x={L.w / 2} y={L.footY + 20} text-anchor="middle">→ out<tspan dy="4" font-size="9">c</tspan><tspan dy="-4"> output planes</tspan></text>
        </>
      ) : (
        <text class="f-label" x={L.w / 2} y={L.footY} text-anchor="middle">repeat with each of the out<tspan dy="4" font-size="10">c</tspan><tspan dy="-4"> filters W</tspan><tspan dy="4" font-size="10">1</tspan><tspan dy="-4">, …, W</tspan><tspan dy="4" font-size="10">out</tspan><tspan dy="3" font-size="8">c</tspan><tspan dy="-7"> → out</tspan><tspan dy="4" font-size="10">c</tspan><tspan dy="-4"> planes</tspan></text>
      )}
    </svg>
  ))}
</Figure>
