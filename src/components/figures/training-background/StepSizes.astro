---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';

// Gradient descent on L(θ) = θ²/2, so L'(θ) = θ and θ ← θ − η·g·θ,
// where g stands for the factor w^τ that the gradient picked up through the network.
const loss = (t: number) => (t * t) / 2;
const W = 270; // panel width
const H = 200; // panel height
const pl = 26;
const pr = W - 10;
const pt = 40;
const pb = H - 28;
const sx = scale([-3, 3], [pl, pr]);
const sy = scale([0, 4.6], [pb, pt]);
const curvePath = plot(loss, -3, 3, sx, sy, 120);

function iterate(theta0: number, rate: number, steps: number) {
  const out = [theta0];
  for (let k = 0; k < steps; k += 1) out.push(out[k] - rate * out[k]);
  return out;
}

// Exploding: effective rate 2.3 > 2, so |θ| grows by |1 − 2.3| = 1.3 per step.
const bigRate = 2.3;
const big = iterate(1, bigRate, 3).map((t) => [sx(t), sy(loss(t))] as const);
// Vanishing: effective rate 0.03, stopped after max_steps = 10.
const maxSteps = 10;
const smallRate = 0.03;
const smallTheta = iterate(2.5, smallRate, maxSteps);
const small = smallTheta.map((t) => [sx(t), sy(loss(t))] as const);
const smallEnd = smallTheta[maxSteps].toFixed(2);

const hop = (a: readonly [number, number], b: readonly [number, number]) => {
  const mx = (a[0] + b[0]) / 2;
  const my = Math.min(a[1], b[1]) - 30;
  return `M ${a[0]} ${a[1] - 6} Q ${mx} ${my} ${b[0]} ${b[1] - 6}`;
};
const minX = sx(0);
const minY = sy(0);
---

<Figure
  id="training-background-step-sizes"
  title="What a huge or tiny gradient does to the training steps"
  caption={`Gradient descent on the toy loss L(θ) = θ²/2, whose gradient is θ. If the gradient arrives multiplied by a factor g picked up through the network, the update with learning rate η is θ ← θ − η g θ = (1 − η g) θ. The iterates overshoot the minimum when η g > 1 and move farther out when η g > 2. Red: η g = ${bigRate} from θ₀ = 1, so every step multiplies θ by ${(1 - bigRate).toFixed(1).replace('-', '−')} and the iterates bounce outwards. Blue: η g = ${smallRate} from θ₀ = 2.5, so ten steps move θ only to ${smallEnd}, and training ends at max_steps far from the minimum.`}
>
  {[
    { cls: 'fig-wide', vb: `0 0 ${2 * W + 40} ${H}`, offsets: [[0, 0], [W + 40, 0]] },
    { cls: 'fig-narrow', vb: `0 0 360 ${2 * H + 20}`, offsets: [[45, 0], [45, H + 20]] },
  ].map((v) => (
    <svg class={v.cls} viewBox={v.vb} role="img" aria-labelledby={`training-background-step-sizes-${v.cls}-t training-background-step-sizes-${v.cls}-d`}>
      <title id={`training-background-step-sizes-${v.cls}-t`}>Overshooting steps versus steps that are too small</title>
      <desc id={`training-background-step-sizes-${v.cls}-d`}>Two copies of a parabola-shaped loss. In the first, labelled exploding, gradient-descent iterates start near the minimum and jump to alternating sides, each farther out, with red arcs between them. In the second, labelled vanishing, eleven blue points creep slowly down the right branch and stop at max steps, far from the minimum at zero.</desc>

      <g transform={`translate(${v.offsets[0][0]} ${v.offsets[0][1]})`}>
        <text class="f-title f-t-red" x={pl} y="18">w ≫ 1: steps too large</text>
        <path class="f-axis" d={`M ${pl} ${pb} H ${pr}`} />
        <path class="f-line f-muted" d={curvePath} />
        <circle class="f-solid-green" cx={minX} cy={minY} r="4" />
        <text class="f-note" x={minX} y={pb + 20} text-anchor="middle">minimum</text>
        {big.slice(0, -1).map((p, i) => <path class="f-thin f-red" d={hop(p, big[i + 1])} marker-end="url(#f-arrow-red)" />)}
        {big.map(([x, y], i) => <circle class={i === 0 ? 'f-solid-muted' : 'f-solid-red'} cx={x} cy={y} r="4" />)}
        <text class="f-small f-halo" x={big[0][0] + 12} y={big[0][1] + 9}>start</text>
        <text class="f-small f-t-red" x={minX} y={pt + 2} text-anchor="middle">overshoots,</text>
        <text class="f-small f-t-red" x={minX} y={pt + 18} text-anchor="middle">diverges</text>
      </g>

      <g transform={`translate(${v.offsets[1][0]} ${v.offsets[1][1]})`}>
        <text class="f-title f-t-blue" x={pl} y="18">w → 0: steps too small</text>
        <path class="f-axis" d={`M ${pl} ${pb} H ${pr}`} />
        <path class="f-line f-muted" d={curvePath} />
        <circle class="f-solid-green" cx={minX} cy={minY} r="4" />
        <text class="f-note" x={minX} y={pb + 20} text-anchor="middle">minimum</text>
        {small.map(([x, y], i) => <circle class={i === 0 ? 'f-solid-muted' : 'f-solid-blue'} cx={x} cy={y} r="3" />)}
        <text class="f-small" x={small[0][0] - 6} y={small[0][1] - 10} text-anchor="end">start</text>
        <text class="f-small f-t-blue" x={minX} y={pt + 2} text-anchor="middle">stopped at</text>
        <text class="f-small f-t-blue" x={minX} y={pt + 18} text-anchor="middle">max_steps = {maxSteps}</text>
        <path class="f-thin f-blue" d={`M ${minX + 64} ${pt + 13} Q ${small[maxSteps][0] - 40} ${pt + 10} ${small[maxSteps][0] - 7} ${small[maxSteps][1] - 7}`} marker-end="url(#f-arrow-blue)" />
      </g>
    </svg>
  ))}
</Figure>
