---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';

// Gradient factor w^τ after τ recurrent steps, plotted on a log2 axis.
const tMax = 10;
const yTicks = [
  { e: 10, label: '1024' },
  { e: 5, label: '32' },
  { e: 0, label: '1' },
  { e: -5, label: '1/32' },
  { e: -10, label: '1/1024' },
];
const xTicks = [0, 2, 4, 6, 8, 10];
const weights = [
  { w: 2, cls: 'f-red', dot: 'f-solid-red', text: 'f-t-red', label: 'w = 2' },
  { w: 1, cls: 'f-green', dot: 'f-solid-green', text: 'f-t-green', label: 'w = 1' },
  { w: 0.5, cls: 'f-blue', dot: 'f-solid-blue', text: 'f-t-blue', label: 'w = 0.5' },
];

// A wide layout and a narrow one for small screens; only the plot box and margins differ.
const layouts = [
  { cls: 'fig-medium fig-wide', w: 600, h: 360, left: 84, right: 500, top: 26, bottom: 296, yLabelX: 16, xLabelDy: 44 },
  { cls: 'fig-narrow', w: 360, h: 340, left: 66, right: 286, top: 26, bottom: 280, yLabelX: 14, xLabelDy: 44 },
].map((L) => {
  const sx = scale([0, tMax], [L.left, L.right]);
  const sy = scale([-10, 10], [L.bottom, L.top]); // log2 of the factor
  const yOf = (v: number) => sy(Math.log2(v));
  const series = weights.map((s) => {
    const pts = Array.from({ length: tMax + 1 }, (_, t) => [sx(t), yOf(s.w ** t)] as const);
    return { ...s, pts, path: polyline(pts) };
  });
  const marks = [1, 2, 3].map((t) => ({ x: sx(t), y: yOf(2 ** t), label: `${2 ** t}` }));
  return { ...L, sx, sy, series, marks };
});
---

<Figure
  id="training-background-gradient-factor"
  title="Repeated multiplication by w"
  caption="The factor w raised to the power τ after τ steps, on a logarithmic axis where powers of 2 are evenly spaced. With w = 2 it reaches 1024 after ten steps (exploding); with w = 0.5 it falls to 1/1024 (vanishing); only w = 1 keeps the scale. The first three red points, 2, 4 and 8, are the factors after one, two and three steps of the unrolled RNN above."
  origin="illustrative"
  pages="14"
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`training-background-gradient-factor-${L.w}-t training-background-gradient-factor-${L.w}-d`}>
      <title id={`training-background-gradient-factor-${L.w}-t`}>Gradient factor w to the power τ on a log scale</title>
      <desc id={`training-background-gradient-factor-${L.w}-d`}>Three straight lines on a logarithmic vertical axis from 1/1024 to 1024, against time steps 0 to 10. The line for w equals 2 rises to 1024 through the shaded exploding region; the line for w equals 1 stays at 1; the line for w equals 0.5 falls to 1/1024 through the shaded vanishing region. Points at τ equal 1, 2 and 3 on the rising line are labelled 2, 4 and 8.</desc>

      <rect class="f-fill-red" style="fill-opacity: 0.07" x={L.left} y={L.top} width={L.right - L.left} height={L.sy(0) - L.top} />
      <rect class="f-fill-blue" style="fill-opacity: 0.07" x={L.left} y={L.sy(0)} width={L.right - L.left} height={L.bottom - L.sy(0)} />

      {yTicks.map((tick) => <line class="f-grid" x1={L.left} x2={L.right} y1={L.sy(tick.e)} y2={L.sy(tick.e)} />)}
      {yTicks.map((tick) => <text class="f-note" x={L.left - 8} y={L.sy(tick.e) + 5} text-anchor="end">{tick.label}</text>)}
      {xTicks.map((tick) => <text class="f-note" x={L.sx(tick)} y={L.bottom + 22} text-anchor="middle">{tick}</text>)}
      <path class="f-axis" d={`M ${L.left} ${L.bottom} H ${L.right + 18}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-axis" d={`M ${L.left} ${L.bottom} V ${L.top - 12}`} marker-end="url(#f-arrow-muted)" />
      <text class="f-label" x={L.right + 18} y={L.bottom + L.xLabelDy} text-anchor="end">time steps τ</text>
      <text class="f-label" transform={`translate(${L.yLabelX} ${(L.top + L.bottom) / 2}) rotate(-90)`} text-anchor="middle">factor w<tspan dy="-7" font-size="11">τ</tspan><tspan dy="7"> (log scale)</tspan></text>

      <text class="f-label f-t-red f-halo" x={L.left + 10} y={L.top + 24}>exploding: w<tspan dy="-7" font-size="11">τ</tspan><tspan dy="7"> → ∞</tspan></text>
      <text class="f-label f-t-blue f-halo" x={L.left + 10} y={L.bottom - 12}>vanishing: w<tspan dy="-7" font-size="11">τ</tspan><tspan dy="7"> → 0</tspan></text>

      {L.series.map((s) => <path class={`f-line f-bold ${s.cls}`} d={s.path} />)}
      {L.series.map((s) => s.pts.map(([x, y]) => <circle class={s.dot} cx={x} cy={y} r="3.2" />))}
      {L.series.map((s) => (
        <text class={`f-math f-upright f-halo ${s.text}`} x={L.right + 8} y={s.pts[tMax][1] + (s.w < 1 ? -6 : 6)}>{s.label}</text>
      ))}

      {L.marks.map((m) => (
        <text class="f-small f-t-red f-halo" x={m.x - 7} y={m.y - 6} text-anchor="end">{m.label}</text>
      ))}
    </svg>
  ))}
</Figure>
