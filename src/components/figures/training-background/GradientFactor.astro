---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';

// Gradient factor w^t after t recurrent steps, plotted on a log2 axis.
const left = 84;
const right = 500;
const top = 26;
const bottom = 296;
const tMax = 10;
const sx = scale([0, tMax], [left, right]);
const sy = scale([-10, 10], [bottom, top]); // log2 of the factor
const yOf = (v: number) => sy(Math.log2(v));

const series = [
  { w: 2, cls: 'f-red', dot: 'f-solid-red', text: 'f-t-red', label: 'w = 2' },
  { w: 1, cls: 'f-green', dot: 'f-solid-green', text: 'f-t-green', label: 'w = 1' },
  { w: 0.5, cls: 'f-blue', dot: 'f-solid-blue', text: 'f-t-blue', label: 'w = 0.5' },
].map((s) => {
  const pts = Array.from({ length: tMax + 1 }, (_, t) => [sx(t), yOf(s.w ** t)] as const);
  return { ...s, pts, path: polyline(pts) };
});

const yTicks = [
  { e: 10, label: '1024' },
  { e: 5, label: '32' },
  { e: 0, label: '1' },
  { e: -5, label: '1/32' },
  { e: -10, label: '1/1024' },
];
const xTicks = [0, 2, 4, 6, 8, 10];
const marks = [1, 2, 3].map((t) => ({ t, x: sx(t), y: yOf(2 ** t), label: `×${2 ** t}` }));
---

<Figure
  id="training-background-gradient-factor"
  title="Repeated multiplication by w"
  caption="The factor wᵗ after t steps, on a logarithmic axis where powers of 2 are evenly spaced. With w = 2 it reaches 1024 after ten steps (exploding); with w = 0.5 it falls to 1/1024 (vanishing); only w = 1 keeps the scale. The first three red points are the ×2, ×4, ×8 of the unrolled RNN in Figure 2."
  origin="illustrative"
  pages="14"
>
  <svg class="fig-medium" viewBox="0 0 600 360" role="img" aria-labelledby="training-background-gradient-factor-t training-background-gradient-factor-d">
    <title id="training-background-gradient-factor-t">Gradient factor w to the power t on a log scale</title>
    <desc id="training-background-gradient-factor-d">Three straight lines on a logarithmic vertical axis from 1/1024 to 1024, against time steps 0 to 10. The line for w equals 2 rises to 1024 through the shaded exploding region; the line for w equals 1 stays at 1; the line for w equals 0.5 falls to 1/1024 through the shaded vanishing region. Points at t equal 1, 2 and 3 on the rising line are labelled times 2, times 4 and times 8.</desc>

    <rect class="f-fill-red" style="fill-opacity: 0.07" x={left} y={top} width={right - left} height={sy(0) - top} />
    <rect class="f-fill-blue" style="fill-opacity: 0.07" x={left} y={sy(0)} width={right - left} height={bottom - sy(0)} />

    {yTicks.map((tick) => <line class="f-grid" x1={left} x2={right} y1={sy(tick.e)} y2={sy(tick.e)} />)}
    {yTicks.map((tick) => <text class="f-note" x={left - 10} y={sy(tick.e) + 5} text-anchor="end">{tick.label}</text>)}
    {xTicks.map((tick) => <text class="f-note" x={sx(tick)} y={bottom + 22} text-anchor="middle">{tick}</text>)}
    <path class="f-axis" d={`M ${left} ${bottom} H ${right + 22}`} marker-end="url(#f-arrow-muted)" />
    <path class="f-axis" d={`M ${left} ${bottom} V ${top - 12}`} marker-end="url(#f-arrow-muted)" />
    <text class="f-label" x={right + 22} y={bottom + 44} text-anchor="end">time steps t</text>
    <text class="f-label" transform={`translate(16 ${(top + bottom) / 2}) rotate(-90)`} text-anchor="middle">factor wᵗ (log scale)</text>

    <text class="f-label f-t-red" x={left + 14} y={top + 26}>exploding: wᵗ → ∞</text>
    <text class="f-label f-t-blue" x={left + 14} y={bottom - 14}>vanishing: wᵗ → 0</text>

    {series.map((s) => <path class={`f-line f-bold ${s.cls}`} d={s.path} />)}
    {series.map((s) => s.pts.map(([x, y]) => <circle class={s.dot} cx={x} cy={y} r="3.2" />))}
    {series.map((s) => (
      <text class={`f-math f-upright f-halo ${s.text}`} x={right + 10} y={s.pts[tMax][1] + (s.w < 1 ? -6 : 6)}>{s.label}</text>
    ))}

    {marks.map((m) => (
      <text class="f-small f-t-red f-halo" x={m.x - 8} y={m.y - 6} text-anchor="end">{m.label}</text>
    ))}
  </svg>
</Figure>
