---
import Figure from '../Figure.astro';
import { normals, scale, plot, gaussian } from '../geometry';

// A right-skewed, shifted batch of activations: x = 2 + 4·exp(0.45 z), z ~ N(0, 1).
const n = 256;
const eps = 1e-5;
const xs = normals(n, 11).map((z) => 2 + 4 * Math.exp(0.45 * z));
const mu = xs.reduce((a, b) => a + b, 0) / n;
const variance = xs.reduce((a, b) => a + (b - mu) ** 2, 0) / n;
const denom = Math.sqrt(variance + eps);
const xhat = xs.map((x) => (x - mu) / denom);
const meanHat = xhat.reduce((a, b) => a + b, 0) / n;
const varHat = xhat.reduce((a, b) => a + (b - meanHat) ** 2, 0) / n;

// Shared horizontal axis for all three rows.
const left = 40;
const right = 584;
const sx = scale([-3.5, 15.5], [left, right]);

// Histogram bins in raw units; the same bins are shifted / rescaled for the later rows.
const binW = 0.6;
const lo = Math.floor(Math.min(...xs) / binW) * binW;
const counts: number[] = [];
for (const x of xs) {
  const k = Math.floor((x - lo) / binW);
  counts[k] = (counts[k] ?? 0) + 1;
}
const dens = Array.from({ length: counts.length }, (_, k) => (counts[k] ?? 0) / (n * binW));
const maxDens = Math.max(...dens);
const pxPerDens = 70 / maxDens; // the raw row is 70 px tall; density is preserved below

const rows = { raw: 120, centred: 254, norm: 482 };
type Map1 = (x: number) => number;
const bars = (map: Map1, factor: number, base: number) =>
  dens
    .map((d, k) => {
      if (d === 0) return '';
      const x0 = map(lo + k * binW);
      const x1 = map(lo + (k + 1) * binW);
      const h = d * factor * pxPerDens;
      return `M ${sx(x0).toFixed(2)} ${base} V ${(base - h).toFixed(2)} H ${sx(x1).toFixed(2)} V ${base}`;
    })
    .join(' ');
const rawBars = bars((x) => x, 1, rows.raw);
const centredBars = bars((x) => x - mu, 1, rows.centred);
const normBars = bars((x) => (x - mu) / denom, denom, rows.norm);
const normalCurve = plot((t) => gaussian(t), -3, 4.5, sx, (d) => rows.norm - d * pxPerDens, 120);
const normTop = rows.norm - maxDens * denom * pxPerDens;

const f2 = (v: number) => v.toFixed(2);
const xTicks = [0, 5, 10, 15];
---

<Figure
  id="training-background-batchnorm"
  title="Batch normalization of one feature"
  caption={`A skewed batch of n = ${n} activations with batch mean ${f2(mu)} and batch standard deviation ${f2(Math.sqrt(variance))}. Subtracting the mean slides the histogram to zero; dividing by √(σ² + ε) squeezes it to unit variance. Areas are preserved, so the narrower histogram is taller. The shape does not change: the batch stays skewed and is not turned into the dashed standard normal.`}
  origin="illustrative"
  pages="13–14"
>
  <svg class="fig-medium" viewBox="0 0 600 520" role="img" aria-labelledby="training-background-batchnorm-t training-background-batchnorm-d">
    <title id="training-background-batchnorm-t">Histogram of a batch before and after normalization</title>
    <desc id="training-background-batchnorm-d">Three histograms on a shared horizontal axis. The top one is a right-skewed batch centred near {f2(mu)}. An arrow labelled subtract mu B moves it to the middle row, now centred at zero with the same width. Two arrows labelled divide by the square root of sigma B squared plus epsilon squeeze the plus and minus one standard deviation marks to plus and minus one, giving the bottom histogram: narrower, taller, still skewed, with mean 0 and variance 1. A dashed standard normal curve is drawn on the bottom row for comparison.</desc>

    <line class="f-thin f-muted f-dot" x1={sx(0)} x2={sx(0)} y1={rows.raw - 80} y2={rows.norm} />

    <!-- Row 1: raw batch -->
    <text class="f-title" x={left} y="22">batch xᵢ</text>
    <path class="f-thin f-blue f-fill-blue" d={rawBars} />
    <path class="f-axis" d={`M ${left} ${rows.raw} H ${right}`} />
    <line class="f-line f-amber" x1={sx(mu)} x2={sx(mu)} y1={rows.raw + 4} y2={rows.raw - 88} />
    <text class="f-math f-t-amber f-halo" x={sx(mu) + 8} y={rows.raw - 72}>μ<tspan dy="5" font-size="13">B</tspan><tspan dy="-5"> = {f2(mu)}</tspan></text>

    <!-- Arrow: subtract the mean -->
    <path class="f-line f-amber" d={`M ${sx(mu) - 4} ${rows.raw + 10} Q ${sx(mu / 2)} ${rows.raw + 26} ${sx(0) + 6} ${rows.centred - 82}`} marker-end="url(#f-arrow)" />
    <text class="f-label f-halo" x={sx(mu / 2) + 30} y={rows.raw + 44}>subtract μ<tspan dy="5" font-size="11">B</tspan></text>

    <!-- Row 2: centred -->
    <text class="f-title" x={right} y={rows.centred - 74} text-anchor="end">xᵢ − μ<tspan dy="5" font-size="12">B</tspan></text>
    <path class="f-thin f-blue f-fill-blue" d={centredBars} />
    <path class="f-axis" d={`M ${left} ${rows.centred} H ${right}`} />
    <line class="f-line f-amber" x1={sx(0)} x2={sx(0)} y1={rows.centred + 4} y2={rows.centred - 80} />
    {[-1, 1].map((s) => (
      <g>
        <line class="f-thin f-red" x1={sx(s * Math.sqrt(variance))} x2={sx(s * Math.sqrt(variance))} y1={rows.centred - 6} y2={rows.centred + 6} />
        <text class="f-small f-t-red" x={sx(s * Math.sqrt(variance))} y={rows.centred + 21} text-anchor="middle">{s < 0 ? '−σ' : 'σ'}<tspan dy="4" font-size="10">B</tspan></text>
      </g>
    ))}

    <!-- Arrows: divide by the standard deviation -->
    {[-1, 1].map((s) => (
      <path class="f-line f-red" d={`M ${sx(s * Math.sqrt(variance))} ${rows.centred + 28} L ${sx(s) + (s < 0 ? 3 : -3)} ${normTop - 14}`} marker-end="url(#f-arrow-red)" />
    ))}
    <text class="f-label f-t-red" x={sx(Math.sqrt(variance)) + 18} y={rows.centred + 50}>divide by √(σ<tspan dy="5" font-size="11">B</tspan><tspan dy="-12" font-size="11">2</tspan><tspan dy="7"> + ε)</tspan></text>

    <!-- Row 3: normalized -->
    <text class="f-math" x={right} y={normTop + 22} text-anchor="end">x̂<tspan dy="5" font-size="13">i</tspan></text>
    <text class="f-note" x={right} y={normTop + 42} text-anchor="end">mean {f2(Math.abs(meanHat))}, variance {f2(varHat)}</text>
    <path class="f-thin f-blue f-fill-blue" d={normBars} />
    <path class="f-line f-green f-dash" d={normalCurve} />
    <text class="f-note f-t-green" x={sx(-1.6)} y={rows.norm - 0.3 * pxPerDens - 4} text-anchor="end">𝒩(0, 1)</text>
    <path class="f-axis" d={`M ${left} ${rows.norm} H ${right}`} />
    {[-1, 1].map((s) => <line class="f-thin f-red" x1={sx(s)} x2={sx(s)} y1={rows.norm - 6} y2={rows.norm + 6} />)}
    {[-1, 1].map((s) => <line class="f-thin f-red f-dot" x1={sx(s)} x2={sx(s)} y1={normTop - 8} y2={rows.norm} />)}
    {xTicks.map((t) => <text class="f-note" x={sx(t)} y={rows.norm + 22} text-anchor="middle">{t}</text>)}
    <text class="f-note" x={sx(-1)} y={rows.norm + 22} text-anchor="middle">−1</text>
    <text class="f-note" x={sx(1)} y={rows.norm + 22} text-anchor="middle">1</text>
  </svg>
</Figure>
