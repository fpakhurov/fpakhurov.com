---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale } from '../geometry';
import { stages, resp, hard } from './toy';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// log p(X | θ) = L(q, θ) + KL(q ‖ p(Z | X, θ)) at four stages of two runs from θ0 = 0.6 on the seven-point mixture:
// exact EM (q = the posterior) and variational EM with q restricted to point masses (hard EM).
const ex = stages(resp), hd = stages(hard);
const f2 = (v: number) => v.toFixed(2);
const sig = (s: typeof ex) => s.map((v) => [v.th.toFixed(3), f2(v.ll), f2(v.L)].join('/')).join(' ');
if (sig(ex) !== '0.600/-16.35/-16.35 1.662/-12.83/-13.93 1.662/-12.83/-12.83 2.540/-12.00/-12.00') throw new Error('BoundGap: exact EM drifted from the note');
if (sig(hd) !== '0.600/-16.35/-19.18 2.300/-12.06/-13.40 2.300/-12.06/-12.82 2.767/-12.05/-12.50') throw new Error('BoundGap: hard EM drifted from the note');
const gaps = (s: typeof ex) => s.map((v) => f2(v.ll - v.L)).join(' ');
if (gaps(hd) !== '2.83 1.34 0.77 0.45' || gaps(ex) !== '0.00 1.10 0.00 0.00') throw new Error('BoundGap: gaps drifted from the note');

const neg = (s: string) => s.replace('-', '−');
const t = ru
  ? {
      title: 'Точный и ограниченный E-шаг: ℓ = L + KL',
      ex: 'q — точное апостериорное (EM)', hd: 'q — точечная масса (жёсткий EM)', key: 'черта: ℓ(θ), точка: L(q, θ)',
      st: ['E-шаг', 'M-шаг', 'E-шаг', 'предел'],
      steps: [
        'E-шаг при θ₀ = 0.6: точное апостериорное закрывает зазор, лучшая точечная масса оставляет KL = 2.83',
        'M-шаг: θ переходит в максимум своей нижней оценки (1.662 и 2.300); обе оценки растут, ℓ — сильнее',
        'E-шаг при новом θ: точный зазор снова закрыт, зазор точечной массы уменьшился до 0.77',
        'предел: EM приходит в максимум ℓ при θ = 2.540, жёсткий EM останавливается в 2.767 с зазором 0.45',
      ],
      desc: 'Четыре пары вертикальных отрезков. У каждого отрезка верхняя черта — логарифм правдоподобия, нижняя точка — нижняя оценка; длина отрезка — KL-зазор. У точного EM зазор после каждого E-шага нулевой, у жёсткого EM он остаётся положительным: 2.83, 1.34, 0.77, 0.45.',
    }
  : {
      title: 'An exact and a restricted E-step: ℓ = L + KL',
      ex: 'q = exact posterior (EM)', hd: 'q = point mass (hard EM)', key: 'tick: ℓ(θ), dot: L(q, θ)',
      st: ['E-step', 'M-step', 'E-step', 'converged'],
      steps: [
        'E-step at θ₀ = 0.6: the exact posterior closes the gap; the best point mass leaves KL = 2.83',
        'M-step: θ moves to the maximum of its bound (1.662 and 2.300); both bounds rise, ℓ rises more',
        'E-step at the new θ: the exact gap closes again, the point-mass gap shrinks to 0.77',
        'converged: EM reaches the maximum of ℓ at θ = 2.540; hard EM stops at 2.767 with a gap of 0.45',
      ],
      desc: 'Four pairs of vertical segments. On each segment the top tick is the log-likelihood and the bottom dot the lower bound; the length of the segment is the KL gap. For exact EM the gap is zero after every E-step; for hard EM it stays positive: 2.83, 1.34, 0.77, 0.45.',
    };
const id = 'bound-gap';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 372, x0: 64, x1: 584, y0: 70, y1: 296, dx: 18, nums: true, leg: [[64, 20], [304, 20], [64, 42]] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 430, x0: 46, x1: 350, y0: 92, y1: 352, dx: 12, nums: false, leg: [[16, 20], [16, 44], [16, 68]] },
];
const dom: [number, number] = [-20, -11.5];
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? `Смесь ½ N(0, 1) + ½ N(θ, 1) на семи точках, обе версии стартуют из θ₀ = 0.6. Для любого q логарифм правдоподобия ℓ(θ) (черта) равен нижней оценке L(q, θ) (точка) плюс KL(q ‖ p(Z | X, θ)) (длина отрезка). Синий: точный EM, E-шаг берёт апостериорное распределение и закрывает зазор. Жёлтый: вариационный EM, где q обязано быть точечной массой (жёсткий EM): после E-шага зазор остаётся, ${gaps(hd).split(' ').join(', ')}. M-шаги дают θ = ${ex[1].th.toFixed(3)} и ${hd[1].th.toFixed(3)}. В пределе EM приходит в максимум ℓ = ${neg(f2(ex[3].ll))} при θ = ${ex[3].th.toFixed(3)}, а жёсткий EM — в максимум своей нижней оценки, θ = ${hd[3].th.toFixed(3)}, где ℓ = ${neg(f2(hd[3].ll))}.`
    : `The mixture ½ N(0, 1) + ½ N(θ, 1) on seven points, both runs started at θ₀ = 0.6. For any q, the log-likelihood ℓ(θ) (tick) equals the lower bound L(q, θ) (dot) plus KL(q ‖ p(Z | X, θ)) (the length of the segment). Blue: exact EM, whose E-step takes the posterior and closes the gap. Amber: variational EM with q restricted to point masses (hard EM); after its E-steps the gap stays open, ${gaps(hd).split(' ').join(', ')}. The M-steps give θ = ${ex[1].th.toFixed(3)} and ${hd[1].th.toFixed(3)}. In the limit EM reaches the maximum ℓ = ${neg(f2(ex[3].ll))} at θ = ${ex[3].th.toFixed(3)}, and hard EM the maximum of its own bound, θ = ${hd[3].th.toFixed(3)}, where ℓ = ${neg(f2(hd[3].ll))}.`}
>
  {layouts.map((L) => {
    const sy = scale(dom, [L.y1, L.y0]);
    const cw = (L.x1 - L.x0) / 4;
    const cx = (i: number) => L.x0 + cw * (i + 0.5);
    const bar = (x: number, v: { ll: number; L: number }, tone: string, side: 'start' | 'end', show: boolean) => (
      <g>
        <path class={`f-line f-${tone}`} style="stroke-width: 5; stroke-opacity: .45" d={`M ${x} ${sy(v.L)} V ${sy(v.ll)}`} />
        <path class="f-line f-bold" d={`M ${x - 9} ${sy(v.ll)} H ${x + 9}`} />
        <circle cx={x} cy={sy(v.L)} r="4.2" style={`fill: var(--fig-${tone})`} />
        {show && <text class={`f-small f-t-${tone} f-halo`} x={side === 'end' ? x - 13 : x + 13} y={(sy(v.L) + sy(v.ll)) / 2 + 4.5} text-anchor={side}>{f2(v.ll - v.L)}</text>}
      </g>
    );
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        {[[t.ex, 'blue'], [t.hd, 'amber']].map(([label, tone], i) => (
          <g>
            <path class={`f-line f-${tone}`} style="stroke-width: 5; stroke-opacity: .45" d={`M ${L.leg[i][0]} ${L.leg[i][1] - 4} h 22`} />
            <text class="f-small" x={L.leg[i][0] + 30} y={L.leg[i][1]}>{label}</text>
          </g>
        ))}
        <text class="f-small f-t-muted" x={L.leg[2][0]} y={L.leg[2][1]}>{t.key}</text>
        {[-20, -18, -16, -14, -12].map((v) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} />
            <text class="f-note" x={L.x0 - 6} y={sy(v) + 4} text-anchor="end">{neg(String(v))}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {[0, 1, 2, 3].map((i) => (
          <g data-s={String(i + 1)}>
            {bar(cx(i) - L.dx, ex[i], 'blue', 'end', L.nums)}
            {bar(cx(i) + L.dx, hd[i], 'amber', 'start', L.nums)}
            <Badge x={cx(i)} y={L.y1 + 20} n={i + 1} />
            <text class="f-small" x={cx(i)} y={L.y1 + 48} text-anchor="middle">{t.st[i]}</text>
          </g>
        ))}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
