---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { bpca, ml, lam, q, d, n } from './bpca';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Ten-dimensional data from a three-dimensional probabilistic PCA model (100 points, unit noise), fitted with k = 9 columns
// by maximum likelihood and by Bayesian PCA (EM for the MAP loadings, one ARD precision per column, α_j = d / ‖wⱼ‖²).
const iters = 5000;
const fit = bpca(iters);
const prunedAt = Array.from({ length: q }, (_, j) => fit.norms.findIndex((r) => r[j] === 0));
const pruned = prunedAt.filter((v) => v > 0).sort((a, b) => a - b);
const kept = fit.norms[iters].filter((v) => v > 0).sort((a, b) => b - a);
const mlSorted = [...ml.norms].sort((a, b) => b - a);
if (fit.active.length !== 3 || pruned.join(' ') !== '22 39 83 131 199 331') throw new Error('BpcaPruning: pruning drifted from the note');
if (kept.map((v) => v.toFixed(2)).join(' ') !== '8.79 4.67 2.91' || fit.s2.toFixed(3) !== '0.970') throw new Error('BpcaPruning: kept columns drifted from the note');
if (ml.s2.toFixed(3) !== '0.642' || mlSorted.map((v) => v.toFixed(2)).join(' ') !== '9.24 4.95 3.13 0.87 0.78 0.73 0.49 0.34 0.14') throw new Error('BpcaPruning: ML fit drifted from the note');
if (lam.slice(0, 4).map((v) => v.toFixed(1)).join(' ') !== '86.1 25.2 10.5 1.4') throw new Error('BpcaPruning: eigenvalues drifted from the note');
// The fixed point of a column along an eigenvector with eigenvalue λ: (n + d) u² − [n(λ − σ²) − 2dσ²] u + dσ⁴ = 0 for u = ‖w‖²,
// with a positive root only when λ/σ² ≥ 1 + 2(d + √(d(n + d)))/n.
const root = (l: number) => {
  const B = n * (l - fit.s2) - 2 * d * fit.s2, disc = B * B - 4 * (n + d) * d * fit.s2 ** 2;
  return disc > 0 && B > 0 ? Math.sqrt((B + Math.sqrt(disc)) / (2 * (n + d))) : 0;
};
const thr = 1 + (2 * (d + Math.sqrt(d * (n + d)))) / n;
if (lam.slice(0, 3).some((l, i) => Math.abs(root(l) - kept[i]) > 1e-3) || root(lam[3]) !== 0 || thr.toFixed(3) !== '1.863') throw new Error('BpcaPruning: the fixed-point formula does not match the run');
const bpcaSorted = [...kept, ...new Array(q - kept.length).fill(0)];
// iterations drawn on the log axis: about 300 log-spaced ones
const ticks = [...new Set(Array.from({ length: 300 }, (_, i) => Math.round(iters ** (i / 299))))];

const t = ru
  ? {
      title: 'Байесовский PCA отключает лишние столбцы',
      lt: 'нормы столбцов ‖wⱼ‖, по убыванию', rt: '‖wⱼ‖ по итерациям EM (лог. шкала)', ml: 'макс. правдоподобие, k = 9', bp: 'байесовский PCA, k = 9',
      col: 'столбец', it: 'итерация EM', keep: '3 столбца остаются', off: '6 столбцов отключены',
      desc: 'Слева: девять пар столбиков; у максимального правдоподобия все девять норм положительны, у байесовского PCA ненулевые только три. Справа: девять кривых норм столбцов по итерациям; шесть падают до нуля, три выходят на постоянные значения.',
    }
  : {
      title: 'Bayesian PCA switches off the columns it does not need',
      lt: 'column norms ‖wⱼ‖, sorted', rt: '‖wⱼ‖ during EM (log scale)', ml: 'maximum likelihood, k = 9', bp: 'Bayesian PCA, k = 9',
      col: 'column', it: 'EM iteration', keep: '3 columns kept', off: '6 columns switched off',
      desc: 'Left: nine pairs of bars; maximum likelihood has all nine norms positive, Bayesian PCA only three. Right: nine curves of column norms over the EM iterations; six fall to zero, three level off.',
    };
const id = 'bpca-pruning';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 330, A: { x0: 56, x1: 330, y0: 44, y1: 266 }, B: { x0: 440, x1: 740, y0: 44, y1: 266 } },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 690, A: { x0: 44, x1: 344, y0: 44, y1: 276 }, B: { x0: 44, x1: 344, y0: 400, y1: 620 } },
];
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? `${n} точек в d = ${d} измерениях из модели вероятностного PCA с тремя латентными измерениями и единичным шумом; собственные значения выборочной ковариации ${lam.slice(0, 4).map((v) => v.toFixed(1)).join(', ')}, … Обе модели получают k = 9 столбцов. Максимальное правдоподобие (серые столбики) использует все девять: нормы √(λⱼ − σ²) при σ² = ${ml.s2.toFixed(3)} положительны и у шумовых направлений. Байесовский PCA (красные) с отдельной обратной дисперсией αⱼ для каждого столбца обнуляет шесть столбцов, на итерациях EM ${pruned.join(', ')}, а оставшиеся три медленно поворачиваются к собственным векторам и к итерации ${iters} приходят к нормам ${kept.map((v) => v.toFixed(2)).join(', ')} — корням уравнения неподвижной точки из текста; σ² = ${fit.s2.toFixed(3)} (истинное значение 1). Четвёртое собственное значение, ${lam[3].toFixed(2)}, меньше порога ${thr.toFixed(3)} σ² = ${(thr * fit.s2).toFixed(2)}, и у его столбца ненулевой неподвижной точки нет.`
    : `${n} points in d = ${d} dimensions from a probabilistic PCA model with three latent dimensions and unit noise; the eigenvalues of the sample covariance are ${lam.slice(0, 4).map((v) => v.toFixed(1)).join(', ')}, … Both models are given k = 9 columns. Maximum likelihood (grey bars) uses all nine: the norms √(λⱼ − σ²) with σ² = ${ml.s2.toFixed(3)} are positive for the noise directions too. Bayesian PCA (red), with one precision αⱼ per column, sets six columns to zero, at EM iterations ${pruned.join(', ')}; the other three slowly turn towards eigenvectors and by iteration ${iters} reach norms ${kept.map((v) => v.toFixed(2)).join(', ')}, the roots of the fixed-point equation in the text, with σ² = ${fit.s2.toFixed(3)} (true value 1). The fourth eigenvalue, ${lam[3].toFixed(2)}, is below the threshold ${thr.toFixed(3)} σ² = ${(thr * fit.s2).toFixed(2)}, and its column has no nonzero fixed point.`}
>
  {layouts.map((L) => {
    const A = L.A, B = L.B;
    const ay = scale([0, 10], [A.y1, A.y0]), sw = (A.x1 - A.x0) / q;
    const bxl = scale([0, Math.log10(iters)], [B.x0, B.x1]), bx = (i: number) => bxl(Math.log10(Math.max(i, 1))), by = scale([0, 10], [B.y1, B.y0]);
    const lx = A.x0 + 2.6 * sw;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        <text class="f-small f-t-muted" x={A.x0} y={A.y0 - 22}>{t.lt}</text>
        {[0, 2, 4, 6, 8, 10].map((v) => (
          <g>
            <path class="f-grid" d={`M ${A.x0} ${ay(v)} H ${A.x1}`} />
            <text class="f-note" x={A.x0 - 6} y={ay(v) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        {mlSorted.map((v, j) => (
          <g>
            <rect x={A.x0 + j * sw + sw * 0.14} y={ay(v)} width={sw * 0.34} height={ay(0) - ay(v)} style="fill: var(--muted); fill-opacity: .55" />
            {bpcaSorted[j] > 0 && <rect x={A.x0 + j * sw + sw * 0.52} y={ay(bpcaSorted[j])} width={sw * 0.34} height={ay(0) - ay(bpcaSorted[j])} style="fill: var(--fig-red)" />}
            <text class="f-note" x={A.x0 + (j + 0.5) * sw} y={A.y1 + 18} text-anchor="middle">{j + 1}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${A.x0} ${A.y1} H ${A.x1}`} />
        <text class="f-small f-t-muted" x={(A.x0 + A.x1) / 2} y={A.y1 + 40} text-anchor="middle">{t.col}</text>
        <rect x={lx} y={ay(9.3) - 9} width="14" height="10" style="fill: var(--muted); fill-opacity: .55" />
        <text class="f-small" x={lx + 20} y={ay(9.3)}>{t.ml}</text>
        <rect x={lx} y={ay(8.1) - 9} width="14" height="10" style="fill: var(--fig-red)" />
        <text class="f-small" x={lx + 20} y={ay(8.1)}>{t.bp}</text>

        <text class="f-small f-t-muted" x={B.x0} y={B.y0 - 22}>{t.rt}</text>
        {[0, 2, 4, 6, 8, 10].map((v) => (
          <g>
            <path class="f-grid" d={`M ${B.x0} ${by(v)} H ${B.x1}`} />
            <text class="f-note" x={B.x0 - 6} y={by(v) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        {[1, 10, 100, 1000].map((v) => <text class="f-note" x={bx(v)} y={B.y1 + 18} text-anchor="middle">{v}</text>)}
        <path class="f-axis" d={`M ${B.x0} ${B.y1} H ${B.x1}`} />
        <text class="f-small f-t-muted" x={(B.x0 + B.x1) / 2} y={B.y1 + 40} text-anchor="middle">{t.it}</text>
        {Array.from({ length: q }, (_, j) => {
          const end = prunedAt[j] > 0 ? prunedAt[j] : iters;
          const pts = [...ticks.filter((i) => i < end), end].map((i) => [bx(i), by(fit.norms[i][j])] as [number, number]);
          return (
            <g>
              <path class={prunedAt[j] > 0 ? 'f-thin f-muted' : 'f-line f-red'} style={prunedAt[j] > 0 ? 'stroke-width: 1.4' : ''} d={polyline(pts)} />
              {prunedAt[j] > 0 && <circle cx={bx(end)} cy={by(0)} r="3.4" class="f-solid-muted" />}
            </g>
          );
        })}
        <text class="f-small f-t-red f-halo" x={B.x1} y={by(9.9)} text-anchor="end">{t.keep}</text>
        <text class="f-small f-t-muted f-halo" x={B.x0 + 8} y={by(9.9)}>{t.off}</text>
      </svg>
    );
  })}
</Figure>
