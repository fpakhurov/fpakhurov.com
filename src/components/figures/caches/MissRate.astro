---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A cache simulator with LRU replacement, run at build time on the two traversals of a 64 x 64 matrix of 4-byte ints
// (16 KiB, row-major, starting at address 0) for cache sizes from 512 bytes to 32 KiB with 64-byte blocks.
// The same simulation is the Python program in the Code section of the note.
function missRate(trace: number[], size: number, block: number, ways: number | null) {
  const E = ways ?? size / block;
  const S = size / (block * E);
  const sets: number[][] = Array.from({ length: S }, () => []); // tags, least recently used first
  let misses = 0;
  for (const a of trace) {
    const blk = Math.floor(a / block);
    const set = sets[blk % S], tag = Math.floor(blk / S);
    const p = set.indexOf(tag);
    if (p !== -1) set.splice(p, 1);
    else {
      misses += 1;
      if (set.length === E) set.shift();
    }
    set.push(tag);
  }
  return misses / trace.length;
}
const N = 64, B = 64;
const row: number[] = [], col: number[] = [];
for (let i = 0; i < N; i++) for (let j = 0; j < N; j++) row.push((i * N + j) * 4);
for (let j = 0; j < N; j++) for (let i = 0; i < N; i++) col.push((i * N + j) * 4);
const lx: [number, number] = [9, 15]; // log2 of the cache size in bytes
const sizes = Array.from({ length: lx[1] - lx[0] + 1 }, (_, k) => lx[0] + k);
const series = {
  row: sizes.map((l) => missRate(row, 2 ** l, B, 1)),
  rowFA: sizes.map((l) => missRate(row, 2 ** l, B, null)),
  fa: sizes.map((l) => missRate(col, 2 ** l, B, null)),
  dm: sizes.map((l) => missRate(col, 2 ** l, B, 1)),
  w2: sizes.map((l) => missRate(col, 2 ** l, B, 2)),
  w4: sizes.map((l) => missRate(col, 2 ** l, B, 4)),
};
const floor = 1 / 16;
const same = (a: number[], b: number[]) => a.every((v, k) => Math.abs(v - b[k]) < 1e-12);
if (!series.row.every((v) => v === floor) || !same(series.row, series.rowFA)) throw new Error(`row-major ${series.row}`);
if (!same(series.fa, [1, 1, 1, floor, floor, floor, floor])) throw new Error(`fully associative ${series.fa}`);
if (!same(series.dm, [1, 1, 1, 1, 1, floor, floor])) throw new Error(`direct-mapped ${series.dm}`);
if (!same(series.dm, series.w2) || !same(series.dm, series.w4)) throw new Error('2-way and 4-way should equal direct-mapped here');
const amat = (m: number) => 4 + 200 * m; // the note's L1: hit time 4 cycles, miss penalty 200 cycles
if (amat(floor) !== 16.5 || amat(1) !== 204) throw new Error('AMAT');

const sizeLabel = (l: number) => (l < 10 ? (ru ? '512 Б' : '512 B') : `${2 ** (l - 10)} ${ru ? 'КиБ' : 'KiB'}`);
const t = ru
  ? { y: 'доля промахов', y2: 'AMAT, такты', x: 'размер кэша (блоки по 64 Б)', cap: 'промахи ёмкости', capN: 'ёмкость', conf: 'конфликтные промахи', confN: 'конфликт',
      comp: ['обязательные:', '1 из 16'], row: 'по строкам: любой размер и устройство', fa: 'полностью ассоциативный', dm: ['с прямым отображением,', '2- и 4-канальный'],
      legend: ['по строкам: любой кэш', 'по столбцам: полностью ассоциативный', 'по столбцам: прямое отображение, 2 и 4 канала'] }
  : { y: 'miss rate', y2: 'AMAT, cycles', x: 'cache size (64-byte blocks)', cap: 'capacity misses', capN: 'capacity', conf: 'conflict misses', confN: 'conflict',
      comp: ['compulsory:', '1 in 16'], row: 'row-major: every size and organization', fa: 'fully associative', dm: ['direct-mapped,', '2-way and 4-way'],
      legend: ['row-major: any cache', 'column-major: fully associative', 'column-major: direct-mapped, 2- or 4-way'] };

interface Layout { cls: string; W: number; H: number; box: [number, number, number, number]; xt: number[]; wide: boolean; legend: [number, number] }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 340, box: [86, 34, 650, 284], xt: sizes, wide: true, legend: [0, 0] },
  { cls: 'fig-narrow', W: 360, H: 420, box: [52, 34, 300, 284], xt: [9, 11, 13, 15], wide: false, legend: [16, 346] },
];
const yt = [0, 0.25, 0.5, 0.75, 1];
const id = 'cache-miss-rate';
const pct = (v: number) => `${Math.round(v * 100)}${ru ? '%' : ' %'}`;
---

<Figure
  id={id}
  title={ru ? 'Промахи при обходе матрицы по строкам и по столбцам' : 'Misses when a matrix is traversed by rows and by columns'}
  caption={ru
    ? `Результат симуляции кэша с замещением LRU и блоками по 64 байта на двух обходах матрицы 64 × 64 из 4-байтовых целых (16 КиБ, хранится по строкам). Обход по строкам промахивается один раз на блок, то есть на 1 обращение из 16 (6.25%), при любом размере и устройстве кэша: это обязательные промахи. Обход по столбцам при каждом шаге переходит к следующей строке, на 256 байт дальше, и возвращается к тому же блоку только через 64 обращения. Чтобы удержать блоки, полностью ассоциативному кэшу нужно 64 блока, 4 КиБ; меньший промахивается всегда (промахи ёмкости). Кэшу с прямым отображением, а также 2- и 4-канальному, нужно 16 КиБ: адреса с шагом 256 байт попадают только в каждый четвёртый набор, и использовать удаётся лишь четверть ёмкости (конфликтные промахи). Правая шкала переводит долю промахов в среднее время доступа (AMAT) при времени попадания 4 такта и штрафе за промах 200 тактов: ${amat(floor)} такта против ${amat(1)}.`
    : `A simulated cache with LRU replacement and 64-byte blocks, on the two traversals of a 64 × 64 matrix of 4-byte ints (16 KiB, stored row by row). The row-major traversal misses once per block, 1 access in 16 (6.25 %), at every size and organization: these are the compulsory misses. The column-major traversal moves to the next row, 256 bytes further, at every step, and returns to the same block only 64 accesses later. A fully associative cache needs 64 blocks, 4 KiB, to keep them; a smaller one misses every time (capacity misses). A direct-mapped cache, and equally a 2-way or 4-way one, needs 16 KiB: addresses 256 bytes apart fall only into every fourth set, so only a quarter of the capacity is usable (conflict misses). The right-hand scale turns the miss rate into the average memory access time for a hit time of 4 cycles and a miss penalty of 200 cycles: ${amat(floor)} cycles against ${amat(1)}.`}
>
  {layouts.map((L) => {
    const [x0, y0, x1, y1] = L.box;
    const sx = scale(lx, [x0, x1]);
    const sy = scale([0, 1], [y1, y0]);
    const line = (v: number[]) => v.map((m, k) => `${k ? 'L' : 'M'} ${sx(sizes[k]).toFixed(1)} ${sy(m).toFixed(1)}`).join(' ');
    const band = (upper: number[], lower: number[]) =>
      `${line(upper)} ${lower.map((m, k) => k).reverse().map((k) => `L ${sx(sizes[k]).toFixed(1)} ${sy(lower[k]).toFixed(1)}`).join(' ')} Z`;
    const floorLine = sizes.map(() => floor);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Доля промахов в зависимости от размера кэша' : 'Miss rate against cache size'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'По горизонтали размер кэша от 512 байт до 32 КиБ в логарифмической шкале, по вертикали доля промахов от 0 до 100%. Обход по строкам держится на 6.25% при любом размере. Обход по столбцам даёт 100% промахов, пока полностью ассоциативный кэш меньше 4 КиБ, а кэш с прямым отображением меньше 16 КиБ, затем падает до 6.25%. Область между линией полностью ассоциативного кэша и уровнем 6.25% подписана как промахи ёмкости, область между двумя линиями обхода по столбцам — как конфликтные промахи.'
          : 'Cache size from 512 bytes to 32 KiB on a logarithmic horizontal axis, miss rate from 0 to 100 percent on the vertical axis. The row-major traversal stays at 6.25 percent at every size. The column-major traversal misses 100 percent of the time until a fully associative cache reaches 4 KiB, and a direct-mapped one 16 KiB, and then drops to 6.25 percent. The area between the fully associative line and 6.25 percent is labelled capacity misses, the area between the two column-major lines conflict misses.'}</desc>
        <path class="f-fill-blue" d={band(series.fa, floorLine)} />
        <path class="f-fill-red" d={band(series.dm, series.fa)} />
        {yt.map((m) => (
          <g>
            <path class="f-grid" d={`M ${x0} ${sy(m)} H ${x1}`} />
            <text class="f-note" x={x0 - 8} y={sy(m) + 5} text-anchor="end">{pct(m)}</text>
            <text class="f-note" x={x1 + 8} y={sy(m) + 5}>{amat(m)}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${x0} ${y0} V ${y1} H ${x1} V ${y0}`} />
        {L.xt.map((l) => (
          <g>
            <path class="f-axis" d={`M ${sx(l)} ${y1} v 5`} />
            <text class="f-note" x={sx(l)} y={y1 + 20} text-anchor="middle">{sizeLabel(l)}</text>
          </g>
        ))}
        <text class="f-note" x={x0} y={y0 - 14}>{t.y}</text>
        <text class="f-note" x={L.W - 4} y={y0 - 14} text-anchor="end">{t.y2}</text>
        <text class="f-note" x={x1} y={y1 + 40} text-anchor="end">{t.x}</text>
        <path class="f-line f-blue f-bold" d={line(series.fa)} />
        <path class="f-line f-red f-bold f-dash" d={line(series.dm)} />
        <path class="f-line f-green f-bold" d={line(series.row)} />
        {sizes.map((l, k) => (
          <g>
            <circle cx={sx(l)} cy={sy(series.fa[k])} r="3.5" class="f-solid-blue" />
            <circle cx={sx(l)} cy={sy(series.dm[k])} r="2.2" class="f-solid-red" />
            <circle cx={sx(l)} cy={sy(series.row[k])} r="3.5" class="f-solid-green" />
          </g>
        ))}
        <text class="f-small f-halo" x={sx(10)} y={sy(0.55)} text-anchor="middle">{L.wide ? t.cap : t.capN}</text>
        <text class="f-small f-halo" x={sx(12.55)} y={sy(0.55)} text-anchor="middle">{L.wide ? t.conf : t.confN}</text>
        {L.wide
          ? <g>
              <text class="f-small f-t-green f-halo" x={x0 + 8} y={sy(floor) - 9}>{t.row}</text>
              {t.comp.map((s, k) => <text class="f-small f-t-muted f-halo" x={x1 - 6} y={sy(floor) - 25 + k * 16} text-anchor="end">{s}</text>)}
              <text class="f-small f-t-blue f-halo" x={sx(11.3) - 4} y={sy(0.35)} text-anchor="end">{t.fa}</text>
              {t.dm.map((s, k) => <text class="f-small f-t-red f-halo" x={sx(13.5) + 12} y={sy(0.62) + k * 16}>{s}</text>)}
            </g>
          : <g>
              {t.legend.map((s, k) => (
                <g>
                  <path class={`f-line f-bold ${['f-green', 'f-blue', 'f-red'][k]}`} d={`M ${L.legend[0]} ${L.legend[1] + k * 22 - 4.5} h 20`} />
                  <text class="f-small" x={L.legend[0] + 28} y={L.legend[1] + k * 22}>{s}</text>
                </g>
              ))}
            </g>}
      </svg>
    );
  })}
</Figure>
