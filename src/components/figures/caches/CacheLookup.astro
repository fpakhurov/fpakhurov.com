---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Op from '../seqflow/Op.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A 16 KiB, 4-way set-associative cache with 64-byte blocks and 32-bit addresses, the worked example of the note:
// 16384 / (4 * 64) = 64 sets, so 6 offset bits, 6 index bits and 20 tag bits. The load reads address 0x1234ABCC.
const C = 16384, Bk = 64, E = 4, m = 32;
const S = C / (Bk * E);
const b = Math.log2(Bk), s = Math.log2(S), tBits = m - s - b;
const addr = 0x1234abcc;
const offset = addr & (Bk - 1);
const index = (addr >>> b) & (S - 1);
const tag = addr >>> (b + s);
if (S !== 64 || b !== 6 || s !== 6 || tBits !== 20) throw new Error(`geometry S=${S} b=${b} s=${s} t=${tBits}`);
if (offset !== 12 || index !== 47 || tag !== 0x1234a) throw new Error(`split ${tag.toString(16)} ${index} ${offset}`);
const hex = (v: number, w = 5) => '0x' + v.toString(16).toUpperCase().padStart(w, '0');
// Contents of set 47: way 1 holds the block with the address's tag; way 3 is empty.
const ways = [
  { v: 1, tag: 0x0f00c },
  { v: 1, tag: 0x1234a },
  { v: 1, tag: 0x7fff0 },
  { v: 0, tag: -1 },
];
const hitWay = ways.findIndex((w) => w.v === 1 && w.tag === tag);
if (hitWay !== 1) throw new Error(`hit way ${hitWay}`);
const setRows = ['0', '1', '⋮', String(index), '⋮', String(S - 1)];

const t = ru
  ? {
      addr: 'адрес', tagL: `тег ${hex(tag)}`, idxL: `индекс ${index}`, offL: `смещение ${offset}`,
      tagS: 'биты 31–12', idxS: 'биты 11–6', offS: 'биты 5–0', nTag: 'тег', nIdx: 'индекс', nOff: 'смещение', set: 'набор', sets: `${S} наборов`,
      hV: 'V', hTag: 'тег', hData: 'данные', block: 'блок 64 Б', blockN: 'блок', mux: 'mux', muxSub: `канал ${hitWay}`,
      muxNote: ['пропускает канал', 'с совпавшим тегом'], hit: `канал ${hitWay}: тег совпал и V = 1, попадание`, hitN: `попадание: канал ${hitWay}`,
      sel: 'выбор', word: 'слово', wordSub: `байты ${offset}–${offset + 3}`, offN: `смещение ${offset}`,
      steps: [
        `разбить адрес: тег ${hex(tag)}, индекс ${index}, смещение ${offset}`,
        `индекс выбирает набор ${index} из ${S}, и все ${E} канала читаются одновременно`,
        `сравнить ${E} хранимых тега с тегом адреса параллельно; совпадение засчитывается только при V = 1`,
        `совпал канал ${hitWay}: попадание, мультиплексор пропускает его блок`,
        `смещение ${offset} выбирает байты ${offset}–${offset + 3} блока: слово, которое вернёт загрузка`,
      ],
    }
  : {
      addr: 'address', tagL: `tag ${hex(tag)}`, idxL: `index ${index}`, offL: `offset ${offset}`,
      tagS: 'bits 31–12', idxS: 'bits 11–6', offS: 'bits 5–0', nTag: 'tag', nIdx: 'index', nOff: 'offset', set: 'set', sets: `${S} sets`,
      hV: 'V', hTag: 'tag', hData: 'data', block: '64-byte block', blockN: 'block', mux: 'mux', muxSub: `way ${hitWay}`,
      muxNote: ['passes the way', 'whose tag matched'], hit: `way ${hitWay}: tags equal and V = 1, a hit`, hitN: `hit in way ${hitWay}`,
      sel: 'select', word: 'word', wordSub: `bytes ${offset}–${offset + 3}`, offN: `offset ${offset}`,
      steps: [
        `split the address: tag ${hex(tag)}, index ${index}, offset ${offset}`,
        `the index selects set ${index} of ${S} and reads out all ${E} ways`,
        `compare the ${E} stored tags with the address tag at once; a match counts only if V = 1`,
        `way ${hitWay} matches: a hit, and the multiplexer passes its block`,
        `the offset ${offset} selects bytes ${offset}–${offset + 3} of the block: the word the load returns`,
      ],
    };

interface Layout {
  cls: string; W: number; H: number; wide: boolean;
  fields: { x: number; w: number }[]; fy: number; fh: number;
  table: { x: number; w: number; y: number; rh: number };
  group: { x: number; y: number; w: number; h: number };
  rows: { y0: number; step: number; h: number };
  cell: { vx: number; vw: number; tx: number; tw: number; cx: number; bus: number; dx: number; dw: number };
  idxRoute: [number, number][]; tagRoute: [number, number][];
  badges: [number, number][];
}
const layouts: Layout[] = [
  {
    cls: 'fig-wide', W: 760, H: 304, wide: true,
    fields: [{ x: 150, w: 250 }, { x: 400, w: 130 }, { x: 530, w: 130 }], fy: 20, fh: 44,
    table: { x: 20, w: 90, y: 100, rh: 16 },
    group: { x: 140, y: 84, w: 340, h: 188 },
    rows: { y0: 100, step: 40, h: 30 },
    cell: { vx: 150, vw: 24, tx: 176, tw: 84, cx: 290, bus: 322, dx: 340, dw: 130 },
    idxRoute: [[465, 64], [465, 76], [12, 76], [12, 156], [18, 156]],
    tagRoute: [[322, 64], [322, 235]],
    badges: [[676, 28], [65, 90], [290, 90], [530, 88], [640, 132]],
  },
  {
    cls: 'fig-narrow seq-narrow', W: 360, H: 456, wide: false,
    fields: [{ x: 10, w: 150 }, { x: 160, w: 95 }, { x: 255, w: 95 }], fy: 30, fh: 46,
    table: { x: 14, w: 70, y: 104, rh: 18 },
    group: { x: 96, y: 100, w: 248, h: 172 },
    rows: { y0: 108, step: 42, h: 30 },
    cell: { vx: 104, vw: 20, tx: 126, tw: 66, cx: 212, bus: 244, dx: 256, dw: 80 },
    idxRoute: [[207, 76], [207, 88], [6, 88], [6, 167], [12, 167]],
    tagRoute: [[140, 76], [140, 96], [244, 96], [244, 249]],
    badges: [[24, 20], [49, 252], [318, 286], [218, 320], [338, 372]],
  },
];
const path = (pts: [number, number][]) => pts.map((p, i) => `${i ? 'L' : 'M'} ${p[0]} ${p[1]}`).join(' ');
const id = 'cache-lookup';
---

<Figure
  id={id}
  title={ru ? 'Поиск в 4-канальном наборно-ассоциативном кэше' : 'A lookup in a 4-way set-associative cache'}
  caption={ru
    ? `Кэш 16 КиБ, 4 канала, блоки по 64 байта, 32-битные адреса: ${S} наборов, поэтому смещение занимает ${b} бит, индекс ${s} бит, тег ${tBits} бит. Загрузка по адресу 0x1234ABCC (1): индекс ${index} выбирает один набор, и его четыре канала читаются одновременно (2). Каждый канал хранит бит достоверности V, тег и блок данных. Четыре компаратора сравнивают хранимые теги с тегом адреса ${hex(tag)} параллельно (3); совпадение в канале ${hitWay} при V = 1 означает попадание, и мультиплексор пропускает блок этого канала (4). Смещение ${offset} выбирает в блоке байты ${offset}–${offset + 3}, то есть слово, которое загрузка запишет в регистр (5). Если бы ни один тег не совпал, это был бы промах: блок пришёл бы со следующего уровня и занял бы место в канале, который выбрала политика замещения. Цвета: зелёный — части адреса, синий — содержимое кэша, янтарный — сравнение и выбор, красный — результат.`
    : `A 16 KiB cache with 4 ways, 64-byte blocks and 32-bit addresses: ${S} sets, so the offset takes ${b} bits, the index ${s} bits and the tag ${tBits} bits. A load from address 0x1234ABCC (1): the index ${index} selects one set, and its four ways are read out at once (2). Each way holds a valid bit V, a tag and a block of data. Four comparators check the stored tags against the address tag ${hex(tag)} in parallel (3); a match in way ${hitWay} with V = 1 is a hit, and the multiplexer passes that way's block (4). The offset ${offset} selects bytes ${offset}–${offset + 3} of the block, the word the load writes to its register (5). Had no tag matched, the access would be a miss: the block would come from the next level and take the place of the way chosen by the replacement policy. Colours: green for parts of the address, blue for the cache's contents, amber for comparison and selection, red for the result.`}
>
  {layouts.map((L) => {
    const cy = (k: number) => L.rows.y0 + k * L.rows.step + L.rows.h / 2;
    const ry = (k: number) => L.rows.y0 + k * L.rows.step;
    const c = L.cell;
    const fx = (i: number) => L.fields[i].x + L.fields[i].w / 2;
    const row47 = L.table.y + 3 * L.table.rh + L.table.rh / 2;
    const fieldLabels = L.wide ? [[t.tagL, t.tagS], [t.idxL, t.idxS], [t.offL, t.offS]] : [[hex(tag), t.nTag], [String(index), t.nIdx], [String(offset), t.nOff]];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Как кэш находит слово по адресу' : 'How a cache finds a word from its address'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? `Адрес 0x1234ABCC разбит на три поля: тег ${hex(tag)}, индекс ${index} и смещение ${offset}. Линия от индекса ведёт к набору ${index} в столбце из ${S} наборов. Набор показан крупно: четыре канала, у каждого бит V, тег и блок данных. Теги каналов 0x0F00C, 0x1234A, 0x7FFF0, а канал 3 пуст. Тег адреса идёт ко всем четырём компараторам; совпадает канал 1. Мультиплексор пропускает блок канала 1, а смещение выбирает в нём байты 12–15 — слово-результат.`
          : `The address 0x1234ABCC is split into three fields: tag ${hex(tag)}, index ${index} and offset ${offset}. A line from the index leads to set ${index} in a column of ${S} sets. The set is shown enlarged: four ways, each with a valid bit, a tag and a block of data. The tags of the ways are 0x0F00C, 0x1234A and 0x7FFF0, and way 3 is empty. The address tag goes to all four comparators; way 1 matches. A multiplexer passes way 1's block, and the offset selects bytes 12 to 15 of it, the resulting word.`}</desc>

        {/* 1: the address and its three fields */}
        <g data-s="1">
          {L.wide
            ? <g>
                <text class="f-label" x={L.fields[0].x - 10} y={L.fy + 18} text-anchor="end">{t.addr}</text>
                <text class="f-label" x={L.fields[0].x - 10} y={L.fy + 36} text-anchor="end">0x1234ABCC</text>
              </g>
            : <text class="f-label" x={L.W / 2} y={20} text-anchor="middle">{t.addr} 0x1234ABCC</text>}
          {L.fields.map((f, i) => <Box x={f.x} y={L.fy} w={f.w} h={L.fh} label={fieldLabels[i][0]} sub={fieldLabels[i][1]} tone="x" />)}
          <Badge x={L.badges[0][0]} y={L.badges[0][1]} n={1} />
        </g>

        {/* 3: the address tag goes to every comparator (drawn first: the index route crosses it) */}
        <g data-s="3">
          <path class="f-line f-green" d={path(L.tagRoute)} />
          {ways.map((_, k) => (
            <path class="f-line f-green" d={`M ${c.bus} ${cy(k)} L ${c.cx + 15} ${cy(k)}`} marker-end="url(#f-arrow-green)" />
          ))}
        </g>

        {/* 2: the index selects one set; its ways are read out */}
        <g data-s="2">
          <path d={path(L.idxRoute)} style="fill: none; stroke: var(--paper); stroke-width: 7" />
          <path class="f-line f-green" d={path(L.idxRoute)} marker-end="url(#f-arrow-green)" />
          {setRows.map((r, k) => {
            const y = L.table.y + k * L.table.rh;
            const sel = k === 3;
            return (
              <g>
                <rect x={L.table.x} y={y} width={L.table.w} height={L.table.rh} style={`fill: ${sel ? toneVar.h : 'var(--paper-strong)'}; fill-opacity: ${sel ? 0.22 : 1}; stroke: ${sel ? toneVar.h : 'var(--line)'}; stroke-width: ${sel ? 1.6 : 1}`} />
                <text class={`f-small${sel ? '' : ' f-t-muted'}`} x={L.table.x + 6} y={y + L.table.rh / 2 + 4.5}>{r === '⋮' ? r : `${t.set} ${r}`}</text>
              </g>
            );
          })}
          <text class="f-small f-t-muted" x={L.table.x + L.table.w / 2} y={L.table.y + 6 * L.table.rh + 18} text-anchor="middle">{t.sets}</text>
          <path class="f-line f-blue f-dash" d={`M ${L.table.x + L.table.w} ${row47} L ${L.group.x} ${row47}`} />
          <rect x={L.group.x} y={L.group.y} width={L.group.w} height={L.group.h} rx="9" style={`fill: ${toneVar.h}; fill-opacity: 0.04; stroke: ${toneVar.h}; stroke-width: 1.2; stroke-dasharray: 6 4`} />
          {L.wide && (
            <g>
              <text class="f-small f-t-muted" x={c.vx + c.vw / 2} y={L.rows.y0 - 4} text-anchor="middle">{t.hV}</text>
              <text class="f-small f-t-muted" x={c.tx + c.tw / 2} y={L.rows.y0 - 4} text-anchor="middle">{t.hTag}</text>
              <text class="f-small f-t-muted" x={c.dx + c.dw / 2} y={L.rows.y0 - 4} text-anchor="middle">{t.hData}</text>
            </g>
          )}
          {ways.map((w, k) => (
            <g>
              <rect x={c.vx} y={ry(k)} width={c.vw} height={L.rows.h} style={`fill: ${toneVar.h}; fill-opacity: 0.14; stroke: ${toneVar.h}; stroke-width: 1.1`} />
              <text class="f-small" x={c.vx + c.vw / 2} y={cy(k) + 4.5} text-anchor="middle">{w.v}</text>
              <rect x={c.tx} y={ry(k)} width={c.tw} height={L.rows.h} style={`fill: ${toneVar.h}; fill-opacity: ${k === hitWay ? 0.3 : 0.14}; stroke: ${toneVar.h}; stroke-width: ${k === hitWay ? 2 : 1.1}`} />
              <text class="f-small" x={c.tx + c.tw / 2} y={cy(k) + 4.5} text-anchor="middle">{w.v ? hex(w.tag) : '—'}</text>
              <rect x={c.dx} y={ry(k)} width={c.dw} height={L.rows.h} style={`fill: ${toneVar.h}; fill-opacity: ${k === hitWay ? 0.3 : 0.14}; stroke: ${toneVar.h}; stroke-width: ${k === hitWay ? 2 : 1.1}`} />
              <text class={`f-small${w.v ? '' : ' f-t-muted'}`} x={c.dx + c.dw / 2} y={cy(k) + 4.5} text-anchor="middle">{L.wide ? t.block : t.blockN}</text>
            </g>
          ))}
          <Badge x={L.badges[1][0]} y={L.badges[1][1]} n={2} />
        </g>

        {/* 3: comparators */}
        <g data-s="3">
          {ways.map((_, k) => (
            <g>
              <path class={k === hitWay ? 'f-line f-blue f-bold' : 'f-thin f-muted'} d={`M ${c.tx + c.tw} ${cy(k)} L ${c.cx - 14} ${cy(k)}`} />
              <Op x={c.cx} y={cy(k)} sym="=" tone={k === hitWay ? 'amber' : 'ink'} />
            </g>
          ))}
          <text class="f-small f-t-amber" x={L.wide ? c.vx : L.group.x} y={L.group.y + L.group.h + 20}>{L.wide ? t.hit : t.hitN}</text>
          <Badge x={L.badges[2][0]} y={L.badges[2][1]} n={3} />
        </g>

        {/* 4: the multiplexer passes the matching way's block */}
        <g data-s="4">
          {L.wide
            ? <g>
                {ways.map((_, k) => (
                  <path class={k === hitWay ? 'f-line f-blue f-bold' : 'f-thin f-muted'} d={`M ${c.dx + c.dw} ${cy(k)} L 508 ${cy(k)}`} marker-end={k === hitWay ? 'url(#f-arrow-blue)' : undefined} />
                ))}
                <path d="M 510 100 L 550 114 L 550 236 L 510 250 Z" style={`fill: ${toneVar.g}; fill-opacity: 0.14; stroke: ${toneVar.g}; stroke-width: 1.3`} />
                <text class="f-label" x="530" y="180" text-anchor="middle">{t.mux}</text>
                {t.muxNote.map((line, k) => <text class="f-small f-t-muted" x="530" y={270 + k * 16} text-anchor="middle">{line}</text>)}
              </g>
            : <g>
                {ways.map((_, k) => <path class="f-thin f-muted" d={`M ${c.dx + c.dw} ${cy(k)} L 350 ${cy(k)}`} />)}
                <path class="f-thin f-muted" d={`M 350 ${cy(0)} L 350 ${cy(1)}`} />
                <path class="f-line f-blue f-bold" d={`M ${c.dx + c.dw} ${cy(1)} L 350 ${cy(1)} L 350 298`} marker-end="url(#f-arrow-blue)" />
                <path class="f-thin f-muted" d={`M 350 ${cy(2)} L 350 ${cy(3)}`} />
                <Box x={230} y={300} w={124} h={40} label={t.mux} sub={t.muxSub} tone="g" />
              </g>}
          <Badge x={L.badges[3][0]} y={L.badges[3][1]} n={4} />
        </g>

        {/* 5: the offset selects the word */}
        <g data-s="5">
          {L.wide
            ? <g>
                <path class="f-line" d="M 550 175 L 578 175" marker-end="url(#f-arrow)" />
                <path class="f-line f-green" d={`M ${fx(2)} ${L.fy + L.fh} L ${fx(2)} 160`} marker-end="url(#f-arrow-green)" />
                <Op x={610} y={175} sym={t.sel} tone="amber" />
                <path class="f-line f-red" d="M 640 175 L 658 175" marker-end="url(#f-arrow-red)" />
                <Box x={660} y={150} w={90} h={50} label={t.word} sub={t.wordSub} tone="y" />
              </g>
            : <g>
                <path class="f-line" d="M 292 340 L 292 357" marker-end="url(#f-arrow)" />
                <text class="f-small f-t-green" x="252" y="377" text-anchor="end">{t.offN}</text>
                <Op x={292} y={372} sym={t.sel} tone="amber" />
                <path class="f-line f-red" d="M 292 385 L 292 398" marker-end="url(#f-arrow-red)" />
                <Box x={212} y={400} w={140} h={46} label={t.word} sub={t.wordSub} tone="y" />
              </g>}
          <Badge x={L.badges[4][0]} y={L.badges[4][1]} n={5} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
