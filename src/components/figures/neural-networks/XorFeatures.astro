---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { mulberry32, normal } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Noisy XOR: four clusters of 50 points around (±1, ±1) with standard deviation 0.3; the class is 1 when x₁x₂ < 0.
// A 2 → 2 → 1 network with tanh hidden units and a sigmoid output, trained by full-batch Adam (step 0.05, 300 steps)
// on the binary cross-entropy. Panel (a) shows the two hidden units as lines in the input plane, panel (b) the points
// in the coordinates (h₁, h₂) of the hidden layer, where one line separates the classes.
const u = mulberry32(3), z = normal(u);
const centres: [number, number, number][] = [[-1, -1, 0], [1, 1, 0], [-1, 1, 1], [1, -1, 1]];
const X: [number, number][] = [], Y: number[] = [], cluster: number[] = [];
centres.forEach(([cx, cy, y], k) => {
  for (let i = 0; i < 50; i += 1) { X.push([cx + 0.3 * z(), cy + 0.3 * z()]); Y.push(y); cluster.push(k); }
});
type Net = { W: number[]; b: number[]; v: number[]; c: number[] };
const forward = (P: Net, x: [number, number]) => {
  const H = P.b.length, h: number[] = [];
  let o = P.c[0];
  for (let j = 0; j < H; j += 1) { h.push(Math.tanh(P.W[2 * j] * x[0] + P.W[2 * j + 1] * x[1] + P.b[j])); o += P.v[j] * h[j]; }
  return { h, o, p: 1 / (1 + Math.exp(-o)) };
};
// Weights start from N(0, 1/fan-in), biases from zero; Adam with β = (0.9, 0.999).
const train = (H: number, seed: number) => {
  const r = normal(mulberry32(seed));
  const P: Net = { W: Array.from({ length: 2 * H }, () => r() * Math.SQRT1_2), b: new Array(H).fill(0), v: Array.from({ length: H }, () => r() * Math.sqrt(1 / H)), c: [0] };
  const parts = [P.W, P.b, P.v, P.c], m = parts.map((a) => a.map(() => 0)), s = parts.map((a) => a.map(() => 0));
  const n = X.length;
  for (let t = 1; t <= 300; t += 1) {
    const g = parts.map((a) => a.map(() => 0));
    for (let i = 0; i < n; i += 1) {
      const { h, p } = forward(P, X[i]);
      const d = (p - Y[i]) / n;
      g[3][0] += d;
      for (let j = 0; j < H; j += 1) {
        g[2][j] += d * h[j];
        const dz = d * P.v[j] * (1 - h[j] * h[j]);
        g[1][j] += dz; g[0][2 * j] += dz * X[i][0]; g[0][2 * j + 1] += dz * X[i][1];
      }
    }
    parts.forEach((a, k) => a.forEach((_, q) => {
      m[k][q] = 0.9 * m[k][q] + 0.1 * g[k][q];
      s[k][q] = 0.999 * s[k][q] + 0.001 * g[k][q] ** 2;
      a[q] -= (0.05 * m[k][q] / (1 - 0.9 ** t)) / (Math.sqrt(s[k][q] / (1 - 0.999 ** t)) + 1e-8);
    }));
  }
  let correct = 0, loss = 0;
  X.forEach((x, i) => { const { p } = forward(P, x); correct += Number((p > 0.5) === (Y[i] === 1)); loss -= Y[i] ? Math.log(p) : Math.log(1 - p); });
  return { P, acc: correct / n, loss: loss / n };
};
const net = train(2, 1);
const P = net.P;
// Ten initializations each for two and for four hidden units: how often does training separate all 200 points?
const solved = (H: number) => Array.from({ length: 10 }, (_, k) => train(H, k + 1)).filter((r) => r.acc === 1).length;
const solved2 = solved(2), solved4 = solved(4);
const r1 = (v: number) => v.toFixed(1);
const quoted = [net.acc, net.loss.toFixed(3), ...P.W.map(r1), ...P.b.map(r1), ...P.v.map(r1), r1(P.c[0]), solved2, solved4].join();
if (quoted !== '1,0.013,3.8,3.2,3.4,3.4,3.4,-3.1,5.3,-5.4,-5.2,4,10') throw new Error(`XorFeatures: numbers drifted from the note (${quoted})`);
// Where each cluster lands in the hidden layer (the mean of its 50 hidden vectors), rounded to the nearest corner.
const H = X.map((x) => forward(P, x).h as [number, number]);
const corner = centres.map((_, k) => {
  const idx = cluster.map((c, i) => (c === k ? i : -1)).filter((i) => i >= 0);
  return [0, 1].map((d) => Math.sign(idx.reduce((acc, i) => acc + H[i][d], 0))).join();
});
if (corner.join(' ') !== '-1,-1 1,1 1,-1 1,-1') throw new Error(`XorFeatures: the clusters moved to other corners (${corner.join(' ')})`);
// How well the rule "between the two lines" (h₁ > 0 and h₂ < 0) matches the network's own decision on a 201 × 201 grid.
let agree = 0;
for (let i = 0; i <= 200; i += 1) for (let j = 0; j <= 200; j += 1) {
  const x: [number, number] = [-2.2 + 0.022 * i, -2.2 + 0.022 * j];
  const { h, p } = forward(P, x);
  agree += Number((h[0] > 0 && h[1] < 0) === (p > 0.5));
}
const agreePct = (100 * agree) / 201 ** 2;
if (agreePct.toFixed(1) !== '99.6') throw new Error(`XorFeatures: band agreement drifted (${agreePct.toFixed(2)})`);

// Clip the line a·x + b·y + c = 0 to the square [lo, hi]².
const clip = (a: number, b: number, c: number, lo: number, hi: number) => {
  const pts: [number, number][] = [];
  for (const x of [lo, hi]) { const y = -(c + a * x) / b; if (y >= lo && y <= hi) pts.push([x, y]); }
  for (const y of [lo, hi]) { const x = -(c + b * y) / a; if (x > lo && x < hi) pts.push([x, y]); }
  return pts.sort((p, q) => p[0] - q[0]);
};
const D = 2.2, E = 1.15;
const unitLines = [0, 1].map((j) => clip(P.W[2 * j], P.W[2 * j + 1], P.b[j], -D, D));
const outLine = clip(P.v[0], P.v[1], P.c[0], -E, E);
// Unit 1's label sits right of its lower end, unit 2's right of its upper end, both inside the square.
const lower = unitLines[0].reduce((p, q) => (q[1] < p[1] ? q : p)), upper = unitLines[1].reduce((p, q) => (q[1] > p[1] ? q : p));
const tone = (y: number) => (y ? 'var(--fig-red)' : 'var(--fig-blue)');
const t = ru
  ? { a: '(а) входы x', b: '(б) скрытый слой h', map: 'h = tanh(W₁x + b₁)', unit: ['h₁ = 0', 'h₂ = 0'], c0: 'класс 0: x₁x₂ > 0', c1: 'класс 1: x₁x₂ < 0', ul: 'скрытые нейроны', ol: 'выходной нейрон' }
  : { a: '(a) inputs x', b: '(b) hidden layer h', map: 'h = tanh(W₁x + b₁)', unit: ['h₁ = 0', 'h₂ = 0'], c0: 'class 0: x₁x₂ > 0', c1: 'class 1: x₁x₂ < 0', ul: 'hidden units’ lines', ol: 'output unit’s line' };
// Clusters are lettered A (−1, −1), B (1, 1), C (−1, 1), D (1, −1) in both panels.
const letters = [{ x: [-1.88, -1.88], k: 'A', y: 0 }, { x: [1.88, 1.88], k: 'B', y: 0 }, { x: [-1.88, 1.88], k: 'C', y: 1 }, { x: [1.88, -1.88], k: 'D', y: 1 }];
const id = 'xor-features';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 420, a: [40, 40, 300], b: [440, 40, 300], arrow: [[352, 190], [426, 190]] as [number, number][], mapAt: [389, 176], leg: [40, 384], legStep: [180, 0], legCols: 4 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 840, a: [40, 40, 300], b: [40, 440, 300], arrow: [[190, 362], [190, 420]] as [number, number][], mapAt: [202, 396], leg: [16, 792], legStep: [175, 26], legCols: 2 },
];
---

<Figure
  id={id}
  title={ru ? 'Сеть сама находит признаки для XOR' : 'A network finds its own features for XOR'}
  caption={ru
    ? `200 точек из четырёх облаков A, B, C, D вокруг (±1, ±1); класс 1 (красный) там, где знаки координат различаются. Сеть 2 → 2 → 1 с tanh в скрытом слое после 300 шагов Adam верно классифицирует все точки (кросс-энтропия ${net.loss.toFixed(3)}). (а) Каждый скрытый нейрон — это прямая во входной плоскости: h₁ = tanh(${r1(P.W[0])}x₁ + ${r1(P.W[1])}x₂ + ${r1(P.b[0])}) отрицателен только при обеих отрицательных координатах («или»), h₂ = tanh(${r1(P.W[2])}x₁ + ${r1(P.W[3])}x₂ − ${r1(-P.b[1])}) положителен только при обеих положительных («и»). Сеть относит точку к классу 1 почти ровно тогда, когда та лежит между прямыми (совпадение на ${agreePct.toFixed(1)}% квадрата). (б) В координатах (h₁, h₂) облака попадают в три угла: A в (−1, −1), B в (1, 1), C и D вместе в (1, −1), и одна прямая выходного нейрона ${r1(P.v[0])}h₁ − ${r1(-P.v[1])}h₂ − ${r1(-P.c[0])} = 0 разделяет классы.`
    : `200 points from four clusters A, B, C, D around (±1, ±1); class 1 (red) where the signs of the coordinates differ. A 2 → 2 → 1 network with tanh hidden units classifies every point correctly after 300 Adam steps (cross-entropy ${net.loss.toFixed(3)}). (a) Each hidden unit is a line in the input plane: h₁ = tanh(${r1(P.W[0])}x₁ + ${r1(P.W[1])}x₂ + ${r1(P.b[0])}) is negative only when both coordinates are negative (an OR), h₂ = tanh(${r1(P.W[2])}x₁ + ${r1(P.W[3])}x₂ − ${r1(-P.b[1])}) is positive only when both are positive (an AND). The network calls a point class 1 almost exactly when it lies between the two lines (agreement on ${agreePct.toFixed(1)}% of the square). (b) In the coordinates (h₁, h₂) the clusters land in three corners: A at (−1, −1), B at (1, 1), and C and D together at (1, −1), and the single line ${r1(P.v[0])}h₁ − ${r1(-P.v[1])}h₂ − ${r1(-P.c[0])} = 0 of the output unit separates the classes.`}
>
  {layouts.map((L) => {
    const [ax, ay, as] = L.a, [bx, by, bs] = L.b;
    const sxa = scale([-D, D], [ax, ax + as]), sya = scale([-D, D], [ay + as, ay]);
    const sxb = scale([-E, E], [bx, bx + bs]), syb = scale([-E, E], [by + bs, by]);
    const cornerLabels = [
      { at: [sxb(-0.93), syb(-0.72)], anchor: 'start', text: 'A', tone: 'f-t-blue' },
      { at: [sxb(0.86), syb(0.82)], anchor: 'end', text: 'B', tone: 'f-t-blue' },
      { at: [sxb(0.86), syb(-0.72)], anchor: 'end', text: 'C, D', tone: 'f-t-red' },
    ];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'XOR во входном пространстве и в скрытом слое' : 'XOR in the input space and in the hidden layer'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Слева четыре облака точек в шахматном порядке и две параллельные пунктирные прямые скрытых нейронов; красные облака лежат между прямыми. Справа те же точки в координатах скрытого слоя: синие облака A и B в углах (−1, −1) и (1, 1), красные C и D вместе в углу (1, −1), их отделяет одна прямая.'
          : 'Left, four clusters of points in a checkerboard pattern and two parallel dashed lines of the hidden units; the red clusters lie between the lines. Right, the same points in hidden-layer coordinates: the blue clusters A and B in the corners (−1, −1) and (1, 1), the red clusters C and D together in the corner (1, −1), separated by a single line.'}</desc>
        <text class="f-small f-t-muted" x={ax} y={ay - 14}>{t.a}</text>
        <rect x={ax} y={ay} width={as} height={as} class="f-box-soft" />
        <path class="f-grid" d={`M ${sxa(0)} ${ay} V ${ay + as} M ${ax} ${sya(0)} H ${ax + as}`} />
        {[-2, -1, 0, 1, 2].map((v) => <text class="f-note" x={sxa(v)} y={ay + as + 18} text-anchor="middle">{v}</text>)}
        {[-2, -1, 1, 2].map((v) => <text class="f-note" x={ax - 7} y={sya(v) + 5} text-anchor="end">{v}</text>)}
        {X.map(([x1, x2], i) => <circle cx={sxa(x1).toFixed(1)} cy={sya(x2).toFixed(1)} r="2.6" style={`fill: ${tone(Y[i])}; fill-opacity: .55`} />)}
        {unitLines.map((seg) => <path class="f-line f-amber f-dash" style="stroke-width: 2" d={`M ${sxa(seg[0][0])} ${sya(seg[0][1])} L ${sxa(seg[1][0])} ${sya(seg[1][1])}`} />)}
        <text class="f-small f-t-amber f-halo" x={sxa(lower[0]) + 8} y={sya(lower[1]) - 7}>{t.unit[0]}</text>
        <text class="f-small f-t-amber f-halo" x={sxa(upper[0]) + 8} y={sya(upper[1]) + 17}>{t.unit[1]}</text>
        {letters.map((l) => <text class={`f-label ${l.y ? 'f-t-red' : 'f-t-blue'} f-halo`} x={sxa(l.x[0])} y={sya(l.x[1]) + 5} text-anchor="middle" style="font-weight: 650">{l.k}</text>)}
        <text class="f-small f-t-muted" x={bx} y={by - 14}>{t.b}</text>
        <rect x={bx} y={by} width={bs} height={bs} class="f-box-soft" />
        <path class="f-grid" d={`M ${sxb(0)} ${by} V ${by + bs} M ${bx} ${syb(0)} H ${bx + bs}`} />
        {[-1, 0, 1].map((v) => <text class="f-note" x={sxb(v)} y={by + bs + 18} text-anchor="middle">{v}</text>)}
        {[-1, 1].map((v) => <text class="f-note" x={bx - 7} y={syb(v) + 5} text-anchor="end">{v}</text>)}
        <text class="f-math" x={bx + bs - 4} y={syb(0) + 20} text-anchor="end">h₁</text>
        <text class="f-math" x={sxb(0) + 6} y={by + 18}>h₂</text>
        {H.map(([h1, h2], i) => <circle cx={sxb(h1).toFixed(1)} cy={syb(h2).toFixed(1)} r="2.6" style={`fill: ${tone(Y[i])}; fill-opacity: .4`} />)}
        <path class="f-line" style="stroke-width: 2" d={`M ${sxb(outLine[0][0])} ${syb(outLine[0][1])} L ${sxb(outLine[1][0])} ${syb(outLine[1][1])}`} />
        {cornerLabels.map((c) => <text class={`f-label ${c.tone} f-halo`} x={c.at[0]} y={c.at[1]} text-anchor={c.anchor} style="font-weight: 650">{c.text}</text>)}
        <path class="f-line f-muted" d={`M ${L.arrow[0][0]} ${L.arrow[0][1]} L ${L.arrow[1][0]} ${L.arrow[1][1]}`} marker-end="url(#f-arrow-muted)" />
        <text class="f-small" x={L.mapAt[0]} y={L.mapAt[1]} text-anchor={L.cls === 'fig-wide' ? 'middle' : 'start'}>{t.map}</text>
        {[
          { kind: 'dot', tone: 'var(--fig-blue)', text: t.c0 },
          { kind: 'dot', tone: 'var(--fig-red)', text: t.c1 },
          { kind: 'dash', tone: '', text: t.ul },
          { kind: 'line', tone: '', text: t.ol },
        ].map((item, i) => {
          const lx = L.leg[0] + (i % L.legCols) * L.legStep[0], ly = L.leg[1] + Math.floor(i / L.legCols) * L.legStep[1];
          return (
            <g>
              {item.kind === 'dot' && <circle cx={lx + 8} cy={ly - 4} r="4" style={`fill: ${item.tone}; fill-opacity: .7`} />}
              {item.kind === 'dash' && <path class="f-line f-amber f-dash" d={`M ${lx} ${ly - 4} h 20`} />}
              {item.kind === 'line' && <path class="f-line" d={`M ${lx} ${ly - 4} h 20`} />}
              <text class="f-small" x={lx + 26} y={ly}>{item.text}</text>
            </g>
          );
        })}
      </svg>
    );
  })}
</Figure>
