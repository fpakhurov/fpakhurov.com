---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The tent map g(x) = 2 ReLU(x) − 4 ReLU(x − 1/2) on [0, 1] and its compositions g∘…∘g (k times): a network with
// k hidden layers of 2 ReLU units. Each composition doubles the number of linear pieces, so g^k has 2^k pieces;
// a network with one hidden layer of m ReLU units has at most m + 1 pieces on a line and needs m ≥ 2^k − 1.
const relu = (v: number) => Math.max(0, v);
const g = (v: number) => 2 * relu(v) - 4 * relu(v - 0.5);
const gk = (k: number) => (v: number) => { let y = v; for (let i = 0; i < k; i += 1) y = g(y); return y; };
const ks = [1, 2, 3, 5];
const N = 4096;
const grid = Array.from({ length: N + 1 }, (_, i) => i / N);
// Count linear pieces from slope changes on a grid that contains every breakpoint (multiples of 2^−k).
const pieces = ks.map((k) => {
  const f = gk(k), ys = grid.map(f);
  const slopes = ys.slice(1).map((y, i) => Math.round((y - ys[i]) * N * 1e6) / 1e6);
  return 1 + slopes.slice(1).filter((s, i) => s !== slopes[i]).length;
});
if (pieces.join() !== '2,4,8,32') throw new Error(`DepthSawtooth: piece counts drifted (${pieces.join()})`);
// Russian plural: 1, 21 → form one; 2–4, 22–24 → form two; otherwise form three.
const plural = (n: number, [one, few, many]: string[]) => (n % 10 === 1 && n % 100 !== 11 ? one : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? few : many);
const t = ru
  ? { k: (k: number) => `${k} ${plural(k, ['слой', 'слоя', 'слоёв'])}`, units: (k: number) => `${2 * k} ${plural(2 * k, ['нейрон', 'нейрона', 'нейронов'])}`, pc: (p: number) => `${p} ${plural(p, ['кусок', 'куска', 'кусков'])}`, shallow: (p: number) => `один слой: ≥ ${p - 1}` }
  : { k: (k: number) => (k === 1 ? '1 layer' : `${k} layers`), units: (k: number) => `${2 * k} units`, pc: (p: number) => `${p} pieces`, shallow: (p: number) => `one layer: ≥ ${p - 1}` };
const id = 'depth-sawtooth';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 260, size: 150, pos: [[30, 34], [220, 34], [410, 34], [600, 34]] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 500, size: 140, pos: [[22, 34], [200, 34], [22, 278], [200, 278]] },
];
---

<Figure
  id={id}
  title={ru ? 'Глубина умножает число линейных кусков' : 'Depth multiplies the number of linear pieces'}
  caption={ru
    ? `Функция-«палатка» g(x) = 2 ReLU(x) − 4 ReLU(x − 1/2) на [0, 1] и её композиции g∘g, g∘g∘g и пятикратная: сеть из k скрытых слоёв по 2 ReLU-нейрона. Каждый новый слой удваивает число линейных кусков: ${pieces.join(', ')}. Сеть с одним скрытым слоем из m ReLU-нейронов даёт на прямой не больше m + 1 кусков, поэтому для пятой композиции ей нужно не меньше ${pieces[3] - 1} нейронов против 10 у глубокой сети.`
    : `The tent map g(x) = 2 ReLU(x) − 4 ReLU(x − 1/2) on [0, 1] and its compositions g∘g, g∘g∘g and the five-fold one: a network of k hidden layers with 2 ReLU units each. Every added layer doubles the number of linear pieces: ${pieces.join(', ')}. A network with one hidden layer of m ReLU units has at most m + 1 pieces on a line, so it needs at least ${pieces[3] - 1} units for the five-fold composition, against 10 in the deep network.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Композиции функции-палатки' : 'Compositions of the tent map'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'Четыре графика на [0, 1]: одна палатка, две, четыре и шестнадцать зубцов пилы; число линейных кусков 2, 4, 8 и 32.' : 'Four plots on [0, 1]: one tent, two, four and sixteen teeth of a sawtooth; the numbers of linear pieces are 2, 4, 8 and 32.'}</desc>
      {ks.map((k, i) => {
        const [x0, y0] = L.pos[i], s = L.size;
        const sx = scale([0, 1], [x0, x0 + s]), sy = scale([0, 1], [y0 + s, y0]);
        const f = gk(k);
        const pts = Array.from({ length: 2 ** k * 2 + 1 }, (_, j) => j / (2 ** k * 2)).map((v) => [sx(v), sy(f(v))] as [number, number]);
        return (
          <g>
            <text class="f-small" x={x0} y={y0 - 12}>{`${t.k(k)} · ${t.units(k)}`}</text>
            <rect x={x0} y={y0} width={s} height={s} class="f-box-soft" />
            <path class="f-line f-blue" style="stroke-width: 1.6" d={polyline(pts)} />
            <text class="f-note" x={x0} y={y0 + s + 16} text-anchor="middle">0</text>
            <text class="f-note" x={x0 + s} y={y0 + s + 16} text-anchor="middle">1</text>
            <text class="f-small f-t-blue" x={x0 + s / 2} y={y0 + s + 36} text-anchor="middle">{t.pc(pieces[i])}</text>
            <text class="f-small f-t-muted" x={x0 + s / 2} y={y0 + s + 54} text-anchor="middle">{t.shallow(pieces[i])}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
