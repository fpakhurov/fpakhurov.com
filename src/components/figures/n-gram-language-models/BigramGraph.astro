---
import BlockDiagram, { type DLayout, type DNode, type DEdge } from '../BlockDiagram.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The bigram model of the worked example: a node per token, an arrow per observed bigram.
const lines = [['the', 'cat', 'sat'], ['the', 'cat', 'ran'], ['the', 'dog', 'sat']];
const counts = new Map<string, Map<string, number>>();
for (const line of lines) {
  const seq = ['[S]', ...line, '[EOS]'];
  for (let i = 1; i < seq.length; i++) {
    const row = counts.get(seq[i - 1]) ?? new Map<string, number>();
    row.set(seq[i], (row.get(seq[i]) ?? 0) + 1);
    counts.set(seq[i - 1], row);
  }
}
const prob = (a: string, b: string) => {
  const row = counts.get(a)!;
  const c = row.get(b) ?? 0, total = [...row.values()].reduce((x, y) => x + y, 0);
  if (c === 0) return '0';
  const g = (x: number, y: number): number => (y ? g(y, x % y) : x);
  const d = g(c, total);
  return total === d ? '1' : [c / d, total / d].join('/');
};
if (prob('the', 'cat') !== '2/3' || prob('cat', 'ran') !== '1/2' || prob('dog', 'ran') !== '0') throw new Error('BigramGraph: counts drifted from the note');

// Positions in wide units; the narrow layout squeezes x.
const place: Record<string, [number, number, number]> = { '[S]': [10, 93, 56], the: [110, 93, 64], cat: [230, 36, 64], dog: [230, 150, 64], sat: [380, 36, 64], ran: [380, 150, 64], '[EOS]': [500, 93, 72] };
type Spec = { from: string; to: string; pos?: number; shift?: [number, number]; anchor?: 'start' | 'middle' | 'end' };
const specs: Spec[] = [
  { from: '[S]', to: 'the' },
  { from: 'the', to: 'cat', shift: [-6, 0], anchor: 'end' },
  { from: 'the', to: 'dog', shift: [-6, 22], anchor: 'end' },
  { from: 'cat', to: 'sat' },
  { from: 'cat', to: 'ran', pos: 0.86, shift: [-8, 4], anchor: 'end' },
  { from: 'dog', to: 'sat', pos: 0.86, shift: [-8, 14], anchor: 'end' },
  { from: 'sat', to: '[EOS]', shift: [8, -2], anchor: 'start' },
  { from: 'ran', to: '[EOS]', shift: [8, 18], anchor: 'start' },
];
const desc = ru
  ? 'Граф биграммной модели. Узлы: [S], the, cat, dog, sat, ran, [EOS]. Стрелки с вероятностями: [S] → the 1; the → cat 2/3; the → dog 1/3; cat → sat 1/2; cat → ran 1/2; dog → sat 1; sat → [EOS] 1; ran → [EOS] 1. Стрелки dog → ran в обучающих строках не было, она показана красным пунктиром с вероятностью 0.'
  : 'Graph of the bigram model. Nodes: [S], the, cat, dog, sat, ran, [EOS]. Arrows with probabilities: [S] → the 1; the → cat 2/3; the → dog 1/3; cat → sat 1/2; cat → ran 1/2; dog → sat 1; sat → [EOS] 1; ran → [EOS] 1. The arrow dog → ran never occurred in training and is drawn red and dashed with probability 0.';

function layout(cls: string, w: number, sx: number, bw: number): DLayout {
  const nodes: DNode[] = Object.entries(place).map(([id, [x, y, width]]) => ({ id, x: Math.round(x * sx), y, w: Math.round(width * bw), h: 40, label: id, tone: id.startsWith('[') ? 'soft' : 'plain' }));
  const edges: DEdge[] = specs.map((e) => ({ ...e, label: prob(e.from, e.to), tone: 'blue' }));
  edges.push({ from: 'dog', to: 'ran', label: 'P = 0', tone: 'red', dashed: true, shift: [0, 26] });
  return { cls, w, h: 214, nodes, edges, desc };
}
---

<BlockDiagram
  id="n-gram-bigram-graph"
  title={ru ? 'Биграммная модель как граф переходов' : 'A bigram model is a graph of transitions'}
  svgTitle={ru ? 'Граф биграммной модели разобранного примера' : 'Graph of the bigram model of the worked example'}
  caption={ru
    ? 'Биграммная модель разобранного примера в виде графа: узел на каждый токен, стрелка на каждую встреченную биграмму, подписанная условной вероятностью. Порождение строки — случайное блуждание из [S], которое на каждом шаге выбирает стрелку с её вероятностью и останавливается в [EOS]; вероятность строки — произведение подписей вдоль её пути. Строке the dog ran нужна стрелка dog → ran, которой в обучающих строках не было (красный пунктир), поэтому её вероятность равна 0. Сглаживание добавляет небольшую вероятность каждой недостающей стрелке.'
    : 'The bigram model of the worked example as a graph: a node per token and an arrow per observed bigram, labelled with its conditional probability. Generating a line is a random walk from [S] that takes each next arrow with its probability and stops at [EOS]; the probability of a line is the product of the labels along its path. The line the dog ran needs the arrow dog → ran, which the training lines never showed (red, dashed), so its probability is 0. Smoothing gives every missing arrow a small probability.'}
  layouts={[layout('fig-wide', 590, 1, 1), layout('fig-narrow', 360, 0.6, 0.78)]}
/>
