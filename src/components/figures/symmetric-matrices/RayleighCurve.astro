---
import Figure from '../Figure.astro';
import { scale, plot } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The Rayleigh quotient of A = [[5, 2], [2, 2]] on the unit circle x = (cos θ, sin θ):
// R(θ) = 5cos²θ + 4cosθ sinθ + 2sin²θ = 3.5 + 1.5cos2θ + 2sin2θ, between λ₂ = 1 and λ₁ = 6, average tr A / 2 = 3.5.
const R = (deg: number) => { const t = (deg * Math.PI) / 180, c = Math.cos(t), s = Math.sin(t); return 5 * c * c + 4 * c * s + 2 * s * s; };
const grid = Array.from({ length: 180001 }, (_, i) => i / 1000);
let iMax = 0, iMin = 0;
grid.forEach((g, i) => { if (R(g) > R(grid[iMax])) iMax = i; if (R(g) < R(grid[iMin])) iMin = i; });
const tMax = grid[iMax], tMin = grid[iMin];
const mean = grid.reduce((a, g) => a + R(g), 0) / grid.length;
const qAngle = (Math.atan2(1, 2) * 180) / Math.PI;
if (Math.abs(R(tMax) - 6) > 1e-6 || Math.abs(R(tMin) - 1) > 1e-6 || Math.abs(tMax - qAngle) > 0.002 || Math.abs(tMin - qAngle - 90) > 0.002) throw new Error('RayleighCurve: extremes drifted from the note');
if (Math.abs(R(45) - 5.5) > 1e-12 || Math.abs(mean - 3.5) > 1e-3 || qAngle.toFixed(2) !== '26.57') throw new Error('RayleighCurve: values drifted from the note');

const t = ru
  ? {
      title: 'Отношение Рэлея на единичной окружности',
      desc: 'Кривая R(θ) для θ от 0 до 180 градусов колеблется между 1 и 6. Максимум 6 при θ = 26.57°, в направлении собственного вектора q₁ = (2, 1)/√5; минимум 1 при θ = 116.57°, в направлении q₂. Точка θ = 45° даёт 5.5. Среднее значение 3.5.',
      caption: 'R(θ) = xᵀAx для единичного вектора x = (cos θ, sin θ) и A = [[5, 2], [2, 2]]. Отношение — взвешенное среднее собственных значений с весами, равными квадратам координат x в собственном базисе, поэтому оно не выходит за пределы [λ₂, λ₁] = [1, 6]. Максимум достигается на собственном векторе q₁ = (2, 1)/√5 (26.57°), минимум — на q₂ = (1, −2)/√5, перпендикулярном ему (116.57°). Вектор (1, 1)/√2 (45°) имеет веса 0.9 и 0.1 и даёт 0.9 · 6 + 0.1 · 1 = 5.5. Среднее по окружности равно tr A / 2 = 3.5. Период равен 180°, потому что x и −x дают одно значение.',
      x: 'угол θ вектора x', y: 'R(θ) = xᵀAx', max: 'θ = 26.57°, вдоль q₁', min: 'θ = 116.57°, вдоль q₂', mean: 'tr A / 2 = 3.5',
    }
  : {
      title: 'The Rayleigh quotient on the unit circle',
      desc: 'The curve R(θ) for θ from 0 to 180 degrees oscillates between 1 and 6. The maximum 6 is at θ = 26.57°, the direction of the eigenvector q₁ = (2, 1)/√5; the minimum 1 is at θ = 116.57°, the direction of q₂. The point θ = 45° gives 5.5. The average value is 3.5.',
      caption: 'R(θ) = xᵀAx for the unit vector x = (cos θ, sin θ) and A = [[5, 2], [2, 2]]. The quotient is a weighted average of the eigenvalues, with the squared coordinates of x in the eigenbasis as weights, so it stays within [λ₂, λ₁] = [1, 6]. The maximum is at the eigenvector q₁ = (2, 1)/√5 (26.57°), the minimum at q₂ = (1, −2)/√5, perpendicular to it (116.57°). The vector (1, 1)/√2 (45°) has weights 0.9 and 0.1 and gives 0.9 · 6 + 0.1 · 1 = 5.5. The average over the circle is tr A / 2 = 3.5. The period is 180° because x and −x give the same value.',
      x: 'angle θ of x', y: 'R(θ) = xᵀAx', max: 'θ = 26.57°, along q₁', min: 'θ = 116.57°, along q₂', mean: 'tr A / 2 = 3.5',
    };
const id = 'rayleigh-curve';
const layouts = [
  { cls: 'fig-wide', sfx: 'w', W: 760, H: 290, x: [70, 700], y: [34, 224], full: true },
  { cls: 'fig-narrow', sfx: 'n', W: 360, H: 300, x: [52, 340], y: [40, 230], full: false },
];
---

<Figure id={id} title={t.title} caption={t.caption}>
  {layouts.map((L) => {
    const sx = scale([0, 180], L.x as [number, number]), sy = scale([0, 7], [L.y[1], L.y[0]]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {[45, 90, 135, 180].map((v) => <path class="f-grid" d={`M ${sx(v)} ${L.y[0]} V ${L.y[1]}`} />)}
        <path class="f-axis" d={`M ${L.x[0]} ${L.y[0]} V ${L.y[1]} H ${L.x[1]}`} />
        {[0, 45, 90, 135, 180].map((v) => <text class="f-note" x={sx(v)} y={L.y[1] + 19} text-anchor="middle">{`${v}°`}</text>)}
        {[0, 1, 3.5, 6].map((v) => <text class="f-note" x={L.x[0] - 8} y={sy(v) + 5} text-anchor="end">{v}</text>)}
        <text class="f-small f-t-muted" x={(L.x[0] + L.x[1]) / 2} y={L.y[1] + 40} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.x[0] - 40} y={L.y[0] - 18}>{t.y}</text>
        <path class="f-thin f-red f-dash" d={`M ${L.x[0]} ${sy(6)} H ${L.x[1]}`} />
        <path class="f-thin f-blue f-dash" d={`M ${L.x[0]} ${sy(1)} H ${L.x[1]}`} />
        <path class="f-thin f-muted f-dot" d={`M ${L.x[0]} ${sy(3.5)} H ${L.x[1]}`} />
        <text class="f-small f-t-red f-halo" x={L.x[1]} y={sy(6) - 6} text-anchor="end">λ₁ = 6</text>
        <text class="f-small f-t-blue f-halo" x={L.x[1]} y={sy(1) - 6} text-anchor="end">λ₂ = 1</text>
        <text class="f-small f-t-muted f-halo" x={L.x[0] + 4} y={sy(3.5) + 18}>{t.mean}</text>
        <path class="f-line f-amber" d={plot(R, 0, 180, sx, sy, 360)} />
        <circle cx={sx(tMax)} cy={sy(6)} r="4.5" class="f-solid-red" />
        <circle cx={sx(tMin)} cy={sy(1)} r="4.5" class="f-solid-blue" />
        <circle cx={sx(45)} cy={sy(5.5)} r="3.5" class="f-solid-muted" />
        <text class="f-small f-halo" x={sx(45) + 8} y={sy(5.5) - 8}>5.5</text>
        <text class="f-small f-t-red f-halo" x={sx(tMax)} y={sy(6) - 12} text-anchor="middle">{L.full ? t.max : '26.57°'}</text>
        <text class="f-small f-t-blue f-halo" x={sx(tMin)} y={sy(2.3)} text-anchor="middle">{L.full ? t.min : '116.57°'}</text>
      </svg>
    );
  })}
</Figure>
