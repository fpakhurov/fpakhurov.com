---
import Figure from '../Figure.astro';
import { polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Left: q(x) = xᵀAx with A = [[5, 2], [2, 2]], eigenvalues 6 along (2, 1)/√5 and 1 along (1, −2)/√5; level sets q = 1 and q = 4
// are ellipses with half-axes √(c/λ): 0.41 and 1, then 0.82 and 2. Right: B = [[1, 2], [2, 1]], eigenvalues 3 along (1, 1)/√2 and
// −1 along (1, −1)/√2; q = 3y₁² − y₂², level sets q = ±1 are hyperbolas, q = 0 the two asymptotes.
type V2 = [number, number];
const eig2 = (m: number[][]) => {
  const tr = m[0][0] + m[1][1], dt = m[0][0] * m[1][1] - m[0][1] * m[1][0], r = Math.sqrt(tr * tr / 4 - dt);
  const l = [tr / 2 + r, tr / 2 - r];
  const vec = (lam: number): V2 => { const v: V2 = [m[0][1], lam - m[0][0]]; const n = Math.hypot(v[0], v[1]); return [v[0] / n, v[1] / n]; };
  return { l, q: [vec(l[0]), vec(l[1])] };
};
const A = [[5, 2], [2, 2]], B = [[1, 2], [2, 1]];
const EA = eig2(A), EB = eig2(B);
if (EA.l.join() !== '6,1' || EB.l.join() !== '3,-1') throw new Error('QuadraticForms: eigenvalues drifted from the note');
const qf = (m: number[][], x: V2) => m[0][0] * x[0] ** 2 + 2 * m[0][1] * x[0] * x[1] + m[1][1] * x[1] ** 2;
const fromY = (E: { q: V2[] }, y: V2): V2 => [y[0] * E.q[0][0] + y[1] * E.q[1][0], y[0] * E.q[0][1] + y[1] * E.q[1][1]];
const ellipse = (c: number) => Array.from({ length: 241 }, (_, i) => { const t = (2 * Math.PI * i) / 240; return fromY(EA, [Math.sqrt(c / 6) * Math.cos(t), Math.sqrt(c / 1) * Math.sin(t)]); });
const ellErr = [1, 4].map((c) => Math.max(...ellipse(c).map((x) => Math.abs(qf(A, x) - c)))).reduce((a, b) => Math.max(a, b));
const half = [Math.sqrt(4 / 6), Math.sqrt(4 / 1)];
if (ellErr > 1e-9 || half.map((h) => h.toFixed(2)).join() !== '0.82,2.00' || Math.sqrt(1 / 6).toFixed(3) !== '0.408') throw new Error('QuadraticForms: level sets drifted from the note');
const R = 2.2; // half-width of each panel in data units
const inBox = (x: V2) => Math.abs(x[0]) <= R && Math.abs(x[1]) <= R;
// Split a sampled curve into the runs of consecutive points inside the panel.
const runs = (pts: V2[]) => { const out: V2[][] = []; let cur: V2[] = []; for (const p of pts) { if (inBox(p)) cur.push(p); else { if (cur.length > 1) out.push(cur); cur = []; } } if (cur.length > 1) out.push(cur); return out; };
const us = Array.from({ length: 401 }, (_, i) => -3 + (6 * i) / 400);
const hyp = (c: number) => [1, -1].flatMap((sg) => runs(us.map((u) => fromY(EB, c > 0 ? [(sg * Math.cosh(u)) / Math.sqrt(3), Math.sinh(u)] : [Math.sinh(u) / Math.sqrt(3), sg * Math.cosh(u)]))));
const hypErr = [1, -1].map((c) => Math.max(...hyp(c).flat().map((x) => Math.abs(qf(B, x) - c)))).reduce((a, b) => Math.max(a, b));
if (hypErr > 1e-9) throw new Error('QuadraticForms: hyperbolas drifted');
const asym = [1, -1].map((sg) => [fromY(EB, [-1.1, -1.1 * sg * Math.sqrt(3)]), fromY(EB, [1.1, 1.1 * sg * Math.sqrt(3)])] as V2[]);
if (asym.flat().some((p) => !inBox(p) || Math.abs(qf(B, p)) > 1e-9)) throw new Error('QuadraticForms: asymptotes leave the panel');

const t = ru
  ? {
      title: 'Линии уровня квадратичной формы и собственные оси её матрицы',
      left: 'q = 5x₁² + 4x₁x₂ + 2x₂², λ = 6 и 1', right: 'q = x₁² + 4x₁x₂ + x₂², λ = 3 и −1',
      desc: 'Слева: два вложенных эллипса, линии уровня q = 1 и q = 4 формы с матрицей [[5, 2], [2, 2]]. Их оси идут вдоль собственных векторов (2, 1) и (1, −2); полуоси уровня 4 равны 0.82 вдоль первого и 2 вдоль второго. Справа: форма с матрицей [[1, 2], [2, 1]] — седло. Линии уровня q = 1 и q = −1 — гиперболы с осями вдоль (1, 1) и (1, −1), а пунктирные асимптоты — уровень q = 0.',
      caption: 'Слева: положительно определённая форма с матрицей A = [[5, 2], [2, 2]]. Её линии уровня q = 1 и q = 4 — эллипсы с осями вдоль собственных векторов (2, 1)/√5 (λ = 6, красный) и (1, −2)/√5 (λ = 1, синий). Полуось равна √(c/λ): у уровня 4 это √(4/6) = 0.82 вдоль крутого направления и √(4/1) = 2 вдоль пологого. Большое собственное значение — короткая ось. Справа: знаконеопределённая форма с матрицей [[1, 2], [2, 1]]: q = 3y₁² − y₂² в собственных координатах. Уровень q = 1 (жёлтый) — гипербола вокруг оси с λ = 3, уровень q = −1 (зелёный) — вокруг оси с λ = −1, пунктир — уровень 0. Начало координат — седловая точка.',
    }
  : {
      title: 'Level sets of a quadratic form and the eigen-axes of its matrix',
      left: 'q = 5x₁² + 4x₁x₂ + 2x₂², λ = 6 and 1', right: 'q = x₁² + 4x₁x₂ + x₂², λ = 3 and −1',
      desc: 'Left: two nested ellipses, the level sets q = 1 and q = 4 of the form with matrix [[5, 2], [2, 2]]. Their axes run along the eigenvectors (2, 1) and (1, −2); the half-axes of level 4 are 0.82 along the first and 2 along the second. Right: the form with matrix [[1, 2], [2, 1]] is a saddle. Its level sets q = 1 and q = −1 are hyperbolas with axes along (1, 1) and (1, −1), and the dashed asymptotes are the level q = 0.',
      caption: 'Left: a positive definite form with matrix A = [[5, 2], [2, 2]]. Its level sets q = 1 and q = 4 are ellipses with axes along the eigenvectors (2, 1)/√5 (λ = 6, red) and (1, −2)/√5 (λ = 1, blue). The half-axis is √(c/λ): for level 4, √(4/6) = 0.82 along the steep direction and √(4/1) = 2 along the flat one. A large eigenvalue means a short axis. Right: an indefinite form with matrix [[1, 2], [2, 1]], which is q = 3y₁² − y₂² in eigen-coordinates. The level q = 1 (amber) is a hyperbola around the axis with λ = 3, the level q = −1 (green) one around the axis with λ = −1, and the dashed lines are level 0. The origin is a saddle point.',
    };
const id = 'quadratic-forms';
const layouts = [
  { cls: 'fig-wide', sfx: 'w', W: 760, H: 384, s: 75, c: [[190, 210], [570, 210]] as V2[], tY: [22, 22] },
  { cls: 'fig-narrow', sfx: 'n', W: 360, H: 650, s: 60, c: [[180, 172], [180, 498]] as V2[], tY: [22, 348] },
];
---

<Figure id={id} title={t.title} caption={t.caption}>
  {layouts.map((L) => {
    const Xa = (v: V2): V2 => [L.c[0][0] + L.s * v[0], L.c[0][1] - L.s * v[1]];
    const Xb = (v: V2): V2 => [L.c[1][0] + L.s * v[0], L.c[1][1] - L.s * v[1]];
    const frame = (X: (v: V2) => V2) => {
      const g = [-2, -1, 1, 2];
      return [
        ...g.map((k) => `M ${X([k, -R])[0]} ${X([k, -R])[1]} V ${X([k, R])[1]}`),
        ...g.map((k) => `M ${X([-R, k])[0]} ${X([-R, k])[1]} H ${X([R, k])[0]}`),
      ].join(' ');
    };
    const axis = (X: (v: V2) => V2, q: V2, r: number) => polyline([X([-r * q[0], -r * q[1]]), X([r * q[0], r * q[1]])]);
    const tipA1 = Xa([half[0] * EA.q[0][0], half[0] * EA.q[0][1]]), tipA2 = Xa([half[1] * EA.q[1][0], half[1] * EA.q[1][1]]);
    const endA1 = Xa([2.4 * EA.q[0][0], 2.4 * EA.q[0][1]]), endA2 = Xa([2.4 * EA.q[1][0], 2.4 * EA.q[1][1]]);
    // the topmost point of the level set q = c lies along A⁻¹e₂ ∝ (−2, 5), at (−2, 5)·√(c/30)
    const top1 = Xa([-2 * Math.sqrt(1 / 30), 5 * Math.sqrt(1 / 30)]), top4 = Xa([-2 * Math.sqrt(4 / 30), 5 * Math.sqrt(4 / 30)]), lab1 = Xa([-1.3, 1.45]);
    const lb = (v: V2) => Xb(v);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        <path class="f-grid" d={frame(Xa) + ' ' + frame(Xb)} />
        <path class="f-axis" d={`M ${Xa([-R, 0])[0]} ${Xa([0, 0])[1]} H ${Xa([R, 0])[0]} M ${Xa([0, 0])[0]} ${Xa([0, -R])[1]} V ${Xa([0, R])[1]} M ${Xb([-R, 0])[0]} ${Xb([0, 0])[1]} H ${Xb([R, 0])[0]} M ${Xb([0, 0])[0]} ${Xb([0, -R])[1]} V ${Xb([0, R])[1]}`} />
        <text class="f-small" x={L.c[0][0]} y={L.tY[0]} text-anchor="middle">{t.left}</text>
        <text class="f-small" x={L.c[1][0]} y={L.tY[1]} text-anchor="middle">{t.right}</text>

        <path class="f-thin f-red f-dash" d={axis(Xa, EA.q[0], 2.4)} />
        <path class="f-thin f-blue f-dash" d={axis(Xa, EA.q[1], 2.4)} />
        <path class="f-fill-amber" d={polyline(ellipse(1).map(Xa)) + ' Z'} />
        <path class="f-line f-amber" d={polyline(ellipse(1).map(Xa))} />
        <path class="f-line f-amber" d={polyline(ellipse(4).map(Xa))} />
        <path class="f-line f-red f-bold" d={polyline([Xa([0, 0]), tipA1])} marker-end="url(#f-arrow-red)" />
        <path class="f-line f-blue f-bold" d={polyline([Xa([0, 0]), tipA2])} marker-end="url(#f-arrow-blue)" />
        <text class="f-small f-t-red f-halo" x={tipA1[0] + 12} y={tipA1[1] + 16}>0.82</text>
        <text class="f-small f-t-blue f-halo" x={tipA2[0] + 10} y={tipA2[1] + 6}>2</text>
        <text class="f-small f-t-red f-halo" x={endA1[0] - 4} y={endA1[1] - 10} text-anchor="end">λ₁ = 6</text>
        <text class="f-small f-t-blue f-halo" x={endA2[0] + 8} y={endA2[1] + 2}>λ₂ = 1</text>
        <path class="f-thin f-muted" d={polyline([top1, lab1])} />
        <text class="f-small f-t-amber f-halo" x={lab1[0] - 4} y={lab1[1] + 4} text-anchor="end">q = 1</text>
        <text class="f-small f-t-amber f-halo" x={top4[0] - 6} y={top4[1] - 2} text-anchor="end">q = 4</text>

        <path class="f-thin f-red f-dash" d={axis(Xb, EB.q[0], 2.4)} />
        <path class="f-thin f-blue f-dash" d={axis(Xb, EB.q[1], 2.4)} />
        {asym.map((seg) => <path class="f-thin f-muted f-dash" d={polyline(seg.map(Xb))} />)}
        {hyp(1).map((r) => <path class="f-line f-amber" d={polyline(r.map(Xb))} />)}
        {hyp(-1).map((r) => <path class="f-line f-green" d={polyline(r.map(Xb))} />)}
        <text class="f-small f-t-amber f-halo" x={lb([1.25, 0.75])[0]} y={lb([1.25, 0.75])[1] + 4} text-anchor="middle">q = 1</text>
        <text class="f-small f-t-green f-halo" x={lb([1.1, -1.6])[0]} y={lb([1.1, -1.6])[1] + 4} text-anchor="middle">q = −1</text>
        <text class="f-small f-t-red f-halo" x={lb([1.62, 1.62])[0] - 4} y={lb([1.62, 1.62])[1] - 8} text-anchor="end">λ₁ = 3</text>
        <text class="f-small f-t-blue f-halo" x={lb([1.62, -1.62])[0] - 4} y={lb([1.62, -1.62])[1] + 18} text-anchor="end">λ₂ = −1</text>
        <circle cx={Xb([0, 0])[0]} cy={Xb([0, 0])[1]} r="3" class="f-solid-muted" />
      </svg>
    );
  })}
</Figure>
