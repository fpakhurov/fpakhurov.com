---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Five sampled reasoning paths for 17 + 6 × 4 − 9 in the stand-in model of the note: three correct plans, the
// left-to-right misconception, and one path that slips in an addition. The vote returns the most frequent answer.
type Step = [number, string, number];
const run = (steps: Step[], slip = [0, 0, 0]) => {
  const res: number[] = [];
  const text = steps.map(([x, op, y], i) => {
    const a = x < 0 ? res[-x - 1] : x, b = y < 0 ? res[-y - 1] : y;
    const r = (op === '+' ? a + b : op === '−' ? a - b : a * b) + slip[i];
    res.push(r);
    return [a, op, b, r] as [number, string, number, number];
  });
  return { text, answer: res[res.length - 1] };
};
// operands: a non-negative number, or -k for the result of step k
const paths = [
  run([[6, '×', 4], [17, '+', -1], [-2, '−', 9]]),
  run([[17, '+', 6], [-1, '×', 4], [-2, '−', 9]]),
  run([[17, '−', 9], [6, '×', 4], [-1, '+', -2]]),
  run([[6, '×', 4], [17, '+', -1], [-2, '−', 9]], [0, 2, 0]),
  run([[4, '×', 6], [-1, '−', 9], [17, '+', -2]]),
];
const answers = paths.map((p) => p.answer);
if (answers.join(' ') !== '32 83 32 34 32') throw new Error(`SelfConsistency: answers drifted (${answers.join(' ')})`);
const tally = [...new Set(answers)].map((a) => [a, answers.filter((b) => b === a).length] as [number, number]).sort((x, y) => y[1] - x[1]);
const winner = tally[0][0];
if (winner !== 32 || tally[0][1] !== 3) throw new Error('SelfConsistency: the vote should return 32 with three votes');
const wide = paths.map((p) => p.text.map(([a, op, b, r]) => `${a} ${op} ${b} = ${r}`).join(',  '));
const narrow = paths.map((p) => p.text.map(([a, op, b, r]) => `${a}${op}${b}=${r}`).join(', '));
const tallyText = tally.map(([a, k]) => `${a} × ${k}`);

const t = ru
  ? {
      title: 'Самосогласованность: пять путей рассуждения и голосование',
      q: 'вопрос x', qSub: '17 + 6 × 4 − 9', n: 'n = 5, τ = 0.7', nNarrow: '5 путей, τ = 0.7', paths: 'сэмплированные пути рассуждения', ans: 'ответ', vote: 'голосование', result: `ответ: ${winner}`,
      steps: ['вопрос попадает в контекст вместе с примерами рассуждений', 'модель независимо пишет пять путей при температуре 0.7', 'регулярное выражение читает ответ в конце каждого пути', `возвращается самый частый ответ: ${winner}, три голоса из пяти`],
      desc: `Слева вопрос 17 + 6 × 4 − 9. От него расходятся пять стрелок к пяти путям рассуждения: ${wide.join('; ')}. У каждого пути справа его ответ: ${answers.join(', ')}. Ответы сходятся в блок голосования: ${tallyText.join(', ')}; итог ${winner}.`,
    }
  : {
      title: 'Self-consistency: five reasoning paths and a vote',
      q: 'question x', qSub: '17 + 6 × 4 − 9', n: 'n = 5, τ = 0.7', nNarrow: '5 paths, τ = 0.7', paths: 'sampled reasoning paths', ans: 'answer', vote: 'vote', result: `answer: ${winner}`,
      steps: ['the question goes into the context, with examples of reasoning', 'the model writes five paths independently at temperature 0.7', 'a regular expression reads the answer at the end of each path', `the most frequent answer is returned: ${winner}, three votes of five`],
      desc: `On the left the question 17 + 6 × 4 − 9. Five arrows fan out from it to five reasoning paths: ${wide.join('; ')}. Each path has its answer on the right: ${answers.join(', ')}. The answers converge on a vote box: ${tallyText.join(', ')}; the result is ${winner}.`,
    };
const id = 'self-consistency';
const caption = ru
  ? 'Пути взяты из модели-заменителя раздела «Код». Второй путь — заблуждение, которое считает слева направо, четвёртый ошибается в сложении (17 + 24 = 43). Правильные пути начинаются по-разному, поэтому жадное декодирование, которое идёт за самым вероятным первым шагом, при q = 0.35 выбирает заблуждение и отвечает 83. Голосование складывает вероятности всех путей, ведущих к одному ответу, и возвращает 32; сами пути отбрасываются.'
  : 'The paths come from the stand-in model of the Code section. The second path is the misconception that computes from left to right; the fourth slips in an addition (17 + 24 = 43). The correct paths begin differently, so greedy decoding, which follows the most likely first step, picks the misconception when q = 0.35 and answers 83. The vote adds up the probability of all paths that reach the same answer and returns 32; the paths themselves are discarded.';
const rowsW = paths.map((_, i) => 50 + 46 * i);
const rowsN = paths.map((_, i) => 110 + 36 * i);
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 300" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <g data-s="1">
      <Box x={16} y={118} w={160} h={64} label={t.q} sub={t.qSub} tone="x" />
      <Badge x={96} y={200} n={1} />
    </g>
    <g data-s="2">
      <text class="f-small f-t-muted" x="96" y="108" text-anchor="middle">{t.n}</text>
      <text class="f-small f-t-muted" x="374" y="38" text-anchor="middle">{t.paths}</text>
      {rowsW.map((y) => <Arrow pts={[[176, 150], [226, y + 17]]} tone="green" />)}
      {rowsW.map((y, i) => (
        <g>
          <rect x="228" y={y} width="292" height="34" rx="6" style="fill: var(--fig-blue); fill-opacity: 0.1; stroke: var(--fig-blue); stroke-width: 1.2" />
          <text class="f-small" x="240" y={y + 22}>{wide[i]}</text>
        </g>
      ))}
      <Badge x={203} y={60} n={2} />
    </g>
    <g data-s="3">
      <text class="f-small f-t-muted" x="570" y="40" text-anchor="middle">{t.ans}</text>
      {rowsW.map((y, i) => (
        <g>
          <Arrow pts={[[520, y + 17], [546, y + 17]]} />
          <rect x="548" y={y + 5} width="44" height="24" style="fill: var(--fig-red); fill-opacity: 0.14; stroke: var(--fig-red); stroke-width: 1.2" />
          <text class="f-label" x="570" y={y + 22} text-anchor="middle">{String(answers[i])}</text>
        </g>
      ))}
      <Badge x={570} y={284} n={3} />
    </g>
    <g data-s="4">
      {rowsW.map((y) => <Arrow pts={[[592, y + 17], [630, 158]]} tone="red" />)}
      <text class="f-small f-t-muted" x="688" y="88" text-anchor="middle">{t.vote}</text>
      <rect x="632" y="96" width="112" height="124" rx="7" style="fill: var(--fig-red); fill-opacity: 0.08; stroke: var(--fig-red); stroke-width: 1.3" />
      {tallyText.map((s, i) => <text class="f-label" x="688" y={126 + 24 * i} text-anchor="middle" style={i === 0 ? 'font-weight: 650' : ''}>{s}</text>)}
      <path class="f-line f-muted" d="M 648 188 H 728" />
      <text class="f-label f-t-red" x="688" y="210" text-anchor="middle" style="font-weight: 650">{String(winner)}</text>
      <Badge x={688} y={240} n={4} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 384" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <g data-s="1">
      <Box x={60} y={30} w={240} h={50} label={t.q} sub={t.qSub} tone="x" />
      <Badge x={36} y={55} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[180, 80], [180, 106]]} tone="green" />
      <text class="f-small f-t-muted" x="190" y="98">{t.nNarrow}</text>
      {rowsN.map((y, i) => (
        <g>
          <rect x="34" y={y} width="236" height="28" rx="6" style="fill: var(--fig-blue); fill-opacity: 0.1; stroke: var(--fig-blue); stroke-width: 1.2" />
          <text class="f-small" x="42" y={y + 19}>{narrow[i]}</text>
        </g>
      ))}
      <Badge x={18} y={196} n={2} />
    </g>
    <g data-s="3">
      {rowsN.map((y, i) => (
        <g>
          <Arrow pts={[[270, y + 14], [288, y + 14]]} />
          <rect x="290" y={y + 3} width="44" height="22" style="fill: var(--fig-red); fill-opacity: 0.14; stroke: var(--fig-red); stroke-width: 1.2" />
          <text class="f-small" x="312" y={y + 19} text-anchor="middle">{String(answers[i])}</text>
        </g>
      ))}
      <Badge x={348} y={196} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[312, 279], [312, 306]]} tone="red" />
      <rect x="40" y="308" width="280" height="64" rx="7" style="fill: var(--fig-red); fill-opacity: 0.08; stroke: var(--fig-red); stroke-width: 1.3" />
      <text class="f-label" x="180" y="332" text-anchor="middle">{tallyText.join('   ')}</text>
      <text class="f-label f-t-red" x="180" y="360" text-anchor="middle" style="font-weight: 650">{t.result}</text>
      <Badge x={20} y={340} n={4} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
