---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? "Одно построение и шесть проверок" : "Build once and probe six times";
const caption = ru ? "Четыре строки каталога образуют временную структуру поиска. Каждая позиция проверяет свой товар и даёт одну пару." : "The four catalogue rows become a temporary lookup structure. Each order line probes it by product and emits one pair.";
const desc = ru ? "Хеш-таблица строится по четырём строкам каталога. Её проверяют шесть позиций заказа, и каждой подходит одна строка каталога." : "A hash table built from four catalogue rows is probed by six order lines. All probes match one catalogue entry.";
const labels = ru
  ? ['Каталог · 4 строки', 'Хеш-таблица', 'Позиции · 6 строк', 'Результат · 6 пар']
  : ['Catalogue · 4 rows', 'Hash table', 'Order lines · 6 rows', 'Output · 6 pairs'];
---
<Figure id="db-join-work" title={title} caption={caption}>
  <svg viewBox="0 0 340 181" role="img" aria-labelledby="db-join-work-title db-join-work-desc" style="max-width: 550px; margin-inline: auto">
    <title id="db-join-work-title">{title}</title>
    <desc id="db-join-work-desc">{desc}</desc>
    <rect class="f-fill-blue" x="10" y="19" width="153" height="40" rx="6" />
    <rect class="f-fill-green" x="177" y="19" width="153" height="40" rx="6" />
    <text class="f-label" x="86" y="44" text-anchor="middle">{labels[0]}</text>
    <text class="f-label" x="254" y="44" text-anchor="middle">{labels[2]}</text>
    <path class="f-line" d="M 86 61 L 137 85 M 131 86 L 137 85 L 134 79 M 254 61 L 203 85 M 206 79 L 203 85 L 209 86" fill="none" />
    <rect class="f-fill-blue" x="101" y="88" width="138" height="36" rx="6" />
    <text class="f-label" x="170" y="111" text-anchor="middle">{labels[1]}</text>
    <path class="f-line" d="M 170 126 V 144 M 166 140 L 170 144 L 174 140" fill="none" />
    <text class="f-label" x="170" y="164" text-anchor="middle">{labels[3]}</text>
  </svg>
</Figure>
