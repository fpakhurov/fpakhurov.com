---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The test pyramid of an ML system, bottom to top: many fast tests of data and feature code; model tests that train
// small models; an integration test of the whole pipeline; checks in production on real traffic. Each layer is
// tagged with the section of the ML Test Score (Breck et al., 2017) it roughly corresponds to.
const layers = ru
  ? [
      { name: 'данные', tag: 'тесты данных', what: 'схемы, диапазоны, тесты кода признаков', when: 'каждый коммит · секунды' },
      { name: 'модель', tag: 'тесты модели', what: 'пробное обучение, поведение, срезы', when: 'каждый коммит и каждая модель · минуты' },
      { name: 'конвейер', tag: 'тесты инфраструктуры', what: 'весь конвейер на малой выборке', when: 'ночью и перед релизом · десятки минут' },
      { name: 'продакшен', tag: 'тесты мониторинга', what: 'канарейка, теневой трафик, мониторинг', when: 'непрерывно · реальные пользователи' },
    ]
  : [
      { name: 'data', tag: 'Data tests', what: 'schemas, ranges, feature code unit tests', when: 'every commit · seconds' },
      { name: 'model', tag: 'Model tests', what: 'smoke training, behaviour, slices', when: 'every commit and every model · minutes' },
      { name: 'pipeline', tag: 'Infrastructure tests', what: 'the pipeline end to end on a sample', when: 'nightly, before release · tens of minutes' },
      { name: 'production', tag: 'Monitoring tests', what: 'canary, shadow traffic, monitoring', when: 'continuously · real users' },
    ];
const t = ru
  ? {
      title: 'Пирамида тестов ML-системы',
      steps: [
        'основание: много быстрых проверок данных и кода признаков на каждый коммит',
        'тесты модели: обучение на малых данных, поведенческие тесты и качество на срезах',
        'интеграционный тест: весь конвейер от сырых данных до загруженной в инференс модели',
        'вершина: проверки на реальном трафике — канареечный выпуск, теневой запуск, мониторинг',
      ],
      desc: 'Трапеция из четырёх слоёв. Снизу вверх: данные (схемы, диапазоны, тесты кода признаков, на каждый коммит, секунды), модель (пробное обучение, поведение, срезы, минуты), конвейер (весь конвейер на малой выборке, ночью и перед релизом), продакшен (канарейка, теневой трафик, мониторинг, непрерывно). Каждый слой подписан разделом ML Test Score.',
    }
  : {
      title: 'The test pyramid of an ML system',
      steps: [
        'the base: many fast checks of the data and the feature code, on every commit',
        'model tests: training on small data, behavioural tests and quality on slices',
        'an integration test: the whole pipeline from raw data to a model loaded by serving',
        'the top: checks on real traffic, canary, shadow and monitoring',
      ],
      desc: 'A trapezoid of four layers. Bottom to top: data (schemas, ranges, feature code unit tests, every commit, seconds), model (smoke training, behaviour, slices, minutes), pipeline (the pipeline end to end on a sample, nightly and before release), production (canary, shadow traffic, monitoring, continuously). Each layer is labelled with a section of the ML Test Score.',
    };
const id = 'ml-test-pyramid';
const caption = ru
  ? 'Чем ниже слой, тем больше в нём тестов, тем они быстрее и тем точнее указывают на причину; чем выше, тем ближе проверка к реальности и тем дороже и медленнее она. Отказ должен ловить самый дешёвый тест, способный его поймать. Подписи слоёв — разделы рубрики ML Test Score, которым слой примерно соответствует.'
  : 'The lower the layer, the more tests it holds, the faster they run and the more precisely they point at a cause; the higher the layer, the closer a check is to reality and the slower and costlier it is. A failure should be caught by the cheapest test that can catch it. The labels name the section of the ML Test Score rubric each layer roughly corresponds to.';

const fits = (s: string, room: number, px: number) => {
  if (s.length * px > room) throw new Error(`"${s}" needs ${Math.round(s.length * px)} px, has ${room}`);
};
interface L { cls: string; W: number; H: number; cx: number; y0: number; y1: number; wTop: number; wBot: number; wide: boolean }
const layouts: L[] = [
  { cls: 'fig-wide', W: 760, H: 300, cx: 210, y0: 20, y1: 280, wTop: 110, wBot: 380, wide: true },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 500, cx: 180, y0: 14, y1: 230, wTop: 110, wBot: 330, wide: false },
];
const geo = layouts.map((L) => {
  const n = layers.length, hL = (L.y1 - L.y0) / n;
  const width = (y: number) => L.wTop + ((L.wBot - L.wTop) * (y - L.y0)) / (L.y1 - L.y0);
  // layer k (0 = bottom) spans from yB(k) at the bottom to yB(k) - hL at the top
  const band = layers.map((_, k) => {
    const yb = L.y1 - k * hL, yt = yb - hL, ym = (yb + yt) / 2;
    const d = `M ${L.cx - width(yt) / 2} ${yt} L ${L.cx + width(yt) / 2} ${yt} L ${L.cx + width(yb) / 2} ${yb} L ${L.cx - width(yb) / 2} ${yb} Z`;
    return { yb, yt, ym, d, wMid: width(ym), wTop: width(yt) };
  });
  layers.forEach((l, k) => {
    fits(l.name, width(band[k].ym - 12) - 24, L.wide ? 7.5 : 8.0);
    if (L.wide) {
      fits(l.tag, width(band[k].ym + 4) - 16, 6.5);
      fits(l.what, L.W - 8 - 430, 6.5);
      fits(l.when, L.W - 8 - 430, 6.5);
    } else {
      fits(l.what, L.W - 8 - 44, 7.3);
      fits(l.when, L.W - 8 - 44, 7.3);
    }
  });
  return { band, hL };
});
const tone = ['var(--fig-green)', 'var(--fig-blue)', 'var(--fig-amber)', 'var(--fig-red)'];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L, li) => {
    const g = geo[li];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        {layers.map((l, k) => {
          const b = g.band[k];
          return (
            <g data-s={String(k + 1)}>
              <path d={b.d} style={`fill: ${tone[k]}; fill-opacity: 0.16; stroke: ${tone[k]}; stroke-width: 1.4`} />
              {L.wide
                ? <g>
                    <text class="f-label" x={L.cx} y={b.ym - 2} text-anchor="middle" style="font-weight: 650">{l.name}</text>
                    <text class="f-small f-t-muted" x={L.cx} y={b.ym + 16} text-anchor="middle">{l.tag}</text>
                    <path class="f-thin f-dot" d={`M ${L.cx + b.wMid / 2 + 6} ${b.ym} L 422 ${b.ym}`} />
                    <text class="f-small" x={430} y={b.ym - 3}>{l.what}</text>
                    <text class="f-small f-t-muted" x={430} y={b.ym + 15}>{l.when}</text>
                    <Badge x={L.cx - b.wMid / 2 - 16} y={b.ym} n={k + 1} />
                  </g>
                : <g>
                    <text class="f-label" x={L.cx} y={b.ym + 6} text-anchor="middle" style="font-weight: 650">{l.name}</text>
                    <Badge x={L.cx - b.wMid / 2 - 2} y={b.ym} n={k + 1} />
                    <Badge x={22} y={L.y1 + 34 + k * 66} n={k + 1} />
                    <text class="f-small" x={44} y={L.y1 + 39 + k * 66}>{l.what}</text>
                    <text class="f-small f-t-muted" x={44} y={L.y1 + 61 + k * 66}>{l.when}</text>
                  </g>}
            </g>
          );
        })}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
