---
import Figure from '../Figure.astro';

const ru = Astro.props.lang === 'ru';
const title = ru ? 'Запись и применение идут в разные моменты' : 'Durable copy and apply happen at different times';
const caption = ru
  ? 'В исполнении без отказа подтверждение устойчивой копии B приходит в 35 мс, а новое состояние на B видно в 45 мс.'
  : 'Without failure, confirmation of a durable B copy arrives at 35 ms. The new state becomes visible on B at 45 ms.';
const events = [
  { at: '5', label: ru ? 'Устойчивая запись на A' : 'Durable on A', color: 'f-solid-blue' },
  { at: '35', label: ru ? 'Подтверждение записи на B' : 'Durable B copy confirmed', color: 'f-solid-green' },
  { at: '45', label: ru ? 'Запись применена на B' : 'Applied on B', color: 'f-solid-green' },
];
---
<Figure id="big-data-replica-timeline" title={title} caption={caption}>
  <svg viewBox="0 0 340 126" role="img" aria-labelledby="replica-timeline-title replica-timeline-desc" style="max-width: 510px; margin-inline: auto">
    <title id="replica-timeline-title">{title}</title>
    <desc id="replica-timeline-desc">{caption}</desc>
    <path class="f-line" d="M 79 24 V 104" />
    {events.map(({at, label, color}, i) => (
      <g transform={`translate(0 ${i * 40})`}>
        <text class="f-label" x="64" y="29" text-anchor="end">{at} {ru ? 'мс' : 'ms'}</text>
        <circle class={color} cx="79" cy="24" r="5" />
        <text class="f-label" x="97" y="29">{label}</text>
      </g>
    ))}
  </svg>
</Figure>
