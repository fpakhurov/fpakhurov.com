---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Measured once with timeit (best of 5 batches) on CPython 3.14.7, Apple M1, macOS: the time of `-1 in data`
// for data = list(range(n)) (the element is absent, so the whole list is scanned) and for s = set(data).
// The numbers are embedded because the build cannot time code; the note's Code section reproduces the measurement.
const ns = [10, 100, 1_000, 10_000, 100_000, 1_000_000];
const listNs = [92.6, 757.0, 7618.3, 76910.7, 781099.7, 7801743.0];
const setNs = [11.0, 11.0, 11.1, 11.0, 11.1, 11.0];
// Checks: the list grows linearly (7 to 8 ns per element once n is 100 or more); the set stays flat.
ns.forEach((n, k) => {
  if (k > 0 && (listNs[k] / n < 7 || listNs[k] / n > 8.5)) throw new Error(`list per element at ${n}`);
  if (Math.abs(setNs[k] - 11) > 0.5) throw new Error(`set at ${n}`);
});
const perElement = listNs[5] / ns[5];
if (Math.abs(perElement - 7.8) > 0.05) throw new Error('7.8 ns per element');
const ratio = listNs[5] / setNs[5];
if (Math.round(ratio / 1000) !== 709) throw new Error(`ratio ${ratio}`);

const t = ru
  ? { x: 'длина n', y: 'время одной проверки', list: 'x in list: просмотр, 7.8 нс на элемент', listN: ['x in list:', '7.8 нс на элемент'], set: 'x in set: хеш, ~11 нс при любом n', setN: ['x in set:', '~11 нс'], ratio: 'при n = 1M в 700 000 раз медленнее' }
  : { x: 'length n', y: 'time of one test', list: 'x in list: a scan, 7.8 ns per element', listN: ['x in list:', '7.8 ns per element'], set: 'x in set: a hash, ~11 ns for any n', setN: ['x in set:', '~11 ns'], ratio: '700,000 times slower at n = 1M' };
const xLabels = ['10', '100', '1k', '10k', '100k', '1M'];
const yTicks = [1, 2, 3, 4, 5, 6, 7];
const yLabel = (e: number) => (ru ? ['10 нс', '100 нс', '1 мкс', '10 мкс', '100 мкс', '1 мс', '10 мс'] : ['10 ns', '100 ns', '1 µs', '10 µs', '100 µs', '1 ms', '10 ms'])[e - 1];

interface Layout { cls: string; W: number; H: number; x0: number; x1: number; y0: number; y1: number; wide: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 330, x0: 80, x1: 540, y0: 30, y1: 280, wide: true },
  { cls: 'fig-narrow', W: 360, H: 330, x0: 62, x1: 340, y0: 28, y1: 250, wide: false },
];
// The wide labels start at log10 n = 1.1 above the list line; check that they end before the line reaches their height.
for (const L of layouts.filter((l) => l.wide)) {
  const sx = scale([1, 6], [L.x0, L.x1]);
  const sy = scale([1, 7], [L.y1, L.y0]);
  const end = sx(1.1) + Math.max(t.list.length, t.ratio.length) * 6.5;
  const lineYAtEnd = sy(Math.log10(perElement) + Math.log10(10 ** (1 + (5 * (end - L.x0)) / (L.x1 - L.x0))));
  if (lineYAtEnd - 12 < sy(6.3) + 20) throw new Error('list label meets the line');
  if (sx(3.2) + t.set.length * 6.5 > L.x1) throw new Error('set label');
}
const id = 'membership-plot';
---

<Figure
  id={id}
  title={ru ? 'Проверка вхождения: список против множества' : 'Membership test: list against set'}
  caption={ru
    ? 'Время одной проверки -1 in data, где data — list(range(n)), и того же для set(data), в логарифмическом масштабе по обеим осям. Измерено один раз через timeit (лучший из 5 повторов) на CPython 3.14.7, Apple M1, macOS; на другой машине числа будут другими, форма — нет. Элемента нет в контейнере, поэтому список просматривается целиком: время растёт пропорционально n, примерно 7.8 нс на элемент. Множество находит ответ по хешу за одно и то же время, около 11 нс, при любом n.'
    : 'Time of one test -1 in data, with data = list(range(n)), and the same for set(data), on logarithmic scales on both axes. Measured once with timeit (best of 5 batches) on CPython 3.14.7, Apple M1, macOS; the numbers will differ on another machine, the shape will not. The element is absent, so the list is scanned to the end: the time grows in proportion to n, about 7.8 ns per element. The set finds the answer from a hash in the same time, about 11 ns, for every n.'}
>
  {layouts.map((L) => {
    const sx = scale([1, 6], [L.x0, L.x1]);
    const sy = scale([1, 7], [L.y1, L.y0]);
    const pts = (v: number[]) => v.map((y, k) => [sx(Math.log10(ns[k])), sy(Math.log10(y))] as [number, number]);
    const path = (p: [number, number][]) => p.map(([x, y], i) => `${i ? 'L' : 'M'} ${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
    const lp = pts(listNs), sp = pts(setNs);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Время проверки вхождения от длины' : 'Membership time against length'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Две линии в логарифмических осях. Список: от 93 нс при n = 10 до 7.8 мс при n = 1 000 000, прямая с наклоном 1. Множество: горизонтальная линия около 11 нс.'
          : 'Two lines on logarithmic axes. The list: from 93 ns at n = 10 to 7.8 ms at n = 1,000,000, a straight line of slope 1. The set: a horizontal line at about 11 ns.'}</desc>
        {yTicks.map((e) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(e)} H ${L.x1}`} />
            <text class="f-note" x={L.x0 - 8} y={sy(e) + 5} text-anchor="end">{yLabel(e)}</text>
          </g>
        ))}
        {xLabels.map((s, k) => (
          <g>
            <path class="f-axis" d={`M ${sx(k + 1)} ${L.y1} v 5`} />
            <text class="f-note" x={sx(k + 1)} y={L.y1 + 20} text-anchor="middle">{s}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${L.x0} ${L.y0} V ${L.y1} H ${L.x1}`} />
        <text class="f-note" x={L.x0} y={L.y0 - 12}>{t.y}</text>
        <text class="f-note" x={L.x1} y={L.y1 + 40} text-anchor="end">{t.x}</text>
        <path class="f-line f-red f-bold" d={path(lp)} />
        <path class="f-line f-blue f-bold" d={path(sp)} />
        {lp.map(([x, y]) => <circle cx={x} cy={y} r="3.5" class="f-solid-red" />)}
        {sp.map(([x, y]) => <circle cx={x} cy={y} r="3.5" class="f-solid-blue" />)}
        {L.wide && <text class="f-small f-t-red f-halo" x={sx(1.1)} y={sy(6.3)}>{t.list}</text>}
        {L.wide && <text class="f-small f-t-blue f-halo" x={sx(3.2)} y={sy(1) - 14}>{t.set}</text>}
        {L.wide && <text class="f-small f-t-muted f-halo" x={sx(1.1)} y={sy(6.3) + 20}>{t.ratio}</text>}
        {!L.wide && t.listN.map((s, i) => <text class="f-small f-t-red f-halo" x={sx(1.15)} y={sy(6.4) + i * 17}>{s}</text>)}
        {!L.wide && t.setN.map((s, i) => <text class="f-small f-t-blue f-halo" x={sx(3.6)} y={sy(2.15) + i * 17}>{s}</text>)}
      </svg>
    );
  })}
</Figure>
