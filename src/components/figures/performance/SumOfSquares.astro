---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Measured once on CPython 3.14.7 with NumPy 2.5.4 (Accelerate BLAS), Apple M1, macOS: the sum of squares of the same
// 1,000,000 floats (numpy.random.default_rng(0).random), best of 5 runs (3 for the first row), in ns per element.
// xs is the list arr.tolist(); every version printed the same sum, 333560.615743.
type Kind = 'interp' | 'cobj' | 'craw';
const rows: { code: string; ns: number; kind: Kind }[] = [
  { code: 'for x in arr: t += x * x', ns: 76.4, kind: 'interp' },
  { code: 'sum([x * x for x in xs])', ns: 26.13, kind: 'interp' },
  { code: 'sum(x * x for x in xs)', ns: 20.17, kind: 'interp' },
  { code: 'for x in xs: t += x * x', ns: 18.97, kind: 'interp' },
  { code: 'math.sumprod(xs, xs)', ns: 5.28, kind: 'cobj' },
  { code: '(arr * arr).sum()', ns: 0.37, kind: 'craw' },
  { code: 'arr @ arr', ns: 0.16, kind: 'craw' },
];
for (let k = 1; k !== rows.length; k++) if (rows[k].ns >= rows[k - 1].ns) throw new Error('rows must go from slow to fast');
const speedup = rows[3].ns / rows[6].ns;
if (Math.round(speedup) !== 119) throw new Error(`loop over matmul ${speedup}`);
const fmtNs = (v: number) => (v >= 10 ? v.toFixed(1) : v.toFixed(2)) + (ru ? ' нс' : ' ns');
const tone: Record<Kind, string> = { interp: 'red', cobj: 'amber', craw: 'green' };
const t = ru
  ? { axis: 'нс на элемент (логарифмическая шкала)', legend: { interp: 'интерпретатор, по элементу за раз', cobj: 'цикл на C по объектам float', craw: 'цикл на C по «сырым» double' } as Record<Kind, string> }
  : { axis: 'ns per element (log scale)', legend: { interp: 'the interpreter, one element at a time', cobj: 'a C loop over float objects', craw: 'a C loop over raw doubles' } as Record<Kind, string> };

interface Layout { cls: string; W: number; codeX: number; x0: number; x1: number; top: number; rowH: number; barH: number; labelAbove: boolean; mono: number; sans: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, codeX: 24, x0: 250, x1: 650, top: 20, rowH: 30, barH: 16, labelAbove: false, mono: 7.5, sans: 6.5 },
  { cls: 'fig-narrow', W: 360, codeX: 16, x0: 16, x1: 270, top: 20, rowH: 44, barH: 14, labelAbove: true, mono: 7.5, sans: 6.5 },
];
const geom = layouts.map((L) => {
  const sx = scale([-1, 2], [L.x0, L.x1]);
  const barsEnd = L.top + rows.length * L.rowH;
  const legendY = barsEnd + 62;
  const H = legendY + 3 * 20 + 4;
  for (const r of rows) {
    if (!L.labelAbove && L.codeX + r.code.length * L.mono > L.x0 - 8) throw new Error(`"${r.code}" runs into the bars`);
    if (L.labelAbove && L.codeX + r.code.length * L.mono > L.W - 4) throw new Error(`"${r.code}" overflows`);
    if (sx(Math.log10(r.ns)) + 6 + fmtNs(r.ns).length * L.sans > L.W - 4) throw new Error(`value of "${r.code}" overflows`);
  }
  for (const k of ['interp', 'cobj', 'craw'] as Kind[]) if (L.codeX + 22 + t.legend[k].length * L.sans > L.W - 4) throw new Error('legend');
  return { sx, barsEnd, legendY, H };
});
const id = 'sum-of-squares';
---

<Figure
  id={id}
  title={ru ? 'Сумма квадратов миллиона чисел семью способами' : 'The sum of squares of a million numbers, seven ways'}
  caption={ru
    ? 'Время на один элемент для суммы квадратов одного и того же миллиона чисел float, шкала логарифмическая. xs — список Python, arr — массив NumPy с теми же числами. Измерено один раз: CPython 3.14.7, NumPy 2.5.4, Apple M1, macOS, лучший из 5 запусков; все версии дали одну и ту же сумму. Цвет — модель под кодом: красным — цикл интерпретатора, где каждый элемент — объект в куче; жёлтым — цикл на C по тем же объектам; зелёным — цикл на C по непрерывному массиву double. Самая медленная строка — цикл Python по массиву NumPy: каждый элемент при чтении упаковывается в новый объект.'
    : 'Time per element for the sum of squares of the same million floats, on a logarithmic scale. xs is a Python list and arr a NumPy array holding the same numbers. Measured once: CPython 3.14.7, NumPy 2.5.4, Apple M1, macOS, best of 5 runs; every version gave the same sum. The colour is the model under the code: red, the interpreter loop, where every element is an object on the heap; amber, a C loop over the same objects; green, a C loop over a contiguous array of doubles. The slowest row is a Python loop over a NumPy array: every element read is boxed into a new object.'}
>
  {layouts.map((L, li) => {
    const { sx, barsEnd, legendY, H } = geom[li];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Семь способов, нс на элемент' : 'Seven ways, ns per element'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Горизонтальные столбцы от медленного к быстрому: цикл по массиву NumPy 76.4 нс; сумма по включению списка 26.1; сумма по генератору 20.2; цикл for 19.0; math.sumprod 5.28; NumPy (arr * arr).sum() 0.37; arr @ arr 0.16 нс.'
          : 'Horizontal bars from slow to fast: a loop over a NumPy array 76.4 ns; sum of a list comprehension 26.1; sum of a generator 20.2; a for loop 19.0; math.sumprod 5.28; NumPy (arr * arr).sum() 0.37; arr @ arr 0.16 ns.'}</desc>
        {[-1, 0, 1, 2].map((e) => (
          <g>
            <path class="f-grid" d={`M ${sx(e)} ${L.top - 6} V ${barsEnd}`} />
            <text class="f-note" x={sx(e)} y={barsEnd + 18} text-anchor="middle">{['0.1', '1', '10', '100'][e + 1]}</text>
          </g>
        ))}
        <text class="f-note" x={sx(2)} y={barsEnd + 36} text-anchor="end">{t.axis}</text>
        {rows.map((r, k) => {
          const y = L.top + k * L.rowH + (L.labelAbove ? 20 : 4);
          const w = sx(Math.log10(r.ns)) - L.x0;
          return (
            <g>
              <text class="f-small" x={L.codeX} y={L.labelAbove ? y - 5 : y + L.barH / 2 + 4.5} style="font-family: var(--mono)">{r.code}</text>
              <rect x={L.x0} y={y} width={w} height={L.barH} rx="2" class={`f-fill-${tone[r.kind]}`} style={`stroke: var(--fig-${tone[r.kind]}); stroke-width: 1.2`} />
              <text class="f-small" x={L.x0 + w + 6} y={y + L.barH / 2 + 4.5}>{fmtNs(r.ns)}</text>
            </g>
          );
        })}
        {(['interp', 'cobj', 'craw'] as Kind[]).map((k, i) => (
          <g>
            <rect x={L.codeX} y={legendY + i * 20 - 10} width="14" height="12" rx="2" class={`f-fill-${tone[k]}`} style={`stroke: var(--fig-${tone[k]}); stroke-width: 1.2`} />
            <text class="f-small" x={L.codeX + 22} y={legendY + i * 20}>{t.legend[k]}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
