---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { mulberry32, normal } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Pure noise: 60 datasets of n = 50 objects (25 per class) with d = 1000 standard normal features that carry no
// information about the label. Keep the k features with the largest |difference of class means| / sd, classify by the
// nearest class centroid, and estimate accuracy by stratified 5-fold cross-validation. "Wrong": features chosen once on
// all 50 objects. "Right": features chosen again inside each training fold. The true accuracy of any rule is 0.5.
const n = 50, d = 1000, R = 60, K = 5;
const ks = [1, 2, 5, 10, 20, 50, 100, 200, 500, 1000];
const z = normal(mulberry32(2024));
const y = Array.from({ length: n }, (_, i) => i % 2);
const fold = Array.from({ length: n }, (_, i) => Math.floor(i / 2) % K);
const order = (X: number[][], rows: number[]) => {
  const s = new Array(d).fill(0);
  for (let j = 0; j < d; j++) {
    let s0 = 0, s1 = 0, n0 = 0, n1 = 0, q = 0;
    for (const r of rows) { const v = X[r][j]; if (y[r]) { s1 += v; n1++; } else { s0 += v; n0++; } q += v * v; }
    const mean = (s0 + s1) / rows.length, sd = Math.sqrt(q / rows.length - mean * mean);
    s[j] = Math.abs(s1 / n1 - s0 / n0) / sd;
  }
  return s.map((v, j) => [v, j]).sort((a, b) => b[0] - a[0]).map((p) => p[1]);
};
const centroidAcc = (X: number[][], tr: number[], te: number[], feats: number[]) => {
  const c = [new Array(feats.length).fill(0), new Array(feats.length).fill(0)], cnt = [0, 0];
  for (const r of tr) { cnt[y[r]]++; feats.forEach((j, a) => { c[y[r]][a] += X[r][j]; }); }
  c.forEach((v, cl) => v.forEach((_, a) => { v[a] /= cnt[cl]; }));
  let ok = 0;
  for (const r of te) {
    let d0 = 0, d1 = 0;
    feats.forEach((j, a) => { d0 += (X[r][j] - c[0][a]) ** 2; d1 += (X[r][j] - c[1][a]) ** 2; });
    if ((d1 < d0 ? 1 : 0) === y[r]) ok++;
  }
  return ok / te.length;
};
const wrong = new Array(ks.length).fill(0), right = new Array(ks.length).fill(0);
const all = Array.from({ length: n }, (_, i) => i);
for (let rep = 0; rep < R; rep++) {
  const X = Array.from({ length: n }, () => Array.from({ length: d }, z));
  const oAll = order(X, all);
  for (let f = 0; f < K; f++) {
    const tr = all.filter((i) => fold[i] !== f), te = all.filter((i) => fold[i] === f);
    const oTr = order(X, tr);
    ks.forEach((k, a) => {
      wrong[a] += centroidAcc(X, tr, te, oAll.slice(0, k)) / (R * K);
      right[a] += centroidAcc(X, tr, te, oTr.slice(0, k)) / (R * K);
    });
  }
}
const at = (k: number) => ks.indexOf(k);
const quoted = [wrong[at(1)], wrong[at(20)], wrong[at(200)], wrong[at(1000)], Math.min(...right), Math.max(...right)].map((v) => v.toFixed(2)).join();
if (quoted !== '0.68,0.93,0.99,0.50,0.47,0.50') throw new Error(`SelectionOnNoise: numbers drifted from the note (${quoted})`);
const t = ru
  ? { x: 'число отобранных признаков k (из 1000)', y: 'доля правильных ответов по кросс-валидации', wrong: 'отбор по всем данным', right: 'отбор внутри каждого фолда', truth: 'истинная доля правильных ответов 0.5' }
  : { x: 'number of selected features k (of 1000)', y: 'cross-validated accuracy', wrong: 'selected on all the data', right: 'selected inside each fold', truth: 'true accuracy 0.5' };
const id = 'selection-on-noise';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 320, x0: 56, x1: 580, y0: 20, y1: 260, narrow: false },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 330, x0: 44, x1: 346, y0: 20, y1: 262, narrow: true },
];
---

<Figure
  id={id}
  title={ru ? 'Отбор признаков вне кросс-валидации находит сигнал в чистом шуме' : 'Feature selection outside cross-validation finds signal in pure noise'}
  caption={ru
    ? `${R} наборов по 50 объектов с 1000 случайными признаками, не связанными с меткой. Из признаков берутся k с наибольшей разницей средних по классам, классификатор — ближайший центроид, доля правильных ответов оценивается 5-кратной кросс-валидацией, среднее по наборам. Если признаки выбраны один раз по всем 50 объектам (красная кривая), оценка растёт с ${wrong[at(1)].toFixed(2)} при k = 1 до ${wrong[at(200)].toFixed(2)} при k = 200 и падает до ${wrong[at(1000)].toFixed(2)}, когда отбора уже нет. Если отбор повторяется внутри каждого обучающего фолда (синяя), оценка остаётся между ${Math.min(...right).toFixed(2)} и ${Math.max(...right).toFixed(2)}: честные 0.5.`
    : `${R} datasets of 50 objects with 1,000 random features unrelated to the label. The k features with the largest difference of class means are kept, the classifier is the nearest centroid, and accuracy is estimated by 5-fold cross-validation and averaged over the datasets. With the features chosen once on all 50 objects (red), the estimate rises from ${wrong[at(1)].toFixed(2)} at k = 1 to ${wrong[at(200)].toFixed(2)} at k = 200, and falls to ${wrong[at(1000)].toFixed(2)} when nothing is selected any more. With the selection repeated inside each training fold (blue), it stays between ${Math.min(...right).toFixed(2)} and ${Math.max(...right).toFixed(2)}: the honest 0.5.`}
>
  {layouts.map((L) => {
    const sx = scale([0, 3], [L.x0 + 8, L.x1 - 8]), sy = scale([0.4, 1.0], [L.y1, L.y0]);
    const lx = (k: number) => sx(Math.log10(k));
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Доля правильных ответов по кросс-валидации на шуме при двух способах отбора' : 'Cross-validated accuracy on noise under two ways of selecting features'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Красная кривая поднимается почти до 1 и возвращается к 0.5 при k = 1000; синяя лежит около 0.5 при всех k.' : 'The red curve climbs to almost 1 and returns to 0.5 at k = 1000; the blue curve stays near 0.5 for every k.'}</desc>
        {[0.4, 0.5, 0.6, 0.7, 0.8, 0.9, 1.0].map((v) => <g><path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} /><text class="f-note" x={L.x0 - 8} y={sy(v) + 5} text-anchor="end">{v.toFixed(1)}</text></g>)}
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {[1, 10, 100, 1000].map((k) => <text class="f-note" x={lx(k)} y={L.y1 + 18} text-anchor="middle">{k}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 40} text-anchor="middle">{t.x}</text>
        <path class="f-thin f-muted f-dash" d={`M ${L.x0} ${sy(0.5)} H ${L.x1}`} />
        <path class="f-line f-red" d={polyline(ks.map((k, a) => [lx(k), sy(wrong[a])]))} />
        <path class="f-line f-blue" d={polyline(ks.map((k, a) => [lx(k), sy(right[a])]))} />
        {ks.map((k, a) => <circle cx={lx(k)} cy={sy(wrong[a])} r="3.2" class="f-solid-red" />)}
        {ks.map((k, a) => <circle cx={lx(k)} cy={sy(right[a])} r="3.2" class="f-solid-blue" />)}
        <text class="f-small f-t-red f-halo" x={L.narrow ? lx(1) + 4 : lx(8)} y={L.narrow ? sy(0.62) : sy(0.96)} text-anchor={L.narrow ? 'start' : 'end'}>{t.wrong}</text>
        <text class="f-small f-t-blue f-halo" x={lx(1) + 4} y={sy(0.5) - 22}>{t.right}</text>
        <text class="f-note f-halo" x={lx(1) + 4} y={sy(0.5) + 30}>{t.truth}</text>
      </svg>
    );
  })}
</Figure>
