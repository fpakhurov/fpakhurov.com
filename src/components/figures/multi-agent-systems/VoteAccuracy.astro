---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Majority vote of n agents on a yes/no question. Each agent is right with probability p. With probability rho all agents
// share one draw (a common blind spot); otherwise they err independently. The pairwise correlation of their correctness is
// rho, and the vote is right with A_n = rho p + (1 - rho) B_n(p), where B_n is the binomial tail above n/2.
const p = 0.7;
function binom(n: number, k: number): number {
  let c = 1;
  for (let i = 1; i <= k; i++) c = (c * (n - k + i)) / i;
  return c;
}
const B = (n: number) => {
  let s = 0;
  for (let k = Math.floor(n / 2) + 1; k <= n; k++) s += binom(n, k) * p ** k * (1 - p) ** (n - k);
  return s;
};
const A = (n: number, rho: number) => rho * p + (1 - rho) * B(n);
const rhos = [
  { rho: 0, line: 'f-blue', text: 'f-t-blue', fill: 'f-solid-blue' },
  { rho: 0.2, line: 'f-green', text: 'f-t-green', fill: 'f-solid-green' },
  { rho: 0.5, line: 'f-amber', text: 'f-t-amber', fill: '' },
  { rho: 0.8, line: 'f-red', text: 'f-t-red', fill: 'f-solid-red' },
];
const ns = Array.from({ length: 13 }, (_, i) => 2 * i + 1);   // 1, 3, ..., 25
const quoted = [A(5, 0), A(5, 0.5), A(25, 0), A(25, 0.2), A(25, 0.5), A(25, 0.8)].map((v) => v.toFixed(3)).join(' ');
if (quoted !== '0.837 0.768 0.983 0.926 0.841 0.757') throw new Error(`VoteAccuracy: numbers drifted from the note (${quoted})`);

const t = ru
  ? { title: 'Доля правильных ответов голосования большинством в зависимости от числа агентов', x: 'число агентов n', y: 'доля правильных ответов',
      lab: (r: number) => `ρ = ${r}`, lim: 'пунктир: предел 1 − ρ(1 − p)',
      desc: 'Четыре кривые доли правильных ответов голосования большинством для нечётного числа агентов от 1 до 25 при вероятности одного агента быть правым 0.7 и корреляции ошибок ρ = 0, 0.2, 0.5 и 0.8. При ρ = 0 доля растёт до 0.983 при 25 агентах; при ρ = 0.8 — только до 0.757. Пунктиром показаны пределы 1 − ρ(1 − p): 1, 0.94, 0.85 и 0.76.' }
  : { title: 'Majority-vote accuracy against the number of agents', x: 'number of agents n', y: 'accuracy of the majority',
      lab: (r: number) => `ρ = ${r}`, lim: 'dashed: the limit 1 − ρ(1 − p)',
      desc: 'Four curves of majority-vote accuracy for odd numbers of agents from 1 to 25, with single-agent accuracy 0.7 and error correlation ρ = 0, 0.2, 0.5 and 0.8. At ρ = 0 the accuracy rises to 0.983 with 25 agents; at ρ = 0.8 only to 0.757. Dashed lines mark the limits 1 − ρ(1 − p): 1, 0.94, 0.85 and 0.76.' };
const id = 'vote-accuracy';
const caption = ru
  ? `Каждый агент прав с вероятностью p = 0.7; с вероятностью ρ все агенты ошибаются или правы вместе (общее слепое пятно), иначе независимо. Большинство право с вероятностью ρp + (1 − ρ)Bₙ(p), где Bₙ — вероятность, что больше половины из n независимых агентов правы. Независимые агенты при n = 25 дают ${A(25, 0).toFixed(3)}; при ρ = 0.5 доля правильных ответов не превысит 0.85, сколько агентов ни добавляй. Голоса помогают ровно настолько, насколько ошибки различны.`
  : `Each agent is right with probability p = 0.7; with probability ρ all agents are right or wrong together (a shared blind spot), otherwise independently. The majority is right with probability ρp + (1 − ρ)Bₙ(p), where Bₙ is the probability that more than half of n independent agents are right. Independent agents reach ${A(25, 0).toFixed(3)} at n = 25; at ρ = 0.5 the accuracy never exceeds 0.85, however many agents are added. Votes help exactly as much as the errors differ.`;

const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [70, 620] as [number, number], py: [40, 270] as [number, number], leg: [640, 120, 26] as [number, number, number] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 400, px: [52, 344] as [number, number], py: [40, 250] as [number, number], leg: [40, 320, 24] as [number, number, number] },
];
const yTicks = [0.7, 0.8, 0.9, 1.0], xTicks = [1, 5, 9, 13, 17, 21, 25];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sx = scale([1, 25], L.px), sy = scale([0.68, 1.0], [L.py[1], L.py[0]]);
    const narrow = L.sfx === 'n';
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {yTicks.map((v) => <path class="f-grid" d={`M ${L.px[0]} ${sy(v)} H ${L.px[1]}`} />)}
        <path class="f-axis" d={`M ${L.px[0]} ${L.py[0] - 6} V ${L.py[1]} H ${L.px[1]}`} />
        {yTicks.map((v) => <text class="f-small" x={L.px[0] - 7} y={sy(v) + 4} text-anchor="end">{v.toFixed(1)}</text>)}
        {xTicks.map((v) => <text class="f-small" x={sx(v)} y={L.py[1] + 18} text-anchor="middle">{String(v)}</text>)}
        <text class="f-small f-t-muted" x={(L.px[0] + L.px[1]) / 2} y={L.py[1] + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.px[0] - 40} y={L.py[0] - 20}>{t.y}</text>
        {rhos.map((R) => (
          <g>
            <path class={`f-line ${R.line} f-dash`} d={`M ${L.px[0]} ${sy(1 - R.rho * (1 - p))} H ${L.px[1]}`} style="stroke-width: 1" />
            <path class={`f-line ${R.line}`} d={polyline(ns.map((n) => [sx(n), sy(A(n, R.rho))] as [number, number]))} />
            {ns.map((n) => <circle cx={sx(n)} cy={sy(A(n, R.rho))} r="2.6" style={`fill: var(--fig-${R.line.slice(2)})`} />)}
            <text class={`f-small ${R.text} f-halo`} x={sx(25) - 4} y={sy(A(25, R.rho)) + 15} text-anchor="end">{A(25, R.rho).toFixed(3)}</text>
          </g>
        ))}
        {rhos.map((R, i) => (
          <g>
            <path class={`f-line ${R.line}`} d={narrow ? `M ${L.leg[0] + i * 76} ${L.leg[1] - 4} h 16` : `M ${L.leg[0]} ${L.leg[1] + i * L.leg[2] - 4} h 20`} />
            <text class={`f-small ${R.text}`} x={narrow ? L.leg[0] + i * 76 + 22 : L.leg[0] + 26} y={narrow ? L.leg[1] : L.leg[1] + i * L.leg[2]}>{t.lab(R.rho)}</text>
          </g>
        ))}
        {narrow && <text class="f-small f-t-muted" x={L.leg[0]} y={L.leg[1] + 26}>{t.lim}</text>}
        {!narrow && <text class="f-small f-t-muted" x={L.leg[0]} y={L.leg[1] + 4 * L.leg[2] + 4}>{ru ? 'пунктир:' : 'dashed:'}</text>}
        {!narrow && <text class="f-small f-t-muted" x={L.leg[0]} y={L.leg[1] + 4 * L.leg[2] + 22}>{ru ? 'предел' : 'the limit'}</text>}
        {!narrow && <text class="f-small f-t-muted" x={L.leg[0]} y={L.leg[1] + 4 * L.leg[2] + 40}>1 − ρ(1 − p)</text>}
      </svg>
    );
  })}
</Figure>
