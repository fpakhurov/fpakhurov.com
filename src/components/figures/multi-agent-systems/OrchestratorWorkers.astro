---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Orchestrator and workers: the orchestrator splits the task and writes a brief for each worker; each worker works in
// its own context with its own tool calls; it returns a short structured result; the orchestrator checks and merges.
const t = ru
  ? {
      title: 'Оркестратор и исполнители',
      task: 'задача', taskSub: 'шесть городов', orch: 'оркестратор', orchSub: 'делит, сводит, проверяет',
      ans: 'ответ', ansSub: 'с источником', worker: (i: number) => `агент ${i}`, wSub: 'свой контекст',
      tools: 'поиск, чтение', toolsN: 'инструменты', brief: 'поручение', result: 'краткий результат',
      steps: ['деление: оркестратор разбивает задачу на независимые части', 'поручения: каждый исполнитель получает краткое описание своей части', 'работа: исполнители параллельно вызывают инструменты, каждый в своём контексте', 'возврат: исполнители возвращают короткие структурированные результаты, а не всё прочитанное', 'сведение: оркестратор проверяет результаты, при необходимости запрашивает повторно и пишет ответ'],
      desc: 'Слева сверху задача, в центре сверху оркестратор, справа сверху ответ. Ниже три исполнителя, у каждого свой контекст и свои вызовы инструментов поиска и чтения. Янтарная шина поручений идёт от оркестратора к исполнителям, зелёная шина кратких результатов — обратно к оркестратору, который проверяет и сводит их в ответ.',
    }
  : {
      title: 'An orchestrator and its workers',
      task: 'task', taskSub: 'six cities', orch: 'orchestrator', orchSub: 'split, merge, check',
      ans: 'answer', ansSub: 'with its source', worker: (i: number) => `worker ${i}`, wSub: 'own context',
      tools: 'search, read', toolsN: 'tools', brief: 'brief', result: 'short result',
      steps: ['split: the orchestrator divides the task into independent parts', 'brief: each worker receives a short description of its part', 'work: the workers call tools in parallel, each in its own context', 'return: the workers send back short structured results, not everything they read', 'merge: the orchestrator checks the results, asks again if needed, and writes the answer'],
      desc: 'At the top left the task, at the top centre the orchestrator, at the top right the answer. Below, three workers, each with its own context and its own calls to search and read tools. An amber bus of briefs goes from the orchestrator to the workers, and a green bus of short results goes back to the orchestrator, which checks and merges them into the answer.',
    };
const id = 'orchestrator-workers';
const caption = ru
  ? 'Каждый исполнитель видит только своё поручение и то, что прочитал сам, поэтому его контекст короткий, а работа идёт параллельно: цепочка последовательных вызовов не растёт с числом частей. Цена — повторённые в каждом контексте инструкции и потеря подробностей на передаче: оркестратор видит лишь то, что исполнитель решил вернуть. Поэтому результаты возвращают в проверяемом виде, и оркестратор проверяет их перед сведением.'
  : 'Each worker sees only its brief and what it read itself, so its context stays short and the work runs in parallel: the chain of calls in sequence does not grow with the number of parts. The price is instructions repeated in every context and detail lost at the handoff: the orchestrator sees only what a worker chose to return. That is why results come back in a checkable structure, and the orchestrator checks them before it merges.';
const wx = [60, 300, 540], WW = 160;
const nx = [16, 130, 244], NW = 100;
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 320" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <Box x={16} y={20} w={150} h={50} label={t.task} sub={t.taskSub} tone="x" />
    <g data-s="1">
      <Arrow pts={[[166, 45], [288, 45]]} tone="green" />
      <Box x={290} y={20} w={180} h={50} label={t.orch} sub={t.orchSub} tone="h" />
      <Badge x={458} y={20} n={1} />
    </g>
    <g data-s="2">
      <path class="f-line f-amber" d={`M 350 70 V 98 M ${wx[0] + 50} 98 H ${wx[2] + 50}`} />
      {wx.map((x) => <Arrow pts={[[x + 50, 98], [x + 50, 138]]} tone="amber" />)}
      <text class="f-small f-t-amber f-halo" x={wx[0] + 56} y="92">{t.brief}</text>
      {wx.map((x, i) => <Box x={x} y={140} w={WW} h={50} label={t.worker(i + 1)} sub={t.wSub} tone="g" />)}
      <Badge x={wx[0] + WW - 12} y={140} n={2} />
    </g>
    <g data-s="3">
      {wx.map((x) => (
        <g>
          <Box x={x + 20} y={240} w={WW - 40} h={40} label={t.tools} />
          <Arrow pts={[[x + 70, 190], [x + 70, 238]]} tone="red" />
          <Arrow pts={[[x + 90, 240], [x + 90, 192]]} tone="green" />
        </g>
      ))}
      <Badge x={wx[1] + WW - 12} y={240} n={3} />
    </g>
    <g data-s="4">
      {wx.map((x) => <path class="f-line f-green" d={`M ${x + 110} 140 V 116`} />)}
      <path class="f-line f-green" d={`M ${wx[0] + 110} 116 H ${wx[2] + 110}`} />
      <Arrow pts={[[410, 116], [410, 72]]} tone="green" />
      <text class="f-small f-t-green f-halo" x="420" y="111">{t.result}</text>
      <Badge x={wx[2] + WW - 12} y={140} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[470, 45], [592, 45]]} tone="red" />
      <Box x={594} y={20} w={150} h={50} label={t.ans} sub={t.ansSub} tone="y" />
      <Badge x={732} y={20} n={5} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 350" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <Box x={16} y={8} w={156} h={46} label={t.task} sub={t.taskSub} tone="x" />
    <g data-s="1">
      <Arrow pts={[[94, 54], [94, 76]]} tone="green" />
      <Box x={16} y={78} w={328} h={46} label={t.orch} sub={t.orchSub} tone="h" />
      <Badge x={332} y={78} n={1} />
    </g>
    <g data-s="2">
      <path class="f-line f-amber" d={`M 120 124 V 148 M ${nx[0] + 30} 148 H ${nx[2] + 30}`} />
      {nx.map((x) => <Arrow pts={[[x + 30, 148], [x + 30, 188]]} tone="amber" />)}
      {nx.map((x, i) => <Box x={x} y={190} w={NW} h={50} label={t.worker(i + 1)} sub={t.wSub} tone="g" />)}
      <Badge x={nx[0] + NW - 10} y={190} n={2} />
    </g>
    <g data-s="3">
      {nx.map((x) => (
        <g>
          <Box x={x} y={282} w={NW} h={40} label={t.toolsN} />
          <Arrow pts={[[x + 40, 240], [x + 40, 280]]} tone="red" />
          <Arrow pts={[[x + 60, 282], [x + 60, 242]]} tone="green" />
        </g>
      ))}
      <Badge x={nx[1] + NW - 10} y={282} n={3} />
    </g>
    <g data-s="4">
      {nx.map((x) => <path class="f-line f-green" d={`M ${x + 76} 190 V 166`} />)}
      <path class="f-line f-green" d={`M ${nx[0] + 76} 166 H ${nx[2] + 76}`} />
      <Arrow pts={[[240, 166], [240, 126]]} tone="green" />
      <Badge x={nx[2] + NW - 10} y={190} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[262, 78], [262, 56]]} tone="red" />
      <Box x={188} y={8} w={156} h={46} label={t.ans} sub={t.ansSub} tone="y" />
      <Badge x={332} y={8} n={5} />
    </g>
    <text class="f-small f-t-muted" x="16" y="344">{`${t.brief} ↓   ${t.result} ↑`}</text>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
