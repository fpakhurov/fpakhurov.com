---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';
import { schedule, totalCycles, cells, forwards, type Instr } from './schedule';

const ru = pageLang(Astro.url) === 'ru';

// The sequence of the note's worked example: a load-use hazard, then two ALU results that are forwarded.
const prog: Instr[] = [
  { text: 'lw t0, 0(a0)', dest: 't0', srcs: ['a0'], load: true },
  { text: 'add t1, t0, t2', dest: 't1', srcs: ['t0', 't2'] },
  { text: 'sub t3, t1, t4', dest: 't3', srcs: ['t1', 't4'] },
  { text: 'sw t3, 8(a0)', srcs: ['t3', 'a0'] },
];
const ex = schedule(prog, true);
const withFw = totalCycles(prog, true), noFw = totalCycles(prog, false);
if (withFw !== 9 || noFw !== 14) throw new Error(`pipeline: ${withFw} and ${noFw} cycles, expected 9 and 14`);
if (ex.join() !== '3,5,6,7') throw new Error(`EX cycles ${ex}`);
const grid = cells(prog, true);
const fw = forwards(prog);
if (fw.map((f) => `${f.from}>${f.to}:${f.path}`).join() !== '0>1:MEM/WB,1>2:EX/MEM,2>3:EX/MEM') throw new Error(`forwards ${JSON.stringify(fw)}`);
const stalls = grid.flat().filter((c) => c.repeat);
if (stalls.map((c) => c.cycle).join() !== '4,4') throw new Error('one stall cycle expected, in cycle 4');

// Step of every cell: 1 = the load and what enters behind it; 2 = the stall; 3–5 = the three consumers from their EX on.
const stepOf = (i: number, cycle: number, repeat: boolean) => {
  if (repeat) return 2;
  if (i === 0 || cycle <= 3) return 1;
  if (i === 1) return 3;
  return cycle >= ex[i - 1] ? i + 2 : i + 1;
};
const fwStep = (k: number) => k + 3;

const t = ru
  ? { cycle: 'такт', stall: 'простой', withF: `с пробрасыванием: ${withFw} тактов`, noF: `без пробрасывания: ${noFw} тактов`,
      steps: ['lw проходит пять стадий, по одной за такт; загруженное значение готово только в конце MEM, в такте 4',
        'в такте 4 add должна быть на стадии EX, но t0 ещё не готов: блок конфликтов держит add в ID и sub в IF, а в EX уходит пузырёк',
        'в такте 5 значение t0 пробрасывается из регистра MEM/WB на вход АЛУ команды add',
        'в такте 6 результат add пробрасывается из регистра EX/MEM на вход АЛУ команды sub',
        `в такте 7 результат sub пробрасывается в sw; 4 команды занимают ${withFw} тактов: 5 + 3 + 1 такт простоя`] }
  : { cycle: 'cycle', stall: 'stall', withF: `with forwarding: ${withFw} cycles`, noF: `without forwarding: ${noFw} cycles`,
      steps: ['lw goes through the five stages, one per cycle; the loaded value exists only at the end of MEM, in cycle 4',
        'in cycle 4 add should be in EX, but t0 is not there yet: the hazard unit holds add in ID and sub in IF, and a bubble goes into EX',
        'in cycle 5 the value of t0 is forwarded from the MEM/WB register to the ALU input of add',
        'in cycle 6 the result of add is forwarded from the EX/MEM register to the ALU input of sub',
        `in cycle 7 the result of sub is forwarded to sw; 4 instructions take ${withFw} cycles: 5 + 3 + 1 stall`] };

interface Layout { cls: string; W: number; H: number; wide: boolean; x0: number; cw: number; y0: number; rh: number; ch: number; labelX: number; labelDy: number; barX: number; barY: number; unit: number; b2: [number, number] }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 344, wide: true, x0: 176, cw: 62, y0: 46, rh: 52, ch: 30, labelX: 14, labelDy: 0, barX: 230, barY: 282, unit: 20, b2: [0.07, -11] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 424, wide: false, x0: 14, cw: 37, y0: 70, rh: 64, ch: 30, labelX: 14, labelDy: -24, barX: 14, barY: 346, unit: 22, b2: [0.5, 104] },
];
const id = 'pipeline-diagram';
const N = withFw;
---

<Figure
  id={id}
  title={ru ? 'Четыре команды в пятистадийном конвейере: один простой и три пробрасывания' : 'Four instructions in the five-stage pipeline: one stall and three forwards'}
  caption={ru
    ? `Строки — команды, столбцы — такты; клетка показывает, в какой стадии команда находится в этом такте. Команда add использует t0, который загружает lw: значение появляется только в конце MEM (такт 4), поэтому add ждёт в ID один лишний такт, а sub — в IF (жёлтые клетки). Красные стрелки — пробрасывания: из MEM/WB в EX для add и из EX/MEM в EX для sub и sw. Полосы внизу сравнивают время: ${withFw} тактов с пробрасыванием и ${noFw} без него, когда каждая зависимая команда может прочитать регистр в ID только в такте WB команды, которая его записывает.`
    : `Rows are instructions, columns are clock cycles; a cell shows the stage an instruction is in during that cycle. add uses t0, which lw loads: the value exists only at the end of MEM (cycle 4), so add waits one extra cycle in ID and sub one extra cycle in IF (amber cells). Red arrows are forwards: from MEM/WB into EX for add, and from EX/MEM into EX for sub and sw. The bars at the bottom compare the time: ${withFw} cycles with forwarding and ${noFw} without, when every dependent instruction can read its register in ID only in the cycle of its producer's WB.`}
>
  {layouts.map((L) => {
    const cx = (c: number) => L.x0 + (c - 1) * L.cw;
    const ry = (i: number) => L.y0 + i * L.rh;
    const cellW = L.cw - 5;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Диаграмма конвейера: команды по тактам' : 'Pipeline diagram: instructions by cycle'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? `Сетка из четырёх строк (lw, add, sub, sw) и ${N} столбцов-тактов. Каждая команда проходит IF, ID, EX, MEM, WB со сдвигом на такт; в такте 4 add повторяет ID, а sub повторяет IF. Стрелки ведут из MEM команды lw в EX команды add, из EX команды add в EX команды sub и из EX команды sub в EX команды sw. Внизу две полосы: ${withFw} тактов с пробрасыванием и ${noFw} без пробрасывания.`
          : `A grid of four rows (lw, add, sub, sw) and ${N} cycle columns. Each instruction goes through IF, ID, EX, MEM, WB one cycle behind the previous one; in cycle 4 add repeats ID and sub repeats IF. Arrows lead from the MEM cell of lw to the EX cell of add, from the EX of add to the EX of sub, and from the EX of sub to the EX of sw. At the bottom two bars: ${withFw} cycles with forwarding and ${noFw} without.`}</desc>

        <text class="f-small f-t-muted" x={L.wide ? L.labelX : L.x0} y={L.wide ? L.y0 - 18 : 20}>{t.cycle}</text>
        {Array.from({ length: N }, (_, k) => (
          <text class="f-small f-t-muted" x={cx(k + 1) + cellW / 2} y={L.wide ? L.y0 - 18 : 40} text-anchor="middle">{k + 1}</text>
        ))}

        {prog.map((ins, i) => (
          <g>
            <text class="f-small" x={L.labelX} y={ry(i) + L.ch / 2 + 4.5 + L.labelDy} style="font-family: var(--mono)">{ins.text}</text>
            {grid[i].map((c) => (
              <g data-s={String(stepOf(i, c.cycle, c.repeat))}>
                <rect x={cx(c.cycle)} y={ry(i)} width={cellW} height={L.ch} rx="5"
                  class={c.repeat ? 'f-fill-amber f-amber' : 'f-fill-blue f-blue'} style={c.repeat ? 'stroke-width: 1.4; stroke-dasharray: 4 3' : 'stroke-width: 1.1'} />
                <text class="f-small" x={cx(c.cycle) + cellW / 2} y={ry(i) + L.ch / 2 + 4.5} text-anchor="middle" style={L.wide ? undefined : 'font-size: 12px'}>{c.stage}</text>
              </g>
            ))}
          </g>
        ))}

        <g data-s="2"><Badge x={cx(4) + L.b2[0] * cellW} y={ry(1) + L.b2[1]} n={2} /></g>

        {fw.map((f, k) => {
          const x1 = cx(f.fromCycle) + cellW * 0.62, y1 = ry(f.from) + L.ch + 1;
          const x2 = cx(f.toCycle) + cellW * 0.3, y2 = ry(f.to) - 3;
          return (
            <g data-s={String(fwStep(k))}>
              <path class="f-line f-red f-bold" d={`M ${x1} ${y1} L ${x2} ${y2}`} marker-end="url(#f-arrow-red)" />
              <Badge x={x2 + 15} y={(y1 + y2) / 2 + 1} n={fwStep(k)} />
            </g>
          );
        })}
        <g data-s="1"><Badge x={cx(6) + 12} y={ry(0) + L.ch / 2} n={1} /></g>

        <g data-s="5">
          {[[withFw, t.withF, 'f-fill-blue f-blue'], [noFw, t.noF, 'f-fill-amber f-amber']].map(([n, label, cls], k) => {
            const y = L.barY + k * (L.wide ? 34 : 46);
            return (
              <g>
                {Array.from({ length: n as number }, (_, c) => (
                  <rect x={L.barX + c * L.unit} y={y} width={L.unit - 2} height="14" class={cls as string} style="stroke-width: 1" />
                ))}
                <text class="f-small" x={L.wide ? L.labelX : L.barX} y={L.wide ? y + 11 : y - 6}>{label}</text>
              </g>
            );
          })}
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
