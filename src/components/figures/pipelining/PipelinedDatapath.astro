---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Op from '../seqflow/Op.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Stage delays of the note's worked example (ps). The single-cycle clock is their sum, the critical path of lw;
// the pipelined clock is the slowest stage plus 30 ps for the pipeline register.
const delay = { IF: 250, ID: 150, EX: 200, MEM: 250, WB: 100 };
const single = Object.values(delay).reduce((a, b) => a + b, 0);
const tc = Math.max(...Object.values(delay)) + 30;
if (single !== 950 || tc !== 280) throw new Error(`clock ${single} / ${tc}`);

const t = ru
  ? { regs: 'регистры', imm: 'imm', immSub: 'расширение', imem: 'память', imemSub: 'команд', dmem: 'память', dmemSub: 'данных',
      alu: 'АЛУ', fwd: 'MUX', haz: 'конфликты', next: 'next PC', mux: 'MUX', target: 'адрес перехода', stall: 'простой', wb: 'запись',
      clock: [`такт без конвейера: ${single} пс`, `такт с конвейером: ${tc} пс`],
      steps: ['IF: команда читается из памяти команд по адресу из PC; следующий PC — PC + 4, если переход не выполняется',
        'ID: команда декодируется, читаются два регистра, константа знаково расширяется до 32 бит',
        'EX: АЛУ вычисляет результат, адрес или сравнение для перехода; выполняемый переход отправляет свой адрес обратно в PC',
        'MEM: lw читает, а sw пишет память данных; остальные команды передают результат АЛУ дальше',
        'WB: мультиплексор выбирает загруженное слово или результат АЛУ и записывает его в регистр',
        'пробрасывание и блок конфликтов: результаты из EX/MEM и MEM/WB возвращаются на входы АЛУ; при конфликте «загрузка — использование» блок замораживает PC и IF/ID'] }
  : { regs: 'registers', imm: 'imm', immSub: 'extend', imem: 'instruction', imemSub: 'memory', dmem: 'data', dmemSub: 'memory',
      alu: 'ALU', fwd: 'mux', haz: 'hazard unit', next: 'next PC', mux: 'mux', target: 'branch target', stall: 'stall', wb: 'write back',
      clock: [`single-cycle clock: ${single} ps`, `pipelined clock: ${tc} ps`],
      steps: ['IF: the PC fetches an instruction from instruction memory; the next PC is PC + 4 unless a branch is taken',
        'ID: the instruction is decoded, two registers are read, the immediate is sign-extended to 32 bits',
        'EX: the ALU computes a result, an address or a branch comparison; a taken branch sends its target back to the PC',
        'MEM: lw reads and sw writes data memory; other instructions pass by',
        'WB: a multiplexer picks the loaded value or the ALU result and writes it into a register',
        'forwarding and the hazard unit: results in EX/MEM and MEM/WB go back to the ALU inputs; on a load-use hazard the unit freezes the PC and IF/ID'] };
const stages = ['IF', 'ID', 'EX', 'MEM', 'WB'] as const;
const id = 'pipelined-datapath';

// Wide layout: stages left to right, pipeline registers as vertical bars.
const bars = [178, 330, 500, 636];
const centres = [96, 254, 413, 568, 700];
// Narrow layout: stages top to bottom, pipeline registers as horizontal bars.
const nBars = [112, 236, 360, 456];
const nTops = [36, 128, 252, 376, 472];
---

<Figure
  id={id}
  title={ru ? 'Конвейерный тракт данных: пять стадий, регистры между ними, пробрасывание' : 'The pipelined datapath: five stages, the registers between them, forwarding'}
  caption={ru
    ? `Синие блоки хранят состояние (PC, память команд и данных, регистровый файл, четыре регистра конвейера IF/ID, ID/EX, EX/MEM, MEM/WB); серые — комбинационная логика; жёлтым показаны пробрасывание и блок конфликтов; красная линия — запись результата обратно в регистровый файл, пунктир — адрес выполненного перехода. Числа под стадиями — задержки из разобранного примера: однотактный процессор проходит их все за один такт (${single} пс, путь lw), конвейерный — по одной стадии за такт (${tc} пс: самая медленная стадия плюс 30 пс на регистр конвейера).`
    : `Blue blocks hold state (the PC, instruction and data memory, the register file and the four pipeline registers IF/ID, ID/EX, EX/MEM, MEM/WB); grey blocks are combinational logic; amber is forwarding and the hazard unit; the red line writes a result back into the register file, and the dashed line carries the target of a taken branch. The numbers under the stages are the delays of the worked example: a single-cycle processor goes through all of them in one cycle (${single} ps, the path of lw), a pipelined one through one stage per cycle (${tc} ps: the slowest stage plus 30 ps for the pipeline register).`}
>
  <svg class="fig-wide" viewBox="0 0 760 348" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{ru ? 'Пятистадийный конвейерный тракт данных RISC-V' : 'The five-stage pipelined RISC-V datapath'}</title>
    <desc id={`${id}-w-d`}>{ru
      ? 'Слева направо: PC и память команд (IF), регистровый файл и расширение константы (ID), мультиплексоры операндов и АЛУ (EX), память данных (MEM), мультиплексор записи (WB). Между стадиями — вертикальные регистры конвейера. Пути пробрасывания идут из EX/MEM и MEM/WB назад к мультиплексорам перед АЛУ, линия записи — из WB назад в регистровый файл, адрес перехода — из EX назад к PC. Блок конфликтов над регистровым файлом может заморозить PC.'
      : 'Left to right: the PC and instruction memory (IF), the register file and immediate extension (ID), operand multiplexers and the ALU (EX), data memory (MEM), the write-back multiplexer (WB). Vertical pipeline registers separate the stages. Forwarding paths run from EX/MEM and MEM/WB back to the multiplexers in front of the ALU, the write-back line from WB back to the register file, and the branch target from EX back to the PC. A hazard unit above the register file can freeze the PC.'}</desc>

    {stages.map((s, k) => <text class="f-label" x={centres[k]} y="20" text-anchor="middle" style="font-weight: 650">{s}</text>)}
    {stages.map((s, k) => <text class="f-small f-t-muted" x={centres[k]} y="338" text-anchor="middle">{delay[s]} {ru ? 'пс' : 'ps'}</text>)}
    {bars.map((x) => <rect x={x} y="56" width="10" height="250" rx="2" class="f-fill-blue f-blue" style="stroke-width: 1.2" />)}

    <g data-s="1">
      <Op x={41} y={84} sym={t.next} />
      <Arrow pts={[[41, 97], [41, 126]]} />
      <Box x={22} y={128} w={38} h={44} label="PC" tone="h" />
      <Arrow pts={[[60, 150], [70, 150]]} />
      <Box x={72} y={110} w={98} h={80} label={t.imem} sub={t.imemSub} tone="h" />
      <Arrow pts={[[170, 150], [176, 150]]} />
      <Badge x={centres[0] - 24} y={15} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[188, 150], [196, 150]]} />
      <Arrow pts={[[192, 150], [192, 234], [196, 234]]} />
      <Box x={198} y={106} w={116} h={88} label={t.regs} tone="h" />
      <Box x={198} y={216} w={84} h={36} label={t.imm} sub={t.immSub} tone="n" subGap={13} />
      <Arrow pts={[[314, 128], [328, 128]]} />
      <Arrow pts={[[314, 160], [328, 160]]} />
      <Arrow pts={[[282, 234], [322, 234], [322, 186], [328, 186]]} />
      <Badge x={centres[1] - 24} y={15} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[340, 128], [348, 128]]} />
      <Arrow pts={[[340, 160], [348, 160]]} />
      <Arrow pts={[[340, 186], [348, 186]]} />
      <Box x={350} y={106} w={40} h={88} label={t.fwd} tone="g" />
      <Arrow pts={[[390, 132], [418, 132]]} />
      <Arrow pts={[[390, 168], [418, 168]]} />
      <Box x={420} y={106} w={56} h={88} label={t.alu} tone="n" />
      <Arrow pts={[[476, 150], [498, 150]]} />
      <Arrow pts={[[448, 106], [448, 40], [41, 40], [41, 69]]} dashed tone="muted" />
      <text class="f-small f-t-muted f-halo" x="404" y="34" text-anchor="end">{t.target}</text>
      <Badge x={centres[2] - 24} y={15} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[510, 150], [518, 150]]} />
      <Box x={520} y={110} w={96} h={80} label={t.dmem} sub={t.dmemSub} tone="h" />
      <Arrow pts={[[616, 150], [634, 150]]} />
      <Arrow pts={[[510, 212], [634, 212]]} />
      <Badge x={centres[3] - 30} y={15} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[646, 150], [666, 150]]} />
      <Arrow pts={[[646, 212], [686, 212], [686, 165]]} />
      <Op x={686} y={150} sym={t.mux} />
      <Arrow pts={[[705, 150], [740, 150], [740, 290], [300, 290], [300, 196]]} tone="red" bold />
      <text class="f-small f-t-red f-halo" x="720" y="282" text-anchor="end">{t.wb}</text>
      <Badge x={centres[4] - 26} y={15} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[514, 212], [514, 262], [380, 262], [380, 197]]} tone="amber" bold />
      <Arrow pts={[[364, 290], [364, 197]]} tone="amber" bold />
      <text class="f-small f-t-amber f-halo" x="392" y="256">EX/MEM</text>
      <text class="f-small f-t-amber f-halo" x="370" y="283">MEM/WB</text>
      <Box x={198} y={50} w={116} h={32} label={t.haz} tone="g" />
      <Arrow pts={[[198, 66], [120, 66], [120, 84], [77, 84]]} tone="amber" dashed />
      <text class="f-small f-t-amber f-halo" x="166" y="60" text-anchor="end">{t.stall}</text>
      <Badge x={462} y={250} n={6} />
    </g>
  </svg>

  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 586" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{ru ? 'Пятистадийный конвейерный тракт данных RISC-V' : 'The five-stage pipelined RISC-V datapath'}</title>
    <desc id={`${id}-n-d`}>{ru
      ? 'Сверху вниз: PC и память команд (IF), регистровый файл и константа (ID), мультиплексор операндов и АЛУ (EX), память данных (MEM), мультиплексор записи (WB), между ними горизонтальные регистры конвейера. Справа пути пробрасывания из EX/MEM и MEM/WB поднимаются к мультиплексору перед АЛУ; слева линия записи поднимается к регистровому файлу.'
      : 'Top to bottom: the PC and instruction memory (IF), the register file and immediate (ID), the operand multiplexer and the ALU (EX), data memory (MEM), the write-back multiplexer (WB), with horizontal pipeline registers between them. On the right, forwarding paths from EX/MEM and MEM/WB rise to the multiplexer in front of the ALU; on the left, the write-back line rises to the register file.'}</desc>

    {stages.map((s, k) => <text class="f-label" x="306" y={nTops[k] + 26} style="font-weight: 650">{s}</text>)}
    {stages.map((s, k) => <text class="f-small f-t-muted" x="306" y={nTops[k] + 46}>{delay[s]} {ru ? 'пс' : 'ps'}</text>)}
    {nBars.map((y) => <rect x="40" y={y} width="236" height="9" rx="2" class="f-fill-blue f-blue" style="stroke-width: 1.2" />)}

    <g data-s="1">
      <Box x={56} y={nTops[0] + 6} w={52} h={46} label="PC" tone="h" />
      <Arrow pts={[[108, nTops[0] + 29], [128, nTops[0] + 29]]} />
      <Box x={130} y={nTops[0]} w={130} h={58} label={t.imem} sub={t.imemSub} tone="h" />
      <Arrow pts={[[195, nTops[0] + 58], [195, nBars[0] - 2]]} />
      <Badge x={14} y={nTops[0] + 29} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[150, nBars[0] + 9], [150, nTops[1] + 14]]} />
      <Box x={56} y={nTops[1] + 16} w={150} h={50} label={t.regs} tone="h" />
      <Box x={214} y={nTops[1] + 16} w={62} h={50} label={t.imm} tone="n" />
      <Arrow pts={[[110, nTops[1] + 66], [110, nBars[1] - 2]]} />
      <Arrow pts={[[245, nTops[1] + 66], [245, nBars[1] - 2]]} />
      <Badge x={14} y={nTops[1] + 41} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[110, nBars[1] + 9], [110, nTops[2] + 12]]} />
      <Arrow pts={[[245, nBars[1] + 9], [245, nTops[2] + 12]]} />
      <Box x={56} y={nTops[2] + 14} w={220} h={30} label={t.fwd} tone="g" />
      <Arrow pts={[[166, nTops[2] + 44], [166, nTops[2] + 56]]} />
      <Box x={120} y={nTops[2] + 58} w={92} h={40} label={t.alu} tone="n" />
      <Arrow pts={[[166, nTops[2] + 98], [166, nBars[2] - 2]]} />
      <Badge x={14} y={nTops[2] + 50} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[166, nBars[2] + 9], [166, nTops[3] + 10]]} />
      <Box x={110} y={nTops[3] + 12} w={112} h={48} label={t.dmem} sub={t.dmemSub} tone="h" />
      <Arrow pts={[[166, nTops[3] + 60], [166, nBars[3] - 2]]} />
      <Badge x={14} y={nTops[3] + 36} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[166, nBars[3] + 9], [166, nTops[4] + 14]]} />
      <Op x={166} y={nTops[4] + 28} sym={t.mux} />
      <Arrow pts={[[147, nTops[4] + 28], [34, nTops[4] + 28], [34, nTops[1] + 41], [54, nTops[1] + 41]]} tone="red" bold />
      <Badge x={14} y={nTops[4] + 28} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[276, nBars[2] + 4], [286, nBars[2] + 4], [286, nTops[2] + 34], [278, nTops[2] + 34]]} tone="amber" bold />
      <Arrow pts={[[276, nBars[3] + 4], [298, nBars[3] + 4], [298, nTops[2] + 22], [278, nTops[2] + 22]]} tone="amber" bold />
      <Badge x={320} y={nTops[2] + 80} n={6} />
    </g>
    {t.clock.map((line, k) => <text class="f-small f-t-muted" x="14" y={556 + k * 18}>{line}</text>)}
  </svg>
  <Stepper steps={t.steps} />
</Figure>
