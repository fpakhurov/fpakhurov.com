---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The loop branch of the worked example: taken 9 times, then not taken once, and the loop is run 100 times.
const pattern = Array.from({ length: 100 }, () => [...Array(9).fill(true), false]).flat();
const run = (predict: (s: number) => boolean, update: (s: number, t: boolean) => number, s0: number) => {
  let s = s0, hits = 0;
  for (const taken of pattern) { hits += Number(predict(s) === taken); s = update(s, taken); }
  return hits / pattern.length;
};
const twoBit = run((s) => s >= 2, (s, t) => (t ? Math.min(s + 1, 3) : Math.max(s - 1, 0)), 2);
const oneBit = run((s) => s === 1, (_, t) => Number(t), 0);
if (twoBit !== 0.9 || oneBit !== 0.8) throw new Error(`predictor accuracies ${twoBit}, ${oneBit}`);

const names = ru
  ? ['сильно: нет перехода', 'слабо: нет перехода', 'слабо: переход', 'сильно: переход']
  : ['strongly not taken', 'weakly not taken', 'weakly taken', 'strongly taken'];
const codes = ['00', '01', '10', '11'];
const tones = ['n', 'n', 'h', 'h'] as const;
const t = ru
  ? { notTaken: 'предсказание: нет перехода', taken: 'предсказание: переход', nt: ['предсказание:', 'нет перехода'], tk: ['предсказание:', 'переход'] }
  : { notTaken: 'predict not taken', taken: 'predict taken', nt: ['predict', 'not taken'], tk: ['predict', 'taken'] };
const T = ru ? 'П' : 'T', N = ru ? 'Н' : 'N';

const W = 760, bw = 150, bh = 54, by = 74, xs = [24, 216, 408, 600];
const nx = 150, nw = 190, nh = 50, ys = [40, 130, 220, 310];
const id = 'two-bit-predictor';
---

<Figure
  id={id}
  title={ru ? 'Двухбитный насыщающийся счётчик: одна неожиданность не меняет предсказание' : 'A two-bit saturating counter: one surprise does not flip the prediction'}
  caption={ru
    ? `Четыре состояния счётчика одного перехода. Выполненный переход (${T}) сдвигает состояние вправо, невыполненный (${N}) — влево; в крайних состояниях счётчик насыщается. Старший бит — предсказание. Для перехода в конце цикла из 10 итераций счётчик стоит в 11; выход из цикла даёт одну ошибку и переводит его в 10, где предсказание всё ещё «переход», так что первая итерация следующего запуска цикла предсказана верно: ${Math.round(twoBit * 100)}% верных предсказаний против ${Math.round(oneBit * 100)}% у однобитной схемы, которая ошибается дважды за запуск.`
    : `The four states of the counter of one branch. A taken branch (${T}) moves the state right, a not-taken branch (${N}) moves it left; at both ends the counter saturates. The high bit is the prediction. For the branch at the bottom of a 10-iteration loop the counter sits in 11; the loop exit is one misprediction and moves it to 10, which still predicts taken, so the first iteration of the next run of the loop is predicted correctly: ${Math.round(twoBit * 100)} % correct predictions against ${Math.round(oneBit * 100)} % for a one-bit scheme, which is wrong twice per run.`}
>
  <svg class="fig-wide" viewBox={`0 0 ${W} 186`} role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{ru ? 'Диаграмма состояний двухбитного предсказателя' : 'State diagram of a two-bit predictor'}</title>
    <desc id={`${id}-w-d`}>{ru
      ? 'Четыре блока в ряд: 00 — сильно: нет перехода, 01 — слабо: нет перехода, 10 — слабо: переход, 11 — сильно: переход. Стрелки П ведут вправо, стрелки Н влево; петля П на 11 и петля Н на 00. Под первыми двумя блоками подпись «предсказание: нет перехода», под последними двумя — «предсказание: переход».'
      : 'Four boxes in a row: 00 strongly not taken, 01 weakly not taken, 10 weakly taken, 11 strongly taken. Arrows labelled T lead right, arrows labelled N lead left; a T loop on 11 and an N loop on 00. Under the first two boxes the label predict not taken, under the last two predict taken.'}</desc>
    {xs.map((x, k) => <Box x={x} y={by} w={bw} h={bh} label={codes[k]} sub={names[k]} tone={tones[k]} />)}
    {[0, 1, 2].map((k) => (
      <g>
        <Arrow pts={[[xs[k] + bw + 2, by + 16], [xs[k + 1] - 3, by + 16]]} tone="green" label={T} at={[(xs[k] + bw + xs[k + 1]) / 2, by + 9]} anchor="middle" labelTone="x" />
        <Arrow pts={[[xs[k + 1] - 2, by + 40], [xs[k] + bw + 3, by + 40]]} tone="red" label={N} at={[(xs[k] + bw + xs[k + 1]) / 2, by + 58]} anchor="middle" labelTone="y" />
      </g>
    ))}
    <path class="f-line f-red" d={`M ${xs[0] + 50} ${by - 1} C ${xs[0] + 50} ${by - 42}, ${xs[0] + 100} ${by - 42}, ${xs[0] + 100} ${by - 4}`} marker-end="url(#f-arrow-red)" />
    <text class="f-small f-t-red" x={xs[0] + 75} y={by - 36} text-anchor="middle">{N}</text>
    <path class="f-line f-green" d={`M ${xs[3] + 50} ${by - 1} C ${xs[3] + 50} ${by - 42}, ${xs[3] + 100} ${by - 42}, ${xs[3] + 100} ${by - 4}`} marker-end="url(#f-arrow-green)" />
    <text class="f-small f-t-green" x={xs[3] + 75} y={by - 36} text-anchor="middle">{T}</text>
    <path class="f-thin f-muted" d={`M ${xs[0]} ${by + bh + 22} H ${xs[1] + bw}`} />
    <path class="f-thin f-muted" d={`M ${xs[2]} ${by + bh + 22} H ${xs[3] + bw}`} />
    <text class="f-small f-t-muted" x={(xs[0] + xs[1] + bw) / 2} y={by + bh + 42} text-anchor="middle">{t.notTaken}</text>
    <text class="f-small f-t-blue" x={(xs[2] + xs[3] + bw) / 2} y={by + bh + 42} text-anchor="middle">{t.taken}</text>
  </svg>

  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 412" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{ru ? 'Диаграмма состояний двухбитного предсказателя' : 'State diagram of a two-bit predictor'}</title>
    <desc id={`${id}-n-d`}>{ru
      ? 'Четыре блока в столбец: 00, 01, 10, 11. Стрелки П ведут вниз, стрелки Н вверх; петля Н на 00 и петля П на 11. Слева подписи: первые два блока предсказывают «нет перехода», последние два — «переход».'
      : 'Four boxes in a column: 00, 01, 10, 11. Arrows labelled T lead down, arrows labelled N lead up; an N loop on 00 and a T loop on 11. Labels on the left: the first two boxes predict not taken, the last two predict taken.'}</desc>
    {ys.map((y, k) => <Box x={nx} y={y} w={nw} h={nh} label={codes[k]} sub={names[k]} tone={tones[k]} subGap={17} />)}
    {[0, 1, 2].map((k) => (
      <g>
        <Arrow pts={[[nx + 140, ys[k] + nh + 2], [nx + 140, ys[k + 1] - 3]]} tone="green" label={T} at={[nx + 152, (ys[k] + nh + ys[k + 1]) / 2 + 5]} labelTone="x" />
        <Arrow pts={[[nx + 50, ys[k + 1] - 2], [nx + 50, ys[k] + nh + 3]]} tone="red" label={N} at={[nx + 38, (ys[k] + nh + ys[k + 1]) / 2 + 5]} anchor="end" labelTone="y" />
      </g>
    ))}
    <path class="f-line f-red" d={`M ${nx + 70} ${ys[0] - 1} C ${nx + 70} ${ys[0] - 32}, ${nx + 120} ${ys[0] - 32}, ${nx + 120} ${ys[0] - 4}`} marker-end="url(#f-arrow-red)" />
    <text class="f-small f-t-red" x={nx + 132} y={ys[0] - 18}>{N}</text>
    <path class="f-line f-green" d={`M ${nx + 70} ${ys[3] + nh + 1} C ${nx + 70} ${ys[3] + nh + 32}, ${nx + 120} ${ys[3] + nh + 32}, ${nx + 120} ${ys[3] + nh + 4}`} marker-end="url(#f-arrow-green)" />
    <text class="f-small f-t-green" x={nx + 132} y={ys[3] + nh + 26}>{T}</text>
    <path class="f-thin f-muted" d={`M ${nx - 12} ${ys[0]} V ${ys[1] + nh}`} />
    <path class="f-thin f-muted" d={`M ${nx - 12} ${ys[2]} V ${ys[3] + nh}`} />
    {t.nt.map((line, k) => <text class="f-small f-t-muted" x={nx - 20} y={(ys[0] + ys[1] + nh) / 2 - 4 + k * 18} text-anchor="end">{line}</text>)}
    {t.tk.map((line, k) => <text class="f-small f-t-blue" x={nx - 20} y={(ys[2] + ys[3] + nh) / 2 - 4 + k * 18} text-anchor="end">{line}</text>)}
  </svg>
</Figure>
