---
import Figure from '../Figure.astro';
import { N, original, shifted, blurred, errShift, errBlur, mseShift, mseBlur } from './lpips-math';

// Pixel grid: grey levels drawn as ink with opacity v (0 = paper, 1 = ink), errors in red.
// Errors use a square-root ramp so the blur's uniform 0.0625 stays visible next to the shift's 1.
const grid = (x0: number, y0: number, cs: number, values: number[][], colour: 'ink' | 'red') =>
  values.flatMap((row, i) =>
    row.map((v, j) => ({
      x: x0 + j * cs,
      y: y0 + i * cs,
      cs,
      style: `fill: var(${colour === 'ink' ? '--ink' : '--fig-red'}); fill-opacity: ${(colour === 'ink' ? 0.9 * v : 0.85 * Math.sqrt(v)).toFixed(3)}`,
    })),
  );

const ratio = mseShift / mseBlur;
const fmt = (v: number) => (Number.isInteger(v * 100) ? v.toFixed(2) : v.toFixed(4));

// Wide layout (680 × 430): shifted | original | blurred, error maps underneath.
const cs = 14;
const S = N * cs; // 112
const colW = { shift: 54, orig: 284, blur: 514 };
const yImg = 52;
const yErr = 236;
const gW = {
  shift: grid(colW.shift, yImg, cs, shifted, 'ink'),
  orig: grid(colW.orig, yImg, cs, original, 'ink'),
  blur: grid(colW.blur, yImg, cs, blurred, 'ink'),
  eShift: grid(colW.shift, yErr, cs, errShift, 'red'),
  eBlur: grid(colW.blur, yErr, cs, errBlur, 'red'),
};

// Narrow layout (360 × 700): original on top, then one row per copy: image and error map.
const csN = 11;
const SN = N * csN; // 88
const xImgN = 56;
const xErrN = 216;
const yOrigN = 40;
const yShiftN = 230;
const yBlurN = 450;
const gN = {
  orig: grid(136, yOrigN, csN, original, 'ink'),
  shift: grid(xImgN, yShiftN, csN, shifted, 'ink'),
  eShift: grid(xErrN, yShiftN, csN, errShift, 'red'),
  blur: grid(xImgN, yBlurN, csN, blurred, 'ink'),
  eBlur: grid(xErrN, yBlurN, csN, errBlur, 'red'),
};

// Legend ramp for the squared error (0 … 1), evenly spaced on the square-root scale.
const ramp = [0, 0.0625, 0.25, 0.5625, 1];
---

<Figure
  id="lpips-shift-blur"
  title="Pixel MSE punishes a shift and forgives a blur"
  caption={`An 8 × 8 image of vertical stripes (period 4 pixels). Shifting it right by one pixel (wrapping around) leaves the picture looking the same, but half of the pixels flip, so MSE = ${fmt(mseShift)}. Blurring it with the kernel [1 2 1]/4 (also wrapping around) visibly washes out the stripes, yet every pixel moves by only 0.25, so MSE = ${fmt(mseBlur)}: pixel MSE calls the blurred copy ${ratio.toFixed(0)} times closer. The error maps use a square-root colour scale so that the small errors stay visible.`}
  origin="illustrative"
>
  <svg class="fig-wide" viewBox="0 0 680 440" role="img" aria-labelledby="lpips-shift-blur-w-t lpips-shift-blur-w-d">
    <title id="lpips-shift-blur-w-t">Shifted versus blurred stripes under pixel MSE</title>
    <desc id="lpips-shift-blur-w-d">{`In the middle, an 8 by 8 pixel image of vertical stripes, two columns of value 0 then two columns of value 1, repeated. On the left, the same image shifted right by one pixel: it looks the same, but its squared-error map against the original has half of the pixels at error 1, so the pixel MSE is ${fmt(mseShift)}, large. On the right, the image blurred with kernel 1 2 1 over 4: it looks worse, with grey values 0.25 and 0.75, but every pixel has squared error 0.0625, so the pixel MSE is ${fmt(mseBlur)}, small. Pixel MSE therefore ranks the blurred copy ${ratio.toFixed(0)} times closer.`}</desc>

    <text class="f-label" x={colW.shift + S / 2} y="36" text-anchor="middle">shifted copy</text>
    <text class="f-title" x={colW.orig + S / 2} y="36" text-anchor="middle">original x</text>
    <text class="f-label" x={colW.blur + S / 2} y="36" text-anchor="middle">blurred copy</text>

    {[gW.shift, gW.orig, gW.blur, gW.eShift, gW.eBlur].map((g) => g.map((c) => <rect x={c.x} y={c.y} width={c.cs} height={c.cs} style={c.style} />))}
    {[
      [colW.shift, yImg],
      [colW.orig, yImg],
      [colW.blur, yImg],
      [colW.shift, yErr],
      [colW.blur, yErr],
    ].map(([x, y]) => (
      <>
        {Array.from({ length: N - 1 }, (_, k) => (
          <path class="f-grid" d={`M ${x + (k + 1) * cs} ${y} V ${y + S} M ${x} ${y + (k + 1) * cs} H ${x + S}`} />
        ))}
        <rect class="f-thin" x={x} y={y} width={S} height={S} style="fill: none" />
      </>
    ))}

    <!-- operations -->
    <path class="f-line" d={`M ${colW.orig - 8} ${yImg + S / 2} H ${colW.shift + S + 10}`} marker-end="url(#f-arrow)" />
    <text class="f-note" x={(colW.shift + S + colW.orig) / 2} y={yImg + S / 2 - 10} text-anchor="middle">shift right 1 px</text>
    <path class="f-line" d={`M ${colW.orig + S + 8} ${yImg + S / 2} H ${colW.blur - 10}`} marker-end="url(#f-arrow)" />
    <text class="f-note" x={(colW.orig + S + colW.blur) / 2} y={yImg + S / 2 - 10} text-anchor="middle">blur [1 2 1]/4</text>

    <!-- human verdict -->
    <text class="f-label f-t-green" x={colW.shift + S / 2} y={yImg + S + 24} text-anchor="middle">looks the same</text>
    <text class="f-label f-t-red" x={colW.blur + S / 2} y={yImg + S + 24} text-anchor="middle">looks worse</text>

    <!-- error maps -->
    <text class="f-note" x={colW.shift + S / 2} y={yErr - 12} text-anchor="middle">squared error (x − x′)²</text>
    <text class="f-note" x={colW.blur + S / 2} y={yErr - 12} text-anchor="middle">squared error (x − x′)²</text>
    <text class="f-title" x={colW.shift + S / 2} y={yErr + S + 26} text-anchor="middle">MSE = {fmt(mseShift)}</text>
    <text class="f-note" x={colW.shift + S / 2} y={yErr + S + 45} text-anchor="middle">large: half the pixels flip</text>
    <text class="f-title" x={colW.blur + S / 2} y={yErr + S + 26} text-anchor="middle">MSE = {fmt(mseBlur)}</text>
    <text class="f-note" x={colW.blur + S / 2} y={yErr + S + 45} text-anchor="middle">small: each pixel off by 0.25</text>

    <!-- legend for the error colour -->
    <text class="f-note" x={colW.orig + S / 2} y={yErr + 16} text-anchor="middle">error scale (√)</text>
    {ramp.map((v, k) => (
      <>
        <rect x={colW.orig + 6 + k * 20} y={yErr + 28} width="20" height="16" style={`fill: var(--fig-red); fill-opacity: ${(0.85 * Math.sqrt(v)).toFixed(3)}`} />
        <rect class="f-grid" x={colW.orig + 6 + k * 20} y={yErr + 28} width="20" height="16" style="fill: none" />
      </>
    ))}
    <text class="f-small f-t-muted" x={colW.orig + 16} y={yErr + 62} text-anchor="middle">0</text>
    <text class="f-small f-t-muted" x={colW.orig + 96} y={yErr + 62} text-anchor="middle">1</text>

    <text class="f-label f-t-red" x={colW.orig + S / 2} y={yErr + 102} text-anchor="middle">pixel MSE: blur is</text>
    <text class="f-label f-t-red" x={colW.orig + S / 2} y={yErr + 121} text-anchor="middle">{ratio.toFixed(0)}× “closer”</text>
    <text class="f-note" x={colW.orig + S / 2} y={yErr + 196} text-anchor="middle">a perceptual metric should rank them the other way</text>
  </svg>

  <svg class="fig-narrow" viewBox="0 0 360 680" role="img" aria-labelledby="lpips-shift-blur-n-t lpips-shift-blur-n-d">
    <title id="lpips-shift-blur-n-t">Shifted versus blurred stripes under pixel MSE (stacked)</title>
    <desc id="lpips-shift-blur-n-d">{`At the top, an 8 by 8 pixel image of vertical stripes. Below it, the image shifted right by one pixel next to its squared-error map: it looks the same but half the pixels have error 1, MSE ${fmt(mseShift)}. At the bottom, the blurred image next to its error map: it looks worse but every pixel has error 0.0625, MSE ${fmt(mseBlur)}. Pixel MSE ranks the blurred copy ${ratio.toFixed(0)} times closer.`}</desc>

    <text class="f-title" x="180" y="28" text-anchor="middle">original x</text>
    {[gN.orig, gN.shift, gN.eShift, gN.blur, gN.eBlur].map((g) => g.map((c) => <rect x={c.x} y={c.y} width={c.cs} height={c.cs} style={c.style} />))}
    {[
      [136, yOrigN],
      [xImgN, yShiftN],
      [xErrN, yShiftN],
      [xImgN, yBlurN],
      [xErrN, yBlurN],
    ].map(([x, y]) => (
      <>
        {Array.from({ length: N - 1 }, (_, k) => (
          <path class="f-grid" d={`M ${x + (k + 1) * csN} ${y} V ${y + SN} M ${x} ${y + (k + 1) * csN} H ${x + SN}`} />
        ))}
        <rect class="f-thin" x={x} y={y} width={SN} height={SN} style="fill: none" />
      </>
    ))}

    <path class="f-line" d={`M 150 ${yOrigN + SN + 6} Q ${xImgN + SN / 2} ${yOrigN + SN + 24} ${xImgN + SN / 2} ${yShiftN - 34}`} marker-end="url(#f-arrow)" />
    <text class="f-note" x="114" y={yOrigN + SN + 40}>shift right 1 px</text>
    <path class="f-line" d={`M 128 ${yOrigN + SN / 2} H 26 V ${yBlurN + SN / 2} H ${xImgN - 6}`} marker-end="url(#f-arrow)" />
    <text class="f-note" transform={`translate(18 ${(yOrigN + SN / 2 + yBlurN + SN / 2) / 2}) rotate(-90)`} text-anchor="middle">blur [1 2 1]/4</text>

    <text class="f-label" x={xImgN + SN / 2} y={yShiftN - 12} text-anchor="middle">shifted copy</text>
    <text class="f-note" x={xErrN + SN / 2} y={yShiftN - 12} text-anchor="middle">(x − x′)²</text>
    <path class="f-thin f-muted" d={`M ${xImgN + SN + 10} ${yShiftN + SN / 2} H ${xErrN - 10}`} marker-end="url(#f-arrow-muted)" />
    <text class="f-label f-t-green" x={xImgN + SN / 2} y={yShiftN + SN + 22} text-anchor="middle">looks the same</text>
    <text class="f-title" x={xErrN + SN / 2} y={yShiftN + SN + 22} text-anchor="middle">MSE = {fmt(mseShift)}</text>
    <text class="f-note" x={xErrN + SN / 2} y={yShiftN + SN + 40} text-anchor="middle">large</text>

    <text class="f-label" x={xImgN + SN / 2} y={yBlurN - 12} text-anchor="middle">blurred copy</text>
    <text class="f-note" x={xErrN + SN / 2} y={yBlurN - 12} text-anchor="middle">(x − x′)²</text>
    <path class="f-thin f-muted" d={`M ${xImgN + SN + 10} ${yBlurN + SN / 2} H ${xErrN - 10}`} marker-end="url(#f-arrow-muted)" />
    <text class="f-label f-t-red" x={xImgN + SN / 2} y={yBlurN + SN + 22} text-anchor="middle">looks worse</text>
    <text class="f-title" x={xErrN + SN / 2} y={yBlurN + SN + 22} text-anchor="middle">MSE = {fmt(mseBlur)}</text>
    <text class="f-note" x={xErrN + SN / 2} y={yBlurN + SN + 40} text-anchor="middle">small: 0.0625 everywhere</text>

    <text class="f-label f-t-red" x="180" y="660" text-anchor="middle">pixel MSE: blur is {ratio.toFixed(0)}× “closer”</text>
  </svg>
</Figure>
