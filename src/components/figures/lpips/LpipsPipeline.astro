---
import Figure from '../Figure.astro';
import { polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A small picture glyph (frame, mountain, sun); `dx` shifts the scene to make x' slightly different.
const picture = (x: number, y: number, size: number, dx = 0) => {
  const m = (fx: number, fy: number): [number, number] => [x + fx * size + dx, y + fy * size];
  return {
    x,
    y,
    size,
    mountain: polyline([m(0.08, 0.86), m(0.36, 0.46), m(0.55, 0.7), m(0.7, 0.55), m(0.86, 0.86)]),
    sun: m(0.7, 0.28),
  };
};

const L = 5;
const subs = ['₁', '₂', '₃', '₄', '₅'];

// ---- Wide layout (680 × 380): two horizontal strips of layers, one comparison node per layer.
const cxW = [150, 220, 290, 360, 430];
const bandW = { h: [76, 64, 54, 44, 36], w: [20, 25, 30, 35, 40] };
const topY = 84;
const botY = 308;
const nodeY = 196;
const r = 18;
const imgX = picture(30, topY - 28, 56);
const imgY = picture(30, botY - 28, 56, 5);

// ---- Narrow layout (360 × 640): two vertical strips, nodes between them.
const yN = [150, 212, 274, 336, 398];
const bandN = { w: [96, 82, 70, 58, 48], h: [14, 17, 20, 23, 26] };
const leftN = 90;
const rightN = 270;
const imgXN = picture(leftN - 25, 34, 50);
const imgYN = picture(rightN - 25, 34, 50, 4);

// ---- "Inside each d_l": the chain of operations. Each line is a list of [text, subscript] pieces.
type Piece = [string, string?];
interface Step {
  lines: Piece[][];
  amber?: boolean;
}
const steps: Step[] = [
  { lines: [[['φ', 'l'], ['(x), φ', 'l'], ['(x′)']], [['C', 'l'], [' × H', 'l'], [' × W', 'l']]] },
  { lines: [[[(ru ? "нормировка" : "unit-normalise")]], [[(ru ? "по каналам" : "over channels")]]] },
  { lines: [[[(ru ? "вычитание" : "subtract")]], [['φ̂', 'l'], ['(x) − φ̂', 'l'], ['(x′)']]] },
  { lines: [[['⊙ w', 'l']], [[(ru ? "взвешивание" : "weigh channels")]]], amber: true },
  { lines: [[[(ru ? "квадрат ‖ · ‖²₂" : "square ‖ · ‖²₂")]], [[(ru ? "среднее по h, w" : "mean over (h, w)")]]] },
];
// φ and φ̂ in the serif italic of the note's math (the sans φ looks like Φ and misplaces the hat).
const phiStyle = 'font-family: var(--serif); font-style: italic; font-size: 14px';
const phiSplit = (t: string) => t.split(/(φ̂|φ)/).filter((part) => part !== '');
const isPhi = (part: string) => part === 'φ' || part === 'φ̂';
const boxW = 104;
const boxH = 50;
// Wide inset: one row.
const gapW = 18;
const insetY = 462;
const stepXW = steps.map((_, i) => 10 + i * (boxW + gapW));
const dlXW = stepXW[4] + boxW + 28 + r;
// Narrow inset: two rows of three slots (the sixth slot is the d_l node).
const gapN = 14;
const stepXN = [0, 1, 2, 0, 1].map((k) => 7 + k * (boxW + gapN));
const stepYN = [0, 0, 0, 1, 1].map((r) => 630 + r * 96);
const dlXN = 7 + 2 * (boxW + gapN) + boxW / 2;
---

<Figure
  id="lpips-pipeline"
  title={ru ? "Как LPIPS сравнивает два изображения" : "How LPIPS compares two images"}
  caption={ru ? "Оба изображения проходят через одну и ту же замороженную сеть. На каждом выбранном слое две карты признаков сравниваются (нормируются к единичной длине по каналам, вычитаются, взвешиваются обученными весами wₗ, возводятся в квадрат и усредняются по позициям), что даёт одно число dₗ на слой. LPIPS — сумма этих чисел. Размеры слоёв схематичны: у AlexNet пять слоёв имеют Cₗ = 64, 192, 384, 256 и 256 каналов, у VGG — 64, 128, 256, 512 и 512." : "Both images pass through the same frozen network. At every chosen layer the two feature maps are compared (unit-normalised over channels, subtracted, weighted by the learned wₗ, squared and averaged over positions), which gives one number dₗ per layer. LPIPS is the sum of these numbers. The layer sizes are schematic: for AlexNet the five layers have Cₗ = 64, 192, 384, 256 and 256 channels, for VGG 64, 128, 256, 512 and 512."}
>
  <svg class="fig-wide" viewBox="0 0 680 566" role="img" aria-labelledby="lpips-pipeline-w-t lpips-pipeline-w-d">
    <title id="lpips-pipeline-w-t">{ru ? "Схема вычисления LPIPS" : "LPIPS pipeline"}</title>
    <desc id="lpips-pipeline-w-d">{ru ? "Изображение x слева вверху и изображение x штрих слева внизу поступают каждое в копию одной и той же замороженной свёрточной сети, AlexNet или VGG, изображённой пятью слоями. Две копии имеют общие веса. С каждого слоя l карты признаков фи l для x и для x штрих идут в узел сравнения d l между двумя полосами. Узлы d1, d2, d3, d4 и d5 складываются, и сумма равна LPIPS от x и x штрих. Врезка внизу показывает шаги внутри каждого узла d l: карты признаков размера C l на H l на W l нормируются к единичной длине по каналам, вычитаются, поканально умножаются на веса w l, обученные на человеческих перцептивных суждениях, возводятся в квадрат и усредняются по позициям h, w, что даёт d l. Низкий LPIPS означает, что изображения выглядят похоже; высокий — что изображения различаются видимой структурой." : "Image x at the top left and image x prime at the bottom left each enter a copy of the same frozen convolutional network, AlexNet or VGG, drawn as five layers. The two copies share weights. From each layer l the feature maps phi l of x and of x prime go to a comparison node d l between the two strips. The nodes d1 plus d2 plus d3 plus d4 plus d5 are added, which equals LPIPS of x and x prime. An inset below shows the steps inside every node d l: the feature maps of size C l by H l by W l are unit-normalised over channels, subtracted, multiplied channel-wise by the weights w l, which are learned from human perceptual judgements, squared and averaged over positions h, w, giving d l. Low LPIPS means the images look similar; high means the images differ in visible structure."}</desc>

    <text class="f-note" x="290" y="16" text-anchor="middle">{ru ? "замороженная предобученная CNN (AlexNet / VGG), слои l = 1 … L" : "frozen pretrained CNN (AlexNet / VGG), layers l = 1 … L"}</text>

    <!-- images -->
    <text class="f-math f-t-red" x="18" y={topY + 6} text-anchor="middle">x</text>
    <rect class="f-box" x={imgX.x} y={imgX.y} width={imgX.size} height={imgX.size} rx="3" />
    <rect class="f-fill-red" x={imgX.x} y={imgX.y} width={imgX.size} height={imgX.size} rx="3" />
    <path class="f-thin f-red" d={imgX.mountain} />
    <circle class="f-thin f-red" cx={imgX.sun[0]} cy={imgX.sun[1]} r="5" />

    <text class="f-math f-t-blue" x="18" y={botY + 6} text-anchor="middle">x′</text>
    <rect class="f-box" x={imgY.x} y={imgY.y} width={imgY.size} height={imgY.size} rx="3" />
    <rect class="f-fill-blue" x={imgY.x} y={imgY.y} width={imgY.size} height={imgY.size} rx="3" />
    <path class="f-thin f-blue" d={imgY.mountain} />
    <circle class="f-thin f-blue" cx={imgY.sun[0]} cy={imgY.sun[1]} r="5" />

    <path class="f-line f-red" d={`M 90 ${topY} H ${cxW[0] - bandW.w[0] / 2 - 3}`} marker-end="url(#f-arrow-red)" />
    <path class="f-line f-blue" d={`M 90 ${botY} H ${cxW[0] - bandW.w[0] / 2 - 3}`} marker-end="url(#f-arrow-blue)" />

    <!-- shared weights -->
    <path class="f-thin f-muted f-dash" d={`M 58 ${topY + 34} V ${nodeY - 26}`} marker-start="url(#f-arrow-muted)" />
    <text class="f-note" x="58" y={nodeY - 4} text-anchor="middle">{ru ? "общие" : "shared"}</text>
    <text class="f-note" x="58" y={nodeY + 13} text-anchor="middle">{ru ? "веса" : "weights"}</text>
    <path class="f-thin f-muted f-dash" d={`M 58 ${nodeY + 24} V ${botY - 34}`} marker-end="url(#f-arrow-muted)" />

    <!-- layer strips -->
    {cxW.map((cx, i) => (
      <>
        <rect class="f-box-soft" x={cx - bandW.w[i] / 2} y={topY - bandW.h[i] / 2} width={bandW.w[i]} height={bandW.h[i]} rx="2" />
        <rect class="f-box-soft" x={cx - bandW.w[i] / 2} y={botY - bandW.h[i] / 2} width={bandW.w[i]} height={bandW.h[i]} rx="2" />
      </>
    ))}
    {cxW.slice(0, -1).map((cx, i) => (
      <>
        <path class="f-thin f-muted" d={`M ${cx + bandW.w[i] / 2 + 2} ${topY} H ${cxW[i + 1] - bandW.w[i + 1] / 2 - 2}`} marker-end="url(#f-arrow-muted)" />
        <path class="f-thin f-muted" d={`M ${cx + bandW.w[i] / 2 + 2} ${botY} H ${cxW[i + 1] - bandW.w[i + 1] / 2 - 2}`} marker-end="url(#f-arrow-muted)" />
      </>
    ))}
    <text class="f-small f-t-muted" x={cxW[0]} y={topY - bandW.h[0] / 2 - 8} text-anchor="middle">conv1</text>
    <text class="f-small f-t-muted" x={cxW[L - 1]} y={topY - bandW.h[L - 1] / 2 - 8} text-anchor="middle">conv5</text>
    <text class="f-small f-t-muted" x={cxW[0]} y={botY + bandW.h[0] / 2 + 18} text-anchor="middle">conv1</text>
    <text class="f-small f-t-muted" x={cxW[L - 1]} y={botY + bandW.h[L - 1] / 2 + 18} text-anchor="middle">conv5</text>
    <text class="f-note" x="290" y="392" text-anchor="middle">{ru ? 'карты признаков ' : 'feature maps '}<tspan style={phiStyle}>φ</tspan><tspan dy="4" font-size="12">l</tspan><tspan dy="-4">{ru ? ' размера C' : ' of size C'}</tspan><tspan dy="4" font-size="12">l</tspan><tspan dy="-4"> × H</tspan><tspan dy="4" font-size="12">l</tspan><tspan dy="-4"> × W</tspan><tspan dy="4" font-size="12">l</tspan><tspan dy="-4">{ru ? ' (чем глубже слой, тем грубее сетка)' : ' (deeper layers: coarser grids)'}</tspan></text>

    <!-- taps and comparison nodes -->
    {cxW.map((cx, i) => (
      <>
        <path class="f-thin f-red" d={`M ${cx} ${topY + bandW.h[i] / 2 + 3} V ${nodeY - r - 3}`} marker-end="url(#f-arrow-red)" />
        <path class="f-thin f-blue" d={`M ${cx} ${botY - bandW.h[i] / 2 - 3} V ${nodeY + r + 3}`} marker-end="url(#f-arrow-blue)" />
        <circle class="f-box" cx={cx} cy={nodeY} r={r} />
        <text class="f-math" x={cx} y={nodeY + 6} text-anchor="middle">d{subs[i]}</text>
      </>
    ))}
    {cxW.slice(0, -1).map((cx) => (
      <text class="f-title" x={cx + 35} y={nodeY + 5} text-anchor="middle">+</text>
    ))}
    <text class="f-small f-t-red" x={cxW[0] + 7} y={nodeY - 48}><tspan style={phiStyle}>φ</tspan>₁(x)</text>
    <text class="f-small f-t-blue" x={cxW[0] + 7} y={nodeY + 58}><tspan style={phiStyle}>φ</tspan>₁(x′)</text>

    <!-- sum = LPIPS -->
    <text class="f-title" x={cxW[L - 1] + r + 15} y={nodeY + 5} text-anchor="middle">=</text>
    <rect class="f-box" x="480" y={nodeY - 24} width="150" height="48" rx="6" />
    <text class="f-title" x="555" y={nodeY + 5} text-anchor="middle">LPIPS(x, x′)</text>
    <text class="f-note" x="555" y={nodeY + 50} text-anchor="middle">{ru ? "низкий → выглядят похоже" : "low → looks similar"}</text>
    <text class="f-note" x="555" y={nodeY + 68} text-anchor="middle">{ru ? "высокий → различается" : "high → different"}</text>
    <text class="f-note" x="555" y={nodeY + 86} text-anchor="middle">{ru ? "видимая структура" : "visible structure"}</text>

    <!-- sum label -->
    <text class="f-note" x="555" y={nodeY - 36} text-anchor="middle">{ru ? 'сумма по слоям Σ' : 'sum over layers Σ'}<tspan dy="4" font-size="11">l</tspan></text>

    <!-- what happens inside a node: explicit chain -->
    <rect class="f-thin f-muted f-dash" x="4" y={insetY - 46} width="672" height="142" rx="8" style="fill: none" />
    <text class="f-label" x="16" y={insetY - 20}>{ru ? 'внутри каждого узла d' : 'inside every node d'}<tspan dy="4" font-size="12">l</tspan><tspan dy="-4">:</tspan></text>
    {steps.map((st, i) => (
      <>
        <rect class={st.amber ? 'f-box-soft' : 'f-box'} x={stepXW[i]} y={insetY} width={boxW} height={boxH} rx="5" />
        {st.amber && <rect class="f-fill-amber" x={stepXW[i]} y={insetY} width={boxW} height={boxH} rx="5" />}
        {st.lines.map((line, j) => (
          <text class={j === 0 ? 'f-small' : 'f-small f-t-muted'} x={stepXW[i] + boxW / 2} y={insetY + 21 + j * 17} text-anchor="middle">
            {line.map(([t, sub]) => <>{phiSplit(t).map((part) => (isPhi(part) ? <tspan style={phiStyle}>{part}</tspan> : part))}{sub && <><tspan dy="3" font-size="10">{sub}</tspan><tspan dy="-3"></tspan></>}</>)}
          </text>
        ))}
        <path class="f-thin" d={`M ${stepXW[i] + boxW + 3} ${insetY + boxH / 2} H ${(i < 4 ? stepXW[i + 1] : dlXW - r) - 4}`} marker-end="url(#f-arrow)" />
      </>
    ))}
    <circle class="f-box" cx={dlXW} cy={insetY + boxH / 2} r={r} />
    <text class="f-math" x={dlXW} y={insetY + boxH / 2 + 6} text-anchor="middle">d<tspan dy="4" font-size="13">l</tspan></text>
    <text class="f-small f-t-amber" x={stepXW[3] + boxW / 2} y={insetY + boxH + 30} text-anchor="middle">{ru ? "обучены на человеческих перцептивных суждениях" : "learned from human perceptual judgements"}</text>
    <path class="f-thin f-amber" d={`M ${stepXW[3] + boxW / 2} ${insetY + boxH + 16} V ${insetY + boxH + 5}`} />
    <path d={`M ${stepXW[3] + boxW / 2} ${insetY + boxH + 2} l -4 7 h 8 z`} style="fill: var(--fig-amber)" />
  </svg>

  <svg class="fig-narrow" viewBox="0 0 360 824" role="img" aria-labelledby="lpips-pipeline-n-t lpips-pipeline-n-d">
    <title id="lpips-pipeline-n-t">{ru ? "Схема вычисления LPIPS (вертикальная)" : "LPIPS pipeline (stacked)"}</title>
    <desc id="lpips-pipeline-n-d">{ru ? "Изображение x слева и изображение x штрих справа проходят сверху вниз каждое через копию одной и той же замороженной свёрточной сети из пяти слоёв; копии имеют общие веса. На каждом слое карты признаков обоих изображений идут в узел сравнения d l посередине. Узлы от d1 до d5 складываются, и сумма равна LPIPS от x и x штрих. Врезка в рамке внизу показывает шаги внутри каждого узла d l: нормировка к единичной длине по каналам, вычитание, поканальное умножение на w l (обученные на человеческих перцептивных суждениях), возведение в квадрат и усреднение по позициям h, w. Низкий LPIPS означает, что изображения выглядят похоже; высокий — что изображения различаются видимой структурой." : "Image x on the left and image x prime on the right each go down through a copy of the same frozen convolutional network with five layers; the copies share weights. At every layer the feature maps of both images go to a comparison node d l in the middle. The nodes d1 to d5 are added, which equals LPIPS of x and x prime. A boxed inset at the bottom shows the steps inside every node d l: unit-normalise over channels, subtract, multiply channel-wise by w l (learned from human perceptual judgements), square, and average over positions h, w. Low LPIPS means the images look similar; high means the images differ in visible structure."}</desc>

    <text class="f-math f-t-red" x={leftN - 40} y="66" text-anchor="middle">x</text>
    <rect class="f-box" x={imgXN.x} y={imgXN.y} width={imgXN.size} height={imgXN.size} rx="3" />
    <rect class="f-fill-red" x={imgXN.x} y={imgXN.y} width={imgXN.size} height={imgXN.size} rx="3" />
    <path class="f-thin f-red" d={imgXN.mountain} />
    <circle class="f-thin f-red" cx={imgXN.sun[0]} cy={imgXN.sun[1]} r="4.5" />
    <text class="f-math f-t-blue" x={rightN + 42} y="66" text-anchor="middle">x′</text>
    <rect class="f-box" x={imgYN.x} y={imgYN.y} width={imgYN.size} height={imgYN.size} rx="3" />
    <rect class="f-fill-blue" x={imgYN.x} y={imgYN.y} width={imgYN.size} height={imgYN.size} rx="3" />
    <path class="f-thin f-blue" d={imgYN.mountain} />
    <circle class="f-thin f-blue" cx={imgYN.sun[0]} cy={imgYN.sun[1]} r="4.5" />

    <text class="f-note" x="180" y="20" text-anchor="middle">{ru ? "та же замороженная CNN" : "same frozen CNN"}</text>
    <text class="f-note" x="180" y="38" text-anchor="middle">(AlexNet / VGG)</text>
    <path class="f-thin f-muted f-dash" d="M 126 58 H 234" marker-start="url(#f-arrow-muted)" marker-end="url(#f-arrow-muted)" />
    <text class="f-note" x="180" y="78" text-anchor="middle">{ru ? "общие веса" : "shared weights"}</text>

    <path class="f-line f-red" d={`M ${leftN} 88 V ${yN[0] - bandN.h[0] / 2 - 3}`} marker-end="url(#f-arrow-red)" />
    <path class="f-line f-blue" d={`M ${rightN} 88 V ${yN[0] - bandN.h[0] / 2 - 3}`} marker-end="url(#f-arrow-blue)" />

    {yN.map((y, i) => (
      <>
        <rect class="f-box-soft" x={leftN - bandN.w[i] / 2} y={y - bandN.h[i] / 2} width={bandN.w[i]} height={bandN.h[i]} rx="2" />
        <rect class="f-box-soft" x={rightN - bandN.w[i] / 2} y={y - bandN.h[i] / 2} width={bandN.w[i]} height={bandN.h[i]} rx="2" />
        <path class="f-thin f-red" d={`M ${leftN + bandN.w[i] / 2 + 3} ${y} H ${180 - r - 3}`} marker-end="url(#f-arrow-red)" />
        <path class="f-thin f-blue" d={`M ${rightN - bandN.w[i] / 2 - 3} ${y} H ${180 + r + 3}`} marker-end="url(#f-arrow-blue)" />
        <circle class="f-box" cx="180" cy={y} r={r} />
        <text class="f-math" x="180" y={y + 6} text-anchor="middle">d{subs[i]}</text>
      </>
    ))}
    {yN.slice(0, -1).map((y, i) => (
      <>
        <path class="f-thin f-muted" d={`M ${leftN} ${y + bandN.h[i] / 2 + 2} V ${yN[i + 1] - bandN.h[i + 1] / 2 - 2}`} marker-end="url(#f-arrow-muted)" />
        <path class="f-thin f-muted" d={`M ${rightN} ${y + bandN.h[i] / 2 + 2} V ${yN[i + 1] - bandN.h[i + 1] / 2 - 2}`} marker-end="url(#f-arrow-muted)" />
        <text class="f-title" x="180" y={y + 36} text-anchor="middle">+</text>
      </>
    ))}
    <text class="f-small f-t-muted" x={leftN - bandN.w[0] / 2 - 6} y={yN[0] + 4} text-anchor="end">conv1</text>
    <text class="f-small f-t-muted" x={rightN + bandN.w[0] / 2 + 6} y={yN[0] + 4}>conv1</text>
    <text class="f-small f-t-muted" x={leftN - bandN.w[L - 1] / 2 - 6} y={yN[L - 1] + 4} text-anchor="end">conv5</text>
    <text class="f-small f-t-muted" x={rightN + bandN.w[L - 1] / 2 + 6} y={yN[L - 1] + 4}>conv5</text>

    <text class="f-title" x="180" y={yN[L - 1] + 42} text-anchor="middle">=</text>
    <rect class="f-box" x="105" y={yN[L - 1] + 54} width="150" height="44" rx="6" />
    <text class="f-title" x="180" y={yN[L - 1] + 81} text-anchor="middle">LPIPS(x, x′)</text>
    <text class="f-note" x="180" y={yN[L - 1] + 122} text-anchor="middle">{ru ? "низкий → выглядят похоже" : "low → looks similar"}</text>
    <text class="f-note" x="180" y={yN[L - 1] + 140} text-anchor="middle">{ru ? "высокий → разная видимая структура" : "high → different visible structure"}</text>

    <rect class="f-thin f-muted f-dash" x="2" y="574" width="356" height="244" rx="8" style="fill: none" />
    <text class="f-label" x="12" y="602">{ru ? 'внутри каждого узла d' : 'inside every node d'}<tspan dy="4" font-size="12">l</tspan><tspan dy="-4">:</tspan></text>
    {steps.map((st, i) => (
      <>
        <rect class={st.amber ? 'f-box-soft' : 'f-box'} x={stepXN[i]} y={stepYN[i]} width={boxW} height={boxH} rx="5" />
        {st.amber && <rect class="f-fill-amber" x={stepXN[i]} y={stepYN[i]} width={boxW} height={boxH} rx="5" />}
        {st.lines.map((line, j) => (
          <text class={j === 0 ? 'f-small' : 'f-small f-t-muted'} x={stepXN[i] + boxW / 2} y={stepYN[i] + 21 + j * 17} text-anchor="middle">
            {line.map(([t, sub]) => <>{phiSplit(t).map((part) => (isPhi(part) ? <tspan style={phiStyle}>{part}</tspan> : part))}{sub && <><tspan dy="3" font-size="10">{sub}</tspan><tspan dy="-3"></tspan></>}</>)}
          </text>
        ))}
      </>
    ))}
    {[0, 1, 3].map((i) => (
      <path class="f-thin" d={`M ${stepXN[i] + boxW + 3} ${stepYN[i] + boxH / 2} H ${stepXN[i + 1] - 4}`} marker-end="url(#f-arrow)" />
    ))}
    <path class="f-thin" d={`M ${stepXN[2] + boxW / 2} ${stepYN[2] + boxH + 3} C ${stepXN[2] + boxW / 2} ${stepYN[2] + boxH + 24}, ${stepXN[0] + boxW / 2} ${stepYN[3] - 26}, ${stepXN[0] + boxW / 2} ${stepYN[3] - 4}`} marker-end="url(#f-arrow)" />
    <path class="f-thin" d={`M ${stepXN[4] + boxW + 3} ${stepYN[4] + boxH / 2} H ${dlXN - r - 4}`} marker-end="url(#f-arrow)" />
    <circle class="f-box" cx={dlXN} cy={stepYN[4] + boxH / 2} r={r} />
    <text class="f-math" x={dlXN} y={stepYN[4] + boxH / 2 + 6} text-anchor="middle">d<tspan dy="4" font-size="13">l</tspan></text>
    <path class="f-thin f-amber" d={`M ${stepXN[3] + boxW / 2} ${stepYN[3] + boxH + 16} V ${stepYN[3] + boxH + 5}`} />
    <path d={`M ${stepXN[3] + boxW / 2} ${stepYN[3] + boxH + 2} l -4 7 h 8 z`} style="fill: var(--fig-amber)" />
    <text class="f-small f-t-amber" x="12" y={stepYN[3] + boxH + 30}>w<tspan dy="3" font-size="10">l</tspan><tspan dy="-3">{ru ? ' обучены на человеческих перцептивных суждениях' : ' learned from human perceptual judgements'}</tspan></text>
  </svg>
</Figure>
