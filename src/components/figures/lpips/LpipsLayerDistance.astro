---
import Figure from '../Figure.astro';
import { arrowHead, cells, dLayer, maxSq, weights } from './lpips-math';

type Kind = 'raw' | 'unit' | 'diff' | 'heat';

interface Seg {
  d: string;
  head: string;
  style: string;
  fill: string;
}

// Arrow from (ox, oy) along vector v (data units, y up) with the given pixel scale.
// x is drawn wide and underneath, x′ thin on top, so both colours stay visible when the directions nearly agree.
const arrow = (ox: number, oy: number, v: [number, number], k: number, colour: string, wide: boolean): Seg | null => {
  const x2 = ox + v[0] * k;
  const y2 = oy - v[1] * k;
  const len = Math.hypot(x2 - ox, y2 - oy);
  if (len < 3) return null;
  const head = Math.min(wide ? 9 : 6.5, len * 0.55);
  return {
    d: `M ${ox.toFixed(2)} ${oy.toFixed(2)} L ${x2.toFixed(2)} ${y2.toFixed(2)}`,
    head: arrowHead(ox, oy, x2, y2, head),
    style: `fill: none; stroke: ${colour}; stroke-width: ${wide ? 3 : 1.3}; stroke-linecap: round`,
    fill: colour,
  };
};

const panel = (x0: number, y0: number, cs: number, kind: Kind) => {
  const segs: Seg[] = [];
  const arcs: string[] = [];
  const dots: { cx: number; cy: number }[] = [];
  const heat: { x: number; y: number; o: number; label: string }[] = [];
  const red = 'var(--fig-red)';
  const blue = 'var(--fig-blue)';
  cells.forEach((row, h) =>
    row.forEach((c, w) => {
      const cx = x0 + (w + 0.5) * cs;
      const cy = y0 + (h + 0.5) * cs;
      // Post-ReLU features are non-negative, so in panels 1–2 every arrow lies in the first quadrant:
      // start it at the lower-left corner of its cell to give it the whole cell.
      const ox = x0 + w * cs + 0.12 * cs;
      const oy = y0 + (h + 1) * cs - 0.12 * cs;
      const reach = 0.78 * cs;
      if (kind === 'raw') {
        const k = reach / 2.2;
        [arrow(ox, oy, c.fx, k, red, true), arrow(ox, oy, c.fy, k, blue, false)].forEach((s) => s && segs.push(s));
      } else if (kind === 'unit') {
        arcs.push(`M ${(ox + reach).toFixed(2)} ${oy.toFixed(2)} A ${reach.toFixed(2)} ${reach.toFixed(2)} 0 0 0 ${ox.toFixed(2)} ${(oy - reach).toFixed(2)}`);
        [arrow(ox, oy, c.nx, reach, red, true), arrow(ox, oy, c.ny, reach, blue, false)].forEach((s) => s && segs.push(s));
      } else if (kind === 'diff') {
        // Centre the difference arrow on the cell so it can be drawn larger.
        const k = cs * 0.6;
        const s = arrow(cx - (c.wd[0] * k) / 2, cy + (c.wd[1] * k) / 2, c.wd, k, 'var(--ink)', false);
        if (s) segs.push({ ...s, style: s.style.replace('stroke-width: 1.3', 'stroke-width: 1.6') });
        else dots.push({ cx, cy });
      } else {
        heat.push({ x: x0 + w * cs, y: y0 + h * cs, o: 0.06 + 0.6 * (c.sq / maxSq), label: c.sq.toFixed(2) });
      }
    }),
  );
  const grid = [1, 2].flatMap((i) => [
    `M ${x0 + i * cs} ${y0} V ${y0 + 3 * cs}`,
    `M ${x0} ${y0 + i * cs} H ${x0 + 3 * cs}`,
  ]);
  return { x0, y0, cs, size: 3 * cs, segs, arcs, dots, heat, grid, kind };
};

// Wide layout
const csW = 46;
const xsW = [10, 184, 358, 532];
const gyW = 70;
const panelsW = (['raw', 'unit', 'diff', 'heat'] as Kind[]).map((k, i) => panel(xsW[i], gyW, csW, k));
const midW = (i: number) => xsW[i] + (3 * csW) / 2;
const botW = gyW + 3 * csW;

// Narrow layout (2 × 2)
const csN = 48;
const xsN = [20, 196];
const gyN = [70, 342];
const panelsN = (['raw', 'unit', 'diff', 'heat'] as Kind[]).map((k, i) => panel(xsN[i % 2], gyN[Math.floor(i / 2)], csN, k));
const sizeN = 3 * csN;

const dText = dLayer.toFixed(2);
const maxText = maxSq.toFixed(2);
const wText = `(${weights[0].toFixed(1)}, ${weights[1].toFixed(1)})`;
---

<Figure
  id="lpips-layer"
  title="Inside one layer: from two feature maps to the number dₗ"
  caption={`A toy layer with C = 2 channels on a 3 × 3 grid, so the feature vector at each position (h, w) is an arrow (red for x, blue for x′). Post-ReLU features are non-negative, so in the first two grids every arrow starts at the lower-left corner of its cell and points into the first quadrant. Normalisation keeps only the directions; the weighted difference is large only where the directions disagree; its squared length, averaged over the 9 positions, is dₗ = ${dText}. All values are computed.`}
>
  <svg class="fig-wide" viewBox="0 0 680 318" role="img" aria-labelledby="lpips-layer-w-t lpips-layer-w-d">
    <title id="lpips-layer-w-t">The four steps of one LPIPS layer distance</title>
    <desc id="lpips-layer-w-d">{`Four 3 by 3 grids connected by arrows. First: at every position a red feature vector of x and a blue feature vector of x prime, of different lengths. Second: both vectors normalised to unit length, reaching a quarter circle. Third: the difference of the unit vectors multiplied channel-wise by w_l = ${wText}; it is tiny almost everywhere, larger at the centre, and largest at the bottom-right position where the two directions differ by 90 degrees. Fourth: the squared lengths as a heat map with numbers, from 0.00 to ${maxText}. Their average over the nine positions is d_l = ${dText}.`}</desc>

    <text class="f-label" x={midW(0)} y="26" text-anchor="middle">features</text>
    <text class="f-math" x={midW(0)} y="52" text-anchor="middle"><tspan class="f-t-red">φ<tspan dy="5" font-size="13">l</tspan><tspan dy="-5">(x)</tspan></tspan>, <tspan class="f-t-blue">φ<tspan dy="5" font-size="13">l</tspan><tspan dy="-5">(x′)</tspan></tspan></text>
    <text class="f-label" x={midW(1)} y="26" text-anchor="middle">unit-normalise</text>
    <text class="f-math" x={midW(1)} y="52" text-anchor="middle"><tspan class="f-t-red">φ̂<tspan dy="5" font-size="13">l</tspan><tspan dy="-5">(x)</tspan></tspan>, <tspan class="f-t-blue">φ̂<tspan dy="5" font-size="13">l</tspan><tspan dy="-5">(x′)</tspan></tspan></text>
    <text class="f-label" x={midW(2)} y="26" text-anchor="middle">subtract, weigh</text>
    <text class="f-math" x={midW(2)} y="52" text-anchor="middle"><tspan class="f-t-amber">w<tspan dy="5" font-size="13">l</tspan><tspan dy="-5"> ⊙</tspan></tspan> (φ̂ − φ̂′)</text>
    <text class="f-label" x={midW(3)} y="26" text-anchor="middle">square</text>
    <text class="f-math" x={midW(3)} y="52" text-anchor="middle"><tspan style="font-style: normal">‖ · ‖</tspan>²<tspan dy="5" font-size="13">2</tspan><tspan dy="-5"> at each (h, w)</tspan></text>

    {panelsW.map((p) => (
      <>
        {p.heat.map((c) => (
          <>
            <rect x={c.x} y={c.y} width={p.cs} height={p.cs} style={`fill: var(--fig-amber); fill-opacity: ${c.o.toFixed(3)}`} />
            <text class="f-small" x={c.x + p.cs / 2} y={c.y + p.cs / 2 + 4.5} text-anchor="middle">{c.label}</text>
          </>
        ))}
        {p.grid.map((d) => <path class="f-grid" d={d} />)}
        <rect class="f-thin" x={p.x0} y={p.y0} width={p.size} height={p.size} style="fill: none" />
        {p.arcs.map((d) => <path class="f-grid" d={d} style="fill: none" />)}
        {p.dots.map((c) => <circle class="f-fill-ink" cx={c.cx} cy={c.cy} r="1.8" />)}
        {p.segs.map((s) => (
          <>
            <path d={s.d} style={s.style} />
            <path d={s.head} style={`fill: ${s.fill}`} />
          </>
        ))}
      </>
    ))}

    {xsW.slice(0, -1).map((x) => (
      <path class="f-line" d={`M ${x + 3 * csW + 6} ${gyW + 1.5 * csW} H ${x + 174 - 8}`} marker-end="url(#f-arrow)" />
    ))}

    <text class="f-note" x={midW(0)} y={botW + 22} text-anchor="middle">different lengths</text>
    <text class="f-note" x={midW(1)} y={botW + 22} text-anchor="middle">only directions left</text>
    <text class="f-note" x={midW(2)} y={botW + 22} text-anchor="middle"><tspan class="f-t-amber">w<tspan dy="4" font-size="11">l</tspan><tspan dy="-4"> = {wText}</tspan></tspan></text>
    <text class="f-note" x={midW(3)} y={botW + 22} text-anchor="middle">big where directions differ</text>

    <path class="f-line" d={`M ${midW(3)} ${botW + 34} V ${botW + 62}`} marker-end="url(#f-arrow)" />
    <text class="f-note" x={midW(3) - 10} y={botW + 54} text-anchor="end">mean of the 9 values</text>
    <text class="f-math" x={midW(3)} y={botW + 88} text-anchor="middle">d<tspan dy="5" font-size="13">l</tspan><tspan dy="-5" style="font-style: normal"> = {dText}</tspan></text>
  </svg>

  <svg class="fig-narrow" viewBox="0 0 360 616" role="img" aria-labelledby="lpips-layer-n-t lpips-layer-n-d">
    <title id="lpips-layer-n-t">The four steps of one LPIPS layer distance (stacked)</title>
    <desc id="lpips-layer-n-d">{`Four 3 by 3 grids in two rows. Top left: red feature vectors of x and blue feature vectors of x prime, of different lengths. Top right: both normalised to unit length. Bottom left: the difference of the unit vectors multiplied channel-wise by w_l = ${wText}, large only where the directions differ. Bottom right: the squared lengths as a heat map with numbers from 0.00 to ${maxText}; their average over the nine positions is d_l = ${dText}.`}</desc>

    {panelsN.map((p, i) => {
      const cx = p.x0 + p.size / 2;
      const titles = [
        ['1. features', 'different lengths'],
        ['2. unit-normalise', 'only directions left'],
        ['3. subtract, ⊙ w', `w = ${wText}`, true],
        ['4. square ‖ · ‖²', 'big where directions differ'],
      ][i];
      return (
        <>
          <text class="f-label" x={cx} y={p.y0 - 14} text-anchor="middle">{titles[0]}{titles[2] && <tspan dy="4" font-size="11">l</tspan>}</text>
          {p.heat.map((c) => (
            <>
              <rect x={c.x} y={c.y} width={p.cs} height={p.cs} style={`fill: var(--fig-amber); fill-opacity: ${c.o.toFixed(3)}`} />
              <text class="f-small" x={c.x + p.cs / 2} y={c.y + p.cs / 2 + 4.5} text-anchor="middle">{c.label}</text>
            </>
          ))}
          {p.grid.map((d) => <path class="f-grid" d={d} />)}
          <rect class="f-thin" x={p.x0} y={p.y0} width={p.size} height={p.size} style="fill: none" />
          {p.arcs.map((d) => <path class="f-grid" d={d} style="fill: none" />)}
          {p.dots.map((c) => <circle class="f-fill-ink" cx={c.cx} cy={c.cy} r="1.8" />)}
          {p.segs.map((s) => (
            <>
              <path d={s.d} style={s.style} />
              <path d={s.head} style={`fill: ${s.fill}`} />
            </>
          ))}
          <text class={i === 2 ? 'f-note f-t-amber' : 'f-note'} x={cx} y={p.y0 + p.size + 22} text-anchor="middle">{titles[2] ? <>w<tspan dy="4" font-size="11">l</tspan><tspan dy="-4">{` = ${wText}`}</tspan></> : titles[1]}</text>
        </>
      );
    })}

    <path class="f-line" d={`M ${xsN[0] + sizeN + 5} ${gyN[0] + sizeN / 2} H ${xsN[1] - 7}`} marker-end="url(#f-arrow)" />
    <path class="f-line" d={`M ${xsN[1] + sizeN / 2} ${gyN[0] + sizeN + 34} Q ${xsN[1] + sizeN / 2 - 10} ${gyN[1] - 30} ${xsN[0] + sizeN + 14} ${gyN[1] - 6}`} marker-end="url(#f-arrow)" />
    <path class="f-line" d={`M ${xsN[0] + sizeN + 5} ${gyN[1] + sizeN / 2} H ${xsN[1] - 7}`} marker-end="url(#f-arrow)" />

    <text class="f-label" x="180" y={gyN[1] + sizeN + 56} text-anchor="middle">average over the 9 positions:</text>
    <text class="f-math" x="180" y={gyN[1] + sizeN + 86} text-anchor="middle">d<tspan dy="5" font-size="13">l</tspan><tspan dy="-5" style="font-style: normal"> = {dText}</tspan></text>
    <text class="f-note" x="180" y={gyN[1] + sizeN + 116} text-anchor="middle">red: x, blue: x′</text>
  </svg>
</Figure>
