---
import Figure from '../Figure.astro';
import { arrowHead, cells, dLayer, maxSq, weights } from './lpips-math';

type Kind = 'raw' | 'unit' | 'diff' | 'heat';

interface Seg {
  d: string;
  head: string;
  cls: string;
  fill: string;
}

// Arrow from the centre of a cell along vector v (data units, y up) with the given pixel scale.
const arrow = (cx: number, cy: number, v: [number, number], k: number, cls: string, fill: string): Seg | null => {
  const x2 = cx + v[0] * k;
  const y2 = cy - v[1] * k;
  const len = Math.hypot(x2 - cx, y2 - cy);
  if (len < 3) return null;
  return { d: `M ${cx} ${cy} L ${x2.toFixed(2)} ${y2.toFixed(2)}`, head: arrowHead(cx, cy, x2, y2, Math.min(7, len * 0.55)), cls, fill };
};

const panel = (x0: number, y0: number, cs: number, kind: Kind) => {
  const segs: Seg[] = [];
  const rings: { cx: number; cy: number; r: number }[] = [];
  const heat: { x: number; y: number; o: number; label: string }[] = [];
  cells.forEach((row, h) =>
    row.forEach((c, w) => {
      const cx = x0 + (w + 0.5) * cs;
      const cy = y0 + (h + 0.5) * cs;
      const red = 'var(--fig-red)';
      const blue = 'var(--fig-blue)';
      if (kind === 'raw') {
        const k = (cs * 0.47) / 2.2;
        [arrow(cx, cy, c.fx, k, 'f-thin f-red', red), arrow(cx, cy, c.fy, k, 'f-thin f-blue', blue)].forEach((s) => s && segs.push(s));
      } else if (kind === 'unit') {
        const k = cs * 0.4;
        rings.push({ cx, cy, r: k });
        [arrow(cx, cy, c.nx, k, 'f-thin f-red', red), arrow(cx, cy, c.ny, k, 'f-thin f-blue', blue)].forEach((s) => s && segs.push(s));
      } else if (kind === 'diff') {
        // Centre the difference arrow on the cell so it can be drawn larger.
        const k = cs * 0.6;
        const s = arrow(cx - (c.wd[0] * k) / 2, cy + (c.wd[1] * k) / 2, c.wd, k, 'f-line', 'var(--ink)');
        if (s) segs.push(s);
        else rings.push({ cx, cy, r: 1.6 });
      } else {
        heat.push({ x: x0 + w * cs, y: y0 + h * cs, o: 0.06 + 0.6 * (c.sq / maxSq), label: c.sq.toFixed(2) });
      }
    }),
  );
  const grid = [1, 2].flatMap((i) => [
    `M ${x0 + i * cs} ${y0} V ${y0 + 3 * cs}`,
    `M ${x0} ${y0 + i * cs} H ${x0 + 3 * cs}`,
  ]);
  return { x0, y0, cs, size: 3 * cs, segs, rings, heat, grid, kind };
};

// Wide layout
const csW = 40;
const xsW = [25, 195, 365, 535];
const gyW = 70;
const panelsW = (['raw', 'unit', 'diff', 'heat'] as Kind[]).map((k, i) => panel(xsW[i], gyW, csW, k));

// Narrow layout (2 × 2)
const csN = 34;
const xsN = [42, 216];
const gyN = [70, 308];
const panelsN = (['raw', 'unit', 'diff', 'heat'] as Kind[]).map((k, i) => panel(xsN[i % 2], gyN[Math.floor(i / 2)], csN, k));

const dText = dLayer.toFixed(2);
const maxText = maxSq.toFixed(2);
const wText = `(${weights[0].toFixed(1)}, ${weights[1].toFixed(1)})`;
---

<Figure
  id="lpips-layer"
  title="Inside one layer: from two feature maps to the number dₗ"
  caption={`A toy layer with C = 2 channels on a 3 × 3 grid, so the feature vector at each position (h, w) is an arrow (red for x, blue for x′). Normalisation keeps only the directions; the weighted difference is large only where the directions disagree; its squared length, averaged over the 9 positions, is dₗ = ${dText}. All values are computed.`}
  origin="illustrative"
  pages="18–19"
>
  <svg class="fig-wide" viewBox="0 0 680 298" role="img" aria-labelledby="lpips-layer-w-t lpips-layer-w-d">
    <title id="lpips-layer-w-t">The four steps of one LPIPS layer distance</title>
    <desc id="lpips-layer-w-d">{`Four 3 by 3 grids connected by arrows. First: at every position a red feature vector of x and a blue feature vector of x prime, of different lengths. Second: both vectors normalised to unit length, drawn inside unit circles. Third: the difference of the unit vectors multiplied channel-wise by w_l = ${wText}; it is tiny almost everywhere, larger at the centre, and largest at the bottom-right position where the two directions differ by 90 degrees. Fourth: the squared lengths as a heat map with numbers, from 0.00 to ${maxText}. Their average over the nine positions is d_l = ${dText}.`}</desc>

    <text class="f-label" x={xsW[0] + 60} y="26" text-anchor="middle">features</text>
    <text class="f-math" x={xsW[0] + 60} y="52" text-anchor="middle"><tspan class="f-t-red">φ<tspan dy="5" font-size="13">l</tspan><tspan dy="-5">(x)</tspan></tspan>, <tspan class="f-t-blue">φ<tspan dy="5" font-size="13">l</tspan><tspan dy="-5">(x′)</tspan></tspan></text>
    <text class="f-label" x={xsW[1] + 60} y="26" text-anchor="middle">unit-normalise</text>
    <text class="f-math" x={xsW[1] + 60} y="52" text-anchor="middle"><tspan class="f-t-red">φ̂<tspan dy="5" font-size="13">l</tspan><tspan dy="-5">(x)</tspan></tspan>, <tspan class="f-t-blue">φ̂<tspan dy="5" font-size="13">l</tspan><tspan dy="-5">(x′)</tspan></tspan></text>
    <text class="f-label" x={xsW[2] + 60} y="26" text-anchor="middle">subtract, weigh</text>
    <text class="f-math" x={xsW[2] + 60} y="52" text-anchor="middle"><tspan class="f-t-amber">w<tspan dy="5" font-size="13">l</tspan><tspan dy="-5"> ⊙</tspan></tspan> (φ̂ − φ̂′)</text>
    <text class="f-label" x={xsW[3] + 60} y="26" text-anchor="middle">square</text>
    <text class="f-math" x={xsW[3] + 60} y="52" text-anchor="middle"><tspan style="font-style: normal">‖ · ‖</tspan>²<tspan dy="5" font-size="13">2</tspan><tspan dy="-5"> at each (h, w)</tspan></text>

    {panelsW.map((p) => (
      <>
        {p.heat.map((c) => (
          <>
            <rect x={c.x} y={c.y} width={p.cs} height={p.cs} style={`fill: var(--fig-amber); fill-opacity: ${c.o.toFixed(3)}`} />
            <text class="f-small" x={c.x + p.cs / 2} y={c.y + p.cs / 2 + 4.5} text-anchor="middle">{c.label}</text>
          </>
        ))}
        {p.grid.map((d) => <path class="f-grid" d={d} />)}
        <rect class="f-thin" x={p.x0} y={p.y0} width={p.size} height={p.size} style="fill: none" />
        {p.rings.map((c) => (p.kind === 'unit' ? <circle class="f-grid" cx={c.cx} cy={c.cy} r={c.r} /> : <circle class="f-fill-ink" cx={c.cx} cy={c.cy} r={c.r} />))}
        {p.segs.map((s) => (
          <>
            <path class={s.cls} d={s.d} />
            <path d={s.head} style={`fill: ${s.fill}`} />
          </>
        ))}
      </>
    ))}

    {xsW.slice(0, -1).map((x) => (
      <path class="f-line" d={`M ${x + 128} ${gyW + 60} H ${x + 165}`} marker-end="url(#f-arrow)" />
    ))}

    <text class="f-note" x={xsW[0] + 60} y="214" text-anchor="middle">different lengths</text>
    <text class="f-note" x={xsW[1] + 60} y="214" text-anchor="middle">only directions left</text>
    <text class="f-note" x={xsW[2] + 60} y="214" text-anchor="middle"><tspan class="f-t-amber">w<tspan dy="4" font-size="11">l</tspan><tspan dy="-4"> = {wText}</tspan></tspan></text>
    <text class="f-note" x={xsW[3] + 60} y="214" text-anchor="middle">big where directions differ</text>

    <text class="f-note" x={xsW[3] + 60} y="234" text-anchor="middle">mean of the 9 values</text>
    <path class="f-line" d={`M ${xsW[3] + 60} 242 V 260`} marker-end="url(#f-arrow)" />
    <text class="f-math" x={xsW[3] + 60} y="286" text-anchor="middle">d<tspan dy="5" font-size="13">l</tspan><tspan dy="-5" style="font-style: normal"> = {dText}</tspan></text>
  </svg>

  <svg class="fig-narrow" viewBox="0 0 360 560" role="img" aria-labelledby="lpips-layer-n-t lpips-layer-n-d">
    <title id="lpips-layer-n-t">The four steps of one LPIPS layer distance (stacked)</title>
    <desc id="lpips-layer-n-d">{`Four 3 by 3 grids in two rows. Top left: red feature vectors of x and blue feature vectors of x prime, of different lengths. Top right: both normalised to unit length. Bottom left: the difference of the unit vectors multiplied channel-wise by w_l = ${wText}, large only where the directions differ. Bottom right: the squared lengths as a heat map with numbers from 0.00 to ${maxText}; their average over the nine positions is d_l = ${dText}.`}</desc>

    {panelsN.map((p, i) => {
      const cx = p.x0 + p.size / 2;
      const titles = [
        ['1. features', 'different lengths'],
        ['2. unit-normalise', 'only directions left'],
        ['3. subtract, ⊙ w', `w = ${wText}`, true],
        ['4. square ‖ · ‖²', 'big where directions differ'],
      ][i];
      return (
        <>
          <text class="f-label" x={cx} y={p.y0 - 14} text-anchor="middle">{titles[0]}{titles[2] && <tspan dy="4" font-size="11">l</tspan>}</text>
          {p.heat.map((c) => (
            <>
              <rect x={c.x} y={c.y} width={p.cs} height={p.cs} style={`fill: var(--fig-amber); fill-opacity: ${c.o.toFixed(3)}`} />
              <text class="f-small" x={c.x + p.cs / 2} y={c.y + p.cs / 2 + 4.5} text-anchor="middle">{c.label}</text>
            </>
          ))}
          {p.grid.map((d) => <path class="f-grid" d={d} />)}
          <rect class="f-thin" x={p.x0} y={p.y0} width={p.size} height={p.size} style="fill: none" />
          {p.rings.map((c) => (p.kind === 'unit' ? <circle class="f-grid" cx={c.cx} cy={c.cy} r={c.r} /> : <circle class="f-fill-ink" cx={c.cx} cy={c.cy} r={c.r} />))}
          {p.segs.map((s) => (
            <>
              <path class={s.cls} d={s.d} />
              <path d={s.head} style={`fill: ${s.fill}`} />
            </>
          ))}
          <text class={i === 2 ? 'f-note f-t-amber' : 'f-note'} x={cx} y={p.y0 + p.size + 22} text-anchor="middle">{titles[2] ? <>w<tspan dy="4" font-size="11">l</tspan><tspan dy="-4">{` = ${wText}`}</tspan></> : titles[1]}</text>
        </>
      );
    })}

    <path class="f-line" d={`M ${xsN[0] + 108} ${gyN[0] + 51} H ${xsN[1] - 8}`} marker-end="url(#f-arrow)" />
    <path class="f-line" d={`M ${xsN[1] + 51} ${gyN[0] + 136} Q ${xsN[1] + 40} 236 ${xsN[0] + 70} 262`} marker-end="url(#f-arrow)" />
    <path class="f-line" d={`M ${xsN[0] + 108} ${gyN[1] + 51} H ${xsN[1] - 8}`} marker-end="url(#f-arrow)" />

    <text class="f-label" x="180" y="486" text-anchor="middle">average over the 9 positions:</text>
    <text class="f-math" x="180" y="516" text-anchor="middle">d<tspan dy="5" font-size="13">l</tspan><tspan dy="-5" style="font-style: normal"> = {dText}</tspan></text>
    <text class="f-note" x="180" y="546" text-anchor="middle">red: x, blue: x′</text>
  </svg>
</Figure>
