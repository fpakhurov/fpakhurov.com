---
import Figure from '../Figure.astro';
import { scale, plot } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The worked example: A = (1, 1, 5, 5), B = (3, 2, 7, 6) as (x1, y1, x2, y2), y pointing down as in an image.
const A = [1, 1, 5, 5], B = [3, 2, 7, 6];
const I = [Math.max(A[0], B[0]), Math.max(A[1], B[1]), Math.min(A[2], B[2]), Math.min(A[3], B[3])];
const boxArea = (b: number[]) => (b[2] - b[0]) * (b[3] - b[1]);
const inter = boxArea(I), union = boxArea(A) + boxArea(B) - inter, iou = inter / union;
// A box of the right size shifted by a fraction u of its side: along one axis IoU = (1 − u)/(1 + u); along both, (1 − u)²/(2 − (1 − u)²).
const along = (u: number) => (1 - u) / (1 + u);
const diag = (u: number) => (1 - u) ** 2 / (2 - (1 - u) ** 2);
const u50 = 1 / 3, u75 = 1 / 7;
const q = [inter, union, iou.toFixed(3), along(u50).toFixed(3), along(u75).toFixed(3), along(0.2).toFixed(3), (1 - Math.sqrt(2 * 0.5 / 1.5)).toFixed(3), diag(1 - Math.sqrt(2 * 0.5 / 1.5)).toFixed(3)].join(' ');
if (q !== '6 26 0.231 0.500 0.750 0.667 0.184 0.500') throw new Error(`IouGeometry: values drifted (${q})`);

const t = ru
  ? { title: 'Отношение пересечения к объединению и допустимый сдвиг рамки', a: 'A: 4 × 4 = 16', b: 'B: 4 × 4 = 16', i: 'A ∩ B: 2 × 3 = 6', res: 'IoU = 6 / (16 + 16 − 6) = 0.231',
      x: 'сдвиг / сторона рамки u', y: 'IoU', one: 'сдвиг по одной оси', two: 'по обеим осям', m50: 'u = 1/3', m75: 'u = 1/7',
      desc: 'Слева: две рамки 4 на 4 на сетке, A в точке (1, 1), B в точке (3, 2); их пересечение 2 на 3 закрашено, IoU равно 6/26 = 0.231. Справа: IoU рамки правильного размера как функция сдвига u в долях стороны. При сдвиге по одной оси IoU = (1 − u)/(1 + u): 0.5 при u = 1/3 и 0.75 при u = 1/7. При сдвиге по обеим осям кривая ниже.' }
  : { title: 'Intersection over union, and how far a box may be off', a: 'A: 4 × 4 = 16', b: 'B: 4 × 4 = 16', i: 'A ∩ B: 2 × 3 = 6', res: 'IoU = 6 / (16 + 16 − 6) = 0.231',
      x: 'shift / box side u', y: 'IoU', one: 'shift along one axis', two: 'along both axes', m50: 'u = 1/3', m75: 'u = 1/7',
      desc: 'Left: two 4 by 4 boxes on a grid, A at (1, 1) and B at (3, 2); their 2 by 3 intersection is shaded, and the IoU is 6/26 = 0.231. Right: the IoU of a box of the right size as a function of its shift u, as a fraction of its side. Shifted along one axis the IoU is (1 − u)/(1 + u): 0.5 at u = 1/3 and 0.75 at u = 1/7. Shifted along both axes the curve is lower.' };
const id = 'det-iou';
const caption = ru
  ? `Слева — пример из текста: пересечение 6, объединение 26, IoU = ${iou.toFixed(3)}. Справа — сколько может ошибиться рамка правильного размера: при сдвиге на долю u стороны вдоль одной оси IoU = (1 − u)/(1 + u), поэтому порог 0.5 допускает сдвиг на треть стороны, а порог 0.75 — лишь на седьмую часть. Сдвиг на 2 пикселя отнимает у рамки 10 × 10 треть IoU (0.667), а у рамки 100 × 100 — четыре процента (0.961): IoU измеряет ошибку относительно размера объекта.`
  : `Left: the worked example of the text, intersection 6, union 26, IoU = ${iou.toFixed(3)}. Right: how far a box of the right size may be off. Shifted by a fraction u of its side along one axis, its IoU is (1 − u)/(1 + u), so the threshold 0.5 tolerates a shift of a third of the side and the threshold 0.75 only a seventh. A 2-pixel shift costs a 10 × 10 box a third of its IoU (0.667) and a 100 × 100 box four percent (0.961): IoU measures the error relative to the size of the object.`;

const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, ox: 40, oy: 34, cell: 34, tx: 40, ty: 296, px: [450, 730] as [number, number], py: [40, 260] as [number, number], lx: 580, ly: 52 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 630, ox: 34, oy: 20, cell: 30, tx: 20, ty: 268, px: [60, 340] as [number, number], py: [350, 570] as [number, number], lx: 70, ly: 534 },
];
function helpers(L: (typeof layouts)[number]) {
  const gx = (v: number) => L.ox + v * L.cell, gy = (v: number) => L.oy + v * L.cell;
  const rect = (b: number[]) => ({ x: gx(b[0]), y: gy(b[1]), width: (b[2] - b[0]) * L.cell, height: (b[3] - b[1]) * L.cell });
  return { gx, gy, rect, sx: scale([0, 0.6], L.px), sy: scale([0, 1], [L.py[1], L.py[0]]) };
}
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const { gx, gy, rect, sx, sy } = helpers(L);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((v) => <path class="f-grid" d={`M ${gx(v)} ${gy(0)} V ${gy(7)}`} />)}
        {[0, 1, 2, 3, 4, 5, 6, 7].map((v) => <path class="f-grid" d={`M ${gx(0)} ${gy(v)} H ${gx(8)}`} />)}
        {[0, 2, 4, 6, 8].map((v) => <text class="f-note" x={gx(v)} y={gy(0) - 6} text-anchor="middle">{v}</text>)}
        {[2, 4, 6].map((v) => <text class="f-note" x={gx(0) - 8} y={gy(v) + 5} text-anchor="end">{v}</text>)}
        <rect {...rect(A)} class="f-fill-blue" style="stroke: var(--fig-blue); stroke-width: 2" />
        <rect {...rect(B)} class="f-fill-red" style="stroke: var(--fig-red); stroke-width: 2" />
        <rect {...rect(I)} style="fill: var(--fig-amber); fill-opacity: 0.45; stroke: var(--fig-amber); stroke-width: 1.5" />
        <text class="f-small f-t-blue f-halo" x={gx(1) + 6} y={gy(1) + 18}>{t.a}</text>
        <text class="f-small f-t-red f-halo" x={gx(7) - 6} y={gy(6) - 8} text-anchor="end">{t.b}</text>
        <text class="f-small f-halo" x={gx(4)} y={gy(3.5) + 5} text-anchor="middle">6</text>
        <text class="f-small" x={L.tx} y={L.ty}>{t.i}</text>
        <text class="f-small" x={L.tx} y={L.ty + 20}>{t.res}</text>
        {[0.25, 0.5, 0.75, 1].map((v) => <path class="f-grid" d={`M ${L.px[0]} ${sy(v)} H ${L.px[1]}`} />)}
        <path class="f-axis" d={`M ${L.px[0]} ${L.py[0]} V ${L.py[1]} H ${L.px[1]}`} />
        {[0, 0.2, 0.4, 0.6].map((v) => <text class="f-note" x={sx(v)} y={L.py[1] + 18} text-anchor="middle">{v}</text>)}
        {[0, 0.5, 0.75, 1].map((v) => <text class="f-note" x={L.px[0] - 7} y={sy(v) + 5} text-anchor="end">{v}</text>)}
        <text class="f-small" x={(L.px[0] + L.px[1]) / 2} y={L.py[1] + 40} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.px[0]} y={L.py[0] - 10}>{t.y}</text>
        <path class="f-line f-blue" d={plot(along, 0, 0.6, sx, sy, 120)} />
        <path class="f-line f-red f-dash" d={plot(diag, 0, 0.6, sx, sy, 120)} />
        <path class="f-thin f-muted f-dash" d={`M ${sx(u50)} ${sy(0.5)} V ${L.py[1]} M ${sx(u75)} ${sy(0.75)} V ${L.py[1]}`} />
        <circle cx={sx(u50)} cy={sy(0.5)} r="4" class="f-solid-blue" />
        <circle cx={sx(u75)} cy={sy(0.75)} r="4" class="f-solid-blue" />
        <text class="f-small f-halo" x={sx(u50) + 8} y={sy(0.5) - 8}>{t.m50}</text>
        <text class="f-small f-halo" x={sx(u75) + 8} y={sy(0.75) - 8}>{t.m75}</text>
        <path class="f-line f-blue" d={`M ${L.lx} ${L.ly - 4} h 22`} />
        <text class="f-small" x={L.lx + 28} y={L.ly}>{t.one}</text>
        <path class="f-line f-red f-dash" d={`M ${L.lx} ${L.ly + 18} h 22`} />
        <text class="f-small" x={L.lx + 28} y={L.ly + 22}>{t.two}</text>
      </svg>
    );
  })}
</Figure>
