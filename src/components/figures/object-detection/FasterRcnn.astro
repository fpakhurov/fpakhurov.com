---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Faster R-CNN with VGG-16: stride 16, k = 3 scales × 3 aspect ratios = 9 anchors per position, NMS at IoU 0.7, 300 proposals at test time, 7 × 7 RoI pooling.
// For a 1000 × 600 image the paper counts roughly 60 × 40 positions, so about 20 thousand anchors.
const k = 3 * 3, anchors = 60 * 40 * k;
if (k !== 9 || anchors !== 21600) throw new Error('FasterRcnn: anchor count drifted');

const t = ru
  ? {
      title: 'Faster R-CNN: общая карта признаков, предложения и выходной блок',
      img: 'изображение', bb: 'базовая сеть', bbS: 'CNN', fm: 'признаки', fmS: 'шаг 16', rpn: 'RPN', rpnS: '9 якорей на позицию', nms1: 'NMS 0.7', nms1S: '300 предложений',
      roi: 'RoI-пулинг', roiS: 'сетка 7 × 7', head: 'выходной блок', headS: 'K + 1 классов, рамки', nms2: 'NMS', nms2S: 'по классам', out: 'детекции',
      steps: ['базовая сеть один раз вычисляет карту признаков всего изображения', 'RPN в каждой позиции оценивает 9 якорей и уточняет их рамки', 'NMS с порогом 0.7 оставляет лучшие предложения (300 на тесте)', 'RoI-пулинг вырезает из общей карты сетку 7 × 7 для каждого предложения', 'выходной блок относит предложение к одному из K классов или к фону и уточняет рамку', 'NMS по каждому классу убирает дубликаты; оставшиеся рамки — детекции'],
      desc: 'Схема Faster R-CNN. Изображение проходит через свёрточную базовую сеть, получается карта признаков с шагом 16. Сеть предложений регионов (RPN) оценивает 9 якорей в каждой позиции карты; после NMS с порогом 0.7 остаётся 300 предложений. RoI-пулинг вырезает для каждого предложения сетку признаков 7 на 7 из той же карты, выходной блок классифицирует её и уточняет рамку, NMS по классам даёт итоговые детекции.',
    }
  : {
      title: 'Faster R-CNN: one feature map, proposals and a head',
      img: 'image', bb: 'backbone', bbS: 'CNN', fm: 'features', fmS: 'stride 16', rpn: 'RPN', rpnS: '9 anchors / position', nms1: 'NMS 0.7', nms1S: '300 proposals',
      roi: 'RoI pooling', roiS: '7 × 7 per proposal', head: 'head', headS: 'K + 1 classes, boxes', nms2: 'NMS', nms2S: 'per class', out: 'detections',
      steps: ['the backbone computes one feature map for the whole image', 'at every position the RPN scores 9 anchors and refines their boxes', 'NMS at IoU 0.7 keeps the best proposals (300 at test time)', 'RoI pooling cuts a 7 × 7 grid from the shared map for each proposal', 'the head assigns each proposal one of K classes or background and refines its box', 'per-class NMS removes duplicates; the remaining boxes are the detections'],
      desc: 'A diagram of Faster R-CNN. The image passes through a convolutional backbone, giving a feature map with stride 16. The region proposal network (RPN) scores 9 anchors at every position of the map; NMS at threshold 0.7 leaves 300 proposals. RoI pooling cuts a 7 by 7 feature grid for each proposal from the same map, the head classifies it and refines the box, and per-class NMS gives the final detections.',
    };
const id = 'det-faster-rcnn';
const caption = ru
  ? `Двухстадийный детектор как одна сеть. Самая дорогая часть, базовая сеть, работает один раз на изображение; RPN — небольшой свёрточный выходной блок на той же карте: для изображения 1000 × 600 и шага 16 это примерно 60 × 40 позиций по 9 якорей, около 20 тысяч. Вторая стадия видит только предложения, прошедшие NMS. Обе стадии обучаются с функцией потерь одного вида, «классификация плюс регрессия рамки», но с разными порогами IoU для разметки.`
  : `A two-stage detector as one network. The expensive part, the backbone, runs once per image; the RPN is a small convolutional head on the same map: for a 1000 × 600 image at stride 16 that is roughly 60 × 40 positions with 9 anchors each, about 20 thousand. The second stage sees only the proposals that survive NMS. Both stages are trained with the same kind of loss, classification plus box regression, with different IoU thresholds for labelling.`;
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 352" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <g data-s="1">
      <Box x={16} y={140} w={96} h={52} label={t.img} tone="x" />
      <Arrow pts={[[112, 166], [128, 166]]} />
      <Box x={130} y={140} w={98} h={52} label={t.bb} sub={t.bbS} />
      <Arrow pts={[[228, 166], [246, 166]]} />
      <Box x={248} y={140} w={100} h={52} label={t.fm} sub={t.fmS} tone="h" />
      <Badge x={248} y={140} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[298, 140], [298, 66], [374, 66]]} />
      <Box x={376} y={40} w={160} h={52} label={t.rpn} sub={t.rpnS} tone="g" />
      <Badge x={376} y={40} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[536, 66], [566, 66]]} />
      <Box x={568} y={40} w={120} h={52} label={t.nms1} sub={t.nms1S} />
      <Badge x={568} y={40} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[348, 166], [374, 166]]} />
      <Arrow pts={[[628, 92], [628, 116], [456, 116], [456, 138]]} />
      <Box x={376} y={140} w={160} h={52} label={t.roi} sub={t.roiS} />
      <Badge x={376} y={140} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[456, 192], [456, 230]]} />
      <Box x={376} y={232} w={160} h={52} label={t.head} sub={t.headS} tone="g" />
      <Badge x={376} y={232} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[536, 258], [556, 258]]} />
      <Box x={558} y={232} w={84} h={52} label={t.nms2} sub={t.nms2S} />
      <Arrow pts={[[642, 258], [656, 258]]} />
      <Box x={658} y={232} w={92} h={52} label={t.out} tone="y" />
      <Badge x={558} y={232} n={6} />
    </g>
    <Legend x={210} y={336} step={120} rows={1} />
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 572" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <g data-s="1">
      <Box x={16} y={30} w={156} h={48} label={t.img} tone="x" />
      <Arrow pts={[[94, 78], [94, 98]]} />
      <Box x={16} y={100} w={156} h={48} label={t.bb} sub={t.bbS} />
      <Arrow pts={[[94, 148], [94, 168]]} />
      <Box x={16} y={170} w={156} h={48} label={t.fm} sub={t.fmS} tone="h" />
      <Badge x={16} y={170} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[172, 194], [188, 194]]} />
      <Box x={190} y={170} w={164} h={48} label={t.rpn} sub={t.rpnS} tone="g" />
      <Badge x={190} y={170} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[272, 218], [272, 238]]} />
      <Box x={190} y={240} w={164} h={48} label={t.nms1} sub={t.nms1S} />
      <Badge x={190} y={240} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[94, 218], [94, 308]]} />
      <Arrow pts={[[272, 288], [272, 334], [174, 334]]} />
      <Box x={16} y={310} w={156} h={48} label={t.roi} sub={t.roiS} />
      <Badge x={16} y={310} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[94, 358], [94, 378]]} />
      <Box x={16} y={380} w={156} h={48} label={t.head} sub={t.headS} tone="g" />
      <Badge x={16} y={380} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[172, 404], [188, 404]]} />
      <Box x={190} y={380} w={164} h={48} label={t.nms2} sub={t.nms2S} />
      <Arrow pts={[[272, 428], [272, 448]]} />
      <Box x={190} y={450} w={164} h={48} label={t.out} tone="y" />
      <Badge x={190} y={380} n={6} />
    </g>
    <Legend x={16} y={536} step={170} rows={2} />
  </svg>
  <Stepper steps={t.steps} />
</Figure>
