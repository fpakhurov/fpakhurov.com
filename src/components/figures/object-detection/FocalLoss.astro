---
import Figure from '../Figure.astro';
import { scale, plot } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Focal loss FL(p) = −(1 − p)^γ log p for the probability p of the true class; γ = 0 is cross-entropy.
const fl = (g: number) => (p: number) => -((1 - p) ** g) * Math.log(p);
const gammas: [number, string][] = [[0, 'f-muted'], [0.5, 'f-green'], [1, 'f-amber'], [2, 'f-red'], [5, 'f-blue']];
const q = [fl(0)(0.9).toFixed(4), fl(2)(0.9).toFixed(6), (fl(0)(0.9) / fl(2)(0.9)).toFixed(0), (fl(0)(0.968) / fl(2)(0.968)).toFixed(0), (fl(0)(0.5) / fl(2)(0.5)).toFixed(0)].join(' ');
if (q !== '0.1054 0.001054 100 977 4') throw new Error(`FocalLoss: values drifted (${q})`);

const t = ru
  ? { title: 'Фокальная функция потерь приглушает лёгкие примеры', x: 'вероятность верного класса pₜ', y: 'потери', ce: 'γ = 0 (кросс-энтропия)', easy: 'лёгкие примеры',
      note: 'pₜ = 0.9, γ = 2: в 100 раз ниже',
      desc: 'Значение функции потерь в зависимости от вероятности верного класса от 0 до 1 при γ = 0, 0.5, 1, 2 и 5. При γ = 0 это кросс-энтропия. С ростом γ потери на примерах с вероятностью выше 0.5 почти исчезают: при pₜ = 0.9 и γ = 2 она в 100 раз меньше кросс-энтропии.' }
  : { title: 'The focal loss turns down easy examples', x: 'probability of the true class pₜ', y: 'loss', ce: 'γ = 0 (cross-entropy)', easy: 'well classified',
      note: 'pₜ = 0.9, γ = 2: 100× smaller',
      desc: 'The loss against the probability of the true class from 0 to 1, for γ = 0, 0.5, 1, 2 and 5. At γ = 0 it is cross-entropy. As γ grows, the loss on examples with probability above 0.5 almost vanishes: at pₜ = 0.9 and γ = 2 it is 100 times smaller than cross-entropy.' };
const id = 'det-focal-loss';
const caption = ru
  ? 'FL(pₜ) = −(1 − pₜ)^γ log pₜ. Множитель (1 − pₜ)^γ почти не трогает трудные примеры (при pₜ = 0.1 и γ = 2 он равен 0.81) и сильно уменьшает потери на лёгких: в 4 раза при pₜ = 0.5, в 100 раз при pₜ = 0.9, примерно в 1000 раз при pₜ = 0.968. Сотня тысяч лёгких фоновых якорей больше не заглушает несколько десятков объектов.'
  : 'FL(pₜ) = −(1 − pₜ)^γ log pₜ. The factor (1 − pₜ)^γ barely touches hard examples (0.81 at pₜ = 0.1 for γ = 2) and shrinks the loss of easy ones: 4 times at pₜ = 0.5, 100 times at pₜ = 0.9, about 1000 times at pₜ = 0.968. A hundred thousand easy background anchors no longer drown out a few dozen objects.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [70, 520] as [number, number], py: [30, 250] as [number, number], lx: 556, ly: 60, nl: 1.3 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 400, px: [50, 340] as [number, number], py: [30, 250] as [number, number], lx: 50, ly: 326, nl: 2.6 },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sx = scale([0, 1], L.px), sy = scale([0, 4], [L.py[1], L.py[0]]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        <rect x={sx(0.5)} y={L.py[0]} width={sx(1) - sx(0.5)} height={L.py[1] - L.py[0]} class="f-fill-green" />
        <text class="f-small f-t-green" x={sx(0.75)} y={L.py[0] + 18} text-anchor="middle">{t.easy}</text>
        {[1, 2, 3, 4].map((v) => <path class="f-grid" d={`M ${L.px[0]} ${sy(v)} H ${L.px[1]}`} />)}
        <path class="f-axis" d={`M ${L.px[0]} ${L.py[0]} V ${L.py[1]} H ${L.px[1]}`} />
        {[0, 0.2, 0.4, 0.6, 0.8, 1].map((v) => <text class="f-note" x={sx(v)} y={L.py[1] + 18} text-anchor="middle">{v}</text>)}
        {[0, 1, 2, 3, 4].map((v) => <text class="f-note" x={L.px[0] - 7} y={sy(v) + 5} text-anchor="end">{v}</text>)}
        <text class="f-small" x={(L.px[0] + L.px[1]) / 2} y={L.py[1] + 40} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.px[0]} y={L.py[0] - 10}>{t.y}</text>
        {gammas.map(([g, c]) => <path class={`f-line ${c}`} d={plot(fl(g), Math.exp(-4), 1, sx, sy, 240)} />)}
        <circle cx={sx(0.9)} cy={sy(fl(0)(0.9))} r="3.5" class="f-solid-muted" />
        <path class="f-thin f-muted" d={`M ${sx(0.9)} ${sy(fl(0)(0.9)) - 6} V ${sy(L.nl)}`} />
        <text class="f-small f-halo" x={sx(0.9)} y={sy(L.nl) - 6} text-anchor="end">{t.note}</text>
        {gammas.map(([g, c], i) => {
          // wide: one column; narrow: cross-entropy on the first row, then two columns
          const lx = L.lx + (L.sfx === 'n' && i ? ((i - 1) % 2) * 140 : 0);
          const ly = L.ly + (L.sfx === 'n' ? (i ? 1 + Math.floor((i - 1) / 2) : 0) * 22 : i * 24);
          return (
            <g>
              <path class={`f-line ${c}`} d={`M ${lx} ${ly - 4} h 24`} />
              <text class="f-small" x={lx + 32} y={ly}>{g === 0 ? t.ce : `γ = ${g}`}</text>
            </g>
          );
        })}
      </svg>
    );
  })}
</Figure>
