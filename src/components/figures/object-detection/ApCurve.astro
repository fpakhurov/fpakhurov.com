---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The worked example: four objects, seven detections by decreasing score, each with the object it overlaps most and the IoU.
// IoU (40 − d)/(40 + d) for 40 × 40 boxes shifted by d = 2, 9, 20, 8, 4, 12 pixels; the last detection overlaps nothing.
const dets: [number, number][] = [[1, 38 / 42], [2, 31 / 49], [3, 20 / 60], [1, 32 / 48], [3, 36 / 44], [4, 28 / 52], [0, 0]];
const nGt = 4;
function curve(thr: number) {
  const taken = new Set<number>();
  let hits = 0;
  const pts = dets.map(([g, v], k) => {
    const tp = g > 0 && v >= thr && !taken.has(g);
    if (tp) { taken.add(g); hits += 1; }
    return { tp, r: hits / nGt, p: hits / (k + 1) };
  });
  const env = pts.map((_, k) => Math.max(...pts.slice(k).map((x) => x.p)));
  let ap = 0, prev = 0;
  const steps: [number, number, number][] = [];
  pts.forEach((x, k) => { if (x.tp) { ap += (x.r - prev) * env[k]; steps.push([prev, x.r, env[k]]); prev = x.r; } });
  return { pts, ap, steps };
}
const c50 = curve(0.5), c75 = curve(0.75);
const q = [c50.ap.toFixed(3), c75.ap.toFixed(3), c50.pts.map((x) => x.p.toFixed(3)).join(',')].join(' ');
if (q !== '0.833 0.350 1.000,1.000,0.667,0.500,0.600,0.667,0.571') throw new Error(`ApCurve: values drifted (${q})`);

const t = ru
  ? { title: 'Средняя точность для примера из текста', x: 'полнота', y: 'точность', raw: 'точность на каждом ранге', e50: `IoU 0.5: AP = ${c50.ap.toFixed(3)}`, e75: `IoU 0.75: AP = ${c75.ap.toFixed(3)}`,
      desc: 'Кривые точность–полнота для семи детекций и четырёх объектов. Точки — точность и полнота после каждого ранга. Ступенчатые огибающие — интерполированная точность; площадь под ними равна AP: 0.833 при пороге IoU 0.5 и 0.350 при пороге 0.75.' }
  : { title: 'Average precision for the worked example', x: 'recall', y: 'precision', raw: 'precision at each rank', e50: `IoU 0.5: AP = ${c50.ap.toFixed(3)}`, e75: `IoU 0.75: AP = ${c75.ap.toFixed(3)}`,
      desc: 'Precision–recall curves for seven detections and four objects. The dots are precision and recall after each rank. The staircase envelopes are the interpolated precision; the area under each is the AP: 0.833 at IoU threshold 0.5 and 0.350 at 0.75.' };
const id = 'det-ap';
const caption = ru
  ? 'Детекции идут по убыванию оценки; каждая верная поднимает полноту на 1/4, каждая ложная опускает точность. Интерполированная точность при данной полноте — лучшая точность при этой или большей полноте, отсюда ступеньки; AP — площадь под ними. При пороге 0.75 две из четырёх верных детекций становятся ложными, потому что их рамки прилегают к объектам недостаточно плотно, и AP падает с 0.833 до 0.350, хотя ранжирование то же.'
  : 'The detections come in order of decreasing score; each true positive raises recall by 1/4, each false positive lowers precision. The interpolated precision at a recall is the best precision at that recall or beyond, hence the staircase; AP is the area under it. At the threshold 0.75 two of the four true positives become false positives because their boxes are not tight enough, and AP falls from 0.833 to 0.350 with the same ranking.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 310, px: [80, 400] as [number, number], py: [30, 250] as [number, number], lx: 450, ly: 90 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 400, px: [56, 340] as [number, number], py: [30, 250] as [number, number], lx: 40, ly: 322 },
];
function helpers(L: (typeof layouts)[number]) {
  const sx = scale([0, 1], L.px), sy = scale([0, 1], [L.py[1], L.py[0]]);
  type C = typeof c50;
  // the staircase: a horizontal run at the interpolated precision for each recall step, joined by vertical risers
  const stair = (c: C) => c.steps.map(([a, b, h]) => `M ${sx(a)} ${sy(h)} H ${sx(b)}`).join(' ') + ' ' + c.steps.slice(1).map(([a], i) => `M ${sx(a)} ${sy(c.steps[i][2])} V ${sy(c.steps[i + 1][2])}`).join(' ');
  const area = (c: C) => c.steps.map(([a, b, h]) => `M ${sx(a)} ${sy(0)} V ${sy(h)} H ${sx(b)} V ${sy(0)} Z`).join(' ');
  const zig = (c: C) => [{ r: 0, p: 1 }, ...c.pts].map((x, i) => `${i ? 'L' : 'M'} ${sx(x.r)} ${sy(x.p)}`).join(' ');
  return { sx, sy, stair, area, zig };
}
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const { sx, sy, stair, area, zig } = helpers(L);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        <path d={area(c50)} class="f-fill-red" />
        <path d={area(c75)} class="f-fill-blue" />
        {[0.25, 0.5, 0.75, 1].map((v) => <path class="f-grid" d={`M ${L.px[0]} ${sy(v)} H ${L.px[1]} M ${sx(v)} ${L.py[0]} V ${L.py[1]}`} />)}
        <path class="f-axis" d={`M ${L.px[0]} ${L.py[0]} V ${L.py[1]} H ${L.px[1]}`} />
        {[0, 0.25, 0.5, 0.75, 1].map((v) => <text class="f-note" x={sx(v)} y={L.py[1] + 18} text-anchor="middle">{v}</text>)}
        {[0, 0.25, 0.5, 0.75, 1].map((v) => <text class="f-note" x={L.px[0] - 7} y={sy(v) + 5} text-anchor="end">{v}</text>)}
        <text class="f-small" x={(L.px[0] + L.px[1]) / 2} y={L.py[1] + 40} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.px[0]} y={L.py[0] - 12}>{t.y}</text>
        <path class="f-thin f-blue f-dot" d={zig(c75)} />
        <path class="f-thin f-red f-dot" d={zig(c50)} />
        <path class="f-line f-blue f-bold" d={stair(c75)} />
        <path class="f-line f-red f-bold" d={stair(c50)} />
        {c75.pts.map((x) => <circle cx={sx(x.r)} cy={sy(x.p)} r="3.5" class="f-solid-blue" />)}
        {c50.pts.map((x) => <circle cx={sx(x.r)} cy={sy(x.p)} r="3.5" class="f-solid-red" />)}
        <circle cx={L.lx + 10} cy={L.ly - 4} r="3.5" class="f-solid-muted" />
        <text class="f-small" x={L.lx + 30} y={L.ly}>{t.raw}</text>
        <path class="f-line f-red f-bold" d={`M ${L.lx} ${L.ly + 20} h 22`} />
        <text class="f-small" x={L.lx + 30} y={L.ly + 24}>{t.e50}</text>
        <path class="f-line f-blue f-bold" d={`M ${L.lx} ${L.ly + 44} h 22`} />
        <text class="f-small" x={L.lx + 30} y={L.ly + 48}>{t.e75}</text>
      </svg>
    );
  })}
</Figure>
