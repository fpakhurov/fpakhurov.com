---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The worked example: six boxes of one class, (x1, y1, x2, y2) and score; greedy NMS at IoU threshold 0.5.
type B = { n: string; b: number[]; s: number };
const boxes: B[] = [
  { n: 'A', b: [10, 10, 50, 50], s: 0.95 }, { n: 'B', b: [14, 12, 54, 52], s: 0.8 }, { n: 'C', b: [8, 14, 46, 54], s: 0.6 },
  { n: 'D', b: [60, 20, 100, 60], s: 0.9 }, { n: 'E', b: [64, 24, 104, 64], s: 0.55 }, { n: 'F', b: [40, 30, 80, 70], s: 0.5 },
];
const iou = (a: number[], b: number[]) => {
  const w = Math.max(0, Math.min(a[2], b[2]) - Math.max(a[0], b[0])), h = Math.max(0, Math.min(a[3], b[3]) - Math.max(a[1], b[1]));
  const i = w * h;
  return i / ((a[2] - a[0]) * (a[3] - a[1]) + (b[2] - b[0]) * (b[3] - b[1]) - i);
};
const by = (n: string) => boxes.find((x) => x.n === n)!;
const order = [...boxes].sort((a, b) => b.s - a.s);
const kept: B[] = [], removedBy: Record<string, string> = {};
for (const x of order) {
  const hit = kept.find((k) => iou(k.b, x.b) > 0.5);
  if (hit) removedBy[x.n] = hit.n; else kept.push(x);
}
const v = (a: string, b: string) => iou(by(a).b, by(b).b).toFixed(2);
const q = [order.map((x) => x.n).join(''), kept.map((x) => x.n).join(''), v('A', 'B'), v('A', 'C'), v('D', 'E'), v('A', 'F'), v('D', 'F')].join(' ');
if (q !== 'ADBCEF ADF 0.75 0.71 0.68 0.07 0.23') throw new Error(`NmsSteps: values drifted (${q})`);
// the step at which each box is decided
const stepOf: Record<string, number> = { A: 2, B: 2, C: 2, D: 3, E: 3, F: 4 };
// the kept box of each step carries the step's badge in the list
const badgeOf: Record<number, string> = Object.fromEntries(kept.map((x) => [stepOf[x.n], x.n]));

const t = ru
  ? {
      title: 'Подавление немаксимумов по шагам',
      head: 'по убыванию оценки', kept: (n: string) => (n === 'F' ? `оставлена: IoU ${v('A', 'F')} с A, ${v('D', 'F')} с D` : 'оставлена'),
      rem: (n: string) => `удалена: IoU с ${removedBy[n]} ${v(removedBy[n], n)}`,
      steps: ['отсортировать рамки по оценке', 'оставить лучшую, A; удалить B и C: их IoU с A больше 0.5', 'лучшая из оставшихся, D, остаётся; E удаляется', 'F ни с одной оставленной рамкой не перекрывается больше чем на 0.5 и остаётся'],
      desc: 'Шесть рамок одного класса: три сильно перекрывающиеся вокруг первого объекта (A 0.95, B 0.80, C 0.60), две вокруг второго (D 0.90, E 0.55) и рамка F 0.50 между ними. Жадное подавление с порогом 0.5 оставляет A, D и F и удаляет B, C и E.',
    }
  : {
      title: 'Non-maximum suppression, step by step',
      head: 'by decreasing score', kept: (n: string) => (n === 'F' ? `kept: IoU ${v('A', 'F')} with A, ${v('D', 'F')} with D` : 'kept'),
      rem: (n: string) => `removed: IoU with ${removedBy[n]} ${v(removedBy[n], n)}`,
      steps: ['sort the boxes by score', 'keep the best, A; remove B and C, whose IoU with A exceeds 0.5', 'the best remaining box, D, is kept; E is removed', 'F overlaps no kept box by more than 0.5: it is kept'],
      desc: 'Six boxes of one class: three heavily overlapping ones around the first object (A 0.95, B 0.80, C 0.60), two around the second (D 0.90, E 0.55), and a box F 0.50 between them. Greedy suppression at threshold 0.5 keeps A, D and F and removes B, C and E.',
    };
const id = 'det-nms';
const caption = ru
  ? 'Пример из текста, порог IoU 0.5. Каждый шаг берёт лучшую из оставшихся рамок и удаляет всё, что перекрывает её сильнее порога; сравнение идёт только с оставленными рамками. F остаётся, хотя пересекается с A и D: оба перекрытия небольшие. Порог управляет компромиссом: при 0.7 выжила бы и E (IoU 0.68 с D) — дубликат, а при 0.2 исчезла бы F (0.23 с D), которая может быть отдельным объектом.'
  : 'The worked example of the text, IoU threshold 0.5. Each step takes the best remaining box and removes everything that overlaps it by more than the threshold; boxes are compared only with kept ones. F survives although it touches A and D: its overlaps are small. The threshold sets the trade-off: at 0.7, E (IoU 0.68 with D) would also survive as a duplicate, and at 0.2, F (0.23 with D), which might be a separate object, would go.';

const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 272, ox: 20, oy: 34, bx: 372, nx: 390, dx: 476, hy: 44, ry: 72 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 466, ox: 4, oy: 22, bx: 14, nx: 32, dx: 100, hy: 290, ry: 318 },
];
// label anchor per box: [x, y, text-anchor] in scene units, outside the crowded area
const labelAt: Record<string, [number, number, string]> = { A: [10, 7, 'start'], B: [56, 18, 'start'], C: [8, 60, 'start'], D: [100, 17, 'end'], E: [104, 69, 'end'], F: [40, 75, 'start'] };
function helpers(L: (typeof layouts)[number]) {
  const X = (u: number) => L.ox + 3 * u, Y = (u: number) => L.oy + 3 * u;
  const r = (b: number[]) => ({ x: X(b[0]), y: Y(b[1]), width: 3 * (b[2] - b[0]), height: 3 * (b[3] - b[1]) });
  const rowY = (n: string) => L.ry + order.findIndex((x) => x.n === n) * 26;
  return { X, Y, r, rowY };
}
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const { X, Y, r, rowY } = helpers(L);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {boxes.map((x) => <rect {...r(x.b)} class="f-thin" style="fill: none" />)}
        {boxes.map((x) => {
          const [lx, ly, anchor] = labelAt[x.n];
          return <text class="f-small" x={X(lx)} y={Y(ly)} text-anchor={anchor}>{`${x.n} ${x.s.toFixed(2)}`}</text>;
        })}
        {[2, 3, 4].map((s) => (
          <g data-s={String(s)}>
            {boxes.filter((x) => stepOf[x.n] === s).map((x) => removedBy[x.n]
              ? <rect {...r(x.b)} class="f-line f-muted f-dash" style="fill: none" />
              : <rect {...r(x.b)} class="f-line f-red f-bold f-fill-red" />)}
          </g>
        ))}
        <g data-s="1">
          <text class="f-small f-t-muted" x={L.nx} y={L.hy}>{t.head}</text>
          {order.map((x) => <text class="f-small" x={L.nx} y={rowY(x.n)}>{`${x.n} ${x.s.toFixed(2)}`}</text>)}
          <Badge x={L.bx} y={L.hy - 4} n={1} />
        </g>
        {[2, 3, 4].map((s) => (
          <g data-s={String(s)}>
            {order.filter((x) => stepOf[x.n] === s).map((x) => (
              <text class={`f-small ${removedBy[x.n] ? 'f-t-muted' : 'f-t-red'}`} x={L.dx} y={rowY(x.n)}>{removedBy[x.n] ? t.rem(x.n) : t.kept(x.n)}</text>
            ))}
            <Badge x={L.bx} y={rowY(badgeOf[s]) - 4} n={s} />
          </g>
        ))}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
