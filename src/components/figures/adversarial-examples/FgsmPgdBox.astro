---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale, polyline, plot } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A two-pixel toy: the input is x = (0, 0), the budget ε = 1, so the allowed inputs are the box [−1, 1]².
// The margin of the true class is m(u) = 1.5 − u1 − 0.3 u2 + 0.9 u1 u2 and the loss L = log(1 + e^(−m)).
// The prediction is wrong where m < 0. PGD starts at x (no random start, for clarity) with steps α = ε/4.
const m = (u1: number, u2: number) => 1.5 - u1 - 0.3 * u2 + 0.9 * u1 * u2;
const loss = (mm: number) => Math.log(1 + Math.exp(-mm));
const gradL = (u1: number, u2: number): [number, number] => [1 - 0.9 * u2, 0.3 - 0.9 * u1];   // ∇(−m), same signs as ∇L
const sgn = (v: number) => (v > 0 ? 1 : v < 0 ? -1 : 0);
const clip = (v: number) => Math.max(-1, Math.min(1, v));
const eps = 1, alpha = 0.25;
const g0 = gradL(0, 0);
const fgsm: [number, number] = [eps * sgn(g0[0]), eps * sgn(g0[1])];
const path: [number, number][] = [[0, 0]];
const raw: [number, number][] = [];
for (let k = 0; k < 8; k += 1) {
  const [a, b] = path[path.length - 1];
  const g = gradL(a, b);
  const r: [number, number] = [a + alpha * sgn(g[0]), b + alpha * sgn(g[1])];
  raw.push(r);
  path.push([clip(r[0]), clip(r[1])]);
}
const end = path[path.length - 1];
const firstOut = raw.findIndex((r) => Math.abs(r[0]) > 1 || Math.abs(r[1]) > 1);   // the first step that leaves the box
const check = [fgsm.join(','), end.join(','), firstOut, m(0, 0), m(...fgsm).toFixed(2), m(...end).toFixed(2),
  loss(m(0, 0)).toFixed(3), loss(m(...fgsm)).toFixed(3), loss(m(...end)).toFixed(3)].join(' ');
if (check !== '1,1 1,-1 4 1.5 1.10 -0.10 0.201 0.287 0.744') throw new Error(`FgsmPgdBox: the toy drifted (${check})`);
// the true maximum of the loss over the box is at the corner PGD reaches (m is bilinear, so the extremes are corners)
const corners: [number, number][] = [[1, 1], [1, -1], [-1, 1], [-1, -1]];
if (Math.min(...corners.map((c) => m(...c))) !== m(...end)) throw new Error('FgsmPgdBox: PGD does not end at the worst corner');

const D1: [number, number] = [-1.45, 1.6], D2: [number, number] = [-1.45, 1.45];
// level set m = c, solved for u2; NaN outside the drawn range so that the path breaks there
const level = (c: number) => (u1: number) => {
  const u2 = (u1 - 1.5 + c) / (0.9 * u1 - 0.3);
  return Math.abs(u2) <= D2[1] ? u2 : NaN;
};
const u1Edge = 1.935 / 2.305;   // where the boundary m = 0 meets u2 = −1.45
if (Math.abs(level(0)(u1Edge + 1e-9) + 1.45) > 1e-6) throw new Error('FgsmPgdBox: boundary edge point drifted');

// The level sets are hyperbolas with a vertical asymptote at u1 = 1/3; sample u1 geometrically towards it so the steep parts are drawn.
const contour = (c: number, sx: (v: number) => number, sy: (v: number) => number) => [-1, 1].map((side) => {
  const reach = side > 0 ? D1[1] - 1 / 3 : 1 / 3 - D1[0];
  const pts = Array.from({ length: 401 }, (_, k) => 1 / 3 + side * Math.exp(Math.log(1e-4) + (k / 400) * (Math.log(reach) - Math.log(1e-4))));
  let pen = false;
  return pts.map((u1) => {
    const u2 = level(c)(u1);
    if (!Number.isFinite(u2)) { pen = false; return ''; }
    const seg = `${pen ? 'L' : 'M'} ${sx(u1).toFixed(2)} ${sy(u2).toFixed(2)}`;
    pen = true;
    return seg;
  }).join(' ');
}).join(' ');

const t = ru
  ? {
      title: 'FGSM и PGD в области допустимых возмущений',
      grad: '∇ₓL', box: '‖x′ − x‖∞ ≤ ε', wrong: 'ошибка',
      legBox: 'допустимые входы', legWrong: 'сеть ошибается', legLevel: 'линии уровня функции потерь',
      rx: `x: потери ${loss(1.5).toFixed(3)}`, rf: `FGSM: ${loss(1.1).toFixed(3)}, класс ещё верный`, rp: `PGD, 8 шагов: ${loss(-0.1).toFixed(3)}, класс неверный`,
      steps: ['градиент в x направлен вправо и чуть вверх', 'FGSM: шаг ε по знаку градиента — в верхний правый угол', 'PGD: шаги размера α; справа вертикальная компонента градиента меняет знак', 'шаг за пределы квадрата проецируется обратно', 'PGD заканчивает путь в нижнем правом углу, за границей решения'],
      desc: 'Квадрат допустимых входов вокруг x, граница решения и красная область, где сеть ошибается, в правом нижнем углу. FGSM за один шаг приходит в верхний правый угол, где потери равны 0.287, а класс ещё верный. PGD шагами по четверти ε идёт вправо и вверх, затем вниз вдоль правой стороны квадрата и заканчивает путь в нижнем правом углу с потерями 0.744, за границей.',
    }
  : {
      title: 'FGSM and PGD inside the box of allowed perturbations',
      grad: '∇ₓL', box: '‖x′ − x‖∞ ≤ ε', wrong: 'wrong',
      legBox: 'allowed inputs', legWrong: 'network is wrong', legLevel: 'contours of the loss',
      rx: `x: loss ${loss(1.5).toFixed(3)}`, rf: `FGSM: ${loss(1.1).toFixed(3)}, still correct`, rp: `PGD, 8 steps: ${loss(-0.1).toFixed(3)}, wrong`,
      steps: ['the gradient at x points right and slightly up', 'FGSM: a step of ε along the gradient’s sign, to the top-right corner', 'PGD: steps of α; on the right, the vertical gradient changes sign', 'a step that leaves the box is projected back', 'PGD ends at the bottom-right corner, across the decision boundary'],
      desc: 'The square of allowed inputs around x, the decision boundary and, in the bottom right, the red region where the network is wrong. FGSM reaches the top-right corner in one step, where the loss is 0.287 and the class is still correct. PGD, in steps of a quarter of ε, goes right and up, then down along the right side of the square, and ends at the bottom-right corner with loss 0.744, across the boundary.',
    };
const id = 'adv-fgsm-pgd-box';
const caption = ru
  ? 'Игрушечный пример с двумя пикселями: вход x в центре, бюджет ε, допустимые входы — квадрат (синий). Отступ (margin) верного класса m(u) = 1.5 − u₁ − 0.3u₂ + 0.9u₁u₂, функция потерь L = log(1 + e^(−m)); там, где m < 0, сеть ошибается. Пунктир — линии уровня функции потерь через x, через угол FGSM и через четвёртую точку PGD. FGSM доверяет линейному приближению во всём квадрате и прыгает в угол по знаку градиента в x. PGD делает 8 шагов размера α = ε/4 из x (без случайного старта, для наглядности), пересчитывает градиент на каждом шаге и находит угол с наибольшими потерями.'
  : 'A two-pixel toy: the input x at the centre, the budget ε, the allowed inputs a square (blue). The margin of the true class is m(u) = 1.5 − u₁ − 0.3u₂ + 0.9u₁u₂ and the loss L = log(1 + e^(−m)); where m < 0 the network is wrong. Dashed: contours of the loss through x, through the FGSM corner and through the fourth PGD point. FGSM trusts the linear approximation over the whole square and jumps to the corner given by the gradient’s sign at x. PGD takes 8 steps of size α = ε/4 from x (no random start, for clarity), recomputes the gradient at every step, and finds the corner with the highest loss.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 352, px: [40, 360] as [number, number], py: [24, 328] as [number, number], panel: [404, 70] as [number, number], gap: 26 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 548, px: [24, 344] as [number, number], py: [16, 320] as [number, number], panel: [24, 360] as [number, number], gap: 26 },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => {
    const sx = scale(D1, Ly.px), sy = scale(D2, [Ly.py[1], Ly.py[0]]);
    const P = (u: [number, number]) => [sx(u[0]), sy(u[1])] as [number, number];
    const region = `${plot(level(0), u1Edge + 1e-6, D1[1], sx, sy, 80)} L ${sx(D1[1])} ${sy(D2[0])} L ${sx(u1Edge)} ${sy(D2[0])} Z`;
    const gl = Math.hypot(g0[0], g0[1]);
    const gEnd: [number, number] = [0.62 * g0[0] / gl, 0.62 * g0[1] / gl];
    const [lx, ly] = Ly.panel;
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
        <rect x={Ly.px[0]} y={Ly.py[0]} width={Ly.px[1] - Ly.px[0]} height={Ly.py[1] - Ly.py[0]} class="f-box-soft" />
        <path class="f-fill-red" d={region} />
        <rect x={sx(-1)} y={sy(1)} width={sx(1) - sx(-1)} height={sy(-1) - sy(1)} class="f-fill-blue" style="stroke: var(--fig-blue); stroke-width: 1.4" />
        {[1.5, 1.1, 0.5].map((c) => <path class="f-thin f-muted f-dash" d={contour(c, sx, sy)} />)}
        <path class="f-line f-red" d={plot(level(0), u1Edge + 1e-6, D1[1], sx, sy, 80)} />
        <text class="f-small f-t-red f-halo" x={sx(1.56)} y={sy(-1.32)} text-anchor="end">{t.wrong}</text>
        <text class="f-small f-t-blue f-halo" x={sx(-0.95)} y={sy(-0.85)}>{t.box}</text>
        <g data-s="1">
          <path class="f-line f-green" d={`M ${sx(0)} ${sy(0)} L ${sx(gEnd[0])} ${sy(gEnd[1])}`} marker-end="url(#f-arrow-green)" />
          <text class="f-small f-t-green f-halo" x={sx(gEnd[0]) + 4} y={sy(gEnd[1]) + 16}>{t.grad}</text>
          <Badge x={sx(-0.25)} y={sy(-0.3)} n={1} />
        </g>
        <g data-s="2">
          <path class="f-line f-amber f-dash" d={`M ${sx(0)} ${sy(0)} L ${sx(fgsm[0]) - 7} ${sy(fgsm[1]) + 7}`} marker-end="url(#f-arrow-amber)" />
          <circle cx={sx(fgsm[0])} cy={sy(fgsm[1])} r="5.5" style="fill: var(--fig-amber)" />
          <text class="f-small f-t-amber f-halo" x={sx(fgsm[0]) - 10} y={sy(fgsm[1]) - 10} text-anchor="end">FGSM</text>
          <Badge x={sx(1.3)} y={sy(1.32)} n={2} />
        </g>
        <g data-s="3">
          <path class="f-line" d={polyline(path.slice(0, firstOut + 1).map(P))} />
          {path.slice(1, firstOut + 1).map((u) => <circle cx={sx(u[0])} cy={sy(u[1])} r="3.5" class="f-fill-ink" />)}
          <text class="f-small f-halo" x={sx(0.5) - 10} y={sy(0.5) - 10} text-anchor="end">PGD</text>
          <Badge x={sx(0.86)} y={sy(0.42)} n={3} />
        </g>
        <g data-s="4">
          <path class="f-thin f-dash" d={`M ${sx(1)} ${sy(0)} L ${sx(raw[firstOut][0])} ${sy(raw[firstOut][1])}`} />
          <circle cx={sx(raw[firstOut][0])} cy={sy(raw[firstOut][1])} r="3.5" class="f-fill-paper" style="stroke: var(--ink); stroke-width: 1.2" />
          <path class="f-thin" d={`M ${sx(raw[firstOut][0]) - 4} ${sy(raw[firstOut][1])} L ${sx(1) + 6} ${sy(path[firstOut + 1][1])}`} marker-end="url(#f-arrow)" />
          <Badge x={sx(1.42)} y={sy(0.25)} n={4} />
        </g>
        <g data-s="5">
          <path class="f-line" d={polyline(path.slice(firstOut + 1).map(P))} />
          {path.slice(firstOut + 1).map((u) => <circle cx={sx(u[0])} cy={sy(u[1])} r="3.5" class="f-fill-ink" />)}
          <circle cx={sx(end[0])} cy={sy(end[1])} r="6" class="f-fill-ink" />
          <Badge x={sx(1.3)} y={sy(-0.85)} n={5} />
        </g>
        <circle cx={sx(0)} cy={sy(0)} r="5.5" class="f-solid-green" />
        <text class="f-label f-halo" x={sx(0) - 10} y={sy(0) + 5} text-anchor="end">x</text>
        <rect x={lx} y={ly - 11} width="16" height="12" class="f-fill-blue" style="stroke: var(--fig-blue); stroke-width: 1.2" />
        <text class="f-small" x={lx + 24} y={ly}>{t.legBox}</text>
        <rect x={lx} y={ly + Ly.gap - 11} width="16" height="12" class="f-fill-red" style="stroke: var(--fig-red); stroke-width: 1.2" />
        <text class="f-small" x={lx + 24} y={ly + Ly.gap}>{t.legWrong}</text>
        <path class="f-thin f-muted f-dash" d={`M ${lx} ${ly + 2 * Ly.gap - 4} h 16`} />
        <text class="f-small" x={lx + 24} y={ly + 2 * Ly.gap}>{t.legLevel}</text>
        <circle cx={lx + 8} cy={ly + 3.5 * Ly.gap - 4} r="5" class="f-solid-green" />
        <text class="f-small" x={lx + 24} y={ly + 3.5 * Ly.gap}>{t.rx}</text>
        <circle cx={lx + 8} cy={ly + 4.5 * Ly.gap - 4} r="5" style="fill: var(--fig-amber)" />
        <text class="f-small" x={lx + 24} y={ly + 4.5 * Ly.gap}>{t.rf}</text>
        <circle cx={lx + 8} cy={ly + 5.5 * Ly.gap - 4} r="5" class="f-fill-ink" />
        <text class="f-small" x={lx + 24} y={ly + 5.5 * Ly.gap}>{t.rp}</text>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
