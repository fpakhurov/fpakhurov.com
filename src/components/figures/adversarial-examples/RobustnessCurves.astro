---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The Code section of the note (one training run): a 64 -> 256 -> 256 -> 10 network on the 8 x 8 digits, 540 test images.
// Accuracy against the budget eps for random signs of size eps, FGSM, 20-step PGD, FGSM computed on another network
// (transfer), and 20-step PGD against the same network adversarially trained with PGD at eps = 0.2.
const eps = [0, 0.05, 0.1, 0.15, 0.2, 0.25, 0.3];
const noise = [0.965, 0.972, 0.956, 0.939, 0.93, 0.869, 0.806];
const fgsm = [0.965, 0.815, 0.461, 0.12, 0.013, 0.002, 0.002];
const pgd = [0.965, 0.807, 0.43, 0.072, 0.002, 0, 0];
const transfer = [0.965, 0.833, 0.55, 0.169, 0.024, 0, 0];
const robust = [0.944, 0.9, 0.824, 0.715, 0.539, 0.311, 0.107];
if (pgd.some((v, i) => v > fgsm[i]) || fgsm.some((v, i) => v > transfer[i] + 1e-9 && i > 0 && i < 5))
  throw new Error('RobustnessCurves: the white-box attacks should be at least as strong as transfer, PGD at least as strong as FGSM');
const quoted = [pgd[2], robust[0], robust[2], robust[4], robust[6], transfer[2], noise[2]].join(' ');
if (quoted !== '0.43 0.944 0.824 0.539 0.107 0.55 0.956') throw new Error(`RobustnessCurves: numbers drifted from the note (${quoted})`);

const t = ru
  ? { title: 'Доля правильных ответов под атакой: обычная и состязательно обученная сеть', x: 'бюджет ε', y: 'доля правильных ответов', train: 'ε обучения',
      series: ['случайные знаки', 'FGSM', 'PGD, 20 шагов', 'перенос с другой сети', 'состязательное обучение, PGD'],
      desc: 'Доля правильных ответов на тесте в зависимости от бюджета ε от 0 до 0.3. Случайный шум почти не вредит: 0.806 при 0.3. FGSM, PGD и перенос с другой сети опускают долю правильных ответов обычной сети почти до нуля к ε = 0.2. Сеть, обученная на примерах PGD с ε = 0.2, сохраняет 0.539 при ε = 0.2 и 0.944 без атаки.' }
  : { title: 'Accuracy under attack: a standard and an adversarially trained network', x: 'budget ε', y: 'test accuracy', train: 'training ε',
      series: ['random signs', 'FGSM', 'PGD, 20 steps', 'transfer from another net', 'adversarially trained, PGD'],
      desc: 'Test accuracy against the budget ε from 0 to 0.3. Random noise barely hurts: 0.806 at 0.3. FGSM, PGD and transfer from another network bring the standard network close to zero by ε = 0.2. The network trained on PGD examples with ε = 0.2 keeps 0.539 at ε = 0.2 and 0.944 without attack.' };
const styles = [
  { cls: 'f-line f-muted f-dash', dot: 'f-solid-muted', data: noise },
  { cls: 'f-line f-amber', dot: '', data: fgsm },
  { cls: 'f-line f-red', dot: 'f-solid-red', data: pgd },
  { cls: 'f-line f-blue f-dash', dot: 'f-solid-blue', data: transfer },
  { cls: 'f-line f-green f-bold', dot: 'f-solid-green', data: robust },
];
const id = 'adv-robustness-curves';
const caption = ru
  ? 'Сеть 64 → 256 → 256 → 10 на цифрах 8 × 8, 540 тестовых изображений, один запуск из раздела «Код». Серая линия — случайные знаки ±ε в каждом пикселе; жёлтая, красная и синяя линии — FGSM, PGD с 20 шагами и FGSM, посчитанный на другой сети 64 → 512 → 10 (перенос). Зелёная — PGD против той же архитектуры, обученной на примерах PGD с ε = 0.2 (вертикальная линия). Цена устойчивости — 2.1 пункта доли правильных ответов без атаки (0.944 против 0.965); защита слабеет за пределами ε обучения.'
  : 'A 64 → 256 → 256 → 10 network on the 8 × 8 digits, 540 test images, one run of the Code section. Grey: random signs ±ε in every pixel; amber, red and blue: FGSM, 20-step PGD, and FGSM computed on another network, 64 → 512 → 10 (transfer). Green: PGD against the same architecture trained on PGD examples with ε = 0.2 (vertical line). Robustness costs 2.1 points of clean accuracy (0.944 against 0.965), and the protection fades beyond the training ε.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 320, px: [70, 500] as [number, number], py: [30, 250] as [number, number], leg: [526, 58] as [number, number] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 430, px: [56, 340] as [number, number], py: [30, 250] as [number, number], leg: [20, 316] as [number, number] },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => {
    const sx = scale([0, 0.3], Ly.px), sy = scale([0, 1], [Ly.py[1], Ly.py[0]]);
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
        {[0.25, 0.5, 0.75, 1].map((v) => <path class="f-grid" d={`M ${Ly.px[0]} ${sy(v)} H ${Ly.px[1]}`} />)}
        <path class="f-axis" d={`M ${Ly.px[0]} ${Ly.py[0]} V ${Ly.py[1]} H ${Ly.px[1]}`} />
        {[0, 0.1, 0.2, 0.3].map((v) => <text class="f-note" x={sx(v)} y={Ly.py[1] + 18} text-anchor="middle">{v === 0 ? '0' : v.toFixed(1)}</text>)}
        {[0, 0.5, 1].map((v) => <text class="f-note" x={Ly.px[0] - 7} y={sy(v) + 5} text-anchor="end">{v === 0 ? '0' : v.toFixed(1)}</text>)}
        <text class="f-small f-t-muted" x={(Ly.px[0] + Ly.px[1]) / 2} y={Ly.py[1] + 40} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={Ly.px[0] - 44} y={Ly.py[0] - 14}>{t.y}</text>
        <path class="f-thin f-green f-dot" d={`M ${sx(0.2)} ${Ly.py[0]} V ${Ly.py[1]}`} />
        <text class="f-small f-t-green f-halo" x={sx(0.2)} y={Ly.py[0] - 8} text-anchor="middle">{t.train}</text>
        {styles.map((s) => (
          <g>
            <path class={s.cls} d={polyline(eps.map((e, i) => [sx(e), sy(s.data[i])]))} />
            {eps.map((e, i) => <circle cx={sx(e)} cy={sy(s.data[i])} r="3.2" class={s.dot} style={s.dot ? undefined : 'fill: var(--fig-amber)'} />)}
          </g>
        ))}
        <text class="f-small f-t-green f-halo" x={sx(0.2) + 8} y={sy(robust[4]) - 8}>{robust[4].toFixed(3)}</text>
        {styles.map((s, i) => (
          <g>
            <path class={s.cls} d={`M ${Ly.leg[0]} ${Ly.leg[1] + 24 * i - 4} h 26`} />
            <text class="f-small" x={Ly.leg[0] + 34} y={Ly.leg[1] + 24 * i}>{t.series[i]}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
