---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Polynomials of degree 0..11 fitted by least squares to n = 12 equally spaced inputs on [0, 1], y = sin(2πx) + ε,
// ε ~ N(0, 0.3²). Both curves are exact expectations over the noise, no simulation:
//   E[training MSE] = (‖(I − H)m‖² + σ²(n − p)) / n,  H the hat matrix, m the true values at the inputs, p = degree + 1;
//   E[test MSE]     = σ² + ∫₀¹ (E f̂(x) − m(x))² dx + σ² ∫₀¹ ‖R⁻ᵀ g(x)‖² dx,  Φ = QR, g(x) the basis at x,
// with a new input X ~ U(0, 1). Basis: Legendre polynomials of 2x − 1; QR by modified Gram–Schmidt; Simpson's rule.
const n = 12, s2 = 0.09, m = (x: number) => Math.sin(2 * Math.PI * x);
const xs = Array.from({ length: n }, (_, i) => i / (n - 1));
const legendre = (x: number, p: number) => {
  const t = 2 * x - 1, out = [1, t];
  for (let k = 1; k < p - 1; k++) out.push(((2 * k + 1) * t * out[k] - k * out[k - 1]) / (k + 1));
  return out.slice(0, p);
};
const N = 2000, h = 1 / N;
const simpson = (f: (x: number) => number) => {
  let s = f(0) + f(1);
  for (let i = 1; i < N; i++) s += (i % 2 ? 4 : 2) * f(i * h);
  return (s * h) / 3;
};
const errors = (deg: number) => {
  const p = deg + 1;
  const Q = xs.map((x) => legendre(x, p)), R = Array.from({ length: p }, () => new Array(p).fill(0));
  for (let j = 0; j < p; j++) {
    for (let i = 0; i < j; i++) {
      let d = 0; for (let r = 0; r < n; r++) d += Q[r][i] * Q[r][j];
      R[i][j] = d; for (let r = 0; r < n; r++) Q[r][j] -= d * Q[r][i];
    }
    let nn = 0; for (let r = 0; r < n; r++) nn += Q[r][j] ** 2;
    nn = Math.sqrt(nn); R[j][j] = nn; for (let r = 0; r < n; r++) Q[r][j] /= nn;
  }
  const mt = xs.map(m);
  const qtm = Array.from({ length: p }, (_, j) => mt.reduce((s, v, r) => s + Q[r][j] * v, 0));
  const resid = mt.reduce((s, v, r) => s + (v - qtm.reduce((a, q, j) => a + Q[r][j] * q, 0)) ** 2, 0);
  const c = new Array(p).fill(0);
  for (let j = p - 1; j >= 0; j--) { let s = qtm[j]; for (let i = j + 1; i < p; i++) s -= R[j][i] * c[i]; c[j] = s / R[j][j]; }
  const sqVar = (x: number) => {
    const g = legendre(x, p), v = new Array(p).fill(0);
    for (let i = 0; i < p; i++) { let s = g[i]; for (let k = 0; k < i; k++) s -= R[k][i] * v[k]; v[i] = s / R[i][i]; }
    return v.reduce((a, b) => a + b * b, 0);
  };
  const bias2 = simpson((x) => (legendre(x, p).reduce((a, b, j) => a + b * c[j], 0) - m(x)) ** 2);
  return { train: (resid + s2 * (n - p)) / n, test: s2 + bias2 + s2 * simpson(sqVar) };
};
const degs = Array.from({ length: 12 }, (_, d) => d);
const E = degs.map(errors);
const r3 = (v: number) => v.toFixed(3);
const quoted = [E[3].train, E[3].test, E[9].train, E[9].test, E[10].test, E[11].train].map(r3).join() + ',' + E[11].test.toFixed(2);
if (quoted !== '0.067,0.121,0.015,0.208,0.421,0.000,3.16') throw new Error(`FitVsGeneralize: numbers drifted from the note (${quoted})`);
const best = degs.reduce((b, d) => (E[d].test < E[b].test ? d : b), 0);
if (best !== 3) throw new Error('FitVsGeneralize: the best degree moved');
const yMax = 0.65;
const clipped = E.map((e) => Math.min(e.test, yMax));
const t = ru
  ? { x: 'степень многочлена', y: 'среднеквадратичная ошибка', train: 'на обучении', test: 'на новых данных', floor: 'шум 0.09', best: 'минимум: степень 3, 0.121', bestN: 'минимум 0.121', zero: '0 при степени 11', up: '3.16' }
  : { x: 'degree of the polynomial', y: 'mean squared error', train: 'training', test: 'new data', floor: 'noise 0.09', best: 'smallest at degree 3: 0.121', bestN: 'smallest: 0.121', zero: '0 at degree 11', up: '3.16' };
const id = 'fit-vs-generalize';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 330, x0: 58, x1: 580, y0: 24, y1: 270, narrow: false },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 330, x0: 44, x1: 346, y0: 24, y1: 266, narrow: true },
];
---

<Figure
  id={id}
  title={ru ? 'Ошибка на обучении падает, ошибка на новых данных — нет' : 'Training error falls, error on new data does not'}
  caption={ru
    ? `Многочлены степени 0–11, подогнанные методом наименьших квадратов к 12 равноотстоящим точкам y = sin 2πx + шум (σ = 0.3). Обе кривые — точные математические ожидания по шуму. Ошибка на обучении падает с каждым коэффициентом и при степени 11 равна 0: многочлен проходит через все точки. Ошибка на новой точке X ~ U(0, 1) минимальна при степени 3 (${r3(E[3].test)}), равна ${r3(E[9].test)} при степени 9, ${r3(E[10].test)} при степени 10 и ${E[11].test.toFixed(2)} при степени 11. Пунктир — шум 0.09, ниже которого не может опуститься ошибка никакой модели на новых данных.`
    : `Polynomials of degree 0–11 fitted by least squares to 12 equally spaced points y = sin 2πx + noise (σ = 0.3). Both curves are exact expectations over the noise. The training error falls with every coefficient and is 0 at degree 11, where the polynomial passes through all the points. The error at a new point X ~ U(0, 1) is smallest at degree 3 (${r3(E[3].test)}), and is ${r3(E[9].test)} at degree 9, ${r3(E[10].test)} at degree 10 and ${E[11].test.toFixed(2)} at degree 11. The dashed line is the noise, 0.09, below which no model's error on new data can go.`}
>
  {layouts.map((L) => {
    const sx = scale([0, 11], [L.x0 + 10, L.x1 - 10]), sy = scale([0, yMax], [L.y1, L.y0]);
    const ticks = L.narrow ? [0, 3, 6, 9, 11] : degs;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Ошибка на обучении и на новых данных в зависимости от степени' : 'Training error and error on new data against the degree'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Синяя кривая ошибки на обучении монотонно падает до нуля; красная кривая ошибки на новых данных падает до степени 3 и затем растёт, уходя за верх графика при степени 11.' : 'The blue training-error curve falls steadily to zero; the red curve of the error on new data falls until degree 3 and then rises, leaving the top of the plot at degree 11.'}</desc>
        {[0, 0.2, 0.4, 0.6].map((v) => <g><path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} /><text class="f-note" x={L.x0 - 8} y={sy(v) + 5} text-anchor="end">{v}</text></g>)}
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {ticks.map((d) => <text class="f-note" x={sx(d)} y={L.y1 + 18} text-anchor="middle">{d}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 40} text-anchor="middle">{t.x}</text>
        <path class="f-thin f-muted f-dash" d={`M ${L.x0} ${sy(s2)} H ${L.x1}`} />
        <text class="f-note" x={L.x0 + 4} y={sy(s2) - 6}>{t.floor}</text>
        <path class="f-line f-blue" d={polyline(degs.map((d) => [sx(d), sy(E[d].train)]))} />
        <path class="f-line f-red" d={polyline(degs.map((d) => [sx(d), sy(clipped[d])]))} marker-end="url(#f-arrow-red)" />
        {degs.map((d) => <circle cx={sx(d)} cy={sy(E[d].train)} r="3.2" class="f-solid-blue" />)}
        {degs.filter((d) => d !== 11).map((d) => <circle cx={sx(d)} cy={sy(E[d].test)} r="3.2" class="f-solid-red" />)}
        <text class="f-note f-t-red" x={sx(11) - 14} y={L.y0 + 14} text-anchor="end">{t.up}</text>
        <text class="f-small f-t-red f-halo" x={sx(1.2)} y={sy(E[1].test) - 12}>{t.test}</text>
        <text class="f-small f-t-blue f-halo" x={sx(0.3)} y={sy(E[0].train) + 22}>{t.train}</text>
        <text class="f-note f-t-red f-halo" x={sx(3.3)} y={sy(0.215)}>{L.narrow ? t.bestN : t.best}</text>
        <text class="f-note f-t-blue f-halo" x={sx(10.6)} y={sy(0.045)} text-anchor="end">{t.zero}</text>
      </svg>
    );
  })}
</Figure>
