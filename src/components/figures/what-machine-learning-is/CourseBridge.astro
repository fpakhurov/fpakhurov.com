---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The course as a bridge, drawn from one data table: probability tools (left) feed groups of machine-learning notes
// (middle), which feed the places where the NLP and Generative Models courses use them (right). Node positions and
// edge curves are computed from the table; the assertions keep the table and the caption in step.
type Col = 0 | 1 | 2;
type Tone = 'p' | 'm' | 'nlp' | 'gm';
interface Node { id: string; col: Col; tone: Tone; en: [string, string]; ru: [string, string]; nen: string[]; nru: string[] }
const nodes: Node[] = [
  { id: 'exp', col: 0, tone: 'p', en: ['Expectation', 'risk is an expected loss'], ru: ['Матожидание', 'риск — ожидаемая потеря'], nen: ['Expectation'], nru: ['Матожидание'] },
  { id: 'conc', col: 0, tone: 'p', en: ['Concentration, LLN, CLT', 'why an average generalizes'], ru: ['Концентрация, ЗБЧ, ЦПТ', 'почему среднее обобщается'], nen: ['LLN, CLT,', 'concentration'], nru: ['ЗБЧ, ЦПТ,', 'концентрация'] },
  { id: 'cond', col: 0, tone: 'p', en: ['Conditional expectation', 'the best possible predictor'], ru: ['Условное матожидание', 'лучший возможный прогноз'], nen: ['Conditional', 'expectation'], nru: ['Условное', 'матожидание'] },
  { id: 'mle', col: 0, tone: 'p', en: ['Maximum likelihood', 'losses as log-likelihoods'], ru: ['Максимум правдоподобия', 'потери из правдоподобия'], nen: ['Maximum', 'likelihood'], nru: ['Максимум', 'правдоподобия'] },
  { id: 'bayes', col: 0, tone: 'p', en: ['Bayesian inference', 'priors become penalties'], ru: ['Байесовский вывод', 'априорное → штраф'], nen: ['Bayesian', 'inference'], nru: ['Байесовский', 'вывод'] },
  { id: 'gauss', col: 0, tone: 'p', en: ['Multivariate Gaussian', 'geometry of high dimension'], ru: ['Многомерное нормальное', 'многомерная геометрия'], nen: ['Multivariate', 'Gaussian'], nru: ['Многомерное', 'нормальное'] },

  { id: 'risk', col: 1, tone: 'm', en: ['Risk and empirical risk', 'this note'], ru: ['Риск и эмпирический риск', 'эта заметка'], nen: ['Empirical', 'risk'], nru: ['Эмпирич.', 'риск'] },
  { id: 'valid', col: 1, tone: 'm', en: ['Validation and metrics', 'error bars, selection bias'], ru: ['Валидация и метрики', 'погрешность и отбор'], nen: ['Validation,', 'metrics'], nru: ['Валидация,', 'метрики'] },
  { id: 'gd', col: 1, tone: 'm', en: ['Gradient descent, backprop', 'fitting by small steps'], ru: ['Градиентный спуск', 'backprop, обучение шагами'], nen: ['Gradients,', 'backprop'], nru: ['Градиенты,', 'backprop'] },
  { id: 'ls', col: 1, tone: 'm', en: ['Least squares', 'and the bias–variance split'], ru: ['Наименьшие квадраты', 'и смещение–разброс'], nen: ['Least', 'squares'], nru: ['Наименьшие', 'квадраты'] },
  { id: 'logreg', col: 1, tone: 'm', en: ['Logistic regression', 'probabilities and softmax'], ru: ['Логистическая регрессия', 'вероятности и softmax'], nen: ['Logistic,', 'softmax'], nru: ['Логистич.,', 'softmax'] },
  { id: 'reg', col: 1, tone: 'm', en: ['Regularization', 'ridge, lasso, weight decay'], ru: ['Регуляризация', 'ridge, lasso, weight decay'], nen: ['Ridge, lasso,', 'weight decay'], nru: ['Регуляри-', 'зация'] },
  { id: 'knn', col: 1, tone: 'm', en: ['Nearest neighbours', 'prediction by similarity'], ru: ['Ближайшие соседи', 'прогноз по сходству'], nen: ['Nearest', 'neighbours'], nru: ['Ближайшие', 'соседи'] },
  { id: 'em', col: 1, tone: 'm', en: ['PCA, mixtures and EM', 'structure without labels'], ru: ['PCA, смеси и EM', 'структура без разметки'], nen: ['PCA,', 'mixtures, EM'], nru: ['PCA,', 'смеси, EM'] },

  { id: 'eval', col: 2, tone: 'nlp', en: ['Evaluation and leakage', 'splits and errors in NLP'], ru: ['Оценка качества и утечки', 'разбиения и ошибки в NLP'], nen: ['Evaluation,', 'leakage'], nru: ['Оценка,', 'утечки'] },
  { id: 'train', col: 2, tone: 'nlp', en: ['Training RNNs, Transformers', 'gradients through time'], ru: ['Обучение нейросетей', 'RNN, трансформеры'], nen: ['Training', 'Transformers'], nru: ['Обучение', 'нейросетей'] },
  { id: 'textclf', col: 2, tone: 'nlp', en: ['Text classifiers', 'linear models on counts'], ru: ['Классификаторы текстов', 'линейные модели на словах'], nen: ['Text', 'classifiers'], nru: ['Классификация', 'текстов'] },
  { id: 'lm', col: 2, tone: 'nlp', en: ['Language models', 'next-token cross-entropy'], ru: ['Языковые модели', 'кросс-энтропия на токенах'], nen: ['Language', 'models'], nru: ['Языковые', 'модели'] },
  { id: 'kl', col: 2, tone: 'gm', en: ['Cross-entropy and KL', 'training generative models'], ru: ['Кросс-энтропия и KL', 'лосс генеративных моделей'], nen: ['Cross-entropy', 'and KL'], nru: ['Кросс-', 'энтропия, KL'] },
  { id: 'ft', col: 2, tone: 'nlp', en: ['Fine-tuning', 'weight decay on a big model'], ru: ['Дообучение', 'штраф на веса большой сети'], nen: ['Fine-tuning'], nru: ['Дообучение'] },
  { id: 'search', col: 2, tone: 'nlp', en: ['Semantic search', 'nearest embeddings'], ru: ['Семантический поиск', 'соседи среди эмбеддингов'], nen: ['Semantic', 'search'], nru: ['Семантический', 'поиск'] },
  { id: 'vae', col: 2, tone: 'gm', en: ['Autoencoders and VAEs', 'PCA and EM, made deep'], ru: ['Автоэнкодеры и VAE', 'глубокие PCA и EM'], nen: ['Autoencoders,', 'VAEs'], nru: ['Автоэнкодеры,', 'VAE'] },
];
const edges: [string, string][] = [
  ['exp', 'risk'], ['exp', 'gd'], ['conc', 'risk'], ['conc', 'valid'], ['cond', 'ls'], ['cond', 'knn'],
  ['mle', 'ls'], ['mle', 'logreg'], ['mle', 'em'], ['bayes', 'reg'], ['gauss', 'knn'], ['gauss', 'em'],
  ['valid', 'eval'], ['gd', 'train'], ['logreg', 'textclf'], ['logreg', 'lm'], ['logreg', 'kl'], ['reg', 'ft'], ['knn', 'search'], ['em', 'vae'],
];
const byId = new Map(nodes.map((n) => [n.id, n]));
const cols = [0, 1, 2].map((c) => nodes.filter((n) => n.col === c));
const counts = cols.map((c) => c.length);
const nlpCount = cols[2].filter((n) => n.tone === 'nlp').length, gmCount = cols[2].filter((n) => n.tone === 'gm').length;
if (counts.join() !== '6,8,8' || edges.length !== 20 || nlpCount !== 6 || gmCount !== 2) throw new Error('CourseBridge: the table no longer matches the caption');
for (const [a, b] of edges) {
  const A = byId.get(a), B = byId.get(b);
  if (!A || !B || B.col - A.col !== 1) throw new Error(`CourseBridge: bad edge ${a} → ${b}`);
}
for (const n of nodes) if (!edges.some(([a, b]) => a === n.id || b === n.id)) throw new Error(`CourseBridge: ${n.id} has no edge`);
// Text fit: an estimated width of 0.52 em per Latin and 0.56 em per Cyrillic character (bold +5%) must leave a margin
// in the box: 12.5 px text in the 200-wide boxes, 14 px text (seq-narrow) in the 108-wide boxes of the narrow layout.
const textWidth = (s: string, px: number) => [...s].reduce((w, ch) => w + (/[а-яё]/i.test(ch) ? 0.56 : 0.52) * px, 0);
for (const n of nodes) {
  for (const s of [...n.en, ...n.ru]) if (textWidth(s, 12.5) * 1.05 > 190) throw new Error(`CourseBridge: "${s}" is too long for a wide box`);
  for (const s of [...n.nen, ...n.nru]) if (textWidth(s, 14) > 102) throw new Error(`CourseBridge: "${s}" is too long for a narrow box`);
}

const tone = { p: 'var(--fig-blue)', m: 'var(--muted)', nlp: 'var(--fig-green)', gm: 'var(--fig-red)' } as const;
const edgeTone = (b: Node) => (b.tone === 'gm' ? 'red' : b.tone === 'nlp' ? 'green' : 'blue');
const heads = ru
  ? { wide: ['Теория вероятностей', 'Машинное обучение'], narrow: ['Теорвер', 'ML'], nlp: 'NLP', gm: 'генеративные модели', gmShort: 'ген.' }
  : { wide: ['Probability Theory', 'Machine Learning'], narrow: ['Probability', 'ML'], nlp: 'NLP', gm: 'Generative Models', gmShort: 'GM' };
const id = 'course-bridge';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 470, narrow: false, colX: [0, 280, 560], bw: 200, bh: 40, top: 46, pitch: 52 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 494, narrow: true, colX: [0, 126, 252], bw: 108, bh: 44, top: 40, pitch: 56 },
];
// Rows: the middle and right columns are evenly spaced; the left column is spread over the same height.
const place = (L: (typeof layouts)[number]) => {
  const span = (Math.max(counts[1], counts[2]) - 1) * L.pitch;
  const pos = new Map<string, { x: number; y: number }>();
  cols.forEach((c, ci) => c.forEach((n, i) => pos.set(n.id, { x: L.colX[ci], y: L.top + (c.length === 1 ? span / 2 : (i * span) / (c.length - 1)) })));
  return pos;
};
const curves = layouts.map((L) => {
  const pos = place(L);
  return edges.map(([a, b]) => {
    const A = pos.get(a)!, B = pos.get(b)!;
    const x1 = A.x + L.bw, y1 = A.y + L.bh / 2, x2 = B.x - 2, y2 = B.y + L.bh / 2, mx = (x1 + x2) / 2;
    return { d: `M ${x1} ${y1} C ${mx} ${y1} ${mx} ${y2} ${x2} ${y2}`, tone: edgeTone(byId.get(b)!) };
  });
});
const positions = layouts.map(place);
const cap = ru
  ? `Шесть инструментов теории вероятностей (слева) питают восемь групп заметок этого курса (в центре), а те — восемь мест, где ими пользуются курсы NLP (зелёные) и генеративных моделей (красные). Каждая из ${edges.length} линий — одна зависимость; таблица выше называет заметки за каждой.`
  : `Six tools of probability theory (left) feed eight groups of notes in this course (middle), and these feed eight places where the NLP course (green) and the Generative Models course (red) use them. Each of the ${edges.length} lines is one dependency; the table above names the notes behind each.`;
---

<Figure id={id} title={ru ? 'Курс как мост: от вероятности к NLP и генеративным моделям' : 'The course as a bridge: from probability to NLP and generative models'} caption={cap}>
  {layouts.map((L, li) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Три столбца: теория вероятностей, машинное обучение, NLP и генеративные модели' : 'Three columns: probability theory, machine learning, NLP and generative models'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Слева шесть понятий теории вероятностей, в центре восемь тем машинного обучения, справа восемь применений в NLP и генеративных моделях; линии соединяют понятие с темой, которая на нём построена, и тему с её применением.'
        : 'Left, six concepts of probability theory; middle, eight topics of machine learning; right, eight uses in NLP and generative models. Lines join each concept to the topic built on it and each topic to its uses.'}</desc>
      {[0, 1].map((c) => (
        <text class="f-small" x={L.colX[c] + L.bw / 2} y={L.top - 16} text-anchor="middle" style="font-weight: 650">{L.narrow ? heads.narrow[c] : heads.wide[c]}</text>
      ))}
      <text class="f-small" x={L.colX[2] + L.bw / 2} y={L.top - 16} text-anchor="middle" style="font-weight: 650">
        <tspan class="f-t-green">{heads.nlp}</tspan><tspan> · </tspan><tspan class="f-t-red">{L.narrow ? heads.gmShort : heads.gm}</tspan>
      </text>
      {curves[li].map((e) => (
        <path class={`f-thin f-${e.tone}`} style="stroke-opacity: .55" d={e.d} marker-end={`url(#f-arrow-${e.tone})`} />
      ))}
      {nodes.map((n) => {
        const p = positions[li].get(n.id)!;
        const c = tone[n.tone];
        const lines = L.narrow ? (ru ? n.nru : n.nen) : (ru ? n.ru : n.en);
        const cx = p.x + L.bw / 2;
        return (
          <g>
            <rect x={p.x} y={p.y} width={L.bw} height={L.bh} rx="7" style={`fill: ${n.tone === 'm' ? 'var(--paper-strong)' : c}; fill-opacity: ${n.tone === 'm' ? 1 : 0.13}; stroke: ${n.tone === 'm' ? 'var(--line)' : c}; stroke-width: 1.2`} />
            {L.narrow
              ? lines.map((s, i) => <text class="f-small" x={cx} y={p.y + L.bh / 2 + 5 + (i - (lines.length - 1) / 2) * 16} text-anchor="middle">{s}</text>)
              : [
                  <text class="f-small" x={cx} y={p.y + 17} text-anchor="middle" style="font-weight: 600">{lines[0]}</text>,
                  <text class="f-small f-t-muted" x={cx} y={p.y + 33} text-anchor="middle">{lines[1]}</text>,
                ]}
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
