---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The burglar alarm: B and E independent causes of the alarm A, the radio R reports earthquakes.
// The beliefs after each piece of evidence are computed by enumerating the 16 joint states.
const pB = 0.01, pE = 0.02;
const pA = (b: number, e: number) => [[0.001, 0.3], [0.9, 0.95]][b][e];
const pR = (e: number) => [0.001, 0.8][e];
const bern = (p: number, v: number) => (v ? p : 1 - p);
const joint = (b: number, e: number, a: number, r: number) => bern(pB, b) * bern(pE, e) * bern(pA(b, e), a) * bern(pR(e), r);
const states: number[][] = [];
for (const b of [0, 1]) for (const e of [0, 1]) for (const a of [0, 1]) for (const r of [0, 1]) states.push([b, e, a, r]);
// prob(i, ev): probability that variable i is 1 given the evidence ev (index -> value)
const prob = (i: number, ev: Record<number, number>) => {
  const ok = (s: number[]) => Object.entries(ev).every(([k, v]) => s[Number(k)] === v);
  const den = states.filter(ok).reduce((a, s) => a + joint(s[0], s[1], s[2], s[3]), 0);
  const num = states.filter((s) => ok(s) && s[i] === 1).reduce((a, s) => a + joint(s[0], s[1], s[2], s[3]), 0);
  return num / den;
};
const evidence: Record<number, number>[] = [{}, { 2: 1 }, { 2: 1, 3: 1 }];
const beliefs = evidence.map((ev) => [prob(0, ev), prob(1, ev)]);
const chk = beliefs.map(([b, e]) => `${b.toFixed(3)} ${e.toFixed(3)}`).join(' ');
if (chk !== '0.010 0.020 0.566 0.385 0.033 0.998') throw new Error(`AlarmNetwork: beliefs drifted from the note (${chk})`);

const given = ['', ' | A', ' | A, R'];
const t = ru
  ? {
      title: 'Байесовская сеть «сигнализация»: объяснение другой причиной',
      B: 'кража B', E: 'землетрясение E', A: 'сигнализация A', R: 'радио R', obs: 'наблюдается',
      rows: ['нет наблюдений', 'сработала сигнализация', 'радио сообщило о землетрясении'],
      steps: ['априорные вероятности: P(B) = 0.010, P(E) = 0.020', 'сигнализация сработала: P(B | A) = 0.566', 'радио сообщило о землетрясении: P(B | A, R) = 0.033'],
      desc: 'Граф из четырёх вершин: кража и землетрясение ведут к сигнализации, землетрясение — к сообщению по радио. Справа вероятности кражи и землетрясения: 0.010 и 0.020 без наблюдений; 0.566 и 0.385 после сигнализации; 0.033 и 0.998 после сообщения по радио.',
    }
  : {
      title: 'The burglar alarm network: explaining away',
      B: 'burglary B', E: 'earthquake E', A: 'alarm A', R: 'radio R', obs: 'observed',
      rows: ['no evidence', 'the alarm rings', 'the radio reports a quake'],
      steps: ['the priors: P(B) = 0.010, P(E) = 0.020', 'the alarm rings: P(B | A) = 0.566', 'the radio reports an earthquake: P(B | A, R) = 0.033'],
      desc: 'A graph of four nodes: burglary and earthquake point to the alarm, earthquake also points to the radio report. On the right, the probabilities of a burglary and an earthquake: 0.010 and 0.020 with no evidence, 0.566 and 0.385 after the alarm, 0.033 and 0.998 after the radio report.',
    };
const line = (k: number, v: number) => `P(${v === 0 ? 'B' : 'E'}${given[k]}) = ${beliefs[k][v].toFixed(3)}`;
const id = 'alarm-network';
const caption = ru
  ? 'Кража B (P = 0.01) и землетрясение E (P = 0.02) независимы, и каждое из этих событий может включить сигнализацию A; радио R сообщает о землетрясениях. Наблюдаемые вершины закрашены зелёным. Без наблюдений (1) вероятности равны априорным. Сигнализация (2) поднимает вероятность кражи с 0.010 до 0.566. Сообщение по радио (3) делает землетрясение почти достоверным (0.998), и вероятность кражи падает до 0.033: землетрясение объясняет сигнализацию. Таблицы условных вероятностей приведены в тексте.'
  : 'A burglary B (P = 0.01) and an earthquake E (P = 0.02) are independent, and either can set off the alarm A; the radio R reports earthquakes. Observed nodes are shaded green. With no evidence (1) the beliefs are the priors. The alarm (2) raises the probability of a burglary from 0.010 to 0.566. The radio report (3) makes the earthquake almost certain, 0.998, and the burglary falls to 0.033: the earthquake explains the alarm away. The conditional probability tables are in the text.';
const sub = { B: 'P(B = 1) = 0.01', E: 'P(E = 1) = 0.02', A: 'P(A | B, E)', R: 'P(R | E)' };
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 330" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <Box x={20} y={50} w={140} h={50} label={t.B} sub={sub.B} tone="h" />
    <Box x={220} y={50} w={140} h={50} label={t.E} sub={sub.E} tone="h" />
    <Arrow pts={[[90, 100], [150, 198]]} />
    <Arrow pts={[[270, 100], [200, 198]]} />
    <Arrow pts={[[310, 100], [330, 198]]} />
    <Box x={100} y={200} w={140} h={50} label={t.A} sub={sub.A} />
    <Box x={260} y={200} w={140} h={50} label={t.R} sub={sub.R} />
    <g data-s="2 3">
      <rect class="f-fill-green f-green" x="100" y="200" width="140" height="50" rx="7" style="stroke-width: 2" />
      <text class="f-small f-t-green" x="170" y="270" text-anchor="middle">{t.obs}</text>
    </g>
    <g data-s="3">
      <rect class="f-fill-green f-green" x="260" y="200" width="140" height="50" rx="7" style="stroke-width: 2" />
      <text class="f-small f-t-green" x="330" y="270" text-anchor="middle">{t.obs}</text>
    </g>
    {t.rows.map((r, k) => (
      <g data-s={k + 1}>
        <Badge x={446} y={60 + k * 90} n={k + 1} />
        <text class="f-label" x="464" y={65 + k * 90}>{r}</text>
        <text class="f-small f-t-blue" x="464" y={92 + k * 90}>{`${line(k, 0)}    ${line(k, 1)}`}</text>
      </g>
    ))}
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 500" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <Box x={16} y={30} w={156} h={52} label={t.B} sub={sub.B} tone="h" />
    <Box x={188} y={30} w={156} h={52} label={t.E} sub={sub.E} tone="h" />
    <Arrow pts={[[94, 82], [94, 148]]} />
    <Arrow pts={[[230, 82], [150, 148]]} />
    <Arrow pts={[[266, 82], [266, 148]]} />
    <Box x={16} y={150} w={156} h={52} label={t.A} sub={sub.A} />
    <Box x={188} y={150} w={156} h={52} label={t.R} sub={sub.R} />
    <g data-s="2 3">
      <rect class="f-fill-green f-green" x="16" y="150" width="156" height="52" rx="7" style="stroke-width: 2" />
      <text class="f-small f-t-green" x="94" y="224" text-anchor="middle">{t.obs}</text>
    </g>
    <g data-s="3">
      <rect class="f-fill-green f-green" x="188" y="150" width="156" height="52" rx="7" style="stroke-width: 2" />
      <text class="f-small f-t-green" x="266" y="224" text-anchor="middle">{t.obs}</text>
    </g>
    {t.rows.map((r, k) => (
      <g data-s={k + 1}>
        <Badge x={26} y={262 + k * 80} n={k + 1} />
        <text class="f-label" x="44" y={267 + k * 80}>{r}</text>
        <text class="f-small f-t-blue" x="44" y={290 + k * 80}>{line(k, 0)}</text>
        <text class="f-small f-t-blue" x="44" y={310 + k * 80}>{line(k, 1)}</text>
      </g>
    ))}
  </svg>
  <Stepper steps={t.steps} />
</Figure>
