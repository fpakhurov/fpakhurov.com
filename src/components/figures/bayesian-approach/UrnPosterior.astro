---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Eleven urns, urn u holds u black balls of 10, uniform prior; draws with replacement.
// Left: 3 black in 10 draws. Right: 0 black in 3 draws. Bars: the posterior over u.
const f = Array.from({ length: 11 }, (_, u) => u / 10);
const posterior = (nB: number, N: number) => {
  const lik = f.map((q) => q ** nB * (1 - q) ** (N - nB));
  const z = lik.reduce((a, b) => a + b, 0);
  return lik.map((l) => l / z);
};
const cases = [
  { post: posterior(3, 10), en: '3 black in 10 draws', ru: '3 чёрных из 10' },
  { post: posterior(0, 3), en: '0 black in 3 draws', ru: '0 чёрных из 3' },
].map((c) => {
  const best = c.post.indexOf(Math.max(...c.post));
  const pred = c.post.reduce((a, p, u) => a + p * f[u], 0);
  return { ...c, best, plug: f[best], pred };
});
const chk = [cases[0].post[3].toFixed(3), cases[0].pred.toFixed(3), cases[0].best, cases[1].post[0].toFixed(3), cases[1].pred.toFixed(3), cases[1].best].join(' ');
if (chk !== '0.293 0.333 3 0.331 0.163 0') throw new Error(`UrnPosterior: numbers drifted from the note (${chk})`);

const t = ru
  ? { title: 'Апостериорное распределение по урнам и предсказание', x: 'урна u (u чёрных шаров из 10)', plug: (u: number, v: string) => `подстановка (урна ${u}): ${v}`, avg: (v: string) => `апостериорное среднее: ${v}`, head: 'P(следующий чёрный):',
      desc: 'Два столбчатых графика вероятностей урн 0–10. Слева, после 3 чёрных из 10, пик у урны 3 (0.293), масса распределена по урнам 1–7; предсказание 0.333 против 0.3 при подстановке. Справа, после 0 чёрных из 3, вероятности убывают от 0.331 у урны 0; предсказание 0.163 против 0 при подстановке.' }
  : { title: 'The posterior over the urns and the prediction', x: 'urn u (u black balls of 10)', plug: (u: number, v: string) => `plug-in (urn ${u}): ${v}`, avg: (v: string) => `posterior average: ${v}`, head: 'P(next ball black):',
      desc: 'Two bar charts of the probabilities of urns 0 to 10. Left, after 3 black in 10 draws, a peak at urn 3 (0.293) with mass spread over urns 1 to 7; the prediction is 0.333 against 0.3 for the plug-in. Right, after 0 black in 3 draws, probabilities fall from 0.331 at urn 0; the prediction is 0.163 against 0 for the plug-in.' };
const id = 'urn-posterior';
const fmtP = (v: number) => (v === 0 ? '0' : v.toFixed(3));
const layouts = [
  { cls: 'fig-wide', W: 760, H: 290, panels: [{ x0: 50, x1: 360, y0: 64, y1: 228 }, { x0: 440, x1: 750, y0: 64, y1: 228 }] },
  { cls: 'fig-narrow', W: 360, H: 590, panels: [{ x0: 44, x1: 344, y0: 64, y1: 228 }, { x0: 44, x1: 344, y0: 354, y1: 518 }] },
];
const caption = ru
  ? 'Одиннадцать урн, в урне u лежат u чёрных и 10 − u белых шаров; урна выбрана равновероятно, шары тянут с возвращением. Столбцы — апостериорные вероятности урн; янтарным выделена урна с наибольшим правдоподобием. Слева, после 3 чёрных из 10, подстановка этой урны предсказывает чёрный шар с вероятностью 0.3, а усреднение по апостериорному распределению — 0.333. Справа, после 3 белых подряд, подстановка урны 0 объявляет чёрный шар невозможным, а усреднение даёт 0.163.'
  : 'Eleven urns, urn u holds u black and 10 − u white balls; the urn is picked uniformly and balls are drawn with replacement. The bars are the posterior probabilities of the urns; the urn of highest likelihood is in amber. Left, after 3 black in 10 draws, plugging in that urn predicts black with probability 0.3, and averaging over the posterior gives 0.333. Right, after 3 white draws in a row, plugging in urn 0 declares black impossible, while the average gives 0.163.';
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{t.title}</title>
      <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
      {cases.map((c, k) => {
        const P = L.panels[k];
        const bw = (P.x1 - P.x0) / 11;
        const sx = (u: number) => P.x0 + u * bw;
        const sy = scale([0, 0.35], [P.y1, P.y0]);
        return (
          <g>
            <text class="f-label" x={P.x0} y={P.y0 - 34}>{ru ? c.ru : c.en}</text>
            {[0, 0.1, 0.2, 0.3].map((v) => (
              <g>
                <path class="f-grid" d={`M ${P.x0} ${sy(v)} H ${P.x1}`} />
                <text class="f-note" x={P.x0 - 6} y={sy(v) + 4} text-anchor="end">{v}</text>
              </g>
            ))}
            {c.post.map((p, u) => (
              <rect x={sx(u) + 4} y={sy(p)} width={bw - 8} height={Math.max(sy(0) - sy(p), 0)} class={u === c.best ? 'f-fill-amber f-amber' : 'f-fill-blue f-blue'} style="stroke-width: 1.2" />
            ))}
            <path class="f-axis" d={`M ${P.x0} ${P.y1} H ${P.x1}`} />
            {f.map((_, u) => <text class="f-note" x={sx(u) + bw / 2} y={P.y1 + 17} text-anchor="middle">{u}</text>)}
            <text class="f-small f-t-muted" x={(P.x0 + P.x1) / 2} y={P.y1 + 38} text-anchor="middle">{t.x}</text>
            <text class="f-small f-t-muted" x={P.x1} y={P.y0 - 2} text-anchor="end">{t.head}</text>
            <text class="f-small f-t-amber f-halo" x={P.x1} y={P.y0 + 16} text-anchor="end">{t.plug(c.best, fmtP(c.plug))}</text>
            <text class="f-small f-t-red f-halo" x={P.x1} y={P.y0 + 34} text-anchor="end">{t.avg(c.pred.toFixed(3))}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
