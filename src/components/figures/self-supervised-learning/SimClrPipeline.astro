---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import { fmt } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Two bundled digits (load_digits images 0 and 3, values 0..16) and two deterministic stand-ins for random views:
// t shifts one pixel to the right and lowers the contrast, t' shifts one pixel down.
const zero = [0, 0, 5, 13, 9, 1, 0, 0, 0, 0, 13, 15, 10, 15, 5, 0, 0, 3, 15, 2, 0, 11, 8, 0, 0, 4, 12, 0, 0, 8, 8, 0, 0, 5, 8, 0, 0, 9, 8, 0, 0, 4, 11, 0, 1, 12, 7, 0, 0, 2, 14, 5, 10, 12, 0, 0, 0, 0, 6, 13, 10, 0, 0, 0];
const three = [0, 0, 7, 15, 13, 1, 0, 0, 0, 8, 13, 6, 15, 4, 0, 0, 0, 2, 1, 13, 13, 0, 0, 0, 0, 0, 2, 15, 11, 1, 0, 0, 0, 0, 0, 1, 12, 12, 1, 0, 0, 0, 0, 0, 1, 10, 8, 0, 0, 0, 8, 4, 5, 14, 9, 0, 0, 0, 7, 13, 13, 9, 0, 0];
if (zero.length !== 64 || three.length !== 64 || zero.reduce((a, b) => a + b, 0) !== 294 || three.reduce((a, b) => a + b, 0) !== 267) throw new Error('SimClrPipeline: digit pixels drifted');
const shift = (img: number[], dx: number, dy: number, gain = 1) =>
  img.map((_, k) => { const r = Math.floor(k / 8) - dy, c = (k % 8) - dx; return r >= 0 && c >= 0 ? img[r * 8 + c] * gain : 0; });
const views = [shift(zero, 1, 0, 0.75), shift(three, 1, 0, 0.75), shift(zero, 0, 1), shift(three, 0, 1)];

// The worked example of the text: normalized embeddings of the views (a, b, a', b'), tau = 0.5.
const z = [[1, 0], [0, 1], [0.8, 0.6], [-0.6, 0.8]];
const partner = [2, 3, 0, 1];
const S = z.map((u) => z.map((v) => u[0] * v[0] + u[1] * v[1]));
const tau = 0.5;
const loss = S.map((row, i) => {
  const den = row.reduce((acc, s, k) => (k === i ? acc : acc + Math.exp(s / tau)), 0);
  return -Math.log(Math.exp(row[partner[i]] / tau) / den);
});
const mean = loss.reduce((a, b) => a + b, 0) / 4;
const L3 = loss.map((v) => fmt(v, 3));
if (L3.join(' ') !== '0.233 0.627 0.627 0.233' || fmt(mean, 3) !== '0.430') throw new Error(`SimClrPipeline: losses drifted (${L3.join(' ')}, ${fmt(mean, 3)})`);
const cell = (i: number, k: number) => (i === k ? '—' : fmt(S[i][k], 1).replace('-', '−'));
const zs = z.map((v) => v.map((c) => fmt(c, 1).replace('-', '−').replace(/\.0$/, '')));
const names = ['a', 'b', 'a′', 'b′'];
const hs = names.map((n) => `h(${n})`);

const t = ru
  ? {
      title: 'SimCLR: два вида каждого изображения, общий энкодер, голова и NT-Xent',
      batch: 'батч', shared: 'общий', kept: 'остаётся', dropped: 'не нужна', sim: 'сходство (cos)',
      mean: `среднее ${fmt(mean, 3)}`, zbar: 'z̄ = z / ‖z‖',
      steps: ['две случайные аугментации каждого изображения: 2N видов', 'общий энкодер f даёт представление h', 'голова g даёт z, z нормируется', 'косинусное сходство каждой пары видов, деление на τ, без диагонали', 'каждая строка — классификация среди остальных 2N − 1 видов, верный класс — парный вид; функция потерь — её кросс-энтропия'],
      desc: 'Слева батч из двух цифр, a и b. Аугментации t и t′ дают четыре вида: a, b, a′, b′. Каждый вид проходит через общий энкодер f, получается h, затем через голову g, получается нормированный z: (1, 0), (0, 1), (0.8, 0.6), (−0.6, 0.8). Справа матрица косинусных сходств 4 × 4 без диагонали, положительные пары обведены; потери строк при τ = 0.5: 0.233, 0.627, 0.627, 0.233, среднее 0.430.',
    }
  : {
      title: 'SimCLR: two views of each image, a shared encoder, a head and NT-Xent',
      batch: 'batch', shared: 'shared', kept: 'kept', dropped: 'dropped later', sim: 'cosine similarity',
      mean: `mean ${fmt(mean, 3)}`, zbar: 'z̄ = z / ‖z‖',
      steps: ['two random augmentations of each image: 2N views', 'the shared encoder f gives the representation h', 'the head g gives z, which is normalized', 'cosine similarity of every pair of views, divided by τ, diagonal excluded', 'each row is a classification over the other 2N − 1 views, the partner view is the correct class; the loss is its cross-entropy'],
      desc: 'On the left a batch of two digits, a and b. The augmentations t and t′ give four views: a, b, a′, b′. Each view goes through the shared encoder f, giving h, then through the head g, giving a normalized z: (1, 0), (0, 1), (0.8, 0.6), (−0.6, 0.8). On the right the 4 × 4 matrix of cosine similarities without its diagonal, positive pairs outlined; the per-row losses at τ = 0.5 are 0.233, 0.627, 0.627, 0.233, mean 0.430.',
    };
const id = 'ssl-simclr-pipeline';
const caption = ru
  ? 'Пример из текста с N = 2 изображениями. Виды здесь — сдвиг на пиксель вправо с понижением контраста (t) и сдвиг на пиксель вниз (t′); при обучении аугментации случайны. Векторы z взяты из примера, а не из обученной сети. В матрице строка — якорь, столбец — кандидат; красная рамка отмечает парный вид. У якоря b потеря больше, чем у a: его отрицательный пример a′ похож на него почти так же, как его собственная пара (0.6 против 0.8). После обучения голова g отбрасывается, а представление h используется дальше.'
  : 'The worked example of the text with N = 2 images. Here the views are a one-pixel shift to the right with lower contrast (t) and a one-pixel shift down (t′); in training the augmentations are random. The vectors z are those of the example, not of a trained network. In the matrix a row is an anchor and a column a candidate; the red outline marks the partner view. Anchor b loses more than a: its negative a′ is almost as similar to it as its own partner (0.6 against 0.8). After training the head g is dropped and the representation h is reused.';

// Wide layout: one row per view.
const Y = [70, 120, 190, 240];
const mx = 520, cw = 44, chh = 30;
// Narrow layout: one column per view.
const CX = [126, 172, 218, 264];
const nmy = 290, nch = 26;
const Thumb = (img: number[], x: number, y: number, s: number) =>
  img.map((v, k) => ({ x: x + (k % 8) * s, y: y + Math.floor(k / 8) * s, o: (v / 16).toFixed(3) }));
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 345" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <g data-s="1">
      <text class="f-small f-t-muted" x="40" y="106" text-anchor="middle">{t.batch}</text>
      {[zero, three].map((img, j) => (
        <g>
          {Thumb(img, 24, 114 + j * 50, 4).map((p) => <rect x={p.x} y={p.y} width="4" height="4" style={`fill: var(--ink); fill-opacity: ${p.o}`} />)}
          <rect x="24" y={114 + j * 50} width="32" height="32" style="fill: none; stroke: var(--fig-green); stroke-width: 1.3" />
          <text class="f-math" x="18" y={136 + j * 50} text-anchor="end">{names[j]}</text>
        </g>
      ))}
      <Arrow pts={[[60, 150], [104, 100]]} tone="green" label="t" at={[78, 118]} anchor="middle" labelTone="x" />
      <Arrow pts={[[60, 160], [104, 210]]} tone="green" label="t′" at={[78, 200]} anchor="middle" labelTone="x" />
      <Badge x={84} y={155} n={1} />
      {views.map((img, i) => (
        <g>
          {Thumb(img, 108, Y[i] - 16, 4).map((p) => <rect x={p.x} y={p.y} width="4" height="4" style={`fill: var(--ink); fill-opacity: ${p.o}`} />)}
          <rect x="108" y={Y[i] - 16} width="32" height="32" style="fill: none; stroke: var(--fig-green); stroke-width: 1.3" />
          <text class="f-math" x="146" y={Y[i] + 6}>{names[i]}</text>
        </g>
      ))}
    </g>
    <g data-s="2">
      {Y.map((y) => <Arrow pts={[[164, y], [186, y]]} />)}
      <Box x={188} y={50} w={56} h={210} label="f" sub={t.shared} math={true} tone="g" />
      {Y.map((y, i) => (
        <g>
          <Arrow pts={[[244, y], [260, y]]} />
          <Vec x={262} y={y - 11} values={[hs[i]]} tone="h" cw={52} />
        </g>
      ))}
      <text class="f-small f-t-muted" x="288" y="284" text-anchor="middle">{t.kept}</text>
      <Badge x={216} y={36} n={2} />
    </g>
    <g data-s="3">
      {Y.map((y) => <Arrow pts={[[314, y], [332, y]]} />)}
      <Box x={334} y={50} w={46} h={210} label="g" math={true} tone="g" />
      {Y.map((y, i) => (
        <g>
          <Arrow pts={[[380, y], [398, y]]} />
          <Vec x={400} y={y - 11} values={zs[i]} tone="y" dir="row" cw={40} />
        </g>
      ))}
      <text class="f-small f-t-muted" x="357" y="284" text-anchor="middle">{t.dropped}</text>
      <text class="f-small" x="440" y="40" text-anchor="middle">{t.zbar}</text>
      <Badge x={357} y={36} n={3} />
    </g>
    <g data-s="4">
      {Y.map((y) => <Arrow pts={[[484, y], [516, y]]} />)}
      {names.map((n, k) => <text class="f-math" x={mx + k * cw + cw / 2} y="44" text-anchor="middle">{n}</text>)}
      {Y.map((y, i) => names.map((_, k) => (
        <g>
          <rect x={mx + k * cw} y={y - chh / 2} width={cw} height={chh} style={`fill: var(--paper-strong); stroke: ${partner[i] === k ? 'var(--fig-red)' : 'var(--line)'}; stroke-width: ${partner[i] === k ? 2.2 : 1}`} />
          <text class={`f-small${i === k ? ' f-t-muted' : ''}`} x={mx + k * cw + cw / 2} y={y + 4.5} text-anchor="middle" style={partner[i] === k ? 'font-weight: 650' : undefined}>{cell(i, k)}</text>
        </g>
      )))}
      <text class="f-small f-t-muted" x={mx} y="284">{t.sim}</text>
      <Badge x={503} y={36} n={4} />
    </g>
    <g data-s="5">
      <text class="f-math" x="731" y="44" text-anchor="middle">ℓ</text>
      {Y.map((y, i) => <Vec x={706} y={y - 11} values={[L3[i]]} tone="y" cw={50} />)}
      <text class="f-small" x="756" y="284" text-anchor="end">{t.mean}</text>
      <Badge x={748} y={36} n={5} />
    </g>
    <Legend x={196} y={326} step={120} rows={1} />
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 476" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <g data-s="1">
      {[zero, three].map((img, j) => (
        <g>
          {Thumb(img, 14 + j * 36, 30, 4).map((p) => <rect x={p.x} y={p.y} width="4" height="4" style={`fill: var(--ink); fill-opacity: ${p.o}`} />)}
          <rect x={14 + j * 36} y="30" width="32" height="32" style="fill: none; stroke: var(--fig-green); stroke-width: 1.3" />
          <text class="f-math" x={30 + j * 36} y="82" text-anchor="middle">{names[j]}</text>
        </g>
      ))}
      <text class="f-small f-t-muted" x="48" y="20" text-anchor="middle">{t.batch}</text>
      <Arrow pts={[[86, 46], [106, 46]]} tone="green" />
      <text class="f-small f-t-green" x="96" y="20" text-anchor="middle">t, t′</text>
      <Badge x={96} y={66} n={1} />
      {views.map((img, i) => (
        <g>
          {Thumb(img, CX[i] - 16, 30, 4).map((p) => <rect x={p.x} y={p.y} width="4" height="4" style={`fill: var(--ink); fill-opacity: ${p.o}`} />)}
          <rect x={CX[i] - 16} y="30" width="32" height="32" style="fill: none; stroke: var(--fig-green); stroke-width: 1.3" />
          <text class="f-math" x={CX[i]} y="82" text-anchor="middle">{names[i]}</text>
        </g>
      ))}
    </g>
    <g data-s="2">
      <Box x={104} y={90} w={182} h={26} label={`f, ${t.shared}`} tone="g" />
      {CX.map((cx, i) => (
        <g>
          <Arrow pts={[[cx, 116], [cx, 132]]} />
          <Vec x={cx - 22} y={134} values={[hs[i]]} tone="h" cw={44} />
        </g>
      ))}
      <text class="f-small f-t-muted" x="96" y="150" text-anchor="end">{t.kept}</text>
      <Badge x={312} y={103} n={2} />
    </g>
    <g data-s="3">
      {CX.map((cx) => <Arrow pts={[[cx, 156], [cx, 170]]} />)}
      <Box x={104} y={172} w={182} h={26} label="g" math={true} tone="g" />
      {CX.map((cx, i) => (
        <g>
          <Arrow pts={[[cx, 198], [cx, 212]]} />
          <Vec x={cx - 22} y={214} values={zs[i]} tone="y" cw={44} />
        </g>
      ))}
      <text class="f-small f-t-muted" x="96" y="190" text-anchor="end">{t.dropped}</text>
      <text class="f-math" x="96" y="242" text-anchor="end">z̄</text>
      <Badge x={312} y={185} n={3} />
    </g>
    <g data-s="4">
      {CX.map((cx) => <Arrow pts={[[cx, 262], [cx, 286]]} />)}
      {CX.map((_, i) => <text class="f-math" x="96" y={nmy + i * nch + 19} text-anchor="end">{names[i]}</text>)}
      {CX.map((_, i) => CX.map((cx, k) => (
        <g>
          <rect x={cx - 22} y={nmy + i * nch} width="44" height={nch} style={`fill: var(--paper-strong); stroke: ${partner[i] === k ? 'var(--fig-red)' : 'var(--line)'}; stroke-width: ${partner[i] === k ? 2.2 : 1}`} />
          <text class={`f-small${i === k ? ' f-t-muted' : ''}`} x={cx} y={nmy + i * nch + 18} text-anchor="middle" style={partner[i] === k ? 'font-weight: 650' : undefined}>{cell(i, k)}</text>
        </g>
      )))}
      <text class="f-small f-t-muted" x="104" y="420">{t.sim}</text>
      <Badge x={80} y={276} n={4} />
    </g>
    <g data-s="5">
      <text class="f-math" x="320" y="282" text-anchor="middle">ℓ</text>
      {CX.map((_, i) => <Vec x={296} y={nmy + i * nch + 2} values={[L3[i]]} tone="y" cw={48} ch={nch - 4} />)}
      <text class="f-small" x="344" y="420" text-anchor="end">{t.mean}</text>
      <Badge x={344} y={270} n={5} />
    </g>
    <Legend x={16} y={446} step={170} rows={2} />
  </svg>
  <Stepper steps={t.steps} />
</Figure>
