---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The experiment of the note (Code section, seed 0): linear probes on 719 test digits with 5 or 10 labelled
// training images per class (mean over five draws) or all 1078.
const rows = [
  { key: 'pix', en: 'raw pixels', ru: 'исходные пиксели', cls: 'f-muted', dot: 'f-solid-muted', acc: [0.825, 0.897, 0.968] },
  { key: 'rand', en: 'random encoder', ru: 'случайный энкодер', cls: 'f-blue', dot: 'f-solid-blue', acc: [0.806, 0.884, 0.968] },
  { key: 'ssl', en: 'SimCLR encoder', ru: 'энкодер SimCLR', cls: 'f-red', dot: 'f-solid-red', acc: [0.942, 0.956, 0.987] },
];
const gain = (rows[2].acc[0] - rows[0].acc[0]).toFixed(3);
if (gain !== '0.117' || rows[2].acc[2] - rows[1].acc[2] < 0.018) throw new Error('LinearProbe: numbers drifted from the table');

const t = ru
  ? { title: 'Линейный зонд: признаки SimCLR против пикселей и случайного энкодера', y: 'доля правильных ответов на тесте', x: 'размеченные изображения для зонда',
      cats: ['по 5 на класс', 'по 10 на класс', 'все 1078'],
      desc: 'Доля правильных ответов логистической регрессии на замороженных признаках при 5 и 10 размеченных изображениях на класс и при всех 1078. Исходные пиксели: 0.825, 0.897, 0.968. Случайный энкодер: 0.806, 0.884, 0.968. Энкодер SimCLR: 0.942, 0.956, 0.987.' }
  : { title: 'The linear probe: SimCLR features against pixels and a random encoder', y: 'test accuracy', x: 'labelled images for the probe',
      cats: ['5 per class', '10 per class', 'all 1078'],
      desc: 'Accuracy of logistic regression on frozen features with 5 and 10 labelled images per class and with all 1078. Raw pixels: 0.825, 0.897, 0.968. Random encoder: 0.806, 0.884, 0.968. SimCLR encoder: 0.942, 0.956, 0.987.' };
const id = 'ssl-linear-probe';
const caption = ru
  ? `1078 обучающих изображений цифр 8 × 8 без меток для SimCLR (50 эпох, τ = 0.5, батч 256), затем логистическая регрессия на замороженных 64-мерных признаках h; тест — 719 изображений, одно начальное значение генератора, для 5 и 10 меток на класс — среднее по пяти выборкам размеченных изображений. Случайный энкодер — та же сеть без обучения. С пятью метками на класс доля правильных ответов на признаках SimCLR на ${gain} выше, чем на исходных пикселях; со всеми метками преимущество около двух пунктов.`
  : `1078 training digits of 8 × 8 pixels without labels for SimCLR (50 epochs, τ = 0.5, batches of 256), then logistic regression on the frozen 64-dimensional features h; 719 test images, one seed, and for 5 and 10 labels per class the mean over five draws of the labelled images. The random encoder is the same network, untrained. With five labels per class, SimCLR features score ${gain} above raw pixels; with all labels the advantage is about two points.`;
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 300, px: [80, 500] as [number, number], py: [30, 230] as [number, number], lgx: 560, lgy: 60 },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 380, px: [56, 336] as [number, number], py: [30, 230] as [number, number], lgx: 56, lgy: 306 },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => {
    const sy = scale([0.75, 1.0], [Ly.py[1], Ly.py[0]]);
    const slot = (Ly.px[1] - Ly.px[0]) / 3;
    const cx = (i: number) => Ly.px[0] + slot * (i + 0.5);
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
        {[0.8, 0.85, 0.9, 0.95, 1.0].map((v) => <path class="f-grid" d={`M ${Ly.px[0]} ${sy(v)} H ${Ly.px[1]}`} />)}
        <path class="f-axis" d={`M ${Ly.px[0]} ${Ly.py[1]} H ${Ly.px[1]} M ${Ly.px[0]} ${Ly.py[0]} V ${Ly.py[1]}`} />
        {[0.75, 0.8, 0.85, 0.9, 0.95, 1.0].map((v) => <text class="f-note" x={Ly.px[0] - 8} y={sy(v) + 5} text-anchor="end">{v.toFixed(2)}</text>)}
        <text class="f-small f-t-muted" x={Ly.px[0] - 50} y={Ly.py[0] - 14}>{t.y}</text>
        {t.cats.map((c, i) => <text class="f-small" x={cx(i)} y={Ly.py[1] + 20} text-anchor="middle">{c}</text>)}
        <text class="f-small f-t-muted" x={(Ly.px[0] + Ly.px[1]) / 2} y={Ly.py[1] + 42} text-anchor="middle">{t.x}</text>
        {rows.map((r) => (
          <g>
            <path class={`f-line ${r.cls}`} d={polyline(r.acc.map((a, i) => [cx(i), sy(a)]))} />
            {r.acc.map((a, i) => <circle cx={cx(i)} cy={sy(a)} r="5" class={r.dot} />)}
          </g>
        ))}
        {rows.map((r) => (
          <text class="f-small f-halo" x={cx(0) - 12} y={sy(r.acc[0]) + (r.key === 'rand' ? 12 : r.key === 'pix' ? -2 : 5)} text-anchor="end">{r.acc[0].toFixed(3)}</text>
        ))}
        <text class="f-small f-halo" x={cx(2) + 12} y={sy(rows[2].acc[2]) + 5}>{rows[2].acc[2].toFixed(3)}</text>
        <text class="f-small f-halo" x={cx(2) + 12} y={sy(rows[0].acc[2]) + 9}>{rows[0].acc[2].toFixed(3)}</text>
        {rows.map((r, i) => (
          <g>
            <path class={`f-line ${r.cls}`} d={`M ${Ly.lgx} ${Ly.lgy + i * 24 - 4} h 22`} />
            <circle cx={Ly.lgx + 11} cy={Ly.lgy + i * 24 - 4} r="4" class={r.dot} />
            <text class="f-small" x={Ly.lgx + 30} y={Ly.lgy + i * 24}>{ru ? r.ru : r.en}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
