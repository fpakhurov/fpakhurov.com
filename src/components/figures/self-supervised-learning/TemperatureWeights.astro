---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { fmt } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Anchor b of the worked example: its candidates are the easy negative a (s = 0), the hard negative a' (s = 0.6)
// and its partner b' (s = 0.8). The softmax weights q over the three candidates as functions of the temperature.
const sims = { easy: 0, hard: 0.6, pos: 0.8 };
const q = (tau: number) => {
  const e = [sims.easy, sims.hard, sims.pos].map((s) => Math.exp(s / tau));
  const sum = e[0] + e[1] + e[2];
  return { easy: e[0] / sum, hard: e[1] / sum, pos: e[2] / sum };
};
const marks = [0.1, 0.5, 1];
const at = marks.map(q);
const chk = at.map((v) => [fmt(v.pos, 3), fmt(v.hard, 3), fmt(v.easy, 3)].join(' ')).join(' | ');
if (chk !== '0.881 0.119 0.000 | 0.534 0.358 0.108 | 0.441 0.361 0.198') throw new Error(`TemperatureWeights: weights drifted (${chk})`);
const lossAt = at.map((v) => fmt(-Math.log(v.pos), 3)).join(' ');
if (lossAt !== '0.127 0.627 0.819') throw new Error(`TemperatureWeights: losses drifted (${lossAt})`);
const ratio = marks.map((tau) => Math.exp((sims.hard - sims.easy) / tau));
if (ratio.map((r) => r.toFixed(1)).join(' ') !== '403.4 3.3 1.8') throw new Error('TemperatureWeights: gradient ratios drifted');
const ratioText = ratio.map((r) => (r >= 10 ? String(Math.round(r)) : r.toFixed(1)));

const t = ru
  ? {
      title: 'Температура решает, какие отрицательные примеры получают градиент',
      x: 'температура τ', y: 'вес q в softmax', pos: 'парный вид b′ (s = 0.8)', hard: 'трудный a′ (s = 0.6)', easy: 'лёгкий a (s = 0)',
      ratioHead: 'градиент a′ / градиент a:', ratio: (tau: string, r: string) => `τ = ${tau}: ${r}×`,
      desc: 'Три кривые весов softmax якоря b в зависимости от температуры τ на логарифмической оси от 0.05 до 2: парный вид b′, трудный отрицательный a′ и лёгкий отрицательный a. При τ = 0.5 веса 0.534, 0.358 и 0.108. С ростом τ веса сближаются, при малом τ вес a стремится к нулю, а a′ получает почти весь отталкивающий градиент.',
    }
  : {
      title: 'The temperature decides which negatives get the gradient',
      x: 'temperature τ', y: 'softmax weight q', pos: 'partner b′ (s = 0.8)', hard: 'hard a′ (s = 0.6)', easy: 'easy a (s = 0)',
      ratioHead: 'gradient on a′ / on a:', ratio: (tau: string, r: string) => `τ = ${tau}: ${r}×`,
      desc: 'Three curves of the softmax weights of anchor b against the temperature τ on a log axis from 0.05 to 2: the partner view b′, the hard negative a′ and the easy negative a. At τ = 0.5 the weights are 0.534, 0.358 and 0.108. As τ grows the weights approach each other; at small τ the weight of a goes to zero and a′ receives almost all of the repelling gradient.',
    };
const id = 'ssl-temperature-weights';
const caption = ru
  ? `Якорь b из примера в тексте: косинусные сходства с кандидатами 0 (a), 0.6 (a′) и 0.8 (b′). Градиент функции потерь по сходству с отрицательным примером равен q/τ, поэтому отношение градиентов на a′ и на a равно e^(0.6/τ): ${ratio[2].toFixed(1)} при τ = 1, ${ratio[1].toFixed(1)} при τ = 0.5 и ${Math.round(ratio[0])} при τ = 0.1. Вертикальные линии отмечают эти три температуры; значения функции потерь якоря при них ${lossAt.split(' ').reverse().join(', ')}. При малом τ градиент приходит почти только от самого похожего отрицательного примера, при большом τ распределяется поровну.`
  : `Anchor b of the worked example in the text: cosine similarities 0 to a, 0.6 to a′ and 0.8 to b′. The gradient of the loss with respect to a negative's similarity is q/τ, so the gradients on a′ and on a are in the ratio e^(0.6/τ): ${ratio[2].toFixed(1)} at τ = 1, ${ratio[1].toFixed(1)} at τ = 0.5 and ${Math.round(ratio[0])} at τ = 0.1. The vertical lines mark these three temperatures; the anchor's loss there is ${lossAt.split(' ').reverse().join(', ')}. At small τ almost all of the push comes from the most similar negative; at large τ it is shared evenly.`;

const lx = (tau: number) => Math.log10(tau);
const series = [
  { key: 'pos' as const, cls: 'f-red', solid: 'f-solid-red', label: t.pos },
  { key: 'hard' as const, cls: 'f-amber', solid: 'f-fill-amber', label: t.hard },
  { key: 'easy' as const, cls: 'f-blue', solid: 'f-solid-blue', label: t.easy },
];
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 326, px: [70, 520] as [number, number], py: [30, 256] as [number, number], lgx: 556, lgy: 40, narrow: false },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 486, px: [52, 340] as [number, number], py: [30, 256] as [number, number], lgx: 52, lgy: 324, narrow: true },
];
const taus = Array.from({ length: 121 }, (_, i) => 10 ** (lx(0.05) + ((lx(2) - lx(0.05)) * i) / 120));
const ticks = [0.05, 0.1, 0.2, 0.5, 1, 2];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => {
    const sx = scale([lx(0.05), lx(2)], Ly.px);
    const sy = scale([0, 1], [Ly.py[1], Ly.py[0]]);
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
        {[0.25, 0.5, 0.75, 1].map((v) => <path class="f-grid" d={`M ${Ly.px[0]} ${sy(v)} H ${Ly.px[1]}`} />)}
        {marks.map((m) => <path class="f-thin f-dash f-muted" d={`M ${sx(lx(m))} ${Ly.py[0]} V ${Ly.py[1]}`} />)}
        <path class="f-axis" d={`M ${Ly.px[0]} ${Ly.py[1]} H ${Ly.px[1]} M ${Ly.px[0]} ${Ly.py[0]} V ${Ly.py[1]}`} />
        {[0, 0.25, 0.5, 0.75, 1].map((v) => <text class="f-note" x={Ly.px[0] - 8} y={sy(v) + 5} text-anchor="end">{v.toFixed(2)}</text>)}
        {ticks.map((v) => <text class="f-note" x={sx(lx(v))} y={Ly.py[1] + 20} text-anchor="middle">{String(v)}</text>)}
        <text class="f-small f-t-muted" x={(Ly.px[0] + Ly.px[1]) / 2} y={Ly.py[1] + 42} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={Ly.px[0] - 44} y={Ly.py[0] - 14}>{t.y}</text>
        {series.map((s) => (
          <g>
            <path class={`f-line ${s.cls}`} d={polyline(taus.map((tau) => [sx(lx(tau)), sy(q(tau)[s.key])]))} />
            {marks.map((m) => <circle cx={sx(lx(m))} cy={sy(q(m)[s.key])} r="4.5" class={s.solid} style={s.key === 'hard' ? 'fill-opacity: 1; stroke: var(--fig-amber); stroke-width: 1.2' : undefined} />)}
          </g>
        ))}
        {series.map((s, i) => (
          <g>
            <path class={`f-line ${s.cls}`} d={`M ${Ly.lgx} ${Ly.lgy + i * 24 - 4} h 22`} />
            <text class="f-small" x={Ly.lgx + 30} y={Ly.lgy + i * 24}>{s.label}</text>
          </g>
        ))}
        <text class="f-small f-t-muted" x={Ly.lgx} y={Ly.lgy + 86}>{t.ratioHead}</text>
        {marks.map((m, i) => <text class="f-small" x={Ly.lgx} y={Ly.lgy + 108 + i * 20}>{t.ratio(String(m), ratioText[i])}</text>)}
      </svg>
    );
  })}
</Figure>
