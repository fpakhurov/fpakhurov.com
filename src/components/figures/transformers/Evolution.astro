---
import Figure from '../Figure.astro';
import Arrow from '../seqflow/Arrow.astro';
import NewMark from '../seqflow/NewMark.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Six small diagrams in the colours of the sequence-model figures; the amber outline marks what each model adds.
const panels = ru
  ? [
      { title: '1 · RNN', note: 'состояние идёт от шага к шагу', href: '/ru/notes/nlp/recurrent-networks' },
      { title: '2 · LSTM', note: '+ линия памяти и гейты', href: '/ru/notes/nlp/lstm-and-gru' },
      { title: '3 · seq2seq', note: '+ вторая сеть стартует с s₀', href: '/ru/notes/nlp/seq2seq' },
      { title: '4 · внимание', note: '+ декодер читает все hᵢ', href: '/ru/notes/nlp/attention-before-transformers' },
      { title: '5 · self-attention', note: '− цепочка: все читают всех', href: '/ru/notes/nlp/attention' },
      { title: '6 · трансформер', note: '+ FFN, остатки, позиции, × L', href: '/ru/notes/nlp/transformers' },
    ]
  : [
      { title: '1 · RNN', note: 'a state passed from step to step', href: '/notes/nlp/recurrent-networks' },
      { title: '2 · LSTM', note: '+ a memory line and gates', href: '/notes/nlp/lstm-and-gru' },
      { title: '3 · seq2seq', note: '+ a second network starts from s₀', href: '/notes/nlp/seq2seq' },
      { title: '4 · attention', note: '+ the decoder reads every hᵢ', href: '/notes/nlp/attention-before-transformers' },
      { title: '5 · self-attention', note: '− the chain: all read all', href: '/notes/nlp/attention' },
      { title: '6 · Transformer', note: '+ FFN, residuals, positions, × L', href: '/notes/nlp/transformers' },
    ];
const steps = panels.map((p) => `${p.title.split(' · ')[1]}: ${p.note}`);
const id = 'sequence-model-evolution';
const PW = 236, PH = 150;
const layouts = [
  { cls: 'fig-wide', W: 760, H: 2 * (PH + 22) + 8, pos: (k: number) => [8 + (k % 3) * (PW + 22), 6 + Math.floor(k / 3) * (PH + 22)] },
  { cls: 'fig-narrow seq-narrow', W: PW + 16, H: 6 * (PH + 18) + 4, pos: (k: number) => [8, 4 + k * (PH + 18)] },
];
const box = (x: number, y: number, w: number, h: number, tone: 'x' | 'h' | 'y' | 'n', bold = false) =>
  `<rect x="${x}" y="${y}" width="${w}" height="${h}" rx="4" style="fill: ${toneVar[tone]}; fill-opacity: 0.16; stroke: ${toneVar[tone]}; stroke-width: ${bold ? 2 : 1.2}" />`;
// Cells at three positions, inputs under them.
const xs3 = [36, 104, 172];
---

<Figure
  id={id}
  title={ru ? 'От RNN к трансформеру: одна идея, шесть доработок' : 'From RNN to Transformer: one idea, six refinements'}
  caption={ru
    ? 'Каждая модель этой части курса сохраняет предыдущую и меняет одну вещь (янтарная рамка). RNN передаёт состояние от токена к токену; LSTM добавляет к нему линию памяти, которую гейты меняют лишь умножением и сложением; seq2seq запускает вторую сеть с последнего состояния первой; внимание позволяет второй сети на каждом шаге смешивать все состояния первой; self-attention применяет то же смешивание внутри одной последовательности и убирает цепочку совсем; трансформер добавляет к нему сеть FFN для каждой позиции, остаточные связи, нормализацию и позиции и ставит блоки в стопку. Цвета те же, что на подробных рисунках заметок.'
    : 'Each model of this part of the course keeps the previous one and changes one thing (amber outline). The RNN passes a state from token to token; the LSTM adds a memory line that the gates change only by multiplication and addition; seq2seq starts a second network from the last state of the first; attention lets the second network mix all states of the first at every step; self-attention applies the same mixing inside one sequence and drops the chain altogether; the Transformer adds a per-position FFN, residual connections, normalization and positions, and stacks the blocks. The colours are those of the detailed figures in the notes.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Шесть моделей последовательностей' : 'Six sequence models'}</title>
      <desc id={`${id}-${L.W}-d`}>{panels.map((p) => `${p.title}: ${p.note}`).join('. ')}.</desc>
      {panels.map((p, k) => {
        const [ox, oy] = L.pos(k);
        return (
          <g data-s={String(k + 1)} transform={`translate(${ox} ${oy})`}>
            <rect x="0" y="0" width={PW} height={PH} rx="10" class="f-box-soft" />
            <a href={p.href}><text class="f-label f-title" x="10" y="20">{p.title}</text></a>
            <text class="f-small f-t-muted" x="10" y={PH - 9}>{p.note}</text>
            {k === 0 && (
              <g>
                {xs3.map((x, i) => <g><Fragment set:html={box(x - 20, 64, 40, 24, 'h') + box(x - 9, 104, 18, 14, 'x')} /><Arrow pts={[[x, 104], [x, 90]]} /><text class="f-small" x={x} y={81} text-anchor="middle">h</text></g>)}
                <NewMark x={10} y={56} w={188} h={40} label=" " />
                {xs3.slice(1).map((x) => <Arrow pts={[[x - 48, 76], [x - 22, 76]]} tone="blue" bold />)}
              </g>
            )}
            {k === 1 && (
              <g>
                <NewMark x={8} y={30} w={PW - 16} h={22} label=" " />
                <path class="f-line f-blue f-bold" d={`M 14 41 H ${PW - 14}`} marker-end="url(#f-arrow-blue)" />
                {xs3.map((x, i) => <g><Fragment set:html={box(x - 20, 64, 40, 24, 'h') + box(x - 9, 104, 18, 14, 'x')} /><Arrow pts={[[x, 104], [x, 90]]} /><path class="f-thin f-amber" d={`M ${x} 64 V 47`} /><circle cx={x} cy={41} r="4" style="fill: var(--fig-amber)" /></g>)}
                {xs3.slice(1).map((x) => <Arrow pts={[[x - 48, 76], [x - 22, 76]]} tone="blue" bold />)}
              </g>
            )}
            {k === 2 && (
              <g>
                {[22, 74].map((x) => <g><Fragment set:html={box(x - 18, 70, 36, 22, 'h') + box(x - 8, 106, 16, 12, 'x')} /><Arrow pts={[[x, 106], [x, 94]]} /></g>)}
                {[162, 214].map((x) => <g><Fragment set:html={box(x - 18, 70, 36, 22, 'h') + box(x - 8, 40, 16, 12, 'y')} /><Arrow pts={[[x, 70], [x, 54]]} /></g>)}
                <Arrow pts={[[40, 81], [54, 81]]} tone="blue" bold />
                <NewMark x={94} y={66} w={46} h={30} label=" " />
                <Arrow pts={[[92, 81], [142, 81]]} tone="amber" bold />
                <text class="f-small f-t-amber" x="117" y="112" text-anchor="middle">s₀</text>
                <Arrow pts={[[180, 81], [194, 81]]} tone="blue" bold />
              </g>
            )}
            {k === 3 && (
              <g>
                {[30, 80, 130].map((x) => <g><Fragment set:html={box(x - 16, 98, 32, 20, 'h')} /></g>)}
                <Arrow pts={[[46, 108], [62, 108]]} tone="blue" bold />
                <Arrow pts={[[96, 108], [112, 108]]} tone="blue" bold />
                <Fragment set:html={box(176, 40, 40, 24, 'h', true)} />
                <text class="f-small" x="196" y="56" text-anchor="middle">s</text>
                <NewMark x={22} y={50} w={150} h={50} label=" " />
                {[30, 80, 130].map((x) => <path class="f-line f-amber" d={`M 176 56 L ${x} 98`} />)}
              </g>
            )}
            {k === 4 && (
              <g>
                {[50, 118, 186].map((x) => <g><Fragment set:html={box(x - 18, 100, 36, 20, 'h') + box(x - 18, 36, 36, 20, 'h', true)} /></g>)}
                <NewMark x={26} y={58} w={184} h={40} label=" " />
                {[50, 118, 186].map((a) => [50, 118, 186].map((b) => <path class="f-thin f-amber" d={`M ${a} 100 L ${b} 56`} />))}
              </g>
            )}
            {k === 5 && (
              <g>
                {[50, 118, 186].map((x) => <g><Fragment set:html={box(x - 16, 112, 32, 14, 'h') + box(x - 18, 46, 36, 16, 'n')} /><text class="f-small" x={x} y={58} text-anchor="middle">FFN</text><Arrow pts={[[x, 82], [x, 64]]} /><path class="f-line f-blue" d={`M ${x + 20} 112 V 38`} /></g>)}
                <rect x="28" y="84" width="180" height="18" rx="6" style="fill: var(--fig-blue); fill-opacity: 0.08; stroke: var(--fig-blue); stroke-width: 1.1" />
                <NewMark x={26} y={34} w={190} h={34} label=" " />
                <text class="f-small f-t-blue" x={PW - 10} y="22" text-anchor="end">× L</text>
              </g>
            )}
          </g>
        );
      })}
    </svg>
  ))}
  <Stepper steps={steps} />
</Figure>
