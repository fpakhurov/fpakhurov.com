---
import Figure from '../Figure.astro';

// Encoder–decoder Transformer: two stacks, with the decoder's cross-attention
// reading keys and values from the encoder output.
interface Node { label: string; cls?: string; note?: string }
const encoder: Node[] = [
  { label: 'token + position embeddings', cls: 'f-fill-amber' },
  { label: 'self-attention (all positions)', cls: 'f-fill-blue' },
  { label: 'feed-forward', cls: 'f-fill-green' },
  { label: 'encoder states', cls: 'f-fill-red' },
];
const decoder: Node[] = [
  { label: 'token + position embeddings', cls: 'f-fill-amber' },
  { label: 'masked self-attention (≤ t)', cls: 'f-fill-blue' },
  { label: 'cross-attention over the encoder states', cls: 'f-fill-red' },
  { label: 'feed-forward', cls: 'f-fill-green' },
  { label: 'linear + softmax over the vocabulary' },
];
const boxH = 32;
const step = 50;

interface Layout { cls: string; w: number; h: number; boxW: number; encX: number; encBottom: number; decX: number; decBottom: number; vertical: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', w: 720, h: 380, boxW: 270, encX: 30, encBottom: 300, decX: 410, decBottom: 300, vertical: false },
  { cls: 'fig-narrow', w: 360, h: 690, boxW: 260, encX: 24, encBottom: 232, decX: 24, decBottom: 620, vertical: true },
];
const stackY = (bottom: number, i: number) => bottom - i * step - boxH;
---

<Figure
  id="encoder-decoder"
  title="Encoder–decoder: the decoder reads the source through cross-attention"
  caption="Left (or top): N encoder blocks turn the source tokens into one state per source position; nothing is masked. Right (or bottom): N decoder blocks over the target so far, with three sub-layers: masked self-attention over previous target positions, cross-attention in which the queries come from the decoder and the keys and values are the encoder states (red), and the feed-forward network. A linear layer and a softmax over the vocabulary give the next-token distribution at every position. Residual connections and normalization, shown in the block figure above, wrap every sub-layer and are omitted here."
>
  {layouts.map((L) => {
    const encY = (i: number) => stackY(L.encBottom, i);
    const decY = (i: number) => stackY(L.decBottom, i);
    const encRight = L.encX + L.boxW;
    const encMid = L.encX + L.boxW / 2;
    const decMid = L.decX + L.boxW / 2;
    const kvFrom = { x: L.vertical ? encRight : encRight, y: encY(3) + boxH / 2 };
    const kvTo = { x: L.vertical ? L.decX + L.boxW : L.decX, y: decY(2) + boxH / 2 };
    const kvPath = L.vertical
      ? `M ${kvFrom.x} ${kvFrom.y} H ${kvFrom.x + 24} V ${kvTo.y} H ${kvTo.x + 3}`
      : `M ${kvFrom.x} ${kvFrom.y} H ${(kvFrom.x + kvTo.x) / 2} V ${kvTo.y} H ${kvTo.x - 3}`;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`encoder-decoder-${L.w}-t encoder-decoder-${L.w}-d`}>
        <title id={`encoder-decoder-${L.w}-t`}>Encoder–decoder Transformer with cross-attention</title>
        <desc id={`encoder-decoder-${L.w}-d`}>Two stacks of boxes. The encoder stack: embeddings, self-attention, feed-forward, encoder states. The decoder stack: embeddings, masked self-attention, cross-attention, feed-forward, linear and softmax. A red arrow connects the encoder states to the cross-attention box, labelled K and V. Source tokens enter the encoder from below; the target so far enters the decoder from below and the next token comes out at the top.</desc>
        {/* encoder */}
        <text class="f-title" x={L.encX} y={encY(3) - 14}>encoder × N</text>
        {encoder.map((node, i) => (
          <g>
            <rect class={`f-box ${node.cls ?? ''}`} x={L.encX} y={encY(i)} width={L.boxW} height={boxH} rx="6" />
            <text class="f-small" x={encMid} y={encY(i) + boxH / 2 + 4} text-anchor="middle">{node.label}</text>
            {i < encoder.length - 1 && <path class="f-line" d={`M ${encMid} ${encY(i)} V ${encY(i + 1) + boxH + 3}`} marker-end="url(#f-arrow)" />}
          </g>
        ))}
        <path class="f-line" d={`M ${encMid} ${L.encBottom + 30} V ${L.encBottom + 3}`} marker-end="url(#f-arrow)" />
        <text class="f-label" x={encMid} y={L.encBottom + 50} text-anchor="middle">Ein Mann liest .</text>
        <text class="f-small f-t-muted" x={encMid} y={L.encBottom + 68} text-anchor="middle">source</text>
        {/* decoder */}
        <text class="f-title" x={L.decX} y={decY(4) - 14 - (L.vertical ? 0 : 0)} >decoder × N</text>
        {decoder.map((node, i) => (
          <g>
            <rect class={`f-box ${node.cls ?? ''}`} x={L.decX} y={decY(i)} width={L.boxW} height={boxH} rx="6" />
            <text class="f-small" x={decMid} y={decY(i) + boxH / 2 + 4} text-anchor="middle">{node.label}</text>
            {i < decoder.length - 1 && <path class="f-line" d={`M ${decMid} ${decY(i)} V ${decY(i + 1) + boxH + 3}`} marker-end="url(#f-arrow)" />}
          </g>
        ))}
        <path class="f-line" d={`M ${decMid} ${L.decBottom + 30} V ${L.decBottom + 3}`} marker-end="url(#f-arrow)" />
        <text class="f-label" x={decMid} y={L.decBottom + 50} text-anchor="middle">[CLS] A man</text>
        <text class="f-small f-t-muted" x={decMid} y={L.decBottom + 68} text-anchor="middle">target so far (shifted right)</text>
        <path class="f-line f-blue" d={`M ${decMid} ${decY(4) - 2} V ${decY(4) - 26}`} marker-end="url(#f-arrow-blue)" />
        <text class="f-label f-t-blue" x={decMid} y={decY(4) - 34} text-anchor="middle">A man reads</text>
        {/* K, V from the encoder */}
        <path class="f-line f-red" d={kvPath} marker-end="url(#f-arrow-red)" />
        <text class="f-small f-t-red f-halo" x={L.vertical ? kvFrom.x + 30 : (kvFrom.x + kvTo.x) / 2 + 8} y={L.vertical ? (kvFrom.y + kvTo.y) / 2 : (kvFrom.y + kvTo.y) / 2 + 4} text-anchor={L.vertical ? 'start' : 'start'}>{L.vertical ? 'K, V' : 'K, V (Q from the decoder)'}</text>
      </svg>
    );
  })}
</Figure>
