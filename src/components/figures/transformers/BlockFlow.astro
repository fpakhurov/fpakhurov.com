---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Op from '../seqflow/Op.astro';
import Badge from '../seqflow/Badge.astro';
import Arrow from '../seqflow/Arrow.astro';
import Box from '../seqflow/Box.astro';
import NewMark from '../seqflow/NewMark.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import Sub from '../generative-modeling/Sub.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One pre-norm block for three tokens: attention mixes positions, the FFN works on each position alone,
// and each sub-layer adds its result to a residual stream that bypasses it.
const words = ['dogs', 'chase', 'cats'];
const t = ru
  ? { attn: 'многоголовое self-attention', ffnSub: 'та же сеть', next: 'в следующий блок, × L',
      steps: ['эмбеддинг токена плюс позиция: h', 'Norm, затем внимание: каждая позиция читает все', 'сложить с остаточным путём: h′ = h + Attn', 'Norm, затем FFN: каждая позиция отдельно', 'сложить ещё раз: h″ = h′ + FFN', 'h″ идёт в следующий блок'] }
  : { attn: 'multi-head self-attention', ffnSub: 'same weights', next: 'to the next block, × L',
      steps: ['token embedding plus position: h', 'Norm, then attention: every position reads every position', 'add the residual: h′ = h + Attn', 'Norm, then the FFN: each position on its own', 'add again: h″ = h′ + FFN', 'h″ goes on to the next block'] };
const id = 'transformer-block-flow';
const yWord = 512, yEmb = 470, yPos = 440, yH = 398, split1 = 384, yNorm1 = 362, yAttTop = 290, yAttBot = 334, yAdd1 = 256, split2 = 240, yNorm2 = 216, yFfnTop = 146, yFfnBot = 190, yAdd2 = 108, yOut = 56;
const layouts = [
  { cls: 'fig-wide', W: 760, H: 560, cx: [170, 380, 590], cw: 22, res: 66, boxW: 104, legend: [8, 548], step: 130, rows: 1 },
  { cls: 'fig-narrow seq-narrow', W: 380, H: 596, cx: [64, 190, 316], cw: 17, res: 48, boxW: 80, legend: [8, 562], step: 180, rows: 2 },
];
const empty4 = ['', '', '', ''];
---

<Figure
  id={id}
  title={ru ? 'Блок трансформера: что куда идёт' : 'A Transformer block: what goes where'}
  caption={ru
    ? 'Три токена проходят один блок (pre-norm). К эмбеддингу каждого токена прибавляется вектор его позиции (1). Нормализованные векторы идут в self-attention — единственное место, где позиции обмениваются информацией (2); его результат прибавляется к остаточному пути (3), синей линии, которая обходит слой. Затем нормализованный вектор каждой позиции отдельно проходит одну и ту же двухслойную сеть FFN (4), и её результат снова прибавляется (5). Выход имеет ту же форму, что и вход, поэтому блоки складываются в стопку (6). Новое по сравнению с self-attention обведено: позиционный сигнал, сеть FFN, остаточные сложения и нормализация.'
    : 'Three tokens go through one (pre-norm) block. The vector of each token’s position is added to its embedding (1). The normalized vectors go into self-attention, the only place where positions exchange information (2); its result is added to the residual stream (3), the blue line that bypasses the layer. Then the normalized vector of each position goes, on its own, through the same two-layer network, the FFN (4), and its result is added again (5). The output has the shape of the input, so blocks stack (6). What is new compared with self-attention is outlined: the position signal, the FFN, the residual additions and the normalization.'}
>
  {layouts.map((L) => {
    const vw = 4 * L.cw;
    const attL = L.cx[0] - L.boxW / 2 - 14, attR = L.cx[2] + L.res + 10;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Один блок трансформера для трёх токенов' : 'One Transformer block for three tokens'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Снизу вверх для каждого из трёх токенов: эмбеддинг плюс позиция, нормализация, общий слой внимания, сложение с остаточным путём, нормализация, отдельная для каждой позиции сеть FFN с общими весами, второе сложение и выход в следующий блок.'
          : 'Bottom to top for each of three tokens: embedding plus position, normalization, a shared attention layer, addition to the residual stream, normalization, a per-position FFN with shared weights, a second addition and the output to the next block.'}</desc>
        <NewMark x={attL - 4} y={yPos - 18} w={attR - attL + 8} h={36} at="tr" />
        <NewMark x={attL - 4} y={yFfnTop - 10} w={attR - attL + 8} h={yAdd1 - 18 - (yFfnTop - 10)} at="tr" />
        {L.cx.map((cx, j) => (
          <g>
            <text class="f-small f-t-muted" x={cx} y={yWord} text-anchor="middle">{words[j]}</text>
            <g data-s="1">
              <Vec x={cx - vw / 2} y={yEmb} values={empty4} tone="x" dir="row" cw={L.cw} />
              <Arrow pts={[[cx, yEmb], [cx, yPos + 13]]} />
              <Op x={cx} y={yPos} sym="+" />
              <text class="f-math" x={cx + 18} y={yPos + 6}><Sub label={`p_${j + 1}`} /></text>
              <Arrow pts={[[cx, yPos - 13], [cx, yH + 24]]} />
              <Vec x={cx - vw / 2} y={yH} values={empty4} tone="h" dir="row" cw={L.cw} />
            </g>
            <g data-s="2">
              <Arrow pts={[[cx, yH], [cx, yNorm1 + 13]]} />
              <Op x={cx} y={yNorm1} sym="Norm" />
              <Arrow pts={[[cx, yNorm1 - 13], [cx, yAttBot + 2]]} />
            </g>
            <g data-s="3">
              <path class="f-line f-blue f-bold" d={`M ${cx} ${split1} H ${cx + L.res} V ${yAdd1} H ${cx + 15}`} marker-end="url(#f-arrow-blue)" />
              <Arrow pts={[[cx, yAttTop], [cx, yAdd1 + 15]]} />
              <Op x={cx} y={yAdd1} sym="+" />
            </g>
            <g data-s="4">
              <Arrow pts={[[cx, yAdd1 - 13], [cx, yNorm2 + 15]]} />
              <Op x={cx} y={yNorm2} sym="Norm" />
              <Arrow pts={[[cx, yNorm2 - 13], [cx, yFfnBot + 2]]} />
              <Box x={cx - L.boxW / 2} y={yFfnTop} w={L.boxW} h={yFfnBot - yFfnTop} label="FFN" sub={L.cls.includes('narrow') ? undefined : t.ffnSub} tone="n" />
            </g>
            <g data-s="5">
              <path class="f-line f-blue f-bold" d={`M ${cx} ${split2} H ${cx + L.res} V ${yAdd2} H ${cx + 15}`} marker-end="url(#f-arrow-blue)" />
              <Arrow pts={[[cx, yFfnTop], [cx, yAdd2 + 15]]} />
              <Op x={cx} y={yAdd2} sym="+" />
            </g>
            <g data-s="6">
              <Arrow pts={[[cx, yAdd2 - 13], [cx, yOut + 24]]} tone="blue" bold />
              <Vec x={cx - vw / 2} y={yOut} values={empty4} tone="h" dir="row" cw={L.cw} bold />
            </g>
          </g>
        ))}
        <g data-s="2">
          <rect x={attL} y={yAttTop} width={attR - attL} height={yAttBot - yAttTop} rx="9" style="fill: var(--fig-blue); fill-opacity: 0.06; stroke: var(--fig-blue); stroke-width: 1.3" />
          {L.cx.map((a) => L.cx.map((b) => <path class="f-thin f-muted" d={`M ${a} ${yAttBot} L ${b} ${yAttTop}`} />))}
          <text class="f-small f-t-blue f-halo" x={attL + 8} y={yAttTop + 16}>{t.attn}</text>
          <Badge x={attL - 2} y={yAttBot} n={2} />
        </g>
        <g data-s="1"><Badge x={L.cx[0] - vw / 2 - 12} y={yPos} n={1} /></g>
        <g data-s="3"><Badge x={L.cx[0] - 22} y={yAdd1 + 12} n={3} /></g>
        <g data-s="4"><Badge x={L.cx[0] - L.boxW / 2 - 2} y={yFfnTop} n={4} /></g>
        <g data-s="5"><Badge x={L.cx[0] - 22} y={yAdd2 + 12} n={5} /></g>
        <g data-s="6">
          <Badge x={L.cx[0] - vw / 2 - 12} y={yOut + 11} n={6} />
          <text class="f-small f-t-blue" x={L.cx[2] + vw / 2} y={yOut - 10} text-anchor="end">{t.next}</text>
        </g>
        <Legend x={L.legend[0]} y={L.legend[1]} step={L.step} rows={L.rows} />
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
