---
import Figure from '../Figure.astro';

// Post-norm (original) and pre-norm Transformer blocks, side by side.
interface Node { label: string; cls?: string; plain?: boolean }
const post: Node[] = [{ label: 'x', plain: true }, { label: 'multi-head attention', cls: 'f-fill-blue' }, { label: '+ x' }, { label: 'LayerNorm', cls: 'f-fill-amber' }, { label: 'feed-forward', cls: 'f-fill-green' }, { label: '+' }, { label: 'LayerNorm', cls: 'f-fill-amber' }, { label: 'out', plain: true }];
const pre: Node[] = [{ label: 'x', plain: true }, { label: 'LayerNorm', cls: 'f-fill-amber' }, { label: 'multi-head attention', cls: 'f-fill-blue' }, { label: '+ x' }, { label: 'LayerNorm', cls: 'f-fill-amber' }, { label: 'feed-forward', cls: 'f-fill-green' }, { label: '+' }, { label: 'out', plain: true }];
const boxW = 164;
const boxH = 30;
const step = 44;
// Residual skips: from node index a to node index b (drawn at the right).
const columns = [
  { title: 'post-norm (original)', nodes: post, skips: [[0, 2], [3, 5]] as [number, number][] },
  { title: 'pre-norm', nodes: pre, skips: [[0, 3], [3, 6]] as [number, number][] },
];

interface Layout { cls: string; w: number; h: number; xs: [number, number]; tops: [number, number] }
const layouts: Layout[] = [
  { cls: 'fig-wide', w: 620, h: 8 * step + 40, xs: [60, 380], tops: [36, 36] },
  { cls: 'fig-narrow', w: 360, h: 16 * step + 90, xs: [100, 100], tops: [36, 36 + 8 * step + 50] },
];
---

<Figure
  id="transformer-block-variants"
  title="Post-norm and pre-norm Transformer blocks"
  caption="Both blocks apply multi-head attention and then a position-wise feed-forward network, each wrapped in a residual connection (red). In the post-norm block of the original paper, LayerNorm is applied to the sum after each sub-layer, so the residual path passes through a normalization. In the pre-norm block, LayerNorm is applied to the input of each sub-layer and the residual path is an unbroken identity from x to out, which is why deep pre-norm stacks train without learning-rate warm-up."
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`transformer-block-variants-${L.w}-t transformer-block-variants-${L.w}-d`}>
      <title id={`transformer-block-variants-${L.w}-t`}>Post-norm versus pre-norm Transformer block</title>
      <desc id={`transformer-block-variants-${L.w}-d`}>Two vertical stacks of boxes. Post-norm: attention, add input, LayerNorm, feed-forward, add, LayerNorm. Pre-norm: LayerNorm, attention, add input, LayerNorm, feed-forward, add. Red residual arrows bypass each sub-layer on the right of each stack.</desc>
      {columns.map((col, ci) => {
        const x = L.xs[ci];
        const top = L.tops[ci];
        const y = (i: number) => top + i * step;
        return (
          <g>
            <text class="f-title" x={x + boxW / 2} y={top - 14} text-anchor="middle">{col.title}</text>
            {col.nodes.map((node, i) => (
              <g>
                {node.plain
                  ? <text class="f-math" x={x + boxW / 2} y={y(i) + boxH / 2 + 6} text-anchor="middle">{node.label}</text>
                  : <rect class={`f-box ${node.cls ?? ''}`} x={x} y={y(i)} width={boxW} height={boxH} rx="6" />}
                {!node.plain && <text class="f-small" x={x + boxW / 2} y={y(i) + boxH / 2 + 4} text-anchor="middle">{node.label}</text>}
                {i < col.nodes.length - 1 && <path class="f-line" d={`M ${x + boxW / 2} ${y(i) + boxH + 2} V ${y(i + 1) - 3}`} marker-end="url(#f-arrow)" />}
              </g>
            ))}
            {col.skips.map(([a, b]) => (
              <path class="f-line f-red" d={`M ${x + boxW + 2} ${y(a) + boxH / 2} H ${x + boxW + 26} V ${y(b) + boxH / 2} H ${x + boxW + 3}`} marker-end="url(#f-arrow-red)" />
            ))}
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
