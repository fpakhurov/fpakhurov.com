---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar, type Tone } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The multiplication in def f(price, qty): total = price * qty, as dis(f, adaptive=True) showed it on CPython 3.14.7:
// BINARY_OP 5 (*) as compiled, BINARY_OP_MULTIPLY_INT after calls with ints, BINARY_OP_MULTIPLY_FLOAT after calls with floats.
const names = ['BINARY_OP 5 (*)', 'BINARY_OP_MULTIPLY_INT', 'BINARY_OP_MULTIPLY_INT', 'BINARY_OP_MULTIPLY_FLOAT'];
if (3 * 4 !== 12 || 2.5 * 4.0 !== 10) throw new Error('the calls of the note');

interface Row { name: string; tone: Tone; note: [string, string]; arrow?: string }
const rows: Row[] = ru
  ? [
      { name: names[0], tone: 'g', note: ['общая версия: ищет умножение', 'у типа; кэш хранит счётчик'], arrow: 'f(3, 4): int * int' },
      { name: names[1], tone: 'h', note: ['проверка: оба int? тогда', 'прямое умножение, без поиска'], arrow: 'f(2.5, 4.0): float' },
      { name: names[2], tone: 'y', note: ['проверка не прошла: выполняется', 'общий путь, счётчик промахов'], arrow: 'после нескольких промахов' },
      { name: names[3], tone: 'h', note: ['проверка: оба float? тогда', 'прямое умножение double'] },
    ]
  : [
      { name: names[0], tone: 'g', note: ["generic: finds the type's multiply;", 'its cache holds a counter'], arrow: 'f(3, 4): int * int' },
      { name: names[1], tone: 'h', note: ['guard: both ints? then a direct', 'integer multiply, no lookup'], arrow: 'f(2.5, 4.0): a float' },
      { name: names[2], tone: 'y', note: ['the guard fails: the generic path', 'runs, and a miss is counted'], arrow: 'after a few misses' },
      { name: names[3], tone: 'h', note: ['guard: both floats? then a direct', 'multiply of two doubles'] },
    ];
const steps = ru
  ? ['компилятор выдаёт общую команду с кэшем', 'после разогрева она переписана под int', 'пришёл float: проверка не проходит, общий путь', 'после промахов команда переписана под float']
  : ['the compiler emits the generic instruction with a cache', 'after a warm-up it is rewritten for ints', 'a float arrives: the guard fails, the generic path runs', 'after a few misses it is rewritten for floats'];

interface Layout { cls: string; W: number; bx: number; bw: number; bh: number; gap: number; noteX: number | null; mono: number; sans: number; badgeX: number; lh: number; ax: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, bx: 40, bw: 300, bh: 34, gap: 34, noteX: 360, mono: 7.5, sans: 6.5, badgeX: 20, lh: 17, ax: 190 },
  { cls: 'fig-narrow seq-narrow', W: 360, bx: 34, bw: 318, bh: 76, gap: 36, noteX: null, mono: 8.4, sans: 7.3, badgeX: 17, lh: 19, ax: 74 },
];
for (const L of layouts) {
  for (const r of rows) {
    if (12 + r.name.length * L.mono > L.bw - 6) throw new Error(`"${r.name}" overflows at ${L.W}`);
    if (L.noteX !== null) for (const s of r.note) if (L.noteX + s.length * L.sans > L.W - 4) throw new Error(`note "${s}" overflows`);
    if (L.noteX === null) for (const s of r.note) if (12 + s.length * L.sans > L.bw - 6) throw new Error(`note "${s}" overflows the box`);
    if (r.arrow && L.ax + 10 + r.arrow.length * L.sans > L.W - 4) throw new Error(`arrow "${r.arrow}" overflows`);
  }
}
const H = (L: Layout) => 12 + rows.length * L.bh + (rows.length - 1) * L.gap + 10;
const id = 'specialization';
---

<Figure
  id={id}
  title={ru ? 'Специализация одной команды' : 'One instruction, specialized'}
  caption={ru
    ? 'Одно и то же место в байт-коде f(price, qty) — умножение — в CPython 3.14.7, как его показывает dis(f, adaptive=True). Компилятор выдаёт общую команду BINARY_OP со встроенным кэшем (1). После разогрева на f(3, 4) интерпретатор переписывает её на месте в BINARY_OP_MULTIPLY_INT: проверка типов и прямое умножение целых, без поиска метода (2). Когда приходят float, проверка не проходит, и выполняется общий путь (3); после нескольких промахов команда переписывается в BINARY_OP_MULTIPLY_FLOAT (4). Ни один шаг не меняет результат вычисления, только путь к нему.'
    : 'One place in the bytecode of f(price, qty), the multiplication, on CPython 3.14.7, as dis(f, adaptive=True) shows it. The compiler emits the generic BINARY_OP with an inline cache (1). After a warm-up on f(3, 4) the interpreter rewrites it in place as BINARY_OP_MULTIPLY_INT: a type check and a direct integer multiply, with no method lookup (2). When floats arrive, the check fails and the generic path runs (3); after a few misses the instruction is rewritten as BINARY_OP_MULTIPLY_FLOAT (4). No step changes the result of the computation, only the path to it.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${H(L)}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Одна команда в четырёх состояниях' : 'One instruction in four states'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Четыре блока сверху вниз: BINARY_OP, BINARY_OP_MULTIPLY_INT, та же команда при неудачной проверке и BINARY_OP_MULTIPLY_FLOAT. Стрелки между ними подписаны: f(3, 4), f(2.5, 4.0) и «после нескольких промахов».'
        : 'Four boxes from top to bottom: BINARY_OP, BINARY_OP_MULTIPLY_INT, the same instruction when its guard fails, and BINARY_OP_MULTIPLY_FLOAT. The arrows between them are labelled f(3, 4), f(2.5, 4.0) and after a few misses.'}</desc>
      {rows.map((r, k) => {
        const top = 12 + k * (L.bh + L.gap);
        const midX = L.ax;
        return (
          <g data-s={String(k + 1)}>
            <rect x={L.bx} y={top} width={L.bw} height={L.bh} rx="7" style={`fill: ${toneVar[r.tone]}; fill-opacity: 0.12; stroke: ${toneVar[r.tone]}; stroke-width: 1.3; ${r.tone === 'y' ? 'stroke-dasharray: 6 5' : ''}`} />
            <text class="f-small" x={L.bx + 12} y={top + 22} style="font-family: var(--mono); font-weight: 650">{r.name}</text>
            {L.noteX !== null && r.note.map((s, i) => <text class="f-small f-t-muted" x={L.noteX!} y={top + 12 + i * L.lh}>{s}</text>)}
            {L.noteX === null && r.note.map((s, i) => <text class="f-small f-t-muted" x={L.bx + 12} y={top + 22 + (i + 1) * L.lh + 2}>{s}</text>)}
            {r.arrow && <path class="f-line f-muted" d={`M ${midX} ${top + L.bh + 2} V ${top + L.bh + L.gap - 3}`} marker-end="url(#f-arrow-muted)" />}
            {r.arrow && <text class="f-small f-t-blue" x={midX + 10} y={top + L.bh + L.gap / 2 + 5}>{r.arrow}</text>}
            <Badge x={L.badgeX} y={top + 17} n={k + 1} />
          </g>
        );
      })}
    </svg>
  ))}
  <Stepper steps={steps} />
</Figure>
