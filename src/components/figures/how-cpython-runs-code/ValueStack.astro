---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// f(3, 4) for def f(price, qty): total = price * qty; return total + 1, on CPython 3.14.7.
// The instructions are the output of dis.dis(f) after RESUME. The figure replays them on a small stack machine
// and draws the value stack and the three local slots after each instruction.
type Ins = { text: string; run: (st: number[], loc: (number | null)[]) => void };
const prog: Ins[] = [
  { text: 'LOAD_FAST_BORROW_LOAD_FAST_BORROW 1', run: (st, loc) => { st.push(loc[0]!, loc[1]!); } },
  { text: 'BINARY_OP 5 (*)', run: (st) => { const b = st.pop()!, a = st.pop()!; st.push(a * b); } },
  { text: 'STORE_FAST 2 (total)', run: (st, loc) => { loc[2] = st.pop()!; } },
  { text: 'LOAD_FAST_BORROW 2 (total)', run: (st, loc) => { st.push(loc[2]!); } },
  { text: 'LOAD_SMALL_INT 1', run: (st) => { st.push(1); } },
  { text: 'BINARY_OP 0 (+)', run: (st) => { const b = st.pop()!, a = st.pop()!; st.push(a + b); } },
  { text: 'RETURN_VALUE', run: (st) => { st.pop(); } },
];
const stack: number[] = [];
const locals: (number | null)[] = [3, 4, null];
const snaps = prog.map((ins) => {
  const before = stack.length;
  const top = stack[stack.length - 1];
  ins.run(stack, locals);
  const pushed = stack.length - before;
  return { stack: [...stack], locals: [...locals], fresh: stack.map((_, i) => i >= stack.length - pushed), returned: ins.text === 'RETURN_VALUE' ? top : null };
});
if (snaps[1].stack.join() !== '12' || snaps[5].stack.join() !== '13' || snaps[6].returned !== 13) throw new Error('replay');
if (Math.max(...snaps.map((s) => s.stack.length)) !== 2) throw new Error('co_stacksize is 2');
const localNames = ['price', 'qty', 'total'];

const t = ru
  ? { ins: 'команда', stack: 'стек значений (вершина справа)', locals: 'локальные', ret: 'вернуть 13',
      steps: ['одна команда кладёт на стек price и qty', 'BINARY_OP * снимает два значения и кладёт 12', 'STORE_FAST снимает 12 в слот total', 'LOAD_FAST_BORROW кладёт total обратно', 'LOAD_SMALL_INT кладёт константу 1', 'BINARY_OP + снимает 12 и 1 и кладёт 13', 'RETURN_VALUE снимает 13 и отдаёт вызывающему'] }
  : { ins: 'instruction', stack: 'value stack (top on the right)', locals: 'locals', ret: 'return 13',
      steps: ['one instruction pushes price and qty', 'BINARY_OP * pops two values and pushes 12', 'STORE_FAST pops 12 into the slot total', 'LOAD_FAST_BORROW pushes total back', 'LOAD_SMALL_INT pushes the constant 1', 'BINARY_OP + pops 12 and 1 and pushes 13', 'RETURN_VALUE pops 13 and hands it to the caller'] };

interface Layout { cls: string; W: number; y0: number; rowH: number; insX: number; insY: number; sx: number; cw: number; lx: number; lw: number; cellY: number; ch: number; mono: number; sans: number; badgeX: number; headY: number; wide: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, y0: 44, rowH: 40, insX: 44, insY: 25, sx: 330, cw: 52, lx: 540, lw: 62, cellY: 8, ch: 26, mono: 7.5, sans: 6.5, badgeX: 22, headY: 26, wide: true },
  { cls: 'fig-narrow seq-narrow', W: 360, y0: 48, rowH: 66, insX: 34, insY: 18, sx: 34, cw: 46, lx: 160, lw: 58, cellY: 28, ch: 28, mono: 8.4, sans: 7.3, badgeX: 17, headY: 22, wide: false },
];
for (const L of layouts) {
  for (const ins of prog) if (L.insX + ins.text.length * L.mono > (L.wide ? L.sx - 12 : L.W - 4)) throw new Error(`"${ins.text}" overflows at ${L.W}`);
  if (L.sx + 2 * (L.cw + 4) > L.lx - 8) throw new Error('stack runs into locals');
  if (L.lx + 3 * (L.lw + 6) > L.W - 2) throw new Error('locals overflow');
  if (L.wide && L.sx + t.stack.length * L.sans > L.lx - 6) throw new Error('stack header');
}
const H = (L: Layout) => L.y0 + prog.length * L.rowH + 6;
const id = 'value-stack';
---

<Figure
  id={id}
  title={ru ? 'Байт-код выполняется на стеке значений' : 'Bytecode runs on the value stack'}
  caption={ru
    ? 'Вызов f(3, 4) для def f(price, qty): total = price * qty; return total + 1 в CPython 3.14.7. Каждая строка — одна команда из вывода dis и состояние кадра после неё: стек значений (синие ячейки, вершина справа) и три слота локальных переменных. Команды берут операнды с вершины стека и кладут результат обратно; имена price, qty и total хранятся в пронумерованных слотах кадра, поэтому LOAD_FAST_BORROW 2 обращается к слоту по номеру, без поиска по имени. Глубина стека не превышает 2 — это co_stacksize функции.'
    : 'The call f(3, 4) for def f(price, qty): total = price * qty; return total + 1, on CPython 3.14.7. Each row is one instruction from the output of dis and the state of the frame after it: the value stack (blue cells, top on the right) and the three slots for local variables. Instructions take their operands from the top of the stack and push their result back; price, qty and total live in numbered slots of the frame, so LOAD_FAST_BORROW 2 reaches its slot by number, with no lookup by name. The stack never holds more than 2 values, the function’s co_stacksize.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${H(L)}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Семь команд и состояние стека после каждой' : 'Seven instructions and the stack after each'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Семь строк. Стек после каждой команды: 3 и 4; 12; пусто, total равно 12; 12; 12 и 1; 13; пусто, функция возвращает 13. Слоты price и qty равны 3 и 4 всё время.'
        : 'Seven rows. The stack after each instruction: 3 and 4; 12; empty, with total set to 12; 12; 12 and 1; 13; empty, and the function returns 13. The slots price and qty hold 3 and 4 throughout.'}</desc>
      {L.wide && <text class="f-small f-t-muted" x={L.insX} y={L.headY} style="font-weight: 650">{t.ins}</text>}
      {L.wide && <text class="f-small f-t-muted" x={L.sx} y={L.headY} style="font-weight: 650">{t.stack}</text>}
      {!L.wide && <text class="f-small f-t-muted" x={L.sx} y={L.headY} style="font-weight: 650">{ru ? 'стек →' : 'stack →'}</text>}
      {localNames.map((n, i) => (
        <text class="f-small f-t-muted" x={L.lx + i * (L.lw + 6) + L.lw / 2} y={L.headY} text-anchor="middle" style="font-family: var(--mono); font-weight: 650">{n}</text>
      ))}
      {snaps.map((s, k) => {
        const top = L.y0 + k * L.rowH;
        const cy = top + L.cellY;
        return (
          <g data-s={String(k + 1)}>
            <Badge x={L.badgeX} y={top + (L.wide ? 20 : 13)} n={k + 1} />
            <text class="f-small" x={L.insX} y={top + L.insY} style="font-family: var(--mono)">{prog[k].text}</text>
            {s.stack.map((v, i) => {
              const fresh = s.fresh[i];
              return (
                <g>
                  <rect x={L.sx + i * (L.cw + 4)} y={cy} width={L.cw} height={L.ch} rx="4" style={`fill: ${toneVar.h}; fill-opacity: ${fresh ? 0.28 : 0.1}; stroke: ${toneVar.h}; stroke-width: ${fresh ? 1.6 : 1}`} />
                  <text class="f-small" x={L.sx + i * (L.cw + 4) + L.cw / 2} y={cy + L.ch / 2 + 4.5} text-anchor="middle" style="font-family: var(--mono)">{String(v)}</text>
                </g>
              );
            })}
            {s.stack.length === 0 && s.returned === null && <text class="f-small f-t-muted" x={L.sx + 4} y={cy + L.ch / 2 + 4.5}>{ru ? 'пусто' : 'empty'}</text>}
            {s.returned !== null && <text class="f-small f-t-red" x={L.sx + 4} y={cy + L.ch / 2 + 4.5} style="font-weight: 650">{`→ ${t.ret}`}</text>}
            {s.locals.map((v, i) => {
              const changed = k === 2 && i === 2;
              return (
                <g>
                  <rect x={L.lx + i * (L.lw + 6)} y={cy} width={L.lw} height={L.ch} rx="4" style={`fill: ${changed ? toneVar.g : 'var(--paper-strong)'}; fill-opacity: ${changed ? 0.22 : 1}; stroke: ${changed ? toneVar.g : 'var(--line)'}; stroke-width: ${changed ? 1.6 : 1}`} />
                  <text class={`f-small${v === null ? ' f-t-muted' : ''}`} x={L.lx + i * (L.lw + 6) + L.lw / 2} y={cy + L.ch / 2 + 4.5} text-anchor="middle" style="font-family: var(--mono)">{v === null ? '–' : String(v)}</text>
                </g>
              );
            })}
          </g>
        );
      })}
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
