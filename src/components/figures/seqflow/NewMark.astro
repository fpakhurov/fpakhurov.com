---
/** Amber dashed outline around the parts a model adds to the previous one in the series. */
import { pageLang } from '../../../utils/lang';
interface Props { x: number; y: number; w: number; h: number; label?: string; at?: 'tl' | 'tr' | 'bl' | 'br' }
const { x, y, w, h, label, at = 'tl' } = Astro.props;
const ru = pageLang(Astro.url) === 'ru';
const text = label ?? (ru ? 'новое' : 'new');
const tx = at === 'tl' || at === 'bl' ? x + 6 : x + w - 6;
const ty = at === 'tl' || at === 'tr' ? y - 5 : y + h + 14;
---
<g>
  <rect x={x} y={y} width={w} height={h} rx="10" style="fill: var(--fig-amber); fill-opacity: 0.05; stroke: var(--fig-amber); stroke-width: 1.4; stroke-dasharray: 6 4" />
  <text class="f-small f-t-amber" x={tx} y={ty} text-anchor={at === 'tl' || at === 'bl' ? 'start' : 'end'} style="font-weight: 650">{text}</text>
</g>
