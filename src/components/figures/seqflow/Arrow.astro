---
/** A polyline with an arrowhead and an optional label (a weight such as W_x or ×0.5). */
import Sub from '../generative-modeling/Sub.astro';
import type { Tone } from './tones';
import { toneText } from './tones';

interface Props {
  pts: [number, number][];
  tone?: 'ink' | 'muted' | 'blue' | 'green' | 'amber' | 'red';
  dashed?: boolean; bold?: boolean;
  label?: string; at?: [number, number]; anchor?: 'start' | 'middle' | 'end'; labelTone?: Tone;
  head?: boolean;
}
const { pts, tone = 'muted', dashed = false, bold = false, label, at, anchor = 'start', labelTone = 'g', head = true } = Astro.props;
const d = pts.map((p, i) => `${i ? 'L' : 'M'} ${p[0]} ${p[1]}`).join(' ');
const cls = `f-line ${tone === 'ink' ? '' : `f-${tone}`}${dashed ? ' f-dash' : ''}${bold ? ' f-bold' : ''}`;
const marker = head ? `url(#f-arrow${tone === 'ink' ? '' : `-${tone}`})` : undefined;
---
<g>
  <path class={cls} d={d} marker-end={marker} />
  {label && at && <text class={`f-small ${toneText[labelTone]} f-halo`} x={at[0]} y={at[1]} text-anchor={anchor}><Sub label={label} /></text>}
</g>
