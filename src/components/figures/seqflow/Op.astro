---
/** An operation node: a circle for one-character operators (+, ×), a pill for named functions (tanh, σ, softmax). */
interface Props { x: number; y: number; sym: string; tone?: 'ink' | 'amber' }
const { x, y, sym, tone = 'ink' } = Astro.props;
const pill = sym.length > 1;
const w = pill ? 14 + sym.length * 7.6 : 26;
const stroke = tone === 'amber' ? 'var(--fig-amber)' : 'var(--ink)';
---
<g>
  {pill
    ? <rect x={x - w / 2} y={y - 13} width={w} height="26" rx="13" style={`fill: var(--paper); stroke: ${stroke}; stroke-width: 1.4`} />
    : <circle cx={x} cy={y} r="13" style={`fill: var(--paper); stroke: ${stroke}; stroke-width: 1.4`} />}
  <text class="f-label" x={x} y={y + 5} text-anchor="middle">{sym}</text>
</g>
