---
/** The colour key shared by every figure of the sequence-model series. */
import { pageLang } from '../../../utils/lang';
import { toneVar, type Tone } from './tones';
interface Props { x: number; y: number; step?: number; rows?: number }
const { x, y, step = 120, rows = 1 } = Astro.props;
const ru = pageLang(Astro.url) === 'ru';
const items: [Tone, string][] = ru
  ? [['x', 'вход'], ['h', 'состояние'], ['g', 'веса и гейты'], ['y', 'выход']]
  : [['x', 'input'], ['h', 'state'], ['g', 'weights, gates'], ['y', 'output']];
const perRow = Math.ceil(items.length / rows);
---
<g>
  {items.map(([t, label], i) => {
    const cx = x + (i % perRow) * step, cy = y + Math.floor(i / perRow) * 20;
    return (
      <g>
        <rect x={cx} y={cy - 10} width="14" height="12" style={`fill: ${toneVar[t]}; fill-opacity: 0.14; stroke: ${toneVar[t]}; stroke-width: 1.2`} />
        <text class="f-small f-t-muted" x={cx + 20} y={cy}>{label}</text>
      </g>
    );
  })}
</g>
