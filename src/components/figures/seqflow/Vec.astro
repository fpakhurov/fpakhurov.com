---
/** A vector drawn as a column (or row) of cells with its values, as in the step-by-step diagrams of the sequence notes. */
import Sub from '../generative-modeling/Sub.astro';
import { toneVar, type Tone } from './tones';

interface Props {
  x: number; y: number;
  values: string[];
  tone?: Tone;
  label?: string;
  labelPos?: 'above' | 'below' | 'left' | 'right';
  dir?: 'col' | 'row';
  cw?: number; ch?: number;
  bold?: boolean;
}
const { x, y, values, tone = 'h', label, labelPos = 'above', dir = 'col', cw = 40, ch = 22, bold = false } = Astro.props;
const n = values.length;
const W = dir === 'col' ? cw : cw * n;
const H = dir === 'col' ? ch * n : ch;
const c = toneVar[tone];
const lx = labelPos === 'left' ? x - 6 : labelPos === 'right' ? x + W + 6 : x + W / 2;
const ly = labelPos === 'above' ? y - 11 : labelPos === 'below' ? y + H + 16 : y + H / 2 + 5;
const anchor = labelPos === 'left' ? 'end' : labelPos === 'right' ? 'start' : 'middle';
---
<g>
  {values.map((v, i) => {
    const cx = dir === 'col' ? x : x + i * cw;
    const cy = dir === 'col' ? y + i * ch : y;
    return (
      <g>
        <rect x={cx} y={cy} width={cw} height={ch} style={`fill: ${c}; fill-opacity: 0.14; stroke: ${c}; stroke-width: ${bold ? 2.2 : 1.2}`} />
        <text class="f-small" x={cx + cw / 2} y={cy + ch / 2 + 4.5} text-anchor="middle">{v}</text>
      </g>
    );
  })}
  {label && <text class="f-math" x={lx} y={ly} text-anchor={anchor}><Sub label={label} /></text>}
</g>
