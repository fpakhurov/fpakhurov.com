---
/** A labelled block (a weight matrix, a layer); the label may use _x subscripts. */
import Sub from '../generative-modeling/Sub.astro';
import { toneVar, type Tone } from './tones';
interface Props { x: number; y: number; w: number; h: number; label: string; sub?: string; tone?: Tone; math?: boolean; subGap?: number }
const { x, y, w, h, label, sub, tone = 'n', math = false, subGap = 15 } = Astro.props;
const c = toneVar[tone];
---
<g>
  <rect x={x} y={y} width={w} height={h} rx="7" style={`fill: ${tone === 'n' ? 'var(--paper-strong)' : c}; fill-opacity: ${tone === 'n' ? 1 : 0.14}; stroke: ${tone === 'n' ? 'var(--line)' : c}; stroke-width: 1.3`} />
  <text class={math ? 'f-math' : 'f-label'} x={x + w / 2} y={y + (sub ? h / 2 - 1 - (subGap - 15) / 2 : h / 2 + 5)} text-anchor="middle"><Sub label={label} /></text>
  {sub && <text class="f-small f-t-muted" x={x + w / 2} y={y + h / 2 + subGap - 1 - (subGap - 15) / 2} text-anchor="middle">{sub}</text>}
</g>
