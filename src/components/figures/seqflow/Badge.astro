---
/** A numbered step marker; the numbers match the step list printed under the figure. */
interface Props { x: number; y: number; n: number }
const { x, y, n } = Astro.props;
---
<g class="seq-badge" data-badge={n}>
  <circle cx={x} cy={y} r="9.5" />
  <text x={x} y={y + 4.3} text-anchor="middle" style="fill: var(--paper); font-size: 12px; font-weight: 700">{n}</text>
</g>
