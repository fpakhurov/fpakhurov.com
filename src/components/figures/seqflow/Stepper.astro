---
/**
 * Step-through controls for a flow figure. Elements of the figure marked data-s="n" (or "n m") belong to step n;
 * pressing ▶ shows the steps one by one: the current step at full strength with its numbered badge highlighted,
 * earlier steps faded, later steps almost hidden. Without JavaScript the bar stays hidden and the figure shows
 * every step at once, as does the "all steps" state the figure starts in.
 */
import { pageLang } from '../../../utils/lang';
interface Props { steps: string[] }
const { steps } = Astro.props;
const ru = pageLang(Astro.url) === 'ru';
const t = ru
  ? { all: `Все ${steps.length} шагов · нажмите ▶, чтобы пройти по одному`, prev: 'Предыдущий шаг', next: 'Следующий шаг', reset: 'Показать все шаги', allBtn: 'Все' }
  : { all: `All ${steps.length} steps · press ▶ to go one at a time`, prev: 'Previous step', next: 'Next step', reset: 'Show all steps', allBtn: 'All' };
---
<div class="fig-stepper" data-stepper data-steps={JSON.stringify(steps)} data-all-label={t.all} hidden>
  <button type="button" class="stepper-prev" aria-label={t.prev}>◀</button>
  <span class="stepper-label" aria-live="polite">{t.all}</span>
  <button type="button" class="stepper-next" aria-label={t.next}>▶</button>
  <button type="button" class="stepper-all" aria-label={t.reset}>{t.allBtn}</button>
</div>

<script>
  function setup(bar: HTMLElement) {
    const fig = bar.closest('.fig');
    if (!fig || bar.dataset.ready) return;
    bar.dataset.ready = '1';
    const steps: string[] = JSON.parse(bar.dataset.steps ?? '[]');
    const n = steps.length;
    const els = [...fig.querySelectorAll<SVGElement>('[data-s]')];
    const badges = [...fig.querySelectorAll<SVGElement>('[data-badge]')];
    const label = bar.querySelector<HTMLElement>('.stepper-label')!;
    const prev = bar.querySelector<HTMLButtonElement>('.stepper-prev')!;
    const next = bar.querySelector<HTMLButtonElement>('.stepper-next')!;
    const all = bar.querySelector<HTMLButtonElement>('.stepper-all')!;
    let cur = 0; // 0 shows every step
    const render = () => {
      for (const el of els) {
        const own = (el.dataset.s ?? '').split(/\s+/).map(Number);
        el.classList.remove('s-past', 's-now', 's-future');
        if (!cur) continue;
        el.classList.add(own.includes(cur) ? 's-now' : Math.min(...own) > cur ? 's-future' : 's-past');
      }
      for (const b of badges) b.classList.toggle('s-badge-now', Number(b.dataset.badge) === cur);
      fig.classList.toggle('stepping', cur > 0);
      label.textContent = cur ? `${cur} / ${n} · ${steps[cur - 1]}` : bar.dataset.allLabel ?? '';
      prev.disabled = cur === 1;
      all.disabled = cur === 0;
    };
    const go = (k: number) => { cur = k < 0 ? 0 : k > n ? 0 : k; render(); };
    next.addEventListener('click', () => go(cur === n ? 0 : cur + 1));
    prev.addEventListener('click', () => go(cur === 0 ? n : cur - 1));
    all.addEventListener('click', () => go(0));
    bar.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); next.click(); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); prev.click(); }
    });
    // Horizontal swipes on the drawing step forward and back on touch screens.
    const body = fig.querySelector<HTMLElement>('.fig-body');
    let x0: number | null = null, y0 = 0;
    body?.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; y0 = e.touches[0].clientY; }, { passive: true });
    body?.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0, dy = e.changedTouches[0].clientY - y0;
      x0 = null;
      if (Math.abs(dx) > 50 && Math.abs(dx) > 2 * Math.abs(dy)) (dx < 0 ? next : prev).click();
    });
    bar.hidden = false;
    render();
  }
  const init = () => document.querySelectorAll<HTMLElement>('[data-stepper]').forEach(setup);
  init();
  document.addEventListener('astro:page-load', init);
</script>
