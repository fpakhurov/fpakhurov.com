---
import Figure from '../Figure.astro';
import { polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The two maps of the note: A = [[2, 1], [0, 1]] (invertible) and B = [[1, 2], [1/2, 1]] (rank one).
// Each panel draws the image of the same square grid on [-1, 1]² and of the unit circle.
type M2 = [[number, number], [number, number]];
type P2 = [number, number];
const I: M2 = [[1, 0], [0, 1]];
const A: M2 = [[2, 1], [0, 1]];
const B: M2 = [[1, 2], [0.5, 1]];
const apply = (M: M2, [x, y]: P2): P2 => [M[0][0] * x + M[0][1] * y, M[1][0] * x + M[1][1] * y];
const det = (M: M2) => M[0][0] * M[1][1] - M[0][1] * M[1][0];
// Checks against the text: A e1 = (2, 0), A e2 = (1, 1), A(3, -2) = (4, -2); B kills (2, -1) and sends everything onto the line through (2, 1).
const Ae1 = apply(A, [1, 0]), Ae2 = apply(A, [0, 1]), A32 = apply(A, [3, -2]), Bk = apply(B, [2, -1]);
if (Ae1.join() !== '2,0' || Ae2.join() !== '1,1' || A32.join() !== '4,-2' || Bk.join() !== '0,0' || det(B) !== 0 || det(A) !== 2)
  throw new Error('LinearMapGrid: the maps drifted from the note');
// The unit circle under B is the segment between ±√5 (1, 1/2): the largest value of x1 + 2 x2 on the circle is √5.
const circle = Array.from({ length: 181 }, (_, i) => [Math.cos((2 * Math.PI * i) / 180), Math.sin((2 * Math.PI * i) / 180)] as P2);
const bReach = Math.max(...circle.map((p) => apply(B, p)[0]));
if (Math.abs(bReach - Math.sqrt(5)) > 1e-3) throw new Error('LinearMapGrid: the image of the circle under B drifted');

const t = ru
  ? { p1: 'вход x', p2: 'Ax: A обратима', p3: 'Bx: ранг B равен 1', e1: 'e₁', e2: 'e₂', Ae1: 'Ae₁ = (2, 0)', Ae2: 'Ae₂ = (1, 1)', Be1: 'Be₁', Be2: 'Be₂', ker: 'ker B', im: 'im B',
      title: 'Линейное отображение переводит сетку в сетку, а окружность в эллипс',
      tt: 'Образ сетки и единичной окружности под действием двух матриц',
      desc: 'Три панели. Слева: квадратная сетка на [−1, 1]², единичная окружность, базисные векторы e₁, e₂ и пунктирная прямая ker B вдоль (2, −1). В центре: под действием A сетка становится сеткой параллелограммов, окружность — эллипсом, e₁ переходит в (2, 0), e₂ — в (1, 1). Справа: B сплющивает всю плоскость на прямую im B вдоль (2, 1); окружность становится отрезком.' }
  : { p1: 'the input x', p2: 'Ax: A invertible', p3: 'Bx: B of rank 1', e1: 'e₁', e2: 'e₂', Ae1: 'Ae₁ = (2, 0)', Ae2: 'Ae₂ = (1, 1)', Be1: 'Be₁', Be2: 'Be₂', ker: 'ker B', im: 'im B',
      title: 'A linear map sends a grid to a grid and a circle to an ellipse',
      tt: 'The image of a grid and of the unit circle under two matrices',
      desc: 'Three panels. Left: a square grid on [−1, 1]², the unit circle, the basis vectors e₁, e₂ and a dashed line ker B along (2, −1). Middle: under A the grid becomes a grid of parallelograms, the circle an ellipse, e₁ goes to (2, 0) and e₂ to (1, 1). Right: B flattens the whole plane onto the line im B along (2, 1); the circle becomes a segment.' };
const caption = ru
  ? 'Каждая панель — образ картинки слева. A = (2 1; 0 1) переводит e₁ в (2, 0), а e₂ — в (1, 1): сетка становится параллелограммами, а окружность — эллипсом. B = (1 2; 1/2 1) имеет ранг 1: плоскость сплющивается на прямую im B вдоль (2, 1), а прямая ker B вдоль (2, −1) переходит в 0.'
  : 'Each panel is the image of the picture on the left. A = (2 1; 0 1) sends e₁ to (2, 0) and e₂ to (1, 1): the grid becomes parallelograms and the circle an ellipse. B = (1 2; 1/2 1) has rank 1: the plane collapses onto im B along (2, 1), and ker B along (2, −1) goes to 0.';

const id = 'linear-map-grid';
type Label = { x: number; y: number; text: string; cls: string; anchor?: 'start' | 'middle' | 'end' };
// Wide: three panels side by side. Narrow: three panels stacked.
const layouts = [
  { cls: 'fig-wide fig-bp-640', W: 760, H: 214, s: 36.5, panels: [[128, 118], [380, 118], [632, 118]] as P2[], titleDy: -94 },
  { cls: 'fig-narrow fig-bp-640 seq-narrow', W: 360, H: 612, s: 50, panels: [[180, 116], [180, 316], [180, 516]] as P2[], titleDy: -92 },
];
const ticks = [-1, -0.5, 0, 0.5, 1];
const draw = (L: (typeof layouts)[number]) => {
  const out = [I, A, B].map((M, k) => {
    const [cx, cy] = L.panels[k];
    const S = (p: P2): P2 => [cx + L.s * p[0], cy - L.s * p[1]];
    const T = (p: P2) => S(apply(M, p));
    const grid = ticks.flatMap((v) => [polyline([T([v, -1]), T([v, 1])]), polyline([T([-1, v]), T([1, v])])]);
    const circ = polyline(circle.map(T));
    const axes = [polyline([S([-3.2, 0]), S([3.2, 0])]), polyline([S([0, -1.75]), S([0, 1.75])])];
    return { S, T, grid, circ, axes, o: S([0, 0]), e1: T([1, 0]), e2: T([0, 1]) };
  });
  const [p1, p2, p3] = out;
  // ker B and im B drawn as the segments between ±1.5 (2, −1) and ±1.5 (2, 1).
  const kerEnd = p1.S([3.0, -1.5]);
  const ker = polyline([p1.S([-3.0, 1.5]), kerEnd]);
  const imEnd = p3.S([3.0, 1.5]);
  const im = polyline([p3.S([-3.0, -1.5]), imEnd]);
  const titleY = (k: number) => L.panels[k][1] + L.titleDy;
  const labels: Label[] = [
    { x: L.panels[0][0], y: titleY(0), text: t.p1, cls: 'f-small', anchor: 'middle' },
    { x: L.panels[1][0], y: titleY(1), text: t.p2, cls: 'f-small', anchor: 'middle' },
    { x: L.panels[2][0], y: titleY(2), text: t.p3, cls: 'f-small', anchor: 'middle' },
    { x: p1.e1[0] + 6, y: p1.e1[1] + 16, text: t.e1, cls: 'f-small f-t-green' },
    { x: p1.e2[0] - 7, y: p1.e2[1] - 5, text: t.e2, cls: 'f-small f-t-amber', anchor: 'end' },
    { x: kerEnd[0] - 4, y: kerEnd[1] + 16, text: t.ker, cls: 'f-small f-t-red', anchor: 'end' },
    { x: p2.e1[0], y: p2.e1[1] + 18, text: t.Ae1, cls: 'f-small f-t-green', anchor: 'middle' },
    { x: p2.e2[0] + 7, y: p2.e2[1] - 7, text: t.Ae2, cls: 'f-small f-t-amber' },
    { x: p3.e1[0] + 4, y: p3.e1[1] + 17, text: t.Be1, cls: 'f-small f-t-green' },
    { x: p3.e2[0] - 6, y: p3.e2[1] - 8, text: t.Be2, cls: 'f-small f-t-amber', anchor: 'end' },
    { x: imEnd[0] - 4, y: imEnd[1] - 8, text: t.im, cls: 'f-small f-t-blue', anchor: 'end' },
  ];
  return { out, ker, im, labels };
};
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const D = draw(L);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.tt}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        {D.out.map((P, k) => (
          <g>
            {P.axes.map((d) => <path class="f-grid" d={d} />)}
            {P.grid.map((d) => <path class="f-thin f-muted" style="stroke-opacity: .55" d={d} />)}
            <path class={k === 2 ? 'f-line f-blue f-bold' : 'f-line f-blue'} d={P.circ} />
            <path class="f-line f-green" d={`M ${P.o[0]} ${P.o[1]} L ${P.e1[0]} ${P.e1[1]}`} marker-end="url(#f-arrow-green)" />
            <path class="f-line f-amber" d={`M ${P.o[0]} ${P.o[1]} L ${P.e2[0]} ${P.e2[1]}`} marker-end="url(#f-arrow-amber)" />
          </g>
        ))}
        <path class="f-line f-red f-dash" d={D.ker} />
        <path class="f-thin f-blue f-dash" d={D.im} />
        <circle cx={D.out[2].o[0]} cy={D.out[2].o[1]} r="3.5" class="f-solid-red" />
        {D.labels.map((l) => <text class={`${l.cls} f-halo`} x={l.x} y={l.y} text-anchor={l.anchor ?? 'start'}>{l.text}</text>)}
      </svg>
    );
  })}
</Figure>
