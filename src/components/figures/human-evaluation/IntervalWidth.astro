---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Half-width of the 95 % Wilson interval for an observed rate of 0.5 after n judgements.
const z = 1.959964;
const half = (n: number, p = 0.5) => {
  const d = 1 + (z * z) / n;
  return (z / d) * Math.sqrt((p * (1 - p)) / n + (z * z) / (4 * n * n));
};
const marks = [
  { n: 100, label: ru ? '100 суждений' : '100 judgements' },
  { n: 200, label: ru ? '200: пример в тексте' : '200: the example in the text' },
  { n: 783, label: ru ? '783: 0.45 против 0.5' : '783: 0.45 against 0.5' },
];
if (half(200).toFixed(3) !== '0.069' || half(783).toFixed(3) !== '0.035') throw new Error('IntervalWidth: numbers drifted from the note');
const t = ru
  ? { x: 'число суждений n (логарифмическая шкала)', y: '± полуширина 95% интервала' }
  : { x: 'number of judgements n (log scale)', y: '± half-width of the 95% interval' };
const id = 'human-evaluation-interval-width';
const layouts = [
  { sfx: 'w', cls: 'fig-wide fig-medium', W: 600, H: 330, left: 70, right: 560, top: 24, bottom: 270 },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 330, left: 56, right: 340, top: 24, bottom: 260 },
];
---

<Figure
  id={id}
  title={ru ? 'Сколько суждений нужно для точности ±0.05' : 'How many judgements an answer of ±0.05 takes'}
  caption={ru
    ? 'Полуширина 95%-го интервала Уилсона для доли ошибок около 0.5 в зависимости от числа суждений. Она убывает как 1/√n: 200 суждений дают ±0.069, а чтобы сократить её вдвое, нужно вчетверо больше. Чтобы отличить 45% от 50% с мощностью 0.8, нужно около 783 независимых суждений.'
    : 'Half-width of the 95% Wilson interval for an error rate near 0.5 against the number of judgements. It shrinks like 1/√n: 200 judgements give ±0.069, and halving it takes four times as many. Telling 45% from 50% with power 0.8 takes about 783 independent judgements.'}
>
  {layouts.map((L) => {
    const sx = scale([1, Math.log10(3000)], [L.left, L.right]);
    const sy = scale([0, 0.32], [L.bottom, L.top]);
    const narrow = L.sfx === 'n';
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{ru ? 'Ширина доверительного интервала и число суждений' : 'Interval width and the number of judgements'}</title>
        <desc id={`${id}-${L.sfx}-d`}>{ru ? 'Убывающая кривая от ±0.26 при 10 суждениях до ±0.018 при 3000. Отмечены 100 суждений (±0.096), 200 (±0.069) и 783 (±0.035).' : 'A decreasing curve from ±0.26 at 10 judgements to ±0.018 at 3000. Marked: 100 judgements (±0.096), 200 (±0.069) and 783 (±0.035).'}</desc>
        {[0, 0.1, 0.2, 0.3].map((y) => <line class="f-grid" x1={L.left} x2={L.right} y1={sy(y)} y2={sy(y)} />)}
        {[0, 0.1, 0.2, 0.3].map((y) => <text class="f-note" x={L.left - 10} y={sy(y) + 5} text-anchor="end">{y}</text>)}
        {[10, 30, 100, 300, 1000, 3000].map((n) => <text class="f-note" x={sx(Math.log10(n))} y={L.bottom + 20} text-anchor="middle">{n}</text>)}
        <path class="f-axis" d={`M ${L.left} ${L.bottom} H ${L.right + 12}`} marker-end="url(#f-arrow-muted)" />
        <path class="f-axis" d={`M ${L.left} ${L.bottom} V ${L.top - 10}`} marker-end="url(#f-arrow-muted)" />
        <text class="f-label" x={L.right + 12} y={L.bottom + 44} text-anchor="end">{t.x}</text>
        <text class="f-label" transform={`translate(${L.left - (narrow ? 38 : 46)} ${(L.top + L.bottom) / 2}) rotate(-90)`} text-anchor="middle">{t.y}</text>
        <path class="f-line f-blue f-bold" d={plot((lg) => half(10 ** lg), 1, Math.log10(3000), sx, sy, 200)} />
        {marks.map((m, i) => (
          <g>
            <circle class={i === 2 ? 'f-solid-red' : 'f-solid-blue'} cx={sx(Math.log10(m.n))} cy={sy(half(m.n))} r="5" />
            <text class={`f-label f-halo${i === 2 ? ' f-t-red' : ''}`} x={sx(Math.log10(m.n)) + (i === 2 ? -8 : 10)} y={sy(half(m.n)) - 14} text-anchor={i === 2 ? 'end' : 'start'}>{narrow ? `n = ${m.n}, ±${half(m.n).toFixed(3)}` : `${m.label}, ±${half(m.n).toFixed(3)}`}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
