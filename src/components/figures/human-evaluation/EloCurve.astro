---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Win probability as a function of the rating difference on the Elo scale (Bradley–Terry with base 10, scale 400).
const win = (d: number) => 1 / (1 + 10 ** (-d / 400));
const eloOf = (p: number) => 400 * Math.log10(p / (1 - p));
const ab = eloOf(0.6), ac = 2 * ab;
if (ab.toFixed(1) !== '70.4' || win(ac).toFixed(3) !== '0.692') throw new Error('EloCurve: numbers drifted from the note');
const t = ru
  ? { x: 'разность рейтингов d', y: 'P(A лучше B)', ab: 'A против B: 0.60', ac: 'A против C: 0.69' }
  : { x: 'rating difference d', y: 'P(A preferred to B)', ab: 'A against B: 0.60', ac: 'A against C: 0.69' };
const id = 'human-evaluation-elo-curve';
const layouts = [
  { sfx: 'w', cls: 'fig-wide fig-medium', W: 600, H: 320, left: 70, right: 560, top: 24, bottom: 262 },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 320, left: 68, right: 340, top: 24, bottom: 254 },
];
---

<Figure
  id={id}
  title={ru ? 'Модель Брэдли–Терри на шкале Эло' : 'The Bradley–Terry model on the Elo scale'}
  caption={ru
    ? 'Вероятность того, что A предпочтут B, в зависимости от разности рейтингов d: 1 / (1 + 10^(−d/400)). Выигрыш у B в 60% сравнений ставит A на 70.4 пункта выше. Если B так же выигрывает у C, то A на 140.9 пункта выше C и, по предсказанию модели, выигрывает у C в 69% случаев, хотя эту пару никто не сравнивал.'
    : 'The probability that A is preferred to B against their rating difference d: 1 / (1 + 10^(−d/400)). Winning 60% against B puts A 70.4 points higher. If B beats C by the same margin, A is 140.9 points above C and is predicted to win 69% against C, a pair never compared.'}
>
  {layouts.map((L) => {
    const sx = scale([-400, 400], [L.left, L.right]);
    const sy = scale([0, 1], [L.bottom, L.top]);
    const narrow = L.sfx === 'n';
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{ru ? 'Вероятность выигрыша и разность рейтингов' : 'Win probability and rating difference'}</title>
        <desc id={`${id}-${L.sfx}-d`}>{ru ? 'S-образная кривая от 0.09 при d = −400 до 0.91 при d = 400, равная 0.5 при d = 0. Отмечены d = 70.4 с вероятностью 0.60 и d = 140.9 с вероятностью 0.69.' : 'An S-shaped curve from 0.09 at d = −400 to 0.91 at d = 400, equal to 0.5 at d = 0. Marked: d = 70.4 with probability 0.60 and d = 140.9 with probability 0.69.'}</desc>
        {[0, 0.25, 0.5, 0.75, 1].map((y) => <line class="f-grid" x1={L.left} x2={L.right} y1={sy(y)} y2={sy(y)} />)}
        {[0, 0.25, 0.5, 0.75, 1].map((y) => <text class="f-note" x={L.left - 10} y={sy(y) + 5} text-anchor="end">{y}</text>)}
        {[-400, -200, 0, 200, 400].map((d) => <text class="f-note" x={sx(d)} y={L.bottom + 20} text-anchor="middle">{d}</text>)}
        <path class="f-axis" d={`M ${L.left} ${L.bottom} H ${L.right + 12}`} marker-end="url(#f-arrow-muted)" />
        <path class="f-axis" d={`M ${L.left} ${L.bottom} V ${L.top - 10}`} marker-end="url(#f-arrow-muted)" />
        <text class="f-label" x={L.right + 12} y={L.bottom + 44} text-anchor="end">{t.x}</text>
        <text class="f-label" transform={`translate(${L.left - (narrow ? 50 : 46)} ${(L.top + L.bottom) / 2}) rotate(-90)`} text-anchor="middle">{t.y}</text>
        <path class="f-line f-blue f-bold" d={plot(win, -400, 400, sx, sy, 160)} />
        {[[ab, t.ab], [ac, t.ac]].map(([d, label], i) => (
          <g>
            <path class="f-thin f-muted f-dash" d={`M ${sx(d as number)} ${L.bottom} V ${sy(win(d as number))} H ${L.left}`} />
            <circle class="f-solid-red" cx={sx(d as number)} cy={sy(win(d as number))} r="5" />
            <text class="f-label f-halo" x={sx(d as number) + (narrow ? -10 : 10)} y={sy(win(d as number)) + (i === 0 ? 18 : -10)} text-anchor={narrow ? 'end' : 'start'}>{label as string}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
