---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The life of one TCP connection of the echo program: the system calls on each side and the segments that the
// two kernels exchange because of them. Time runs down. The ACKs of the two FINs are left out.
const msgLen = 'hello, sockets'.length;
if (msgLen !== 14) throw new Error(`message length ${msgLen}`);

type Side = 'c' | 's';
interface Call { side: Side; y: number; label: string; ret?: boolean; s: number }
interface Pkt { from: Side; y: number; label: string; tone: 'amber' | 'green' | 'red'; s: number }
interface Bar { side: Side; y0: number; y1: number; s: number }
const dy = 30; // vertical drop of a segment while it crosses
const calls: Call[] = [
  { side: 's', y: 64, label: 'socket()', s: 1 },
  { side: 's', y: 98, label: 'bind()', s: 1 },
  { side: 's', y: 132, label: 'listen()', s: 1 },
  { side: 's', y: 166, label: 'accept()', s: 1 },
  { side: 'c', y: 200, label: 'socket()', s: 2 },
  { side: 'c', y: 234, label: 'connect()', s: 2 },
  { side: 'c', y: 352, label: 'connect → 0', ret: true, s: 3 },
  { side: 's', y: 386, label: 'accept → fd', ret: true, s: 3 },
  { side: 'c', y: 420, label: 'send()', s: 4 },
  { side: 's', y: 482, label: 'recv()', s: 4 },
  { side: 's', y: 516, label: 'send()', s: 4 },
  { side: 'c', y: 578, label: 'recv()', s: 4 },
  { side: 'c', y: 618, label: 'close()', s: 5 },
  { side: 's', y: 680, label: 'recv → 0', ret: true, s: 5 },
  { side: 's', y: 714, label: 'close()', s: 5 },
];
const pkts: Pkt[] = [
  { from: 'c', y: 252, label: 'SYN, seq = x', tone: 'amber', s: 2 },
  { from: 's', y: 292, label: 'SYN+ACK, ack = x+1', tone: 'amber', s: 3 },
  { from: 'c', y: 332, label: 'ACK, ack = y+1', tone: 'amber', s: 3 },
  { from: 'c', y: 436, label: ru ? `данные, ${msgLen} байт` : `data, ${msgLen} bytes`, tone: 'green', s: 4 },
  { from: 's', y: 532, label: ru ? `эхо, ${msgLen} байт` : `echo, ${msgLen} bytes`, tone: 'green', s: 4 },
  { from: 'c', y: 634, label: 'FIN', tone: 'red', s: 5 },
  { from: 's', y: 730, label: 'FIN', tone: 'red', s: 5 },
];
const bars: Bar[] = [
  { side: 's', y0: 180, y1: 372, s: 1 },
  { side: 'c', y0: 248, y1: 338, s: 2 },
];
const H = 800;
const lastY = 730 + dy;
if (lastY + 16 > H) throw new Error('figure too short');
const t = ru
  ? {
      client: 'клиент', server: 'сервер', note: 'ACK в ответ на каждый FIN не показаны', time: 'время',
      steps: [
        'сервер создаёт сокет, привязывает его к адресу, переводит в режим прослушивания и блокируется в accept',
        'клиент создаёт сокет и вызывает connect: его ядро отправляет SYN',
        'ядро сервера отвечает SYN+ACK, ядро клиента — ACK; connect возвращает 0, accept — новый дескриптор',
        `данные: клиент отправляет ${msgLen} байт, сервер их получает и отправляет обратно`,
        'закрытие: каждая сторона отправляет FIN; recv сервера возвращает 0, когда приходит FIN клиента',
      ],
    }
  : {
      client: 'client', server: 'server', note: 'the ACK of each FIN is not drawn', time: 'time',
      steps: [
        'the server creates a socket, binds it to an address, listens, and blocks in accept',
        'the client creates a socket and calls connect: its kernel sends SYN',
        "the server's kernel answers SYN+ACK, the client's kernel ACK; connect returns 0 and accept a new descriptor",
        `data: the client sends ${msgLen} bytes, the server receives them and sends them back`,
        "close: each side sends FIN; the server's recv returns 0 when the client's FIN arrives",
      ],
    };
interface Layout { cls: string; W: number; x: Record<Side, number>; bw: number; lift: number; badge: Record<number, [number, number]> }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, x: { c: 200, s: 560 }, bw: 120, lift: 12, badge: { 1: [720, 64], 2: [40, 200], 3: [40, 308], 4: [40, 420], 5: [40, 618] } },
  { cls: 'fig-narrow seq-narrow', W: 360, x: { c: 64, s: 296 }, bw: 104, lift: 14, badge: { 1: [180, 64], 2: [180, 200], 3: [180, 368], 4: [180, 400], 5: [180, 602] } },
];
const toneOf = { amber: 'f-amber', green: 'f-green', red: 'f-red' } as const;
const textTone = { amber: 'f-t-amber', green: 'f-t-green', red: 'f-t-red' } as const;
const steps = [1, 2, 3, 4, 5];
const id = 'socket-sequence';
---

<Figure
  id={id}
  title={ru ? 'Одно TCP-соединение: системные вызовы и сегменты' : 'One TCP connection: the system calls and the segments'}
  caption={ru
    ? `Время идёт вниз. Сервер вызывает socket, bind и listen и блокируется в accept (1). connect клиента заставляет его ядро отправить SYN (2); ядро сервера отвечает SYN+ACK, ядро клиента — ACK, и только тогда connect завершается, а accept возвращает новый сокет для этого соединения (3). Рукопожатие выполняют ядра: процессы лишь ждут его в connect и accept. Затем ${msgLen} байт идут к серверу и обратно (4). close клиента отправляет FIN, и recv сервера возвращает 0; сервер закрывает свою сторону и отправляет свой FIN (5). Полосы на линиях жизни отмечают время, когда процесс заблокирован.`
    : `Time runs down. The server calls socket, bind and listen and blocks in accept (1). The client's connect makes its kernel send a SYN (2); the server's kernel answers SYN+ACK, the client's kernel ACK, and only then does connect return and accept return a new socket for this connection (3). The kernels perform the handshake; the processes only wait for it in connect and accept. Then ${msgLen} bytes go to the server and back (4). The client's close sends a FIN, and the server's recv returns 0; the server closes its side with its own FIN (5). Bars on the lifelines mark the time a process is blocked.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Диаграмма последовательности TCP-соединения с эхо-сервером' : 'Sequence diagram of a TCP connection to an echo server'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? `Две вертикальные линии жизни, клиент слева и сервер справа. Сервер: socket, bind, listen, accept, затем ожидание. Клиент: socket, connect. Между ними наклонные стрелки сегментов: SYN к серверу, SYN+ACK к клиенту, ACK к серверу. Затем connect возвращает 0, accept возвращает дескриптор. Клиент вызывает send, стрелка с ${msgLen} байтами идёт к серверу, сервер вызывает recv и send, стрелка эха идёт к клиенту, клиент вызывает recv. Клиент вызывает close, стрелка FIN, recv сервера возвращает 0, сервер вызывает close, стрелка FIN к клиенту.`
        : `Two vertical lifelines, client on the left and server on the right. Server: socket, bind, listen, accept, then waiting. Client: socket, connect. Slanted segment arrows between them: SYN to the server, SYN+ACK to the client, ACK to the server. Then connect returns 0 and accept returns a descriptor. Client send, an arrow with ${msgLen} bytes to the server, server recv and send, an echo arrow back, client recv. Client close, a FIN arrow, the server's recv returns 0, server close, a FIN arrow to the client.`}</desc>
      <text class="f-label" x={L.x.c} y="26" text-anchor="middle" style="font-weight: 650">{t.client}</text>
      <text class="f-label" x={L.x.s} y="26" text-anchor="middle" style="font-weight: 650">{t.server}</text>
      <path class="f-thin f-muted f-dash" d={`M ${L.x.c} 40 V ${H - 30}`} />
      <path class="f-thin f-muted f-dash" d={`M ${L.x.s} 40 V ${H - 30}`} />
      {steps.map((s) => (
        <g data-s={String(s)}>
          {bars.filter((b) => b.s === s).map((b) => (
            <rect x={L.x[b.side] - 5} y={b.y0} width="10" height={b.y1 - b.y0} style={`fill: ${toneVar.n}; fill-opacity: 0.35; stroke: none`} />
          ))}
          {pkts.filter((p) => p.s === s).map((p) => {
            const x0 = p.from === 'c' ? L.x.c + 6 : L.x.s - 6;
            const x1 = p.from === 'c' ? L.x.s - 6 : L.x.c + 6;
            return (
              <g>
                <path class={`f-line ${toneOf[p.tone]}`} d={`M ${x0} ${p.y} L ${x1} ${p.y + dy}`} marker-end={`url(#f-arrow-${p.tone})`} />
                <text class={`f-small ${textTone[p.tone]} f-halo`} x={(L.x.c + L.x.s) / 2} y={p.y + dy / 2 - L.lift} text-anchor="middle">{p.label}</text>
              </g>
            );
          })}
          {calls.filter((c) => c.s === s).map((c) => (
            <g>
              <rect x={L.x[c.side] - L.bw / 2} y={c.y - 13} width={L.bw} height="26" rx="6" style={c.ret ? 'fill: var(--paper); stroke: var(--muted); stroke-width: 1.2; stroke-dasharray: 4 3' : 'fill: var(--paper-strong); stroke: var(--line); stroke-width: 1.3'} />
              <text class="f-small" x={L.x[c.side]} y={c.y + 4.5} text-anchor="middle" style={c.ret ? undefined : 'font-weight: 650'}>{c.label}</text>
            </g>
          ))}
          <Badge x={L.badge[s][0]} y={L.badge[s][1]} n={s} />
        </g>
      ))}
      <g data-s="5">
        <text class="f-small f-t-muted" x={(L.x.c + L.x.s) / 2} y={H - 10} text-anchor="middle">{t.note}</text>
      </g>
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
