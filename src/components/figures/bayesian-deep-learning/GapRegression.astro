---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The Code section of the note: 40 points on [−4, −1] and 40 on [1, 4], y = sin x + noise of standard deviation 0.1;
// networks 1 → 128 → 128 → 1 with ReLU, full-batch Adam for 3000 steps. Predictive mean and standard deviation on a grid
// of 57 points from −7 to 7: a deterministic network (the residual standard deviation only), MC dropout with p = 0.1
// (500 passes plus the noise variance), and an ensemble of five networks (their spread plus the noise variance).
const xd = [-2.09, -3.19, -3.88, -3.95, -1.56, -1.26, -2.18, -1.81, -2.37, -1.19, -1.55, -3.99, -1.43, -3.90, -1.81, -3.47, -1.41, -2.38, -3.10, -2.73, -3.92, -3.63, -1.99, -2.06, -2.15, -2.85, -1.01, -1.06, -1.94, -2.05, -1.93, -2.83, -3.59, -1.84, -2.42, -3.07, -2.54, -1.33, -1.20, -2.93, 2.71, 1.97, 2.78, 2.01, 2.17, 3.67, 1.68, 2.87, 1.25, 3.50, 3.36, 1.72, 3.63, 1.18, 2.01, 1.45, 2.35, 3.39, 1.69, 1.16, 2.21, 1.60, 1.27, 2.74, 1.90, 3.02, 1.60, 3.83, 2.10, 1.32, 2.89, 3.78, 2.32, 3.86, 2.50, 2.28, 2.86, 3.99, 3.85, 2.38];
const yd = [-0.86, 0.25, 0.69, 0.66, -1.04, -1.06, -0.95, -0.91, -0.64, -0.80, -1.08, 0.92, -1.02, 0.84, -1.01, 0.25, -0.96, -0.59, -0.02, -0.46, 0.56, 0.33, -0.86, -0.78, -0.85, -0.40, -0.76, -1.00, -1.00, -0.83, -1.16, -0.26, 0.38, -0.95, -0.67, -0.05, -0.49, -1.05, -0.79, -0.14, 0.50, 1.04, 0.43, 0.99, 0.83, -0.65, 0.98, 0.19, 0.81, -0.32, -0.27, 0.89, -0.57, 0.95, 0.94, 1.13, 0.71, -0.14, 1.13, 1.03, 0.56, 1.12, 0.99, 0.43, 0.98, 0.16, 1.03, -0.67, 0.68, 0.96, 0.17, -0.49, 0.70, -0.65, 0.51, 0.71, 0.28, -0.90, -0.62, 0.68];
const detMean = [4.223, 3.957, 3.682, 3.407, 3.133, 2.857, 2.579, 2.291, 1.998, 1.704, 1.411, 1.111, 0.820, 0.527, 0.294, 0.122, -0.117, -0.374, -0.568, -0.769, -0.928, -1.009, -1.033, -0.942, -0.797, -0.518, -0.230, 0.086, 0.405, 0.663, 0.866, 1.013, 1.084, 0.878, 1.079, 1.018, 0.930, 0.692, 0.557, 0.395, 0.142, -0.111, -0.365, -0.606, -0.826, -1.039, -1.241, -1.427, -1.609, -1.788, -1.964, -2.140, -2.314, -2.482, -2.649, -2.818, -2.986], detStd = 0.080;
const mcMean = [2.005, 1.900, 1.818, 1.710, 1.615, 1.499, 1.412, 1.297, 1.196, 1.094, 0.989, 0.889, 0.758, 0.525, 0.309, 0.096, -0.149, -0.395, -0.580, -0.771, -0.942, -0.995, -1.009, -0.938, -0.815, -0.649, -0.427, -0.161, 0.120, 0.388, 0.612, 0.798, 0.922, 0.999, 1.059, 1.051, 0.970, 0.733, 0.587, 0.421, 0.144, -0.145, -0.398, -0.607, -0.803, -0.909, -1.035, -1.132, -1.236, -1.330, -1.435, -1.539, -1.644, -1.753, -1.839, -1.951, -2.046];
const mcStd = [0.245, 0.233, 0.216, 0.208, 0.194, 0.190, 0.176, 0.170, 0.164, 0.155, 0.147, 0.136, 0.125, 0.117, 0.112, 0.111, 0.114, 0.105, 0.104, 0.105, 0.105, 0.108, 0.108, 0.107, 0.110, 0.115, 0.127, 0.135, 0.136, 0.134, 0.125, 0.113, 0.111, 0.111, 0.112, 0.109, 0.109, 0.105, 0.102, 0.104, 0.112, 0.117, 0.115, 0.121, 0.124, 0.136, 0.138, 0.150, 0.162, 0.182, 0.174, 0.198, 0.203, 0.214, 0.231, 0.242, 0.245];
const ensMean = [3.825, 3.586, 3.347, 3.107, 2.864, 2.620, 2.370, 2.120, 1.867, 1.611, 1.348, 1.079, 0.803, 0.523, 0.306, 0.154, -0.117, -0.413, -0.569, -0.772, -0.930, -1.005, -1.035, -0.978, -0.804, -0.493, -0.229, -0.006, 0.212, 0.423, 0.609, 0.781, 0.919, 0.922, 1.075, 1.013, 0.930, 0.703, 0.568, 0.406, 0.133, -0.114, -0.365, -0.602, -0.820, -1.030, -1.230, -1.420, -1.605, -1.787, -1.966, -2.144, -2.320, -2.495, -2.670, -2.844, -3.017];
const ensStd = [0.509, 0.467, 0.424, 0.383, 0.344, 0.305, 0.269, 0.234, 0.199, 0.165, 0.130, 0.103, 0.084, 0.081, 0.080, 0.082, 0.081, 0.082, 0.078, 0.079, 0.077, 0.077, 0.077, 0.079, 0.082, 0.167, 0.266, 0.315, 0.336, 0.324, 0.259, 0.173, 0.096, 0.083, 0.078, 0.077, 0.077, 0.079, 0.077, 0.078, 0.078, 0.079, 0.079, 0.078, 0.079, 0.081, 0.084, 0.088, 0.093, 0.099, 0.106, 0.115, 0.123, 0.132, 0.142, 0.152, 0.165];
const grid = Array.from({ length: 57 }, (_, i) => -7 + 0.25 * i);
if (xd.length !== 80 || yd.length !== 80 || [detMean, mcMean, mcStd, ensMean, ensStd].some((a) => a.length !== 57)) throw new Error('GapRegression: wrong array sizes');
const at = (v: number) => grid.indexOf(v);
const chk = [mcStd[at(0)], ensStd[at(0)], mcStd[at(-2.5)], ensStd[at(-2.5)], ensStd[at(-7)], mcStd[at(6)], ensStd[at(6)], detMean[at(6)], mcMean[at(6)], ensMean[at(6)]].map((v) => v.toFixed(2)).join(' ');
if (chk !== '0.14 0.34 0.10 0.08 0.51 0.20 0.12 -2.31 -1.64 -2.32') throw new Error(`GapRegression: the run drifted from the note (${chk})`);

const panels = [
  { key: 'det', mean: detMean, std: grid.map(() => detStd), tone: 'muted' },
  { key: 'mc', mean: mcMean, std: mcStd, tone: 'blue' },
  { key: 'ens', mean: ensMean, std: ensStd, tone: 'red' },
];
const t = ru
  ? { title: 'Неопределённость там, где нет данных', head: { det: 'детерминированная сеть', mc: 'MC-дропаут, p = 0.1', ens: 'ансамбль из 5 сетей' } as Record<string, string>,
      gap: 'разрыв', desc: 'Три панели с данными на отрезках от −4 до −1 и от 1 до 4, истинной функцией sin x и предсказанием со средним ± 2 стандартных отклонения на отрезке от −7 до 7. Детерминированная сеть: полоса постоянной ширины, стандартное отклонение 0.080 везде. MC-дропаут: 0.10 на данных, 0.14 в разрыве и 0.20–0.25 за краями данных. Ансамбль: 0.08 на данных, 0.34 в разрыве, 0.12 при x = 6 и 0.51 при x = −7. При x = 6 средние трёх моделей отклоняются от sin x на 25, 7 и 17 их стандартных отклонений.' }
  : { title: 'Uncertainty where there are no data', head: { det: 'deterministic network', mc: 'MC dropout, p = 0.1', ens: 'ensemble of 5 networks' } as Record<string, string>,
      gap: 'gap', desc: 'Three panels with the data on −4 to −1 and 1 to 4, the true function sin x, and the prediction as mean ± 2 standard deviations from −7 to 7. Deterministic network: a band of constant width, standard deviation 0.080 everywhere. MC dropout: 0.10 on the data, 0.14 in the gap and 0.20 to 0.25 beyond the data. Ensemble: 0.08 on the data, 0.34 in the gap, 0.12 at x = 6 and 0.51 at x = −7. At x = 6 the means of the three models are off sin x by 25, 7 and 17 of their standard deviations.' };
const id = 'bdl-gap-regression';
const caption = ru
  ? 'Сеть 1 → 128 → 128 → 1 с ReLU, 80 точек из y = sin x плюс шум со стандартным отклонением 0.1; полосы — предсказательное среднее ± 2 стандартных отклонения, шум включён. Разрыв в данных затенён, пунктир — sin x. Главное — ширина полос в разрыве и при x = 6.'
  : 'A 1 → 128 → 128 → 1 ReLU network, 80 points from y = sin x plus noise of standard deviation 0.1; bands are the predictive mean ± 2 standard deviations, noise included. The gap in the data is shaded; the dashed curve is sin x. Compare the band widths in the gap and at x = 6.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 290, P: [[36, 40], [284, 40], [532, 40]], pw: 212, ph: 200 },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 740, P: [[44, 36], [44, 278], [44, 520]], pw: 300, ph: 180 },
];
const truthPath = (sx: (v: number) => number, sy: (v: number) => number) => polyline(Array.from({ length: 141 }, (_, i) => -7 + 0.1 * i).map((x) => [sx(x), sy(Math.sin(x))]));
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
      {panels.map((p, k) => {
        const [x0, y0] = L.P[k];
        const sx = scale([-7, 7], [x0, x0 + L.pw]), sy = scale([-3, 4], [y0 + L.ph, y0]);
        const cy = (v: number) => sy(Math.max(-3, Math.min(4, v)));
        const upper = grid.map((x, i) => [sx(x), cy(p.mean[i] + 2 * p.std[i])] as [number, number]);
        const lower = grid.map((x, i) => [sx(x), cy(p.mean[i] - 2 * p.std[i])] as [number, number]).reverse();
        return (
          <g>
            <rect x={sx(-1)} y={y0} width={sx(1) - sx(-1)} height={L.ph} class="f-fill-amber" />
            <text class="f-small f-t-amber" x={sx(0)} y={y0 + L.ph - 8} text-anchor="middle">{t.gap}</text>
            <path class="f-axis" d={`M ${x0} ${y0} V ${y0 + L.ph} H ${x0 + L.pw}`} />
            {[-2, 0, 2, 4].map((v) => <text class="f-note" x={x0 - 6} y={sy(v) + 5} text-anchor="end">{v}</text>)}
            {[-6, 0, 6].map((v) => <text class="f-note" x={sx(v)} y={y0 + L.ph + 18} text-anchor="middle">{v}</text>)}
            <path class={p.tone === 'muted' ? 'f-fill-ink' : `f-fill-${p.tone}`} style={p.tone === 'muted' ? 'fill-opacity: 0.12' : undefined} d={`${polyline([...upper, ...lower])} Z`} />
            <path class="f-line f-dash f-muted" d={truthPath(sx, sy)} />
            <path class={`f-line f-${p.tone}`} d={polyline(grid.map((x, i) => [sx(x), cy(p.mean[i])]))} />
            {xd.map((x, i) => <circle cx={sx(x)} cy={sy(yd[i])} r="1.8" class="f-fill-ink" />)}
            <text class="f-small" x={x0 + 4} y={y0 - 10}>{t.head[p.key]}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
