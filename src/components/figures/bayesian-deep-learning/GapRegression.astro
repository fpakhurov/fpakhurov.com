---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The Code section of the note: 40 points on [−4, −1] and 40 on [1, 4], y = sin x + noise of standard deviation 0.1;
// networks 1 → 128 → 128 → 1 with ReLU, full-batch Adam for 3000 steps. Predictive mean and standard deviation on a grid
// of 57 points from −7 to 7: a deterministic network (the residual standard deviation only), MC dropout with p = 0.1
// (500 passes plus the noise variance), and an ensemble of five networks (their spread plus the noise variance).
const xd = [-2.09, -3.19, -3.88, -3.95, -1.56, -1.26, -2.18, -1.81, -2.37, -1.19, -1.55, -3.99, -1.43, -3.90, -1.81, -3.47, -1.41, -2.38, -3.10, -2.73, -3.92, -3.63, -1.99, -2.06, -2.15, -2.85, -1.01, -1.06, -1.94, -2.05, -1.93, -2.83, -3.59, -1.84, -2.42, -3.07, -2.54, -1.33, -1.20, -2.93, 2.71, 1.97, 2.78, 2.01, 2.17, 3.67, 1.68, 2.87, 1.25, 3.50, 3.36, 1.72, 3.63, 1.18, 2.01, 1.45, 2.35, 3.39, 1.69, 1.16, 2.21, 1.60, 1.27, 2.74, 1.90, 3.02, 1.60, 3.83, 2.10, 1.32, 2.89, 3.78, 2.32, 3.86, 2.50, 2.28, 2.86, 3.99, 3.85, 2.38];
const yd = [-0.86, 0.25, 0.69, 0.66, -1.04, -1.06, -0.95, -0.91, -0.64, -0.80, -1.08, 0.92, -1.02, 0.84, -1.01, 0.25, -0.96, -0.59, -0.02, -0.46, 0.56, 0.33, -0.86, -0.78, -0.85, -0.40, -0.76, -1.00, -1.00, -0.83, -1.16, -0.26, 0.38, -0.95, -0.67, -0.05, -0.49, -1.05, -0.79, -0.14, 0.50, 1.04, 0.43, 0.99, 0.83, -0.65, 0.98, 0.19, 0.81, -0.32, -0.27, 0.89, -0.57, 0.95, 0.94, 1.13, 0.71, -0.14, 1.13, 1.03, 0.56, 1.12, 0.99, 0.43, 0.98, 0.16, 1.03, -0.67, 0.68, 0.96, 0.17, -0.49, 0.70, -0.65, 0.51, 0.71, 0.28, -0.90, -0.62, 0.68];
const detMean = [3.021, 2.848, 2.674, 2.500, 2.327, 2.153, 1.976, 1.798, 1.619, 1.428, 1.229, 1.021, 0.804, 0.580, 0.360, 0.154, -0.106, -0.385, -0.561, -0.754, -0.905, -1.013, -1.027, -0.940, -0.803, -0.488, -0.168, 0.183, 0.533, 0.868, 1.098, 1.196, 1.178, 0.888, 1.093, 1.037, 0.961, 0.695, 0.601, 0.450, 0.140, -0.089, -0.341, -0.581, -0.801, -0.997, -1.178, -1.344, -1.506, -1.669, -1.830, -1.991, -2.152, -2.309, -2.465, -2.619, -2.769], detStd = 0.077;
const mcMean = [2.096, 1.953, 1.853, 1.742, 1.644, 1.542, 1.420, 1.331, 1.225, 1.113, 1.011, 0.903, 0.784, 0.569, 0.352, 0.160, -0.085, -0.340, -0.537, -0.737, -0.914, -0.982, -0.988, -0.923, -0.824, -0.707, -0.515, -0.250, 0.038, 0.314, 0.566, 0.771, 0.896, 0.971, 1.039, 1.012, 0.945, 0.704, 0.565, 0.396, 0.133, -0.129, -0.389, -0.606, -0.805, -0.931, -1.048, -1.160, -1.275, -1.386, -1.502, -1.613, -1.724, -1.844, -1.951, -2.068, -2.162];
const mcStd = [0.237, 0.236, 0.219, 0.198, 0.196, 0.194, 0.191, 0.173, 0.166, 0.155, 0.141, 0.138, 0.133, 0.116, 0.107, 0.111, 0.109, 0.103, 0.100, 0.099, 0.102, 0.101, 0.101, 0.103, 0.102, 0.110, 0.123, 0.141, 0.140, 0.138, 0.130, 0.114, 0.109, 0.105, 0.109, 0.104, 0.105, 0.101, 0.098, 0.100, 0.106, 0.113, 0.112, 0.118, 0.123, 0.130, 0.137, 0.143, 0.152, 0.164, 0.177, 0.185, 0.197, 0.195, 0.205, 0.232, 0.244];
const ensMean = [3.822, 3.580, 3.337, 3.094, 2.849, 2.603, 2.357, 2.109, 1.861, 1.609, 1.355, 1.090, 0.817, 0.543, 0.322, 0.169, -0.099, -0.386, -0.561, -0.754, -0.919, -1.000, -1.028, -0.941, -0.789, -0.493, -0.215, 0.122, 0.428, 0.662, 0.852, 0.972, 1.041, 0.904, 1.089, 1.029, 0.956, 0.703, 0.579, 0.416, 0.148, -0.097, -0.345, -0.586, -0.816, -1.042, -1.266, -1.484, -1.702, -1.918, -2.133, -2.349, -2.563, -2.775, -2.987, -3.199, -3.410];
const ensStd = [0.581, 0.536, 0.491, 0.446, 0.401, 0.358, 0.316, 0.274, 0.233, 0.191, 0.149, 0.109, 0.083, 0.084, 0.088, 0.084, 0.081, 0.080, 0.079, 0.079, 0.078, 0.078, 0.078, 0.078, 0.082, 0.182, 0.234, 0.263, 0.288, 0.279, 0.261, 0.200, 0.139, 0.084, 0.081, 0.079, 0.080, 0.079, 0.079, 0.080, 0.081, 0.080, 0.080, 0.081, 0.083, 0.088, 0.096, 0.104, 0.114, 0.125, 0.137, 0.150, 0.163, 0.177, 0.190, 0.202, 0.215];
const grid = Array.from({ length: 57 }, (_, i) => -7 + 0.25 * i);
if (xd.length !== 80 || yd.length !== 80 || [detMean, mcMean, mcStd, ensMean, ensStd].some((a) => a.length !== 57)) throw new Error('GapRegression: wrong array sizes');
const at = (v: number) => grid.indexOf(v);
const chk = [mcStd[at(0)], ensStd[at(0)], mcStd[at(-2.5)], ensStd[at(-2.5)], ensStd[at(-7)], mcStd[at(6)], ensStd[at(6)], detMean[at(6)], mcMean[at(6)], ensMean[at(6)]].map((v) => v.toFixed(2)).join(' ');
if (chk !== '0.14 0.29 0.10 0.08 0.58 0.20 0.16 -2.15 -1.72 -2.56') throw new Error(`GapRegression: the run drifted from the note (${chk})`);

const panels = [
  { key: 'det', mean: detMean, std: grid.map(() => detStd), tone: 'muted' },
  { key: 'mc', mean: mcMean, std: mcStd, tone: 'blue' },
  { key: 'ens', mean: ensMean, std: ensStd, tone: 'red' },
];
const t = ru
  ? { title: 'Неопределённость там, где нет данных', head: { det: 'детерминированная сеть', mc: 'MC-дропаут, p = 0.1', ens: 'ансамбль из 5 сетей' } as Record<string, string>,
      gap: 'разрыв', desc: 'Три панели с данными на отрезках от −4 до −1 и от 1 до 4, истинной функцией sin x и предсказанием со средним ± 2 стандартных отклонения на отрезке от −7 до 7. Детерминированная сеть: полоса постоянной ширины, стандартное отклонение 0.077 везде. MC-дропаут: 0.10 на данных, 0.14 в разрыве и 0.20–0.24 за краями данных. Ансамбль: 0.08 на данных, 0.29 в разрыве, 0.16 при x = 6 и 0.58 при x = −7. При x = 6 средние трёх моделей отклоняются от sin x на 24, 7 и 14 их стандартных отклонений.' }
  : { title: 'Uncertainty where there are no data', head: { det: 'deterministic network', mc: 'MC dropout, p = 0.1', ens: 'ensemble of 5 networks' } as Record<string, string>,
      gap: 'gap', desc: 'Three panels with the data on −4 to −1 and 1 to 4, the true function sin x, and the prediction as mean ± 2 standard deviations from −7 to 7. Deterministic network: a band of constant width, standard deviation 0.077 everywhere. MC dropout: 0.10 on the data, 0.14 in the gap and 0.20 to 0.24 beyond the data. Ensemble: 0.08 on the data, 0.29 in the gap, 0.16 at x = 6 and 0.58 at x = −7. At x = 6 the means of the three models are off sin x by 24, 7 and 14 of their standard deviations.' };
const id = 'bdl-gap-regression';
const caption = ru
  ? 'Сеть 1 → 128 → 128 → 1 с ReLU, 80 обучающих точек, y = sin x + шум со стандартным отклонением 0.1; полосы — среднее ± 2 стандартных отклонения предсказания, шум включён; цветом отмечен разрыв в данных, пунктир — sin x. Детерминированной сети неоткуда взять неопределённость, кроме шума остатков. MC-дропаут и ансамбль расширяют полосу в разрыве в 1.8 и 3.7 раза по сравнению с ней, ансамбль — и далеко за краями данных. Но при x = 6 ошибка среднего равна 1.4 у MC-дропаута и 2.3 у ансамбля, то есть 7 и 14 их стандартных отклонений: обе аппроксимации апостериорного распределения слишком уверены вдали от данных. Один запуск раздела «Код».'
  : 'A 1 → 128 → 128 → 1 ReLU network, 80 training points, y = sin x + noise of standard deviation 0.1; the bands are the predictive mean ± 2 standard deviations, noise included; the gap in the data is shaded, the dashed curve is sin x. The deterministic network has no source of uncertainty except the noise of its residuals. In the gap, MC dropout and the ensemble have bands 1.8 and 3.7 times as wide as it, and the ensemble widens its band far beyond the data as well. But at x = 6 the error of the mean is 1.4 for MC dropout and 2.3 for the ensemble, 7 and 14 of their standard deviations: both approximations of the posterior are overconfident far from the data. One run of the Code section.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 290, P: [[36, 40], [284, 40], [532, 40]], pw: 212, ph: 200 },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 740, P: [[44, 36], [44, 278], [44, 520]], pw: 300, ph: 180 },
];
const truthPath = (sx: (v: number) => number, sy: (v: number) => number) => polyline(Array.from({ length: 141 }, (_, i) => -7 + 0.1 * i).map((x) => [sx(x), sy(Math.sin(x))]));
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
      {panels.map((p, k) => {
        const [x0, y0] = L.P[k];
        const sx = scale([-7, 7], [x0, x0 + L.pw]), sy = scale([-3, 4], [y0 + L.ph, y0]);
        const cy = (v: number) => sy(Math.max(-3, Math.min(4, v)));
        const upper = grid.map((x, i) => [sx(x), cy(p.mean[i] + 2 * p.std[i])] as [number, number]);
        const lower = grid.map((x, i) => [sx(x), cy(p.mean[i] - 2 * p.std[i])] as [number, number]).reverse();
        return (
          <g>
            <rect x={sx(-1)} y={y0} width={sx(1) - sx(-1)} height={L.ph} class="f-fill-amber" />
            <text class="f-small f-t-amber" x={sx(0)} y={y0 + L.ph - 8} text-anchor="middle">{t.gap}</text>
            <path class="f-axis" d={`M ${x0} ${y0} V ${y0 + L.ph} H ${x0 + L.pw}`} />
            {[-2, 0, 2, 4].map((v) => <text class="f-note" x={x0 - 6} y={sy(v) + 5} text-anchor="end">{v}</text>)}
            {[-6, 0, 6].map((v) => <text class="f-note" x={sx(v)} y={y0 + L.ph + 18} text-anchor="middle">{v}</text>)}
            <path class={p.tone === 'muted' ? 'f-fill-ink' : `f-fill-${p.tone}`} style={p.tone === 'muted' ? 'fill-opacity: 0.12' : undefined} d={`${polyline([...upper, ...lower])} Z`} />
            <path class="f-line f-dash f-muted" d={truthPath(sx, sy)} />
            <path class={`f-line f-${p.tone}`} d={polyline(grid.map((x, i) => [sx(x), cy(p.mean[i])]))} />
            {xd.map((x, i) => <circle cx={sx(x)} cy={sy(yd[i])} r="1.8" class="f-fill-ink" />)}
            <text class="f-small" x={x0 + 4} y={y0 - 10}>{t.head[p.key]}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
