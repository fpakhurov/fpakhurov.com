---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Op from '../seqflow/Op.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The deep ensemble of the Code section at x = 0, in the middle of the gap in the data: five networks from different
// random initializations, and the noise variance estimated from the training residuals of their average.
const f = [0.0612, 0.7616, 0.4665, 0.6009, 0.2514], noise = 0.00598;
const T = f.length, mean = f.reduce((a, b) => a + b, 0) / T;
const varModel = f.reduce((a, b) => a + (b - mean) ** 2, 0) / (T - 1);   // sample variance, as torch.var
const std = Math.sqrt(varModel + noise);
const chk = [mean.toFixed(2), varModel.toFixed(4), noise.toFixed(4), std.toFixed(3)].join(' ');
if (chk !== '0.43 0.0771 0.0060 0.288') throw new Error(`PredictiveSamples: the ensemble numbers drifted (${chk})`);

const t = ru
  ? {
      title: 'Предсказательное распределение по сэмплам весов',
      m: [['Bayes by Backprop', 'w ~ N(μ, σ²) на каждый вес'], ['MC-дропаут', 'случайные маски нейронов'], ['глубокий ансамбль', 'M обученных сетей']],
      draws: 'T = 5 наборов весов', outs: 'f(0; wₜ)', mean: `среднее = ${mean.toFixed(2)}`, meanSub: 'по 5 проходам', std: `ст. откл. = ${std.toFixed(3)}`,
      stdSub: `√(${varModel.toFixed(4)} модель + ${noise.toFixed(4)} шум)`, total: 'Var y = E[σ²] + Var[f]',
      steps: ['распределение весов: гауссовское, маски дропаута или ансамбль', 'сэмплировать T наборов весов; у ансамбля это его 5 сетей', 'прямой проход каждого набора в точке x = 0 из разрыва', 'среднее и дисперсия: разброс сетей плюс шум данных'],
      desc: 'Слева три способа задать распределение весов: гауссовское распределение каждого веса (Bayes by Backprop), случайные маски нейронов (MC-дропаут) и несколько обученных сетей (глубокий ансамбль). Из него берутся пять наборов весов; каждый прогоняется на входе x = 0 из разрыва в данных и даёт предсказания 0.06, 0.76, 0.47, 0.60 и 0.25. Справа их среднее 0.43 и стандартное отклонение 0.288: корень из суммы разброса сетей 0.0771 и дисперсии шума 0.0060.',
    }
  : {
      title: 'A predictive distribution from samples of the weights',
      m: [['Bayes by Backprop', 'w ~ N(μ, σ²) per weight'], ['MC dropout', 'random masks of units'], ['deep ensemble', 'M trained networks']],
      draws: 'T = 5 weight settings', outs: 'f(0; wₜ)', mean: `mean = ${mean.toFixed(2)}`, meanSub: 'over the 5 passes', std: `std = ${std.toFixed(3)}`,
      stdSub: `√(${varModel.toFixed(4)} model + ${noise.toFixed(4)} noise)`, total: 'Var y = E[σ²] + Var[f]',
      steps: ['a distribution over weights: Gaussian, dropout masks or an ensemble', 'draw T weight settings; for an ensemble, its 5 networks', 'one forward pass per setting at x = 0, in the gap', 'mean and variance: the spread of the networks plus the noise'],
      desc: 'On the left, three ways to define a distribution over weights: a Gaussian for every weight (Bayes by Backprop), random masks of units (MC dropout) and several trained networks (a deep ensemble). Five weight settings are taken from it; each is run on the input x = 0 from the gap in the data and predicts 0.06, 0.76, 0.47, 0.60 and 0.25. On the right, their mean 0.43 and the standard deviation 0.288: the square root of the spread of the networks, 0.0771, plus the noise variance, 0.0060.',
    };
const id = 'bdl-predictive-samples';
const caption = ru
  ? 'Числа — ансамбль из пяти сетей из раздела «Код» в точке x = 0, посередине разрыва в обучающих данных; у MC-дропаута те же шаги дают 500 проходов со случайными масками, у Bayes by Backprop — 500 сэмплов весов из гауссовских распределений. Дисперсия предсказания складывается по закону полной дисперсии из среднего шума данных и дисперсии предсказаний сетей; в разрыве она почти целиком приходится на разброс сетей, на обучающих точках — на шум.'
  : 'The numbers are the five-network ensemble of the Code section at x = 0, in the middle of the gap in the training data; for MC dropout the same steps use 500 passes with random masks, for Bayes by Backprop 500 draws of the weights from their Gaussians. The predictive variance adds, by the law of total variance, the average noise of the data and the variance of the networks’ predictions; in the gap almost all of it is the spread of the networks, at the training points it is the noise.';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 250" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <g data-s="1">
      {t.m.map(([lab, sub], i) => <Box x={16} y={40 + 60 * i} w={190} h={44} label={lab} sub={sub} tone="g" />)}
      <Badge x={111} y={24} n={1} />
    </g>
    <g data-s="2">
      {[62, 122, 182].map((yy) => <Arrow pts={[[206, yy], [226, yy], [226, 105], [246, 105]]} head={yy === 122} />)}
      <Vec x={250} y={50} values={['w₁', 'w₂', 'w₃', 'w₄', 'w₅']} tone="g" cw={56} label={t.draws} labelPos="below" />
      <Badge x={278} y={34} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[306, 105], [344, 105]]} />
      <Op x={380} y={105} sym="f(x; w)" />
      <Vec x={350} y={200} values={['x = 0']} tone="x" dir="row" cw={60} />
      <Arrow pts={[[380, 200], [380, 120]]} />
      <Arrow pts={[[414, 105], [448, 105]]} />
      <Vec x={450} y={50} values={f.map((v) => v.toFixed(2))} tone="y" cw={56} label={t.outs} labelPos="below" />
      <Badge x={478} y={34} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[506, 105], [528, 105], [528, 72], [548, 72]]} />
      <Arrow pts={[[528, 105], [528, 138], [548, 138]]} />
      <Box x={550} y={50} w={200} h={44} label={t.mean} sub={t.meanSub} tone="y" />
      <Box x={550} y={116} w={200} h={44} label={t.std} sub={t.stdSub} tone="y" />
      <text class="f-small f-t-muted" x="550" y="190">{t.total}</text>
      <Badge x={650} y={30} n={4} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 600" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <g data-s="1">
      {t.m.map(([lab, sub], i) => <Box x={40} y={20 + 56 * i} w={300} h={48} label={lab} sub={sub} tone="g" />)}
      <Badge x={20} y={44} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[190, 180], [190, 206]]} />
      <Vec x={50} y={208} values={['w₁', 'w₂', 'w₃', 'w₄', 'w₅']} tone="g" dir="row" cw={56} />
      <text class="f-small f-t-muted" x="198" y="250">{t.draws}</text>
      <Badge x={20} y={219} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[190, 230], [190, 290]]} />
      <Op x={190} y={304} sym="f(x; w)" />
      <Vec x={40} y={293} values={['x = 0']} tone="x" dir="row" cw={70} />
      <Arrow pts={[[110, 304], [154, 304]]} />
      <Arrow pts={[[190, 317], [190, 344]]} />
      <Vec x={50} y={346} values={f.map((v) => v.toFixed(2))} tone="y" dir="row" cw={56} />
      <text class="f-small f-t-muted" x="50" y="386">{t.outs}</text>
      <Badge x={20} y={357} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[190, 368], [190, 406]]} />
      <Box x={40} y={408} w={300} h={48} label={t.mean} sub={t.meanSub} tone="y" />
      <Box x={40} y={472} w={300} h={48} label={t.std} sub={t.stdSub} tone="y" />
      <text class="f-small f-t-muted" x="40" y="550">{t.total}</text>
      <Badge x={20} y={432} n={4} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
