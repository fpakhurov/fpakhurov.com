---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The four-point example of the least-squares note, x = (0, 1, 2, 3), y = (1, 3, 2, 5), Q(w) = mean squared error.
// Its Hessian is A = (2/n) XᵀX: [[2, 3], [3, 7]] for the raw feature, 2I after standardizing x. Gradient descent
// from w = 0; a run counts the steps until ‖w − ŵ‖ falls below 1/1000 of ‖ŵ‖.
type V = [number, number];
const xs = [0, 1, 2, 3], ys = [1, 3, 2, 5];
const mean = xs.reduce((a, b) => a + b) / 4;
const sd = Math.sqrt(xs.reduce((a, b) => a + (b - mean) ** 2, 0) / 4);
const problem = (col: number[]) => {
  const A = [[2, (2 / 4) * col.reduce((a, b) => a + b, 0)], [0, (2 / 4) * col.reduce((a, b) => a + b * b, 0)]];
  A[1][0] = A[0][1];
  const b: V = [(2 / 4) * ys.reduce((a, v) => a + v, 0), (2 / 4) * col.reduce((a, c, i) => a + c * ys[i], 0)];
  const det = A[0][0] * A[1][1] - A[0][1] * A[1][0];
  const wh: V = [(A[1][1] * b[0] - A[0][1] * b[1]) / det, (A[0][0] * b[1] - A[1][0] * b[0]) / det];
  const tr = A[0][0] + A[1][1], disc = Math.sqrt(tr * tr / 4 - det);
  const L = tr / 2 + disc, mu = tr / 2 - disc;
  const grad = (w: V): V => [A[0][0] * w[0] + A[0][1] * w[1] - b[0], A[1][0] * w[0] + A[1][1] * w[1] - b[1]];
  const run = (eta: number, cap: number) => {
    let w: V = [0, 0];
    const path: V[] = [w];
    const nh = Math.hypot(wh[0], wh[1]);
    let steps = 0;
    while (Math.hypot(w[0] - wh[0], w[1] - wh[1]) > 1e-3 * nh && steps < 1000 && Math.hypot(w[0], w[1]) < 1e3) {
      const g = grad(w);
      w = [w[0] - eta * g[0], w[1] - eta * g[1]];
      steps += 1;
      if (path.length <= cap) path.push(w);
    }
    const diverged = steps >= 1000 || Math.hypot(w[0], w[1]) >= 1e3;
    return { path, steps, diverged };
  };
  // eigenvectors of A for the contour ellipses Q − Q̂ = ½ (w − ŵ)ᵀ A (w − ŵ) = c
  const ang = 0.5 * Math.atan2(2 * A[0][1], A[0][0] - A[1][1]);
  const u1: V = [Math.cos(ang), Math.sin(ang)], u2: V = [-Math.sin(ang), Math.cos(ang)];
  const lam1 = A[0][0] * u1[0] ** 2 + 2 * A[0][1] * u1[0] * u1[1] + A[1][1] * u1[1] ** 2;
  const lam2 = A[0][0] * u2[0] ** 2 + 2 * A[0][1] * u2[0] * u2[1] + A[1][1] * u2[1] ** 2;
  const ellipse = (c: number) => Array.from({ length: 121 }, (_, k) => {
    const th = (2 * Math.PI * k) / 120, a = Math.sqrt((2 * c) / lam1) * Math.cos(th), bb = Math.sqrt((2 * c) / lam2) * Math.sin(th);
    return [wh[0] + a * u1[0] + bb * u2[0], wh[1] + a * u1[1] + bb * u2[1]] as V;
  });
  return { A, wh, L, mu, run, ellipse };
};
const raw = problem(xs);
const std = problem(xs.map((v) => (v - mean) / sd));
const bestRaw = 2 / (raw.L + raw.mu);
const runs = {
  slow: raw.run(0.05, 400), best: raw.run(bestRaw, 400), over: raw.run(0.24, 26),
  sSlow: std.run(0.05, 400), sBest: std.run(2 / (std.L + std.mu), 400),
};
const got = [raw.wh.map((v) => v.toFixed(2)).join(), raw.mu.toFixed(3), raw.L.toFixed(3), (raw.L / raw.mu).toFixed(1), bestRaw.toFixed(3), (2 / raw.L).toFixed(3),
  runs.slow.steps, runs.best.steps, runs.over.diverged, std.wh.map((v) => v.toFixed(2)).join(), std.L.toFixed(2), std.mu.toFixed(2), runs.sSlow.steps, runs.sBest.steps].join(' ');
if (got !== '1.10,1.10 0.595 8.405 14.1 0.222 0.238 194 49 true 2.75,1.23 2.00 2.00 66 1') throw new Error(`DescentPaths: numbers drifted: ${got}`);

const levels = [0.05, 0.25, 1, 3, 7];
const panels = [
  { key: 'raw', P: raw, dom: { x: [-0.9, 3.1] as V, y: [-0.55, 2.95] as V },
    runs: [{ r: runs.slow, cls: 'f-line f-green', dots: false }, { r: runs.best, cls: 'f-line f-blue', dots: true }],
    en: 'raw feature x: κ = 14.1', ru: 'исходный признак x: κ = 14.1', ax: ['w₁ (intercept)', 'w₂ (slope)'], axr: ['w₁ (свободный член)', 'w₂ (наклон)'] },
  { key: 'std', P: std, dom: { x: [-0.6, 3.4] as V, y: [-1.2, 2.3] as V },
    runs: [{ r: runs.sSlow, cls: 'f-line f-green', dots: false }, { r: runs.sBest, cls: 'f-line f-blue', dots: true }],
    en: 'standardized x: κ = 1', ru: 'стандартизованный x: κ = 1', ax: ['w₁ (intercept)', 'w₂ (slope)'], axr: ['w₁ (свободный член)', 'w₂ (наклон)'] },
];
const legend = [
  { cls: 'f-line f-green', dot: true, en: 'η = 0.05: 194 steps | 66 steps', ru: 'η = 0.05: 194 шага | 66 шагов' },
  { cls: 'f-line f-blue', dot: false, en: 'η = 2/(L + μ): 49 steps | 1 step', ru: 'η = 2/(L + μ): 49 шагов | 1 шаг' },
];
const note = ru
  ? ['число шагов: слева | справа;', 'синий путь показан до 25-го шага']
  : ['steps: left panel | right panel;', 'the blue path is drawn up to step 25'];
const id = 'gradient-descent-paths';
// equal scale on both axes, so that the circles of the standardized problem look round
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 400, unit: 82, boxes: [[50, 30], [418, 30]] as V[], lx: 50, ly: 358, legendCols: true, note: [note.join(' '), ''], noteY: [382, 0] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 760, unit: 76, boxes: [[40, 30], [40, 342]] as V[], lx: 14, ly: 664, legendCols: false, note, noteY: [720, 738] },
];
---

<Figure
  id={id}
  title={ru ? 'Градиентный спуск на вытянутой и на круглой чаше' : 'Gradient descent on a stretched and on a round bowl'}
  caption={ru
    ? 'Линии уровня среднеквадратичной ошибки для четырёх точек x = (0, 1, 2, 3), y = (1, 3, 2, 5) и пути градиентного спуска из w = 0; шаги считаются, пока расстояние до минимума не станет меньше 1/1000 от начального. Слева признак x как есть: собственные числа гессиана 0.595 и 8.405, κ = 14.1, чаша вытянута. Лучший постоянный шаг 2/(L + μ) = 0.222 прыгает поперёк долины и доходит за 49 шагов; шаг 0.05 (зелёные точки, по одной на шаг) сначала спускается на дно долины, а потом ползёт вдоль него, всего 194 шага. Справа x стандартизован: гессиан 2I, линии уровня — окружности, градиент смотрит прямо в минимум: шаг 0.05 идёт к нему по прямой за 66 шагов, а шаг 0.5 попадает в него сразу.'
    : 'Contours of the mean squared error for the four points x = (0, 1, 2, 3), y = (1, 3, 2, 5), and gradient-descent paths from w = 0; steps are counted until the distance to the minimum is below 1/1000 of the initial one. Left, the raw feature x: the Hessian has eigenvalues 0.595 and 8.405, κ = 14.1, and the bowl is stretched. The best constant step, 2/(L + μ) = 0.222, jumps across the valley and arrives in 49 steps; a step of 0.05 (green dots, one per step) first drops to the valley floor and then crawls along it, 194 steps in all. Right, x standardized: the Hessian is 2I, the contours are circles, and the gradient points straight at the minimum: a step of 0.05 walks there along a straight line in 66 steps, and a step of 0.5 lands on it at once.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{ru ? 'Пути градиентного спуска при разной обусловленности' : 'Gradient-descent paths under different conditioning'}</title>
      <desc id={`${id}-${L.sfx}-d`}>{ru
        ? 'Две панели с линиями уровня функции потерь. Слева вытянутые эллипсы: синяя ломаная зигзагом пересекает долину, зелёные точки спускаются на дно долины и медленно ползут вдоль него. Справа окружности: зелёные точки и синий отрезок ведут прямо в центр.'
        : 'Two panels of loss contours. Left, stretched ellipses: a blue zigzag crosses the valley back and forth, green dots drop to the valley floor and creep along it. Right, circles: green dots and a single blue segment go directly to the centre.'}</desc>
      {panels.map((p, j) => {
        const [bx, by] = L.boxes[j];
        const w = L.unit * (p.dom.x[1] - p.dom.x[0]), h = L.unit * (p.dom.y[1] - p.dom.y[0]);
        const sx = scale(p.dom.x, [bx, bx + w]), sy = scale(p.dom.y, [by + h, by]);
        const S = (v: V) => [sx(v[0]), sy(v[1])] as [number, number];
        const clip = `${id}-${L.sfx}-${p.key}`;
        return (
          <g>
            <defs><clipPath id={clip}><rect x={bx} y={by} width={w} height={h} /></clipPath></defs>
            <rect x={bx} y={by} width={w} height={h} class="f-box-soft" style="fill: none" />
            <text class="f-small" x={bx} y={by - 10}>{ru ? p.ru : p.en}</text>
            <g clip-path={`url(#${clip})`}>
              {levels.map((c) => <path class="f-thin f-muted" style="stroke-opacity: .55" d={polyline(p.P.ellipse(c).map(S)) + ' Z'} />)}
              {p.runs.filter((r) => !r.dots).map((r) => r.r.path.map((v) => <circle cx={S(v)[0]} cy={S(v)[1]} r="2.3" class="f-solid-green" />))}
              {p.runs.filter((r) => r.dots).map((r) => <path class={r.cls} d={polyline(r.r.path.slice(0, 25).map(S))} />)}
              {p.runs.filter((r) => r.dots).map((r) => r.r.path.slice(0, 8).map((v) => <circle cx={S(v)[0]} cy={S(v)[1]} r="2.6" class="f-solid-blue" />))}
            </g>
            <circle cx={S([0, 0])[0]} cy={S([0, 0])[1]} r="4" class="f-solid-muted" />
            <text class="f-note f-halo" x={S([0, 0])[0] - 7} y={S([0, 0])[1] + 16} text-anchor="end">0</text>
            <circle cx={S(p.P.wh)[0]} cy={S(p.P.wh)[1]} r="4.5" class="f-solid-green" style="fill: var(--ink)" />
            <text class="f-small f-halo" x={S(p.P.wh)[0] + 9} y={S(p.P.wh)[1] - 8}>ŵ</text>
            <text class="f-note" x={bx + w} y={by + h + 17} text-anchor="end">{ru ? p.axr[0] : p.ax[0]}</text>
            <text class="f-note" x={bx + 6} y={by + 16}>{ru ? p.axr[1] : p.ax[1]}</text>
          </g>
        );
      })}
      {legend.map((g, i) => {
        const x0 = L.legendCols ? L.lx + [0, 300][i] : L.lx;
        const y0 = L.legendCols ? L.ly : L.ly + i * 28;
        return (
          <g>
            {g.dot ? [0, 8, 16, 24].map((d) => <circle cx={x0 + d} cy={y0 - 4} r="2.3" class="f-solid-green" />) : <path class={g.cls} d={`M ${x0} ${y0 - 4} h 24`} />}
            <text class="f-small" x={x0 + 31} y={y0}>{ru ? g.ru : g.en}</text>
          </g>
        );
      })}
      {L.note.map((s, i) => s && <text class="f-note" x={L.lx} y={L.noteY[i]}>{s}</text>)}
    </svg>
  ))}
</Figure>
