---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Op from '../seqflow/Op.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import { fmt } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The worked example of the note: f(x) = w x + b from w = 0.5, b = 0; batch (1, 2) -> (2, 3); mean squared error; step 0.1.
const x = [1, 2], y = [2, 3];
const w0 = 0.5, b0 = 0, eta = 0.1;
const yhat = x.map((v) => w0 * v + b0);
const res = yhat.map((v, i) => v - y[i]);
const L = res.reduce((s, r) => s + r * r, 0) / x.length;
const dyhat = res.map((r) => (2 * r) / x.length);               // ∂L/∂ŷ_i = 2 (ŷ_i − y_i) / n
const gw = dyhat.reduce((s, d, i) => s + d * x[i], 0), gb = dyhat.reduce((s, d) => s + d, 0);
const w1 = w0 - eta * gw, b1 = b0 - eta * gb;
const L1 = x.reduce((s, v, i) => s + (w1 * v + b1 - y[i]) ** 2, 0) / x.length;
const quoted = [yhat.join(' '), L, dyhat.join(' '), gw, gb, w1.toFixed(2), b1.toFixed(2), L1.toFixed(5)].join(' | ');
if (quoted !== '0.5 1 | 3.125 | -1.5 -2 | -5.5 | -3.5 | 1.05 | 0.35 | 0.33125')
  throw new Error(`TrainingLoop: the worked example drifted from the note (${quoted})`);
const f = (v: number, d = 1) => fmt(v, d).replace('-', '−');

const t = ru
  ? {
      title: 'Один оборот цикла обучения',
      model: 'w x + b', params: 'w, b', loss: 'mean (ŷ−y)²', step: 'θ − 0.1 g', dY: '∂L/∂ŷ', g: 'g = ∂L/∂(w, b)', gShort: 'g', newP: 'новые w, b',
      after: `на том же батче: L = ${L1.toFixed(3)}`, fwd: 'прямой проход', bwd: 'обратный проход и шаг',
      steps: ['батч: x = (1, 2), y = (2, 3)', 'прямой проход: ŷ = wx + b = (0.5, 1.0)', 'функция потерь: L = 3.125', 'обратный проход: ∂L/∂ŷ = (−1.5, −2), g = (−5.5, −3.5)', 'шаг: (w, b) = (0.5, 0) − 0.1 g = (1.05, 0.35)'],
      desc: 'Слева направо: батч, модель wx + b с параметрами w = 0.5 и b = 0, предсказания (0.5, 1.0), функция потерь 3.125. Снизу справа налево: градиент 1, затем ∂L/∂ŷ = (−1.5, −2), градиент по параметрам (−5.5, −3.5), шаг с η = 0.1 и новые параметры (1.05, 0.35).',
    }
  : {
      title: 'One turn of the training loop',
      model: 'w x + b', params: 'w, b', loss: 'mean (ŷ−y)²', step: 'θ − 0.1 g', dY: '∂L/∂ŷ', g: 'g = ∂L/∂(w, b)', gShort: 'g', newP: 'new w, b',
      after: `on the same batch: L = ${L1.toFixed(3)}`, fwd: 'forward', bwd: 'backward and step',
      steps: ['batch: x = (1, 2), y = (2, 3)', 'forward: ŷ = wx + b = (0.5, 1.0)', 'loss: L = 3.125', 'backward: ∂L/∂ŷ = (−1.5, −2), g = (−5.5, −3.5)', 'step: (w, b) = (0.5, 0) − 0.1 g = (1.05, 0.35)'],
      desc: 'Left to right: the batch, the model wx + b with parameters w = 0.5 and b = 0, the predictions (0.5, 1.0), the loss 3.125. Below, right to left: the seed gradient 1, then ∂L/∂ŷ = (−1.5, −2), the gradient with respect to the parameters (−5.5, −3.5), a step with η = 0.1 and the new parameters (1.05, 0.35).',
    };
const batchLabel = 'x = (1, 2)', batchSub = 'y = (2, 3)';
const id = 'deep-learning-training-loop';
const caption = ru
  ? `Пример из текста: модель f(x) = wx + b, начальные w = 0.5 и b = 0, батч из двух примеров, квадратичная ошибка, усреднённая по батчу, и шаг η = 0.1. Верхний ряд — прямой проход (1–3), нижний — обратный проход справа налево и шаг (4–5). Градиент по предсказаниям ∂L/∂ŷᵢ = 2(ŷᵢ − yᵢ)/2; градиент по w собирает его с множителями xᵢ, по b — без них. После шага функция потерь на том же батче падает с 3.125 до ${L1.toFixed(3)}. В настоящей сети меняется только масштаб: миллионы параметров и обратное распространение через все слои.`
  : `The worked example of the text: the model f(x) = wx + b from w = 0.5 and b = 0, a batch of two examples, the squared error averaged over the batch, and a step η = 0.1. The top row is the forward pass (1–3), the bottom row the backward pass from right to left and the step (4–5). The gradient with respect to the predictions is ∂L/∂ŷᵢ = 2(ŷᵢ − yᵢ)/2; the gradient with respect to w collects it with the factors xᵢ, that with respect to b without them. After the step, the loss on the same batch falls from 3.125 to ${L1.toFixed(3)}. In a real network only the scale changes: millions of parameters and backpropagation through every layer.`;
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 344" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <text class="f-small f-t-muted" x="704" y="66" text-anchor="end">{t.fwd}</text>
    <text class="f-small f-t-muted" x="704" y="300" text-anchor="end">{t.bwd}</text>
    <g data-s="1">
      <Box x={16} y={74} w={120} h={44} label={batchLabel} sub={batchSub} tone="x" />
      <Badge x={76} y={60} n={1} />
    </g>
    <g data-s="2">
      <Vec x={193} y={22} values={[f(w0), f(b0, 0)]} tone="g" dir="row" cw={40} label={t.params} labelPos="left" />
      <Arrow pts={[[233, 44], [233, 74]]} tone="amber" />
      <Arrow pts={[[136, 96], [166, 96]]} label="x" at={[151, 88]} anchor="middle" labelTone="x" />
      <Box x={168} y={76} w={130} h={40} label={t.model} />
      <Arrow pts={[[298, 96], [328, 96]]} />
      <Vec x={330} y={74} values={yhat.map((v) => f(v))} tone="y" cw={44} label="ŷ" />
      <Badge x={313} y={66} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[374, 96], [421, 96]]} />
      <Op x={472} y={96} sym={t.loss} />
      <Arrow pts={[[76, 118], [76, 142], [472, 142], [472, 111]]} dashed label="y" at={[290, 136]} anchor="middle" labelTone="x" />
      <Arrow pts={[[522, 96], [566, 96]]} />
      <Vec x={568} y={85} values={[L.toFixed(3)]} tone="y" cw={60} label="L" />
      <Badge x={472} y={66} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[598, 107], [598, 227]]} tone="red" />
      <Vec x={568} y={229} values={['1']} tone="y" cw={60} label="∂L/∂L" labelPos="below" />
      <Arrow pts={[[568, 240], [376, 240]]} tone="red" />
      <Vec x={330} y={218} values={dyhat.map((v) => f(v))} tone="y" cw={44} label={t.dY} labelPos="below" />
      <Arrow pts={[[330, 240], [294, 240]]} tone="red" label="× x" at={[312, 230]} anchor="middle" labelTone="x" />
      <Vec x={196} y={229} values={[f(gw), f(gb)]} tone="g" dir="row" cw={48} label={t.g} labelPos="below" />
      <Badge x={612} y={168} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[196, 240], [169, 240]]} tone="red" />
      <Op x={126} y={240} sym={t.step} tone="amber" />
      <Arrow pts={[[126, 253], [126, 279]]} tone="amber" />
      <Vec x={78} y={281} values={[f(w1, 2), f(b1, 2)]} tone="g" dir="row" cw={48} bold label={t.newP} labelPos="right" />
      <text class="f-small f-t-muted" x="78" y="324">{t.after}</text>
      <Badge x={126} y={212} n={5} />
    </g>
    <Legend x={290} y={334} step={120} />
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 560" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <g data-s="1">
      <Box x={16} y={20} w={130} h={44} label={batchLabel} sub={batchSub} tone="x" />
      <Badge x={164} y={22} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[81, 64], [81, 96]]} label="x" at={[90, 86]} labelTone="x" />
      <Box x={16} y={98} w={130} h={40} label={t.model} />
      <Vec x={214} y={107} values={[f(w0), f(b0, 0)]} tone="g" dir="row" cw={44} label={t.params} />
      <Arrow pts={[[214, 118], [148, 118]]} tone="amber" />
      <Arrow pts={[[81, 138], [81, 164]]} />
      <Vec x={37} y={166} values={yhat.map((v) => f(v))} tone="y" dir="row" cw={44} label="ŷ" labelPos="left" />
      <Badge x={146} y={177} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[81, 188], [81, 213]]} />
      <Op x={81} y={228} sym={t.loss} />
      <Arrow pts={[[146, 42], [184, 42], [184, 228], [133, 228]]} dashed label="y" at={[192, 160]} labelTone="x" />
      <Arrow pts={[[81, 241], [81, 266]]} />
      <Vec x={51} y={268} values={[L.toFixed(3)]} tone="y" cw={60} label="L" labelPos="left" />
      <Badge x={130} y={279} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[81, 290], [81, 326]]} tone="red" />
      <Vec x={61} y={328} values={['1']} tone="y" cw={40} />
      <text class="f-small f-t-muted" x="55" y="343" text-anchor="end">∂L/∂L</text>
      <Arrow pts={[[101, 339], [133, 339]]} tone="red" />
      <Vec x={135} y={328} values={dyhat.map((v) => f(v))} tone="y" dir="row" cw={44} />
      <text class="f-small f-t-muted" x="179" y="318" text-anchor="middle">{t.dY}</text>
      <Arrow pts={[[223, 339], [248, 339]]} tone="red" />
      <Vec x={250} y={328} values={[f(gw), f(gb)]} tone="g" dir="row" cw={48} />
      <text class="f-small f-t-muted" x="298" y="318" text-anchor="middle">{t.gShort}</text>
      <Badge x={26} y={304} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[298, 350], [298, 410], [143, 410]]} tone="red" />
      <Op x={100} y={410} sym={t.step} tone="amber" />
      <Arrow pts={[[100, 423], [100, 449]]} tone="amber" />
      <Vec x={52} y={451} values={[f(w1, 2), f(b1, 2)]} tone="g" dir="row" cw={48} bold label={t.newP} labelPos="right" />
      <text class="f-small f-t-muted" x="16" y="500">{t.after}</text>
      <Badge x={26} y={380} n={5} />
    </g>
    <Legend x={16} y={530} step={170} rows={2} />
  </svg>
  <Stepper steps={t.steps} />
</Figure>
