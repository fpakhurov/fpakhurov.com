---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Top-5 test error of the winning classification entry of the ImageNet challenge (ILSVRC), challenge data only.
// 2010–2014: Russakovsky et al. (2015), Tables 5–7 (NEC, XRCE, SuperVision, Clarifai, GoogLeNet).
// 2015: He et al. (2016), Table 5 (an ensemble of residual networks).
const data = [
  { year: 2010, team: 'NEC', err: 28.2, cnn: false },
  { year: 2011, team: 'XRCE', err: 25.8, cnn: false },
  { year: 2012, team: 'SuperVision', err: 16.4, cnn: true },
  { year: 2013, team: 'Clarifai', err: 11.7, cnn: true },
  { year: 2014, team: 'GoogLeNet', err: 6.7, cnn: true },
  { year: 2015, team: 'ResNet', err: 3.57, cnn: true },
];
if (data.map((d) => d.err).join(' ') !== '28.2 25.8 16.4 11.7 6.7 3.57') throw new Error('ImagenetErrors: values drifted from the sources');
// the drop from 2011 to 2012 quoted in the caption, in percentage points
const drop = data[1].err - data[2].err;
if (Math.abs(drop - 9.4) > 1e-9) throw new Error('ImagenetErrors: drop drifted');

const t = ru
  ? { title: 'Ошибка top-5 победителей ImageNet по годам', y: 'ошибка top-5, %', hand: 'признаки, заданные вручную', cnn: 'свёрточные сети',
      desc: 'Столбцы по годам с 2010 по 2015: 28.2, 25.8, 16.4, 11.7, 6.7 и 3.57 процента. Первые два — системы на признаках, заданных вручную, остальные — свёрточные сети.' }
  : { title: 'Top-5 error of the ImageNet winners by year', y: 'top-5 error, %', hand: 'hand-designed features', cnn: 'convolutional networks',
      desc: 'Bars for the years 2010 to 2015: 28.2, 25.8, 16.4, 11.7, 6.7 and 3.57 percent. The first two are systems on hand-designed features, the rest convolutional networks.' };
const id = 'deep-learning-imagenet-errors';
const caption = ru
  ? 'Ошибка top-5 на тестовой выборке ImageNet (доля изображений, для которых верного класса нет среди пяти самых вероятных) у победителя каждого года, обученного только на данных соревнования. 2010 и 2011 — признаки, заданные вручную, и линейные SVM; с 2012 года — свёрточные сети: SuperVision (сеть Крижевского, Суцкевера и Хинтона), Clarifai, GoogLeNet и ансамбль остаточных сетей ResNet. Переход 2011→2012 снизил ошибку на 9.4 процентного пункта, больше, чем любой следующий год. С дополнительными данными SuperVision получила 15.3%.'
  : 'Top-5 error on the ImageNet test set (the fraction of images whose correct class is not among the five most probable) of each year\'s winner trained on the challenge data only. 2010 and 2011: hand-designed features with linear SVMs; from 2012: convolutional networks, namely SuperVision (the network of Krizhevsky, Sutskever and Hinton), Clarifai, GoogLeNet and an ensemble of residual networks (ResNet). The step from 2011 to 2012 cut the error by 9.4 percentage points, more than any later year. With extra training data SuperVision reached 15.3%.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [72, 744] as [number, number], py: [44, 250] as [number, number], bar: 64, team: true, ly: 18 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 322, px: [48, 352] as [number, number], py: [84, 270] as [number, number], bar: 32, team: false, ly: 18 },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => {
    const sy = scale([0, 30], [Ly.py[1], Ly.py[0]]);
    const slot = (Ly.px[1] - Ly.px[0]) / data.length;
    const cx = (i: number) => Ly.px[0] + slot * (i + 0.5);
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
        {[10, 20, 30].map((v) => <path class="f-grid" d={`M ${Ly.px[0]} ${sy(v)} H ${Ly.px[1]}`} />)}
        <path class="f-axis" d={`M ${Ly.px[0]} ${Ly.py[1]} H ${Ly.px[1]} M ${Ly.px[0]} ${Ly.py[0] - 6} V ${Ly.py[1]}`} />
        {[0, 10, 20, 30].map((v) => <text class="f-note" x={Ly.px[0] - 7} y={sy(v) + 5} text-anchor="end">{v}</text>)}
        <text class="f-small f-t-muted" x={Ly.px[0] - 36} y={Ly.py[0] - 22}>{t.y}</text>
        <rect x={Ly.sfx === 'w' ? 400 : 48} y={Ly.sfx === 'w' ? Ly.ly - 10 : 8} width="14" height="12" class="f-fill-blue" style="stroke: var(--fig-blue); stroke-width: 1.2" />
        <text class="f-small f-t-muted" x={Ly.sfx === 'w' ? 420 : 68} y={Ly.sfx === 'w' ? Ly.ly : 18}>{t.hand}</text>
        <rect x={Ly.sfx === 'w' ? 584 : 48} y={Ly.sfx === 'w' ? Ly.ly - 10 : 28} width="14" height="12" class="f-fill-red" style="stroke: var(--fig-red); stroke-width: 1.2" />
        <text class="f-small f-t-muted" x={Ly.sfx === 'w' ? 604 : 68} y={Ly.sfx === 'w' ? Ly.ly : 38}>{t.cnn}</text>
        {data.map((d, i) => (
          <g>
            <rect x={cx(i) - Ly.bar / 2} y={sy(d.err)} width={Ly.bar} height={Ly.py[1] - sy(d.err)}
              class={d.cnn ? 'f-fill-red' : 'f-fill-blue'} style={`stroke: var(${d.cnn ? '--fig-red' : '--fig-blue'}); stroke-width: 1.3`} />
            <text class="f-small" x={cx(i)} y={sy(d.err) - 7} text-anchor="middle">{String(d.err)}</text>
            <text class="f-small" x={cx(i)} y={Ly.py[1] + 20} text-anchor="middle">{String(d.year)}</text>
            {Ly.team && <text class="f-note" x={cx(i)} y={Ly.py[1] + 40} text-anchor="middle">{d.team}</text>}
          </g>
        ))}
        <text class="f-small f-t-muted" x={(Ly.px[0] + Ly.px[1]) / 2} y={Ly.H - 12} text-anchor="middle">{ru ? 'год соревнования' : 'year of the challenge'}</text>
      </svg>
    );
  })}
</Figure>
