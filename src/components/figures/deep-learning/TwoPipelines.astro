---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// ImageNet top-5 test error of the two winners compared in the caption (Russakovsky et al., 2015, Tables 5 and 6;
// 2012 with the challenge data only).
const err2011 = '25.8%', err2012 = '16.4%';

const t = ru
  ? {
      title: 'Признаки, заданные вручную, и признаки, выученные сетью',
      handRow: 'признаки вручную (ImageNet 2011: 25.8% ошибок top-5)',
      deepRow: 'глубокая сеть (ImageNet 2012: 16.4%)',
      pixels: 'пиксели x', features: 'признаки h(x)', fixed: 'заданы вручную',
      layer: (k: string) => `слой ${k}`, clf: 'W h + b', clfL: 'W h_L + b', learned: 'обучаемый', cls: 'класс',
      stop: 'градиент доходит только до классификатора', all: 'градиент доходит до каждого слоя',
      handCol: 'вручную', deepCol: 'глубокая сеть', grad: 'красное: градиент функции потерь',
      desc: 'Два конвейера. Верхний: пиксели, затем фиксированные признаки, заданные вручную, затем обучаемый линейный классификатор и класс; градиент функции потерь доходит только до классификатора. Нижний: пиксели, затем слои 1, 2, …, L и линейный классификатор; градиент доходит до каждого слоя.',
    }
  : {
      title: 'Features designed by hand and features learned by a network',
      handRow: 'hand-designed features (ImageNet 2011: 25.8% top-5 error)',
      deepRow: 'deep network (ImageNet 2012: 16.4%)',
      pixels: 'pixels x', features: 'features h(x)', fixed: 'fixed, by hand',
      layer: (k: string) => `layer ${k}`, clf: 'W h + b', clfL: 'W h_L + b', learned: 'linear, learned', cls: 'class',
      stop: 'the gradient stops at the classifier', all: 'the gradient reaches every layer',
      handCol: 'by hand', deepCol: 'deep network', grad: 'red: the gradient of the loss',
      desc: 'Two pipelines. Top: pixels, then fixed hand-designed features, then a learned linear classifier and the class; the gradient of the loss reaches only the classifier. Bottom: pixels, then layers 1, 2, …, L and a linear classifier; the gradient reaches every layer.',
    };
if (!t.handRow.includes(err2011) || !t.deepRow.includes(err2012)) throw new Error('TwoPipelines: error rates drifted from the text');
const id = 'deep-learning-two-pipelines';
const caption = ru
  ? 'Сверху — система до 2012 года: признаки h(x) (гистограммы направлений градиентов, коды дескрипторов) заданы людьми и не меняются, обучается только линейный классификатор поверх них. Снизу — глубокая сеть: признаки h₁, …, h_L вычисляются слоями, и градиент одной функции потерь (красный) меняет их все вместе с классификатором. Последний слой в обоих случаях — линейная модель на признаках. Ошибки top-5 — победители соревнования ImageNet 2011 и 2012 годов на данных соревнования.'
  : 'Top: a system before 2012. The features h(x) (histograms of gradient orientations, coded descriptors) are designed by people and stay fixed; only the linear classifier on top is trained. Bottom: a deep network. The features h₁, …, h_L are computed by layers, and the gradient of one loss (red) changes all of them together with the classifier. In both, the last layer is a linear model on features. The top-5 errors are those of the ImageNet winners of 2011 and 2012, trained on the challenge data.';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 246" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <text class="f-small f-t-muted" x="16" y="22">{t.handRow}</text>
    <Box x={16} y={34} w={90} h={46} label={t.pixels} tone="x" />
    <Arrow pts={[[106, 57], [134, 57]]} />
    <Box x={136} y={34} w={308} h={46} label={t.features} sub={t.fixed} />
    <Arrow pts={[[444, 57], [472, 57]]} />
    <Box x={474} y={34} w={120} h={46} label={t.clf} sub={t.learned} tone="g" />
    <Arrow pts={[[594, 57], [622, 57]]} />
    <Box x={624} y={34} w={88} h={46} label={t.cls} tone="y" />
    <Arrow pts={[[668, 80], [668, 96], [534, 96], [534, 82]]} tone="red" dashed />
    <text class="f-small f-t-red" x="601" y="114" text-anchor="middle">{t.stop}</text>

    <text class="f-small f-t-muted" x="16" y="140">{t.deepRow}</text>
    <Box x={16} y={152} w={90} h={46} label={t.pixels} tone="x" />
    <Arrow pts={[[106, 175], [134, 175]]} />
    <Box x={136} y={152} w={80} h={46} label={t.layer('1')} tone="h" />
    <Arrow pts={[[216, 175], [238, 175]]} />
    <Box x={240} y={152} w={80} h={46} label={t.layer('2')} tone="h" />
    <Arrow pts={[[320, 175], [336, 175]]} head={false} />
    <text class="f-label" x="342" y="180" text-anchor="middle">⋯</text>
    <Arrow pts={[[348, 175], [362, 175]]} />
    <Box x={364} y={152} w={80} h={46} label={t.layer('L')} tone="h" />
    <Arrow pts={[[444, 175], [472, 175]]} />
    <Box x={474} y={152} w={120} h={46} label={t.clfL} sub={t.learned} tone="g" />
    <Arrow pts={[[594, 175], [622, 175]]} />
    <Box x={624} y={152} w={88} h={46} label={t.cls} tone="y" />
    <Arrow pts={[[668, 198], [668, 214], [176, 214], [176, 200]]} tone="red" dashed />
    <text class="f-small f-t-red" x="420" y="234" text-anchor="middle">{t.all}</text>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 476" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <text class="f-small f-t-muted" x="90" y="20" text-anchor="middle">{t.handCol}</text>
    <text class="f-small f-t-muted" x="270" y="20" text-anchor="middle">{t.deepCol}</text>

    <Box x={15} y={34} w={150} h={40} label={t.pixels} tone="x" />
    <Arrow pts={[[90, 74], [90, 102]]} />
    <Box x={15} y={104} w={150} h={180} label={t.features} sub={t.fixed} subGap={20} />
    <Arrow pts={[[90, 284], [90, 306]]} />
    <Box x={15} y={308} w={150} h={46} label={t.clf} sub={t.learned} tone="g" />
    <Arrow pts={[[90, 354], [90, 376]]} />
    <Box x={15} y={378} w={150} h={34} label={t.cls} tone="y" />
    <Arrow pts={[[165, 395], [176, 395], [176, 331], [167, 331]]} tone="red" dashed />

    <Box x={195} y={34} w={150} h={40} label={t.pixels} tone="x" />
    <Arrow pts={[[270, 74], [270, 102]]} />
    <Box x={195} y={104} w={150} h={36} label={t.layer('1')} tone="h" />
    <Arrow pts={[[270, 140], [270, 158]]} />
    <Box x={195} y={160} w={150} h={36} label={t.layer('2')} tone="h" />
    <Arrow pts={[[270, 196], [270, 208]]} head={false} />
    <text class="f-label" x="270" y="226" text-anchor="middle">⋮</text>
    <Arrow pts={[[270, 232], [270, 246]]} />
    <Box x={195} y={248} w={150} h={36} label={t.layer('L')} tone="h" />
    <Arrow pts={[[270, 284], [270, 306]]} />
    <Box x={195} y={308} w={150} h={46} label={t.clfL} sub={t.learned} tone="g" />
    <Arrow pts={[[270, 354], [270, 376]]} />
    <Box x={195} y={378} w={150} h={34} label={t.cls} tone="y" />
    <Arrow pts={[[345, 395], [354, 395], [354, 122], [347, 122]]} tone="red" dashed />

    <text class="f-small f-t-muted" x="90" y="434" text-anchor="middle">{`${err2011} (2011)`}</text>
    <text class="f-small f-t-muted" x="270" y="434" text-anchor="middle">{`${err2012} (2012)`}</text>
    <text class="f-small f-t-red" x="180" y="462" text-anchor="middle">{t.grad}</text>
  </svg>
</Figure>
