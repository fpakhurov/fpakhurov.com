---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Twenty points x equally spaced on [-1, 1], y = sin(pi x) + noise of sd 0.2, rounded to 3 decimals (the Code section's data).
// Polynomials of degree M with prior w ~ N(0, I / alpha) and noise precision beta = 25.
const N = 20;
const xs = Array.from({ length: N }, (_, i) => -1 + (2 * i) / (N - 1));
const ys = [0.025, -0.351, -0.486, -0.816, -1.077, -0.924, -0.655, -0.546, -0.617, -0.418, 0.04, 0.484, 0.271, 0.872, 0.747, 0.823, 0.728, 0.551, 0.407, 0.209];
const beta = 25;
const feats = (x: number, M: number) => Array.from({ length: M + 1 }, (_, j) => x ** j);

// log N(y | 0, C), C = Phi Phi^T / alpha + I / beta, by a Cholesky factor
const logEvidence = (M: number, alpha: number) => {
  const F = xs.map((x) => feats(x, M));
  const C = F.map((fi, i) => F.map((fj, j) => fi.reduce((s, v, k) => s + v * fj[k], 0) / alpha + (i === j ? 1 / beta : 0)));
  const L = C.map(() => new Array(N).fill(0));
  for (let i = 0; i < N; i++) for (let j = 0; j <= i; j++) {
    let s = C[i][j];
    for (let k = 0; k < j; k++) s -= L[i][k] * L[j][k];
    L[i][j] = i === j ? Math.sqrt(s) : s / L[j][j];
  }
  const z = new Array(N).fill(0);
  for (let i = 0; i < N; i++) { let s = ys[i]; for (let k = 0; k < i; k++) s -= L[i][k] * z[k]; z[i] = s / L[i][i]; }
  return -0.5 * z.reduce((s, v) => s + v * v, 0) - L.reduce((s, r, i) => s + Math.log(r[i]), 0) - 0.5 * N * Math.log(2 * Math.PI);
};
// posterior mean m = (alpha I + beta Phi^T Phi)^{-1} beta Phi^T y, by Gaussian elimination
const postMean = (M: number, alpha: number) => {
  const d = M + 1, F = xs.map((x) => feats(x, M));
  const A = Array.from({ length: d }, (_, a) => Array.from({ length: d }, (_, b) => beta * F.reduce((s, f) => s + f[a] * f[b], 0) + (a === b ? alpha : 0)));
  const r = Array.from({ length: d }, (_, a) => beta * F.reduce((s, f, i) => s + f[a] * ys[i], 0));
  for (let c = 0; c < d; c++) {
    let piv = c;
    for (let i = c + 1; i < d; i++) if (Math.abs(A[i][c]) > Math.abs(A[piv][c])) piv = i;
    [A[c], A[piv]] = [A[piv], A[c]]; [r[c], r[piv]] = [r[piv], r[c]];
    for (let i = c + 1; i < d; i++) { const f = A[i][c] / A[c][c]; for (let j = c; j < d; j++) A[i][j] -= f * A[c][j]; r[i] -= f * r[c]; }
  }
  const m = new Array(d).fill(0);
  for (let i = d - 1; i >= 0; i--) { let s = r[i]; for (let j = i + 1; j < d; j++) s -= A[i][j] * m[j]; m[i] = s / A[i][i]; }
  return m;
};
const Ms = Array.from({ length: 10 }, (_, M) => M);
const ev1 = Ms.map((M) => logEvidence(M, 1)), ev2 = Ms.map((M) => logEvidence(M, 0.01));
const best = ev1.indexOf(Math.max(...ev1)), best2 = ev2.indexOf(Math.max(...ev2));
const chk = [ev1[0].toFixed(2), ev1[3].toFixed(2), ev1[9].toFixed(2), ev2[3].toFixed(2), ev2[9].toFixed(2), best, best2].join(' ');
if (chk !== '-84.84 -4.18 -6.77 -8.84 -18.26 3 3') throw new Error(`PolyEvidence: evidences drifted from the note (${chk})`);
const fits = [
  { M: 1, cls: 'f-line f-green', tone: 'f-t-green' },
  { M: 3, cls: 'f-line f-blue', tone: 'f-t-blue' },
  { M: 9, cls: 'f-line f-amber f-dash', tone: 'f-t-amber' },
].map((f) => { const m = postMean(f.M, 1); return { ...f, g: (x: number) => feats(x, f.M).reduce((s, v, j) => s + v * m[j], 0) }; });
const gx = Array.from({ length: 161 }, (_, i) => -1 + i / 80);

const t = ru
  ? {
      title: 'Обоснованность полиномиальных моделей',
      left: 'данные и апостериорные средние', right: 'логарифм обоснованности', deg: 'степень M', a1: 'α = 1', a2: 'α = 0.01', peak: 'максимум при M = 3', off: 'M = 0: −84.8, вне шкалы',
      fit: (M: number) => `M = ${M}`,
      desc: 'Слева 20 точек около синусоиды и три кривые: прямая (M = 1), кубический полином (M = 3), близкий к данным, и полином степени 9, почти совпадающий с кубическим. Справа логарифм обоснованности по степени M = 1…9 для α = 1 и α = 0.01: резкий рост до M = 3 и медленный спад после, круче при более широком априорном распределении.',
    }
  : {
      title: 'The evidence of polynomial models',
      left: 'data and posterior means', right: 'log evidence', deg: 'degree M', a1: 'α = 1', a2: 'α = 0.01', peak: 'peak at M = 3', off: 'M = 0: −84.8, off the scale',
      fit: (M: number) => `M = ${M}`,
      desc: 'Left, 20 points around a sine and three curves: a line (M = 1), a cubic (M = 3) that follows the data, and a degree-9 polynomial almost on top of the cubic. Right, the log evidence by degree M = 1 to 9 for α = 1 and α = 0.01: a sharp rise to M = 3 and a slow decline after it, steeper for the broader prior.',
    };
const id = 'poly-evidence';
const caption = ru
  ? 'Двадцать точек на [−1, 1]: sin(πx) плюс шум со стандартным отклонением 0.2; априорное распределение весов N(0, α⁻¹I), обратная дисперсия шума β = 25. Слева апостериорные средние при α = 1 для степеней 1, 3 и 9; полином степени 9 почти не отличается от кубического, потому что априорное распределение гасит лишние направления. Справа логарифм обоснованности: максимум при M = 3 (−4.18 при α = 1, −8.84 при α = 0.01), после него медленный спад, тем более крутой, чем шире априорное распределение.'
  : 'Twenty points on [−1, 1]: sin(πx) plus noise of standard deviation 0.2; prior on the weights N(0, α⁻¹I), noise precision β = 25. Left, the posterior means at α = 1 for degrees 1, 3 and 9; the degree-9 polynomial differs little from the cubic, because the prior damps the extra directions. Right, the log evidence: a peak at M = 3 (−4.18 at α = 1, −8.84 at α = 0.01), then a slow decline, the steeper the broader the prior.';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 320, A: { x0: 50, x1: 350, y0: 70, y1: 262 }, B: { x0: 450, x1: 740, y0: 70, y1: 262 } },
  { cls: 'fig-narrow', W: 360, H: 660, A: { x0: 44, x1: 340, y0: 70, y1: 262 }, B: { x0: 54, x1: 340, y0: 400, y1: 592 } },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const A = L.A, B = L.B;
    const sxA = scale([-1, 1], [A.x0, A.x1]), syA = scale([-1.6, 1.6], [A.y1, A.y0]);
    const sxB = scale([1, 9], [B.x0, B.x1]), syB = scale([-45, 0], [B.y1, B.y0]);
    const line = (ev: number[]) => polyline(Ms.slice(1).map((M) => [sxB(M), syB(ev[M])]));
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        <text class="f-label" x={A.x0} y={A.y0 - 44}>{t.left}</text>
        {fits.map((f, i) => (
          <g>
            <path class={f.cls} d={`M ${A.x0 + i * 72} ${A.y0 - 20} h 16`} />
            <text class={`f-small ${f.tone}`} x={A.x0 + i * 72 + 22} y={A.y0 - 16}>{t.fit(f.M)}</text>
          </g>
        ))}
        {[-1, 0, 1].map((v) => (
          <g>
            <path class="f-grid" d={`M ${A.x0} ${syA(v)} H ${A.x1}`} />
            <text class="f-note" x={A.x0 - 6} y={syA(v) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        {fits.map((f) => <path class={f.cls} d={polyline(gx.map((x) => [sxA(x), syA(f.g(x))]))} />)}
        {xs.map((x, i) => <circle cx={sxA(x)} cy={syA(ys[i])} r="3.2" class="f-fill-ink" />)}
        <path class="f-axis" d={`M ${A.x0} ${A.y1} H ${A.x1}`} />
        {[-1, 0, 1].map((v) => <text class="f-note" x={sxA(v)} y={A.y1 + 17} text-anchor="middle">{v}</text>)}
        <text class="f-small f-t-muted" x={(A.x0 + A.x1) / 2} y={A.y1 + 38} text-anchor="middle">x</text>

        <text class="f-label" x={B.x0} y={B.y0 - 44}>{t.right}</text>
        <path class="f-line f-blue" d={`M ${B.x0} ${B.y0 - 20} h 16`} />
        <text class="f-small f-t-blue" x={B.x0 + 22} y={B.y0 - 16}>{t.a1}</text>
        <path class="f-line f-amber f-dash" d={`M ${B.x0 + 80} ${B.y0 - 20} h 16`} />
        <text class="f-small f-t-amber" x={B.x0 + 102} y={B.y0 - 16}>{t.a2}</text>
        {[0, -10, -20, -30, -40].map((v) => (
          <g>
            <path class="f-grid" d={`M ${B.x0} ${syB(v)} H ${B.x1}`} />
            <text class="f-note" x={B.x0 - 6} y={syB(v) + 4} text-anchor="end">{v === 0 ? '0' : `−${-v}`}</text>
          </g>
        ))}
        <path class="f-line f-amber f-dash" d={line(ev2)} />
        <path class="f-line f-blue" d={line(ev1)} />
        {Ms.slice(1).map((M) => <circle cx={sxB(M)} cy={syB(ev2[M])} r="3" style="fill: var(--fig-amber)" />)}
        {Ms.slice(1).map((M) => <circle cx={sxB(M)} cy={syB(ev1[M])} r={M === best ? 5 : 3.2} class="f-solid-blue" />)}
        <text class="f-small f-t-blue f-halo" x={sxB(best) + 8} y={syB(ev1[best]) - 10}>{t.peak}</text>
        <path class="f-axis" d={`M ${B.x0} ${B.y1} H ${B.x1}`} />
        {Ms.slice(1).map((M) => <text class="f-note" x={sxB(M)} y={B.y1 + 17} text-anchor="middle">{M}</text>)}
        <text class="f-small f-t-muted" x={(B.x0 + B.x1) / 2} y={B.y1 + 38} text-anchor="middle">{t.deg}</text>
        <text class="f-small f-t-muted" x={B.x1} y={B.y1 - 8} text-anchor="end">{t.off}</text>
      </svg>
    );
  })}
</Figure>
