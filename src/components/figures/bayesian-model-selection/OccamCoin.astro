---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import Sub from '../generative-modeling/Sub.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Ten flips. M0: the coin is fair, P(k) = C(10, k) / 1024. M1: uniform prior on the bias, P(k) = 1/11 for every k.
const ks = Array.from({ length: 11 }, (_, k) => k);
const choose = (n: number, k: number) => { let c = 1; for (let i = 1; i <= k; i++) c = (c * (n - k + i)) / i; return c; };
const p0 = ks.map((k) => choose(10, k) / 1024);
const p1 = ks.map(() => 1 / 11);
const K01 = p0[5] / p1[5], K10 = p1[9] / p0[9];
const chk = [p0[5].toFixed(3), p1[5].toFixed(3), p0[9].toFixed(4), K01.toFixed(2), K10.toFixed(2)].join(' ');
if (chk !== '0.246 0.091 0.0098 2.71 9.31') throw new Error(`OccamCoin: numbers drifted from the note (${chk})`);

const t = ru
  ? {
      title: 'Обоснованность как бритва Оккама: честная монета против любой',
      m0: ': монета честная', m1: ': вероятность орла f ~ U[0, 1]', x: 'число орлов k в 10 бросках', y: 'P(k | модель)',
      h5: '5 орлов', h9: '9 орлов', f5: `K_{01} = ${K01.toFixed(2)}: честная`, f9: `K_{10} = ${K10.toFixed(2)}: несимметричная`,
      steps: ['простая модель собирает массу около k = 5', 'гибкая модель распределяет её поровну: 1/11 на каждое k', '5 орлов: 0.246 против 0.091, выигрывает честная монета', '9 орлов: 0.0098 против 0.091, выигрывает гибкая модель'],
      desc: 'Столбцы для k = 0…10: биномиальные вероятности честной монеты с пиком 0.246 при k = 5 и ровные столбцы 0.091 гибкой модели. При k = 5 выше честная монета (отношение 2.71), при k = 9 — гибкая модель (отношение 9.31).',
    }
  : {
      title: "The evidence as Occam's razor: a fair coin against any coin",
      m0: ': the coin is fair', m1: ': uniform prior on its bias f', x: 'number of heads k in 10 flips', y: 'P(k | model)',
      h5: '5 heads', h9: '9 heads', f5: `K_{01} = ${K01.toFixed(2)}: the fair coin`, f9: `K_{10} = ${K10.toFixed(2)}: a biased coin`,
      steps: ['the simple model concentrates its mass near k = 5', 'the flexible model spreads it: 1/11 for every k', '5 heads: 0.246 against 0.091, the fair coin wins', '9 heads: 0.0098 against 0.091, the flexible model wins'],
      desc: 'Bars for k = 0 to 10: the binomial probabilities of the fair coin, peaking at 0.246 at k = 5, and the flat bars of 0.091 of the flexible model. At k = 5 the fair coin is higher (ratio 2.71), at k = 9 the flexible model is (ratio 9.31).',
    };
const v5 = `M_0: ${p0[5].toFixed(3)}, M_1: ${p1[5].toFixed(3)}`, v9 = `M_0: ${p0[9].toFixed(4)}, M_1: ${p1[9].toFixed(3)}`;
const id = 'occam-coin';
const caption = ru
  ? 'Вероятность, которую каждая модель даёт числу орлов в 10 бросках; столбцы каждой модели в сумме дают 1. M₀, честная монета (янтарная), сосредоточивает массу около k = 5. M₁, равномерное априорное распределение на вероятность орла (синяя), даёт каждому k по 1/11. Сравните столбцы при k = 5 и k = 9.'
  : 'The probability each model gives to the number of heads in 10 flips; each set of bars sums to 1. M₀, a fair coin (amber), concentrates its mass near k = 5. M₁, a uniform prior on the bias (blue), gives every k 1/11. Compare the bars at k = 5 and k = 9.';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 320, x0: 60, x1: 520, y0: 76, y1: 256, lx: 60, ly: [22, 42], rx: 552, ry: [96, 196], bw: 15 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 560, x0: 44, x1: 344, y0: 84, y1: 270, lx: 20, ly: [24, 50], rx: 20, ry: [354, 450], bw: 10 },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const slot = (L.x1 - L.x0) / 11;
    const cx = (k: number) => L.x0 + (k + 0.5) * slot;
    const sy = scale([0, 0.26], [L.y1, L.y0]);
    const mark = (k: number, s: number) => (
      <g data-s={s}>
        <path class="f-thin f-red f-dash" d={`M ${cx(k)} ${L.y1} V ${L.y0 - 4}`} />
        <Badge x={cx(k)} y={L.y0 - 16} n={s} />
      </g>
    );
    const row = (s: number, y: number, head: string, vals: string, fac: string) => (
      <g data-s={s}>
        <Badge x={L.rx + 10} y={y - 5} n={s} />
        <text class="f-label" x={L.rx + 28} y={y}>{head}</text>
        <text class="f-small" x={L.rx + 28} y={y + 24}><Sub label={vals} /></text>
        <text class="f-small f-t-red" x={L.rx + 28} y={y + 46}><Sub label={fac} /></text>
      </g>
    );
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        {[0, 0.1, 0.2].map((v) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} />
            <text class="f-note" x={L.x0 - 6} y={sy(v) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        <g data-s="1">
          <rect x={L.lx} y={L.ly[0] - 10} width="12" height="10" class="f-fill-amber f-amber" />
          <text class="f-small" x={L.lx + 18} y={L.ly[0]}><Sub label="M_0" />{t.m0}</text>
          {ks.map((k) => <rect x={cx(k) - L.bw - 1} y={sy(p0[k])} width={L.bw} height={sy(0) - sy(p0[k])} class="f-fill-amber f-amber" style="stroke-width: 1" />)}
        </g>
        <g data-s="2">
          <rect x={L.lx} y={L.ly[1] - 10} width="12" height="10" class="f-fill-blue f-blue" />
          <text class="f-small" x={L.lx + 18} y={L.ly[1]}><Sub label="M_1" />{t.m1}</text>
          {ks.map((k) => <rect x={cx(k) + 1} y={sy(p1[k])} width={L.bw} height={sy(0) - sy(p1[k])} class="f-fill-blue f-blue" style="stroke-width: 1" />)}
        </g>
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {ks.map((k) => <text class="f-note" x={cx(k)} y={L.y1 + 17} text-anchor="middle">{k}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 40} text-anchor="middle">{t.x}</text>
        {mark(5, 3)}
        {mark(9, 4)}
        {row(3, L.ry[0], t.h5, v5, t.f5)}
        {row(4, L.ry[1], t.h9, v9, t.f9)}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
