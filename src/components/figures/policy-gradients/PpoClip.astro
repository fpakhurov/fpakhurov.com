---
import Figure from '../Figure.astro';
import Curves from '../temporal-difference-learning/Curves.astro';
import { scale, plot } from '../geometry';
import { clipObjective } from './pg';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// PPO's clipped objective for one sample, min(r A, clip(r, 1 − ε, 1 + ε) A), with ε = 0.2 and A = +2 or −2,
// against the unclipped surrogate r A. Dots: the ratios of the table in the note.
const eps = 0.2, ratios = [0.6, 0.9, 1.0, 1.1, 1.4];
const table = [2, -2].map((A) => ratios.map((r) => clipObjective(r, A, eps)));
const chk = table.map((row) => row.map((v) => `${v.L.toFixed(1)}/${v.slope}`).join(' ')).join(' | ');
if (chk !== '1.2/2 1.8/2 2.0/2 2.2/2 2.4/0 | -1.6/0 -1.8/-2 -2.0/-2 -2.2/-2 -2.8/-2') throw new Error(`PpoClip: numbers drifted from the note (${chk})`);

const t = ru
  ? { title: 'Обрезанная целевая функция PPO при ε = 0.2', r: 'отношение r новой вероятности к старой', pos: 'A = +2: действие лучше среднего', neg: 'A = −2: действие хуже среднего',
      clip: 'min(r A, clip(r) A)', raw: 'r A без обрезки', flat: 'градиент 0',
      desc: 'Две панели. Слева преимущество +2: обрезанная целевая функция растёт как 2r до r = 1.2 и дальше остаётся равной 2.4, а необрезанная продолжает расти. Справа преимущество −2: при r меньше 0.8 целевая функция постоянна и равна −1.6, при больших r она убывает как −2r вместе с необрезанной. Точки отмечают r = 0.6, 0.9, 1.0, 1.1 и 1.4.' }
  : { title: 'PPO\'s clipped objective with ε = 0.2', r: 'ratio r of the new probability to the old', pos: 'A = +2: better than average', neg: 'A = −2: worse than average',
      clip: 'min(r A, clip(r) A)', raw: 'r A, unclipped', flat: 'gradient 0',
      desc: 'Two panels. Left, advantage +2: the clipped objective rises as 2r up to r = 1.2 and stays at 2.4 beyond, while the unclipped one keeps rising. Right, advantage −2: below r = 0.8 the objective is constant at −1.6; above, it falls as −2r together with the unclipped one. Dots mark r = 0.6, 0.9, 1.0, 1.1 and 1.4.' };
const id = 'pg-ppo-clip';
const caption = ru
  ? 'Для одного действия с преимуществом A целевая функция PPO — минимум из r A и той же величины с r, обрезанным до [0.8, 1.2]. Минимум выбирает пессимистичную из двух: когда новая стратегия уже сделала хорошее действие на 20% вероятнее (r > 1.2 при A > 0) или плохое на 20% менее вероятным (r < 0.8 при A < 0), целевая функция перестаёт расти и градиент этого примера обнуляется (серые участки). В обратную сторону обрезки нет: если шаг ухудшил дело, целевая функция продолжает его штрафовать.'
  : 'For one action with advantage A, PPO\'s objective is the minimum of r A and the same quantity with r clipped to [0.8, 1.2]. The minimum picks the more pessimistic of the two: once the new policy has made a good action 20% more likely (r > 1.2 with A > 0) or a bad one 20% less likely (r < 0.8 with A < 0), the objective stops improving and the gradient of that sample is zero (grey stretches). There is no clipping in the other direction: if a step made things worse, the objective keeps penalizing it.';

const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 320, P: [{ px: [64, 344] as [number, number], py: [56, 256] as [number, number] }, { px: [444, 724] as [number, number], py: [56, 256] as [number, number] }] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 640, P: [{ px: [56, 340] as [number, number], py: [56, 256] as [number, number] }, { px: [56, 340] as [number, number], py: [372, 572] as [number, number] }] },
];
const dx: [number, number] = [0.4, 1.6];
const minusFmt = (v: number) => (v < 0 ? `−${-v}` : String(v));
// per panel: the stretch where the gradient is zero, where its label sits, and where the two curve labels sit (data coordinates)
const panels = [
  { A: 2, dy: [0, 3.2] as [number, number], yt: [0, 1, 2, 3], head: t.pos, flat: [1 + eps, 1.6], flatTop: false,
    clipAt: [0.45, 2.9], clipAnchor: 'start', rawAt: [1.38, 3.05], rawAnchor: 'end' },
  { A: -2, dy: [-3.2, 0] as [number, number], yt: [-3, -2, -1, 0], head: t.neg, flat: [0.4, 1 - eps], flatTop: true,
    clipAt: [1.55, -0.35], clipAnchor: 'end', rawAt: [0.45, -0.7], rawAnchor: 'start' },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
      {panels.map((pn, k) => {
        const P = L.P[k], sx = scale(dx, P.px), sy = scale(pn.dy, [P.py[1], P.py[0]]);
        return (
          <g>
            <text class="f-small" x={P.px[0]} y={P.py[0] - 22} style="font-weight: 600">{pn.head}</text>
            <rect x={sx(pn.flat[0])} y={P.py[0]} width={sx(pn.flat[1]) - sx(pn.flat[0])} height={P.py[1] - P.py[0]} style="fill: var(--muted); fill-opacity: 0.1" />
            <text class="f-small f-t-muted" x={(sx(pn.flat[0]) + sx(pn.flat[1])) / 2} y={pn.flatTop ? P.py[0] + 18 : P.py[1] - 10} text-anchor="middle">{t.flat}</text>
            <Curves px={P.px} py={P.py} dx={dx} dy={pn.dy} xTicks={[0.4, 0.8, 1.2, 1.6]} yTicks={pn.yt}
              xFmt={(v: number) => v.toFixed(1)} yFmt={minusFmt} xLabel={t.r} series={[]} />
            <path class="f-line f-muted f-dash" d={plot((r) => r * pn.A, 0.4, 1.6, sx, sy, 40)} />
            <path class="f-line f-blue f-bold" d={plot((r) => clipObjective(r, pn.A, eps).L, 0.4, 1.6, sx, sy, 240)} />
            {ratios.map((r) => <circle cx={sx(r)} cy={sy(clipObjective(r, pn.A, eps).L)} r="4" class="f-solid-blue" />)}
            <text class="f-small f-t-blue f-halo" x={sx(pn.clipAt[0])} y={sy(pn.clipAt[1])} text-anchor={pn.clipAnchor}>{t.clip}</text>
            <text class="f-small f-t-muted f-halo" x={sx(pn.rawAt[0])} y={sy(pn.rawAt[1])} text-anchor={pn.rawAnchor}>{t.raw}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
