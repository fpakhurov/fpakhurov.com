---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
// Original three-slot allocation fixture: reward one for exactly two priority jobs.
const value = (p: number) => 3 * p * p * (1 - p);
const sx = (p: number) => 48 + 280 * p;
const sy = (reward: number) => 224 - 360 * reward;
const curve = Array.from({ length: 121 }, (_, i) => {
  const p = i / 120;
  return `${i ? 'L' : 'M'}${sx(p).toFixed(3)},${sy(value(p)).toFixed(3)}`;
}).join(' ');
const id = 'pg-allocation-policy';
const title = ru ? 'Три слота и одна вероятность' : 'Three slots, one probability';
const description = ru
  ? 'Ожидаемая награда J(p) = 3p²(1 − p). При p = 0.4 она равна 0.288; максимум 4/9 достигается при p = 2/3. При p = 0 и p = 1 награда нулевая.'
  : 'Expected reward J(p) = 3p²(1 − p). At p = 0.4 it is 0.288; the maximum 4/9 occurs at p = 2/3. At p = 0 and p = 1 reward is zero.';
const caption = ru
  ? 'В каждом из трёх слотов независимо выбираем приоритетную задачу с общей вероятностью p. Успешны три последовательности: 110, 101 и 011. Кривая вычислена по их точным вероятностям. Ограничение общей вероятности существенно: стратегия, учитывающая номер слота и уже выбранные задачи, может получить награду 1.'
  : 'Each of three slots independently selects a priority job with the same probability p. Three schedules succeed: 110, 101 and 011. The curve uses their exact probabilities. The shared-probability restriction matters: a policy that observes the slot and previous choices can obtain reward 1.';
---

<span id="pg-short-corridor"></span>
<Figure id="pg-short-corridor" title={title} caption={caption}>
  <svg class="allocation-plot" viewBox="0 0 360 278" role="img" aria-labelledby={`${id}-title ${id}-description`}>
    <title id={`${id}-title`}>{title}</title>
    <desc id={`${id}-description`}>{description}</desc>
    <text x="48" y="22" class="f-label">J(p)</text>
    {[0, 0.2, 0.4].map((r) => (
      <g>
        <path d={`M 48 ${sy(r)} H 328`} class="f-grid" />
        <text x="38" y={sy(r) + 4} text-anchor="end" class="f-small">{r.toFixed(1)}</text>
      </g>
    ))}
    <path d="M 48 44 V 224 H 328" class="f-axis" />
    {[0, 0.2, 0.4, 0.6, 0.8, 1].map((p) => (
      <g>
        <path d={`M ${sx(p)} 224 v 5`} class="f-axis" />
        <text x={sx(p)} y="247" text-anchor="middle" class="f-small">{p.toFixed(1)}</text>
      </g>
    ))}
    <text x="336" y="270" text-anchor="end" class="f-label">p</text>
    <path d={curve} class="f-line f-blue f-bold" />
    <circle cx={sx(0.4)} cy={sy(value(0.4))} r="4" fill="var(--fig-amber)" />
    <text x={sx(0.4) + 8} y={sy(value(0.4)) + 23} class="f-small f-t-amber">0.288</text>
    <circle cx={sx(2 / 3)} cy={sy(4 / 9)} r="4" class="f-solid-blue" />
    <text x="244" y="45" text-anchor="middle" class="f-small f-t-blue">p = 2/3, J = 4/9</text>
  </svg>
</Figure>

<style>
  .allocation-plot { display: block; width: 100%; max-width: 520px; height: auto; margin-inline: auto; }
</style>
