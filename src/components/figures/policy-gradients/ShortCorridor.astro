---
import Figure from '../Figure.astro';
import Curves from '../temporal-difference-learning/Curves.astro';
import { scale, plot } from '../geometry';
import { bins, mean, spread } from '../temporal-difference-learning/td';
import { corridorValue, pStar, reinforce } from './pg';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The short corridor: start, then a state in which left and right are swapped, then a state next to the goal; reward −1
// per step; every state looks the same, so a policy is one number p = P(right). Left: J(p) = −2(2 − p)/(p(1 − p)).
// Right: REINFORCE on the logit of p from p = 0.05, with +100 at the goal, 100 runs of 1000 episodes.
const Jstar = corridorValue(pStar);
const runs = [
  { key: 'small', alpha: 2 ** -11, base: false },
  { key: 'large', alpha: 2 ** -9, base: false },
  { key: 'base', alpha: 2 ** -9, base: true },
].map((r) => ({ ...r, steps: reinforce(r.alpha, r.base) }));
const at = (i: number, a: number, b: number) => mean(runs[i].steps, a, b);
const chk = [pStar, Jstar, corridorValue(0.95), corridorValue(0.05), at(0, 90, 110), at(1, 90, 110), at(2, 90, 110), at(0, 900, 1000), at(1, 900, 1000), at(2, 900, 1000)]
  .map((v) => v.toFixed(2)).join(' ');
if (chk !== '0.59 -11.66 -44.21 -82.11 26.50 19.37 13.45 13.52 19.03 11.67') throw new Error(`ShortCorridor: numbers drifted from the note (${chk})`);

const cls = ['f-line f-amber', 'f-line f-red', 'f-line f-blue f-bold'];
const tcls = ['f-t-amber', 'f-t-red', 'f-t-blue'];
const t = ru
  ? { title: 'Короткий коридор: лучшая стратегия случайна', p: 'p = P(вправо)', J: 'J(p), ожидаемая отдача', eps: 'ε-жадная', opt: `оптимум p = 2 − √2`,
      ep: 'эпизоды', st: 'шагов за эпизод', names: ['без базы, α = 2⁻¹¹', 'без базы, α = 2⁻⁹', 'с базой, α = 2⁻⁹'], best: `оптимум ${(-Jstar).toFixed(2)}`,
      desc: `Слева кривая J(p) = −2(2 − p)/(p(1 − p)) для p от 0.02 до 0.98, с максимумом ${Jstar.toFixed(2)} при p = ${pStar.toFixed(3)}; точки ε-жадных стратегий: ${corridorValue(0.05).toFixed(1)} при p = 0.05 и ${corridorValue(0.95).toFixed(1)} при p = 0.95. Справа число шагов за эпизод при обучении REINFORCE: без базовой линии с малым шагом оно падает медленно, до ${at(0, 900, 1000).toFixed(1)}; без базовой линии с большим шагом застревает около ${at(1, 900, 1000).toFixed(0)}; с базовой линией и тем же большим шагом доходит до ${at(2, 900, 1000).toFixed(1)}, почти до оптимума ${(-Jstar).toFixed(2)}.` }
  : { title: 'The short corridor: the best policy is random', p: 'p = P(right)', J: 'J(p), expected return', eps: 'ε-greedy', opt: `optimum p = 2 − √2`,
      ep: 'episodes', st: 'steps per episode', names: ['no baseline, α = 2⁻¹¹', 'no baseline, α = 2⁻⁹', 'baseline, α = 2⁻⁹'], best: `optimum ${(-Jstar).toFixed(2)}`,
      desc: `Left: the curve J(p) = −2(2 − p)/(p(1 − p)) for p from 0.02 to 0.98, with its maximum ${Jstar.toFixed(2)} at p = ${pStar.toFixed(3)}; the ε-greedy policies are marked at ${corridorValue(0.05).toFixed(1)} for p = 0.05 and ${corridorValue(0.95).toFixed(1)} for p = 0.95. Right: steps per episode while REINFORCE learns. Without a baseline and with a small step it falls slowly, to ${at(0, 900, 1000).toFixed(1)}; without a baseline and with a large step it stalls near ${at(1, 900, 1000).toFixed(0)}; with a baseline and the same large step it reaches ${at(2, 900, 1000).toFixed(1)}, close to the optimum ${(-Jstar).toFixed(2)}.` };
const id = 'pg-short-corridor';
const caption = ru
  ? `Коридор из трёх состояний, награда −1 за шаг, во втором состоянии действия переставлены; все состояния выглядят одинаково, поэтому стратегия — одно число p. Слева: детерминированные стратегии (p = 0 или 1) никогда не доходят до цели, ε-жадные с ε = 0.1 тратят в среднем 82 или 44 шага, а лучшая стохастическая — ${(-Jstar).toFixed(2)}. Справа: REINFORCE для логита p, старт с p = 0.05, к награде у цели добавлено +100 (оптимальная стратегия от этого не меняется), среднее по 100 запускам и окнам из 10 эпизодов. С базовой линией w, обученной на средней отдаче (шаг 2⁻¹⁰), большой шаг работает; без неё прибавка 100 делает оценку градиента в шесть раз шумнее, и стратегия всё время дрожит вокруг оптимума.`
  : `A corridor of three states, reward −1 per step, with the actions swapped in the second state; all states look the same, so a policy is one number p. Left: deterministic policies (p = 0 or 1) never reach the goal, ε-greedy ones with ε = 0.1 need 82 or 44 steps on average, and the best stochastic policy ${(-Jstar).toFixed(2)}. Right: REINFORCE on the logit of p, starting from p = 0.05, with +100 added at the goal (which does not change the optimal policy), averaged over 100 runs and windows of 10 episodes. With a baseline w trained on the average return (step 2⁻¹⁰), the large step works; without one, the +100 makes the gradient estimate six times noisier, and the policy keeps jittering around the optimum.`;

const curves = runs.map((r) => bins(r.steps, 10));
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, a: { px: [64, 330] as [number, number], py: [40, 270] as [number, number] }, b: { px: [430, 610] as [number, number], py: [40, 270] as [number, number] }, legend: false },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 720, a: { px: [60, 340] as [number, number], py: [44, 264] as [number, number] }, b: { px: [60, 340] as [number, number], py: [372, 592] as [number, number] }, legend: true },
];
const dyJ: [number, number] = [-100, 0], dyS: [number, number] = [0, 80];
const minusFmt = (v: number) => (v < 0 ? `−${-v}` : '0');
// the two ε-greedy policies, labelled on the side away from the axis they are close to
const marks = [{ p: 0.05, dx: 8, anchor: 'start' }, { p: 0.95, dx: -8, anchor: 'end' }];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sxA = scale([0, 1], L.a.px), syA = scale(dyJ, [L.a.py[1], L.a.py[0]]);
    const syB = scale(dyS, [L.b.py[1], L.b.py[0]]);
    const ends = spread(curves.map((c) => syB(c.ys[c.ys.length - 1])), 16);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        <Curves px={L.a.px} py={L.a.py} dx={[0, 1]} dy={dyJ} xTicks={[0, 0.25, 0.5, 0.75, 1]} yTicks={[-100, -75, -50, -25, 0]}
          xFmt={(v: number) => String(v)} yFmt={minusFmt} xLabel={t.p} yLabel={t.J} yLabelAt={[L.a.px[0] - 44, L.a.py[0] - 20]} series={[]} />
        <path class="f-line f-blue" d={plot((p) => Math.max(-100, corridorValue(p)), 0.02, 0.98, sxA, syA, 240)} />
        {marks.map((mk) => (
          <g>
            <circle cx={sxA(mk.p)} cy={syA(corridorValue(mk.p))} r="4" class="f-solid-red" />
            <text class="f-small f-t-red f-halo" x={sxA(mk.p) + mk.dx} y={syA(corridorValue(mk.p)) + 4} text-anchor={mk.anchor}>{`${t.eps}: ${corridorValue(mk.p).toFixed(1)}`}</text>
          </g>
        ))}
        <circle cx={sxA(pStar)} cy={syA(Jstar)} r="4.5" class="f-solid-blue" />
        <text class="f-small f-t-blue f-halo" x={sxA(pStar)} y={syA(Jstar) - 10} text-anchor="middle">{`${t.opt}: ${Jstar.toFixed(2)}`}</text>
        <Curves px={L.b.px} py={L.b.py} dx={[0, 1000]} dy={dyS} xTicks={[0, 500, 1000]} yTicks={[0, 20, 40, 60, 80]}
          xLabel={t.ep} yLabel={t.st} yLabelAt={[L.b.px[0] - 40, L.b.py[0] - 20]} series={curves.map((c, i) => ({ xs: c.xs, ys: c.ys, cls: cls[i] }))} />
        <path class="f-line f-muted f-dash" d={`M ${L.b.px[0]} ${syB(-Jstar)} H ${L.b.px[1]}`} style="stroke-width: 1.1" />
        <text class="f-small f-t-muted f-halo" x={L.b.px[1] - 4} y={syB(-Jstar) + 16} text-anchor="end">{t.best}</text>
        {!L.legend && curves.map((_, i) => <text class={`f-small ${tcls[i]}`} x={L.b.px[1] + 8} y={ends[i] + 4}>{t.names[i]}</text>)}
        {L.legend && t.names.map((name, i) => (
          <g>
            <path class={cls[i]} d={`M 16 ${652 + i * 24 - 5} h 24`} />
            <text class={`f-small ${tcls[i]}`} x={48} y={652 + i * 24}>{name}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
