---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { gae } from './pg';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One iteration of an actor-critic method with GAE, on the three-step example of the note:
// rewards 0, 0, 1, then the end; critic values 0.5, 0.6, 0.8; γ = 0.9, λ = 0.5.
const { delta, adv } = gae([0, 0, 1], [0.5, 0.6, 0.8, 0], 0.9, 0.5);
const f2 = (v: number) => v.toFixed(2);
if (delta.map(f2).join(' ') !== '0.04 0.12 0.20' || adv.map((v) => v.toFixed(4)).join(' ') !== '0.1345 0.2100 0.2000') throw new Error('ActorCriticLoop: the worked example drifted');

const t = ru
  ? {
      title: 'Одна итерация метода «актор–критик» с GAE и PPO',
      actor: 'актор π_θ', actorSub: 'стохастическая стратегия', env: 'среда', envSub: 'a ~ π(· | s)',
      batch: 'батч траекторий', batchSub: 'награды 0, 0, 1; старые log-вероятности',
      critic: 'критик V_w', criticSub: 'V = 0.50, 0.60, 0.80, затем 0',
      td: 'ошибки TD δ_t', tdSub: `γ = 0.9: ${delta.map(f2).join(', ')}`,
      gae: 'преимущества Â_t', gaeSub: `λ = 0.5: ${adv.map(f2).join(', ')}`,
      upd: 'шаг актора', updSub: 'обрезанная цель, K эпох', fit: 'регрессия V на Â + V',
      steps: ['действие: актор выбирает a_t из π_θ(· | s_t), среда отвечает', 'батч: траектории с наградами и log-вероятностями старой стратегии', `критик: V_w оценивает состояния, δ_t = r_t + γV(s_t+1) − V(s_t) = ${delta.map(f2).join(', ')}`, `GAE: Â_t = δ_t + γλ Â_t+1, справа налево: ${adv.map(f2).join(', ')}`, 'актор: несколько эпох подъёма по обрезанной цели с этими Â_t, затем θ_old ← θ', 'критик: регрессия V_w на отдачи Â_t + V(s_t)'],
      desc: `Цикл из шести блоков. Актор π_θ выбирает действия в среде, получается батч траекторий с наградами 0, 0, 1. Критик V_w оценивает состояния значениями 0.5, 0.6, 0.8; отсюда ошибки TD ${delta.map(f2).join(', ')} и преимущества GAE ${adv.map(f2).join(', ')} при γ = 0.9 и λ = 0.5. Преимущества идут в шаг актора по обрезанной цели, который обновляет π_θ, и в регрессию критика.`,
    }
  : {
      title: 'One iteration of actor-critic with GAE and PPO',
      actor: 'actor π_θ', actorSub: 'a stochastic policy', env: 'environment', envSub: 'a ~ π(· | s)',
      batch: 'batch of trajectories', batchSub: 'rewards 0, 0, 1; old log-probabilities',
      critic: 'critic V_w', criticSub: 'V = 0.50, 0.60, 0.80, then 0',
      td: 'TD errors δ_t', tdSub: `γ = 0.9: ${delta.map(f2).join(', ')}`,
      gae: 'advantages Â_t', gaeSub: `λ = 0.5: ${adv.map(f2).join(', ')}`,
      upd: 'actor step', updSub: 'clipped objective, K epochs', fit: 'regress V on Â + V',
      steps: ['act: the actor samples a_t from π_θ(· | s_t), the environment responds', 'batch: trajectories with their rewards and the old policy\'s log-probabilities', `critic: V_w evaluates the states, δ_t = r_t + γV(s_t+1) − V(s_t) = ${delta.map(f2).join(', ')}`, `GAE: Â_t = δ_t + γλ Â_t+1, from right to left: ${adv.map(f2).join(', ')}`, 'actor: a few epochs of ascent on the clipped objective with these Â_t, then θ_old ← θ', 'critic: regress V_w on the returns Â_t + V(s_t)'],
      desc: `A cycle of six blocks. The actor π_θ chooses actions in the environment, which yields a batch of trajectories with rewards 0, 0, 1. The critic V_w gives the states the values 0.5, 0.6, 0.8; from these come the TD errors ${delta.map(f2).join(', ')} and the GAE advantages ${adv.map(f2).join(', ')} with γ = 0.9 and λ = 0.5. The advantages feed the actor's step on the clipped objective, which updates π_θ, and the critic's regression.`,
    };
const id = 'pg-actor-critic-loop';
const caption = ru
  ? 'Актор — стратегия, которую оптимизируют; критик — функция ценности, которая нужна только для того, чтобы оценить преимущество каждого действия с меньшей дисперсией, чем полная отдача. Числа — пример из текста: три шага с наградами 0, 0, 1, γ = 0.9, λ = 0.5. Последнее преимущество равно последней ошибке TD, а каждое предыдущее добавляет к своей ошибке γλ = 0.45 от следующего преимущества.'
  : 'The actor is the policy being optimized; the critic is a value function whose only job is to estimate the advantage of each action with less variance than the full return. The numbers are the example of the text: three steps with rewards 0, 0, 1, γ = 0.9, λ = 0.5. The last advantage equals the last TD error, and each earlier one adds γλ = 0.45 times the next advantage to its own TD error.';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 290" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <Box x={16} y={40} w={190} h={50} label={t.actor} sub={t.actorSub} tone="y" />
    <g data-s="1">
      <Arrow pts={[[206, 65], [246, 65]]} tone="red" />
      <Box x={248} y={40} w={160} h={50} label={t.env} sub={t.envSub} />
      <Badge x={226} y={44} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[408, 65], [448, 65]]} tone="green" />
      <Box x={450} y={40} w={290} h={50} label={t.batch} sub={t.batchSub} tone="x" />
      <Badge x={428} y={44} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[595, 90], [595, 128]]} tone="green" />
      <Box x={450} y={130} w={290} h={50} label={t.critic} sub={t.criticSub} tone="h" />
      <Arrow pts={[[595, 180], [595, 208]]} />
      <Box x={450} y={210} w={290} h={50} label={t.td} sub={t.tdSub} tone="h" />
      <Badge x={614} y={109} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[450, 235], [410, 235]]} />
      <Box x={230} y={210} w={178} h={50} label={t.gae} sub={t.gaeSub} tone="g" />
      <Badge x={430} y={220} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[230, 235], [208, 235]]} />
      <Box x={16} y={210} w={190} h={50} label={t.upd} sub={t.updSub} tone="y" />
      <Arrow pts={[[111, 210], [111, 92]]} tone="red" />
      <Badge x={130} y={150} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[319, 210], [319, 155], [448, 155]]} tone="blue" dashed />
      <text class="f-small f-t-blue f-halo" x="327" y="146">{t.fit}</text>
      <Badge x={300} y={180} n={6} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 590" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <Box x={16} y={16} w={292} h={50} label={t.actor} sub={t.actorSub} tone="y" />
    <g data-s="1">
      <Arrow pts={[[162, 66], [162, 94]]} tone="red" />
      <Box x={16} y={96} w={292} h={50} label={t.env} sub={t.envSub} />
      <Badge x={184} y={80} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[162, 146], [162, 174]]} tone="green" />
      <Box x={16} y={176} w={292} h={50} label={t.batch} sub={t.batchSub} tone="x" />
      <Badge x={184} y={160} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[162, 226], [162, 254]]} tone="green" />
      <Box x={16} y={256} w={292} h={50} label={t.critic} sub={t.criticSub} tone="h" />
      <Arrow pts={[[162, 306], [162, 334]]} />
      <Box x={16} y={336} w={292} h={50} label={t.td} sub={t.tdSub} tone="h" />
      <Badge x={184} y={240} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[162, 386], [162, 414]]} />
      <Box x={16} y={416} w={292} h={50} label={t.gae} sub={t.gaeSub} tone="g" />
      <Badge x={184} y={400} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[162, 466], [162, 494]]} />
      <Box x={16} y={496} w={292} h={50} label={t.upd} sub={t.updSub} tone="y" />
      <Arrow pts={[[308, 521], [344, 521], [344, 41], [310, 41]]} tone="red" />
      <Badge x={344} y={200} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[308, 441], [326, 441], [326, 281], [310, 281]]} tone="blue" dashed />
      <Badge x={326} y={360} n={6} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
