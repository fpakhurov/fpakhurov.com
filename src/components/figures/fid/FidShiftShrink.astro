---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { fid2 } from './fid-math';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Real features: N(0, I). Generated: N((m, 0), s² I). Then FID = m² + 2(1 − s)².
const cases = [
  { name: (ru ? "совпадают" : "identical"), m: 0, s: 1 },
  { name: (ru ? "сдвиг" : "shifted"), m: 1.5, s: 1 },
  { name: (ru ? "сжатие" : "shrunk"), m: 0, s: 0.4 },
  { name: (ru ? "сдвиг + сжатие" : "shifted + shrunk"), m: 1.5, s: 0.4 },
].map((c) => {
  const r = fid2([0, 0], [[1, 0], [0, 1]], [c.m, 0], [[c.s * c.s, 0], [0, c.s * c.s]]);
  return { ...c, ...r };
});
const fmt = (v: number) => (Math.abs(v) < 1e-9 ? '0' : v.toFixed(2));

const xDom: [number, number] = [-2.3, 3.7];
const yDom: [number, number] = [-2.6, 2.6];
const panel = (ox: number, oy: number, w: number) => {
  const h = (w * (yDom[1] - yDom[0])) / (xDom[1] - xDom[0]);
  const sx = scale(xDom, [ox, ox + w]);
  const sy = scale(yDom, [oy + h, oy]);
  const u = w / (xDom[1] - xDom[0]);
  return { sx, sy, u, h, ox, oy, w };
};

// Wide: four panels in a row.
const wideW = 138;
const wideGap = 22;
const wide = cases.map((c, i) => ({ c, p: panel(14 + i * (wideW + wideGap), 34, wideW) }));
const wideH = wide[0].p.h;

// Narrow: 2 × 2 grid.
const narrowW = 150;
const narrow = cases.map((c, i) => ({ c, p: panel(14 + (i % 2) * (narrowW + 32), 34 + Math.floor(i / 2) * 252, narrowW) }));
const narrowH = narrow[0].p.h;
const panels = [
  { variant: 'wide', items: wide, h: wideH, width: 14 + 4 * wideW + 3 * wideGap + 14, height: 34 + wideH + 74 },
  { variant: 'narrow', items: narrow, h: narrowH, width: 360, height: 34 + 252 + narrowH + 74 },
];
---

<Figure
  id="fid-shift-shrink"
  title={ru ? "FID при сдвиге и сжатии сгенерированной гауссианы" : "FID as the generated Gaussian shifts and shrinks"}
  caption={ru ? "Настоящие признаки N(0, I) показаны красным, сгенерированные признаки N((m, 0), s²I) — синим (окружности 2σ). В двух измерениях FID = m² + 2(1 − s)²; здесь член ковариаций вдвое больше одномерного (1 − s)². Под каждой панелью напечатано: член средних (янтарный) + член ковариаций. Сдвиг меняет только член средних, более узкий (менее разнообразный) генератор — только член ковариаций, и два члена складываются." : "Real features N(0, I) in red, generated features N((m, 0), s²I) in blue (2σ circles). In two dimensions FID = m² + 2(1 − s)², twice the one-dimensional covariance term (1 − s)², printed under each panel as mean term (amber) + covariance term: a shift only moves the mean term, a narrower (less diverse) generator only moves the covariance term, and the two add up."}
>
  {panels.map((v) => (
    <svg class={`fig-${v.variant}`} viewBox={`0 0 ${v.width} ${v.height}`} role="img" aria-labelledby={`fid-shift-shrink-${v.variant}-t fid-shift-shrink-${v.variant}-d`}>
      <title id={`fid-shift-shrink-${v.variant}-t`}>{ru ? "Четыре случая FID между двумя изотропными гауссианами" : "Four cases of FID between two isotropic Gaussians"}</title>
      <desc id={`fid-shift-shrink-${v.variant}-d`}>{cases.map((c) => ru ? `${c.name}: сдвиг ${c.m}, масштаб ${c.s}, член средних ${fmt(c.mean)}, член ковариаций ${fmt(c.cov)}, FID ${fmt(c.fid)}.` : `${c.name}: shift ${c.m}, scale ${c.s}, mean term ${fmt(c.mean)}, covariance term ${fmt(c.cov)}, FID ${fmt(c.fid)}.`).join(' ')}</desc>
      {v.items.map(({ c, p }) => (
        <g>
          <text class="f-title" x={p.ox + p.w / 2} y={p.oy - 12} text-anchor="middle">{c.name}</text>
          <rect class="f-grid" x={p.ox} y={p.oy} width={p.w} height={p.h} style="fill: none" />
          <circle class="f-fill-red" cx={p.sx(0)} cy={p.sy(0)} r={2 * p.u} />
          <circle class="f-line f-red" cx={p.sx(0)} cy={p.sy(0)} r={2 * p.u} />
          <circle class="f-fill-blue" cx={p.sx(c.m)} cy={p.sy(0)} r={2 * c.s * p.u} />
          <circle class={`f-line f-blue${c.m === 0 && c.s === 1 ? ' f-dash' : ''}`} cx={p.sx(c.m)} cy={p.sy(0)} r={2 * c.s * p.u} />
          <circle class="f-solid-red" cx={p.sx(0)} cy={p.sy(0)} r="3.2" />
          <circle class="f-solid-blue" cx={p.sx(c.m)} cy={p.sy(0)} r="3.2" />
          <text class="f-small f-t-muted" x={p.ox + p.w / 2} y={p.oy + p.h + 20} text-anchor="middle">m = {c.m}, s = {c.s}</text>
          <text class="f-small" x={p.ox + p.w / 2} y={p.oy + p.h + 40} text-anchor="middle"><tspan style="fill: var(--fig-amber)">{fmt(c.mean)}</tspan> + {fmt(c.cov)}</text>
          <text class="f-title" x={p.ox + p.w / 2} y={p.oy + p.h + 62} text-anchor="middle">FID = {fmt(c.fid)}</text>
        </g>
      ))}
    </svg>
  ))}
</Figure>
