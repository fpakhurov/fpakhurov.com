---
import Figure from '../Figure.astro';
import { normals, polyline } from '../geometry';
import { arrowHead } from './fid-math';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A small stack of "pictures": three offset frames with a mountain-and-sun glyph on the front one.
const stack = (x: number, y: number, size: number) => {
  const frames = [2, 1, 0].map((i) => ({ x: x + i * 6, y: y - i * 6 }));
  const front = frames[2];
  const m = (fx: number, fy: number): [number, number] => [front.x + fx * size, front.y + fy * size];
  const mountain = polyline([m(0.08, 0.86), m(0.36, 0.48), m(0.55, 0.7), m(0.7, 0.54), m(0.92, 0.86)]);
  const sun = m(0.72, 0.28);
  return { frames, mountain, sun, size };
};

// Feature clouds: seeded standard normals, scaled and clipped to a disc.
const cloud = (cx: number, cy: number, radius: number, seed: number, stretch: [number, number], tilt: number) => {
  const z = normals(90, seed);
  const pts: [number, number][] = [];
  for (let i = 0; i + 1 < z.length; i += 2) {
    const a = z[i] * stretch[0];
    const b = z[i + 1] * stretch[1];
    const x = a * Math.cos(tilt) - b * Math.sin(tilt);
    const y = a * Math.sin(tilt) + b * Math.cos(tilt);
    if (Math.hypot(x, y) <= radius) pts.push([cx + x, cy + y]);
  }
  return pts;
};

// Wide layout (680 × 340)
const realW = stack(20, 64, 58);
const genW = stack(20, 204, 58);
const barsW = [
  { x: 158, h: 150 },
  { x: 180, h: 126 },
  { x: 202, h: 102 },
  { x: 224, h: 80 },
];
const barMidW = 160;
const realCloudW = cloud(398, 95, 40, 11, [16, 9], -0.5);
const genCloudW = cloud(398, 235, 40, 23, [11, 8], 0.3);

// Narrow layout (360 × 610)
const realN = stack(64, 38, 54);
const genN = stack(234, 38, 54);
const barsN = [
  { y: 184, w: 240 },
  { y: 200, w: 196 },
  { y: 216, w: 152 },
  { y: 232, w: 110 },
];
const realCloudN = cloud(95, 345, 34, 11, [14, 8], -0.5);
const genCloudN = cloud(265, 345, 34, 23, [10, 7], 0.3);
---

<Figure
  id="fid-pipeline"
  title={ru ? "Как вычисляется FID" : "How FID is computed"}
  caption={ru ? "Оба набора изображений проходят через одну и ту же замороженную сеть Inception. Активации берутся до классификационного выходного слоя с softmax (в стандартной реализации это 2048-мерный слой pool3), к каждому облаку признаков подгоняется гауссиана, и FID сравнивает две гауссианы." : "Both image sets go through the same frozen Inception network. The activations are taken before the softmax classification head (in the standard implementation, the 2048-dimensional pool3 layer), one Gaussian is fitted to each feature cloud, and FID compares the two Gaussians."}
>
  <svg class="fig-wide" viewBox="0 0 680 340" role="img" aria-labelledby="fid-pipeline-w-t fid-pipeline-w-d">
    <title id="fid-pipeline-w-t">{ru ? "Схема вычисления FID" : "FID pipeline"}</title>
    <desc id="fid-pipeline-w-d">{ru ? "Настоящие и сгенерированные изображения поступают в одну и ту же предобученную сеть Inception v3. Её слой pool3, расположенный до классификатора с softmax, даёт для каждого изображения 2048-мерный эмбеддинг; полносвязный выходной слой с softmax перечёркнут как неиспользуемый. Эмбеддинги настоящих изображений образуют красное облако точек, которое сводится к среднему mu r и ковариации Sigma r; эмбеддинги сгенерированных изображений образуют синее облако, которое сводится к mu g и Sigma g. Обе сводки поступают в FID: чем меньше значение, тем ближе распределения, а ноль означает равные средние и равные ковариации." : "Real images and generated images both enter one pretrained Inception v3 network. Its pool3 layer, before the softmax classifier, gives a 2048-dimensional embedding per image; the fully connected softmax head is crossed out as not used. The real embeddings form a red point cloud summarised by mean mu r and covariance Sigma r; the generated embeddings form a blue cloud summarised by mu g and Sigma g. Both summaries feed into FID, where lower means closer and zero means equal means and equal covariances."}</desc>

    <!-- image stacks -->
    {ru ? (
      <g>
        <text class="f-label f-t-red" x="55" y="24" text-anchor="middle">настоящие</text>
        <text class="f-label f-t-red" x="55" y="40" text-anchor="middle">изображения</text>
      </g>
    ) : (
      <text class="f-label f-t-red" x="55" y="40" text-anchor="middle">real images</text>
    )}
    {realW.frames.map((f) => <rect class="f-box" x={f.x} y={f.y} width={realW.size} height={realW.size} rx="3" />)}
    <rect class="f-fill-red" x={realW.frames[2].x} y={realW.frames[2].y} width={realW.size} height={realW.size} rx="3" />
    <path class="f-thin f-red" d={realW.mountain} />
    <circle class="f-thin f-red" cx={realW.sun[0]} cy={realW.sun[1]} r="5" />

    {genW.frames.map((f) => <rect class="f-box" x={f.x} y={f.y} width={genW.size} height={genW.size} rx="3" />)}
    <rect class="f-fill-blue" x={genW.frames[2].x} y={genW.frames[2].y} width={genW.size} height={genW.size} rx="3" />
    <path class="f-thin f-blue" d={genW.mountain} />
    <circle class="f-thin f-blue" cx={genW.sun[0]} cy={genW.sun[1]} r="5" />
    {ru ? (
      <g>
        <text class="f-label f-t-blue" x="55" y="292" text-anchor="middle">изображения</text>
        <text class="f-label f-t-blue" x="55" y="308" text-anchor="middle">генератора</text>
      </g>
    ) : (
      <text class="f-label f-t-blue" x="55" y="292" text-anchor="middle">generated images</text>
    )}

    <path class="f-line f-red" d="M 94 95 H 138" marker-end="url(#f-arrow-red)" />
    <path class="f-line f-blue" d="M 94 235 H 138" marker-end="url(#f-arrow-blue)" />

    <!-- network -->
    <rect class="f-box" x="140" y="40" width="160" height="240" rx="8" />
    <text class="f-title" x="220" y="64" text-anchor="middle">Inception v3</text>
    <text class="f-note" x="220" y="82" text-anchor="middle">{ru ? 'обучена и заморожена' : 'pretrained, frozen'}</text>
    {barsW.map((b) => <rect class="f-box-soft" x={b.x} y={barMidW - b.h / 2 + 6} width="14" height={b.h} rx="2" />)}
    {barsW.map((b) => <rect class="f-thin f-muted" x={b.x} y={barMidW - b.h / 2 + 6} width="14" height={b.h} rx="2" />)}
    <rect class="f-fill-amber" x="252" y={barMidW - 25 + 6} width="14" height="50" rx="2" />
    <rect class="f-line f-amber" x="252" y={barMidW - 25 + 6} width="14" height="50" rx="2" />
    <text class="f-small f-t-amber" x="248" y="228" text-anchor="end">pool3</text>

    <!-- unused classification head -->
    <path class="f-thin f-muted f-dash" d="M 268 166 H 318" marker-end="url(#f-arrow-muted)" />
    <rect class="f-line f-muted f-dash" x="320" y="151" width="100" height="30" rx="4" style="fill: var(--paper)" />
    <text class="f-note" x="370" y="171" text-anchor="middle">FC + softmax</text>
    <path class="f-line f-red" d="M 285 158 L 299 174 M 299 158 L 285 174" />

    <!-- embeddings out of pool3 -->
    <path class="f-line f-red" d="M 266 146 Q 300 98 350 95" marker-end="url(#f-arrow-red)" />
    <path class="f-line f-blue" d="M 266 186 Q 300 232 350 235" marker-end="url(#f-arrow-blue)" />

    <!-- feature clouds -->
    <text class="f-note" x="398" y="40" text-anchor="middle">{ru ? "настоящие признаки" : "real features"}</text>
    {realCloudW.map(([x, y]) => <circle class="f-solid-red" cx={x} cy={y} r="2.4" />)}
    {genCloudW.map(([x, y]) => <circle class="f-solid-blue" cx={x} cy={y} r="2.4" />)}
    <text class="f-note" x="398" y="292" text-anchor="middle">{ru ? "сгенерированные признаки" : "generated features"}</text>

    <path class="f-line f-red" d="M 440 95 H 460" marker-end="url(#f-arrow-red)" />
    <path class="f-line f-blue" d="M 440 235 H 460" marker-end="url(#f-arrow-blue)" />

    <!-- Gaussian summaries -->
    <text class="f-note" x="505" y="60" text-anchor="middle">{ru ? "подгонка гауссианы" : "fit a Gaussian"}</text>
    <rect class="f-box" x="462" y="72" width="86" height="46" rx="5" />
    <text class="f-math f-t-red" x="505" y="101" text-anchor="middle">μ<tspan dy="5" font-size="13">r</tspan><tspan dy="-5">, Σ</tspan><tspan dy="5" font-size="13">r</tspan></text>
    <rect class="f-box" x="462" y="212" width="86" height="46" rx="5" />
    <text class="f-math f-t-blue" x="505" y="241" text-anchor="middle">μ<tspan dy="5" font-size="13">g</tspan><tspan dy="-5">, Σ</tspan><tspan dy="5" font-size="13">g</tspan></text>

    <path class="f-line" d="M 550 95 Q 610 98 619 136" marker-end="url(#f-arrow)" />
    <path class="f-line" d="M 550 235 Q 610 232 619 194" marker-end="url(#f-arrow)" />
    <rect class="f-box" x="582" y="140" width="80" height="50" rx="6" />
    <text class="f-title" x="622" y="171" text-anchor="middle">FID</text>
    <text class="f-note" x="622" y="262" text-anchor="middle">{ru ? "меньше = ближе" : "lower = closer"}</text>
    <text class="f-note" x="622" y="280" text-anchor="middle">{ru ? "0 = равные μ, Σ" : "0 = same μ, Σ"}</text>

    <!-- where the embeddings are taken -->
    <text class="f-label f-t-amber" x="340" y="326" text-anchor="middle">{ru ? "эмбеддинги берём здесь: до softmax" : "take embeddings here: before softmax"}</text>
    <path class="f-line f-amber" d="M 262 308 Q 268 262 260 208" />
    <path d={arrowHead(259.6, 206, 259, 194, 11)} style="fill: var(--fig-amber)" />
  </svg>

  <svg class="fig-narrow" viewBox="0 0 360 610" role="img" aria-labelledby="fid-pipeline-n-t fid-pipeline-n-d">
    <title id="fid-pipeline-n-t">{ru ? "Схема вычисления FID (вертикальная)" : "FID pipeline (stacked)"}</title>
    <desc id="fid-pipeline-n-d">{ru ? "Настоящие и сгенерированные изображения поступают в одну и ту же предобученную сеть Inception v3. Её слой pool3, расположенный до классификатора с softmax, даёт для каждого изображения 2048-мерный эмбеддинг; полносвязный выходной слой с softmax перечёркнут как неиспользуемый. Эмбеддинги настоящих изображений образуют красное облако точек, которое сводится к mu r и Sigma r; эмбеддинги сгенерированных изображений образуют синее облако, которое сводится к mu g и Sigma g. Обе сводки поступают в FID: чем меньше значение, тем ближе распределения, а ноль означает равные средние и равные ковариации." : "Real images and generated images both enter one pretrained Inception v3 network. Its pool3 layer, before the softmax classifier, gives a 2048-dimensional embedding per image; the fully connected softmax head is crossed out as not used. The real embeddings form a red point cloud summarised by mu r and Sigma r; the generated embeddings form a blue cloud summarised by mu g and Sigma g. Both feed into FID, where lower means closer and zero means equal means and equal covariances."}</desc>

    <text class="f-label f-t-red" x="95" y="18" text-anchor="middle">{ru ? "настоящие" : "real images"}</text>
    <text class="f-label f-t-blue" x="265" y="18" text-anchor="middle">{ru ? "сгенерированные" : "generated images"}</text>
    {realN.frames.map((f) => <rect class="f-box" x={f.x} y={f.y} width={realN.size} height={realN.size} rx="3" />)}
    <rect class="f-fill-red" x={realN.frames[2].x} y={realN.frames[2].y} width={realN.size} height={realN.size} rx="3" />
    <path class="f-thin f-red" d={realN.mountain} />
    <circle class="f-thin f-red" cx={realN.sun[0]} cy={realN.sun[1]} r="5" />
    {genN.frames.map((f) => <rect class="f-box" x={f.x} y={f.y} width={genN.size} height={genN.size} rx="3" />)}
    <rect class="f-fill-blue" x={genN.frames[2].x} y={genN.frames[2].y} width={genN.size} height={genN.size} rx="3" />
    <path class="f-thin f-blue" d={genN.mountain} />
    <circle class="f-thin f-blue" cx={genN.sun[0]} cy={genN.sun[1]} r="5" />

    <path class="f-line f-red" d="M 91 98 V 128" marker-end="url(#f-arrow-red)" />
    <path class="f-line f-blue" d="M 261 98 V 128" marker-end="url(#f-arrow-blue)" />

    <rect class="f-box" x="30" y="130" width="300" height="140" rx="8" />
    <text class="f-title" x="180" y="154" text-anchor="middle">Inception v3</text>
    <text class="f-note" x="180" y="172" text-anchor="middle">{ru ? "предобученная, замороженная" : "pretrained, frozen"}</text>
    {barsN.map((b) => <rect class="f-box-soft" x={160 - b.w / 2} y={b.y - 4} width={b.w} height="10" rx="2" />)}
    {barsN.map((b) => <rect class="f-thin f-muted" x={160 - b.w / 2} y={b.y - 4} width={b.w} height="10" rx="2" />)}
    <rect class="f-fill-amber" x="125" y="244" width="70" height="12" rx="2" />
    <rect class="f-line f-amber" x="125" y="244" width="70" height="12" rx="2" />
    <text class="f-small f-t-amber" x="118" y="255" text-anchor="end">pool3</text>
    <path class="f-thin f-muted f-dash" d="M 197 250 H 230" marker-end="url(#f-arrow-muted)" />
    <rect class="f-line f-muted f-dash" x="232" y="238" width="90" height="24" rx="4" style="fill: var(--paper)" />
    <text class="f-small f-t-muted" x="277" y="254" text-anchor="middle">FC + softmax</text>
    <path class="f-line f-red" d="M 207 243 L 219 257 M 219 243 L 207 257" />

    <path class="f-line f-red" d="M 145 258 Q 100 280 95 306" marker-end="url(#f-arrow-red)" />
    <path class="f-line f-blue" d="M 175 258 Q 255 280 263 306" marker-end="url(#f-arrow-blue)" />
    <text class="f-small f-t-amber" x="180" y="300" text-anchor="middle">{ru ? "эмбеддинги" : "embeddings"}</text>
    <text class="f-small f-t-amber" x="180" y="316" text-anchor="middle">{ru ? "до softmax" : "before softmax"}</text>

    {realCloudN.map(([x, y]) => <circle class="f-solid-red" cx={x} cy={y} r="2.2" />)}
    {genCloudN.map(([x, y]) => <circle class="f-solid-blue" cx={x} cy={y} r="2.2" />)}
    <text class="f-note" x="180" y="350" text-anchor="middle">{ru ? 'признаки' : 'features'}</text>

    <path class="f-line f-red" d="M 95 384 V 414" marker-end="url(#f-arrow-red)" />
    <path class="f-line f-blue" d="M 265 384 V 414" marker-end="url(#f-arrow-blue)" />
    <text class="f-note" x="180" y="404" text-anchor="middle">{ru ? "подгонка гауссианы" : "fit a Gaussian"}</text>
    <rect class="f-box" x="52" y="416" width="86" height="44" rx="5" />
    <text class="f-math f-t-red" x="95" y="444" text-anchor="middle">μ<tspan dy="5" font-size="13">r</tspan><tspan dy="-5">, Σ</tspan><tspan dy="5" font-size="13">r</tspan></text>
    <rect class="f-box" x="222" y="416" width="86" height="44" rx="5" />
    <text class="f-math f-t-blue" x="265" y="444" text-anchor="middle">μ<tspan dy="5" font-size="13">g</tspan><tspan dy="-5">, Σ</tspan><tspan dy="5" font-size="13">g</tspan></text>

    <path class="f-line" d="M 95 462 Q 100 498 136 514" marker-end="url(#f-arrow)" />
    <path class="f-line" d="M 265 462 Q 260 498 224 514" marker-end="url(#f-arrow)" />
    <rect class="f-box" x="140" y="500" width="80" height="46" rx="6" />
    <text class="f-title" x="180" y="529" text-anchor="middle">FID</text>
    <text class="f-note" x="180" y="574" text-anchor="middle">{ru ? "меньше = ближе" : "lower = closer"}</text>
    <text class="f-note" x="180" y="594" text-anchor="middle">{ru ? "0 = равные μ и Σ" : "0 = same μ and Σ"}</text>
  </svg>
</Figure>
