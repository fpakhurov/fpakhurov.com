---
import Figure from '../Figure.astro';
import { normals, polyline, scale, curve } from '../geometry';
import { fid2, ellipse, chol, arrowHead } from './fid-math';

// Feature distributions of the example (2-D stand-in for 2048-D Inception features).
const muR: [number, number] = [0, 0];
const SigR: [[number, number], [number, number]] = [[1.0, 0.6], [0.6, 0.8]];
const muG: [number, number] = [1.2, 0.6];
const SigG: [[number, number], [number, number]] = [[0.45, -0.1], [-0.1, 0.35]];
const res = fid2(muR, SigR, muG, SigG);
const f2 = (v: number) => v.toFixed(2);
const f3 = (v: number) => v.toFixed(3);

// Plot area, equal aspect ratio. The narrow variant uses a smaller unit so that its
// viewBox is 360 wide like the other narrow figures and the text stays legible.
const xDom: [number, number] = [-2.6, 3.4];
const yDom: [number, number] = [-2.3, 2.5];
const top = 34;

const sample = (mu: [number, number], S: typeof SigR, n: number, seed: number) => {
  const L = chol(S);
  const z = normals(2 * n, seed);
  const pts: [number, number][] = [];
  for (let i = 0; i < n; i += 1) {
    const a = z[2 * i];
    const b = z[2 * i + 1];
    const x = mu[0] + L[0][0] * a;
    const y = mu[1] + L[1][0] * a + L[1][1] * b;
    if (x > xDom[0] + 0.05 && x < xDom[1] - 0.05 && y > yDom[0] + 0.05 && y < yDom[1] - 0.05) pts.push([x, y]);
  }
  return pts;
};
const realData = sample(muR, SigR, 140, 5);
const genData = sample(muG, SigG, 140, 17);

// Points on the ellipse outlines for the covariance callout (lower boundary).
const eR = ellipse(muR, SigR, 2, 360);
const eG = ellipse(muG, SigG, 2, 360);
const lowest = (pts: [number, number][], xMin: number) =>
  pts.filter(([x]) => x >= xMin).reduce((best, p) => (p[1] < best[1] ? p : best));
const tR = lowest(eR, 0.3);
const tG = lowest(eG, 1.6);

const geom = (unit: number, left: number, covX: number, genX: number) => {
  const right = left + unit * (xDom[1] - xDom[0]);
  const bottom = top + unit * (yDom[1] - yDom[0]);
  const sx = scale(xDom, [left, right]);
  const sy = scale(yDom, [bottom, top]);
  const toScreen = (pts: [number, number][]) => polyline(pts.map(([x, y]) => [sx(x), sy(y)] as [number, number])) + ' Z';
  const pR = [sx(muR[0]), sy(muR[1])];
  const pG = [sx(muG[0]), sy(muG[1])];
  // Arrow for mu_r - mu_g: from the generated mean to the real mean, stopping short of the dot.
  const dLen = Math.hypot(pR[0] - pG[0], pR[1] - pG[1]);
  const tip = [pR[0] + ((pG[0] - pR[0]) / dLen) * 7, pR[1] + ((pG[1] - pR[1]) / dLen) * 7];
  return {
    left, right, bottom, sx, sy, pR, pG,
    realPts: realData.map(([x, y]) => [sx(x), sy(y)]),
    genPts: genData.map(([x, y]) => [sx(x), sy(y)]),
    ellR: toScreen(ellipse(muR, SigR, 2)),
    ellG: toScreen(ellipse(muG, SigG, 2)),
    meanHead: arrowHead(pG[0], pG[1], tip[0], tip[1], 13),
    meanTail: [pR[0] + ((pG[0] - pR[0]) / dLen) * 16, pR[1] + ((pG[1] - pR[1]) / dLen) * 16],
    hookR: [sx(tR[0]), sy(tR[1])],
    hookG: [sx(tG[0]), sy(tG[1])],
    covLabel: { x: sx(covX), y: bottom - 24 },
    genX: sx(genX),
  };
};
const gw = geom(68, 24, 1.84, 2.1);
const gn = geom(56, 12, 1.25, 1.8);
const panelX = gw.right + 22;
const nY = gn.bottom + 16;

const desc = `A red cloud of real features centred at the origin, tilted, and a smaller, rounder blue cloud of generated features centred at (1.2, 0.6). An amber arrow between the two means is labelled squared norm of mu r minus mu g, equal to ${f2(res.mean)}. A callout pointing at both ellipse outlines is labelled covariance term, the trace, equal to ${f3(res.cov)}. A summary panel adds them: FID equals ${f3(res.fid)}.`;
const variants = [
  { name: 'wide', g: gw, w: panelX + 194, h: gw.bottom + 20 },
  { name: 'narrow', g: gn, w: gn.right + 12, h: nY + 202 },
];
---

<Figure
  id="fid-two-gaussians"
  title="The two terms of FID on a 2-D example"
  caption={`Seeded samples (140 drawn from each Gaussian; the few outside the frame are not shown), with 2σ ellipses. The mean term measures how far apart the clouds sit; the covariance term measures how differently they are spread and oriented. Numbers use the true parameters: real mean (0, 0) and covariance [[1, 0.6], [0.6, 0.8]]; generated mean (1.2, 0.6) and covariance [[0.45, −0.1], [−0.1, 0.35]].`}
>
  {variants.map(({ name, g, w, h }) => (
  <svg class={`fig-${name}`} viewBox={`0 0 ${w} ${h}`} role="img" aria-labelledby={`fid-two-gaussians-${name}-t fid-two-gaussians-${name}-d`}>
    <title id={`fid-two-gaussians-${name}-t`}>Real and generated feature clouds with their FID terms</title>
    <desc id={`fid-two-gaussians-${name}-d`}>{desc}</desc>

    <rect class="f-grid" x={g.left} y={top} width={g.right - g.left} height={g.bottom - top} style="fill: none" />
    <line class="f-grid" x1={g.sx(0)} x2={g.sx(0)} y1={top} y2={g.bottom} />
    <line class="f-grid" x1={g.left} x2={g.right} y1={g.sy(0)} y2={g.sy(0)} />
    <text class="f-note" x={g.right - 6} y={top - 10} text-anchor="end">2 of the 2048 feature dimensions</text>

    {g.realPts.map(([x, y]) => <circle class="f-solid-red" cx={x} cy={y} r="2.3" opacity="0.55" />)}
    {g.genPts.map(([x, y]) => <circle class="f-solid-blue" cx={x} cy={y} r="2.3" opacity="0.6" />)}
    <path class="f-fill-red" d={g.ellR} />
    <path class="f-line f-red" d={g.ellR} />
    <path class="f-fill-blue" d={g.ellG} />
    <path class="f-line f-blue" d={g.ellG} />

    <text class="f-label f-t-red f-halo" x={g.sx(-2.4)} y={g.sy(2.15)}>real, 𝒩(μ<tspan dy="5" font-size="12">r</tspan><tspan dy="-5">, Σ</tspan><tspan dy="5" font-size="12">r</tspan><tspan dy="-5">)</tspan></text>
    <text class="f-label f-t-blue f-halo" x={g.genX} y={g.sy(2.25)}>generated,</text>
    <text class="f-label f-t-blue f-halo" x={g.genX} y={g.sy(2.25) + 19}>𝒩(μ<tspan dy="5" font-size="12">g</tspan><tspan dy="-5">, Σ</tspan><tspan dy="5" font-size="12">g</tspan><tspan dy="-5">)</tspan></text>

    <!-- mean difference -->
    <path class="f-line f-amber f-bold" d={`M ${g.pG[0]} ${g.pG[1]} L ${g.meanTail[0]} ${g.meanTail[1]}`} />
    <path d={g.meanHead} style="fill: var(--fig-amber)" />
    <circle class="f-solid-red" cx={g.pR[0]} cy={g.pR[1]} r="4.5" />
    <circle class="f-solid-blue" cx={g.pG[0]} cy={g.pG[1]} r="4.5" />
    <text class="f-math f-t-amber f-halo" x={g.sx(-2.45)} y={g.sy(1.5)}><tspan font-style="normal">‖</tspan>μ<tspan dy="5" font-size="13">r</tspan><tspan dy="-5"> − μ</tspan><tspan dy="5" font-size="13">g</tspan><tspan dy="-5" dx="2" font-style="normal">‖² = {f2(res.mean)}</tspan></text>
    <path class="f-thin" d={curve(g.sx(-1.3), g.sy(1.32), g.sx(0.5), g.sy(0.36), 26)} marker-end="url(#f-arrow)" />

    <!-- covariance callout -->
    <text class="f-label f-halo" x={g.covLabel.x} y={g.covLabel.y} text-anchor="middle">covariance term Tr(…) = {f3(res.cov)}</text>
    <path class="f-thin" d={curve(g.covLabel.x - 70, g.covLabel.y - 16, g.hookR[0] + 2, g.hookR[1] + 6, -28)} marker-end="url(#f-arrow)" />
    <path class="f-thin" d={curve(g.covLabel.x + 30, g.covLabel.y - 16, g.hookG[0], g.hookG[1] + 6, 20)} marker-end="url(#f-arrow)" />
    <text class="f-note" x={g.covLabel.x} y={g.covLabel.y + 17} text-anchor="middle">different spread and tilt</text>

    {name === 'wide' ? (
    <g>
    <!-- numeric readout -->
    <rect class="f-box-soft" x={panelX} y={top} width="184" height="196" rx="6" />
    <text class="f-title" x={panelX + 14} y={top + 26}>This example</text>
    <text class="f-note" x={panelX + 14} y={top + 52}>mean term</text>
    <text class="f-label f-t-amber" x={panelX + 170} y={top + 52} text-anchor="end">{f3(res.mean)}</text>
    <text class="f-note" x={panelX + 14} y={top + 76}>Tr Σ<tspan dy="4" font-size="11">r</tspan></text>
    <text class="f-label" x={panelX + 170} y={top + 76} text-anchor="end">{f3(res.trR)}</text>
    <text class="f-note" x={panelX + 14} y={top + 98}>Tr Σ<tspan dy="4" font-size="11">g</tspan></text>
    <text class="f-label" x={panelX + 170} y={top + 98} text-anchor="end">{f3(res.trG)}</text>
    <text class="f-note" x={panelX + 14} y={top + 120}>−2 Tr[(Σ<tspan dy="4" font-size="11">r</tspan><tspan dy="-4">Σ</tspan><tspan dy="4" font-size="11">g</tspan><tspan dy="-4">)</tspan><tspan dy="-6" font-size="10">½</tspan><tspan dy="6">]</tspan></text>
    <text class="f-label" x={panelX + 170} y={top + 120} text-anchor="end">−{f3(2 * res.trSqrt)}</text>
    <line class="f-thin f-muted" x1={panelX + 14} x2={panelX + 170} y1={top + 132} y2={top + 132} />
    <text class="f-note" x={panelX + 14} y={top + 152}>cov. term</text>
    <text class="f-label" x={panelX + 170} y={top + 152} text-anchor="end">{f3(res.cov)}</text>
    <text class="f-title" x={panelX + 14} y={top + 182}>FID</text>
    <text class="f-title" x={panelX + 170} y={top + 182} text-anchor="end">{f3(res.fid)}</text>
    </g>
    ) : (
    <g>
      <!-- numeric readout, one column below the plot -->
      <rect class="f-box-soft" x={g.left} y={nY} width={g.right - g.left} height="190" rx="6" />
      <text class="f-title" x={g.left + 14} y={nY + 26}>This example</text>
      <text class="f-note" x={g.left + 14} y={nY + 52}>mean term</text>
      <text class="f-label f-t-amber" x={g.right - 14} y={nY + 52} text-anchor="end">{f3(res.mean)}</text>
      <text class="f-note" x={g.left + 14} y={nY + 74}>Tr Σ<tspan dy="4" font-size="12">r</tspan></text>
      <text class="f-label" x={g.right - 14} y={nY + 74} text-anchor="end">{f3(res.trR)}</text>
      <text class="f-note" x={g.left + 14} y={nY + 96}>Tr Σ<tspan dy="4" font-size="12">g</tspan></text>
      <text class="f-label" x={g.right - 14} y={nY + 96} text-anchor="end">{f3(res.trG)}</text>
      <text class="f-note" x={g.left + 14} y={nY + 118}>−2 Tr[(Σ<tspan dy="4" font-size="12">r</tspan><tspan dy="-4">Σ</tspan><tspan dy="4" font-size="12">g</tspan><tspan dy="-4">)</tspan><tspan dy="-6" font-size="12">½</tspan><tspan dy="6">]</tspan></text>
      <text class="f-label" x={g.right - 14} y={nY + 118} text-anchor="end">−{f3(2 * res.trSqrt)}</text>
      <line class="f-thin f-muted" x1={g.left + 14} x2={g.right - 14} y1={nY + 130} y2={nY + 130} />
      <text class="f-note" x={g.left + 14} y={nY + 150}>covariance term</text>
      <text class="f-label" x={g.right - 14} y={nY + 150} text-anchor="end">{f3(res.cov)}</text>
      <text class="f-title" x={g.left + 14} y={nY + 176}>FID</text>
      <text class="f-title" x={g.right - 14} y={nY + 176} text-anchor="end">{f3(res.fid)}</text>
    </g>
    )}
  </svg>
  ))}
</Figure>
