---
import Figure from '../Figure.astro';

interface Props {
  id: string;
  title: string;
  caption: string;
  desc: string;
  stages: { label: string; value: string }[];
}
const { id, title, caption, desc, stages } = Astro.props;
const rowHeight = 78;
const height = stages.length * rowHeight - 8;
---
<Figure {id} {title} {caption}>
  <svg viewBox={`0 0 360 ${height}`} role="img" aria-labelledby={`${id}-title ${id}-desc`} style="max-width: 560px; margin-inline: auto">
    <title id={`${id}-title`}>{title}</title>
    <desc id={`${id}-desc`}>{desc}</desc>
    {stages.map(({ label, value }, i) => (
      <g transform={`translate(0 ${i * rowHeight})`}>
        <text class="f-label" x="180" y="18" text-anchor="middle">{label}</text>
        <rect class={i === stages.length - 1 ? 'f-fill-green' : 'f-fill-blue'} x="18" y="27" width="324" height="37" rx="8" />
        <text class="f-label" x="180" y="50" text-anchor="middle">{value}</text>
        {i < stages.length - 1 && <path class="f-line" d="M 180 67 V 78 M 176 74 L 180 78 L 184 74" />}
      </g>
    ))}
  </svg>
</Figure>
