---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// How a Deployment of 3 replicas becomes running containers. Every component talks only to the API server:
// controllers and kubelets watch objects there and write their results back, and only the API server reads and
// writes etcd. Two nodes; the scheduler puts two Pods on node 1 and one on node 2.
const replicas = 3, onNode1 = 2, onNode2 = 1;
if (onNode1 + onNode2 !== replicas) throw new Error('pods per node do not add up');
const t = ru
  ? {
      title: 'Цикл согласования: как Deployment превращается в работающие контейнеры',
      kubectl: 'kubectl apply', kubectlSub: 'web.yaml', api: 'API-сервер', apiSub: 'проверяет, хранит',
      etcd: 'etcd', etcdSub: 'все объекты',
      dc: 'контроллер Deployment', dcSub: 'создаёт ReplicaSet',
      rc: 'контроллер ReplicaSet', rcSub: `создаёт ${replicas} пода`,
      sch: 'планировщик', schSub: 'назначает поды узлам',
      n1: 'узел 1: kubelet', n1Sub: `запускает ${onNode1} пода`, n2: 'узел 2: kubelet', n2Sub: `запускает ${onNode2} под`,
      store: 'хранение', watch: 'наблюдение', status: 'статус',
      loop: 'каждый компонент повторяет: наблюдать → сравнить → действовать',
      loopN: 'наблюдать → сравнить → действовать',
      steps: [
        'kubectl отправляет Deployment API-серверу; тот проверяет объект и сохраняет его в etcd',
        'контроллер Deployment видит Deployment без ReplicaSet и создаёт ReplicaSet',
        `контроллер ReplicaSet видит 0 подов из ${replicas} и создаёт ${replicas} пода без узла`,
        'планировщик видит поды без узла, выбирает узел для каждого и записывает привязку',
        'kubelet каждого узла видит свои поды и просит среду выполнения контейнеров запустить их',
        'агенты kubelet сообщают статус; все контроллеры снова сравнивают статус с желаемым, и цикл продолжается',
      ],
      desc: `В центре API-сервер, рядом с ним etcd. Слева kubectl apply отправляет файл. Контроллер Deployment создаёт ReplicaSet, контроллер ReplicaSet создаёт ${replicas} пода, планировщик назначает их узлам. Внизу два узла: kubelet узла 1 запускает ${onNode1} пода, kubelet узла 2 — ${onNode2}. Все стрелки идут к API-серверу или от него: компоненты не обращаются друг к другу напрямую. kubelet возвращает статус, и контроллеры снова сравнивают его с желаемым.`,
    }
  : {
      title: 'The reconciliation loop: how a Deployment becomes running containers',
      kubectl: 'kubectl apply', kubectlSub: 'web.yaml', api: 'API server', apiSub: 'validates, stores',
      etcd: 'etcd', etcdSub: 'every object',
      dc: 'Deployment controller', dcSub: 'creates a ReplicaSet',
      rc: 'ReplicaSet controller', rcSub: `creates ${replicas} Pods`,
      sch: 'scheduler', schSub: 'binds Pods to nodes',
      n1: 'node 1: kubelet', n1Sub: `starts ${onNode1} Pods`, n2: 'node 2: kubelet', n2Sub: `starts ${onNode2} Pod`,
      store: 'store', watch: 'watch', status: 'status',
      loop: 'every component repeats: observe → compare → act',
      loopN: 'observe → compare → act',
      steps: [
        'kubectl sends the Deployment to the API server, which validates it and stores it in etcd',
        'the Deployment controller sees a Deployment without a ReplicaSet and creates one',
        `the ReplicaSet controller sees 0 of ${replicas} Pods and creates ${replicas} Pods with no node`,
        'the scheduler sees Pods without a node, picks a node for each and writes the binding',
        'the kubelet of each node sees its Pods and asks the container runtime to start them',
        'the kubelets report status; every controller compares status with spec again, and the loop goes on',
      ],
      desc: `In the middle the API server, beside it etcd. On the left, kubectl apply sends a file. The Deployment controller creates a ReplicaSet, the ReplicaSet controller creates ${replicas} Pods, and the scheduler binds them to nodes. At the bottom two nodes: the kubelet of node 1 starts ${onNode1} Pods, the kubelet of node 2 starts ${onNode2}. Every arrow goes to or from the API server: no component calls another directly. The kubelets report status, and the controllers compare it with the desired state again.`,
    };
// The Russian labels use «2 пода», «3 пода» and «1 под»; check that the counts still match those forms.
if (onNode1 !== 2 || onNode2 !== 1 || replicas !== 3) throw new Error('Russian plurals assume 3 = 2 + 1');
// Label widths: f-label about 7.5 px per character (8.0 narrow), f-small 6.5 (7.3).
const fits = (s: string, room: number, px: number) => {
  if (s.length * px > room) throw new Error(`"${s}" needs ${Math.round(s.length * px)} px, has ${room}`);
};
for (const s of [t.dc, t.rc]) { fits(s, 200, 7.5); fits(s, 236, 8.0); }
for (const s of [t.dcSub, t.rcSub, t.schSub, t.n1Sub, t.n2Sub, t.apiSub]) { fits(s, 180, 6.5); fits(s, 236, 7.3); }
for (const s of [t.sch, t.n1, t.n2, t.kubectl, t.etcd]) { fits(s, 170, 7.5); fits(s, 236, 8.0); }
fits(t.loop, 760 - 32, 6.5); fits(t.loopN, 340, 7.3);
const id = 'reconcile-loop';
const caption = ru
  ? `Никто не отдаёт команду «запусти ${replicas} контейнера». kubectl только сохраняет желаемое состояние (1), а дальше каждый компонент наблюдает за своими объектами в API-сервере и дописывает туда результат: контроллер Deployment создаёт ReplicaSet (2), контроллер ReplicaSet — поды (3), планировщик назначает им узлы (4), kubelet запускает контейнеры (5) и сообщает статус (6). Если под позже исчезнет, контроллер ReplicaSet увидит 2 пода вместо ${replicas} и создаст новый тем же путём.`
  : `Nobody issues the command "start ${replicas} containers". kubectl only stores the desired state (1), and from then on each component watches its own objects in the API server and writes its result back: the Deployment controller creates a ReplicaSet (2), the ReplicaSet controller creates Pods (3), the scheduler assigns them nodes (4), the kubelets start the containers (5) and report status (6). If a Pod disappears later, the ReplicaSet controller sees 2 Pods instead of ${replicas} and creates a new one the same way.`;
// Narrow layout: a tall API server on the left and one row per component.
const rows = [
  { s: 1, y: 100, label: t.etcd, sub: t.etcdSub, tone: 'n' as const, arrow: 'out' as const, text: t.store },
  { s: 2, y: 168, label: t.dc, sub: t.dcSub, tone: 'g' as const, arrow: 'both' as const, text: '' },
  { s: 3, y: 236, label: t.rc, sub: t.rcSub, tone: 'g' as const, arrow: 'both' as const, text: '' },
  { s: 4, y: 304, label: t.sch, sub: t.schSub, tone: 'g' as const, arrow: 'both' as const, text: '' },
  { s: 5, y: 372, label: t.n1, sub: t.n1Sub, tone: 'x' as const, arrow: 'both' as const, text: '' },
  { s: 5, y: 440, label: t.n2, sub: t.n2Sub, tone: 'x' as const, arrow: 'both' as const, text: '' },
];
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 372" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <Box x={290} y={110} w={180} h={112} label={t.api} sub={t.apiSub} tone="h" />
    <g data-s="1">
      <Box x={16} y={20} w={160} h={48} label={t.kubectl} sub={t.kubectlSub} tone="x" />
      <Arrow pts={[[178, 44], [330, 44], [330, 108]]} />
      <Box x={600} y={142} w={144} h={48} label={t.etcd} sub={t.etcdSub} tone="n" />
      <Arrow pts={[[472, 166], [598, 166]]} />
      <text class="f-small f-t-muted f-halo" x="535" y="158" text-anchor="middle">{t.store}</text>
      <Badge x={176} y={20} n={1} />
    </g>
    <g data-s="2">
      <Box x={16} y={100} w={210} h={48} label={t.dc} sub={t.dcSub} tone="g" />
      <Arrow pts={[[228, 118], [288, 118]]} tone="amber" />
      <Arrow pts={[[288, 132], [228, 132]]} tone="muted" />
      <Badge x={226} y={100} n={2} />
    </g>
    <g data-s="3">
      <Box x={16} y={184} w={210} h={48} label={t.rc} sub={t.rcSub} tone="g" />
      <Arrow pts={[[228, 202], [288, 202]]} tone="amber" />
      <Arrow pts={[[288, 216], [228, 216]]} tone="muted" />
      <Badge x={226} y={184} n={3} />
    </g>
    <g data-s="4">
      <Box x={570} y={36} w={174} h={48} label={t.sch} sub={t.schSub} tone="g" />
      <Arrow pts={[[568, 70], [440, 70], [440, 108]]} tone="amber" />
      <Arrow pts={[[424, 108], [424, 54], [568, 54]]} tone="muted" />
      <Badge x={744} y={36} n={4} />
    </g>
    <g data-s="5">
      <Box x={190} y={270} w={180} h={50} label={t.n1} sub={t.n1Sub} tone="x" />
      <Box x={390} y={270} w={180} h={50} label={t.n2} sub={t.n2Sub} tone="x" />
      <Arrow pts={[[300, 224], [300, 268]]} tone="muted" />
      <Arrow pts={[[446, 224], [446, 268]]} tone="muted" />
      <text class="f-small f-t-muted f-halo" x="294" y="250" text-anchor="end">{t.watch}</text>
      <Badge x={570} y={270} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[318, 268], [318, 224]]} tone="green" />
      <Arrow pts={[[462, 268], [462, 224]]} tone="green" />
      <text class="f-small f-t-green f-halo" x="470" y="250">{t.status}</text>
      <text class="f-small f-t-muted" x="380" y="350" text-anchor="middle">{t.loop}</text>
      <Badge x={190} y={270} n={6} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 540" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <rect x="10" y="90" width="70" height="408" rx="8" style="fill: var(--fig-blue); fill-opacity: 0.14; stroke: var(--fig-blue); stroke-width: 1.3" />
    <text class="f-label" x="0" y="0" text-anchor="middle" transform="translate(50 294) rotate(-90)">{t.api}</text>
    <g data-s="1">
      <Box x={110} y={16} w={240} h={50} label={t.kubectl} sub={t.kubectlSub} tone="x" />
      <Arrow pts={[[108, 41], [45, 41], [45, 88]]} />
      <Badge x={350} y={16} n={1} />
    </g>
    {rows.map((r) => (
      <g data-s={r.arrow === 'out' ? '1' : String(r.s)}>
        <Box x={110} y={r.y} w={240} h={50} label={r.label} sub={r.sub} tone={r.tone} />
        {r.arrow === 'out' && <Arrow pts={[[82, r.y + 25], [108, r.y + 25]]} />}
        {r.arrow !== 'out' && r.s !== 5 && <Arrow pts={[[108, r.y + 18], [82, r.y + 18]]} tone="amber" />}
        {r.arrow !== 'out' && <Arrow pts={[[82, r.y + (r.s === 5 ? 18 : 34)], [108, r.y + (r.s === 5 ? 18 : 34)]]} tone="muted" />}
        {r.arrow !== 'out' && r.s !== 5 && <Badge x={350} y={r.y} n={r.s} />}
      </g>
    ))}
    <g data-s="5">
      <Badge x={350} y={372} n={5} />
    </g>
    <g data-s="6">
      {rows.filter((r) => r.s === 5).map((r) => <Arrow pts={[[108, r.y + 34], [82, r.y + 34]]} tone="green" />)}
      <text class="f-small f-t-muted" x="44" y="526">{t.loopN}</text>
      <Badge x={24} y={521} n={6} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
