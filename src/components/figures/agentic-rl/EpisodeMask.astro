---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import NewMark from '../seqflow/NewMark.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The worked example of the note: one episode of the toy repository rendered as tokens, with the number of tokens of each
// part and its mask (1 if the model wrote it); a group of 8 episodes of the same task with rewards 1, 0, 1, 1, 0, 0, 0, 0.
const parts = [
  { kind: 'task', n: 120, m: 0 }, { kind: 'turn', n: 40, m: 1, act: 'read 0' }, { kind: 'out', n: 300, m: 0, obs: 'OK' },
  { kind: 'turn', n: 35, m: 1, act: 'read 1' }, { kind: 'out', n: 250, m: 0, obs: 'BUG' }, { kind: 'turn', n: 60, m: 1, act: 'patch 1' },
  { kind: 'out', n: 20, m: 0, obs: 'DONE' },
];
const total = parts.reduce((a, p) => a + p.n, 0), model = parts.reduce((a, p) => a + p.n * p.m, 0);
if (total !== 825 || model !== 135) throw new Error('EpisodeMask: the token counts drifted from the note');
const R = [1, 0, 1, 1, 0, 0, 0, 0];
const mean = R.reduce((a, b) => a + b, 0) / R.length;
const std = Math.sqrt(R.reduce((a, b) => a + (b - mean) ** 2, 0) / R.length);
const aPos = (1 - mean) / std, aNeg = -mean / std;
if (aPos.toFixed(2) !== '1.29' || aNeg.toFixed(2) !== '-0.77') throw new Error('EpisodeMask: the advantages drifted from the note');
const mn = (v: number) => v.toFixed(2).replace('-', '−');

let turn = 0;
const blocks = parts.map((p) => {
  if (p.kind === 'turn') turn += 1;
  const label = p.kind === 'task' ? (ru ? 'задача' : 'task') : p.kind === 'turn' ? (ru ? `ход ${turn}` : `turn ${turn}`) : (ru ? 'вывод' : 'output');
  const sub = p.kind === 'task' ? `${p.n} ${ru ? 'токенов' : 'tokens'}` : p.kind === 'turn' ? `${p.act} · ${p.n}` : `${p.obs}${p.obs === 'DONE' ? '' : ru ? ', файл' : ', file'} · ${p.n}`;
  return { ...p, label, sub, tone: (p.m ? 'y' : 'x') as 'y' | 'x', step: p.kind === 'task' ? 1 : 2 };
});
const widths = [88, 96, 112, 88, 120, 104, 96];
const xs = widths.map((_, i) => 16 + widths.slice(0, i).reduce((a, b) => a + b, 0) + i * 4);
if (xs[6] + widths[6] !== 744) throw new Error('EpisodeMask: the strip does not fill the width');

const t = ru
  ? {
      title: 'Эпизод агента как одна последовательность и маска в функции потерь',
      grader: 'оценщик: скрытые тесты', graderSub: 'новый контейнер · R = 1', group: 'группа из G = 8 эпизодов', groupSub: 'R = 1, 0, 1, 1, 0, 0, 0, 0',
      adv: 'преимущество Â', advSub: `+${aPos.toFixed(2)} здесь, ${mn(aNeg)} у неудачных`,
      loss: 'функция потерь с маской: Â · Σ m_j log π_θ(w_j | w_{<j}) / Σ m_j', lossSub: `${model} токенов модели получают +${aPos.toFixed(2)}; ${total - model} токенов задачи и инструментов — ничего`,
      mark: 'новое: маска в функции потерь',
      steps: ['рендер: задача и история записываются в одну последовательность токенов', 'прогон: модель пишет ход с вызовом инструмента, среда выполнения запускает его и дописывает вывод (маска 0)', 'оценка: после эпизода скрытые тесты в новом контейнере дают награду R = 1', `группа: 8 эпизодов той же задачи, награды 1, 0, 1, 1, 0, 0, 0, 0, преимущество +${aPos.toFixed(2)} или ${mn(aNeg)}`, `функция потерь: преимущество умножается на log-вероятности только ${model} токенов, которые написала модель`],
      desc: `Сверху полоса из семи блоков — один эпизод: задача (120 токенов), ход 1 (read 0, 40 токенов), вывод (OK и файл, 300), ход 2 (read 1, 35), вывод (BUG и файл, 250), ход 3 (patch 1, 60), вывод (DONE, 20). Под каждым блоком маска: 1 у ходов модели, 0 у задачи и выводов. Ниже оценщик со скрытыми тестами даёт R = 1, группа из 8 эпизодов с наградами 1, 0, 1, 1, 0, 0, 0, 0 даёт преимущество +${aPos.toFixed(2)}, и функция потерь с маской обучает только ${model} из ${total} токенов.`,
    }
  : {
      title: 'An agent episode as one sequence, and the loss mask',
      grader: 'grader: hidden tests', graderSub: 'a fresh container · R = 1', group: 'a group of G = 8 episodes', groupSub: 'R = 1, 0, 1, 1, 0, 0, 0, 0',
      adv: 'advantage Â', advSub: `+${aPos.toFixed(2)} here, ${mn(aNeg)} for failures`,
      loss: 'masked loss: Â · Σ m_j log π_θ(w_j | w_{<j}) / Σ m_j', lossSub: `the ${model} model tokens get +${aPos.toFixed(2)}; the ${total - model} task and tool tokens get nothing`,
      mark: 'new: the loss mask',
      steps: ['render: the task and the history are written into one token sequence', 'roll out: the model writes a turn with a tool call; the runtime runs it and appends the output (mask 0)', 'grade: after the episode, hidden tests in a fresh container give the reward R = 1', `group: 8 episodes of the same task, rewards 1, 0, 1, 1, 0, 0, 0, 0, advantage +${aPos.toFixed(2)} or ${mn(aNeg)}`, `loss: the advantage multiplies the log-probabilities of only the ${model} tokens the model wrote`],
      desc: `Top, a strip of seven blocks, one episode: the task (120 tokens), turn 1 (read 0, 40 tokens), an output (OK and the file, 300), turn 2 (read 1, 35), an output (BUG and the file, 250), turn 3 (patch 1, 60), an output (DONE, 20). Under each block its mask: 1 for the model's turns, 0 for the task and the outputs. Below, a grader with hidden tests gives R = 1, a group of 8 episodes with rewards 1, 0, 1, 1, 0, 0, 0, 0 gives the advantage +${aPos.toFixed(2)}, and the masked loss trains only ${model} of the ${total} tokens.`,
    };
if (t.steps.length !== 5) throw new Error('EpisodeMask: the note lists five steps');
const id = 'episode-mask';
const caption = ru
  ? `Числа — пример из текста. Эпизод — это одна последовательность, но токены в ней двух видов: те, что выбрала стратегия (красные, маска 1), и те, что вернула среда или дал пользователь (зелёные, маска 0). Градиент по стратегии содержит только первые: вероятности выводов инструментов от θ не зависят. Награда одна на эпизод, и все ${model} токенов модели получают одно и то же преимущество, в каком бы ходе они ни стояли.`
  : `The numbers are the worked example of the text. An episode is one sequence, but its tokens are of two kinds: those the policy chose (red, mask 1) and those the environment returned or the user gave (green, mask 0). The policy gradient contains only the first kind, because the probabilities of tool outputs do not depend on θ. The reward is one per episode, and all ${model} model tokens get the same advantage, whichever turn they are in.`;
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 330" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    {blocks.map((b, i) => (
      <g data-s={String(b.step)}>
        <Box x={xs[i]} y={30} w={widths[i]} h={48} label={b.label} sub={b.sub} tone={b.tone} />
        <text class={`f-small ${b.m ? 'f-t-red' : 'f-t-green'}`} x={xs[i] + widths[i] / 2} y={96} text-anchor="middle">{`m = ${b.m}`}</text>
      </g>
    ))}
    <Badge x={24} y={24} n={1} />
    <Badge x={xs[1] + 8} y={24} n={2} />
    <g data-s="3">
      <Arrow pts={[[660, 104], [660, 128]]} />
      <Box x={540} y={130} w={204} h={50} label={t.grader} sub={t.graderSub} tone="g" />
      <Badge x={540} y={130} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[540, 155], [508, 155]]} tone="amber" />
      <Box x={290} y={130} w={216} h={50} label={t.group} sub={t.groupSub} tone="h" />
      <Arrow pts={[[290, 155], [258, 155]]} tone="blue" />
      <Box x={16} y={130} w={240} h={50} label={t.adv} sub={t.advSub} tone="g" />
      <Badge x={290} y={130} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[136, 180], [136, 222]]} tone="amber" />
      <NewMark x={10} y={218} w={740} h={66} label={t.mark} at="br" />
      <Box x={16} y={224} w={728} h={54} label={t.loss} sub={t.lossSub} tone="y" math={false} />
      <Badge x={16} y={224} n={5} />
    </g>
  </svg>

  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 690" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    {blocks.map((b, i) => (
      <g data-s={String(b.step)}>
        <Box x={16} y={16 + i * 44} w={250} h={40} label={b.label} sub={b.sub} tone={b.tone} subGap={15} />
        <text class={`f-small ${b.m ? 'f-t-red' : 'f-t-green'}`} x={278} y={41 + i * 44}>{`m = ${b.m}`}</text>
      </g>
    ))}
    <Badge x={340} y={35} n={1} />
    <Badge x={340} y={79} n={2} />
    <g data-s="3">
      <Arrow pts={[[141, 324], [141, 340]]} />
      <Box x={16} y={342} w={300} h={46} label={t.grader} sub={t.graderSub} tone="g" />
      <Badge x={340} y={365} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[166, 388], [166, 404]]} tone="amber" />
      <Box x={16} y={406} w={300} h={46} label={t.group} sub={t.groupSub} tone="h" />
      <Arrow pts={[[166, 452], [166, 468]]} tone="blue" />
      <Box x={16} y={470} w={300} h={46} label={t.adv} sub={t.advSub} tone="g" />
      <Badge x={340} y={429} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[166, 516], [166, 540]]} tone="amber" />
      <Box x={16} y={542} w={300} h={64} label={ru ? 'функция потерь с маской' : 'masked loss'} sub={'Â · Σ mⱼ log π(wⱼ) / Σ mⱼ'} tone="y" />
      <text class="f-small f-t-muted" x={16} y={630}>{ru ? `${model} токенов модели: +${aPos.toFixed(2)}` : `${model} model tokens: +${aPos.toFixed(2)}`}</text>
      <text class="f-small f-t-muted" x={16} y={652}>{ru ? `${total - model} токенов задачи и инструментов: 0` : `${total - model} task and tool tokens: 0`}</text>
      <Badge x={340} y={574} n={5} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
