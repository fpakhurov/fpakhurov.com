---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { trainExpected } from './env';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The toy repository of the Code section with an honest grader (hidden tests): the true pass rate of three updates
// on whole episodes, in their large-batch limits, over 100 iterations with a step of 2. The best any policy can do is 2/3.
const methods = ['grpo', 'filtered BC', 'reinforce'] as const;
const runs = methods.map((m) => trainExpected(m, false).truth);
const q = (k: number, i: number) => runs[k][i].toFixed(3);
const quoted = [q(0, 0), q(0, 20), q(1, 20), q(2, 20), q(0, 100), q(1, 100), q(2, 100)].join(' ');
if (quoted !== '0.216 0.452 0.531 0.343 0.650 0.649 0.613') throw new Error(`AgentCurves: numbers drifted from the note (${quoted})`);

const t = ru
  ? { title: 'Три обновления на целых эпизодах', x: 'итерация', y: 'доля исправленных ошибок',
      names: ['GRPO, группы по 8', 'клонирование успешных эпизодов', 'REINFORCE с базовой линией'], best: 'лучшее возможное, 2/3',
      desc: `Три кривые истинной доли исправленных ошибок в зависимости от итерации, от 0 до 100, все от 0.216. На итерации 20: GRPO ${q(0, 20)}, клонирование успешных эпизодов ${q(1, 20)}, REINFORCE со средней базовой линией ${q(2, 20)}. На итерации 100: ${q(0, 100)}, ${q(1, 100)} и ${q(2, 100)}. Пунктир на 2/3 — лучшее, чего может добиться любая стратегия.` }
  : { title: 'Three updates on whole episodes', x: 'iteration', y: 'share of bugs fixed',
      names: ['GRPO, groups of 8', 'filtered behaviour cloning', 'REINFORCE, mean baseline'], best: 'best possible, 2/3',
      desc: `Three curves of the true share of bugs fixed against the iteration, from 0 to 100, all starting at 0.216. At iteration 20: GRPO ${q(0, 20)}, filtered behaviour cloning ${q(1, 20)}, REINFORCE with a mean baseline ${q(2, 20)}. At iteration 100: ${q(0, 100)}, ${q(1, 100)} and ${q(2, 100)}. A dashed line at 2/3 marks the best any policy can do.` };
const id = 'agent-curves';
const caption = ru
  ? 'Игрушечный репозиторий из раздела «Код»: ошибка в одном из трёх файлов, три хода, патч работает только на прочитанном файле, оценка — скрытыми тестами. Кривые — пределы при большом батче: ожидаемые обновления без шума сэмплирования. Все три поднимаются по градиенту одной и той же доли успехов и отличаются только весом каждой задачи: (1 − 1/G) у REINFORCE, c_G(p) у GRPO, 1/p̄ у клонирования успешных эпизодов. Ни одна стратегия не может прочитать три файла и исправить третий за три хода, поэтому потолок — 2/3.'
  : 'The toy repository of the Code section: a bug in one of three files, three turns, a patch that works only on a file the agent has read, graded by hidden tests. The curves are large-batch limits, the expected updates without sampling noise. All three climb the gradient of the same success rate and differ only in the weight they give each task: (1 − 1/G) for REINFORCE, c_G(p) for GRPO, 1/p̄ for filtered behaviour cloning. No strategy can read three files and fix the third within three turns, so the ceiling is 2/3.';
const styles = ['f-line f-blue', 'f-line f-green', 'f-line f-red'];
const tones = ['f-t-blue', 'f-t-green', 'f-t-red'];
const its = Array.from({ length: 101 }, (_, i) => i);
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 320, px: [64, 520] as [number, number], py: [36, 260] as [number, number], wide: true },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 420, px: [52, 340] as [number, number], py: [36, 270] as [number, number], wide: false },
];
const yTicks = [0, 0.2, 0.4, 0.6, 0.8], xTicks = [0, 20, 40, 60, 80, 100];
const endY = (sy: (v: number) => number) => {
  // end labels at their curves' heights, pushed down until they are 15 units apart (two curves end almost together)
  const order = runs.map((r, k) => ({ k, y: sy(r[100]) + 4 })).sort((u, v) => u.y - v.y);
  for (let i = 1; i < order.length; i += 1) order[i].y = Math.max(order[i].y, order[i - 1].y + 15);
  const ys = [0, 0, 0];
  for (const o of order) ys[o.k] = o.y;
  return ys;
};
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sx = scale([0, 100], L.px), sy = scale([0, 0.8], [L.py[1], L.py[0]]);
    const ends = endY(sy);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {yTicks.map((v) => <path class="f-grid" d={`M ${L.px[0]} ${sy(v)} H ${L.px[1]}`} />)}
        <path class="f-axis" d={`M ${L.px[0]} ${L.py[0] - 6} V ${L.py[1]} H ${L.px[1]}`} />
        {yTicks.map((v) => <text class="f-small" x={L.px[0] - 7} y={sy(v) + 4} text-anchor="end">{v.toFixed(1)}</text>)}
        {xTicks.map((v) => <text class="f-small" x={sx(v)} y={L.py[1] + 18} text-anchor="middle">{String(v)}</text>)}
        <text class="f-small f-t-muted" x={(L.px[0] + L.px[1]) / 2} y={L.py[1] + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.px[0] - 40} y={L.py[0] - 18}>{t.y}</text>
        <path class="f-line f-dash" d={`M ${L.px[0]} ${sy(2 / 3)} H ${L.px[1]}`} />
        <text class="f-small f-t-muted f-halo" x={L.px[0] + 8} y={sy(2 / 3) - 6}>{t.best}</text>
        {runs.map((r, k) => <path class={styles[k]} d={polyline(its.map((i) => [sx(i), sy(r[i])] as [number, number]))} />)}
        {L.wide
          ? runs.map((_, k) => <text class={`f-small ${tones[k]}`} x={L.px[1] + 8} y={ends[k]}>{t.names[k]}</text>)
          : t.names.map((name, k) => (
              <g>
                <path class={styles[k]} d={`M ${L.px[0]} ${L.py[1] + 62 + k * 22 - 4} h 22`} />
                <text class={`f-small ${tones[k]}`} x={L.px[0] + 30} y={L.py[1] + 62 + k * 22}>{name}</text>
              </g>
            ))}
      </svg>
    );
  })}
</Figure>
