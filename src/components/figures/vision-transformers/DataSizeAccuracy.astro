---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The experiment of the note (Code section, seed 0): test accuracy on 719 digits after training on n images,
// the same recipe for both models (AdamW, one-cycle, batches of 64, 200 steps).
const ns = [100, 300, 1078];
const vit = [0.843, 0.925, 0.967];
const cnn = [0.937, 0.976, 0.987];
const gaps = ns.map((_, i) => (cnn[i] - vit[i]).toFixed(3));
if (gaps.join(' ') !== '0.094 0.051 0.020') throw new Error(`DataSizeAccuracy: gaps drifted (${gaps.join(' ')})`);

const t = ru
  ? { title: 'Свёрточная сеть выигрывает при малом объёме данных, и разрыв сокращается с их ростом', y: 'доля правильных ответов на тесте', x: 'обучающие изображения (логарифмическая шкала)',
      vit: 'ViT', vitP: '26 762 параметра', cnn: 'остаточная CNN', cnnP: '14 346 параметров', gap: 'разрыв',
      desc: 'Доля правильных ответов на тесте крошечного ViT и остаточной CNN после обучения на 100, 300 и 1078 изображениях цифр по одному рецепту. ViT: 0.843, 0.925, 0.967. CNN: 0.937, 0.976, 0.987. Разрывы 0.094, 0.051 и 0.020.' }
  : { title: 'The CNN wins with little data, and the gap shrinks as data grow', y: 'test accuracy', x: 'training images (log scale)',
      vit: 'ViT', vitP: '26,762 parameters', cnn: 'residual CNN', cnnP: '14,346 parameters', gap: 'gap',
      desc: 'Test accuracy of a tiny ViT and a residual CNN after training on 100, 300 and 1078 digit images with one recipe. ViT: 0.843, 0.925, 0.967. CNN: 0.937, 0.976, 0.987. The gaps are 0.094, 0.051 and 0.020.' };
const id = 'vit-data-size';
const caption = ru
  ? 'Цифры 8 × 8, тест — одни и те же 719 изображений; обучающие подвыборки стратифицированы по классам. ViT: патчи 4 × 4, D = 32, 3 блока, 4 головы. CNN: семислойная остаточная сеть из заметки о свёрточных архитектурах. Обе обучены одинаково: AdamW (шаг обучения 3 · 10⁻³, затухание весов 0.05), расписание one-cycle, батчи по 64, 200 шагов; одно начальное значение генератора. Обе модели почти без ошибок на своих обучающих изображениях, так что разница — в обобщении: при 100 изображениях предположения свёртки стоят больше девяти пунктов, при 1078 — около двух.'
  : 'Digits of 8 × 8 pixels, the same 719 test images throughout; the training subsets are stratified by class. ViT: 4 × 4 patches, D = 32, 3 blocks, 4 heads. CNN: the 7-layer residual network of the convolutional-architectures note. Both trained alike: AdamW (learning rate 3 · 10⁻³, weight decay 0.05), one-cycle schedule, batches of 64, 200 steps; one seed. Both models fit their training images almost perfectly, so the difference is generalization: with 100 images the convolution\'s assumptions are worth more than nine points, with 1078 about two.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 310, px: [80, 500] as [number, number], py: [30, 230] as [number, number], lgx: 540, lgy: 60 },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 410, px: [56, 320] as [number, number], py: [30, 230] as [number, number], lgx: 56, lgy: 300 },
];
const lx = (n: number) => Math.log10(n);
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => {
    const sx = scale([lx(80), lx(1350)], Ly.px);
    const sy = scale([0.8, 1.0], [Ly.py[1], Ly.py[0]]);
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
        {[0.85, 0.9, 0.95, 1.0].map((v) => <path class="f-grid" d={`M ${Ly.px[0]} ${sy(v)} H ${Ly.px[1]}`} />)}
        <path class="f-axis" d={`M ${Ly.px[0]} ${Ly.py[1]} H ${Ly.px[1]} M ${Ly.px[0]} ${Ly.py[0]} V ${Ly.py[1]}`} />
        {[0.8, 0.85, 0.9, 0.95, 1.0].map((v) => <text class="f-note" x={Ly.px[0] - 8} y={sy(v) + 5} text-anchor="end">{v.toFixed(2)}</text>)}
        <text class="f-small f-t-muted" x={Ly.px[0] - 50} y={Ly.py[0] - 14}>{t.y}</text>
        {ns.map((n) => <text class="f-note" x={sx(lx(n))} y={Ly.py[1] + 20} text-anchor="middle">{String(n)}</text>)}
        <text class="f-small f-t-muted" x={(Ly.px[0] + Ly.px[1]) / 2} y={Ly.py[1] + 42} text-anchor="middle">{t.x}</text>
        {ns.map((n, i) => (
          <g>
            <path class="f-thin f-dot f-muted" d={`M ${sx(lx(n))} ${sy(vit[i]) - 6} V ${sy(cnn[i]) + 6}`} />
            <text class="f-small f-halo" x={sx(lx(n)) + 9} y={(sy(vit[i]) + sy(cnn[i])) / 2 + 5}>{gaps[i]}</text>
          </g>
        ))}
        <path class="f-line f-blue" d={polyline(ns.map((n, i) => [sx(lx(n)), sy(cnn[i])]))} />
        <path class="f-line f-red" d={polyline(ns.map((n, i) => [sx(lx(n)), sy(vit[i])]))} />
        {ns.map((n, i) => <circle cx={sx(lx(n))} cy={sy(cnn[i])} r="5" class="f-solid-blue" />)}
        {ns.map((n, i) => <circle cx={sx(lx(n))} cy={sy(vit[i])} r="5" class="f-solid-red" />)}
        <text class="f-small f-halo" x={sx(lx(100))} y={sy(cnn[0]) - 10} text-anchor="middle">{cnn[0].toFixed(3)}</text>
        <text class="f-small f-halo" x={sx(lx(100))} y={sy(vit[0]) + 20} text-anchor="middle">{vit[0].toFixed(3)}</text>
        {[[t.cnn, t.cnnP, 'blue'], [t.vit, t.vitP, 'red']].map(([name, params, c], i) => (
          <g>
            <path class={`f-line f-${c}`} d={`M ${Ly.lgx} ${Ly.lgy + i * 44 - 4} h 22`} />
            <circle cx={Ly.lgx + 11} cy={Ly.lgy + i * 44 - 4} r="4" class={`f-solid-${c}`} />
            <text class="f-small" x={Ly.lgx + 30} y={Ly.lgy + i * 44}>{name}</text>
            <text class="f-small f-t-muted" x={Ly.lgx + 30} y={Ly.lgy + i * 44 + 18}>{params}</text>
          </g>
        ))}
        <path class="f-thin f-dot f-muted" d={`M ${Ly.lgx + 11} ${Ly.lgy + 82} v 14`} />
        <text class="f-small f-t-muted" x={Ly.lgx + 30} y={Ly.lgy + 94}>{t.gap}</text>
      </svg>
    );
  })}
</Figure>
