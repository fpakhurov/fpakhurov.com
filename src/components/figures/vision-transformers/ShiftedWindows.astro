---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A 12 x 12 map of tokens, windows of M = 4: the regular partition has 3 x 3 windows; the next block shifts
// the partition by floor(M / 2) = 2 tokens, which cuts the map into bands of 2, 4, 4, 2 tokens per axis.
const G = 12, M = 4, shift = Math.floor(M / 2);
const bandsReg = [0, 4, 8, 12];
const bandsShift = [0, 2, 6, 10, 12];
if (shift !== 2 || bandsShift.slice(1, -1).some((b, i) => b !== shift + i * M)) throw new Error('ShiftedWindows: bands drifted');
const tok = [5, 5];                                   // the highlighted token (row, column)
const band = (bands: number[], v: number) => bands.findIndex((b, i) => v >= b && v < bands[i + 1]);
const winReg = [band(bandsReg, tok[0]), band(bandsReg, tok[1])];
const winShift = [band(bandsShift, tok[0]), band(bandsShift, tok[1])];
// the shifted window of the token covers rows and columns 2..5, which meet four windows of the regular partition
const covered = new Set<string>();
for (let r = bandsShift[winShift[0]]; r < bandsShift[winShift[0] + 1]; r += 1)
  for (let c = bandsShift[winShift[1]]; c < bandsShift[winShift[1] + 1]; c += 1) covered.add(`${band(bandsReg, r)},${band(bandsReg, c)}`);
if (winReg.join() !== '1,1' || winShift.join() !== '1,1' || covered.size !== 4) throw new Error('ShiftedWindows: windows drifted');

const t = ru
  ? {
      title: 'Swin: внимание внутри окон и сдвиг окон в следующем блоке',
      a: 'блок ℓ: окна 4 × 4', b: 'блок ℓ + 1: окна сдвинуты на 2', shift: 'сдвиг на ⌊M/2⌋ = 2', prev: 'границы блока ℓ',
      desc: 'Две сетки из 12 × 12 токенов. Слева разбиение на 3 × 3 окна по 4 × 4 токена; выделенный токен видит только своё окно. Справа разбиение сдвинуто на два токена по обеим осям; окно выделенного токена теперь покрывает части четырёх окон предыдущего блока, границы которых показаны пунктиром.',
    }
  : {
      title: 'Swin: attention within windows, and windows shifted in the next block',
      a: 'block ℓ: 4 × 4 windows', b: 'block ℓ + 1: windows shifted by 2', shift: 'shift by ⌊M/2⌋ = 2', prev: 'borders of block ℓ',
      desc: 'Two grids of 12 × 12 tokens. On the left, a partition into 3 × 3 windows of 4 × 4 tokens; the highlighted token sees only its own window. On the right, the partition is shifted by two tokens along both axes; the window of the highlighted token now covers parts of four windows of the previous block, whose borders are dashed.',
    };
const id = 'vit-shifted-windows';
const caption = ru
  ? 'Карта из 12 × 12 токенов, M = 4. Внимание считается отдельно в каждом цветном окне. В сдвинутом разбиении по краям остаются неполные окна; Swin циклически сдвигает карту, чтобы снова получить 3 × 3 полных окна, и маскирует пары токенов, пришедших из разных частей. Красная рамка — окно выделенного токена: после сдвига в него попадают токены из четырёх окон предыдущего блока, так что информация пересекает старые границы.'
  : 'A map of 12 × 12 tokens, M = 4. Attention is computed separately in each tinted window. The shifted partition leaves incomplete windows at the borders; Swin shifts the map cyclically to get 3 × 3 full windows again and masks pairs of tokens that came from different pieces. The red outline is the window of the highlighted token: after the shift it contains tokens from four windows of the previous block, so information crosses the old borders.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 300, s: 18, A: [20, 34], B: [400, 34], narrow: false },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 560, s: 16, A: [84, 30], B: [84, 300], narrow: true },
];
const regions = (bands: number[]) => bands.slice(0, -1).flatMap((r0, i) => bands.slice(0, -1).map((c0, j) => ({ r0, r1: bands[i + 1], c0, c1: bands[j + 1], i, j })));
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => {
    const panel = (o: number[], bands: number[], win: number[], showPrev: boolean, label: string) => (
      <g>
        {regions(bands).map((rg) => (
          <rect x={o[0] + rg.c0 * Ly.s} y={o[1] + rg.r0 * Ly.s} width={(rg.c1 - rg.c0) * Ly.s} height={(rg.r1 - rg.r0) * Ly.s}
            class={(rg.i + rg.j) % 2 ? 'f-fill-amber' : 'f-fill-blue'} style="stroke: var(--ink); stroke-width: 1.6" />
        ))}
        {Array.from({ length: G + 1 }, (_, k) => (
          <path class="f-grid" d={`M ${o[0] + k * Ly.s} ${o[1]} V ${o[1] + G * Ly.s} M ${o[0]} ${o[1] + k * Ly.s} H ${o[0] + G * Ly.s}`} />
        ))}
        {regions(bands).map((rg) => (
          <rect x={o[0] + rg.c0 * Ly.s} y={o[1] + rg.r0 * Ly.s} width={(rg.c1 - rg.c0) * Ly.s} height={(rg.r1 - rg.r0) * Ly.s} style="fill: none; stroke: var(--ink); stroke-width: 1.6" />
        ))}
        {showPrev && [4, 8].map((k) => (
          <path class="f-line f-dash f-muted" d={`M ${o[0] + k * Ly.s} ${o[1]} V ${o[1] + G * Ly.s} M ${o[0]} ${o[1] + k * Ly.s} H ${o[0] + G * Ly.s}`} />
        ))}
        <rect x={o[0] + bands[win[1]] * Ly.s} y={o[1] + bands[win[0]] * Ly.s} width={(bands[win[1] + 1] - bands[win[1]]) * Ly.s} height={(bands[win[0] + 1] - bands[win[0]]) * Ly.s}
          style="fill: none; stroke: var(--fig-red); stroke-width: 3" />
        <circle cx={o[0] + (tok[1] + 0.5) * Ly.s} cy={o[1] + (tok[0] + 0.5) * Ly.s} r={Ly.s * 0.3} class="f-solid-red" />
        <text class="f-small" x={o[0] + (G * Ly.s) / 2} y={o[1] + G * Ly.s + 22} text-anchor="middle">{label}</text>
      </g>
    );
    const span = G * Ly.s;
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
        {panel(Ly.A, bandsReg, winReg, false, t.a)}
        {panel(Ly.B, bandsShift, winShift, true, t.b)}
        {Ly.narrow
          ? <g>
              <path class="f-line" d={`M ${Ly.A[0] + span / 2} ${Ly.A[1] + span + 34} V ${Ly.B[1] - 8}`} marker-end="url(#f-arrow)" />
              <text class="f-small f-t-muted" x={Ly.A[0] + span / 2 + 12} y={(Ly.A[1] + span + 34 + Ly.B[1]) / 2 + 4}>{t.shift}</text>
              <path class="f-line f-dash f-muted" d={`M ${Ly.B[0]} ${Ly.B[1] + span + 44} h 24`} />
              <text class="f-small f-t-muted" x={Ly.B[0] + 32} y={Ly.B[1] + span + 48}>{t.prev}</text>
            </g>
          : <g>
              <path class="f-line" d={`M ${Ly.A[0] + span + 20} ${Ly.A[1] + span / 2} H ${Ly.B[0] - 20}`} marker-end="url(#f-arrow)" />
              <text class="f-small f-t-muted" x={(Ly.A[0] + span + Ly.B[0]) / 2} y={Ly.A[1] + span / 2 - 12} text-anchor="middle">{t.shift}</text>
              <path class="f-line f-dash f-muted" d={`M ${Ly.B[0] + span + 14} ${Ly.B[1] + 10} h 24`} />
              <text class="f-small f-t-muted" x={Ly.B[0] + span + 14} y={Ly.B[1] + 32}>{t.prev}</text>
            </g>}
      </svg>
    );
  })}
</Figure>
