---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A bundled digit (load_digits image 3, a "3", values 0..16) cut into N = (8/4)^2 = 4 patches of 4 x 4 pixels,
// row by row, as the Code section's ViT does with x.unfold(2, 4, 4).unfold(3, 4, 4).
const img = [0, 0, 7, 15, 13, 1, 0, 0, 0, 8, 13, 6, 15, 4, 0, 0, 0, 2, 1, 13, 13, 0, 0, 0, 0, 0, 2, 15, 11, 1, 0, 0, 0, 0, 0, 1, 12, 12, 1, 0, 0, 0, 0, 0, 1, 10, 8, 0, 0, 0, 8, 4, 5, 14, 9, 0, 0, 0, 7, 13, 13, 9, 0, 0];
const P = 4, side = 8, N = (side / P) ** 2, D = 32;
const patches = Array.from({ length: N }, (_, j) => {
  const r0 = Math.floor(j / (side / P)) * P, c0 = (j % (side / P)) * P;
  return Array.from({ length: P * P }, (_, k) => img[(r0 + Math.floor(k / P)) * side + c0 + (k % P)]);
});
const sums = patches.map((p) => p.reduce((a, b) => a + b, 0));
if (N !== 4 || patches[0].length !== 16 || sums.reduce((a, b) => a + b, 0) !== 267 || sums.join(' ') !== '82 58 33 94')
  throw new Error(`PatchTokens: patches drifted (${sums.join(' ')})`);
// parameters of the patch embedding E (16 -> 32 with bias), the class token and the 5 position vectors, as in the Code section
if (P * P * D + D !== 544 || (N + 1) * D !== 160) throw new Error('PatchTokens: parameter counts drifted');

const sub = ['₁', '₂', '₃', '₄'];
const t = ru
  ? {
      title: 'Vision Transformer: изображение как последовательность патчей',
      image: 'изображение 8 × 8', strips: 'патчи, 16 чисел', tokens: 'токены', pos: 'позиции', cls: 'класс',
      enc: 'трансформер', encSub: 'L блоков pre-norm', head: 'LN, голова', logits: '10 логитов',
      steps: ['разрезать изображение на N = 4 патча 4 × 4 по строкам', 'вытянуть каждый патч в 16 чисел и умножить на общую матрицу E: токен размерности D', 'поставить в начало обучаемый токен класса', 'прибавить обучаемый позиционный эмбеддинг к каждому из N + 1 токенов', 'L блоков энкодера: каждый токен обращает внимание на все остальные', 'нормализовать выход токена класса и классифицировать его линейной головой'],
      desc: 'Слева цифра 3 размером 8 × 8, разрезанная на четыре патча 4 × 4. Каждый патч вытянут в полоску из 16 значений и умножен на общую матрицу E; получаются токены x₁E, …, x₄E. Перед ними стоит токен класса, к каждому из пяти токенов прибавляется позиционный вектор p₀, …, p₄. Пять токенов проходят через энкодер трансформера; выход токена класса после LN и линейной головы даёт 10 логитов.',
    }
  : {
      title: 'Vision Transformer: an image as a sequence of patches',
      image: '8 × 8 image', strips: 'patches, 16 values', tokens: 'tokens', pos: 'positions', cls: 'class',
      enc: 'Transformer', encSub: 'L pre-norm blocks', head: 'LN, head', logits: '10 logits',
      steps: ['cut the image into N = 4 patches of 4 × 4, row by row', 'flatten each patch to 16 values and multiply by the shared matrix E: a token of width D', 'prepend the learned class token', 'add a learned position embedding to each of the N + 1 tokens', 'L encoder blocks: every token attends to every other', 'normalize the class token\'s output and classify it with a linear head'],
      desc: 'On the left a digit 3 of 8 × 8 pixels, cut into four patches of 4 × 4. Each patch is flattened into a strip of 16 values and multiplied by the shared matrix E, giving the tokens x₁E to x₄E. A class token is placed before them, and a position vector p₀ to p₄ is added to each of the five tokens. The five tokens pass through the Transformer encoder; the class token\'s output, after LN and a linear head, gives 10 logits.',
    };
const id = 'vit-patch-tokens';
const caption = ru
  ? 'Числа как в коде заметки: P = 4, N = 4 патча, D = 32. Матрица E одна для всех патчей (544 параметра со смещением); это то же, что свёртка с ядром и шагом P. Токен класса и пять позиционных векторов (160 параметров) обучаются вместе с сетью. Выходы токенов патчей после последнего блока не используются: классифицируется только токен класса. Для изображения 224 × 224 с P = 16 картина та же, но токенов 197.'
  : 'The numbers of the note\'s code: P = 4, N = 4 patches, D = 32. E is one matrix shared by all patches (544 parameters with the bias), the same as a convolution with kernel and stride P. The class token and the five position vectors (160 parameters) are learned with the network. The outputs of the patch tokens after the last block are not used: only the class token is classified. For a 224 × 224 image with P = 16 the picture is the same, with 197 tokens.';

// wide layout: one row per token, class token first
const RY = [60, 100, 140, 180, 220];
const s = 14, ix = 16, iy = 84;
// narrow layout
const ns = 10, nix = 16, niy = 40;
const NX = [40, 96, 152, 208, 264];
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 290" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <text class="f-small f-t-muted" x={ix + 56} y="22" text-anchor="middle">{t.image}</text>
    {img.map((v, k) => <rect x={ix + (k % 8) * s} y={iy + Math.floor(k / 8) * s} width={s} height={s} style={`fill: var(--ink); fill-opacity: ${(v / 16).toFixed(3)}`} />)}
    <g data-s="1">
      {[0, 1, 2, 3].map((j) => (
        <g>
          <rect x={ix + (j % 2) * 56} y={iy + Math.floor(j / 2) * 56} width="56" height="56" style="fill: none; stroke: var(--fig-green); stroke-width: 2" />
          <text class="f-small f-t-green f-halo" x={ix + (j % 2) * 56 + 5} y={iy + Math.floor(j / 2) * 56 + 14}>{j + 1}</text>
        </g>
      ))}
      <Badge x={136} y={72} n={1} />
    </g>
    <g data-s="2">
      <text class="f-small f-t-muted" x="198" y="22" text-anchor="middle">{t.strips}</text>
      {patches.map((p, j) => (
        <g>
          <text class="f-small f-t-green" x="141" y={RY[j + 1] + 5} text-anchor="middle">{j + 1}</text>
          {p.map((v, k) => <rect x={150 + k * 6} y={RY[j + 1] - 7} width="6" height="14" style={`fill: var(--ink); fill-opacity: ${(v / 16).toFixed(3)}; stroke: var(--fig-green); stroke-width: 0.5`} />)}
          <Arrow pts={[[248, RY[j + 1]], [260, RY[j + 1]]]} />
          <Arrow pts={[[302, RY[j + 1]], [320, RY[j + 1]]]} />
          <Vec x={322} y={RY[j + 1] - 11} values={[`x${sub[j]}E`]} tone="x" cw={50} />
        </g>
      ))}
      <Box x={262} y={84} w={40} h={152} label="E" math={true} tone="g" />
      <text class="f-small f-t-muted" x="347" y="22" text-anchor="middle">{t.tokens}</text>
      <Badge x={282} y={72} n={2} />
    </g>
    <g data-s="3">
      <Vec x={322} y={RY[0] - 11} values={[t.cls]} tone="g" cw={50} />
      <Badge x={306} y={RY[0]} n={3} />
    </g>
    <g data-s="4">
      {RY.map((y, j) => (
        <g>
          <text class="f-label" x="391" y={y + 5} text-anchor="middle">+</text>
          <Vec x={404} y={y - 11} values={[`p${['₀', ...sub][j]}`]} tone="g" cw={40} />
        </g>
      ))}
      <text class="f-small f-t-muted" x="424" y="22" text-anchor="middle">{t.pos}</text>
      <Badge x={460} y={34} n={4} />
    </g>
    <g data-s="5">
      {RY.map((y) => <Arrow pts={[[446, y], [478, y]]} />)}
      <Box x={480} y={44} w={124} h={192} label={t.enc} sub={t.encSub} tone="h" />
      <Badge x={542} y={30} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[604, RY[0]], [622, RY[0]]]} tone="red" />
      <Box x={624} y={RY[0] - 16} w={84} h={32} label={t.head} tone="y" />
      <Arrow pts={[[708, RY[0]], [726, RY[0]]]} tone="red" />
      <text class="f-math" x="730" y={RY[0] + 6}>ŷ</text>
      <text class="f-small f-t-muted" x="666" y={RY[0] + 36} text-anchor="middle">{t.logits}</text>
      <Badge x={666} y={30} n={6} />
    </g>
    <Legend x={196} y={274} step={120} rows={1} />
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 466" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <text class="f-small f-t-muted" x={nix} y="24">{t.image}</text>
    {img.map((v, k) => <rect x={nix + (k % 8) * ns} y={niy + Math.floor(k / 8) * ns} width={ns} height={ns} style={`fill: var(--ink); fill-opacity: ${(v / 16).toFixed(3)}`} />)}
    <g data-s="1">
      {[0, 1, 2, 3].map((j) => (
        <g>
          <rect x={nix + (j % 2) * 40} y={niy + Math.floor(j / 2) * 40} width="40" height="40" style="fill: none; stroke: var(--fig-green); stroke-width: 2" />
          <text class="f-small f-t-green f-halo" x={nix + (j % 2) * 40 + 4} y={niy + Math.floor(j / 2) * 40 + 15}>{j + 1}</text>
        </g>
      ))}
      <Badge x={110} y={130} n={1} />
    </g>
    <g data-s="2">
      {patches.map((p, j) => (
        <g>
          <text class="f-small f-t-green" x="132" y={50 + j * 22 + 5} text-anchor="middle">{j + 1}</text>
          {p.map((v, k) => <rect x={144 + k * 12} y={50 + j * 22 - 8} width="12" height="16" style={`fill: var(--ink); fill-opacity: ${(v / 16).toFixed(3)}; stroke: var(--fig-green); stroke-width: 0.5`} />)}
        </g>
      ))}
      <Arrow pts={[[240, 128], [240, 146]]} />
      <Box x={40} y={148} w={280} h={26} label="E" math={true} tone="g" />
      {[1, 2, 3, 4].map((j) => <Arrow pts={[[NX[j] + 28, 174], [NX[j] + 28, 188]]} />)}
      {[0, 1, 2, 3].map((j) => <Vec x={NX[j + 1]} y={190} values={[`x${sub[j]}E`]} tone="x" cw={56} />)}
      <Badge x={334} y={161} n={2} />
    </g>
    <g data-s="3">
      <Vec x={NX[0]} y={190} values={[t.cls]} tone="g" cw={56} />
      <Badge x={20} y={201} n={3} />
    </g>
    <g data-s="4">
      {NX.map((x, j) => (
        <g>
          <text class="f-label" x={x + 28} y="232" text-anchor="middle">+</text>
          <Vec x={x} y={240} values={[`p${['₀', ...sub][j]}`]} tone="g" cw={56} />
        </g>
      ))}
      <Badge x={334} y={251} n={4} />
    </g>
    <g data-s="5">
      {NX.map((x) => <Arrow pts={[[x + 28, 262], [x + 28, 282]]} />)}
      <Box x={40} y={284} w={280} h={44} label={t.enc} sub={t.encSub} tone="h" />
      <Badge x={334} y={306} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[68, 328], [68, 352]]} tone="red" />
      <Box x={26} y={354} w={120} h={30} label={t.head} tone="y" />
      <Arrow pts={[[146, 369], [170, 369]]} tone="red" />
      <text class="f-math" x="176" y="375">ŷ</text>
      <text class="f-small f-t-muted" x="196" y="374">{t.logits}</text>
      <Badge x={334} y={369} n={6} />
    </g>
    <Legend x={16} y={430} step={170} rows={2} />
  </svg>
  <Stepper steps={t.steps} />
</Figure>
