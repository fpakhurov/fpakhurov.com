---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// AI control's trusted-monitoring protocol (Greenblatt et al., 2024): a capable but untrusted model proposes an action,
// a weaker trusted model scores its suspiciousness, and by the score the action is executed, replaced by the trusted
// model's own, or sent to a small budget of human audit. The numbers in the labels are the paper's APPS-backdoor setup.
const t = ru
  ? {
      title: 'Доверенный мониторинг: как использовать сильную, но недоверенную модель',
      task: 'задача', taskSub: 'например, код',
      unt: 'сильная модель', untSub: 'недоверенная (GPT-4)',
      act: 'предложенное действие', actSub: 'код + рассуждение',
      mon: 'доверенный монитор', monSub: 'слабая (GPT-3.5)',
      score: 'оценка подозрительности', scoreSub: '0–10',
      exec: 'выполнить', execSub: 'низкая оценка',
      defer: 'замена действия', deferSub: 'средняя оценка',
      audit: 'аудит человеком', auditSub: 'верхние 2%',
      steps: ['недоверенная модель получает задачу и предлагает действие вместе с рассуждением', 'доверенная (более слабая) модель ставит действию оценку подозрительности', 'низкая оценка: действие выполняется как есть', 'средняя оценка: действие заменяется на то, что предложит доверенная модель', 'самые подозрительные (верх 2%) уходят человеку на аудит — дефицитный ресурс'],
      desc: 'Сильная недоверенная модель предлагает действие по задаче. Слабая доверенная модель оценивает его подозрительность. По оценке действие либо выполняется, либо заменяется на действие доверенной модели, либо, если попало в верхние 2% по подозрительности, отправляется человеку на аудит.',
    }
  : {
      title: 'Trusted monitoring: using a strong but untrusted model safely',
      task: 'task', taskSub: 'e.g. write code',
      unt: 'untrusted model', untSub: 'capable (GPT-4)',
      act: 'proposed action', actSub: 'code + reasoning',
      mon: 'trusted monitor', monSub: 'weaker model (GPT-3.5)',
      score: 'suspicion score', scoreSub: '0–10',
      exec: 'execute', execSub: 'low score',
      defer: 'defer to trusted', deferSub: 'mid score',
      audit: 'human audit', auditSub: 'top 2% → review',
      steps: ['the untrusted model receives the task and proposes an action with its reasoning', 'the trusted (weaker) model scores the action for suspiciousness', 'low score: execute the action as proposed', 'mid score: replace it with what the trusted model would do (defer to trusted)', 'the most suspicious (top 2%) go to a person for audit, a scarce budget'],
      desc: 'A strong untrusted model proposes an action for the task. A weaker trusted model scores its suspiciousness. By the score the action is executed, replaced by the trusted model’s action, or, if it falls in the top 2% most suspicious, sent to a person for audit.',
    };
const id = 'trusted-monitoring';
const caption = ru
  ? 'Протокол доверенного мониторинга из работы о контроле ИИ (AI control; Greenblatt et al., 2024). Сильная модель полезна, но ей нельзя доверять; слабой модели доверяют, но она менее способна; аудита человеком хватает лишь на малую долю действий. Монитор на слабой модели сортирует действия по подозрительности: большинство выполняется, средние заменяются на безопасный вариант доверенной модели, а дефицитный аудит тратится на самые подозрительные. В задаче с бэкдорами в коде передача доверенной модели 10% действий поднимает безопасность с 62% до 83% ценой падения полезности с 97% до 93%.'
  : 'The trusted-monitoring protocol of AI control (Greenblatt et al., 2024). The strong model is useful but cannot be trusted; the weak model is trusted but less capable; human audit covers only a small fraction of actions. A monitor built on the weak model ranks actions by suspiciousness: most run, mid ones are replaced by the trusted model’s safe version, and the scarce audit is spent on the most suspicious. In their code-backdoor setting, deferring 10% of actions to the trusted model raises safety from 62% to 83%, at a cost in usefulness from 97% to 93%.';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 300" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <Box x={14} y={120} w={120} h={50} label={t.task} sub={t.taskSub} tone="x" />
    <g data-s="1">
      <Arrow pts={[[134, 145], [158, 145]]} />
      <Box x={160} y={120} w={150} h={50} label={t.unt} sub={t.untSub} tone="y" />
      <Badge x={298} y={120} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[310, 145], [334, 145]]} label={t.act} at={[322, 112]} anchor="middle" labelTone="n" />
      <Box x={336} y={120} w={160} h={50} label={t.mon} sub={t.monSub} tone="h" />
      <Badge x={484} y={120} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[496, 135], [560, 135], [560, 40], [620, 40]]} tone="green" />
      <Box x={622} y={18} w={124} h={46} label={t.exec} sub={t.execSub} tone="x" />
      <Badge x={734} y={18} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[496, 145], [620, 145]]} tone="amber" />
      <Box x={622} y={120} w={124} h={50} label={t.defer} sub={t.deferSub} tone="g" />
      <Badge x={734} y={120} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[496, 155], [560, 155], [560, 250], [620, 250]]} tone="red" />
      <Box x={622} y={228} w={124} h={46} label={t.audit} sub={t.auditSub} tone="y" />
      <Badge x={734} y={228} n={5} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 520" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <Box x={100} y={8} w={160} h={44} label={t.task} sub={t.taskSub} tone="x" />
    <g data-s="1">
      <Arrow pts={[[180, 52], [180, 76]]} />
      <Box x={100} y={78} w={160} h={48} label={t.unt} sub={t.untSub} tone="y" />
      <Badge x={248} y={78} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[180, 126], [180, 152]]} label={t.act} at={[188, 142]} labelTone="n" />
      <Box x={100} y={154} w={160} h={48} label={t.mon} sub={t.monSub} tone="h" />
      <Badge x={248} y={154} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[150, 202], [150, 278]]} tone="green" />
      <Box x={70} y={280} w={220} h={46} label={t.exec} sub={t.execSub} tone="x" />
      <Badge x={278} y={280} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[180, 326], [180, 352]]} tone="amber" />
      <Box x={70} y={354} w={220} h={46} label={t.defer} sub={t.deferSub} tone="g" />
      <Badge x={278} y={354} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[180, 400], [180, 426]]} tone="red" />
      <Box x={70} y={428} w={220} h={46} label={t.audit} sub={t.auditSub} tone="y" />
      <Badge x={278} y={428} n={5} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
