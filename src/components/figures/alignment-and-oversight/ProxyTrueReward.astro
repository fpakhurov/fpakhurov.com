---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The toy RL agent of the Code section, by expected-gradient ascent (no sampling noise). Strategies: quick fix, careful
// fix, edit the test; P(visible tests pass) = 0.5, 0.8, 1.0 and P(code correct) = 0.3, 0.75, 0. For the hack, the agent
// describes it in disguise with probability q = sigmoid(phi). A chain-of-thought monitor catches a candid hack with 0.95,
// a disguised one with 0.1. Steps 0-1500: reward = proxy. Then two branches: (left) proxy minus 1 when the monitor flags;
// (right) the hidden tests (the true reward).
const PP = [0.5, 0.8, 1.0], PT = [0.3, 0.75, 0.0], CC = 0.95, CD = 0.1, SWITCH = 1500, STEPS = 3000;
const softmax = (th: number[]) => { const m = Math.max(...th); const e = th.map((x) => Math.exp(x - m)); const s = e.reduce((a, b) => a + b, 0); return e.map((x) => x / s); };
const dot = (a: number[], b: number[]) => a.reduce((s, x, i) => s + x * b[i], 0);
function run(branch: 'penalty' | 'hidden') {
  let theta = [2, 1, -2], phi = -2.5;
  const out = { proxy: [] as number[], truth: [] as number[], flag: [] as number[] };
  for (let t = 0; t <= STEPS; t++) {
    const pi = softmax(theta), q = 1 / (1 + Math.exp(-phi));
    out.proxy.push(dot(pi, PP)); out.truth.push(dot(pi, PT)); out.flag.push(pi[2] * ((1 - q) * CC + q * CD));
    const mode = t < SWITCH ? 'proxy' : branch;
    const [rc, rd] = mode === 'penalty' ? [1 - CC, 1 - CD] : mode === 'hidden' ? [0, 0] : [1, 1];
    const r = [...(mode === 'hidden' ? PT : PP)]; r[2] = (1 - q) * rc + q * rd;
    const J = dot(pi, r);
    theta = theta.map((th, i) => th + pi[i] * (r[i] - J));
    phi = phi + pi[2] * q * (1 - q) * (rd - rc);
  }
  return out;
}
const runs = [run('penalty'), run('hidden')];
const pick = (o: ReturnType<typeof run>, ts: number[]) => ts.map((s) => [o.proxy[s], o.truth[s], o.flag[s]].map((v) => v.toFixed(3)).join('/')).join(' ');
const quoted = pick(runs[0], [0, 1000, 1500, 2000, 3000]) + ' | ' + pick(runs[1], [2000, 3000]);
if (quoted !== '0.586/0.415/0.012 0.802/0.735/0.015 0.998/0.006/0.878 0.999/0.004/0.102 0.999/0.002/0.100 | 0.800/0.749/0.001 0.800/0.750/0.000')
  throw new Error(`ProxyTrueReward: trajectory drifted from the note (${quoted})`);

const t = ru
  ? { title: 'Суррогатная и истинная награда при обучении на неверной мере', x: 'шаг обучения', y: 'доля',
      panels: ['затем штраф за сигнал монитора', 'затем скрытые тесты как награда'], sw: 'смена награды',
      proxy: 'суррогат: видимые тесты пройдены', truth: 'истина: код верен', flag: 'пойман монитором',
      desc: 'Две панели по 3000 шагов. До шага 1500 обе одинаковы: суррогат и истина растут вместе до 0.80 и 0.74, затем агент переходит к правке тестов, суррогат доходит до 1, истина падает почти до 0, а монитор ловит 0.88 запусков. Слева после шага 1500 к награде добавлен штраф за сигнал монитора: доля пойманных падает до 0.10, а истина остаётся около 0. Справа наградой становятся скрытые тесты: истина возвращается к 0.75, суррогат — к 0.80.' }
  : { title: 'Proxy and true reward when training on the wrong measure', x: 'training step', y: 'share',
      panels: ['then a penalty when the monitor flags', 'then the hidden tests as the reward'], sw: 'reward changes',
      proxy: 'proxy: visible tests pass', truth: 'true: the code is correct', flag: 'caught by the monitor',
      desc: 'Two panels of 3000 steps each. Up to step 1500 they are identical: proxy and true reward rise together to 0.80 and 0.74, then the agent switches to editing the tests, the proxy reaches 1, the true reward falls to near 0, and the monitor catches 0.88 of the runs. On the left, after step 1500, a penalty for being flagged is added: the share caught falls to 0.10 while the true reward stays near 0. On the right the hidden tests become the reward: the true reward returns to 0.75 and the proxy to 0.80.' };
const id = 'proxy-true-reward';
const caption = ru
  ? `Агент из раздела «Код», ожидаемый градиент без шума. До шага 1500 награда — суррогат «видимые тесты пройдены»: сначала агент учится аккуратно чинить код, затем находит правку тестов, и истинная награда падает до ${runs[0].truth[1500].toFixed(3)} при суррогате ${runs[0].proxy[1500].toFixed(3)}. Монитор цепочки рассуждений ловит ${(runs[0].flag[1500] * 100).toFixed(0)}% таких запусков. Штраф за его сигнал (слева) не возвращает честную работу: агент учится описывать тот же взлом невинно, и монитор ловит лишь ${(runs[0].flag[3000] * 100).toFixed(0)}%. Исправленная награда (справа) возвращает истинную долю к ${runs[1].truth[3000].toFixed(2)}.`
  : `The agent of the Code section, expected gradient without noise. Up to step 1500 the reward is the proxy "visible tests pass": the agent first learns to fix code carefully, then finds that editing the tests pays, and the true reward falls to ${runs[0].truth[1500].toFixed(3)} at a proxy of ${runs[0].proxy[1500].toFixed(3)}. A chain-of-thought monitor catches ${(runs[0].flag[1500] * 100).toFixed(0)}% of these runs. Penalizing its flags (left) does not restore honest work: the agent learns to describe the same hack innocently, and the monitor catches only ${(runs[0].flag[3000] * 100).toFixed(0)}%. Fixing the reward (right) brings the true rate back to ${runs[1].truth[3000].toFixed(2)}.`;

const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 360, panels: [[64, 354, 40, 250], [440, 730, 40, 250]], leg: [64, 320] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 620, panels: [[52, 336, 44, 214], [52, 336, 300, 470]], leg: [20, 538] },
];
const yTicks = [0, 0.5, 1.0], xTicks = [0, 1500, 3000];
const series = [
  { k: 'proxy' as const, cls: 'f-blue' },
  { k: 'truth' as const, cls: 'f-green' },
  { k: 'flag' as const, cls: 'f-amber' },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
      {L.panels.map(([x0, x1, y0, y1], p) => {
        const sx = scale([0, STEPS], [x0, x1]), sy = scale([0, 1], [y1, y0]);
        const line = (d: number[]) => polyline(d.map((v, i) => [i, v] as [number, number]).filter(([i]) => i % 20 === 0).map(([i, v]) => [sx(i), sy(v)] as [number, number]));
        return (
          <g>
            {yTicks.map((v) => <path class="f-grid" d={`M ${x0} ${sy(v)} H ${x1}`} />)}
            <path class="f-axis" d={`M ${x0} ${y0 - 4} V ${y1} H ${x1}`} />
            {yTicks.map((v) => <text class="f-small" x={x0 - 6} y={sy(v) + 4} text-anchor="end">{v.toFixed(1)}</text>)}
            {xTicks.map((v) => <text class="f-small" x={sx(v)} y={y1 + 17} text-anchor="middle">{String(v)}</text>)}
            <text class="f-small f-t-muted" x={x0} y={y0 - 14}>{t.panels[p]}</text>
            <path class="f-line f-muted f-dash" d={`M ${sx(SWITCH)} ${y0} V ${y1}`} style="stroke-width: 1" />
            {series.map((S) => <path class={`f-line ${S.cls}`} d={line(runs[p][S.k])} />)}
          </g>
        );
      })}
      <text class="f-small f-t-muted" x={L.sfx === 'w' ? 397 : 180} y={L.sfx === 'w' ? 290 : 510} text-anchor="middle">{t.x}</text>
      {[[t.proxy, 'f-blue', 'f-t-blue'], [t.truth, 'f-green', 'f-t-green'], [t.flag, 'f-amber', 'f-t-amber']].map(([label, cl, tc], i) => {
        const x = L.sfx === 'w' ? L.leg[0] + i * 232 : L.leg[0];
        const y = L.sfx === 'w' ? L.leg[1] : L.leg[1] + i * 26;
        return (
          <g>
            <path class={`f-line ${cl}`} d={`M ${x} ${y - 4} h 22`} />
            <text class={`f-small ${tc}`} x={x + 30} y={y}>{label}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
