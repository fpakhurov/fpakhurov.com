---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Inclusion–exclusion for three events: how many times each of the seven regions is counted after each step.
// A region in m of the events is counted m times after step 1, m − C(m, 2) after step 2, m − C(m, 2) + C(m, 3) after step 3.
const R = 46;
const centres = [[-26, -14], [26, -14], [0, 30]];
const regions = [
  { in: [1, 0, 0], at: [-46, -24] }, { in: [0, 1, 0], at: [46, -24] }, { in: [0, 0, 1], at: [0, 56] },
  { in: [1, 1, 0], at: [0, -34] }, { in: [1, 0, 1], at: [-28, 22] }, { in: [0, 1, 1], at: [28, 22] }, { in: [1, 1, 1], at: [0, 0] },
];
for (const g of regions) {
  const inside = centres.map(([x, y]) => Math.hypot(g.at[0] - x, g.at[1] - y) < R - 8);
  if (inside.some((v, i) => v !== (g.in[i] === 1))) throw new Error('InclusionExclusion: a region label is outside its region');
}
const choose = (m: number, k: number) => (k === 2 ? (m * (m - 1)) / 2 : k === 3 ? (m * (m - 1) * (m - 2)) / 6 : m);
const counted = (m: number, step: number) => m - (step > 1 ? choose(m, 2) : 0) + (step > 2 ? choose(m, 3) : 0);
const table = [1, 2, 3].map((s) => regions.map((g) => counted(g.in.reduce((a, b) => a + b, 0), s)));
if (table.map((r) => r.join('')).join(' ') !== '1112223 1111110 1111111') throw new Error('InclusionExclusion: counts drifted');
const tone = (c: number) => (c === 1 ? 'f-t-green' : c === 0 ? 'f-t-red' : 'f-t-amber');
const t = ru
  ? { formula: [['P(A) + P(B) + P(C)'], ['− P(A∩B) − P(A∩C)', '− P(B∩C)'], ['+ P(A∩B∩C)']],
      note: [['пересечения учтены', '2 или 3 раза'], ['центр теперь', 'учтён 0 раз'], ['каждая точка', 'учтена один раз']],
      steps: ['сложить P(A), P(B), P(C): пересечения учтены два или три раза', 'вычесть три попарных пересечения: центр уходит в ноль', 'вернуть тройное пересечение: каждая точка учтена один раз'] }
  : { formula: [['P(A) + P(B) + P(C)'], ['− P(A∩B) − P(A∩C)', '− P(B∩C)'], ['+ P(A∩B∩C)']],
      note: [['overlaps counted', '2 or 3 times'], ['the centre is now', 'counted 0 times'], ['every point is', 'counted once']],
      steps: ['add P(A), P(B), P(C): the overlaps are counted two or three times', 'subtract the three pairwise intersections: the centre drops to zero', 'add the triple intersection back: every point is counted once'] };
const id = 'inclusion-exclusion';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 250, c: (k: number) => [125 + k * 255, 92], wide: true },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 510, c: (k: number) => [88, 76 + k * 170], wide: false },
];
const setLabels = [['A', -70, -46], ['B', 70, -46], ['C', 44, 72]] as const;
---

<Figure
  id={id}
  title={ru ? 'Включения–исключения для трёх событий' : 'Inclusion–exclusion for three events'}
  caption={ru
    ? 'Число в каждой из семи областей — сколько раз она учтена к этому шагу; зелёный — ровно один раз, жёлтый — больше, красный — ноль. Сумма P(A) + P(B) + P(C) учитывает попарные пересечения дважды, а центр трижды (1). Вычитание трёх попарных пересечений исправляет попарные области, но центр, входивший в каждое из них, уходит в ноль (2). Добавление P(A∩B∩C) возвращает его (3), и каждая точка объединения учтена ровно один раз.'
    : 'The number in each of the seven regions is how many times it has been counted so far; green is exactly once, amber more, red zero. The sum P(A) + P(B) + P(C) counts the pairwise overlaps twice and the centre three times (1). Subtracting the three pairwise intersections fixes the pairwise regions, but the centre, which lies in all of them, drops to zero (2). Adding P(A∩B∩C) brings it back (3), and every point of the union is counted exactly once.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Три шага формулы включений–исключений' : 'Three steps of inclusion–exclusion'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'Три диаграммы Венна. После первого шага области учтены 1, 2 или 3 раза, после второго центр учтён 0 раз, после третьего все области учтены один раз.' : 'Three Venn diagrams. After the first step the regions are counted 1, 2 or 3 times, after the second the centre is counted 0 times, after the third every region is counted once.'}</desc>
      {table.map((row, k) => {
        const [cx, cy] = L.c(k);
        const tx = L.wide ? cx : 176, ty = L.wide ? cy + 108 : cy - 12;
        return (
          <g data-s={k + 1}>
            {centres.map(([x, y]) => <circle cx={cx + x} cy={cy + y} r={R} class="f-thin f-blue" style="fill: var(--fig-blue); fill-opacity: .06" />)}
            {setLabels.map(([s, x, y]) => <text class="f-small f-t-blue" x={cx + x} y={cy + y + 4} text-anchor="middle">{s}</text>)}
            {regions.map((g, i) => <text class={`f-label ${tone(row[i])}`} x={cx + g.at[0]} y={cy + g.at[1] + 5} text-anchor="middle" style="font-weight: 650">{row[i]}</text>)}
            {L.wide
              ? <g>
                  <text class="f-small" x={tx} y={ty} text-anchor="middle">{t.formula[k].join(' ')}</text>
                  <text class="f-note" x={tx} y={ty + 22} text-anchor="middle">{t.note[k].join(' ')}</text>
                  <Badge x={cx - 98} y={cy - 64} n={k + 1} />
                </g>
              : <g>
                  {t.formula[k].map((line, j) => <text class="f-small" x={tx} y={ty + j * 19}>{line}</text>)}
                  {t.note[k].map((line, j) => <text class="f-note" x={tx} y={ty + (t.formula[k].length + j) * 19 + 8}>{line}</text>)}
                  <Badge x={tx + 9} y={cy - 46} n={k + 1} />
                </g>}
          </g>
        );
      })}
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
