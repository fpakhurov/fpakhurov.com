---
// Original fictional flag weights and computed inclusion-exclusion diagram.
// Fedor Pakhurov project with Codex assistance, 2026-11-14.
import Figure from '../Figure.astro';
import {pageLang} from '../../../utils/lang';
const ru=pageLang(Astro.url)==='ru';
const atoms=[['000',13],['100',5],['010',7],['001',3],['110',4],['101',2],['011',1],['111',1]] as const;
const rows=atoms.map(([flags,weight])=>{
 const m=[...flags].filter(x=>x==='1').length;
 const pair=m*(m-1)/2,triple=m*(m-1)*(m-2)/6;
 return {flags,weight,steps:[weight*m,weight*(m-pair),weight*(m-pair+triple)]};
});
const sums=[0,1,2].map(k=>rows.reduce((s,r)=>s+r.steps[k],0));
if(sums.join(',')!=='32,22,23'||atoms.reduce((s,[,w])=>s+w,0)!==36)throw new Error('Flag-weight inclusion-exclusion drift');
---
<Figure id="inclusion-exclusion"
 title={ru?'Перекрытие: 32 − 10 + 1 = 23':'Overlap: 32 − 10 + 1 = 23'}
 caption={ru?'Числа — учтённые единицы веса из 36. После вычитания пар запись 111 теряет все три копии; тройная поправка возвращает её одну единицу. В последнем столбце каждый отмеченный исход учтён ровно один раз.':'Numbers are counted weight units out of 36. Pair subtraction removes all three copies of record 111; the triple correction restores its one unit. The final column counts each flagged outcome once.'}>
 <div class="flag-table"><table>
  <thead><tr><th>ABC</th><th>{ru?'Вес':'Weight'}</th><th>{ru?'Сумма':'Singles'}</th><th>{ru?'Минус пары':'Minus pairs'}</th><th>{ru?'Плюс тройка':'Plus triple'}</th></tr></thead>
  <tbody>{rows.map(r=><tr><th scope="row"><code>{r.flags}</code></th><td>{r.weight}</td>{r.steps.map((n,k)=><td class:list={{final:k===2,corrected:r.flags==='111'&&k>0}}>{n}</td>)}</tr>)}</tbody>
  <tfoot><tr><th>{ru?'Всего':'Total'}</th><td>36</td>{sums.map(n=><td>{n}</td>)}</tr></tfoot>
 </table></div>
</Figure>
<style>
 .flag-table table{width:100%;table-layout:fixed;border-collapse:collapse;font-size:.875rem;font-variant-numeric:tabular-nums}
 .flag-table th,.flag-table td{text-align:center;padding:.4rem .2rem;line-height:1.35;border-bottom:1px solid var(--line)}
 .flag-table th{font-weight:600;overflow-wrap:anywhere}
 .flag-table code{background:none;padding:0;font-size:inherit}
 .flag-table .final{background:color-mix(in srgb,var(--fig-blue) 9%,transparent)}
 .flag-table .corrected{font-weight:700}
 .flag-table tfoot{font-weight:700}
</style>
