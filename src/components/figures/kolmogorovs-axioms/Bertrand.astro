---
// Original finite mode-format example. Filename/figure anchor retained for links.
// The former chord simulation is not used. No random generator dependency.
import Figure from '../Figure.astro';
import {pageLang} from '../../../utils/lang';
const ru=pageLang(Astro.url)==='ru';
const modes=[['A',['u','v']],['B',['v']],['C',['u','v','w']]] as const;
const rows=modes.flatMap(([mode,formats])=>formats.map(format=>({pair:`${mode},${format}`,denominator:3*formats.length})));
if(rows.length!==6||rows.map(r=>r.denominator).join(',')!=='6,6,3,9,9,9')throw new Error('Mode-format branch weights drift');
---
<Figure id="bertrand-chords"
 title={ru?'Одни результаты, разные меры':'Same outcomes, different measures'}
 caption={ru?'Слева равномерно выбирается одна из шести пар. Справа сначала равномерно выбирается режим, затем допустимый формат. Пара C,w получает 1/6 или 1/9; оба набора весов в сумме дают один.':'The left column samples one of six pairs uniformly. The right column first samples a mode uniformly, then a permitted format. Pair C,w receives 1/6 or 1/9; both weight lists sum to one.'}>
 <div class="mode-table"><table>
  <thead><tr><th>{ru?'Пара':'Pair'}</th><th>{ru?'Выбор пары':'Choose pair'}</th><th>{ru?'Режим → формат':'Mode → format'}</th></tr></thead>
  <tbody>{rows.map(r=><tr class:list={{selected:r.pair==='C,w'}}><th scope="row"><code>{r.pair}</code></th><td>1/6</td><td>{`1/${r.denominator}`}</td></tr>)}</tbody>
 </table></div>
</Figure>
<style>
 .mode-table table{width:100%;table-layout:fixed;border-collapse:collapse;font-size:.875rem;font-variant-numeric:tabular-nums}
 .mode-table th,.mode-table td{text-align:center;padding:.5rem .3rem;line-height:1.35;border-bottom:1px solid var(--line)}
 .mode-table th{font-weight:600;overflow-wrap:anywhere}
 .mode-table code{background:none;padding:0;font-size:inherit}
 .mode-table .selected{background:color-mix(in srgb,var(--fig-blue) 10%,transparent);font-weight:700}
</style>
