---
import Figure from '../Figure.astro';
import { mulberry32 } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Bertrand's paradox: a "random chord" of the unit circle drawn in three ways. A chord is long if it is longer than
// the side of the inscribed equilateral triangle, sqrt(3), which happens when its midpoint is closer than 1/2 to the centre.
// Each method returns the angles of the two endpoints.
type Chord = [number, number];
const TAU = 2 * Math.PI;
const methods: ((r: () => number) => Chord)[] = [
  (r) => [TAU * r(), TAU * r()],
  (r) => { const phi = TAU * r(), a = Math.acos(r()); return [phi - a, phi + a]; },
  (r) => { const phi = TAU * r(), a = Math.acos(Math.sqrt(r())); return [phi - a, phi + a]; },
];
const long = ([a, b]: Chord) => 2 * Math.abs(Math.sin((a - b) / 2)) > Math.sqrt(3);
// The share of long chords in 100,000 draws of each method checks the answers quoted in the note.
const shares = methods.map((m, k) => { const r = mulberry32(11 + k); let c = 0; for (let i = 0; i < 100000; i++) if (long(m(r))) c++; return c / 100000; });
const exact = [1 / 3, 1 / 2, 1 / 4];
if (shares.some((s, k) => Math.abs(s - exact[k]) > 0.005)) throw new Error('Bertrand: simulated shares drifted from 1/3, 1/2, 1/4');
const chords = methods.map((m, k) => { const r = mulberry32(101 + k); return Array.from({ length: 40 }, () => m(r)); });
const t = ru
  ? { names: [['(а) случайные', 'концы'], ['(б) случайная точка', 'на радиусе'], ['(в) случайная', 'середина']], p: 'P(длинная)', fr: ['1/3', '1/2', '1/4'] }
  : { names: [['(a) random', 'endpoints'], ['(b) random point', 'on a radius'], ['(c) random', 'midpoint']], p: 'P(long)', fr: ['1/3', '1/2', '1/4'] };
const id = 'bertrand-chords';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 290, R: 92, c: (k: number) => [130 + k * 250, 150], text: (k: number) => [130 + k * 250, 24], wide: true },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 600, R: 80, c: (k: number) => [96, 100 + k * 200], text: (k: number) => [200, 70 + k * 200], wide: false },
];
const pt = (cx: number, cy: number, R: number, a: number) => `${(cx + R * Math.cos(a)).toFixed(1)} ${(cy - R * Math.sin(a)).toFixed(1)}`;
const tri = (cx: number, cy: number, R: number) => [0, 1, 2].map((i) => pt(cx, cy, R, Math.PI / 2 + (i * TAU) / 3)).join(' L ');
---

<Figure
  id={id}
  title={ru ? 'Парадокс Бертрана: три способа провести «случайную хорду»' : 'Bertrand\'s paradox: three ways to draw a "random chord"'}
  caption={ru
    ? 'Хорда длинная (жёлтая), если она длиннее стороны вписанного правильного треугольника, то есть её середина ближе 1/2 радиуса к центру (пунктирная окружность). (а) Два конца выбираются равномерно на окружности: длинных хорд 1/3. (б) Выбирается радиус и точка на нём, равномерно по расстоянию от центра; хорда перпендикулярна радиусу: 1/2. (в) Середина хорды выбирается равномерно в круге: 1/4. В каждом круге по 40 хорд; доли в 100 000 бросках — 0.332, 0.501 и 0.251. Все три ответа верны, потому что это три разные вероятностные модели.'
    : 'A chord is long (amber) if it is longer than the side of the inscribed equilateral triangle, which means that its midpoint is within half the radius of the centre (dashed circle). (a) Both endpoints uniform on the circle: 1/3 of the chords are long. (b) A random radius and a point on it, uniform in the distance from the centre, with the chord perpendicular to the radius: 1/2. (c) The midpoint uniform in the disk: 1/4. Each disk shows 40 chords; the shares in 100,000 draws are 0.332, 0.501 and 0.251. All three answers are right, because they are three different probability models.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Три способа выбрать случайную хорду' : 'Three ways to choose a random chord'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'Три круга с 40 хордами в каждом; доля длинных хорд 1/3, 1/2 и 1/4.' : 'Three disks with 40 chords each; the shares of long chords are 1/3, 1/2 and 1/4.'}</desc>
      {chords.map((cs, k) => {
        const [cx, cy] = L.c(k), [tx, ty] = L.text(k), R = L.R;
        return (
          <g>
            <circle cx={cx} cy={cy} r={R} class="f-line" />
            {k === 0
              ? <path class="f-thin f-muted f-dash" d={`M ${tri(cx, cy, R)} Z`} />
              : <circle cx={cx} cy={cy} r={R / 2} class="f-thin f-muted f-dash" />}
            {cs.filter((c) => !long(c)).map(([a, b]) => <path class="f-thin f-muted" style="stroke-opacity: .55" d={`M ${pt(cx, cy, R, a)} L ${pt(cx, cy, R, b)}`} />)}
            {cs.filter(long).map(([a, b]) => <path class="f-thin f-amber" style="stroke-width: 1.6" d={`M ${pt(cx, cy, R, a)} L ${pt(cx, cy, R, b)}`} />)}
            {L.wide
              ? <g>
                  <text class="f-small" x={tx} y={ty} text-anchor="middle">{t.names[k].join(' ')}</text>
                  <text class="f-label" x={cx} y={cy + R + 30} text-anchor="middle">{`${t.p} = ${t.fr[k]}`}</text>
                </g>
              : <g>
                  <text class="f-small" x={tx} y={ty}>{t.names[k][0]}</text>
                  <text class="f-small" x={tx} y={ty + 19}>{t.names[k][1]}</text>
                  <text class="f-label" x={tx} y={ty + 52}>{`${t.p} = ${t.fr[k]}`}</text>
                </g>}
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
