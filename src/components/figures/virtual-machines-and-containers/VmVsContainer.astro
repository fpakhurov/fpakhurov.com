---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Two virtual machines and two containers on one machine each: what every isolated unit carries with it,
// and which layer draws the boundary. Two units per side; the count only has to match the text.
const units = 2;
if (units !== 2) throw new Error('VmVsContainer: two units per side');

const t = ru
  ? {
      head: ['виртуальные машины', 'контейнеры'],
      subhead: ['у каждого гостя своё ядро', 'все контейнеры делят одно ядро'],
      hw: 'оборудование: CPU, память, устройства', hyp: 'гипервизор (VT-x, расширение H)',
      gk: 'гостевое ядро', gkSub: ['Linux', 'другая ОС'], libs: 'библиотеки', layers: 'слои образа',
      app: ['приложение A', 'приложение B'], hostK: 'одно ядро хоста', hostSub: 'пространства имён · cgroups',
      vm: 'ВМ', ct: 'контейнер',
      steps: ['одно и то же оборудование снизу', 'гипервизор делит CPU, память и устройства между гостями и перехватывает чувствительные команды', 'в каждой ВМ своё ядро, библиотеки и приложения; граница — интерфейс виртуального оборудования', 'одно ядро хоста: пространства имён дают каждому контейнеру собственный взгляд на систему, cgroups ограничивают его ресурсы', 'в контейнере только библиотеки и приложения из слоёв образа; граница — интерфейс системных вызовов'],
    }
  : {
      head: ['virtual machines', 'containers'],
      subhead: ['each guest has its own kernel', 'all containers share one kernel'],
      hw: 'hardware: CPU, memory, devices', hyp: 'hypervisor (VT-x, H extension)',
      gk: 'guest kernel', gkSub: ['Linux', 'another OS'], libs: 'libraries', layers: 'image layers',
      app: ['app A', 'app B'], hostK: 'one host kernel', hostSub: 'namespaces · cgroups',
      vm: 'VM', ct: 'container',
      steps: ['the same hardware at the bottom', 'the hypervisor divides the CPU, memory and devices among the guests and traps sensitive instructions', 'each VM has its own kernel, libraries and apps; the boundary is the virtual hardware interface', 'one host kernel: namespaces give each container its own view of the system, cgroups limit its resources', 'a container holds only libraries and apps, from image layers; the boundary is the system-call interface'],
    };

interface Panel { x: number; y: number; w: number }
interface Layout { cls: string; W: number; H: number; vm: Panel; ct: Panel; colGap: number }
const wide: Layout = { cls: 'fig-wide', W: 760, H: 352, vm: { x: 10, y: 0, w: 360 }, ct: { x: 390, y: 0, w: 360 }, colGap: 20 };
const narrow: Layout = { cls: 'fig-narrow seq-narrow', W: 360, H: 702, vm: { x: 10, y: 0, w: 340 }, ct: { x: 10, y: 356, w: 340 }, colGap: 20 };
// Vertical positions inside a panel (offsets from its top).
const Y = { head: 22, sub: 44, mark: 76, app: 88, libs: 136, gk: 184, hyp: 244, hostK: 190, hw: 296, bh: 40 };
const colW = (P: Panel, L: Layout) => (P.w - L.colGap) / 2;
const colX = (P: Panel, L: Layout, k: number) => P.x + k * (colW(P, L) + L.colGap);
const id = 'vm-vs-container';
const layouts = [wide, narrow];
---

<Figure
  id={id}
  title={ru ? 'Стек виртуальных машин и стек контейнеров' : 'The virtual-machine stack and the container stack'}
  caption={ru
    ? 'Слева две виртуальные машины, справа два контейнера, на одинаковом оборудовании (1). Гипервизор делит оборудование между гостями (2), и каждая ВМ несёт своё ядро: граница изоляции (пунктир) проходит по интерфейсу виртуального оборудования (3). Контейнеры работают на одном ядре хоста, которое с помощью пространств имён даёт каждому из них собственный взгляд на систему, а с помощью cgroups ограничивает их ресурсы (4); в контейнере только библиотеки и приложения, и его граница — интерфейс системных вызовов общего ядра (5).'
    : 'Two virtual machines on the left, two containers on the right, on the same hardware (1). The hypervisor divides the hardware among the guests (2), and each VM carries its own kernel: the isolation boundary (dashed) is the virtual hardware interface (3). The containers run on one host kernel, which gives them separate views of the system with namespaces and limits their resources with cgroups (4); a container holds only libraries and apps, and its boundary is the system-call interface of the shared kernel (5).'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Что входит в виртуальную машину и что в контейнер' : 'What a virtual machine contains and what a container contains'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Два стека блоков. Виртуальные машины: снизу оборудование, над ним гипервизор, над ним две колонки, в каждой гостевое ядро, библиотеки и приложение, обведённые пунктиром. Контейнеры: снизу оборудование, над ним одно ядро хоста с пространствами имён и cgroups, над ним две колонки, в каждой слои образа и приложение, обведённые пунктиром.'
        : 'Two stacks of boxes. Virtual machines: hardware at the bottom, a hypervisor above it, and above that two columns, each with a guest kernel, libraries and an app, outlined with a dashed line. Containers: hardware at the bottom, one host kernel with namespaces and cgroups above it, and above that two columns, each with image layers and an app, outlined with a dashed line.'}</desc>

      {[L.vm, L.ct].map((P, side) => (
        <g>
          <text class="f-label" x={P.x} y={P.y + Y.head} style="font-weight: 650">{t.head[side]}</text>
          <text class="f-small f-t-muted" x={P.x} y={P.y + Y.sub}>{t.subhead[side]}</text>
          <g data-s="1">
            <Box x={P.x} y={P.y + Y.hw} w={P.w} h={Y.bh} label={t.hw} />
            <Badge x={P.x + 2} y={P.y + Y.hw + 2} n={1} />
          </g>
        </g>
      ))}

      <g data-s="2">
        <Box x={L.vm.x} y={L.vm.y + Y.hyp} w={L.vm.w} h={Y.bh} label={t.hyp} tone="g" />
        <Badge x={L.vm.x + 2} y={L.vm.y + Y.hyp + 2} n={2} />
      </g>
      <g data-s="3">
        {[0, 1].map((k) => (
          <g>
            <rect x={colX(L.vm, L, k) - 5} y={L.vm.y + Y.app - 8} width={colW(L.vm, L) + 10} height={Y.gk + Y.bh + 8 + 6 - (Y.app - 8)} rx="9" class="f-line f-amber f-dash" style="fill: none; stroke-width: 1.3" />
            <Box x={colX(L.vm, L, k)} y={L.vm.y + Y.app} w={colW(L.vm, L)} h={Y.bh} label={t.app[k]} tone="y" />
            <Box x={colX(L.vm, L, k)} y={L.vm.y + Y.libs} w={colW(L.vm, L)} h={Y.bh} label={t.libs} />
            <Box x={colX(L.vm, L, k)} y={L.vm.y + Y.gk} w={colW(L.vm, L)} h={Y.bh + 8} label={t.gk} sub={t.gkSub[k]} tone="h" />
            <text class="f-small f-t-amber" x={colX(L.vm, L, k) + colW(L.vm, L) - 2} y={L.vm.y + Y.mark - 7} text-anchor="end">{t.vm} {k + 1}</text>
          </g>
        ))}
        <Badge x={L.vm.x + 2} y={L.vm.y + Y.app + 2} n={3} />
      </g>

      <g data-s="4">
        <Box x={L.ct.x} y={L.ct.y + Y.hostK} w={L.ct.w} h={Y.hw - Y.hostK - 6} label={t.hostK} sub={t.hostSub} tone="h" />
        <Badge x={L.ct.x + 2} y={L.ct.y + Y.hostK + 2} n={4} />
      </g>
      <g data-s="5">
        {[0, 1].map((k) => (
          <g>
            <rect x={colX(L.ct, L, k) - 5} y={L.ct.y + Y.app - 8} width={colW(L.ct, L) + 10} height={Y.libs + Y.bh + 6 - (Y.app - 8)} rx="9" class="f-line f-amber f-dash" style="fill: none; stroke-width: 1.3" />
            <Box x={colX(L.ct, L, k)} y={L.ct.y + Y.app} w={colW(L.ct, L)} h={Y.bh} label={t.app[k]} tone="y" />
            <Box x={colX(L.ct, L, k)} y={L.ct.y + Y.libs} w={colW(L.ct, L)} h={Y.bh} label={t.layers} />
            <text class="f-small f-t-amber" x={colX(L.ct, L, k) + colW(L.ct, L) - 2} y={L.ct.y + Y.mark - 7} text-anchor="end">{t.ct} {k + 1}</text>
          </g>
        ))}
        <Badge x={L.ct.x + 2} y={L.ct.y + Y.app + 2} n={5} />
      </g>
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
