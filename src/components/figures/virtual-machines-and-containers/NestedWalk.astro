---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One TLB miss under two-stage translation, Sv39 in the guest and Sv39x4 in the host: 3 levels each.
// Every guest page-table entry sits at a guest-physical address, so the host walks its 3 levels before the guest
// entry can be read; the data's own guest-physical address needs one more host walk. The cells are numbered in the
// order of the reads, and the count is checked against (n + 1)(m + 1) - 1.
const n = 3, m = 3;
type Cell = { kind: 'host' | 'guest' | 'data'; num: number };
const rows: Cell[][] = [];
let k = 0;
for (let r = 0; r <= n; r++) {
  const row: Cell[] = [];
  for (let c = 0; c < m; c++) row.push({ kind: 'host', num: ++k });
  row.push(r < n ? { kind: 'guest', num: ++k } : { kind: 'data', num: 0 });
  rows.push(row);
}
if (k !== (n + 1) * (m + 1) - 1 || k !== 15) throw new Error(`NestedWalk: ${k} reads`);
const tone = { host: toneVar.h, guest: toneVar.g, data: toneVar.y };

const t = ru
  ? {
      cols: ['хост, уровень 2', 'хост, уровень 1', 'хост, уровень 0', 'запись гостя'],
      colsShort: ['хост 2', 'хост 1', 'хост 0', 'PTE гостя'],
      rows: ['таблица гостя, уровень 2', 'таблица гостя, уровень 1', 'таблица гостя, уровень 0', 'адрес данных (gPA)'],
      data: 'данные',
      note: [`без виртуализации: ${n} чтения`, `вложенный обход: (${n}+1)(${m}+1) − 1 = ${k} чтений`, 'попадание в TLB: ни одного'],
      steps: ['корневая таблица гостя лежит по гостевому физическому адресу: хост проходит 3 уровня (чтения 1–3), затем читается запись гостя (4)', 'то же для таблицы гостя уровня 1 (5–8)', 'то же для таблицы уровня 0 (9–12)', 'гостевой физический адрес самих данных требует ещё одного обхода хоста (13–15); затем читаются данные'],
    }
  : {
      cols: ['host level 2', 'host level 1', 'host level 0', 'guest entry'],
      colsShort: ['host 2', 'host 1', 'host 0', 'guest PTE'],
      rows: ['guest table, level 2', 'guest table, level 1', 'guest table, level 0', 'data address (gPA)'],
      data: 'data',
      note: [`native: ${n} reads`, `nested: (${n}+1)(${m}+1) − 1 = ${k} reads`, 'TLB hit: none'],
      steps: ['the guest\'s root table is at a guest-physical address: the host walks its 3 levels (reads 1–3), then the guest entry is read (4)', 'the same for the guest\'s level-1 table (5–8)', 'the same for the level-0 table (9–12)', 'the data\'s own guest-physical address needs one more host walk (13–15); then the data is read'],
    };

interface Layout {
  cls: string; W: number; H: number; wide: boolean;
  x0: number; cw: number; chh: number; gap: number; headY: number; rowY: (r: number) => number; labelAt: (r: number) => [number, number];
  badgeAt: (r: number) => [number, number]; noteAt: [number, number]; noteStep: number; noteJoin: boolean;
}
const wide: Layout = {
  cls: 'fig-wide', W: 760, H: 298, wide: true,
  x0: 210, cw: 104, chh: 40, gap: 8, headY: 34,
  rowY: (r) => 48 + r * 52, labelAt: (r) => [32, 48 + r * 52 + 25], badgeAt: (r) => [16, 48 + r * 52 + 20],
  noteAt: [20, 280], noteStep: 0, noteJoin: true,
};
const narrow: Layout = {
  cls: 'fig-narrow seq-narrow', W: 360, H: 420, wide: false,
  x0: 20, cw: 74, chh: 40, gap: 6, headY: 34,
  rowY: (r) => 72 + r * 74, labelAt: (r) => [36, 72 + r * 74 - 9], badgeAt: (r) => [22, 72 + r * 74 - 14],
  noteAt: [20, 362], noteStep: 22, noteJoin: false,
};
const cx = (L: Layout, c: number) => L.x0 + c * (L.cw + L.gap);
const id = 'nested-walk';
const layouts = [wide, narrow];
---

<Figure
  id={id}
  title={ru ? 'Двумерный обход таблиц страниц при промахе TLB в виртуальной машине' : 'The two-dimensional page walk of a TLB miss in a virtual machine'}
  caption={ru
    ? `Трёхуровневые таблицы в госте (Sv39) и в хосте (Sv39x4). Каждая запись таблицы гостя лежит по гостевому физическому адресу, поэтому перед её чтением (жёлтые клетки) хост проходит свои три уровня (синие клетки); адрес самих данных требует ещё одного обхода хоста. Номера клеток — порядок чтений: ${k} чтений таблиц вместо ${n} без виртуализации. Для четырёх уровней в каждой стадии получается 24.`
    : `Three-level tables in the guest (Sv39) and in the host (Sv39x4). Every entry of a guest table lives at a guest-physical address, so before it can be read (amber cells) the host walks its own three levels (blue cells); the address of the data itself needs one more host walk. The numbers give the order of the reads: ${k} page-table reads instead of ${n} without virtualization. With four levels at each stage the count is 24.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? `${k} чтений таблиц страниц за один промах TLB` : `${k} page-table reads for one TLB miss`}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Сетка из четырёх строк и четырёх столбцов. Строки: таблицы гостя уровней 2, 1, 0 и адрес данных. В каждой строке три синие клетки обхода хоста и затем жёлтая клетка чтения записи гостя; в последней строке вместо неё красная клетка данных. Клетки пронумерованы от 1 до 15.'
        : 'A grid of four rows and four columns. Rows: the guest tables of levels 2, 1 and 0, and the data address. Each row has three blue cells for the host walk, then an amber cell for reading the guest entry; in the last row a red data cell takes its place. The cells are numbered 1 to 15.'}</desc>

      {(L.wide ? t.cols : t.colsShort).map((h, c) => (
        <text class="f-small f-t-muted" x={cx(L, c) + L.cw / 2} y={L.headY} text-anchor="middle">{h}</text>
      ))}
      {rows.map((row, r) => (
        <g data-s={`${r + 1}`}>
          <text class="f-small" x={L.labelAt(r)[0]} y={L.labelAt(r)[1]}>{t.rows[r]}</text>
          {row.map((cell, c) => (
            <g>
              <rect x={cx(L, c)} y={L.rowY(r)} width={L.cw} height={L.chh} rx="5" style={`fill: ${tone[cell.kind]}; fill-opacity: 0.16; stroke: ${tone[cell.kind]}; stroke-width: 1.2`} />
              <text class="f-label" x={cx(L, c) + L.cw / 2} y={L.rowY(r) + L.chh / 2 + 5} text-anchor="middle">{cell.kind === 'data' ? t.data : cell.num}</text>
            </g>
          ))}
          <Badge x={L.badgeAt(r)[0]} y={L.badgeAt(r)[1]} n={r + 1} />
        </g>
      ))}
      {L.noteJoin
        ? <text class="f-small f-t-muted" x={L.noteAt[0]} y={L.noteAt[1]}>{t.note.join('   ·   ')}</text>
        : t.note.map((line, i) => <text class="f-small f-t-muted" x={L.noteAt[0]} y={L.noteAt[1] + i * L.noteStep}>{line}</text>)}
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
