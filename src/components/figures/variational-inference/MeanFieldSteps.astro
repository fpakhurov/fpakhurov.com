---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale, polyline } from '../geometry';
import { exact, cavi, exactContour, mfContour, type MF } from './ng';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Mean-field variational inference for the normal model with unknown mean μ and precision λ (eight points, normal–gamma prior):
// coordinate ascent alternates the closed-form updates of q(μ) and q(λ). Start: q(μ) = N(1.4, 0.2²), q(λ) = Gamma(6.5, 6.5/1.2).
const start: MF = { m: 1.4, lam: 25, a: 6.5, b: 6.5 / 1.2 };
const run = cavi(start, 30);
const qs = [run[0], run[1], run[2], run[run.length - 1]];
const Et = (q: MF) => q.a / q.b, sd = (q: MF) => 1 / Math.sqrt(q.lam);
if (exact.m.toFixed(3) !== '0.478' || exact.sdMu.toFixed(3) !== '0.449' || exact.Etau.toFixed(3) !== '0.661') throw new Error('MeanFieldSteps: exact posterior drifted from the note');
if (run[1].lam.toFixed(1) !== '10.8' || Et(run[2]).toFixed(3) !== '0.685' || sd(run[1]).toFixed(3) !== '0.304') throw new Error('MeanFieldSteps: first updates drifted from the note');
if (Et(qs[3]).toFixed(3) !== '0.661' || sd(qs[3]).toFixed(3) !== '0.410') throw new Error('MeanFieldSteps: fixed point drifted from the note');

const t = ru
  ? {
      title: 'Покоординатный подъём для q(μ) q(λ)',
      ex: 'точное апостериорное p(μ, λ | X)', mf: 'среднее поле q(μ) q(λ)', lv: 'контуры: e^(−1/2) и e^(−2) от максимума',
      steps: [
        'старт: q(μ) = N(1.4, 0.2²), у q(λ) среднее 1.2',
        'обновление q(μ): среднее 0.478 (точное апостериорное среднее), обратная дисперсия (κ₀ + n) E[λ] = 10.8',
        'обновление q(λ): E[λ] падает до 0.685',
        'после сходимости: E[λ] = 0.661, как у точного апостериорного; стандартное отклонение μ 0.410 против точного 0.449',
      ],
      desc: 'Плоскость (μ, λ). Синие контуры точного апостериорного распределения наклонены: при малых λ оно шире по μ. Красные контуры факторизованного q — эллипсы с осями вдоль координат; они переходят из правого верхнего угла к центру апостериорного и в конце оказываются уже его по μ.',
    }
  : {
      title: 'Coordinate ascent for q(μ) q(λ)',
      ex: 'exact posterior p(μ, λ | X)', mf: 'mean field q(μ) q(λ)', lv: 'contours at e^(−1/2), e^(−2) of the maximum',
      steps: [
        'start: q(μ) = N(1.4, 0.2²), q(λ) with mean 1.2',
        'update q(μ): mean 0.478 (the exact posterior mean), precision (κ₀ + n) E[λ] = 10.8',
        'update q(λ): E[λ] falls to 0.685',
        'after convergence: E[λ] = 0.661, as in the exact posterior; the standard deviation of μ is 0.410 against the exact 0.449',
      ],
      desc: 'The (μ, λ) plane. The blue contours of the exact posterior are tilted: at small λ it is wider in μ. The red contours of the factorized q have axes along the coordinates; they move from the upper right to the centre of the posterior and end narrower than it in μ.',
    };
const id = 'mean-field-steps';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 400, x0: 56, x1: 584, y0: 20, y1: 316, leg: [[56, 368], [320, 368], [56, 390]] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 470, x0: 44, x1: 344, y0: 20, y1: 300, leg: [[16, 364], [16, 388], [16, 412]] },
];
const ex1 = exactContour(0.5), ex2 = exactContour(2);
const qc = qs.map((q) => mfContour(q, 0.5)), qf2 = mfContour(qs[3], 2);
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? `Восемь наблюдений, априорное μ | λ ~ N(0, 1/λ), λ ~ Gamma(2, 2). Синим — точное апостериорное распределение (нормальное–гамма): среднее μ ${exact.m.toFixed(3)}, E[λ] = ${exact.Etau.toFixed(3)}, стандартное отклонение μ ${exact.sdMu.toFixed(3)}. Красным — q(μ) q(λ) после каждого обновления (шаги 1–3, пунктир) и после сходимости (шаг 4, сплошная линия). Каждое обновление применяет формулу log qⱼ = E₋ⱼ[log p] + const к одному множителю, поэтому контур q движется то по горизонтали, то по вертикали. В пределе среднее и E[λ] совпадают с точными, а стандартное отклонение μ равно ${sd(qs[3]).toFixed(3)}: q не может передать, что при малых λ апостериорное шире по μ.`
    : `Eight observations, prior μ | λ ~ N(0, 1/λ), λ ~ Gamma(2, 2). Blue: the exact posterior (normal–gamma), with mean of μ ${exact.m.toFixed(3)}, E[λ] = ${exact.Etau.toFixed(3)} and standard deviation of μ ${exact.sdMu.toFixed(3)}. Red: q(μ) q(λ) after each update (steps 1–3, dashed) and after convergence (step 4, solid). Each update is the formula log qⱼ = E₋ⱼ[log p] + const and changes one factor only, so the contour of q moves alternately along μ and along λ. In the limit the mean and E[λ] are exact and the standard deviation of μ is ${sd(qs[3]).toFixed(3)}: q cannot express that the posterior is wider in μ where λ is small.`}
>
  {layouts.map((L) => {
    const sx = scale([-0.8, 2.0], [L.x0, L.x1]), sy = scale([0, 2.0], [L.y1, L.y0]);
    const P = (c: [number, number][]) => polyline(c.map(([m, v]) => [sx(m), sy(v)]));
    const ext = (c: [number, number][], side: 1 | -1) => c.reduce((b, p) => (side * p[0] > side * b[0] ? p : b), c[0]);
    const badgeAt = (i: number): [number, number] => {
      const p = ext(qc[i], i === 2 ? -1 : 1);
      return [sx(p[0]) + (i === 2 ? -15 : 15), sy(p[1])];
    };
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        {[0, 0.5, 1, 1.5, 2].map((v) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} />
            <text class="f-note" x={L.x0 - 6} y={sy(v) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        {[-0.5, 0, 0.5, 1, 1.5, 2].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{String(v).replace('-', '−')}</text>)}
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        <text class="f-label" x={L.x1} y={L.y1 + 40} text-anchor="end">μ</text>
        <text class="f-label" x={L.x0 + 8} y={L.y0 + 14}>λ</text>
        <path class="f-line f-blue" d={P(ex1)} />
        <path class="f-line f-blue f-dash" d={P(ex2)} />
        {[0, 1, 2].map((i) => (
          <g data-s={String(i + 1)}>
            <path class="f-line f-red f-dash" style="stroke-width: 1.4" d={P(qc[i])} />
            <Badge x={badgeAt(i)[0]} y={badgeAt(i)[1]} n={i + 1} />
          </g>
        ))}
        <g data-s="4">
          <path class="f-line f-red f-bold" d={P(qc[3])} />
          <path class="f-line f-red f-dot" d={P(qf2)} />
          <Badge x={badgeAt(3)[0]} y={badgeAt(3)[1]} n={4} />
        </g>
        <path class="f-line f-blue" d={`M ${L.leg[0][0]} ${L.leg[0][1] - 4} h 22`} />
        <text class="f-small" x={L.leg[0][0] + 30} y={L.leg[0][1]}>{t.ex}</text>
        <path class="f-line f-red" d={`M ${L.leg[1][0]} ${L.leg[1][1] - 4} h 22`} />
        <text class="f-small" x={L.leg[1][0] + 30} y={L.leg[1][1]}>{t.mf}</text>
        <text class="f-small f-t-muted" x={L.leg[2][0]} y={L.leg[2][1]}>{t.lv}</text>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
