---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Fraction of a 2 GHz CPU spent on input at a given data rate, in the model of the note (the same constants
// as the Code section): poll 100 cycles, at least 1000 polls per second; interrupt 1000 cycles per 4-byte
// transfer; DMA 2000 + 1000 cycles per 4 KiB block.
const F = 2e9, POLL = 100, IRQ = 1000, SETUP = 2000, WORD = 4, BLOCK = 4096, IDLE = 1000;
const methods = [
  { key: 'poll', f: (r: number) => (POLL * Math.max(IDLE, r / WORD)) / F, cls: 'f-amber', tcls: 'f-t-amber' },
  { key: 'irq', f: (r: number) => (IRQ * r) / WORD / F, cls: 'f-red', tcls: 'f-t-red' },
  { key: 'dma', f: (r: number) => ((SETUP + IRQ) * r) / BLOCK / F, cls: 'f-green', tcls: 'f-t-green' },
];
const disk = 200e6, keyboard = 10 * WORD;
const check = (v: number, s: string) => { if (v.toExponential(2) !== s) throw new Error(`I/O model ${v} vs ${s}`); };
check(methods[0].f(disk), '2.50e+0'); check(methods[1].f(disk), '2.50e+1'); check(methods[2].f(disk), '7.32e-2');
check(methods[0].f(keyboard), '5.00e-5'); check(methods[1].f(keyboard), '5.00e-6');
const full = [WORD * F / POLL, WORD * F / IRQ, BLOCK * F / (SETUP + IRQ)];
if (full.map((v) => v.toPrecision(3)).join() !== '8.00e+7,8.00e+6,2.73e+9') throw new Error(`saturation ${full}`);

const X0 = 0, X1 = 10, Y0 = -9, Y1 = 2;                 // log10 of bytes/s and of the CPU fraction
const names = ru
  ? { poll: 'опрос', irq: 'прерывание/слово', dma: 'DMA, блоки 4 КиБ' }
  : { poll: 'polling', irq: 'interrupt per word', dma: 'DMA, 4 KiB blocks' };
const t = ru
  ? { x: 'скорость данных, байт/с', y: 'доля времени ЦП', full: '100% ЦП', kb: 'клавиатура', disk: 'диск 200 МБ/с' }
  : { x: 'data rate, bytes/s', y: 'fraction of CPU time', full: '100 % of the CPU', kb: 'keyboard', disk: 'disk at 200 MB/s' };
const xticks = [0, 2, 4, 6, 8, 10];
const xlabel = ['1', '100', '10k', '1M', '100M', '10G'];
const yticks = [-8, -6, -4, -2, 0, 2];
const ylabel = (e: number) => (e === 0 ? '1' : e === 2 ? '100' : `1e${e}`);

// log-log samples of a method's cost, cut where the curve leaves the plot at the top
const curveOf = (f: (r: number) => number, sx: (v: number) => number, sy: (v: number) => number) => {
  const pts: [number, number][] = [];
  for (let i = 0; i <= 200; i++) {
    const x = X0 + ((X1 - X0) * i) / 200, y = Math.log10(f(10 ** x));
    if (y <= Y1) pts.push([sx(x), sy(y)]);
  }
  return pts;
};
interface Layout { cls: string; W: number; H: number; l: number; r: number; top: number; bottom: number; endX: number[] }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 340, l: 70, r: 580, top: 20, bottom: 290, endX: [] },
  { cls: 'fig-narrow', W: 360, H: 384, l: 52, r: 344, top: 16, bottom: 270, endX: [] },
];
const id = 'io-overhead';
---

<Figure
  id={id}
  title={ru ? 'Сколько ЦП стоит ввод: опрос, прерывания и DMA' : 'What input costs the CPU: polling, interrupts and DMA'}
  caption={ru
    ? `Доля времени ЦП 2 ГГц, уходящая на ввод, в зависимости от скорости данных; обе оси логарифмические. Модель из текста: опрос стоит 100 тактов и выполняется не реже 1000 раз в секунду, прерывание — 1000 тактов на 4-байтовое слово, DMA — 3000 тактов на блок 4 КиБ. Прерывания дешевле опроса только ниже 400 байт/с; опросу и прерываниям не хватает целого ЦП выше 80 и 8 МБ/с, DMA — только выше 2.73 ГБ/с. Точки: клавиатура (10 нажатий в секунду) и диск со скоростью 200 МБ/с.`
    : `The fraction of a 2 GHz CPU spent on input, against the data rate; both axes are logarithmic. The model of the text: a poll costs 100 cycles and happens at least 1000 times a second, an interrupt costs 1000 cycles per 4-byte word, DMA 3000 cycles per 4 KiB block. Interrupts are cheaper than polling only below 400 bytes/s; polling and interrupts need more than a whole CPU above 80 and 8 MB/s, DMA only above 2.73 GB/s. Points: a keyboard (10 key presses a second) and a disk at 200 MB/s.`}
>
  {layouts.map((L) => {
    const sx = scale([X0, X1], [L.l, L.r]), sy = scale([Y0, Y1], [L.bottom, L.top]);
    const lines = methods.map((m) => curveOf(m.f, sx, sy));
    const narrow = L.cls !== 'fig-wide';
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Доля ЦП на ввод в зависимости от скорости данных' : 'CPU fraction spent on input against the data rate'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Логарифмический график. Линия опроса горизонтальна до 4000 байт/с, затем растёт и пересекает уровень 100% при 80 МБ/с. Линия прерываний растёт пропорционально скорости, идёт ниже опроса до 400 байт/с и выше после, и пересекает 100% при 8 МБ/с. Линия DMA примерно в 340 раз ниже линии прерываний. Отмечены клавиатура и диск 200 МБ/с.'
          : 'A log-log plot. The polling line is flat up to 4000 bytes/s, then rises and crosses the 100 % level at 80 MB/s. The interrupt line rises in proportion to the rate, lies below polling up to 400 bytes/s and above it after, and crosses 100 % at 8 MB/s. The DMA line lies about 340 times below the interrupt line. A keyboard and a 200 MB/s disk are marked.'}</desc>
        {yticks.map((e) => <path class="f-grid" d={`M ${L.l} ${sy(e)} H ${L.r}`} />)}
        {xticks.map((e) => <path class="f-grid" d={`M ${sx(e)} ${L.top} V ${L.bottom}`} />)}
        <path class="f-axis" d={`M ${L.l} ${L.top} V ${L.bottom} H ${L.r}`} />
        {xticks.map((e, k) => <text class="f-small f-t-muted" x={sx(e)} y={L.bottom + 18} text-anchor="middle">{xlabel[k]}</text>)}
        {yticks.map((e) => <text class="f-small f-t-muted" x={L.l - 6} y={sy(e) + 4} text-anchor="end">{ylabel(e)}</text>)}
        <text class="f-small f-t-muted" x={(L.l + L.r) / 2} y={L.bottom + 40} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.l + 6} y={L.top + 12}>{t.y}</text>
        <path class="f-line f-muted f-dash" d={`M ${L.l} ${sy(0)} H ${L.r}`} />
        <text class="f-small f-t-muted f-halo" x={L.l + 6} y={sy(0) - 6}>{t.full}</text>
        {lines.map((pts, k) => <path class={`f-line f-bold ${methods[k].cls}`} d={polyline(pts)} />)}
        {[keyboard, disk].map((r, j) => (
          <g>
            <path class="f-thin f-muted f-dot" d={`M ${sx(Math.log10(r))} ${L.top + 18} V ${L.bottom}`} />
            <text class="f-small f-t-muted f-halo" x={sx(Math.log10(r)) + (j ? -4 : 4)} y={L.bottom - 8} text-anchor={j ? 'end' : 'start'}>{j ? t.disk : t.kb}</text>
            {methods.map((m) => <circle cx={sx(Math.log10(r))} cy={sy(Math.log10(m.f(r)))} r="4" class={`${m.cls}`} style="fill: var(--paper); stroke-width: 2" />)}
          </g>
        ))}
        {methods.map((m, k) => {
          const lx = narrow ? L.l : L.r + 14, ly = narrow ? L.bottom + 64 + k * 20 : L.top + 50 + k * 22;
          return (
            <g>
              <path class={`f-line f-bold ${m.cls}`} d={`M ${lx} ${ly - 4} h 22`} />
              <text class={`f-small ${m.tcls}`} x={lx + 30} y={ly} style="font-weight: 650">{names[m.key as keyof typeof names]}</text>
            </g>
          );
        })}
      </svg>
    );
  })}
</Figure>
