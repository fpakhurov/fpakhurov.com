---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// CPU cycles to bring one 4 KiB block in, with the model of the note: a poll costs 100 cycles, an interrupt
// 1000, a DMA transfer 2000 to set up plus one completion interrupt; programmed I/O moves 4 bytes at a time.
const POLL = 100, IRQ = 1000, SETUP = 2000, WORD = 4, BLOCK = 4096;
const words = BLOCK / WORD;
const cost = [words * POLL, words * IRQ, SETUP + IRQ];
if (cost.join() !== '102400,1024000,3000') throw new Error(`I/O costs ${cost}`);
const fmt = (n: number) => n.toLocaleString('en-US').replace(/,/g, ru ? ' ' : ',');

const t = ru
  ? { titles: ['опрос', 'прерывания', 'DMA'], cpu: 'ЦП', mem: 'память', dev: 'устройство', devSub: 'статус, данные', dmaSub: '+ DMA',
      cost: (n: number) => `${fmt(n)} тактов ЦП`, per: 'на блок 4 КиБ',
      steps: ['опрос: ЦП снова и снова читает регистр состояния, пока устройство не будет готово',
        'ЦП читает регистр данных и сам записывает слово в память; так 1024 раза на блок',
        'прерывания: готовое устройство выставляет запрос прерывания, а до тех пор ЦП занят другой работой',
        'обработчик читает регистр данных, записывает слово в память и возвращает управление; одно прерывание на слово',
        'DMA: ЦП записывает в регистры контроллера DMA адрес буфера, длину и команду запуска',
        'контроллер сам переносит весь блок между устройством и памятью по шине',
        'в конце блока одно прерывание сообщает ЦП, что данные в памяти'] }
  : { titles: ['polling', 'interrupts', 'DMA'], cpu: 'CPU', mem: 'memory', dev: 'device', devSub: 'status, data', dmaSub: '+ DMA engine',
      cost: (n: number) => `${fmt(n)} CPU cycles`, per: 'per 4 KiB block',
      steps: ['polling: the CPU reads the status register again and again until the device is ready',
        'the CPU reads the data register and stores the word to memory itself; 1024 times per block',
        'interrupts: the ready device raises an interrupt request; meanwhile the CPU does other work',
        'the handler reads the data register, stores the word to memory and returns; one interrupt per word',
        'DMA: the CPU writes the buffer address, the length and a start command into the controller registers',
        'the controller moves the whole block between the device and memory over the bus by itself',
        'at the end of the block, one interrupt tells the CPU that the data is in memory'] };

interface Panel { px: number; py: number; pw: number }
interface Layout { cls: string; W: number; H: number; wide: boolean; panels: Panel[]; ph: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 290, wide: true, ph: 290, panels: [0, 1, 2].map((k) => ({ px: 6 + k * 252, py: 0, pw: 244 })) },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 744, wide: false, ph: 248, panels: [0, 1, 2].map((k) => ({ px: 0, py: k * 248, pw: 360 })) },
];
const id = 'io-methods';
---

<Figure
  id={id}
  title={ru ? 'Три способа ввода: опрос, прерывания и DMA' : 'Three ways to bring data in: polling, interrupts and DMA'}
  caption={ru
    ? `Один и тот же ввод блока 4 КиБ с устройства, тремя способами. Числа внизу — время ЦП на блок в модели из текста: опрос стоит 100 тактов, прерывание 1000, запуск DMA 2000 плюс одно прерывание в конце, а без DMA ЦП переносит по 4 байта за раз. При опросе ЦП занят всё время ожидания; с прерываниями он свободен между словами, но платит за каждое слово; с DMA он платит дважды за весь блок.`
    : `The same input of a 4 KiB block from a device, three ways. The numbers at the bottom are the CPU time per block in the model of the text: a poll costs 100 cycles, an interrupt 1000, starting a DMA transfer 2000 plus one interrupt at the end, and without DMA the CPU moves 4 bytes at a time. With polling the CPU is busy for the whole wait; with interrupts it is free between words but pays for every word; with DMA it pays twice for the whole block.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Опрос, прерывания и DMA' : 'Polling, interrupts and DMA'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? `Три панели, в каждой ЦП сверху, память слева внизу и устройство справа внизу. Опрос: пунктирная стрелка от ЦП к устройству (чтение регистра состояния), стрелки от устройства к ЦП и от ЦП к памяти; ${fmt(cost[0])} тактов на блок. Прерывания: красная стрелка от устройства к ЦП, затем данные через ЦП в память; ${fmt(cost[1])} тактов. DMA: стрелка от ЦП к контроллеру, толстая стрелка от устройства прямо в память и красная стрелка прерывания к ЦП; ${fmt(cost[2])} тактов.`
        : `Three panels, each with the CPU at the top, memory at the bottom left and the device at the bottom right. Polling: a dashed arrow from the CPU to the device (status reads), arrows from the device to the CPU and from the CPU to memory; ${fmt(cost[0])} cycles per block. Interrupts: a red arrow from the device to the CPU, then data through the CPU into memory; ${fmt(cost[1])} cycles. DMA: an arrow from the CPU to the controller, a thick arrow from the device straight into memory, and a red interrupt arrow to the CPU; ${fmt(cost[2])} cycles.`}</desc>
      {L.panels.map(({ px, py, pw }, k) => {
        const cx = px + pw / 2, cpuW = L.wide ? 96 : 120, cpuTop = py + 36, cpuBot = cpuTop + 40;
        const bw = pw * 0.4, bh = 46, by = py + (L.wide ? 150 : 128);
        const mx = px + pw * 0.05, dx = px + pw * 0.55;
        const mc = mx + bw / 2, dc = dx + bw / 2;
        const s0 = [1, 3, 5][k];
        return (
          <g>
            {k !== 0 && (L.wide
              ? <path class="f-thin f-muted" d={`M ${px - 4} 12 V ${L.ph - 12}`} style="stroke-dasharray: 3 4" />
              : <path class="f-thin f-muted" d={`M 12 ${py} H ${L.W - 12}`} style="stroke-dasharray: 3 4" />)}
            <text class="f-label" x={px + 10} y={py + 24} style="font-weight: 650">{t.titles[k]}</text>
            <Box x={cx - cpuW / 2} y={cpuTop} w={cpuW} h={40} label={t.cpu} tone="h" />
            <Box x={mx} y={by} w={bw} h={bh} label={t.mem} tone="h" />
            <Box x={dx} y={by} w={bw} h={bh} label={t.dev} sub={k === 2 ? t.dmaSub : t.devSub} tone="x" subGap={14} />
            {k === 0 && (
              <g>
                <g data-s="1">
                  <Arrow pts={[[cx + 20, cpuBot + 2], [dc - 6, by - 3]]} dashed tone="muted" />
                  <Badge x={(cx + 20 + dc) / 2 + 16} y={(cpuBot + by) / 2 - 6} n={1} />
                </g>
                <g data-s="2">
                  <Arrow pts={[[dc + 10, by - 2], [cx + 36, cpuBot + 3]]} tone="green" bold />
                  <Arrow pts={[[cx - 20, cpuBot + 2], [mc, by - 3]]} tone="blue" bold />
                  <Badge x={(cx - 20 + mc) / 2 - 16} y={(cpuBot + by) / 2 - 6} n={2} />
                </g>
              </g>
            )}
            {k === 1 && (
              <g>
                <g data-s="3">
                  <Arrow pts={[[dc - 6, by - 2], [cx + 20, cpuBot + 3]]} tone="red" bold />
                  <Badge x={(cx + 20 + dc) / 2 - 2} y={(cpuBot + by) / 2 + 14} n={3} />
                </g>
                <g data-s="4">
                  <Arrow pts={[[dc + 10, by - 2], [cx + 36, cpuBot + 3]]} tone="green" bold />
                  <Arrow pts={[[cx - 20, cpuBot + 2], [mc, by - 3]]} tone="blue" bold />
                  <Badge x={(cx - 20 + mc) / 2 - 16} y={(cpuBot + by) / 2 - 6} n={4} />
                </g>
              </g>
            )}
            {k === 2 && (
              <g>
                <g data-s="5">
                  <Arrow pts={[[cx + 20, cpuBot + 2], [dc - 6, by - 3]]} tone="blue" />
                  <Badge x={(cx + 20 + dc) / 2 + 16} y={(cpuBot + by) / 2 - 6} n={5} />
                </g>
                <g data-s="6">
                  <Arrow pts={[[dx - 2, by + bh / 2], [mx + bw + 3, by + bh / 2]]} tone="green" bold />
                  <Badge x={(mx + bw + dx) / 2} y={by + bh + 16} n={6} />
                </g>
                <g data-s="7">
                  <Arrow pts={[[dc + 14, by - 2], [cx + 38, cpuBot + 3]]} tone="red" bold />
                  <Badge x={dc + 26} y={(cpuBot + by) / 2 + 8} n={7} />
                </g>
              </g>
            )}
            <text class="f-small" x={px + 10} y={by + bh + (L.wide ? 50 : 44)} style="font-weight: 650" data-s={String(s0 + (k === 2 ? 2 : 1))}>{t.cost(cost[k])}</text>
            <text class="f-small f-t-muted" x={px + 10} y={by + bh + (L.wide ? 68 : 62)}>{t.per}</text>
          </g>
        );
      })}
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
