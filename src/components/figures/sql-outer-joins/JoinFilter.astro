---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? 'Место фильтра меняет состав отчёта' : 'Filter placement changes which products appear';
const caption = ru
  ? 'Порог quantity ≥ 3 в ON сохраняет четыре товара. Порог в WHERE оставляет одну строку какао.'
  : 'Putting quantity ≥ 3 in ON preserves four products. Putting it in WHERE leaves one row for cocoa.';
const desc = ru
  ? 'В первом результате у какао одна позиция, у кофе, мяты и чая ноль. Во втором кофе, мяты и чая нет.'
  : 'In the first result cocoa has one line and coffee, mint and tea have zero. In the second result coffee, mint and tea are absent.';
const products = [
  ['cocoa', 1, true],
  ['coffee', 0, false],
  ['mint', 0, false],
  ['tea', 0, false],
] as const;
---
<Figure id="sql-outer-join-filter" title={title} caption={caption}>
  <svg viewBox="0 0 340 181" role="img" aria-labelledby="sql-outer-join-filter-title sql-outer-join-filter-desc" style="max-width: 550px; margin-inline: auto">
    <title id="sql-outer-join-filter-title">{title}</title>
    <desc id="sql-outer-join-filter-desc">{desc}</desc>
    <text class="f-label" x="55" y="29" text-anchor="middle">product</text>
    <text class="f-label" x="154" y="29" text-anchor="middle">ON</text>
    <text class="f-label" x="265" y="29" text-anchor="middle">WHERE</text>
    {products.map(([product, count, present], i) => (
      <g transform={`translate(0 ${i * 33})`}>
        <text class="f-label" x="55" y="60" text-anchor="middle">{product}</text>
        <rect class="f-fill-green" x="106" y="41" width="96" height="28" rx="5" />
        <rect class={present ? 'f-fill-green' : 'f-fill-amber'} x="217" y="41" width="96" height="28" rx="5" />
        <text class="f-label" x="154" y="60" text-anchor="middle">{count}</text>
        <text class="f-label" x="265" y="60" text-anchor="middle">{present ? count : ru ? 'Нет строки' : 'No row'}</text>
      </g>
    ))}
  </svg>
</Figure>
