---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { labels, scores, lambdas } from './toy';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The running query again: labels (0, 3, 1, 0, 2, 0) at positions 1–6, scores 2.5, 2.0, ..., 0.0. For each document
// the total force λ_i: positive pushes it up the list, negative down. RankNet weights every misordered pair alike;
// LambdaRank multiplies each pair by |ΔNDCG|, the change in NDCG if the two documents swapped places.
const { rank, lam } = lambdas(labels, scores);
const fmt = (v: number, k: number) => (v >= 0 ? '+' : '−') + Math.abs(v).toFixed(k);
const checks = [rank.map((v) => v.toFixed(3)).join(' '), lam.map((v) => v.toFixed(3)).join(' ')].join(' | ');
if (checks !== '-2.234 1.571 0.182 -1.269 2.429 -0.679 | -0.383 0.286 -0.005 -0.052 0.184 -0.031') throw new Error(`LambdaBars: values drifted from the note (${checks})`);
if (!(rank[4] > rank[1] && lam[1] > lam[4])) throw new Error('LambdaBars: the two methods should disagree on which relevant document to push hardest');
const panels = [
  { vals: rank, k: 2, title: ru ? 'RankNet: все пары равноправны' : 'RankNet: every pair counts alike' },
  { vals: lam, k: 3, title: ru ? 'LambdaRank: пары взвешены |ΔNDCG|' : 'LambdaRank: pairs weighted by |ΔNDCG|' },
];
const t = ru ? { up: 'вверх', down: 'вниз' } : { up: 'up', down: 'down' };
const id = 'lambda-bars';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 300, boxes: [[70, 40, 290, 200], [450, 40, 290, 200]] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 600, boxes: [[66, 40, 286, 200], [66, 340, 286, 200]] },
];
---

<Figure
  id={id}
  title={ru ? 'Силы λ на документах запроса: RankNet и LambdaRank' : 'The forces λ on the documents of one query: RankNet and LambdaRank'}
  caption={ru
    ? `Шесть документов запроса из примера в текущем порядке, места 1–6 слева направо (метки 0, 3, 1, 0, 2, 0; оценки 2.5, 2.0, …, 0.0). Столбец вверх — сила, поднимающая документ в списке, вниз — опускающая; синие — релевантные документы, серые — нерелевантные. У каждой панели своя шкала. RankNet сильнее всего толкает документ с меткой 2 на пятом месте (${fmt(rank[4], 3)}): над ним три документа с меньшими метками. LambdaRank сильнее всего толкает документ с меткой 3 на втором месте (${fmt(lam[1], 3)} против ${fmt(lam[4], 3)}): обмен с первым местом даёт самый большой прирост NDCG.`
    : `The six documents of the running query in their current order, positions 1 to 6 from left to right (labels 0, 3, 1, 0, 2, 0; scores 2.5, 2.0, …, 0.0). A bar above the line is a force that pushes the document up the list, below the line down; blue documents are relevant, grey ones are not. Each panel has its own scale. RankNet pushes hardest on the label-2 document in fifth place (${fmt(rank[4], 3)}), which has three less relevant documents above it. LambdaRank pushes hardest on the label-3 document in second place (${fmt(lam[1], 3)} against ${fmt(lam[4], 3)}): swapping it with the first place gains the most NDCG.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Два столбчатых графика сил λ' : 'Two bar charts of the forces λ'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'У RankNet самый высокий столбец у пятого документа, у LambdaRank — у второго; первый документ в обоих случаях толкается вниз.' : 'For RankNet the tallest upward bar is the fifth document, for LambdaRank the second; the first document is pushed down in both.'}</desc>
      {panels.map((pn, pi) => {
        const [bx, by, bw, bh] = L.boxes[pi];
        const mx = Math.max(...pn.vals.map(Math.abs));
        const sy = scale([-mx, mx], [by + bh - 18, by + 18]);
        const slot = bw / labels.length;
        return (
          <g>
            <text class="f-small" x={bx + bw / 2} y={by - 14} text-anchor="middle">{pn.title}</text>
            <path class="f-axis" d={`M ${bx} ${sy(0)} H ${bx + bw}`} />
            <text class="f-small f-t-muted" x={bx - 8} y={by + 22} text-anchor="end">{`↑ ${t.up}`}</text>
            <text class="f-small f-t-muted" x={bx - 8} y={by + bh - 14} text-anchor="end">{`↓ ${t.down}`}</text>
            {pn.vals.map((v, i) => {
              const cx = bx + slot * (i + 0.5);
              const y0 = sy(0), y1 = sy(v);
              const tone = labels[i] > 0 ? 'var(--fig-blue)' : 'var(--muted)';
              return (
                <g>
                  <rect x={cx - 15} y={Math.min(y0, y1)} width="30" height={Math.max(Math.abs(y1 - y0), 0.8)} rx="2" style={`fill: ${tone}; fill-opacity: ${labels[i] > 0 ? 0.75 : 0.45}`} />
                  <text class="f-small" x={cx} y={v >= 0 ? y1 - 6 : y1 + 15} text-anchor="middle">{fmt(v, pn.k)}</text>
                  <text class="f-note" x={cx} y={by + bh + 16} text-anchor="middle">{i + 1}</text>
                  <text class="f-small f-t-muted" x={cx} y={by + bh + 34} text-anchor="middle">{`y=${labels[i]}`}</text>
                </g>
              );
            })}
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
