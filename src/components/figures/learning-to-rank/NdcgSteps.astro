---
import Figure from '../Figure.astro';
import { scale, plot } from '../geometry';
import { labels, scores, ndcg, ranknetLoss } from './toy';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The running query: six documents with labels (0, 3, 1, 0, 2, 0) at scores (2.5, 2.0, 1.5, 1.0, 0.5, 0.0).
// Only the score s of the label-3 document moves; the other five stay fixed. NDCG@6 is constant between the other
// scores and jumps when s crosses one of them; the RankNet loss of the query decreases smoothly in s.
const mover = 1;
const at = (s: number) => scores.map((v, i) => (i === mover ? s : v));
const N = (s: number) => ndcg(labels, at(s));
const C = (s: number) => ranknetLoss(labels, at(s));
const s0 = scores[mover];
const h = 1e-5;
const slope = (C(s0 + h) - C(s0 - h)) / (2 * h);
const others = scores.map((v, i) => ({ v, y: labels[i] })).filter((_, i) => i !== mover).sort((a, b) => a.v - b.v);
const xr: [number, number] = [-1, 3.5];
const cuts = [xr[0], ...others.map((o) => o.v), xr[1]];
const steps = cuts.slice(0, -1).map((a, k) => ({ a, b: cuts[k + 1], v: N((a + cuts[k + 1]) / 2) }));
const checks = [N(s0).toFixed(3), C(s0).toFixed(3), slope.toFixed(3), N(3).toFixed(3), N(-0.5).toFixed(3)].join();
if (checks !== '0.647,8.967,-1.571,0.922,0.470') throw new Error(`NdcgSteps: values drifted from the note (${checks})`);
const nz = steps.slice(1).map((st, k) => st.v - steps[k].v);
if (!nz.every((d) => d > 0)) throw new Error('NdcgSteps: NDCG should rise at every crossing');

const t = ru
  ? { x: 'оценка s документа с меткой 3', n: 'NDCG@6', c: 'функция потерь RankNet', now: 'при s = 2', slope: `наклон ${slope.toFixed(2)}`, y: 'y' }
  : { x: 'score s of the label-3 document', n: 'NDCG@6', c: 'RankNet loss', now: 'at s = 2', slope: `slope ${slope.toFixed(2)}`, y: 'y' };
const id = 'ndcg-steps';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 340, x0: 70, x1: 730, top: [34, 140] as [number, number], bot: [176, 282] as [number, number] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 380, x0: 52, x1: 344, top: [34, 154] as [number, number], bot: [194, 312] as [number, number] },
];
---

<Figure
  id={id}
  title={ru ? 'NDCG — ступенчатая функция оценок, функция потерь RankNet — гладкая' : 'NDCG is a step function of the scores; the RankNet loss is smooth'}
  caption={ru
    ? `Запрос из примера: шесть документов с метками (0, 3, 1, 0, 2, 0) и оценками (2.5, 2.0, 1.5, 1.0, 0.5, 0.0). Меняется только оценка s документа с меткой 3, остальные пять неподвижны (пунктирные линии с их метками). NDCG@6 (сверху) постоянен между оценками остальных документов и меняется скачком, когда s пересекает одну из них: при s = 2 он равен ${N(s0).toFixed(3)}, а выше 2.5, на первом месте, — ${N(3).toFixed(3)}. Его производная почти везде равна нулю. Функция потерь RankNet для запроса (снизу) убывает гладко; её наклон при s = 2 равен ${slope.toFixed(3)}, то есть минус сила λ этого документа.`
    : `The running query: six documents with labels (0, 3, 1, 0, 2, 0) and scores (2.5, 2.0, 1.5, 1.0, 0.5, 0.0). Only the score s of the label-3 document moves; the other five stay where they are (dotted lines, marked with their labels). NDCG@6 (top) is constant between the other scores and jumps when s crosses one of them: ${N(s0).toFixed(3)} at s = 2, and ${N(3).toFixed(3)} above 2.5, in first place. Its derivative is zero almost everywhere. The RankNet loss of the query (bottom) decreases smoothly; its slope at s = 2 is ${slope.toFixed(3)}, minus the force λ on this document.`}
>
  {layouts.map((L) => {
    const sx = scale(xr, [L.x0, L.x1]);
    const syN = scale([0.4, 1.0], [L.top[1], L.top[0]]);
    const syC = scale([6, 17], [L.bot[1], L.bot[0]]);
    const ticks = [-1, 0, 1, 2, 3];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'NDCG и функция потерь RankNet как функции одной оценки' : 'NDCG and the RankNet loss as functions of one score'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? `Сверху ступенчатая кривая NDCG от ${steps[0].v.toFixed(2)} до ${steps[steps.length - 1].v.toFixed(2)}, снизу гладко убывающая кривая функции потерь.` : `Top: a staircase of NDCG from ${steps[0].v.toFixed(2)} to ${steps[steps.length - 1].v.toFixed(2)}; bottom: a smoothly decreasing loss curve.`}</desc>
        {others.map((o) => (
          <g>
            <path class="f-thin f-muted f-dot" d={`M ${sx(o.v)} ${L.top[0] - 4} V ${L.bot[1]}`} />
            <text class="f-small f-t-muted" x={sx(o.v)} y={L.top[0] - 10} text-anchor="middle">{`${t.y}=${o.y}`}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${L.x0} ${L.top[1]} H ${L.x1}`} />
        <path class="f-axis" d={`M ${L.x0} ${L.bot[1]} H ${L.x1}`} />
        {[0.4, 0.7, 1.0].map((v) => <g><path class="f-grid" d={`M ${L.x0} ${syN(v)} H ${L.x1}`} /><text class="f-note" x={L.x0 - 6} y={syN(v) + 5} text-anchor="end">{v.toFixed(1)}</text></g>)}
        {[6, 10, 14].map((v) => <g><path class="f-grid" d={`M ${L.x0} ${syC(v)} H ${L.x1}`} /><text class="f-note" x={L.x0 - 6} y={syC(v) + 5} text-anchor="end">{v}</text></g>)}
        {ticks.map((v) => <text class="f-note" x={sx(v)} y={L.bot[1] + 18} text-anchor="middle">{v}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.bot[1] + 40} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-blue" x={L.x0 + 6} y={L.top[0] + 12}>{t.n}</text>
        <text class="f-small f-t-red" x={L.x1 - 6} y={L.bot[0] + 12} text-anchor="end">{t.c}</text>
        {steps.map((st, k) => (
          <g>
            <path class="f-line f-blue" d={`M ${sx(st.a)} ${syN(st.v)} H ${sx(st.b)}`} />
            {k > 0 && <path class="f-thin f-blue f-dash" d={`M ${sx(st.a)} ${syN(steps[k - 1].v)} V ${syN(st.v)}`} />}
          </g>
        ))}
        <path class="f-line f-red" d={plot(C, xr[0], xr[1], sx, syC, 200)} />
        <path class="f-thin f-dash" d={`M ${sx(s0)} ${L.top[0] - 4} V ${L.bot[1]}`} />
        <circle cx={sx(s0)} cy={syN(N(s0))} r="4" class="f-solid-blue" />
        <circle cx={sx(s0)} cy={syC(C(s0))} r="4" class="f-solid-red" />
        <path class="f-thin f-red" d={`M ${sx(s0 - 0.45)} ${syC(C(s0) - 0.45 * slope)} L ${sx(s0 + 0.45)} ${syC(C(s0) + 0.45 * slope)}`} />
        <text class="f-small f-t-blue f-halo" x={sx(s0) - 8} y={syN(N(s0)) - 10} text-anchor="end">{`${N(s0).toFixed(3)} ${t.now}`}</text>
        <text class="f-small f-t-red f-halo" x={sx(s0) - 10} y={syC(C(s0)) + 22} text-anchor="end">{`${C(s0).toFixed(2)}, ${t.slope}`}</text>
      </svg>
    );
  })}
</Figure>
