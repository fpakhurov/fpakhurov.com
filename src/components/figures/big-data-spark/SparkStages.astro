---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? "Shuffle разделяет два этапа" : "The shuffle divides two stages";
const caption = ru ? "Фильтрация выполняется в каждой входной задаче. Shuffle передаёт блоки двух групп выходным задачам." : "Filtering runs in each input task. The shuffle passes grouped blocks to the two output tasks.";
const desc = ru ? "У первого этапа четыре входные задачи с фильтрацией и объединением. Shuffle связывает их с двумя задачами второго этапа." : "The first stage has four input tasks and combines values. The shuffle connects them to two result tasks in the second stage.";
---
<Figure id="bd-spark-stages" title={title} caption={caption}>
  <svg viewBox="0 0 340 216" role="img" aria-labelledby="bd-spark-stages-title bd-spark-stages-desc" style="max-width: 550px; margin-inline: auto">
    <title id="bd-spark-stages-title">{title}</title>
    <desc id="bd-spark-stages-desc">{desc}</desc>
    <text class="f-label" x="170" y="22" text-anchor="middle">{ru ? 'Фильтр · 4 задачи' : 'Filter · 4 tasks'}</text>
    {[0, 1, 2, 3].map((i) => (
      <g transform={`translate(${i * 83} 0)`}>
        <rect class="f-fill-blue" x="12" y="35" width="68" height="30" rx="5" />
        <text class="f-label" x="46" y="55" text-anchor="middle">P{i}</text>
        <path class="f-line" d="M 46 67 V 87" fill="none" />
      </g>
    ))}
    <rect class="f-fill-amber" x="12" y="91" width="317" height="35" rx="5" />
    <text class="f-label" x="170" y="114" text-anchor="middle">Shuffle</text>
    {[0, 1].map((i) => (
      <g transform={`translate(${i * 138} 0)`}>
        <path class="f-line" d="M 101 128 V 149" fill="none" />
        <rect class="f-fill-green" x="53" y="153" width="96" height="30" rx="5" />
        <text class="f-label" x="101" y="173" text-anchor="middle">R{i}</text>
      </g>
    ))}
    <text class="f-label" x="170" y="203" text-anchor="middle">{ru ? 'Итоги · 2 задачи' : 'Totals · 2 tasks'}</text>
  </svg>
</Figure>
