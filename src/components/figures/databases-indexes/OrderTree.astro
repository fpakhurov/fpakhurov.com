---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? "Поиск заказа 103" : "Search for order 103";
const caption = ru ? "Разделитель направляет поиск в правый лист. В листе есть два адреса в куче для ключа 103." : "The separator directs the search to the right leaf. The leaf gives two heap addresses for key 103.";
const desc = ru ? "Разделитель 103 в корне направляет поиск этого ключа вправо. Две записи с ключом 103 ссылаются на адреса 8/2 и 9/1 в куче." : "Root separator 103 sends a search for that key to the right. The two entries for 103 refer to heap addresses 8/2 and 9/1.";
---
<Figure id="db-order-tree" title={title} caption={caption}>
  <svg viewBox="0 0 340 207" role="img" aria-labelledby="db-order-tree-title db-order-tree-desc" style="max-width: 550px; margin-inline: auto">
    <title id="db-order-tree-title">{title}</title>
    <desc id="db-order-tree-desc">{desc}</desc>
    <rect class="f-fill-blue" x="119" y="11" width="102" height="32" rx="5" />
    <text class="f-label" x="170" y="32" text-anchor="middle">{ru ? 'Корень 103' : 'Root 103'}</text>
    <path class="f-line" d="M 145 45 L 74 67 M 195 45 L 251 67" fill="none" />
    <rect class="f-fill-blue" x="9" y="70" width="128" height="44" rx="5" />
    <rect class="f-fill-green" x="151" y="70" width="180" height="44" rx="5" />
    <text class="f-label" x="73" y="97" text-anchor="middle">101 · 101 · 102</text>
    <text class="f-label" x="241" y="97" text-anchor="middle">103 · 103 · 104</text>
    <path class="f-line" d="M 205 116 L 206 150 M 248 116 L 288 150" fill="none" />
    <rect class="f-fill-green" x="159" y="152" width="94" height="37" rx="5" />
    <rect class="f-fill-green" x="258" y="152" width="73" height="37" rx="5" />
    <text class="f-label" x="206" y="175" text-anchor="middle">{ru ? 'Куча 8/2' : 'Heap 8/2'}</text>
    <text class="f-label" x="294" y="175" text-anchor="middle">{ru ? 'Куча 9/1' : 'Heap 9/1'}</text>
  </svg>
</Figure>
