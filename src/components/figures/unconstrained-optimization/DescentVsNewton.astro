---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

type V = [number, number];
// Left: q(x) = ½ xᵀAx with A = R diag(1, 10) Rᵀ, R a rotation by 30°, minimum at 0, start x0 = R (2, 0.2).
// Gradient descent with exact line search (t = gᵀg / gᵀAg) until q falls below 1e-6 q(x0); Newton: one step.
const th = Math.PI / 6, c = Math.cos(th), s = Math.sin(th);
const mu = 1, L = 10;
const A = [[mu * c * c + L * s * s, (mu - L) * c * s], [(mu - L) * c * s, mu * s * s + L * c * c]];
const Ax = (x: V): V => [A[0][0] * x[0] + A[0][1] * x[1], A[1][0] * x[0] + A[1][1] * x[1]];
const q = (x: V) => 0.5 * (x[0] * Ax(x)[0] + x[1] * Ax(x)[1]);
const x0: V = [2 * c - 0.2 * s, 2 * s + 0.2 * c];
const path: V[] = [x0];
let xk: V = x0;
while (q(xk) > 1e-6 * q(x0)) {
  const g = Ax(xk), Ag = Ax(g);
  const t = (g[0] * g[0] + g[1] * g[1]) / (g[0] * Ag[0] + g[1] * Ag[1]);
  xk = [xk[0] - t * g[0], xk[1] - t * g[1]];
  path.push(xk);
}
const ratio = q(path[1]) / q(path[0]);
const ellipse = (lev: number) => Array.from({ length: 121 }, (_, k) => {
  const a = (2 * Math.PI * k) / 120, y1 = Math.sqrt((2 * lev) / mu) * Math.cos(a), y2 = Math.sqrt((2 * lev) / L) * Math.sin(a);
  return [c * y1 - s * y2, s * y1 + c * y2] as V;
});

// Right: the penalized logistic loss of the baseline on 40 deterministic points.
const n = 40, lam = 0.01;
const X: V[] = [], y: number[] = [];
for (let k = 1; k <= n; k += 1) {
  const x1 = 2 * ((k * 0.6180339887498949) % 1) - 1, x2 = 10 * (2 * ((k * 0.7548776662466927) % 1) - 1);
  const noise = ((k * 0.4142135623730951) % 1) - 0.5;
  X.push([x1, x2]); y.push(x1 + 0.1 * x2 + noise > 0 ? 1 : -1);
}
const F = (w: V) => {
  let sum = 0;
  for (let i = 0; i < n; i += 1) { const m = y[i] * (w[0] * X[i][0] + w[1] * X[i][1]); sum += Math.max(-m, 0) + Math.log1p(Math.exp(-Math.abs(m))); }
  return sum / n + (lam / 2) * (w[0] * w[0] + w[1] * w[1]);
};
const G = (w: V): V => {
  const g: V = [lam * w[0], lam * w[1]];
  for (let i = 0; i < n; i += 1) { const m = y[i] * (w[0] * X[i][0] + w[1] * X[i][1]); const r = y[i] / (1 + Math.exp(m)); g[0] -= (r * X[i][0]) / n; g[1] -= (r * X[i][1]) / n; }
  return g;
};
const newtonStep = (w: V): V => {
  const H = [[lam, 0], [0, lam]];
  for (let i = 0; i < n; i += 1) { const p = 1 / (1 + Math.exp(-(w[0] * X[i][0] + w[1] * X[i][1]))), v = p * (1 - p); H[0][0] += (v * X[i][0] * X[i][0]) / n; H[0][1] += (v * X[i][0] * X[i][1]) / n; H[1][1] += (v * X[i][1] * X[i][1]) / n; }
  H[1][0] = H[0][1];
  const g = G(w), det = H[0][0] * H[1][1] - H[0][1] * H[1][0];
  return [w[0] - (H[1][1] * g[0] - H[0][1] * g[1]) / det, w[1] - (H[0][0] * g[1] - H[1][0] * g[0]) / det];
};
let ws: V = [0, 0];
for (let k = 0; k < 30; k += 1) ws = newtonStep(ws);
const Fs = F(ws);
let sxx = 0, sxy = 0, syy = 0;
for (const x of X) { sxx += x[0] * x[0]; sxy += x[0] * x[1]; syy += x[1] * x[1]; }
const Lb = ((sxx + syy) / 2 + Math.sqrt(((sxx - syy) / 2) ** 2 + sxy * sxy)) / (4 * n) + lam;
const run = (step: (w: V) => V) => { let w: V = [0, 0]; const gaps = [F(w) - Fs]; while (gaps[gaps.length - 1] > 1e-10) { w = step(w); gaps.push(F(w) - Fs); } return gaps; };
const armijo = (w: V): V => { const g = G(w), gg = g[0] * g[0] + g[1] * g[1]; let t = 1; while (F([w[0] - t * g[0], w[1] - t * g[1]]) > F(w) - 1e-4 * t * gg) t /= 2; return [w[0] - t * g[0], w[1] - t * g[1]]; };
const gd = run((w) => { const g = G(w); return [w[0] - g[0] / Lb, w[1] - g[1] / Lb]; });
const ar = run(armijo);
const nt = run(newtonStep);
const got = [path.length - 1, ratio.toFixed(3), ws[0].toFixed(4), ws[1].toFixed(4), Lb.toFixed(3), gd.length - 1, ar.length - 1, nt.length - 1, gd[0].toFixed(2), nt[5] < 1e-14].join(' ');
if (got !== '35 0.669 3.4682 0.3803 7.898 2727 526 5 0.38 true') throw new Error(`DescentVsNewton: numbers drifted: ${got}`);

const series = [
  { gaps: gd, cls: 'f-line f-blue', tcls: 'f-t-blue', en: 'gradient descent, η = 1/L: 2,727', ru: 'градиентный спуск, η = 1/L: 2727' },
  { gaps: ar, cls: 'f-line f-green', tcls: 'f-t-green', en: 'with Armijo backtracking: 526', ru: 'с поиском с возвратом (Армихо): 526' },
  { gaps: nt, cls: 'f-line f-red', tcls: 'f-t-red', en: 'Newton: 5', ru: 'Ньютон: 5' },
];
const pow10 = (v: number) => (v === 0 ? '1' : '10' + String(v).split('').map((ch) => ({ '-': '⁻', '0': '⁰', '1': '¹', '2': '²', '4': '⁴', '6': '⁶', '8': '⁸' } as Record<string, string>)[ch]).join(''));
const id = 'descent-vs-newton';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 420, unit: 76, box: [30, 46] as V, plot: [480, 740, 46, 290], lg: [480, 360], lgStep: 22, leg: 300 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 800, unit: 74, box: [24, 46] as V, plot: [62, 340, 360, 640], lg: [30, 712], lgStep: 26, leg: 290 },
];
const dom = { x: [-2.1, 2.1] as V, y: [-1.45, 1.45] as V };
const levels = [0.05, 0.2, 0.6, 1.2, q(x0)];
const T = ru
  ? { left: 'κ = 10: спуск зигзагом, Ньютон за шаг', right: 'логистическая функция потерь', gd: 'спуск: 35 шагов', nt: 'Ньютон: 1 шаг', xl: 'итерация k (лог. шкала)', yl: 'f − f*' }
  : { left: 'κ = 10: descent zigzags, Newton jumps', right: 'logistic loss of the baseline', gd: 'descent: 35 steps', nt: 'Newton: 1 step', xl: 'iteration k (log scale)', yl: 'f − f*' };
---

<Figure
  id={id}
  title={ru ? 'Градиентный спуск и метод Ньютона' : 'Gradient descent against Newton’s method'}
  caption={ru
    ? 'Слева квадратичная функция с собственными значениями гессиана 1 и 10, оси повёрнуты на 30°, минимум в нуле. Градиентный спуск с точным поиском вдоль градиента (синий) делает каждый шаг перпендикулярным предыдущему и умножает f на 0.669 за шаг; до уменьшения в миллион раз нужно 35 шагов. Шаг Ньютона (красная стрелка) сразу попадает в минимум. Справа логистическая функция потерь с L2-штрафом из начала заметки, f − f* = 0.38 в начале, в логарифмическом масштабе по обеим осям; число в подписи — шаги до f − f* ≤ 10⁻¹⁰. Спуск с шагом 1/L (L = 7.898) идёт линейно и медленно, с поиском с возвратом по Армихо — быстрее, а метод Ньютона после двух-трёх шагов удваивает число верных знаков на каждом шаге.'
    : 'Left, a quadratic with Hessian eigenvalues 1 and 10, axes turned by 30°, minimum at the origin. Gradient descent with an exact line search along the gradient (blue) makes each step perpendicular to the previous one and reduces f by the factor 0.669 per step; a millionfold reduction takes 35 steps. The Newton step (red arrow) lands on the minimum at once. Right, the L2-penalized logistic loss of the baseline, f − f* = 0.38 at the start, with both axes logarithmic; the numbers in the legend are the steps until f − f* ≤ 10⁻¹⁰. Descent with the step 1/L (L = 7.898) converges linearly and slowly, with Armijo backtracking faster, and Newton’s method, after two or three steps, doubles the number of correct digits at every step.'}
>
  {layouts.map((Ly) => {
    const [bx, by] = Ly.box;
    const w = Ly.unit * (dom.x[1] - dom.x[0]), h = Ly.unit * (dom.y[1] - dom.y[0]);
    const sx = scale(dom.x, [bx, bx + w]), sy = scale(dom.y, [by + h, by]);
    const S = (v: V): V => [sx(v[0]), sy(v[1])];
    const [px0, px1, py0, py1] = Ly.plot;
    const lx = scale([0, Math.log10(3000)], [px0, px1]), ly = scale([-16, 0], [py1, py0]);
    const P = (k: number, g: number): V => [lx(Math.log10(k)), ly(Math.max(-16, Math.log10(g)))];
    const clip = `${id}-${Ly.sfx}-clip`;
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{ru ? 'Зигзаг градиентного спуска и шаг Ньютона; скорость сходимости' : 'The zigzag of gradient descent, the Newton step, and convergence speeds'}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{ru
          ? 'Слева вытянутые эллипсы линий уровня; синяя ломаная зигзагом идёт к центру, красная стрелка ведёт в центр одним отрезком. Справа три кривые ошибки от номера итерации: синяя медленно опускается за тысячи шагов, зелёная быстрее, красная обрывается вниз за пять шагов.'
          : 'Left, elongated elliptical contours; a blue zigzag approaches the centre, a red arrow reaches the centre in one segment. Right, three error curves against the iteration number: the blue one descends slowly over thousands of steps, the green one faster, the red one drops off a cliff within five steps.'}</desc>
        <defs><clipPath id={clip}><rect x={bx} y={by} width={w} height={h} /></clipPath></defs>
        <text class="f-small" x={bx + w / 2} y={by - 14} text-anchor="middle">{T.left}</text>
        <rect x={bx} y={by} width={w} height={h} class="f-box-soft" style="fill: none" />
        <g clip-path={`url(#${clip})`}>
          {levels.map((lev) => <path class="f-thin f-muted" style="stroke-opacity: .55" d={polyline(ellipse(lev).map(S)) + ' Z'} />)}
          <path class="f-line f-blue" d={polyline(path.map(S))} />
          {path.slice(0, 12).map((v) => <circle cx={S(v)[0]} cy={S(v)[1]} r="2.6" class="f-solid-blue" />)}
          <path class="f-line f-red f-bold" d={polyline([S(x0), S([0.07 * x0[0], 0.07 * x0[1]])])} marker-end="url(#f-arrow-red)" />
        </g>
        <circle cx={S(x0)[0]} cy={S(x0)[1]} r="4.5" class="f-solid-muted" style="fill: var(--ink)" />
        <circle cx={S([0, 0])[0]} cy={S([0, 0])[1]} r="4" class="f-solid-red" />
        <path class="f-line f-blue" d={`M ${bx} ${Ly.leg - 4} h 22`} />
        <text class="f-small f-t-blue" x={bx + 28} y={Ly.leg}>{T.gd}</text>
        <path class="f-line f-red f-bold" d={`M ${bx} ${Ly.leg + Ly.lgStep - 4} h 22`} />
        <text class="f-small f-t-red" x={bx + 28} y={Ly.leg + Ly.lgStep}>{T.nt}</text>
        <text class="f-note f-halo" x={S(x0)[0] + 8} y={S(x0)[1] - 8}>x₀</text>

        <text class="f-small" x={(px0 + px1) / 2} y={py0 - 14} text-anchor="middle">{T.right}</text>
        {[-4, -8, -12].map((v) => <path class="f-grid" d={`M ${px0} ${ly(v)} H ${px1}`} />)}
        <path class="f-axis" d={`M ${px0} ${py0} V ${py1} H ${px1}`} />
        {[0, -4, -8, -12, -16].map((v) => <text class="f-note" x={px0 - 6} y={ly(v) + 5} text-anchor="end">{pow10(v)}</text>)}
        {[1, 10, 100, 1000].map((k) => <text class="f-note" x={lx(Math.log10(k))} y={py1 + 18} text-anchor="middle">{k}</text>)}
        <text class="f-small" x={(px0 + px1) / 2} y={py1 + 40} text-anchor="middle">{T.xl}</text>
        <text class="f-small" x={px0 - 6} y={py0 - 14} text-anchor="end">{T.yl}</text>
        {series.map((sr) => <path class={sr.cls} d={polyline(sr.gaps.slice(1).map((g, i) => P(i + 1, g)))} />)}
        {nt.slice(1).map((g, i) => <circle cx={P(i + 1, g)[0]} cy={P(i + 1, g)[1]} r="3" class="f-solid-red" />)}
        {series.map((sr, i) => (
          <g>
            <path class={sr.cls} d={`M ${Ly.lg[0]} ${Ly.lg[1] + i * Ly.lgStep - 4} h 22`} />
            <text class={`f-small ${sr.tcls}`} x={Ly.lg[0] + 28} y={Ly.lg[1] + i * Ly.lgStep}>{ru ? sr.ru : sr.en}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
