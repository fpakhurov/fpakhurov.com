---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? "Продажа использует раннюю версию" : "The sale uses the earlier version";
const caption = ru ? "Граница категорий — 10 января. Опоздавшая продажа пришла 12 января, но её событие было 9 января. Расстояния между датами условны." : "The category boundary is 10 January. The late sale arrived on 12 January, but its event date is 9 January. The date spacing is schematic.";
const desc = ru ? "Версия 7 действует с 1 до 10 января. Версия 8 начинается 10 января. Продажа 9 января относится к версии 7, хотя поступила 12 января." : "Version 7 is valid from January 1 up to January 10. Version 8 starts on January 10. The January 9 sale matches version 7 despite arriving January 12.";
---
<Figure id="bd-dimension-timeline" title={title} caption={caption}>
  <svg viewBox="0 0 340 201" role="img" aria-labelledby="bd-dimension-timeline-title bd-dimension-timeline-desc" style="max-width: 550px; margin-inline: auto">
    <title id="bd-dimension-timeline-title">{title}</title>
    <desc id="bd-dimension-timeline-desc">{desc}</desc>
    <rect class="f-fill-blue" x="22" y="31" width="148" height="39" rx="5" />
    <rect class="f-fill-green" x="170" y="31" width="149" height="39" rx="5" />
    <text class="f-label" x="96" y="56" text-anchor="middle">7 · Drinks</text>
    <text class="f-label" x="244" y="56" text-anchor="middle">8 · Gifts</text>
    <path class="f-line" d="M 170 22 V 82 M 112 72 V 86 M 272 72 V 86" fill="none" />
    <text class="f-label" x="22" y="104" text-anchor="middle">01.01</text>
    <text class="f-label" x="112" y="104" text-anchor="middle">09.01</text>
    <text class="f-label" x="170" y="104" text-anchor="middle">10.01</text>
    <text class="f-label" x="272" y="104" text-anchor="middle">12.01</text>
    <text class="f-label" x="112" y="132" text-anchor="middle">{ru ? 'Продажа' : 'Sale'}</text>
    <text class="f-label" x="272" y="132" text-anchor="middle">{ru ? 'Получение' : 'Arrival'}</text>
    <path class="f-line" d="M 115 147 H 270 M 265 142 L 270 147 L 265 152" fill="none" />
    <text class="f-label" x="192" y="172" text-anchor="middle">{ru ? 'Задержка доставки' : 'Delivery delay'}</text>
  </svg>
</Figure>
