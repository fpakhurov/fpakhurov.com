---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The allocator of the note's Code section, re-run here: a 128-byte array, a 4-byte padding word, 4-byte headers
// and footers holding size | allocated bit, block sizes multiples of 8 with a minimum of 16, first fit, splitting,
// coalescing with both neighbours, and a 4-byte end marker. Each state is checked against the C program's output.
const HEAP = 128;
type Block = { h: number; size: number; a: boolean; name: string };
let blocks: Block[] = [{ h: 4, size: HEAP - 8, a: false, name: '' }];
const need = (n: number) => Math.max(16, Math.ceil((n + 8) / 8) * 8);
function malloc(n: number, name: string): number | null {
  const k = blocks.findIndex((b) => !b.a && b.size >= need(n));
  if (k === -1) return null;
  const b = blocks[k], sz = need(n);
  if (b.size - sz >= 16) blocks.splice(k, 1, { h: b.h, size: sz, a: true, name }, { h: b.h + sz, size: b.size - sz, a: false, name: '' });
  else blocks[k] = { ...b, a: true, name };
  return b.h + 4;
}
function free(name: string) {
  let k = blocks.findIndex((b) => b.name === name && b.a);
  blocks[k] = { ...blocks[k], a: false, name: '' };
  if (blocks[k + 1] && !blocks[k + 1].a) { blocks[k].size += blocks[k + 1].size; blocks.splice(k + 1, 1); }
  if (k > 0 && !blocks[k - 1].a) { blocks[k - 1].size += blocks[k].size; blocks.splice(k, 1); k -= 1; }
}

const states: { label: string; blocks: Block[]; note?: string }[] = [];
const snap = (label: string, note?: string) => states.push({ label, blocks: blocks.map((b) => ({ ...b })), note });
snap(ru ? 'начало' : 'start');
malloc(10, 'a'); snap('a = malloc(10)');
malloc(20, 'b'); snap('b = malloc(20)');
malloc(8, 'c'); snap('c = malloc(8)');
free('b');
const failed = malloc(60, 'x');
if (failed !== null) throw new Error('HeapBlocks: malloc(60) should fail after free(b)');
snap('free(b)', 'malloc(60) → NULL');
malloc(4, 'd'); snap('d = malloc(4)');
free('c'); snap('free(c)');
malloc(60, 'e'); snap('e = malloc(60)');

// The printed lines of the C program (Code section), block lists only.
const expected = [
  '[f 120 @8]',
  '[A 24 @8] [f 96 @32]',
  '[A 24 @8] [A 32 @32] [f 64 @64]',
  '[A 24 @8] [A 32 @32] [A 16 @64] [f 48 @80]',
  '[A 24 @8] [f 32 @32] [A 16 @64] [f 48 @80]',
  '[A 24 @8] [A 16 @32] [f 16 @48] [A 16 @64] [f 48 @80]',
  '[A 24 @8] [A 16 @32] [f 80 @48]',
  '[A 24 @8] [A 16 @32] [A 80 @48]',
];
states.forEach((s, i) => {
  const got = s.blocks.map((b) => `[${b.a ? 'A' : 'f'} ${b.size} @${b.h + 4}]`).join(' ');
  if (got !== expected[i]) throw new Error(`HeapBlocks: state ${i} is ${got}, expected ${expected[i]}`);
});
const freeBytes = states[4].blocks.filter((b) => !b.a).reduce((s, b) => s + b.size, 0);
const largest = Math.max(...states[4].blocks.filter((b) => !b.a).map((b) => b.size));
if (freeBytes !== 80 || largest !== 48 || need(60) !== 72) throw new Error('HeapBlocks: fragmentation numbers drifted');
const last = states[7].blocks;
const payload = 10 + 4 + 60, inBlocks = last.reduce((s, b) => s + b.size, 0);
if (payload !== 74 || inBlocks !== 120) throw new Error('HeapBlocks: utilization numbers drifted');

// A block is new in a state if no block with the same offset, size and status existed in the previous state.
const isNew = (i: number, b: Block) => i > 0 && !states[i - 1].blocks.some((p) => p.h === b.h && p.size === b.size && p.a === b.a);

const t = ru
  ? {
      title: 'Куча из 128 байт после каждого запроса',
      offset: 'смещение',
      legend: ['заголовок и концевая метка: размер | занятость', 'занятый блок: имя и размер', 'свободный: размер'],
      steps: ['один свободный блок 120 байт', 'a: 10 + 8 → блок 24, остаток 96 свободен', 'b: 20 + 8 → блок 32', 'c: 8 + 8 → блок 16, в конце свободно 48', 'free(b): 80 свободных байт в двух кусках, и malloc(60) не находит блока 72', 'd: первый подходящий блок — дыра 32, она делится на 16 + 16', 'free(c): слияние с обоими соседями, 16 + 16 + 48 = 80', 'e: 60 + 8 → 72; остаток 8 меньше минимума, e получает все 80 байт'],
      desc: 'Восемь горизонтальных полос, по одной на состояние кучи. Каждая полоса — массив из 128 байт: слово заполнения, блоки и метка конца. Занятые блоки синие, с именем и размером, свободные белые, с размером; у каждого блока жёлтые заголовок и концевая метка. Состояния: один свободный блок 120; a 24 и 96 свободных; затем b 32; затем c 16 и 48 свободных; после free(b) дыра 32 и 48 свободных, malloc(60) не проходит; d 16 занимает половину дыры; после free(c) три свободных блока сливаются в 80; e получает блок 80.',
    }
  : {
      title: 'A 128-byte heap after each request',
      offset: 'offset',
      legend: ['header and footer: size | allocated bit', 'allocated block: name and size', 'free block: size'],
      steps: ['one free block of 120 bytes', 'a: 10 + 8 → a 24-byte block, 96 left free', 'b: 20 + 8 → a 32-byte block', 'c: 8 + 8 → a 16-byte block, 48 free at the end', 'free(b): 80 free bytes in two pieces, so malloc(60) finds no 72', 'd: first fit reaches the 32-byte hole and splits it 16 + 16', 'free(c): coalesce with both neighbours, 16 + 16 + 48 = 80', 'e: 60 + 8 → 72; the 8 left are below the minimum, so e takes all 80'],
      desc: 'Eight horizontal bars, one per state of the heap. Each bar is the 128-byte array: a padding word, the blocks and an end marker. Allocated blocks are blue with name and size, free blocks white with their size, and every block has a yellow header and footer. The states: one free block of 120; a 24 and 96 free; then b 32; then c 16 and 48 free; after free(b) a 32-byte hole and 48 free, and malloc(60) fails; d 16 takes half of the hole; after free(c) three free blocks merge into 80; e gets the 80-byte block.',
    };

interface Layout { cls: string; W: number; H: number; wide: boolean; x0: number; x1: number; top: number; rowH: number; barY: number; barH: number; labelX: number; badgeX: number; legendY: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 430, wide: true, x0: 170, x1: 746, top: 46, rowH: 42, barY: 0, barH: 26, labelX: 34, badgeX: 14, legendY: 404 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 560, wide: false, x0: 10, x1: 350, top: 44, rowH: 56, barY: 20, barH: 24, labelX: 30, badgeX: 14, legendY: 504 },
];
const id = 'memory-allocation-heap-blocks';
const tags = toneVar.g, alloc = toneVar.h;
// wide legend: items side by side, each starting 24 px after the previous text (about 6.5 px per character)
const legendX: number[] = [];
t.legend.reduce((x, txt) => { legendX.push(x); return x + 20 + txt.length * 6.5 + 24; }, 34);
if (legendX[2] + 20 + t.legend[2].length * 6.5 > 750) throw new Error('HeapBlocks: legend too wide');
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? `Распределитель из раздела «Код»: массив из 128 байт, стратегия первого подходящего блока, заголовок и концевая метка по 4 байта, размеры блоков кратны 8 и не меньше 16. Каждая полоса — массив целиком после одного запроса; ось вверху — смещение в байтах. Жирная рамка отмечает блоки, появившиеся на этом шаге. После free(b) свободно ${freeBytes} байт, но наибольший свободный блок — ${largest}, и malloc(60), которому нужен блок 72, возвращает NULL: внешняя фрагментация. free(c) сливает свободные блоки с обеих сторон в один на 80 байт, и тот же запрос проходит. В конце ${payload} байт полезных данных занимают ${inBlocks} байт блоков.`
    : `The allocator of the Code section: a 128-byte array, first fit, 4-byte headers and footers, block sizes multiples of 8 and at least 16. Each bar is the whole array after one request; the axis on top is the byte offset. A bold outline marks the blocks created in that step. After free(b), ${freeBytes} bytes are free but the largest free block is ${largest}, so malloc(60), which needs a 72-byte block, returns NULL: external fragmentation. free(c) merges the free blocks on both sides into one of 80 bytes, and the same request then succeeds. At the end, ${payload} bytes of payload occupy ${inBlocks} bytes of blocks.`}
>
  {layouts.map((L) => {
    const sx = (off: number) => L.x0 + (off / HEAP) * (L.x1 - L.x0);
    const tw = sx(4) - sx(0);
    const ticks = L.wide ? [0, 16, 32, 48, 64, 80, 96, 112, 128] : [0, 32, 64, 96, 128];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        <text class="f-small f-t-muted" x={L.wide ? L.labelX : L.x0} y={L.wide ? 22 : 16} text-anchor="start">{t.offset}</text>
        {ticks.map((v) => (
          <g>
            <path class="f-grid" d={`M ${sx(v)} ${L.top - 8} V ${L.top + 8 * L.rowH - 6}`} />
            <text class="f-small f-t-muted" x={sx(v)} y={L.top - 12} text-anchor={v === 0 ? 'start' : v === HEAP ? 'end' : 'middle'}>{v}</text>
          </g>
        ))}
        {states.map((s, i) => {
          const y = L.top + i * L.rowH + L.barY;
          return (
            <g data-s={`${i + 1}`}>
              <Badge x={L.badgeX} y={L.wide ? y + L.barH / 2 : L.top + i * L.rowH + 6} n={i + 1} />
              <text class="f-small" x={L.labelX} y={L.wide ? y + L.barH / 2 + (s.note ? -2 : 4.5) : L.top + i * L.rowH + 11} style="font-family: var(--mono)">{s.label}</text>
              {s.note && <text class="f-small f-t-red" x={L.wide ? L.labelX : L.x1} y={L.wide ? y + L.barH / 2 + 13 : L.top + i * L.rowH + 11} text-anchor={L.wide ? 'start' : 'end'} style="font-family: var(--mono)">{s.note}</text>}
              {/* padding word and end marker */}
              <rect x={sx(0)} y={y} width={tw} height={L.barH} style="fill: var(--line); stroke: var(--muted); stroke-width: 0.8" />
              <rect x={sx(HEAP - 4)} y={y} width={tw} height={L.barH} style={`fill: ${tags}; fill-opacity: 0.55; stroke: var(--muted); stroke-width: 0.8`} />
              {s.blocks.map((b) => {
                const bx = sx(b.h), bw = sx(b.h + b.size) - bx;
                const label = b.a ? (L.wide ? `${b.name} · ${b.size}` : `${b.size}`) : `${b.size}`;
                return (
                  <g>
                    <rect x={bx} y={y} width={bw} height={L.barH} style={b.a ? `fill: ${alloc}; fill-opacity: 0.2` : 'fill: var(--paper)'} />
                    <rect x={bx} y={y} width={tw} height={L.barH} style={`fill: ${tags}; fill-opacity: 0.55`} />
                    <rect x={bx + bw - tw} y={y} width={tw} height={L.barH} style={`fill: ${tags}; fill-opacity: 0.55`} />
                    <rect x={bx} y={y} width={bw} height={L.barH} style={`fill: none; stroke: ${b.a ? alloc : 'var(--muted)'}; stroke-width: ${isNew(i, b) ? 2.4 : 1}`} />
                    <text class={`f-small${b.a ? '' : ' f-t-muted'}`} x={bx + bw / 2} y={y + L.barH / 2 + 4.5} text-anchor="middle">{label}</text>
                  </g>
                );
              })}
            </g>
          );
        })}
        {/* legend */}
        {t.legend.map((txt, k) => {
          const lx = L.wide ? legendX[k] : L.x0;
          const ly = L.wide ? L.legendY : L.legendY + k * 20;
          const fill = k === 0 ? `fill: ${tags}; fill-opacity: 0.55` : k === 1 ? `fill: ${alloc}; fill-opacity: 0.2; stroke: ${alloc}` : 'fill: var(--paper); stroke: var(--muted)';
          return (
            <g>
              <rect x={lx} y={ly - 10} width="14" height="12" style={fill} />
              <text class="f-small f-t-muted" x={lx + 20} y={ly}>{txt}</text>
            </g>
          );
        })}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
