---
// Original 36-record population and table, Fedor Pakhurov project, AI-assisted.
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
const ru = pageLang(Astro.url)==='ru';
const xs=[0,1,3],ys=[0,2,5];
const counts=[[6,4,2],[2,8,2],[4,2,6]];
const rows=counts.map(row=>row.reduce((a,b)=>a+b,0));
const columns=ys.map((_,j)=>counts.reduce((s,row)=>s+row[j],0));
const total=rows.reduce((a,b)=>a+b,0);
if(total!==36||rows.some(n=>n!==12))throw new Error('Joint population drift');
---
<Figure id="joint-table"
 title={ru?'Совместные массы из 36 записей':'Joint masses from 36 records'}
 caption={ru?'Каждая ячейка показывает число записей. Для совместной вероятности делим на 36. Условие X = 1 оставляет выделенную строку: для условных вероятностей делим её числа на 12. Итоги строк и столбцов задают маргинальные массы.':'Each cell counts records. Divide by 36 for a joint probability. Conditioning on X = 1 retains the highlighted row: divide its counts by 12 for conditional probabilities. Row and column totals give marginal masses.'}>
 <table class="joint-counts" aria-label={ru?'Числа записей для значений X и Y, с итогами':'Record counts for X and Y values, with totals'}>
  <thead><tr><th scope="col">X / Y</th>{ys.map(y=><th scope="col">{y}</th>)}<th scope="col">Σ</th></tr></thead>
  <tbody>{counts.map((row,i)=><tr class:list={{selected:xs[i]===1}} data-x={xs[i]}>
   <th scope="row">{xs[i]}</th>{row.map((n,j)=><td data-y={ys[j]}>{n}</td>)}<td class="total">{rows[i]}</td>
  </tr>)}</tbody>
  <tfoot><tr><th scope="row">Σ</th>{columns.map((n,j)=><td data-total-y={ys[j]}>{n}</td>)}<td class="total">{total}</td></tr></tfoot>
 </table>
 <p class="row-law">X = 1: (2, 8, 2) / 12 = <span>(1/6, 2/3, 1/6)</span></p>
</Figure>
<style>
 .joint-counts{display:table;table-layout:auto;width:100%;max-width:440px;margin:0 auto;border-collapse:collapse;font-variant-numeric:tabular-nums;font-size:1rem}
 .joint-counts th,.joint-counts td{padding:.65rem .25rem;text-align:center;border-bottom:1px solid var(--line);color:var(--ink)}
 .joint-counts th{font-weight:600;word-break:normal;overflow-wrap:normal}
 .joint-counts .selected{background:color-mix(in srgb,var(--fig-blue) 14%,transparent)}
 .joint-counts .selected th{color:var(--fig-blue)}
 .joint-counts .total,.joint-counts tfoot{font-weight:600;word-break:normal;overflow-wrap:normal}
 .row-law{font-size:.875rem;text-align:center;margin:1rem 0 0;color:var(--ink);text-wrap:balance}
 .row-law span{white-space:nowrap}
</style>
