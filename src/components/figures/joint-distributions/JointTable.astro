---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Two dice; X is the first, Y the larger of the two. Joint PMF in 36ths, its two marginals, and the conditional of Y given X = 3.
const faces = [1, 2, 3, 4, 5, 6];
const joint = faces.map((x) => faces.map((y) => (y < x ? 0 : y === x ? x : 1)));
const rowSums = joint.map((r) => r.reduce((a, b) => a + b, 0));
const colSums = faces.map((_, j) => joint.reduce((a, r) => a + r[j], 0));
const cond = joint[2].map((v) => (v === 0 ? '0' : `${v}/${rowSums[2]}`));
if (rowSums.join() !== '6,6,6,6,6,6' || colSums.join() !== '1,3,5,7,9,11' || cond.join() !== '0,0,3/6,1/6,1/6,1/6') throw new Error('JointTable: table drifted from the note');
const t = ru
  ? { top: 'Y — большая из двух костей', corner: 'X \\ Y', px: 'P(X)', py: 'P(Y)', pc: 'P(Y | X = 3)', unit: 'в 36-х долях',
      steps: ['совместное распределение: P(X = x, Y = y) в 36-х долях', 'маргинальные распределения: суммы по строкам и столбцам', 'условное распределение Y при X = 3: строка 3, делённая на её сумму'] }
  : { top: 'Y is the larger of the two dice', corner: 'X \\ Y', px: 'P(X)', py: 'P(Y)', pc: 'P(Y | X = 3)', unit: 'in 36ths',
      steps: ['the joint distribution: P(X = x, Y = y) in 36ths', 'the marginal distributions: sums over rows and columns', 'the conditional distribution of Y given X = 3: row 3 divided by its sum'] };
const id = 'joint-table';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 560, H: 430, x0: 160, y0: 64, c: 44 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 420, x0: 106, y0: 64, c: 34 },
];
---

<Figure
  id={id}
  title={ru ? 'Совместное, маргинальные и условное распределения двух костей' : 'Joint, marginal and conditional distributions of two dice'}
  caption={ru
    ? 'Строки — значение первой кости X, столбцы — большее из двух значений Y; в клетке — P(X = x, Y = y), умноженная на 36 (1). Сумма строки — P(X = x) = 6/36 для каждой грани, сумма столбца — P(Y = y) = (2y − 1)/36: большее из двух значений чаще бывает большим (2). Если известно, что X = 3, остаётся строка 3: Y = 3, если вторая кость не больше 3, иначе Y равно второй кости; деление на сумму строки даёт P(Y | X = 3) = 3/6, 1/6, 1/6, 1/6 (3).'
    : 'Rows are the value of the first die X, columns the larger value Y of the two; each cell holds P(X = x, Y = y) times 36 (1). A row sum is P(X = x) = 6/36 for every face; a column sum is P(Y = y) = (2y − 1)/36: the larger of two values tends to be large (2). Given X = 3, only row 3 remains: Y = 3 if the second die shows at most 3, and otherwise Y is the second die; dividing by the row sum gives P(Y | X = 3) = 3/6, 1/6, 1/6, 1/6 (3).'}
>
  {layouts.map((L) => {
    const cx = (j: number) => L.x0 + j * L.c + L.c / 2, cy = (i: number) => L.y0 + i * L.c + L.c / 2;
    const sumX = L.x0 + 6 * L.c + 26, sumY = L.y0 + 6 * L.c + 26, condY = sumY + 44;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Таблица 6 × 6 совместного распределения с суммами' : 'A 6 × 6 joint table with its sums'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'В строке x стоят нули левее диагонали, x на диагонали и единицы правее. Суммы строк равны 6, суммы столбцов 1, 3, 5, 7, 9, 11. Условное распределение при X = 3: 0, 0, 3/6, 1/6, 1/6, 1/6.' : 'Row x holds zeros left of the diagonal, x on the diagonal and ones to its right. Row sums are 6, column sums 1, 3, 5, 7, 9, 11. The conditional distribution given X = 3: 0, 0, 3/6, 1/6, 1/6, 1/6.'}</desc>
        <text class="f-small" x={L.x0 + 3 * L.c} y="22" text-anchor="middle">{t.top}</text>
        <text class="f-note" x={L.x0 - 10} y={L.y0 - 10} text-anchor="end">{t.corner}</text>
        {faces.map((f, j) => <text class="f-note" x={cx(j)} y={L.y0 - 10} text-anchor="middle">{f}</text>)}
        {faces.map((f, i) => <text class="f-note" x={L.x0 - 12} y={cy(i) + 5} text-anchor="middle">{f}</text>)}
        <g data-s="1">
          {joint.map((row, i) => row.map((v, j) => (
            <g>
              <rect x={L.x0 + j * L.c} y={L.y0 + i * L.c} width={L.c - 2} height={L.c - 2} rx="3" style={`fill: var(--fig-blue); fill-opacity: ${(0.08 + (0.55 * v) / 6).toFixed(2)}; stroke: var(--line); stroke-width: 1`} />
              <text class={v === 0 ? 'f-note' : 'f-label'} x={cx(j) - 1} y={cy(i) + 5} text-anchor="middle">{v}</text>
            </g>
          )))}
          <Badge x={L.x0 - 34} y={L.y0 + 12} n={1} />
        </g>
        <g data-s="2">
          <text class="f-note f-t-green" x={sumX} y={L.y0 - 10} text-anchor="middle">{t.px}</text>
          {rowSums.map((v, i) => <text class="f-label f-t-green" x={sumX} y={cy(i) + 5} text-anchor="middle">{v}</text>)}
          <text class="f-note f-t-green" x={L.x0 - 10} y={sumY + 5} text-anchor="end">{t.py}</text>
          {colSums.map((v, j) => <text class="f-label f-t-green" x={cx(j)} y={sumY + 5} text-anchor="middle">{v}</text>)}
          <Badge x={sumX} y={sumY} n={2} />
        </g>
        <g data-s="3">
          <rect x={L.x0 - 3} y={L.y0 + 2 * L.c - 3} width={6 * L.c + 4} height={L.c + 4} rx="5" style="fill: none; stroke: var(--fig-amber); stroke-width: 2.2" />
          <text class="f-note f-t-amber" x={L.x0 - 10} y={condY + 5} text-anchor="end">{t.pc}</text>
          {cond.map((v, j) => <text class="f-small f-t-amber" x={cx(j)} y={condY + 5} text-anchor="middle">{v}</text>)}
          <Badge x={sumX} y={condY} n={3} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
