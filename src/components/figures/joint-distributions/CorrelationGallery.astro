---
// Original finite dependence contrast, Fedor Pakhurov project, AI-assisted.
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
const ru=pageLang(Astro.url)==='ru';
const xs=[-2,0,2],ys=[-1,0,1];
const panels=[
 {id:'dependent',title:ru?'Зависимы, Cov = 0':'Dependent, Cov = 0',cells:[['1/6','0','1/6'],['0','1/3','0'],['1/6','0','1/6']]},
 {id:'independent',title:ru?'Независимы, Cov = 0':'Independent, Cov = 0',cells:[['1/9','1/9','1/9'],['1/9','1/9','1/9'],['1/9','1/9','1/9']]},
];
---
<Figure id="correlation-gallery"
 title={ru?'Одинаковые маргиналы и ковариация':'Same marginals and covariance'}
 caption={ru?'В обеих таблицах каждое значение X и Y имеет вероятность 1/3; ковариация равна нулю. В первой таблице X = 0 определяет Y = 0. Во второй условие X = 0 оставляет три равновероятных значения Y.':'In both tables every value of X and Y has probability 1/3, and covariance is zero. In the first, X = 0 determines Y = 0. In the second, conditioning on X = 0 retains three equally likely Y values.'}>
 <div class="joint-panels">{panels.map(p=><section data-pairing={p.id} aria-labelledby={`joint-${p.id}-title`}>
  <h4 id={`joint-${p.id}-title`}>{p.title}</h4>
  <table aria-label={p.title}>
   <thead><tr><th scope="col">X / Y</th>{ys.map(y=><th scope="col">{y}</th>)}</tr></thead>
   <tbody>{xs.map((x,i)=><tr class:list={{selected:x===0}} data-x={x}><th scope="row">{x}</th>{p.cells[i].map((mass,j)=><td data-y={ys[j]}>{mass}</td>)}</tr>)}</tbody>
  </table>
 </section>)}</div>
</Figure>
<style>
 .joint-panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.25rem}
 .joint-panels h4{margin:0 0 .5rem;font-size:.95rem;text-align:center;color:var(--ink)}
 .joint-panels table{display:table;table-layout:auto;width:100%;border-collapse:collapse;font-size:.95rem;font-variant-numeric:tabular-nums}
 .joint-panels td,.joint-panels th{padding:.55rem .2rem;text-align:center;border-bottom:1px solid var(--line);color:var(--ink)}
 .joint-panels th{font-weight:600;word-break:normal;overflow-wrap:normal}
 .joint-panels .selected{background:color-mix(in srgb,var(--fig-blue) 14%,transparent)}
 @media(max-width:520px){.joint-panels{grid-template-columns:1fr;max-width:360px;margin:auto}}
</style>
