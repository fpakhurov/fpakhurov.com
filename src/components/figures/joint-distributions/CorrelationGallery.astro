---
import Figure from '../Figure.astro';
import { mulberry32, normal } from '../random';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Four samples of 300 points. Only (b) has independent coordinates; (c) and (d) are strongly dependent and still
// have a correlation near 0, because correlation measures only linear dependence.
const n = 300;
const make = (seed: number, gen: (z: () => number, u: () => number) => [number, number]) => {
  const u = mulberry32(seed), z = normal(u);
  return Array.from({ length: n }, () => gen(z, u));
};
const panels = [
  { en: '(a) a line plus noise', ru: '(а) прямая и шум', pts: make(1, (z) => { const x = z(); return [x, 0.8 * x + 0.6 * z()]; }), xr: [-3, 3], yr: [-3, 3] },
  { en: '(b) independent', ru: '(б) независимые', pts: make(2, (z) => [z(), z()]), xr: [-3, 3], yr: [-3, 3] },
  { en: '(c) Y = X²', ru: '(в) Y = X²', pts: make(7, (z) => { const x = z(); return [x, x * x + 0.15 * z()]; }), xr: [-3, 3], yr: [-0.8, 8] },
  { en: '(d) a ring', ru: '(г) кольцо', pts: make(4, (z, u) => { const a = 2 * Math.PI * u(), r = 1 + 0.08 * z(); return [r * Math.cos(a), r * Math.sin(a)]; }), xr: [-1.5, 1.5], yr: [-1.5, 1.5] },
];
const corr = (p: [number, number][]) => {
  const mx = p.reduce((s, [x]) => s + x, 0) / p.length, my = p.reduce((s, [, y]) => s + y, 0) / p.length;
  let sxy = 0, sxx = 0, syy = 0;
  for (const [x, y] of p) { sxy += (x - mx) * (y - my); sxx += (x - mx) ** 2; syy += (y - my) ** 2; }
  return sxy / Math.sqrt(sxx * syy);
};
const rs = panels.map((P) => corr(P.pts));
if (Math.abs(rs[0] - 0.8) > 0.06 || rs.slice(1).some((r) => Math.abs(r) > 0.05)) throw new Error('CorrelationGallery: sample correlations drifted');
const id = 'correlation-gallery';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 240, pos: (k: number) => [14 + k * 188, 44], s: 170 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 440, pos: (k: number) => [8 + (k % 2) * 180, 44 + Math.floor(k / 2) * 210], s: 164 },
];
const inside = (P: (typeof panels)[number]) => P.pts.filter(([x, y]) => x >= P.xr[0] && x <= P.xr[1] && y >= P.yr[0] && y <= P.yr[1]);
const shown = panels.map(inside);
---

<Figure
  id={id}
  title={ru ? 'Корреляция измеряет только линейную зависимость' : 'Correlation measures only linear dependence'}
  caption={ru
    ? `По 300 точек в каждой панели, над панелью — выборочная корреляция r. (а) Y = 0.8X + шум: r = ${rs[0].toFixed(2)}. (б) Независимые X и Y: r = ${rs[1].toFixed(2)}. (в) Y = X² с небольшим шумом: Y почти полностью определяется X, а r = ${rs[2].toFixed(2)}. (г) Точки на кольце: зная X, Y ограничен двумя значениями, а r = ${rs[3].toFixed(2)}. Нулевая корреляция не означает независимости.`
    : `300 points per panel, with the sample correlation r above each. (a) Y = 0.8X + noise: r = ${rs[0].toFixed(2)}. (b) Independent X and Y: r = ${rs[1].toFixed(2)}. (c) Y = X² with a little noise: X almost determines Y, and r = ${rs[2].toFixed(2)}. (d) Points on a ring: given X, Y is one of two values, and r = ${rs[3].toFixed(2)}. Zero correlation does not mean independence.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Четыре облака точек с корреляциями' : 'Four point clouds with their correlations'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? `Корреляции: ${rs.map((r) => r.toFixed(2)).join(', ')}.` : `Correlations: ${rs.map((r) => r.toFixed(2)).join(', ')}.`}</desc>
      {panels.map((P, k) => {
        const [x0, y0] = L.pos(k);
        const sx = scale(P.xr as [number, number], [x0, x0 + L.s]), sy = scale(P.yr as [number, number], [y0 + L.s, y0]);
        return (
          <g>
            <text class="f-small" x={x0} y={y0 - 24}>{ru ? P.ru : P.en}</text>
            <text class="f-small f-t-amber" x={x0} y={y0 - 7}>{`r = ${rs[k].toFixed(2)}`}</text>
            <rect x={x0} y={y0} width={L.s} height={L.s} style="fill: none; stroke: var(--line); stroke-width: 1" />
            {shown[k].map(([x, y]) => <circle cx={sx(x).toFixed(1)} cy={sy(y).toFixed(1)} r="1.9" style="fill: var(--fig-blue); fill-opacity: .55" />)}
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
