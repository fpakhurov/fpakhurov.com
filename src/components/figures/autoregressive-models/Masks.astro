---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// 5×5 masks of a PixelCNN: 1 above the centre row and left of the centre; type B also keeps the centre.
const k = 5, c = (k - 1) / 2;
const mask = (center: boolean): number[][] => Array.from({ length: k }, (_, i) => Array.from({ length: k }, (_, j) => (i < c || (i === c && (j < c || (center && j === c))) ? 1 : 0)));
const masks = [mask(false), mask(true)];
const ones = masks.map((m) => m.flat().reduce((a, b) => a + b, 0));
if (ones[0] !== 12 || ones[1] !== 13) throw new Error('Masks: mask sizes drifted from the note');
const titles = ru ? ['маска A: первый слой', 'маска B: остальные слои'] : ['mask A: first layer', 'mask B: later layers'];
const id = 'autoregressive-models-masks';
const cell = 28;
---

<Figure
  id={id}
  title={ru ? 'Маски свёртки 5×5 в PixelCNN' : 'The 5×5 convolution masks of PixelCNN'}
  caption={ru
    ? `Маска умножается на ядро свёртки поэлементно, и веса с нулями не участвуют в вычислении. Единицы стоят во всех строках выше центра и слева от центра в его строке: это пиксели, предшествующие текущему в порядке развёртки. Маска A исключает и сам центр (${ones[0]} единиц из 25), потому что на входе первого слоя в центре стоит значение, которое нужно предсказать. Маска B центр оставляет (${ones[1]} единиц): после первого слоя признак в позиции i уже вычислен только по пикселям до i.`
    : `The mask multiplies the convolution kernel element-wise, so the weights at zeros take no part in the computation. The ones cover every row above the centre and the positions left of the centre in its row: the pixels that come before the current one in raster order. Mask A also excludes the centre (${ones[0]} ones out of 25), because at the input of the first layer the centre holds the very value to be predicted. Mask B keeps the centre (${ones[1]} ones): after the first layer, the feature at position i has already been computed from the pixels before i only.`}
>
  <svg class="fig-compact" viewBox="0 0 360 206" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>{ru ? 'Маски типа A и B' : 'Type-A and type-B masks'}</title>
    <desc id={`${id}-d`}>{ru ? `Две сетки 5×5 из нулей и единиц. Единицы в двух верхних строках и в двух левых клетках средней строки; в маске B единица ещё и в центре.` : `Two 5×5 grids of zeros and ones. Ones fill the two top rows and the two left cells of the middle row; mask B also has a one at the centre.`}</desc>
    {masks.map((m, p) => {
      const x0 = 20 + p * 180, y0 = 34;
      return (
        <g>
          <text class="f-small" x={x0} y={y0 - 12}>{titles[p]}</text>
          {m.map((row, i) => row.map((v, j) => (
            <g>
              <rect x={x0 + j * cell} y={y0 + i * cell} width={cell - 2} height={cell - 2} rx="3" style={`fill: var(--fig-blue); fill-opacity: ${v ? 0.45 : 0}; stroke: ${i === c && j === c ? 'var(--fig-red)' : 'var(--line)'}; stroke-width: ${i === c && j === c ? 2 : 1}`} />
              <text class="f-note" x={x0 + j * cell + (cell - 2) / 2} y={y0 + i * cell + 18} text-anchor="middle">{v}</text>
            </g>
          )))}
        </g>
      );
    })}
    <rect x="20" y="184" width="13" height="13" rx="2" style="fill: none; stroke: var(--fig-red); stroke-width: 2" />
    <text class="f-small" x="40" y="195">{ru ? 'центр: предсказываемый пиксель' : 'centre: the pixel being predicted'}</text>
  </svg>
</Figure>
