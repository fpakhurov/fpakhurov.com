---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Which earlier pixels can influence the prediction at the target after L masked 3×3 convolutions.
// Offsets are (row, column) relative to the target; negative rows are above it.
const L = 4;
const maskA: [number, number][] = [[-1, -1], [-1, 0], [-1, 1], [0, -1]];
const maskB: [number, number][] = [...maskA, [0, 0]];
const key = (r: number, c: number) => `${r},${c}`;
// Receptive field of a PixelCNN: Minkowski sum of one type-A mask and L − 1 type-B masks.
let field = new Set(maskA.map(([r, c]) => key(r, c)));
for (let l = 1; l < L; l++) {
  const next = new Set<string>();
  for (const k of field) {
    const [r, c] = k.split(',').map(Number);
    for (const [dr, dc] of maskB) next.add(key(r + dr, c + dc));
  }
  field = next;
}
// Gated PixelCNN: a vertical stack sees L rows above, ±L columns; a horizontal stack sees L pixels to the left.
const gated = (r: number, c: number) => (r < 0 && r >= -L && Math.abs(c) <= L) || (r === 0 && c < 0 && c >= -L);
const past = (r: number, c: number) => r < 0 || (r === 0 && c < 0);
const rows = Array.from({ length: L + 2 }, (_, i) => i - (L + 1));
const cols = Array.from({ length: 2 * L + 3 }, (_, i) => i - (L + 1));
const inWindow = (r: number, c: number) => past(r, c) && r >= -L && Math.abs(c) <= L;
const blind = rows.flatMap((r) => cols.filter((c) => inWindow(r, c) && !field.has(key(r, c))).map((c) => key(r, c)));
if (blind.length !== 6) throw new Error('BlindSpot: the blind spot drifted from the note');
const t = ru
  ? { a: `PixelCNN: ${L} маскированные свёртки 3×3`, b: `Gated PixelCNN: две стопки, ${L} слоя`, field: 'видимая часть прошлого', blindL: 'слепое пятно', target: 'предсказываемый пиксель' }
  : { a: `PixelCNN: ${L} masked 3×3 convolutions`, b: `Gated PixelCNN: two stacks, ${L} layers`, field: 'visible part of the past', blindL: 'blind spot', target: 'pixel being predicted' };
const id = 'autoregressive-models-blind-spot';
const cell = 24;
---

<Figure
  id={id}
  title={ru ? 'Слепое пятно PixelCNN' : 'The blind spot of PixelCNN'}
  caption={ru
    ? `Предшествующие пиксели, которые могут повлиять на предсказание в отмеченном пикселе после ${L} слоёв. Слева — PixelCNN с масками 3×3: треугольник сверху справа недосягаем при любой глубине (${blind.length} пикселей в этом окне). Справа — Gated PixelCNN: его вертикальная и горизонтальная стопки не оставляют слепого пятна.`
    : `Earlier pixels that can influence the prediction at the marked pixel after ${L} layers. Left: PixelCNN with 3×3 masks; the triangle at the upper right stays out of reach at any depth (${blind.length} pixels in this window). Right: Gated PixelCNN, whose vertical and horizontal stacks leave no blind spot.`}
>
  {[{ sfx: 'w', cls: 'fig-wide', W: 680, H: 250, stack: false }, { sfx: 'n', cls: 'fig-narrow', W: 360, H: 470, stack: true }].map((Lt) => (
    <svg class={Lt.cls} viewBox={`0 0 ${Lt.W} ${Lt.H}`} role="img" aria-labelledby={`${id}-${Lt.sfx}-t ${id}-${Lt.sfx}-d`}>
      <title id={`${id}-${Lt.sfx}-t`}>{ru ? 'Рецептивное поле и слепое пятно' : 'Receptive field and blind spot'}</title>
      <desc id={`${id}-${Lt.sfx}-d`}>{ru ? `Две сетки ${rows.length}×${cols.length} с предсказываемым пикселем в нижней строке. В сетке PixelCNN часть прошлого сверху справа (${blind.length} пикселей) не входит в рецептивное поле. В сетке Gated PixelCNN рецептивное поле покрывает всё прошлое в пределах ${L} строк.` : `Two ${rows.length}×${cols.length} grids with the pixel being predicted in the bottom row. In the PixelCNN grid, part of the past at the upper right (${blind.length} pixels) is outside the receptive field. In the Gated PixelCNN grid the receptive field covers the whole past within ${L} rows.`}</desc>
      {[{ title: t.a, visible: (r: number, c: number) => field.has(key(r, c)) }, { title: t.b, visible: gated }].map((panel, p) => {
        const x0 = Lt.stack ? 46 : 20 + p * 330, y0 = Lt.stack ? 30 + p * 200 : 30;
        return (
          <g>
            <text class="f-label" x={x0} y={y0 - 10}>{panel.title}</text>
            {rows.map((r, ri) => cols.map((c, ci) => {
              const isTarget = r === 0 && c === 0;
              const vis = panel.visible(r, c);
              const isBlind = !vis && inWindow(r, c);
              const fill = isTarget ? 'var(--fig-red)' : vis ? 'var(--fig-blue)' : isBlind ? 'var(--fig-amber)' : 'transparent';
              const op = isTarget ? 0.85 : vis ? 0.5 : isBlind ? 0.55 : 0;
              return <rect x={x0 + ci * cell} y={y0 + ri * cell} width={cell - 2} height={cell - 2} rx="3" style={`fill: ${fill}; fill-opacity: ${op}; stroke: var(--line); stroke-width: 1`} />;
            }))}
          </g>
        );
      })}
      {[[t.field, 'blue', 0.5], [t.blindL, 'amber', 0.55], [t.target, 'red', 0.85]].map(([label, tone, op], i) => {
        const lx = Lt.stack ? 46 : 20 + i * 210, ly = Lt.stack ? 420 + i * 18 : 218;
        return (
          <g>
            <rect x={lx} y={ly - 11} width="13" height="13" rx="2" style={`fill: var(--fig-${tone}); fill-opacity: ${op}`} />
            <text class="f-small" x={lx + 20} y={ly}>{label as string}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
