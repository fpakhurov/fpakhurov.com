---
import Figure from '../Figure.astro';
import Op from '../seqflow/Op.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The worked example of the note: a 4 × 4 input, a 3 × 3 vertical-edge kernel, no padding, stride 1, bias 0.
const X = [[1, 0, 2, 3], [0, 1, 3, 2], [1, 0, 2, 3], [0, 1, 2, 3]];
const K = [[-1, 0, 1], [-1, 0, 1], [-1, 0, 1]];
const corr = (i: number, j: number) => K.reduce((s, row, m) => s + row.reduce((t, k, n) => t + k * X[i + m][j + n], 0), 0);
const Y = [[corr(0, 0), corr(0, 1)], [corr(1, 0), corr(1, 1)]];
const P = K.map((row, m) => row.map((k, n) => k * X[m][n]));
if (Y.flat().join(' ') !== '5 7 6 6') throw new Error(`CrossCorrelation: the output drifted (${Y.flat().join(' ')})`);
if (P.flat().join(' ') !== '-1 0 2 0 0 3 -1 0 2') throw new Error('CrossCorrelation: the products drifted');
const terms = P.flat().filter((v) => v !== 0);
const sumText = `${terms.map((v, i) => (i === 0 ? (v < 0 ? `−${-v}` : `${v}`) : v < 0 ? ` − ${-v}` : ` + ${v}`)).join('')} = ${Y[0][0]}`;
if (sumText !== '−1 + 2 + 3 − 1 + 2 = 5') throw new Error(`CrossCorrelation: the sum text drifted (${sumText})`);
const num = (v: number) => (v < 0 ? `−${-v}` : String(v));

const t = ru
  ? {
      title: 'Свёртка как скользящее скалярное произведение',
      x: 'вход X', k: 'ядро K', p: 'произведения', y: 'выход Y', next: (a: number[]) => `далее: ${a.join(', ')}`,
      steps: ['ядро ложится на левое верхнее окно 3 × 3 входа', 'окно и ядро перемножаются поэлементно: 9 произведений', 'произведения суммируются (смещение b = 0): y₀₀ = 5', 'окно сдвигается на шаг, равный 1: y₀₁ = 7, затем следующая строка: 6 и 6'],
      desc: 'Вход 4 × 4 со строками (1, 0, 2, 3), (0, 1, 3, 2), (1, 0, 2, 3), (0, 1, 2, 3) и ядро 3 × 3 со строками (−1, 0, 1). Левое верхнее окно 3 × 3 умножается на ядро поэлементно, произведения −1, 0, 2, 0, 0, 3, −1, 0, 2 в сумме дают 5 — первый элемент выхода 2 × 2. Остальные окна дают 7, 6 и 6.',
    }
  : {
      title: 'A convolution as a sliding dot product',
      x: 'input X', k: 'kernel K', p: 'products', y: 'output Y', next: (a: number[]) => `next: ${a.join(', ')}`,
      steps: ['place the kernel on the top-left 3 × 3 window of the input', 'multiply window and kernel entry by entry: 9 products', 'add the products (bias b = 0): y₀₀ = 5', 'slide by the stride, 1: y₀₁ = 7, then the next row: 6 and 6'],
      desc: 'A 4 × 4 input with rows (1, 0, 2, 3), (0, 1, 3, 2), (1, 0, 2, 3), (0, 1, 2, 3) and a 3 × 3 kernel whose rows are (−1, 0, 1). The top-left 3 × 3 window is multiplied by the kernel entry by entry; the products −1, 0, 2, 0, 0, 3, −1, 0, 2 add up to 5, the first entry of the 2 × 2 output. The other windows give 7, 6 and 6.',
    };
const id = 'convolution-cross-correlation';
const caption = ru
  ? 'Пример из текста. Ядро со столбцами −1, 0, 1 отвечает на переход от тёмного к светлому слева направо, и все четыре выхода положительны: в каждом окне правый столбец ярче левого. Ядро не переворачивается: это взаимная корреляция, которую библиотеки называют свёрткой. Пунктирная рамка — второе окно, сдвинутое на один пиксель вправо. Во всех окнах используются одни и те же 9 весов.'
  : 'The worked example of the text. The kernel with columns −1, 0, 1 responds to a dark-to-bright change from left to right, and all four outputs are positive: in every window the right column is brighter than the left one. The kernel is not flipped; this is the cross-correlation that libraries call a convolution. The dashed frame is the second window, one pixel to the right. The same 9 weights are used at every window.';

type Cell = { x: number; y: number; v: string; tone: 'x' | 'h' | 'g' | 'y'; s?: string };
const grid = (x0: number, y0: number, c: number, vals: (number | string)[][], tone: Cell['tone']): Cell[] =>
  vals.flatMap((row, i) => row.map((v, j) => ({ x: x0 + j * c, y: y0 + i * c, v: typeof v === 'number' ? num(v) : v, tone })));

const L = [
  {
    sfx: 'w', cls: 'fig-wide', W: 760, H: 240, c: 36,
    X: [30, 60], K: [230, 78], P: [394, 78], Y: [600, 96], kc: 36,
    odot: [202, 132], eq: [366, 137], sig: [548, 114],
    labX: [102, 46], labK: [284, 64], labP: [448, 64], labY: [636, 84],
    sum: [448, 216, 'middle'], nxt: [636, 194, 'middle'],
    b1: [16, 72], b2: [202, 100], b3: [548, 84], b4: [700, 132],
    arrP: [[502, 114], [533, 114]], arrY: [[561, 114], [598, 114]], arrDown: null as null | [number, number][],
  },
  {
    sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 410, c: 30,
    X: [20, 50], K: [192, 71], P: [20, 230], Y: [210, 260], kc: 26,
    odot: [165, 110], eq: null as null | number[], sig: [160, 275],
    labX: [80, 38], labK: [231, 59], labP: [65, 340], labY: [240, 250],
    sum: [20, 368, 'start'], nxt: [20, 394, 'start'],
    b1: [10, 60], b2: [165, 82], b3: [160, 245], b4: [300, 305],
    arrP: [[110, 275], [145, 275]], arrY: [[173, 275], [208, 275]], arrDown: [[165, 124], [165, 200], [65, 200], [65, 226]] as [number, number][],
  },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {L.map((g) => {
    const xs = grid(g.X[0], g.X[1], g.c, X, 'x');
    const ks = grid(g.K[0], g.K[1], g.kc, K, 'g');
    const ps = grid(g.P[0], g.P[1], g.c, P, 'h');
    const ys = grid(g.Y[0], g.Y[1], g.c, Y, 'y');
    const cellRect = (cl: Cell, size: number, bold = false) => (
      <g>
        <rect x={cl.x} y={cl.y} width={size} height={size} style={`fill: ${toneVar[cl.tone]}; fill-opacity: 0.14; stroke: ${toneVar[cl.tone]}; stroke-width: ${bold ? 2.4 : 1.1}`} />
        <text class="f-small" x={cl.x + size / 2} y={cl.y + size / 2 + 4.5} text-anchor="middle">{cl.v}</text>
      </g>
    );
    return (
      <svg class={g.cls} viewBox={`0 0 ${g.W} ${g.H}`} role="img" aria-labelledby={`${id}-${g.sfx}-t ${id}-${g.sfx}-d`}>
        <title id={`${id}-${g.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${g.sfx}-d`}>{t.desc}</desc>
        <text class="f-small f-t-muted" x={g.labX[0]} y={g.labX[1]} text-anchor="middle">{t.x}</text>
        {xs.map((cl) => cellRect(cl, g.c))}
        <g data-s="1">
          <rect x={g.X[0]} y={g.X[1]} width={3 * g.c} height={3 * g.c} style="fill: none; stroke: var(--fig-amber); stroke-width: 3" />
          <text class="f-small f-t-muted" x={g.labK[0]} y={g.labK[1]} text-anchor="middle">{t.k}</text>
          {ks.map((cl) => cellRect(cl, g.kc))}
          <Badge x={g.b1[0]} y={g.b1[1]} n={1} />
        </g>
        <g data-s="2">
          <Op x={g.odot[0]} y={g.odot[1]} sym="⊙" />
          {g.eq && <text class="f-label" x={g.eq[0]} y={g.eq[1]} text-anchor="middle">=</text>}
          {g.arrDown && <Arrow pts={g.arrDown} />}
          <text class="f-small f-t-muted" x={g.labP[0]} y={g.labP[1]} text-anchor="middle">{t.p}</text>
          {ps.map((cl) => cellRect(cl, g.c))}
          <Badge x={g.b2[0]} y={g.b2[1]} n={2} />
        </g>
        <g data-s="3">
          <Arrow pts={g.arrP as [number, number][]} />
          <Op x={g.sig[0]} y={g.sig[1]} sym="Σ" />
          <Arrow pts={g.arrY as [number, number][]} />
          <text class="f-small f-t-muted" x={g.labY[0]} y={g.labY[1]} text-anchor="middle">{t.y}</text>
          {cellRect(ys[0], g.c, true)}
          <text class="f-small" x={g.sum[0] as number} y={g.sum[1] as number} text-anchor={g.sum[2] as 'start' | 'middle'}>{sumText}</text>
          <Badge x={g.b3[0]} y={g.b3[1]} n={3} />
        </g>
        <g data-s="4">
          <rect x={g.X[0] + g.c} y={g.X[1]} width={3 * g.c} height={3 * g.c} style="fill: none; stroke: var(--fig-amber); stroke-width: 2; stroke-dasharray: 6 4" />
          {ys.slice(1).map((cl) => cellRect(cl, g.c))}
          <text class="f-small f-t-muted" x={g.nxt[0] as number} y={g.nxt[1] as number} text-anchor={g.nxt[2] as 'start' | 'middle'}>{t.next([Y[0][1], Y[1][0], Y[1][1]])}</text>
          <Badge x={g.b4[0]} y={g.b4[1]} n={4} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
