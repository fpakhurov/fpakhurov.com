---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A transposed convolution with stride 2 applied to a 4 × 4 input of ones with a k × k kernel of ones:
// output pixel (i, j) receives one copy of the kernel for every input pixel whose footprint covers it,
// so its value is the number of overlapping footprints, cover(i) · cover(j) with cover(i) = #{(a, m): 2a + m = i}.
const n = 4, s = 2;
const cover = (k: number) => {
  const size = (n - 1) * s + k;
  return Array.from({ length: size }, (_, i) => {
    let c = 0;
    for (let a = 0; a < n; a += 1) for (let m = 0; m < k; m += 1) if (s * a + m === i) c += 1;
    return c;
  });
};
const panels = [3, 4].map((k) => {
  const cv = cover(k);
  return { k, size: cv.length, grid: cv.map((ci) => cv.map((cj) => ci * cj)) };
});
// the middle rows printed in the Code section
if (panels[0].grid[4].join(',') !== '2,2,4,2,4,2,4,2,2') throw new Error('Checkerboard: k = 3 row drifted');
if (panels[1].grid[4].join(',') !== '2,2,4,4,4,4,4,4,2,2') throw new Error('Checkerboard: k = 4 row drifted');

const t = ru
  ? {
      title: 'Транспонированная свёртка с шагом 2: неравномерное перекрытие',
      head: (k: number) => `ядро ${k} × ${k}, шаг 2`,
      sub: (k: number) => (k === 3 ? '3 не делится на 2: шахматный узор' : '4 делится на 2: ровная середина'),
      desc: 'Две сетки чисел: сколько копий ядра накладывается на каждый пиксель выхода. Слева ядро 3 × 3: внутри чередуются 1, 2 и 4, шахматный узор. Справа ядро 4 × 4: внутри везде 4, неровности только у края.',
    }
  : {
      title: 'Transposed convolution with stride 2: uneven overlap',
      head: (k: number) => `kernel ${k} × ${k}, stride 2`,
      sub: (k: number) => (k === 3 ? '3 is not divisible by 2: checkerboard' : '4 is divisible by 2: even interior'),
      desc: 'Two grids of numbers, how many copies of the kernel overlap at each output pixel. Left, a 3 × 3 kernel: the interior alternates between 1, 2 and 4, a checkerboard. Right, a 4 × 4 kernel: the interior is 4 everywhere, with uneven values only at the border.',
    };
const id = 'convolution-checkerboard';
const caption = ru
  ? 'Вход 4 × 4 из единиц и ядро из единиц, так что каждый пиксель выхода равен числу копий ядра, которые на него ложатся. Каждый входной пиксель «рисует» копию ядра, и копии отстоят друг от друга на 2 пикселя. При k = 3 соседние копии перекрываются полосой шириной в один пиксель, такие полосы идут через один пиксель, и даже постоянный вход даёт узор 1–2–4. При k = 4 перекрытие равномерное. Обученное ядро может компенсировать узор, но склонность к нему остаётся.'
  : 'A 4 × 4 input of ones and a kernel of ones, so each output pixel equals the number of kernel copies that land on it. Every input pixel paints a copy of the kernel, and the copies are 2 pixels apart. With k = 3, neighbouring copies overlap in a one-pixel strip at every other position, and even a constant input gives the 1–2–4 pattern. With k = 4 the overlap is even. A trained kernel can compensate, but the tendency remains.';

const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 310, c: 24, origins: [[60, 68], [410, 56]] as [number, number][], headY: 22 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 620, c: 22, origins: [[81, 64], [70, 380]] as [number, number][], headY: 0 },
];
const fill = (v: number) => (v >= 4 ? 0.55 : v >= 2 ? 0.3 : 0.1);
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => (
    <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
      <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
      {panels.map((q, i) => {
        const [x0, y0] = Ly.origins[i];
        const w = q.size * Ly.c;
        const hy = Ly.headY ? Ly.headY : y0 - 36;
        return (
          <g>
            <text class="f-small" x={x0 + w / 2} y={hy} text-anchor="middle">{t.head(q.k)}</text>
            <text class="f-small f-t-muted" x={x0 + w / 2} y={hy + 18} text-anchor="middle">{t.sub(q.k)}</text>
            {q.grid.map((row, r) => row.map((v, c) => (
              <g>
                <rect x={x0 + c * Ly.c} y={y0 + r * Ly.c} width={Ly.c} height={Ly.c} style={`fill: var(--fig-blue); fill-opacity: ${fill(v)}; stroke: var(--paper); stroke-width: 1`} />
                <text class="f-small" x={x0 + c * Ly.c + Ly.c / 2} y={y0 + r * Ly.c + Ly.c / 2 + 4.5} text-anchor="middle">{v}</text>
              </g>
            )))}
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
