---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Receptive field of a stack of L layers of 3 × 3 convolutions, from r_l = r_{l-1} + (k - 1) d_l j_{l-1}, j_l = j_{l-1} s_l.
const rf = (layers: { s: number; d: number }[]) => {
  let r = 1, j = 1;
  return layers.map(({ s, d }) => {
    r += 2 * d * j;
    j *= s;
    return r;
  });
};
const N = 8;
const idx = Array.from({ length: N }, (_, i) => i);
const series = [
  { key: 'plain', vals: rf(idx.map(() => ({ s: 1, d: 1 }))), cls: 'blue' },
  { key: 'stride', vals: rf(idx.map((i) => ({ s: i % 2 === 1 ? 2 : 1, d: 1 }))), cls: 'green' },
  { key: 'dilated', vals: rf(idx.map((i) => ({ s: 1, d: 2 ** i }))), cls: 'red' },
];
const got = series.map((q) => q.vals.join(',')).join(' | ');
if (got !== '3,5,7,9,11,13,15,17 | 3,5,9,13,21,29,45,61 | 3,7,15,31,63,127,255,511') throw new Error(`ReceptiveField: values drifted (${got})`);
// the dilated stack reaches 2^(L+1) − 1, the (2^(i+2) − 1) of Yu and Koltun with L = i + 1
series[2].vals.forEach((v, i) => { if (v !== 2 ** (i + 2) - 1) throw new Error('ReceptiveField: dilated closed form'); });

const t = ru
  ? {
      title: 'Рецептивное поле растёт с глубиной',
      x: 'число слоёв 3 × 3', y: 'рецептивное поле, пикселей (лог. шкала)',
      names: { plain: 'шаг 1', stride: 'шаг 2 в каждом втором слое', dilated: 'расширение 1, 2, 4, …' },
      desc: 'Ширина рецептивного поля для стопки от 1 до 8 свёрток 3 × 3 в логарифмическом масштабе. С шагом 1 она растёт на 2 за слой, до 17. Если у каждого второго слоя шаг 2, она растёт как геометрическая прогрессия, до 61. С расширением, которое удваивается от слоя к слою, она равна 2 в степени L + 1 минус 1, до 511.',
    }
  : {
      title: 'The receptive field grows with depth',
      x: 'number of 3 × 3 layers', y: 'receptive field, pixels (log scale)',
      names: { plain: 'stride 1', stride: 'stride 2 every second layer', dilated: 'dilation 1, 2, 4, …' },
      desc: 'The width of the receptive field for a stack of 1 to 8 convolutions of size 3 × 3, on a log scale. With stride 1 it grows by 2 per layer, to 17. If every second layer has stride 2, it grows geometrically, to 61. With a dilation that doubles from layer to layer it is 2 to the power L + 1 minus 1, up to 511.',
    };
const id = 'convolution-receptive-field';
const caption = ru
  ? 'Значения по рекуррентной формуле из текста; та же стопка с единичными весами даёт те же ширины по градиенту в разделе «Код». С шагом 1 каждый слой добавляет k − 1 = 2 пикселя. Шаг 2 вдвое увеличивает расстояние между соседними нейронами на выходе слоя, поэтому ядро следующего слоя охватывает вдвое больше пикселей. Удваивающееся расширение тоже даёт экспоненциальный рост, ещё более быстрый, и без потери разрешения: выход остаётся того же размера, что и вход.'
  : 'Values from the recursion of the text; the same stack with all weights equal to 1 gives the same widths from its gradient in the Code section. With stride 1 each layer adds k − 1 = 2 pixels. A stride of 2 doubles the spacing between neighbouring units of its output, so the kernel of the next layer spans twice as many pixels. A doubling dilation also gives exponential growth, faster still, and without losing resolution: the output keeps the size of the input.';

const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 320, px: [70, 520], py: [30, 250], leg: [548, 180], legStep: 26, end: true },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 430, px: [56, 336], py: [40, 270], leg: [20, 352], legStep: 24, end: false },
];
const yt = [2, 4, 8, 16, 32, 64, 128, 256, 512];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => {
    const sx = scale([1, N], Ly.px as [number, number]);
    const sy = scale([1, Math.log2(512)], [Ly.py[1], Ly.py[0]]);
    const ly = (v: number) => sy(Math.log2(v));
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
        {yt.map((v) => <path class="f-grid" d={`M ${Ly.px[0]} ${ly(v)} H ${Ly.px[1]}`} />)}
        <path class="f-axis" d={`M ${Ly.px[0]} ${Ly.py[1]} H ${Ly.px[1]} M ${Ly.px[0]} ${Ly.py[0]} V ${Ly.py[1]}`} />
        {yt.map((v) => <text class="f-note" x={Ly.px[0] - 7} y={ly(v) + 5} text-anchor="end">{v}</text>)}
        {idx.map((i) => <text class="f-note" x={sx(i + 1)} y={Ly.py[1] + 20} text-anchor="middle">{i + 1}</text>)}
        <text class="f-small" x={Ly.px[1]} y={Ly.py[1] + 40} text-anchor="end">{t.x}</text>
        <text class="f-small f-t-muted" x={Ly.px[0] - 40} y={Ly.py[0] - 14}>{t.y}</text>
        {series.map((q) => (
          <g>
            <path class={`f-line f-${q.cls}`} d={polyline(q.vals.map((v, i) => [sx(i + 1), ly(v)]))} />
            {q.vals.map((v, i) => <circle cx={sx(i + 1)} cy={ly(v)} r="3.5" class={`f-solid-${q.cls}`} />)}
            {Ly.end && <text class={`f-small f-t-${q.cls} f-halo`} x={sx(N) + 10} y={ly(q.vals[N - 1]) + 5}>{q.vals[N - 1]}</text>}
          </g>
        ))}
        {series.map((q, i) => (
          <g>
            <path class={`f-line f-${q.cls}`} d={`M ${Ly.leg[0]} ${Ly.leg[1] + i * Ly.legStep - 4} h 24`} />
            <text class="f-small" x={Ly.leg[0] + 32} y={Ly.leg[1] + i * Ly.legStep}>{`${t.names[q.key as 'plain' | 'stride' | 'dilated']}${Ly.end ? '' : `: ${q.vals[N - 1]}`}`}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
