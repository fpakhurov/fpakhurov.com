---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A 5 × 5 input padded by p = 1 (a 7 × 7 grid), a 3 × 3 kernel. For three settings of stride s and dilation d,
// the padded-grid cells read by the first output y00 and by its right neighbour y01.
const H = 5, k = 3, p = 1, n = H + 2 * p;
const outSize = (s: number, d: number) => Math.floor((H + 2 * p - d * (k - 1) - 1) / s) + 1;
const reads = (s: number, d: number, col: number) => {
  const cells: string[] = [];
  for (let m = 0; m < k; m += 1) for (let l = 0; l < k; l += 1) cells.push(`${d * m},${s * col + d * l}`);
  return cells;
};
const panels = [
  { s: 1, d: 1 },
  { s: 2, d: 1 },
  { s: 1, d: 2 },
].map((q) => ({ ...q, out: outSize(q.s, q.d), a: reads(q.s, q.d, 0), b: reads(q.s, q.d, 1), extent: q.d * (k - 1) + 1 }));
if (panels.map((q) => q.out).join(' ') !== '5 3 3') throw new Error('StrideDilation: output sizes drifted');
if (panels[2].b.join(' ') !== '0,1 0,3 0,5 2,1 2,3 2,5 4,1 4,3 4,5') throw new Error('StrideDilation: dilated reads drifted');

const t = ru
  ? {
      title: 'Шаг и расширение (dilation) меняют, какие входы читает выход',
      setting: (s: number, d: number) => `шаг ${s}, расширение ${d}`,
      out: (o: number) => `выход ${o} × ${o}`, ext: (e: number) => `охват ${e} × ${e}`,
      first: 'окно y₀₀', second: 'окно y₀₁', both: 'оба', pad: 'нулевое дополнение',
      desc: 'Три сетки 7 × 7: вход 5 × 5 с нулевым дополнением p = 1, ядро 3 × 3. Отмечены клетки, которые читают первый выход и его правый сосед. Шаг 1, расширение 1: окна сдвинуты на одну клетку и перекрываются, выход 5 × 5. Шаг 2: окна сдвинуты на две клетки, выход 3 × 3. Расширение 2: ядро читает каждую вторую клетку и охватывает 5 × 5, выход 3 × 3.',
    }
  : {
      title: 'Stride and dilation change which inputs an output reads',
      setting: (s: number, d: number) => `stride ${s}, dilation ${d}`,
      out: (o: number) => `output ${o} × ${o}`, ext: (e: number) => `extent ${e} × ${e}`,
      first: 'read by y₀₀', second: 'read by y₀₁', both: 'both', pad: 'zero padding',
      desc: 'Three 7 × 7 grids: a 5 × 5 input with zero padding p = 1 and a 3 × 3 kernel. Marked are the cells read by the first output and by its right neighbour. Stride 1, dilation 1: the windows move by one cell and overlap, output 5 × 5. Stride 2: the windows move by two cells, output 3 × 3. Dilation 2: the kernel reads every other cell and spans 5 × 5, output 3 × 3.',
    };
const id = 'convolution-stride-dilation';
const caption = ru
  ? 'Вход 5 × 5 (белые клетки) с нулевой рамкой ширины p = 1 (серые), ядро 3 × 3 — во всех трёх случаях 9 весов. Янтарные клетки читает первый выход, синие — его правый сосед, клетки с обоими цветами — оба. Шаг задаёт, на сколько сдвигается окно, расширение — расстояние между клетками внутри окна. Размер выхода по формуле из текста: ⌊(5 + 2 − 2d − 1)/s⌋ + 1.'
  : 'A 5 × 5 input (white cells) with a zero border of width p = 1 (grey), and a 3 × 3 kernel: 9 weights in all three cases. Amber cells are read by the first output, blue cells by its right neighbour, cells with both colours by both. The stride sets how far the window moves, the dilation how far apart the cells inside it are. Output sizes from the formula of the text: ⌊(5 + 2 − 2d − 1)/s⌋ + 1.';

const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 300, c: 22, origins: [[45, 40], [300, 40], [555, 40]] as [number, number][], textDy: [178, 198, 218], textDx: 77, anchor: 'middle', legend: [[150, 278], [330, 278], [510, 278]] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 560, c: 20, origins: [[16, 20], [16, 190], [16, 360]] as [number, number][], textDy: [50, 74, 98], textDx: 156, anchor: 'start', legend: [[16, 514], [190, 514], [16, 538]] },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => (
    <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
      <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
      {panels.map((q, i) => {
        const [x0, y0] = Ly.origins[i];
        const cells = [];
        for (let r = 0; r < n; r += 1) {
          for (let c = 0; c < n; c += 1) {
            const key = `${r},${c}`;
            const pad = r < p || c < p || r >= n - p || c >= n - p;
            const inA = q.a.includes(key), inB = q.b.includes(key);
            cells.push({ x: x0 + c * Ly.c, y: y0 + r * Ly.c, pad, inA, inB });
          }
        }
        return (
          <g>
            {cells.map((cl) => (
              <g>
                <rect x={cl.x} y={cl.y} width={Ly.c} height={Ly.c} class={cl.pad ? 'f-box-soft' : 'f-fill-paper'} style={cl.pad ? '' : 'stroke: var(--line); stroke-width: 1'} />
                {cl.inA && <rect x={cl.x + 1.5} y={cl.y + 1.5} width={Ly.c - 3} height={Ly.c - 3} class="f-fill-amber" />}
                {cl.inB && <rect x={cl.x + 4} y={cl.y + 4} width={Ly.c - 8} height={Ly.c - 8} style="fill: none; stroke: var(--fig-blue); stroke-width: 2.2" />}
              </g>
            ))}
            <text class="f-small" x={x0 + Ly.textDx} y={y0 + Ly.textDy[0]} text-anchor={Ly.anchor}>{t.setting(q.s, q.d)}</text>
            <text class="f-small f-t-muted" x={x0 + Ly.textDx} y={y0 + Ly.textDy[1]} text-anchor={Ly.anchor}>{t.out(q.out)}</text>
            <text class="f-small f-t-muted" x={x0 + Ly.textDx} y={y0 + Ly.textDy[2]} text-anchor={Ly.anchor}>{t.ext(q.extent)}</text>
          </g>
        );
      })}
      <g>
        <rect x={Ly.legend[0][0]} y={Ly.legend[0][1] - 11} width="14" height="14" class="f-fill-amber" />
        <text class="f-small" x={Ly.legend[0][0] + 20} y={Ly.legend[0][1]}>{t.first}</text>
        <rect x={Ly.legend[1][0] + 2} y={Ly.legend[1][1] - 9} width="10" height="10" style="fill: none; stroke: var(--fig-blue); stroke-width: 2.2" />
        <text class="f-small" x={Ly.legend[1][0] + 20} y={Ly.legend[1][1]}>{t.second}</text>
        <rect x={Ly.legend[2][0]} y={Ly.legend[2][1] - 11} width="14" height="14" class="f-box-soft" />
        <text class="f-small" x={Ly.legend[2][0] + 20} y={Ly.legend[2][1]}>{t.pad}</text>
      </g>
    </svg>
  ))}
</Figure>
