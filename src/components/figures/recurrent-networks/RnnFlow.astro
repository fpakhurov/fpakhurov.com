---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Op from '../seqflow/Op.astro';
import Badge from '../seqflow/Badge.astro';
import Arrow from '../seqflow/Arrow.astro';
import Box from '../seqflow/Box.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import { fmt } from '../seqflow/tones';
import Sub from '../generative-modeling/Sub.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// (b) is the scalar worked example of the note: W_x = 1, W_h = 0.5, b = 0, inputs (1, 0, 0).
const wx = 1, wh = 0.5, xs = [1, 0, 0];
const steps: { pre: number; h: number }[] = [];
let h = 0;
for (const x of xs) { const pre = wx * x + wh * h; h = Math.tanh(pre); steps.push({ pre, h }); }
if (steps.map((s) => fmt(s.h)).join() !== '0.762,0.363,0.180' || fmt(steps[1].pre) !== '0.381' || fmt(steps[2].pre) !== '0.182')
  throw new Error('RnnFlow: the worked example drifted from the note');
const t = ru
  ? { a: '(а) один шаг: что куда идёт', b: '(б) пример из текста: три шага', next: 'к шагу t + 1', ex: 'W_x = 1, W_h = 0.5, b = 0', steps: ['прочитать вход: W_x xₜ', 'прочитать память: W_h hₜ₋₁', 'сложить с b', 'сжать tanh: новое состояние hₜ', 'предсказать: W_y hₜ, softmax', 'передать hₜ следующему шагу'] }
  : { a: '(a) one step: what goes where', b: '(b) the worked example: three steps', next: 'to step t + 1', ex: 'W_x = 1, W_h = 0.5, b = 0', steps: ['read the input: W_x xₜ', 'read the memory: W_h hₜ₋₁', 'add, with b', 'squash with tanh: the new state hₜ', 'predict: W_y hₜ, softmax', 'pass hₜ on to the next step'] };
const empty3 = ['', '', ''];
const id = 'rnn-flow';
const layouts = [
  { cls: 'fig-wide', W: 770, H: 350, pa: [0, 0], pb: [400, 0], legend: [8, 340] },
  { cls: 'fig-narrow seq-narrow', W: 372, H: 712, pa: [0, 0], pb: [0, 330], legend: [8, 672] },
];
---

<Figure
  id={id}
  title={ru ? 'Шаг рекуррентной сети: что куда идёт' : 'One step of a recurrent network: what goes where'}
  caption={ru
    ? '(а) Один шаг для H = 3 и d = 4. Вход xₜ умножается на W_x (1), предыдущее состояние hₜ₋₁ — на W_h (2), результаты складываются с b (3), tanh даёт новое состояние hₜ (4). Если нужен выход, hₜ умножается на W_y и проходит softmax (5); само hₜ уходит на следующий шаг (6). (б) Те же операции с числами примера из текста: на каждом шаге одни и те же веса ×1 и ×0.5; единица, поданная на первом шаге, затухает от 0.762 до 0.180.'
    : '(a) One step for H = 3 and d = 4. The input xₜ is multiplied by W_x (1), the previous state hₜ₋₁ by W_h (2), the two are added with b (3), and tanh gives the new state hₜ (4). If an output is needed, hₜ is multiplied by W_y and passed through a softmax (5); hₜ itself goes on to the next step (6). (b) The same operations with the numbers of the worked example: the same weights ×1 and ×0.5 at every step; the 1 fed in at step 1 fades from 0.762 to 0.180.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Шаг RNN и пример из трёх шагов' : 'An RNN step and a three-step example'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? `Слева один шаг: hₜ₋₁ через W_h и xₜ через W_x сходятся в сумматоре с b, затем tanh даёт hₜ, которое идёт вверх через W_y и softmax к выходу и вправо к следующему шагу. Справа три шага с числами: входы 1, 0, 0, состояния ${steps.map((s) => fmt(s.h)).join(', ')}.`
        : `Left, one step: hₜ₋₁ through W_h and xₜ through W_x meet in a sum with b, then tanh gives hₜ, which goes up through W_y and a softmax to the output and right to the next step. Right, three steps with numbers: inputs 1, 0, 0, states ${steps.map((s) => fmt(s.h)).join(', ')}.`}</desc>
      <g transform={`translate(${L.pa[0]} ${L.pa[1]})`}>
        <text class="f-small f-t-muted" x="4" y="14">{t.a}</text>
        <g transform="translate(0 24)">
          <g data-s="1">
            <Vec x={120} y={250} values={['', '', '', '']} tone="x" dir="row" cw={26} label="x_t" labelPos="left" />
            <Arrow pts={[[172, 250], [172, 228]]} />
            <Box x={147} y={196} w={50} h={30} label="W_x" tone="g" math />
            <Arrow pts={[[172, 196], [172, 172]]} />
            <Badge x={136} y={211} n={1} />
          </g>
          <g data-s="2">
            <Vec x={8} y={124} values={empty3} tone="h" cw={34} label="h_{t−1}" labelPos="below" />
            <Arrow pts={[[42, 157], [58, 157]]} />
            <Box x={60} y={142} w={50} h={30} label="W_h" tone="g" math />
            <Arrow pts={[[110, 157], [157, 157]]} />
            <Badge x={85} y={131} n={2} />
          </g>
          <g data-s="3">
            <Op x={172} y={157} sym="+" />
            <text class="f-math" x="146" y="122">b</text>
            <Arrow pts={[[152, 126], [162, 145]]} />
            <Badge x={190} y={176} n={3} />
          </g>
          <g data-s="4">
            <Arrow pts={[[185, 157], [214, 157]]} />
            <Op x={238} y={157} sym="tanh" />
            <Arrow pts={[[261, 157], [288, 157]]} />
            <Vec x={290} y={124} values={empty3} tone="h" cw={34} label="h_t" labelPos="below" />
            <Badge x={238} y={134} n={4} />
          </g>
          <g data-s="5">
            <Arrow pts={[[307, 124], [307, 110]]} />
            <Box x={282} y={78} w={50} h={30} label="W_y" tone="g" math />
            <Arrow pts={[[307, 78], [307, 67]]} />
            <Op x={307} y={52} sym="softmax" />
            <Arrow pts={[[307, 39], [307, 30]]} />
            <Vec x={262} y={6} values={['', '', '', '']} tone="y" dir="row" cw={22} label="ŷ_t" labelPos="left" />
            <Badge x={270} y={93} n={5} />
          </g>
          <g data-s="6">
            <Arrow pts={[[324, 157], [366, 157]]} tone="blue" bold />
            <text class="f-small f-t-blue" x="345" y="178" text-anchor="middle">t + 1</text>
            <Badge x={345} y={140} n={6} />
          </g>
        </g>
      </g>
      <g transform={`translate(${L.pb[0]} ${L.pb[1]})`}>
        <text class="f-small f-t-muted" x="4" y="14">{t.b}</text>
        <text class="f-small f-t-amber" x="4" y="32"><Sub label={t.ex} /></text>
        <g transform="translate(0 24)">
          <g data-s="2 6"><Vec x={4} y={62} values={['0']} tone="h" cw={36} label="h_0" labelPos="above" /></g>
          {steps.map((s, i) => {
            const cx = 100 + i * 110, prevRight = i === 0 ? 40 : 100 + (i - 1) * 110 + 24;
            return (
              <g>
                <g data-s="2 6"><Arrow pts={[[prevRight, 73], [cx - 45, 73], [cx - 45, 173], [cx - 15, 173]]} tone="blue" label="×0.5" at={[cx - 41, 156]} /></g>
                <g data-s="1">
                  <Vec x={cx - 20} y={250} values={[String(xs[i])]} tone="x" label={`x_${i + 1}`} labelPos="below" />
                  <Arrow pts={[[cx, 250], [cx, 188]]} label="×1" at={[cx + 6, 226]} />
                </g>
                <g data-s="3">
                  <Op x={cx} y={173} sym="+" />
                  <text class="f-small" x={cx + 17} y={200}>{Number.isInteger(s.pre) ? String(s.pre) : fmt(s.pre)}</text>
                </g>
                <g data-s="4">
                  <Arrow pts={[[cx, 160], [cx, 135]]} />
                  <Op x={cx} y={120} sym="tanh" />
                  <Arrow pts={[[cx, 107], [cx, 86]]} />
                  <Vec x={cx - 24} y={62} values={[fmt(s.h)]} tone="h" cw={48} label={`h_${i + 1}`} labelPos="above" />
                </g>
              </g>
            );
          })}
        </g>
      </g>
      <Legend x={L.legend[0]} y={L.legend[1]} step={L.cls === 'fig-wide' ? 130 : 170} rows={L.cls === 'fig-wide' ? 1 : 2} />
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
