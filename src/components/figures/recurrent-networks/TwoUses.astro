---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The same unrolled recurrence used two ways: the last state for a label, every state for the next token.
const clsInputs = ['oil', 'price', 'soar', 'record'];
const lmInputs = ['the', 'cat', 'sat', 'on'];
const lmTargets = ['cat', 'sat', 'on', 'the'];
const t = ru
  ? { a: '(а) классификатор: последнее состояние', b: '(б) языковая модель: каждое состояние', head: 'linear + softmax → Business', targets: 'цели', inputs: 'входы' }
  : { a: '(a) classifier: the last state', b: '(b) language model: every state', head: 'linear + softmax → Business', targets: 'targets', inputs: 'inputs' };
const id = 'rnn-two-uses';
const cellW = 52, cellH = 40, step = 72, cellY = 112;
const cellX = (x0: number, i: number) => x0 + 52 + i * step;
---

<Figure
  id={id}
  title={ru ? 'Одна рекурсия, два способа использовать состояния' : 'One recurrence, two ways to use its states'}
  caption={ru
    ? 'Обе модели — одна и та же ячейка, применённая к каждому токену по очереди; горизонтальные стрелки передают скрытое состояние hₜ дальше, начиная с h₀ = 0. (а) Классификатор читает весь документ и подаёт линейному слою только последнее состояние, которое зависит от всех токенов по порядку. (б) Языковая модель в каждой позиции выдаёт распределение по словарю и учится предсказывать следующий токен: входы — текст без последнего токена, цели — тот же текст, сдвинутый на один (teacher forcing). Функция потерь — сумма −log P(цель) по позициям, и её экспонента после усреднения — перплексия.'
    : 'Both models are the same cell applied to each token in turn; the horizontal arrows pass the hidden state hₜ on, starting from h₀ = 0. (a) A classifier reads the whole document and gives only the last state, which depends on every token in order, to a linear layer. (b) A language model produces a distribution over the vocabulary at every position and is trained to predict the next token: the inputs are the text without its last token, the targets the same text shifted by one (teacher forcing). The loss is the sum of −log P(target) over positions, and the exponential of its average is the perplexity.'}
>
  {[{ cls: 'fig-wide', W: 700, H: 236, panels: [[0, 0], [350, 0]] }, { cls: 'fig-narrow', W: 360, H: 466, panels: [[0, 0], [0, 232]] }].map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'RNN как классификатор и как языковая модель' : 'An RNN as a classifier and as a language model'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? `(а) Четыре ячейки RNN читают ${clsInputs.join(', ')}; последнее состояние идёт в linear + softmax, ответ Business. (б) Четыре ячейки читают ${lmInputs.join(', ')}; каждая выдаёт softmax, цели — ${lmTargets.join(', ')}.`
        : `(a) Four RNN cells read ${clsInputs.join(', ')}; the last state goes to linear + softmax, which outputs Business. (b) Four cells read ${lmInputs.join(', ')}; each produces a softmax, and the targets are ${lmTargets.join(', ')}.`}</desc>
      {L.panels.map(([x0, y0], pi) => {
        const inputs = pi === 0 ? clsInputs : lmInputs;
        return (
          <g>
            <text class="f-title" x={x0 + 8} y={y0 + 18}>{pi === 0 ? t.a : t.b}</text>
            <text class="f-small f-t-muted" x={x0 + 22} y={y0 + cellY + cellH / 2 + 4} text-anchor="middle">h₀</text>
            {inputs.map((tok, i) => {
              const x = cellX(x0, i), y = y0 + cellY;
              return (
                <g>
                  <path class="f-line f-muted" d={`M ${i === 0 ? x0 + 32 : cellX(x0, i - 1) + cellW + 1} ${y + cellH / 2} H ${x - 4}`} marker-end="url(#f-arrow-muted)" />
                  <rect class="f-fill-blue" x={x} y={y} width={cellW} height={cellH} rx="6" />
                  <rect class="f-thin f-blue" x={x} y={y} width={cellW} height={cellH} rx="6" fill="none" />
                  <text class="f-small f-t-blue" x={x + cellW / 2} y={y + cellH / 2 + 4} text-anchor="middle">RNN</text>
                  <text class="f-label" x={x + cellW / 2} y={y0 + 214} text-anchor="middle" font-family="var(--mono)">{tok}</text>
                  <path class="f-thin f-muted" d={`M ${x + cellW / 2} ${y0 + 198} V ${y + cellH + 4}`} marker-end="url(#f-arrow-muted)" />
                  {pi === 1 && (
                    <g>
                      <path class="f-thin f-green" d={`M ${x + cellW / 2} ${y - 2} V ${y0 + 82}`} marker-end="url(#f-arrow-green)" />
                      <rect class="f-fill-paper" x={x} y={y0 + 52} width={cellW} height={26} rx="5" />
                      <rect class="f-thin f-green" x={x} y={y0 + 52} width={cellW} height={26} rx="5" fill="none" />
                      <text class="f-small" x={x + cellW / 2} y={y0 + 69} text-anchor="middle">softmax</text>
                      <text class="f-label f-t-green" x={x + cellW / 2} y={y0 + 44} text-anchor="middle" font-family="var(--mono)">{lmTargets[i]}</text>
                    </g>
                  )}
                </g>
              );
            })}
            {pi === 0 && (() => {
              const x = cellX(x0, 3);
              return (
                <g>
                  <path class="f-line f-amber" d={`M ${x + cellW / 2} ${y0 + cellY - 2} V ${y0 + 72}`} marker-end="url(#f-arrow-amber)" />
                  <rect class="f-fill-amber" x={x + cellW - 208} y={y0 + 40} width={208} height={28} rx="5" />
                  <rect class="f-thin f-amber" x={x + cellW - 208} y={y0 + 40} width={208} height={28} rx="5" fill="none" />
                  <text class="f-small" x={x + cellW - 104} y={y0 + 58} text-anchor="middle">{t.head}</text>
                </g>
              );
            })()}
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
