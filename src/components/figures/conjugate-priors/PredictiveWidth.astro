---
import Figure from '../Figure.astro';
import { scale, plot } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Left: heads in the next m = 10 flips after the posterior Beta(7, 4): the beta-binomial predictive
// against the binomial with p = 7/11 plugged in. Right: the Student-t predictive of the normal-gamma
// example (7 degrees of freedom, centre 1, squared scale 0.8167) against N(1, 0.7), the posterior means plugged in.
const lgamma = (z: number): number => {
  // Lanczos approximation, g = 7, n = 9
  const c = [0.99999999999980993, 676.5203681218851, -1259.1392167224028, 771.32342877765313, -176.61502916214059,
    12.507343278686905, -0.13857109526572012, 9.9843695780195716e-6, 1.5056327351493116e-7];
  if (z < 0.5) return Math.log(Math.PI / Math.sin(Math.PI * z)) - lgamma(1 - z);
  z -= 1;
  let x = c[0];
  for (let i = 1; i < 9; i++) x += c[i] / (z + i);
  const t = z + 7.5;
  return 0.5 * Math.log(2 * Math.PI) + (z + 0.5) * Math.log(t) - t + Math.log(x);
};
const lbeta = (a: number, b: number) => lgamma(a) + lgamma(b) - lgamma(a + b);
const lchoose = (m: number, k: number) => lgamma(m + 1) - lgamma(k + 1) - lgamma(m - k + 1);
const a = 7, b = 4, m = 10, p = a / (a + b);
const ks = Array.from({ length: m + 1 }, (_, k) => k);
const bb = ks.map((k) => Math.exp(lchoose(m, k) + lbeta(a + k, b + m - k) - lbeta(a, b)));
const bi = ks.map((k) => Math.exp(lchoose(m, k) + k * Math.log(p) + (m - k) * Math.log(1 - p)));
const varOf = (pm: number[]) => { const mu = pm.reduce((s, q, k) => s + q * k, 0); return pm.reduce((s, q, k) => s + q * (k - mu) ** 2, 0); };
const cdf3 = (pm: number[]) => pm.slice(0, 4).reduce((s, q) => s + q, 0);

const nu = 7, loc = 1, s2 = (2.45 * 7) / (3.5 * 6), v2 = 2.45 / 3.5;
const tpdf = (x: number) => Math.exp(lgamma((nu + 1) / 2) - lgamma(nu / 2) - 0.5 * Math.log(nu * Math.PI * s2) - ((nu + 1) / 2) * Math.log(1 + (x - loc) ** 2 / (nu * s2)));
const npdf = (x: number) => Math.exp(-((x - loc) ** 2) / (2 * v2)) / Math.sqrt(2 * Math.PI * v2);
const tail = (g: (x: number) => number, from: number, to: number) => {
  const N = 20000, h = (to - from) / N;
  let s = g(from) + g(to);
  for (let i = 1; i < N; i++) s += g(from + i * h) * (i % 2 ? 4 : 2);
  return (s * h) / 3;   // Simpson's rule
};
const tSf = tail(tpdf, 3, 403), nSf = tail(npdf, 3, 13);
const chk = [varOf(bb).toFixed(2), varOf(bi).toFixed(2), cdf3(bb).toFixed(3), cdf3(bi).toFixed(3), s2.toFixed(3), tSf.toFixed(3), nSf.toFixed(4)].join(' ');
if (chk !== '4.05 2.31 0.089 0.032 0.817 0.031 0.0084') throw new Error(`PredictiveWidth: numbers drifted from the note (${chk})`);

const t = ru
  ? {
      title: 'Предсказательное распределение шире подстановки',
      left: 'число орлов в 10 следующих бросках', right: 'новое наблюдение x', kx: 'число орлов k', xx: 'x',
      bb: 'бета-биномиальное (предсказание)', bi: 'биномиальное, p = 7/11', st: 'Стьюдента (предсказание), 7 ст. свободы', no: 'нормальное, подставлены средние',
      var: `дисперсия ${varOf(bb).toFixed(2)} и ${varOf(bi).toFixed(2)}`, p3: `P(k ≤ 3): ${cdf3(bb).toFixed(3)} и ${cdf3(bi).toFixed(3)}`,
      tl: 'P(x > 3):', tv: `${tSf.toFixed(3)} и ${nSf.toFixed(4)}`,
      desc: 'Слева пары столбцов для k = 0…10: бета-биномиальное распределение ниже в центре и выше на краях, чем биномиальное; дисперсии 4.05 и 2.31. Справа плотность Стьюдента с 7 степенями свободы и нормальная плотность с центром 1; у t-распределения тяжелее хвосты, P(x > 3) равна 0.031 против 0.0084.',
    }
  : {
      title: 'The predictive is wider than the plug-in',
      left: 'heads in the next 10 flips', right: 'a new observation x', kx: 'number of heads k', xx: 'x',
      bb: 'beta–binomial predictive', bi: 'binomial, p = 7/11', st: 'Student-t predictive, 7 dof', no: 'normal, posterior means plugged in',
      var: `variance ${varOf(bb).toFixed(2)} vs ${varOf(bi).toFixed(2)}`, p3: `P(k ≤ 3): ${cdf3(bb).toFixed(3)} vs ${cdf3(bi).toFixed(3)}`,
      tl: 'P(x > 3):', tv: `${tSf.toFixed(3)} vs ${nSf.toFixed(4)}`,
      desc: 'Left, pairs of bars for k = 0 to 10: the beta–binomial is lower in the middle and higher at the ends than the binomial; variances 4.05 and 2.31. Right, a Student-t density with 7 degrees of freedom and a normal density, both centred at 1; the t has heavier tails, with P(x > 3) equal to 0.031 against 0.0084.',
    };
const id = 'predictive-width';
const caption = ru
  ? 'Слева: после апостериорного Beta(7, 4) число орлов в 10 следующих бросках имеет бета-биномиальное распределение (синие столбцы); биномиальное с подставленной вероятностью 7/11 (янтарные) имеет то же среднее 6.36, но дисперсию 2.31 вместо 4.05. Справа: в примере с нормально-гамма-распределением (5 наблюдений со средним 1.2) предсказание нового наблюдения — распределение Стьюдента с 7 степенями свободы, центром 1 и квадратом масштаба 0.817 (синее); подстановка апостериорных средних даёт N(1, 0.7) (янтарное). Пунктир — порог x = 3.'
  : 'Left: after the posterior Beta(7, 4), the number of heads in the next 10 flips is beta–binomial (blue bars); the binomial with the probability 7/11 plugged in (amber) has the same mean, 6.36, but variance 2.31 instead of 4.05. Right: in the normal–gamma example (5 observations with mean 1.2), the predictive of a new observation is a Student-t with 7 degrees of freedom, centre 1 and squared scale 0.817 (blue); plugging in the posterior means gives N(1, 0.7) (amber). The dashed line is the threshold x = 3.';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 330, P: [{ x0: 50, x1: 360, y0: 96, y1: 262 }, { x0: 440, x1: 750, y0: 96, y1: 262 }] },
  { cls: 'fig-narrow', W: 360, H: 670, P: [{ x0: 44, x1: 344, y0: 96, y1: 262 }, { x0: 44, x1: 344, y0: 432, y1: 598 }] },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const A = L.P[0], B = L.P[1];
    const bw = (A.x1 - A.x0) / 11;
    const syA = scale([0, 0.26], [A.y1, A.y0]);
    const sxB = scale([-3, 5], [B.x0, B.x1]), syB = scale([0, 0.5], [B.y1, B.y0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        <text class="f-label" x={A.x0} y={A.y0 - 62}>{t.left}</text>
        <rect x={A.x0} y={A.y0 - 48} width="12" height="10" class="f-fill-blue f-blue" />
        <text class="f-small" x={A.x0 + 18} y={A.y0 - 39}>{t.bb}</text>
        <rect x={A.x0} y={A.y0 - 30} width="12" height="10" class="f-fill-amber f-amber" />
        <text class="f-small" x={A.x0 + 18} y={A.y0 - 21}>{t.bi}</text>
        {[0, 0.1, 0.2].map((v) => (
          <g>
            <path class="f-grid" d={`M ${A.x0} ${syA(v)} H ${A.x1}`} />
            <text class="f-note" x={A.x0 - 6} y={syA(v) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        {ks.map((k) => (
          <g>
            <rect x={A.x0 + k * bw + 3} y={syA(bb[k])} width={bw / 2 - 3} height={syA(0) - syA(bb[k])} class="f-fill-blue f-blue" style="stroke-width: 1" />
            <rect x={A.x0 + k * bw + bw / 2} y={syA(bi[k])} width={bw / 2 - 3} height={syA(0) - syA(bi[k])} class="f-fill-amber f-amber" style="stroke-width: 1" />
            <text class="f-note" x={A.x0 + k * bw + bw / 2} y={A.y1 + 17} text-anchor="middle">{k}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${A.x0} ${A.y1} H ${A.x1}`} />
        <text class="f-small f-t-muted" x={(A.x0 + A.x1) / 2} y={A.y1 + 38} text-anchor="middle">{t.kx}</text>
        <text class="f-small f-halo" x={A.x0 + 6} y={A.y0 + 12}>{t.var}</text>
        <text class="f-small f-halo" x={A.x0 + 6} y={A.y0 + 30}>{t.p3}</text>

        <text class="f-label" x={B.x0} y={B.y0 - 62}>{t.right}</text>
        <path class="f-line f-blue" d={`M ${B.x0} ${B.y0 - 43} h 14`} />
        <text class="f-small" x={B.x0 + 20} y={B.y0 - 39}>{t.st}</text>
        <path class="f-line f-amber f-dash" d={`M ${B.x0} ${B.y0 - 25} h 14`} />
        <text class="f-small" x={B.x0 + 20} y={B.y0 - 21}>{t.no}</text>
        {[0, 0.2, 0.4].map((v) => (
          <g>
            <path class="f-grid" d={`M ${B.x0} ${syB(v)} H ${B.x1}`} />
            <text class="f-note" x={B.x0 - 6} y={syB(v) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        <path class="f-line f-amber f-dash" d={plot(npdf, -3, 5, sxB, syB, 200)} />
        <path class="f-line f-blue" d={plot(tpdf, -3, 5, sxB, syB, 200)} />
        <path class="f-thin f-muted f-dash" d={`M ${sxB(3)} ${B.y1} V ${B.y0 + 82}`} />
        <path class="f-axis" d={`M ${B.x0} ${B.y1} H ${B.x1}`} />
        {[-2, 0, 2, 4].map((v) => <text class="f-note" x={sxB(v)} y={B.y1 + 17} text-anchor="middle">{v}</text>)}
        <text class="f-small f-t-muted" x={(B.x0 + B.x1) / 2} y={B.y1 + 38} text-anchor="middle">{t.xx}</text>
        <text class="f-small f-halo" x={B.x1} y={B.y0 + 50} text-anchor="end">{t.tl}</text>
        <text class="f-small f-halo" x={B.x1} y={B.y0 + 68} text-anchor="end">{t.tv}</text>
      </svg>
    );
  })}
</Figure>
