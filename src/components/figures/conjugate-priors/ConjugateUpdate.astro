---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Op from '../seqflow/Op.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Seven Bernoulli flips, the Beta(2, 2) prior in natural form (chi = a, nu = a + b),
// the update chi' = chi + sum x, nu' = nu + n, the predictive chi'/nu' and the evidence B(7, 4)/B(2, 2).
const xs = [1, 0, 1, 1, 0, 1, 1];
const k = xs.reduce((a, b) => a + b, 0), n = xs.length;
const chi = 2, nu = 4;
const chi1 = chi + k, nu1 = nu + n;
const lf = (m: number) => { let s = 0; for (let i = 2; i <= m; i++) s += Math.log(i); return s; };
const lB = (a: number, b: number) => lf(a - 1) + lf(b - 1) - lf(a + b - 1);   // integer arguments
const evidence = Math.exp(lB(chi1, nu1 - chi1) - lB(chi, nu - chi));
const pred = chi1 / nu1;
const chk = [k, n, chi1, nu1, nu1 - chi1, pred.toFixed(3), (1 / evidence).toFixed(0)].join(' ');
if (chk !== '5 7 7 11 4 0.636 140') throw new Error(`ConjugateUpdate: numbers drifted from the note (${chk})`);

const t = ru
  ? {
      title: 'Сопряжённое обновление: сложить достаточные статистики',
      data: 'данные X: 7 бросков', prior: 'априорное', post: 'апостериорное', stats: 'статистики',
      steps: ['достаточные статистики: Σx = 5, n = 7', 'априорное Beta(2, 2) как χ = 2, ν = 4 воображаемых броска', 'сложение: χ′ = 7, ν′ = 11, апостериорное Beta(7, 4)', 'предсказание 7/11 = 0.636 и обоснованность 1/140'],
      desc: 'Ряд из семи бросков 1 0 1 1 0 1 1 сворачивается в статистики Σx = 5 и n = 7. Вектор априорных гиперпараметров (2, 4) плюс вектор статистик (5, 7) равен (7, 11), то есть Beta(7, 4). Из него читаются вероятность орла 0.636 и обоснованность 1/140.',
    }
  : {
      title: 'A conjugate update: add the sufficient statistics',
      data: 'data X: 7 flips', prior: 'prior', post: 'posterior', stats: 'statistics',
      steps: ['sufficient statistics: Σx = 5, n = 7', 'the prior Beta(2, 2) as χ = 2, ν = 4 imaginary flips', 'add: χ′ = 7, ν′ = 11, the posterior Beta(7, 4)', 'read off the predictive 7/11 = 0.636 and the evidence 1/140'],
      desc: 'A row of seven flips 1 0 1 1 0 1 1 is reduced to the statistics Σx = 5 and n = 7. The prior hyperparameters (2, 4) plus the statistics (5, 7) give (7, 11), which is Beta(7, 4). From it the probability of heads, 0.636, and the evidence, 1/140, are read off.',
    };
const id = 'conjugate-update';
const caption = ru
  ? 'Бета–бернуллиевская модель в естественной параметризации экспоненциального семейства. Данные входят только через сумму достаточных статистик и их число (1). Априорное распределение Beta(a, b) — это χ = a «орлов» среди ν = a + b воображаемых бросков (2). Обновление складывает настоящие статистики с воображаемыми (3), и из апостериорных гиперпараметров читаются предсказательная вероятность χ′/ν′ и обоснованность — отношение нормировочных констант после и до (4).'
  : 'The beta–Bernoulli model in the natural form of the exponential family. The data enter only through the sum of the sufficient statistics and their number (1). The prior Beta(a, b) is χ = a heads among ν = a + b imaginary flips (2). The update adds the real statistics to the imaginary ones (3), and the posterior hyperparameters give the predictive probability χ′/ν′ and the evidence, the ratio of the normalizing constants after and before (4).';
const P = ['χ = 2', 'ν = 4'], S = ['Σx = 5', 'n = 7'], Q = ['χ′ = 7', 'ν′ = 11'];
const D = xs.map(String);
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 270" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <text class="f-small f-t-muted" x="132" y="40">{t.data}</text>
    <Vec x={132} y={50} values={D} tone="x" dir="row" cw={36} />
    <g data-s="1">
      <Arrow pts={[[258, 72], [258, 92]]} />
      <Op x={258} y={106} sym="Σ" />
      <Arrow pts={[[258, 119], [258, 148]]} />
      <Vec x={226} y={150} values={S} tone="x" cw={64} ch={24} />
      <text class="f-small f-t-muted" x="258" y="218" text-anchor="middle">{t.stats}</text>
      <Badge x={284} y={106} n={1} />
    </g>
    <g data-s="2">
      <Vec x={110} y={150} values={P} tone="g" cw={64} ch={24} />
      <text class="f-small f-t-muted" x="142" y="218" text-anchor="middle">{t.prior}</text>
      <text class="f-small f-t-amber" x="142" y="236" text-anchor="middle">Beta(2, 2)</text>
      <Badge x={92} y={174} n={2} />
    </g>
    <g data-s="3">
      <Op x={200} y={174} sym="+" />
      <Op x={316} y={174} sym="=" />
      <Vec x={342} y={150} values={Q} tone="h" cw={64} ch={24} />
      <text class="f-small f-t-muted" x="374" y="218" text-anchor="middle">{t.post}</text>
      <text class="f-small f-t-blue" x="374" y="236" text-anchor="middle">Beta(7, 4)</text>
      <Badge x={316} y={146} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[406, 166], [440, 166], [440, 135], [478, 135]]} />
      <Arrow pts={[[406, 182], [440, 182], [440, 215], [478, 215]]} />
      <Box x={480} y={110} w={210} h={50} label="P(x = 1 | X) = 0.636" sub="χ′/ν′ = 7/11" tone="y" />
      <Box x={480} y={190} w={210} h={50} label="p(X) = 1/140" sub="B(7, 4) / B(2, 2)" tone="y" />
      <Badge x={712} y={135} n={4} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 430" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <text class="f-small f-t-muted" x="40" y="30">{t.data}</text>
    <Vec x={40} y={40} values={D} tone="x" dir="row" cw={36} />
    <g data-s="1">
      <Arrow pts={[[168, 62], [168, 76]]} />
      <Op x={168} y={90} sym="Σ" />
      <Arrow pts={[[168, 103], [168, 118]]} />
      <Badge x={196} y={90} n={1} />
      <Vec x={136} y={120} values={S} tone="x" cw={64} ch={24} />
      <text class="f-small f-t-muted" x="168" y="190" text-anchor="middle">{t.stats}</text>
    </g>
    <g data-s="2">
      <Vec x={20} y={120} values={P} tone="g" cw={64} ch={24} />
      <text class="f-small f-t-muted" x="52" y="190" text-anchor="middle">{t.prior}</text>
      <text class="f-small f-t-amber" x="52" y="210" text-anchor="middle">Beta(2, 2)</text>
      <Badge x={20} y={104} n={2} />
    </g>
    <g data-s="3">
      <Op x={110} y={144} sym="+" />
      <Op x={226} y={144} sym="=" />
      <Vec x={252} y={120} values={Q} tone="h" cw={72} ch={24} />
      <text class="f-small f-t-muted" x="288" y="190" text-anchor="middle">{t.post}</text>
      <text class="f-small f-t-blue" x="288" y="210" text-anchor="middle">Beta(7, 4)</text>
      <Badge x={324} y={104} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[288, 218], [288, 246]]} />
      <Box x={30} y={248} w={300} h={56} label="P(x = 1 | X) = 0.636" sub="χ′/ν′ = 7/11" tone="y" subGap={18} />
      <Arrow pts={[[180, 304], [180, 330]]} />
      <Box x={30} y={332} w={300} h={56} label="p(X) = 1/140" sub="B(7, 4) / B(2, 2)" tone="y" subGap={18} />
      <Badge x={344} y={276} n={4} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
