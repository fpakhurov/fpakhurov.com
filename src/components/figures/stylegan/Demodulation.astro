---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { mulberry32, normal } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A toy modulated convolution (StyleGAN2, Eqs. 1–3). One 3×3 convolution with 8 input and 8 output channels;
// base weights N(0, 1/72), so that an unmodulated output has variance close to 1; input maps of 26×26 i.i.d.
// standard normals (valid outputs 24×24). Six samples, each with its own style vector s_i = exp(1.5 n_i).
// For every sample we measure the standard deviation of each output channel over its 576 positions:
//   modulated   w'_ijk = s_i w_ijk                                  (Eq. 1)
//   demodulated w''_ijk = w'_ijk / sqrt(Σ_{i,k} w'_ijk² + ε)          (Eq. 3)
// and, with the same demodulated weights, a spatially smooth input (3×3 box sum / 3 of an i.i.d. map: unit
// variance, neighbour correlation 2/3), which breaks the i.i.d. assumption behind Eq. 2.
// The same stream of mulberry32 draws reproduces the numbers of compute.py in the scratch work folder.
const CIN = 8, COUT = 8, K = 3, HW = 26, NS = 6, SEED = 7, SG = 1.5;
const OUT = HW - K + 1;
const rand = mulberry32(SEED);
const nrm = normal(rand);
const grid = (n: number, m: number, f: () => number) => Array.from({ length: n }, () => Array.from({ length: m }, f));
// Draw order: input maps, weights, styles, the larger map for the smooth input.
const x = Array.from({ length: CIN }, () => grid(HW, HW, nrm));
const w = Array.from({ length: COUT }, () => Array.from({ length: CIN }, () => grid(K, K, () => nrm() / Math.sqrt(CIN * K * K))));
const S = Array.from({ length: NS }, () => Array.from({ length: CIN }, () => Math.exp(SG * nrm())));
const big = Array.from({ length: CIN }, () => grid(HW + 2, HW + 2, nrm));
const smoothIn = big.map((m) => Array.from({ length: HW }, (_, r) => Array.from({ length: HW }, (_, q) => {
  let v = 0;
  for (let a = 0; a !== 3; a++) for (let b = 0; b !== 3; b++) v += m[r + a][q + b];
  return v / 3;
})));

type W4 = number[][][][];
const convStd = (inp: number[][][], wt: W4) => wt.map((wj) => {
  const vals: number[] = [];
  for (let r = 0; r !== OUT; r++)
    for (let q = 0; q !== OUT; q++) {
      let v = 0;
      for (let i = 0; i !== CIN; i++)
        for (let a = 0; a !== K; a++)
          for (let b = 0; b !== K; b++) v += wj[i][a][b] * inp[i][r + a][q + b];
      vals.push(v);
    }
  const mean = vals.reduce((u, v) => u + v, 0) / vals.length;
  return Math.sqrt(vals.reduce((u, v) => u + (v - mean) ** 2, 0) / vals.length);
});

const samples = S.map((s) => {
  const wm: W4 = w.map((wj) => wj.map((wji, i) => wji.map((row) => row.map((v) => s[i] * v))));
  const sigma = wm.map((wj) => Math.sqrt(wj.flat(2).reduce((u, v) => u + v * v, 0)));
  const wd: W4 = wm.map((wj, j) => wj.map((wji) => wji.map((row) => row.map((v) => v / Math.sqrt(sigma[j] ** 2 + 1e-8)))));
  return { mod: convStd(x, wm), dem: convStd(x, wd), smooth: convStd(smoothIn, wd), sigma };
});

const all = (k: 'mod' | 'dem' | 'smooth') => samples.flatMap((s) => s[k]);
const lo = (k: 'mod' | 'dem' | 'smooth') => Math.min(...all(k));
const hi = (k: 'mod' | 'dem' | 'smooth') => Math.max(...all(k));
const ratioDev = Math.max(...samples.flatMap((s) => s.mod.map((v, j) => Math.abs(v / s.sigma[j] - 1))));
const checks: [string, string][] = [
  [lo('mod').toFixed(1), '1.4'], [hi('mod').toFixed(1), '14.9'],
  [lo('dem').toFixed(2), '0.93'], [hi('dem').toFixed(2), '1.05'],
  [lo('smooth').toFixed(2), '0.65'], [hi('smooth').toFixed(2), '1.20'],
  [ratioDev.toFixed(2), '0.07'],
];
for (const [got, want] of checks) if (got !== want) throw new Error(`Demodulation: computed ${got}, the caption says ${want}`);

const t = ru
  ? { y: 'ст. отклонение выхода', ylog: '(лог. шкала)', sample: 'пример', mod: 'только модуляция', dem: 'с демодуляцией, i.i.d. вход', smooth: 'с демодуляцией, гладкий вход', unit: '1' }
  : { y: 'output std', ylog: '(log scale)', sample: 'sample', mod: 'modulation only', dem: 'demodulated, i.i.d. input', smooth: 'demodulated, smooth input', unit: '1' };

const id = 'stylegan-demodulation';
const ticks = [0.5, 1, 2, 5, 10, 20];
const layouts = [
  { cls: 'fig-wide', W: 760, H: 380, L: 92, R: 744, T: 70, B: 330, off: 26, jit: 1.8, leg: [[92, 26], [300, 26], [530, 26]], legStep: 0, narrow: false },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 520, L: 52, R: 352, T: 118, B: 470, off: 13, jit: 0.9, leg: [[20, 24], [20, 50], [20, 76]], legStep: 0, narrow: true },
].map((o) => {
  const sy = (v: number) => scale([Math.log10(0.5), Math.log10(20)], [o.B, o.T])(Math.log10(v));
  const step = (o.R - o.L) / NS;
  const cx = (n: number) => o.L + step * (n + 0.5);
  return { ...o, sy, cx };
});
type L = (typeof layouts)[number];
const dots = (L: L, k: 'mod' | 'dem' | 'smooth', dx: number) =>
  samples.flatMap((s, n) => s[k].map((v, j) => ({ x: L.cx(n) + dx + (j - 3.5) * L.jit, y: L.sy(v) })));
---

<Figure
  id={id}
  title={ru ? 'Демодуляция возвращает выходу единичную дисперсию' : 'Demodulation restores unit output variance'}
  caption={ru
    ? `Игрушечная свёртка 3×3 с 8 входными и 8 выходными каналами, веса из N(0, 1/72), у каждого из шести примеров свой стиль s_i = exp(1.5 n_i). Точки — стандартные отклонения 8 выходных каналов. Жёлтые — только модуляция, от 1.4 до 14.9. Синие — с демодуляцией, от 0.93 до 1.05. Полые — с демодуляцией, пространственно коррелированный вход (корреляция соседей 2/3), от 0.65 до 1.20. Числа игрушечные.`
    : `A toy 3×3 convolution with 8 channels in and out, weights from N(0, 1/72), and a style s_i = exp(1.5 n_i) for each of six samples. Dots: standard deviations of the 8 output channels. Amber: modulation alone, 1.4 to 14.9. Blue: demodulated, 0.93 to 1.05. Hollow: demodulated, spatially correlated input (neighbour correlation 2/3), 0.65 to 1.20. Toy numbers.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Стандартные отклонения выходов модулированной свёртки' : 'Output standard deviations of a modulated convolution'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'Для шести примеров по три столбика точек на логарифмической оси от 0.5 до 20. Жёлтые точки разбросаны от 1.4 до 14.9, синие лежат у пунктирной линии 1, полые — от 0.65 до 1.2.' : 'For six samples, three columns of dots on a logarithmic axis from 0.5 to 20. Amber dots spread from 1.4 to 14.9, blue dots sit on the dashed line at 1, hollow dots range from 0.65 to 1.2.'}</desc>

      {ticks.map((v) => <line class="f-grid" x1={L.L} x2={L.R} y1={L.sy(v)} y2={L.sy(v)} />)}
      {ticks.map((v) => <text class="f-note" x={L.L - 8} y={L.sy(v) + 4} text-anchor="end">{v}</text>)}
      <line class="f-line f-dash" x1={L.L} x2={L.R} y1={L.sy(1)} y2={L.sy(1)} />
      <path class="f-axis" d={`M ${L.L} ${L.B} H ${L.R}`} />
      <path class="f-axis" d={`M ${L.L} ${L.B} V ${L.T - 8}`} />
      <text class="f-small f-t-muted" x={L.narrow ? 20 : L.L + 8} y={L.narrow ? L.T - 16 : L.T - 22}>{`${t.y} ${t.ylog}`}</text>
      {samples.map((_, n) => <text class="f-note" x={L.cx(n)} y={L.B + 20} text-anchor="middle">{L.narrow ? n + 1 : `${t.sample} ${n + 1}`}</text>)}

      {dots(L, 'mod', -L.off).map((d) => <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r="3.2" style="fill: var(--fig-amber); fill-opacity: 0.8" />)}
      {dots(L, 'dem', 0).map((d) => <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r="3.2" style="fill: var(--fig-blue); fill-opacity: 0.8" />)}
      {dots(L, 'smooth', L.off).map((d) => <circle cx={d.x.toFixed(1)} cy={d.y.toFixed(1)} r="3.2" style="fill: var(--paper); stroke: var(--fig-blue); stroke-width: 1.2" />)}

      <g>
        <circle cx={L.leg[0][0] + 5} cy={L.leg[0][1] - 4} r="4" style="fill: var(--fig-amber); fill-opacity: 0.8" />
        <text class="f-small" x={L.leg[0][0] + 14} y={L.leg[0][1]}>{t.mod}</text>
        <circle cx={L.leg[1][0] + 5} cy={L.leg[1][1] - 4} r="4" style="fill: var(--fig-blue); fill-opacity: 0.8" />
        <text class="f-small" x={L.leg[1][0] + 14} y={L.leg[1][1]}>{t.dem}</text>
        <circle cx={L.leg[2][0] + 5} cy={L.leg[2][1] - 4} r="4" style="fill: var(--paper); stroke: var(--fig-blue); stroke-width: 1.2" />
        <text class="f-small" x={L.leg[2][0] + 14} y={L.leg[2][1]}>{t.smooth}</text>
      </g>
      {L.narrow && <text class="f-note" x={(L.L + L.R) / 2} y={L.B + 42} text-anchor="middle">{t.sample}</text>}
    </svg>
  ))}
</Figure>
