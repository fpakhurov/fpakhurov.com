---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Op from '../seqflow/Op.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import Sub from '../generative-modeling/Sub.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The StyleGAN generator (Karras, Laine and Aila, 2019, Figure 1b) in the colours of the sequence-model figures:
// the input code green, the intermediate code w and the feature maps blue, learned maps (mapping network, the
// affine maps A) amber, the image red. Sizes from the paper: z and w have 512 entries, the mapping network has
// 8 fully connected layers, the synthesis network starts from a 4×4×512 constant and has 18 layers, two per
// resolution from 4² to 1024², each followed by AdaIN with its own style.
const zDim = 512, mapDepth = 8, resolutions = [4, 8, 16, 32, 64, 128, 256, 512, 1024], layersPerRes = 2;
const nLayers = resolutions.length * layersPerRes;
if (zDim !== 512 || mapDepth !== 8 || nLayers !== 18) throw new Error('StyleFlow: sizes drifted from the note');

// Endpoint of an arrow from (x0, y0) that stops on the rim of an Op circle (radius 13, plus a 2 px gap) at (cx, cy).
const rim = (x0: number, y0: number, cx: number, cy: number): [number, number] => {
  const dx = cx - x0, dy = cy - y0, d = Math.hypot(dx, dy);
  return [Number((cx - (dx / d) * 15).toFixed(1)), Number((cy - (dy / d) * 15).toFixed(1))];
};

const t = ru
  ? {
      fSub: `MLP из ${mapDepth} слоёв`, wSub: `${zDim}`, zSub: `${zDim}`, constSub: '4×4×512', blockSub: '2 стиля', img: 'x', imgSub: 'изображение',
      noise: 'шум', style: '(y_s, y_b)', inset: 'внутри блока, дважды на разрешение', up: 'увеличение 2×', conv: 'свёртка', bNoise: 'B · шум', aw: 'стиль A(w)',
      again: 'затем ещё раз: свёртка, шум, AdaIN',
      steps: [
        `отображающая сеть: нормированный z проходит через ${mapDepth} полносвязных слоёв и становится промежуточным кодом w ∈ 𝒲`,
        'синтез начинается с обучаемой константы 4×4×512; z и w в неё не входят',
        'обучаемое аффинное отображение A превращает w в стиль (y_s, y_b) своего слоя; AdaIN задаёт каждому каналу масштаб y_s и сдвиг y_b',
        'B масштабирует по каналам одноканальное изображение гауссовского шума; оно прибавляется после каждой свёртки',
        `каждый блок: увеличение 2×, затем дважды свёртка 3×3, шум, leaky ReLU (не показан) и AdaIN (блок 4×4 начинает с константы без увеличения и первой свёртки); ${nLayers} слоёв от 4² до 1024², затем свёртка 1×1 в RGB`,
      ],
    }
  : {
      fSub: `MLP, ${mapDepth} layers`, wSub: `${zDim}`, zSub: `${zDim}`, constSub: '4×4×512', blockSub: '2 styles', img: 'x', imgSub: 'image',
      noise: 'noise', style: '(y_s, y_b)', inset: 'inside a block, twice per resolution', up: 'upsample 2×', conv: 'conv', bNoise: 'B · noise', aw: 'style A(w)',
      again: 'then once more: conv, noise, AdaIN',
      steps: [
        `mapping network: the normalized z passes through ${mapDepth} fully connected layers and becomes the intermediate code w ∈ 𝒲`,
        'synthesis starts from a learned 4×4×512 constant; neither z nor w enters it',
        'a learned affine map A turns w into the style (y_s, y_b) of its layer; AdaIN gives every channel the scale y_s and the bias y_b',
        'B scales a single-channel image of Gaussian noise per channel; it is added after every convolution',
        `each block: upsample 2×, then twice a 3×3 conv, noise, leaky ReLU (not drawn) and AdaIN (the 4×4 block starts from the constant, without upsampling or the first conv); ${nLayers} layers from 4² to 1024², then a 1×1 conv to RGB`,
      ],
    };

const id = 'stylegan-flow';
const blocks = ['4×4', '8×8', '16×16', '1024²'];
// Blocks followed by a plain arrow to the next block (the third one is followed by the ellipsis).
const linked = (i: number) => i === 0 || i === 1;

// Wide layout: the synthesis chain runs left to right, the bus of w above it, the noise below.
const W = {
  z: [16, 18, 72, 48], f: [110, 18, 176, 48], w: [308, 18, 72, 48], busY: 86,
  rowY: 180, bh: 50, cst: [16, 92], bx: [136, 256, 376, 526], bw: [90, 90, 90, 100], img: [656, 88], dots: 496,
  aY: 104, aH: 30, aW: 36, bY: 270, nY: 300,
  inset: [16, 350, 728, 118],
};
const wc = W.bx.map((x, i) => x + W.bw[i] / 2);
const wMid = W.rowY + W.bh / 2;
const wInsetY = 412;
const wPlus = 318;
const wPlusIn = rim(274, wInsetY, wPlus, wInsetY);

// Narrow layout: the synthesis chain runs top to bottom, the bus of w on the right, the noise on the left.
const N = {
  z: [8, 16, 56, 44], f: [86, 16, 150, 44], w: [258, 16, 60, 44], busX: 336,
  colX: 96, cw: 124, bh: 44, cstY: 92, by: [164, 236, 308, 396], imgY: 470, dotsY: 380,
  aX: 260, aW: 40, aH: 28, nX: 52,
  inset: [4, 530, 352, 118],
};
const nc = N.colX + N.cw / 2;
const nInsetY = 592;
const nPlus = 220;
const nPlusIn = rim(186, nInsetY, nPlus, nInsetY);
---

<Figure
  id={id}
  title={ru ? 'Генератор StyleGAN: отображающая сеть, стили и шум' : 'The StyleGAN generator: mapping network, styles and noise'}
  caption={ru
    ? `Зелёный — входной код z, синие — w и карты признаков, жёлтые — обучаемые отображения, красный — изображение. Код z входит только в отображающую сеть f (${mapDepth} слоёв, 512 → 512); синтез начинается с обучаемой константы. У каждого из ${nLayers} слоёв своё аффинное отображение A одного и того же w и свой шум; показаны первые три блока и последний, на врезке — один проход блока.`
    : `Green: the input code z; blue: w and the feature maps; amber: learned maps; red: the image. z enters only the mapping network f (${mapDepth} layers, 512 → 512); synthesis starts from a learned constant. Each of the ${nLayers} layers has its own affine map A of the same w and its own noise; the first three blocks and the last are drawn, and the inset shows one pass of a block.`}
>
  <svg class="fig-wide" viewBox="0 0 760 476" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{ru ? 'Генератор StyleGAN' : 'The StyleGAN generator'}</title>
    <desc id={`${id}-w-d`}>{ru ? 'Сверху: z, отображающая сеть f и код w. От w идёт горизонтальная шина к четырём блокам A, каждый из которых подаёт стиль в свой блок синтеза. Средний ряд: константа 4×4×512, блоки 4×4, 8×8, 16×16, многоточие, блок 1024² и изображение x. Под каждым блоком — узел B, через который входит шум. Внизу врезка: увеличение, свёртка, сложение с шумом, AdaIN со стилем A(w).' : 'Top: z, the mapping network f and the code w. A horizontal bus runs from w to four A boxes, each feeding a style into its synthesis block. Middle row: the 4×4×512 constant, blocks 4×4, 8×8, 16×16, an ellipsis, block 1024² and the image x. Below every block a node B through which noise enters. Bottom inset: upsample, convolution, addition of noise, AdaIN with the style A(w).'}</desc>

    <g data-s="1">
      <Box x={W.z[0]} y={W.z[1]} w={W.z[2]} h={W.z[3]} label="z" sub={t.zSub} tone="x" math subGap={19} />
      <Arrow pts={[[W.z[0] + W.z[2], 42], [W.f[0] - 2, 42]]} />
      <Box x={W.f[0]} y={W.f[1]} w={W.f[2]} h={W.f[3]} label="f" sub={t.fSub} tone="g" math subGap={19} />
      <Arrow pts={[[W.f[0] + W.f[2], 42], [W.w[0] - 2, 42]]} />
      <Box x={W.w[0]} y={W.w[1]} w={W.w[2]} h={W.w[3]} label="w" sub={t.wSub} tone="h" math subGap={19} />
    </g>
    <Badge x={W.f[0] - 10} y={W.z[1] + W.z[3] + 16} n={1} />

    <g data-s="3">
      <path class="f-line f-blue" d={`M ${W.w[0] + W.w[2] / 2} ${W.w[1] + W.w[3]} V ${W.busY} M ${wc[0]} ${W.busY} H ${wc[3]}`} />
      {wc.map((cx, i) => (
        <g>
          <Arrow pts={[[cx, W.busY], [cx, W.aY - 2]]} tone="blue" />
          <Box x={cx - W.aW / 2} y={W.aY} w={W.aW} h={W.aH} label="A" tone="g" />
          <Arrow pts={[[cx, W.aY + W.aH], [cx, W.rowY - 2]]} tone="amber" />
          {i === 0 && <text class="f-small f-t-amber f-halo" x={cx + 8} y={W.rowY - 18}><Sub label={t.style} /></text>}
        </g>
      ))}
    </g>
    <Badge x={wc[0] - 26} y={W.busY} n={3} />

    <g data-s="2">
      <Box x={W.cst[0]} y={W.rowY} w={W.cst[1]} h={W.bh} label="const" sub={t.constSub} tone="h" />
    </g>
    <Badge x={W.cst[0] + 8} y={W.rowY + W.bh + 16} n={2} />
    <g data-s="2 5">
      <Arrow pts={[[W.cst[0] + W.cst[1], wMid], [W.bx[0] - 2, wMid]]} />
      {blocks.map((b, i) => (
        <g>
          <Box x={W.bx[i]} y={W.rowY} w={W.bw[i]} h={W.bh} label={b} sub={t.blockSub} tone="h" />
          {linked(i) && <Arrow pts={[[W.bx[i] + W.bw[i], wMid], [W.bx[i + 1] - 2, wMid]]} />}
        </g>
      ))}
      <Arrow pts={[[W.bx[2] + W.bw[2], wMid], [W.dots - 12, wMid]]} />
      <text class="f-label" x={W.dots} y={wMid + 5} text-anchor="middle">…</text>
      <Arrow pts={[[W.dots + 12, wMid], [W.bx[3] - 2, wMid]]} />
      <Arrow pts={[[W.bx[3] + W.bw[3], wMid], [W.img[0] - 2, wMid]]} />
      <Box x={W.img[0]} y={W.rowY} w={W.img[1]} h={W.bh} label={t.img} sub={t.imgSub} tone="y" math subGap={19} />
    </g>

    <g data-s="4">
      {wc.map((cx) => (
        <g>
          <Box x={cx - 28} y={W.nY} w={56} h={26} label={t.noise} />
          <Arrow pts={[[cx, W.nY], [cx, W.bY + 15]]} />
          <Op x={cx} y={W.bY} sym="B" tone="amber" />
          <Arrow pts={[[cx, W.bY - 13], [cx, W.rowY + W.bh + 2]]} />
        </g>
      ))}
    </g>
    <Badge x={wc[0] - 46} y={W.nY + 13} n={4} />

    <g data-s="5">
      <rect x={W.inset[0]} y={W.inset[1]} width={W.inset[2]} height={W.inset[3]} rx="10" style="fill: none; stroke: var(--line); stroke-width: 1.2; stroke-dasharray: 5 4" />
      <text class="f-small f-t-muted" x={W.inset[0] + 28} y={W.inset[1] + 22}>{t.inset}</text>
      <Box x={36} y={wInsetY - 20} w={110} h={40} label={t.up} />
      <Arrow pts={[[146, wInsetY], [176, wInsetY]]} />
      <Box x={178} y={wInsetY - 20} w={96} h={40} label={t.conv} sub="3×3" tone="g" />
      <Arrow pts={[[274, wInsetY], wPlusIn]} />
      <Op x={wPlus} y={wInsetY} sym="+" />
      <Arrow pts={[[wPlus, wInsetY + 34], [wPlus, wInsetY + 15]]} />
      <text class="f-small f-t-muted" x={wPlus} y={wInsetY + 48} text-anchor="middle">{t.bNoise}</text>
      <Arrow pts={[[wPlus + 13, wInsetY], [362, wInsetY]]} />
      <Box x={364} y={wInsetY - 20} w={96} h={40} label="AdaIN" tone="h" />
      <text class="f-small f-t-amber" x={412} y={W.inset[1] + 22} text-anchor="middle">{t.aw}</text>
      <Arrow pts={[[412, W.inset[1] + 28], [412, wInsetY - 22]]} tone="amber" />
      <Arrow pts={[[460, wInsetY], [488, wInsetY]]} />
      <text class="f-small f-t-muted" x={494} y={wInsetY + 4}>{t.again}</text>
    </g>
    <Badge x={W.inset[0] + 12} y={W.inset[1] + 18} n={5} />
  </svg>

  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 656" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{ru ? 'Генератор StyleGAN' : 'The StyleGAN generator'}</title>
    <desc id={`${id}-n-d`}>{ru ? 'Сверху: z, отображающая сеть f и код w. От w вниз идёт шина к блокам A справа, каждый подаёт стиль в свой блок синтеза. Столбец в середине: константа, блоки 4×4, 8×8, 16×16, многоточие, 1024² и изображение x. Слева от каждого блока узел B с шумом. Внизу врезка: увеличение, свёртка, сложение с шумом, AdaIN со стилем A(w).' : 'Top: z, the mapping network f and the code w. A bus runs down from w to the A boxes on the right, each feeding a style into its synthesis block. Middle column: the constant, blocks 4×4, 8×8, 16×16, an ellipsis, 1024² and the image x. Left of every block a node B with noise. Bottom inset: upsample, convolution, addition of noise, AdaIN with the style A(w).'}</desc>

    <g data-s="1">
      <Box x={N.z[0]} y={N.z[1]} w={N.z[2]} h={N.z[3]} label="z" sub={t.zSub} tone="x" math subGap={19} />
      <Arrow pts={[[N.z[0] + N.z[2], 38], [N.f[0] - 2, 38]]} />
      <Box x={N.f[0]} y={N.f[1]} w={N.f[2]} h={N.f[3]} label="f" sub={t.fSub} tone="g" math subGap={19} />
      <Arrow pts={[[N.f[0] + N.f[2], 38], [N.w[0] - 2, 38]]} />
      <Box x={N.w[0]} y={N.w[1]} w={N.w[2]} h={N.w[3]} label="w" sub={t.wSub} tone="h" math subGap={19} />
    </g>
    <Badge x={N.f[0] - 10} y={N.z[1] + N.z[3] + 14} n={1} />

    <g data-s="3">
      <path class="f-line f-blue" d={`M ${N.w[0] + N.w[2]} ${N.z[1] + N.z[3] / 2} H ${N.busX} V ${N.by[3] + N.bh / 2}`} />
      {N.by.map((by, i) => (
        <g>
          <Arrow pts={[[N.busX, by + N.bh / 2], [N.aX + N.aW + 2, by + N.bh / 2]]} tone="blue" />
          <Box x={N.aX} y={by + N.bh / 2 - N.aH / 2} w={N.aW} h={N.aH} label="A" tone="g" />
          <Arrow pts={[[N.aX, by + N.bh / 2], [N.colX + N.cw + 2, by + N.bh / 2]]} tone="amber" />
          {i === 0 && <text class="f-small f-t-amber f-halo" x={N.aX + N.aW / 2} y={by - 4} text-anchor="middle"><Sub label={t.style} /></text>}
        </g>
      ))}
    </g>
    <Badge x={N.busX} y={N.by[0] - 22} n={3} />

    <g data-s="2">
      <Box x={N.colX} y={N.cstY} w={N.cw} h={N.bh} label="const" sub={t.constSub} tone="h" subGap={19} />
    </g>
    <Badge x={N.colX - 14} y={N.cstY + 10} n={2} />
    <g data-s="2 5">
      <Arrow pts={[[nc, N.cstY + N.bh], [nc, N.by[0] - 2]]} />
      {blocks.map((b, i) => (
        <g>
          <Box x={N.colX} y={N.by[i]} w={N.cw} h={N.bh} label={b} sub={t.blockSub} tone="h" subGap={19} />
          {linked(i) && <Arrow pts={[[nc, N.by[i] + N.bh], [nc, N.by[i + 1] - 2]]} />}
        </g>
      ))}
      <Arrow pts={[[nc, N.by[2] + N.bh], [nc, N.dotsY - 12]]} />
      <text class="f-label" x={nc} y={N.dotsY + 2} text-anchor="middle">⋮</text>
      <Arrow pts={[[nc, N.dotsY + 4], [nc, N.by[3] - 2]]} />
      <Arrow pts={[[nc, N.by[3] + N.bh], [nc, N.imgY - 2]]} />
      <Box x={N.colX} y={N.imgY} w={N.cw} h={N.bh} label={t.img} sub={t.imgSub} tone="y" math subGap={19} />
    </g>

    <g data-s="4">
      <text class="f-small f-t-muted" x={N.nX} y={N.by[0] - 4} text-anchor="middle">{t.noise}</text>
      {N.by.map((by) => (
        <g>
          <Op x={N.nX} y={by + N.bh / 2} sym="B" tone="amber" />
          <Arrow pts={[[N.nX + 13, by + N.bh / 2], [N.colX - 2, by + N.bh / 2]]} />
        </g>
      ))}
    </g>
    <Badge x={N.nX - 30} y={N.by[0] + N.bh / 2} n={4} />

    <g data-s="5">
      <rect x={N.inset[0]} y={N.inset[1]} width={N.inset[2]} height={N.inset[3]} rx="10" style="fill: none; stroke: var(--line); stroke-width: 1.2; stroke-dasharray: 5 4" />
      <text class="f-small f-t-muted" x={N.inset[0] + 26} y={N.inset[1] + 20}>{ru ? 'внутри блока, ×2' : 'inside a block, ×2'}</text>
      <Box x={10} y={nInsetY - 18} w={86} h={36} label={ru ? '↑ 2×' : 'up 2×'} />
      <Arrow pts={[[96, nInsetY], [112, nInsetY]]} />
      <Box x={114} y={nInsetY - 22} w={72} h={44} label={t.conv} sub="3×3" tone="g" subGap={19} />
      <Arrow pts={[[186, nInsetY], nPlusIn]} />
      <Op x={nPlus} y={nInsetY} sym="+" />
      <Arrow pts={[[nPlus, nInsetY + 30], [nPlus, nInsetY + 15]]} />
      <text class="f-small f-t-muted" x={nPlus} y={nInsetY + 42} text-anchor="middle">{t.bNoise}</text>
      <Arrow pts={[[nPlus + 13, nInsetY], [256, nInsetY]]} />
      <Box x={258} y={nInsetY - 18} w={88} h={36} label="AdaIN" tone="h" />
      <text class="f-small f-t-amber" x={302} y={N.inset[1] + 20} text-anchor="middle">A(w)</text>
      <Arrow pts={[[302, N.inset[1] + 26], [302, nInsetY - 20]]} tone="amber" />
    </g>
    <Badge x={N.inset[0] + 12} y={N.inset[1] + 15} n={5} />
  </svg>
  <Stepper steps={t.steps} />
</Figure>
