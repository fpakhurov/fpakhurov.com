---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { cases } from './styleCases';

const ru = pageLang(Astro.url) === 'ru';
// Original numeric comparison, replacing the historical paper-architecture redraw.
const t = ru ? {
  title: 'Стиль меняет моменты; шум меняет пространственный узор',
  caption: 'Четыре позиции: x = (−3, −1, 1, 3), n = (1, −1, −1, 1). Нормализуем x + bn и применяем стиль. Вторая строка меняет стиль, третья — знак шума. Свёртка, активация и стабилизатор опущены.',
  rows: ['Исходный вариант', 'Другой стиль', 'Другой шум'],
  output: 'Четыре позиции выхода', mean: 'среднее', std: 'ст. откл.',
} : {
  title: 'Style changes moments; noise changes the spatial pattern',
  caption: 'Four positions: x = (−3, −1, 1, 3), n = (1, −1, −1, 1). Normalize x + bn, then apply the style. The second row changes style; the third reverses noise. Convolution, activation and the stabilizer are omitted.',
  rows: ['Initial setting', 'Different style', 'Different noise'],
  output: 'Four output positions', mean: 'mean', std: 'std',
};
const layouts = [
  { cls: 'fig-wide', w: 760, h: 330, step: 94, cellX: 268, cellY: 16, cellW: 74, statX: 610 },
  { cls: 'fig-narrow', w: 360, h: 540, step: 160, cellX: 16, cellY: 64, cellW: 78, statX: 16 },
];
const fmt = (v: number) => v.toFixed(2).replace('-', '−');
---
<Figure id="stylegan-flow" title={t.title} caption={t.caption}>
  {layouts.map(l => <svg class={l.cls} viewBox={`0 0 ${l.w} ${l.h}`} role="img" aria-labelledby={`style-cases-${l.w}`}>
    <title id={`style-cases-${l.w}`}>{t.title}</title>
    <desc>{ru ? 'Три строки показывают вычисленные значения. Изменение стиля удваивает стандартное отклонение и сдвигает среднее; изменение шума сохраняет моменты, но меняет значения позиций.' : 'Three rows show computed values. Changing style doubles standard deviation and shifts the mean; changing noise preserves those moments but changes individual positions.'}</desc>
    <text x="16" y="22" class="f-small f-t-muted">{t.output}</text>
    {cases.map((c, i) => <g transform={`translate(0 ${38+i*l.step})`}>
      <text x="16" y="20" class="f-label" font-weight="600">{t.rows[i]}</text>
      <text x="16" y="44" class="f-small f-t-muted">{`b = ${c.noiseScale};  yₛ = ${c.scale};  yᵦ = ${c.shift}`}</text>
      {c.output.map((v,j) => <g transform={`translate(${l.cellX+j*(l.cellW+4)} ${l.cellY})`}>
        <rect width={l.cellW} height="43" rx="6" style={`fill: var(${i===1?'--fig-amber':'--fig-blue'}); fill-opacity: .14; stroke: var(--line)`} />
        <text x={l.cellW/2} y="27" text-anchor="middle" class="f-label">{fmt(v)}</text>
      </g>)}
      {l.w===760 ? <g>
        <text x={l.statX} y="29" class="f-small">{`${t.mean}: ${Math.round(c.mean)}`}</text>
        <text x={l.statX} y="52" class="f-small">{`${t.std}: ${Math.round(c.std)}`}</text>
      </g> : <text x="16" y="134" class="f-small">{`${t.mean}: ${Math.round(c.mean)};  ${t.std}: ${Math.round(c.std)}`}</text>}
      {i<2 && <line x1="16" x2={l.w-16} y1={l.step-9} y2={l.step-9} class="f-axis" />}
    </g>)}
  </svg>)}
</Figure>
