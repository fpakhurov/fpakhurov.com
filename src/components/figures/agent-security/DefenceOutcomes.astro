---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The outcomes of the toy agent of the Code section, run on six documents that carry an injection and four that do not,
// under three designs: naive, a keyword detector, and CaMeL-style taint tracking. Counts are what the Code section
// prints. The quantities are the number of documents whose injection leaked the private file (out of 6, lower better)
// and the number of the ten documents on which the user's own task still completed (out of 10, higher better).
const designs = [
  { key: 'naive', leaked: 6, done: 10 },
  { key: 'detector', leaked: 3, done: 5 },
  { key: 'taint', leaked: 0, done: 10 },
];
const quoted = designs.map((d) => `${d.leaked}/${d.done}`).join(' ');
if (quoted !== '6/10 3/5 0/10') throw new Error(`DefenceOutcomes: counts drifted from the Code section (${quoted})`);

const t = ru
  ? { title: 'Три защиты на игрушечном агенте: утечки и выполненные задачи', y1: 'утечек (из 6)', y2: 'задач выполнено (из 10)',
      names: { naive: 'наивный', detector: 'детектор', taint: 'поток данных' },
      leak: 'секрет утёк', done: 'задача выполнена',
      desc: 'Для трёх вариантов агента показаны два столбца. Наивный агент: 6 утечек из 6 и 10 выполненных задач из 10. Детектор по ключевым словам: 3 утечки и 5 задач (заодно он блокирует половину честных документов). Отслеживание меток в потоке данных: 0 утечек и 10 задач.' }
  : { title: 'Three defences on the toy agent: leaks and completed tasks', y1: 'leaks (of 6)', y2: 'tasks done (of 10)',
      names: { naive: 'naive', detector: 'detector', taint: 'taint tracking' },
      leak: 'secret leaked', done: 'user task done',
      desc: 'For three agent designs, two bars each. Naive: 6 leaks of 6 and 10 completed tasks of 10. Keyword detector: 3 leaks and 5 tasks (it also blocks half the honest documents). Data-flow taint tracking: 0 leaks and 10 tasks.' };
const id = 'defence-outcomes';
const caption = ru
  ? 'На шести документах с инъекцией и четырёх без неё. Наивный агент выполняет все задачи и допускает все утечки. Детектор по ключевым словам ловит часть инъекций, но отвергает и честные документы с теми же словами, поэтому теряет половину задач. Отслеживание меток (taint tracking, упрощённый CaMeL) блокирует отправку любых данных, помеченных как пришедшие из документа, адресату, которого не называл пользователь: 0 утечек и все задачи выполнены. Текстовую атаку (вписать слово в краткое изложение) ни одна из защит не ловит — она не нарушает поток данных.'
  : 'On six documents that carry an injection and four that do not. The naive agent completes every task and lets every leak through. The keyword detector catches some injections but also rejects honest documents with the same words, so it loses half the tasks. Taint tracking (a simplified CaMeL) blocks sending any data marked as coming from the document to a recipient the user did not name: 0 leaks, every task done. A text-only attack (writing a word into the summary) is caught by none of them, because it changes no data flow.';

const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 300, px: [70, 700] as [number, number], py: [40, 230] as [number, number], bw: 40, gap: 210 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 360, px: [54, 340] as [number, number], py: [40, 280] as [number, number], bw: 26, gap: 95 },
];
const yTicks = [0, 2, 4, 6, 8, 10];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sy = scale([0, 10], [L.py[1], L.py[0]]);
    const centers = designs.map((_, i) => L.px[0] + 60 + i * L.gap);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {yTicks.map((v) => <path class="f-grid" d={`M ${L.px[0]} ${sy(v)} H ${L.px[1]}`} />)}
        <path class="f-axis" d={`M ${L.px[0]} ${L.py[0] - 6} V ${L.py[1]} H ${L.px[1]}`} />
        {yTicks.map((v) => <text class="f-small" x={L.px[0] - 7} y={sy(v) + 4} text-anchor="end">{String(v)}</text>)}
        {designs.map((d, i) => (
          <g>
            <rect x={centers[i] - L.bw - 3} y={sy(d.leaked)} width={L.bw} height={L.py[1] - sy(d.leaked)} style="fill: var(--fig-red); fill-opacity: 0.75" />
            <rect x={centers[i] + 3} y={sy(d.done)} width={L.bw} height={L.py[1] - sy(d.done)} style="fill: var(--fig-green); fill-opacity: 0.75" />
            <text class="f-small f-t-red f-halo" x={centers[i] - L.bw / 2 - 3} y={sy(d.leaked) - 5} text-anchor="middle">{String(d.leaked)}</text>
            <text class="f-small f-t-green f-halo" x={centers[i] + L.bw / 2 + 3} y={sy(d.done) - 5} text-anchor="middle">{String(d.done)}</text>
            <text class="f-small f-t-muted" x={centers[i]} y={L.py[1] + 18} text-anchor="middle">{t.names[d.key as keyof typeof t.names]}</text>
          </g>
        ))}
        <g>
          <rect x={L.px[0]} y={L.py[0] - 30} width="13" height="12" style="fill: var(--fig-red); fill-opacity: 0.75" />
          <text class="f-small f-t-red" x={L.px[0] + 18} y={L.py[0] - 20}>{t.leak}</text>
          <rect x={L.px[0] + 150} y={L.py[0] - 30} width="13" height="12" style="fill: var(--fig-green); fill-opacity: 0.75" />
          <text class="f-small f-t-green" x={L.px[0] + 168} y={L.py[0] - 20}>{t.done}</text>
        </g>
      </svg>
    );
  })}
</Figure>
