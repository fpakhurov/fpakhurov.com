---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Indirect prompt injection in the toy agent of the Code section. The user's request and the document the agent reads
// end up in one context; the model cannot tell which text is an instruction, so a sentence in the document becomes a
// tool call. The three conditions of the "lethal trifecta" are marked: private data, untrusted content, a way out.
const t = ru
  ? {
      title: 'Косвенная инъекция в промпт: путь от документа до отправки',
      user: 'пользователь', userSub: 'кратко изложи отчёт',
      doc: 'документ', docSub: 'текст + чужая фраза',
      ctx: 'контекст модели', ctxSub: 'запрос + документ',
      model: 'модель', modelSub: 'одна лента токенов',
      call: 'вызов send_email', callSub: 'to = attacker.example',
      secret: 'закрытый файл', secretSub: 'секрет (игрушечный)',
      out: 'отправка', outSub: 'наружу',
      tri: ['недоверенный текст', 'закрытые данные', 'канал наружу'],
      steps: ['пользователь просит агента кратко изложить документ и отправить изложение коллеге', 'агент читает документ; в нём есть фраза, обращённая к агенту', 'запрос и документ попадают в один контекст, и разметки «это данные» там нет', 'модель читает фразу документа как инструкцию', 'она вызывает инструмент с адресом из документа и читает закрытый файл', 'среда выполнения исполняет вызов: данные уходят по адресу злоумышленника'],
      desc: 'Слева запрос пользователя и документ с чужой фразой. Оба попадают в контекст модели. Модель выдаёт вызов инструмента отправки письма с адресом из документа, читает закрытый файл и отправляет его наружу. Три условия, при которых это возможно, отмечены: недоверенное содержимое, закрытые данные и канал наружу.',
    }
  : {
      title: 'Indirect prompt injection: from a document to a send',
      user: 'user', userSub: 'summarize the report',
      doc: 'document', docSub: 'text + a planted line',
      ctx: 'model context', ctxSub: 'request and document',
      model: 'model', modelSub: 'one stream of tokens',
      call: 'send_email call', callSub: 'to = attacker.example',
      secret: 'private file', secretSub: 'a (toy) secret',
      out: 'send', outSub: 'out',
      tri: ['untrusted content', 'private data', 'a way out'],
      steps: ['the user asks the agent to summarize a document and send the summary to a colleague', 'the agent reads the document; it contains a line addressed to the agent', 'the request and the document end up in one context, with no marking that says "this is data"', 'the model reads the line from the document as an instruction', 'it calls a tool with the address from the document and reads the private file', 'the runtime executes the call: the data goes to the attacker’s address'],
      desc: 'On the left, the user’s request and a document with a planted line. Both enter the model’s context. The model emits a call to the e-mail tool with the address from the document, reads the private file and sends it out. The three conditions that make this possible are marked: untrusted content, private data and a way out.',
    };
const id = 'injection-flow';
const caption = ru
  ? 'Атака не требует доступа к агенту: достаточно, чтобы агент прочитал текст злоумышленника. Она удаётся, когда сходятся три условия (выделены янтарным): агент читает недоверенное содержимое, имеет доступ к закрытым данным и может отправить что-то наружу. Убрав любое из трёх, атаку этого вида можно остановить; модель же сама не может надёжно отличить инструкцию от данных.'
  : 'The attack needs no access to the agent: it is enough that the agent reads the attacker’s text. It succeeds when three conditions meet (marked in amber): the agent reads untrusted content, has access to private data, and can send something out. Removing any one of the three stops this kind of attack; the model by itself cannot reliably tell an instruction from data.';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 300" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <g data-s="1">
      <Box x={16} y={20} w={150} h={50} label={t.user} sub={t.userSub} tone="x" />
      <Badge x={154} y={20} n={1} />
    </g>
    <g data-s="2">
      <Box x={16} y={130} w={150} h={50} label={t.doc} sub={t.docSub} tone="g" />
      <Badge x={154} y={130} n={2} />
      <text class="f-small f-t-amber f-halo" x="91" y="200" text-anchor="middle">{t.tri[0]}</text>
    </g>
    <g data-s="3">
      <Arrow pts={[[166, 45], [200, 45], [200, 88], [222, 88]]} />
      <Arrow pts={[[166, 155], [200, 155], [200, 112], [222, 112]]} />
      <Box x={224} y={75} w={160} h={50} label={t.ctx} sub={t.ctxSub} tone="h" />
      <Badge x={372} y={75} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[384, 100], [410, 100]]} />
      <Box x={412} y={75} w={150} h={50} label={t.model} sub={t.modelSub} tone="h" />
      <Badge x={550} y={75} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[562, 100], [588, 100]]} tone="red" />
      <Box x={590} y={75} w={156} h={50} label={t.call} sub={t.callSub} tone="y" />
      <Badge x={734} y={75} n={5} />
      <Box x={412} y={190} w={150} h={50} label={t.secret} sub={t.secretSub} tone="g" />
      <Arrow pts={[[562, 215], [640, 215], [640, 127]]} tone="green" />
      <text class="f-small f-t-amber f-halo" x="487" y="260" text-anchor="middle">{t.tri[1]}</text>
    </g>
    <g data-s="6">
      <Arrow pts={[[700, 125], [700, 188]]} tone="red" />
      <Box x={660} y={190} w={86} h={50} label={t.out} sub={t.outSub} tone="y" />
      <text class="f-small f-t-amber f-halo" x="703" y="260" text-anchor="middle">{t.tri[2]}</text>
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 560" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <g data-s="1">
      <Box x={10} y={10} w={160} h={50} label={t.user} sub={t.userSub} tone="x" />
      <Badge x={158} y={10} n={1} />
    </g>
    <g data-s="2">
      <Box x={190} y={10} w={160} h={50} label={t.doc} sub={t.docSub} tone="g" />
      <Badge x={338} y={10} n={2} />
      <text class="f-small f-t-amber f-halo" x="270" y="80" text-anchor="middle">{t.tri[0]}</text>
    </g>
    <g data-s="3">
      <Arrow pts={[[90, 60], [90, 110], [128, 110]]} />
      <Arrow pts={[[270, 90], [270, 110], [232, 110]]} />
      <Box x={100} y={100} w={160} h={50} label={t.ctx} sub={t.ctxSub} tone="h" />
      <Badge x={248} y={100} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[180, 150], [180, 178]]} />
      <Box x={100} y={180} w={160} h={50} label={t.model} sub={t.modelSub} tone="h" />
      <Badge x={248} y={180} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[180, 230], [180, 258]]} tone="red" />
      <Box x={90} y={260} w={180} h={50} label={t.call} sub={t.callSub} tone="y" />
      <Badge x={258} y={260} n={5} />
      <Box x={90} y={350} w={180} h={50} label={t.secret} sub={t.secretSub} tone="g" />
      <Arrow pts={[[150, 350], [150, 312]]} tone="green" />
      <text class="f-small f-t-amber f-halo" x="180" y="420" text-anchor="middle">{t.tri[1]}</text>
    </g>
    <g data-s="6">
      <Arrow pts={[[270, 285], [320, 285], [320, 450], [272, 450]]} tone="red" />
      <Box x={90} y={430} w={180} h={50} label={t.out} sub={t.outSub} tone="y" />
      <text class="f-small f-t-amber f-halo" x="180" y="500" text-anchor="middle">{t.tri[2]}</text>
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
