---
import Figure from '../Figure.astro';

// Shapes of scaled dot-product attention for n = 3 tokens, d_k = d_v = 2.
// The matrices are the worked example of the note: Q = K = V = X.
const n = 3;
const dk = 2;
const X: number[][] = [[1, 0], [0, 1], [1, 1]];
const scores = X.map((q) => X.map((k) => (q[0] * k[0] + q[1] * k[1]) / Math.sqrt(dk)));
const weights = scores.map((row) => {
  const e = row.map((v) => Math.exp(v));
  const Z = e.reduce((a, b) => a + b, 0);
  return e.map((v) => v / Z);
});
const out = weights.map((row) => [0, 1].map((c) => row.reduce((acc, w, j) => acc + w * X[j][c], 0)));
const f = (v: number) => (Math.abs(v) < 1e-9 ? '0' : v.toFixed(2).replace(/^0\./, '.').replace(/^-0\./, '-.'));

const cell = 34;
interface Block { label: string; sub: string; rows: number; cols: number; values: number[][]; cls?: string }
const blocks: Block[] = [
  { label: 'Q', sub: `${n} × ${dk}`, rows: n, cols: dk, values: X },
  { label: 'Kᵀ', sub: `${dk} × ${n}`, rows: dk, cols: n, values: [0, 1].map((c) => X.map((r) => r[c])) },
  { label: 'QKᵀ / √d', sub: `${n} × ${n}`, rows: n, cols: n, values: scores, cls: 'f-fill-amber' },
  { label: 'softmax', sub: `${n} × ${n}, rows sum to 1`, rows: n, cols: n, values: weights, cls: 'f-fill-blue' },
  { label: 'V', sub: `${n} × ${dk}`, rows: n, cols: dk, values: X },
  { label: 'output', sub: `${n} × ${dk}`, rows: n, cols: dk, values: out, cls: 'f-fill-green' },
];
const ops = ['×', '=', '→', '×', '='];

interface Layout { cls: string; w: number; h: number; positions: [number, number][] }
const layouts: Layout[] = [
  { cls: 'fig-wide', w: 760, h: 200, positions: [[20, 60], [116, 77], [250, 60], [396, 60], [546, 60], [650, 60]] },
  { cls: 'fig-narrow', w: 360, h: 420, positions: [[20, 50], [118, 67], [250, 50], [20, 250], [160, 250], [262, 250]] },
];
---

<Figure
  id="attention-shapes"
  title="Scaled dot-product attention for three tokens in two dimensions"
  caption={`Q, K and V are the same 3 × 2 matrix here (identity projections). QKᵀ is 3 × 3: entry (i, j) is the dot product of token i's query with token j's key, divided by √2. A row-wise softmax turns each row into weights that sum to one. The output row for token i is the weighted sum of the value rows; token 3, whose query matched itself best, keeps half of its own value and mixes in a quarter of each neighbour.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`attention-shapes-${L.w}-t attention-shapes-${L.w}-d`}>
      <title id={`attention-shapes-${L.w}-t`}>Matrix shapes in scaled dot-product attention</title>
      <desc id={`attention-shapes-${L.w}-d`}>Six small matrices with their numeric entries: Q (3 by 2), K transposed (2 by 3), the scaled score matrix (3 by 3), the softmax weights (3 by 3, rows summing to one), V (3 by 2) and the output (3 by 2). Operators between them read: times, equals, arrow, times, equals.</desc>
      {blocks.map((b, bi) => {
        const [x, y] = L.positions[bi];
        return (
          <g>
            <text class="f-title" x={x + (b.cols * cell) / 2} y={y - 22} text-anchor="middle">{b.label}</text>
            {b.values.map((row, r) => row.map((v, c) => (
              <g>
                <rect class={`f-box-soft ${b.cls ?? ''}`} x={x + c * cell} y={y + r * cell} width={cell} height={cell} />
                <text class="f-small" x={x + c * cell + cell / 2} y={y + r * cell + cell / 2 + 5} text-anchor="middle" font-family="var(--mono)">{f(v)}</text>
              </g>
            )))}
            <text class="f-note" x={x + (b.cols * cell) / 2} y={y + b.rows * cell + 18} text-anchor="middle">{b.sub}</text>
            {bi < ops.length && !(L.cls === 'fig-narrow' && bi === 2) && (
              <text class="f-label" x={x + b.cols * cell + (L.positions[bi + 1][0] - x - b.cols * cell) / 2} y={y + 40} text-anchor="middle">{ops[bi]}</text>
            )}
            {L.cls === 'fig-narrow' && bi === 2 && <text class="f-label" x={x + (b.cols * cell) / 2} y={y + b.rows * cell + 48} text-anchor="middle">↓ softmax, row by row</text>}
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
