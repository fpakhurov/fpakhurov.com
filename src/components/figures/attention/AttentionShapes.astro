---
import Figure from '../Figure.astro';

// Shapes of scaled dot-product self-attention, drawn to scale for n = 5 tokens,
// d = 8 and d_k = d_v = 4. One query row (token 2) is traced through every step.
const n = 5;
const d = 8;
const dk = 4;
const traced = 1; // zero-based row index of token 2
const c = 14; // px per matrix entry

type Hue = 'blue' | 'red' | 'amber' | 'green' | 'muted';
interface Block { name: string; shape: string; rows: number; cols: number; x: number; y: number; hue: Hue; mode: 'row' | 'all' }
type Op = { t: string; x: number; y: number };

const top = (y: number, xs: number[]): Block[] => [
  { name: 'X', shape: 'n × d', rows: n, cols: d, x: xs[0], y, hue: 'muted', mode: 'row' },
  { name: 'Q', shape: 'n × d_k', rows: n, cols: dk, x: xs[1], y, hue: 'blue', mode: 'row' },
  { name: 'K', shape: 'n × d_k', rows: n, cols: dk, x: xs[2], y, hue: 'red', mode: 'all' },
  { name: 'V', shape: 'n × d_v', rows: n, cols: dk, x: xs[3], y, hue: 'amber', mode: 'all' },
];
const rest = (p: [number, number][]): Block[] => [
  { name: 'Q', shape: 'n × d_k', rows: n, cols: dk, x: p[0][0], y: p[0][1], hue: 'blue', mode: 'row' },
  { name: 'Kᵀ', shape: 'd_k × n', rows: dk, cols: n, x: p[1][0], y: p[1][1] + ((n - dk) * c) / 2, hue: 'red', mode: 'all' },
  { name: 'S = QKᵀ/√d_k', shape: 'n × n scores', rows: n, cols: n, x: p[2][0], y: p[2][1], hue: 'blue', mode: 'row' },
  { name: 'A = softmax(S)', shape: 'n × n weights', rows: n, cols: n, x: p[3][0], y: p[3][1], hue: 'blue', mode: 'row' },
  { name: 'V', shape: 'n × d_v', rows: n, cols: dk, x: p[4][0], y: p[4][1], hue: 'amber', mode: 'all' },
  { name: 'Y = AV', shape: 'n × d_v', rows: n, cols: dk, x: p[5][0], y: p[5][1], hue: 'green', mode: 'row' },
];

interface Layout {
  cls: string; W: number; H: number; blocks: Block[]; ops: Op[];
  proj: { x1: number; x2: number; y: number; labelX: number; labelY: number; anchor: string; l2: [number, number, string] };
  note: [number, number]; noteText: string;
}
const wide: Layout = {
  cls: 'fig-wide fig-bp-640', W: 760, H: 336,
  blocks: [...top(52, [30, 330, 430, 530]), ...rest([[30, 200], [130, 200], [256, 200], [420, 200], [550, 200], [660, 200]])],
  ops: [{ t: '×', x: 113, y: 242 }, { t: '=', x: 229, y: 242 }, { t: '×', x: 523, y: 242 }, { t: '=', x: 633, y: 242 }],
  proj: { x1: 150, x2: 318, y: 87, labelX: 234, labelY: 78, anchor: 'middle', l2: [234, 108, 'middle'] },
  note: [30, 324], noteText: 'Highlighted: token 2. Its output row is Σⱼ α₂ⱼ vⱼ, a weighted average of all value rows.',
};
const narrow: Layout = {
  cls: 'fig-narrow fig-bp-640', W: 360, H: 516,
  blocks: [...top(52, [14, 168, 232, 296]), ...rest([[14, 214], [106, 214], [220, 214], [24, 388], [140, 388], [258, 388]])],
  ops: [{ t: '×', x: 88, y: 256 }, { t: '=', x: 200, y: 256 }, { t: '×', x: 118, y: 430 }, { t: '=', x: 228, y: 430 }],
  proj: { x1: 132, x2: 158, y: 87, labelX: 14, labelY: 162, anchor: 'start', l2: [14, 180, 'start'] },
  note: [14, 506], noteText: 'Highlighted: token 2; its output is y₂ = Σⱼ α₂ⱼ vⱼ.',
};
const id = 'attention-shapes';
const fill = (h: Hue) => (h === 'muted' ? 'var(--muted)' : `var(--fig-${h})`);
---

<Figure
  id={id}
  title="Matrix shapes in self-attention, one row traced through"
  caption="Drawn to scale for n = 5 tokens, d = 8 and d_k = d_v = 4; each small square is one number. The three projections turn the n × d input into Q, K and V. QKᵀ is n × n: row i holds the scores of token i's query against every key. The softmax works row by row, and AV gives one d_v-dimensional output per token. The highlighted row follows token 2: its input row, its query, its row of scores and weights, and its output, which mixes all rows of V."
>
  {[wide, narrow].map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>Matrix shapes of scaled dot-product attention</title>
      <desc id={`${id}-${L.W}-d`}>Top: the input X, five rows by eight columns, is multiplied by three projection matrices to give Q, K and V, each five rows by four columns. Below: Q times K transposed gives a five-by-five score matrix, the softmax turns it into a five-by-five weight matrix, and the weights times V give the five-by-four output Y. The second row is highlighted in X, Q, the scores, the weights and the output; all of K and V are shaded because every key and value takes part in that row.</desc>
      {L.blocks.map((b) => (
        <g>
          <text class="f-label" x={b.x + (b.cols * c) / 2} y={b.y - 10} text-anchor="middle" font-weight="600">{b.name}</text>
          {b.mode === 'all' && <rect x={b.x} y={b.y} width={b.cols * c} height={b.rows * c} fill={fill(b.hue)} fill-opacity="0.18" />}
          {b.mode === 'row' && <rect x={b.x} y={b.y + traced * c} width={b.cols * c} height={c} fill={fill(b.hue)} fill-opacity="0.45" />}
          {Array.from({ length: b.rows + 1 }, (_, r) => <path class="f-grid" d={`M ${b.x} ${b.y + r * c} h ${b.cols * c}`} />)}
          {Array.from({ length: b.cols + 1 }, (_, k) => <path class="f-grid" d={`M ${b.x + k * c} ${b.y} v ${b.rows * c}`} />)}
          <rect x={b.x} y={b.y} width={b.cols * c} height={b.rows * c} fill="none" stroke="var(--muted)" stroke-width="1.3" />
          <text class="f-small f-t-muted" x={b.x + (b.cols * c) / 2} y={b.y + Math.max(b.rows, n) * c + 18 - (b.rows < n ? ((n - b.rows) * c) / 2 : 0)} text-anchor="middle">{b.shape}</text>
        </g>
      ))}
      {L.ops.map((o) => <text class="f-label" x={o.x} y={o.y} text-anchor="middle" font-size="20">{o.t}</text>)}
      <path class="f-line" d={`M ${L.proj.x1} ${L.proj.y} H ${L.proj.x2}`} marker-end="url(#f-arrow)" />
      <text class="f-small" x={L.proj.labelX} y={L.proj.labelY} text-anchor={L.proj.anchor}>× W_Q, × W_K, × W_V</text>
      <text class="f-small f-t-muted" x={L.proj.l2[0]} y={L.proj.l2[1]} text-anchor={L.proj.l2[2]}>{L.W === 760 ? 'each d × d_k' : 'each d × d_k, shared by all rows'}</text>
      {L.W === 760 ? (
        <g>
          <path class="f-line f-blue" d="M 340 235 H 410" marker-end="url(#f-arrow-blue)" />
          <text class="f-small f-t-blue" x="374" y="226" text-anchor="middle">softmax</text>
          <text class="f-small f-t-blue" x="374" y="254" text-anchor="middle">per row</text>
        </g>
      ) : (
        <g>
          <path class="f-line f-blue" d="M 255 314 C 255 350, 59 326, 59 358" marker-end="url(#f-arrow-blue)" />
          <text class="f-small f-t-blue" x="266" y="336">softmax,</text>
          <text class="f-small f-t-blue" x="266" y="352">row by row</text>
        </g>
      )}
      <text class="f-note" x={L.note[0]} y={L.note[1]}>{L.noteText}</text>
    </svg>
  ))}
</Figure>
