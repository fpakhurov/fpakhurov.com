---
import Figure from '../Figure.astro';
import { softmaxRows } from './toy';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Four heads of size 8 on a model of width 32, as in the classification model of the note.
// Each head's weights are a toy pattern over n = 6 tokens: score 4 on one target key, 0 elsewhere,
// then a row-wise softmax (weight e⁴/(e⁴ + 5) ≈ 0.92 on the target).
const n = 6;
const d = 32;
const h = 4;
const dk = d / h;
const target: ((i: number) => number)[] = [
  (i) => Math.max(0, i - 1),
  (i) => Math.min(n - 1, i + 1),
  () => 0,
  () => 3,
];
const heads = [
  { name: ru ? 'голова 1' : 'head 1', what: ru ? 'предыдущий токен' : 'previous token', hue: 'blue' },
  { name: ru ? 'голова 2' : 'head 2', what: ru ? 'следующий токен' : 'next token', hue: 'red' },
  { name: ru ? 'голова 3' : 'head 3', what: ru ? 'первый токен' : 'first token', hue: 'amber' },
  { name: ru ? 'голова 4' : 'head 4', what: ru ? 'значимое слово' : 'one content word', hue: 'green' },
].map((hd, k) => ({
  ...hd,
  A: softmaxRows(Array.from({ length: n }, (_, i) => Array.from({ length: n }, (_, j) => (j === target[k](i) ? 4 : 0)))),
}));
const peak = heads[0].A[2][1];
const params = 3 * h * d * dk + d * d;

interface Layout {
  cls: string; W: number; H: number; cell: number;
  x: [number, number, number, number]; // X block x, heatmap x, label x, strip x
  headY: (k: number) => number;
  X: { y: number; w: number; h: number };
  cat: { x: number; y: number; w: number; h: number };
  out: { x: number; y: number; w: number; h: number };
  wo: string; woLabel: [number, number, string];
}
const wide: Layout = {
  cls: 'fig-wide fig-bp-640', W: 760, H: 352, cell: 10,
  x: [24, 170, 244, 392],
  headY: (k) => 28 + k * 78,
  X: { y: 112, w: 64, h: 120 },
  cat: { x: 482, y: 112, w: 64, h: 120 },
  out: { x: 676, y: 112, w: 64, h: 120 },
  wo: 'M 556 172 H 664', woLabel: [610, 162, 'middle'],
};
// Narrow layout: X on top, the four heads in a column, then concat, W_O and the output.
const nhy = (k: number) => 92 + k * 80;
const ncat = { x: 110, y: 428, w: 140, h: 36 };
const id = 'attention-multi-head';
---

<Figure
  id={id}
  title={ru ? "Многоголовое внимание: четыре головы размера 8 в модели ширины 32" : "Multi-head attention: four heads of size 8 in a model of width 32"}
  caption={ru ? `Каждая голова проецирует один и тот же вход X (n × ${d}) в собственные запросы, ключи и значения размера d_k = ${d}/${h} = ${dk}, вычисляет собственные веса n × n и возвращает выход n × ${dk}. Четыре выхода конкатенируются обратно в n × ${d} и смешиваются через W_O. Шаблоны весов — игрушечные примеры на шести токенах (оценка 4 для одного ключа, 0 для остальных, на целевой ключ приходится около ${peak.toFixed(2)} веса): головы могут смотреть на предыдущий токен, на следующий токен, на общий первый токен или на одно значимое слово. Параметров на слой: 3 · ${h} · ${d} · ${dk} + ${d}² = ${params} = 4 · ${d}², столько же, сколько у одной головы полной ширины.` : `Each head projects the same input X (n × ${d}) to its own queries, keys and values of size d_k = ${d}/${h} = ${dk}, computes its own n × n weights and returns an n × ${dk} output. The four outputs are concatenated back to n × ${d} and mixed by W_O. The weight patterns are toy examples over six tokens (score 4 on one key, 0 on the others, about ${peak.toFixed(2)} of the weight on the target): heads can look at the previous token, the next token, a shared first token or one content word. Parameters per layer: 3 · ${h} · ${d} · ${dk} + ${d}² = ${params.toLocaleString('en-US')} = 4 · ${d}², the same as one head of full width.`}
>
  {[wide].map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? "Четыре головы внимания работают параллельно, и их выходы конкатенируются" : "Four attention heads run in parallel and are concatenated"}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? "Вход X слева подаётся в четыре головы. Для каждой головы показан шаблон весов шесть на шесть: голова 1 смотрит на предыдущий токен (полоса под диагональю), голова 2 — на следующий токен (полоса над диагональю), голова 3 — на первый токен (столбец слева), голова 4 — на одно значимое слово (столбец посередине). Каждая голова выдаёт узкую полосу выхода n на 8; четыре полосы ставятся рядом в блок n на 32, который умножается на W_O и даёт выход n на 32." : "The input X on the left feeds four heads. Each head shows a six-by-six weight pattern: head 1 attends to the previous token (a band below the diagonal), head 2 to the next token (a band above the diagonal), head 3 to the first token (a column on the left) and head 4 to one content word (a column in the middle). Each head produces a narrow n by 8 output strip; the four strips are placed side by side into an n by 32 block, which is multiplied by W_O to give the n by 32 output."}</desc>
      <rect x={L.x[0]} y={L.X.y} width={L.X.w} height={L.X.h} fill="var(--muted)" fill-opacity="0.15" stroke="var(--muted)" stroke-width="1.3" />
      <text class="f-label" x={L.x[0] + L.X.w / 2} y={L.X.y - 10} text-anchor="middle" font-weight="600">X</text>
      <text class="f-small f-t-muted" x={L.x[0] + L.X.w / 2} y={L.X.y + L.X.h + 18} text-anchor="middle">n × {d}</text>
      {heads.map((hd, k) => {
        const y0 = L.headY(k);
        const size = n * L.cell;
        return (
          <g>
            <path class="f-thin f-muted" d={`M ${L.x[0] + L.X.w + 4} ${L.X.y + L.X.h / 2} L ${L.x[1] - 6} ${y0 + size / 2}`} marker-end="url(#f-arrow-muted)" />
            {hd.A.map((row, i) => row.map((v, j) => (
              <rect x={L.x[1] + j * L.cell} y={y0 + i * L.cell} width={L.cell} height={L.cell} fill={`var(--fig-${hd.hue})`} fill-opacity={(0.06 + 0.8 * v).toFixed(3)} />
            )))}
            <rect x={L.x[1]} y={y0} width={size} height={size} fill="none" stroke="var(--muted)" stroke-width="1.2" />
            <text class={`f-label f-t-${hd.hue}`} x={L.x[2]} y={y0 + 24} font-weight="650">{hd.name}</text>
            <text class="f-small" x={L.x[2]} y={y0 + 44}>{hd.what}</text>
            <path class={`f-thin f-${hd.hue}`} d={`M ${L.x[3] - 26} ${y0 + size / 2} H ${L.x[3] - 4}`} marker-end={`url(#f-arrow-${hd.hue})`} />
            <rect x={L.x[3]} y={y0} width="16" height={size} fill={`var(--fig-${hd.hue})`} fill-opacity="0.35" stroke={`var(--fig-${hd.hue})`} stroke-width="1.2" />
            {L.W === 760 && <text class="f-note" x={L.x[3] + 24} y={y0 + size / 2 + 5}>n × {dk}</text>}
            <path class="f-thin f-muted" d={`M ${L.x[3] + (L.W === 760 ? 66 : 20)} ${y0 + size / 2} L ${L.cat.x - 6} ${L.cat.y + (k + 0.5) * (L.cat.h / h)}`} marker-end="url(#f-arrow-muted)" />
            <rect x={L.cat.x + k * (L.cat.w / h)} y={L.cat.y} width={L.cat.w / h} height={L.cat.h} fill={`var(--fig-${hd.hue})`} fill-opacity="0.35" />
          </g>
        );
      })}
      <rect x={L.cat.x} y={L.cat.y} width={L.cat.w} height={L.cat.h} fill="none" stroke="var(--muted)" stroke-width="1.3" />
      <text class="f-label" x={ru ? L.cat.x - 2 : L.cat.x + L.cat.w / 2} y={L.cat.y - 10} text-anchor={ru ? 'start' : 'middle'} font-weight="600">{ru ? "конкатенация" : "concat"}</text>
      <text class="f-small f-t-muted" x={L.cat.x + L.cat.w / 2} y={L.cat.y + L.cat.h + 18} text-anchor="middle">n × {d}</text>
      <path class="f-line" d={L.wo} marker-end="url(#f-arrow)" />
      <text class="f-label" x={L.woLabel[0]} y={L.woLabel[1]} text-anchor={L.woLabel[2]}>× W_O</text>
      <text class="f-small f-t-muted" x={L.woLabel[0]} y={L.woLabel[1] + 32} text-anchor={L.woLabel[2]}>{d} × {d}</text>
      <rect x={L.out.x} y={L.out.y} width={L.out.w} height={L.out.h} fill="var(--fig-blue)" fill-opacity="0.12" stroke="var(--muted)" stroke-width="1.3" />
      <text class="f-label" x={L.out.x + L.out.w / 2} y={L.out.y - 10} text-anchor="middle" font-weight="600">{ru ? "выход" : "output"}</text>
      <text class="f-small f-t-muted" x={L.out.x + L.out.w / 2} y={L.out.y + L.out.h + 18} text-anchor="middle">n × {d}</text>
    </svg>
  ))}
  <svg class="fig-narrow fig-bp-640" viewBox="0 0 360 600" role="img" aria-labelledby={`${id}-360-t ${id}-360-d`}>
    <title id={`${id}-360-t`}>{ru ? "Четыре головы внимания работают параллельно, и их выходы конкатенируются" : "Four attention heads run in parallel and are concatenated"}</title>
    <desc id={`${id}-360-d`}>{ru ? "Вход X сверху подаётся в четыре головы, расположенные столбцом. Голова 1 смотрит на предыдущий токен, голова 2 — на следующий токен, голова 3 — на первый токен, голова 4 — на одно значимое слово; каждая показана шаблоном весов шесть на шесть. Их выходы n на 8 ставятся рядом в блок n на 32, который умножается на W_O и даёт выход n на 32 внизу." : "The input X at the top feeds four heads stacked in a column. Head 1 attends to the previous token, head 2 to the next token, head 3 to the first token and head 4 to one content word, each shown as a six-by-six weight pattern. Their n by 8 outputs are placed side by side into an n by 32 block, which is multiplied by W_O to give the n by 32 output at the bottom."}</desc>
    <rect x="110" y="24" width="140" height="36" fill="var(--muted)" fill-opacity="0.15" stroke="var(--muted)" stroke-width="1.3" />
    <text class="f-label" x="100" y="48" text-anchor="end" font-weight="600">X</text>
    <text class="f-small f-t-muted" x="260" y="47">n × {d}</text>
    <path class="f-thin f-muted" d={`M 130 60 V 72 H 80 V ${nhy(3) + 30}`} />
    <path class="f-thin f-muted" d={`M 310 ${nhy(0) + 30} V ${ncat.y + ncat.h / 2} H ${ncat.x + ncat.w + 6}`} marker-end="url(#f-arrow-muted)" />
    {heads.map((hd, k) => {
      const y0 = nhy(k);
      return (
        <g>
          <path class="f-thin f-muted" d={`M 80 ${y0 + 30} H 104`} marker-end="url(#f-arrow-muted)" />
          {hd.A.map((row, i) => row.map((v, j) => (
            <rect x={110 + j * 10} y={y0 + i * 10} width="10" height="10" fill={`var(--fig-${hd.hue})`} fill-opacity={(0.06 + 0.8 * v).toFixed(3)} />
          )))}
          <rect x="110" y={y0} width="60" height="60" fill="none" stroke="var(--muted)" stroke-width="1.2" />
          <text class={`f-label f-t-${hd.hue}`} x="182" y={y0 + 24} font-weight="650">{hd.name}</text>
          <text class="f-small" x="182" y={y0 + 44}>{hd.what}</text>
          <path class={`f-thin f-${hd.hue}`} d={`M 292 ${y0 + 30} H 310`} />
          <rect x={ncat.x + k * (ncat.w / h)} y={ncat.y} width={ncat.w / h} height={ncat.h} fill={`var(--fig-${hd.hue})`} fill-opacity="0.35" />
        </g>
      );
    })}
    <rect x={ncat.x} y={ncat.y} width={ncat.w} height={ncat.h} fill="none" stroke="var(--muted)" stroke-width="1.3" />
    <text class="f-small f-t-muted" x={ncat.x - 10} y={ncat.y + 23} text-anchor="end">{ru ? "конкатенация" : "concat"}</text>
    <path class="f-line" d={`M 180 ${ncat.y + ncat.h + 4} V ${ncat.y + ncat.h + 58}`} marker-end="url(#f-arrow)" />
    <text class="f-label" x="194" y={ncat.y + ncat.h + 36}>× W_O <tspan class="f-t-muted" font-size="12.5">({d} × {d})</tspan></text>
    <rect x="110" y={ncat.y + ncat.h + 66} width="140" height="36" fill="var(--fig-blue)" fill-opacity="0.12" stroke="var(--muted)" stroke-width="1.3" />
    <text class="f-label" x="100" y={ncat.y + ncat.h + 90} text-anchor="end" font-weight="600">{ru ? "выход" : "output"}</text>
    <text class="f-small f-t-muted" x="260" y={ncat.y + ncat.h + 89}>n × {d}</text>
  </svg>
</Figure>
