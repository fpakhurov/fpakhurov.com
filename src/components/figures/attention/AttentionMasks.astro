---
import Figure from '../Figure.astro';
import Heatmap from './Heatmap.astro';
import { attention, X, tokens, f3 } from './toy';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The toy scores with no mask, with the last token treated as padding, and with a causal mask.
const isPad = (_i: number, j: number) => j === 2;
const isFuture = (i: number, j: number) => j > i;
const grid = (fn: (i: number, j: number) => boolean) => tokens.map((_, i) => tokens.map((__, j) => fn(i, j)));
const panels = [
  { title: ru ? 'без маски' : 'no mask', sub: ru ? 'разрешены все ключи' : 'every key allowed', A: attention(X).A, masked: undefined },
  { title: ru ? 'маска паддинга' : 'padding mask', sub: ru ? 'ключ «cats» — паддинг' : 'key “cats” is padding', A: attention(X, { masked: isPad }).A, masked: grid(isPad) },
  { title: ru ? 'каузальная маска' : 'causal mask', sub: ru ? 'нет ключей после запроса' : 'no key after the query', A: attention(X, { masked: isFuture }).A, masked: grid(isFuture) },
];
const layouts = [
  { cls: 'fig-wide fig-bp-640', W: 760, H: 246, cell: 50, pos: [[0, 4], [256, 4], [512, 4]] },
  { cls: 'fig-narrow fig-bp-640', W: 360, H: 710, cell: 50, pos: [[50, 4], [50, 244], [50, 484]] },
];
const id = 'attention-masks';
---

<Figure
  id={id}
  title={ru ? "Маска паддинга и каузальная маска на одних и тех же оценках" : "Padding and causal masks on the same scores"}
  caption={ru ? `Веса внимания игрушечного примера; строки — запросы, столбцы — ключи. Маска присваивает оценке −∞ до softmax (заштрихованные клетки), поэтому её вес в точности равен 0, а остальные веса строки перенормируются так, чтобы их сумма была равна единице. Маска паддинга: ключ «cats» исключён из каждой строки, и первая строка становится ${panels[1].A[0].map(f3).join(', ')}. Каузальная маска: верхний треугольник исключён, поэтому первый токен видит только себя, а последняя строка не меняется.` : `Attention weights of the toy example; rows are queries, columns are keys. A mask sets a score to −∞ before the softmax (hatched cells), so its weight is exactly 0 and the remaining weights of the row are renormalized to sum to one. Padding mask: the key “cats” is excluded from every row, and the first row becomes ${panels[1].A[0].map(f3).join(', ')}. Causal mask: the upper triangle is excluded, so the first token sees only itself and the last row is unchanged.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? "Веса внимания с маской паддинга и с каузальной маской" : "Attention weights under padding and causal masks"}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? "Три матрицы весов три на три для dogs, chase и cats. Без маски все девять весов положительны. С маской паддинга столбец cats заштрихован и помечен минус бесконечностью, и веса каждой строки распределены только между dogs и chase. С каузальной маской заштрихованы три клетки над диагональю; первая строка равна 1, 0, 0, вторая 0.5, 0.5, 0, а третья сохраняет все три веса." : "Three three-by-three weight matrices for dogs, chase and cats. Without a mask all nine weights are positive. With a padding mask the cats column is hatched and marked minus infinity, and each row's weights are spread over dogs and chase only. With a causal mask the three cells above the diagonal are hatched; the first row is 1, 0, 0, the second 0.5, 0.5, 0, and the third row keeps all three weights."}</desc>
      {panels.map((p, k) => (
        <Heatmap x={L.pos[k][0]} y={L.pos[k][1]} values={p.A} rows={tokens} cols={tokens} cell={L.cell} masked={p.masked} title={p.title} sub={p.sub} />
      ))}
    </svg>
  ))}
</Figure>
