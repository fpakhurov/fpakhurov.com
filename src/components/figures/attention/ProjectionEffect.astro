---
import Figure from '../Figure.astro';
import Heatmap from './Heatmap.astro';
import { attention, rawAttention, X, tokens, f3 } from './toy';

// Same three input vectors, scored without projections (x_i · x_j / √4) and with the toy W_Q, W_K.
const raw = rawAttention(X);
const learned = attention(X).A;
const layouts = [
  { cls: 'fig-wide fig-medium', W: 560, H: 250, cell: 50, row: 54, xs: [8, 290] },
  { cls: 'fig-narrow', W: 360, H: 216, cell: 42, row: 46, xs: [0, 182] },
];
const id = 'attention-projection-effect';
---

<Figure
  id={id}
  title="Attention weights with and without learned projections"
  caption={`Rows are queries, columns are keys; each row sums to one and the largest weight of each row is outlined. Left: scores are plain dot products of the input vectors, softmax(XXᵀ/√4). The matrix is symmetric and the diagonal wins every row, because a vector matches itself best when the norms are equal. Right: the same inputs with the toy projections W_Q ≠ W_K, softmax(QKᵀ/√2). The weights are no longer symmetric, “dogs” reads mostly from “chase” (${f3(learned[0][1])}) and keeps only ${f3(learned[0][0])} of itself.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>Raw dot-product attention versus attention with projections</title>
      <desc id={`${id}-${L.W}-d`}>Two three-by-three weight matrices for the tokens dogs, chase and cats. The left one, without projections, is symmetric and its diagonal entries are the largest in every row (0.506, 0.506 and 0.452). The right one, with learned query and key projections, is not symmetric; the largest entries are dogs to chase, chase to cats and cats to chase.</desc>
      <Heatmap x={L.xs[0]} y={4} values={raw} rows={tokens} cols={tokens} cell={L.cell} rowWidth={L.row} title="no projections" sub="queries = keys = x" outlineMax />
      <Heatmap x={L.xs[1]} y={4} values={learned} rows={tokens} cols={tokens} cell={L.cell} rowWidth={L.row} title="learned W_Q, W_K" sub="q = xW_Q, k = xW_K" outlineMax />
    </svg>
  ))}
</Figure>
