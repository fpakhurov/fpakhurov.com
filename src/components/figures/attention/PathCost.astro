---
import Figure from '../Figure.astro';
import { scale } from '../geometry';

// (a), (b): how token 1 reaches token 6 in a recurrent layer and in self-attention.
// (c): multiply-adds per layer, n²d for the attention scores and weighted sum versus nd² for a
// recurrent (or projection) layer, at d = 512 (the base Transformer width). They cross at n = d.
const N = 6;
const d = 512;
const gap = 62;
const r = 14;
const lg = [4, 14]; // log2 n range
const ly = [5, 12]; // log10 operations range
const attn = (n: number) => n * n * d;
const rec = (n: number) => n * d * d;

interface Layout { cls: string; W: number; H: number; a: [number, number]; b: [number, number]; c: [number, number, number, number] }
const layouts: Layout[] = [
  { cls: 'fig-wide fig-bp-640', W: 760, H: 318, a: [22, 8], b: [22, 150], c: [496, 40, 740, 250] },
  { cls: 'fig-narrow fig-bp-640', W: 360, H: 640, a: [12, 8], b: [12, 150], c: [70, 372, 340, 580] },
];
const plots = layouts.map((L) => {
  const [x0, y0, x1, y1] = L.c;
  const sx = scale(lg as [number, number], [x0, x1]);
  const sy = scale(ly as [number, number], [y1, y0]);
  const path = (f: (n: number) => number) =>
    Array.from({ length: 41 }, (_, k) => lg[0] + ((lg[1] - lg[0]) * k) / 40)
      .map((l, k) => `${k ? 'L' : 'M'} ${sx(l).toFixed(1)} ${sy(Math.log10(f(2 ** l))).toFixed(1)}`)
      .join(' ');
  return { L, sx, sy, attnPath: path(attn), recPath: path(rec) };
});
const id = 'attention-path-cost';
const cx = (k: number) => 20 + k * gap;
const arc = (i: number, j: number, y: number) => `M ${cx(i)} ${y - r} Q ${(cx(i) + cx(j)) / 2} ${y - r - 22 * (j - i)} ${cx(j)} ${y - r}`;
const pairs: [number, number][] = [];
for (let i = 0; i < N; i += 1) for (let j = i + 1; j < N; j += 1) pairs.push([i, j]);
const powText = (e: number) => (e < 10 ? `10${'⁰¹²³⁴⁵⁶⁷⁸⁹'[e]}` : `10¹${'⁰¹²'[e - 10]}`);
---

<Figure
  id={id}
  title="Recurrence versus self-attention: path length and cost"
  caption={`(a) In a recurrent layer information from token 1 reaches token 6 through 5 state updates, and the 6 steps must run one after another. (b) In self-attention every token reads every other token directly: all ${pairs.length} pairs are one step apart and all positions are computed at once. (c) The price: per layer, the attention scores and the weighted sum take about n²d multiply-adds, against nd² for a recurrent layer or the projections; at d = ${d} the two terms are equal at n = ${d} up to constant factors, and attention dominates for longer sequences. Both axes are logarithmic.`}
>
  {plots.map(({ L, sx, sy, attnPath, recPath }) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>Path length and cost of recurrence and self-attention</title>
      <desc id={`${id}-${L.W}-d`}>Panel a: six tokens in a row joined by arrows from each to the next; the path from token 1 to token 6 is highlighted and takes five steps. Panel b: the same six tokens with arcs between every pair; the single arc from token 1 to token 6 is highlighted. Panel c: a log-log plot of operations per layer against sequence length for width 512; the attention line n squared d is steeper than the recurrent line n d squared, and they cross at n equal to 512.</desc>

      <g transform={`translate(${L.a[0]} ${L.a[1]})`}>
        <text class="f-title" x="0" y="16">(a) recurrence</text>
        {Array.from({ length: N - 1 }, (_, k) => (
          <path class="f-line f-red" d={`M ${cx(k) + r + 2} 70 H ${cx(k + 1) - r - 3}`} marker-end="url(#f-arrow-red)" />
        ))}
        {Array.from({ length: N }, (_, k) => (
          <g>
            <circle cx={cx(k)} cy="70" r={r} class="f-box" />
            <text class="f-small" x={cx(k)} y="75" text-anchor="middle">{k + 1}</text>
          </g>
        ))}
        <text class="f-note" x="0" y="112">1 → 6: 5 steps; 6 sequential updates</text>
      </g>

      <g transform={`translate(${L.b[0]} ${L.b[1]})`}>
        <text class="f-title" x="0" y="16">(b) self-attention</text>
        {pairs.map(([i, j]) => <path class={`f-thin ${i === 0 && j === N - 1 ? 'f-blue f-bold' : 'f-muted'}`} d={arc(i, j, 112)} opacity={i === 0 && j === N - 1 ? 1 : 0.55} />)}
        {Array.from({ length: N }, (_, k) => (
          <g>
            <circle cx={cx(k)} cy="112" r={r} class="f-box" />
            <text class="f-small" x={cx(k)} y="117" text-anchor="middle">{k + 1}</text>
          </g>
        ))}
        <text class="f-note" x="0" y="152">every pair 1 step; all positions in parallel</text>
      </g>

      <g>
        <text class="f-title" x={L.c[0] - 50} y={L.c[1] - 18}>(c) operations per layer, d = {d}</text>
        <path class="f-axis" d={`M ${L.c[0]} ${L.c[1]} V ${L.c[3]} H ${L.c[2]}`} />
        {[6, 8, 10, 12].map((e) => (
          <g>
            <path class="f-grid" d={`M ${L.c[0]} ${sy(e)} H ${L.c[2]}`} />
            <text class="f-note" x={L.c[0] - 8} y={sy(e) + 5} text-anchor="end">{powText(e)}</text>
          </g>
        ))}
        {[4, 7, 10, 13].map((l) => (
          <g>
            <path class="f-axis" d={`M ${sx(l)} ${L.c[3]} v 5`} />
            <text class="f-note" x={sx(l)} y={L.c[3] + 20} text-anchor="middle">{(2 ** l).toLocaleString('en-US')}</text>
          </g>
        ))}
        <text class="f-note" x={L.c[2]} y={L.c[3] + 38} text-anchor="end">sequence length n</text>
        <path class="f-line f-blue f-bold" d={attnPath} />
        <path class="f-line f-red f-bold" d={recPath} />
        <circle cx={sx(9)} cy={sy(Math.log10(attn(512)))} r="4.5" class="f-solid-muted" />
        <text class="f-small f-halo" x={sx(9) + 8} y={sy(Math.log10(attn(512))) + 20}>n = d = {d}</text>
        <text class="f-small f-t-blue f-halo" x={sx(10.8) - 12} y={sy(Math.log10(attn(2 ** 10.8)))} text-anchor="end">attention n²d</text>
        <text class="f-small f-t-red f-halo" x={sx(13)} y={sy(Math.log10(rec(2 ** 13))) + 30} text-anchor="middle">recurrent nd²</text>
      </g>
    </svg>
  ))}
</Figure>
