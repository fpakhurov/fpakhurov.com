---
/**
 * A small attention-weight matrix for the figures of the self-attention note:
 * rows are queries, columns are keys, the fill opacity is the weight.
 * Masked cells are drawn hatched with "−∞" instead of a number.
 */
import { short } from './toy';

interface Props {
  x: number;
  y: number;
  values: number[][];
  rows: string[];
  cols: string[];
  cell?: number;
  masked?: boolean[][];
  title?: string;
  sub?: string;
  digits?: number;
  hue?: 'blue' | 'red' | 'amber' | 'green';
  colLabels?: boolean;
  rowWidth?: number;
  /** Outline the largest weight of every row. */
  outlineMax?: boolean;
}

const { x, y, values, rows, cols, cell = 50, masked, title, sub, digits = 3, hue = 'blue', colLabels = true, rowWidth = 52, outlineMax = false } = Astro.props;
const gx = x + rowWidth;
const gy = y + (title ? 26 : 0) + (colLabels ? 22 : 0);
const n = values.length;
const m = values[0].length;
---

<g>
  {title && <text class="f-title" x={gx + (m * cell) / 2} y={y + 15} text-anchor="middle">{title}</text>}
  {colLabels && cols.map((c, j) => <text class="f-small f-t-muted" x={gx + j * cell + cell / 2} y={gy - 8} text-anchor="middle">{c}</text>)}
  {rows.map((r, i) => <text class="f-small" x={gx - 8} y={gy + i * cell + cell / 2 + 5} text-anchor="end">{r}</text>)}
  {values.map((row, i) => row.map((v, j) => {
    const off = masked?.[i]?.[j];
    return (
      <g>
        <rect x={gx + j * cell} y={gy + i * cell} width={cell} height={cell} fill="var(--paper)" stroke="var(--line)" stroke-width="1" />
        {off ? (
          <g>
            <path class="f-grid" d={`M ${gx + j * cell} ${gy + i * cell + cell / 2} l ${cell / 2} ${-cell / 2} M ${gx + j * cell} ${gy + (i + 1) * cell} l ${cell} ${-cell} M ${gx + j * cell + cell / 2} ${gy + (i + 1) * cell} l ${cell / 2} ${-cell / 2}`} />
            <text class="f-small f-t-muted f-halo" x={gx + j * cell + cell / 2} y={gy + i * cell + cell / 2 + 5} text-anchor="middle">−∞</text>
          </g>
        ) : (
          <g>
            <rect x={gx + j * cell + 1} y={gy + i * cell + 1} width={cell - 2} height={cell - 2} fill={`var(--fig-${hue})`} fill-opacity={(0.08 + 0.72 * Math.max(0, Math.min(1, v))).toFixed(3)} />
            <text class="f-small f-halo" x={gx + j * cell + cell / 2} y={gy + i * cell + cell / 2 + 5} text-anchor="middle" font-family="var(--mono)">{short(v, digits)}</text>
          </g>
        )}
      </g>
    );
  }))}
  {outlineMax && values.map((row, i) => {
    const j = row.indexOf(Math.max(...row));
    return <rect x={gx + j * cell + 2.5} y={gy + i * cell + 2.5} width={cell - 5} height={cell - 5} fill="none" stroke="var(--ink)" stroke-width="2" />;
  })}
  <rect x={gx} y={gy} width={m * cell} height={n * cell} fill="none" stroke="var(--muted)" stroke-width="1.2" />
  {sub && <text class="f-note" x={gx + (m * cell) / 2} y={gy + n * cell + 20} text-anchor="middle">{sub}</text>}
</g>
