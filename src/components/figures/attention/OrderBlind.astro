---
import Figure from '../Figure.astro';
import Heatmap from './Heatmap.astro';
import { attention, X, tokens, f3 } from './toy';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// "dogs chase cats" and "cats chase dogs": the same three input rows in a different order, no positions added.
const order = [2, 1, 0];
const sentences = [
  { words: tokens, r: attention(X) },
  { words: order.map((k) => tokens[k]), r: attention(order.map((k) => X[k])) },
];
const vec = (v: number[]) => `(${v.map(f3).join(', ')})`;
const dogsOut = sentences.map((s) => s.r.Y[s.words.indexOf('dogs')]);
const layouts = [
  { cls: 'fig-wide fig-bp-640', W: 660, H: 330, cell: 46, pos: [[10, 4], [360, 4]], arrow: [292, 140] },
  { cls: 'fig-narrow fig-bp-640', W: 360, H: 660, cell: 46, pos: [[44, 4], [44, 334]], arrow: null },
];
const id = 'attention-order-blind';
---

<Figure
  id={id}
  title={ru ? "Перестановка двух слов лишь переставляет результат" : "Swapping two words only permutes the result"}
  caption={ru ? `Self-attention без информации о позициях на «dogs chase cats» и на «cats chase dogs». Вторая матрица весов — это первая, у которой строки и столбцы переставлены одинаково, и строки выхода тоже переставлены: вектор, вычисленный для «dogs», равен ${vec(dogsOut[0])} в обоих предложениях. Слой не может определить, кто за кем гонится; порядок нужно передать отдельно.` : `Self-attention without position information on “dogs chase cats” and on “cats chase dogs”. The second weight matrix is the first with rows and columns reordered in the same way, and the output rows are reordered too: the vector computed for “dogs” is ${vec(dogsOut[0])} in both sentences. The layer cannot tell who chases whom; order has to be supplied separately.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? "Self-attention не видит порядка слов" : "Self-attention is blind to word order"}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? "Две матрицы весов, одна для dogs chase cats, другая для cats chase dogs, с одинаковыми элементами на переставленных местах. Под каждой матрицей перечислены три выходных вектора; выход для dogs выделен и равен 0.277, 2.536 в обоих предложениях." : "Two weight matrices, one for dogs chase cats and one for cats chase dogs, with the same entries in permuted positions. Under each matrix the three output vectors are listed; the output for dogs, highlighted, is 0.277, 2.536 in both sentences."}</desc>
      {sentences.map((s, k) => {
        const [x0, y0] = L.pos[k];
        const ty = y0 + 26 + 22 + 3 * L.cell + 36;
        return (
          <g>
            <Heatmap x={x0} y={y0} values={s.r.A} rows={s.words} cols={s.words} cell={L.cell} title={ru ? `«${s.words.join(' ')}»` : `“${s.words.join(' ')}”`} />
            <text class="f-note" x={x0} y={ty}>{ru ? "выходы (без позиций)" : "outputs (no positions)"}</text>
            {s.words.map((w, i) => (
              <g>
                {w === 'dogs' && <rect class="f-fill-blue" x={x0 - 4} y={ty + 8 + i * 24} width="200" height="22" rx="4" />}
                <text class="f-small" x={x0 + 48} y={ty + 24 + i * 24} text-anchor="end">{w}</text>
                <text class={`f-small${w === 'dogs' ? ' f-t-blue' : ''}`} x={x0 + 60} y={ty + 24 + i * 24} font-family="var(--mono)">{vec(s.r.Y[i])}</text>
              </g>
            ))}
          </g>
        );
      })}
      {L.arrow && (
        <g>
          <path class="f-line f-muted" d={`M ${L.arrow[0]} ${L.arrow[1]} h 46`} marker-end="url(#f-arrow-muted)" />
          <text class="f-note" x={L.arrow[0] + 22} y={L.arrow[1] - 12} text-anchor="middle">{ru ? "обмен" : "swap"}</text>
          <text class="f-note" x={L.arrow[0] + 22} y={L.arrow[1] + 24} text-anchor="middle">1 ↔ 3</text>
        </g>
      )}
    </svg>
  ))}
</Figure>
