---
import Figure from '../Figure.astro';
import { attention, X, tokens, f3 } from './toy';

// One query ("dogs") worked through the four steps with the toy matrices of the note.
const r = attention(X);
const i = 0;
const q = r.Q[i];
const scores = r.scaled[i];
const w = r.A[i];
const y = r.Y[i];
const V = r.V;
const K = r.K;
const vec = (v: number[]) => `(${v.map((x) => (Number.isInteger(x) ? String(x) : f3(x))).join(', ')})`;

// Panel C: values and the weighted sum, drawn tip to tail.
const ox = 44;
const oy = 214;
const ux = 70; // px per unit in x
const uy = 50; // px per unit in y
const P = (a: number, b: number): [number, number] => [ox + a * ux, oy - b * uy];
// Axes are drawn slightly off the origin (at x = −0.3, y = −0.3) so that v₂ = (0, 3) does not lie on the y-axis.
const [ax0, ay0] = P(-0.3, -0.3);
const partial: [number, number][] = [[0, 0]];
w.forEach((a, j) => {
  const [px, py] = partial[partial.length - 1];
  partial.push([px + a * V[j][0], py + a * V[j][1]]);
});
const sumPath = partial.map(([a, b], k) => `${k === 0 ? 'M' : 'L'} ${P(a, b)[0].toFixed(1)} ${P(a, b)[1].toFixed(1)}`).join(' ');
const hull = V.map(([a, b], k) => `${k === 0 ? 'M' : 'L'} ${P(a, b)[0]} ${P(a, b)[1]}`).join(' ') + ' Z';
const valueLabelOffset: [number, number][] = [[8, 5], [8, 5], [4, 38]];

const layouts = [
  { cls: 'fig-wide fig-bp-640', W: 760, H: 266, a: [12, 8], b: [246, 8], c: [520, 8] },
  { cls: 'fig-narrow fig-bp-640', W: 360, H: 770, a: [62, 4], b: [52, 254], c: [70, 504] },
];
const id = 'attention-soft-lookup';
const barS = 20; // px per unit of score
const barW = 74; // px for weight 1
---

<Figure
  id={id}
  title="One query from scores to output"
  caption={`Toy example of the note, token “dogs” as the query (d = 4, d_k = d_v = 2). ① Its query q₁ = ${vec(q)} is compared with the keys of all three tokens, itself included. ② The dot products divided by √2 are ${scores.map((s) => s.toFixed(2)).join(', ')}. ③ The softmax turns them into weights ${w.map(f3).join(', ')}, which sum to one. ④ The output y₁ is the weighted sum of the value vectors, drawn tip to tail in blue: ${vec(y)}. Because the weights are positive and sum to one, every output lies inside the triangle spanned by the values (dashed).`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>Self-attention for one query, step by step</title>
      <desc id={`${id}-${L.W}-d`}>Three panels. The first lists the query of dogs and the keys and values of dogs, chase and cats. The second shows horizontal bars for the three scaled scores and, next to them, bars for the softmax weights; chase gets most of the weight, about 0.77. The third is a small plot with the three value vectors as amber arrows from the origin and a blue path that adds the weighted values one after another, ending at the output point near (0.28, 2.54), inside the dashed triangle of the values.</desc>

      <g transform={`translate(${L.a[0]} ${L.a[1]})`}>
        <text class="f-title" x="0" y="16">① project</text>
        <text class="f-label" x="0" y="48">query of <tspan font-weight="650">{tokens[i]}</tspan></text>
        <text class="f-math f-t-blue" x="0" y="74">q<tspan dy="5" font-size="12">1</tspan><tspan dy="-5"> = x</tspan><tspan dy="5" font-size="12">1</tspan><tspan dy="-5">W</tspan><tspan dy="5" font-size="12">Q</tspan><tspan dy="-5" font-style="normal" font-family="var(--mono)" font-size="14"> = {vec(q)}</tspan></text>
        <text class="f-note" x="0" y="112">token</text>
        <text class="f-math f-t-red" x="92" y="112">k<tspan dy="5" font-size="12">j</tspan></text>
        <text class="f-math f-t-amber" x="158" y="112">v<tspan dy="5" font-size="12">j</tspan></text>
        <path class="f-grid" d="M 0 122 H 214" />
        {tokens.map((t, j) => (
          <g font-family="var(--mono)">
            <text class="f-label" x="0" y={146 + j * 28} font-family="var(--sans, inherit)">{t}</text>
            <text class="f-small f-t-red" x="80" y={146 + j * 28}>{vec(K[j])}</text>
            <text class="f-small f-t-amber" x="146" y={146 + j * 28}>{vec(V[j])}</text>
          </g>
        ))}
        <text class="f-note" x="0" y="234">same W_K, W_V for every token</text>
      </g>

      <g transform={`translate(${L.b[0]} ${L.b[1]})`}>
        <text class="f-title" x="0" y="16">② score   ③ normalize</text>
        <text class="f-note" x="58" y="56">q₁·kⱼ / √2</text>
        <text class="f-note" x="168" y="56">weight α₁ⱼ</text>
        {tokens.map((t, j) => {
          const yy = 76 + j * 44;
          return (
            <g>
              <text class="f-label" x="0" y={yy + 15}>{t}</text>
              <rect class="f-fill-red" x="58" y={yy} width={Math.max(1.5, scores[j] * barS)} height="20" />
              <path class="f-thin f-red" d={`M 58 ${yy} V ${yy + 20}`} />
              <text class="f-small" x={58 + scores[j] * barS + 5} y={yy + 15} font-family="var(--mono)">{scores[j].toFixed(2)}</text>
              <rect class="f-solid-blue" x="168" y={yy} width={Math.max(1.5, w[j] * barW)} height="20" opacity="0.75" />
              <text class="f-small" x={168 + w[j] * barW + 5} y={yy + 15} font-family="var(--mono)">{f3(w[j])}</text>
            </g>
          );
        })}
                <text class="f-note" x="0" y="232">softmax: weights are positive, sum to 1</text>
      </g>

      <g transform={`translate(${L.c[0]} ${L.c[1]})`}>
        <text class="f-title" x="0" y="16">④ mix: y₁ = Σ α₁ⱼ vⱼ</text>
        <path class="f-axis" d={`M ${ax0} ${ay0} H ${P(2.45, 0)[0]} M ${ax0} ${ay0} V ${P(0, 3.3)[1]}`} />
        {[1, 2].map((t) => <g><path class="f-axis" d={`M ${P(t, 0)[0]} ${ay0} v 5`} /><text class="f-note" x={P(t, 0)[0]} y={ay0 + 19} text-anchor="middle">{t}</text></g>)}
        {[1, 2, 3].map((t) => <g><path class="f-axis" d={`M ${ax0} ${P(0, t)[1]} h -5`} /><text class="f-note" x={ax0 - 10} y={P(0, t)[1] + 5} text-anchor="end">{t}</text></g>)}
        <circle cx={ox} cy={oy} r="2.5" class="f-solid-muted" />
        <text class="f-note" x={ox - 5} y={oy + 13} text-anchor="end">0</text>
        <path class="f-thin f-muted f-dash" d={hull} />
        {V.map(([a, b], j) => (
          <g>
            <path class="f-thin f-amber" d={`M ${ox} ${oy} L ${P(a, b)[0]} ${P(a, b)[1]}`} marker-end="url(#f-arrow-amber)" />
            <text class="f-small f-t-amber f-halo" x={P(a, b)[0] + valueLabelOffset[j][0]} y={P(a, b)[1] + valueLabelOffset[j][1]}>v{['₁', '₂', '₃'][j]} {tokens[j]}</text>
          </g>
        ))}
        <path class="f-line f-blue f-bold" d={sumPath} />
        <circle cx={P(y[0], y[1])[0]} cy={P(y[0], y[1])[1]} r="5" class="f-solid-blue" />
        <path class="f-thin f-blue" d={`M ${P(y[0], y[1])[0] + 6} ${P(y[0], y[1])[1] + 2} L 94 ${P(y[0], y[1])[1] + 6}`} />
        <text class="f-small f-t-blue f-halo" x="97" y={P(y[0], y[1])[1] + 10}>y₁ {vec(y)}</text>
      </g>
    </svg>
  ))}
</Figure>
