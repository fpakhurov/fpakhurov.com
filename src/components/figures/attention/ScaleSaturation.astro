---
import Figure from '../Figure.astro';
import { plot, scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Left: exact density of the score q·k for q, k ~ N(0, I_{d_k}) (a variance-gamma distribution, variance d_k),
// and of q·k/√d_k (variance 1). For even d_k = 2(m + 1) the Bessel function K_{m+1/2} has a closed form and
// f(x) = e^{−|x|} Σ_{j=0}^{m} c_j |x|^{m−j} / (2^{m+1} m!), with c_j = (m + j)! / (j! (m − j)! 2^j).
const scoreDensity = (dk: number) => {
  const m = dk / 2 - 1;
  const c: number[] = [];
  for (let j = 0; j <= m; j++) {
    let v = 1; // (m + j)! / (m − j)! / j! / 2^j, built as a running product
    for (let t = m - j + 1; t <= m + j; t++) v *= t;
    for (let t = 1; t <= j; t++) v /= 2 * t;
    c.push(v);
  }
  let norm = 2 ** (m + 1);
  for (let t = 2; t <= m; t++) norm *= t;
  return (x: number) => {
    const a = Math.abs(x);
    let sum = 0;
    for (let j = 0; j <= m; j++) sum += c[j] * a ** (m - j);
    return (Math.exp(-a) * sum) / norm;
  };
};
const scaledDensity = (dk: number) => {
  const f = scoreDensity(dk);
  return (x: number) => Math.sqrt(dk) * f(Math.sqrt(dk) * x);
};
// Right: simulation with n = 16 keys, q and k ~ N(0, I_{d_k}), 2000 draws per d_k, seed 0
// (pure Python, random.gauss). Columns: d_k, mean largest weight unscaled / scaled,
// mean of 1 − Σ α_j² unscaled / scaled.
const sim: [number, number, number, number, number][] = [
  [1, 0.2052, 0.2052, 0.8742, 0.8742],
  [2, 0.2981, 0.2222, 0.8143, 0.8708],
  [4, 0.4263, 0.2348, 0.7098, 0.8684],
  [8, 0.5587, 0.2403, 0.5758, 0.8669],
  [16, 0.6855, 0.2463, 0.4256, 0.8658],
  [32, 0.7776, 0.2442, 0.3105, 0.8677],
  [64, 0.8441, 0.247, 0.2197, 0.8668],
  [128, 0.8919, 0.2475, 0.1543, 0.8671],
  [256, 0.9268, 0.2461, 0.1046, 0.8681],
  [512, 0.9421, 0.2459, 0.0824, 0.8677],
];
const at64 = sim.find((r) => r[0] === 64)!;
const dens = [
  { dk: 4, cls: 'f-muted', t: 'f-t-muted' },
  { dk: 16, cls: 'f-amber', t: 'f-t-amber' },
  { dk: 64, cls: 'f-red', t: 'f-t-red' },
];

const build = (W: number, left: [number, number, number, number], right: [number, number, number, number]) => {
  const [lx0, ly0, lx1, ly1] = left; // x0, top, x1, bottom
  const sx = scale([-26, 26], [lx0, lx1]);
  const sy = scale([0, 0.52], [ly1, ly0]);
  const [rx0, ry0, rx1, ry1] = right;
  const tx = scale([0, 9], [rx0, rx1]);
  const ty = scale([0, 1], [ry1, ry0]);
  const series = (col: number) => polyline(sim.map((r) => [tx(Math.log2(r[0])), ty(r[col])] as [number, number]));
  return {
    W, left, right, sx, sy, tx, ty,
    curves: dens.map((d) => ({ ...d, path: plot(scoreDensity(d.dk), -26, 26, sx, sy, 400), peak: scoreDensity(d.dk)(0) })),
    unit: dens.map((d) => ({ dk: d.dk, path: plot(scaledDensity(d.dk), -26, 26, sx, sy, 800) })),
    s: [1, 2, 3, 4].map(series),
  };
};
const variants = [
  { cls: 'fig-wide fig-bp-640', H: 356, v: build(760, [40, 40, 340, 236], [440, 40, 740, 236]), legendY: 298, rightTitleX: 440, leftTitleX: 40, offY: 0 },
  { cls: 'fig-narrow fig-bp-640', H: 676, v: build(360, [30, 40, 340, 236], [50, 352, 340, 548]), legendY: 614, rightTitleX: 30, leftTitleX: 30, offY: 312 },
];
const id = 'attention-scale-saturation';
const xticks = [-24, -16, -8, 0, 8, 16, 24];
const dkTicks = [1, 4, 16, 64, 256];
const minus = (t: number) => (t < 0 ? `−${-t}` : `${t}`);
---

<Figure
  id={id}
  title={ru ? "Зачем оценки делят на √d_k" : "Why the scores are divided by √d_k"}
  caption={ru ? `Слева: если компоненты q и k независимы, имеют среднее 0 и дисперсию 1, то оценка q·k имеет дисперсию d_k; кривые — её точные плотности при d_k = 4, 16, 64, которые с ростом d_k приближаются к нормальным. Деление на √d_k возвращает каждый случай к дисперсии 1 (синие кривые; пунктирная, d_k = 4, самая острая, две другие почти совпадают). Справа: симуляция с 16 ключами, 2000 случайных испытаний на каждое значение d_k (игрушечная, seed 0). Без масштабирования (красные линии) наибольший вес softmax растёт от ${sim[0][1].toFixed(2)} до ${sim[9][1].toFixed(2)}, а мера градиента 1 − Σ αⱼ² падает от ${sim[0][3].toFixed(2)} до ${sim[9][3].toFixed(2)}; при d_k = 64 они равны ${at64[1].toFixed(2)} и ${at64[3].toFixed(2)}. С масштабированием (синие линии) обе величины остаются около ${at64[2].toFixed(2)} и ${at64[4].toFixed(2)} при любом d_k.` : `Left: if the components of q and k are independent with mean 0 and variance 1, the score q·k has variance d_k; the curves are its exact densities for d_k = 4, 16, 64, which approach normal curves as d_k grows. Dividing by √d_k returns every case to variance 1 (blue; the dashed one, d_k = 4, is the most peaked, the other two nearly coincide). Right: a simulation with 16 keys, 2000 random draws per d_k (toy, seed 0). Without scaling (red) the largest softmax weight grows from ${sim[0][1].toFixed(2)} to ${sim[9][1].toFixed(2)} and the gradient measure 1 − Σ αⱼ² falls from ${sim[0][3].toFixed(2)} to ${sim[9][3].toFixed(2)}; at d_k = 64 they are ${at64[1].toFixed(2)} and ${at64[3].toFixed(2)}. With scaling (blue) both stay near ${at64[2].toFixed(2)} and ${at64[4].toFixed(2)} for every d_k.`}
>
  {variants.map(({ cls, H, v, legendY, rightTitleX, leftTitleX }) => (
    <svg class={cls} viewBox={`0 0 ${v.W} ${H}`} role="img" aria-labelledby={`${id}-${v.W}-t ${id}-${v.W}-d`}>
      <title id={`${id}-${v.W}-t`}>{ru ? "Дисперсия оценок и насыщение softmax с ростом размера ключа" : "Score variance and softmax saturation as the key size grows"}</title>
      <desc id={`${id}-${v.W}-d`}>{ru ? "Левый график: три колоколообразные кривые с центром в нуле для немасштабированной оценки при d_k, равном 4, 16 и 64, каждая шире и ниже предыдущей, и три высокие узкие синие кривые для масштабированной оценки, из которых кривая для d_k, равного 4, немного острее. Правый график, по оси абсцисс d_k в логарифмической шкале от 1 до 512: без масштабирования наибольший вес растёт примерно от 0.2 до 0.94, а мера градиента падает от 0.87 до 0.08; с масштабированием обе линии остаются горизонтальными, около 0.25 и 0.87." : "Left plot: three zero-centred bell curves for the unscaled score with d_k equal to 4, 16 and 64, each wider and flatter than the last, and three tall narrow blue curves for the scaled score, of which the one for d_k equal to 4 is slightly more peaked. Right plot, against d_k on a logarithmic axis from 1 to 512: without scaling the largest weight rises from about 0.2 to 0.94 and the gradient measure falls from 0.87 to 0.08; with scaling both lines stay flat, near 0.25 and 0.87."}</desc>

      <text class="f-title" x={leftTitleX} y="20">{ru ? "распределение оценки" : "score distribution"}</text>
      <path class="f-axis" d={`M ${v.left[0]} ${v.left[3]} H ${v.left[2]}`} />
      {xticks.map((t) => <g><path class="f-axis" d={`M ${v.sx(t)} ${v.left[3]} v 5`} /><text class="f-note" x={v.sx(t)} y={v.left[3] + 20} text-anchor="middle">{minus(t)}</text></g>)}
      {v.curves.map((c) => <path class={`f-line ${c.cls}`} d={c.path} />)}
      {v.unit.map((u) => <path class={`f-line f-blue ${u.dk === 4 ? 'f-dash' : 'f-bold'}`} d={u.path} />)}
      <text class="f-small f-t-blue f-halo" x={v.sx(1.8)} y={v.sy(0.44)}>{ru ? "q·k/√d_k: дисперсия 1" : "q·k/√d_k: variance 1"}</text>
      {v.curves.map((c, k) => <text class={`f-small ${c.t} f-halo`} x={v.sx([3.2, 6.5, 13][k])} y={v.sy(c.peak) - [6, 4, 10][k]}>d_k = {c.dk}</text>)}

      <g>
        <text class="f-title" x={rightTitleX} y={20 + (v.right[1] - 40)}>{ru ? "softmax по 16 ключам" : "softmax over 16 keys"}</text>
        <path class="f-axis" d={`M ${v.right[0]} ${v.right[1]} V ${v.right[3]} H ${v.right[2]}`} />
        {[0, 0.5, 1].map((t) => <g><path class="f-grid" d={`M ${v.right[0]} ${v.ty(t)} H ${v.right[2]}`} /><text class="f-note" x={v.right[0] - 8} y={v.ty(t) + 5} text-anchor="end">{t}</text></g>)}
        {dkTicks.map((t) => <g><path class="f-axis" d={`M ${v.tx(Math.log2(t))} ${v.right[3]} v 5`} /><text class="f-note" x={v.tx(Math.log2(t))} y={v.right[3] + 20} text-anchor="middle">{t}</text></g>)}
        <text class="f-note" x={v.right[2]} y={v.right[3] + 38} text-anchor="end">{ru ? "размер ключа d_k (лог. шкала)" : "key size d_k (log scale)"}</text>
        <path class="f-line f-red f-bold" d={v.s[0]} />
        <path class="f-line f-blue f-bold" d={v.s[1]} />
        <path class="f-line f-red f-dash" d={v.s[2]} />
        <path class="f-line f-blue f-dash" d={v.s[3]} />
        {sim.map((r) => (
          <g>
            <circle cx={v.tx(Math.log2(r[0]))} cy={v.ty(r[1])} r="3" class="f-solid-red" />
            <circle cx={v.tx(Math.log2(r[0]))} cy={v.ty(r[2])} r="3" class="f-solid-blue" />
          </g>
        ))}
      </g>

      <g>
        <path class="f-line f-red f-bold" d={`M ${rightTitleX} ${legendY} h 26`} />
        <text class="f-small" x={rightTitleX + 32} y={legendY + 5}>{ru ? "без масштаба q·k" : "unscaled q·k"}</text>
        <path class="f-line f-blue f-bold" d={`M ${rightTitleX + (ru ? 156 : 140)} ${legendY} h 26`} />
        <text class="f-small" x={rightTitleX + (ru ? 188 : 172)} y={legendY + 5}>{ru ? "с масштабом q·k/√d_k" : "scaled q·k/√d_k"}</text>
        <text class="f-small f-t-muted" x={rightTitleX} y={legendY + 26}>{ru ? "сплошные: наибольший вес, max αⱼ" : "solid: largest weight, max αⱼ"}</text>
        <text class="f-small f-t-muted" x={rightTitleX} y={legendY + 46}>{ru ? "пунктир: мера градиента, 1 − Σ αⱼ²" : "dashed: gradient measure, 1 − Σ αⱼ²"}</text>
      </g>
    </svg>
  ))}
</Figure>
