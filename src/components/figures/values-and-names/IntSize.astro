---
import Figure from '../Figure.astro';
import { scale, polyline, type Point } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// sys.getsizeof(2**k) on CPython 3.14.7, 64-bit macOS (arm64), measured once and embedded here.
// An int is a 24-byte header plus one 4-byte digit per 30 bits of magnitude (sys.int_info: bits_per_digit=30, sizeof_digit=4).
const measured: [number, number][] = [[0, 28], [29, 28], [30, 32], [59, 32], [60, 36], [89, 36], [90, 40], [149, 44], [150, 48], [239, 56], [240, 60], [299, 64]];
const size = (bits: number) => 24 + 4 * Math.max(1, Math.ceil(bits / 30));
for (const [k, b] of measured) if (size(k + 1) !== b) throw new Error(`2**${k}: formula ${size(k + 1)}, measured ${b}`);

const maxBits = 300;
const t = ru
  ? { x: 'число битов', y: 'байты', note1: 'заголовок 24 байта + цифры по 4 байта', note2: '+4 байта на каждые 30 бит' }
  : { x: 'bits in the number', y: 'bytes', note1: 'a 24-byte header + 4-byte digits', note2: '+4 bytes for every 30 bits' };

interface Layout { cls: string; W: number; H: number; x0: number; x1: number; y0: number; y1: number; sans: number; xticks: number[] }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 300, x0: 70, x1: 730, y0: 250, y1: 30, sans: 6.5, xticks: [0, 60, 120, 180, 240, 300] },
  { cls: 'fig-narrow', W: 360, H: 290, x0: 50, x1: 344, y0: 238, y1: 30, sans: 6.5, xticks: [0, 100, 200, 300] },
];
const yticks = [28, 40, 52, 64];
const id = 'int-size';
const plots = layouts.map((L) => {
  const sx = scale([0, maxBits], [L.x0, L.x1]);
  const sy = scale([20, 68], [L.y0, L.y1]);
  // The staircase: constant on each block of 30 bits, a jump of 4 bytes at 31, 61, ...
  const pts: Point[] = [];
  for (let d = 1; d * 30 - 29 <= maxBits; d += 1) {
    const a = d === 1 ? 1 : d * 30 - 29, b = Math.min(d * 30, maxBits);
    pts.push([sx(a), sy(size(a))], [sx(b), sy(size(a))]);
  }
  if (L.x1 + 0 > L.W - 10) throw new Error('plot runs off the right edge');
  for (const s of [t.note1, t.note2]) if (L.x0 + 14 + s.length * L.sans > L.x1) throw new Error(`"${s}" overflows at ${L.W}`);
  return { sx, sy, path: polyline(pts) };
});
---

<Figure
  id={id}
  title={ru ? 'Размер целого числа растёт с числом битов' : 'The size of an int grows with its number of bits'}
  caption={ru
    ? 'sys.getsizeof(2**k) в CPython 3.14.7 на 64-битной macOS (arm64), по горизонтали — число битов в 2**k, то есть k + 1. Целое число Python — это 24-байтовый заголовок и массив 30-битных «цифр», каждая в 4 байтах, поэтому размер растёт на 4 байта каждые 30 битов. Ограничения сверху нет: число растёт, пока хватает памяти. Точки — измеренные значения, линия — формула 24 + 4·⌈биты/30⌉.'
    : 'sys.getsizeof(2**k) on CPython 3.14.7, 64-bit macOS (arm64), against the number of bits in 2**k, which is k + 1. A Python int is a 24-byte header and an array of 30-bit "digits" stored in 4 bytes each, so the size grows by 4 bytes every 30 bits. There is no upper limit: a number grows as long as memory lasts. The dots are measured values, the line is the formula 24 + 4·⌈bits/30⌉.'}
>
  {layouts.map((L, li) => {
    const { sx, sy, path } = plots[li];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Размер int в байтах в зависимости от числа битов' : 'Size of an int in bytes against its number of bits'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Ступенчатый график: 28 байт до 30 бит, затем 32, 36 и так далее до 64 байт при 300 битах. Измеренные точки лежат на ступеньках.'
          : 'A staircase: 28 bytes up to 30 bits, then 32, 36 and so on up to 64 bytes at 300 bits. The measured points lie on the steps.'}</desc>
        {yticks.map((v) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} />
            <text class="f-small f-t-muted" x={L.x0 - 8} y={sy(v) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        {L.xticks.map((v) => (
          <text class="f-small f-t-muted" x={sx(v)} y={L.y0 + 18} text-anchor="middle">{v}</text>
        ))}
        <path class="f-axis" d={`M ${L.x0} ${L.y1 - 6} V ${L.y0} H ${L.x1 + 6}`} />
        <path class="f-line f-blue" d={path} />
        {measured.map(([k, b]) => <circle cx={sx(k + 1)} cy={sy(b)} r="3.6" class="f-solid-red" />)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.H - 6} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.x0 - 8} y={L.y1 - 12} text-anchor="end">{t.y}</text>
        <text class="f-small" x={L.x0 + 14} y={L.y1 + 8}>{t.note1}</text>
        <text class="f-small f-t-blue" x={L.x0 + 14} y={L.y1 + 28}>{t.note2}</text>
      </svg>
    );
  })}
</Figure>
