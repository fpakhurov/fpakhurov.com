---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Five statements and the names and objects they leave behind (the REPL session of the note, CPython 3.14.7).
// Replay the statements to check the drawing: which list each name ends on, and what each list holds.
const code = ['a = [1, 2]', 'b = a', 'b.append(3)', 'c = [1, 2, 3]', 'b = b + [4]'];
{
  const l1: number[] = [1, 2];
  let b = l1;
  b.push(3);
  const l2 = [1, 2, 3];
  const before = b;
  b = [...b, 4];
  if (l1.join() !== '1,2,3' || l2.join() !== '1,2,3' || b.join() !== '1,2,3,4') throw new Error('replay');
  if (before !== l1 || b === l1) throw new Error('b rebinds');
}
// The objects: cells, the step at which each cell appears, the row they sit on, and their tag.
const lists = [
  { cells: ['1', '2', '3'], cellStep: [1, 1, 3], row: 0, tag: '#1' },
  { cells: ['1', '2', '3', '4'], cellStep: [5, 5, 5, 5], row: 1, tag: '#3' },
  { cells: ['1', '2', '3'], cellStep: [4, 4, 4], row: 2, tag: '#2' },
];
const names = [{ n: 'a', row: 0, step: 1 }, { n: 'b', row: 1, step: 2 }, { n: 'c', row: 2, step: 4 }];
const t = ru
  ? { code: 'код', names: 'имена', objects: 'объекты', tag: 'список ',
      notes: [['a видит изменение: a is b → True', 3], ['a == c → True, но a is c → False', 4], ['a is b → False; a по-прежнему [1, 2, 3]', 5]] as [string, number][],
      steps: ['a = [1, 2] создаёт список и связывает с ним имя a', 'b = a связывает b с тем же списком; ничего не копируется', 'b.append(3) меняет список, и a тоже это видит', 'c = [1, 2, 3] создаёт второй список, равный, но не тот же', 'b = b + [4] строит новый список и перепривязывает b; a не тронут'] }
  : { code: 'code', names: 'names', objects: 'objects', tag: 'list ',
      notes: [['a sees the change: a is b → True', 3], ['a == c → True, but a is c → False', 4], ['a is b → False; a is still [1, 2, 3]', 5]] as [string, number][],
      steps: ['a = [1, 2] creates a list and binds the name a to it', 'b = a binds b to the same list; nothing is copied', 'b.append(3) changes the list, and a sees it too', 'c = [1, 2, 3] creates a second list, equal but not the same', 'b = b + [4] builds a new list and rebinds b; a is untouched'] };

interface Layout { cls: string; W: number; H: number; codeX: number; codeY: (k: number) => number; nameX: number; listX: number; cw: number; ch: number; rowY: (r: number) => number; tagX: number; noteX: number; noteY: (i: number) => number; headY: number; heads: [number, number, number] | null; mono: number; sans: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 346, codeX: 44, codeY: (k) => 64 + k * 40, nameX: 250, listX: 380, cw: 46, ch: 30, rowY: (r) => 50 + r * 84, tagX: 576, noteX: 250, noteY: (i) => 290 + i * 20, headY: 24, heads: [20, 250, 380], mono: 7.5, sans: 6.5 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 470, codeX: 34, codeY: (k) => 40 + k * 28, nameX: 16, listX: 110, cw: 40, ch: 30, rowY: (r) => 200 + r * 72, tagX: 278, noteX: 16, noteY: (i) => 412 + i * 22, headY: 176, heads: null, mono: 8.4, sans: 7.3 },
];
for (const L of layouts) {
  for (const s of code) if (L.codeX + s.length * L.mono > (L.heads ? L.nameX - 12 : L.W - 4)) throw new Error(`code "${s}" overflows at ${L.W}`);
  for (const [s] of t.notes) if (L.noteX + s.length * L.mono > L.W - 4) throw new Error(`note "${s}" overflows at ${L.W}`);
  if (L.listX + 4 * L.cw > L.tagX - 6) throw new Error('lists run into tags');
  if (L.tagX + (t.tag.length + 2) * L.sans > L.W - 2) throw new Error('tag overflows');
  if (L.noteY(0) < L.rowY(2) + L.ch + 16 || L.noteY(2) > L.H - 6) throw new Error(`notes do not fit at ${L.W}`);
}
const nameW = 36;
const id = 'names-objects';
---

<Figure
  id={id}
  title={ru ? 'Имена ссылаются на объекты' : 'Names refer to objects'}
  caption={ru
    ? 'Пять инструкций по шагам. Имя — это ссылка на объект; присваивание связывает имя с объектом и ничего не копирует. После шага 2 имена a и b ссылаются на один список #1, поэтому изменение через b (3) видно через a. Шаг 4 создаёт отдельный список #2 с равным значением: == сравнивает значения, is — идентичность. Шаг 5 строит новый список #3 и перепривязывает b (крестик отмечает старую ссылку), а a по-прежнему ссылается на #1. Ячейки списка тоже хранят ссылки; их рисует заметка о списках.'
    : 'Five statements, step by step. A name is a reference to an object; assignment binds a name to an object and copies nothing. After step 2, a and b refer to the same list #1, so a change made through b (3) is seen through a. Step 4 creates a separate list #2 with an equal value: == compares values, is compares identity. Step 5 builds a new list #3 and rebinds b (the cross marks the old reference), while a still refers to #1. The cells of a list hold references too; the lists note draws them.'}
>
  {layouts.map((L) => {
    const nameMid = (r: number) => L.rowY(r) + L.ch / 2;
    const bOld = { x1: L.nameX + nameW + 2, y1: nameMid(1), x2: L.listX - 4, y2: nameMid(0) + 10 };
    const mx = (bOld.x1 + bOld.x2) / 2, my = (bOld.y1 + bOld.y2) / 2;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Имена a, b, c и три списка' : 'The names a, b, c and three lists'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Слева пять строк кода с номерами шагов. Справа имена a, b и c и стрелки к объектам-спискам. a и b сначала указывают на один список [1, 2, 3]; c указывает на другой список [1, 2, 3]; в конце b указывает на новый список [1, 2, 3, 4], а старая стрелка от b перечёркнута.'
          : 'On the left, five lines of code with step numbers. On the right, the names a, b and c with arrows to list objects. a and b first point to one list [1, 2, 3]; c points to a different list [1, 2, 3]; at the end b points to a new list [1, 2, 3, 4], and the old arrow from b is crossed out.'}</desc>
        {L.heads && [t.code, t.names, t.objects].map((h, i) => (
          <text class="f-small f-t-muted" x={L.heads![i]} y={L.headY} style="font-weight: 650">{h}</text>
        ))}
        {!L.heads && <text class="f-small f-t-muted" x={L.nameX} y={L.headY} style="font-weight: 650">{`${t.names} → ${t.objects}`}</text>}
        {code.map((s, k) => (
          <g data-s={String(k + 1)}>
            <Badge x={L.codeX - 18} y={L.codeY(k) - 5} n={k + 1} />
            <text class="f-small" x={L.codeX} y={L.codeY(k)} style="font-family: var(--mono)">{s}</text>
          </g>
        ))}
        {names.map((nm) => (
          <g data-s={String(nm.step)}>
            <rect x={L.nameX} y={L.rowY(nm.row)} width={nameW} height={L.ch} rx="5" style={`fill: ${toneVar.x}; fill-opacity: 0.14; stroke: ${toneVar.x}; stroke-width: 1.3`} />
            <text class="f-label" x={L.nameX + nameW / 2} y={nameMid(nm.row) + 5} text-anchor="middle" style="font-family: var(--mono)">{nm.n}</text>
          </g>
        ))}
        {lists.map((l) => (
          <g>
            {l.cells.map((v, i) => (
              <g data-s={String(l.cellStep[i])}>
                <rect x={L.listX + i * L.cw} y={L.rowY(l.row)} width={L.cw} height={L.ch} style={`fill: ${toneVar.h}; fill-opacity: 0.14; stroke: ${toneVar.h}; stroke-width: 1.2`} />
                <text class="f-small" x={L.listX + i * L.cw + L.cw / 2} y={nameMid(l.row) + 4.5} text-anchor="middle">{v}</text>
              </g>
            ))}
            <text class="f-small f-t-muted" x={L.tagX} y={nameMid(l.row) + 4.5} data-s={String(l.cellStep[0])}>{t.tag + l.tag}</text>
          </g>
        ))}
        <path data-s="1" class="f-line f-green" d={`M ${L.nameX + nameW + 2} ${nameMid(0)} H ${L.listX - 4}`} marker-end="url(#f-arrow-green)" />
        <path data-s="2" class="f-line f-green" d={`M ${bOld.x1} ${bOld.y1} L ${bOld.x2} ${bOld.y2}`} marker-end="url(#f-arrow-green)" />
        <path data-s="4" class="f-line f-green" d={`M ${L.nameX + nameW + 2} ${nameMid(2)} H ${L.listX - 4}`} marker-end="url(#f-arrow-green)" />
        <path data-s="5" class="f-line f-green" d={`M ${L.nameX + nameW + 2} ${nameMid(1)} H ${L.listX - 4}`} marker-end="url(#f-arrow-green)" />
        <g data-s="5">
          <path class="f-line f-red f-bold" d={`M ${mx - 7} ${my - 7} L ${mx + 7} ${my + 7} M ${mx + 7} ${my - 7} L ${mx - 7} ${my + 7}`} />
        </g>
        {t.notes.map(([s, step], i) => (
          <text class="f-small f-t-muted" x={L.noteX} y={L.noteY(i)} data-s={String(step)} style="font-family: var(--mono)">{s}</text>
        ))}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
