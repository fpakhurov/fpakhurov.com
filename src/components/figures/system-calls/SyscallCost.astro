---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One run of the cost program in the Code section of the note (Apple M1, macOS 26.5, clang -O2): pwrite rewrites
// the same 1 MiB of a file (in the page cache) in chunks of B bytes; median of 9 repetitions.
const B = [1, 4, 16, 64, 256, 1024, 4096, 16384, 65536];
const perCall = [736, 736, 745, 745, 747, 757, 824, 1078, 2437];       // ns per pwrite call
const perByte = [735.963, 184.042, 46.54, 11.648, 2.916, 0.739, 0.201, 0.066, 0.037];
B.forEach((b, i) => { if (Math.abs(perCall[i] / b - perByte[i]) / perByte[i] > 0.01) throw new Error(`row ${b}`); });
// Model: a fixed cost c per call plus a copy cost d per byte, fitted to the two ends of the range.
const c = perCall[0], d = (perCall[8] - perCall[0]) / (B[8] - B[0]);
const model = (b: number) => c / b + d;
if (d.toFixed(3) !== '0.026' || Math.round(perByte[0] / perByte[6]) !== 3662) throw new Error(`model ${d} ${perByte[0] / perByte[6]}`);
const gbps = 1 / d; // bytes per ns = GB/s
if (Math.round(gbps) !== 39) throw new Error(`copy rate ${gbps}`);

const t = ru
  ? { x: 'размер буфера B, байт', y: 'нс на байт', meas: 'измерено (один запуск)', mod: `модель ${c}/B + ${d.toFixed(3)}`, floor: 'только копирование', a1: `B = 1: ${perByte[0].toFixed(0)} нс на байт`, a2: `B = 4096: ${perByte[6].toFixed(2)} нс на байт` }
  : { x: 'buffer size B, bytes', y: 'ns per byte', meas: 'measured (one run)', mod: `model ${c}/B + ${d.toFixed(3)}`, floor: 'copying alone', a1: `B = 1: ${perByte[0].toFixed(0)} ns per byte`, a2: `B = 4096: ${perByte[6].toFixed(2)} ns per byte` };

interface Layout { cls: string; W: number; H: number; x0: number; x1: number; y0: number; y1: number; legend: [number, number]; lstep: [number, number]; a1: [number, number]; a2: [number, number] }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 300, x0: 78, x1: 520, y0: 30, y1: 250, legend: [548, 60], lstep: [0, 24], a1: [104, 38], a2: [400, 214] },
  { cls: 'fig-narrow', W: 360, H: 372, x0: 52, x1: 344, y0: 30, y1: 236, legend: [56, 300], lstep: [0, 22], a1: [74, 38], a2: [280, 200] },
];
const lx = (L: Layout, b: number) => L.x0 + (Math.log2(b) / 16) * (L.x1 - L.x0);
const ly = (L: Layout, v: number) => L.y1 - ((Math.log10(v) + 2) / 5) * (L.y1 - L.y0);
const xticks: [number, string][] = [[1, '1'], [16, '16'], [256, '256'], [4096, '4 Ki'], [65536, '64 Ki']];
const yticks: [number, string][] = [[0.01, '0.01'], [0.1, '0.1'], [1, '1'], [10, '10'], [100, '100'], [1000, '1000']];
const curve = (L: Layout) => Array.from({ length: 65 }, (_, i) => 2 ** (i / 4)).map((b, i) => `${i ? 'L' : 'M'} ${lx(L, b).toFixed(1)} ${ly(L, model(b)).toFixed(1)}`).join(' ');
const id = 'syscall-cost';
---

<Figure
  id={id}
  title={ru ? 'Цена байта при записи блоками разного размера' : 'The cost per byte of writing in blocks of different sizes'}
  caption={ru
    ? `Время на байт при перезаписи 1 МиБ файла вызовами pwrite по B байт, обе оси логарифмические. Точки — один запуск программы из раздела «Код» (Apple M1, macOS 26.5, clang -O2, файл в страничном кэше, медиана 9 повторов); между запусками числа меняются на десятки процентов. Линия — модель: постоянная цена вызова c = ${c} нс плюс копирование d = ${d.toFixed(3)} нс на байт (около ${gbps.toFixed(0)} ГБ/с). Пока B мал, почти всё время уходит на вход в ядро и выход из него, и цена байта падает как c/B; около B = 16 КиБ она приближается к цене копирования.`
    : `Time per byte when rewriting 1 MiB of a file with pwrite calls of B bytes, both axes logarithmic. The dots are one run of the program in the Code section (Apple M1, macOS 26.5, clang -O2, file in the page cache, median of 9 repetitions); the numbers change by tens of percent between runs. The line is a model: a fixed cost per call c = ${c} ns plus copying at d = ${d.toFixed(3)} ns per byte (about ${gbps.toFixed(0)} GB/s). While B is small, almost all the time goes into entering and leaving the kernel, and the cost per byte falls as c/B; around B = 16 KiB it approaches the cost of the copy.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Наносекунды на байт в зависимости от размера буфера' : 'Nanoseconds per byte against buffer size'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? `График в логарифмическом масштабе по обеим осям. При B = 1 запись стоит ${perByte[0].toFixed(0)} нс на байт, при 4096 — ${perByte[6].toFixed(2)}, при 65536 — ${perByte[8].toFixed(3)}. Точки лежат на прямой с наклоном −1 до нескольких килобайт, затем выходят на горизонтальную линию цены копирования.`
        : `A log-log plot. At B = 1 a write costs ${perByte[0].toFixed(0)} ns per byte, at 4096 it costs ${perByte[6].toFixed(2)}, at 65536 ${perByte[8].toFixed(3)}. The dots lie on a line of slope −1 up to a few kilobytes and then level off towards the horizontal line of the copy cost.`}</desc>
      {yticks.map(([v, s]) => (
        <g>
          <path class="f-grid" d={`M ${L.x0} ${ly(L, v)} H ${L.x1}`} />
          <text class="f-small f-t-muted" x={L.x0 - 6} y={ly(L, v) + 4} text-anchor="end">{s}</text>
        </g>
      ))}
      {xticks.map(([b, s]) => (
        <g>
          <path class="f-grid" d={`M ${lx(L, b)} ${L.y0} V ${L.y1}`} />
          <text class="f-small f-t-muted" x={lx(L, b)} y={L.y1 + 16} text-anchor="middle">{s}</text>
        </g>
      ))}
      <path class="f-axis" d={`M ${L.x0} ${L.y0} V ${L.y1} H ${L.x1}`} />
      <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 34} text-anchor="middle">{t.x}</text>
      <text class="f-small f-t-muted" x={L.x0} y={L.y0 - 12}>{t.y}</text>
      <path class="f-thin f-muted f-dot" d={`M ${L.x0} ${ly(L, d)} H ${L.x1}`} />
      <path class="f-line f-blue" d={curve(L)} />
      {B.map((b, i) => <circle cx={lx(L, b)} cy={ly(L, perByte[i])} r="4" style="fill: var(--fig-amber); stroke: var(--paper); stroke-width: 1.2" />)}
      <text class="f-small f-halo" x={L.a1[0]} y={L.a1[1]}>{t.a1}</text>
      <text class="f-small f-halo" x={L.a2[0]} y={L.a2[1]} text-anchor="end">{t.a2}</text>
      <g>
        <circle cx={L.legend[0] + 8} cy={L.legend[1] - 4} r="4" style="fill: var(--fig-amber)" />
        <text class="f-small" x={L.legend[0] + 22} y={L.legend[1]}>{t.meas}</text>
        <path class="f-line f-blue" d={`M ${L.legend[0]} ${L.legend[1] + L.lstep[1] - 4} h 16`} />
        <text class="f-small" x={L.legend[0] + 22} y={L.legend[1] + L.lstep[1]}>{t.mod}</text>
        <path class="f-thin f-muted f-dot" d={`M ${L.legend[0]} ${L.legend[1] + 2 * L.lstep[1] - 4} h 16`} />
        <text class="f-small" x={L.legend[0] + 22} y={L.legend[1] + 2 * L.lstep[1]}>{t.floor}</text>
      </g>
    </svg>
  ))}
</Figure>
