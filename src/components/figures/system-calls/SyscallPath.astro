---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The path of write(1, buf, 13) on Linux for RISC-V, the call that prints "hello, world\n" (13 bytes).
// Numbers from the kernel's generic table (include/uapi/asm-generic/unistd.h): write is 64. The scause code of an
// ecall from U-mode is 8. The C library treats a return value in [-4095, -1] as a negated error number.
const NR_WRITE = 64, CAUSE_ECALL_U = 8, LEN = 'hello, world\n'.length;
if (LEN !== 13) throw new Error('length of the hello-world string');
const t = ru
  ? {
      user: 'режим U', kernel: 'режим S (ядро)',
      boxes: {
        main: ['main', `write(1, buf, ${LEN})`, 'a0 = 1, a1 = buf, a2 = 13'],
        wrap: ['библиотека C: write', `li a7, ${NR_WRITE}`, 'ecall'],
        entry: ['вход в ядро (stvec)', 'сохранить регистры пользователя', 'sepc += 4, прочитать a7'],
        table: [`sys_call_table[${NR_WRITE}]`, `номер ${NR_WRITE} → sys_write`, ''],
        sys: [`sys_write(1, buf, ${LEN})`, 'проверить fd и буфер, скопировать', `${LEN} байт драйверу терминала`],
        back: ['библиотека C, после ecall', `a0 = ${LEN} ≥ 0: вернуть ${LEN}`, 'a0 ∈ [−4095, −1]: errno = −a0, −1'],
      },
      call: 'вызов', ecall: `ecall: scause = ${CAUSE_ECALL_U}`, sret: `sret, a0 = ${LEN}`, ret: `возврат ${LEN}`,
      steps: [
        `main вызывает write: аргументы уже в a0–a2 по соглашению о вызовах`,
        `обёртка кладёт номер ${NR_WRITE} в a7 и выполняет ecall: процессор сохраняет pc в sepc, записывает причину ${CAUSE_ECALL_U} в scause и переходит в режим S по адресу из stvec`,
        'вход в ядро сохраняет регистры пользователя и сдвигает сохранённый pc за ecall',
        `номер из a7 выбирает функцию в таблице системных вызовов`,
        `sys_write проверяет дескриптор и буфер, копирует байты и кладёт результат ${LEN} в a0; sret возвращает в режим U`,
        `обёртка проверяет a0 и возвращает ${LEN} в main или −1, установив errno`,
      ],
    }
  : {
      user: 'U-mode', kernel: 'S-mode (kernel)',
      boxes: {
        main: ['main', `write(1, buf, ${LEN})`, 'a0 = 1, a1 = buf, a2 = 13'],
        wrap: ['C library: write', `li a7, ${NR_WRITE}`, 'ecall'],
        entry: ['kernel entry (stvec)', 'save the user registers', 'sepc += 4, read a7'],
        table: [`sys_call_table[${NR_WRITE}]`, `number ${NR_WRITE} → sys_write`, ''],
        sys: [`sys_write(1, buf, ${LEN})`, 'check fd and buffer, copy the', `${LEN} bytes to the terminal driver`],
        back: ['C library, after ecall', `a0 = ${LEN} ≥ 0: return ${LEN}`, 'a0 in [−4095, −1]: errno = −a0, −1'],
      },
      call: 'call', ecall: `ecall: scause = ${CAUSE_ECALL_U}`, sret: `sret, a0 = ${LEN}`, ret: `return ${LEN}`,
      steps: [
        'main calls write: the arguments are already in a0–a2 by the calling convention',
        `the wrapper puts number ${NR_WRITE} in a7 and executes ecall: the processor saves pc in sepc, records cause ${CAUSE_ECALL_U} and enters S-mode at the address in stvec`,
        'the kernel entry saves the user registers and moves the saved pc past the ecall',
        'the number in a7 selects a function from the system-call table',
        `sys_write checks the descriptor and the buffer, copies the bytes and puts the result ${LEN} in a0; sret returns to U-mode`,
        `the wrapper checks a0 and returns ${LEN} to main, or −1 with errno set`,
      ],
    };
type Key = keyof typeof t.boxes;
const tone: Record<Key, string> = { main: 'var(--fig-green)', wrap: 'var(--fig-green)', back: 'var(--fig-green)', entry: 'var(--fig-blue)', table: 'var(--fig-amber)', sys: 'var(--fig-blue)' };
const step: Record<Key, number> = { main: 1, wrap: 2, entry: 3, table: 4, sys: 5, back: 6 };
type B = [number, number, number, number];
interface Arrow { d: string; cls: string; head: string; label?: string; at?: [number, number]; anchor?: 'start' | 'middle' | 'end'; s: number }
interface Layout { cls: string; W: number; H: number; box: Record<Key, B>; bands: { b: B; label: string; at: [number, number] }[]; arrows: Arrow[]; badges: [number, number, number][] }

const wideBox: Record<Key, B> = {
  main: [36, 36, 274, 64], wrap: [36, 136, 274, 64], back: [36, 316, 274, 64],
  entry: [450, 136, 290, 64], table: [450, 226, 290, 50], sys: [450, 302, 290, 64],
};
const nb = (y: number): B => [30, y, 300, 64];
const narrowBox: Record<Key, B> = { main: nb(30), wrap: nb(116), entry: nb(222), table: [30, 308, 300, 50], sys: nb(380), back: nb(486) };
const mid = (b: B) => b[0] + b[2] / 2, bot = (b: B) => b[1] + b[3];
const W = wideBox, N = narrowBox;
const layouts: Layout[] = [
  {
    cls: 'fig-wide', W: 760, H: 400, box: W,
    bands: [{ b: [8, 8, 314, 384], label: t.user, at: [16, 24] }, { b: [438, 8, 314, 384], label: t.kernel, at: [446, 24] }],
    arrows: [
      { d: `M ${mid(W.main)} ${bot(W.main) + 2} V ${W.wrap[1] - 3}`, cls: 'f-line', head: 'url(#f-arrow)', label: t.call, at: [mid(W.main) + 8, 122], s: 1 },
      { d: `M ${W.wrap[0] + W.wrap[2] + 2} ${W.wrap[1] + 32} H ${W.entry[0] - 3}`, cls: 'f-line f-blue', head: 'url(#f-arrow-blue)', label: t.ecall, at: [380, W.wrap[1] + 24], anchor: 'middle', s: 2 },
      { d: `M ${mid(W.entry)} ${bot(W.entry) + 2} V ${W.table[1] - 3}`, cls: 'f-line f-blue', head: 'url(#f-arrow-blue)', s: 3 },
      { d: `M ${mid(W.table)} ${bot(W.table) + 2} V ${W.sys[1] - 3}`, cls: 'f-line f-blue', head: 'url(#f-arrow-blue)', s: 4 },
      { d: `M ${W.sys[0] - 2} ${W.sys[1] + 46} H ${W.back[0] + W.back[2] + 3}`, cls: 'f-line f-green', head: 'url(#f-arrow-green)', label: t.sret, at: [380, W.sys[1] + 38], anchor: 'middle', s: 5 },
      { d: `M ${W.back[0] - 2} ${W.back[1] + 32} H 22 V ${W.main[1] + 32} H ${W.main[0] - 3}`, cls: 'f-line f-green f-dash', head: 'url(#f-arrow-green)', label: t.ret, at: [30, 262], s: 6 },
    ],
    badges: [[mid(W.main) - 16, 118, 1], [380, W.wrap[1] + 48, 2], [mid(W.entry) - 18, 213, 3], [mid(W.table) - 18, 289, 4], [380, W.sys[1] + 62, 5], [22, 290, 6]],
  },
  {
    cls: 'fig-narrow seq-narrow', W: 360, H: 590, box: N,
    bands: [{ b: [8, 8, 344, 186], label: t.user, at: [14, 22] }, { b: [8, 204, 344, 254], label: t.kernel, at: [14, 218] }, { b: [8, 468, 344, 112], label: t.user, at: [14, 482] }],
    arrows: [
      { d: `M ${mid(N.main) - 60} ${bot(N.main) + 2} V ${N.wrap[1] - 3}`, cls: 'f-line', head: 'url(#f-arrow)', label: t.call, at: [mid(N.main) - 52, 108], s: 1 },
      { d: `M ${mid(N.wrap) - 60} ${bot(N.wrap) + 2} V ${N.entry[1] - 3}`, cls: 'f-line f-blue', head: 'url(#f-arrow-blue)', label: t.ecall, at: [mid(N.wrap) - 52, 200], s: 2 },
      { d: `M ${mid(N.entry) - 60} ${bot(N.entry) + 2} V ${N.table[1] - 3}`, cls: 'f-line f-blue', head: 'url(#f-arrow-blue)', s: 3 },
      { d: `M ${mid(N.table) - 60} ${bot(N.table) + 2} V ${N.sys[1] - 3}`, cls: 'f-line f-blue', head: 'url(#f-arrow-blue)', s: 4 },
      { d: `M ${mid(N.sys) - 60} ${bot(N.sys) + 2} V ${N.back[1] - 3}`, cls: 'f-line f-green', head: 'url(#f-arrow-green)', label: t.sret, at: [mid(N.sys) - 52, 474], s: 5 },
    ],
    badges: [[mid(N.main) - 80, 108, 1], [mid(N.wrap) - 80, 200, 2], [mid(N.entry) - 80, 297, 3], [mid(N.table) - 80, 369, 4], [mid(N.sys) - 80, 466, 5], [20, 571, 6]],
  },
];
const id = 'syscall-path';
---

<Figure
  id={id}
  title={ru ? 'Путь системного вызова write от main до ядра и обратно' : 'The path of a write system call from main to the kernel and back'}
  caption={ru
    ? `Вызов write(1, buf, ${LEN}), который печатает «hello, world» и перевод строки, в Linux на RISC-V. Слева код в режиме U, справа ядро в режиме S. До ecall это обычный вызов функции библиотеки C; ловушку ecall процессор обрабатывает сам, а ядро продолжает по адресу, который оно заранее записало в stvec. ${NR_WRITE} — номер write в общей таблице Linux, которую используют RISC-V и arm64. Ядро возвращает в a0 либо результат, либо отрицательный номер ошибки; обёртка превращает второй случай в −1 и errno.`
    : `The call write(1, buf, ${LEN}) that prints "hello, world" and a newline, on Linux for RISC-V. On the left, code in U-mode; on the right, the kernel in S-mode. Up to the ecall this is an ordinary call into the C library; the processor itself handles the ecall trap, and the kernel continues at the address it stored in stvec in advance. ${NR_WRITE} is the number of write in Linux's generic table, which RISC-V and arm64 share. The kernel returns either the result or a negated error number in a0; the wrapper turns the second case into −1 and errno.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Шаги системного вызова write' : 'The steps of a write system call'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? `Блоки в режиме пользователя: main с вызовом write(1, buf, ${LEN}); обёртка библиотеки C с командами li a7, ${NR_WRITE} и ecall; та же обёртка после ecall, проверяющая a0. Блоки в ядре: вход по адресу stvec с сохранением регистров; таблица системных вызовов, элемент ${NR_WRITE}; функция sys_write. Стрелки ведут от main к обёртке, через ecall в ядро, вниз по ядру и через sret обратно в обёртку, а от неё к main.`
        : `Boxes in user mode: main calling write(1, buf, ${LEN}); the C library wrapper with the instructions li a7, ${NR_WRITE} and ecall; the same wrapper after the ecall, checking a0. Boxes in the kernel: the entry at stvec that saves the registers; the system-call table, entry ${NR_WRITE}; the function sys_write. Arrows lead from main to the wrapper, through ecall into the kernel, down through the kernel and through sret back to the wrapper, and from it to main.`}</desc>
      {L.bands.map((band, i) => (
        <g>
          <rect x={band.b[0]} y={band.b[1]} width={band.b[2]} height={band.b[3]} rx="8" style={`fill: ${band.label === t.user ? 'var(--fig-green)' : 'var(--fig-blue)'}; fill-opacity: 0.05; stroke: ${band.label === t.user ? 'var(--fig-green)' : 'var(--fig-blue)'}; stroke-opacity: 0.45`} />
          <text class="f-small f-t-muted" x={band.at[0]} y={band.at[1]} style="font-weight: 600">{band.label}</text>
        </g>
      ))}
      {(Object.keys(L.box) as Key[]).map((k) => {
        const b = L.box[k], [label, s1, s2] = t.boxes[k];
        return (
          <g data-s={String(step[k])}>
            <rect x={b[0]} y={b[1]} width={b[2]} height={b[3]} rx="7" style={`fill: ${tone[k]}; fill-opacity: 0.14; stroke: ${tone[k]}; stroke-width: 1.3`} />
            <text class="f-small" x={b[0] + 10} y={b[1] + 19} style="font-weight: 600">{label}</text>
            <text class="f-small f-t-muted" x={b[0] + 10} y={b[1] + 37} style="font-family: var(--mono, ui-monospace, monospace)">{s1}</text>
            {s2 && <text class="f-small f-t-muted" x={b[0] + 10} y={b[1] + 55} style="font-family: var(--mono, ui-monospace, monospace)">{s2}</text>}
          </g>
        );
      })}
      {L.arrows.map((a) => (
        <g data-s={String(a.s)}>
          <path class={a.cls} d={a.d} marker-end={a.head} />
          {a.label && a.at && <text class={`f-small f-halo ${a.cls.includes('blue') ? 'f-t-blue' : a.cls.includes('green') ? 'f-t-green' : ''}`} x={a.at[0]} y={a.at[1]} text-anchor={a.anchor ?? 'start'}>{a.label}</text>}
        </g>
      ))}
      {L.badges.map(([x, y, n]) => <g data-s={String(n)}><Badge x={x} y={y} n={n} /></g>)}
      {L.W === 360 && <text class="f-small f-t-green" x={36} y={575}>{t.ret} → main</text>}
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
