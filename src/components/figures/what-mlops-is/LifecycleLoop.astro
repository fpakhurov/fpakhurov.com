---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The six stages of the ML lifecycle, and the three events that can start a new turn.
const stages = ru
  ? [['Данные', 'проверка, версия'], ['Обучение', 'записанный запуск'], ['Оценка', 'сравнение с текущей'],
     ['Выкатка', 'постепенно, обратимо'], ['Мониторинг', 'входы и исходы'], ['Переобучение', 'расписание или сигнал']]
  : [['Data', 'validate, version'], ['Train', 'a recorded run'], ['Evaluate', 'gate vs production'],
     ['Deploy', 'gradual, reversible'], ['Monitor', 'inputs and outcomes'], ['Retrain', 'schedule or trigger']];
// Triggers: which stage each one enters, and the step it belongs to.
const triggers = ru
  ? [{ text: 'новые данные', stage: 0 }, { text: 'коммит', stage: 1 }, { text: 'дрейф', stage: 4 }]
  : [{ text: 'new data', stage: 0 }, { text: 'commit', stage: 1 }, { text: 'drift', stage: 4 }];
const t = ru
  ? { devops: 'DevOps: новый круг начинает только коммит', ml: 'ML: ещё новые данные и дрейф мира',
      noCommit: 'без коммита',
      steps: ['данные собирают, проверяют и сохраняют как версию; новые данные начинают круг', 'обучение с записанными кодом, конфигурацией, данными и окружением; коммит начинает круг', 'кандидата сравнивают с текущей моделью на свежих данных и не пропускают дальше, если он хуже', 'модель выкатывают постепенно, с готовым откатом', 'мониторинг входов, предсказаний и исходов; дрейф мира начинает круг без всякого коммита', 'переобучение по расписанию или по сигналу мониторинга: снова к данным'] }
  : { devops: 'DevOps: only a commit starts a new turn', ml: 'ML: also new data, and drift in the world',
      noCommit: 'no commit',
      steps: ['data are collected, validated and stored as a version; new data start a turn', 'training with recorded code, configuration, data and environment; a commit starts a turn', 'the candidate is compared with production on fresh data and stopped if it is worse', 'the model is rolled out gradually, with a rollback ready', 'inputs, predictions and outcomes are monitored; drift in the world starts a turn with no commit', 'retraining on a schedule or on an alert from monitoring: back to the data'] };

const green = toneVar.x, blue = toneVar.h, amber = toneVar.g;

// Wide: the loop as two rows, data → train → evaluate on top, retrain ← monitor ← deploy below.
const W = 760, H = 330, BW = 156, BH = 58, TOP = 64, BOT = 224;
const colX = [66, 302, 538];
const pos = [
  { x: colX[0], y: TOP }, { x: colX[1], y: TOP }, { x: colX[2], y: TOP },
  { x: colX[2], y: BOT }, { x: colX[1], y: BOT }, { x: colX[0], y: BOT },
];
for (const [name, sub] of stages) {
  if (name.length * 7.5 > BW - 14 || sub.length * 6.5 > BW - 14) throw new Error(`stage ${name} does not fit`);
}
if (colX[2] + BW > W - 20) throw new Error('row too wide');
const cx = (i: number) => pos[i].x + BW / 2;
for (const s of [t.devops, t.ml]) {
  if (s.length * 6.5 > cx(2) - cx(0) - 24) throw new Error(`centre text ${s}`);
}
// Trigger arrows enter from above (top row) or below (bottom row).
for (const tr of triggers) if (tr.text.length * 6.5 > BW) throw new Error('trigger');

// Narrow: a column; the return arrow runs up the left side, triggers come from the right.
const NW = 360, NX = 48, NBW = 190, NBH = 48, NGAP = 26, NTOP = 20;
const nY = stages.map((_, i) => NTOP + i * (NBH + NGAP));
const nBottom = nY[5] + NBH;
const NH = nBottom + 78;
for (const [name, sub] of stages) {
  if (name.length * 8.0 > NBW - 16 || sub.length * 7.3 > NBW - 16) throw new Error(`narrow stage ${name}`);
}
for (const tr of triggers) if (NX + NBW + 12 + tr.text.length * 8.4 > NW - 4) throw new Error(`narrow trigger ${tr.text}`);
for (const s of [t.devops, t.ml]) if (20 + s.length * 7.3 > NW - 4) throw new Error(`narrow text ${s}`);
const id = 'lifecycle-loop';
---

<Figure
  id={id}
  title={ru ? 'Жизненный цикл ML-системы — петля' : 'The lifecycle of an ML system is a loop'}
  caption={ru
    ? 'Шесть этапов: данные (1), обучение (2), оценка с гейтом (3), выкатка (4), мониторинг (5) и переобучение (6), после которого петля возвращается к данным. Жёлтые стрелки — события, которые начинают новый круг: в DevOps это только коммит; в ML-системе ещё новые данные и дрейф мира, который не требует ничьего коммита.'
    : 'Six stages: data (1), training (2), evaluation with a gate (3), deployment (4), monitoring (5) and retraining (6), after which the loop returns to the data. Amber arrows are events that start a new turn: in DevOps only a commit does; in an ML system new data do too, and so does drift in the world, which needs no one to commit anything.'}
>
  <svg class="fig-wide fig-bp-640" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`${id}-760-t ${id}-760-d`}>
    <title id={`${id}-760-t`}>{ru ? 'Петля из шести этапов и три запускающих события' : 'A loop of six stages and three triggering events'}</title>
    <desc id={`${id}-760-d`}>{ru
      ? 'Верхний ряд слева направо: данные, обучение, оценка. Нижний ряд справа налево: выкатка, мониторинг, переобучение. Стрелки замыкают петлю. Сверху в «данные» входит стрелка «новые данные», в «обучение» — «коммит»; снизу в «мониторинг» входит «дрейф» с пометкой «без коммита». В центре: в DevOps новый круг начинает только коммит, в ML ещё новые данные и дрейф.'
      : 'Top row left to right: data, train, evaluate. Bottom row right to left: deploy, monitor, retrain. Arrows close the loop. From above, an arrow labelled new data enters Data and one labelled commit enters Train; from below, an arrow labelled drift, marked no commit, enters Monitor. In the centre: in DevOps only a commit starts a new turn; in ML also new data and drift.'}</desc>
    {stages.map(([name, sub], i) => (
      <g data-s={String(i + 1)}>
        <rect x={pos[i].x} y={pos[i].y} width={BW} height={BH} rx="8" style={`fill: ${blue}; fill-opacity: 0.1; stroke: ${blue}; stroke-width: 1.3`} />
        <text class="f-label" x={cx(i)} y={pos[i].y + 25} text-anchor="middle" style="font-weight: 600">{name}</text>
        <text class="f-small f-t-muted" x={cx(i)} y={pos[i].y + 44} text-anchor="middle">{sub}</text>
        <Badge x={pos[i].x} y={pos[i].y} n={i + 1} />
      </g>
    ))}
    <g data-s="1"><path class="f-line f-muted" d={`M ${pos[0].x + BW + 2} ${TOP + BH / 2} H ${pos[1].x - 3}`} marker-end="url(#f-arrow-muted)" /></g>
    <g data-s="2"><path class="f-line f-muted" d={`M ${pos[1].x + BW + 2} ${TOP + BH / 2} H ${pos[2].x - 3}`} marker-end="url(#f-arrow-muted)" /></g>
    <g data-s="3"><path class="f-line f-muted" d={`M ${cx(2)} ${TOP + BH + 2} V ${BOT - 3}`} marker-end="url(#f-arrow-muted)" /></g>
    <g data-s="4"><path class="f-line f-muted" d={`M ${pos[3].x - 2} ${BOT + BH / 2} H ${pos[4].x + BW + 3}`} marker-end="url(#f-arrow-muted)" /></g>
    <g data-s="5"><path class="f-line f-muted" d={`M ${pos[4].x - 2} ${BOT + BH / 2} H ${pos[5].x + BW + 3}`} marker-end="url(#f-arrow-muted)" /></g>
    <g data-s="6"><path class="f-line f-green" d={`M ${cx(5)} ${BOT - 2} V ${TOP + BH + 3}`} marker-end="url(#f-arrow-green)" /></g>
    {triggers.map((tr) => {
      const p = pos[tr.stage], fromTop = p.y === TOP;
      const x = cx(tr.stage) + 30;
      return (
        <g data-s={String(tr.stage + 1)}>
          {fromTop
            ? <path class="f-line f-amber f-bold" d={`M ${x} ${p.y - 30} V ${p.y - 3}`} marker-end="url(#f-arrow-amber)" />
            : <path class="f-line f-amber f-bold" d={`M ${x} ${p.y + BH + 30} V ${p.y + BH + 3}`} marker-end="url(#f-arrow-amber)" />}
          <text class="f-small f-t-amber" x={x + 8} y={fromTop ? p.y - 18 : p.y + BH + 26} style="font-weight: 650">{tr.text}{!fromTop && <tspan class="f-t-muted" style="font-weight: 400"> · {t.noCommit}</tspan>}</text>
        </g>
      );
    })}
    <text class="f-small f-t-muted" x={W / 2} y={(TOP + BH + BOT) / 2 - 4} text-anchor="middle">{t.devops}</text>
    <text class="f-small" x={W / 2} y={(TOP + BH + BOT) / 2 + 16} text-anchor="middle" style="font-weight: 650">{t.ml}</text>
  </svg>

  <svg class="fig-narrow seq-narrow fig-bp-640" viewBox={`0 0 ${NW} ${NH}`} role="img" aria-labelledby={`${id}-360-t ${id}-360-d`}>
    <title id={`${id}-360-t`}>{ru ? 'Петля из шести этапов и три запускающих события' : 'A loop of six stages and three triggering events'}</title>
    <desc id={`${id}-360-d`}>{ru
      ? 'Сверху вниз: данные, обучение, оценка, выкатка, мониторинг, переобучение; слева стрелка ведёт от переобучения обратно к данным. Справа в этапы входят жёлтые стрелки: «новые данные» в данные, «коммит» в обучение, «дрейф» в мониторинг.'
      : 'Top to bottom: data, train, evaluate, deploy, monitor, retrain; on the left an arrow leads from retrain back to data. From the right, amber arrows enter the stages: new data into Data, commit into Train, drift into Monitor.'}</desc>
    {stages.map(([name, sub], i) => (
      <g data-s={String(i + 1)}>
        {i > 0 && <path class="f-line f-muted" d={`M ${NX + NBW / 2} ${nY[i - 1] + NBH + 2} V ${nY[i] - 3}`} marker-end="url(#f-arrow-muted)" />}
        <rect x={NX} y={nY[i]} width={NBW} height={NBH} rx="8" style={`fill: ${blue}; fill-opacity: 0.1; stroke: ${blue}; stroke-width: 1.3`} />
        <text class="f-label" x={NX + NBW / 2} y={nY[i] + 21} text-anchor="middle" style="font-weight: 600">{name}</text>
        <text class="f-small f-t-muted" x={NX + NBW / 2} y={nY[i] + 40} text-anchor="middle">{sub}</text>
        <Badge x={NX} y={nY[i]} n={i + 1} />
      </g>
    ))}
    <g data-s="6"><path class="f-line f-green" d={`M ${NX - 2} ${nY[5] + NBH / 2} H 24 V ${nY[0] + NBH / 2} H ${NX - 3}`} marker-end="url(#f-arrow-green)" /></g>
    {triggers.map((tr) => (
      <g data-s={String(tr.stage + 1)}>
        <path class="f-line f-amber f-bold" d={`M ${NW - 6} ${nY[tr.stage] + NBH / 2 + 8} H ${NX + NBW + 3}`} marker-end="url(#f-arrow-amber)" />
        <text class="f-small f-t-amber" x={NX + NBW + 12} y={nY[tr.stage] + NBH / 2} style="font-weight: 650">{tr.text}</text>
      </g>
    ))}
    <text class="f-small f-t-muted" x={20} y={nBottom + 34}>{t.devops}</text>
    <text class="f-small" x={20} y={nBottom + 58} style="font-weight: 650">{t.ml}</text>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
