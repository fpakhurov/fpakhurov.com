---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The fraud system along the path of one payment. The model is the small dark box; sizes are illustrative.
// step: the numbered item of the list under the figure in the note.
interface Part { key: string; en: string; ru: string; subEn: string; subRu: string; step: number; w: number }
const parts: Part[] = [
  { key: 'collect', en: 'collection', ru: 'сбор данных', subEn: 'events, labels', subRu: 'события, метки', step: 1, w: 104 },
  { key: 'verify', en: 'verification', ru: 'проверка', subEn: 'schema, ranges', subRu: 'схема, диапазоны', step: 1, w: 116 },
  { key: 'features', en: 'features', ru: 'признаки', subEn: 'batch and live', subRu: 'пакетно и онлайн', step: 2, w: 116 },
  { key: 'model', en: 'ML', ru: 'ML', subEn: '', subRu: '', step: 3, w: 44 },
  { key: 'serving', en: 'serving', ru: 'инференс', subEn: 'endpoint, fallback', subRu: 'API, запасной путь', step: 4, w: 134 },
  { key: 'monitor', en: 'monitoring', ru: 'мониторинг', subEn: 'inputs, outcomes', subRu: 'входы, исходы', step: 5, w: 136 },
];
const label = (p: Part) => (ru ? p.ru : p.en);
const sub = (p: Part) => (ru ? p.subRu : p.subEn);
const t = ru
  ? { model: 'модель', band: 'конфигурация · ресурсы · оркестрация · анализ · управление процессами',
      bandA: 'конфигурация · ресурсы · оркестрация', bandB: 'анализ · управление процессами',
      loop: 'метки и сигналы возвращаются к данным', path: 'путь одного платежа',
      steps: ['сбор событий и меток и их проверка', 'признаки: из истории для обучения и из живых данных для инференса', 'сама модель: код обучения и параметры', 'инференс внутри бюджета задержки, с запасным путём', 'мониторинг входов, предсказаний и исходов; метки возвращаются в данные', 'вокруг всего: конфигурация, ресурсы, оркестрация, анализ и процессы'] }
  : { model: 'the model', band: 'configuration · compute · orchestration · analysis tools · process management',
      bandA: 'configuration · compute · orchestration', bandB: 'analysis tools · process management',
      loop: 'labels and alerts return to the data', path: 'the path of one payment',
      steps: ['collect events and labels, and verify them', 'features: from history for training, from live data for serving', 'the model itself: training code and parameters', 'serving inside the latency budget, with a fallback', 'monitor inputs, predictions and outcomes; labels flow back to the data', 'around everything: configuration, compute, orchestration, analysis and process'] };

// Wide layout: one row of boxes, the model small and centred vertically, a band underneath.
const W = 760, X0 = 20, GAP = 14, Y = 64, H = 104, MH = 30;
const xs: number[] = [];
{ let x = X0; for (const p of parts) { xs.push(x); x += p.w + GAP; } }
const end = xs[xs.length - 1] + parts[parts.length - 1].w;
if (end > W - 18) throw new Error(`row too wide: ${end}`);
for (const p of parts) {
  if (p.key === 'model') continue;
  if (label(p).length * 7.5 > p.w - 10) throw new Error(`label ${p.en} does not fit`);
  if (sub(p).length * 6.5 > p.w - 10) throw new Error(`sub ${p.en} does not fit`);
}
const BAND_Y = 226, BAND_H = 46, LOOP_Y = 198;
if (t.band.length * 7.5 > W - 2 * X0 - 20) throw new Error('band text');
const mid = (i: number) => xs[i] + parts[i].w / 2;
const loopLabelX = (mid(0) + mid(5)) / 2;
if (t.loop.length * 6.5 > mid(5) - mid(0) - 20) throw new Error('loop label');
// The model box must be much smaller than every other box: that is the point of the figure.
const mArea = parts[3].w * MH;
for (const p of parts) if (p.key !== 'model' && p.w * H < 8 * mArea) throw new Error('model box not small enough');

// Narrow layout: a column of boxes; the feedback runs up the right side.
const NW = 360, NX = 50, NBW = 262, NBH = 50, NMH = 34, NMW = 70, NGAP = 18, NTOP = 30;
const nY: number[] = [];
{ let y = NTOP; for (const p of parts) { nY.push(y); y += (p.key === 'model' ? NMH : NBH) + NGAP; } }
const nEnd = nY[5] + NBH;
const NBAND_Y = nEnd + 28, NBAND_H = 62, NH = NBAND_Y + NBAND_H + 14;
for (const p of parts) {
  if (p.key === 'model') continue;
  if (label(p).length * 8.0 > NBW - 20 || sub(p).length * 7.3 > NBW - 20) throw new Error(`narrow ${p.en}`);
}
for (const s of [t.bandA, t.bandB]) if (s.length * 7.3 > NW - 40) throw new Error(`narrow band ${s}`);
const NFX = 334;
const blue = toneVar.h, green = toneVar.x, amber = toneVar.g;
const id = 'ml-system';
---

<Figure
  id={id}
  title={ru ? 'Модель — малая часть ML-системы' : 'The model is a small part of an ML system'}
  caption={ru
    ? 'Система проверки платежей на мошенничество по пути одного платежа. Сбор событий и меток и их проверка (1), признаки (2), сама модель — маленький тёмный прямоугольник (3), инференс (4) и мониторинг (5); метки и сигналы мониторинга возвращаются к данным и запускают следующий круг. Под всем лежат конфигурация, вычислительные ресурсы, оркестрация, инструменты анализа и процессы (6). Размеры условны: идея, что код модели составляет малую долю системы, взята из работы Скалли и соавторов (2015).'
    : 'The fraud-check system along the path of one payment. Collecting and verifying events and labels (1), features (2), the model itself, the small dark box (3), serving (4) and monitoring (5); labels and monitoring alerts flow back to the data and start the next turn. Underneath everything lie configuration, compute, orchestration, analysis tools and processes (6). Sizes are illustrative: the idea that model code is a small share of the system is that of Sculley et al. (2015).'}
>
  <svg class="fig-wide fig-bp-640" viewBox={`0 0 ${W} 288`} role="img" aria-labelledby={`${id}-760-t ${id}-760-d`}>
    <title id={`${id}-760-t`}>{ru ? 'Компоненты ML-системы вокруг маленькой модели' : 'The components of an ML system around a small model'}</title>
    <desc id={`${id}-760-d`}>{ru
      ? 'Слева направо: сбор данных, проверка, признаки, маленький тёмный прямоугольник с надписью ML, инференс и мониторинг, соединённые стрелками. Стрелка снизу ведёт от мониторинга обратно к сбору данных. Под рядом широкая полоса: конфигурация, ресурсы, оркестрация, анализ, управление процессами.'
      : 'Left to right: collection, verification, features, a small dark box labelled ML, serving and monitoring, joined by arrows. An arrow along the bottom leads from monitoring back to collection. Below the row, a wide band: configuration, compute, orchestration, analysis tools, process management.'}</desc>
    <text class="f-small f-t-muted" x={X0} y={30} style="font-weight: 650">{t.path} →</text>
    {parts.map((p, i) => {
      const x = xs[i];
      const isModel = p.key === 'model';
      const y = isModel ? Y + (H - MH) / 2 : Y;
      const h = isModel ? MH : H;
      return (
        <g data-s={String(p.step)}>
          {i > 0 && <path class="f-line f-muted" d={`M ${xs[i - 1] + parts[i - 1].w + 1} ${Y + H / 2} H ${x - 2}`} marker-end="url(#f-arrow-muted)" />}
          {isModel
            ? <g>
                <rect x={x} y={y} width={p.w} height={h} rx="4" style="fill: var(--ink)" />
                <text class="f-small" x={x + p.w / 2} y={y + h / 2 + 4.5} text-anchor="middle" style="fill: var(--paper); font-weight: 700">{label(p)}</text>
                <text class="f-small f-t-muted" x={x + p.w / 2} y={y + h + 18} text-anchor="middle">{t.model}</text>
              </g>
            : <g>
                <rect x={x} y={y} width={p.w} height={h} rx="7" style={`fill: ${blue}; fill-opacity: 0.1; stroke: ${blue}; stroke-width: 1.2`} />
                <text class="f-label" x={x + p.w / 2} y={y + h / 2 + 2} text-anchor="middle">{label(p)}</text>
                <text class="f-small f-t-muted" x={x + p.w / 2} y={y + h / 2 + 20} text-anchor="middle">{sub(p)}</text>
              </g>}
        </g>
      );
    })}
    <g data-s="5">
      <path class="f-line f-green f-dash" d={`M ${mid(5)} ${Y + H} V ${LOOP_Y} H ${mid(0)} V ${Y + H + 3}`} marker-end="url(#f-arrow-green)" />
      <text class="f-small f-t-green f-halo" x={loopLabelX} y={LOOP_Y - 6} text-anchor="middle">{t.loop}</text>
    </g>
    <g data-s="6">
      <rect x={X0} y={BAND_Y} width={W - 2 * X0} height={BAND_H} rx="7" style={`fill: ${amber}; fill-opacity: 0.12; stroke: ${amber}; stroke-width: 1.2`} />
      <text class="f-label" x={W / 2} y={BAND_Y + BAND_H / 2 + 5} text-anchor="middle">{t.band}</text>
    </g>
    <g data-s="1"><Badge x={xs[0]} y={Y} n={1} /></g>
    <g data-s="2"><Badge x={xs[2]} y={Y} n={2} /></g>
    <g data-s="3"><Badge x={xs[3] + parts[3].w / 2} y={Y + (H - MH) / 2 - 16} n={3} /></g>
    <g data-s="4"><Badge x={xs[4]} y={Y} n={4} /></g>
    <g data-s="5"><Badge x={xs[5]} y={Y} n={5} /></g>
    <g data-s="6"><Badge x={X0} y={BAND_Y} n={6} /></g>
  </svg>

  <svg class="fig-narrow seq-narrow fig-bp-640" viewBox={`0 0 ${NW} ${NH}`} role="img" aria-labelledby={`${id}-360-t ${id}-360-d`}>
    <title id={`${id}-360-t`}>{ru ? 'Компоненты ML-системы вокруг маленькой модели' : 'The components of an ML system around a small model'}</title>
    <desc id={`${id}-360-d`}>{ru
      ? 'Сверху вниз: сбор данных, проверка, признаки, маленький тёмный прямоугольник ML, инференс и мониторинг. Справа стрелка ведёт от мониторинга обратно к сбору данных. Внизу полоса: конфигурация, ресурсы, оркестрация, анализ, управление процессами.'
      : 'Top to bottom: collection, verification, features, a small dark box labelled ML, serving and monitoring. On the right an arrow leads from monitoring back to collection. At the bottom, a band: configuration, compute, orchestration, analysis tools, process management.'}</desc>
    {parts.map((p, i) => {
      const isModel = p.key === 'model';
      const y = nY[i];
      const h = isModel ? NMH : NBH;
      const x = isModel ? NX + (NBW - NMW) / 2 : NX;
      const w = isModel ? NMW : NBW;
      return (
        <g data-s={String(p.step)}>
          {i > 0 && <path class="f-line f-muted" d={`M ${NX + NBW / 2} ${nY[i - 1] + (parts[i - 1].key === 'model' ? NMH : NBH) + 1} V ${y - 2}`} marker-end="url(#f-arrow-muted)" />}
          {isModel
            ? <g>
                <rect x={x} y={y} width={w} height={h} rx="4" style="fill: var(--ink)" />
                <text class="f-small" x={x + w / 2} y={y + h / 2 + 5} text-anchor="middle" style="fill: var(--paper); font-weight: 700">{label(p)}</text>
                <text class="f-small f-t-muted" x={x + w + 10} y={y + h / 2 + 5}>{t.model}</text>
              </g>
            : <g>
                <rect x={x} y={y} width={w} height={h} rx="7" style={`fill: ${blue}; fill-opacity: 0.1; stroke: ${blue}; stroke-width: 1.2`} />
                <text class="f-label" x={x + w / 2} y={y + 21} text-anchor="middle">{label(p)}</text>
                <text class="f-small f-t-muted" x={x + w / 2} y={y + 40} text-anchor="middle">{sub(p)}</text>
              </g>}
        </g>
      );
    })}
    <g data-s="5">
      <path class="f-line f-green f-dash" d={`M ${NX + NBW + 1} ${nY[5] + NBH / 2} H ${NFX} V ${nY[0] + NBH / 2} H ${NX + NBW + 3}`} marker-end="url(#f-arrow-green)" />
    </g>
    <g data-s="6">
      <rect x={20} y={NBAND_Y} width={NW - 40} height={NBAND_H} rx="7" style={`fill: ${amber}; fill-opacity: 0.12; stroke: ${amber}; stroke-width: 1.2`} />
      <text class="f-small" x={NW / 2} y={NBAND_Y + 26} text-anchor="middle">{t.bandA}</text>
      <text class="f-small" x={NW / 2} y={NBAND_Y + 48} text-anchor="middle">{t.bandB}</text>
    </g>
    {[0, 2, 3, 4, 5].map((i) => (
      <g data-s={String(parts[i].step)}><Badge x={28} y={nY[i] + (parts[i].key === 'model' ? NMH : NBH) / 2} n={parts[i].step} /></g>
    ))}
    <g data-s="6"><Badge x={28} y={NBAND_Y + NBAND_H / 2} n={6} /></g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
