---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import Sub from '../generative-modeling/Sub.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One step of a language-model agent: render the context, score and sample tokens until the end of the turn,
// parse the string into an action, act, and append the observation. Five steps, as in the numbered list of the note.
const t = ru
  ? {
      title: 'Языковая модель как стратегия: один шаг агента',
      agent: 'программа агента', ctx: 'контекст c_t', instr: 'инструкции', hist: 'o_1, a_1, …, a_{t-1}', now: 'o_t',
      model: 'модель π_θ', modelSub: 'логиты токена', sample: 'сэмплирование', sampleSub: 'softmax(z / τ)',
      loop: 'до конца реплики', y: 'y', parse: 'разбор', parseSub: 'действие или invalid', act: 'a_t',
      env: 'среда', envSub: 'состояние, инструменты', obs: 'o_{t+1} добавляется в историю', tok: 'токен за токеном',
      steps: ['шаблон чата записывает инструкции, историю и новое наблюдение в контекст', 'модель читает контекст и выдаёт логиты следующего токена', 'токены сэмплируются с температурой τ, пока не появится токен конца реплики', 'парсер переводит строку y в действие a_t или помечает её как недопустимую', 'среда выполняет действие, наблюдение o_{t+1} добавляется в историю'],
      desc: 'Слева программа агента: столбец контекста из трёх строк (инструкции; o_1, a_1, …, a_{t−1}; o_t), блок модели, выдающей логиты следующего токена, блок сэмплирования softmax(z / τ) со стрелкой назад к модели, которая повторяется до конца реплики, и блок разбора, который переводит строку y в действие или в недопустимое действие (invalid). Справа среда со скрытым состоянием и инструментами получает действие a_t. Внизу стрелка возвращает наблюдение o_{t+1} в контекст.',
    }
  : {
      title: 'The language model as a policy: one step of the agent',
      agent: 'agent program', ctx: 'context c_t', instr: 'instructions', hist: 'o_1, a_1, …, a_{t-1}', now: 'o_t',
      model: 'model π_θ', modelSub: 'next-token logits', sample: 'sample', sampleSub: 'softmax(z / τ)',
      loop: 'until end of turn', y: 'y', parse: 'parse', parseSub: 'action or invalid', act: 'a_t',
      env: 'environment', envSub: 'hidden state, tools', obs: 'o_{t+1} appended to the history', tok: 'token by token',
      steps: ['the chat template writes the instructions, the history and the new observation into the context', 'the model reads the context and produces the logits of the next token', 'tokens are sampled at temperature τ until the end-of-turn token', 'the parser maps the string y to an action a_t, or marks it invalid', 'the environment executes the action; the observation o_{t+1} is appended'],
      desc: 'On the left the agent program: a context column of three rows (instructions; o_1, a_1, …, a_{t−1}; o_t), a model box that produces next-token logits, a sampling box softmax(z / τ) with an arrow back to the model that repeats until the end of the turn, and a parse box that maps the string y to an action or to invalid. On the right the environment, with its hidden state and tools, receives the action a_t. Along the bottom an arrow returns the observation o_{t+1} to the context.',
    };
if (t.steps.length !== 5) throw new Error('PolicyLoop: the note lists five steps');
const id = 'policy-loop';
const caption = ru
  ? 'Модель работает только на шагах 2 и 3: она выдаёт распределение следующего токена, из него сэмплируется токен, и так до конца реплики. Шаблон, парсер и цикл — часть программы агента, написанной людьми. Среда видит только разобранное действие; строка, которую парсер отверг, становится недопустимым действием. Контекст — это история, записанная текстом, и больше ничего о скрытом состоянии среды у модели нет.'
  : 'The model runs only in steps 2 and 3: it gives a distribution over the next token, a token is drawn, and this repeats until the end of the turn. The template, the parser and the loop belong to the agent program, written by people. The environment sees only the parsed action; a string the parser rejects becomes an invalid action. The context is the history written as text, and it is all the model has to go on about the hidden state of the environment.';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 284" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <rect class="f-box-soft" x="16" y="40" width="512" height="196" rx="10" />
    <text class="f-small f-t-muted" x="516" y="58" text-anchor="end">{t.agent}</text>
    <g data-s="1">
      <text class="f-small" x="108" y="62" text-anchor="middle"><Sub label={t.ctx} /></text>
      <Box x={30} y={70} w={156} h={32} label={t.instr} tone="x" />
      <Box x={30} y={108} w={156} h={32} label={t.hist} tone="x" />
      <Box x={30} y={146} w={156} h={32} label={t.now} tone="x" />
      <Badge x={204} y={104} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[186, 126], [220, 126]]} />
      <Box x={222} y={98} w={132} h={56} label={t.model} sub={t.modelSub} tone="g" />
      <Badge x={288} y={172} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[354, 126], [382, 126]]} />
      <Box x={384} y={98} w={132} h={56} label={t.sample} sub={t.sampleSub} />
      <Arrow pts={[[450, 98], [450, 80], [288, 80], [288, 96]]} tone="amber" />
      <text class="f-small f-t-amber" x="369" y="73" text-anchor="middle">{t.loop}</text>
      <Badge x={368} y={104} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[450, 154], [450, 174]]} />
      <text class="f-small f-t-muted" x="458" y="169">{t.y}</text>
      <Box x={384} y={176} w={132} h={46} label={t.parse} sub={t.parseSub} />
      <Badge x={368} y={199} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[516, 199], [570, 199]]} tone="red" />
      <text class="f-small f-t-red" x="543" y="190" text-anchor="middle"><Sub label={t.act} /></text>
      <Box x={572} y={166} w={172} h={66} label={t.env} sub={t.envSub} tone="h" />
      <Arrow pts={[[658, 232], [658, 266], [108, 266], [108, 180]]} tone="green" />
      <text class="f-small f-t-green" x="383" y="258" text-anchor="middle"><Sub label={t.obs} /></text>
      <Badge x={700} y={250} n={5} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 500" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <g data-s="1">
      <text class="f-small" x="180" y="28" text-anchor="middle"><Sub label={t.ctx} /></text>
      <Box x={40} y={40} w={280} h={30} label={t.instr} tone="x" />
      <Box x={40} y={74} w={280} h={30} label={t.hist} tone="x" />
      <Box x={40} y={108} w={280} h={30} label={t.now} tone="x" />
      <Badge x={22} y={89} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[180, 138], [180, 164]]} />
      <Box x={105} y={166} w={150} h={52} label={t.model} sub={t.modelSub} tone="g" />
      <Badge x={81} y={192} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[180, 218], [180, 244]]} />
      <text class="f-small f-t-amber" x="172" y="236" text-anchor="end">{t.tok}</text>
      <Box x={105} y={246} w={150} h={52} label={t.sample} sub={t.sampleSub} />
      <Arrow pts={[[255, 272], [282, 272], [282, 192], [257, 192]]} tone="amber" />
      <Badge x={81} y={272} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[180, 298], [180, 322]]} />
      <Box x={105} y={324} w={150} h={48} label={t.parse} sub={t.parseSub} />
      <Badge x={81} y={348} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[180, 372], [180, 398]]} tone="red" />
      <text class="f-small f-t-red" x="190" y="390"><Sub label={t.act} /></text>
      <Box x={60} y={400} w={240} h={52} label={t.env} sub={t.envSub} tone="h" />
      <Arrow pts={[[180, 452], [180, 488], [346, 488], [346, 123], [322, 123]]} tone="green" />
      <text class="f-small f-t-green" x="180" y="474" text-anchor="middle"><Sub label={t.obs} /></text>
      <Badge x={40} y={426} n={5} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
