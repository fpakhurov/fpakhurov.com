---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One weight w, eight points x with labels y, a logistic likelihood and the prior N(0, 1); q = N(μ, σ²).
// Single-sample variances of three estimators of ∂ELBO/∂μ, by quadrature on a grid of 6001 standard-normal points:
// the score function (z − μ)/σ² · (log p − log q), the same with the optimal constant control variate, and the
// reparameterization gradient d/dw log p(x, w) at w = μ + σε. σ is held at its optimum; μ varies.
const xs = [-2, -1.5, -1, -0.5, 0.5, 1, 1.5, 2], ys = [0, 0, 1, 0, 1, 0, 1, 1];
const LOG2PI = Math.log(2 * Math.PI);
const G = 6001, E = Array.from({ length: G }, (_, i) => -9 + (18 * i) / (G - 1));
const W0 = E.map((e) => Math.exp(-e * e / 2)), Z = W0.reduce((a, b) => a + b, 0), WE = W0.map((w) => w / Z);
const softplus = (s: number) => (s > 0 ? s + Math.log1p(Math.exp(-s)) : Math.log1p(Math.exp(s)));
const logjoint = (w: number) => xs.reduce((a, x, i) => a + ys[i] * w * x - softplus(w * x), 0) - w * w / 2 - LOG2PI / 2;
const dlogjoint = (w: number) => xs.reduce((a, x, i) => a + (ys[i] - 1 / (1 + Math.exp(-w * x))) * x, 0) - w;
const elbo = (mu: number, ls: number) => E.reduce((a, e, i) => a + WE[i] * (logjoint(mu + Math.exp(ls) * e) + e * e / 2 + ls + LOG2PI / 2), 0);
const MU = 0.76035, SG = 0.53505; // the optimum of the ELBO, found by the Code section and checked here
const dm = (elbo(MU + 1e-4, Math.log(SG)) - elbo(MU - 1e-4, Math.log(SG))) / 2e-4;
const ds = (elbo(MU, Math.log(SG) + 1e-4) - elbo(MU, Math.log(SG) - 1e-4)) / 2e-4;
if (Math.abs(dm) > 1e-3 || Math.abs(ds) > 1e-3) throw new Error(`EstimatorVariance: (μ, σ) is not the optimum (${dm}, ${ds})`);
const variances = (mu: number) => {
  let mS = 0, sS = 0, hh = 0, hfh = 0, mR = 0, sR = 0;
  const fs = E.map((e) => logjoint(mu + SG * e) + e * e / 2 + Math.log(SG) + LOG2PI / 2);
  E.forEach((e, i) => { const h = e / SG, g = h * fs[i], r = dlogjoint(mu + SG * e), w = WE[i];
    mS += w * g; sS += w * g * g; hh += w * h * h; hfh += w * g * h; mR += w * r; sR += w * r * r; });
  const a = hfh / hh;
  let sC = 0;
  E.forEach((e, i) => { const h = e / SG, gc = h * (fs[i] - a); sC += WE[i] * gc * gc; });
  return [sS - mS * mS, sC - mS * mS, sR - mR * mR];
};
const MUS = Array.from({ length: 81 }, (_, i) => -1 + i * 0.05);
const V = MUS.map(variances);
const vOpt = variances(MU), vLeft = V[0];
const ratio = (V[80][1] / V[80][2]).toFixed(0), rng = [Math.min(...V.map((v) => v[2])).toFixed(2), Math.max(...V.map((v) => v[2])).toFixed(1)].join(' ');
if (ratio !== '95' || rng !== '0.47 5.1') throw new Error(`EstimatorVariance: caption numbers drifted (${ratio}, ${rng})`);
const chk = [...vOpt, ...vLeft].map((v) => v.toFixed(1)).join(' ');
if (chk !== '94.7 0.2 3.6 523.2 86.1 2.9') throw new Error(`EstimatorVariance: drifted from the Code section (${chk})`);

const tone = ['red', 'amber', 'blue'];
const t = ru
  ? { title: 'Дисперсия трёх оценок градиента ELBO', x: 'среднее μ вариационного распределения', y: 'дисперсия по одному сэмплу (лог. шкала)',
      lab: ['функция вклада', 'с контрольной переменной', 'репараметризация'], opt: 'оптимум μ = 0.76',
      desc: 'Дисперсия по одному сэмплу трёх оценок производной ELBO по μ для логистической регрессии с одним весом, при σ = 0.535 и μ от −1 до 3, в логарифмической шкале. Через функцию вклада: от 95 в оптимуме до 523 при μ = −1. С оптимальной постоянной контрольной переменной: от 0.2 в оптимуме до 86. Репараметризация: от 0.47 до 5.1 на всём отрезке.' }
  : { title: 'Variance of three estimators of the ELBO gradient', x: 'mean μ of the variational distribution', y: 'variance of one sample (log scale)',
      lab: ['score function', 'with a control variate', 'reparameterization'], opt: 'optimum μ = 0.76',
      desc: 'The single-sample variance of three estimators of the derivative of the ELBO with respect to μ, for logistic regression with one weight, at σ = 0.535 and μ from −1 to 3, on a log scale. Score function: from 95 at the optimum to 523 at μ = −1. With the optimal constant control variate: from 0.2 at the optimum to 86. Reparameterization: between 0.47 and 5.1 over the whole range.' };
const id = 'bbvi-estimator-variance';
const caption = ru
  ? 'Дисперсия по одному сэмплу трёх оценок ∂L/∂μ, вычисленная квадратурой, для одного веса с априорным N(0, 1), восьми размеченных точек из раздела «Код» и логистического правдоподобия; σ = 0.535, оптимальное значение. Вблизи оптимума μ = 0.76 базовая линия выигрывает у репараметризации, а при μ = 3 проигрывает ей в 95 раз.'
  : 'Single-sample variance of three estimators of ∂L/∂μ, by quadrature, for one weight with prior N(0, 1), the eight labelled points of the Code section and a logistic likelihood; σ = 0.535, its optimal value. Near the optimum μ = 0.76 the baseline beats reparameterization; at μ = 3 it loses by a factor of 95.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 340, x: [80, 520], y: [40, 260], leg: [[550, 80], [550, 108], [550, 136]] },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 450, x: [56, 340], y: [40, 300], leg: [[16, 382], [16, 406], [16, 430]] },
];
const yt = [-1, 0, 1, 2, 3], ysl = ['0.1', '1', '10', '100', '1000'];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sx = scale([-1, 3], L.x as [number, number]), sy = scale([-1, 3], [L.y[1], L.y[0]]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {yt.map((v) => <path class="f-grid" d={`M ${L.x[0]} ${sy(v)} H ${L.x[1]}`} />)}
        <path class="f-axis" d={`M ${L.x[0]} ${L.y[0]} V ${L.y[1]} H ${L.x[1]}`} />
        {yt.map((v, i) => <text class="f-note" x={L.x[0] - 7} y={sy(v) + 5} text-anchor="end">{ysl[i]}</text>)}
        {[-1, 0, 1, 2, 3].map((v) => <text class="f-note" x={sx(v)} y={L.y[1] + 19} text-anchor="middle">{v}</text>)}
        <text class="f-small f-t-muted" x={(L.x[0] + L.x[1]) / 2} y={L.y[1] + 40} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.x[0] - 50} y={L.y[0] - 14}>{t.y}</text>
        <path class="f-line f-muted f-dash" d={`M ${sx(MU)} ${L.y[0] + 24} V ${L.y[1]}`} />
        <text class="f-small f-t-muted f-halo" x={sx(MU) + 6} y={sy(2.75)}>{t.opt}</text>
        {[0, 1, 2].map((k) => <path class={`f-line f-${tone[k]}`} d={polyline(MUS.map((m, i) => [sx(m), sy(Math.log10(V[i][k]))]))} />)}
        {[0, 1, 2].map((k) => (
          <g>
            <path class={`f-line f-${tone[k]}`} d={`M ${L.leg[k][0]} ${L.leg[k][1] - 4} h 26`} />
            <text class="f-small" x={L.leg[k][0] + 34} y={L.leg[k][1]}>{t.lab[k]}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
