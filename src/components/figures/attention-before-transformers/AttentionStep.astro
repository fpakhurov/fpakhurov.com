---
import Figure from '../Figure.astro';

// One decoder step with dot-product attention over three encoder states.
// Numbers are computed here so that figure and text agree.
const h: [number, number][] = [[1, 0], [0, 1], [1, 1]];
const s: [number, number] = [0.9, 0.2];
const scores = h.map(([a, b]) => s[0] * a + s[1] * b);
const exps = scores.map((x) => Math.exp(x));
const Z = exps.reduce((a, b) => a + b, 0);
const weights = exps.map((e) => e / Z);
const context: [number, number] = [
  weights.reduce((acc, w, i) => acc + w * h[i][0], 0),
  weights.reduce((acc, w, i) => acc + w * h[i][1], 0),
];
const f = (x: number) => x.toFixed(3);
const tokens = ['Ein', 'Mann', 'liest'];
const cellW = 64;
const cellH = 34;

interface Layout { cls: string; w: number; h: number; encX: number; encY: number; decX: number; decY: number; ctxX: number; ctxY: number; tableX: number; tableY: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', w: 700, h: 300, encX: 40, encY: 200, decX: 40, decY: 60, ctxX: 300, ctxY: 60, tableX: 430, tableY: 50 },
  { cls: 'fig-narrow', w: 360, h: 470, encX: 30, encY: 190, decX: 30, decY: 60, ctxX: 220, ctxY: 60, tableX: 30, tableY: 290 },
];
---

<Figure
  id="attention-step"
  title="One decoder step with dot-product attention over three encoder states"
  caption={`Toy numbers in two dimensions. The decoder state s = (0.9, 0.2) is compared with every encoder state by a dot product, giving scores ${scores.map(f).join(', ')}. A softmax turns them into weights ${weights.map(f).join(', ')}, which sum to one. The context vector is the weighted sum of the encoder states, (${f(context[0])}, ${f(context[1])}); it leans towards the states that scored highest. The decoder then predicts the next token from s and the context together. The weights are recomputed at every decoder step.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`attention-step-${L.w}-t attention-step-${L.w}-d`}>
      <title id={`attention-step-${L.w}-t`}>Attention weights and context vector for one decoder step</title>
      <desc id={`attention-step-${L.w}-d`}>Three encoder state boxes at the bottom labelled with the German tokens. A decoder state box above them is connected to each encoder state by an arrow labelled with the attention weight. The weighted sum flows into a context vector box, and a table lists the scores, the softmax weights and the context vector.</desc>
      {h.map((vec, i) => {
        const x = L.encX + i * (cellW + 18);
        return (
          <g>
            <rect class="f-box" x={x} y={L.encY} width={cellW} height={cellH} rx="6" />
            <text class="f-math" x={x + cellW / 2} y={L.encY + 23} text-anchor="middle">h<tspan dy="5" font-size="12">{i + 1}</tspan></text>
            <text class="f-small f-t-muted" x={x + cellW / 2} y={L.encY + cellH + 18} text-anchor="middle">{tokens[i]} ({vec[0]}, {vec[1]})</text>
            <path class={`f-line f-blue${weights[i] < 0.25 ? ' f-dash' : ''}`} d={`M ${x + cellW / 2} ${L.encY - 2} L ${L.decX + cellW / 2 + (i - 1) * 8} ${L.decY + cellH + 3}`} marker-end="url(#f-arrow-blue)" />
            <text class="f-small f-t-blue f-halo" x={(x + cellW / 2 + L.decX + cellW / 2) / 2 + (i === 0 ? -22 : i === 2 ? 22 : 10)} y={(L.encY + L.decY + cellH) / 2 + 4} text-anchor="middle">{f(weights[i])}</text>
          </g>
        );
      })}
      <rect class="f-box f-fill-blue" x={L.decX} y={L.decY} width={cellW} height={cellH} rx="6" />
      <text class="f-math" x={L.decX + cellW / 2} y={L.decY + 23} text-anchor="middle">s</text>
      <text class="f-small f-t-muted" x={L.decX + cellW / 2} y={L.decY - 10} text-anchor="middle">decoder state ({s[0]}, {s[1]})</text>
      <path class="f-line f-green" d={`M ${L.decX + cellW + 4} ${L.decY + cellH / 2} H ${L.ctxX - 3}`} marker-end="url(#f-arrow-green)" />
      <text class="f-small f-t-green" x={(L.decX + cellW + L.ctxX) / 2} y={L.decY + cellH / 2 - 8} text-anchor="middle">Σ wᵢ hᵢ</text>
      <rect class="f-box f-fill-green" x={L.ctxX} y={L.decY} width={cellW + 10} height={cellH} rx="6" />
      <text class="f-math" x={L.ctxX + (cellW + 10) / 2} y={L.decY + 23} text-anchor="middle">c</text>
      <text class="f-small f-t-muted" x={L.ctxX + (cellW + 10) / 2} y={L.decY - 10} text-anchor="middle">context ({f(context[0])}, {f(context[1])})</text>
      <g font-family="var(--mono)">
        <text class="f-small" x={L.tableX} y={L.tableY + 16}>i    score   weight</text>
        {h.map((_, i) => (
          <text class="f-small" x={L.tableX} y={L.tableY + 38 + i * 20}>{i + 1}    {f(scores[i])}   {f(weights[i])}</text>
        ))}
        <text class="f-small f-t-muted" x={L.tableX} y={L.tableY + 38 + 3 * 20 + 4}>softmax: eˢ / Σ eˢ</text>
      </g>
    </svg>
  ))}
</Figure>
