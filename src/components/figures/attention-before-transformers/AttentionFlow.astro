---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Op from '../seqflow/Op.astro';
import Badge from '../seqflow/Badge.astro';
import Arrow from '../seqflow/Arrow.astro';
import Box from '../seqflow/Box.astro';
import NewMark from '../seqflow/NewMark.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import { fmt } from '../seqflow/tones';
import Sub from '../generative-modeling/Sub.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The worked example of the note: three encoder states and one decoder state, dot-product scores.
const H = [[1, 0], [0, 1], [1, 1]];
const s = [0.9, 0.2];
const e = H.map((h) => h[0] * s[0] + h[1] * s[1]);
const z = e.reduce((a, v) => a + Math.exp(v), 0);
const a = e.map((v) => Math.exp(v) / z);
const weighted = H.map((h, i) => h.map((v) => a[i] * v));
const c = [0, 1].map((k) => weighted.reduce((acc, w) => acc + w[k], 0));
if (a.map((v) => fmt(v)).join() !== '0.368,0.183,0.449' || c.map((v) => fmt(v)).join() !== '0.817,0.632')
  throw new Error('AttentionFlow: the worked example drifted from the note');
const t = ru
  ? { steps: ['оценить: sₜ · hᵢ для каждого i', 'нормировать: softmax → αᵢ', 'смешать: cₜ = Σ αᵢ hᵢ', 'предсказать по [sₜ; cₜ]'] }
  : { steps: ['score: sₜ · hᵢ for every i', 'normalize: softmax → αᵢ', 'mix: cₜ = Σ αᵢ hᵢ', 'predict from [sₜ; cₜ]'] };
const id = 'attention-flow';
const yH = 330, yScore = 314, yBus = 290, yBand = 250, yA = 214, yMul = 190, yW = 130, yPlus = 96;
const layouts = [
  { cls: 'fig-wide', W: 760, H: 450, cx: [80, 200, 320], sX: 600, plusX: 200, cX: 250, boxX: 350, boxW: 170, yX: 410, legend: [8, 436], step: 130, rows: 1 },
  { cls: 'fig-narrow seq-narrow', W: 380, H: 480, cx: [50, 150, 250], sX: 320, plusX: 150, cX: 190, boxX: 250, boxW: 126, yX: 288, legend: [8, 442], step: 180, rows: 2 },
];
---

<Figure
  id={id}
  title={ru ? 'Один шаг внимания: что куда идёт' : 'One attention step: what goes where'}
  caption={ru
    ? `Числа разобранного примера: три состояния энкодера и состояние декодера s = (0.9, 0.2). Состояние декодера сравнивается скалярным произведением с каждым состоянием энкодера (1), softmax превращает оценки в веса ${a.map((v) => fmt(v)).join(', ')} (2), контекст — взвешенная сумма состояний энкодера, (${c.map((v) => fmt(v)).join(', ')}) (3), и следующее слово предсказывается по состоянию декодера вместе с контекстом (4). Новое по сравнению с seq2seq: вместо одного s₀ в начале декодер на каждом шаге заново смешивает все состояния энкодера.`
    : `The numbers of the worked example: three encoder states and the decoder state s = (0.9, 0.2). The decoder state is compared with every encoder state by a dot product (1), a softmax turns the scores into the weights ${a.map((v) => fmt(v)).join(', ')} (2), the context is the weighted sum of the encoder states, (${c.map((v) => fmt(v)).join(', ')}) (3), and the next word is predicted from the decoder state together with the context (4). New compared with seq2seq: instead of one s₀ at the start, the decoder mixes all encoder states afresh at every step.`}
>
  {layouts.map((L) => {
    const narrow = L.cls.includes('narrow');
    const left = L.cx[0] - 40, right = L.cx[2] + 40;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Оценки, веса и контекст для трёх состояний' : 'Scores, weights and context for three states'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? `Оценки ${e.map((v) => fmt(v, 1)).join(', ')}; веса ${a.map((v) => fmt(v)).join(', ')}; контекст (${c.map((v) => fmt(v)).join(', ')}).`
          : `Scores ${e.map((v) => fmt(v, 1)).join(', ')}; weights ${a.map((v) => fmt(v)).join(', ')}; context (${c.map((v) => fmt(v)).join(', ')}).`}</desc>
        <NewMark x={left - 6} y={yW - 10} w={right - left + 12} h={yH + 47 - (yW - 10)} />
        {H.map((h, i) => (
          <Vec x={L.cx[i] - 22} y={yH} values={h.map(String)} tone="h" cw={44} label={`h_${i + 1}`} labelPos="below" />
        ))}
        <Vec x={L.sX} y={yH} values={s.map(String)} tone="h" cw={44} bold label="s_t" labelPos="below" />
        <g data-s="1">
          <path class="f-line f-blue f-dash" d={`M ${L.sX + 22} ${yH} V ${yBus} H ${left}`} />
          {H.map((h, i) => (
            <g>
              <Arrow pts={[[L.cx[i] + 26, yBus], [L.cx[i] + 26, yScore - 12]]} tone="blue" />
              <Arrow pts={[[L.cx[i] - 6, yH], [L.cx[i] - 6, yScore + 4]]} />
              <text class="f-small" x={L.cx[i]} y={yScore} text-anchor="middle">{`${narrow ? '' : 's·h = '}${fmt(e[i], 1)}`}</text>
            </g>
          ))}
          <Badge x={left + 2} y={yScore - 4} n={1} />
        </g>
        <g data-s="2">
          {H.map((_, i) => <Arrow pts={[[L.cx[i], yScore - 14], [L.cx[i], yBand + 26]]} />)}
          <rect x={left} y={yBand} width={right - left} height="24" rx="12" style="fill: var(--paper); stroke: var(--ink); stroke-width: 1.4" />
          <text class="f-label" x={(left + right) / 2} y={yBand + 17} text-anchor="middle">softmax</text>
          {H.map((_, i) => (
            <g>
              <Arrow pts={[[L.cx[i], yBand], [L.cx[i], yA + 24]]} tone="amber" />
              <Vec x={L.cx[i] - 26} y={yA} values={[fmt(a[i])]} tone="g" cw={52} />
            </g>
          ))}
          <Badge x={left - 2} y={yBand - 8} n={2} />
        </g>
        <g data-s="3">
          {H.map((h, i) => (
            <g>
              <Arrow pts={[[L.cx[i], yA], [L.cx[i], yMul + 13]]} tone="amber" />
              <text class="f-math f-t-blue" x={L.cx[i] - 17} y={yMul + 6} text-anchor="end"><Sub label={`h_${i + 1}`} /></text>
              <Op x={L.cx[i]} y={yMul} sym="×" />
              <Arrow pts={[[L.cx[i], yMul - 13], [L.cx[i], yW + 46]]} />
              <Vec x={L.cx[i] - 26} y={yW} values={weighted[i].map((v) => fmt(v))} tone="h" cw={52} />
              <Arrow pts={[[L.cx[i], yW], [L.plusX + (i - 1) * 9, yPlus + 13]]} />
            </g>
          ))}
          <Op x={L.plusX} y={yPlus} sym="+" />
          <Arrow pts={[[L.plusX + 13, yPlus], [L.cX - 2, yPlus]]} tone="blue" bold />
          <Vec x={L.cX} y={yPlus - 22} values={c.map((v) => fmt(v))} tone="h" cw={52} bold label="c_t" labelPos="above" />
          <Badge x={L.plusX - 22} y={yPlus - 18} n={3} />
        </g>
        <g data-s="4">
          <Arrow pts={[[L.cX + 52, yPlus], [L.boxX - 2, yPlus]]} tone="blue" bold />
          <Box x={L.boxX} y={yPlus - 18} w={L.boxW} h={36} label="W_o [s_t; c_t]" tone="n" math />
          {L.sX + 22 < L.boxX + L.boxW
            ? <Arrow pts={[[L.sX + 22, yBus], [L.sX + 22, yPlus + 22]]} tone="blue" />
            : <Arrow pts={[[L.sX + 22, yBus], [L.sX + 22, yPlus], [L.boxX + L.boxW + 2, yPlus]]} tone="blue" />}
          <Arrow pts={[[L.yX + 25, yPlus - 18], [L.yX + 25, 66]]} />
          <Op x={L.yX + 25} y={52} sym="softmax" />
          <Arrow pts={[[L.yX + 25, 39], [L.yX + 25, 30]]} />
          <Vec x={L.yX} y={6} values={['']} tone="y" cw={50} label="y_t" labelPos="left" />
          <Badge x={L.boxX + L.boxW - 4} y={yPlus - 18} n={4} />
        </g>
        <Legend x={L.legend[0]} y={L.legend[1]} step={L.step} rows={L.rows} />
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
