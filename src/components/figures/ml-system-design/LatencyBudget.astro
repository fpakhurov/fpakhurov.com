---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The latency budget of the fraud check. Stages in milliseconds (median, p99), measured on a prototype
// (illustrative). Each stage starts where the previous stage's p99 ends, which is the pessimistic sum.
const Z99 = 2.3263479;                      // standard normal 0.99 quantile
const Z3 = 2.7119428;                       // standard normal quantile at 0.99^(1/3)
const Z50_3 = 0.8211;                       // standard normal quantile at 0.5^(1/3)
const sigma = Math.log(20 / 4) / Z99;
const fanP99 = 4 * Math.exp(sigma * Z3);    // p99 of the slowest of three log-normal lookups
const fanP50 = 4 * Math.exp(sigma * Z50_3); // median of the slowest of three
if (Math.abs(sigma - 0.692) > 5e-4) throw new Error(`sigma ${sigma}`);
if (fanP99.toFixed(1) !== '26.1') throw new Error(`fan-out p99 ${fanP99}`);
if (Math.abs(1 - 0.99 ** 3 - 0.0297) > 5e-5) throw new Error('fan-out tail probability');
const stages = [
  { en: 'network', ru: 'сеть', p50: 2, p99: 5 },
  { en: '3 lookups', ru: '3 запроса', p50: fanP50, p99: fanP99, each: { p50: 4, p99: 20 } },
  { en: 'model', ru: 'модель', p50: 3, p99: 8 },
  { en: 'rules', ru: 'правила', p50: 1, p99: 3 },
];
const starts: number[] = [];
{ let s = 0; for (const st of stages) { starts.push(s); s += st.p99; } }
const sumP99 = stages.reduce((s, x) => s + x.p99, 0);
if (sumP99.toFixed(1) !== '42.1') throw new Error(`sum of p99 ${sumP99}`);
// End to end, from the simulation with a million requests in the note.
const E2E = { p50: 13.7, p99: 33.0 };
const BUDGET = 50;
if (!(E2E.p99 < sumP99 && sumP99 < BUDGET)) throw new Error('order of totals');

const ms = ru ? 'мс' : 'ms';
const fmt = (v: number) => (Number.isInteger(v) ? String(v) : v.toFixed(1));
const t = ru
  ? { total: 'итого', budget: `бюджет ${BUDGET} ${ms}`, median: 'медиана', p99: 'до p99',
      fan: `p99 самого медленного: ${fmt(fanP99)} ${ms}`, fanN: fmt(fanP99),
      e2e50: `p50 ${fmt(E2E.p50)}`, e2e99: `p99 ${fmt(E2E.p99)}`, sum: `сумма p99 ${fmt(sumP99)}`, axis: 'миллисекунды',
      steps: ['сетевой переход: медиана 2 мс, p99 5 мс', 'три запроса признаков параллельно: этап ждёт самого медленного, p99 26.1 мс вместо 20', 'модель: 3 мс и 8 мс', 'правила и ответ: 1 мс и 3 мс', 'итог по моделированию: p99 33.0 мс, меньше суммы p99 этапов (42.1 мс); оба в бюджете 50 мс'] }
  : { total: 'total', budget: `budget ${BUDGET} ${ms}`, median: 'median', p99: 'up to p99',
      fan: `p99 of the slowest: ${fmt(fanP99)} ${ms}`, fanN: fmt(fanP99),
      e2e50: `p50 ${fmt(E2E.p50)}`, e2e99: `p99 ${fmt(E2E.p99)}`, sum: `sum of p99s ${fmt(sumP99)}`, axis: 'milliseconds',
      steps: ['the network hop: median 2 ms, p99 5 ms', 'three lookups in parallel: the stage waits for the slowest, p99 26.1 ms rather than 20', 'the model: 3 ms and 8 ms', 'rules and the response: 1 ms and 3 ms', 'end to end, simulated: p99 33.0 ms, below the sum of the stage p99s (42.1 ms); both inside the 50 ms budget'] };
const name = (i: number) => (ru ? stages[i].ru : stages[i].en);
const blue = toneVar.h, red = toneVar.y;

interface Layout {
  cls: string; W: number; H: number; x0: number; x1: number; rowY: number[]; barH: number; lookH: number; lookGap: number;
  nameX: number | null; nameDy: number; totalY: number; axisY: number; small: number; label: number; wide: boolean;
}
const layouts: Layout[] = [
  { cls: 'fig-wide fig-bp-640', W: 760, H: 318, x0: 150, x1: 728, rowY: [56, 92, 142, 178], barH: 16, lookH: 8, lookGap: 3,
    nameX: 140, nameDy: 0, totalY: 226, axisY: 276, small: 6.5, label: 7.5, wide: true },
  { cls: 'fig-narrow seq-narrow fig-bp-640', W: 360, H: 346, x0: 20, x1: 336, rowY: [52, 104, 160, 210], barH: 14, lookH: 6, lookGap: 3,
    nameX: null, nameDy: -7, totalY: 262, axisY: 302, small: 7.3, label: 8.0, wide: false },
];
const geo = layouts.map((L) => {
  const x = (v: number) => L.x0 + (v / BUDGET) * (L.x1 - L.x0);
  // Value labels after the p99 end of each stage.
  const valueText = (i: number) => (i === 1 ? (L.wide ? t.fan : t.fanN) : L.wide ? `p99 ${fmt(stages[i].p99)} ${ms}` : fmt(stages[i].p99));
  stages.forEach((_, i) => {
    const endX = x(starts[i] + stages[i].p99) + 6;
    if (endX + valueText(i).length * L.small > L.x1 - 2) throw new Error(`value label ${i} at ${L.W}`);
    if (L.nameX !== null && L.nameX - name(i).length * L.label < 34) throw new Error(`name ${i} at ${L.W}`);
  });
  // The three markers of the total row must not overlap: p50 and p99 above, the sum below on narrow.
  const half = (s: string) => (s.length * L.small) / 2;
  if (x(E2E.p50) + half(t.e2e50) > x(E2E.p99) - half(t.e2e99) - 4) throw new Error('p50 and p99 labels overlap');
  if (L.wide && x(E2E.p99) + half(t.e2e99) > x(sumP99) - half(t.sum) - 4) throw new Error('p99 and sum labels overlap');
  if (x(sumP99) + half(t.sum) > L.W - 4) throw new Error('sum label off the right edge');
  if (L.x1 - t.budget.length * L.small < L.x0) throw new Error('budget label');
  return { x, valueText };
});
const ticks = [0, 10, 20, 30, 40, 50];
const id = 'latency-budget';
---

<Figure
  id={id}
  title={ru ? 'Бюджет задержки проверки платежа' : 'The latency budget of the fraud check'}
  caption={ru
    ? 'Каждый этап начинается там, где кончается p99 предыдущего; тёмная часть полосы — медиана, светлая — до p99 (значения условные, с прототипа). Сеть (1); три запроса признаков параллельно (2), этап ждёт самого медленного, поэтому его p99 — 26.1 мс, а не 20; модель (3); правила и ответ (4). Сумма p99 этапов — 42.1 мс, а p99 всей проверки по моделированию миллиона запросов — 33.0 мс, медиана 13.7 мс (5): медленные хвосты независимых этапов редко совпадают. Красная линия — бюджет 50 мс от страницы оформления заказа.'
    : 'Each stage starts where the p99 of the previous stage ends; the dark part of a bar is the median, the light part runs to p99 (illustrative values from a prototype). The network (1); three feature lookups in parallel (2), where the stage waits for the slowest, so its p99 is 26.1 ms rather than 20; the model (3); rules and the response (4). The stage p99s add up to 42.1 ms, while the p99 of the whole check, from a simulation of a million requests, is 33.0 ms with a median of 13.7 ms (5): the slow tails of independent stages rarely coincide. The red line is the 50 ms budget given by the checkout page.'}
>
  {layouts.map((L, li) => {
    const g = geo[li];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Этапы проверки на оси времени и бюджет 50 мс' : 'The stages of the check on a time axis, and the 50 ms budget'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Ось от 0 до 50 миллисекунд. Полосы друг за другом: сеть до 5 мс; три параллельных запроса, самый медленный до 31.1 мс; модель до 39.1 мс; правила до 42.1 мс. Строка «итого»: медиана 13.7 мс, p99 33.0 мс, отметка суммы p99 на 42.1 мс. Вертикальная красная линия на 50 мс — бюджет.'
          : 'An axis from 0 to 50 milliseconds. Bars one after another: network to 5 ms; three parallel lookups, the slowest ending at 31.1 ms; the model to 39.1 ms; rules to 42.1 ms. A total row: median 13.7 ms, p99 33.0 ms, and a mark for the sum of p99s at 42.1 ms. A vertical red line at 50 ms is the budget.'}</desc>
        {ticks.map((v) => <line class="f-grid" x1={g.x(v)} x2={g.x(v)} y1={L.rowY[0] - 14} y2={L.axisY} />)}
        <line class="f-axis" x1={L.x0} x2={L.x1} y1={L.axisY} y2={L.axisY} />
        {ticks.map((v) => <text class="f-small f-t-muted" x={g.x(v)} y={L.axisY + 16} text-anchor="middle">{v}</text>)}
        <text class="f-small f-t-muted" x={L.x1} y={L.axisY + 34} text-anchor="end">{t.axis}</text>
        <g>
          <rect x={L.wide ? L.x0 : L.x0} y={L.wide ? 18 : 14} width="14" height="10" style={`fill: ${blue}; fill-opacity: 0.75`} />
          <text class="f-small f-t-muted" x={L.x0 + 20} y={L.wide ? 27 : 23}>{t.median}</text>
          <rect x={L.x0 + (L.wide ? 90 : 96)} y={L.wide ? 18 : 14} width="14" height="10" style={`fill: ${blue}; fill-opacity: 0.22`} />
          <text class="f-small f-t-muted" x={L.x0 + (L.wide ? 110 : 116)} y={L.wide ? 27 : 23}>{t.p99}</text>
        </g>
        {stages.map((st, i) => {
          const y = L.rowY[i], s = starts[i];
          const nameY = L.nameX !== null ? y + L.barH / 2 + 4.5 : y + L.nameDy;
          const bars = i === 1
            ? [0, 1, 2].map((k) => ({ y: y + k * (L.lookH + L.lookGap), h: L.lookH, p50: 4, p99: 20 }))
            : [{ y, h: L.barH, p50: st.p50, p99: st.p99 }];
          const endX = g.x(s + st.p99);
          const labelY = i === 1 ? y + (3 * L.lookH + 2 * L.lookGap) / 2 + 4.5 : y + L.barH / 2 + 4.5;
          return (
            <g data-s={String(i + 1)}>
              <text class={L.wide ? 'f-label' : 'f-small'} x={L.nameX ?? L.x0} y={nameY} text-anchor={L.nameX !== null ? 'end' : 'start'}>{name(i)}</text>
              {bars.map((b) => (
                <g>
                  <rect x={g.x(s)} y={b.y} width={g.x(s + b.p99) - g.x(s)} height={b.h} style={`fill: ${blue}; fill-opacity: 0.22`} />
                  <rect x={g.x(s)} y={b.y} width={g.x(s + b.p50) - g.x(s)} height={b.h} style={`fill: ${blue}; fill-opacity: 0.75`} />
                </g>
              ))}
              {i === 1 && <line class="f-line" x1={endX} x2={endX} y1={y - 4} y2={y + 3 * L.lookH + 2 * L.lookGap + 4} style={`stroke: ${blue}; stroke-width: 2.2`} />}
              <text class="f-small" x={endX + 6} y={labelY} style={i === 1 ? 'font-weight: 650' : ''}>{g.valueText(i)}</text>
            </g>
          );
        })}
        <g data-s="5">
          <text class={L.wide ? 'f-label' : 'f-small'} x={L.nameX ?? L.x0} y={L.nameX !== null ? L.totalY + L.barH / 2 + 4.5 : L.totalY + L.nameDy} text-anchor={L.nameX !== null ? 'end' : 'start'} style="font-weight: 650">{t.total}</text>
          <rect x={g.x(0)} y={L.totalY} width={g.x(E2E.p99) - g.x(0)} height={L.barH} style={`fill: ${blue}; fill-opacity: 0.22`} />
          <rect x={g.x(0)} y={L.totalY} width={g.x(E2E.p50) - g.x(0)} height={L.barH} style={`fill: ${blue}; fill-opacity: 0.75`} />
          <text class="f-small" x={g.x(E2E.p50)} y={L.totalY + L.barH + 16} text-anchor="middle">{t.e2e50}</text>
          <text class="f-small" x={g.x(E2E.p99)} y={L.totalY + L.barH + 16} text-anchor="middle" style="font-weight: 650">{t.e2e99}</text>
          <line x1={g.x(sumP99)} x2={g.x(sumP99)} y1={L.totalY - 3} y2={L.totalY + L.barH + 3} class="f-line f-muted f-dash" />
          <text class="f-small f-t-muted" x={g.x(sumP99)} y={L.wide ? L.totalY + L.barH + 16 : L.totalY - 8} text-anchor="middle">{t.sum}</text>
        </g>
        <g data-s="5">
          <line class="f-line f-red f-dash" x1={g.x(BUDGET)} x2={g.x(BUDGET)} y1={L.rowY[0] - 14} y2={L.axisY} />
          <text class="f-small f-t-red" x={g.x(BUDGET) - 4} y={L.rowY[0] - 18} text-anchor="end" style="font-weight: 650">{t.budget}</text>
        </g>
        {stages.map((_, i) => (
          <g data-s={String(i + 1)}><Badge x={L.wide ? 20 : L.x0 + name(i).length * L.small + 14} y={L.wide ? L.rowY[i] + (i === 1 ? 15 : L.barH / 2) : L.rowY[i] + L.nameDy - 5} n={i + 1} /></g>
        ))}
        <g data-s="5"><Badge x={L.wide ? 20 : L.x0 + t.total.length * L.small + 14} y={L.wide ? L.totalY + L.barH / 2 : L.totalY + L.nameDy - 5} n={5} /></g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
