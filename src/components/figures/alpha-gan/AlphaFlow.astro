---
import Figure from '../Figure.astro';
import {pageLang} from '../../../utils/lang';
import data from './cases.json';
// Original finite probability table, not a source model-architecture drawing.
const ru=pageLang(Astro.url)==='ru';
const id='alpha-gan-flow';
const layouts=[{cls:'fig-wide',w:760,h:248,left:28,cell:142},{cls:'fig-narrow',w:360,h:248,left:10,cell:68}];
const headers=ru?['Код z','p(z)','q(z)','C: π=½','C: π=⅓']:['Code z','p(z)','q(z)','C: π=½','C: π=⅓'];
---
<Figure id={id}
 title={ru?'Один набор кодов, две доли классов':'One code distribution, two class weights'}
 caption={ru?'p — равномерное априорное распределение; q — агрегированные коды датчика. π — вес положительного класса p. Таблица показывает точный оптимум классификатора; поправка (1−π)/π восстанавливает отношение p/q.':'p is the uniform prior; q is the sensor’s aggregate code distribution. π is the positive prior-class weight. The table shows the exact classifier optimum; the correction (1−π)/π recovers p/q.'}>
 {layouts.map(l=><svg class={l.cls} viewBox={`0 0 ${l.w} ${l.h}`} role="img" aria-labelledby={`${id}-${l.w}-title ${id}-${l.w}-desc`}>
  <title id={`${id}-${l.w}-title`}>{ru?'Вероятности и оптимальный классификатор кодов':'Code probabilities and optimal classifiers'}</title>
  <desc id={`${id}-${l.w}-desc`}>{ru?'Априорные вероятности равны одной трети. Агрегированные: одна вторая, одна шестая, одна третья. C при равных весах: две пятых, две трети, одна вторая. При π равном одной трети: одна четвертая, одна вторая, одна третья.':'Prior probabilities are all one third. Aggregate: one half, one sixth, one third. Equal-class C: two fifths, two thirds, one half. C with prior class weight one third: one quarter, one half, one third.'}</desc>
  {headers.map((header,j)=><text class="f-small f-t-muted" x={l.left+(j+.5)*l.cell} y={35} text-anchor="middle">{header}</text>)}
  {data.code_rows.map((row,i)=>{
   const y=53+i*51;const values=[row.z,row.prior,row.aggregate,row.equal_class_C,row.one_third_class_C];
   return <g>
    <line class="f-grid" x1={l.left} x2={l.left+5*l.cell} y1={y} y2={y}/>
    {values.map((value,j)=><text class={j===2?'f-label f-t-blue':j>=3?'f-label f-t-amber':'f-label'} x={l.left+(j+.5)*l.cell} y={y+32} text-anchor="middle">{value}</text>)}
   </g>;
  })}
  <text class="f-small f-t-muted" x={l.w/2} y={232} text-anchor="middle">{ru?'Различные C; одинаковое восстановленное p/q':'Different C; the same recovered p/q'}</text>
 </svg>)}
</Figure>
