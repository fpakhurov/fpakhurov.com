---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Op from '../seqflow/Op.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import Sub from '../generative-modeling/Sub.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The α-WGAN: encoder E, generator G, code critic C, image critic D, in the colours of the sequence-model figures:
// inputs (data x, prior noise z) green, codes blue, critics amber, generated images red.
// Row 1: x → E → ẑ → G → x̂ with the L1 loss back to x. Row 3: z → G → G(z). C sits between ẑ and z; D takes x̂, G(z) and real x.
const t = ru
  ? { data: 'данные', code: 'код', rec: 'реконструкция', noise: 'шум', sample: 'сэмпл', cc: 'критик кодов', ic: 'критик изображений', real: 'настоящий', fake: 'подделка',
      trains: 'обучает', eToo: '(и E — через x̂)',
      steps: ['E кодирует изображение x в код ẑ, G декодирует его в реконструкцию x̂; функция потерь λ‖x − x̂‖₁ обучает E и G', 'тот же G декодирует сэмпл z из априорного распределения в новое изображение G(z)', 'критик кодов C считает сэмплы z настоящими, а коды ẑ — подделкой; C обучается на своей функции потерь WGAN-GP, E — на −C(ẑ)', 'критик изображений D считает настоящими данные, а x̂ и G(z) — подделкой; D обучается на своей функции потерь WGAN-GP, G — на −D(x̂) − D(G(z))'] }
  : { data: 'data', code: 'code', rec: 'reconstruction', noise: 'noise', sample: 'sample', cc: 'code critic', ic: 'image critic', real: 'real', fake: 'fake',
      trains: 'trains', eToo: '(and E, through x̂)',
      steps: ['E encodes an image x into a code ẑ and G decodes it into a reconstruction x̂; the loss λ‖x − x̂‖₁ trains E and G', 'G also decodes a prior sample z into a new image G(z)', 'the code critic C scores prior samples z as real and codes ẑ as fake; C trains on its WGAN-GP loss, E on −C(ẑ)', 'the image critic D scores data as real and x̂, G(z) as fake; D trains on its WGAN-GP loss, G on −D(x̂) − D(G(z))'] };
const id = 'alpha-gan-flow';

// Geometry of the two layouts. Rows: r1 (encode–decode), rc (code critic), r3 (prior → sample); boxes are bh tall.
const layouts = [
  {
    cls: 'fig-wide', W: 760, H: 372, wide: true, bh: 50, r1: 80, rc: 187, r3: 300,
    x: [16, 96], E: 150, zh: [188, 104], G1: 336, xh: [386, 118], z: [188, 104], G3: 336, gz: [386, 118], C: [188, 104],
    dx: [580, 150], dy: 187, rx: [580, 150], ry: 80, l1Top: 36, l1Label: [254, 40],
    b1: [64, 152], b2: [170, 325], b3: [170, 212], b4: [744, 212], cNote: [306, 206], dNote: [578, 262],
  },
  {
    cls: 'fig-narrow seq-narrow', W: 360, H: 540, wide: false, bh: 50, r1: 56, rc: 176, r3: 296,
    x: [2, 58], E: 85, zh: [108, 58], G1: 190, xh: [214, 126], z: [97, 80], G3: 204, gz: [228, 92], C: [87, 100],
    dx: [196, 160], dy: 416, rx: [80, 100], ry: 416, l1Top: 14, l1Label: [154, 20],
    b1: [31, 126], b2: [80, 321], b3: [72, 201], b4: [64, 441], cNote: [196, 196], dNote: [150, 492],
  },
];
type L = (typeof layouts)[number];
const mid = (y: number, L: L) => y + L.bh / 2;
const right = (b: number[]) => b[0] + b[1];
const cx = (b: number[]) => b[0] + b[1] / 2;
---

<Figure
  id={id}
  title={ru ? 'α-WGAN: энкодер, генератор и два критика' : 'α-WGAN: an encoder, a generator and two critics'}
  caption={ru
    ? 'Зелёные — входы (данные x и шум z из априорного распределения), синие — коды, жёлтые — критики, красные — сгенерированные изображения. Функция потерь L1 требует, чтобы G(E(x)) возвращало x (1), и тот же G декодирует шум в новые изображения (2). Критик кодов C сравнивает коды ẑ = E(x) с сэмплами из априорного распределения (3), критик изображений D сравнивает данные с реконструкциями и сэмплами (4).'
    : 'Green: inputs (data x and prior noise z); blue: codes; amber: critics; red: generated images. The L1 loss asks G(E(x)) to return x (1), and the same G decodes noise into new images (2). The code critic C compares codes ẑ = E(x) with prior samples (3); the image critic D compares data with reconstructions and samples (4).'}
>
  {layouts.map((L) => {
    const y1 = mid(L.r1, L), y3 = mid(L.r3, L), yc = mid(L.rc, L), yd = mid(L.dy, L);
    const l1Path = `M ${cx(L.xh)} ${L.r1 - 2} C ${cx(L.xh)} ${L.l1Top}, ${cx(L.x)} ${L.l1Top}, ${cx(L.x)} ${L.r1 - 2}`;
    const subGap = L.wide ? 15 : 19;
    // Arrows from the reconstruction and the sample into D: diagonal in the wide layout, vertical in the narrow one.
    const recToD: [number, number][] = L.wide ? [[right(L.xh), L.r1 + 38], [L.dx[0] - 2, L.dy + 12]] : [[334, L.r1 + L.bh], [334, L.dy - 2]];
    const genToD: [number, number][] = L.wide ? [[right(L.gz), L.r3 + 12], [L.dx[0] - 2, L.dy + L.bh - 12]] : [[cx(L.gz), L.r3 + L.bh], [cx(L.gz), L.dy - 2]];
    const realToD: [number, number][] = L.wide ? [[cx(L.rx), L.ry + L.bh], [cx(L.rx), L.dy - 2]] : [[right(L.rx), yd], [L.dx[0] - 2, yd]];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Схема α-WGAN' : 'Wiring of the α-WGAN'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Верхний ряд: x, энкодер E, код ẑ, генератор G, реконструкция x̂, пунктирная L1-потеря от x̂ к x. Нижний ряд: шум z, тот же G, сэмпл G(z). Между ẑ и z — критик кодов C, получающий оба. Справа — критик изображений D, получающий x̂, G(z) и настоящие данные x.'
          : 'Top row: x, encoder E, code ẑ, generator G, reconstruction x̂, with a dashed L1 loss from x̂ back to x. Bottom row: noise z, the same G, sample G(z). Between ẑ and z sits the code critic C, which receives both. On the right the image critic D receives x̂, G(z) and real data x.'}</desc>

        <g data-s="1">
          <Box x={L.x[0]} y={L.r1} w={L.x[1]} h={L.bh} label="x" sub={t.data} tone="x" subGap={subGap} />
          <Arrow pts={[[right(L.x), y1], [L.E - 15, y1]]} />
          <Op x={L.E} y={y1} sym="E" />
          <Arrow pts={[[L.E + 13, y1], [L.zh[0] - 2, y1]]} />
          <Box x={L.zh[0]} y={L.r1} w={L.zh[1]} h={L.bh} label="ẑ" sub={t.code} tone="h" subGap={subGap} />
          <Arrow pts={[[right(L.zh), y1], [L.G1 - 15, y1]]} />
          <Op x={L.G1} y={y1} sym="G" />
          <Arrow pts={[[L.G1 + 13, y1], [L.xh[0] - 2, y1]]} />
          <Box x={L.xh[0]} y={L.r1} w={L.xh[1]} h={L.bh} label="x̂ = G(ẑ)" sub={t.rec} tone="y" subGap={subGap} />
          <path class="f-line f-red f-dash" d={l1Path} marker-end="url(#f-arrow-red)" />
          <text class="f-small f-t-red f-halo" x={L.l1Label[0]} y={L.l1Label[1]} text-anchor="middle">λ‖x − x̂‖₁</text>
        </g>

        <g data-s="2">
          <Box x={L.z[0]} y={L.r3} w={L.z[1]} h={L.bh} label="z ∼ p(z)" sub={t.noise} tone="x" subGap={subGap} />
          <Arrow pts={[[right(L.z), y3], [L.G3 - 15, y3]]} />
          <Op x={L.G3} y={y3} sym="G" />
          <Arrow pts={[[L.G3 + 13, y3], [L.gz[0] - 2, y3]]} />
          <Box x={L.gz[0]} y={L.r3} w={L.gz[1]} h={L.bh} label="G(z)" sub={t.sample} tone="y" subGap={subGap} />
        </g>

        <g data-s="3">
          <Arrow pts={[[cx(L.zh), L.r1 + L.bh], [cx(L.C), L.rc - 2]]} tone="amber" />
          <Arrow pts={[[cx(L.z), L.r3], [cx(L.C), L.rc + L.bh + 2]]} tone="amber" />
          <Box x={L.C[0]} y={L.rc} w={L.C[1]} h={L.bh} label="C" sub={t.cc} tone="g" subGap={subGap} />
          <text class="f-small f-t-muted" x={cx(L.C) + 6} y={(L.r1 + L.bh + L.rc) / 2 + 4}>{t.fake}</text>
          <text class="f-small f-t-muted" x={cx(L.C) + 6} y={(L.rc + L.bh + L.r3) / 2 + 4}>{t.real}</text>
          <text class="f-small f-t-amber" x={L.cNote[0]} y={L.cNote[1]}><Sub label={`L_C + GP ${t.trains} C`} /></text>
          <text class="f-small" x={L.cNote[0]} y={L.cNote[1] + 19}>{`−C(ẑ) ${t.trains} E`}</text>
        </g>

        <g data-s="4">
          <Box x={L.rx[0]} y={L.ry} w={L.rx[1]} h={L.bh} label="x ∼ P" sub={t.data} tone="x" subGap={subGap} />
          <Arrow pts={realToD} tone="amber" />
          <Arrow pts={recToD} tone="amber" />
          <Arrow pts={genToD} tone="amber" />
          <Box x={L.dx[0]} y={L.dy} w={L.dx[1]} h={L.bh} label="D" sub={t.ic} tone="g" subGap={subGap} />
          {L.wide && (
            <g>
              <text class="f-small f-t-muted" x={cx(L.rx) + 6} y={(L.ry + L.bh + L.dy) / 2 + 4}>{t.real}</text>
              <text class="f-small f-t-muted" x={552} y={150}>{t.fake}</text>
              <text class="f-small f-t-muted" x={540} y={262} text-anchor="end">{t.fake}</text>
            </g>
          )}
          <text class="f-small f-t-amber" x={L.dNote[0]} y={L.dNote[1]}><Sub label={`L_D + GP ${t.trains} D`} /></text>
          <text class="f-small" x={L.dNote[0]} y={L.dNote[1] + 19}>{`−D(x̂) − D(G(z)) ${t.trains} G`}</text>
          <text class="f-small f-t-muted" x={L.dNote[0]} y={L.dNote[1] + 38}>{t.eToo}</text>
        </g>

        <Badge x={L.b1[0]} y={L.b1[1]} n={1} />
        <Badge x={L.b2[0]} y={L.b2[1]} n={2} />
        <Badge x={L.b3[0]} y={L.b3[1]} n={3} />
        <Badge x={L.b4[0]} y={L.b4[1]} n={4} />
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
