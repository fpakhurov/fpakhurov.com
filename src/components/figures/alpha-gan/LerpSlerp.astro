---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { dim, pairs, ts, lerpPaths, slerpPaths, lerpMean, slerpMean, priorNorms, lerpMid, slerpMid, stats } from './interpolation';

const ru = pageLang(Astro.url) === 'ru';

// Norms along lerp and slerp paths between 400 pairs of independent N(0, I_128) samples, and a sideways histogram
// of the norms of prior samples and of the two kinds of midpoint, on the same vertical axis.
const f2 = (v: number) => v.toFixed(2);
const f0 = (v: number) => v.toFixed(0);
if (dim !== 128 || pairs !== 400) throw new Error('LerpSlerp: setup drifted from the note');
if (f2(stats.priorMean) !== '11.32' || f2(stats.lerpMidMean) !== '7.99' || f2(stats.slerpMidMean) !== '11.33') throw new Error('LerpSlerp: mean norms drifted from the note');
if (f2(stats.priorLo) !== '9.56' || f2(stats.priorHi) !== '12.87' || f2(stats.lerpMidMax) !== '9.31' || stats.lerpInside !== 0) throw new Error('LerpSlerp: the lerp midpoints are no longer outside the prior range');
if (f0(stats.angleMin) !== '75' || f0(stats.angleMax) !== '105') throw new Error('LerpSlerp: angle range drifted from the note');

const yr: [number, number] = [5.5, 14];
const binW = 0.25;
const nBins = Math.round((yr[1] - yr[0]) / binW);
const hist = (xs: number[]) => Array.from({ length: nBins }, (_, b) => xs.filter((r) => r >= yr[0] + b * binW && r < yr[0] + (b + 1) * binW).length / (xs.length * binW));
const hPrior = hist(priorNorms), hLerp = hist(lerpMid), hSlerp = hist(slerpMid);
const shown = 8; // individual paths drawn under the means

const t = ru
  ? { norm: 'длина ‖zₜ‖', tAxis: 't', lerp: 'lerp', slerp: 'slerp', band: '98% сэмплов N(0, I)', dens: 'плотность', prior: 'сэмплы N(0, I)', mids: 'середины, t = ½',
      lerpNote: `√(d/2) = 8`, slerpNote: `√d ≈ 11.3` }
  : { norm: 'length ‖zₜ‖', tAxis: 't', lerp: 'lerp', slerp: 'slerp', band: '98% of N(0, I) samples', dens: 'density', prior: 'N(0, I) samples', mids: 'midpoints, t = ½',
      lerpNote: `√(d/2) = 8`, slerpNote: `√d ≈ 11.3` };
const id = 'alpha-gan-lerp-slerp';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, aL: 64, aR: 430, hL: 490, hR: 740, T: 34, B: 280, wide: true },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 400, aL: 40, aR: 214, hL: 236, hR: 352, T: 40, B: 330, wide: false },
].map((o) => {
  const sx = scale([0, 1], [o.aL, o.aR]);
  const sy = scale(yr, [o.B, o.T]);
  const sh = scale([0, 0.9], [o.hL, o.hR]);
  const path = (ys: number[]) => polyline(ts.map((tt, j) => [sx(tt), sy(ys[j])]));
  const bars = (h: number[]) => h.map((v, b) => ({ x: o.hL, y: sy(yr[0] + (b + 1) * binW), w: sh(v) - o.hL, h: sy(yr[0]) - sy(yr[0] + binW) }));
  // Step outline of a sideways histogram.
  const steps = (h: number[]) => polyline(h.flatMap((v, b) => [[sh(v), sy(yr[0] + b * binW)], [sh(v), sy(yr[0] + (b + 1) * binW)]] as [number, number][]));
  return {
    ...o, sx, sy, sh,
    lerpThin: lerpPaths.slice(0, shown).map(path), slerpThin: slerpPaths.slice(0, shown).map(path),
    lerpBold: path(lerpMean), slerpBold: path(slerpMean),
    priorBars: bars(hPrior), lerpBars: bars(hLerp), slerpSteps: steps(hSlerp),
  };
});
---

<Figure
  id={id}
  title={ru ? 'Линейная интерполяция уходит внутрь оболочки, сферическая — нет' : 'Linear interpolation dips inside the shell; spherical interpolation does not'}
  caption={ru
    ? `${pairs} пар независимых сэмплов из N(0, I) в d = ${dim} измерениях. Слева — длина zₜ в зависимости от t: ${shown} пар тонкими линиями, среднее по всем парам жирной; зелёная полоса — центральные 98% длин сэмплов (от ${f2(stats.priorLo)} до ${f2(stats.priorHi)}). Справа — гистограммы длин сэмплов (среднее ${f2(stats.priorMean)}), середин lerp (${f2(stats.lerpMidMean)}) и середин slerp (${f2(stats.slerpMidMean)}). Ни одна середина lerp не достигает полосы.`
    : `${pairs} pairs of independent samples of N(0, I) in d = ${dim} dimensions. Left: the length of zₜ against t, ${shown} pairs thin and the mean over all pairs bold; the green band holds the central 98% of sample lengths (${f2(stats.priorLo)} to ${f2(stats.priorHi)}). Right: length histograms of the samples (mean ${f2(stats.priorMean)}), lerp midpoints (${f2(stats.lerpMidMean)}) and slerp midpoints (${f2(stats.slerpMidMean)}). No lerp midpoint reaches the band.`}
>
  {layouts.map((o) => (
    <svg class={o.cls} viewBox={`0 0 ${o.W} ${o.H}`} role="img" aria-labelledby={`${id}-${o.sfx}-t ${id}-${o.sfx}-d`}>
      <title id={`${id}-${o.sfx}-t`}>{ru ? 'Длина точки на пути lerp и slerp' : 'Length of the path point for lerp and slerp'}</title>
      <desc id={`${id}-${o.sfx}-d`}>{ru
        ? `Слева: средняя длина на пути slerp остаётся около ${f2(stats.slerpMidMean)} при всех t, а на пути lerp опускается до ${f2(stats.lerpMidMean)} при t = ½, ниже зелёной полосы типичных длин. Справа: гистограмма длин сэмплов и середин slerp лежит около 11.3, гистограмма середин lerp — около 8, без перекрытия.`
        : `Left: the mean length along slerp paths stays near ${f2(stats.slerpMidMean)} for every t, while along lerp paths it dips to ${f2(stats.lerpMidMean)} at t = ½, below the green band of typical lengths. Right: the histogram of sample lengths and of slerp midpoints sits near 11.3, that of lerp midpoints near 8, with no overlap.`}</desc>

      <!-- Left: length along the path -->
      <rect x={o.aL} y={o.sy(stats.priorHi)} width={o.aR - o.aL} height={o.sy(stats.priorLo) - o.sy(stats.priorHi)} class="f-fill-green" />
      <text class="f-small f-t-green" x={o.aR - 6} y={o.sy(stats.priorHi) + 15} text-anchor="end">{o.wide ? t.band : '98%'}</text>
      {[6, 8, 10, 12, 14].map((v) => <line class="f-grid" x1={o.aL} x2={o.aR} y1={o.sy(v)} y2={o.sy(v)} />)}
      {[6, 8, 10, 12, 14].map((v) => <text class="f-note" x={o.aL - 8} y={o.sy(v) + 5} text-anchor="end">{v}</text>)}
      <path class="f-axis" d={`M ${o.aL} ${o.B} H ${o.aR}`} />
      {(o.wide ? [0, 0.25, 0.5, 0.75, 1] : [0, 0.5, 1]).map((v) => <text class="f-note" x={o.sx(v)} y={o.B + 20} text-anchor="middle">{v}</text>)}
      <text class="f-math" x={(o.aL + o.aR) / 2} y={o.B + 44} text-anchor="middle">{t.tAxis}</text>
      <text class="f-small f-t-muted" x={o.aL - 8} y={o.T - 14} text-anchor="start">{t.norm}</text>
      {o.lerpThin.map((d) => <path class="f-thin f-red" d={d} style="opacity: 0.35" />)}
      {o.slerpThin.map((d) => <path class="f-thin f-blue" d={d} style="opacity: 0.35" />)}
      <path class="f-line f-red f-bold" d={o.lerpBold} />
      <path class="f-line f-blue f-bold" d={o.slerpBold} />
      <text class="f-label f-t-blue f-halo" x={o.sx(0.5)} y={o.sy(stats.slerpMidMean) - 10} text-anchor="middle">{`${t.slerp}${o.wide ? ': ' + t.slerpNote : ''}`}</text>
      <text class="f-label f-t-red f-halo" x={o.sx(0.5)} y={o.sy(stats.lerpMidMean) + 24} text-anchor="middle">{`${t.lerp}${o.wide ? ': ' + t.lerpNote : ''}`}</text>

      <!-- Right: sideways histograms on the same vertical axis -->
      {[6, 8, 10, 12, 14].map((v) => <line class="f-grid" x1={o.hL} x2={o.hR} y1={o.sy(v)} y2={o.sy(v)} />)}
      {o.priorBars.map((r) => <rect x={r.x} y={r.y + 0.5} width={r.w} height={r.h - 1} style="fill: var(--fig-green); fill-opacity: 0.4" />)}
      {o.lerpBars.map((r) => <rect x={r.x} y={r.y + 0.5} width={r.w} height={r.h - 1} style="fill: var(--fig-red); fill-opacity: 0.45" />)}
      <path class="f-line f-blue" d={o.slerpSteps} />
      <path class="f-axis" d={`M ${o.hL} ${o.B} V ${o.T}`} />
      <path class="f-axis" d={`M ${o.hL} ${o.B} H ${o.hR}`} />
      {[0, 0.4, 0.8].map((v) => <text class="f-note" x={o.sh(v)} y={o.B + 20} text-anchor="middle">{v}</text>)}
      <text class="f-small f-t-muted" x={(o.hL + o.hR) / 2} y={o.B + 44} text-anchor="middle">{t.dens}</text>
      <text class="f-small f-t-green f-halo" x={o.hR} y={o.sy(13.8)} text-anchor="end">{o.wide ? t.prior : 'N(0, I)'}</text>
      <text class="f-small f-t-blue f-halo" x={o.hR} y={o.sy(13.2)} text-anchor="end">{o.wide ? `slerp: ${t.mids}` : 'slerp, t = ½'}</text>
      <text class="f-small f-t-red f-halo" x={o.hR} y={o.sy(6.4)} text-anchor="end">{o.wide ? `lerp: ${t.mids}` : 'lerp, t = ½'}</text>
    </svg>
  ))}
</Figure>
