---
import Figure from '../Figure.astro';
import {pageLang} from '../../../utils/lang';
import data from './cases.json';
// Original explicit 3D endpoints; all paths are saved standard-library results.
const ru=pageLang(Astro.url)==='ru';
const id='alpha-gan-lerp-slerp';
const layouts=[{cls:'fig-wide',w:760,h:310,panels:[{x:52,y:58,w:290,h:175},{x:438,y:58,w:290,h:175}]},{cls:'fig-narrow',w:360,h:558,panels:[{x:42,y:55,w:296,h:170},{x:42,y:322,w:296,h:170}]}];
const definitions=[{title:ru?'Оба радиуса равны 3':'Both radii equal 3',series:[{key:'linear_norm',label:'lerp',tone:'red'},{key:'arc_norm',label:ru?'сферический путь':'spherical path',tone:'blue'}],ticks:[1,2,3],lo:1,hi:3.2},{title:ru?'Радиусы 3 и 6':'Radii 3 and 6',series:[{key:'unequal_naive_norm',label:ru?'те же коэффициенты':'same coefficients',tone:'amber'},{key:'unequal_radial_norm',label:ru?'направление + радиус':'direction + radius',tone:'green'}],ticks:[3,4,5,6],lo:2.8,hi:6.2}];
---
<Figure id={id}
 title={ru?'Радиус зависит от определения пути':'Radius depends on the path definition'}
 caption={ru?'Явные векторы u=(2,−1,2) и v=(−2,2,1); справа второй конец 2v. Слева сравниваются линейный и сферический пути. Справа те же синусные коэффициенты сравниваются с интерполяцией единичных направлений и линейным радиусом. Это геометрия, без генерации изображений.':'Explicit vectors u=(2,−1,2) and v=(−2,2,1); the right panel uses endpoint 2v. Left: linear and spherical paths. Right: the same sine coefficients versus unit-direction interpolation with a linear radius. These are geometric calculations, without image generation.'}>
 {layouts.map(l=><svg class={l.cls} viewBox={`0 0 ${l.w} ${l.h}`} role="img" aria-labelledby={`${id}-${l.w}-title ${id}-${l.w}-desc`}>
  <title id={`${id}-${l.w}-title`}>{ru?'Нормы четырёх явных путей':'Norms of four explicit paths'}</title>
  <desc id={`${id}-${l.w}-desc`}>{ru?'При одинаковых радиусах линейная середина имеет норму 1.581139, сферическая 3. При разных радиусах неизмененные синусные коэффициенты дают 5.108816, отдельный линейный радиус дает 4.5.':'With equal radii, the linear midpoint norm is 1.581139 and spherical norm is 3. With unequal radii, unchanged sine coefficients give 5.108816; a separately interpolated radius gives 4.5.'}</desc>
  {l.panels.map((p,k)=>{
   const d=definitions[k];const sx=(t:number)=>p.x+p.w*t;const sy=(v:number)=>p.y+p.h*(d.hi-v)/(d.hi-d.lo);
   return <g>
    <text class="f-label" x={p.x+p.w/2} y={p.y-25} text-anchor="middle">{d.title}</text>
    {d.ticks.map(v=><g><line class="f-grid" x1={p.x} x2={p.x+p.w} y1={sy(v)} y2={sy(v)}/><text class="f-note" x={p.x-10} y={sy(v)+4} text-anchor="end">{v}</text></g>)}
    <path class="f-axis" d={`M ${p.x} ${p.y} V ${p.y+p.h} H ${p.x+p.w}`}/>
    {[0,.5,1].map(v=><text class="f-note" x={sx(v)} y={p.y+p.h+19} text-anchor="middle">{v}</text>)}
    <text class="f-small f-t-muted" x={p.x+p.w+10} y={p.y+p.h+19}>t</text>
    {d.series.map((s,j)=>{
     const points=data.interpolation.paths.map(row=>`${sx(row.t)},${sy(row[s.key as keyof typeof row])}`).join(' ');
     return <g><polyline class={`f-line f-${s.tone}`} points={points}/><text class={`f-small f-t-${s.tone}`} x={p.x+4} y={p.y+p.h+42+j*18}>{s.label}</text></g>;
    })}
   </g>;
  })}
 </svg>)}
</Figure>
