---
import BlockDiagram, { type DLayout } from '../BlockDiagram.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Stable Diffusion at 512×512: training in the latent space of a fixed autoencoder, and generation.
const t = ru
  ? { x: 'изображение', xs: '512×512×3', e: 'энкодер E', es: '÷8 по стороне', z: 'латент z₀', zs: '64×64×4', n: 'шум', ns: 'до шага t', u: 'U-Net', us: 'предсказывает шум', p: 'промпт', ps: 'текст', te: 'энкодер текста', tes: '77 векторов', zt: 'чистый шум', zts: 'N(0, I), шаг T', l: 'U-Net + шедулер', ls: '20–50 шагов, CFG', z0: 'z₀', z0s: '64×64×4', d: 'декодер D', ds: '×8 по стороне', xh: 'изображение', xhs: '512×512×3', ca: 'cross-attention', train: 'обучение', gen: 'генерация' }
  : { x: 'image', xs: '512×512×3', e: 'encoder E', es: '÷8 per side', z: 'latent z₀', zs: '64×64×4', n: 'add noise', ns: 'up to step t', u: 'U-Net', us: 'predicts the noise ε', p: 'prompt', ps: 'text', te: 'text encoder', tes: '77 vectors', zt: 'pure noise', zts: 'N(0, I), step T', l: 'U-Net + scheduler', ls: '20–50 steps, CFG', z0: 'z₀', z0s: '64×64×4', d: 'decoder D', ds: '×8 per side', xh: 'image', xhs: '512×512×3', ca: 'cross-attention', train: 'training', gen: 'generation' };
const desc = ru
  ? 'Обучение: изображение 512×512 кодируется энкодером в латент 64×64×4, к нему добавляется шум, и U-Net учится предсказывать этот шум, получая текст через cross-attention. Генерация: латент из нормального шума проходит 20–50 шагов U-Net с шедулером и classifier-free guidance, а декодер переводит результат в изображение.'
  : 'Training: a 512×512 image is encoded into a 64×64×4 latent, noise is added, and a U-Net learns to predict that noise, receiving the text through cross-attention. Generation: a latent drawn from normal noise goes through 20–50 U-Net steps with a scheduler and classifier-free guidance, and the decoder turns the result into an image.';
const col = (i: number) => 12 + i * 152;
const wide: DLayout = {
  cls: 'fig-wide', w: 772, h: 316, desc,
  nodes: [
    { id: 'x', x: col(0), y: 34, w: 140, h: 50, label: t.x, sub: t.xs, tone: 'soft' },
    { id: 'e', x: col(1), y: 34, w: 140, h: 50, label: t.e, sub: t.es, tone: 'amber' },
    { id: 'z', x: col(2), y: 34, w: 140, h: 50, label: t.z, sub: t.zs, tone: 'soft' },
    { id: 'n', x: col(3), y: 34, w: 140, h: 50, label: t.n, sub: t.ns },
    { id: 'u', x: col(4), y: 34, w: 140, h: 50, label: t.u, sub: t.us, tone: 'blue' },
    { id: 'p', x: col(2), y: 138, w: 140, h: 44, label: t.p, sub: t.ps, tone: 'soft' },
    { id: 'te', x: col(3), y: 138, w: 140, h: 44, label: t.te, sub: t.tes, tone: 'green' },
    { id: 'zt', x: col(0), y: 250, w: 140, h: 50, label: t.zt, sub: t.zts, tone: 'soft' },
    { id: 'l', x: col(1), y: 250, w: 140, h: 50, label: t.l, sub: t.ls, tone: 'blue' },
    { id: 'z0', x: col(2), y: 250, w: 140, h: 50, label: t.z0, sub: t.z0s, tone: 'soft' },
    { id: 'd', x: col(3), y: 250, w: 140, h: 50, label: t.d, sub: t.ds, tone: 'amber' },
    { id: 'xh', x: col(4), y: 250, w: 140, h: 50, label: t.xh, sub: t.xhs, tone: 'soft' },
  ],
  edges: [
    { from: 'x', to: 'e' }, { from: 'e', to: 'z' }, { from: 'z', to: 'n' }, { from: 'n', to: 'u' },
    { from: 'p', to: 'te' },
    { from: 'te', to: 'u', tone: 'green', label: t.ca, at: [col(4) + 138, 128], anchor: 'end' },
    { from: 'te', to: 'l', tone: 'green' },
    { from: 'zt', to: 'l' }, { from: 'l', to: 'z0' }, { from: 'z0', to: 'd' }, { from: 'd', to: 'xh' },
  ],
  texts: [
    { x: 12, y: 22, text: t.train, cls: 'f-small f-t-muted' },
    { x: 12, y: 238, text: t.gen, cls: 'f-small f-t-muted' },
  ],
};
const narrow: DLayout = {
  cls: 'fig-narrow', w: 360, h: 760, desc,
  nodes: [
    { id: 'x', x: 100, y: 30, w: 160, h: 44, label: t.x, sub: t.xs, tone: 'soft' },
    { id: 'e', x: 100, y: 90, w: 160, h: 44, label: t.e, sub: t.es, tone: 'amber' },
    { id: 'z', x: 100, y: 150, w: 160, h: 44, label: t.z, sub: t.zs, tone: 'soft' },
    { id: 'n', x: 100, y: 210, w: 160, h: 44, label: t.n, sub: t.ns },
    { id: 'u', x: 100, y: 270, w: 160, h: 44, label: t.u, sub: t.us, tone: 'blue' },
    { id: 'p', x: 100, y: 350, w: 160, h: 40, label: t.p, sub: t.ps, tone: 'soft' },
    { id: 'te', x: 100, y: 406, w: 160, h: 40, label: t.te, sub: t.tes, tone: 'green' },
    { id: 'zt', x: 100, y: 490, w: 160, h: 40, label: t.zt, sub: t.zts, tone: 'soft' },
    { id: 'l', x: 100, y: 546, w: 160, h: 44, label: t.l, sub: t.ls, tone: 'blue' },
    { id: 'z0', x: 100, y: 606, w: 160, h: 40, label: t.z0, sub: t.z0s, tone: 'soft' },
    { id: 'd', x: 100, y: 662, w: 160, h: 40, label: t.d, sub: t.ds, tone: 'amber' },
    { id: 'xh', x: 100, y: 716, w: 160, h: 40, label: t.xh, sub: t.xhs, tone: 'soft' },
  ],
  edges: [
    { from: 'x', to: 'e' }, { from: 'e', to: 'z' }, { from: 'z', to: 'n' }, { from: 'n', to: 'u' },
    { from: 'p', to: 'te' },
    { from: 'te', to: 'u', tone: 'green', via: [[300, 426], [300, 292]], label: t.ca, at: [294, 334], anchor: 'end' },
    { from: 'te', to: 'l', tone: 'green', via: [[60, 426], [60, 568]] },
    { from: 'zt', to: 'l' }, { from: 'l', to: 'z0' }, { from: 'z0', to: 'd' }, { from: 'd', to: 'xh' },
  ],
  texts: [
    { x: 12, y: 20, text: t.train, cls: 'f-small f-t-muted' },
    { x: 12, y: 478, text: t.gen, cls: 'f-small f-t-muted' },
  ],
};
---

<BlockDiagram
  id="latent-diffusion-pipeline"
  title={ru ? 'Латентная диффузия: Stable Diffusion при 512×512' : 'Latent diffusion: Stable Diffusion at 512×512'}
  svgTitle={ru ? 'Обучение и генерация в латентном пространстве' : 'Training and generation in the latent space'}
  caption={ru
    ? 'Сверху — обучение: замороженный энкодер сжимает изображение в 8 раз по каждой стороне в латент из 4 каналов, к нему добавляется шум шага t, и U-Net, читающая текст через cross-attention, предсказывает этот шум. Снизу — генерация: 20–50 шагов сэмплера с guidance на латенте из шума, затем один проход декодера. Диффузия видит 16 384 числа вместо 786 432.'
    : 'Top, training: the frozen encoder shrinks the image eightfold per side into a 4-channel latent, noise of step t is added, and the U-Net, reading the text through cross-attention, predicts that noise. Bottom, generation: 20–50 guided sampler steps on a latent of noise, then one decoder pass. Diffusion sees 16,384 numbers instead of 786,432.'}
  layouts={[wide, narrow]}
/>
