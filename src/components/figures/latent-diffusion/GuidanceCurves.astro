---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Classifier-free guidance on Gaussians: p(x) = N(0, 4), p(x | y) = N(2, 1). At the last step the guided score is the score of the density ∝ p(x)^(1−s) p(x | y)^s;
// this is the direction of guidance, not the law of guided samples (see the note).
const guided = (s: number) => {
  const precision = (1 - s) / 4 + s;
  return { s, mean: (2 * s) / precision, sd: Math.sqrt(1 / precision) };
};
const curves = [0, 1, 3, 7.5].map(guided);
if (curves[3].mean.toFixed(2) !== '2.55' || curves[3].sd.toFixed(2) !== '0.41') throw new Error('GuidanceCurves: numbers drifted from the note');
const pdf = (x: number, m: number, sd: number) => Math.exp(-((x - m) ** 2) / (2 * sd * sd)) / (sd * Math.sqrt(2 * Math.PI));
const tones = ['muted', 'blue', 'amber', 'red'];
const names = ru ? ['s = 0: безусловное', 's = 1: условное', 's = 3', 's = 7.5'] : ['s = 0: unconditional', 's = 1: conditional', 's = 3', 's = 7.5'];
const id = 'latent-diffusion-guidance-curves';
const layouts = [
  { sfx: 'w', cls: 'fig-wide fig-medium', W: 620, H: 300, left: 40, right: 600, top: 20, bottom: 250 },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 350, left: 20, right: 346, top: 20, bottom: 240 },
];
---

<Figure
  id={id}
  title={ru ? 'Направленный score на последнем шаге указывает на более узкую и сдвинутую плотность' : 'At the last step the guided score points to a narrower, shifted density'}
  caption={ru
    ? `Игрушечный пример: безусловное N(0, 4), условное N(2, 1). На последнем шаге направленный score при масштабе s — это score гауссианы p(x)^(1−s) p(x | y)^s: стандартное отклонение ${curves[2].sd.toFixed(2)} и среднее ${curves[2].mean.toFixed(2)} при s = 3, ${curves[3].sd.toFixed(2)} и ${curves[3].mean.toFixed(2)} при s = 7.5. Сэмплеры с guidance дают ещё более узкие распределения, разные для DDPM и DDIM.`
    : `Toy example: unconditional N(0, 4), conditional N(2, 1). At the last step the guided score at scale s is the score of the Gaussian p(x)^(1−s) p(x | y)^s: standard deviation ${curves[2].sd.toFixed(2)} and mean ${curves[2].mean.toFixed(2)} at s = 3, ${curves[3].sd.toFixed(2)} and ${curves[3].mean.toFixed(2)} at s = 7.5. Guided samplers end narrower still, differently for DDPM and DDIM.`}
>
  {layouts.map((L) => {
    const sx = scale([-6, 6], [L.left, L.right]);
    const sy = scale([0, 1], [L.bottom, L.top]);
    const narrow = L.sfx === 'n';
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{ru ? 'Плотности при четырёх масштабах guidance' : 'Densities at four guidance scales'}</title>
        <desc id={`${id}-${L.sfx}-d`}>{curves.map((c, i) => `${names[i]}: ${ru ? 'среднее' : 'mean'} ${c.mean.toFixed(2)}, ${ru ? 'ст. отклонение' : 'sd'} ${c.sd.toFixed(2)}`).join('; ')}.</desc>
        {[-6, -4, -2, 0, 2, 4, 6].map((x) => <text class="f-note" x={sx(x)} y={L.bottom + 20} text-anchor="middle">{x}</text>)}
        <path class="f-axis" d={`M ${L.left} ${L.bottom} H ${L.right + 8}`} />
        <path class="f-thin f-muted f-dash" d={`M ${sx(2)} ${L.bottom} V ${L.top}`} />
        {curves.map((c, i) => <path class={`f-line f-${tones[i]}${i === 3 ? ' f-bold' : ''}`} d={plot((x) => pdf(x, c.mean, c.sd), -6, 6, sx, sy, 400)} />)}
        {curves.map((c, i) => (
          <g>
            <line class={`f-line f-${tones[i]}`} x1={narrow ? L.left : L.left + 4} x2={narrow ? L.left + 22 : L.left + 26} y1={narrow ? L.bottom + 44 + i * 18 : L.top + 14 + i * 20} y2={narrow ? L.bottom + 44 + i * 18 : L.top + 14 + i * 20} />
            <text class="f-label" x={narrow ? L.left + 30 : L.left + 34} y={narrow ? L.bottom + 49 + i * 18 : L.top + 19 + i * 20}>{names[i]}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
