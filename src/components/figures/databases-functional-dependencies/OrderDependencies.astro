---
import Figure from '../Figure.astro';

const ru = Astro.props.lang === 'ru';
const title = ru ? 'Три уровня фактов в одной таблице' : 'Three levels of facts in one table';
const caption = ru
  ? 'Ключ позиции определяет цену и количество. Состояние повторяется на уровне заказа, а код повторяется на уровне товара.'
  : 'The line key determines price and quantity. State repeats by order, and code repeats by product.';
const desc = ru
  ? 'Номер заказа и позиции определяют товар, количество и цену. Заказ определяет состояние, товар и код определяют друг друга.'
  : 'Order and line determine product, quantity and price. Order determines state, and item and code determine each other.';
const rows = [
  { left: '(o, n)', right: 'p, q, c', both: false },
  { left: 'o', right: 's', both: false },
  { left: 'p', right: 'k', both: true },
];
---
<Figure id="db-order-dependencies" title={title} caption={caption}>
  <svg viewBox="0 0 340 149" role="img" aria-labelledby="db-order-deps-title db-order-deps-desc" style="max-width: 520px; margin-inline: auto">
    <title id="db-order-deps-title">{title}</title>
    <desc id="db-order-deps-desc">{desc}</desc>
    {rows.map(({left, right, both}, i) => (
      <g transform={`translate(0 ${i * 48})`}>
        <rect class="f-fill-blue" x="10" y="6" width="119" height="37" rx="6" />
        <text class="f-label" x="69" y="30" text-anchor="middle">{left}</text>
        <path class="f-line" d="M 138 24 H 203 M 198 19 L 203 24 L 198 29" />
        {both && <path class="f-line" d="M 143 19 L 138 24 L 143 29" />}
        <rect class="f-fill-green" x="211" y="6" width="119" height="37" rx="6" />
        <text class="f-label" x="270" y="30" text-anchor="middle">{right}</text>
      </g>
    ))}
  </svg>
</Figure>
