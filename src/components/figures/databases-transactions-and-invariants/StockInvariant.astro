---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
const id = 'db-stock-invariant';
const title = ru ? 'Шесть пачек до и после резерва' : 'Six packs before and after a reservation';
const labels = ru ? ['В продаже', 'В резерве'] : ['Available', 'Reserved'];
const states = [
  { name: ru ? 'До операции' : 'Before', available: 5, reserved: 1 },
  { name: ru ? 'После операции' : 'After', available: 3, reserved: 3 },
];
---
<Figure id={id} title={title} caption={ru
  ? 'Две пачки переходят из доступного остатка в резерв. В каждой строке по шесть пачек.'
  : 'Two packs move from available stock into reservations. Each row contains the same number of packs.'}>
  <svg viewBox="0 0 330 149" class="fig-compact" role="img" aria-labelledby={id + '-title ' + id + '-desc'}>
    <title id={id + '-title'}>{title}</title>
    <desc id={id + '-desc'}>{ru ? 'До операции пять пачек доступны и одна в резерве. После операции три доступны и три в резерве.' : 'Before, five packs are available and one is reserved. After, three are available and three are reserved.'}</desc>
    {states.map(({ name, available, reserved }, row) => (
      <g transform={'translate(0 ' + row * 45 + ')'}>
        <text x="10" y="28">{name}</text>
        {Array.from({ length: available + reserved }, (_, i) => (
          <rect x={123 + i * 32} y="10" width="25" height="25" rx="4"
            class={i < available ? 'f-fill-blue' : 'f-fill-green'} />
        ))}
        <text x="123" y="51">{available} + {reserved} = {available + reserved}</text>
      </g>
    ))}
    {labels.map((label, i) => (
      <g transform={'translate(' + (20 + i * 162) + ' 0)'}>
        <rect x="0" y="121" width="17" height="17" rx="3" class={i === 0 ? 'f-fill-blue' : 'f-fill-green'} />
        <text x="24" y="135">{label}</text>
      </g>
    ))}
  </svg>
</Figure>
