---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// How x + y and x * y are evaluated (Python language reference, "Emulating numeric types"), traced for the
// Vector class of the note with v = Vector(3, 4). Replayed here: 2 * v reaches __rmul__; v + 1 fails both ways.
const v = [3, 4];
const twice = v.map((c) => 2 * c);
if (twice.join() !== '6,8') throw new Error('2 * v');

type Kind = 'call' | 'no' | 'ok' | 'err' | 'skip';
interface Cell { text: string; kind: Kind }
const t = ru
  ? {
      heads: ['правило', '2 * v', 'v + 1'],
      sub: ['для x op y', 'v = Vector(3, 4)', 'int не знает Vector'],
      rules: [['type(x).__op__(x, y)', 'прямой метод левого операнда'], ['type(y).__rop__(y, x)', 'отражённый метод правого операнда'], ['TypeError', 'оба вернули NotImplemented']],
      skip: 'не нужен', note: 'Если type(y) — подкласс type(x) со своим __rop__, шаг 2 выполняется первым.',
      steps: ['вызвать прямой метод левого операнда', 'если он вернул NotImplemented, вызвать отражённый метод правого', 'если и он вернул NotImplemented, возбудить TypeError'],
    }
  : {
      heads: ['the rule', '2 * v', 'v + 1'],
      sub: ['for x op y', 'v = Vector(3, 4)', 'int does not know Vector'],
      rules: [['type(x).__op__(x, y)', "the left operand's method"], ['type(y).__rop__(y, x)', "the right one's reflected"], ['TypeError', 'both said NotImplemented']],
      skip: 'not needed', note: 'If type(y) is a subclass of type(x) with its own __rop__, step 2 runs first.',
      steps: ["call the left operand's forward method", "if it returned NotImplemented, call the right operand's reflected method", 'if that also returned NotImplemented, raise TypeError'],
    };
// Two traces, one cell list per step: the call made, then what it returned.
const traces: Cell[][][] = [
  [
    [{ text: 'int.__mul__(2, v)', kind: 'call' }, { text: '→ NotImplemented', kind: 'no' }],
    [{ text: 'Vector.__rmul__(v, 2)', kind: 'call' }, { text: '→ Vector(6.0, 8.0)', kind: 'ok' }],
    [{ text: t.skip, kind: 'skip' }],
  ],
  [
    [{ text: 'Vector.__add__(v, 1)', kind: 'call' }, { text: '→ NotImplemented', kind: 'no' }],
    [{ text: 'int.__radd__(1, v)', kind: 'call' }, { text: '→ NotImplemented', kind: 'no' }],
    [{ text: 'TypeError: unsupported', kind: 'err' }, { text: "operand type(s) for +", kind: 'err' }],
  ],
];
const cls: Record<Kind, string> = { call: '', no: 'f-t-muted', ok: 'f-t-blue', err: 'f-t-red', skip: 'f-t-muted' };
const weight: Record<Kind, number> = { call: 400, no: 400, ok: 700, err: 650, skip: 400 };

interface Layout { cls: string; W: number; H: number; cols: number[]; colW: number[]; top: number; rowH: number; gap: number; lh: number; mono: number; sans: number; narrow: boolean; noteY: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 300, cols: [40, 300, 535], colW: [244, 220, 215], top: 62, rowH: 58, gap: 12, lh: 19, mono: 7.5, sans: 6.5, narrow: false, noteY: 288 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 604, cols: [34, 34, 34], colW: [318, 318, 318], top: 34, rowH: 176, gap: 14, lh: 21, mono: 8.4, sans: 7.3, narrow: true, noteY: 0 },
];
for (const L of layouts) {
  for (let i = 0; i < 3; i++) {
    for (const [a, b] of [t.rules[i]]) {
      if (10 + a.length * L.mono > L.colW[0] - 4) throw new Error(`rule ${a} at ${L.W}`);
      if (10 + b.length * L.sans > L.colW[0] - 4) throw new Error(`rule note ${b} at ${L.W}`);
    }
    for (let k = 0; k < 2; k++) for (const c of traces[k][i]) {
      const pre = L.narrow ? 7 : 0; // room for the lane label in the narrow layout
      if (10 + (pre + c.text.length) * L.mono > L.colW[k + 1] - 4) throw new Error(`trace ${c.text} at ${L.W}`);
    }
  }
  if (!L.narrow) {
    for (let i = 0; i < 3; i++) if (L.cols[i] + t.sub[i].length * L.sans > L.cols[i] + L.colW[i]) throw new Error(`sub ${t.sub[i]}`);
    if (L.cols[0] + t.note.length * L.sans > L.W - 4) throw new Error('note overflows');
  }
}
const id = 'operator-dispatch';
---

<Figure
  id={id}
  title={ru ? 'Как Python вычисляет бинарный оператор' : 'How Python evaluates a binary operator'}
  caption={ru
    ? 'Протокол бинарного оператора x op y и два его прохода для класса Vector из заметки, v = Vector(3, 4). Сначала вызывается прямой метод левого операнда (1). Для 2 * v это int.__mul__, который не знает Vector и возвращает NotImplemented, поэтому Python вызывает отражённый метод правого операнда (2), Vector.__rmul__, и получает Vector(6.0, 8.0). Для v + 1 оба метода возвращают NotImplemented, и Python возбуждает TypeError (3). Отражённый метод вызывается только для операндов разных типов; если тип правого операнда — подкласс типа левого и переопределяет отражённый метод, он вызывается первым.'
    : "The protocol of a binary operator x op y and two runs of it for the Vector class of the note, with v = Vector(3, 4). The left operand's forward method is called first (1). For 2 * v that is int.__mul__, which does not know Vector and returns NotImplemented, so Python calls the right operand's reflected method (2), Vector.__rmul__, and gets Vector(6.0, 8.0). For v + 1 both methods return NotImplemented, and Python raises TypeError (3). The reflected method is tried only for operands of different types; if the right operand's type is a subclass of the left's and overrides the reflected method, that method is tried first."}
>
  {layouts.map((L) => {
    const rowY = (i: number) => L.top + i * (L.rowH + L.gap);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Прямой метод, отражённый метод, TypeError' : 'Forward method, reflected method, TypeError'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Три шага: прямой метод левого операнда, отражённый метод правого, TypeError. Для 2 * v первый шаг даёт NotImplemented, второй — Vector(6.0, 8.0). Для v + 1 оба шага дают NotImplemented, и третий шаг возбуждает TypeError.'
          : "Three steps: the left operand's forward method, the right operand's reflected method, TypeError. For 2 * v the first step gives NotImplemented and the second gives Vector(6.0, 8.0). For v + 1 both steps give NotImplemented, and the third step raises TypeError."}</desc>
        {!L.narrow && t.heads.map((h, i) => (
          <g>
            <text class="f-small" x={L.cols[i]} y={22} style="font-weight: 650; font-family: var(--mono)">{h}</text>
            <text class="f-small f-t-muted" x={L.cols[i]} y={40}>{t.sub[i]}</text>
          </g>
        ))}
        {L.narrow && <text class="f-small f-t-muted" x={L.cols[0]} y={20} style="font-weight: 650">{t.sub[1]}</text>}
        {t.rules.map(([rule, why], i) => {
          const y = rowY(i);
          const err = i === 2;
          return (
            <g data-s={String(i + 1)}>
              <Badge x={L.cols[0] - 18} y={y + 16} n={i + 1} />
              <rect x={L.cols[0]} y={y} width={L.colW[0]} height={L.narrow ? 46 : L.rowH} rx="6" style={`fill: ${err ? toneVar.y : toneVar.h}; fill-opacity: 0.1; stroke: ${err ? toneVar.y : toneVar.h}; stroke-width: 1.2`} />
              <text class="f-small" x={L.cols[0] + 10} y={y + 20} style="font-family: var(--mono); font-weight: 650">{rule}</text>
              <text class="f-small f-t-muted" x={L.cols[0] + 10} y={y + 38}>{why}</text>
              {[0, 1].map((k) => {
                const cells = traces[k][i];
                const x = L.cols[k + 1] + 10;
                const y0 = L.narrow ? y + 70 + k * 2 * L.lh + k * 8 : y + 20;
                return (
                  <g>
                    {!L.narrow && <rect x={L.cols[k + 1]} y={y} width={L.colW[k + 1]} height={L.rowH} rx="6" style="fill: var(--paper-strong); stroke: var(--line); stroke-width: 1" />}
                    {L.narrow && <text class="f-small f-t-muted" x={x} y={y0} style="font-family: var(--mono); font-weight: 650">{t.heads[k + 1]}</text>}
                    {cells.map((c, j) => (
                      <text class={`f-small ${cls[c.kind]}`} x={L.narrow ? x + 7 * L.mono : x} y={y0 + j * L.lh} style={`font-family: var(--mono); font-weight: ${weight[c.kind]}`}>{c.text}</text>
                    ))}
                  </g>
                );
              })}
            </g>
          );
        })}
        {!L.narrow && <text class="f-small f-t-muted" x={L.cols[0]} y={L.noteY}>{t.note}</text>}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
