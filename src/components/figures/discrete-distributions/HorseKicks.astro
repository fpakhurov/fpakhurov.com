---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Bortkiewicz (1898): deaths from horse kicks in 10 Prussian cavalry corps over 20 years, 200 corps-years.
// Observed number of corps-years with k deaths, and the Poisson fit with the observed mean λ = 122 / 200.
const observed = [109, 65, 22, 3, 1];
const N = observed.reduce((a, b) => a + b, 0), deaths = observed.reduce((a, c, k) => a + c * k, 0), lam = deaths / N;
const fact = (k: number) => { let f = 1; for (let i = 2; i <= k; i++) f *= i; return f; };
const expected = observed.map((_, k) => (N * Math.exp(-lam) * lam ** k) / fact(k));
if (N !== 200 || deaths !== 122 || expected.map((v) => v.toFixed(1)).join() !== '108.7,66.3,20.2,4.1,0.6') throw new Error('HorseKicks: numbers drifted from the note');
const dec = (v: number) => v.toFixed(1);
const id = 'horse-kicks';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 560, H: 290, x0: 60, x1: 540, y0: 30, y1: 230 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 300, x0: 50, x1: 350, y0: 30, y1: 230 },
];
---

<Figure
  id={id}
  title={ru ? 'Гибель от удара копытом в прусской кавалерии и распределение Пуассона' : 'Deaths from horse kicks in the Prussian cavalry and the Poisson distribution'}
  caption={ru
    ? `Борткевич (1898): 10 кавалерийских корпусов за 20 лет, всего ${N} «корпусо-лет» и ${deaths} погибших, в среднем λ = ${lam.toFixed(2)} в год на корпус. Столбцы — сколько корпусо-лет дали 0, 1, 2, 3 и 4 гибели; точки — ожидаемые числа по распределению Пуассона с тем же средним: ${expected.map(dec).join('; ')}.`
    : `Bortkiewicz (1898): 10 cavalry corps over 20 years, ${N} corps-years with ${deaths} deaths, a mean of λ = ${lam.toFixed(2)} per corps per year. Bars are the number of corps-years with 0, 1, 2, 3 and 4 deaths; dots the numbers expected under the Poisson distribution with the same mean: ${expected.map(dec).join(', ')}.`}
>
  {layouts.map((L) => {
    const sx = scale([-0.5, 4.5], [L.x0, L.x1]), sy = scale([0, 120], [L.y1, L.y0]);
    const bw = ((L.x1 - L.x0) / 5) * 0.55;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Наблюдаемые и ожидаемые числа корпусо-лет' : 'Observed and expected numbers of corps-years'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? `Наблюдалось ${observed.join(', ')}; ожидалось ${expected.map(dec).join('; ')}.` : `Observed ${observed.join(', ')}; expected ${expected.map(dec).join(', ')}.`}</desc>
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {[0, 40, 80, 120].map((v) => <g><path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} /><text class="f-note" x={L.x0 - 8} y={sy(v) + 5} text-anchor="end">{v}</text></g>)}
        {observed.map((v, k) => <rect x={sx(k) - bw / 2} y={sy(v)} width={bw} height={sy(0) - sy(v)} style="fill: var(--fig-blue); fill-opacity: .45" />)}
        {expected.map((v, k) => <circle cx={sx(k)} cy={sy(v)} r="4.5" class="f-solid-red" />)}
        {observed.map((v, k) => <text class="f-small" x={sx(k)} y={sy(Math.max(v, expected[k])) - 10} text-anchor="middle">{v}</text>)}
        {observed.map((_, k) => <text class="f-note" x={sx(k)} y={L.y1 + 20} text-anchor="middle">{k}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 44} text-anchor="middle">{ru ? 'погибших за год в корпусе' : 'deaths per corps per year'}</text>
        <rect x={L.x1 - 150} y={L.y0 + 4} width="14" height="10" style="fill: var(--fig-blue); fill-opacity: .45" />
        <text class="f-note" x={L.x1 - 130} y={L.y0 + 14}>{ru ? 'наблюдалось' : 'observed'}</text>
        <circle cx={L.x1 - 143} cy={L.y0 + 30} r="4.5" class="f-solid-red" />
        <text class="f-note" x={L.x1 - 130} y={L.y0 + 35}>{ru ? 'Пуассон, λ = 0.61' : 'Poisson, λ = 0.61'}</text>
      </svg>
    );
  })}
</Figure>
