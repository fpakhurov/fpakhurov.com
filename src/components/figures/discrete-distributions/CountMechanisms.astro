---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { countData } from './countData';

// Original synthetic histograms; Poisson mean is specified, not fitted to either run.
const ru = pageLang(Astro.url) === 'ru';
const expected = countData.poisson.pmf_0_to_5_and_6plus.map(p => countData.windows*p);
const panels = [{ label: ru ? 'Независимые' : 'Independent', counts: countData.independent, color: 'blue' },
  { label: ru ? 'Группы по четыре' : 'Groups of four', counts: countData.grouped, color: 'amber' }];
if (panels.some(p => p.counts.reduce((a,b) => a+b,0) !== 512)) throw new Error('CountMechanisms: a simulated window is missing');
if (Math.abs(expected.reduce((a,b) => a+b,0)-512) > 1e-10) throw new Error('CountMechanisms: expected tail lost');
const id = 'count-mechanisms';
const layouts = [{ key: 'w', cls: 'fig-wide fig-bp-640', W: 760, H: 320, panel: (i: number) => ({ x: 47+i*385, y: 48, w: 320, h: 210 }) },
  { key: 'n', cls: 'fig-narrow fig-bp-640 seq-narrow', W: 360, H: 620, panel: (i: number) => ({ x: 44, y: 48+i*300, w: 300, h: 210 }) }];
---
<Figure id={id}
  title={ru ? 'Общая причина меняет форму распределения' : 'A shared cause changes the shape of the count distribution'}
  caption={ru
    ? 'Столбцы: по 512 искусственных окон, независимые датчики слева и группы по четыре справа. Красные точки: ожидаемые количества окон по Poisson(1.2), без подгонки. Масштабы одинаковы; «6+» включает весь хвост. В узком варианте панели идут сверху вниз.'
    : 'Bars: 512 synthetic windows per mechanism, independent sensors on the left and groups of four on the right. Red dots: expected windows under Poisson(1.2), without fitting. Scales match; “6+” includes the full tail. Narrow layouts stack the panels.'}>
  {layouts.map(L => <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.key}-t ${id}-${L.key}-d`}>
    <title id={`${id}-${L.key}-t`}>{ru ? 'Сравнение двух искусственных гистограмм' : 'Two synthetic count histograms'}</title>
    <desc id={`${id}-${L.key}-d`}>{ru ? `Группы значений: 0, 1, 2, 3, 4, 5, 6+. Независимые: ${countData.independent.join(', ')}. Групповые: ${countData.grouped.join(', ')}. В обеих моделях среднее 1.2; только групповая имеет нулевые вероятности для 1, 2 и 3.` : `Buckets: 0, 1, 2, 3, 4, 5, 6+. Independent: ${countData.independent.join(', ')}. Grouped: ${countData.grouped.join(', ')}. Both models have mean 1.2; only the grouped model has zero probabilities for 1, 2 and 3.`}</desc>
    {panels.map((panel,i) => {
      const p = L.panel(i), x = (k: number) => p.x+p.w*(k+.5)/7, y = (v: number) => p.y+p.h-v*p.h/400;
      return <g>
        <text class="f-small" x={p.x} y={p.y-22}>{panel.label}</text>
        {[0,100,200,300,400].map(v => <g>
          <path class="f-grid" d={`M ${p.x} ${y(v)} H ${p.x+p.w}`} />
          <text class="f-note" x={p.x-7} y={y(v)+4} text-anchor="end">{v}</text>
        </g>)}
        {panel.counts.map((value,k) => <g>
          <rect x={x(k)-p.w/24} y={y(value)} width={p.w/12} height={p.y+p.h-y(value)} style={`fill: var(--fig-${panel.color}); fill-opacity: .5`} />
          <circle cx={x(k)} cy={y(expected[k])} r="3.6" class="f-solid-red" />
          <text class="f-note" x={x(k)} y={y(value)-9} text-anchor="middle">{value}</text>
          <text class="f-note" x={x(k)} y={p.y+p.h+20} text-anchor="middle">{k===6?'6+':k}</text>
        </g>)}
        <text class="f-note f-t-muted" x={p.x+p.w/2} y={p.y+p.h+44} text-anchor="middle">{ru ? 'сообщений за окно' : 'reports per window'}</text>
      </g>;
    })}
  </svg>)}
</Figure>
