---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { countData } from './countData';

// Original probability matrix from the newly specified count experiment.
const ru = pageLang(Astro.url) === 'ru';
const rows = [...countData.poisson.limit.map(row => ({ label: `n = ${row.n}`, mass: row.pmf_0_to_5_and_6plus })),
  { label: ru ? 'Пуассон' : 'Poisson', mass: countData.poisson.pmf_0_to_5_and_6plus }]
  .map(row => ({ ...row, cells: [...row.mass.slice(0, 3), row.mass.slice(3).reduce((a,b) => a+b,0)] }));
if (rows.some(row => Math.abs(row.cells.reduce((a,b) => a+b,0)-1) > 1e-12)) throw new Error('PoissonLimit: probability mass lost');
if (rows.map(row => row.cells[0].toFixed(6)).join(',') !== '0.282430,0.296634,0.300062,0.301194') throw new Error('PoissonLimit: wrong zero probabilities');
const id = 'poisson-limit';
const layouts = [{ key: 'w', cls: 'fig-wide fig-bp-640', W: 660, H: 300, label: 116, cell: 128 },
  { key: 'n', cls: 'fig-narrow fig-bp-640 seq-narrow', W: 360, H: 300, label: 82, cell: 66 }];
---
<Figure id={id}
  title={ru ? 'При постоянном среднем меняется вероятность каждого количества' : 'A fixed mean with changing count probabilities'}
  caption={ru
    ? 'Строки: Bin(n, 1.2/n) и Poisson(1.2). В ячейках — вероятности, последняя объединяет все количества от трёх. Оттенок отражает массу. При росте n биномиальные вероятности приближаются к пуассоновским; среднее остаётся 1.2.'
    : 'Rows: Bin(n, 1.2/n) and Poisson(1.2). Cells contain probabilities; the last combines counts of three or more. Shading reflects mass. Increasing n brings the binomial probabilities toward the Poisson values while the mean remains 1.2.'}>
  {layouts.map(L => <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.key}-t ${id}-${L.key}-d`}>
    <title id={`${id}-${L.key}-t`}>{ru ? 'Вероятности нуля, одного, двух и хотя бы трёх сообщений' : 'Probabilities of zero, one, two and at least three reports'}</title>
    <desc id={`${id}-${L.key}-d`}>{rows.map(row => `${row.label}: ${row.cells.map(x => x.toFixed(3)).join(', ')}`).join('; ')}</desc>
    <text class="f-note f-t-muted" x="12" y="25">{ru ? 'Модель' : 'Model'}</text>
    {['0', '1', '2', '3+'].map((label,i) => <text class="f-small" x={L.label+L.cell*(i+.5)} y="25" text-anchor="middle">{label}</text>)}
    {rows.map((row,r) => <g>
      <text class="f-small" x="12" y={68+r*56}>{row.label}</text>
      {row.cells.map((value,c) => <g>
        <rect x={L.label+c*L.cell} y={43+r*56} width={L.cell-6} height="40" rx="4" style={`fill: var(--fig-blue); fill-opacity: ${.06+.5*value/.4}`} />
        <text class="f-small" x={L.label+L.cell*(c+.5)-3} y={68+r*56} text-anchor="middle">{value.toFixed(3)}</text>
      </g>)}
    </g>)}
    <text class="f-note f-t-muted" x={L.W/2} y="287" text-anchor="middle">{ru ? 'В каждой строке сумма равна 1' : 'Each row sums to 1'}</text>
  </svg>)}
</Figure>
