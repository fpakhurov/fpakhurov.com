---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Binomial(n, 3/n) against Poisson(3) for n = 5, 10, 100, with the total variation distance between them:
// half the sum of the absolute differences, the largest difference in the probability of any event.
const lam = 3, ns = [5, 10, 100], K = 10;
const comb = (n: number, k: number) => { let c = 1; for (let i = 1; i <= k; i++) c = (c * (n - k + i)) / i; return c; };
const binom = (n: number, p: number, k: number) => (k > n ? 0 : comb(n, k) * p ** k * (1 - p) ** (n - k));
const fact = (k: number) => { let f = 1; for (let i = 2; i <= k; i++) f *= i; return f; };
const pois = (k: number) => (Math.exp(-lam) * lam ** k) / fact(k);
const tv = (n: number) => {
  let s = 0, q = 0;
  for (let k = 0; k <= n; k++) { s += Math.abs(binom(n, lam / n, k) - pois(k)); q += pois(k); }
  return 0.5 * (s + 1 - q);
};
const tvs = ns.map(tv);
if (tvs.map((v) => v.toFixed(3)).join() !== '0.219,0.086,0.008') throw new Error('PoissonLimit: distances drifted from the note');
const panels = ns.map((n, i) => ({ n, p: lam / n, tv: tvs[i], bars: Array.from({ length: K }, (_, k) => binom(n, lam / n, k)) }));
const poisK = Array.from({ length: K }, (_, k) => pois(k));
const fmt = (v: number) => v.toFixed(3);
const id = 'poisson-limit';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 268, pos: (i: number) => [30 + i * 250, 50], pw: 220, ph: 150, legend: [30, 258] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 690, pos: (i: number) => [30, 50 + i * 210], pw: 310, ph: 130, legend: [30, 676] },
];
---

<Figure
  id={id}
  title={ru ? 'Биномиальное распределение с малым p приближается к пуассоновскому' : 'A binomial with small p approaches the Poisson distribution'}
  caption={ru
    ? `Столбцы — биномиальное распределение с n испытаниями и вероятностью успеха 3/n, точки — распределение Пуассона с λ = 3; среднее число успехов в обоих равно 3. Расстояние полной вариации (наибольшая разница в вероятности одного и того же события) падает с ${fmt(tvs[0])} при n = 5 до ${fmt(tvs[1])} при n = 10 и ${fmt(tvs[2])} при n = 100.`
    : `Bars are the binomial distribution with n trials and success probability 3/n, dots the Poisson distribution with λ = 3; both have a mean of 3 successes. The total variation distance (the largest difference in the probability of any event) falls from ${fmt(tvs[0])} at n = 5 to ${fmt(tvs[1])} at n = 10 and ${fmt(tvs[2])} at n = 100.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Три биномиальных распределения рядом с пуассоновским' : 'Three binomial distributions next to the Poisson'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? `Биномиальные распределения с n = 5, 10, 100 и p = 3/n; расстояния до Пуассона(3): ${tvs.map(fmt).join(', ')}.` : `Binomial distributions with n = 5, 10, 100 and p = 3/n; distances to Poisson(3): ${tvs.map(fmt).join(', ')}.`}</desc>
      {panels.map((P, i) => {
        const [x0, y0] = L.pos(i);
        const sx = scale([-0.5, K - 0.5], [x0, x0 + L.pw]), sy = scale([0, 0.36], [y0 + L.ph, y0]);
        const bw = (L.pw / K) * 0.7;
        return (
          <g>
            <text class="f-small" x={x0} y={y0 - 24}>{`n = ${P.n}, p = ${+P.p.toFixed(2)}`}</text>
            <text class="f-small f-t-amber" x={x0 + L.pw} y={y0 - 24} text-anchor="end">{`TV = ${fmt(P.tv)}`}</text>
            <path class="f-axis" d={`M ${x0} ${y0 + L.ph} H ${x0 + L.pw}`} />
            {P.bars.map((v, k) => <rect x={sx(k) - bw / 2} y={sy(v)} width={bw} height={sy(0) - sy(v)} style="fill: var(--fig-blue); fill-opacity: .45" />)}
            {poisK.map((v, k) => <circle cx={sx(k)} cy={sy(v)} r="3.6" class="f-solid-red" />)}
            {poisK.map((_, k) => <text class="f-note" x={sx(k)} y={y0 + L.ph + 18} text-anchor="middle">{k}</text>)}
          </g>
        );
      })}
      <rect x={L.legend[0]} y={L.legend[1] - 10} width="14" height="10" style="fill: var(--fig-blue); fill-opacity: .45" />
      <text class="f-note" x={L.legend[0] + 20} y={L.legend[1]}>{ru ? 'биномиальное(n, 3/n)' : 'binomial(n, 3/n)'}</text>
      <circle cx={L.legend[0] + 226} cy={L.legend[1] - 5} r="3.6" class="f-solid-red" />
      <text class="f-note" x={L.legend[0] + 236} y={L.legend[1]}>{ru ? 'Пуассон(3)' : 'Poisson(3)'}</text>
    </svg>
  ))}
</Figure>
