---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One tool call through the Model Context Protocol, revision 2026-07-28: three lifelines (the model, the host with its
// client, the server) and the messages between them, in the order of the numbered list in the note.
const version = '2026-07-28';
const t = ru
  ? {
      title: 'Один вызов инструмента через MCP',
      model: 'модель', host: 'хост и клиент', server: 'сервер',
      m: [
        ['server/discover', 'версии, возможности'],
        ['tools/list', 'инструменты и их JSON Schema'],
        ['описания инструментов в контексте', ''],
        ['вызов get_order(A-1001)', 'согласие пользователя'],
        ['tools/call + _meta', 'content, structuredContent, isError'],
        ['наблюдение в контексте', ''],
      ],
      n: [['discover', 'версии'], ['tools/list', 'схемы'], ['схемы в контекст', ''], ['вызов', 'согласие'], ['tools/call', 'результат'], ['наблюдение', '']],
      steps: ['обнаружение: клиент узнаёт версии и возможности сервера', 'список: сервер возвращает инструменты со схемами', 'показ: хост кладёт описания инструментов в контекст модели', 'решение: модель выдаёт вызов, хост проверяет согласие пользователя', 'вызов: клиент шлёт tools/call с метаданными, сервер проверяет аргументы и выполняет', 'наблюдение: хост добавляет результат в контекст модели'],
      desc: `Три вертикальные линии жизни: модель, хост с клиентом и сервер. Сообщения сверху вниз: server/discover и ответ с версиями; tools/list и ответ со схемами; хост передаёт описания модели; модель выдаёт вызов get_order, хост проверяет согласие; клиент шлёт tools/call с метаданными версии ${version}, сервер возвращает content, structuredContent и isError; хост передаёт результат модели как наблюдение.`,
    }
  : {
      title: 'One tool call through MCP',
      model: 'model', host: 'host and client', server: 'server',
      m: [
        ['server/discover', 'versions, capabilities'],
        ['tools/list', 'tools with their JSON Schemas'],
        ['tool descriptions in the context', ''],
        ['call get_order(A-1001)', "the user's consent"],
        ['tools/call + _meta', 'content, structuredContent, isError'],
        ['observation in the context', ''],
      ],
      n: [['discover', 'versions'], ['tools/list', 'schemas'], ['schemas to context', ''], ['tool call', 'consent'], ['tools/call', 'result'], ['observation', '']],
      steps: ['discover: the client learns the server\'s versions and capabilities', 'list: the server returns its tools with their schemas', 'present: the host puts the tool descriptions into the model\'s context', 'decide: the model emits a call and the host checks the user\'s consent', 'call: the client sends tools/call with its metadata; the server validates the arguments and runs the tool', 'observe: the host appends the result to the model\'s context'],
      desc: `Three vertical lifelines: the model, the host with its client, and the server. Messages from top to bottom: server/discover and a reply with versions; tools/list and a reply with schemas; the host passes the descriptions to the model; the model emits a call to get_order and the host checks consent; the client sends tools/call with the metadata of revision ${version}, and the server returns content, structuredContent and isError; the host passes the result to the model as an observation.`,
    };
const id = 'mcp-exchange';
const caption = ru
  ? `Ревизия ${version}: рукопожатия нет, каждый запрос несёт версию протокола и возможности клиента в _meta, поэтому первый шаг необязателен. Сплошные стрелки — запросы, пунктирные — ответы. Модель никогда не говорит с сервером напрямую: всё проходит через хост, который владеет контекстом и решает, что разрешено. Ошибка в аргументах приходит как обычный результат с isError: true, который модель может прочитать и исправить.`
  : `Revision ${version}: there is no handshake, and every request carries the protocol version and the client's capabilities in _meta, so the first step is optional. Solid arrows are requests, dashed ones replies. The model never talks to the server directly: everything passes through the host, which owns the context and decides what is allowed. An error in the arguments arrives as an ordinary result with isError: true, which the model can read and correct.`;
// lifelines and message rows
const L = {
  w: { W: 760, H: 430, x: [110, 390, 660], top: 20, row0: 92, dy: 56, boxW: [120, 170, 120] },
  n: { W: 360, H: 430, x: [48, 180, 312], top: 12, row0: 82, dy: 54, boxW: [80, 108, 80] },
};
// message direction per row: [from, to] lifeline index; replies come back from the server
const dirs: [number, number][] = [[1, 2], [1, 2], [1, 0], [0, 1], [1, 2], [1, 0]];
---

<Figure id={id} title={t.title} caption={caption}>
  {(['w', 'n'] as const).map((k) => {
    const G = L[k];
    const labels = k === 'w' ? t.m : t.n;
    const cls = k === 'w' ? 'fig-wide' : 'fig-narrow seq-narrow';
    const bottom = G.row0 + 5 * G.dy + 30;
    return (
      <svg class={cls} viewBox={`0 0 ${G.W} ${G.H}`} role="img" aria-labelledby={`${id}-${k}-t ${id}-${k}-d`}>
        <title id={`${id}-${k}-t`}>{t.title}</title>
        <desc id={`${id}-${k}-d`}>{t.desc}</desc>
        {[t.model, t.host, t.server].map((name, i) => (
          <g>
            <Box x={G.x[i] - G.boxW[i] / 2} y={G.top} w={G.boxW[i]} h={36} label={k === 'n' && i === 1 ? (ru ? 'хост' : 'host') : name} tone={i === 1 ? 'h' : 'n'} />
            <path class="f-line f-muted f-dash" d={`M ${G.x[i]} ${G.top + 36} V ${bottom}`} />
          </g>
        ))}
        {dirs.map(([a, b], r) => {
          const y = G.row0 + r * G.dy;
          const sgn = Math.sign(G.x[b] - G.x[a]);
          const mid = (G.x[a] + G.x[b]) / 2;
          const [req, rep] = labels[r];
          const tone = r === 3 ? 'red' : r === 5 ? 'green' : 'ink';
          return (
            <g data-s={String(r + 1)}>
              <Arrow pts={[[G.x[a] + sgn * 4, y], [G.x[b] - sgn * 6, y]]} tone={tone} />
              <text class={`f-small ${r === 3 ? 'f-t-red' : r === 5 ? 'f-t-green' : ''}`} x={mid} y={y - 7} text-anchor="middle">{req}</text>
              {rep && r !== 3 && <Arrow pts={[[G.x[b] - sgn * 4, y + 18], [G.x[a] + sgn * 6, y + 18]]} dashed />}
              {rep && r !== 3 && <text class="f-small f-t-muted" x={mid} y={y + 33} text-anchor="middle">{rep}</text>}
              {r === 3 && <rect x={G.x[1] - 6} y={y + 8} width="12" height="22" rx="3" style="fill: var(--fig-amber); fill-opacity: 0.35; stroke: var(--fig-amber)" />}
              {r === 3 && <text class="f-small f-t-amber" x={G.x[1] + 12} y={y + 24}>{rep}</text>}
              <Badge x={k === 'w' ? 26 : 14} y={y} n={r + 1} />
            </g>
          );
        })}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
