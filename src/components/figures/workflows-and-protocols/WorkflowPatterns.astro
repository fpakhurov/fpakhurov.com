---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Op from '../seqflow/Op.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The five workflows and the autonomous agent of the note, each drawn in a 240 × 160 panel with the same vocabulary:
// model calls are boxes, code-level checks are amber pills, data flows along grey arrows, feedback along amber ones.
const t = ru
  ? {
      title: 'Пять рабочих процессов и автономный агент',
      p: ['цепочка промптов', 'маршрутизация', 'параллелизация', 'оркестратор и исполнители', 'оценщик–оптимизатор', 'автономный агент'],
      gate: 'фильтр', exit: 'стоп', router: 'маршрутизатор', agg: 'агрегатор', orch: 'оркестратор', results: 'результаты',
      gen: 'генератор', evalr: 'оценщик', feedback: 'замечания', accepted: 'принят', env: 'среда', action: 'действие', obs: 'наблюдение', stop: 'стоп',
      desc: 'Шесть панелей. Цепочка: LLM, фильтр, LLM; фильтр может остановить. Маршрутизация: маршрутизатор отправляет вход одному из трёх LLM. Параллелизация: три LLM работают одновременно, агрегатор собирает ответы. Оркестратор и исполнители: оркестратор раздаёт подзадачи трём LLM, результаты возвращаются к нему. Оценщик–оптимизатор: генератор пишет, оценщик возвращает замечания, принятый ответ выходит. Автономный агент: LLM выдаёт действие среде, получает наблюдение и сам решает остановиться.',
    }
  : {
      title: 'Five workflows and the autonomous agent',
      p: ['prompt chaining', 'routing', 'parallelization', 'orchestrator–workers', 'evaluator–optimizer', 'autonomous agent'],
      gate: 'gate', exit: 'exit', router: 'router', agg: 'aggregate', orch: 'orchestrator', results: 'results',
      gen: 'generator', evalr: 'evaluator', feedback: 'feedback', accepted: 'accepted', env: 'environment', action: 'action', obs: 'observation', stop: 'stop',
      desc: 'Six panels. Chaining: an LLM, a gate, an LLM; the gate can stop the chain. Routing: a router sends the input to one of three LLMs. Parallelization: three LLMs run at once and an aggregator combines their answers. Orchestrator–workers: an orchestrator hands subtasks to three LLMs and their results return to it. Evaluator–optimizer: a generator writes, an evaluator returns feedback, and an accepted answer leaves the loop. Autonomous agent: an LLM sends an action to the environment, receives an observation and decides by itself when to stop.',
    };
const id = 'workflow-patterns';
const caption = ru
  ? 'Прямоугольники — вызовы модели, янтарное — проверки и обратная связь, которые задаёт код. В первых пяти схемах путь написан программистом: модель выполняет шаги, но не выбирает их. В последней путь выбирает модель, и поэтому только у неё нет заранее известного числа шагов. Реальные системы сочетают схемы: маршрутизатор перед несколькими цепочками, одна из которых — агент с оценщиком.'
  : 'Boxes are model calls; amber marks the checks and feedback that the code imposes. In the first five diagrams the path is written by the programmer: the model performs the steps but does not choose them. In the last one the model chooses the path, which is why it alone has no number of steps known in advance. Real systems combine the diagrams: a router in front of several chains, one of which is an agent with an evaluator.';
const gateHalf = (14 + t.gate.length * 7.6) / 2;
const wide = [[4, 4], [260, 4], [516, 4], [4, 184], [260, 184], [516, 184]];
const narrow = [0, 1, 2, 3, 4, 5].map((i) => [60, 4 + i * 172]);
const three = [38, 78, 118];
---

<Figure id={id} title={t.title} caption={caption}>
  {[{ cls: 'fig-wide', W: 760, H: 356, pos: wide, sfx: 'w' }, { cls: 'fig-narrow', W: 360, H: 1040, pos: narrow, sfx: 'n' }].map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
      {L.pos.map(([x, y], i) => (
        <g transform={`translate(${x} ${y})`}>
          <rect class="f-box-soft" x="0" y="0" width="240" height="166" rx="10" />
          <text class="f-small f-t-muted" x="10" y="18" style="font-weight: 650">{t.p[i]}</text>
          {i === 0 && (
            <g>
              <Arrow pts={[[2, 92], [14, 92]]} />
              <Box x={16} y={76} w={48} h={32} label="LLM" />
              <Arrow pts={[[64, 92], [112 - gateHalf - 2, 92]]} />
              <Op x={112} y={92} sym={t.gate} tone="amber" />
              <Arrow pts={[[112 + gateHalf, 92], [160, 92]]} />
              <Box x={162} y={76} w={48} h={32} label="LLM" />
              <Arrow pts={[[210, 92], [236, 92]]} />
              <Arrow pts={[[112, 105], [112, 134]]} tone="amber" dashed />
              <text class="f-small f-t-amber" x="120" y="150">{t.exit}</text>
            </g>
          )}
          {i === 1 && (
            <g>
              <Box x={6} y={74} w={104} h={34} label={t.router} tone="g" />
              {three.map((yy, j) => (
                <g>
                  <Arrow pts={[[110, 91], [158, yy + 14]]} tone={j === 1 ? 'ink' : 'muted'} dashed={j !== 1} />
                  <Box x={160} y={yy} w={70} h={28} label={`LLM ${'ABC'[j]}`} />
                </g>
              ))}
            </g>
          )}
          {i === 2 && (
            <g>
              {three.map((yy) => (
                <g>
                  <Arrow pts={[[8, 92], [66, yy + 14]]} />
                  <Box x={68} y={yy} w={56} h={28} label="LLM" />
                  <Arrow pts={[[124, yy + 14], [146, 91]]} />
                </g>
              ))}
              <Box x={148} y={74} w={86} h={34} label={t.agg} tone="g" />
            </g>
          )}
          {i === 3 && (
            <g>
              <Box x={6} y={74} w={100} h={34} label={t.orch} tone="g" />
              {three.map((yy) => (
                <g>
                  <Arrow pts={[[106, 91], [150, yy + 14]]} />
                  <Box x={152} y={yy} w={60} h={28} label="LLM" />
                </g>
              ))}
              <Arrow pts={[[182, 146], [182, 156], [56, 156], [56, 110]]} tone="amber" dashed />
              <text class="f-small f-t-amber" x="64" y="150">{t.results}</text>
            </g>
          )}
          {i === 4 && (
            <g>
              <Box x={10} y={74} w={84} h={34} label={t.gen} />
              <Box x={146} y={74} w={84} h={34} label={t.evalr} tone="g" />
              <Arrow pts={[[94, 84], [144, 84]]} />
              <Arrow pts={[[146, 100], [96, 100]]} tone="amber" dashed />
              <text class="f-small f-t-amber" x="120" y="126" text-anchor="middle">{t.feedback}</text>
              <Arrow pts={[[188, 108], [188, 146]]} tone="red" />
              <text class="f-small f-t-red" x="180" y="146" text-anchor="end">{t.accepted}</text>
            </g>
          )}
          {i === 5 && (
            <g>
              <Box x={10} y={74} w={70} h={34} label="LLM" />
              <Box x={140} y={74} w={94} h={34} label={t.env} />
              <Arrow pts={[[80, 84], [138, 84]]} tone="red" />
              <text class="f-small f-t-red" x="110" y="70" text-anchor="middle">{t.action}</text>
              <Arrow pts={[[140, 100], [82, 100]]} tone="green" />
              <text class="f-small f-t-green" x="110" y="124" text-anchor="middle">{t.obs}</text>
              <Arrow pts={[[45, 108], [45, 146]]} tone="red" />
              <text class="f-small f-t-red" x="53" y="146">{t.stop}</text>
            </g>
          )}
        </g>
      ))}
    </svg>
  ))}
</Figure>
