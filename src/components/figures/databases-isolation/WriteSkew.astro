---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
const id = 'db-write-skew';
const title = ru ? 'Обе операции опираются на старый снимок' : 'Both operations use the old snapshot';
const steps = [
  { x: 86, name: 'T1', write: ru ? 'Закрывает A' : 'Closes A' },
  { x: 244, name: 'T2', write: ru ? 'Закрывает B' : 'Closes B' },
];
---
<Figure id={id} title={title} caption={ru
  ? 'Каждая транзакция читает две открытые стойки. Записи меняют разные строки, но вместе оставляют ноль открытых стоек.'
  : 'Each transaction reads two open counters. The writes affect different rows and together leave zero open counters.'}>
  <svg viewBox="0 0 330 164" class="fig-compact" role="img" aria-labelledby={id + '-title ' + id + '-desc'}>
    <title id={id + '-title'}>{title}</title>
    <desc id={id + '-desc'}>{ru ? 'T1 и T2 читают число 2. Первая закрывает A, вторая B. Итоговое число открытых стоек равно 0.' : 'T1 and T2 read 2. The first closes A and the second closes B. The final open count is 0.'}</desc>
    {steps.map(({ x, name, write }) => (
      <g>
        <text x={x} y="22" text-anchor="middle" class="f-title">{name}</text>
        <rect x={x - 71} y="31" width="142" height="34" rx="5" class="f-fill-blue" />
        <text x={x} y="53" text-anchor="middle">{ru ? 'Читает 2' : 'Reads 2'}</text>
        <path d={'M ' + x + ' 67 V 82'} class="f-axis" marker-end="url(#f-arrow-muted)" />
        <rect x={x - 71} y="88" width="142" height="34" rx="5" class="f-fill-amber" />
        <text x={x} y="111" text-anchor="middle">{write}</text>
      </g>
    ))}
    <text x="165" y="150" text-anchor="middle" class="f-t-red">{ru ? 'Открыто 0 стоек' : '0 open counters'}</text>
  </svg>
</Figure>
