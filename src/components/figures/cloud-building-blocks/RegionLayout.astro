---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A web service laid out over one region with three availability zones: a VPC of 10.0.0.0/16 with a public and a
// private /20 subnet per zone, a load balancer in the public subnets, two app instances per zone, a database primary
// with a synchronous standby in another zone, and regional object storage. Then zone 1 fails.
const zones = [1, 2, 3];
const pub = (z: number) => `10.0.${(z - 1) * 16}.0/20`;
const priv = (z: number) => `10.0.${128 + (z - 1) * 16}.0/20`;
// The six subnets are disjoint /20 blocks inside 10.0.0.0/16: third bytes 0, 16, 32 and 128, 144, 160.
const starts = zones.flatMap((z) => [(z - 1) * 16, 128 + (z - 1) * 16]);
if (new Set(starts).size !== 6 || starts.some((s) => s % 16 !== 0 || s + 16 > 256)) throw new Error('subnets overlap');
const t = ru
  ? {
      title: 'Сервис в одном регионе с тремя зонами доступности',
      users: 'пользователи', region: 'регион', vpc: 'VPC 10.0.0.0/16 на весь регион', zone: (z: number) => `зона ${z}`,
      lb: 'балансировщик в публичных подсетях всех зон', lbN: 'балансировщик',
      app: 'app', dbP: 'БД: ведущая', dbS: 'БД: резерв', repl: 'репликация', promoted: 'теперь ведущая', promotedN: '→ ведущая',
      pubL: 'публ.', privL: 'частн.',
      sgApp: 'SG app: 8080 только от LB', sgDb: 'SG БД: 5432 только от app', sgN: 'SG: app 8080 от LB, БД 5432 от app',
      obj: 'объектное хранилище: копии во всех зонах', objN: 'объектное хранилище',
      fail: 'отказ зоны 1',
      steps: [
        'регион состоит из нескольких зон: отдельное питание, охлаждение и сеть, несколько миллисекунд друг от друга',
        'VPC охватывает регион; в каждой зоне публичная и частная подсеть /20',
        'балансировщик распределяет запросы по инстансам во всех зонах; группы безопасности пускают к app только LB, к БД только app',
        'ведущая БД в зоне 1, синхронный резерв в зоне 2; объектное хранилище само хранит копии в разных зонах',
        'зона 1 отказывает: проверки здоровья выводят её инстансы из ротации, резерв становится ведущим, нагрузку несут зоны 2 и 3',
      ],
      desc: 'Регион с тремя зонами. Сверху балансировщик в публичных подсетях всех зон, под ним по два инстанса приложения в каждой зоне. В зоне 1 ведущая база данных, в зоне 2 её синхронный резерв, между ними стрелка репликации. В каждой зоне указаны публичная и частная подсети /20 внутри VPC 10.0.0.0/16. Группы безопасности пускают к приложению только балансировщик, к базе только приложение. Внизу объектное хранилище с копиями во всех зонах. На последнем шаге зона 1 перечёркнута, резерв в зоне 2 стал ведущим.',
    }
  : {
      title: 'A service in one region with three availability zones',
      users: 'users', region: 'region', vpc: 'VPC 10.0.0.0/16 spans the region', zone: (z: number) => `zone ${z}`,
      lb: 'load balancer in the public subnets of every zone', lbN: 'load balancer',
      app: 'app', dbP: 'DB primary', dbS: 'DB standby', repl: 'replication', promoted: 'now primary', promotedN: '→ primary',
      pubL: 'public', privL: 'private',
      sgApp: 'app SG: 8080 from LB only', sgDb: 'DB SG: 5432 from app only', sgN: 'SG: app 8080 from LB, DB 5432 from app',
      obj: 'object storage: copies in every zone', objN: 'object storage',
      fail: 'zone 1 fails',
      steps: [
        'a region is made of several zones: separate power, cooling and network, a few milliseconds apart',
        'the VPC spans the region; each zone has a public and a private /20 subnet',
        'the load balancer spreads requests over instances in every zone; security groups let only the LB reach the app and only the app reach the DB',
        'the DB primary is in zone 1 with a synchronous standby in zone 2; object storage keeps copies in several zones on its own',
        'zone 1 fails: health checks take its instances out, the standby becomes primary, zones 2 and 3 carry the load',
      ],
      desc: 'A region with three zones. At the top a load balancer in the public subnets of every zone, below it two app instances in each zone. In zone 1 the database primary, in zone 2 its synchronous standby, with a replication arrow between them. Each zone lists a public and a private /20 subnet inside the VPC 10.0.0.0/16. Security groups let only the load balancer reach the app and only the app reach the database. At the bottom object storage with copies in every zone. In the last step zone 1 is crossed out and the standby in zone 2 has become the primary.',
    };
// Label widths: f-small about 6.5 px per character (7.3 in the narrow layout), f-label 7.5 (8.0).
const fits = (s: string, room: number, px: number) => {
  if (s.length * px > room) throw new Error(`"${s}" needs ${Math.round(s.length * px)} px, has ${room}`);
};
fits(t.lb, 680, 7.5); fits(t.obj, 680, 7.5); fits(t.vpc, 740 - 120, 6.5);
// Subnet labels are monospace: about 7.5 px per character wide, 8.4 narrow (right-aligned at x = 338, clear of x = 96).
for (const z of zones) { fits(`${t.privL} ${priv(z)}`, 228 - 20, 7.5); fits(`${pub(z)}, ${priv(z)}`, 338 - 96, 8.4); }
for (const s of [t.sgApp, t.sgDb]) fits(s, 228 - 20, 6.5);
fits(t.repl, 276 - 180 - 8, 6.5); fits(t.repl, 344 - 86, 7.3);
for (const s of [t.dbP, t.dbS]) { fits(s, 150, 7.5); fits(s, 104, 8.0); }
fits(t.sgN, 328, 7.3); fits(t.lbN, 320, 8.0); fits(t.objN, 320, 8.0); fits(t.promoted, 150, 6.5); fits(t.promotedN, 112 - 26, 7.3);
const id = 'region-layout';
const caption = ru
  ? 'Зона доступности — один или несколько центров обработки данных с независимым питанием и сетью; регион — несколько зон в нескольких миллисекундах друг от друга. Сервис переживает отказ зоны, если в каждой зоне есть инстансы, балансировщик проверяет их здоровье, а данные реплицированы в другую зону: на шаге 5 зона 1 исчезает, а запросы продолжают обслуживать зоны 2 и 3. Регионального отказа такое размещение не переживает. Адреса подсетей — непересекающиеся блоки /20 внутри 10.0.0.0/16.'
  : 'An availability zone is one or more data centres with independent power and network; a region is several zones a few milliseconds apart. A service survives the loss of a zone when every zone has instances, the load balancer checks their health and the data is replicated to another zone: in step 5 zone 1 disappears and zones 2 and 3 keep serving. This layout does not survive the loss of the region. The subnets are disjoint /20 blocks inside 10.0.0.0/16.';
const zx = [20, 266, 512], zw = 228;
const nb = [108, 238, 368];
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 388" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <text class="f-small f-t-muted" x="380" y="16" text-anchor="middle">{t.users}</text>
    <Arrow pts={[[380, 22], [380, 86]]} />
    <g data-s="1">
      <rect x="8" y="30" width="744" height="350" rx="12" style="fill: none; stroke: var(--muted); stroke-width: 1.3" />
      <text class="f-small f-t-muted" x="18" y="48" style="font-weight: 650">{t.region}</text>
      {zones.map((z, i) => (
        <g>
          <rect x={zx[i]} y="58" width={zw} height="252" rx="9" style="fill: none; stroke: var(--muted); stroke-width: 1.1; stroke-dasharray: 5 4" />
          <text class="f-small" x={zx[i] + 10} y="78" style="font-weight: 650">{t.zone(z)}</text>
        </g>
      ))}
      <Badge x={752} y={30} n={1} />
    </g>
    <g data-s="2">
      <text class="f-small f-t-blue" x="740" y="48" text-anchor="end">{t.vpc}</text>
      {zones.map((z, i) => (
        <g>
          <text class="f-small f-t-blue" x={zx[i] + 10} y="282" font-family="var(--mono)">{`${t.pubL} ${pub(z)}`}</text>
          <text class="f-small f-t-blue" x={zx[i] + 10} y="300" font-family="var(--mono)">{`${t.privL} ${priv(z)}`}</text>
        </g>
      ))}
      <Badge x={20} y={318} n={2} />
    </g>
    <g data-s="3">
      <Box x={40} y={88} w={680} h={36} label={t.lb} tone="h" />
      {zones.map((z, i) => [0, 1].map((k) => (
        <g>
          <Arrow pts={[[zx[i] + 60 + k * 108, 126], [zx[i] + 60 + k * 108, 148]]} />
          <Box x={zx[i] + 10 + k * 108} y={150} w={100} h={36} label={t.app} tone="x" />
        </g>
      )))}
      <text class="f-small f-t-amber" x={zx[2] + 10} y="222">{t.sgApp}</text>
      <text class="f-small f-t-amber" x={zx[2] + 10} y="240">{t.sgDb}</text>
      <Badge x={720} y={88} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[zx[0] + 60, 188], [zx[0] + 60, 208]]} />
      <Box x={30} y={210} w={150} h={36} label={t.dbP} tone="g" />
      <Box x={276} y={210} w={150} h={36} label={t.dbS} tone="g" />
      <Arrow pts={[[182, 236], [274, 236]]} tone="amber" />
      <text class="f-small f-t-amber f-halo" x="228" y="228" text-anchor="middle">{t.repl}</text>
      <Box x={40} y={324} w={680} h={36} label={t.obj} tone="g" />
      <Badge x={720} y={324} n={4} />
    </g>
    <g data-s="5">
      <rect x={zx[0]} y="58" width={zw} height="252" rx="9" style="fill: var(--fig-red); fill-opacity: 0.12; stroke: var(--fig-red); stroke-width: 2" />
      <path class="f-line f-red" d={`M ${zx[0] + 12} 70 L ${zx[0] + zw - 12} 298 M ${zx[0] + zw - 12} 70 L ${zx[0] + 12} 298`} />
      <text class="f-small f-t-red f-halo" x={zx[0] + zw / 2} y="262" text-anchor="middle" style="font-weight: 650">{t.fail}</text>
      <rect x="276" y="210" width="150" height="36" rx="7" style="fill: none; stroke: var(--fig-green); stroke-width: 2.4" />
      <text class="f-small f-t-green f-halo" x="351" y="262" text-anchor="middle" style="font-weight: 650">{t.promoted}</text>
      <Badge x={244} y={62} n={5} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 590" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <text class="f-small f-t-muted" x="180" y="16" text-anchor="middle">{t.users}</text>
    <Arrow pts={[[180, 22], [180, 50]]} />
    <g data-s="1">
      <rect x="4" y="30" width="352" height="552" rx="12" style="fill: none; stroke: var(--muted); stroke-width: 1.3" />
      <text class="f-small f-t-muted" x="14" y="46" style="font-weight: 650">{t.region}</text>
      {zones.map((z, i) => (
        <g>
          <rect x="16" y={nb[i]} width="328" height="118" rx="9" style="fill: none; stroke: var(--muted); stroke-width: 1.1; stroke-dasharray: 5 4" />
          <text class="f-small" x="26" y={nb[i] + 20} style="font-weight: 650">{t.zone(z)}</text>
        </g>
      ))}
      <Badge x={344} y={30} n={1} />
    </g>
    <g data-s="2">
      {zones.map((z, i) => (
        <text class="f-small f-t-blue" x="338" y={nb[i] + 92} text-anchor="end" font-family="var(--mono)">{`${pub(z)}, ${priv(z)}`}</text>
      ))}
      <Badge x={330} y={nb[0] + 20} n={2} />
    </g>
    <g data-s="3">
      <Box x={20} y={52} w={320} h={36} label={t.lbN} tone="h" />
      <path class="f-line f-muted" d={`M 340 70 H 350 V ${nb[2] + 48}`} />
      {zones.map((z, i) => (
        <g>
          <Arrow pts={[[350, nb[i] + 48], [336, nb[i] + 48]]} />
          <Box x={140} y={nb[i] + 30} w={92} h={36} label={t.app} tone="x" />
          <Box x={242} y={nb[i] + 30} w={92} h={36} label={t.app} tone="x" />
        </g>
      ))}
      <text class="f-small f-t-amber" x="20" y={nb[2] + 140}>{t.sgN}</text>
      <Badge x={20} y={70} n={3} />
    </g>
    <g data-s="4">
      <Box x={26} y={nb[0] + 30} w={104} h={36} label={t.dbP} tone="g" />
      <Box x={26} y={nb[1] + 30} w={104} h={36} label={t.dbS} tone="g" />
      <Arrow pts={[[78, nb[0] + 68], [78, nb[1] + 28]]} tone="amber" />
      <text class="f-small f-t-amber f-halo" x="86" y={nb[0] + 110}>{t.repl}</text>
      <Box x={20} y={nb[2] + 156} w={320} h={36} label={t.objN} tone="g" />
      <Badge x={340} y={nb[2] + 156} n={4} />
    </g>
    <g data-s="5">
      <rect x="16" y={nb[0]} width="328" height="118" rx="9" style="fill: var(--fig-red); fill-opacity: 0.12; stroke: var(--fig-red); stroke-width: 2" />
      <path class="f-line f-red" d={`M 28 ${nb[0] + 10} L 332 ${nb[0] + 108} M 332 ${nb[0] + 10} L 28 ${nb[0] + 108}`} />
      <text class="f-small f-t-red f-halo" x="180" y={nb[0] + 20} text-anchor="middle" style="font-weight: 650">{t.fail}</text>
      <rect x="26" y={nb[1] + 30} width="104" height="36" rx="7" style="fill: none; stroke: var(--fig-green); stroke-width: 2.4" />
      <text class="f-small f-t-green f-halo" x="26" y={nb[1] + 86}>{t.promotedN}</text>
      <Badge x={16} y={nb[0]} n={5} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
