---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Monthly cost of one instance against the share of the month it is needed, under three pricing models.
// Toy prices: on demand $0.10 per hour, a one-year reservation $0.06 per hour paid for every hour of the month,
// spot capacity $0.03 per hour while it runs. A month is 730 hours.
const H = 730, d = 0.10, r = 0.06, s = 0.03;
const onDemand = (u: number) => d * u * H;
const reserved = () => r * H;
const spot = (u: number) => s * u * H;
const breakEven = r / d;
const near = (a: number, b: number) => Math.abs(a - b) < 1e-9;
if (!near(breakEven, 0.6)) throw new Error(`break-even ${breakEven}`);
if (!near(onDemand(1), 73) || !near(reserved(), 43.8) || !near(spot(1), 21.9)) throw new Error('monthly totals');
if (!near(onDemand(0.25), 18.25) || !near(breakEven * H, 438)) throw new Error('worked numbers');

const t = ru
  ? { od: 'по требованию, $0.10/ч', rs: 'резерв на год, $0.06/ч', sp: 'спотовые, $0.03/ч',
      x: 'доля месяца, когда инстанс нужен', y: '$ в месяц', be: 'равенство стоимостей при 60% (438 ч)', bes: '60%' }
  : { od: 'on demand, $0.10/h', rs: 'reserved for a year, $0.06/h', sp: 'spot, $0.03/h',
      x: 'share of the month the instance is needed', y: '$ per month', be: 'break-even at 60 % (438 h)', bes: '60 %' };
interface Layout { cls: string; W: number; H: number; box: [number, number, number, number]; legend: [number, number]; beLabel: string }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 330, box: [70, 20, 520, 270], legend: [540, 40], beLabel: t.be },
  { cls: 'fig-narrow', W: 360, H: 420, box: [52, 20, 340, 260], legend: [20, 336], beLabel: t.bes },
];
// Label widths: f-small about 6.5 px per character.
for (const L of layouts) {
  for (const l of [t.od, t.rs, t.sp]) if (L.legend[0] + 30 + l.length * 6.5 > L.W) throw new Error(`legend outside: ${l}`);
}
const id = 'cost-models';
---

<Figure
  id={id}
  title={ru ? 'Стоимость одного инстанса при трёх моделях оплаты' : 'The cost of one instance under three pricing models'}
  caption={ru
    ? 'Игрушечные цены: по требованию $0.10 в час, резерв на год $0.06 в час за каждый час месяца, используется он или нет, спотовые инстансы — $0.03 в час, пока они работают; месяц — 730 часов. Резерв стоит $43.80 в месяц всегда, по требованию — $73 за полный месяц и пропорционально меньше за неполный. Линии пересекаются при доле r/d = 0.06/0.10 = 60% месяца, 438 часов: инстанс, нужный дольше, выгоднее резервировать. Спотовые инстансы дешевле всего, но провайдер может забрать их с коротким предупреждением, поэтому они подходят только для работы, которую можно прервать.'
    : 'Toy prices: on demand $0.10 per hour, a one-year reservation $0.06 per hour for every hour of the month whether used or not, spot capacity $0.03 per hour while it runs; a month is 730 hours. The reservation always costs $43.80 a month, on demand $73 for a full month and proportionally less for part of one. The lines cross at the share r/d = 0.06/0.10 = 60 % of the month, 438 hours: an instance needed for longer is cheaper reserved. Spot capacity is the cheapest, but the provider can take it back at short notice, so it suits only work that can be interrupted.'}
>
  {layouts.map((L) => {
    const [x0, y0, x1, y1] = L.box;
    const sx = scale([0, 1], [x0, x1]);
    const sy = scale([0, 80], [y1, y0]);
    const bx = sx(breakEven), by = sy(reserved());
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Месячная стоимость в зависимости от доли месяца' : 'Monthly cost against the share of the month'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'По горизонтали доля месяца от 0 до 100%, по вертикали доллары в месяц от 0 до 80. Линия «по требованию» растёт от 0 до 73. Линия резерва горизонтальна на уровне 43.80. Линия спотовых инстансов растёт от 0 до 21.90. Линии по требованию и резерва пересекаются при 60%.'
          : 'Horizontal axis: share of the month from 0 to 100 %; vertical axis: dollars per month from 0 to 80. The on-demand line rises from 0 to 73. The reservation line is flat at 43.80. The spot line rises from 0 to 21.90. The on-demand and reservation lines cross at 60 %.'}</desc>
        {[0, 20, 40, 60, 80].map((v) => (
          <g>
            <path class="f-grid" d={`M ${x0} ${sy(v)} H ${x1}`} />
            <text class="f-note" x={x0 - 8} y={sy(v) + 5} text-anchor="end">{v}</text>
          </g>
        ))}
        {[0, 0.25, 0.5, 0.75, 1].map((u) => (
          <g>
            <path class="f-axis" d={`M ${sx(u)} ${y1} v 5`} />
            <text class="f-note" x={sx(u)} y={y1 + 20} text-anchor="middle">{`${u * 100} %`}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${x0} ${y0} V ${y1} H ${x1}`} />
        <text class="f-note" x={(x0 + x1) / 2} y={y1 + 42} text-anchor="middle">{t.x}</text>
        <text class="f-note" x={x0 + 6} y={y0 + 14}>$</text>
        <path class="f-line f-red f-bold" d={`M ${sx(0)} ${sy(0)} L ${sx(1)} ${sy(onDemand(1))}`} />
        <path class="f-line f-blue f-bold" d={`M ${sx(0)} ${sy(reserved())} L ${sx(1)} ${sy(reserved())}`} />
        <path class="f-line f-green f-bold f-dash" d={`M ${sx(0)} ${sy(0)} L ${sx(1)} ${sy(spot(1))}`} />
        <path class="f-thin f-muted f-dash" d={`M ${bx} ${by} V ${y1}`} />
        <circle cx={bx} cy={by} r="4.5" class="f-solid-muted" />
        <text class="f-small f-halo" x={bx - 8} y={by - 12} text-anchor="end">{L.beLabel}</text>
        {[[t.od, 'f-red', ''], [t.rs, 'f-blue', ''], [t.sp, 'f-green', ' f-dash']].map(([label, tone, dash], i) => (
          <g>
            <path class={`f-line f-bold ${tone}${dash}`} d={`M ${L.legend[0]} ${L.legend[1] + i * 24} h 22`} />
            <text class="f-small f-halo" x={L.legend[0] + 30} y={L.legend[1] + i * 24 + 4.5}>{label}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
