---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { names, n, G, c } from './diabetes';

const ru = pageLang(Astro.url) === 'ru';

// Ridge minimizes ‖y − Xw‖² + λ‖w‖², the lasso ‖y − Xw‖² + λ‖w‖₁, on the standardized diabetes data.
// Both need only G = XᵀX and c = Xᵀy: ridge solves (G + λI)w = c, the lasso runs coordinate descent,
// w_j ← S(c_j − Σ_{k≠j} G_jk w_k, λ/2) / G_jj with the soft threshold S(z, a) = sign(z) max(|z| − a, 0).
const d = c.length;
const solve = (A: number[][], b: number[]) => {
  const M = A.map((r, i) => [...r, b[i]]);
  for (let i = 0; i < d; i += 1) {
    let p = i;
    for (let r = i + 1; r < d; r += 1) if (Math.abs(M[r][i]) > Math.abs(M[p][i])) p = r;
    [M[i], M[p]] = [M[p], M[i]];
    for (let r = 0; r < d; r += 1) {
      if (r === i) continue;
      const f = M[r][i] / M[i][i];
      for (let k = i; k <= d; k += 1) M[r][k] -= f * M[i][k];
    }
  }
  return M.map((r, i) => r[d] / r[i]);
};
const ridge = (lam: number) => solve(G.map((r, i) => r.map((v, j) => v + (i === j ? lam : 0))), c);
const soft = (z: number, a: number) => Math.sign(z) * Math.max(Math.abs(z) - a, 0);
const lamMax = 2 * Math.max(...c.map(Math.abs));
const ridgeGrid = Array.from({ length: 121 }, (_, k) => 10 ** (-1 + (6 * k) / 120));
const lassoGrid = Array.from({ length: 141 }, (_, k) => lamMax * 10 ** (-3.5 + (3.5 * k) / 140));
// warm-started coordinate descent from the largest λ down
const lassoPath: number[][] = [];
{
  let w = new Array(d).fill(0);
  for (let k = lassoGrid.length - 1; k >= 0; k -= 1) {
    const lam = lassoGrid[k];
    for (let sweep = 0; sweep < 400; sweep += 1) {
      for (let j = 0; j < d; j += 1) {
        let r = c[j];
        for (let m = 0; m < d; m += 1) if (m !== j) r -= G[j][m] * w[m];
        w[j] = soft(r, lam / 2) / G[j][j];
      }
    }
    lassoPath[k] = [...w];
  }
}
const ridgePath = ridgeGrid.map(ridge);
const ols = ridge(0);
// the order in which features become nonzero as λ decreases
const order: string[] = [];
for (let k = lassoGrid.length - 1; k >= 0; k -= 1) lassoPath[k].forEach((v, j) => { if (v !== 0 && !order.includes(names[j])) order.push(names[j]); });
const got = [Math.round(lamMax), order.join(','), ols.map((v) => v.toFixed(1)).join(','), lassoPath[0].filter((v) => v !== 0).length].join(' | ');
if (got !== '39921 | bmi,s5,bp,s3,sex,s6,s1,s4,s2,age | -0.5,-11.4,24.7,15.4,-37.7,22.7,4.8,8.4,35.7,3.2 | 10') throw new Error(`RegularizationPath: drifted: ${got}`);
// the λ chosen by cross-validation in the note's Code section: ridge λ = 1, lasso α = 1 in scikit-learn's units, λ = 2nα
const lamLassoCV = 2 * n * 1;
const atCV: number[] = (() => { let best = 0; lassoGrid.forEach((l, k) => { if (Math.abs(Math.log(l / lamLassoCV)) < Math.abs(Math.log(lassoGrid[best] / lamLassoCV))) best = k; }); return lassoPath[best]; })();
const nnzCV = atCV.filter((v) => v !== 0).length;
if (nnzCV !== 7) throw new Error(`RegularizationPath: lasso at the CV choice has ${nnzCV} nonzero weights`);

const styleOf = (name: string) => ({ bmi: 'f-line f-blue f-bold', s5: 'f-line f-green f-bold', s1: 'f-line f-red f-bold', s2: 'f-line f-amber f-bold' } as Record<string, string>)[name] ?? 'f-thin f-muted';
const labelled = ['bmi', 's5', 's1', 's2', 'sex'];
const id = 'regularization-paths';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, panels: [[54, 30, 320, 250], [428, 30, 320, 250]] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 640, panels: [[50, 30, 260, 240], [50, 350, 260, 240]] },
];
const panelSpec = [
  { key: 'ridge', grid: ridgeGrid, path: ridgePath, lx: [-1, 5] as [number, number], ticks: [-1, 1, 3, 5], cv: 1, en: 'ridge: ‖y − Xw‖² + λ‖w‖²', ru: 'гребневая: ‖y − Xw‖² + λ‖w‖²' },
  { key: 'lasso', grid: lassoGrid, path: lassoPath, lx: [Math.log10(lamMax) - 3.5, Math.log10(lamMax)] as [number, number], ticks: [2, 3, 4], cv: lamLassoCV, en: 'lasso: ‖y − Xw‖² + λ‖w‖₁', ru: 'лассо: ‖y − Xw‖² + λ‖w‖₁' },
];
const tickLabel = (t: number) => `10${['⁻¹', '⁰', '¹', '²', '³', '⁴', '⁵'][t + 1]}`;
const yTicks = [-40, -20, 0, 20, 40].map((v) => ({ v, label: v < 0 ? `−${-v}` : String(v) }));
---

<Figure
  id={id}
  title={ru ? 'Пути коэффициентов гребневой регрессии и лассо' : 'Coefficient paths of ridge and the lasso'}
  caption={ru
    ? 'Данные о диабете (442 пациента, 10 стандартизованных признаков), коэффициенты как функции силы штрафа λ в логарифмическом масштабе; слева от каждой панели — решение МНК. Гребневая регрессия сжимает все коэффициенты плавно, и ни один не становится нулём; первыми сжимаются направления малой дисперсии, поэтому противоположные коэффициенты сильно коррелированных s1 и s2 (−37.7 и 22.7) быстро сближаются. Лассо обнуляет коэффициенты по одному: при λ ≥ 2·max|xⱼᵀy| = 39 921 все веса равны нулю, а при уменьшении λ признаки входят в модель в порядке bmi, s5, bp, s3, sex, s6, s1, s4, s2, age. Пунктир — λ, выбранная кросс-валидацией: 1 для гребневой регрессии (почти МНК) и 884 для лассо, где ненулевых весов 7.'
    : 'The diabetes data (442 patients, 10 standardized features), coefficients as functions of the penalty strength λ on a log scale; the left end of each panel is the least-squares solution. Ridge shrinks all coefficients smoothly and none of them reaches zero; directions of small variance shrink first, so the opposite coefficients of the strongly correlated s1 and s2 (−37.7 and 22.7) quickly move together. The lasso sets coefficients to zero one at a time: for λ ≥ 2·max|xⱼᵀy| = 39,921 all weights are zero, and as λ decreases the features enter in the order bmi, s5, bp, s3, sex, s6, s1, s4, s2, age. Dashed: the λ chosen by cross-validation, 1 for ridge (almost least squares) and 884 for the lasso, where 7 weights are nonzero.'}
>
  {layouts.map((Ly) => (
    <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
      <title id={`${id}-${Ly.sfx}-t`}>{ru ? 'Пути регуляризации на данных о диабете' : 'Regularization paths on the diabetes data'}</title>
      <desc id={`${id}-${Ly.sfx}-d`}>{ru
        ? 'Две панели с десятью кривыми коэффициентов. Слева гребневые кривые плавно сходятся к нулю при росте λ. Справа кривые лассо по очереди упираются в ноль и остаются в нём; последней обнуляется кривая bmi.'
        : 'Two panels with ten coefficient curves each. On the left the ridge curves converge smoothly to zero as λ grows. On the right the lasso curves hit zero one after another and stay there; the bmi curve is the last to reach zero.'}</desc>
      {panelSpec.map((P, j) => {
        const [bx, by, bw, bh] = Ly.panels[j];
        const sx = scale(P.lx, [bx, bx + bw]), sy = scale([-42, 42], [by + bh, by]);
        const clip = `${id}-${Ly.sfx}-${j}`;
        const ends = names.map((nm, f) => ({ nm, v: P.path[0][f] })).filter((e) => labelled.includes(e.nm));
        return (
          <g>
            <defs><clipPath id={clip}><rect x={bx} y={by} width={bw} height={bh} /></clipPath></defs>
            <text class="f-small" x={bx} y={by - 12}>{ru ? P.ru : P.en}</text>
            {[-40, -20, 20, 40].map((v) => <path class="f-grid" d={`M ${bx} ${sy(v)} H ${bx + bw}`} />)}
            <path class="f-axis" d={`M ${bx} ${sy(0)} H ${bx + bw} M ${bx} ${by} V ${by + bh}`} />
            {yTicks.map((t) => <text class="f-note" x={bx - 6} y={sy(t.v) + 5} text-anchor="end">{t.label}</text>)}
            {P.ticks.map((t) => <text class="f-note" x={sx(t)} y={by + bh + 18} text-anchor="middle">{tickLabel(t)}</text>)}
            <text class="f-small" x={bx + bw} y={by + bh + 38} text-anchor="end">λ</text>
            <path class="f-thin f-muted f-dash" d={`M ${sx(Math.log10(P.cv))} ${by} V ${by + bh}`} />
            <g clip-path={`url(#${clip})`}>
              {names.map((nm, f) => <path class={styleOf(nm)} d={polyline(P.grid.map((l, k) => [sx(Math.log10(l)), sy(P.path[k][f])] as [number, number]))} />)}
            </g>
            {ends.map((e) => <text class="f-note f-halo" x={bx + 5} y={sy(e.v) + (e.nm === 's2' ? 14 : -5)}>{e.nm}</text>)}
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
