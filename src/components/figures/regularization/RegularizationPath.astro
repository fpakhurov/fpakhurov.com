---
import Figure from '../Figure.astro';
import { scale, polyline } from '../regressionGeometry';
import { pageLang } from '../../../utils/lang';
import fixture from './synthetic-regression.json';
const { names, n, G, c, ridgeCV, lassoAlphaCV } = fixture;

const ru = pageLang(Astro.url) === 'ru';

// Ridge minimizes ‖y − Xw‖² + λ‖w‖², the lasso ‖y − Xw‖² + λ‖w‖₁, on the original synthetic sensor fixture.
// Both need only G = XᵀX and c = Xᵀy: ridge solves (G + λI)w = c, the lasso runs coordinate descent,
// w_j ← S(c_j − Σ_{k≠j} G_jk w_k, λ/2) / G_jj with the soft threshold S(z, a) = sign(z) max(|z| − a, 0).
const d = c.length;
const solve = (A: number[][], b: number[]) => {
  const M = A.map((r, i) => [...r, b[i]]);
  for (let i = 0; i < d; i += 1) {
    let p = i;
    for (let r = i + 1; r < d; r += 1) if (Math.abs(M[r][i]) > Math.abs(M[p][i])) p = r;
    [M[i], M[p]] = [M[p], M[i]];
    for (let r = 0; r < d; r += 1) {
      if (r === i) continue;
      const f = M[r][i] / M[i][i];
      for (let k = i; k <= d; k += 1) M[r][k] -= f * M[i][k];
    }
  }
  return M.map((r, i) => r[d] / r[i]);
};
const ridge = (lam: number) => solve(G.map((r, i) => r.map((v, j) => v + (i === j ? lam : 0))), c);
const soft = (z: number, a: number) => Math.sign(z) * Math.max(Math.abs(z) - a, 0);
const lamMax = 2 * Math.max(...c.map(Math.abs));
const ridgeGrid = Array.from({ length: 121 }, (_, k) => 10 ** (-1 + (6 * k) / 120));
const lassoGrid = Array.from({ length: 141 }, (_, k) => lamMax * 10 ** (-3.5 + (3.5 * k) / 140));
// warm-started coordinate descent from the largest λ down
const lassoPath: number[][] = [];
{
  let w = new Array(d).fill(0);
  for (let k = lassoGrid.length - 1; k >= 0; k -= 1) {
    const lam = lassoGrid[k];
    for (let sweep = 0; sweep < 12000; sweep += 1) {
      const before = [...w];
      for (let j = 0; j < d; j += 1) {
        let r = c[j];
        for (let m = 0; m < d; m += 1) if (m !== j) r -= G[j][m] * w[m];
        w[j] = soft(r, lam / 2) / G[j][j];
      }
      if (Math.max(...w.map((v, j) => Math.abs(v - before[j]))) < 1e-10) break;
    }
    lassoPath[k] = [...w];
  }
}
const ridgePath = ridgeGrid.map(ridge);
const ols = ridge(0);
// the order in which features become nonzero as λ decreases
const order: string[] = [];
for (let k = lassoGrid.length - 1; k >= 0; k -= 1) lassoPath[k].forEach((v, j) => { if (v !== 0 && !order.includes(names[j])) order.push(names[j]); });
const got = [lamMax.toFixed(2), ols.map((v) => v.toFixed(2)).join(',')].join(' | ');
if (got !== '3890.52 | 7.31,0.83,-3.38,2.01,-0.36,0.11,0.46,0.03') throw new Error(`RegularizationPath: drifted: ${got}`);
// Full-data paths are descriptive. The dashed settings were selected using fold-local transformations.
const lamLassoCV = 2 * n * lassoAlphaCV;

const styleOf = (name: string) => ({ sensor_a: 'f-line f-blue f-bold', ambient: 'f-line f-green f-bold', control: 'f-line f-red f-bold', sensor_b: 'f-line f-amber f-bold' } as Record<string, string>)[name] ?? 'f-thin f-muted';
const labelled = ['sensor_a', 'control', 'ambient'];
const labelOf = (name: string) => name === 'sensor_a' ? 'sensor a' : name;
const id = 'regularization-paths';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, panels: [[54, 30, 320, 250], [428, 30, 320, 250]] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 640, panels: [[50, 30, 260, 240], [50, 350, 260, 240]] },
];
const panelSpec = [
  { key: 'ridge', grid: ridgeGrid, path: ridgePath, lx: [-1, 5] as [number, number], ticks: [-1, 1, 3, 5], cv: ridgeCV, en: 'ridge: ‖y − Xw‖² + λ‖w‖²', ru: 'гребневая: ‖y − Xw‖² + λ‖w‖²' },
  { key: 'lasso', grid: lassoGrid, path: lassoPath, lx: [Math.log10(lamMax) - 3.5, Math.log10(lamMax)] as [number, number], ticks: [1, 2, 3], cv: lamLassoCV, en: 'lasso: ‖y − Xw‖² + λ‖w‖₁', ru: 'лассо: ‖y − Xw‖² + λ‖w‖₁' },
];
const tickLabel = (t: number) => `10${['⁻¹', '⁰', '¹', '²', '³', '⁴', '⁵'][t + 1]}`;
const yTicks = [-4, 0, 4, 8].map((v) => ({ v, label: v < 0 ? `−${-v}` : String(v) }));
---

<Figure
  id={id}
  title={ru ? 'Пути коэффициентов гребневой регрессии и лассо' : 'Coefficient paths of ridge and the lasso'}
  caption={ru
    ? 'Заново заданные синтетические сигналы: 240 строк, восемь стандартизованных признаков. Все пути вычисляются из новых G = XᵀX и c = Xᵀy; внешних данных здесь нет. По горизонтали растёт λ. Почти дублирующиеся sensor_a и sensor_b имеют веса МНК 7.31 и 0.83; гребневая регрессия уменьшает перекос. Лассо достигает полностью нулевого решения при λ = 3890.52. Пунктир показывает параметры, выбранные на пяти фолдах: λ = 1 для гребневой регрессии и λ = 48 для лассо (α = 0.1); после обучения на всех строках лассо оставляет семь весов. Левый край показывает малый положительный штраф, а не ровно нулевой.'
    : 'Newly specified synthetic signals: 240 rows and eight standardized features. Every path is calculated from the new G = XᵀX and c = Xᵀy; no external data is used. The horizontal axis increases λ. Nearly duplicated sensor_a and sensor_b have least-squares weights 7.31 and 0.83; ridge reduces the imbalance. Lasso reaches the all-zero solution at λ = 3890.52. Dashed lines mark settings selected on five folds: λ = 1 for ridge and λ = 48 for lasso (α = 0.1); after fitting all rows lasso retains seven weights. The left edge has a small positive penalty, not exactly zero.'}
>
  {layouts.map((Ly) => (
    <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
      <title id={`${id}-${Ly.sfx}-t`}>{ru ? 'Пути регуляризации на синтетических сигналах' : 'Regularization paths on synthetic signals'}</title>
      <desc id={`${id}-${Ly.sfx}-d`}>{ru
        ? 'Две панели с восемью кривыми коэффициентов. Слева гребневые кривые плавно сходятся к нулю при росте λ. Справа кривые лассо по очереди упираются в ноль и остаются в нём; последней обнуляется кривая sensor_a.'
        : 'Two panels with eight coefficient curves each. On the left the ridge curves converge smoothly to zero as λ grows. On the right the lasso curves hit zero one after another and stay there; the sensor_a curve is the last to reach zero.'}</desc>
      {panelSpec.map((P, j) => {
        const [bx, by, bw, bh] = Ly.panels[j];
        const sx = scale(P.lx, [bx, bx + bw]), sy = scale([-4.2, 8.5], [by + bh, by]);
        const clip = `${id}-${Ly.sfx}-${j}`;
        const ends = names.map((nm, f) => ({ nm, v: P.path[0][f] })).filter((e) => labelled.includes(e.nm));
        return (
          <g>
            <defs><clipPath id={clip}><rect x={bx} y={by} width={bw} height={bh} /></clipPath></defs>
            <text class="f-small" x={bx} y={by - 12}>{ru ? P.ru : P.en}</text>
            {[-4, 4, 8].map((v) => <path class="f-grid" d={`M ${bx} ${sy(v)} H ${bx + bw}`} />)}
            <path class="f-axis" d={`M ${bx} ${sy(0)} H ${bx + bw} M ${bx} ${by} V ${by + bh}`} />
            {yTicks.map((t) => <text class="f-note" x={bx - 6} y={sy(t.v) + 5} text-anchor="end">{t.label}</text>)}
            {P.ticks.map((t) => <text class="f-note" x={sx(t)} y={by + bh + 18} text-anchor="middle">{tickLabel(t)}</text>)}
            <text class="f-small" x={bx + bw} y={by + bh + 38} text-anchor="end">λ</text>
            <path class="f-thin f-muted f-dash" d={`M ${sx(Math.log10(P.cv))} ${by} V ${by + bh}`} />
            <g clip-path={`url(#${clip})`}>
              {names.map((nm, f) => <path class={styleOf(nm)} d={polyline(P.grid.map((l, k) => [sx(Math.log10(l)), sy(P.path[k][f])] as [number, number]))} />)}
            </g>
            {ends.map((e) => <text class="f-note f-halo" x={bx + 5} y={sy(e.v) + -5}>{labelOf(e.nm)}</text>)}
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
