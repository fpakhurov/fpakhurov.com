---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The constrained form of ridge and the lasso in two dimensions. The loss is the quadratic
// f(w) = ½ (w − ŵ)ᵀ M (w − ŵ) with the least-squares solution ŵ = (0.8, 2.2) and M = [[1, 0.5], [0.5, 1]];
// the constraint is ‖w‖₂ ≤ 1 (ridge) or ‖w‖₁ ≤ 1 (lasso). The solution is where the smallest contour of f
// touches the constraint set.
type V = [number, number];
const wh: V = [0.8, 2.2];
const M = [[1, 0.5], [0.5, 1]];
const f = (w: V) => { const d0 = w[0] - wh[0], d1 = w[1] - wh[1]; return 0.5 * (M[0][0] * d0 * d0 + 2 * M[0][1] * d0 * d1 + M[1][1] * d1 * d1); };
// ridge: w(λ) = (M + λI)⁻¹ M ŵ, with λ found by bisection so that ‖w(λ)‖ = 1
const wl = (lam: number): V => {
  const a = M[0][0] + lam, b = M[0][1], dd = M[1][1] + lam, det = a * dd - b * b;
  const r0 = M[0][0] * wh[0] + M[0][1] * wh[1], r1 = M[1][0] * wh[0] + M[1][1] * wh[1];
  return [(dd * r0 - b * r1) / det, (a * r1 - b * r0) / det];
};
let lo = 0, hi = 100;
for (let k = 0; k < 200; k += 1) { const mid = (lo + hi) / 2; if (Math.hypot(...wl(mid)) > 1) lo = mid; else hi = mid; }
const wRidge = wl(hi);
// lasso: minimize f on each edge of the diamond |w₁| + |w₂| = 1 (f is a convex quadratic in the edge parameter)
const corners: V[] = [[1, 0], [0, 1], [-1, 0], [0, -1]];
let wLasso: V = corners[0];
for (let e = 0; e < 4; e += 1) {
  const A = corners[e], B = corners[(e + 1) % 4];
  const g = (t: number): V => [A[0] + t * (B[0] - A[0]), A[1] + t * (B[1] - A[1])];
  let a = 0, b = 1;
  for (let k = 0; k < 200; k += 1) { const m1 = a + (b - a) / 3, m2 = b - (b - a) / 3; if (f(g(m1)) < f(g(m2))) b = m2; else a = m1; }
  const t = (a + b) / 2;
  if (f(g(t)) < f(wLasso)) wLasso = g(t);
}
const r3 = (v: V) => v.map((x) => (Math.abs(x) < 5e-4 ? 0 : x).toFixed(3)).join(',');
const got = `${r3(wRidge)} ${r3(wLasso)} ${f(wRidge).toFixed(3)} ${f(wLasso).toFixed(3)}`;
if (got !== '0.535,0.845 0.000,1.000 1.133 1.520') throw new Error(`NormBalls: solutions drifted: ${got}`);
// at the corner (0, 1) the negative gradient −M(w − ŵ) = (1.4, 1.6) lies strictly inside the cone spanned by the
// normals of the two edges meeting there, (1, 1) and (−1, 1): the corner is optimal, and stays optimal under small changes
const ng: V = [-(M[0][0] * (0 - wh[0]) + M[0][1] * (1 - wh[1])), -(M[1][0] * (0 - wh[0]) + M[1][1] * (1 - wh[1]))];
if (ng.map((v) => v.toFixed(1)).join() !== '1.4,1.6' || !(Math.abs(ng[0]) < ng[1])) throw new Error('NormBalls: corner condition failed');

// eigen-decomposition of M for the contour ellipses: eigenvalues 1.5 along (1, 1)/√2 and 0.5 along (1, −1)/√2
const u1: V = [Math.SQRT1_2, Math.SQRT1_2], u2: V = [Math.SQRT1_2, -Math.SQRT1_2];
const ellipse = (c: number) => Array.from({ length: 121 }, (_, k) => {
  const th = (2 * Math.PI * k) / 120, a = Math.sqrt((2 * c) / 1.5) * Math.cos(th), b = Math.sqrt((2 * c) / 0.5) * Math.sin(th);
  return [wh[0] + a * u1[0] + b * u2[0], wh[1] + a * u1[1] + b * u2[1]] as V;
});
const panels = [
  { key: 'ridge', sol: wRidge, fs: f(wRidge), region: Array.from({ length: 121 }, (_, k) => [Math.cos((2 * Math.PI * k) / 120), Math.sin((2 * Math.PI * k) / 120)] as V),
    en: 'ridge: ‖w‖₂ ≤ 1', ru: 'гребневая: ‖w‖₂ ≤ 1', solEn: 'w = (0.54, 0.85)', solRu: 'w = (0.54, 0.85)' },
  { key: 'lasso', sol: wLasso, fs: f(wLasso), region: [...corners, corners[0]],
    en: 'lasso: ‖w‖₁ ≤ 1', ru: 'лассо: ‖w‖₁ ≤ 1', solEn: 'w = (0, 1)', solRu: 'w = (0, 1)' },
];
const dom = { x: [-1.5, 2.5] as V, y: [-1.3, 3.3] as V };
const id = 'regularization-norm-balls';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 350, unit: 66, boxes: [[70, 34], [440, 34]] as V[] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 712, unit: 70, boxes: [[40, 30], [40, 384]] as V[] },
];
---

<Figure
  id={id}
  title={ru ? 'Почему лассо обнуляет веса, а гребневая регрессия нет' : 'Why the lasso zeroes weights and ridge does not'}
  caption={ru
    ? 'Задача с ограничением в двух измерениях. Эллипсы — линии уровня квадратичной функции потерь вокруг решения МНК ŵ = (0.8, 2.2); затенено допустимое множество: круг ‖w‖₂ ≤ 1 для гребневой регрессии и ромб ‖w‖₁ ≤ 1 для лассо. Решение — точка, где самый маленький эллипс касается множества (жирная линия). Граница круга гладкая, эллипс касается её в точке общего положения, (0.54, 0.85), и оба веса ненулевые. У ромба есть углы на осях; эллипс, подходящий с широкого диапазона направлений, первым задевает угол (0, 1), и вес w₁ становится ровно нулём. Значения потерь в решениях: 1.133 и 1.520.'
    : 'The constrained problem in two dimensions. The ellipses are contours of the quadratic loss around the least-squares solution ŵ = (0.8, 2.2); the shaded set is the constraint: the disc ‖w‖₂ ≤ 1 for ridge and the diamond ‖w‖₁ ≤ 1 for the lasso. The solution is where the smallest ellipse touches the set (bold contour). The disc has a smooth boundary, the ellipse touches it at a generic point, (0.54, 0.85), and both weights are nonzero. The diamond has corners on the axes; an ellipse approaching from a wide range of directions hits a corner first, here (0, 1), and the weight w₁ becomes exactly zero. The losses at the solutions are 1.133 and 1.520.'}
>
  {layouts.map((Ly) => (
    <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
      <title id={`${id}-${Ly.sfx}-t`}>{ru ? 'Линии уровня и допустимые множества L2 и L1' : 'Loss contours and the L2 and L1 constraint sets'}</title>
      <desc id={`${id}-${Ly.sfx}-d`}>{ru
        ? 'Две панели. В каждой — наклонные эллипсы вокруг точки ŵ в первом квадранте. Слева затенённый круг, жирный эллипс касается его в точке с двумя положительными координатами. Справа затенённый ромб, жирный эллипс касается его верхнего угла на оси w₂.'
        : 'Two panels. Each shows tilted ellipses around the point ŵ in the first quadrant. On the left a shaded disc, which the bold ellipse touches at a point with two positive coordinates. On the right a shaded diamond, which the bold ellipse touches at its top corner on the w₂ axis.'}</desc>
      {panels.map((p, j) => {
        const [bx, by] = Ly.boxes[j];
        const w = Ly.unit * (dom.x[1] - dom.x[0]), h = Ly.unit * (dom.y[1] - dom.y[0]);
        const sx = scale(dom.x, [bx, bx + w]), sy = scale(dom.y, [by + h, by]);
        const S = (v: V) => [sx(v[0]), sy(v[1])] as [number, number];
        const clip = `${id}-${Ly.sfx}-${j}`;
        return (
          <g>
            <defs><clipPath id={clip}><rect x={bx} y={by} width={w} height={h} /></clipPath></defs>
            <text class="f-small" x={bx} y={by - 12}>{ru ? p.ru : p.en}</text>
            <g clip-path={`url(#${clip})`}>
              <path class="f-axis" d={`M ${bx} ${sy(0)} H ${bx + w} M ${sx(0)} ${by} V ${by + h}`} />
              <path class="f-fill-blue" style="stroke: var(--fig-blue); stroke-width: 1.4" d={polyline(p.region.map(S)) + ' Z'} />
              {[0.25, 0.55].map((k) => <path class="f-thin f-muted" style="stroke-opacity: .6" d={polyline(ellipse(k * p.fs).map(S)) + ' Z'} />)}
              {[1.8, 3.0].map((k) => <path class="f-thin f-muted" style="stroke-opacity: .6" d={polyline(ellipse(k * p.fs).map(S)) + ' Z'} />)}
              <path class="f-line f-red f-bold" d={polyline(ellipse(p.fs).map(S)) + ' Z'} />
            </g>
            <text class="f-note f-halo" x={bx + w - 4} y={sy(0) - 7} text-anchor="end">w₁</text>
            <text class="f-note f-halo" x={sx(0) + 7} y={by + 14}>w₂</text>
            <circle cx={S(wh)[0]} cy={S(wh)[1]} r="4" class="f-solid-muted" style="fill: var(--ink)" />
            <text class="f-small f-halo" x={S(wh)[0] + 9} y={S(wh)[1] + 4}>{ru ? 'ŵ (МНК)' : 'ŵ (least squares)'}</text>
            <circle cx={S(p.sol)[0]} cy={S(p.sol)[1]} r="5" class="f-solid-red" />
            <path class="f-thin f-red" d={`M ${S(p.sol)[0]} ${S(p.sol)[1]} L ${S([1.2, -0.62])[0]} ${S([1.2, -0.62])[1]}`} />
            <text class="f-small f-t-red f-halo" x={S([1.2, -0.62])[0] + 4} y={S([1.2, -0.62])[1] + 16}>{ru ? p.solRu : p.solEn}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
