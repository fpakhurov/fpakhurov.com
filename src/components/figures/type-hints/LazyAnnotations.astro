---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar, type Tone } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Deferred evaluation of annotations in Python 3.14 (PEP 649, PEP 749), traced on the session of the note:
// def link(node: Node) -> Node | None runs before class Node exists, and nothing fails until annotations are asked for.
// The outputs are those of CPython 3.14.7 for that session.
interface Line { s: string; cls?: string }
interface Row { tone: Tone; title: string; lines: Line[] }
const rows: Row[] = ru
  ? [
      { tone: 'x', title: 'def выполняется: аннотации не вычисляются', lines: [{ s: 'def link(node: Node) -> Node | None:' }, { s: '__annotate__: функция, ещё не вызвана', cls: 'f-t-muted' }] },
      { tone: 'x', title: 'класс Node определён позже', lines: [{ s: 'class Node: ...' }] },
      { tone: 'h', title: 'первое обращение вычисляет и кэширует', lines: [{ s: 'link.__annotations__' }, { s: "→ {'node': Node," }, { s: "   'return': Node | None}" }] },
      { tone: 'g', title: 'другие форматы, без вычисления', lines: [{ s: 'get_annotations(link, format=STRING)' }, { s: "→ {'node': 'Node', 'return': …}" }, { s: 'FORWARDREF: нет имени → ForwardRef' }] },
      { tone: 'y', title: 'проверяющая программа читает текст', lines: [{ s: 'mypy, pyright: код не выполняется' }, { s: 'ошибки — до запуска программы' }] },
    ]
  : [
      { tone: 'x', title: 'def runs: annotations are not evaluated', lines: [{ s: 'def link(node: Node) -> Node | None:' }, { s: '__annotate__: a function, not yet run', cls: 'f-t-muted' }] },
      { tone: 'x', title: 'class Node is defined later', lines: [{ s: 'class Node: ...' }] },
      { tone: 'h', title: 'first access evaluates and caches', lines: [{ s: 'link.__annotations__' }, { s: "→ {'node': Node," }, { s: "   'return': Node | None}" }] },
      { tone: 'g', title: 'other formats, without evaluating', lines: [{ s: 'get_annotations(link, format=STRING)' }, { s: "→ {'node': 'Node', 'return': …}" }, { s: 'FORWARDREF: ForwardRef if undefined' }] },
      { tone: 'y', title: 'a type checker reads the source', lines: [{ s: 'mypy, pyright: no code runs' }, { s: 'errors come before the program runs' }] },
    ];
const steps = ru
  ? ['def создаёт функцию и сохраняет __annotate__; имя Node ещё не нужно', 'класс Node определяется после функции', 'link.__annotations__ вызывает __annotate__, вычисляет аннотации и запоминает словарь', 'annotationlib возвращает аннотации строками или как ForwardRef, ничего не вычисляя', 'mypy и pyright проверяют аннотации по исходному тексту, не запуская код']
  : ['def creates the function and stores __annotate__; the name Node is not needed yet', 'the class Node is defined after the function', 'link.__annotations__ calls __annotate__, evaluates the annotations and caches the dict', 'annotationlib returns the annotations as strings or ForwardRef objects, evaluating nothing', 'mypy and pyright check the annotations from the source text, without running it'];

interface Layout { cls: string; W: number; bx: number; bw: number; head: number; lh: number; gap: number; detailX: number; detailTop: number; mono: number; sans: number; badgeX: number; titleW: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, bx: 40, bw: 700, head: 24, lh: 18, gap: 14, detailX: 330, detailTop: 0, mono: 7.5, sans: 6.5, badgeX: 20, titleW: 316 },
  { cls: 'fig-narrow seq-narrow', W: 360, bx: 30, bw: 324, head: 24, lh: 20, gap: 14, detailX: 8, detailTop: 26, mono: 8.4, sans: 7.3, badgeX: 15, titleW: 318 },
];
const geom = layouts.map((L) => {
  let y = 12;
  const ys = rows.map((r) => {
    const h = Math.max(L.detailTop + r.lines.length * L.lh + 14, 40);
    const top = y;
    y += h + L.gap;
    return { top, h };
  });
  for (const r of rows) {
    if (10 + r.title.length * L.sans > L.titleW) throw new Error(`title "${r.title}" at ${L.W}`);
    for (const l of r.lines) if (L.detailX + l.s.length * L.mono > L.bw - 4) throw new Error(`line "${l.s}" at ${L.W}`);
  }
  return { ys, H: y - L.gap + 10 };
});
const id = 'lazy-annotations';
---

<Figure
  id={id}
  title={ru ? 'Что происходит с аннотациями в Python 3.14' : 'What happens to annotations in Python 3.14'}
  caption={ru
    ? 'Отложенное вычисление аннотаций (PEP 649 и PEP 749), на примере из заметки. Когда выполняется def, аннотации не вычисляются: компилятор сохраняет функцию __annotate__, которая вычислит их позже (1). Поэтому аннотация может ссылаться на класс Node, определённый после функции (2). Первое обращение к link.__annotations__ вызывает __annotate__ и запоминает получившийся словарь (3). Модуль annotationlib умеет вернуть те же аннотации строками или объектами ForwardRef, ничего не вычисляя (4). Проверяющая программа, такая как mypy или pyright, читает исходный текст и не выполняет его (5). Зелёным отмечен код, синим — то, что хранится во время выполнения, жёлтым — способы прочитать аннотации, красным — статическая проверка.'
    : 'Deferred evaluation of annotations (PEP 649 and PEP 749), on the example of the note. When def runs, the annotations are not evaluated: the compiler stores a function __annotate__ that will evaluate them later (1). That is why an annotation can refer to the class Node, defined after the function (2). The first access to link.__annotations__ calls __annotate__ and caches the resulting dict (3). The module annotationlib can return the same annotations as strings or ForwardRef objects, evaluating nothing (4). A type checker such as mypy or pyright reads the source text and never runs it (5). Green marks code, blue what is stored at run time, amber the ways to read annotations, red the static check.'}
>
  {layouts.map((L, li) => {
    const { ys, H } = geom[li];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Пять стадий жизни аннотации' : 'Five stages in the life of an annotation'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Пять блоков сверху вниз: def сохраняет __annotate__ без вычисления; класс Node определяется позже; обращение к __annotations__ вычисляет словарь; annotationlib возвращает строки или ForwardRef; проверяющая программа читает текст без выполнения.'
          : 'Five boxes from top to bottom: def stores __annotate__ without evaluating; the class Node is defined later; accessing __annotations__ evaluates the dict; annotationlib returns strings or ForwardRef objects; a type checker reads the text without running it.'}</desc>
        {rows.map((r, k) => {
          const { top, h } = ys[k];
          return (
            <g data-s={String(k + 1)}>
              <rect x={L.bx} y={top} width={L.bw} height={h} rx="7" style={`fill: ${toneVar[r.tone]}; fill-opacity: 0.1; stroke: ${toneVar[r.tone]}; stroke-width: 1.2`} />
              <text class="f-small" x={L.bx + 10} y={top + L.head - 2} style="font-weight: 650">{r.title}</text>
              {r.lines.map((l, i) => (
                <text class={`f-small ${l.cls ?? ''}`} x={L.bx + L.detailX} y={top + L.head - 2 + L.detailTop + i * L.lh} style="font-family: var(--mono)">{l.s}</text>
              ))}
              <Badge x={L.badgeX} y={top + 18} n={k + 1} />
            </g>
          );
        })}
      </svg>
    );
  })}
  <Stepper steps={steps} />
</Figure>
