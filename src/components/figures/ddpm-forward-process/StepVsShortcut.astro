---
import Figure from '../Figure.astro';

const id = 'ddpm-forward-process-shortcut';
// α + combining overline, set in the sans font: in the serif italic, α (and U+1FB1 ᾱ) reads as a Latin ā.
const AB = 'α\u0305';

type Layout = {
  cls: string;
  vb: string;
  r: number;
  xs: number[]; // x0, x1, x2, xt
  dots: number;
  stepLabels: boolean;
  rows: { title: number; node: number }[];
  arcDepth: number;
  titleX: number;
};

const layouts: Record<string, Layout> = {
  w: { cls: 'fig-wide', vb: '0 0 640 462', r: 23, xs: [70, 200, 330, 560], dots: 445, stepLabels: true, rows: [{ title: 22, node: 92 }, { title: 256, node: 326 }], arcDepth: 58, titleX: 20 },
  n: { cls: 'fig-narrow', vb: '0 0 360 415', r: 19, xs: [36, 112, 188, 324], dots: 256, stepLabels: false, rows: [{ title: 20, node: 72 }, { title: 240, node: 292 }], arcDepth: 50, titleX: 6 },
};

const rows = [
  {
    key: 'naive',
    title: 'Naive: xₜ = xₜ₋₁ + √β ε',
    step: ['+ √β ε'],
    shortcut: ['q(xₜ | x₀) = N(x₀, tβ)'],
    verdict: 'mean stays x₀, variance tβ → ∞: never N(0, 1)',
    tone: 'red',
  },
  {
    key: 'ddpm',
    title: 'DDPM: xₜ = √(1 − β) xₜ₋₁ + √β ε',
    step: ['× √(1 − β)', '+ √β ε'],
    shortcut: ['q(xₜ | x₀) = N(√', AB, 'ₜ x₀, 1 − ', AB, 'ₜ)'],
    verdict: `${AB}ₜ = (1 − β)ᵗ → 0, so → N(0, 1)`,
    tone: 'green',
  },
];
const names = [['x', '0'], ['x', '1'], ['x', '2'], ['x', 't']];
---

<Figure
  id={id}
  title="One step at a time, or straight from x₀ to xₜ"
  caption="Single steps and one-jump shortcuts for the two chains. Both add fresh Gaussian noise ε ~ N(0, 1) at every step, and in both the t steps collapse into one Gaussian jump q(xₜ | x₀), so xₜ can be sampled directly. Without rescaling (top) the jump keeps the mean at x₀ and its variance grows without bound. Scaling by √(1 − β) at each step (bottom) shrinks the mean and keeps the conditional variance 1 − α̅ₜ below 1, so the chain approaches N(0, 1). The second argument of N is the variance."
>
  {Object.entries(layouts).map(([sfx, L]) => (
    <svg class={L.cls} viewBox={L.vb} role="img" aria-labelledby={`${id}-${sfx}-t ${id}-${sfx}-d`}>
      <title id={`${id}-${sfx}-t`}>Naive and DDPM noising chains with their one-jump shortcuts</title>
      <desc id={`${id}-${sfx}-d`}>Two rows of circled nodes x0, x1, x2, an ellipsis and xt joined by step arrows. Top row, naive: each step adds square root of beta times epsilon; a long arc from x0 to xt is labelled q of xt given x0 equals N of x0 and t beta, with a red warning that the mean stays x0 and the variance t beta goes to infinity, so the chain never reaches N(0, 1). Bottom row, DDPM: each step multiplies by the square root of 1 minus beta and adds square root of beta times epsilon; the long arc is labelled q of xt given x0 equals N of square root of alpha bar t times x0 and 1 minus alpha bar t, with a green note that alpha bar t equals 1 minus beta to the power t, which goes to zero, so the chain approaches N(0, 1).</desc>

      {rows.map((row, k) => {
        const g = L.rows[k];
        const y = g.node;
        const arcStart = L.xs[0];
        const arcEnd = L.xs[3];
        const arcY = y + L.r + L.arcDepth;
        return (
          <g>
            <text class="f-title" x={L.titleX} y={g.title}>{row.title}</text>
            {L.xs.map((x, i) => (
              <g>
                <circle class={i === 0 ? 'f-line f-red' : 'f-line'} cx={x} cy={y} r={L.r} fill="var(--paper)" />
                <text class="f-math" x={x - 2} y={y + 5} text-anchor="middle">{names[i][0]}<tspan dy="5" font-size="13">{names[i][1]}</tspan></text>
              </g>
            ))}
            <text class="f-math" x={L.dots} y={y + 5} text-anchor="middle">…</text>
            {[[L.xs[0], L.xs[1]], [L.xs[1], L.xs[2]], [L.xs[2], L.dots - 14], [L.dots + 14, L.xs[3]]].map(([a, b], j) => (
              <g>
                <path class="f-line" d={`M ${a + (j === 3 ? 0 : L.r + 5)} ${y} H ${b - (j === 2 ? 0 : L.r + 5)}`} marker-end="url(#f-arrow)" />
                {L.stepLabels && j < 2 && row.step.map((s, m) => (
                  <text class="f-small" x={(a + b) / 2} y={y - 12 - (row.step.length - 1 - m) * 16} text-anchor="middle">{s}</text>
                ))}
              </g>
            ))}
            {/* one-jump shortcut below the chain */}
            <path class={`f-line f-${row.tone === 'red' ? 'red' : 'green'} f-dash`} d={`M ${arcStart + 6} ${y + L.r + 4} C ${arcStart + 40} ${arcY}, ${arcEnd - 40} ${arcY}, ${arcEnd - 6} ${y + L.r + 4}`} marker-end={`url(#f-arrow-${row.tone === 'red' ? 'red' : 'green'})`} />
            <text class="f-math f-halo" x={(arcStart + arcEnd) / 2} y={arcY + 14} text-anchor="middle" font-size="17">{row.shortcut.map((seg) => (seg === AB ? <tspan style="font-family: var(--sans); font-style: normal" font-size="16">{seg}</tspan> : seg))}</text>
            <text class={`f-label f-t-${row.tone === 'red' ? 'red' : 'green'}`} x={(arcStart + arcEnd) / 2} y={arcY + 38} text-anchor="middle">{row.verdict}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
