---
import Figure from '../Figure.astro';
import { normals } from '../geometry';

// A 10×10 "photo" with intensities in [-1, 1] (-1 = paper, +1 = ink): a sun and a hill.
const N = 10;
const photo: number[] = [];
for (let r = 0; r < N; r += 1) {
  for (let c = 0; c < N; c += 1) {
    const sun = (c - 2.6) ** 2 + (r - 2.6) ** 2 <= 2.9;
    const hill = r >= 6.2 + 0.09 * (c - 6.5) ** 2 - 1.6;
    photo.push(sun || hill ? 1 : -1);
  }
}

// Each tile is a real sample x = sqrt(abar) x0 + sqrt(1 - abar) eps, one fixed noise draw shared by all tiles.
const eps = normals(N * N, 38);
const steps = [
  { name: 'x', sub: '0', abar: 1, caption: ['original', 'photo'] },
  { name: 'x', sub: '1', abar: 0.8, caption: ['add', 'noise'] },
  { name: 'x', sub: '2', abar: 0.5, caption: ['more', 'noise'] },
  { name: 'x', sub: 'T', abar: 4e-5, caption: ['pure', 'noise'] },
];
const tiles = steps.map((s) =>
  photo.map((x0, i) => {
    const x = Math.sqrt(s.abar) * x0 + Math.sqrt(1 - s.abar) * eps[i];
    return Math.min(1, Math.max(0, (x + 1) / 2)) * 0.88;
  }),
);

const id = 'ddpm-forward-process-chain';

// Wide layout: tiles in a row; x2 and xT are separated by an ellipsis.
const W = { tile: 64, y: 118, xs: [62, 202, 342, 562], dots: 452 };
// Narrow layout: tiles in a column.
const Nn = { tile: 56, x: 152, ys: [40, 160, 280, 470], dots: 395 };
---

<Figure
  id={id}
  title="The forward chain adds noise; the model walks back"
  caption="Forward arrows are the fixed noising step q(xₜ | xₜ₋₁); the curved arrows are the learned reverse step pθ(xₜ₋₁ | xₜ), which takes xₜ and goes one step back. The tiles are real samples of xₜ = √α̅ₜ x₀ + √(1 − α̅ₜ) ε for α̅ = 1, 0.8, 0.5 and ≈ 0 (4 × 10⁻⁵, the end of DDPM's schedule) with one fixed noise draw ε."
  origin="expanded"
>
  <svg class="fig-wide" viewBox="0 0 640 284" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>Diffusion chain from an original photo to pure noise</title>
    <desc id={`${id}-w-d`}>Four pixel tiles in a row: x0 the original photo of a sun and a hill, x1 with some noise, x2 with more noise, then an ellipsis, then xT which is pure noise. Straight arrows labelled add noise go left to right. Curved arrows above go right to left, labelled p theta of x0 given x1, p theta of x1 given x2 and p theta of xT minus 1 given xT: the learned reverse step. A long arrow below says forward process q of xt given xt minus 1, fixed; a long arrow at the top says reverse process, learned model.</desc>

    <text class="f-label f-t-blue" x="320" y="18" text-anchor="middle">reverse: learned model p<tspan dy="4" font-size="12">θ</tspan><tspan dy="-4"> (goes back one step)</tspan></text>

    {steps.map((s, k) => {
      const cx = W.xs[k];
      const x0 = cx - W.tile / 2;
      const y0 = W.y - W.tile / 2;
      const p = W.tile / N;
      return (
        <g>
          {tiles[k].map((o, i) => (
            <rect x={x0 + (i % N) * p} y={y0 + Math.floor(i / N) * p} width={p + 0.3} height={p + 0.3} fill="var(--ink)" fill-opacity={o.toFixed(3)} />
          ))}
          <rect x={x0} y={y0} width={W.tile} height={W.tile} fill="none" stroke="var(--ink)" stroke-width="1.1" />
          <text class="f-math" x={cx} y={W.y + 58} text-anchor="middle">{s.name}<tspan dy="5" font-size="13">{s.sub}</tspan></text>
          <text class={`f-note ${k === 0 ? 'f-t-red' : ''}`} x={cx} y={W.y + 82} text-anchor="middle">{s.caption[0]}</text>
          <text class={`f-note ${k === 0 ? 'f-t-red' : ''}`} x={cx} y={W.y + 99} text-anchor="middle">{s.caption[1]}</text>
        </g>
      );
    })}
    <text class="f-math" x={W.dots} y={W.y + 6} text-anchor="middle">…</text>

    {/* forward arrows */}
    {[[W.xs[0], W.xs[1]], [W.xs[1], W.xs[2]], [W.xs[2], W.dots - 20], [W.dots + 20, W.xs[3]]].map(([a, b]) => (
      <g>
        <path class="f-line" d={`M ${a + (a === W.dots + 20 ? 0 : W.tile / 2 + 8)} ${W.y} H ${b - (b === W.dots - 20 ? 0 : W.tile / 2) - 8}`} marker-end="url(#f-arrow)" />
      </g>
    ))}
    <text class="f-small" x={(W.xs[0] + W.xs[1]) / 2} y={W.y + 20} text-anchor="middle">add noise</text>
    <text class="f-small" x={(W.xs[1] + W.xs[2]) / 2} y={W.y + 20} text-anchor="middle">add noise</text>

    {/* backward arcs: p_theta(x_{t-1} | x_t) from x_t back to x_{t-1} */}
    {[
      { from: W.xs[1] - 6, to: W.xs[0] + 6, sub: '1', prev: '0' },
      { from: W.xs[2] - 6, to: W.xs[1] + 6, sub: '2', prev: '1' },
      { from: W.xs[3] - 6, to: W.dots + 4, sub: 'T', prev: 'T−1' },
    ].map((a) => {
      const top = W.y - W.tile / 2 - 4;
      const mid = (a.from + a.to) / 2;
      return (
        <g>
          <path class="f-line f-blue" d={`M ${a.from} ${top} Q ${mid} ${top - 52} ${a.to} ${top - 2}`} marker-end="url(#f-arrow-blue)" />
          <text class="f-math f-t-blue f-halo" x={mid} y={top - 36} text-anchor="middle">p<tspan dy="5" font-size="13">θ</tspan><tspan dy="-5">(x</tspan><tspan dy="5" font-size="13">{a.prev}</tspan><tspan dy="-5"> | x</tspan><tspan dy="5" font-size="13">{a.sub}</tspan><tspan dy="-5">)</tspan></text>
        </g>
      );
    })}

    {/* long process arrows */}
    <path class="f-line f-muted" d={`M 40 ${W.y + 124} H 600`} marker-end="url(#f-arrow-muted)" />
    <text class="f-label" x="320" y={W.y + 148} text-anchor="middle">forward process q(x<tspan dy="4" font-size="12">t</tspan><tspan dy="-4"> | x</tspan><tspan dy="4" font-size="12">t−1</tspan><tspan dy="-4">): fixed, just adds noise</tspan></text>
    <path class="f-line f-blue" d={`M 600 26 H 40`} marker-end="url(#f-arrow-blue)" opacity="0.55" />
  </svg>

  <svg class="fig-narrow" viewBox="0 0 360 572" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>Diffusion chain from an original photo to pure noise</title>
    <desc id={`${id}-n-d`}>Four pixel tiles in a column: x0 the original photo of a sun and a hill, x1 with some noise, x2 with more noise, an ellipsis, then xT, pure noise. Arrows labelled add noise point down. Curved blue arrows on the right point up, labelled p theta of x0 given x1, p theta of x1 given x2 and p theta of xT minus 1 given xT: the learned reverse step going one step back.</desc>

    {steps.map((s, k) => {
      const cy = Nn.ys[k];
      const x0 = Nn.x - Nn.tile / 2;
      const y0 = cy - Nn.tile / 2 + 18;
      const p = Nn.tile / N;
      return (
        <g>
          {tiles[k].map((o, i) => (
            <rect x={x0 + (i % N) * p} y={y0 + Math.floor(i / N) * p} width={p + 0.3} height={p + 0.3} fill="var(--ink)" fill-opacity={o.toFixed(3)} />
          ))}
          <rect x={x0} y={y0} width={Nn.tile} height={Nn.tile} fill="none" stroke="var(--ink)" stroke-width="1.1" />
          <text class="f-math" x={x0 - 14} y={y0 + 24} text-anchor="end">{s.name}<tspan dy="5" font-size="13">{s.sub}</tspan></text>
          <text class={`f-note ${k === 0 ? 'f-t-red' : ''}`} x={x0 - 14} y={y0 + 48} text-anchor="end">{s.caption.join(' ')}</text>
        </g>
      );
    })}
    <text class="f-math" x={Nn.x} y={Nn.dots + 6} text-anchor="middle">⋮</text>

    {[[0, 1], [1, 2]].map(([a, b]) => (
      <g>
        <path class="f-line" d={`M ${Nn.x} ${Nn.ys[a] + Nn.tile / 2 + 26} V ${Nn.ys[b] - Nn.tile / 2 + 10}`} marker-end="url(#f-arrow)" />
        <text class="f-small" x={Nn.x - 10} y={(Nn.ys[a] + Nn.ys[b]) / 2 + 22} text-anchor="end">add noise</text>
      </g>
    ))}
    <path class="f-line" d={`M ${Nn.x} ${Nn.ys[2] + Nn.tile / 2 + 26} V ${Nn.dots - 16}`} marker-end="url(#f-arrow)" />
    <path class="f-line" d={`M ${Nn.x} ${Nn.dots + 14} V ${Nn.ys[3] - Nn.tile / 2 + 10}`} marker-end="url(#f-arrow)" />

    {[
      { from: Nn.ys[1] + 4, to: Nn.ys[0] + 34, sub: '1', prev: '0' },
      { from: Nn.ys[2] + 4, to: Nn.ys[1] + 34, sub: '2', prev: '1' },
      { from: Nn.ys[3] + 4, to: Nn.dots + 2, sub: 'T', prev: 'T−1' },
    ].map((a) => {
      const side = Nn.x + Nn.tile / 2 + 6;
      const mid = (a.from + a.to) / 2;
      return (
        <g>
          <path class="f-line f-blue" d={`M ${side} ${a.from} Q ${side + 50} ${mid} ${side + 2} ${a.to}`} marker-end="url(#f-arrow-blue)" />
          <text class="f-math f-t-blue" x={side + 36} y={mid + 6}>p<tspan dy="5" font-size="13">θ</tspan><tspan dy="-5">(x</tspan><tspan dy="5" font-size="13">{a.prev}</tspan><tspan dy="-5"> | x</tspan><tspan dy="5" font-size="13">{a.sub}</tspan><tspan dy="-5">)</tspan></text>
        </g>
      );
    })}
    <text class="f-note f-t-blue" x="330" y="560" text-anchor="end">blue: learned model, one step back</text>
  </svg>
</Figure>
