---
import Figure from '../Figure.astro';
import { area, plot, scale, gaussian, seeded, normals } from '../geometry';

// DDPM linear schedule (Ho et al., 2020): beta from 1e-4 to 0.02 over T = 1000 steps.
const T = 1000;
const betas = Array.from({ length: T }, (_, i) => 1e-4 + ((0.02 - 1e-4) * i) / (T - 1));
const abars: number[] = [];
betas.reduce((p, b) => {
  const next = p * (1 - b);
  abars.push(next);
  return next;
}, 1);
const abarAt = (t: number) => (t === 0 ? 1 : abars[t - 1]);

// 1-D data: a mixture of two Gaussians, like the two-humped sketch on p. 40.
const mix = [
  { pi: 0.45, mu: -1.3, sigma: 0.42 },
  { pi: 0.55, mu: 1.25, sigma: 0.45 },
];
// Marginal q(x_t) = sum_k pi_k N(sqrt(abar) mu_k, abar sigma_k^2 + 1 - abar).
const marginal = (a: number) => (x: number) =>
  mix.reduce((s, m) => s + m.pi * gaussian(x, Math.sqrt(a) * m.mu, Math.sqrt(a * m.sigma ** 2 + 1 - a)), 0);

// Sample histogram (fixed seed) to show what a finite batch looks like: the jagged middle sketch.
const nSamples = 600;
const u = seeded(40);
const z0 = normals(nSamples, 41);
const eps = normals(nSamples, 42);
const x0 = z0.map((z) => {
  const m = u() < mix[0].pi ? mix[0] : mix[1];
  return m.mu + m.sigma * z;
});
const xMin = -4;
const xMax = 4;
const binW = 0.25;
const nBins = Math.round((xMax - xMin) / binW);
const histogram = (a: number) => {
  const counts = new Array(nBins).fill(0);
  x0.forEach((x, i) => {
    const xt = Math.sqrt(a) * x + Math.sqrt(1 - a) * eps[i];
    const b = Math.floor((xt - xMin) / binW);
    if (b >= 0 && b < nBins) counts[b] += 1;
  });
  return counts.map((c) => c / (nSamples * binW));
};

const steps = [0, 100, 300, 1000].map((t, k) => {
  const a = abarAt(t);
  return { t, a, f: marginal(a), hist: histogram(a), tone: k === 0 ? 'red' : k === 3 ? 'green' : '' };
});
const yMax = 0.62;
const id = 'ddpm-forward-process-marginals';

type Panel = { left: number; top: number; w: number; h: number };
const mk = (p: Panel) => ({ ...p, sx: scale([xMin, xMax], [p.left, p.left + p.w]), sy: scale([0, yMax], [p.top + p.h, p.top]) });
const layouts = {
  w: {
    cls: 'fig-wide',
    vb: '0 0 680 220',
    panels: [0, 1, 2, 3].map((i) => mk({ left: 10 + i * 170, top: 24, w: 136, h: 118 })),
    arrows: [0, 1, 2].map((i) => `M ${10 + i * 170 + 140} 90 H ${10 + (i + 1) * 170 - 6}`),
  },
  n: {
    cls: 'fig-narrow',
    vb: '0 0 360 420',
    panels: [
      mk({ left: 14, top: 24, w: 140, h: 118 }),
      mk({ left: 206, top: 24, w: 140, h: 118 }),
      mk({ left: 14, top: 236, w: 140, h: 118 }),
      mk({ left: 206, top: 236, w: 140, h: 118 }),
    ],
    arrows: ['M 160 90 H 200', 'M 250 196 Q 190 210 140 232', 'M 160 302 H 200'],
  },
};
---

<Figure
  id={id}
  title="The data distribution dissolves into N(0, 1)"
  caption="Every data point is noised by the same rule, so the whole 1-D data density q(x₀), a mixture of two Gaussians, turns into the marginal q(xₜ) = Σₖ πₖ N(√α̅ₜ μₖ, α̅ₜσₖ² + 1 − α̅ₜ). Curves are exact; bars are a histogram of 600 samples pushed through the same steps, which is why a finite batch looks jagged. The schedule is DDPM's linear β from 10⁻⁴ to 0.02 (T = 1000)."
  origin="expanded"
  pages="40"
>
  {Object.entries(layouts).map(([sfx, L]) => (
    <svg class={L.cls} viewBox={L.vb} role="img" aria-labelledby={`${id}-${sfx}-t ${id}-${sfx}-d`}>
      <title id={`${id}-${sfx}-t`}>Marginal density of xt at t = 0, 100, 300 and 1000</title>
      <desc id={`${id}-${sfx}-d`}>Four small density plots joined by arrows. At t = 0 the red data density has two humps, at about minus 1.3 and plus 1.25. At t = 100, alpha bar 0.90, the humps are lower, wider and closer together. At t = 300, alpha bar 0.40, they have merged into one lopsided bump. At t = 1000, alpha bar about 0, the green density is the standard normal N(0, 1). Each panel also shows a jagged histogram of 600 noised samples.</desc>

      {steps.map((s, k) => {
        const g = L.panels[k];
        const bottom = g.top + g.h;
        return (
          <g>
            {s.hist.map((h, b) => {
              const x = xMin + b * binW;
              return h > 0 ? <rect class="f-solid-muted" x={g.sx(x) + 0.4} y={g.sy(Math.min(h, yMax))} width={g.sx(x + binW) - g.sx(x) - 0.8} height={bottom - g.sy(Math.min(h, yMax))} opacity="0.28" /> : null;
            })}
            <path class={s.tone ? `f-fill-${s.tone}` : ''} fill={s.tone ? undefined : 'none'} d={area(s.f, xMin, xMax, g.sx, g.sy, 200)} />
            <path class={`f-line f-bold ${s.tone ? `f-${s.tone}` : ''}`} d={plot(s.f, xMin, xMax, g.sx, g.sy, 200)} />
            <path class="f-axis" d={`M ${g.left} ${bottom} H ${g.left + g.w + 2}`} marker-end="url(#f-arrow-muted)" />
            <path class="f-axis" d={`M ${g.sx(0)} ${bottom + 4} V ${g.top - 8}`} marker-end="url(#f-arrow-muted)" />
            <text class={`f-label ${s.tone ? `f-t-${s.tone}` : ''}`} x={g.left + g.w / 2} y={bottom + 24} text-anchor="middle">{s.t === 0 ? 't = 0 (data)' : `t = ${s.t}`}</text>
            <text class="f-note" x={g.left + g.w / 2} y={bottom + 42} text-anchor="middle">{s.t === 0 ? 'α̅ = 1' : s.a < 0.001 ? `α̅ ≈ ${s.a.toExponential(1).replace('e-5', '·10⁻⁵')}` : `α̅ = ${s.a.toFixed(2)}`}</text>
            {s.t === 1000 && <text class="f-math f-t-green f-halo" x={g.left + g.w - 2} y={g.top + 6} text-anchor="end" font-size="16">N(0, 1)</text>}
            {s.t === 0 && <text class="f-math f-t-red f-halo" x={g.left + 2} y={g.top + 6} font-size="16">q(x₀)</text>}
          </g>
        );
      })}
      {L.arrows.map((d) => <path class="f-line" d={d} marker-end="url(#f-arrow)" />)}
    </svg>
  ))}
</Figure>
