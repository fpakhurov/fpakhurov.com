---
import Figure from '../Figure.astro';
import { polyline, scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Four noise schedules with T = 1000. Linear, quadratic and sigmoid: beta from 1e-4 to 0.02 (u = (t-1)/(T-1)).
// Cosine (Nichol & Dhariwal 2021, Eq. 17): abar_t = f(t)/f(0), f(t) = cos^2(((t/T + s)/(1 + s)) * pi/2), s = 0.008,
// beta_t = 1 - abar_t/abar_{t-1} clipped at 0.999. abar_t = prod_{i<=t}(1 - beta_i), abar_0 = 1.
const T = 1000;
const b0 = 1e-4;
const b1 = 0.02;
const u = (t: number) => (t - 1) / (T - 1);
const sigmoid = (z: number) => 1 / (1 + Math.exp(-z));
const sCos = 0.008;
const fCos = (t: number) => Math.cos(((t / T + sCos) / (1 + sCos)) * (Math.PI / 2)) ** 2;
const betaOf: Record<string, (t: number) => number> = {
  linear: (t) => b0 + (b1 - b0) * u(t),
  quadratic: (t) => (Math.sqrt(b0) + (Math.sqrt(b1) - Math.sqrt(b0)) * u(t)) ** 2,
  sigmoid: (t) => b0 + (b1 - b0) * sigmoid(12 * u(t) - 6),
  cosine: (t) => Math.min(1 - fCos(t) / fCos(t - 1), 0.999),
};
const names = ['linear', 'quadratic', 'sigmoid', 'cosine'] as const;
const abars: Record<string, number[]> = {};
for (const n of names) {
  const a = [1];
  for (let t = 1; t <= T; t += 1) a.push(a[t - 1] * (1 - betaOf[n](t)));
  abars[n] = a;
}
const firstBelow = (a: number[], v: number) => a.findIndex((x) => x < v);
const tHalf = Object.fromEntries(names.map((n) => [n, firstBelow(abars[n], 0.5)]));
const tSmall = Object.fromEntries(names.map((n) => [n, firstBelow(abars[n], 0.01)]));
const aEnd = Object.fromEntries(names.map((n) => [n, abars[n][T]]));

// The numbers quoted in the caption and in the note's table.
const expectHalf = { linear: 260, quadratic: 419, sigmoid: 440, cosine: 497 };
const expectSmall = { linear: 674, quadratic: 851, sigmoid: 721, cosine: 936 };
const expectEnd = { linear: '4.0e-5', quadratic: '7.3e-4', sigmoid: '4.0e-5', cosine: '2.4e-9' };
for (const n of names) {
  if (tHalf[n] !== expectHalf[n]) throw new Error(`ScheduleComparison: ${n} crosses 0.5 at ${tHalf[n]}, caption says ${expectHalf[n]}`);
  if (tSmall[n] !== expectSmall[n]) throw new Error(`ScheduleComparison: ${n} drops below 0.01 at ${tSmall[n]}, text says ${expectSmall[n]}`);
  if (aEnd[n].toExponential(1) !== expectEnd[n]) throw new Error(`ScheduleComparison: ${n} abar_T = ${aEnd[n].toExponential(2)}, text says ${expectEnd[n]}`);
}

const style: Record<string, { line: string; dot: string; en: string; ru: string }> = {
  linear: { line: 'f-line', dot: 'f-fill-ink', en: 'linear', ru: 'линейное' },
  quadratic: { line: 'f-line f-blue f-dash', dot: 'f-solid-blue', en: 'quadratic', ru: 'квадратичное' },
  sigmoid: { line: 'f-line f-green', dot: 'f-solid-green', en: 'sigmoid', ru: 'сигмоидное' },
  cosine: { line: 'f-line f-red f-bold', dot: 'f-solid-red', en: 'cosine', ru: 'косинусное' },
};

type L = {
  cls: string; vb: string; left: number; right: number; top: number; bot: number; xTicks: number[];
  legend: { x: number; y: number }[];
};
const layouts: Record<string, L> = {
  w: {
    cls: 'fig-wide fig-medium', vb: '0 0 600 370', left: 64, right: 560, top: 40, bot: 312, xTicks: [0, 200, 400, 600, 800, 1000],
    legend: [{ x: 400, y: 64 }, { x: 400, y: 88 }, { x: 400, y: 112 }, { x: 400, y: 136 }],
  },
  n: {
    cls: 'fig-narrow', vb: '0 0 370 430', left: 52, right: 345, top: 40, bot: 300, xTicks: [0, 250, 500, 750, 1000],
    legend: [{ x: 40, y: 368 }, { x: 200, y: 368 }, { x: 40, y: 396 }, { x: 200, y: 396 }],
  },
};
const id = 'ddpm-forward-process-schedules';
const geo = Object.fromEntries(
  Object.entries(layouts).map(([k, l]) => {
    const sx = scale([0, T], [l.left, l.right]);
    const sy = scale([0, 1], [l.bot, l.top]);
    const paths = Object.fromEntries(
      names.map((n) => [n, polyline(abars[n].filter((_, t) => t % 4 === 0 || t === T).map((a, i, arr) => [sx(i === arr.length - 1 ? T : i * 4), sy(a)] as const))]),
    );
    return [k, { ...l, sx, sy, paths }];
  }),
);
const caption = ru
  ? `α̅ₜ для четырёх расписаний при T = 1000: линейного, квадратичного и сигмоидного с β от 10⁻⁴ до 0.02 и косинусного с s = 0.008. Точки отмечают, где α̅ₜ впервые опускается ниже 0.5: t = ${tHalf.linear}, ${tHalf.quadratic}, ${tHalf.sigmoid} и ${tHalf.cosine}. Сравните, сколько шагов каждое расписание проводит на среднем уровне шума.`
  : `α̅ₜ for four schedules with T = 1000: linear, quadratic and sigmoid with β from 10⁻⁴ to 0.02, and cosine with s = 0.008. Dots mark where α̅ₜ first drops below 0.5: t = ${tHalf.linear}, ${tHalf.quadratic}, ${tHalf.sigmoid} and ${tHalf.cosine}. Compare how long each stays at medium noise.`;
---

<Figure id={id} title={ru ? 'Четыре расписания шума: как убывает α̅ₜ' : 'Four noise schedules: how α̅ₜ falls'} caption={caption}>
  {Object.entries(geo).map(([sfx, g]) => (
    <svg class={g.cls} viewBox={g.vb} role="img" aria-labelledby={`${id}-${sfx}-t ${id}-${sfx}-d`}>
      <title id={`${id}-${sfx}-t`}>{ru ? 'Альфа с чертой для линейного, квадратичного, сигмоидного и косинусного расписаний' : 'Alpha bar for linear, quadratic, sigmoid and cosine schedules'}</title>
      <desc id={`${id}-${sfx}-d`}>{ru
        ? `Четыре убывающие кривые альфа с чертой t на шагах от 0 до 1000, все начинаются в 1. Линейная падает раньше всех и пересекает 0.5 при t, равном ${tHalf.linear}; квадратичная пересекает 0.5 при ${tHalf.quadratic}, сигмоидная — при ${tHalf.sigmoid}, косинусная — при ${tHalf.cosine} и дольше всех остаётся заметно выше нуля.`
        : `Four falling curves of alpha bar t over steps 0 to 1000, all starting at 1. The linear one falls first and crosses 0.5 at t equals ${tHalf.linear}; the quadratic crosses 0.5 at ${tHalf.quadratic}, the sigmoid at ${tHalf.sigmoid}, and the cosine at ${tHalf.cosine}, staying clearly above zero the longest.`}</desc>

      {[0, 0.25, 0.5, 0.75, 1].map((y) => <line class="f-grid" x1={g.left} x2={g.right} y1={g.sy(y)} y2={g.sy(y)} />)}
      {[0, 0.25, 0.5, 0.75, 1].map((y) => <text class="f-note" x={g.left - 8} y={g.sy(y) + 4.5} text-anchor="end">{y}</text>)}
      {g.xTicks.map((x) => <text class="f-note" x={g.sx(x)} y={g.bot + 20} text-anchor="middle">{x}</text>)}
      <path class="f-axis" d={`M ${g.left} ${g.bot} H ${g.right + 14}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-axis" d={`M ${g.left} ${g.bot} V ${g.top - 14}`} marker-end="url(#f-arrow-muted)" />
      <text class="f-math" x={g.right + 14} y={g.bot + 40} text-anchor="end">t</text>
      <text class="f-math" x={g.left + 10} y={g.top - 14}><tspan style="font-family: var(--sans); font-style: normal" font-size="17">α̅</tspan><tspan dy="5" font-size="13">t</tspan></text>

      <line class="f-thin f-muted f-dash" x1={g.left} x2={g.right} y1={g.sy(0.5)} y2={g.sy(0.5)} />
      {names.map((n) => <path class={style[n].line} d={g.paths[n]} />)}
      {names.map((n) => <circle class={style[n].dot} cx={g.sx(tHalf[n])} cy={g.sy(0.5)} r="4.5" />)}

      {names.map((n, i) => (
        <g>
          <line class={style[n].line} x1={g.legend[i].x} x2={g.legend[i].x + 30} y1={g.legend[i].y - 5} y2={g.legend[i].y - 5} />
          <text class="f-label" x={g.legend[i].x + 38} y={g.legend[i].y}>{ru ? style[n].ru : style[n].en}</text>
        </g>
      ))}
    </svg>
  ))}
</Figure>
