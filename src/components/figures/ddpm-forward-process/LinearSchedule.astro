---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';

// DDPM linear schedule: beta_t from 1e-4 to 0.02, T = 1000; abar_t = prod_{i<=t} (1 - beta_i).
const T = 1000;
const b0 = 1e-4;
const b1 = 0.02;
const beta = (t: number) => b0 + ((b1 - b0) * (t - 1)) / (T - 1);
const abars = [1];
for (let t = 1; t <= T; t += 1) abars.push(abars[t - 1] * (1 - beta(t)));
const abar = (t: number) => {
  const i = Math.floor(t);
  const f = t - i;
  return i >= T ? abars[T] : abars[i] * (1 - f) + abars[i + 1] * f;
};
const tHalf = abars.reduce((best, a, t) => (Math.abs(a - 0.5) < Math.abs(abars[best] - 0.5) ? t : best), 0);
const tSmall = abars.findIndex((a) => a < 0.01);
const aEnd = abars[T];

type L = {
  cls: string; vb: string; left: number; right: number;
  top1: number; bot1: number; top2: number; bot2: number;
  xTicks: number[]; halfDx: number; smallDx: number; smallY: number; betaNoteT: number;
};
const layouts: Record<string, L> = {
  w: { cls: 'fig-wide fig-medium', vb: '0 0 600 450', left: 70, right: 560, top1: 46, bot1: 136, top2: 196, bot2: 396, xTicks: [0, 200, 400, 600, 800, 1000], halfDx: 28, smallDx: -6, smallY: 0.27, betaNoteT: 560 },
  n: { cls: 'fig-narrow', vb: '0 0 370 470', left: 56, right: 340, top1: 46, bot1: 136, top2: 200, bot2: 416, xTicks: [0, 250, 500, 750, 1000], halfDx: 22, smallDx: -77, smallY: 0.47, betaNoteT: 640 },
};
const id = 'ddpm-forward-process-schedule';
const geo = Object.fromEntries(
  Object.entries(layouts).map(([k, l]) => [
    k,
    { ...l, sx: scale([0, T], [l.left, l.right]), syB: scale([0, 0.02], [l.bot1, l.top1]), syA: scale([0, 1], [l.bot2, l.top2]) },
  ]),
);
---

<Figure
  id={id}
  title="A linear β schedule and the resulting α̅ₜ"
  caption={`Top: βₜ grows linearly from 10⁻⁴ to 0.02. Bottom: α̅ₜ = ∏ (1 − βᵢ) falls slowly at first (small steps keep early images recognisable), is ≈ 0.5 at t ≈ ${tHalf}, drops below 0.01 at t = ${tSmall} and ends at α̅₁₀₀₀ ≈ ${aEnd.toExponential(1).replace('e-5', ' × 10⁻⁵')}, so x₁₀₀₀ is essentially pure N(0, I) noise.`}
  origin="illustrative"
  pages="40"
>
  {Object.entries(geo).map(([sfx, g]) => (
    <svg class={g.cls} viewBox={g.vb} role="img" aria-labelledby={`${id}-${sfx}-t ${id}-${sfx}-d`}>
      <title id={`${id}-${sfx}-t`}>Linear beta schedule and alpha bar over 1000 steps</title>
      <desc id={`${id}-${sfx}-d`}>Two plots sharing the time axis t from 0 to 1000. The upper plot shows beta t as a straight amber line rising from 0.0001 to 0.02. The lower plot shows alpha bar t, the running product of 1 minus beta, as a falling curve that starts at 1, decreases slowly at first, crosses 0.5 at about t equals {tHalf}, falls below 0.01 at t equals {tSmall}, and is about 4 times 10 to the minus 5 at t equals 1000.</desc>

      {/* beta panel */}
      {[0, 0.01, 0.02].map((y) => <line class="f-grid" x1={g.left} x2={g.right} y1={g.syB(y)} y2={g.syB(y)} />)}
      {[0, 0.01, 0.02].map((y) => <text class="f-note" x={g.left - 8} y={g.syB(y) + 4.5} text-anchor="end">{y}</text>)}
      <path class="f-axis" d={`M ${g.left} ${g.bot1} H ${g.right + 14}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-axis" d={`M ${g.left} ${g.bot1} V ${g.top1 - 14}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-line f-amber f-bold" d={plot(beta, 1, T, g.sx, g.syB, 100)} />
      <text class="f-math" x={g.left + 10} y={g.top1 - 18}>β<tspan dy="5" font-size="13">t</tspan></text>
      <text class="f-note" x={g.sx(g.betaNoteT)} y={g.syB(0.0153)} text-anchor="end">linear, 10⁻⁴ → 0.02</text>

      {/* abar panel */}
      {[0, 0.25, 0.5, 0.75, 1].map((y) => <line class="f-grid" x1={g.left} x2={g.right} y1={g.syA(y)} y2={g.syA(y)} />)}
      {[0, 0.25, 0.5, 0.75, 1].map((y) => <text class="f-note" x={g.left - 8} y={g.syA(y) + 4.5} text-anchor="end">{y}</text>)}
      {g.xTicks.map((x) => <text class="f-note" x={g.sx(x)} y={g.bot2 + 20} text-anchor="middle">{x}</text>)}
      <path class="f-axis" d={`M ${g.left} ${g.bot2} H ${g.right + 14}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-axis" d={`M ${g.left} ${g.bot2} V ${g.top2 - 14}`} marker-end="url(#f-arrow-muted)" />
      <text class="f-math" x={g.right + 14} y={g.bot2 + 40} text-anchor="end">t</text>
      <path class="f-line f-bold" d={plot(abar, 0, T, g.sx, g.syA, 250)} />
      <text class="f-math" x={g.left + 10} y={g.top2 - 16}><tspan style="font-family: var(--sans); font-style: normal" font-size="17">α̅</tspan><tspan dy="5" font-size="13">t</tspan><tspan dy="-5"> = ∏ (1 − β</tspan><tspan dy="5" font-size="13">i</tspan><tspan dy="-5">)</tspan></text>

      <line class="f-thin f-muted f-dash" x1={g.sx(tHalf)} x2={g.sx(tHalf)} y1={g.bot2} y2={g.syA(0.5)} />
      <circle class="f-solid-blue" cx={g.sx(tHalf)} cy={g.syA(0.5)} r="5" />
      <text class="f-label f-halo" x={g.sx(tHalf) + g.halfDx} y={g.syA(0.66)}>α̅ₜ ≈ 0.5 at t ≈ {tHalf}</text>
      <path class="f-thin" d={`M ${g.sx(tHalf) + g.halfDx + 2} ${g.syA(0.635)} Q ${g.sx(tHalf) + 14} ${g.syA(0.6)} ${g.sx(tHalf) + 7} ${g.syA(0.5) - 6}`} marker-end="url(#f-arrow)" />

      <line class="f-thin f-muted f-dash" x1={g.sx(tSmall)} x2={g.sx(tSmall)} y1={g.bot2} y2={g.syA(0.01)} />
      <circle class="f-solid-blue" cx={g.sx(tSmall)} cy={g.syA(0.01)} r="5" />
      <text class="f-label f-halo" x={g.sx(tSmall) + g.smallDx} y={g.syA(g.smallY)}>α̅ₜ &lt; 0.01 from t = {tSmall}:</text>
      <text class="f-note f-halo" x={g.sx(tSmall) + g.smallDx} y={g.syA(g.smallY) + 18}>x₀ is almost gone, xₜ ≈ ε</text>
      <path class="f-thin" d={`M ${g.sx(tSmall) + 6} ${g.syA(g.smallY) + 26} Q ${g.sx(tSmall) + 22} ${g.syA(0.1)} ${g.sx(tSmall) + 4} ${g.syA(0.01) - 8}`} marker-end="url(#f-arrow)" />
    </svg>
  ))}
</Figure>
