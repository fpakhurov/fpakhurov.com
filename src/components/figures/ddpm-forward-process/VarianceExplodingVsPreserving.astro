---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';

// Constant beta, as on p. 39: q(x_t | x_0) for the naive and the DDPM chains.
const beta = 0.02;
const tMax = 200;
const yMax = 2.2;
const abar = (t: number) => (1 - beta) ** t;
const curves = {
  ve: { mean: (_t: number) => 1, std: (t: number) => Math.sqrt(t * beta) },
  vp: { mean: (t: number) => Math.sqrt(abar(t)), std: (t: number) => Math.sqrt(1 - abar(t)) },
};

type Panel = { left: number; right: number; top: number; bottom: number };
const geom = (p: Panel) => ({ ...p, sx: scale([0, tMax], [p.left, p.right]), sy: scale([0, yMax], [p.bottom, p.top]) });

const layouts = {
  w: { cls: 'fig-wide', vb: '0 0 640 340', ve: geom({ left: 56, right: 296, top: 58, bottom: 268 }), vp: geom({ left: 376, right: 616, top: 58, bottom: 268 }) },
  n: { cls: 'fig-narrow', vb: '0 0 360 640', ve: geom({ left: 52, right: 330, top: 52, bottom: 252 }), vp: geom({ left: 52, right: 330, top: 368, bottom: 568 }) },
};
const yTicks = [0, 0.5, 1, 1.5, 2];
const xTicks = [0, 50, 100, 150, 200];
const id = 'ddpm-forward-process-ve-vp';
const at = (t: number) => ({ ve: curves.ve.std(t), vpMean: curves.vp.mean(t), vpStd: curves.vp.std(t) });
const end = at(tMax);
---

<Figure
  id={id}
  title="Variance exploding versus variance preserving"
  caption={`Coefficients of q(xₜ | x₀) for a constant β = ${beta}: xₜ = (mean coefficient)·x₀ + (noise std)·ε. The naive chain keeps x₀ untouched while the noise std √(tβ) grows past 1 without limit (2.0 at t = ${tMax}). The DDPM chain shrinks x₀ by √α̅ₜ (${end.vpMean.toFixed(2)} at t = ${tMax}) while the noise std √(1 − α̅ₜ) rises to 1 (${end.vpStd.toFixed(3)}), the target N(0, 1). The dashed green line marks the target std 1; in the left plot it is drawn over the flat mean line, which also sits at 1.`}
  origin="expanded"
  pages="39–40"
>
  {Object.entries(layouts).map(([sfx, L]) => (
    <svg class={L.cls} viewBox={L.vb} role="img" aria-labelledby={`${id}-${sfx}-t ${id}-${sfx}-d`}>
      <title id={`${id}-${sfx}-t`}>Mean coefficient and noise standard deviation of q(xt | x0) over t</title>
      <desc id={`${id}-${sfx}-d`}>Two plots over t from 0 to 200 with beta equal to 0.02. A dashed green line at height 1 marks the target standard deviation of N(0, 1). Left or top, the naive variance-exploding chain: the red mean coefficient is flat at 1, so the mean does not change, while the blue noise standard deviation, the square root of t beta, crosses 1 at t equals 50 and keeps growing to 2. Right or bottom, the DDPM variance-preserving chain: the red mean coefficient, square root of alpha bar t, decays from 1 to about 0.13, and the blue noise standard deviation, square root of 1 minus alpha bar t, rises towards 1 and levels off there.</desc>

      {[{ g: L.ve, c: curves.ve, name: 'Naive: variance exploding', tone: 'f-t-red' }, { g: L.vp, c: curves.vp, name: 'DDPM: variance preserving', tone: 'f-t-green' }].map(({ g, c, name, tone }) => (
        <g>
          <text class={`f-title ${tone}`} x={g.left} y={g.top - 26}>{name}</text>
          {yTicks.map((y) => <line class="f-grid" x1={g.left} x2={g.right} y1={g.sy(y)} y2={g.sy(y)} />)}
          {yTicks.map((y) => <text class="f-note" x={g.left - 8} y={g.sy(y) + 4.5} text-anchor="end">{y}</text>)}
          {xTicks.map((x) => <text class="f-note" x={g.sx(x)} y={g.bottom + 20} text-anchor="middle">{x}</text>)}
          <path class="f-axis" d={`M ${g.left} ${g.bottom} H ${g.right + 12}`} marker-end="url(#f-arrow-muted)" />
          <path class="f-axis" d={`M ${g.left} ${g.bottom} V ${g.top - 12}`} marker-end="url(#f-arrow-muted)" />
          <text class="f-math" x={g.right + 12} y={g.bottom + 40} text-anchor="end">t</text>
          <path class="f-line f-red f-bold" d={plot(c.mean, 0, tMax, g.sx, g.sy, 200)} />
          <path class="f-line f-blue f-bold" d={plot(c.std, 0, tMax, g.sx, g.sy, 200)} />
          <line class="f-line f-green f-dash" x1={g.left} x2={g.right} y1={g.sy(1)} y2={g.sy(1)} />
        </g>
      ))}

      {/* naive panel annotations: text in the free upper-left corner, arrow to the growing std curve */}
      <text class="f-label f-t-blue" x={L.ve.sx(6)} y={L.ve.sy(2.08)}>noise std √(tβ)</text>
      <text class="f-note f-t-blue" x={L.ve.sx(6)} y={L.ve.sy(2.08) + 17}>variance increases</text>
      <text class="f-note f-t-blue" x={L.ve.sx(6)} y={L.ve.sy(2.08) + 33}>indefinitely</text>
      <path class="f-thin f-blue" d={`M ${L.ve.sx(6) + 116} ${L.ve.sy(2.08) - 5} Q ${L.ve.sx(150)} ${L.ve.sy(2.16)} ${L.ve.sx(174)} ${L.ve.sy(curves.ve.std(174)) - 8}`} marker-end="url(#f-arrow-blue)" />
      <text class="f-label f-t-red" x={L.ve.sx(60)} y={L.ve.sy(1) + 22}>mean doesn't change</text>
      <text class="f-note f-t-green" x={L.ve.sx(96)} y={L.ve.sy(0.36)}>target std 1</text>
      <path class="f-thin f-green" d={`M ${L.ve.sx(96) + 84} ${L.ve.sy(0.42)} Q ${L.ve.sx(196)} ${L.ve.sy(0.6)} ${L.ve.sx(192)} ${L.ve.sy(1) + 7}`} marker-end="url(#f-arrow-green)" />

      {/* DDPM panel annotations */}
      <text class="f-label f-t-red" x={L.vp.sx(84)} y={L.vp.sy(0.62)}>mean shrinks: √α̅ₜ → 0</text>
      <path class="f-thin f-red" d={`M ${L.vp.sx(100)} ${L.vp.sy(0.55)} Q ${L.vp.sx(118)} ${L.vp.sy(0.42)} ${L.vp.sx(122)} ${L.vp.sy(curves.vp.mean(122)) - 7}`} marker-end="url(#f-arrow-red)" />
      <text class="f-label f-t-blue" x={L.vp.sx(84)} y={L.vp.sy(1.55)}>noise std √(1 − α̅ₜ) → 1</text>
      <path class="f-thin f-blue" d={`M ${L.vp.sx(140)} ${L.vp.sy(1.47)} Q ${L.vp.sx(150)} ${L.vp.sy(1.25)} ${L.vp.sx(154)} ${L.vp.sy(curves.vp.std(154)) - 7}`} marker-end="url(#f-arrow-blue)" />
    </svg>
  ))}
</Figure>
