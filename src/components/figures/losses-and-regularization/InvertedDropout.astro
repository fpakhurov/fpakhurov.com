---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Op from '../seqflow/Op.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The worked example: h = (2, 0.5, 1, 3), p = 0.5, mask (1, 0, 1, 0); the survivors are scaled by 1/(1 − p) = 2.
const h = [2, 0.5, 1, 3], p = 0.5, mask = [1, 0, 1, 0];
const kept = h.map((v, i) => v * mask[i]);
const out = kept.map((v) => v / (1 - p));
// expectation: E[m_j / (1 − p)] = 1, so E[h̃] = h
const expect = h.map((v) => ((1 - p) * v) / (1 - p));
if (out.join(' ') !== '4 0 2 0' || expect.join(' ') !== h.join(' ') || 1 / (1 - p) !== 2) throw new Error('InvertedDropout: the worked example drifted');
const S = (a: number[]) => a.map(String);
const avg = '(2.00, 0.50, 1.00, 2.99)';   // the average over 100,000 masks printed in the Code section

const t = ru
  ? {
      title: 'Инвертированный dropout при обучении и на тесте',
      train: 'обучение (model.train())', test: 'тест (model.eval())', mask: 'маска m', prod: 'm ⊙ h', outT: 'выход', identity: 'тождественно', outE: 'выход = h',
      mean1: 'среднее по 100 000 масок:', scale: '× 1/(1 − p)',
      steps: ['маска: каждый нейрон остаётся с вероятностью 1 − p = 0.5', 'умножение: выброшенные нейроны становятся нулями', 'масштаб: выжившие умножаются на 1/(1 − p) = 2', 'на тесте dropout выключен: слой тождественный'],
      desc: 'Сверху: вектор h = (2, 0.5, 1, 3) поэлементно умножается на маску (1, 0, 1, 0), получается (2, 0, 1, 0), затем умножается на 2, получается (4, 0, 2, 0). Справа среднее по 100 000 масок: (2.00, 0.50, 1.00, 2.99). Снизу: на тесте h проходит без изменений.',
    }
  : {
      title: 'Inverted dropout in training and at test time',
      train: 'training (model.train())', test: 'test (model.eval())', mask: 'mask m', prod: 'm ⊙ h', outT: 'output', identity: 'identity', outE: 'output = h',
      mean1: 'mean over 100,000 masks:', scale: '× 1/(1 − p)',
      steps: ['mask: each unit is kept with probability 1 − p = 0.5', 'multiply: dropped units become 0', 'rescale: survivors are multiplied by 1/(1 − p) = 2', 'at test time dropout is off: the layer is the identity'],
      desc: 'Top: the vector h = (2, 0.5, 1, 3) is multiplied elementwise by the mask (1, 0, 1, 0), giving (2, 0, 1, 0), then by 2, giving (4, 0, 2, 0). On the right, the mean over 100,000 masks: (2.00, 0.50, 1.00, 2.99). Bottom: at test time h passes unchanged.',
    };
const id = 'losses-inverted-dropout';
const caption = ru
  ? 'Пример из текста: p = 0.5 — вероятность выбросить нейрон. При обучении каждый нейрон независимо обнуляется (шаги 1–2), а выжившие делятся на 1 − p (шаг 3), поэтому математическое ожидание каждого выхода равно его входу: среднее по 100 000 случайных масок совпадает с h с точностью до шума выборки. На тесте (шаг 4) слой ничего не делает, и следующий слой видит входы того же среднего размера, что и при обучении. Маска новая для каждого примера и каждого шага.'
  : 'The worked example of the text: p = 0.5 is the probability of dropping a unit. In training, each unit is zeroed independently (steps 1–2) and the survivors are divided by 1 − p (step 3), so the expected value of each output equals its input: the mean over 100,000 random masks matches h up to sampling noise. At test time (step 4) the layer does nothing, and the next layer sees inputs of the same average size as in training. The mask is new for every example and every step.';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 374" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <text class="f-small f-t-muted" x="16" y="20">{t.train}</text>
    <Vec x={40} y={50} values={S(h)} tone="h" cw={48} label="h" />
    <g data-s="1">
      <Vec x={186} y={160} values={S(mask)} tone="g" cw={48} label={t.mask} labelPos="below" />
      <Arrow pts={[[210, 160], [210, 108]]} tone="amber" />
      <Badge x={260} y={190} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[88, 94], [195, 94]]} />
      <Op x={210} y={94} sym="⊙" />
      <Arrow pts={[[223, 94], [286, 94]]} />
      <Vec x={288} y={50} values={S(kept)} tone="h" cw={48} label={t.prod} />
      <Badge x={210} y={62} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[336, 94], [365, 94]]} />
      <Op x={416} y={94} sym={t.scale} tone="amber" />
      <Arrow pts={[[466, 94], [494, 94]]} />
      <Vec x={496} y={50} values={S(out)} tone="y" cw={48} label={t.outT} />
      <text class="f-small f-t-muted" x="566" y="80">{t.mean1}</text>
      <text class="f-small" x="566" y="100">{avg}</text>
      <Badge x={416} y={62} n={3} />
    </g>
    <g data-s="4">
      <text class="f-small f-t-muted" x="76" y="300">{t.test}</text>
      <Arrow pts={[[64, 138], [64, 330], [134, 330]]} />
      <Box x={136} y={312} w={130} h={36} label={t.identity} />
      <Arrow pts={[[266, 330], [300, 330]]} />
      <Vec x={302} y={319} values={S(h)} tone="y" dir="row" cw={48} label={t.outE} labelPos="right" />
      <Badge x={284} y={300} n={4} />
    </g>
    <Legend x={290} y={366} step={120} rows={1} />
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 452" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <text class="f-small f-t-muted" x="16" y="20">{t.train}</text>
    <Vec x={20} y={50} values={S(h)} tone="h" cw={40} label="h" />
    <g data-s="1">
      <Vec x={77} y={160} values={S(mask)} tone="g" cw={40} label="m" labelPos="left" />
      <Arrow pts={[[97, 160], [97, 108]]} tone="amber" />
      <Badge x={132} y={236} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[60, 94], [83, 94]]} />
      <Op x={97} y={94} sym="⊙" />
      <Arrow pts={[[110, 94], [132, 94]]} />
      <Vec x={134} y={50} values={S(kept)} tone="h" cw={40} label={t.prod} />
      <Badge x={97} y={34} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[174, 94], [196, 94]]} />
      <Op x={215} y={94} sym="× 2" tone="amber" />
      <Arrow pts={[[234, 94], [256, 94]]} />
      <Vec x={258} y={50} values={S(out)} tone="y" cw={40} label={t.outT} />
      <text class="f-small f-t-muted" x="134" y="178">{t.mean1}</text>
      <text class="f-small" x="134" y="200">{avg}</text>
      <Badge x={215} y={62} n={3} />
    </g>
    <g data-s="4">
      <text class="f-small f-t-muted" x="60" y="270">{t.test}</text>
      <Arrow pts={[[40, 138], [40, 300], [74, 300]]} />
      <Box x={76} y={284} w={130} h={32} label={t.identity} />
      <Arrow pts={[[141, 316], [141, 344]]} />
      <Vec x={61} y={346} values={S(h)} tone="y" dir="row" cw={40} />
      <text class="f-small" x="227" y="361">{t.outE}</text>
      <Badge x={226} y={300} n={4} />
    </g>
    <Legend x={16} y={420} step={170} rows={2} />
  </svg>
  <Stepper steps={t.steps} />
</Figure>
