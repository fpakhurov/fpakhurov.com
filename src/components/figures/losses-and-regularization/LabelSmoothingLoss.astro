---
import Figure from '../Figure.astro';
import { scale, plot } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// K = 10 classes, the true logit is g and the other nine are 0. Plain cross-entropy: log(e^g + 9) − g.
// With label smoothing ε: log(e^g + 9) − (1 − ε + ε/K) g, minimal at e^g = (1 − ε + ε/K)(K − 1)/(ε(K − 1)/K) = 91.
const K = 10, eps = 0.1, qy = 1 - eps + eps / K;
const plain = (g: number) => Math.log(Math.exp(g) + K - 1) - g;
const smooth = (g: number) => Math.log(Math.exp(g) + K - 1) - qy * g;
const gStar = Math.log(qy / (eps / K));
const entropy = -(qy * Math.log(qy) + (K - 1) * (eps / K) * Math.log(eps / K));
const q = [gStar.toFixed(3), smooth(gStar).toFixed(4), entropy.toFixed(4), plain(2).toFixed(4), smooth(2).toFixed(4), plain(8).toFixed(3), smooth(8).toFixed(3), plain(16).toFixed(1), smooth(16).toFixed(2)].join(' ');
if (q !== '4.511 0.5003 0.5003 0.7966 0.9766 0.003 0.723 0.0 1.44') throw new Error(`LabelSmoothingLoss: values drifted from the Code section (${q})`);
const slope = 1 - qy;

const t = ru
  ? { title: 'Сглаживание меток делает оптимум конечным', x: 'разрыв логитов g', y: 'потери',
      plain: 'кросс-энтропия, one-hot', smooth: 'со сглаживанием, ε = 0.1', min: `минимум: g = log 91 = ${gStar.toFixed(2)}`, slope: `наклон → ${slope.toFixed(2)}`,
      desc: 'Две кривые от разрыва логитов g от 0 до 16 при десяти классах. Обычная кросс-энтропия убывает к нулю всё время. Со сглаживанием ε = 0.1 кривая достигает минимума 0.500 при g = 4.51 и затем растёт с наклоном 0.09.' }
  : { title: 'Label smoothing makes the optimum finite', x: 'logit gap g', y: 'loss',
      plain: 'cross-entropy, one-hot', smooth: 'with label smoothing, ε = 0.1', min: `minimum: g = log 91 = ${gStar.toFixed(2)}`, slope: `slope → ${slope.toFixed(2)}`,
      desc: 'Two curves against the logit gap g from 0 to 16, for ten classes. Plain cross-entropy keeps decreasing towards zero. With label smoothing ε = 0.1 the curve reaches its minimum 0.500 at g = 4.51 and then rises with slope 0.09.' };
const id = 'losses-label-smoothing';
const caption = ru
  ? `Десять классов; логит верного класса равен g, остальные девять — нулю. Обычная кросс-энтропия log(e^g + 9) − g убывает к нулю при g → ∞, и сеть, которая может идеально подогнать обучающую выборку, наращивает логиты без конца. Со сглаживанием ε = 0.1 цель q даёт 0.91 верному классу и по 0.01 остальным, потери равны log(e^g + 9) − 0.91g: минимум ${smooth(gStar).toFixed(3)} (энтропия q) при g = log 91 = ${gStar.toFixed(3)}, где p = q; дальше потери растут с наклоном, стремящимся к 0.09 (при g = 8 — 0.723, при g = 16 — 1.44).`
  : `Ten classes; the true class has logit g and the other nine have 0. Plain cross-entropy, log(e^g + 9) − g, decreases towards zero as g → ∞, so a network that can fit its training set perfectly keeps growing its logits. With label smoothing ε = 0.1 the target q puts 0.91 on the true class and 0.01 on each other, and the loss is log(e^g + 9) − 0.91g: its minimum ${smooth(gStar).toFixed(3)} (the entropy of q) is at g = log 91 = ${gStar.toFixed(3)}, where p = q; beyond it the loss rises with a slope approaching 0.09 (0.723 at g = 8, 1.44 at g = 16).`;
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 320, px: [64, 720] as [number, number], py: [28, 240] as [number, number], lx: 380, ly: 52 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 400, px: [48, 344] as [number, number], py: [28, 250] as [number, number], lx: 48, ly: 330 },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => {
    const sx = scale([0, 16], Ly.px), sy = scale([0, 2.5], [Ly.py[1], Ly.py[0]]);
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
        {[0.5, 1, 1.5, 2, 2.5].map((v) => <path class="f-grid" d={`M ${Ly.px[0]} ${sy(v)} H ${Ly.px[1]}`} />)}
        <path class="f-axis" d={`M ${Ly.px[0]} ${Ly.py[1]} H ${Ly.px[1]} M ${Ly.px[0]} ${Ly.py[0]} V ${Ly.py[1]}`} />
        {[0, 4, 8, 12, 16].map((v) => <text class="f-note" x={sx(v)} y={Ly.py[1] + 18} text-anchor="middle">{v}</text>)}
        {[0, 0.5, 1, 1.5, 2, 2.5].map((v) => <text class="f-note" x={Ly.px[0] - 7} y={sy(v) + 5} text-anchor="end">{v}</text>)}
        <text class="f-small" x={(Ly.px[0] + Ly.px[1]) / 2} y={Ly.py[1] + 40} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={Ly.px[0]} y={Ly.py[0] - 10}>{t.y}</text>
        <path class="f-line f-blue" d={plot(plain, 0, 16, sx, sy, 200)} />
        <path class="f-line f-red" style="stroke-width: 2.4" d={plot(smooth, 0, 16, sx, sy, 200)} />
        <path class="f-thin f-muted f-dash" d={`M ${sx(gStar)} ${sy(smooth(gStar))} V ${Ly.py[1]}`} />
        <circle cx={sx(gStar)} cy={sy(smooth(gStar))} r="4.5" class="f-solid-red" />
        <text class="f-small f-halo" x={sx(gStar) + 8} y={sy(smooth(gStar)) + 22}>{t.min}</text>
        <text class="f-small f-t-red f-halo" x={sx(14)} y={sy(smooth(14)) - 12} text-anchor="middle">{t.slope}</text>
        {[8, 16].map((g) => <circle cx={sx(g)} cy={sy(smooth(g))} r="3.5" class="f-solid-red" />)}
        <path class="f-line f-blue" d={`M ${Ly.lx} ${Ly.ly - 4} h 26`} />
        <text class="f-small" x={Ly.lx + 34} y={Ly.ly}>{t.plain}</text>
        <path class="f-line f-red" style="stroke-width: 2.4" d={`M ${Ly.lx} ${Ly.ly + 22} h 26`} />
        <text class="f-small" x={Ly.lx + 34} y={Ly.ly + 26}>{t.smooth}</text>
        <text class="f-note" x={Ly.lx} y={Ly.ly + 58}>K = 10</text>
      </svg>
    );
  })}
</Figure>
