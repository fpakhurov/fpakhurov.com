---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The experiment of the note (Code section, means over three seeds): 300 training digits with 55 wrong labels,
// 1497 clean validation digits, a 64 -> 256 -> 256 -> 10 network, AdamW, 200 epochs.
const rows = [
  { en: 'none', ru: 'нет', train: 1.0, val: 0.807, fitted: 1.0 },
  { en: 'weight decay', ru: 'затухание весов', short: 'decay', shortRu: 'затухание', train: 0.979, val: 0.842, fitted: 0.885 },
  { en: 'dropout', ru: 'дропаут', train: 0.989, val: 0.843, fitted: 0.939 },
  { en: 'both', ru: 'оба', train: 0.887, val: 0.881, fitted: 0.4 },
];
const gaps = rows.map((r) => (r.train - r.val).toFixed(3));
if (gaps.join(' ') !== '0.193 0.137 0.146 0.006') throw new Error(`RegularizationGap: gaps drifted from the table (${gaps.join(' ')})`);

const t = ru
  ? { title: 'Регуляризация сужает разрыв между обучением и валидацией', y: 'доля правильных ответов', train: 'обучение (шумные метки)', val: 'валидация', fitted: 'запомнено неверных меток',
      desc: 'Для четырёх вариантов — без регуляризации, затухание весов, дропаут и оба вместе — точки доли правильных ответов на обучающей и валидационной выборках, соединённые отрезком. Разрывы 0.193, 0.137, 0.146 и 0.006; доля правильных ответов на валидации растёт с 0.807 до 0.881.' }
  : { title: 'Regularization narrows the gap between training and validation', y: 'accuracy', train: 'training (noisy labels)', val: 'validation', fitted: 'wrong labels fitted',
      desc: 'For four configurations, none, weight decay, dropout and both, dots for training and validation accuracy joined by a segment. The gaps are 0.193, 0.137, 0.146 and 0.006; validation accuracy rises from 0.807 to 0.881.' };
const id = 'losses-regularization-gap';
const caption = ru
  ? '300 обучающих изображений цифр, у 55 из них неверные метки; 1497 валидационных изображений с верными метками; сеть 64 → 256 → 256 → 10, AdamW, 200 эпох, среднее по трём начальным значениям генератора (seed). Синие точки — доля правильных ответов на обучающей выборке (по тем зашумлённым меткам, на которых сеть училась), красные — на валидационной; длина отрезка — разрыв. Под каждым вариантом — доля из 55 неверных меток, которые сеть воспроизводит. Затухание весов (λ = 1 в AdamW) и дропаут (p = 0.5) по отдельности сужают разрыв примерно на четверть, вместе почти закрывают его.'
  : '300 training digits, 55 of them with wrong labels; 1497 validation digits with correct labels; a 64 → 256 → 256 → 10 network, AdamW, 200 epochs, means over three seeds. Blue dots: accuracy on the training set (against the noisy labels the network was trained on); red dots: on the validation set; the segment is the gap. Under each configuration, the fraction of the 55 wrong labels that the network reproduces. Weight decay (λ = 1 in AdamW) and dropout (p = 0.5) each narrow the gap by about a quarter; together they nearly close it.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [76, 540] as [number, number], py: [30, 230] as [number, number], lx: 566, ly: 60, short: false },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 400, px: [52, 344] as [number, number], py: [30, 230] as [number, number], lx: 52, ly: 340, short: true },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => {
    const sy = scale([0.75, 1.0], [Ly.py[1], Ly.py[0]]);
    const slot = (Ly.px[1] - Ly.px[0]) / rows.length;
    const cx = (i: number) => Ly.px[0] + slot * (i + 0.5);
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
        {[0.8, 0.85, 0.9, 0.95, 1.0].map((v) => <path class="f-grid" d={`M ${Ly.px[0]} ${sy(v)} H ${Ly.px[1]}`} />)}
        <path class="f-axis" d={`M ${Ly.px[0]} ${Ly.py[1]} H ${Ly.px[1]} M ${Ly.px[0]} ${Ly.py[0]} V ${Ly.py[1]}`} />
        {[0.75, 0.8, 0.85, 0.9, 0.95, 1.0].map((v) => <text class="f-note" x={Ly.px[0] - 7} y={sy(v) + 5} text-anchor="end">{v.toFixed(2)}</text>)}
        <text class="f-small f-t-muted" x={Ly.px[0] - 44} y={Ly.py[0] - 14}>{t.y}</text>
        {rows.map((r, i) => (
          <g>
            <path class="f-line" style="stroke-opacity: .5" d={`M ${cx(i)} ${sy(r.train)} V ${sy(r.val)}`} />
            <circle cx={cx(i)} cy={sy(r.train)} r="6" class="f-solid-blue" />
            <circle cx={cx(i)} cy={sy(r.val)} r="6" class="f-solid-red" />
            <text class="f-small f-halo" x={cx(i) + 12} y={(sy(r.train) + sy(r.val)) / 2 + 5}>{gaps[i]}</text>
            <text class="f-small" x={cx(i)} y={Ly.py[1] + 20} text-anchor="middle">{Ly.short && 'short' in r ? (ru ? (r as { shortRu: string }).shortRu : (r as { short: string }).short) : ru ? r.ru : r.en}</text>
            <text class="f-note" x={cx(i)} y={Ly.py[1] + 40} text-anchor="middle">{`${Math.round(r.fitted * 100)}%`}</text>
          </g>
        ))}
        <text class="f-small f-t-muted" x={Ly.short ? Ly.px[0] : Ly.px[0] - 66} y={Ly.py[1] + (Ly.short ? 62 : 40)}>{Ly.short ? `${t.fitted} ↑` : ''}</text>
        {!Ly.short && <text class="f-small f-t-muted" x={Ly.px[1] + 14} y={Ly.py[1] + 40}>{`← ${t.fitted}`}</text>}
        <circle cx={Ly.lx + 6} cy={Ly.ly - 4} r="6" class="f-solid-blue" />
        <text class="f-small" x={Ly.lx + 20} y={Ly.ly}>{t.train}</text>
        <circle cx={Ly.lx + 6} cy={Ly.ly + 22} r="6" class="f-solid-red" />
        <text class="f-small" x={Ly.lx + 20} y={Ly.ly + 26}>{t.val}</text>
      </svg>
    );
  })}
</Figure>
