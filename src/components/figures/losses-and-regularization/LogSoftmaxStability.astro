---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The loss −log p_k of a class whose logit lies g below the largest one (two classes), computed in 32-bit arithmetic
// (Math.fround after every operation) two ways, minus the exact value g + log(1 + e^{−g}):
//   naive: p = e^{−g} / (1 + e^{−g}), then −log p;   stable: log_softmax = −g − log(1 + e^{−g}).
const f32 = Math.fround;
const exact = (g: number) => g + Math.log1p(Math.exp(-g));
function naive(g: number) {
  const e = f32(Math.exp(-g));
  const p = f32(e / f32(1 + e));
  return p === 0 ? Infinity : -f32(Math.log(p));
}
const stable = (g: number) => -f32(f32(-g) - f32(Math.log(f32(1 + f32(Math.exp(-g))))));
const subnormal = 126 * Math.LN2, smallest = 149 * Math.LN2, zeroAt = 150 * Math.LN2;
// the worked example: at g = 100 the naive log-probability is −99.983; p is 0 from g = 150 ln 2 = 103.97 on
if (naive(100).toFixed(3) !== '99.983' || naive(103.96) === Infinity || naive(103.98) !== Infinity) throw new Error('LogSoftmaxStability: float32 behaviour drifted');
if (subnormal.toFixed(2) !== '87.34' || smallest.toFixed(2) !== '103.28' || zeroAt.toFixed(2) !== '103.97') throw new Error('LogSoftmaxStability: thresholds drifted');
const gs: number[] = [];
for (let g = 80; g < 95; g += 0.05) gs.push(g);
for (let g = 95; g < zeroAt - 0.001; g += 0.01) gs.push(g);
const errNaive = gs.map((g) => naive(g) - exact(g));
const lo = Math.min(...errNaive), hi = Math.max(...errNaive);
if (lo.toFixed(2) !== '-0.69' || hi.toFixed(2) !== '0.40') throw new Error(`LogSoftmaxStability: error range drifted (${lo}, ${hi})`);
if (Math.max(...gs.map((g) => Math.abs(stable(g) - exact(g)))) > 1e-5) throw new Error('LogSoftmaxStability: stable error too large');

const t = ru
  ? { title: 'Ошибка вычисления функции потерь в 32-битной арифметике', x: 'отставание логита g = max z − z_k', y: 'вычислено − точно',
      naive: 'log(softmax(z))', stable: 'log_softmax(z)', sub: 'субнормальные числа', zero: 'p = 0', inf: 'потери = ∞, градиент NaN', at100: 'g = 100: −99.983 вместо −100',
      desc: 'По горизонтали — отставание логита класса от наибольшего, от 80 до 110. Синяя линия log_softmax лежит на нуле. Красная линия log(softmax) совпадает с нулём до 87.34, затем колеблется со всё большей амплитудой, до −0.69 и 0.40, а после 103.97 вероятность обращается в ноль и потери бесконечны.' }
  : { title: 'The error of the computed loss in 32-bit arithmetic', x: 'logit gap g = max z − z_k', y: 'computed − exact',
      naive: 'log(softmax(z))', stable: 'log_softmax(z)', sub: 'subnormal numbers', zero: 'p = 0', inf: 'loss = ∞, gradient NaN', at100: 'g = 100: −99.983 instead of −100',
      desc: 'Horizontal: how far the class logit lies below the largest one, from 80 to 110. The blue line, log_softmax, lies on zero. The red line, log of softmax, is zero up to 87.34, then oscillates with growing amplitude, down to −0.69 and up to 0.40, and beyond 103.97 the probability is 0 and the loss infinite.' };
const id = 'losses-log-softmax-stability';
const caption = ru
  ? 'Функция потерь −log p_k класса, логит которого на g меньше наибольшего, вычисленная в 32-битной арифметике двумя способами, минус точное значение. Красная линия — сначала вероятность, потом логарифм: пока e^{−g} больше наименьшего нормального числа 2⁻¹²⁶ = e^{−87.34}, ошибка порядка 10⁻⁶; дальше вероятность хранится субнормальным числом с немногими значащими битами, и ошибка растёт до 0.69 у e^{−103.28} = 2⁻¹⁴⁹; при g > 103.97 вероятность округляется до нуля, потери бесконечны, градиент не определён. Синяя — log_softmax, который не вычисляет вероятность вовсе: его ошибка не больше 10⁻⁵ на всём графике.'
  : 'The loss −log p_k of a class whose logit lies g below the largest one, computed in 32-bit arithmetic two ways, minus the exact value. Red: probability first, then the log. While e^{−g} is above the smallest normal number 2⁻¹²⁶ = e^{−87.34}, the error is of order 10⁻⁶; beyond it the probability is stored as a subnormal number with few significant bits, and the error grows to 0.69 near e^{−103.28} = 2⁻¹⁴⁹. For g > 103.97 the probability rounds to zero, the loss is infinite and the gradient undefined. Blue: log_softmax, which never forms the probability; its error stays below 10⁻⁵ on the whole plot.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [76, 700] as [number, number], py: [44, 250] as [number, number], lx: 420, ly: 22, lstep: 160, n: false },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 430, px: [56, 344] as [number, number], py: [40, 280] as [number, number], lx: 56, ly: 360, lstep: 0, n: true },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => {
    const sx = scale([80, 110], Ly.px), sy = scale([-0.8, 0.8], [Ly.py[1], Ly.py[0]]);
    const red = polyline(gs.map((g, i) => [sx(g), sy(errNaive[i])] as [number, number]));
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
        <rect x={sx(zeroAt)} y={Ly.py[0]} width={Ly.px[1] - sx(zeroAt)} height={Ly.py[1] - Ly.py[0]} class="f-fill-red" style="fill-opacity: .1" />
        {[-0.8, -0.4, 0.4, 0.8].map((v) => <path class="f-grid" d={`M ${Ly.px[0]} ${sy(v)} H ${Ly.px[1]}`} />)}
        <path class="f-axis" d={`M ${Ly.px[0]} ${Ly.py[1]} H ${Ly.px[1]} M ${Ly.px[0]} ${Ly.py[0]} V ${Ly.py[1]}`} />
        <path class="f-thin f-muted" d={`M ${Ly.px[0]} ${sy(0)} H ${Ly.px[1]}`} />
        {[80, 85, 90, 95, 100, 105, 110].map((v) => <text class="f-note" x={sx(v)} y={Ly.py[1] + 18} text-anchor="middle">{v}</text>)}
        {[-0.8, -0.4, 0, 0.4, 0.8].map((v) => <text class="f-note" x={Ly.px[0] - 7} y={sy(v) + 5} text-anchor="end">{String(v).replace('-', '−')}</text>)}
        <text class="f-small" x={(Ly.px[0] + Ly.px[1]) / 2} y={Ly.py[1] + 40} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={Ly.px[0] - 44} y={Ly.py[0] - 12}>{t.y}</text>
        <path class="f-thin f-muted f-dash" d={`M ${sx(subnormal)} ${Ly.py[0]} V ${Ly.py[1]}`} />
        <text class="f-small f-t-muted f-halo" x={sx(subnormal) + 6} y={sy(0.7)}>{t.sub} →</text>
        <path class="f-thin f-red f-dash" d={`M ${sx(zeroAt)} ${Ly.py[0]} V ${Ly.py[1]}`} />
        <text class="f-small f-t-red f-halo" x={sx(zeroAt) + 6} y={sy(0.7)}>{t.zero}</text>
        <text class="f-small f-t-red f-halo" x={Ly.n ? Ly.px[1] : sx(zeroAt) + 6} y={Ly.n ? 26 : sy(0.55)} text-anchor={Ly.n ? 'end' : 'start'}>{t.inf}</text>
        <path class="f-line f-red" style="stroke-width: 1.2" d={red} />
        <path class="f-line f-blue" style="stroke-width: 2.4" d={`M ${Ly.px[0]} ${sy(0)} H ${sx(110)}`} />
        <circle cx={sx(100)} cy={sy(naive(100) - exact(100))} r="4" class="f-solid-red" />
        <path class="f-thin f-muted" d={`M ${sx(100)} ${sy(naive(100) - exact(100)) + 6} V ${sy(-0.5)}`} />
        <text class="f-small f-halo" x={sx(100) - 4} y={sy(-0.5) + 16} text-anchor="end">{Ly.n ? t.at100.split(' instead')[0].split(' вместо')[0] : t.at100}</text>
        <path class="f-line f-red" style="stroke-width: 1.2" d={`M ${Ly.lx} ${Ly.ly - 4} h 26`} />
        <text class="f-small" x={Ly.lx + 34} y={Ly.ly}>{t.naive}</text>
        <path class="f-line f-blue" style="stroke-width: 2.4" d={`M ${Ly.lx + Ly.lstep} ${Ly.ly - 4 + (Ly.n ? 26 : 0)} h 26`} />
        <text class="f-small" x={Ly.lx + Ly.lstep + 34} y={Ly.ly + (Ly.n ? 26 : 0)}>{t.stable}</text>
      </svg>
    );
  })}
</Figure>
