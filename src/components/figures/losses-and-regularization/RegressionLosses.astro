---
import Figure from '../Figure.astro';
import { scale, plot } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Squared error r², absolute error |r| and the Huber loss with δ = 1, and their derivatives 2r, sign r, clip(r, −1, 1).
const delta = 1;
const sq = (r: number) => r * r, ab = (r: number) => Math.abs(r);
const hub = (r: number) => (Math.abs(r) <= delta ? 0.5 * r * r : delta * (Math.abs(r) - 0.5 * delta));
const dsq = (r: number) => 2 * r, dab = (r: number) => Math.sign(r), dhub = (r: number) => Math.max(-delta, Math.min(delta, r));
// the worked example: residuals (0.5, −2, 10)
const res = [0.5, -2, 10];
const mean = (f: (r: number) => number) => res.reduce((s, r) => s + f(r), 0) / res.length;
const q = [mean(sq).toFixed(2), mean(ab).toFixed(3), mean(hub).toFixed(3), res.map(dsq).join(' '), res.map(dab).join(' '), res.map(dhub).join(' ')].join(' | ');
if (q !== '34.75 | 4.167 | 3.708 | 1 -4 20 | 1 -1 1 | 0.5 -1 1') throw new Error(`RegressionLosses: the worked example drifted (${q})`);
const share = Math.abs(dsq(10)) / res.reduce((s, r) => s + Math.abs(dsq(r)), 0);
if (share !== 0.8) throw new Error('RegressionLosses: outlier share drifted');

const curves = [
  { f: sq, d: dsq, cls: 'f-line f-blue', en: 'squared error r²', ru: 'квадратичная ошибка r²' },
  { f: ab, d: dab, cls: 'f-line f-green', en: 'absolute error |r|', ru: 'абсолютная ошибка |r|' },
  { f: hub, d: dhub, cls: 'f-line f-red', en: 'Huber, δ = 1', ru: 'функция Хьюбера, δ = 1' },
];
const marks = [0.5, -2];
const t = ru
  ? { title: 'Функции потерь для регрессии и их производные', loss: 'функция потерь ℓ(r)', grad: 'производная ℓ′(r)', r: 'остаток r',
      desc: 'Слева: квадратичная ошибка, абсолютная ошибка и функция потерь Хьюбера в зависимости от остатка r на отрезке от −3 до 3. Справа: их производные — прямая 2r, ступенька sign r и обрезанная прямая clip(r, −1, 1). Точки отмечают остатки 0.5 и −2 из примера.' }
  : { title: 'Regression losses and their derivatives', loss: 'loss ℓ(r)', grad: 'derivative ℓ′(r)', r: 'residual r',
      desc: 'Left: the squared, absolute and Huber losses of the residual r between −3 and 3. Right: their derivatives, the line 2r, the step sign r and the clipped line clip(r, −1, 1). Dots mark the residuals 0.5 and −2 of the worked example.' };
const id = 'losses-regression-losses';
const caption = ru
  ? 'Квадратичная ошибка тянет пропорционально остатку (производная 2r), абсолютная — с постоянной силой (sign r), функция Хьюбера с δ = 1 — как квадратичная ½r² около нуля и как абсолютная дальше (clip(r, −1, 1)). Точки — остатки 0.5 и −2 из разобранного примера в тексте. Третий остаток, выброс r = 10, лежит за пределами графика: его производные 20, 1 и 1, так что в квадратичной ошибке он даёт 80% суммарного градиента.'
  : 'The squared error pulls in proportion to the residual (derivative 2r), the absolute error with a constant force (sign r), and the Huber loss with δ = 1 like the squared error ½r² near zero and like the absolute error beyond (clip(r, −1, 1)). The dots are the residuals 0.5 and −2 of the worked example. Its third residual, the outlier r = 10, lies off the plot: its derivatives are 20, 1 and 1, so under the squared error it supplies 80% of the total gradient.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 320, panels: [{ px: [56, 350], py: [28, 230] }, { px: [436, 730], py: [28, 230] }], ly: 300, lstep: 230, lx: 56 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 600, panels: [{ px: [50, 340], py: [28, 210] }, { px: [50, 340], py: [292, 474] }], ly: 540, lstep: 0, lx: 50 },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => (
    <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
      <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
      {Ly.panels.map((P, k) => {
        const sx = scale([-3, 3], P.px as [number, number]);
        const yr: [number, number] = k === 0 ? [0, 4] : [-4.5, 4.5];
        const sy = scale(yr, [P.py[1], P.py[0]]);
        const ticks = k === 0 ? [0, 1, 2, 3, 4] : [-4, -2, 0, 2, 4];
        const clip = `${id}-${Ly.sfx}-clip${k}`;
        return (
          <g>
            <defs><clipPath id={clip}><rect x={P.px[0]} y={P.py[0]} width={P.px[1] - P.px[0]} height={P.py[1] - P.py[0]} /></clipPath></defs>
            {ticks.map((v) => <path class="f-grid" d={`M ${P.px[0]} ${sy(v)} H ${P.px[1]}`} />)}
            <path class="f-axis" d={`M ${P.px[0]} ${sy(0)} H ${P.px[1]} M ${sx(0)} ${P.py[0]} V ${P.py[1]}`} />
            {ticks.filter((v) => v !== 0 || k === 0).map((v) => <text class="f-note" x={P.px[0] - 6} y={sy(v) + 5} text-anchor="end">{String(v).replace('-', '−')}</text>)}
            {[-3, -2, -1, 1, 2, 3].map((v) => <text class="f-note" x={sx(v)} y={P.py[1] + 18} text-anchor="middle">{String(v).replace('-', '−')}</text>)}
            <text class="f-small" x={P.px[1]} y={P.py[1] + 38} text-anchor="end">{t.r}</text>
            <text class="f-small f-t-muted" x={P.px[0]} y={P.py[0] - 10}>{k === 0 ? t.loss : t.grad}</text>
            <g clip-path={`url(#${clip})`}>
              {curves.map((c) => k === 0
                ? <path class={c.cls} d={plot(c.f, -3, 3, sx, sy, 240)} />
                : <path class={c.cls} d={c.d === dab ? `M ${sx(-3)} ${sy(-1)} H ${sx(0)} M ${sx(0)} ${sy(1)} H ${sx(3)}` : plot(c.d, -3, 3, sx, sy, 240)} />)}
            </g>
            {curves.map((c) => marks.map((r) => <circle cx={sx(r)} cy={sy(k === 0 ? c.f(r) : c.d(r))} r="4" class={c.cls.replace('f-line', 'f-solid').replace('f-solid f-', 'f-solid-')} />))}
          </g>
        );
      })}
      {curves.map((c, i) => {
        const x = Ly.lx + i * Ly.lstep, y = Ly.ly + (Ly.lstep ? 0 : i * 24);
        return (
          <g>
            <path class={c.cls} d={`M ${x} ${y - 4} h 26`} />
            <text class="f-small" x={x + 34} y={y}>{ru ? c.ru : c.en}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
