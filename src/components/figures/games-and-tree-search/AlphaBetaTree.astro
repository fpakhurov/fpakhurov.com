---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The worked example: a MAX root over three MIN nodes with three leaves each, searched left to right by alpha–beta.
const leaves = [[4, 7, 5], [2, 9, 6], [8, 3, 1]];
const seen: number[][] = [[], [], []];
const bounds: number[] = [];
let alpha = -Infinity;
leaves.forEach((kids, i) => {
  let m = Infinity;
  for (const x of kids) {
    seen[i].push(x);
    m = Math.min(m, x);
    if (m <= alpha) break;
  }
  bounds.push(m);
  alpha = Math.max(alpha, m);
});
const minimax = Math.max(...leaves.map((k) => Math.min(...k)));
const got = [seen.map((s) => s.join(',')).join(' '), bounds.join(','), alpha, minimax].join(' | ');
if (got !== '4,7,5 2 8,3 | 4,2,3 | 4 | 4') throw new Error(`AlphaBetaTree: drifted from the note (${got})`);
const evaluated = seen.flat().length;

const t = ru
  ? { title: 'Альфа-бета-отсечение на дереве глубины 2', max: 'MAX', min: 'MIN', pruned: 'отсечено',
      steps: ['первый узел MIN: min(4, 7, 5) = 4, у корня теперь α = 4', 'второй узел MIN: первый лист 2 ≤ α, значит, значение узла ≤ 2; листья 9 и 6 не нужны', 'третий узел MIN: 8, затем 3 ≤ α, значит, значение узла ≤ 3; лист 1 не нужен', 'корень: max(4, ≤ 2, ≤ 3) = 4, лучший ход — первый'],
      desc: `Корень MAX с тремя дочерними узлами MIN, у каждого по три листа: 4, 7, 5; 2, 9, 6; 8, 3, 1. Первый узел MIN получает значение 4. У второго после листа 2 отсекаются листья 9 и 6, у третьего после листьев 8 и 3 отсекается лист 1. Корень получает значение 4; оценено ${evaluated} листьев из 9.` }
  : { title: 'Alpha–beta pruning on a tree of depth 2', max: 'MAX', min: 'MIN', pruned: 'pruned',
      steps: ['first MIN node: min(4, 7, 5) = 4, so the root now has α = 4', 'second MIN node: its first leaf 2 ≤ α, so its value is ≤ 2; leaves 9 and 6 are not needed', 'third MIN node: 8, then 3 ≤ α, so its value is ≤ 3; leaf 1 is not needed', 'root: max(4, ≤ 2, ≤ 3) = 4, and the best move is the first'],
      desc: `A MAX root with three MIN children, each over three leaves: 4, 7, 5; 2, 9, 6; 8, 3, 1. The first MIN node gets the value 4. Below the second, the leaves 9 and 6 are pruned after the leaf 2; below the third, the leaf 1 is pruned after the leaves 8 and 3. The root gets the value 4; ${evaluated} of the 9 leaves are evaluated.` };
const id = 'alpha-beta-tree';
const caption = ru
  ? `MAX (треугольник вершиной вверх) выбирает ход с наибольшим значением, MIN (вершиной вниз) — с наименьшим. Поиск идёт слева направо и помнит α, лучшее значение, которое MAX уже может себе гарантировать. Как только значение узла MIN опускается до α или ниже, остальные его листья ничего не изменят: MAX туда не пойдёт. Оценено ${evaluated} листьев из 9, а значение корня, 4, то же, что у полного минимакса.`
  : `MAX (triangle pointing up) picks the move with the largest value, MIN (pointing down) the smallest. The search goes from left to right and remembers α, the best value MAX can already guarantee. As soon as the value of a MIN node drops to α or below, its remaining leaves cannot change anything: MAX will not go there. ${evaluated} of the 9 leaves are evaluated, and the root's value, 4, is the same as full minimax gives.`;
const tri = (x: number, y: number, r: number, up: boolean) => (up
  ? `M ${x} ${y - r} L ${x + r * 1.1} ${y + r * 0.75} L ${x - r * 1.1} ${y + r * 0.75} Z`
  : `M ${x} ${y + r} L ${x + r * 1.1} ${y - r * 0.75} L ${x - r * 1.1} ${y - r * 0.75} Z`);
const label = (i: number) => (i === 0 ? String(bounds[0]) : `≤ ${bounds[i]}`);
// the "pruned" label sits under the pruned leaves, kept inside the viewBox (about 7.3 px per character at narrow width)
const prunedX = (L: { minX: number[]; dx: number; W: number }, i: number) => {
  const centre = L.minX[i] + ((seen[i].length + 2) / 2 - 1) * L.dx;
  return Math.min(centre, L.W - 8 - (t.pruned.length * 7.3) / 2);
};
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 300, rootX: 380, rootY: 46, minX: [150, 380, 610], minY: 140, leafY: 236, dx: 66, r: 24, lw: 40, lh: 30 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 300, rootX: 180, rootY: 46, minX: [62, 180, 298], minY: 140, leafY: 236, dx: 34, r: 22, lw: 30, lh: 30 },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
      {leaves.map((kids, i) => (
        <g>
          <path class="f-line f-muted" d={`M ${L.rootX} ${L.rootY + L.r * 0.75} L ${L.minX[i]} ${L.minY - L.r * 0.75}`} />
          {kids.map((v, j) => {
            const x = L.minX[i] + (j - 1) * L.dx, used = j < seen[i].length;
            return (
              <g data-s={String(i + 1)}>
                <path class={`f-line ${used ? 'f-muted' : 'f-muted f-dash'}`} d={`M ${L.minX[i]} ${L.minY + L.r} L ${x} ${L.leafY - L.lh / 2}`} />
                <rect x={x - L.lw / 2} y={L.leafY - L.lh / 2} width={L.lw} height={L.lh} rx="5" class={used ? 'f-fill-paper' : 'f-box-soft'} style={`stroke: var(${used ? '--ink' : '--line'}); stroke-width: 1.2${used ? '' : '; stroke-dasharray: 4 3'}`} />
                <text class={`f-label ${used ? '' : 'f-t-muted'}`} x={x} y={L.leafY + 5} text-anchor="middle">{String(v)}</text>
              </g>
            );
          })}
          <g data-s={String(i + 1)}>
            <path d={tri(L.minX[i], L.minY, L.r, false)} class="f-fill-red" style="stroke: var(--fig-red); stroke-width: 1.4" />
            <text class="f-small" x={L.minX[i]} y={L.minY + 1} text-anchor="middle" style="font-weight: 650">{label(i)}</text>
            {seen[i].length < kids.length && <text class="f-small f-t-muted" x={prunedX(L, i)} y={L.leafY + L.lh / 2 + 18} text-anchor="middle">{t.pruned}</text>}
            <Badge x={L.minX[i] + L.r * 1.1 + 14} y={L.minY - 10} n={i + 1} />
          </g>
        </g>
      ))}
      <path d={tri(L.rootX, L.rootY, L.r, true)} class="f-fill-blue" style="stroke: var(--fig-blue); stroke-width: 1.4" />
      <g data-s="4">
        <text class="f-small" x={L.rootX} y={L.rootY + 9} text-anchor="middle" style="font-weight: 650">{String(alpha)}</text>
        <path class="f-line f-blue f-bold" d={`M ${L.rootX} ${L.rootY + L.r * 0.75} L ${L.minX[0]} ${L.minY - L.r * 0.75}`} />
        <Badge x={L.rootX + L.r * 1.1 + 14} y={L.rootY} n={4} />
      </g>
      <text class="f-small f-t-blue" x={L.rootX - L.r * 1.1 - 10} y={L.rootY + 5} text-anchor="end">{t.max}</text>
      <text class="f-small f-t-red" x={L.minX[0] - L.r * 1.1 - 8} y={L.minY - 6} text-anchor="end">{L.sfx === 'w' ? t.min : ''}</text>
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
