---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One iteration of MCTS with UCT on the worked example. Each node stores w/n: the wins and visits of the player who
// moved into it. The root has 24 visits; A, B, C are its children; A1, A2 are A's children and A has one untried move.
const c = Math.SQRT2;
const N = 24;
const kids = [{ id: 'A', w: 11, n: 14 }, { id: 'B', w: 1, n: 6 }, { id: 'C', w: 0, n: 4 }];
if (kids.reduce((s, k) => s + k.n, 0) !== N) throw new Error('MctsPhases: the root visits must equal the children visits');
const ucb = kids.map((k) => k.w / k.n + c * Math.sqrt(Math.log(N) / k.n));
const pick = ucb.indexOf(Math.max(...ucb));
const got = `${ucb.map((u) => u.toFixed(3)).join(' ')} ${kids[pick].id}`;
if (got !== '1.460 1.196 1.261 A') throw new Error(`MctsPhases: drifted from the note (${got})`);
// A's own statistics: 1 visit when it was expanded plus its children's visits; its wins from the root player's view
const aKids = [{ id: 'A1', w: 1, n: 8 }, { id: 'A2', w: 2, n: 5 }];
if (1 + aKids.reduce((s, k) => s + k.n, 0) !== kids[0].n) throw new Error('MctsPhases: A visits do not add up');
if (1 + aKids.reduce((s, k) => s + (k.n - k.w), 0) !== kids[0].w) throw new Error('MctsPhases: A wins do not add up');

const t = ru
  ? { title: 'Одна итерация поиска по дереву методом Монте-Карло', root: 'корень', untried: 'новый', sim: 'случайная доигровка', win1: 'победил игрок,', win2: 'сходивший в A',
      note1: 'w/n — победы и посещения игрока,', note2: 'который сделал ход в этот узел',
      steps: ['выбор: от корня к дочернему узлу с наибольшим UCB1; это A, и у A есть неопробованный ход', 'расширение: добавить дочерний узел A3 для неопробованного хода', 'симуляция: из A3 доиграть случайными ходами до конца партии; победил игрок, сходивший в A', 'обратное распространение: прибавить посещение к A3, A и корню и победу тем узлам, чей игрок выиграл'],
      desc: 'Дерево: корень с 24 посещениями, его дочерние узлы A (11 побед из 14), B (1 из 6), C (0 из 4) с оценками UCB1 1.460, 1.196 и 1.261. Выбран A. Под A узлы A1 (1 из 8), A2 (2 из 5) и новый узел A3. Из A3 пунктир случайной доигровки ведёт к победе игрока, сходившего в A. После обновления: A3 0 из 1, A 12 из 15, корень 25 посещений.' }
  : { title: 'One iteration of Monte Carlo tree search', root: 'root', untried: 'new', sim: 'random playout', win1: 'the player who', win2: 'moved into A wins',
      note1: 'w/n: wins and visits of the player', note2: 'who made the move into the node',
      steps: ['selection: from the root, go to the child with the largest UCB1 score; that is A, and A has an untried move', 'expansion: add a child A3 for the untried move', 'simulation: play random moves from A3 to the end of the game; the player who moved into A wins', 'backpropagation: add a visit to A3, A and the root, and a win to every node whose player won'],
      desc: 'A tree: the root with 24 visits; its children A (11 wins of 14), B (1 of 6) and C (0 of 4) with UCB1 scores 1.460, 1.196 and 1.261. A is selected. Under A are A1 (1 of 8), A2 (2 of 5) and the new node A3. From A3 a dashed random playout ends in a win for the player who moved into A. After the update: A3 has 0 of 1, A 12 of 15, the root 25 visits.' };
const id = 'mcts-phases';
const caption = ru
  ? `Счёт w/n у каждого узла ведётся для игрока, который сделал ход в этот узел, поэтому родитель выбирает дочерний узел по счёту самого этого узла. UCB1 = w/n + √2 · √(ln N / n) с N = ${N} посещениями родителя: у A 0.786 + 0.674 = 1.460, у B 0.167 + 1.029 = 1.196, у C 0 + 1.261 = 1.261. Слабый, но редко посещённый C обгоняет B: бонус исследования тем больше, чем меньше у узла посещений. При обратном распространении победа засчитывается через уровень: A (ход игрока у корня) получает победу, A3 (ход соперника) — поражение.`
  : `The score w/n of each node is kept for the player who made the move into it, so a parent picks a child by that child's own score. UCB1 = w/n + √2 · √(ln N / n) with N = ${N} visits of the parent: for A 0.786 + 0.674 = 1.460, for B 0.167 + 1.029 = 1.196, for C 0 + 1.261 = 1.261. The weak but rarely visited C overtakes B: the exploration bonus grows as a node's visits shrink. During backpropagation the win counts on alternate levels: A (a move of the player at the root) gets a win, A3 (a move of the opponent) a loss.`;
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 340, root: [380, 40], kid: [[220, 128], [380, 128], [540, 128]], a: [[140, 222], [220, 222], [300, 222]], sim: 300, simY: 312, lab: 24, ucb: [24, 5], ucbWord: true, a3After: [-21, 4, 'end'] as [number, number, string], noteX: 470, noteY: 300, simText: 322 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 440, root: [180, 36], kid: [[78, 122], [180, 122], [290, 122]], a: [[34, 250], [86, 250], [138, 250]], sim: 138, simY: 344, lab: 26, ucb: [19, 20], ucbWord: false, a3After: [21, 30, 'start'] as [number, number, string], noteX: 16, noteY: 406, simText: 160 },
];
const r = 15;
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const [rx, ry] = L.root;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {L.kid.map(([x, y]) => <path class="f-line f-muted" d={`M ${rx} ${ry + r} L ${x} ${y - r}`} />)}
        {L.a.slice(0, 2).map(([x, y]) => <path class="f-line f-muted" d={`M ${L.kid[0][0]} ${L.kid[0][1] + r} L ${x} ${y - r}`} />)}
        <circle cx={rx} cy={ry} r={r} class="f-fill-paper" style="stroke: var(--ink); stroke-width: 1.4" />
        <text class="f-small f-t-muted" x={rx + r + 6} y={ry + 4}>{`${t.root}: n = ${N}`}</text>
        {kids.map((k, i) => {
          const [x, y] = L.kid[i];
          return (
            <g>
              <circle cx={x} cy={y} r={r} class="f-fill-blue" style="stroke: var(--fig-blue); stroke-width: 1.3" />
              <text class="f-small" x={x} y={y + 4} text-anchor="middle" style="font-weight: 650">{k.id}</text>
              <text class="f-small" x={x - r - 6} y={y + 4} text-anchor="end">{`${k.w}/${k.n}`}</text>
            </g>
          );
        })}
        {aKids.map((k, i) => {
          const [x, y] = L.a[i];
          return (
            <g>
              <circle cx={x} cy={y} r={r} class="f-fill-red" style="stroke: var(--fig-red); stroke-width: 1.3" />
              <text class="f-small" x={x} y={y + 4} text-anchor="middle" style="font-weight: 650">{k.id}</text>
              <text class="f-small" x={x} y={y + L.lab + 4} text-anchor="middle">{`${k.w}/${k.n}`}</text>
            </g>
          );
        })}
        <g data-s="1">
          <path class="f-line f-amber f-bold" d={`M ${rx} ${ry + r} L ${L.kid[0][0]} ${L.kid[0][1] - r}`} />
          <circle cx={L.kid[0][0]} cy={L.kid[0][1]} r={r + 4} class="f-line f-amber" fill="none" />
          {kids.map((_, i) => <text class={`f-small ${i === pick ? 'f-t-amber' : 'f-t-muted'}`} x={L.kid[i][0] + L.ucb[0]} y={L.kid[i][1] + L.ucb[1]} style={i === pick ? 'font-weight: 650' : ''}>{`${L.ucbWord ? 'UCB ' : ''}${ucb[i].toFixed(3)}`}</text>)}
          <Badge x={(rx + L.kid[0][0]) / 2 - 14} y={(ry + L.kid[0][1]) / 2 - 18} n={1} />
        </g>
        <g data-s="2">
          <path class="f-line f-green" d={`M ${L.kid[0][0]} ${L.kid[0][1] + r} L ${L.a[2][0]} ${L.a[2][1] - r}`} />
          <circle cx={L.a[2][0]} cy={L.a[2][1]} r={r} class="f-fill-green" style="stroke: var(--fig-green); stroke-width: 1.4; stroke-dasharray: 4 3" />
          <text class="f-small" x={L.a[2][0]} y={L.a[2][1] + 4} text-anchor="middle" style="font-weight: 650">A3</text>
          <text class="f-small f-t-green" x={L.a[2][0] + r + 6} y={L.a[2][1] - 10}>{t.untried}</text>
          <Badge x={L.a[2][0] + r + 14} y={L.a[2][1] + 10} n={2} />
        </g>
        <g data-s="3">
          <path class="f-line f-dash f-muted" d={`M ${L.sim} ${L.a[2][1] + r} l 10 14 l -14 14 l 12 14 l -10 14 L ${L.sim} ${L.simY - 8}`} />
          <rect x={L.sim - 7} y={L.simY - 8} width="14" height="14" class="f-fill-ink" />
          <text class="f-small f-t-muted" x={L.simText} y={L.simY - 26}>{t.sim}</text>
          <text class="f-small f-t-red" x={L.simText} y={L.simY - 6}>{t.win1}</text>
          <text class="f-small f-t-red" x={L.simText} y={L.simY + 12}>{t.win2}</text>
          <Badge x={L.sim - 26} y={L.simY - 30} n={3} />
        </g>
        <g data-s="4">
          <text class="f-small f-t-red" x={L.a[2][0] + L.a3After[0]} y={L.a[2][1] + L.a3After[1]} text-anchor={L.a3After[2]} style="font-weight: 650">0/1</text>
          <text class="f-small f-t-red" x={L.kid[0][0] - r - 6} y={L.kid[0][1] + 22} text-anchor="end" style="font-weight: 650">→ 12/15</text>
          <text class="f-small f-t-red" x={rx + r + 6} y={ry + 22} style="font-weight: 650">{`→ n = ${N + 1}`}</text>
          <Badge x={rx - r - 16} y={ry} n={4} />
        </g>
        <text class="f-small f-t-muted" x={L.noteX} y={L.noteY}>{t.note1}</text>
        <text class="f-small f-t-muted" x={L.noteX} y={L.noteY + 18}>{t.note2}</text>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
