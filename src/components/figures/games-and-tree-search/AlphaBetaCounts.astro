---
import Figure from '../Figure.astro';
import { scale, polyline, seeded } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Uniform game trees with branching factor b = 4 and depth d = 1..8 (MAX at the root), leaf values uniform on [0, 1]
// from a seeded generator. Count the leaves evaluated by minimax, by alpha–beta in the generated order, and by alpha–beta
// with perfect ordering (children sorted by their true minimax value, best first for the player to move).
const b = 4, D = 8, TREES = 10;
function count(leaves: number[], d: number) {
  // minimax values of every level, bottom-up: vals[k] has b^k entries
  const vals: number[][] = new Array(d + 1);
  vals[d] = leaves;
  for (let k = d - 1; k >= 0; k--) {
    const below = vals[k + 1], maxLevel = k % 2 === 0;
    vals[k] = Array.from({ length: below.length / b }, (_, i) => {
      const kids = below.slice(i * b, i * b + b);
      return maxLevel ? Math.max(...kids) : Math.min(...kids);
    });
  }
  let n = 0;
  const ab = (k: number, i: number, alpha: number, beta: number, ordered: boolean): number => {
    if (k === d) { n++; return leaves[i]; }
    const maxLevel = k % 2 === 0;
    let order = Array.from({ length: b }, (_, j) => i * b + j);
    if (ordered) order = order.sort((p, q) => (maxLevel ? vals[k + 1][q] - vals[k + 1][p] : vals[k + 1][p] - vals[k + 1][q]));
    let v = maxLevel ? -Infinity : Infinity;
    for (const c of order) {
      const x = ab(k + 1, c, alpha, beta, ordered);
      if (maxLevel) { v = Math.max(v, x); alpha = Math.max(alpha, v); } else { v = Math.min(v, x); beta = Math.min(beta, v); }
      if (alpha >= beta) break;
    }
    return v;
  };
  const v1 = ab(0, 0, -Infinity, Infinity, false), plain = n;
  n = 0;
  const v2 = ab(0, 0, -Infinity, Infinity, true), best = n;
  if (v1 !== vals[0][0] || v2 !== vals[0][0]) throw new Error('AlphaBetaCounts: alpha–beta changed the minimax value');
  return { plain, best };
}
const rand = seeded(7);
const rows = Array.from({ length: D }, (_, k) => {
  const d = k + 1;
  let plain = 0, best = 0;
  for (let tr = 0; tr < TREES; tr++) {
    const leaves = Array.from({ length: b ** d }, () => rand());
    const c = count(leaves, d);
    const km = b ** Math.ceil(d / 2) + b ** Math.floor(d / 2) - 1;   // Knuth and Moore (1975)
    if (c.best !== km) throw new Error(`AlphaBetaCounts: perfect ordering gave ${c.best} leaves at depth ${d}, not ${km}`);
    plain += c.plain; best += c.best;
  }
  return { d, full: b ** d, plain: plain / TREES, best: best / TREES };
});
const last = rows[D - 1];
const ebf = (x: number) => x ** (1 / D);
const quoted = [last.full, last.best, ebf(last.plain).toFixed(2)].join(' ');
if (quoted !== '65536 511 3.04' || Math.round(last.plain) !== 7287) throw new Error(`AlphaBetaCounts: unexpected counts (${quoted})`);

const t = ru
  ? { title: 'Сколько листьев оценивает альфа-бета', y: 'оценено листьев', x: 'глубина дерева d', full: 'минимакс, bᵈ', plain: 'альфа-бета, порядок случайный', best: 'альфа-бета, лучший порядок',
      desc: `Логарифмическая шкала числа оценённых листьев от 1 до 10⁵ в зависимости от глубины от 1 до 8 при b = 4. Минимакс растёт как 4ᵈ до 65 536. Альфа-бета с лучшим порядком растёт как 4 в степени d/2, до 511 листьев. Альфа-бета со случайным порядком лежит между ними, в среднем ${Math.round(last.plain)} листьев на глубине 8.` }
  : { title: 'How many leaves alpha–beta evaluates', y: 'leaves evaluated', x: 'tree depth d', full: 'minimax, bᵈ', plain: 'alpha–beta, random order', best: 'alpha–beta, best order',
      desc: `A log scale of the number of leaves evaluated, from 1 to 10⁵, against the depth from 1 to 8 with b = 4. Minimax grows as 4ᵈ, up to 65,536. Alpha–beta with the best ordering grows as 4 to the power d/2, up to 511 leaves. Alpha–beta in random order lies in between, ${Math.round(last.plain)} leaves on average at depth 8.` };
const id = 'alpha-beta-counts';
const caption = ru
  ? `Однородные деревья с b = 4 ходами в каждом узле, значения листьев случайны и равномерны; по ${TREES} деревьев на каждую глубину, одни и те же для всех трёх методов. Все три дают одно и то же значение корня. При идеальном порядке ходов альфа-бета оценивает ровно b^⌈d/2⌉ + b^⌊d/2⌋ − 1 листьев (Кнут и Мур), на глубине 8 это 511 против 65 536: за то же время можно искать вдвое глубже. При случайном порядке в среднем ${Math.round(last.plain)} листьев, эффективный коэффициент ветвления ${ebf(last.plain).toFixed(2)} вместо 4.`
  : `Uniform trees with b = 4 moves at every node and leaf values drawn uniformly at random; ${TREES} trees per depth, the same ones for all three methods. All three return the same root value. With perfect move ordering alpha–beta evaluates exactly b^⌈d/2⌉ + b^⌊d/2⌋ − 1 leaves (Knuth and Moore), 511 against 65,536 at depth 8: in the same time it can search twice as deep. In random order it evaluates ${Math.round(last.plain)} leaves on average, an effective branching factor of ${ebf(last.plain).toFixed(2)} instead of 4.`;
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 320, px: [76, 548] as [number, number], py: [40, 260] as [number, number], lx: 560, ly: [0, 0, 0], legend: false },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 420, px: [60, 344] as [number, number], py: [40, 260] as [number, number], lx: 60, ly: [340, 362, 384], legend: true },
];
const series = [
  { key: 'full' as const, label: t.full, tone: 'muted', dash: true },
  { key: 'plain' as const, label: t.plain, tone: 'blue', dash: false },
  { key: 'best' as const, label: t.best, tone: 'red', dash: false },
];
const num = (x: number) => Math.round(x).toLocaleString('en-US').replace(/,/g, ru ? '\u00a0' : ',');
const sup = (e: number) => ['⁰', '¹', '²', '³', '⁴', '⁵'][e];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sx = scale([1, D], L.px), sy = scale([0, 5], [L.py[1], L.py[0]]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {[0, 1, 2, 3, 4, 5].map((e) => <path class="f-grid" d={`M ${L.px[0]} ${sy(e)} H ${L.px[1]}`} />)}
        <path class="f-axis" d={`M ${L.px[0]} ${L.py[0] - 6} V ${L.py[1]} H ${L.px[1]}`} />
        {[0, 1, 2, 3, 4, 5].map((e) => <text class="f-small" x={L.px[0] - 7} y={sy(e) + 4} text-anchor="end">{e === 0 ? '1' : `10${sup(e)}`}</text>)}
        {rows.map((r) => <text class="f-small" x={sx(r.d)} y={L.py[1] + 18} text-anchor="middle">{String(r.d)}</text>)}
        <text class="f-small f-t-muted" x={(L.px[0] + L.px[1]) / 2} y={L.py[1] + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.px[0] - 44} y={L.py[0] - 20}>{t.y}</text>
        {series.map((S, i) => {
          const pts = rows.map((r) => [sx(r.d), sy(Math.log10(r[S.key]))] as [number, number]);
          const end = pts[pts.length - 1];
          return (
            <g>
              <path class={`f-line f-${S.tone}${S.dash ? ' f-dash' : ''}`} d={polyline(pts)} />
              {pts.map(([x, y]) => <circle cx={x} cy={y} r="3" class={S.tone === 'muted' ? 'f-solid-muted' : `f-solid-${S.tone}`} />)}
              {L.legend
                ? <g>
                    <path class={`f-line f-${S.tone}${S.dash ? ' f-dash' : ''}`} d={`M ${L.lx} ${L.ly[i] - 4} h 22`} />
                    <text class={`f-small f-t-${S.tone}`} x={L.lx + 30} y={L.ly[i]}>{S.label}</text>
                  </g>
                : <g>
                    <text class={`f-small f-t-${S.tone}`} x={L.lx} y={end[1] - 2}>{S.label}</text>
                    <text class={`f-small f-t-${S.tone}`} x={L.lx} y={end[1] + 14}>{num(rows[D - 1][S.key])}</text>
                  </g>}
            </g>
          );
        })}
      </svg>
    );
  })}
</Figure>
