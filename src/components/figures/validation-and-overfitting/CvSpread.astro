---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { mulberry32, normal } from '../random';
import { Phi } from '../normal';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// 2,000 datasets of n = 40 objects (20 per class) in d = 20 dimensions: class 0 ~ N(−e₁, I), class 1 ~ N(e₁, I), so only
// the first feature carries signal and the Bayes error is Φ(−1) = 0.159. The model is the nearest class centroid; its
// true risk is exact, ½Φ(wᵀ(μ₀ − c)/‖w‖) + ½Φ(−wᵀ(μ₁ − c)/‖w‖) with w the difference of the fitted centroids and c their
// midpoint. Each dataset gets four estimates of the risk of the model fitted on all 40 objects: the training error,
// a stratified 20% hold-out, stratified 5-fold cross-validation, and leave-one-out. The dots are the first 150 datasets.
const n = 40, d = 20, R = 2000, show = 150;
const u = mulberry32(77), z = normal(u);
const y = Array.from({ length: n }, (_, i) => (i < n / 2 ? 0 : 1));
const fit = (X: number[][], rows: number[]) => {
  const c = [new Array(d).fill(0), new Array(d).fill(0)], k = [0, 0];
  for (const r of rows) { k[y[r]]++; for (let j = 0; j < d; j++) c[y[r]][j] += X[r][j]; }
  for (const cl of [0, 1]) for (let j = 0; j < d; j++) c[cl][j] /= k[cl];
  return c;
};
const err = (c: number[][], X: number[][], rows: number[]) => {
  let e = 0;
  for (const r of rows) {
    let d0 = 0, d1 = 0;
    for (let j = 0; j < d; j++) { d0 += (X[r][j] - c[0][j]) ** 2; d1 += (X[r][j] - c[1][j]) ** 2; }
    if ((d1 < d0 ? 1 : 0) !== y[r]) e++;
  }
  return e / rows.length;
};
const trueRisk = (c: number[][]) => {
  const w = c[1].map((v, j) => v - c[0][j]), mid = c[1].map((v, j) => (v + c[0][j]) / 2);
  const nw = Math.sqrt(w.reduce((s, v) => s + v * v, 0));
  const a0 = w.reduce((s, v, j) => s + v * ((j === 0 ? -1 : 0) - mid[j]), 0) / nw;
  const a1 = w.reduce((s, v, j) => s + v * ((j === 0 ? 1 : 0) - mid[j]), 0) / nw;
  return 0.5 * Phi(a0) + 0.5 * Phi(-a1);
};
// Stratified folds: a random permutation within each class, then fold = position mod K.
const folds = (K: number) => {
  const f = new Array(n).fill(0);
  for (const cl of [0, 1]) {
    const idx = y.map((v, i) => [v, i]).filter((p) => p[0] === cl).map((p) => p[1]);
    for (let i = idx.length - 1; i > 0; i--) { const j = Math.floor(u() * (i + 1)); [idx[i], idx[j]] = [idx[j], idx[i]]; }
    idx.forEach((r, pos) => { f[r] = pos % K; });
  }
  return f;
};
const all = Array.from({ length: n }, (_, i) => i);
const cv = (X: number[][], K: number) => {
  const f = folds(K), e: number[] = [];
  for (let k = 0; k < K; k++) {
    const tr = all.filter((i) => f[i] !== k), te = all.filter((i) => f[i] === k);
    e.push(err(fit(X, tr), X, te));
  }
  const mean = e.reduce((a, b) => a + b, 0) / K;
  const sd = Math.sqrt(e.reduce((a, b) => a + (b - mean) ** 2, 0) / (K - 1));
  return { mean, se: sd / Math.sqrt(K) };
};
const keys = ['train', 'hold', 'k5', 'loo'] as const;
const diffs: Record<(typeof keys)[number], number[]> = { train: [], hold: [], k5: [], loo: [] };
const risks: number[] = [], se5: number[] = [];
for (let r = 0; r < R; r++) {
  const X = y.map((cl) => Array.from({ length: d }, (_, j) => z() + (j === 0 ? (cl ? 1 : -1) : 0)));
  const c = fit(X, all), risk = trueRisk(c);
  risks.push(risk);
  diffs.train.push(err(c, X, all) - risk);
  const f = folds(5);
  diffs.hold.push(err(fit(X, all.filter((i) => f[i] !== 0)), X, all.filter((i) => f[i] === 0)) - risk);
  const k5 = cv(X, 5); diffs.k5.push(k5.mean - risk); se5.push(k5.se);
  let loo = 0;
  for (const i of all) loo += err(fit(X, all.filter((j) => j !== i)), X, [i]) / n;
  diffs.loo.push(loo - risk);
}
const mean = (a: number[]) => a.reduce((s, v) => s + v, 0) / a.length;
const sd = (a: number[]) => { const m = mean(a); return Math.sqrt(a.reduce((s, v) => s + (v - m) ** 2, 0) / (a.length - 1)); };
const stats = keys.map((k) => ({ k, bias: mean(diffs[k]), sd: sd(diffs[k]) }));
const f2 = (v: number) => (Math.abs(v) < 0.005 ? '0.00' : v.toFixed(2).replace('-', '−'));
const quoted = stats.map((s) => `${s.bias.toFixed(3)}/${s.sd.toFixed(3)}`).join() + `,${mean(risks).toFixed(3)},${sd(risks).toFixed(3)},${mean(se5).toFixed(3)}`;
if (quoted !== '-0.100/0.048,0.012/0.148,0.011/0.074,0.006/0.071,0.209,0.017,0.059') throw new Error(`CvSpread: numbers drifted from the note (${quoted})`);
const names = ru
  ? { train: 'ошибка на обучении', hold: 'отложенная выборка 20%', k5: '5-кратная кросс-валидация', loo: 'leave-one-out' }
  : { train: 'training error', hold: '20% hold-out', k5: '5-fold cross-validation', loo: 'leave-one-out' };
const t = ru
  ? { x: 'оценка − истинный риск', bias: 'смещение', sd: 'ст. откл.' }
  : { x: 'estimate − true risk', bias: 'bias', sd: 'sd' };
const id = 'cv-spread';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 300, x0: 186, x1: 540, top: 24, row: 58, narrow: false },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 490, x0: 20, x1: 340, top: 40, row: 100, narrow: true },
];
// Deterministic jitter for the dots.
const jit = Array.from({ length: show }, (_, i) => ((i * 0.6180339887) % 1) - 0.5);
---

<Figure
  id={id}
  title={ru ? 'Насколько точны оценки риска' : 'How accurate risk estimates are'}
  caption={ru
    ? `2000 наборов по 40 объектов в 20 измерениях, где сигнал несёт только один признак; модель — ближайший центроид, её истинный риск вычислен точно (в среднем ${mean(risks).toFixed(3)}). Точки — разница между оценкой и истинным риском модели, обученной на всех 40 объектах, для первых ${show} наборов; черта — среднее ± одно стандартное отклонение по всем 2000. Ошибка на обучении занижена на ${f2(-stats[0].bias)}. Отложенная выборка из 8 объектов почти несмещена, но её разброс ${stats[1].sd.toFixed(2)}; 5-кратная кросс-валидация использует все объекты и сокращает разброс до ${stats[2].sd.toFixed(2)} ценой небольшого пессимизма (+${stats[2].bias.toFixed(3)}), leave-one-out — до ${stats[3].sd.toFixed(2)}.`
    : `2,000 datasets of 40 objects in 20 dimensions, only one of which carries signal; the model is the nearest class centroid and its true risk is computed exactly (on average ${mean(risks).toFixed(3)}). Dots: the estimate minus the true risk of the model fitted on all 40 objects, for the first ${show} datasets; bars: mean ± one standard deviation over all 2,000. The training error is too low by ${f2(-stats[0].bias)}. The hold-out set of 8 objects is nearly unbiased but spreads by ${stats[1].sd.toFixed(2)}; 5-fold cross-validation uses every object and cuts the spread to ${stats[2].sd.toFixed(2)} at the price of a slight pessimism (+${stats[2].bias.toFixed(3)}), and leave-one-out to ${stats[3].sd.toFixed(2)}.`}
>
  {layouts.map((L) => {
    const sx = scale([-0.4, 0.4], [L.x0, L.x1]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Разброс четырёх оценок риска' : 'The spread of four risk estimates'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Четыре полосы точек: ошибка на обучении сдвинута влево от нуля, отложенная выборка разбросана шире всех, кросс-валидация и leave-one-out сосредоточены около нуля.' : 'Four strips of dots: the training error is shifted left of zero, the hold-out estimate spreads widest, cross-validation and leave-one-out are centred near zero.'}</desc>
        {[-0.4, -0.2, 0, 0.2, 0.4].map((v) => <g><path class={v === 0 ? 'f-thin f-muted f-dash' : 'f-grid'} d={`M ${sx(v)} ${L.top - 6} V ${L.top + L.row * 4 - 10}`} /><text class="f-note" x={sx(v)} y={L.top + L.row * 4 + 8} text-anchor="middle">{v === 0 ? '0' : v.toFixed(1).replace('-', '−')}</text></g>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.top + L.row * 4 + 30} text-anchor="middle">{t.x}</text>
        {stats.map((s, i) => {
          const cy = L.top + i * L.row + (L.narrow ? 52 : 22);
          return (
            <g>
              <text class="f-small f-halo" x={L.narrow ? L.x0 : L.x0 - 12} y={L.narrow ? cy - 34 : cy + 4} text-anchor={L.narrow ? 'start' : 'end'}>{names[s.k]}</text>
              <text class="f-note f-halo" x={L.narrow ? L.x0 : L.x1 + 12} y={L.narrow ? cy - 16 : cy + 4}>{`${t.bias} ${f2(s.bias)}, ${t.sd} ${s.sd.toFixed(2)}`}</text>
              {diffs[s.k].slice(0, show).map((v, j) => <circle cx={sx(Math.max(-0.4, Math.min(0.4, v)))} cy={cy + jit[j] * 22} r="2.2" style={`fill: var(--fig-${i === 0 ? 'red' : 'blue'}); fill-opacity: .35`} />)}
              <path class="f-line" d={`M ${sx(s.bias - s.sd)} ${cy + 16} H ${sx(s.bias + s.sd)}`} />
              <circle cx={sx(s.bias)} cy={cy + 16} r="3.5" class="f-fill-ink" />
            </g>
          );
        })}
      </svg>
    );
  })}
</Figure>
