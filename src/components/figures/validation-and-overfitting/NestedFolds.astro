---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Who sees which rows. Left: K-fold cross-validation, K = 5; in round k block k validates and the other four train.
// Right: nested cross-validation for round 1 of the outer loop: the four outer training blocks are split again into
// four inner folds that choose the hyperparameter; the chosen model, refitted on all four blocks, is scored on block 1.
const K = 5, Kin = 4;
const rounds = Array.from({ length: K }, (_, r) => Array.from({ length: K }, (_, b) => (b === r ? 'val' : 'train')));
const inner = Array.from({ length: Kin }, (_, r) => Array.from({ length: Kin }, (_, b) => (b === r ? 'val' : 'train')));
if (rounds.some((row) => row.filter((c) => c === 'val').length !== 1)) throw new Error('NestedFolds: each round must validate on one block');
if (rounds.map((row) => row.indexOf('val')).join() !== '0,1,2,3,4') throw new Error('NestedFolds: every block must validate once');
const fill = { train: 'var(--fig-blue)', val: 'var(--fig-amber)', test: 'var(--fig-red)' } as const;
const t = ru
  ? { kf: 'K-кратная кросс-валидация', round: 'раунд', nested: 'вложенная: внешний раунд 1', outer: 'внешний', inner: 'внутренние фолды выбирают гиперпараметр', score: 'итоговая оценка на блоке 1', train: 'обучение', val: 'валидация', test: 'оценка' }
  : { kf: 'K-fold cross-validation', round: 'round', nested: 'nested: outer round 1', outer: 'outer', inner: 'inner folds choose the hyperparameter', score: 'final score on block 1', train: 'train', val: 'validate', test: 'score' };
const id = 'nested-folds';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 250, narrow: false, A: [16, 40], B: [420, 40], cw: 52, ch: 26, gap: 8 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 480, narrow: true, A: [8, 46], B: [8, 262], cw: 48, ch: 26, gap: 8 },
];
---

<Figure
  id={id}
  title={ru ? 'Кросс-валидация и вложенная кросс-валидация' : 'Cross-validation and nested cross-validation'}
  caption={ru
    ? `Слева: ${K}-кратная кросс-валидация; в каждом раунде один блок (жёлтый) оценивает модель, обученную на остальных (синие), и каждый объект ровно один раз попадает в валидацию. Справа: первый раунд вложенной кросс-валидации. Четыре обучающих блока внешнего раунда снова делятся на ${Kin} внутренних фолда, по которым выбирается гиперпараметр; выбранная модель обучается на всех четырёх блоках и получает оценку на блоке 1 (красный), который в выборе не участвовал.`
    : `Left: ${K}-fold cross-validation; in each round one block (amber) scores the model trained on the others (blue), and every object is validated exactly once. Right: the first round of nested cross-validation. The four training blocks of the outer round are split again into ${Kin} inner folds that choose the hyperparameter; the chosen model is refitted on all four blocks and scored on block 1 (red), which took no part in the choice.`}
>
  {layouts.map((L) => {
    const step = L.ch + L.gap;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Схемы разбиения на фолды' : 'Fold diagrams'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Сетка из пяти раундов по пять блоков с жёлтым блоком валидации на диагонали; рядом внешний раунд, разделённый на четыре внутренних фолда, и красный блок итоговой оценки.' : 'A grid of five rounds of five blocks with the amber validation block on the diagonal; beside it, an outer round split into four inner folds, and the red block of the final score.'}</desc>
        <text class="f-small" x={L.A[0]} y={L.A[1] - 18} style="font-weight: 650">{t.kf}</text>
        {rounds.map((row, r) => (
          <g>
            <text class="f-note" x={L.A[0] + 54 - 8} y={L.A[1] + r * step + L.ch / 2 + 5} text-anchor="end">{`${t.round} ${r + 1}`}</text>
            {row.map((c, b) => <rect x={L.A[0] + 54 + b * (L.cw + 4)} y={L.A[1] + r * step} width={L.cw} height={L.ch} rx="4" style={`fill: ${fill[c as 'train' | 'val']}; fill-opacity: ${c === 'val' ? 0.45 : 0.18}; stroke: ${fill[c as 'train' | 'val']}; stroke-width: 1`} />)}
          </g>
        ))}
        <text class="f-small" x={L.B[0]} y={L.B[1] - 18} style="font-weight: 650">{t.nested}</text>
        <rect x={L.B[0]} y={L.B[1]} width={L.cw} height={L.ch} rx="4" style={`fill: ${fill.test}; fill-opacity: 0.4; stroke: ${fill.test}; stroke-width: 1`} />
        {[1, 2, 3, 4].map((b) => <rect x={L.B[0] + b * (L.cw + 4)} y={L.B[1]} width={L.cw} height={L.ch} rx="4" style={`fill: ${fill.train}; fill-opacity: 0.18; stroke: ${fill.train}; stroke-width: 1`} />)}
        <text class="f-note" x={L.B[0] + L.cw / 2} y={L.B[1] + L.ch + 16} text-anchor="middle">1</text>
        <path class="f-thin f-muted" d={`M ${L.B[0] + L.cw + 4} ${L.B[1] + L.ch + 6} V ${L.B[1] + L.ch + 14} H ${L.B[0] + 5 * (L.cw + 4) - 4} V ${L.B[1] + L.ch + 6}`} />
        {inner.map((row, r) => row.map((c, b) => (
          <rect x={L.B[0] + (L.cw + 4) + b * (L.cw + 4)} y={L.B[1] + L.ch + 26 + r * (L.ch - 4 + 6)} width={L.cw} height={L.ch - 4} rx="4" style={`fill: ${fill[c as 'train' | 'val']}; fill-opacity: ${c === 'val' ? 0.45 : 0.18}; stroke: ${fill[c as 'train' | 'val']}; stroke-width: 1`} />
        )))}
        <text class="f-note" x={L.B[0]} y={L.B[1] + L.ch + 26 + Kin * (L.ch + 2) + 14}>{t.inner}</text>
        <text class="f-note f-t-red" x={L.B[0]} y={L.B[1] + L.ch + 26 + Kin * (L.ch + 2) + 32}>{t.score}</text>
      </svg>
    );
  })}
</Figure>
