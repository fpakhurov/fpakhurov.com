---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? "Три обязанности для одного отчёта" : "Three responsibilities in one report";
const caption = ru ? "Сохраняем доставки, разбираем повтор и знак возврата, затем публикуем итог после возврата." : "Keep the deliveries, resolve duplicate identity and refund sign, then publish the net amount.";
const desc = ru ? "Из четырёх доставок получаются три разных события со знаком. Итог витрины равен 950 копейкам." : "Four deliveries become three distinct signed events. The serving total is 950 cents.";
const layers = ru
  ? [['Приём', '4 доставки'], ['Интеграция', '700 + 600 − 350'], ['Витрина', '950 копеек']]
  : [['Landing', '4 deliveries'], ['Integration', '700 + 600 − 350'], ['Serving', '950 cents']];
---
<Figure id="bd-sales-layers" title={title} caption={caption}>
  <svg viewBox="0 0 340 244" role="img" aria-labelledby="bd-sales-layers-title bd-sales-layers-desc" style="max-width: 550px; margin-inline: auto">
    <title id="bd-sales-layers-title">{title}</title>
    <desc id="bd-sales-layers-desc">{desc}</desc>
    {layers.map(([label, amount], i) => (
      <g transform={`translate(0 ${i * 78})`}>
        <rect class={i === 2 ? 'f-fill-green' : 'f-fill-blue'} x="43" y="12" width="254" height="52" rx="6" />
        <text class="f-label" x="170" y="34" text-anchor="middle">{label}</text>
        <text class="f-label" x="170" y="54" text-anchor="middle">{amount}</text>
        {i < 2 && <path class="f-line" d="M 170 66 V 85 M 165 80 L 170 85 L 175 80" fill="none" />}
      </g>
    ))}
  </svg>
</Figure>
