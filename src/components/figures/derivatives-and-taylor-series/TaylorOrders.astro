---
import Figure from '../Figure.astro';
import { scale, plot } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// f(x) = log(1 + x) and its Taylor polynomials at a = 0: T_n(x) = x − x²/2 + x³/3 − … ± xⁿ/n.
// Inside |x| < 1 each order is closer; beyond x = 1 the terms xᵏ/k grow and the polynomials swing away.
const f = (x: number) => Math.log1p(x);
const T = (n: number) => (x: number) => {
  let s = 0;
  for (let k = 1; k <= n; k += 1) s += ((k % 2 === 1 ? 1 : -1) * x ** k) / k;
  return s;
};
const at18 = [1, 2, 3, 4].map((n) => T(n)(1.8).toFixed(4)).join();
if (at18 !== '1.8000,0.1800,2.1240,-0.5004' || f(1.8).toFixed(3) !== '1.030') throw new Error(`TaylorOrders: values at 1.8 drifted from the note (${at18})`);
const at01 = [1, 2, 3, 4].map((n) => (f(0.1) - T(n)(0.1)).toExponential(2)).join();
if (at01 !== '-4.69e-3,3.10e-4,-2.32e-5,1.85e-6') throw new Error(`TaylorOrders: errors at 0.1 drifted from the note (${at01})`);

const X0 = -0.85, X1 = 2, Y0 = -2.1, Y1 = 2.9;
const curves = [
  { n: 1, cls: 'f-line f-blue', t: 'f-t-blue', en: 'T₁, the tangent', ru: 'T₁, касательная', short: 'T₁' },
  { n: 2, cls: 'f-line f-green', t: 'f-t-green', en: 'T₂', ru: 'T₂', short: 'T₂' },
  { n: 3, cls: 'f-line f-amber', t: 'f-t-amber', en: 'T₃', ru: 'T₃', short: 'T₃' },
  { n: 4, cls: 'f-line f-red', t: 'f-t-red', en: 'T₄', ru: 'T₄', short: 'T₄' },
];
const id = 'taylor-orders';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 320, x0: 56, x1: 590, y0: 16, y1: 284, short: false },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 320, x0: 34, x1: 300, y0: 16, y1: 284, short: true },
];
const t = ru
  ? { f: 'log(1 + x)', edge: 'x = 1', beyond: 'ряд расходится', x: 'x' }
  : { f: 'log(1 + x)', edge: 'x = 1', beyond: 'the series diverges', x: 'x' };
const xticks = [-0.5, 0, 0.5, 1, 1.5, 2];
const yticks = [-2, -1, 0, 1, 2];
---

<Figure
  id={id}
  title={ru ? 'Касательная и многочлены Тейлора возрастающего порядка' : 'The tangent and Taylor polynomials of increasing order'}
  caption={ru
    ? 'Функция log(1 + x) (чёрная) и её многочлены Тейлора в точке 0: T₁ = x (касательная), T₂ = x − x²/2, T₃ и T₄. Около нуля каждый следующий порядок ближе к функции: при x = 0.1 ошибки равны −4.7·10⁻³, 3.1·10⁻⁴, −2.3·10⁻⁵ и 1.9·10⁻⁶. Правее x = 1 члены xᵏ/k растут, ряд расходится, и многочлены уходят от функции всё дальше: при x = 1.8 они дают 1.8, 0.18, 2.124 и −0.500 вместо log 2.8 = 1.030.'
    : 'The function log(1 + x) (black) and its Taylor polynomials at 0: T₁ = x (the tangent), T₂ = x − x²/2, T₃ and T₄. Near 0 each order is closer to the function: at x = 0.1 the errors are −4.7·10⁻³, 3.1·10⁻⁴, −2.3·10⁻⁵ and 1.9·10⁻⁶. Beyond x = 1 the terms xᵏ/k grow, the series diverges, and the polynomials swing ever further away: at x = 1.8 they give 1.8, 0.18, 2.124 and −0.500 instead of log 2.8 = 1.030.'}
>
  {layouts.map((L) => {
    const sx = scale([X0, X1], [L.x0, L.x1]), sy = scale([Y0, Y1], [L.y1, L.y0]);
    const clip = `${id}-clip-${L.W}`;
    const labelY = (v: number) => sy(v) + 4;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'log(1 + x) и многочлены Тейлора от первого до четвёртого порядка' : 'log(1 + x) and its Taylor polynomials of orders one to four'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Кривая логарифма и четыре многочлена, касающиеся её в нуле. Слева от линии x = 1 многочлены сходятся к кривой, справа расходятся веером.' : 'The logarithm curve and four polynomials touching it at zero. Left of the line x = 1 the polynomials close in on the curve; right of it they fan out.'}</desc>
        <defs><clipPath id={clip}><rect x={L.x0} y={L.y0} width={L.x1 - L.x0} height={L.y1 - L.y0} /></clipPath></defs>
        {yticks.map((v) => <path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} />)}
        <path class="f-axis" d={`M ${L.x0} ${sy(0)} H ${L.x1} M ${sx(0)} ${L.y0} V ${L.y1}`} />
        {xticks.map((v) => <text class="f-small f-t-muted" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{v === 0 ? '0' : String(v).replace('-', '−')}</text>)}
        {yticks.filter((v) => v !== 0).map((v) => <text class="f-small f-t-muted" x={L.x0 - 6} y={sy(v) + 4} text-anchor="end">{String(v).replace('-', '−')}</text>)}
        <path class="f-thin f-muted f-dash" d={`M ${sx(1)} ${L.y0} V ${L.y1}`} />
        <text class="f-small f-t-muted f-halo" x={sx(1) + 6} y={L.y0 + 14}>{t.edge}</text>
        {!L.short && <text class="f-small f-t-muted f-halo" x={sx(1) + 6} y={L.y0 + 30}>{t.beyond}</text>}
        <g clip-path={`url(#${clip})`}>
          {curves.map((c) => <path class={c.cls} d={plot(T(c.n), X0, X1, sx, sy, 240)} />)}
          <path class="f-line f-bold" d={plot(f, X0, X1, sx, sy, 240)} />
        </g>
        <circle cx={sx(0)} cy={sy(0)} r="3.5" class="f-fill-ink" />
        <text class="f-small f-halo" x={L.x1 + 6} y={labelY(f(X1))}>{L.short ? 'f' : t.f}</text>
        {curves.map((c) => <text class={`f-small ${c.t}`} x={L.x1 + 6} y={labelY(T(c.n)(X1))}>{L.short ? c.short : ru ? c.ru : c.en}</text>)}
      </svg>
    );
  })}
</Figure>
