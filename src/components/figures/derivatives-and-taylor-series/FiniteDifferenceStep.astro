---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Finite differences of f(x) = eˣ at x = 1 in double precision, where f = f'' = f''' = e.
// Error bounds: forward  E₊(h) = (e/2) h + 2u e / h, minimized at h = 2√u with value 2e√u;
//               central  E₀(h) = (e/6) h² + u e / h, minimized at h = (3u)^(1/3) with value (e/2)(3u)^(2/3).
const u = 2 ** -53, E = Math.E;
const bf = (h: number) => (E / 2) * h + (2 * u * E) / h;
const bc = (h: number) => (E / 6) * h * h + (u * E) / h;
const hf = 2 * Math.sqrt(u), hc = Math.cbrt(3 * u);
const quoted = [hf.toExponential(1), bf(hf).toExponential(1), hc.toExponential(1), bc(hc).toExponential(1)].join();
if (quoted !== '2.1e-8,5.7e-8,6.9e-6,6.5e-11') throw new Error(`FiniteDifferenceStep: optimal steps drifted from the note (${quoted})`);
// Measured errors on quarter decades h = 10^−1 … 10^−13. They depend on the last bits of exp, so only coarse checks.
const ks = Array.from({ length: 49 }, (_, i) => 1 + i / 4);
const pts = ks.map((k) => {
  const h = 10 ** -k;
  const fw = Math.abs((Math.exp(1 + h) - Math.exp(1)) / h - E);
  const ce = Math.abs((Math.exp(1 + h) - Math.exp(1 - h)) / (2 * h) - E);
  return { k, fw: Math.max(fw, 1e-12), ce: Math.max(ce, 1e-12) };
});
const minOf = (key: 'fw' | 'ce') => pts.reduce((a, b) => (b[key] < a[key] ? b : a));
const mf = minOf('fw'), mc = minOf('ce');
if (mf.k < 7 || mf.k > 9 || mf.fw > 1e-7 || mc.k < 4 || mc.k > 7.5 || mc.ce > 1e-9) throw new Error('FiniteDifferenceStep: measured minima are not where the note says');

const id = 'finite-difference-step';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 340, x0: 64, x1: 584, y0: 16, y1: 262, short: false },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 380, x0: 52, x1: 334, y0: 16, y1: 262, short: true },
];
const t = ru
  ? { x: 'шаг h', y: 'ошибка', fw: 'прямая разность', ce: 'центральная разность', bound: 'пунктир: оценки', trunc: 'усечение', round: 'округление' }
  : { x: 'step h', y: 'error', fw: 'forward difference', ce: 'central difference', bound: 'dashed: the bounds', trunc: 'truncation', round: 'rounding' };
const sup = (n: number) => String(n).split('').map((c) => '⁰¹²³⁴⁵⁶⁷⁸⁹'['0123456789'.indexOf(c)] ?? (c === '-' ? '⁻' : c)).join('');
const xt = [-13, -11, -9, -7, -5, -3, -1];
const yt = [-12, -10, -8, -6, -4, -2, 0];
---

<Figure
  id={id}
  title={ru ? 'Ошибка конечной разности в зависимости от шага' : 'The error of a finite difference against the step'}
  caption={ru
    ? 'Ошибка производной eˣ в точке 1 по прямой (синие) и центральной (красные) разностям в двойной точности; пунктир — оценки E₊(h) и E₀(h). Справа доминирует усечение (наклоны 1 и 2), слева — округление (наклон −1). Вертикальные линии: оптимальные шаги 2.1·10⁻⁸ и 6.9·10⁻⁶.'
    : 'Error of the derivative of eˣ at 1 by forward (blue) and central (red) differences in double precision, with the bounds E₊(h) and E₀(h) dashed. Truncation dominates on the right (slopes 1 and 2), rounding on the left (slope −1). Vertical lines: the optimal steps 2.1·10⁻⁸ and 6.9·10⁻⁶.'}
>
  {layouts.map((L) => {
    const sx = scale([-13, -1], [L.x0, L.x1]), sy = scale([-12, 0], [L.y1, L.y0]);
    const ly = (v: number) => sy(Math.log10(Math.min(Math.max(v, 1e-12), 1)));
    const line = (b: (h: number) => number) => polyline(Array.from({ length: 97 }, (_, i) => -13 + i / 8).map((e) => [sx(e), ly(b(10 ** e))] as [number, number]));
    const legY = L.short ? L.y1 + 58 : L.y1 + 58;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'V-образные кривые ошибки прямой и центральной разностей' : 'V-shaped error curves of the forward and central differences'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Логарифмические оси: шаг от 10⁻¹³ до 10⁻¹, ошибка от 10⁻¹² до 1. Обе кривые падают справа налево до минимума, потом растут; минимум центральной разности ниже и правее.' : 'Logarithmic axes: step from 10⁻¹³ to 10⁻¹, error from 10⁻¹² to 1. Both curves fall from right to left to a minimum, then rise; the central difference has a lower minimum at a larger step.'}</desc>
        {yt.map((e) => <path class="f-grid" d={`M ${L.x0} ${sy(e)} H ${L.x1}`} />)}
        <path class="f-axis" d={`M ${L.x0} ${L.y0} V ${L.y1} H ${L.x1}`} />
        {xt.map((e) => <text class="f-small f-t-muted" x={sx(e)} y={L.y1 + 18} text-anchor="middle">{`10${sup(e)}`}</text>)}
        {yt.map((e) => <text class="f-small f-t-muted" x={L.x0 - 6} y={sy(e) + 4} text-anchor="end">{e === 0 ? '1' : `10${sup(e)}`}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 36} text-anchor="middle">{t.x}</text>
        <path class="f-thin f-blue f-dot" d={`M ${sx(Math.log10(hf))} ${L.y0} V ${L.y1}`} />
        <path class="f-thin f-red f-dot" d={`M ${sx(Math.log10(hc))} ${L.y0} V ${L.y1}`} />
        <path class="f-line f-blue f-dash" d={line(bf)} />
        <path class="f-line f-red f-dash" d={line(bc)} />
        {pts.map((p) => <circle cx={sx(-p.k).toFixed(1)} cy={ly(p.fw).toFixed(1)} r="2.6" class="f-solid-blue" />)}
        {pts.map((p) => <circle cx={sx(-p.k).toFixed(1)} cy={ly(p.ce).toFixed(1)} r="2.6" class="f-solid-red" />)}
        {!L.short && <text class="f-small f-t-muted f-halo" x={sx(-2.2)} y={sy(-9.2)} text-anchor="middle">{t.trunc}</text>}
        {!L.short && <text class="f-small f-t-muted f-halo" x={sx(-11.6)} y={sy(-9.2)} text-anchor="middle">{t.round}</text>}
        <circle cx={L.x0 + 6} cy={legY - 4} r="3" class="f-solid-blue" />
        <text class="f-small f-t-blue" x={L.x0 + 14} y={legY}>{t.fw}</text>
        <circle cx={L.short ? L.x0 + 6 : L.x0 + 176} cy={L.short ? legY + 18 : legY - 4} r="3" class="f-solid-red" />
        <text class="f-small f-t-red" x={L.short ? L.x0 + 14 : L.x0 + 184} y={L.short ? legY + 22 : legY}>{t.ce}</text>
        <text class="f-small f-t-muted" x={L.short ? L.x0 + 14 : L.x0 + 360} y={L.short ? legY + 44 : legY}>{t.bound}</text>
      </svg>
    );
  })}
</Figure>
