---
import Figure from '../Figure.astro';
import { area, plot, scale, gaussian } from '../geometry';

// Notebook 1-D example: target mixture and the initial model Q = N(0, 1).
const P = (x: number) => 0.5 * gaussian(x, -3, 0.5) + 0.5 * gaussian(x, -8, 0.5);
const Q = (x: number) => gaussian(x, 0, 1);
const logQ = (x: number) => -0.5 * x * x - 0.5 * Math.log(2 * Math.PI);
const logRatio = (x: number) => Math.log(P(x)) - logQ(x);
const integrand = (x: number) => (P(x) > 1e-12 ? P(x) * logRatio(x) : 0);

// KL(P || Q) by numerical integration.
const X0 = -14;
const X1 = 4;
const N = 3600;
const dx = (X1 - X0) / N;
let kl = 0;
for (let i = 0; i <= N; i += 1) kl += integrand(X0 + i * dx) * dx;

// Where Q is numerically negligible next to P: Q(x) < 1e-6.
const qTiny = 1e-6;
const xTiny = -Math.sqrt(-2 * (Math.log(qTiny) + 0.5 * Math.log(2 * Math.PI)));

const xa = -11;
const xb = 3;
const yMax2 = 14;
const ticks = [-10, -8, -6, -4, -2, 0, 2];

const at8 = { ratio: logRatio(-8), q: Q(-8), integrand: integrand(-8) };
const expo = Math.floor(Math.log10(at8.q));
const mant = at8.q / 10 ** expo;
const sup = (n: number) => String(n).split('').map((c) => '⁰¹²³⁴⁵⁶⁷⁸⁹⁻'['0123456789-'.indexOf(c)]).join('');
const q8Label = `Q(−8) ≈ ${mant.toFixed(0)}·10${sup(expo)}`;

// Wide: labels beside the curves. Narrow: band labels stacked inside the band, the
// bottom-panel title on two lines and the bottom-panel notes moved left.
const layouts = {
  w: {
    vb: '0 0 600 470', cls: 'fig-wide fig-medium', narrow: false,
    left: 46, right: 580, top1: 40, bot1: 190, yMax1: 0.45, top2: 270, bot2: 430,
  },
  n: {
    vb: '0 0 360 520', cls: 'fig-narrow', narrow: true,
    left: 34, right: 340, top1: 40, bot1: 210, yMax1: 0.6, top2: 312, bot2: 476,
  },
};
---

<Figure
  id="entropy-and-divergences-support"
  title="When Q misses part of P's support"
  caption={`Top: the notebook's bimodal target P and the initial model Q = N(0, 1). Left of x ≈ ${xTiny.toFixed(1)} the model density is below 10⁻⁶, yet P still has a whole mode there. Bottom: each point's contribution P(x) log P(x)/Q(x) to KL(P‖Q); the far mode dominates the total of ${kl.toFixed(1)} nats. If Q were exactly zero where P > 0, the log ratio and the divergence would be infinite.`}
  origin="illustrative"
  pages="12"
>
  {Object.entries(layouts).map(([sfx, L]) => {
    const sx = scale([xa, xb], [L.left, L.right]);
    const sy1 = scale([0, L.yMax1], [L.bot1, L.top1]);
    const sy2 = scale([0, yMax2], [L.bot2, L.top2]);
    const bandMid = (sx(xa) + sx(xTiny)) / 2;
    const noteX = L.narrow ? sx(-6.5) : sx(-1.6);
    return (
      <svg class={L.cls} viewBox={L.vb} role="img" aria-labelledby={`entropy-and-divergences-support-${sfx}-t entropy-and-divergences-support-${sfx}-d`}>
        <title id={`entropy-and-divergences-support-${sfx}-t`}>Forward KL is huge where Q is nearly zero but P is not</title>
        <desc id={`entropy-and-divergences-support-${sfx}-d`}>{`Top panel: red target density with modes at -8 and -3, blue model density N(0, 1) centred at 0. A grey band left of x = ${xTiny.toFixed(1)} marks where Q is below one in a million while P still has mass. At x = -8, Q is about ${mant.toFixed(0)} times 10 to the ${expo}, and log P over Q is about ${at8.ratio.toFixed(0)} nats. Bottom panel: the integrand P(x) log P(x)/Q(x) has a tall peak of about ${at8.integrand.toFixed(1)} at the far mode and a small one at -3; its area, the KL divergence, is ${kl.toFixed(1)} nats.`}</desc>

        {/* top panel: densities */}
        <rect x={sx(xa)} y={L.top1 - 8} width={sx(xTiny) - sx(xa)} height={L.bot1 - L.top1 + 8} fill="var(--muted)" opacity="0.13" />
        <line class="f-thin f-muted f-dash" x1={sx(xTiny)} x2={sx(xTiny)} y1={L.top1 - 8} y2={L.bot1} />
        {L.narrow ? (
          <g>
            <text class="f-note f-halo" x={bandMid} y={L.top1 + 6} text-anchor="middle">Q(x) &lt; 10⁻⁶,</text>
            <text class="f-note f-halo" x={bandMid} y={L.top1 + 23} text-anchor="middle">but P(x) &gt; 0</text>
            <text class="f-note f-halo" x={bandMid} y={L.top1 + 40} text-anchor="middle">{q8Label}</text>
          </g>
        ) : (
          <text class="f-note" x={bandMid} y={L.top1 + 6} text-anchor="middle">Q(x) &lt; 10⁻⁶, but P(x) &gt; 0</text>
        )}
        <path class="f-fill-red" d={area(P, xa, xb, sx, sy1, 500)} />
        <path class="f-line f-red" d={plot(P, xa, xb, sx, sy1, 500)} />
        <path class="f-fill-blue" d={area(Q, xa, xb, sx, sy1, 300)} />
        <path class="f-line f-blue" d={plot(Q, xa, xb, sx, sy1, 300)} />
        <path class="f-axis" d={`M ${L.left} ${L.bot1} H ${L.right + 8}`} marker-end="url(#f-arrow-muted)" />
        {ticks.map((t) => (
          <g>
            <line class="f-axis" x1={sx(t)} x2={sx(t)} y1={L.bot1} y2={L.bot1 + 5} />
            <text class="f-note" x={sx(t)} y={L.bot1 + 20} text-anchor="middle">{t}</text>
          </g>
        ))}
        {L.narrow ? (
          <g>
            <text class="f-math f-t-red" x={sx(-3) + 18} y={sy1(0.36)}>P</text>
            <text class="f-math f-t-blue" x={sx(0)} y={sy1(0.47)} text-anchor="middle">Q = N(0, 1)</text>
          </g>
        ) : (
          <g>
            <text class="f-math f-t-red" x={sx(-3) + 26} y={sy1(0.36)}>P</text>
            <text class="f-math f-t-blue" x={sx(0) + 26} y={sy1(0.36)}>Q = N(0, 1)</text>
            <text class="f-label f-halo" x={sx(-7.0)} y={sy1(0.24)}>{q8Label}</text>
            <path class="f-thin" d={`M ${sx(-6.95)} ${sy1(0.215)} Q ${sx(-7.4)} ${sy1(0.12)} ${sx(-7.9)} ${L.bot1 - 6}`} marker-end="url(#f-arrow)" />
          </g>
        )}

        {/* bottom panel: integrand of KL(P||Q) */}
        {L.narrow ? (
          <g>
            <text class="f-title" x={L.left} y={L.top2 - 40}>Contribution to KL(P‖Q):</text>
            <text class="f-math" x={L.left} y={L.top2 - 16}>P(x) log P(x)/Q(x)</text>
          </g>
        ) : (
          <text class="f-title" x={L.left} y={L.top2 - 22}>Contribution to KL(P‖Q): <tspan font-weight="400" class="f-math" font-size="17">P(x) log P(x)/Q(x)</tspan></text>
        )}
        {[0, 4, 8, 12].map((t) => (
          <g>
            <line class="f-grid" x1={L.left} x2={L.right} y1={sy2(t)} y2={sy2(t)} />
            <text class="f-note" x={L.left - 8} y={sy2(t) + 5} text-anchor="end">{t}</text>
          </g>
        ))}
        <path class="f-fill-amber" d={area(integrand, xa, xb, sx, sy2, 600)} />
        <path class="f-line f-amber" d={plot(integrand, xa, xb, sx, sy2, 600)} />
        <path class="f-axis" d={`M ${L.left} ${L.bot2} H ${L.right + 8}`} marker-end="url(#f-arrow-muted)" />
        {ticks.map((t) => (
          <g>
            <line class="f-axis" x1={sx(t)} x2={sx(t)} y1={L.bot2} y2={L.bot2 + 5} />
            <text class="f-note" x={sx(t)} y={L.bot2 + 20} text-anchor="middle">{t}</text>
          </g>
        ))}
        <text class="f-label f-halo" x={sx(-6.6)} y={sy2(11.2)}>here log P/Q ≈ {at8.ratio.toFixed(0)} nats</text>
        <path class="f-thin" d={`M ${sx(-6.7)} ${sy2(11.6)} Q ${sx(-7.3)} ${sy2(12.6)} ${sx(-7.75)} ${sy2(at8.integrand) + 4}`} marker-end="url(#f-arrow)" />
        <text class="f-label f-halo" x={noteX} y={sy2(L.narrow ? 8 : 7)}>area = KL(P‖Q) ≈ {kl.toFixed(1)} nats</text>
        <text class="f-label f-t-red f-halo" x={noteX} y={sy2(L.narrow ? 5.6 : 4.6)}>if Q(x) = 0 where P(x) &gt; 0:</text>
        <text class="f-label f-t-red f-halo" x={noteX} y={sy2(L.narrow ? 5.6 : 4.6) + 20}>KL(P‖Q) = ∞</text>
      </svg>
    );
  })}
</Figure>
