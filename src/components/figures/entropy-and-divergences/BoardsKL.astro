---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The two tic-tac-toe boards from the start of the note: A = (1/2, 1/2), B = (9/10, 1/10) over {O, X}.
// Colours follow the boards figure: O blue, X red.
const A = [0.5, 0.5];
const Bd = [0.9, 0.1];
const H = (p: number[]) => -p.reduce((s, v) => s + v * Math.log2(v), 0);
const KL = (p: number[], q: number[]) => p.reduce((s, v, i) => s + v * Math.log2(v / q[i]), 0);
const hA = H(A);
const hB = H(Bd);
const klAB = KL(A, Bd);
const klBA = KL(Bd, A);

const HT = 300;
const base = 220;
const top = 70;
const sy = scale([0, 1], [base, top]);
const labels = ['O', 'X'];
const markCls = ['blue', 'red'];
const fmtP = ['1/2', '1/2', '9/10', '1/10'];
const id = 'entropy-and-divergences-boards-kl';

// Wide and narrow differ only in canvas width, bar width and margins.
const layouts = {
  w: { W: 520, bw: 42, gap: 16, margin: 40, cls: 'fig-wide fig-compact' },
  n: { W: 360, bw: 34, gap: 10, margin: 24, cls: 'fig-narrow' },
};
---

<Figure
  id={id}
  title={ru ? "Сравнение двух полей с помощью KL" : "The two boards compared with KL"}
  caption={ru ? `Два поля из начала заметки как распределения на {O, X}; нолики, как и раньше, синие, крестики красные. Энтропии равны ${hA.toFixed(0)} биту и ${hB.toFixed(3)} бита; KL-дивергенция между ними равна ${klAB.toFixed(3)} бита в одну сторону и ${klBA.toFixed(3)} бита в другую. Оба поля дают каждому исходу положительную вероятность, поэтому оба направления конечны. Каждая стрелка идёт от распределения, которое считается истинным (первый аргумент), к распределению, которое считается моделью.` : `The two boards from the start of the note as distributions over {O, X}, with noughts in blue and crosses in red as before. Entropies are ${hA.toFixed(0)} bit and ${hB.toFixed(3)} bits; the KL divergence between them is ${klAB.toFixed(3)} bits one way and ${klBA.toFixed(3)} bits the other. Both boards give every outcome positive probability, so both directions are finite. Each arrow runs from the distribution treated as the truth (the first argument) to the one treated as the model.`}
>
  {Object.entries(layouts).map(([sfx, L]) => {
    const boards = [
      { name: (ru ? "Поле A" : "Board A"), p: A, h: hA, x0: L.margin },
      { name: (ru ? "Поле B" : "Board B"), p: Bd, h: hB, x0: L.W - L.margin - 2 * L.bw - L.gap },
    ];
    const aRight = boards[0].x0 + 2 * L.bw + L.gap;
    const bLeft = boards[1].x0;
    const mid = L.W / 2;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${HT}`} role="img" aria-labelledby={`${id}-${sfx}-t ${id}-${sfx}-d`}>
        <title id={`${id}-${sfx}-t`}>{ru ? "KL между сбалансированным и перекошенным полями" : "KL between the balanced and the skewed board"}</title>
        <desc id={`${id}-${sfx}-d`}>{ru ? `Две столбчатые диаграммы, O синим и X красным. На поле A столбики высотой одна вторая для O и для X, энтропия 1 бит. На поле B столбики 9/10 для O и 1/10 для X, энтропия ${hB.toFixed(3)} бита. Изогнутая стрелка от A к B подписана KL(A‖B) = ${klAB.toFixed(3)} бита; изогнутая стрелка обратно от B к A подписана KL(B‖A) = ${klBA.toFixed(3)} бита.` : `Two bar charts with O in blue and X in red. Board A has bars of height one half for O and for X, entropy 1 bit. Board B has bars of 9/10 for O and 1/10 for X, entropy ${hB.toFixed(3)} bits. A curved arrow from A to B is labelled KL(A‖B) = ${klAB.toFixed(3)} bits; a curved arrow back from B to A is labelled KL(B‖A) = ${klBA.toFixed(3)} bits.`}</desc>

        {boards.map((b, k) => (
          <g>
            <text class="f-title" x={b.x0 + L.bw + L.gap / 2} y="24" text-anchor="middle">{b.name}</text>
            <path class="f-axis" d={`M ${b.x0 - 8} ${base} H ${b.x0 + 2 * L.bw + L.gap + 8}`} />
            {b.p.map((v, i) => (
              <g>
                <rect class={`f-fill-${markCls[i]}`} x={b.x0 + i * (L.bw + L.gap)} y={sy(v)} width={L.bw} height={base - sy(v)} stroke={`var(--fig-${markCls[i]})`} stroke-width="1.6" />
                <text class="f-label" x={b.x0 + i * (L.bw + L.gap) + L.bw / 2} y={sy(v) - 8} text-anchor="middle">{fmtP[2 * k + i]}</text>
                <text class={`f-label f-t-${markCls[i]}`} x={b.x0 + i * (L.bw + L.gap) + L.bw / 2} y={base + 20} text-anchor="middle">{labels[i]}</text>
              </g>
            ))}
            <text class="f-label" x={b.x0 + L.bw + L.gap / 2} y={base + 50} text-anchor="middle">H = {k === 0 ? (ru ? '1 бит' : '1 bit') : `${b.h.toFixed(3)} ${ru ? 'бита' : 'bits'}`}</text>
          </g>
        ))}

        <path class="f-line f-amber" d={`M ${aRight + 6} ${sy(0.75)} Q ${mid} ${sy(1.08)} ${bLeft - 10} ${sy(0.75)}`} marker-end="url(#f-arrow-amber)" />
        <text class="f-label f-t-amber" x={mid} y={sy(0.96) - 10} text-anchor="middle">KL(A‖B) = {klAB.toFixed(3)}</text>
        <path class="f-line f-green" d={`M ${bLeft - 6} ${sy(0.3)} Q ${mid} ${sy(0.12)} ${aRight + 10} ${sy(0.3)}`} marker-end="url(#f-arrow-green)" />
        <text class="f-label f-t-green" x={mid} y={sy(0.02)} text-anchor="middle">KL(B‖A) = {klBA.toFixed(3)}</text>
        {ru && sfx === 'n' ? (
          <text class="f-small" x={mid} y={sy(0.55) - 7} text-anchor="middle">в битах;<tspan x={mid} dy="15">несимметрична</tspan></text>
        ) : (
          <text class="f-small" x={mid} y={sy(0.55)} text-anchor="middle">{ru ? "в битах; несимметрична" : "bits; not symmetric"}</text>
        )}
      </svg>
    );
  })}
</Figure>
