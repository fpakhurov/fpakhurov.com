---
import Figure from '../Figure.astro';

// Cross-entropy = entropy + KL for the two coins of p. 9-10 (natural logarithms).
const rigged = [0.99, 0.01];
const fair = [0.5, 0.5];
const H = (p: number[]) => -p.reduce((s, v) => s + v * Math.log(v), 0);
const CE = (p: number[], q: number[]) => -p.reduce((s, v, i) => s + v * Math.log(q[i]), 0);

const rows = [
  {
    title: 'Believe fair, reality rigged',
    ceLabel: 'H(P, Q)',
    hLabel: 'H(P)',
    klLabel: 'KL(P‖Q)',
    h: H(rigged),
    ce: CE(rigged, fair),
  },
  {
    title: 'Believe rigged, reality fair',
    ceLabel: 'H(Q, P)',
    hLabel: 'H(Q)',
    klLabel: 'KL(Q‖P)',
    h: H(fair),
    ce: CE(fair, rigged),
  },
].map((r) => ({ ...r, kl: r.ce - r.h }));

const maxNats = 2.5;
const barH = 32;
const ticks = [0, 0.5, 1, 1.5, 2, 2.5];
const f3 = (v: number) => v.toFixed(3);

// Wide: labels inside the bars, title and total on one line.
// Narrow: total on its own line, part labels under each bar.
const layouts = {
  w: { vb: '0 0 600 300', cls: 'fig-wide fig-medium', left: 40, right: 570, rowY: [44, 154], axisY: 248, narrow: false },
  n: { vb: '0 0 360 364', cls: 'fig-narrow', left: 22, right: 338, rowY: [30, 160], axisY: 274, narrow: true },
};
---

<Figure
  id="entropy-and-divergences-ce-decomposition"
  title="Cross-entropy = entropy + KL divergence"
  caption="Each bar is the average surprise per flip under a wrong belief. The red part is the surprise that the real coin produces by itself (its entropy); the amber part is the extra surprise caused by the wrong model, the KL divergence. Swapping belief and reality changes both parts. Values in nats."
  origin="illustrative"
  pages="10–11"
>
  {Object.entries(layouts).map(([sfx, L]) => {
    const sx = (v: number) => L.left + (v / maxNats) * (L.right - L.left);
    const swatch = (x: number, y: number, cls: 'red' | 'amber') => (
      <g>
        <rect class={`f-fill-${cls}`} x={x} y={y} width="14" height="12" />
        <rect fill="none" stroke={`var(--fig-${cls})`} stroke-width="1.4" x={x} y={y} width="14" height="12" />
      </g>
    );
    return (
      <svg class={L.cls} viewBox={L.vb} role="img" aria-labelledby={`entropy-and-divergences-ce-decomposition-${sfx}-t entropy-and-divergences-ce-decomposition-${sfx}-d`}>
        <title id={`entropy-and-divergences-ce-decomposition-${sfx}-t`}>Cross-entropy split into entropy and KL divergence</title>
        <desc id={`entropy-and-divergences-ce-decomposition-${sfx}-d`}>Top bar: believe the coin is fair while it is rigged 0.99 to 0.01. Cross-entropy H(P, Q) = 0.693 nats, made of entropy H(P) = 0.056 nats and KL(P‖Q) = 0.637 nats. Bottom bar: believe the coin is rigged while it is fair. Cross-entropy H(Q, P) = 2.308 nats, made of entropy H(Q) = 0.693 nats and KL(Q‖P) = 1.614 nats.</desc>

        {L.narrow
          ? L.rowY.map((y) => ticks.map((t) => <line class="f-grid" x1={sx(t)} x2={sx(t)} y1={y + 32} y2={y + 38 + barH + 6} />))
          : ticks.map((t) => <line class="f-grid" x1={sx(t)} x2={sx(t)} y1={L.rowY[0] - 14} y2={L.axisY} />)}
        {L.narrow && ticks.map((t) => <line class="f-axis" x1={sx(t)} x2={sx(t)} y1={L.axisY} y2={L.axisY + 5} />)}
        {rows.map((r, k) => {
          const y = L.rowY[k];
          const barY = L.narrow ? y + 38 : y + 10;
          const hWide = sx(r.h) - L.left > 110;
          return (
            <g>
              <text class="f-title f-halo" x={L.left} y={y}>{r.title}:</text>
              <text class="f-math f-halo" x={L.narrow ? L.left : L.right} y={L.narrow ? y + 26 : y} text-anchor={L.narrow ? 'start' : 'end'}>{r.ceLabel} = {f3(r.ce)}</text>
              <rect class="f-fill-red" x={L.left} y={barY} width={sx(r.h) - L.left} height={barH} />
              <rect fill="none" stroke="var(--fig-red)" stroke-width="1.6" x={L.left} y={barY} width={sx(r.h) - L.left} height={barH} />
              <rect class="f-fill-amber" x={sx(r.h)} y={barY} width={sx(r.ce) - sx(r.h)} height={barH} />
              <rect fill="none" stroke="var(--fig-amber)" stroke-width="1.6" x={sx(r.h)} y={barY} width={sx(r.ce) - sx(r.h)} height={barH} />
              {L.narrow ? (
                <g>
                  {swatch(L.left, barY + barH + 12, 'red')}
                  <text class="f-label f-halo" x={L.left + 20} y={barY + barH + 23}>{r.hLabel} = {f3(r.h)}</text>
                  {swatch(L.left + 150, barY + barH + 12, 'amber')}
                  <text class="f-label f-halo" x={L.left + 170} y={barY + barH + 23}>{r.klLabel} = {f3(r.kl)}</text>
                </g>
              ) : (
                <g>
                  {hWide ? (
                    <text class="f-label" x={(L.left + sx(r.h)) / 2} y={y + 31} text-anchor="middle">{r.hLabel} = {f3(r.h)}</text>
                  ) : (
                    <g>
                      <path class="f-thin f-red" d={`M ${L.left + 4} ${y + 44} Q ${L.left + 6} ${y + 58} ${L.left + 18} ${y + 62}`} />
                      <text class="f-label f-t-red" x={L.left + 22} y={y + 67}>{r.hLabel} = {f3(r.h)}</text>
                    </g>
                  )}
                  <text class="f-label" x={(sx(r.h) + sx(r.ce)) / 2} y={y + 31} text-anchor="middle">{r.klLabel} = {f3(r.kl)}</text>
                </g>
              )}
            </g>
          );
        })}
        <line class="f-axis" x1={L.left} x2={L.right} y1={L.axisY} y2={L.axisY} />
        {ticks.map((t) => <text class="f-note" x={sx(t)} y={L.axisY + 20} text-anchor="middle">{t}</text>)}
        {L.narrow ? (
          <g>
            <text class="f-note" x={L.right} y={L.axisY + 42} text-anchor="end">nats per flip</text>
            {swatch(L.left, L.axisY + 53, 'red')}
            <text class="f-note" x={L.left + 20} y={L.axisY + 64}>entropy</text>
            {swatch(L.left + 92, L.axisY + 53, 'amber')}
            <text class="f-note" x={L.left + 112} y={L.axisY + 64}>KL: extra surprise from</text>
            <text class="f-note" x={L.left + 112} y={L.axisY + 80}>the wrong model</text>
          </g>
        ) : (
          <g>
            <text class="f-note" x={L.right} y={L.axisY + 42} text-anchor="end">nats per flip</text>
            {swatch(L.left, L.axisY + 31, 'red')}
            <text class="f-note" x={L.left + 20} y={L.axisY + 42}>entropy</text>
            {swatch(L.left + 92, L.axisY + 31, 'amber')}
            <text class="f-note" x={L.left + 112} y={L.axisY + 42}>KL: extra surprise from the wrong model</text>
          </g>
        )}
      </svg>
    );
  })}
</Figure>
