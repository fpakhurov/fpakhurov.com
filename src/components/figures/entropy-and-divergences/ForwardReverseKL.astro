---
import Figure from '../Figure.astro';
import { area, plot, scale, gaussian } from '../geometry';

// Target from the notebook's 1-D example: P = 1/2 N(-3, 0.5^2) + 1/2 N(-8, 0.5^2).
const P = (x: number) => 0.5 * gaussian(x, -3, 0.5) + 0.5 * gaussian(x, -8, 0.5);

// Numerical integration grid.
const X0 = -16;
const X1 = 6;
const N = 1100;
const dx = (X1 - X0) / N;
const xs = Array.from({ length: N + 1 }, (_, i) => X0 + i * dx);
const ps = xs.map(P);
const logps = ps.map((p) => Math.log(Math.max(p, 1e-300)));

// log of a Gaussian density, exact (no underflow).
const logG = (x: number, m: number, s: number) => -0.5 * ((x - m) / s) ** 2 - Math.log(s * Math.sqrt(2 * Math.PI));

const forwardKL = (m: number, s: number) => {
  let acc = 0;
  for (let i = 0; i <= N; i += 1) if (ps[i] > 1e-300) acc += ps[i] * (logps[i] - logG(xs[i], m, s));
  return acc * dx;
};
const reverseKL = (m: number, s: number) => {
  let acc = 0;
  for (let i = 0; i <= N; i += 1) {
    const lq = logG(xs[i], m, s);
    const q = Math.exp(lq);
    if (q > 1e-300) acc += q * (lq - logps[i]);
  }
  return acc * dx;
};

// Coarse grid search over (mu, sigma), then a local refinement.
// `mMin` restricts the search to one side when the loss has two mirror-image optima.
function argmin(f: (m: number, s: number) => number, mMin = -11) {
  let best = { v: Infinity, m: 0, s: 1 };
  for (let m = mMin; m <= 1.001; m += 0.25) {
    for (let s = 0.2; s <= 4.001; s += 0.1) {
      const v = f(m, s);
      if (v < best.v) best = { v, m, s };
    }
  }
  let step = { m: 0.125, s: 0.05 };
  for (let round = 0; round < 6; round += 1) {
    const c = { ...best };
    for (let i = -4; i <= 4; i += 1) {
      for (let j = -4; j <= 4; j += 1) {
        const m = c.m + i * step.m;
        const s = c.s + j * step.s;
        if (s <= 0.05) continue;
        const v = f(m, s);
        if (v < best.v) best = { v, m, s };
      }
    }
    step = { m: step.m / 4, s: step.s / 4 };
  }
  return best;
}
const fwd = argmin(forwardKL);
const rev = argmin(reverseKL, -5.5); // the mode at -3; the mode at -8 is its mirror image
// Reverse KL has two equally good optima (one per mode); show the other one dashed.
const revOther = { m: -11 - rev.m, s: rev.s };

const xLo = -11;
const xHi = -1;
const yMax = 0.85;
const ticks = [-10, -8, -6, -4, -2];
const f2 = (v: number) => v.toFixed(2).replace('-', '−');

// Wide: annotation column to the right of each plot. Narrow: annotations below each plot.
const layouts = {
  w: { vb: '0 0 600 490', cls: 'fig-wide fig-medium', narrow: false, left: 46, right: 440, tops: [40, 282], h: 160 },
  n: { vb: '0 0 360 596', cls: 'fig-narrow', narrow: true, left: 24, right: 330, tops: [52, 336], h: 138 },
};
const titles = { forward: 'min over Q of KL(P‖Q)', reverse: 'min over Q of KL(Q‖P)' };
---

<Figure
  id="entropy-and-divergences-forward-reverse"
  title="Fitting one Gaussian to two modes: forward vs reverse KL"
  caption={`The target is the notebook's 1-D mixture P = ½N(−3, 0.5²) + ½N(−8, 0.5²). The best single Gaussian under KL(P‖Q) (found by grid search) has μ = ${f2(fwd.m)}, σ = ${f2(fwd.s)}: it matches the mean and variance of P. Its densest part, and about a third of its mass, lie in the gap where P is almost zero. Under KL(Q‖P) the best Gaussian sits on one mode (μ = ${f2(rev.m)}, σ = ${f2(rev.s)}); the other mode is an equally good solution.`}
  origin="illustrative"
  pages="12"
>
  {Object.entries(layouts).map(([sfx, L]) => {
    const sx = scale([xLo, xHi], [L.left, L.right]);
    const panels = [
      { top: L.tops[0], bottom: L.tops[0] + L.h, fit: fwd, name: 'forward' as const },
      { top: L.tops[1], bottom: L.tops[1] + L.h, fit: rev, name: 'reverse' as const },
    ];
    const syF = scale([0, yMax], [panels[0].bottom, panels[0].top]);
    const syR = scale([0, yMax], [panels[1].bottom, panels[1].top]);
    const ax = L.right + 18; // wide annotation column
    const fT = panels[0].top;
    const rT = panels[1].top;
    const below = (pn: { bottom: number }, i: number) => pn.bottom + 46 + i * 21; // narrow annotation rows
    return (
      <svg class={L.cls} viewBox={L.vb} role="img" aria-labelledby={`entropy-and-divergences-forward-reverse-${sfx}-t entropy-and-divergences-forward-reverse-${sfx}-d`}>
        <title id={`entropy-and-divergences-forward-reverse-${sfx}-t`}>Forward and reverse KL fits of a Gaussian to a bimodal target</title>
        <desc id={`entropy-and-divergences-forward-reverse-${sfx}-d`}>{`Two panels with the same red bimodal target, peaks at x = -8 and x = -3. Top panel: the Gaussian minimizing KL(P‖Q), mean ${f2(fwd.m)} and standard deviation ${f2(fwd.s)}, is a wide blue curve spanning both modes, with its peak in the empty gap between them; KL(P‖Q) = ${f2(fwd.v)} nats. Bottom panel: the Gaussian minimizing KL(Q‖P), mean ${f2(rev.m)} and standard deviation ${f2(rev.s)}, is a narrow blue curve on the right mode only, so the solid fit ignores the mode at -8; KL(Q‖P) = ${f2(rev.v)} nats, about ln 2. A dashed curve on the left mode marks the mirror solution, which is equally good.`}</desc>

        {panels.map((pn) => {
          const sy = scale([0, yMax], [pn.bottom, pn.top]);
          const Qf = (x: number) => gaussian(x, pn.fit.m, pn.fit.s);
          return (
            <g>
              <text class="f-title" x={L.left - (L.narrow ? 4 : 0)} y={pn.top - 16}>{pn.name === 'forward' ? 'Forward' : 'Reverse'} KL: <tspan class="f-t-blue" fill="var(--fig-blue)">{titles[pn.name]}</tspan></text>
              <path class="f-fill-red" d={area(P, xLo, xHi, sx, sy, 480)} />
              <path class="f-line f-red" d={plot(P, xLo, xHi, sx, sy, 480)} />
              {pn.name === 'reverse' && <path class="f-line f-blue f-dash" d={plot((x) => gaussian(x, revOther.m, revOther.s), xLo, xHi, sx, sy, 480)} />}
              <path class="f-line f-blue f-bold" d={plot(Qf, xLo, xHi, sx, sy, 480)} />
              <path class="f-axis" d={`M ${L.left} ${pn.bottom} H ${L.right + 8}`} marker-end="url(#f-arrow-muted)" />
              {ticks.map((t) => (
                <g>
                  <line class="f-axis" x1={sx(t)} x2={sx(t)} y1={pn.bottom} y2={pn.bottom + 5} />
                  <text class="f-note" x={sx(t)} y={pn.bottom + 20} text-anchor="middle">{t}</text>
                </g>
              ))}
              {pn.name === 'forward' && <text class="f-math f-t-red" x={sx(-8) - 30} y={sy(0.42)} text-anchor="end">P</text>}
            </g>
          );
        })}

        {/* Forward panel: in-plot annotations */}
        <text class="f-label" x={sx(-5.5)} y={fT + 38} text-anchor="middle">covers both modes, wide</text>
        <path class="f-thin" d={`M ${sx(-5.5)} ${fT + 46} Q ${sx(-5.1)} ${fT + 72} ${sx(-5.5) + 4} ${syF(gaussian(-5.5, fwd.m, fwd.s)) - 8}`} marker-end="url(#f-arrow)" />
        <text class="f-note f-t-muted" x={sx(-5.5)} y={panels[0].bottom - 7} text-anchor="middle">P ≈ 0 here</text>

        {L.narrow ? (
          <g>
            <text class="f-label f-t-blue" x={L.left - 4} y={below(panels[0], 0)}>best Gaussian: μ = {f2(fwd.m)}, σ = {f2(fwd.s)}</text>
            <text class="f-label" x={L.left - 4} y={below(panels[0], 1)}>KL(P‖Q) = {f2(fwd.v)} nats</text>

            <text class="f-label" x={sx(-5.6)} y={rT + 24} text-anchor="middle">locks onto</text>
            <text class="f-label" x={sx(-5.6)} y={rT + 42} text-anchor="middle">one mode</text>
            <path class="f-thin" d={`M ${sx(-5.6) + 40} ${rT + 20} Q ${sx(-3.9)} ${rT + 14} ${sx(-3.32) - 5} ${syR(gaussian(-3.32, rev.m, rev.s)) - 3}`} marker-end="url(#f-arrow)" />
            <text class="f-label f-t-blue" x={L.left - 4} y={below(panels[1], 0)}>best Gaussian: μ = {f2(rev.m)}, σ = {f2(rev.s)}</text>
            <text class="f-label" x={L.left - 4} y={below(panels[1], 1)}>KL(Q‖P) = {f2(rev.v)} nats ≈ ln 2</text>
            <text class="f-label f-t-red" x={L.left - 4} y={below(panels[1], 2)}>the solid fit ignores the mode at −8;</text>
            <text class="f-label" x={L.left - 4} y={below(panels[1], 3)}>dashed: the mirror fit, equally good</text>
          </g>
        ) : (
          <g>
            <text class="f-label f-t-blue" x={ax} y={fT + 38}>best Gaussian:</text>
            <text class="f-math f-t-blue" x={ax} y={fT + 64}>μ = {f2(fwd.m)}</text>
            <text class="f-math f-t-blue" x={ax} y={fT + 88}>σ = {f2(fwd.s)}</text>
            <text class="f-label" x={ax} y={fT + 116}>KL(P‖Q) = {f2(fwd.v)}</text>

            <text class="f-label" x={ax} y={rT + 24}>locks onto</text>
            <text class="f-label" x={ax} y={rT + 42}>one mode</text>
            <path class="f-thin" d={`M ${ax - 4} ${rT + 20} Q ${sx(-2.3)} ${rT + 22} ${sx(-2.62) + 4} ${syR(gaussian(-2.62, rev.m, rev.s)) - 4}`} marker-end="url(#f-arrow)" />
            <text class="f-math f-t-blue" x={ax} y={rT + 70}>μ = {f2(rev.m)}</text>
            <text class="f-math f-t-blue" x={ax} y={rT + 94}>σ = {f2(rev.s)}</text>
            <text class="f-label" x={ax} y={rT + 122}>KL(Q‖P) = {f2(rev.v)}</text>
            <text class="f-label" x={ax} y={rT + 142}>≈ ln 2</text>
            <text class="f-label f-t-red" x={sx(-9.25)} y={rT + 64} text-anchor="end">ignored by the</text>
            <text class="f-label f-t-red" x={sx(-9.25)} y={rT + 83} text-anchor="end">solid fit;</text>
            <text class="f-label" x={sx(-9.25)} y={rT + 110} text-anchor="end">dashed: mirror</text>
            <text class="f-label" x={sx(-9.25)} y={rT + 129} text-anchor="end">fit, as good</text>
          </g>
        )}
      </svg>
    );
  })}
</Figure>
