---
import Figure from '../Figure.astro';
import { area, plot, scale, gaussian, curve } from '../geometry';

// Shapes follow the sketch on p. 10: the real P is high on the left and decays with wiggles;
// the believed Q rises, peaks, dips and has a second bump.
const P = (x: number) => 0.6 * gaussian(x, -0.4, 1.0) + 0.25 * gaussian(x, 2.8, 0.7) + 0.15 * gaussian(x, 5.4, 1.0);
const Q = (x: number) => 0.6 * gaussian(x, 3.4, 0.75) + 0.4 * gaussian(x, 6.2, 0.8);
const x0 = 0.8; // a point that is common under P but rare under Q
const pX0 = P(x0);
const qX0 = Q(x0);
const surpriseX0 = -Math.log(qX0);
const yMax = 0.36;

type Panel = { left: number; right: number; top: number; bottom: number };
const panelGeom = (pn: Panel) => ({
  ...pn,
  sx: scale([-0.4, 9], [pn.left, pn.right]),
  sy: scale([0, yMax], [pn.bottom, pn.top]),
});

const layouts = {
  w: {
    vb: '0 0 620 400',
    cls: 'fig-wide fig-medium',
    pPanel: panelGeom({ left: 40, right: 280, top: 44, bottom: 168 }),
    qPanel: panelGeom({ left: 350, right: 590, top: 44, bottom: 168 }),
    formulaY: 262,
    formulaX: 168,
    labelsY: [336, 336],
    labelX: [150, 452],
  },
  n: {
    vb: '0 0 360 560',
    cls: 'fig-narrow',
    pPanel: panelGeom({ left: 40, right: 320, top: 40, bottom: 150 }),
    qPanel: panelGeom({ left: 40, right: 320, top: 214, bottom: 324 }),
    formulaY: 394,
    formulaX: 28,
    labelsY: [468, 520],
    labelX: [118, 180],
  },
};
// Horizontal offsets of the formula pieces relative to formulaX (serif italic 18px).
const piece = { lhs: 0, sum: 90, p: 118, log: 162, frac: 196 };
---

<Figure
  id="entropy-and-divergences-cross-entropy-reading"
  title="Reading the cross-entropy formula"
  caption="Outcomes are drawn from the real P, but surprise is measured with the believed Q. At the marked point x₀ the outcome is common under P (tall red bar) yet nearly impossible under Q (tiny blue bar), so each time it occurs it costs a large surprise log 1/Q(x₀). The shapes are illustrative."
  origin="expanded"
  pages="10"
>
  {Object.entries(layouts).map(([sfx, L]) => {
    const pp = L.pPanel;
    const qp = L.qPanel;
    const fx = L.formulaX;
    const fy = L.formulaY;
    const pTerm = { x: fx + piece.p + 18, y: fy + 8 };
    const logTerm = { x: fx + piece.frac + 36, y: fy + 10 };
    return (
      <svg class={L.cls} viewBox={L.vb} role="img" aria-labelledby={`entropy-and-divergences-cross-entropy-reading-${sfx}-t entropy-and-divergences-cross-entropy-reading-${sfx}-d`}>
        <title id={`entropy-and-divergences-cross-entropy-reading-${sfx}-t`}>Real distribution P, believed distribution Q and the cross-entropy formula</title>
        <desc id={`entropy-and-divergences-cross-entropy-reading-${sfx}-d`}>Left or top: the real density P, high on the left and decaying with bumps. Right or below: the believed density Q, which rises, peaks in the middle, dips and has a second bump. A point x0 on the left is marked: P(x0) is large, Q(x0) is almost zero. Below, the formula H(P, Q) equals the sum over x of P(x) times log of 1 over Q(x). An arrow labels P(x) as how often x is observed; another labels log 1 over Q(x) as how surprised you would be to see it.</desc>

        {[{ g: pp, f: P, cls: 'red', name: 'P (real)', val: pX0, lab: 'P(x₀)' }, { g: qp, f: Q, cls: 'blue', name: 'Q (believed)', val: qX0, lab: 'Q(x₀) ≈ 0' }].map((d) => (
          <g>
            <path class={`f-fill-${d.cls}`} d={area(d.f, -0.4, 9, d.g.sx, d.g.sy, 200)} />
            <path class={`f-line f-${d.cls}`} d={plot(d.f, -0.4, 9, d.g.sx, d.g.sy, 200)} />
            <path class="f-axis" d={`M ${d.g.left} ${d.g.bottom} H ${d.g.right + 10}`} marker-end="url(#f-arrow-muted)" />
            <path class="f-axis" d={`M ${d.g.left} ${d.g.bottom} V ${d.g.top - 16}`} marker-end="url(#f-arrow-muted)" />
            <text class={`f-math f-t-${d.cls}`} x={d.g.left + 10} y={d.g.top - 14}>{d.name}</text>
            <text class="f-math" x={d.g.right + 8} y={d.g.bottom + 22} text-anchor="end">x</text>
            <line class={`f-${d.cls}`} stroke-width="5" x1={d.g.sx(x0)} x2={d.g.sx(x0)} y1={d.g.bottom} y2={Math.min(d.g.sy(d.val), d.g.bottom - 2.5)} />
            <text class="f-small" x={d.g.sx(x0)} y={d.g.bottom + 18} text-anchor="middle">x₀</text>
            {d.cls === 'red' ? (
              <g>
                <text class="f-label f-t-red" x={d.g.sx(2.6)} y={d.g.sy(0.27)}>{d.lab}</text>
                <path class="f-thin f-red" d={`M ${d.g.sx(2.5)} ${d.g.sy(0.28)} Q ${d.g.sx(x0) + 4} ${d.g.sy(0.3)} ${d.g.sx(x0) + 2} ${d.g.sy(d.val) - 8}`} marker-end="url(#f-arrow-red)" />
              </g>
            ) : (
              <g>
                <text class="f-label f-t-blue" x={d.g.sx(x0) + 6} y={d.g.top + 24} text-anchor="middle">{d.lab}</text>
                <path class="f-thin f-blue" d={`M ${d.g.sx(x0) + 6} ${d.g.top + 31} Q ${d.g.sx(x0) + 10} ${(d.g.top + d.g.bottom) / 2 + 20} ${d.g.sx(x0) + 1} ${d.g.bottom - 9}`} marker-end="url(#f-arrow-blue)" />
              </g>
            )}
          </g>
        ))}

        <!-- formula -->
        <text class="f-math" x={fx + piece.lhs} y={fy}>H(P, Q) =</text>
        <text class="f-math f-upright" x={fx + piece.sum} y={fy + 4} font-size="26">∑</text>
        <text class="f-small" x={fx + piece.sum + 9} y={fy + 22} text-anchor="middle">x</text>
        <text class="f-math f-t-red" x={fx + piece.p} y={fy}>P(x)</text>
        <text class="f-math f-upright" x={fx + piece.log} y={fy}>log</text>
        <text class="f-math" x={fx + piece.frac + 22} y={fy - 12} text-anchor="middle">1</text>
        <line class="f-thin" x1={fx + piece.frac} x2={fx + piece.frac + 44} y1={fy - 6} y2={fy - 6} />
        <text class="f-math f-t-blue" x={fx + piece.frac + 22} y={fy + 14} text-anchor="middle">Q(x)</text>

        <!-- labels and curved arrows, as in the handwriting -->
        <text class="f-label f-t-red" x={L.labelX[0]} y={L.labelsY[0]} text-anchor="middle">how often x is observed</text>
        <path class="f-line f-red" d={sfx === 'w' ? curve(L.labelX[0] + 86, L.labelsY[0] - 14, pTerm.x + 2, pTerm.y + 6, 14) : curve(L.labelX[0] - 30, L.labelsY[0] - 18, pTerm.x - 6, pTerm.y + 8, 22)} marker-end="url(#f-arrow-red)" />
        <text class="f-label f-t-blue" x={L.labelX[1]} y={L.labelsY[1]} text-anchor="middle">how surprised you would be to see it</text>
        <path class="f-line f-blue" d={sfx === 'w' ? curve(L.labelX[1] - 70, L.labelsY[1] - 18, logTerm.x - 6, logTerm.y + 14, 24) : curve(L.labelX[1] + 70, L.labelsY[1] - 18, logTerm.x + 4, logTerm.y + 16, -20)} marker-end="url(#f-arrow-blue)" />

        {sfx === 'w' && (
          <text class="f-note" x="310" y="378" text-anchor="middle">at x₀: P(x₀) = {pX0.toFixed(2)}, Q(x₀) = {qX0.toFixed(4)}, so log 1/Q(x₀) ≈ {surpriseX0.toFixed(1)} nats</text>
        )}
        {sfx === 'n' && (
          <text class="f-note" x="180" y="552" text-anchor="middle">at x₀: log 1/Q(x₀) ≈ {surpriseX0.toFixed(1)} nats</text>
        )}
      </svg>
    );
  })}
</Figure>
