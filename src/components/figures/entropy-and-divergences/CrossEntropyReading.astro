---
import Figure from '../Figure.astro';
import { scale, gaussian, curve } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Two distributions over the 18 outcomes x = 0, 0.5, ..., 8.5. The real P is high on the
// left and decays with bumps; the believed Q rises, peaks, dips and has a second bump.
// Both are smooth profiles evaluated on the grid and normalized to probabilities.
const xs = Array.from({ length: 18 }, (_, k) => 0.5 * k);
const profP = (x: number) => 0.6 * gaussian(x, -0.4, 1.0) + 0.25 * gaussian(x, 2.8, 0.7) + 0.15 * gaussian(x, 5.4, 1.0);
const profQ = (x: number) => 0.6 * gaussian(x, 3.4, 0.75) + 0.4 * gaussian(x, 6.2, 0.8);
const normalize = (f: (x: number) => number) => {
  const z = xs.reduce((s, x) => s + f(x), 0);
  return xs.map((x) => f(x) / z);
};
const P = normalize(profP);
const Q = normalize(profQ);
const k0 = 1; // x0 = 0.5: common under P, rare under Q
const x0 = xs[k0];
const pX0 = P[k0];
const qX0 = Q[k0];
const surpriseX0 = -Math.log(qX0);
const yMax = 0.2;
const sci = (v: number) => {
  const e = Math.floor(Math.log10(v));
  const sup = String(e).split('').map((c) => '⁰¹²³⁴⁵⁶⁷⁸⁹⁻'['0123456789-'.indexOf(c)]).join('');
  return `${(v / 10 ** e).toFixed(1)}·10${sup}`;
};

type Panel = { left: number; right: number; top: number; bottom: number };
const panelGeom = (pn: Panel) => ({
  ...pn,
  sx: scale([-0.4, 9], [pn.left, pn.right]),
  sy: scale([0, yMax], [pn.bottom, pn.top]),
});

const layouts = {
  w: {
    vb: '0 0 620 400',
    cls: 'fig-wide fig-medium',
    pPanel: panelGeom({ left: 40, right: 280, top: 44, bottom: 168 }),
    qPanel: panelGeom({ left: 350, right: 590, top: 44, bottom: 168 }),
    formulaY: 262,
    formulaX: 168,
    labelsY: [336, 336],
    labelX: [150, 452],
  },
  n: {
    vb: '0 0 360 560',
    cls: 'fig-narrow',
    pPanel: panelGeom({ left: 40, right: 320, top: 40, bottom: 150 }),
    qPanel: panelGeom({ left: 40, right: 320, top: 214, bottom: 324 }),
    formulaY: 394,
    formulaX: 28,
    labelsY: [468, 520],
    labelX: [118, 180],
  },
};
// Horizontal offsets of the formula pieces relative to formulaX (serif italic 18px).
const piece = { lhs: 0, sum: 90, p: 118, log: 162, frac: 196 };
---

<Figure
  id="entropy-and-divergences-cross-entropy-reading"
  title={ru ? "Как читать формулу кросс-энтропии" : "Reading the cross-entropy formula"}
  caption={ru ? `Обе панели — распределения на одних и тех же дискретных исходах x. Исходы порождает реальное P, а неожиданность измеряется по предполагаемому Q. Отмеченный исход x₀ часто встречается при P (высокий красный столбик, P(x₀) = ${pX0.toFixed(2)}), но почти невозможен при Q (Q(x₀) ≈ ${sci(qX0)}, столбик слишком мал, чтобы его увидеть), поэтому каждое его появление обходится в большую неожиданность, ln 1/Q(x₀) ≈ ${surpriseX0.toFixed(1)} ната. Формы распределений условны.` : `Both panels are distributions over the same discrete outcomes x. Outcomes are drawn from the real P, but surprise is measured with the believed Q. The marked outcome x₀ is common under P (tall red bar, P(x₀) = ${pX0.toFixed(2)}) yet nearly impossible under Q (Q(x₀) ≈ ${sci(qX0)}, a bar too small to see), so each time it occurs it costs a large surprise, ln 1/Q(x₀) ≈ ${surpriseX0.toFixed(1)} nats. The shapes are illustrative.`}
>
  {Object.entries(layouts).map(([sfx, L]) => {
    const pp = L.pPanel;
    const qp = L.qPanel;
    const fx = L.formulaX;
    const fy = L.formulaY;
    const pTerm = { x: fx + piece.p + 18, y: fy + 8 };
    const logTerm = { x: fx + piece.frac + 36, y: fy + 10 };
    const bw = sfx === 'w' ? 9 : 10;
    return (
      <svg class={L.cls} viewBox={L.vb} role="img" aria-labelledby={`entropy-and-divergences-cross-entropy-reading-${sfx}-t entropy-and-divergences-cross-entropy-reading-${sfx}-d`}>
        <title id={`entropy-and-divergences-cross-entropy-reading-${sfx}-t`}>{ru ? "Реальное распределение P, предполагаемое распределение Q и формула кросс-энтропии" : "Real distribution P, believed distribution Q and the cross-entropy formula"}</title>
        <desc id={`entropy-and-divergences-cross-entropy-reading-${sfx}-d`}>{ru ? `Две столбчатые диаграммы на одних и тех же 18 дискретных исходах. Слева или сверху: реальное распределение P, высокое слева и убывающее с горбами. Справа или снизу: предполагаемое распределение Q, которое растёт, достигает пика в середине, проседает и даёт второй горб. Второй исход, x0, отмечен: P(x0) = ${pX0.toFixed(2)} велико, Q(x0) около ${sci(qX0)}, почти ноль. Ниже формула: H(P, Q) равно сумме по x произведений P(x) на логарифм 1 / Q(x). Одна стрелка поясняет, что P(x) — это то, как часто встречается x; другая — что логарифм 1 / Q(x) показывает, насколько нас удивляет его появление.` : `Two bar charts over the same 18 discrete outcomes. Left or top: the real distribution P, high on the left and decaying with bumps. Right or below: the believed distribution Q, which rises, peaks in the middle, dips and has a second bump. The second outcome, x0, is marked: P(x0) = ${pX0.toFixed(2)} is large, Q(x0) is about ${sci(qX0)}, almost zero. Below, the formula H(P, Q) equals the sum over x of P(x) times log of 1 over Q(x). An arrow labels P(x) as how often x is observed; another labels log 1 over Q(x) as how surprised we are to see it.`}</desc>

        {[{ g: pp, m: P, cls: 'red', name: ru ? 'P (реальное)' : 'P (real)', val: pX0, lab: 'P(x₀)' }, { g: qp, m: Q, cls: 'blue', name: ru ? 'Q (предполагаемое)' : 'Q (believed)', val: qX0, lab: 'Q(x₀) ≈ 0' }].map((d) => (
          <g>
            {xs.map((x, k) => (
              k === k0 ? null : (
                <rect class={`f-fill-${d.cls}`} stroke={`var(--fig-${d.cls})`} stroke-width="1.1" x={d.g.sx(x) - bw / 2} y={d.g.sy(d.m[k])} width={bw} height={Math.max(d.g.bottom - d.g.sy(d.m[k]), 0.5)} />
              )
            ))}
            <rect class={`f-solid-${d.cls}`} x={d.g.sx(x0) - bw / 2} y={Math.min(d.g.sy(d.val), d.g.bottom - 2)} width={bw} height={Math.max(d.g.bottom - d.g.sy(d.val), 2)} />
            <path class="f-axis" d={`M ${d.g.left} ${d.g.bottom} H ${d.g.right + 10}`} marker-end="url(#f-arrow-muted)" />
            <path class="f-axis" d={`M ${d.g.left} ${d.g.bottom} V ${d.g.top - 16}`} marker-end="url(#f-arrow-muted)" />
            <text class={`f-math f-t-${d.cls}`} x={d.g.left + 10} y={d.g.top - 14}>{d.name}</text>
            <text class="f-math" x={d.g.right + 8} y={d.g.bottom + 22} text-anchor="end">x</text>
            <text class="f-small" x={d.g.sx(x0)} y={d.g.bottom + 18} text-anchor="middle">x₀</text>
            {d.cls === 'red' ? (
              <g>
                <text class="f-label f-t-red" x={d.g.sx(1.9)} y={d.g.sy(0.172)}>{d.lab}</text>
                <path class="f-thin f-red" d={`M ${d.g.sx(1.8)} ${d.g.sy(0.178)} Q ${d.g.sx(x0) + 6} ${d.g.sy(0.185)} ${d.g.sx(x0) + 3} ${d.g.sy(d.val) - 7}`} marker-end="url(#f-arrow-red)" />
              </g>
            ) : (
              <g>
                <text class="f-label f-t-blue" x={d.g.sx(x0) + 10} y={d.g.top + 24} text-anchor="middle">{d.lab}</text>
                <path class="f-thin f-blue" d={`M ${d.g.sx(x0) + 6} ${d.g.top + 31} Q ${d.g.sx(x0) + 12} ${(d.g.top + d.g.bottom) / 2 + 20} ${d.g.sx(x0) + 1} ${d.g.bottom - 8}`} marker-end="url(#f-arrow-blue)" />
              </g>
            )}
          </g>
        ))}

        {/* formula */}
        <text class="f-math" x={fx + piece.lhs} y={fy}>H(P, Q) =</text>
        <text class="f-math f-upright" x={fx + piece.sum} y={fy + 4} font-size="26">∑</text>
        <text class="f-small" x={fx + piece.sum + 9} y={fy + 22} text-anchor="middle">x</text>
        <text class="f-math f-t-red" x={fx + piece.p} y={fy}>P(x)</text>
        <text class="f-math f-upright" x={fx + piece.log} y={fy}>log</text>
        <text class="f-math" x={fx + piece.frac + 22} y={fy - 12} text-anchor="middle">1</text>
        <line class="f-thin" x1={fx + piece.frac} x2={fx + piece.frac + 44} y1={fy - 6} y2={fy - 6} />
        <text class="f-math f-t-blue" x={fx + piece.frac + 22} y={fy + 14} text-anchor="middle">Q(x)</text>

        {/* labels with curved arrows to the formula terms */}
        <text class="f-label f-t-red" x={L.labelX[0]} y={L.labelsY[0]} text-anchor="middle">{ru ? "как часто встречается x" : "how often x is observed"}</text>
        <path class="f-line f-red" d={sfx === 'w' ? curve(L.labelX[0] + 86, L.labelsY[0] - 14, pTerm.x + 2, pTerm.y + 6, 14) : curve(L.labelX[0] - 30, L.labelsY[0] - 18, pTerm.x - 6, pTerm.y + 8, 22)} marker-end="url(#f-arrow-red)" />
        <text class="f-label f-t-blue" x={L.labelX[1]} y={L.labelsY[1]} text-anchor="middle">{ru ? "насколько нас это удивляет" : "how surprised we are to see it"}</text>
        <path class="f-line f-blue" d={sfx === 'w' ? curve(L.labelX[1] - 70, L.labelsY[1] - 18, logTerm.x - 6, logTerm.y + 14, 24) : curve(L.labelX[1] + 70, L.labelsY[1] - 18, logTerm.x + 4, logTerm.y + 16, -20)} marker-end="url(#f-arrow-blue)" />

        {sfx === 'w' && (
          <text class="f-note" x="310" y="378" text-anchor="middle">{ru ? `в точке x₀: P(x₀) = ${pX0.toFixed(2)}, Q(x₀) ≈ ${sci(qX0)}, поэтому ln 1/Q(x₀) ≈ ${surpriseX0.toFixed(1)} ната` : `at x₀: P(x₀) = ${pX0.toFixed(2)}, Q(x₀) ≈ ${sci(qX0)}, so ln 1/Q(x₀) ≈ ${surpriseX0.toFixed(1)} nats`}</text>
        )}
        {sfx === 'n' && (
          <text class="f-note" x="180" y="552" text-anchor="middle">{ru ? `в точке x₀: ln 1/Q(x₀) ≈ ${surpriseX0.toFixed(1)} ната` : `at x₀: ln 1/Q(x₀) ≈ ${surpriseX0.toFixed(1)} nats`}</text>
        )}
      </svg>
    );
  })}
</Figure>
