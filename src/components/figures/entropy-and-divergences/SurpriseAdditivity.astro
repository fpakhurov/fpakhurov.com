---
import Figure from '../Figure.astro';

// Sequence H, H, T of independent flips with P(H) = 0.9, P(T) = 0.1 (p. 6-7).
const flips = [
  { side: 'H', p: 0.9 },
  { side: 'H', p: 0.9 },
  { side: 'T', p: 0.1 },
].map((f) => ({ ...f, s: -Math.log2(f.p) }));
const product = flips.reduce((acc, f) => acc * f.p, 1);
const total = flips.reduce((acc, f) => acc + f.s, 0);
const f3 = (v: number) => v.toFixed(3);

// Columns.
const colX = [120, 300, 480];
const boxW = 112;
const boxTop = 62;
const boxH = 74;

// Stacked bar of surprises (bits) at the bottom.
const barLeft = 60;
const barRight = 560;
const barTop = 236;
const barH = 26;
const bx = (bits: number) => barLeft + (bits / total) * (barRight - barLeft);
let acc = 0;
const segments = flips.map((f) => {
  const x0 = bx(acc);
  acc += f.s;
  return { ...f, x0, x1: bx(acc) };
});
---

<Figure
  id="entropy-and-divergences-additivity"
  title="Probabilities multiply, surprises add"
  caption="For independent flips the probability of the sequence H, H, T is a product. Its logarithm splits into a sum, so the total surprise is the sum of the per-flip surprises: almost all of it comes from the single rare tails."
  origin="expanded"
  pages="6–7"
>
  <svg class="fig-medium" viewBox="0 0 600 320" role="img" aria-labelledby="entropy-and-divergences-additivity-t entropy-and-divergences-additivity-d">
    <title id="entropy-and-divergences-additivity-t">Surprise of the sequence heads, heads, tails</title>
    <desc id="entropy-and-divergences-additivity-d">Three boxes: heads with probability 0.9, heads with probability 0.9, tails with probability 0.1. The probability of the sequence is 0.9 times 0.9 times 0.1, which is 0.081. The surprises are 0.152, 0.152 and 3.322 bits, which add up to 3.626 bits, equal to log base 2 of 1 over 0.081. A stacked bar shows that the tails flip contributes almost all of the total.</desc>

    <text class="f-label" x="300" y="30" text-anchor="middle">P(H, H, T) = 0.9 × 0.9 × 0.1 = <tspan font-weight="650">{product.toFixed(3)}</tspan></text>

    {flips.map((f, i) => (
      <g>
        <rect class={f.side === 'T' ? 'f-box-soft' : 'f-box'} x={colX[i] - boxW / 2} y={boxTop} width={boxW} height={boxH} rx="8" />
        {f.side === 'T' && <rect class="f-fill-amber" x={colX[i] - boxW / 2} y={boxTop} width={boxW} height={boxH} rx="8" />}
        <text class="f-math f-upright" x={colX[i]} y={boxTop + 32} text-anchor="middle" font-size="24" font-weight="650">{f.side}</text>
        <text class="f-label" x={colX[i]} y={boxTop + 58} text-anchor="middle">p = {f.p}</text>
        <text class="f-math" x={colX[i]} y={boxTop + boxH + 32} text-anchor="middle">log₂(1/{f.p})</text>
        <text class="f-label" x={colX[i]} y={boxTop + boxH + 56} text-anchor="middle" font-weight="650">{f3(f.s)}</text>
      </g>
    ))}
    {[0, 1].map((i) => (
      <text class="f-title" x={(colX[i] + colX[i + 1]) / 2} y={boxTop + boxH + 44} text-anchor="middle" font-size="20">+</text>
    ))}

    <!-- leaders from each surprise value to its segment of the bar -->
    {segments.map((s, i) => (
      <path class="f-thin f-muted f-dash" d={`M ${colX[i]} ${boxTop + boxH + 64} L ${(s.x0 + s.x1) / 2} ${barTop - 4}`} />
    ))}
    {segments.map((s) => (
      <rect class={s.side === 'T' ? 'f-fill-amber' : 'f-fill-blue'} x={s.x0} y={barTop} width={s.x1 - s.x0} height={barH} />
    ))}
    {segments.map((s) => (
      <rect fill="none" stroke="var(--ink)" stroke-width="1.1" x={s.x0} y={barTop} width={s.x1 - s.x0} height={barH} />
    ))}
    <text class="f-label" x={(segments[2].x0 + segments[2].x1) / 2} y={barTop + 18} text-anchor="middle">tails: {f3(segments[2].s)} bits</text>

    <text class="f-label" x="300" y={barTop + barH + 30} text-anchor="middle">total = {f3(total)} bits = log₂(1/{product.toFixed(3)})</text>
  </svg>
</Figure>
