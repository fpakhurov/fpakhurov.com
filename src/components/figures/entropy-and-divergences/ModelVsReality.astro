---
import Figure from '../Figure.astro';

// Believed (model) Q = fair coin, real P = rigged coin; we observe ten heads.
const n = 10;
const rows = [
  { name: 'Model Q (believed)', sym: 'Q', probs: [0.5, 0.5], cls: 'blue' },
  { name: 'Reality P', sym: 'P', probs: [0.99, 0.01], cls: 'red' },
].map((r) => {
  const pSeq = r.probs[0] ** n;
  return { ...r, pSeq, nats: -Math.log(pSeq) };
});

const barW = 34;
const fmtP = (p: number) => p.toFixed(3);

// Wide: bars on the left, formulas to their right, annotation in the right half.
// Narrow: formulas stacked under the bars, annotation beside the reality bars.
const layouts = {
  w: {
    vb: '0 0 600 410',
    cls: 'fig-wide fig-medium',
    barMax: 96,
    chartLeft: 52,
    rowTop: [78, 266],
    formulaX: 210,
    formulaDy: [34, 70],
    numX: null as number | null,
    note: { x: 404, y: [214, 233] as number[], lines: ['surprise caused by believing', 'in the wrong model'] },
    arrow: 'M 470 202 Q 500 176 478 158',
  },
  n: {
    vb: '0 0 360 540',
    cls: 'fig-narrow',
    barMax: 80,
    chartLeft: 50,
    rowTop: [80, 350],
    formulaX: 20,
    formulaDy: [138, 168],
    numX: 212 as number | null,
    note: { x: 268, y: [384, 403, 422] as number[], lines: ['surprise caused', 'by believing in', 'the wrong model'] },
    arrow: 'M 276 368 Q 306 316 252 262',
  },
};
---

<Figure
  id="entropy-and-divergences-model-vs-reality"
  title="Ten heads: surprising under the model, ordinary in reality"
  caption="We believe the coin is fair, but it is rigged. Ten heads in a row have probability about 0.001 under the belief (6.93 nats of surprise) and about 0.90 in reality (0.10 nats). The difference is surprise produced by the wrong model, not by the data. Natural logarithms."
>
  {Object.entries(layouts).map(([sfx, L]) => (
    <svg class={L.cls} viewBox={L.vb} role="img" aria-labelledby={`entropy-and-divergences-model-vs-reality-${sfx}-t entropy-and-divergences-model-vs-reality-${sfx}-d`}>
      <title id={`entropy-and-divergences-model-vs-reality-${sfx}-t`}>Believed fair coin versus real rigged coin</title>
      <desc id={`entropy-and-divergences-model-vs-reality-${sfx}-d`}>Top: the model Q puts probability 0.5 on heads and 0.5 on tails; the probability of ten heads under Q is 0.5 to the power 10, about 0.001, and the surprise is minus the natural log of that, about 6.93 nats. Bottom: reality P puts 0.99 on heads and 0.01 on tails; the probability of ten heads under P is 0.99 to the power 10, about 0.904, and the surprise is about 0.10 nats. A red note says the surprise is caused by believing in the wrong model.</desc>

      {/* the observation: ten heads */}
      <text class="f-note" x="20" y="24">observed:</text>
      {Array.from({ length: n }, (_, i) => (
        <g>
          <circle class="f-box" cx={100 + i * 26} cy="19" r="10" />
          <text class="f-small" x={100 + i * 26} y="23.5" text-anchor="middle">H</text>
        </g>
      ))}

      {rows.map((r, k) => {
        const top = L.rowTop[k];
        const base = top + L.barMax + 10;
        const fy = [top + L.formulaDy[0], top + L.formulaDy[1]];
        return (
          <g>
            <text class={`f-title f-t-${r.cls}`} x={L.chartLeft - 30} y={top - 22}>{r.name}</text>
            <line class="f-axis" x1={L.chartLeft - 12} x2={L.chartLeft + 2 * barW + 50} y1={base} y2={base} />
            {r.probs.map((p, i) => {
              const x = L.chartLeft + i * (barW + 34);
              const h = Math.max(p * L.barMax, 1.5);
              return (
                <g>
                  <rect class={`f-solid-${r.cls}`} x={x} y={base - h} width={barW} height={h} opacity="0.85" />
                  <text class="f-small" x={x + barW / 2} y={base - h - 6} text-anchor="middle">{p}</text>
                  <text class="f-label" x={x + barW / 2} y={base + 20} text-anchor="middle">{i === 0 ? 'H' : 'T'}</text>
                </g>
              );
            })}
            <text class="f-math" x={L.formulaX} y={fy[0]}>{r.sym}(10 heads) = {r.probs[0]}¹⁰ ≈ {fmtP(r.pSeq)}</text>
            {L.numX === null ? (
              <text class="f-math" x={L.formulaX} y={fy[1]}>surprise = −ln {r.probs[0]}¹⁰ ≈ <tspan font-weight="700" class={`f-t-${r.cls}`} fill={`var(--fig-${r.cls})`}>{r.nats.toFixed(2)}</tspan> nats</text>
            ) : (
              <g>
                <text class="f-math" x={L.formulaX} y={fy[1]}>surprise = −ln {r.probs[0]}¹⁰ ≈</text>
                <text class="f-math" x={L.numX} y={fy[1]}><tspan font-weight="700" class={`f-t-${r.cls}`} fill={`var(--fig-${r.cls})`}>{r.nats.toFixed(2)}</tspan> nats</text>
              </g>
            )}
          </g>
        );
      })}

      {/* annotation */}
      {L.note.lines.map((line, i) => (
        <text class="f-label f-t-red" x={L.note.x} y={L.note.y[i]} text-anchor="middle">{line}</text>
      ))}
      <path class="f-line f-red" d={L.arrow} marker-end="url(#f-arrow-red)" />
    </svg>
  ))}
</Figure>
