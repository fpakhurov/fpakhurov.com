---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The three kernel tables behind file descriptors, in the state the note's example ends in: the parent opened
// log.txt (fd 3), duplicated it (fd 4), opened it again (fd 5) and forked; the child wrote "child " through fd 3.
// fd 3 and fd 4 of both processes share description A, fd 5 of both shares B. Offsets are computed, not typed.
const written = 'child '.length;
const refsA = 2 * 2, refsB = 2 * 1;          // two processes, two descriptors on A and one on B in each
const offA = written, offB = 0;
if (offA !== 6 || refsA !== 4 || refsB !== 2) throw new Error(`FileTables: offsets/refs ${offA} ${refsA} ${refsB}`);

const t = ru
  ? {
      heads: ['в каждом процессе', 'таблица открытых файлов', 'таблица inode'],
      parent: 'родитель', child: 'потомок (после fork)',
      rows: ['0–2 терминал', 'fd 3', 'fd 4', 'fd 5'],
      A: 'описание A', B: 'описание B', mode: 'O_RDWR',
      offA: `смещение 0 → ${offA}, ссылок ${refsA}`, offB: `смещение ${offB}, ссылок ${refsB}`,
      offAShort: `смещение 0 → ${offA}`, offBShort: `смещение ${offB}`,
      inode: 'inode log.txt', inodeSub: 'размер, права, блоки',
      steps: ['open(path) возвращает fd 3: новое описание открытого файла A, которое указывает на inode', 'dup(3) возвращает fd 4: вторая ячейка, указывающая на то же описание A', 'второй open(path) возвращает fd 5: новое описание B со своим смещением, тот же inode', 'fork: потомок получает копию таблицы; его fd 3, 4 и 5 указывают на те же A и B', `потомок пишет ${written} байт через fd 3: смещение в A становится ${offA} для всех дескрипторов, разделяющих A; B остаётся на 0`],
    }
  : {
      heads: ['per process', 'open file table', 'inode table'],
      parent: 'parent', child: 'child (after fork)',
      rows: ['0–2 terminal', 'fd 3', 'fd 4', 'fd 5'],
      A: 'description A', B: 'description B', mode: 'O_RDWR',
      offA: `offset 0 → ${offA}, ${refsA} refs`, offB: `offset ${offB}, ${refsB} refs`,
      offAShort: `offset 0 → ${offA}`, offBShort: `offset ${offB}`,
      inode: 'inode of log.txt', inodeSub: 'size, mode, blocks',
      steps: ['open(path) returns fd 3: a new open file description A, which points to the inode', 'dup(3) returns fd 4: a second slot pointing to the same description A', 'a second open(path) returns fd 5: a new description B with its own offset, same inode', 'fork: the child gets a copy of the table; its fds 3, 4 and 5 point to the same A and B', `the child writes ${written} bytes through fd 3: the offset in A becomes ${offA} for every descriptor that shares A; B stays at 0`],
    };

interface Layout {
  cls: string; W: number; H: number;
  heads: [number, number][];
  tx: number; tw: number; rh: number; py: number; cy: number; plabel: [number, number]; clabel: [number, number];
  A: [number, number]; B: [number, number]; bw: number; bh: number;
  I: [number, number]; iw: number; ih: number;
  offA: [number, number, 'start' | 'middle' | 'end']; offB: [number, number, 'start' | 'middle' | 'end']; short: boolean; aDown: number;
  badges: [number, number][];
}
const wide: Layout = {
  cls: 'fig-wide', W: 760, H: 372,
  heads: [[34, 24], [330, 24], [600, 24]],
  tx: 34, tw: 170, rh: 28, py: 62, cy: 252, plabel: [34, 52], clabel: [34, 242],
  A: [330, 78], B: [330, 268], bw: 190, bh: 56,
  I: [600, 168], iw: 150, ih: 64,
  offA: [425, 152, 'middle'], offB: [425, 342, 'middle'], short: false, aDown: 0,
  badges: [[20, 104], [20, 132], [20, 160], [20, 294], [346, 148]],
};
const narrow: Layout = {
  cls: 'fig-narrow seq-narrow', W: 360, H: 412,
  heads: [[14, 22], [206, 22], [206, 22]],
  tx: 26, tw: 128, rh: 28, py: 60, cy: 250, plabel: [26, 50], clabel: [26, 240],
  A: [206, 64], B: [206, 300], bw: 146, bh: 56,
  I: [206, 196], iw: 146, ih: 60,
  offA: [262, 144, 'middle'], offB: [279, 380, 'middle'], short: true, aDown: 128,
  badges: [[13, 102], [13, 130], [13, 158], [13, 292], [204, 140]],
};
const rowY = (L: Layout, base: number, i: number) => base + i * L.rh;
const mid = (L: Layout, base: number, i: number) => rowY(L, base, i) + L.rh / 2;
// Arrow from the right end of a descriptor row to the left side of a description box.
const toBox = (L: Layout, base: number, i: number, box: [number, number], dy: number) =>
  [[L.tx + L.tw - 4, mid(L, base, i)], [box[0] - 3, box[1] + L.bh / 2 + dy]] as [number, number][];
const id = 'file-tables';
const layouts = [wide, narrow];
---

<Figure
  id={id}
  title={ru ? 'Три таблицы ядра за файловым дескриптором' : 'The three kernel tables behind a file descriptor'}
  caption={ru
    ? `Состояние после примера из текста. Дескриптор — номер ячейки в таблице процесса (слева). Ячейка указывает на описание открытого файла в общей таблице ядра (в середине), где хранятся смещение и режим открытия; описание указывает на inode (справа), где хранятся размер, права и расположение блоков. dup (2) и fork (4) копируют указатели на описание, поэтому fd 3 и fd 4 обоих процессов разделяют одно смещение в A, и запись потомка через fd 3 сдвигает его до ${offA} (5). Второй open (3) создаёт отдельное описание B с собственным смещением, по-прежнему равным ${offB}.`
    : `The state at the end of the example in the text. A descriptor is the index of a slot in the process's table (left). The slot points to an open file description in the kernel-wide table (middle), which holds the offset and the access mode; the description points to the inode (right), which holds the size, the permissions and where the blocks are. dup (2) and fork (4) copy pointers to a description, so fds 3 and 4 of both processes share the one offset in A, and the child's write through fd 3 moves it to ${offA} (5). The second open (3) creates a separate description B with its own offset, still ${offB}.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Таблицы дескрипторов, открытых файлов и inode после dup и fork' : 'Descriptor, open file and inode tables after dup and fork'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? `Слева две таблицы дескрипторов, родителя и потомка, в каждой строки 0–2, fd 3, fd 4, fd 5. Стрелки от fd 3 и fd 4 обоих процессов ведут к описанию A со смещением ${offA}; стрелки от fd 5 обоих процессов ведут к описанию B со смещением ${offB}. Оба описания указывают на один inode файла log.txt.`
        : `On the left, two descriptor tables, the parent's and the child's, each with rows 0–2, fd 3, fd 4 and fd 5. Arrows from fd 3 and fd 4 of both processes lead to description A, with offset ${offA}; arrows from fd 5 of both lead to description B, with offset ${offB}. Both descriptions point to the one inode of log.txt.`}</desc>

      <text class="f-small f-t-muted" x={L.heads[0][0]} y={L.heads[0][1]} style="font-weight: 650">{t.heads[0]}</text>
      {L.cls === 'fig-wide' && <text class="f-small f-t-muted" x={L.heads[1][0]} y={L.heads[1][1]} style="font-weight: 650">{t.heads[1]}</text>}
      {L.cls === 'fig-wide' && <text class="f-small f-t-muted" x={L.heads[2][0]} y={L.heads[2][1]} style="font-weight: 650">{t.heads[2]}</text>}
      {L.cls !== 'fig-wide' && <text class="f-small f-t-muted" x={L.heads[1][0]} y={L.heads[1][1]} style="font-weight: 650">{ru ? 'в ядре' : 'in the kernel'}</text>}

      {/* the two descriptor tables; the child's appears at step 4 */}
      {[L.py, L.cy].map((base, k) => (
        <g>
          <text data-s={k === 0 ? '1' : '4'} class="f-small f-t-muted" x={k === 0 ? L.plabel[0] : L.clabel[0]} y={k === 0 ? L.plabel[1] : L.clabel[1]}>{k === 0 ? t.parent : t.child}</text>
          {t.rows.map((r, i) => (
            <g data-s={k === 0 ? `${Math.max(1, i)}` : '4'}>
              <rect x={L.tx} y={rowY(L, base, i)} width={L.tw} height={L.rh} style={`fill: ${i === 0 ? 'var(--paper-strong)' : toneVar.x}; fill-opacity: ${i === 0 ? 1 : 0.12}; stroke: ${i === 0 ? 'var(--line)' : toneVar.x}; stroke-width: 1.1`} />
              <text class={i === 0 ? 'f-small f-t-muted' : 'f-small'} x={L.tx + 10} y={mid(L, base, i) + 4.5}>{r}</text>
              {i > 0 && <circle cx={L.tx + L.tw - 10} cy={mid(L, base, i)} r="3" class="f-solid-green" />}
            </g>
          ))}
        </g>
      ))}

      {/* step 1: description A and the inode */}
      <g data-s="1">
        <Arrow pts={toBox(L, L.py, 1, L.A, -8)} tone="green" />
        <Box x={L.A[0]} y={L.A[1]} w={L.bw} h={L.bh} label={t.A} sub={t.mode} tone="h" />
        <Arrow pts={L.cls === 'fig-wide' ? [[L.A[0] + L.bw + 2, L.A[1] + L.bh / 2], [L.I[0] - 3, L.I[1] + 16]] : [[L.aDown + L.A[0], L.A[1] + L.bh + 2], [L.aDown + L.A[0], L.I[1] - 3]]} tone="blue" />
        <Box x={L.I[0]} y={L.I[1]} w={L.iw} h={L.ih} label={t.inode} sub={t.inodeSub} tone="g" />
        <Badge x={L.badges[0][0]} y={L.badges[0][1]} n={1} />
      </g>
      {/* step 2: dup */}
      <g data-s="2">
        <Arrow pts={toBox(L, L.py, 2, L.A, 0)} tone="green" />
        <Badge x={L.badges[1][0]} y={L.badges[1][1]} n={2} />
      </g>
      {/* step 3: a second open, description B */}
      <g data-s="3">
        <Arrow pts={toBox(L, L.py, 3, L.B, -10)} tone="green" />
        <Box x={L.B[0]} y={L.B[1]} w={L.bw} h={L.bh} label={t.B} sub={t.mode} tone="h" />
        <Arrow pts={L.cls === 'fig-wide' ? [[L.B[0] + L.bw + 2, L.B[1] + L.bh / 2], [L.I[0] - 3, L.I[1] + L.ih - 16]] : [[L.B[0] + L.bw / 2, L.B[1] - 2], [L.B[0] + L.bw / 2, L.I[1] + L.ih + 3]]} tone="blue" />
        <text class="f-small f-t-blue" x={L.offB[0]} y={L.offB[1]} text-anchor={L.offB[2]}>{L.short ? t.offBShort : t.offB}</text>
        <Badge x={L.badges[2][0]} y={L.badges[2][1]} n={3} />
      </g>
      {/* step 4: fork copies the pointers */}
      <g data-s="4">
        <Arrow pts={toBox(L, L.cy, 1, L.A, 8)} tone="muted" dashed />
        <Arrow pts={toBox(L, L.cy, 2, L.A, 16)} tone="muted" dashed />
        <Arrow pts={toBox(L, L.cy, 3, L.B, 10)} tone="muted" dashed />
        <Badge x={L.badges[3][0]} y={L.badges[3][1]} n={4} />
      </g>
      {/* step 5: the child's write moves the shared offset */}
      <g data-s="5">
        <text class="f-small f-t-red" x={L.offA[0]} y={L.offA[1]} text-anchor={L.offA[2]} style="font-weight: 650">{L.short ? t.offAShort : t.offA}</text>
        <Badge x={L.badges[4][0]} y={L.badges[4][1]} n={5} />
      </g>
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
