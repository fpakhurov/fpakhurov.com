---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A directory with a file a.txt, a hard link b.txt to it and a symbolic link c.txt -> a.txt, as in the note's
// Code section. The inode numbers are examples; the link counts and sizes are what that program prints.
const content = 'data\n', target = 'a.txt';
const entries: [string, number][] = [['a.txt', 1201], ['b.txt', 1201], ['c.txt', 1202]];
const links = entries.filter(([, n]) => n === 1201).length;
if (links !== 2 || content.length !== 5 || target.length !== 5) throw new Error('LinksAndInodes: counts');

const t = ru
  ? {
      dir: 'каталог d', name: 'имя', ino: 'inode',
      i1: `${links} ссылки, ${content.length} байт`, i2: `симв. ссылка, ${target.length} байт`,
      d1: '«data\\n»', d2: '«a.txt»', again: 'поиск «a.txt» заново',
      steps: ['каталог — файл, который отображает имена в номера inode', `a.txt и b.txt хранят один номер: жёсткая ссылка, у inode ${links} ссылки`, 'inode хранит метаданные и указатели на блоки данных, но не имя', 'c.txt — символьная ссылка: отдельный inode, содержимое которого — путь «a.txt»; открытие c.txt снова ищет это имя в каталоге'],
    }
  : {
      dir: 'directory d', name: 'name', ino: 'inode',
      i1: `${links} links, ${content.length} bytes`, i2: `symlink, ${target.length} bytes`,
      d1: '“data\\n”', d2: '“a.txt”', again: 'look up “a.txt” again',
      steps: ['a directory is a file that maps names to inode numbers', `a.txt and b.txt hold the same number: a hard link; the inode has ${links} links`, 'the inode holds the metadata and pointers to the data blocks, not the name', 'c.txt is a symbolic link: an inode of its own whose content is the path “a.txt”; opening c.txt looks that name up in the directory again'],
    };

interface Layout {
  cls: string; W: number; H: number;
  dir: [number, number, number, number]; rowH: number; rowTop: number;
  I: [number, number][]; iw: number; ih: number; D: [number, number][]; dw: number; dh: number;
  wide: boolean; back: [number, number][]; backAt: [number, number, 'start' | 'middle' | 'end'];
  badges: [number, number][];
}
const wide: Layout = {
  cls: 'fig-wide', W: 760, H: 252,
  dir: [26, 44, 220, 140], rowH: 34, rowTop: 100,
  I: [[330, 44], [330, 150]], iw: 190, ih: 60, D: [[600, 50], [600, 156]], dw: 140, dh: 48,
  wide: true, back: [[670, 206], [670, 232], [136, 232], [136, 188]], backAt: [400, 225, 'middle'],
  badges: [[26, 44], [284, 62], [330, 44], [330, 150]],
};
const narrow: Layout = {
  cls: 'fig-narrow seq-narrow', W: 360, H: 446,
  dir: [20, 40, 320, 140], rowH: 34, rowTop: 96,
  I: [[10, 236], [190, 236]], iw: 160, ih: 60, D: [[20, 356], [200, 356]], dw: 140, dh: 48,
  wide: false, back: [[340, 380], [352, 380], [352, 120], [344, 120]], backAt: [346, 420, 'end'],
  badges: [[20, 40], [62, 208], [10, 236], [190, 236]],
};
const rowMid = (L: Layout, i: number) => L.rowTop + i * L.rowH - 5;
const id = 'links-and-inodes';
const layouts = [wide, narrow];
---

<Figure
  id={id}
  title={ru ? 'Каталог, inode и два вида ссылок' : 'A directory, inodes and the two kinds of link'}
  caption={ru
    ? `Каталог хранит только пары «имя → номер inode» (1). Имена a.txt и b.txt указывают на один inode: это два равноправных имени одного файла, и счётчик ссылок inode равен ${links} (2). Inode хранит размер, владельца, права и указатели на блоки данных, но не имя (3). Символьная ссылка c.txt — отдельный inode, данные которого — путь «a.txt»; ядро, встретив её, начинает поиск имени заново (4). Номера inode условные; счётчики и размеры — те, что печатает программа из раздела «Код».`
    : `A directory stores only pairs of name and inode number (1). The names a.txt and b.txt point to the same inode: two equal names of one file, and the inode's link count is ${links} (2). The inode stores the size, the owner, the permissions and the pointers to the data blocks, but not the name (3). The symbolic link c.txt is a separate inode whose data is the path "a.txt"; when the kernel meets it, it starts the name lookup again (4). The inode numbers are examples; the counts and sizes are those printed by the program in the Code section.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Жёсткая и символьная ссылки' : 'Hard and symbolic links'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? `Каталог d с тремя записями: a.txt и b.txt указывают на inode 1201, c.txt на inode 1202. Inode 1201 (${links} ссылки, 5 байт) указывает на блок с текстом data. Inode 1202, символьная ссылка, указывает на блок с текстом a.txt, а пунктирная стрелка от него возвращается к каталогу: поиск имени a.txt заново.`
        : `Directory d with three entries: a.txt and b.txt point to inode 1201, c.txt to inode 1202. Inode 1201 (${links} links, 5 bytes) points to a block containing data. Inode 1202, a symbolic link, points to a block containing a.txt, and a dashed arrow from it returns to the directory: the name a.txt is looked up again.`}</desc>

      <g data-s="1">
        <rect x={L.dir[0]} y={L.dir[1]} width={L.dir[2]} height={L.dir[3]} rx="7" class="f-box-soft" />
        <text class="f-small f-t-muted" x={L.dir[0] + 16} y={L.dir[1] + 22} style="font-weight: 650">{t.dir}</text>
        <text class="f-small f-t-muted" x={L.dir[0] + L.dir[2] - 16} y={L.dir[1] + 22} text-anchor="end">{t.name} → {t.ino}</text>
        {entries.map(([name, n], i) => (
          <g>
            <line class="f-grid" x1={L.dir[0] + 8} x2={L.dir[0] + L.dir[2] - 8} y1={L.rowTop + i * L.rowH - 24} y2={L.rowTop + i * L.rowH - 24} style={`stroke-width: ${i === 0 ? 1.4 : 1}`} />
            <text class="f-label" x={L.dir[0] + 16} y={L.rowTop + i * L.rowH}>{name}</text>
            <text class={i < 2 ? 'f-label f-t-blue' : 'f-label f-t-amber'} x={L.dir[0] + L.dir[2] - 16} y={L.rowTop + i * L.rowH} text-anchor="end">{n}</text>
          </g>
        ))}
        <Badge x={L.badges[0][0]} y={L.badges[0][1]} n={1} />
      </g>

      <g data-s="2">
        {[0, 1].map((i) => (L.wide
          ? <Arrow pts={[[L.dir[0] + L.dir[2] + 2, rowMid(L, i)], [L.I[0][0] - 3, L.I[0][1] + 22 + i * 16]]} tone="blue" />
          : <Arrow pts={[[L.dir[0] + 70 + i * 40, L.dir[1] + L.dir[3] + 2], [L.I[0][0] + 60 + i * 30, L.I[0][1] - 3]]} tone="blue" />))}
        <Badge x={L.badges[1][0]} y={L.badges[1][1]} n={2} />
      </g>

      <g data-s="3">
        <Box x={L.I[0][0]} y={L.I[0][1]} w={L.iw} h={L.ih} label="inode 1201" sub={t.i1} tone="h" />
        {L.wide
          ? <Arrow pts={[[L.I[0][0] + L.iw + 2, L.I[0][1] + L.ih / 2], [L.D[0][0] - 3, L.D[0][1] + L.dh / 2]]} tone="blue" />
          : <Arrow pts={[[L.I[0][0] + 80, L.I[0][1] + L.ih + 2], [L.D[0][0] + 70, L.D[0][1] - 3]]} tone="blue" />}
        <rect x={L.D[0][0]} y={L.D[0][1]} width={L.dw} height={L.dh} class="f-box-soft" />
        <text class="f-label" x={L.D[0][0] + L.dw / 2} y={L.D[0][1] + L.dh / 2 + 5} text-anchor="middle" style="font-family: var(--mono, monospace)">{t.d1}</text>
        <Badge x={L.badges[2][0]} y={L.badges[2][1]} n={3} />
      </g>

      <g data-s="4">
        {L.wide
          ? <Arrow pts={[[L.dir[0] + L.dir[2] + 2, rowMid(L, 2)], [L.I[1][0] - 3, L.I[1][1] + L.ih / 2]]} tone="amber" />
          : <Arrow pts={[[L.dir[0] + 250, L.dir[1] + L.dir[3] + 2], [L.I[1][0] + 80, L.I[1][1] - 3]]} tone="amber" />}
        <Box x={L.I[1][0]} y={L.I[1][1]} w={L.iw} h={L.ih} label="inode 1202" sub={t.i2} tone="g" />
        {L.wide
          ? <Arrow pts={[[L.I[1][0] + L.iw + 2, L.I[1][1] + L.ih / 2], [L.D[1][0] - 3, L.D[1][1] + L.dh / 2]]} tone="amber" />
          : <Arrow pts={[[L.I[1][0] + 80, L.I[1][1] + L.ih + 2], [L.D[1][0] + 70, L.D[1][1] - 3]]} tone="amber" />}
        <rect x={L.D[1][0]} y={L.D[1][1]} width={L.dw} height={L.dh} class="f-box-soft" />
        <text class="f-label" x={L.D[1][0] + L.dw / 2} y={L.D[1][1] + L.dh / 2 + 5} text-anchor="middle" style="font-family: var(--mono, monospace)">{t.d2}</text>
        <Arrow pts={L.back} tone="amber" dashed />
        <text class="f-small f-t-amber f-halo" x={L.backAt[0]} y={L.backAt[1]} text-anchor={L.backAt[2]}>{t.again}</text>
        <Badge x={L.badges[3][0]} y={L.badges[3][1]} n={4} />
      </g>
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
