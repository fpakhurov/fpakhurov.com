---
/**
 * Numbered figure wrapper for course notes.
 * `origin` tells the reader how the drawing relates to the handwritten scan.
 */
interface Props {
  id: string;
  title: string;
  caption?: string;
  origin?: 'redrawn' | 'expanded' | 'illustrative';
  pages?: string;
}

const { id, title, caption, origin = 'redrawn', pages } = Astro.props;
const originLabel = {
  redrawn: 'Redrawn from the scan',
  expanded: 'Expanded from a sketch in the scan',
  illustrative: 'Illustrative addition',
}[origin];
---

<figure class="fig" id={`fig-${id}`}>
  <header class="fig-head">
    <span class="fig-kicker">Figure</span>
    <p class="fig-title">{title}</p>
  </header>
  <div class="fig-body"><slot /></div>
  <figcaption>
    {caption && <span>{caption} </span>}
    <span class="fig-origin">{originLabel}{pages && `, p. ${pages}`}.</span>
  </figcaption>
</figure>
