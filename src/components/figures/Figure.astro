---
import { pageLang } from '../../utils/lang';

/**
 * Numbered figure wrapper for course notes.
 */
interface Props {
  id: string;
  title: string;
  caption?: string;
}

const { id, title, caption } = Astro.props;
const kicker = pageLang(Astro.url) === 'ru' ? 'Рисунок' : 'Figure';
---

<figure class="fig" id={`fig-${id}`}>
  <header class="fig-head">
    <span class="fig-kicker">{kicker}</span>
    <p class="fig-title">{title}</p>
  </header>
  <div class="fig-body"><slot /></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
