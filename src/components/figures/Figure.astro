---
/**
 * Numbered figure wrapper for course notes.
 * `origin` and `pages` are kept as authoring metadata and are not rendered.
 */
interface Props {
  id: string;
  title: string;
  caption?: string;
  origin?: 'redrawn' | 'expanded' | 'illustrative';
  pages?: string;
}

const { id, title, caption } = Astro.props;
---

<figure class="fig" id={`fig-${id}`}>
  <header class="fig-head">
    <span class="fig-kicker">Figure</span>
    <p class="fig-title">{title}</p>
  </header>
  <div class="fig-body"><slot /></div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
