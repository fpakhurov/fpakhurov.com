---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
// Original answer-save fixture, checked by scripts/notes/check-slo-renewal.py.
// Eleven minute buckets have 100 successful requests; one has one failed request.
const total = 11 * 100 + 1;
const byRequest = 100 / total;
const byMinute = 100 / 12;
const t = ru ? {
  title: 'У запроса и минуты разный вес',
  caption: 'Вымышленный пример: 11 минут по 100 успешных сохранений и одна минута с одним неудачным. Для SLI по запросам сначала складывают счётчики. Среднее процентов отвечает другому вопросу.',
  slice: 'Интервал', requests: 'Попытки', bad: 'Неудачные',
  normal: '11 обычных минут', quiet: '1 тихая минута',
  request: 'Доля неудачных запросов', minute: 'Среднее долей по минутам',
} : {
  title: 'A request and a minute have different weights',
  caption: 'Fictional fixture: eleven minutes with 100 successful saves each, and one minute with a single failed save. A request SLI sums the counters first. Averaging minute percentages answers a different question.',
  slice: 'Interval', requests: 'Attempts', bad: 'Bad attempts',
  normal: '11 ordinary minutes', quiet: '1 quiet minute',
  request: 'Fraction of failed requests', minute: 'Mean of minute fractions',
};
---

<Figure id="budget-burn" title={t.title} caption={t.caption}>
  <div class="exposure-example">
    <table>
      <thead><tr><th scope="col">{t.slice}</th><th scope="col">{t.requests}</th><th scope="col">{t.bad}</th></tr></thead>
      <tbody>
        <tr><th scope="row">{t.normal}</th><td>1100</td><td>0</td></tr>
        <tr><th scope="row">{t.quiet}</th><td>1</td><td>1</td></tr>
      </tbody>
    </table>
    <dl>
      <div><dt>{t.request}</dt><dd>1 / {total} = {byRequest.toFixed(3)}%</dd></div>
      <div><dt>{t.minute}</dt><dd>100% / 12 = {byMinute.toFixed(3)}%</dd></div>
    </dl>
  </div>
</Figure>

<style>
  .exposure-example { padding: 1rem; }
  .exposure-example table { display: table; width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
  th, td { padding: .5rem; text-align: right; }
  th:first-child { text-align: left; }
  dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); gap: 1rem; margin: 1.25rem 0 0; }
  dt { font-size: .9rem; }
  dd { margin: .25rem 0 0; font-variant-numeric: tabular-nums; font-weight: 600; }
</style>
