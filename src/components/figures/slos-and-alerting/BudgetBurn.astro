---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The month of the note: SLO 99.9 % over 30 days, constant traffic, minute by minute.
// Background: 0.01 % of requests fail. Day 9 at 14:02 a bad deploy makes 12 % fail until the rollback at 14:31.
// Days 18 to 23: a slow leak, 0.15 % fail. Alerts: page if (1 h and 5 min above 14.4 × 0.1 %) or (6 h and 30 min above 6 × 0.1 %);
// ticket if (24 h and 2 h above 3 × 0.1 %) or (3 d and 6 h above 0.1 %). Windows count only once they are full.
const BUDGET = 0.001, N = 30 * 1440, BG = 0.0001;
const inc0 = 9 * 1440 + 14 * 60 + 2, inc1 = inc0 + 29, leak0 = 18 * 1440, leak1 = 23 * 1440;
const err = (m: number) => (m >= inc0 && m < inc1 ? 0.12 : m >= leak0 && m < leak1 ? 0.0015 : BG);
const pre = [0];
for (let m = 0; m < N; m++) pre.push(pre[m] + err(m));
const avg = (m: number, w: number) => (pre[m + 1] - pre[m + 1 - w]) / w;
const rules = [
  { name: 'page', lw: 60, sw: 5, b: 14.4 }, { name: 'page', lw: 360, sw: 30, b: 6 },
  { name: 'ticket', lw: 1440, sw: 120, b: 3 }, { name: 'ticket', lw: 4320, sw: 360, b: 1 },
];
const first: Record<string, number> = {};
for (let m = 0; m < N; m++) {
  for (const r of rules) {
    if (m + 1 < r.lw || first[r.name] !== undefined) continue;
    if (avg(m, r.lw) > r.b * BUDGET && avg(m, r.sw) > r.b * BUDGET) first[r.name] = m;
  }
}
const spentBefore = (m: number) => pre[m] / (BUDGET * N); // fraction of the budget spent before minute m
const remaining = (m: number) => 100 * (1 - spentBefore(m));
// The numbers quoted in the note.
if (first.page !== inc0 + 7) throw new Error(`page at minute ${first.page - inc0} of the incident`);
const incidentShare = (pre[inc1] - pre[inc0]) / (BUDGET * N);
if (Math.abs(incidentShare - 0.0806) > 5e-4) throw new Error(`incident share ${incidentShare}`);
const leakShare = (pre[leak1] - pre[leak0]) / (BUDGET * N);
if (Math.abs(leakShare - 0.25) > 1e-9) throw new Error(`leak share ${leakShare}`);
const ticketDays = (first.ticket - leak0) / 1440;
if (Math.abs(ticketDays - 1.93) > 0.01) throw new Error(`ticket after ${ticketDays} days`);
const left = remaining(N);
if (Math.abs(left - 58.6) > 0.05) throw new Error(`left at the end ${left}`);

// Hourly samples for the curve, plus the two ends of the incident so that the drop is drawn as it happened.
const samples: number[] = [];
for (let m = 0; m <= N; m += 60) samples.push(m);
samples.push(inc0, inc1);
samples.sort((p, q) => p - q);

const pct = (v: number) => (ru ? `${v.toFixed(1)}%` : `${v.toFixed(1)} %`);
const t = ru
  ? { legend: 'остаток бюджета', ref: 'скорость расходования 1: бюджет кончится на 30-й день', refN: 'скорость 1: ноль на 30-й день', x: 'день окна в 30 дней', y: 'остаток бюджета, %',
      inc: ['релиз: 12% ошибок за 29 мин', '8.1% бюджета; вызов в 14:09'], incN: ['вызов', '14:09'],
      leak: ['медленная утечка: 0.15%', 'ошибок 5 дней, 25% бюджета;', 'тикет через 1.9 дня'], leakN: ['тикет'], bg: 'скорость 0.1', left: `осталось ${pct(left)}`, leftN: pct(left) }
  : { legend: 'budget left', ref: 'burn rate 1: the budget runs out on day 30', refN: 'burn rate 1: zero on day 30', x: 'day of the 30-day window', y: 'budget left, %',
      inc: ['bad deploy: 12 % for 29 min', '8.1 % of budget; page 14:09'], incN: ['page', '14:09'],
      leak: ['slow leak: 0.15 % errors', 'for 5 days, 25 % of budget;', 'ticket after 1.9 days'], leakN: ['ticket'], bg: 'burn rate 0.1', left: `${pct(left)} left`, leftN: pct(left) };

interface Label { x: number; y: number; lines: string[]; anchor: 'start' | 'end'; cls: string }
interface Layout { cls: string; W: number; H: number; box: [number, number, number, number]; wide: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 350, box: [64, 44, 734, 294], wide: true },
  { cls: 'fig-narrow', W: 360, H: 350, box: [44, 54, 346, 294], wide: false },
];
const CH = 6.5, LH = 16;
const plots = layouts.map((L) => {
  const [x0, y0, x1, y1] = L.box;
  const sx = scale([0, N], [x0, x1]);
  const sy = scale([0, 100], [y1, y0]);
  const pts = samples.map((m) => [sx(m), sy(remaining(m))] as [number, number]);
  const curve = polyline(pts);
  const ref = polyline([[sx(0), sy(100)], [sx(N), sy(0)]]);
  const page = [sx(first.page), sy(remaining(first.page + 1))] as const;
  const ticket = [sx(first.ticket), sy(remaining(first.ticket + 1))] as const;
  const labels: Label[] = L.wide
    ? [
        { x: sx(inc1) + 10, y: sy(79), lines: t.inc, anchor: 'start', cls: 'f-small f-t-red' },
        { x: sx(21 * 1440), y: sy(52), lines: t.leak, anchor: 'start', cls: 'f-small f-t-amber' },
        { x: sx(4 * 1440), y: sy(91), lines: [t.bg], anchor: 'start', cls: 'f-small f-t-muted' },
        { x: x1, y: sy(left) - 12, lines: [t.left], anchor: 'end', cls: 'f-small' },
      ]
    : [
        { x: sx(inc1) + 7, y: sy(78), lines: t.incN, anchor: 'start', cls: 'f-small f-t-red' },
        { x: ticket[0] - 10, y: ticket[1] + 4, lines: t.leakN, anchor: 'end', cls: 'f-small f-t-amber' },
        { x: x1, y: sy(left) - 12, lines: [t.leftN], anchor: 'end', cls: 'f-small' },
      ];
  // Label boxes must stay inside the plot and clear of both lines and of each other.
  const boxes = labels.map((lb) => {
    const w = Math.max(...lb.lines.map((s) => s.length)) * CH;
    const left0 = lb.anchor === 'start' ? lb.x : lb.x - w;
    return { l: left0, r: left0 + w, top: lb.y - 11, bottom: lb.y + (lb.lines.length - 1) * LH + 3, s: lb.lines[0] };
  });
  const lineY = (x: number) => { // y of the budget curve at screen x (piecewise linear)
    for (let i = 1; i < pts.length; i++) if (pts[i][0] >= x) {
      const [xa, ya] = pts[i - 1], [xb, yb] = pts[i];
      return xb === xa ? Math.max(ya, yb) : ya + ((yb - ya) * (x - xa)) / (xb - xa);
    }
    return pts[pts.length - 1][1];
  };
  const refY = (x: number) => y0 + ((y1 - y0) * (x - x0)) / (x1 - x0);
  for (const b of boxes) {
    if (b.l < x0 + 2 || b.r > L.W - 4 || b.top < y0 - 4 || b.bottom > y1 - 2) throw new Error(`label "${b.s}" leaves the plot at ${L.W}`);
    for (let x = b.l; x <= b.r; x += 2) {
      const yc = lineY(x), yr = refY(x);
      if (yc > b.top - 3 && yc < b.bottom + 3) throw new Error(`label "${b.s}" meets the budget line at ${L.W}, x=${x}`);
      if (yr > b.top - 3 && yr < b.bottom + 3) throw new Error(`label "${b.s}" meets the reference line at ${L.W}, x=${x}`);
    }
  }
  for (let i = 0; i < boxes.length; i++) for (let j = i + 1; j < boxes.length; j++) {
    const a = boxes[i], b = boxes[j];
    if (a.l < b.r && b.l < a.r && a.top < b.bottom && b.top < a.bottom) throw new Error(`labels "${a.s}" and "${b.s}" overlap`);
  }
  const refText = L.wide ? t.ref : t.refN;
  if (x0 + 160 + 30 + refText.length * CH > L.W - 4 && L.wide) throw new Error('legend');
  if (!L.wide && x0 + 30 + refText.length * CH > L.W - 4) throw new Error('narrow legend');
  return { L, sx, sy, curve, ref, page, ticket, labels, refText };
});
const id = 'budget-burn';
---

<Figure
  id={id}
  title={ru ? 'Бюджет ошибок за месяц и оповещения по скорости его расходования' : 'A month of error budget and the burn-rate alerts'}
  caption={ru
    ? 'Расчёт из заметки: SLO 99.9% на окне 30 дней, постоянный трафик, шаг одна минута. Фоновая доля ошибок 0.01% (скорость расходования 0.1). На 9-й день в 14:02 неудачное развёртывание даёт 12% ошибок до отката в 14:31: это 8.1% бюджета; правило «1 ч и 5 мин выше 14.4 × 0.1%» вызывает дежурного в 14:09, когда инцидент израсходовал 2% бюджета. С 18-го по 23-й день медленная утечка, 0.15% ошибок (скорость 1.5), съедает 25% бюджета; правила вызова молчат, а правило «3 дня и 6 ч выше 0.1%» открывает тикет через 1.9 дня. К концу окна остаётся 58.6%. Пунктир — расход со скоростью ровно 1.'
    : 'The computation of the note: SLO 99.9 % over a 30-day window, constant traffic, one-minute steps. The background error rate is 0.01 % (burn rate 0.1). On day 9 at 14:02 a bad deploy makes 12 % of requests fail until the rollback at 14:31, which costs 8.1 % of the budget; the rule "1 h and 5 min above 14.4 × 0.1 %" pages at 14:09, when the incident has spent 2 % of the budget. From day 18 to day 23 a slow leak of 0.15 % errors (burn rate 1.5) eats 25 % of the budget; the paging rules stay silent and the rule "3 days and 6 h above 0.1 %" opens a ticket after 1.9 days. At the end of the window 58.6 % is left. The dashed line spends the budget at a burn rate of exactly 1.'}
>
  {plots.map(({ L, sx, sy, curve, ref, page, ticket, labels, refText }) => {
    const [x0, y0, x1, y1] = L.box;
    const legendY = L.wide ? 20 : 18;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Остаток бюджета ошибок за 30 дней' : 'Error budget left over 30 days'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'График остатка бюджета ошибок в процентах по дням от 0 до 30. Линия медленно опускается со 100%, на 9-й день резко падает примерно на 8 процентных пунктов, с 18-го по 23-й день идёт круто вниз ещё на 25 пунктов и заканчивается на 58.6%. Красная точка отмечает вызов дежурного в начале падения, жёлтая — тикет посреди утечки. Пунктир идёт по прямой от 100% в день 0 до нуля в день 30.'
          : 'A plot of the error budget left, in percent, against the day from 0 to 30. The line falls slowly from 100 %, drops by about 8 points on day 9, falls steeply by another 25 points from day 18 to day 23, and ends at 58.6 %. A red dot marks the page at the start of the drop, an amber dot the ticket in the middle of the leak. A dashed straight line runs from 100 % on day 0 to zero on day 30.'}</desc>
        {[0, 25, 50, 75, 100].map((v) => (
          <g>
            <path class="f-grid" d={`M ${x0} ${sy(v)} H ${x1}`} />
            <text class="f-note" x={x0 - 8} y={sy(v) + 5} text-anchor="end">{String(v)}</text>
          </g>
        ))}
        {[0, 5, 10, 15, 20, 25, 30].map((d) => (
          <g>
            <path class="f-axis" d={`M ${sx(d * 1440)} ${y1} v 5`} />
            <text class="f-note" x={sx(d * 1440)} y={y1 + 20} text-anchor="middle">{String(d)}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${x0} ${y0} V ${y1} H ${x1}`} />
        <text class="f-note" x={x1} y={y1 + 42} text-anchor="end">{t.x}</text>
        <path class="f-thin f-muted f-dash" d={ref} />
        <path class="f-line f-blue f-bold" d={curve} />
        <circle cx={page[0]} cy={page[1]} r="5" class="f-solid-red" />
        <circle cx={ticket[0]} cy={ticket[1]} r="5" style="fill: var(--fig-amber)" />
        {labels.map((lb) => (
          <text class={lb.cls} x={lb.x} y={lb.y} text-anchor={lb.anchor}>
            {lb.lines.map((s, k) => <tspan x={lb.x} dy={k === 0 ? 0 : 16}>{s}</tspan>)}
          </text>
        ))}
        <path class="f-line f-blue f-bold" d={`M ${x0} ${legendY - 4} h 22`} />
        <text class="f-small" x={x0 + 30} y={legendY}>{t.legend}</text>
        <path class="f-thin f-muted f-dash" d={`M ${L.wide ? x0 + 160 : x0} ${L.wide ? legendY - 4 : legendY + 14} h 22`} />
        <text class="f-small f-t-muted" x={(L.wide ? x0 + 160 : x0) + 30} y={L.wide ? legendY : legendY + 18}>{refText}</text>
      </svg>
    );
  })}
</Figure>
