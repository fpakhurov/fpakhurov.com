---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { Phi, phi } from '../normal';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Estimating P(Z > 4) for Z ~ N(0, 1). Under p = N(0, 1) the event is one draw in 31,600; under q = N(4, 1) it is every
// other draw, and each such draw is weighted by p(x)/q(x) = e^(8 − 4x).
const pTail = 1 - Phi(4), qTail = 1 - Phi(0);
if (pTail.toExponential(2) !== '3.17e-5') throw new Error('ImportanceSampling: the tail drifted from the note');
const xs = Array.from({ length: 241 }, (_, i) => -4 + i * 0.05);
const t = ru
  ? { p: 'p = N(0, 1)', q: 'предложение q = N(4, 1)', ev: 'событие Z > 4', pr: `P_p = ${pTail.toExponential(2).replace('e-5', '·10⁻⁵')}`, qr: `P_q = ${qTail.toFixed(2)}`, w: 'вес p/q = e^(8 − 4x)' }
  : { p: 'p = N(0, 1)', q: 'proposal q = N(4, 1)', ev: 'event Z > 4', pr: `P_p = ${pTail.toExponential(2).replace('e-5', '·10⁻⁵')}`, qr: `P_q = ${qTail.toFixed(2)}`, w: 'weight p/q = e^(8 − 4x)' };
const id = 'importance-sampling';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 350, x0: 30, x1: 580, y0: 30, y1: 240, lx: 40, ly: 286 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 330, x0: 16, x1: 344, y0: 110, y1: 280, lx: 16, ly: 24 },
];
---

<Figure
  id={id}
  title={ru ? 'Выборка по значимости для редкого события' : 'Importance sampling for a rare event'}
  caption={ru
    ? `Чтобы оценить P(Z > 4) = ${pTail.toExponential(2).replace('e-5', '·10⁻⁵')} для стандартной нормальной Z, прямая выборка из p тратит впустую почти все точки: в область попадает одна из 31 600. Предложение q = N(4, 1) попадает в неё в половине случаев, а каждое попадание взвешивается отношением p/q = e^(8 − 4x), которое возвращает оценке правильное ожидание. 10 000 точек из q дают относительную стандартную ошибку около 2%, миллион точек из p — около 18%.`
    : `To estimate P(Z > 4) = ${pTail.toExponential(2).replace('e-5', '·10⁻⁵')} for a standard normal Z, plain sampling from p wastes almost every draw: one in 31,600 lands in the region. The proposal q = N(4, 1) lands there half the time, and every hit is weighted by p/q = e^(8 − 4x), which restores the right expectation. 10,000 draws from q give a relative standard error of about 2%, a million draws from p about 18%.`}
>
  {layouts.map((L) => {
    const sx = scale([-4, 8], [L.x0, L.x1]), sy = scale([0, 0.45], [L.y1, L.y0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Исходная плотность, предложение и область события' : 'Original density, proposal and the event region'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Нормальная кривая у нуля почти не заходит в область правее 4; кривая предложения с центром 4 наполовину лежит в ней.' : 'The normal curve at zero barely reaches the region beyond 4; the proposal curve centred at 4 lies half inside it.'}</desc>
        <rect x={sx(4)} y={L.y0} width={sx(8) - sx(4)} height={L.y1 - L.y0} style="fill: var(--fig-red); fill-opacity: .08" />
        <text class="f-small f-t-red" x={sx(7.9)} y={L.y0 + 16} text-anchor="end">{t.ev}</text>
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {[-4, -2, 0, 2, 4, 6, 8].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{v}</text>)}
        <path class="f-line f-blue" d={polyline(xs.map((x) => [sx(x), sy(phi(x))]))} />
        <path class="f-line f-amber" d={polyline(xs.map((x) => [sx(x), sy(phi(x - 4))]))} />
        <path class="f-line f-blue" d={`M ${L.lx} ${L.ly} h 22`} />
        <text class="f-note" x={L.lx + 30} y={L.ly + 5}>{`${t.p}: ${t.pr}`}</text>
        <path class="f-line f-amber" d={`M ${L.lx} ${L.ly + 22} h 22`} />
        <text class="f-note" x={L.lx + 30} y={L.ly + 27}>{`${t.q}: ${t.qr}`}</text>
        <text class="f-note f-t-muted" x={L.lx + 30} y={L.ly + 49}>{t.w}</text>
      </svg>
    );
  })}
</Figure>
