---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale, polyline } from '../geometry';
import { mulberry32 } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Rejection sampling from Beta(2, 5), f(x) = 30 x (1 − x)^4, with a uniform proposal scaled by M = max f = f(0.2) = 2.4576.
// Points uniform under the envelope; those under f are kept, and their x-values are a sample from f.
const f = (x: number) => 30 * x * (1 - x) ** 4, M = f(0.2);
if (M.toFixed(4) !== '2.4576') throw new Error('RejectionSampling: the envelope drifted from the note');
const u = mulberry32(21);
const pts = Array.from({ length: 300 }, () => { const x = u(), y = u() * M; return { x, y, ok: y <= f(x) }; });
const kept = pts.filter((p) => p.ok).length;
if (Math.abs(kept / 300 - 1 / M) > 0.06) throw new Error('RejectionSampling: the seeded acceptance rate is unusual');
const xs = Array.from({ length: 101 }, (_, i) => i / 100);
const t = ru
  ? { env: `огибающая M · q, M = ${M.toFixed(2)}`, f: 'p — плотность Beta(2, 5)', acc: `принято ${kept} из 300`,
      steps: ['целевая плотность p и огибающая M · q: равномерное предложение, умноженное на максимум p', '300 точек равномерно под огибающей: x из q, высота равномерна от 0 до M q(x)', `точки под кривой p принимаются (${kept} из 300, в теории 1/M = 41%); их x — выборка из p`] }
  : { env: `envelope M · q, M = ${M.toFixed(2)}`, f: 'p, the Beta(2, 5) density', acc: `${kept} of 300 accepted`,
      steps: ['the target density p and the envelope M · q: the uniform proposal times the maximum of p', '300 points uniform under the envelope: x from q, height uniform between 0 and M q(x)', `points under the curve p are accepted (${kept} of 300, 1/M = 41% in theory); their x-values are a sample from p`] };
const id = 'rejection-sampling';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 300, x0: 40, x1: 580, y0: 40, y1: 250 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 320, x0: 20, x1: 344, y0: 60, y1: 270 },
];
---

<Figure
  id={id}
  title={ru ? 'Выборка с отклонением' : 'Rejection sampling'}
  caption={ru
    ? `Цель — плотность Beta(2, 5); равномерное предложение q на [0, 1], умноженное на M = ${M.toFixed(4)}, лежит над ней целиком (1). Точки, равномерные под огибающей (2), остаются, если попали под p (3): принято ${kept} из 300. Принятые x распределены по p, а доля принятых в среднем 1/M = 0.41.`
    : `The target is the Beta(2, 5) density; the uniform proposal q on [0, 1], times M = ${M.toFixed(4)}, lies above it everywhere (1). Points uniform under the envelope (2) are kept if they fall under p (3): ${kept} of 300 are accepted. The accepted x-values are distributed as p, and the accepted share is 1/M = 0.41 on average.`}
>
  {layouts.map((L) => {
    const sx = scale([0, 1], [L.x0, L.x1]), sy = scale([0, 2.6], [L.y1, L.y0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Огибающая, точки и принятые точки' : 'Envelope, points and accepted points'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? `Горб плотности под прямоугольником огибающей; ${kept} из 300 точек под горбом.` : `A density hump under the envelope rectangle; ${kept} of 300 points lie under the hump.`}</desc>
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {[0, 0.5, 1].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{v}</text>)}
        <g data-s="1">
          <path class="f-line f-amber f-dash" d={`M ${L.x0} ${L.y1} V ${sy(M)} H ${L.x1} V ${L.y1}`} />
          <path class="f-line f-blue" d={polyline(xs.map((x) => [sx(x), sy(f(x))]))} />
          <text class="f-small f-t-amber" x={L.x1} y={sy(M) - 8} text-anchor="end">{t.env}</text>
          <text class="f-small f-t-blue f-halo" x={sx(0.42)} y={sy(1.9)}>{t.f}</text>
          <Badge x={sx(0.03) + 8} y={sy(M) - 14} n={1} />
        </g>
        <g data-s="2">
          {pts.map((p) => <circle cx={sx(p.x).toFixed(1)} cy={sy(p.y).toFixed(1)} r="2.2" style="fill: var(--muted); fill-opacity: .55" />)}
          <Badge x={sx(0.97)} y={sy(1.3)} n={2} />
        </g>
        <g data-s="3">
          {pts.filter((p) => p.ok).map((p) => <circle cx={sx(p.x).toFixed(1)} cy={sy(p.y).toFixed(1)} r="2.4" class="f-solid-blue" />)}
          <text class="f-small f-t-blue f-halo" x={sx(0.62)} y={sy(1.2)}>{t.acc}</text>
          <Badge x={sx(0.58)} y={sy(1.2) - 5} n={3} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
