---
import Figure from '../Figure.astro';
import { scale, plot } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The synthetic data of the Code section: 40 tasks with human times T (minutes), 8 runs of the agent on each, and the
// number of successes. The data were drawn from P(success) = sigmoid(0.6 (log2 60 - log2 t)). The fit below is the
// maximum-likelihood logistic regression of the Code section, by Newton's method on (w0, w1) with logit = w0 + w1 log2 t;
// then beta = -w1 and log2 h50 = w0 / beta.
const T = [4, 2, 14, 16, 5, 19, 2, 9, 2, 14, 8, 59, 475, 197, 42, 253, 1, 1, 75, 450, 70, 1, 60, 36, 306, 1, 43, 4, 226, 60, 20, 58, 85, 22, 93, 115, 2, 347, 5, 7];
const wins = [8, 8, 6, 6, 8, 7, 8, 6, 7, 7, 7, 4, 2, 3, 5, 3, 8, 7, 2, 0, 2, 8, 4, 6, 2, 7, 6, 8, 0, 3, 5, 7, 5, 6, 4, 2, 7, 2, 5, 8];
const runs = 8, hTrue = 60, betaTrue = 0.6;
const sig = (z: number) => 1 / (1 + Math.exp(-z));
let w0 = 0, w1 = 0;
for (let it = 0; it < 50; it++) {
  let g0 = 0, g1 = 0, h00 = 0, h01 = 0, h11 = 0;
  T.forEach((t, i) => {
    const x = Math.log2(t), q = sig(w0 + w1 * x), v = runs * q * (1 - q), r = wins[i] - runs * q;
    g0 += r; g1 += r * x; h00 += v; h01 += v * x; h11 += v * x * x;
  });
  const det = h00 * h11 - h01 * h01;
  w0 += (h11 * g0 - h01 * g1) / det; w1 += (h00 * g1 - h01 * g0) / det;
}
const beta = -w1, h50 = 2 ** (w0 / beta), h80 = h50 * 2 ** (-Math.log(4) / beta);
const quoted = [h50.toFixed(1), beta.toFixed(2), h80.toFixed(1)].join(' ');
if (quoted !== '67.4 0.57 12.6') throw new Error(`TimeHorizon: fit drifted from the note (${quoted})`);
const fitP = (x: number) => sig(beta * (Math.log2(h50) - x));
const trueP = (x: number) => sig(betaTrue * (Math.log2(hTrue) - x));

const t = ru
  ? { title: 'Горизонт задачи: логистическая подгонка по времени, которое задачи занимают у людей', x: 'время у человека (лог. шкала)', y: 'доля успешных запусков',
      ticks: ['1 мин', '4 мин', '16 мин', '1 ч', '4 ч', '8 ч'], fit: 'подгонка', truth: 'истинная кривая',
      h50: `h₅₀ = ${h50.toFixed(0)} мин`, h80: `h₈₀ = ${h80.toFixed(0)} мин`,
      desc: `Сорок точек: доля успешных запусков агента из восьми на задаче против времени, которое задача занимает у человека, от 1 минуты до 8 часов на логарифмической шкале. Убывающая логистическая кривая подогнана методом максимального правдоподобия; она пересекает 0.5 при ${h50.toFixed(1)} минуты и 0.8 при ${h80.toFixed(1)} минуты. Пунктиром — истинная кривая с горизонтом 60 минут.` }
  : { title: 'Time horizon: a logistic fit against the time tasks take people', x: 'human time for the task (log scale)', y: 'share of successful runs',
      ticks: ['1 min', '4 min', '16 min', '1 h', '4 h', '8 h'], fit: 'fit', truth: 'true curve',
      h50: `h₅₀ = ${h50.toFixed(0)} min`, h80: `h₈₀ = ${h80.toFixed(0)} min`,
      desc: `Forty points: the share of the agent's eight runs that succeeded on a task, against the time the task takes a person, from 1 minute to 8 hours on a log scale. A falling logistic curve is fitted by maximum likelihood; it crosses 0.5 at ${h50.toFixed(1)} minutes and 0.8 at ${h80.toFixed(1)} minutes. Dashed, the true curve, with a horizon of 60 minutes.` };
const id = 'time-horizon';
const caption = ru
  ? `Синтетические данные из раздела «Код»: 40 задач, по 8 запусков на каждой, истинная зависимость σ(0.6 (log₂ 60 − log₂ t)). Логистическая регрессия по log₂ t даёт наклон β = ${beta.toFixed(2)} и 50-процентный горизонт ${h50.toFixed(1)} минуты: время у человека, при котором агент решает задачу с вероятностью 1/2. Горизонт 80% в ${(h50 / h80).toFixed(1)} раза короче, потому что кривая пологая. Точки с одинаковым временем и долей совпадают.`
  : `Synthetic data from the Code section: 40 tasks, 8 runs on each, drawn from σ(0.6 (log₂ 60 − log₂ t)). A logistic regression on log₂ t gives slope β = ${beta.toFixed(2)} and a 50% horizon of ${h50.toFixed(1)} minutes: the human time at which the agent succeeds with probability 1/2. The 80% horizon is ${(h50 / h80).toFixed(1)} times shorter, because the curve is shallow. Points with the same time and share coincide.`;

const tickT = [1, 4, 16, 60, 240, 480];
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [70, 740] as [number, number], py: [40, 270] as [number, number], leg: [560, 70, 22] as [number, number, number] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 400, px: [52, 344] as [number, number], py: [40, 250] as [number, number], leg: [52, 334, 26] as [number, number, number] },
];
const yTicks = [0, 0.25, 0.5, 0.75, 1.0];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sx = scale([0, 9], L.px), sy = scale([0, 1], [L.py[1], L.py[0]]);
    const narrow = L.sfx === 'n';
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {yTicks.map((v) => <path class="f-grid" d={`M ${L.px[0]} ${sy(v)} H ${L.px[1]}`} />)}
        <path class="f-axis" d={`M ${L.px[0]} ${L.py[0] - 6} V ${L.py[1]} H ${L.px[1]}`} />
        {yTicks.map((v) => <text class="f-small" x={L.px[0] - 7} y={sy(v) + 4} text-anchor="end">{v.toFixed(2)}</text>)}
        {tickT.map((v, i) => <text class="f-small" x={sx(Math.log2(v))} y={L.py[1] + 18} text-anchor="middle">{t.ticks[i]}</text>)}
        <text class="f-small f-t-muted" x={(L.px[0] + L.px[1]) / 2} y={L.py[1] + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.px[0] - 40} y={L.py[0] - 20}>{t.y}</text>
        <path class="f-line f-muted f-dash" d={plot(trueP, 0, 9, sx, sy)} style="stroke-width: 1.2" />
        <path class="f-line f-blue" d={plot(fitP, 0, 9, sx, sy)} />
        {T.map((tt, i) => <circle cx={sx(Math.log2(tt))} cy={sy(wins[i] / runs)} r="3.4" style="fill: var(--fig-red); fill-opacity: 0.55" />)}
        <path class="f-line f-amber f-dash" d={`M ${sx(Math.log2(h50))} ${sy(0)} V ${sy(0.5)} H ${L.px[0]}`} style="stroke-width: 1.1" />
        <path class="f-line f-amber f-dash" d={`M ${sx(Math.log2(h80))} ${sy(0)} V ${sy(0.8)} H ${L.px[0]}`} style="stroke-width: 1.1" />
        <text class="f-small f-t-amber f-halo" x={sx(Math.log2(h50)) + 6} y={sy(0.06)}>{t.h50}</text>
        <text class="f-small f-t-amber f-halo" x={sx(Math.log2(h80)) - 6} y={sy(0.06)} text-anchor="end">{t.h80}</text>
        {[[t.fit, 'f-line f-blue', 'f-t-blue'], [t.truth, 'f-line f-muted f-dash', 'f-t-muted']].map(([label, cl, tc], i) => (
          <g>
            <path class={cl} d={narrow ? `M ${L.leg[0] + i * 130} ${L.leg[1] - 4} h 22` : `M ${L.leg[0]} ${L.leg[1] + i * L.leg[2] - 4} h 22`} />
            <text class={`f-small ${tc}`} x={narrow ? L.leg[0] + i * 130 + 30 : L.leg[0] + 30} y={narrow ? L.leg[1] : L.leg[1] + i * L.leg[2]}>{label}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
