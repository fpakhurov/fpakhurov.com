---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Retry until the tests pass, at most k attempts, with a perfect test as the verifier. For a task with one-attempt
// success p: success 1 - (1 - p)^k, expected attempts sum_{j<k} (1 - p)^j. Averaged over p ~ Beta(a, b), with
// E[(1 - p)^j] = prod_{i<j} (b + i)/(a + b + i). Two models: small, Beta(0.6, 0.9), $0.01 per attempt; large,
// Beta(1.2, 0.6), $0.10 per attempt. A configuration is on the Pareto front if no other one is at least as accurate
// and at most as expensive.
const fail = (a: number, b: number, j: number) => Array.from({ length: j }, (_, i) => (b + i) / (a + b + i)).reduce((x, y) => x * y, 1);
const ks = [1, 2, 4, 8, 16];
const models = [
  { key: 'small', a: 0.6, b: 0.9, price: 0.01, cls: 'f-red', txt: 'f-t-red', fill: 'var(--fig-red)' },
  { key: 'large', a: 1.2, b: 0.6, price: 0.10, cls: 'f-blue', txt: 'f-t-blue', fill: 'var(--fig-blue)' },
];
const pts = models.flatMap((m) => ks.map((k) => ({ m, k, acc: 1 - fail(m.a, m.b, k), cost: m.price * Array.from({ length: k }, (_, j) => fail(m.a, m.b, j)).reduce((x, y) => x + y, 0) })));
const onFront = (p: (typeof pts)[number]) => !pts.some((q) => q !== p && q.acc >= p.acc && q.cost <= p.cost);
const front = pts.filter(onFront).sort((x, y) => x.cost - y.cost);
const quoted = pts.map((p) => `${p.acc.toFixed(3)}/${p.cost.toFixed(3)}${onFront(p) ? '*' : ''}`).join(' ');
if (quoted !== '0.400/0.010* 0.544/0.016* 0.673/0.024* 0.774/0.036* 0.847/0.051* 0.667/0.100 0.810/0.133 0.902/0.165* 0.953/0.195* 0.979/0.221*')
  throw new Error(`CostFront: numbers drifted from the note (${quoted})`);

const t = ru
  ? { title: 'Доля решённых задач и стоимость: фронт Парето', x: 'ожидаемая стоимость задачи, $', y: 'доля решённых',
      small: 'малая модель, $0.01 за попытку', large: 'большая модель, $0.10 за попытку', front: 'фронт Парето',
      desc: 'Десять точек: две модели, у каждой от 1 до 16 попыток с повтором, пока тесты не пройдут. Малая модель дёшева: от 0.400 при $0.010 до 0.847 при $0.051. Большая модель с одной попыткой даёт 0.667 за $0.100 и с двумя 0.810 за $0.133; обе точки лежат под фронтом. Фронт проходит через все точки малой модели и через большую модель с 4, 8 и 16 попытками, до 0.979 за $0.221.' }
  : { title: 'Success rate against cost: the Pareto front', x: 'expected cost per task, $', y: 'success rate',
      small: 'small model, $0.01 per attempt', large: 'large model, $0.10 per attempt', front: 'Pareto front',
      desc: 'Ten points: two models, each with 1 to 16 attempts, retrying until the tests pass. The small model is cheap: from 0.400 at $0.010 to 0.847 at $0.051. The large model with one attempt gives 0.667 for $0.100 and with two 0.810 for $0.133; both points lie below the front. The front runs through every point of the small model and through the large model with 4, 8 and 16 attempts, up to 0.979 for $0.221.' };
const id = 'cost-front';
const caption = ru
  ? 'Агент повторяет попытку, пока тесты не пройдут, не больше k раз; тест считается безошибочным, попытки на одной задаче независимы. Доля решённых равна pass@k, стоимость — цене попытки, умноженной на ожидаемое число попыток. Большая модель с одной попыткой ($0.100, 0.667) проигрывает малой с четырьмя ($0.024, 0.673): она дороже и не точнее. Таблица результатов без стоимости поставила бы её выше; фронт показывает, что стоит выбирать при каждом бюджете.'
  : 'The agent retries until the tests pass, at most k times; the test is taken to be perfect, and attempts on one task are independent. The success rate is pass@k, and the cost is the price of an attempt times the expected number of attempts. The large model with one attempt ($0.100, 0.667) loses to the small one with four ($0.024, 0.673): it costs more and is no more accurate. A leaderboard without cost would rank it higher; the front shows what to choose at each budget.';

const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [70, 740] as [number, number], py: [40, 270] as [number, number], leg: [440, 206, 22] as [number, number, number] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 430, px: [52, 344] as [number, number], py: [40, 250] as [number, number], leg: [20, 326, 26] as [number, number, number] },
];
const yTicks = [0.4, 0.6, 0.8, 1.0], xTicks = [0, 0.05, 0.1, 0.15, 0.2];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sx = scale([0, 0.24], L.px), sy = scale([0.3, 1.0], [L.py[1], L.py[0]]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {yTicks.map((v) => <path class="f-grid" d={`M ${L.px[0]} ${sy(v)} H ${L.px[1]}`} />)}
        <path class="f-axis" d={`M ${L.px[0]} ${L.py[0] - 6} V ${L.py[1]} H ${L.px[1]}`} />
        {yTicks.map((v) => <text class="f-small" x={L.px[0] - 7} y={sy(v) + 4} text-anchor="end">{v.toFixed(1)}</text>)}
        {xTicks.map((v) => <text class="f-small" x={sx(v)} y={L.py[1] + 18} text-anchor="middle">{v.toFixed(2)}</text>)}
        <text class="f-small f-t-muted" x={(L.px[0] + L.px[1]) / 2} y={L.py[1] + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.px[0] - 40} y={L.py[0] - 20}>{t.y}</text>
        <path class="f-line f-amber" d={polyline(front.map((p) => [sx(p.cost), sy(p.acc)] as [number, number]))} style="stroke-width: 7; stroke-opacity: 0.3; stroke-linejoin: round" />
        {models.map((m) => {
          const mine = pts.filter((p) => p.m === m);
          return (
            <g>
              <path class={`f-line ${m.cls}`} d={polyline(mine.map((p) => [sx(p.cost), sy(p.acc)] as [number, number]))} style="stroke-width: 1.2" />
              {mine.map((p) => <circle cx={sx(p.cost)} cy={sy(p.acc)} r="4" style={`fill: ${onFront(p) ? m.fill : 'var(--paper)'}; stroke: ${m.fill}; stroke-width: 1.6`} />)}
              {mine.map((p) => <text class={`f-small ${m.txt} f-halo`} x={sx(p.cost) + 8} y={sy(p.acc) + 14}>{`k=${p.k}`}</text>)}
            </g>
          );
        })}
        {[[t.small, 'f-line f-red', 'f-t-red'], [t.large, 'f-line f-blue', 'f-t-blue'], [t.front, 'f-line f-amber', 'f-t-amber']].map(([label, cl, tc], i) => (
          <g>
            <path class={cl} d={`M ${L.leg[0]} ${L.leg[1] + i * L.leg[2] - 4} h 22`} style={i === 2 ? 'stroke-width: 7; stroke-opacity: 0.3' : ''} />
            <text class={`f-small ${tc}`} x={L.leg[0] + 30} y={L.leg[1] + i * L.leg[2]}>{label}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
