---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar, type Tone } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The call stack of print(factorial(3)) with
//   def factorial(n): return 1 if n == 0 else n * factorial(n - 1)
// Frames are pushed for n = 3, 2, 1, 0 on top of the module's frame, then each returns to the one below it.
const N = 3;
const fact = (n: number): number => (n === 0 ? 1 : n * fact(n - 1));
// returns[k] is what the frame for n = k hands back, from the base case up: 1, 1, 2, 6.
const returns = Array.from({ length: N + 1 }, (_, n) => fact(n));
if (returns.join() !== '1,1,2,6') throw new Error(`returns ${returns}`);

interface Frame { title: string; sub: string; tone: Tone }
// Bottom to top: the module, then n = 3, 2, 1, 0.
const frames: Frame[] = [
  { title: '<module>', sub: ru ? 'ждёт factorial(3)' : 'waits for factorial(3)', tone: 'x' },
  ...[3, 2, 1, 0].map((n) => ({
    title: `factorial(n=${n})`,
    sub: n === 0 ? (ru ? 'базовый случай: return 1' : 'base case: return 1') : (ru ? `ждёт factorial(${n - 1})` : `waits for factorial(${n - 1})`),
    tone: (n === 0 ? 'y' : 'h') as Tone,
  })),
];
// Return arrows, from the frame at level k (1 = n=3 ... 4 = n=0) down to level k - 1, in the order they happen.
const rets = [4, 3, 2, 1].map((level, i) => {
  const n = 4 - level;               // the n of the returning frame: 0, 1, 2, 3
  const value = returns[n];
  const expr = n === 0 ? `${value}` : `${n} × ${returns[n - 1]} = ${value}`;
  return { level, step: 6 + i, wide: (ru ? 'возвращает ' : 'returns ') + expr, narrow: expr };
});
if (rets[3].narrow !== '3 × 2 = 6') throw new Error('last return');
const steps = ru
  ? ['модуль вызывает factorial(3): новый кадр', 'кадр n = 3 вызывает factorial(2)', 'кадр n = 2 вызывает factorial(1)', 'кадр n = 1 вызывает factorial(0)', 'кадр n = 0: базовый случай, рекурсия останавливается', 'n = 0 возвращает 1; его кадр уничтожается', 'n = 1 вычисляет 1 × 1 и возвращает 1', 'n = 2 вычисляет 2 × 1 и возвращает 2', 'n = 3 вычисляет 3 × 2 и возвращает 6 модулю']
  : ['the module calls factorial(3): a new frame', 'the frame for n = 3 calls factorial(2)', 'the frame for n = 2 calls factorial(1)', 'the frame for n = 1 calls factorial(0)', 'the frame for n = 0: the base case stops the recursion', 'n = 0 returns 1, and its frame is discarded', 'n = 1 computes 1 × 1 and returns 1', 'n = 2 computes 2 × 1 and returns 2', 'n = 3 computes 3 × 2 and returns 6 to the module'];
const head = ru ? 'стек вызовов: новейший кадр сверху' : 'the call stack: the newest frame on top';

interface Layout { cls: string; W: number; H: number; x: number; w: number; h: number; y: (k: number) => number; labX: number; useWide: boolean; mono: number; sans: number; headY: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 360, x: 70, w: 330, h: 46, y: (k) => 296 - k * 60, labX: 470, useWide: true, mono: 7.5, sans: 6.5, headY: 26 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 410, x: 30, w: 220, h: 50, y: (k) => 344 - k * 66, labX: 290, useWide: false, mono: 8.4, sans: 7.3, headY: 30 },
];
for (const L of layouts) {
  for (const f of frames) {
    if (f.title.length * L.mono > L.w - 16 || f.sub.length * L.sans > L.w - 16) throw new Error(`"${f.title}" / "${f.sub}" overflows at ${L.W}`);
  }
  for (const r of rets) if (L.labX + (L.useWide ? r.wide : r.narrow).length * L.sans > L.W - 4) throw new Error(`label "${r.wide}" overflows at ${L.W}`);
  if (head.length * L.sans > L.W - 8) throw new Error('head overflows');
  if (L.y(4) - 18 < L.headY + 6) throw new Error('top frame hits the heading');
}
const id = 'call-stack';
---

<Figure
  id={id}
  title={ru ? 'Стек вызовов factorial(3)' : 'The call stack of factorial(3)'}
  caption={ru
    ? 'Каждый вызов функции получает собственный кадр с собственными локальными переменными; кадры образуют стек, новейший сверху. factorial(3) вызывает factorial(2), тот — factorial(1), тот — factorial(0) (шаги 1–5): четыре кадра функции, у каждого своё n. Базовый случай n = 0 возвращает 1 без вызова (6), и стек разворачивается: каждый кадр умножает своё n на полученное значение и возвращает результат кадру под ним (7–9), после чего уничтожается. Модуль получает 6.'
    : 'Each call of a function gets its own frame with its own local variables; the frames form a stack, the newest on top. factorial(3) calls factorial(2), which calls factorial(1), which calls factorial(0) (steps 1–5): four frames of one function, each with its own n. The base case n = 0 returns 1 without calling (6), and the stack unwinds: each frame multiplies its n by the value it receives and returns the result to the frame below (7–9), and is then discarded. The module receives 6.'}
>
  {layouts.map((L) => {
    const cy = (k: number) => L.y(k) + L.h / 2;
    const xr = L.x + L.w;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Кадры рекурсивного вычисления факториала' : 'The frames of a recursive factorial'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Пять прямоугольников друг над другом: внизу кадр модуля, выше кадры factorial для n = 3, 2, 1 и 0. Справа изогнутые стрелки от каждого кадра к кадру под ним с возвращаемыми значениями 1, 1, 2 и 6.'
          : 'Five rectangles stacked: at the bottom the module frame, above it the frames of factorial for n = 3, 2, 1 and 0. On the right, curved arrows from each frame to the one below, labelled with the returned values 1, 1, 2 and 6.'}</desc>
        <text class="f-small f-t-muted" x={L.x - 22} y={L.headY} style="font-weight: 650">{head}</text>
        {frames.map((f, k) => (
          <g data-s={String(k + 1)}>
            <rect x={L.x} y={L.y(k)} width={L.w} height={L.h} rx="6" style={`fill: ${toneVar[f.tone]}; fill-opacity: 0.12; stroke: ${toneVar[f.tone]}; stroke-width: 1.3`} />
            <text class="f-small" x={L.x + 10} y={L.y(k) + 19} style="font-family: var(--mono); font-weight: 650">{f.title}</text>
            <text class="f-small f-t-muted" x={L.x + 10} y={L.y(k) + 37}>{f.sub}</text>
            <Badge x={L.x - 12} y={L.y(k)} n={k + 1} />
          </g>
        ))}
        {rets.map((r) => {
          const y1 = cy(r.level) + 4, y2 = cy(r.level - 1) - 4;
          const bulge = xr + (L.useWide ? 46 : 22);
          return (
            <g data-s={String(r.step)}>
              <path class="f-line f-red" d={`M ${xr + 3} ${y1} C ${bulge} ${y1}, ${bulge} ${y2}, ${xr + 5} ${y2}`} marker-end="url(#f-arrow-red)" />
              <text class="f-small f-t-red f-halo" x={L.labX} y={(y1 + y2) / 2 + 5}>{L.useWide ? r.wide : r.narrow}</text>
              <Badge x={L.labX - 14} y={(y1 + y2) / 2} n={r.step} />
            </g>
          );
        })}
      </svg>
    );
  })}
  <Stepper steps={steps} />
</Figure>
