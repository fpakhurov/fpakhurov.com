---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import NewMark from '../seqflow/NewMark.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The two worked examples of the note. PPO: four tokens with log-ratios 0.2, −0.1, 0.5, 0 against the reference,
// β = 0.1, a reward-model score of 1.0, value predictions 0.6, 0.5, 0.7, 0.9, γ = 1, λ = 0.95.
// GRPO: six responses with verifier rewards 1, 0, 0, 1, 0, 0.
const logRatio = [0.2, -0.1, 0.5, 0.0], beta = 0.1, score = 1.0, V = [0.6, 0.5, 0.7, 0.9, 0];
const rew = logRatio.map((l, i) => -beta * l + (i === 3 ? score : 0));
const delta = rew.map((r, i) => r + V[i + 1] - V[i]);
const adv = [0, 0, 0, 0];
for (let i = 3, g = 0; i >= 0; i -= 1) { g = delta[i] + 0.95 * g; adv[i] = g; }
const mn = (v: number, d = 2) => v.toFixed(d).replace('-', '−');
if (adv.map((v) => v.toFixed(3)).join(' ') !== '0.301 0.443 0.245 0.100') throw new Error('PpoVsGrpo: the PPO example drifted');
const r = [1, 0, 0, 1, 0, 0];
const mean = r.reduce((a, b) => a + b, 0) / r.length;
const std = Math.sqrt(r.reduce((a, b) => a + (b - mean) ** 2, 0) / r.length);
const aPos = (1 - mean) / std, aNeg = (0 - mean) / std;
if (aPos.toFixed(3) !== '1.414' || aNeg.toFixed(3) !== '-0.707') throw new Error('PpoVsGrpo: the GRPO example drifted');

const rewS = rew.map((v) => mn(v)).join(', ');
const advS = adv.map((v) => mn(v)).join(' ');
const t = ru
  ? {
      title: 'PPO и GRPO для языковой модели',
      ppo: 'PPO: модель вознаграждения и голова ценности', grpo: 'GRPO: группа ответов вместо критика',
      policy: 'стратегия π_θ', pSub1: 'один ответ', resp: 'ответ y', respSub: '4 токена',
      ref: 'эталонная модель π_ref', refSub: 'log-отношения 0.2, −0.1, 0.5, 0', rm: 'модель вознаграждения r_φ', rmSub: 'одна оценка: 1.0 в конце',
      tok: 'награды токенов r_t', tokSub: rewS, val: 'голова ценности V_ψ', valSub: 'V = 0.6, 0.5, 0.7, 0.9',
      gae: 'GAE: Â_t', gaeSub: advS, step: 'шаг с обрезкой',
      pSub2: 'G = 6 ответов', resps: 'y_1, …, y_6', respsSub: 'один и тот же промпт', ver: 'верификатор', verSub: 'r = 1, 0, 0, 1, 0, 0',
      grp: 'среднее и std группы', grpSub: `среднее ${mean.toFixed(2)}, std ${std.toFixed(2)}`, mark: 'вместо головы ценности',
      advs: 'преимущества Â_i', advsSub: `+${aPos.toFixed(2)} или ${mn(aNeg)} на токен`, loss: 'функция потерь с KL', lossSub: 'β (u − log u − 1)',
      steps: ['сэмплирование: один ответ для PPO, группа из G ответов для GRPO', 'оценка: модель вознаграждения и log-отношения к эталонной модели; в GRPO — награда каждого ответа группы', `PPO: награды токенов, −β, умноженное на log-отношение, плюс оценка в конце: ${rewS}`, 'PPO: голова ценности предсказывает ценность каждого префикса', `преимущества: GAE вдоль ответа (${advS}) или стандартизация внутри группы (+${aPos.toFixed(2)}, ${mn(aNeg)})`, 'обновление: шаги градиента по стратегии с обрезкой; GRPO добавляет оценку KL в функцию потерь'],
      desc: `Две строки блоков. Сверху PPO: стратегия пишет один ответ из 4 токенов; эталонная модель даёт log-отношения 0.2, −0.1, 0.5, 0, модель вознаграждения — одну оценку 1.0; из них получаются награды токенов ${rewS}; голова ценности предсказывает 0.6, 0.5, 0.7, 0.9, а GAE даёт преимущества ${advS}, которые идут в шаг стратегии. Снизу GRPO: стратегия пишет 6 ответов, верификатор ставит 1, 0, 0, 1, 0, 0, среднее и стандартное отклонение группы (${mean.toFixed(2)} и ${std.toFixed(2)}) заменяют голову ценности, и каждый токен верного ответа получает +${aPos.toFixed(2)}, неверного ${mn(aNeg)}; функция потерь содержит штраф KL.`,
    }
  : {
      title: 'PPO and GRPO for a language model',
      ppo: 'PPO: a reward model and a value head', grpo: 'GRPO: a group of responses instead of a critic',
      policy: 'policy π_θ', pSub1: 'one response', resp: 'response y', respSub: '4 tokens',
      ref: 'reference π_ref', refSub: 'log-ratios 0.2, −0.1, 0.5, 0', rm: 'reward model r_φ', rmSub: 'one score: 1.0 at the end',
      tok: 'token rewards r_t', tokSub: rewS, val: 'value head V_ψ', valSub: 'V = 0.6, 0.5, 0.7, 0.9',
      gae: 'GAE: Â_t', gaeSub: advS, step: 'clipped step',
      pSub2: 'G = 6 responses', resps: 'y_1, …, y_6', respsSub: 'the same prompt', ver: 'verifier', verSub: 'r = 1, 0, 0, 1, 0, 0',
      grp: 'group mean and std', grpSub: `mean ${mean.toFixed(2)}, std ${std.toFixed(2)}`, mark: 'replaces the value head',
      advs: 'advantages Â_i', advsSub: `+${aPos.toFixed(2)} or ${mn(aNeg)}, every token`, loss: 'loss with a KL term', lossSub: 'β (u − log u − 1)',
      steps: ['sample: one response for PPO, a group of G for GRPO', 'score: a reward model and the log-ratios to the reference; for GRPO, a reward for each response of the group', `PPO: token rewards, −β times the log-ratio plus the score at the end: ${rewS}`, 'PPO: the value head predicts the value of every prefix', `advantages: GAE along the response (${advS}), or standardized within the group (+${aPos.toFixed(2)}, ${mn(aNeg)})`, 'update: clipped policy-gradient steps; GRPO adds the KL estimate to the loss'],
      desc: `Two rows of blocks. Top, PPO: the policy writes one response of 4 tokens; the reference model gives log-ratios 0.2, −0.1, 0.5, 0 and the reward model one score of 1.0; together they give the token rewards ${rewS}; the value head predicts 0.6, 0.5, 0.7, 0.9, and GAE turns these into the advantages ${advS}, which feed the policy's step. Bottom, GRPO: the policy writes 6 responses, a verifier scores them 1, 0, 0, 1, 0, 0, the group's mean and standard deviation (${mean.toFixed(2)} and ${std.toFixed(2)}) replace the value head, and every token of a correct response gets +${aPos.toFixed(2)}, of a wrong one ${mn(aNeg)}; the loss carries the KL term.`,
    };
if (t.steps.length !== 6) throw new Error('PpoVsGrpo: the note lists six steps');
const id = 'ppo-vs-grpo';
const caption = ru
  ? 'Числа — разобранные примеры из текста. В PPO модель вознаграждения выдаёт одно число на весь ответ, а то, как это число делится между токенами, решает голова ценности — модель размером со стратегию. GRPO её убирает: базовая линия — средняя награда группы ответов на тот же промпт, и все токены ответа получают одно и то же преимущество. Штраф KL в PPO входит в награду каждого токена, в GRPO — в функцию потерь.'
  : 'The numbers are the worked examples of the text. In PPO the reward model gives one number for the whole response, and the value head, a model the size of the policy, decides how that number is shared among the tokens. GRPO removes it: the baseline is the mean reward of a group of responses to the same prompt, and every token of a response gets the same advantage. PPO charges the KL penalty in every token\'s reward; GRPO puts it in the loss.';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 400" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <text class="f-label" x="16" y="22">{t.ppo}</text>
    <Box x={16} y={36} w={124} h={50} label={t.policy} sub={t.pSub1} tone="y" />
    <g data-s="1">
      <Arrow pts={[[140, 61], [160, 61]]} tone="red" />
      <Box x={162} y={36} w={120} h={50} label={t.resp} sub={t.respSub} tone="x" />
      <Badge x={150} y={42} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[282, 61], [304, 61]]} tone="green" />
      <Box x={306} y={36} w={210} h={50} label={t.ref} sub={t.refSub} />
      <Arrow pts={[[222, 36], [222, 30], [638, 30], [638, 35]]} tone="green" />
      <Box x={532} y={36} w={212} h={50} label={t.rm} sub={t.rmSub} tone="g" />
      <Badge x={523} y={42} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[411, 86], [411, 100], [480, 100], [480, 114]]} />
      <Arrow pts={[[638, 86], [638, 100], [580, 100], [580, 114]]} tone="amber" />
      <Box x={420} y={116} w={210} h={50} label={t.tok} sub={t.tokSub} tone="g" />
      <Badge x={646} y={128} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[420, 141], [340, 141]]} />
      <Box x={170} y={116} w={168} h={50} label={t.val} sub={t.valSub} tone="h" />
      <Badge x={380} y={128} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[170, 141], [156, 141]]} tone="blue" />
      <Box x={16} y={116} w={138} h={50} label={t.gae} sub={t.gaeSub} tone="g" />
      <Badge x={163} y={174} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[78, 116], [78, 88]]} tone="red" />
      <text class="f-small f-t-red f-halo" x="86" y="106">{t.step}</text>
      <Badge x={60} y={102} n={6} />
    </g>

    <path class="f-grid" d="M 16 194 H 744" />
    <text class="f-label" x="16" y="222">{t.grpo}</text>
    <Box x={16} y={236} w={124} h={50} label={t.policy} sub={t.pSub2} tone="y" />
    <g data-s="1">
      <Arrow pts={[[140, 261], [160, 261]]} tone="red" />
      <Box x={162} y={236} w={170} h={50} label={t.resps} sub={t.respsSub} tone="x" />
      <Badge x={150} y={242} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[332, 261], [352, 261]]} tone="green" />
      <Box x={354} y={236} w={170} h={50} label={t.ver} sub={t.verSub} tone="g" />
      <Badge x={342} y={242} n={2} />
    </g>
    <g data-s="5">
      <Arrow pts={[[524, 261], [546, 261]]} tone="amber" />
      <NewMark x={542} y={230} w={208} h={62} label={t.mark} at="tr" />
      <Box x={548} y={236} w={196} h={50} label={t.grp} sub={t.grpSub} tone="h" />
      <Arrow pts={[[646, 286], [646, 314]]} tone="blue" />
      <Box x={548} y={316} w={196} h={50} label={t.advs} sub={t.advsSub} tone="g" />
      <Badge x={530} y={300} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[548, 341], [340, 341]]} tone="amber" />
      <Box x={162} y={316} w={176} h={50} label={t.loss} sub={t.lossSub} />
      <Arrow pts={[[162, 341], [78, 341], [78, 288]]} tone="red" />
      <text class="f-small f-t-red f-halo" x="86" y="312">{t.step}</text>
      <Badge x={60} y={314} n={6} />
    </g>
  </svg>

  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 950" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <text class="f-small f-t-muted" x="16" y="20">PPO</text>
    <Box x={16} y={30} w={300} h={46} label={t.policy} sub={t.pSub1} tone="y" />
    <g data-s="1">
      <Arrow pts={[[166, 76], [166, 96]]} tone="red" />
      <Box x={16} y={98} w={300} h={46} label={t.resp} sub={t.respSub} tone="x" />
      <Badge x={190} y={87} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[166, 144], [166, 164]]} tone="green" />
      <Box x={16} y={166} w={300} h={46} label={t.ref} sub={t.refSub} />
      <Badge x={190} y={155} n={2} />
      <Arrow pts={[[166, 212], [166, 232]]} />
      <Box x={16} y={234} w={300} h={46} label={t.rm} sub={t.rmSub} tone="g" />
    </g>
    <g data-s="3">
      <Arrow pts={[[166, 280], [166, 300]]} tone="amber" />
      <Box x={16} y={302} w={300} h={46} label={t.tok} sub={t.tokSub} tone="g" />
      <Badge x={190} y={291} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[166, 348], [166, 368]]} />
      <Box x={16} y={370} w={300} h={46} label={t.val} sub={t.valSub} tone="h" />
      <Badge x={190} y={359} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[166, 416], [166, 436]]} tone="blue" />
      <Box x={16} y={438} w={300} h={46} label={t.gae} sub={t.gaeSub} tone="g" />
      <Badge x={190} y={427} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[316, 461], [340, 461], [340, 53], [318, 53]]} tone="red" />
      <Badge x={340} y={250} n={6} />
    </g>

    <path class="f-grid" d="M 16 500 H 344" />
    <text class="f-small f-t-muted" x="16" y="524">GRPO</text>
    <Box x={16} y={534} w={300} h={46} label={t.policy} sub={t.pSub2} tone="y" />
    <g data-s="1">
      <Arrow pts={[[166, 580], [166, 600]]} tone="red" />
      <Box x={16} y={602} w={300} h={46} label={t.resps} sub={t.respsSub} tone="x" />
      <Badge x={190} y={591} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[166, 648], [166, 668]]} tone="green" />
      <Box x={16} y={670} w={300} h={46} label={t.ver} sub={t.verSub} tone="g" />
      <Badge x={190} y={659} n={2} />
    </g>
    <g data-s="5">
      <Arrow pts={[[166, 716], [166, 736]]} tone="amber" />
      <NewMark x={10} y={732} w={312} h={58} label={t.mark} at="bl" />
      <Box x={16} y={738} w={300} h={46} label={t.grp} sub={t.grpSub} tone="h" />
      <Arrow pts={[[290, 784], [290, 818]]} tone="blue" />
      <Box x={16} y={820} w={300} h={46} label={t.advs} sub={t.advsSub} tone="g" />
      <Badge x={262} y={806} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[166, 866], [166, 886]]} tone="amber" />
      <Box x={16} y={888} w={300} h={46} label={t.loss} sub={t.lossSub} />
      <Arrow pts={[[316, 911], [340, 911], [340, 557], [318, 557]]} tone="red" />
      <Badge x={340} y={740} n={6} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
