---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { bestOfN } from './rl';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Best-of-n against a proxy reward, computed exactly: 98% honest responses (gold g ~ N(0, 1), proxy g + N(0, 0.25)),
// 2% exploits (gold −1, proxy N(0, 4)). The x-axis is the KL divergence of best-of-n from the policy, log n − (n − 1)/n.
const ns = [...new Set([...Array.from({ length: 29 }, (_, k) => Math.round(2 ** (k / 2))), 96])].sort((a, b) => a - b);
const rows = bestOfN(ns);
const at = (n: number) => rows.find((r) => r.n === n)!;
const quoted = [at(1).gold, at(96).gold, at(128).gold, at(16384).gold, at(16384).proxy].map((v) => v.toFixed(3)).join(' ');
if (quoted !== '-0.020 1.747 1.737 -0.835 5.820') throw new Error(`Overoptimization: numbers drifted from the note (${quoted})`);
const best = rows.reduce((a, b) => (b.gold > a.gold ? b : a));
if (best.gold - at(96).gold > 0.001) throw new Error(`Overoptimization: the gold peak moved to n = ${best.n}`);
const peak = at(96);

const t = ru
  ? { title: 'Переоптимизация: best-of-n против суррогатной награды', x: 'KL best-of-n относительно стратегии, наты', y: 'средняя награда',
      proxy: 'суррогатная', gold: 'истинная', peak: 'пик около n = 96',
      desc: `Две кривые в зависимости от KL-дивергенции best-of-n относительно стратегии, из которой он сэмплирует, от 0 до 8.7 ната (n от 1 до 16384). Суррогатная награда выбранного ответа растёт всё время, до ${at(16384).proxy.toFixed(2)}. Истинная награда растёт от −0.02 до пика ${at(96).gold.toFixed(3)} около n = 96 (KL 3.57) и падает до ${at(16384).gold.toFixed(3)} при n = 16384.` }
  : { title: 'Overoptimization: best-of-n against a proxy reward', x: 'KL of best-of-n from the policy, nats', y: 'mean reward',
      proxy: 'proxy', gold: 'gold', peak: 'peak near n = 96',
      desc: `Two curves against the KL divergence of best-of-n from the policy it samples, from 0 to 8.7 nats (n from 1 to 16384). The proxy reward of the selected response rises throughout, to ${at(16384).proxy.toFixed(2)}. The gold reward rises from −0.02 to a peak of ${at(96).gold.toFixed(3)} near n = 96 (KL 3.57) and falls to ${at(16384).gold.toFixed(3)} at n = 16384.` };
const id = 'overoptimization';
const caption = ru
  ? `Точное вычисление по плотности выбранной оценки. У 98% ответов истинное качество g ~ N(0, 1), а суррогатная оценка g + N(0, 0.5²); 2% — эксплойты с истинным качеством −1 и суррогатной оценкой N(0, 2²), которую суррогат не отличает от хорошей. Подписи сверху — число сэмплов n. Пока сэмплов мало, лучший по суррогату ответ почти всегда честный и хороший; когда их тысячи, верх суррогатных оценок занимают эксплойты. Форма — рост, пик и спад, пока суррогатная оценка растёт, — та же, что в измерениях Gao, Schulman и Hilton.`
  : `Computed exactly from the density of the selected score. 98 % of responses have gold quality g ~ N(0, 1) and a proxy score g + N(0, 0.5²); 2 % are exploits with gold quality −1 and a proxy score N(0, 2²) that the proxy cannot tell from a good one. The labels along the top give the number of samples n. With few samples the best-scored response is almost always an honest good one; with thousands, exploits take the top of the proxy scores. The shape, a rise, a peak and a fall while the proxy keeps rising, is the one Gao, Schulman and Hilton measured.`;
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [64, 590] as [number, number], py: [44, 270] as [number, number], wide: true },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 400, px: [52, 340] as [number, number], py: [44, 290] as [number, number], wide: false },
];
const yTicks = [-1, 0, 1, 2, 3, 4, 5, 6], xTicks = [0, 2, 4, 6, 8];
const nLabels = [16, 128, 1024, 16384];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sx = scale([0, 9], L.px), sy = scale([-1, 6], [L.py[1], L.py[0]]);
    const gold = polyline(rows.map((r) => [sx(r.kl), sy(r.gold)] as [number, number]));
    const proxy = polyline(rows.map((r) => [sx(r.kl), sy(r.proxy)] as [number, number]));
    const last = rows[rows.length - 1];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {yTicks.map((v) => <path class="f-grid" d={`M ${L.px[0]} ${sy(v)} H ${L.px[1]}`} />)}
        <path class="f-axis" d={`M ${L.px[0]} ${L.py[0] - 6} V ${L.py[1]} H ${L.px[1]}`} />
        <path class="f-line f-dash" d={`M ${L.px[0]} ${sy(0)} H ${L.px[1]}`} />
        {yTicks.map((v) => <text class="f-small" x={L.px[0] - 7} y={sy(v) + 4} text-anchor="end">{String(v)}</text>)}
        {xTicks.map((v) => <text class="f-small" x={sx(v)} y={L.py[1] + 18} text-anchor="middle">{String(v)}</text>)}
        {nLabels.map((n) => <text class="f-small f-t-muted" x={sx(at(n).kl)} y={L.py[0] - 10} text-anchor="middle">{`n=${n}`}</text>)}
        {nLabels.map((n) => <path class="f-grid" d={`M ${sx(at(n).kl)} ${L.py[0] - 4} V ${L.py[1]}`} />)}
        <text class="f-small f-t-muted" x={(L.px[0] + L.px[1]) / 2} y={L.py[1] + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.px[0] - 40} y={L.py[0] - 28}>{t.y}</text>
        <path class="f-line f-blue" d={proxy} />
        <path class="f-line f-red" d={gold} />
        <circle cx={sx(peak.kl)} cy={sy(peak.gold)} r="4" class="f-solid-red" />
        <text class="f-small f-t-red f-halo" x={sx(peak.kl)} y={sy(peak.gold) + 20} text-anchor="middle">{t.peak}</text>
        {L.wide
          ? [
              <text class="f-small f-t-blue" x={L.px[1] + 8} y={sy(last.proxy) + 4}>{t.proxy}</text>,
              <text class="f-small f-t-red" x={L.px[1] + 8} y={sy(last.gold) + 4}>{t.gold}</text>,
            ]
          : [
              <path class="f-line f-blue" d={`M ${L.px[0]} ${L.py[1] + 62} h 22`} />,
              <text class="f-small f-t-blue" x={L.px[0] + 30} y={L.py[1] + 66}>{t.proxy}</text>,
              <path class="f-line f-red" d={`M ${L.px[0] + 140} ${L.py[1] + 62} h 22`} />,
              <text class="f-small f-t-red" x={L.px[0] + 170} y={L.py[1] + 66}>{t.gold}</text>,
            ]}
      </svg>
    );
  })}
</Figure>
