---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Share of traffic served by version 2 over a schematic time axis 0..T, as piecewise-constant segments.
// A segment with down: true serves nothing (no capacity).
interface Seg { t0: number; t1: number; v2: number; down?: boolean }
interface Row { name: string; undo: string; segs: Seg[]; idle?: { t0: number; t1: number; v: 1 | 2; label: string }[]; checks?: number[] }
const T = 10;
const rows: Row[] = [
  {
    name: ru ? 'Пересоздание' : 'Recreate', undo: ru ? 'откат: пересоздать v1' : 'undo: recreate v1',
    segs: [{ t0: 0, t1: 3, v2: 0 }, { t0: 3, t1: 4.5, v2: 0, down: true }, { t0: 4.5, t1: T, v2: 1 }],
  },
  {
    name: ru ? 'Поэтапное' : 'Rolling', undo: ru ? 'откат: обновить обратно' : 'undo: roll back',
    segs: [{ t0: 0, t1: 3, v2: 0 }, { t0: 3, t1: 4, v2: 0.25 }, { t0: 4, t1: 5, v2: 0.5 }, { t0: 5, t1: 6, v2: 0.75 }, { t0: 6, t1: T, v2: 1 }],
  },
  {
    name: ru ? 'Сине-зелёное' : 'Blue-green', undo: ru ? 'откат: переключить назад' : 'undo: switch back',
    segs: [{ t0: 0, t1: 5, v2: 0 }, { t0: 5, t1: T, v2: 1 }],
    idle: [{ t0: 2, t1: 5, v: 2, label: ru ? 'v2 ждёт' : 'v2 idle' }, { t0: 5, t1: 8, v: 1, label: ru ? 'v1 ждёт' : 'v1 idle' }],
  },
  {
    name: ru ? 'Канареечное' : 'Canary', undo: ru ? 'откат: снять канарейку' : 'undo: abort the canary',
    segs: [{ t0: 0, t1: 3, v2: 0 }, { t0: 3, t1: 5, v2: 0.05 }, { t0: 5, t1: 6.5, v2: 0.25 }, { t0: 6.5, t1: 8, v2: 0.5 }, { t0: 8, t1: T, v2: 1 }],
    checks: [5, 6.5, 8],
  },
];
for (const r of rows) {
  r.segs.forEach((s, i) => {
    if (s.v2 < 0 || s.v2 > 1 || s.t1 <= s.t0) throw new Error(`bad segment in ${r.name}`);
    if (i === 0 ? s.t0 !== 0 : s.t0 !== r.segs[i - 1].t1) throw new Error(`gap in ${r.name}`);
  });
  if (r.segs[r.segs.length - 1].t1 !== T) throw new Error(`${r.name} does not reach T`);
  if (r.segs[0].v2 !== 0 || r.segs[r.segs.length - 1].v2 !== 1) throw new Error(`${r.name} must go from v1 to v2`);
}
// The canary's first step is 5% of traffic, as in the text.
if (rows[3].segs[1].v2 !== 0.05) throw new Error('canary first step');

const downLabel = ru ? 'простой' : 'down';
const checksLabel = ru ? 'проверки' : 'checks';
const timeLabel = ru ? 'время →' : 'time →';
const legend: [string, string][] = ru
  ? [['v1', 'v1'], ['v2', 'v2'], ['down', 'нет сервиса'], ['idle', 'простаивает']]
  : [['v1', 'v1'], ['v2', 'v2'], ['down', 'no service'], ['idle', 'idle']];
const steps = ru
  ? ['пересоздание: v1 остановлена, затем запущена v2; между ними сервис не работает', 'поэтапное: экземпляры заменяются партиями, доля v2 растёт ступенями, обе версии работают', 'сине-зелёное: v2 работает рядом и получает весь трафик одним переключением; v1 ждёт для отката', 'канареечное: v2 получает 5%, затем 25% и 50% после проверок; плохая канарейка снимается, пока у неё мало трафика']
  : ['recreate: v1 is stopped, then v2 started; between the two nothing serves', 'rolling: instances are replaced in batches, the share of v2 climbs in steps, both versions serve', 'blue-green: v2 runs alongside and takes all traffic at one switch; v1 stays idle for a rollback', 'canary: v2 gets 5%, then 25% and 50% after checks; a bad canary is stopped while its share is small'];

interface Layout {
  cls: string; W: number; H: number; px0: number; px1: number; top: number; pitch: number; head: number; plotH: number; stripH: number;
  sans: number; label: number; wide: boolean; legendY: number;
}
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 360, px0: 210, px1: 744, top: 36, pitch: 78, head: 0, plotH: 44, stripH: 18, sans: 6.5, label: 7.5, wide: true, legendY: 16 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 432, px0: 12, px1: 348, top: 40, pitch: 92, head: 24, plotH: 40, stripH: 18, sans: 7.3, label: 7.9, wide: false, legendY: 18 },
];
const legendXs = (L: Layout) => {
  const xs: number[] = [];
  let x = L.wide ? L.px0 : 12;
  for (const [, t] of legend) { xs.push(x); x += 20 + t.length * L.sans + 16; }
  return xs;
};
for (const L of layouts) {
  const xs = legendXs(L);
  if (xs[xs.length - 1] + 20 + legend[legend.length - 1][1].length * L.sans > L.W - 4) throw new Error(`legend at ${L.W}`);
  const sx = (t: number) => L.px0 + (t / T) * (L.px1 - L.px0);
  for (const r of rows) {
    if (L.wide) {
      if (38 + r.name.length * L.label > L.px0 - 8 || 38 + r.undo.length * L.sans > L.px0 - 8) throw new Error(`label of ${r.name} at ${L.W}`);
    } else if (34 + r.name.length * L.label + 16 + r.undo.length * L.sans > L.W - 8) throw new Error(`header of ${r.name} at ${L.W}`);
    for (const s of r.segs) if (s.down && downLabel.length * L.sans > sx(s.t1) - sx(s.t0) + 30) throw new Error('down label');
    for (const i of r.idle ?? []) {
      const w = i.label.length * L.sans;
      if (i.v === 2 ? sx(i.t0) - 6 - w < L.px0 - (L.wide ? 0 : 2) : sx(i.t1) + 6 + w > L.W - 4) throw new Error(`idle label at ${L.W}`);
    }
    if (r.checks && sx(r.checks[0]) - 8 - checksLabel.length * L.sans < sx(r.segs[1].t0) - 4) throw new Error(`checks label at ${L.W}`);
  }
}
const tone = { v1: 'var(--fig-blue)', v2: 'var(--fig-green)', down: 'var(--fig-red)', idle: 'var(--muted)' } as Record<string, string>;
const id = 'deploy-strategies';
---

<Figure
  id={id}
  title={ru ? 'Четыре стратегии развёртывания: доля трафика у каждой версии во времени' : 'Four deployment strategies: the share of traffic on each version over time'}
  caption={ru
    ? 'Схема, ось времени условная. Высота полосы — весь трафик сервиса; синее — доля, которую обслуживает версия 1, зелёное — версия 2. При пересоздании (1) между остановкой v1 и запуском v2 сервис не работает. При поэтапном обновлении (2) доля v2 растёт ступенями по 25%, и всё это время работают обе версии. При сине-зелёном (3) v2 заранее запущена рядом и простаивает, весь трафик переходит на неё одним переключением, а v1 ещё какое-то время ждёт, чтобы на неё можно было переключиться обратно. Канарейка (4) получает 5% трафика, затем 25% и 50%, и каждая ступень начинается только после проверки её метрик; плохую канарейку снимают, пока у неё 5%. Слева — как откатить каждую стратегию.'
    : 'A schematic; the time axis has no units. The height of each band is all of the traffic of the service; blue is the share served by version 1, green by version 2. With recreate (1), nothing serves between stopping v1 and starting v2. With a rolling update (2), the share of v2 climbs in steps of 25%, and both versions serve throughout. With blue-green (3), v2 is started beside v1 in advance and stays idle, all traffic moves to it at one switch, and v1 waits for a while so that traffic can be switched back. A canary (4) gets 5% of traffic, then 25% and 50%, each step starting only after its metrics were checked; a bad canary is stopped while it has 5%. The left column says how each strategy is undone.'}
>
  {layouts.map((L) => {
    const sx = (t: number) => L.px0 + (t / T) * (L.px1 - L.px0);
    const xs = legendXs(L);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Стратегии развёртывания во времени' : 'Deployment strategies over time'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Четыре полосы: пересоздание с промежутком без сервиса, поэтапное обновление со ступенями доли v2 по 25%, сине-зелёное с мгновенным переключением и ожидающей v1, канареечное со ступенями 5%, 25%, 50% и 100% после проверок.'
          : 'Four bands: recreate with a gap of no service, a rolling update with the share of v2 rising in steps of 25%, blue-green with an instant switch and an idle v1 kept for rollback, and a canary with steps of 5%, 25%, 50% and 100% after checks.'}</desc>
        {legend.map(([k, t], i) => (
          <g>
            <rect x={xs[i]} y={L.legendY - 10} width="14" height="12" rx="2" style={k === 'idle' ? 'fill: none; stroke: var(--muted); stroke-width: 1.3; stroke-dasharray: 3 2' : `fill: ${tone[k]}; fill-opacity: ${k === 'down' ? 0.18 : 0.35}; stroke: ${tone[k]}; stroke-width: 1.2`} />
            <text class="f-small f-t-muted" x={xs[i] + 20} y={L.legendY}>{t}</text>
          </g>
        ))}
        {rows.map((r, ri) => {
          const y0 = L.top + ri * L.pitch + L.head, yb = y0 + L.plotH, ys = yb + 4;
          return (
            <g data-s={String(ri + 1)}>
              {L.wide
                ? <g>
                    <Badge x={20} y={y0 + 12} n={ri + 1} />
                    <text class="f-label" x={38} y={y0 + 17} style="font-weight: 650">{r.name}</text>
                    <text class="f-small f-t-muted" x={38} y={y0 + 36}>{r.undo}</text>
                  </g>
                : <g>
                    <Badge x={20} y={y0 - 14} n={ri + 1} />
                    <text class="f-small" x={34} y={y0 - 9} style="font-weight: 650">{r.name}</text>
                    <text class="f-small f-t-muted" x={L.W - 8} y={y0 - 9} text-anchor="end">{r.undo}</text>
                  </g>}
              {r.segs.map((s) => {
                const x = sx(s.t0), w = sx(s.t1) - sx(s.t0), h2 = s.v2 * L.plotH;
                return s.down
                  ? <g>
                      <rect x={x} y={y0} width={w} height={L.plotH} style="fill: var(--fig-red); fill-opacity: 0.12; stroke: var(--fig-red); stroke-width: 1; stroke-dasharray: 4 3" />
                      <text class="f-small f-t-red" x={x + w / 2} y={ys + 11} text-anchor="middle" style="font-weight: 650">{downLabel}</text>
                    </g>
                  : <g>
                      <rect x={x} y={y0} width={w} height={L.plotH - h2} style="fill: var(--fig-blue); fill-opacity: 0.32" />
                      <rect x={x} y={yb - h2} width={w} height={h2} style="fill: var(--fig-green); fill-opacity: 0.45" />
                    </g>;
              })}
              <rect x={L.px0} y={y0} width={L.px1 - L.px0} height={L.plotH} style="fill: none; stroke: var(--line); stroke-width: 1" />
              {(r.idle ?? []).map((i) => (
                <g>
                  <rect x={sx(i.t0)} y={ys} width={sx(i.t1) - sx(i.t0)} height={10} rx="2" style={`fill: none; stroke: ${i.v === 1 ? 'var(--fig-blue)' : 'var(--fig-green)'}; stroke-width: 1.4; stroke-dasharray: 4 3`} />
                  <text class="f-small f-t-muted" x={i.v === 2 ? sx(i.t0) - 6 : sx(i.t1) + 6} y={ys + 9} text-anchor={i.v === 2 ? 'end' : 'start'}>{i.label}</text>
                </g>
              ))}
              {(r.checks ?? []).map((t, k) => (
                <g>
                  <path d={`M ${sx(t)} ${ys} l 5 6 l -5 6 l -5 -6 Z`} style="fill: var(--fig-amber); stroke: var(--fig-amber); stroke-width: 1" />
                  {k === 0 && <text class="f-small f-t-amber" x={sx(t) - 8} y={ys + 10} text-anchor="end">{checksLabel}</text>}
                </g>
              ))}
            </g>
          );
        })}
        <text class="f-small f-t-muted" x={L.px1} y={L.H - 6} text-anchor="end">{timeLabel}</text>
      </svg>
    );
  })}
  <Stepper steps={steps} />
</Figure>
