---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Error counts of a canary that serves n requests: binomial under the stable rate p0 and under a doubled rate p1.
const n = 6000, p0 = 0.002, p1 = 0.004, alpha = 0.05, K = 44;
function pmf(p: number): number[] {
  const out = [Math.pow(1 - p, n)];
  for (let k = 0; k < K; k++) out.push(out[k] * ((n - k) / (k + 1)) * (p / (1 - p)));
  return out;
}
const f0 = pmf(p0), f1 = pmf(p1);
const sf = (f: number[], c: number) => 1 - f.slice(0, c).reduce((a, b) => a + b, 0);   // P(X >= c)
// The threshold: the smallest c with P(X >= c | p0) at most alpha.
let c = 0;
while (sf(f0, c) > alpha) c++;
const falseAlarm = sf(f0, c), power = sf(f1, c), miss = 1 - power;
if (c !== 19) throw new Error(`threshold ${c}`);
if (Math.abs(falseAlarm - 0.0373) > 0.0005 || Math.abs(power - 0.8722) > 0.0005) throw new Error(`alpha ${falseAlarm}, power ${power}`);
if (Math.abs(sf(f0, 21) - 0.0115) > 0.0005) throw new Error('P(X >= 21)');
const pct = (x: number) => `${(100 * x).toFixed(1)}%`;
if (pct(falseAlarm) !== '3.7%' || pct(miss) !== '12.8%') throw new Error('rounded labels');
const yMax = 0.15;
if (Math.max(...f0) > 0.125 || Math.max(...f1) > 0.125) throw new Error('bars reach the annotations');

const legend = ru
  ? [['h0', `хороший релиз, среднее ${n * p0}`], ['h1', `ошибок вдвое больше, среднее ${n * p1}`]]
  : [['h0', `good release, mean ${n * p0}`], ['h1', `doubled error rate, mean ${n * p1}`]];
// Bars right of the threshold are the false alarms (under p0) and the caught releases (under p1).
const bars0 = f0.map((v, k) => ({ v, k, tail: k >= c }));
const bars1 = f1.map((v, k) => ({ v, k, tail: k >= c }));
const missText = ru ? `← пропуск ${pct(miss)}` : `← missed ${pct(miss)}`;
const alarmText = ru ? `ложная тревога ${pct(falseAlarm)} →` : `false alarm ${pct(falseAlarm)} →`;
const thrText = `c = ${c}`;
const xTitle = ru ? `число ошибок на ${n} запросах канарейки` : `errors in ${n.toLocaleString('en-US')} canary requests`;
const steps = ru
  ? [`если канарейка не хуже стабильной версии: среднее ${n * p0} ошибок`, `если релиз удваивает долю ошибок: среднее ${n * p1}`, `порог c = ${c}: хороший релиз проваливается в ${pct(falseAlarm)} случаев, удваивающий долю ошибок проходит в ${pct(miss)}`]
  : [`if the canary is as good as the stable version: mean ${n * p0} errors`, `if the release doubles the error rate: mean ${n * p1}`, `the threshold c = ${c}: a good release fails ${pct(falseAlarm)} of the time, a doubling one passes ${pct(miss)} of the time`];

interface Layout { cls: string; W: number; H: number; x0: number; x1: number; yTop: number; yBot: number; sans: number; legendY: number; legendRows: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 330, x0: 64, x1: 744, yTop: 62, yBot: 280, sans: 6.5, legendY: 18, legendRows: 1 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 380, x0: 42, x1: 350, yTop: 86, yBot: 322, sans: 7.3, legendY: 18, legendRows: 2 },
];
const geo = layouts.map((L) => {
  const step = (L.x1 - L.x0) / (K + 1);
  const xk = (k: number) => L.x0 + (k + 0.5) * step;   // centre of the slot of count k
  const y = (v: number) => L.yBot - (v / yMax) * (L.yBot - L.yTop);
  const bw = Math.max(2, step / 2 - 1);
  const xThr = L.x0 + c * step;                          // between c - 1 and c
  // legend positions: one row in wide, two rows in narrow
  const lg = legend.map(([, t], i) => (L.legendRows === 1 ? { x: L.x0 + i * 340, y: L.legendY } : { x: 12, y: L.legendY + i * 20 }));
  legend.forEach(([, t], i) => {
    const end = lg[i].x + 20 + t.length * L.sans;
    if (end > (L.legendRows === 1 && i === 0 ? lg[1].x - 10 : L.W - 4)) throw new Error(`legend ${i} at ${L.W}`);
  });
  if (xThr - 6 - missText.length * L.sans < L.x0) throw new Error(`miss label at ${L.W}`);
  if (xThr + 6 + alarmText.length * L.sans > L.W - 4) throw new Error(`alarm label at ${L.W}`);
  if (xTitle.length * L.sans > L.x1 - L.x0) throw new Error('axis title');
  return { step, xk, y, bw, xThr, lg };
});
const ticksX = [0, 5, 10, 15, 20, 25, 30, 35, 40];
const ticksY = [0, 0.05, 0.1];
const id = 'canary-decision';
---

<Figure
  id={id}
  title={ru ? 'Решение по канарейке: число ошибок на 6000 запросах' : 'The canary decision: error counts on 6,000 requests'}
  caption={ru
    ? `Канарейка обслужила ${n} запросов. Синие столбики — распределение числа её ошибок, если она не хуже стабильной версии с долей ошибок 0.2% (1), красные — если релиз удваивает долю ошибок до 0.4% (2); вероятности точные, биномиальные. Правило, выбранное заранее, — провалить канарейку, если ошибок не меньше c = ${c}, наименьшего порога, при котором хороший релиз проваливается не чаще чем в 5% случаев (3). Янтарные столбики справа от порога — ложные тревоги, ${pct(falseAlarm)}; густо закрашенные красные слева — пропущенные плохие релизы, ${pct(miss)}, так что мощность правила ${(100 * power).toFixed(1)}%.`
    : `The canary served ${n.toLocaleString('en-US')} requests. Blue bars are the distribution of its error count if it is as good as the stable version, whose error rate is 0.2% (1); red bars, if the release doubles the error rate to 0.4% (2); the probabilities are exact binomial ones. The rule, fixed in advance, fails the canary at c = ${c} errors or more, the smallest threshold at which a good release is failed at most 5% of the time (3). The amber bars right of the threshold are false alarms, ${pct(falseAlarm)}; the solid red bars left of it are bad releases that pass, ${pct(miss)}, so the power of the rule is ${(100 * power).toFixed(1)}%.`}
>
  {layouts.map((L, li) => {
    const g = geo[li];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Два биномиальных распределения и порог' : 'Two binomial distributions and a threshold'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? `Столбчатая диаграмма вероятностей числа ошибок от 0 до ${K}: синее распределение с пиком около 12 и красное с пиком около 24. Вертикальная линия на пороге ${c}; справа от неё 3.7% синего распределения, слева 12.8% красного.`
          : `A bar chart of the probabilities of error counts from 0 to ${K}: a blue distribution peaking near 12 and a red one peaking near 24. A vertical line marks the threshold ${c}; 3.7% of the blue distribution lies to its right and 12.8% of the red one to its left.`}</desc>
        {ticksY.map((v) => (
          <g>
            <line class="f-grid" x1={L.x0} x2={L.x1} y1={g.y(v)} y2={g.y(v)} />
            <text class="f-small f-t-muted" x={L.x0 - 6} y={g.y(v) + 4} text-anchor="end">{v.toFixed(2)}</text>
          </g>
        ))}
        <line class="f-axis" x1={L.x0} x2={L.x1} y1={L.yBot} y2={L.yBot} />
        {ticksX.map((k) => <text class="f-small f-t-muted" x={g.xk(k)} y={L.yBot + 16} text-anchor="middle">{k}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.yBot + 36} text-anchor="middle">{xTitle}</text>
        <g data-s="1">
          {bars0.map((b) => (
            <rect x={g.xk(b.k) - g.bw - 0.5} y={g.y(b.v)} width={g.bw} height={L.yBot - g.y(b.v)} style={`fill: ${b.tail ? 'var(--fig-amber)' : 'var(--fig-blue)'}; fill-opacity: ${b.tail ? 0.85 : 0.5}`} />
          ))}
        </g>
        <g data-s="2">
          {bars1.map((b) => (
            <rect x={g.xk(b.k) + 0.5} y={g.y(b.v)} width={g.bw} height={L.yBot - g.y(b.v)} style={`fill: var(--fig-red); fill-opacity: ${b.tail ? 0.25 : 0.8}`} />
          ))}
        </g>
        <g data-s="3">
          <line class="f-line" x1={g.xThr} x2={g.xThr} y1={g.y(yMax) + 6} y2={L.yBot} />
          <text class="f-small" x={g.xThr} y={g.y(yMax)} text-anchor="middle" style="font-weight: 650">{thrText}</text>
          <text class="f-small f-t-red" x={g.xThr - 6} y={g.y(0.13)} text-anchor="end">{missText}</text>
          <text class="f-small f-t-amber" x={g.xThr + 6} y={g.y(0.13)} style="font-weight: 650">{alarmText}</text>
        </g>
        {legend.map(([k, t], i) => (
          <g data-s={k === 'h0' ? '1' : '2'}>
            <rect x={g.lg[i].x} y={g.lg[i].y - 10} width="14" height="12" rx="2" style={`fill: ${k === 'h0' ? 'var(--fig-blue)' : 'var(--fig-red)'}; fill-opacity: 0.6`} />
            <text class="f-small f-t-muted" x={g.lg[i].x + 20} y={g.lg[i].y}>{t}</text>
          </g>
        ))}
        <g data-s="1"><Badge x={g.xk(12) - (L.W === 760 ? 40 : 30)} y={g.y(f0[12])} n={1} /></g>
        <g data-s="2"><Badge x={g.xk(24) + 4} y={g.y(f1[24]) - 14} n={2} /></g>
        <g data-s="3"><Badge x={g.xThr + 34} y={g.y(yMax) - 4} n={3} /></g>
      </svg>
    );
  })}
  <Stepper steps={steps} />
</Figure>
