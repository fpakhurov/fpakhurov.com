---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
const id = 'db-recovery-times';
const title = ru ? 'Потеря данных и длительность простоя' : 'Lost history and time offline';
const times = [
  { x: 44, clock: '11:55', label: ru ? 'Есть WAL' : 'WAL ready' },
  { x: 145, clock: '12:00', label: ru ? 'Сбой' : 'Failure' },
  { x: 283, clock: '12:42', label: ru ? 'Готово' : 'Ready' },
];
---
<Figure id={id} title={title} caption={ru
  ? 'Шкала условная. Пять минут истории не покрыты архивом. От сбоя до проверенного восстановления проходит 42 минуты.'
  : 'The axis is schematic. The archive lacks five minutes of history. Verified restoration takes 42 minutes from the failure.'}>
  <svg viewBox="0 0 330 127" class="fig-compact" role="img" aria-labelledby={id + '-title ' + id + '-desc'}>
    <title id={id + '-title'}>{title}</title>
    <desc id={id + '-desc'}>{ru ? 'Архив доступен до 11:55. Сбой в 12:00. Сервис снова готов в 12:42.' : 'The archive is available through 11:55. Failure is at 12:00 and service is ready again at 12:42.'}</desc>
    <path d="M 44 53 H 145" class="f-line f-amber f-bold" />
    <path d="M 145 53 H 283" class="f-line f-blue f-bold" />
    <text x="95" y="85" text-anchor="middle">5 {ru ? 'мин' : 'min'}</text>
    <text x="214" y="85" text-anchor="middle">42 {ru ? 'мин' : 'min'}</text>
    {times.map(({ x, clock, label }) => (
      <g>
        <circle cx={x} cy="53" r="4" class="f-fill-ink" />
        <text x={x} y="38" text-anchor="middle" class="f-title">{clock}</text>
        <text x={x} y="112" text-anchor="middle">{label}</text>
      </g>
    ))}
  </svg>
</Figure>
