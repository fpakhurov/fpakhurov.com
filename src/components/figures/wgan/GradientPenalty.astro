---
import Figure from '../Figure.astro';
import { scale, normals, seeded } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Seeded 2-D samples: real x_r ~ P (red) and fake x_f = G(z) (blue).
// As in the notebook's gradient_penalty: α ~ U(0, 1), x̂ = α·x_r + (1 − α)·x_f.
const n = 7;
const zr = normals(2 * n, 4);
const zf = normals(2 * n, 9);
const real = Array.from({ length: n }, (_, i) => [1.75 + 0.42 * zr[2 * i], 0.55 + 0.42 * zr[2 * i + 1]] as const);
const fake = Array.from({ length: n }, (_, i) => [-1.75 + 0.42 * zf[2 * i], -0.55 + 0.42 * zf[2 * i + 1]] as const);
const rand = seeded(18); // α = 0.40 0.60 0.53 0.20 0.80 0.53 0.71: every x̂ visible on its segment
const alphas = Array.from({ length: n }, () => rand());
const hats = real.map((r, i) => {
  const a = alphas[i];
  return [a * r[0] + (1 - a) * fake[i][0], a * r[1] + (1 - a) * fake[i][1]] as const;
});

// Level sets of a critic whose gradient is the unit vector from the fake centre to the real centre.
const dir = (() => {
  const dx = 3.5;
  const dy = 1.1;
  const len = Math.hypot(dx, dy);
  return [dx / len, dy / len] as const;
})();
const levels = [-2, -1, 0, 1, 2];

// The x̂ used for the gradient callout: the one whose α is closest to 0.5.
const k = alphas.map((a, i) => [Math.abs(a - 0.5), i] as const).sort((p, q) => p[0] - q[0])[0][1];
const hk = hats[k];
const gradLen = 1; // data units: the drawn critic has ‖∇f‖₂ = 1, so the arrow has unit length at the plot's scale

// Both layouts use the same scale on x and y, so ∇f is drawn perpendicular to the level sets.
const layouts = [
  { cls: 'fig-wide fig-medium', sfx: 'w', w: 620, h: 360, L: 20, R: 600, T: 70, narrow: false },
  { cls: 'fig-narrow', sfx: 'n', w: 360, h: 330, L: 10, R: 350, T: 104, narrow: true },
].map((o) => {
  const ppu = (o.R - o.L) / 6; // pixels per data unit
  const B = o.T + 2.7 * ppu;
  const sx = scale([-3, 3], [o.L, o.R]);
  const sy = scale([-1.35, 1.35], [B, o.T]);
  // Line {x : dir·x = c}, clipped to the plot rectangle in data space.
  const level = (c: number) => {
    const xAt = (y: number) => (c - dir[1] * y) / dir[0];
    return `M ${sx(xAt(1.3)).toFixed(1)} ${sy(1.3).toFixed(1)} L ${sx(xAt(-1.3)).toFixed(1)} ${sy(-1.3).toFixed(1)}`;
  };
  return { ...o, B, sx, sy, level, gx: sx(hk[0] + dir[0] * gradLen), gy: sy(hk[1] + dir[1] * gradLen) };
});
const hat = 'font-family: var(--serif); font-style: italic';
const id = 'wgan-gradient-penalty';
---

<Figure
  id={id}
  title={ru ? "Штраф на градиент вычисляется между настоящими сэмплами и подделками" : "The gradient penalty is evaluated between real and fake samples"}
  caption={ru ? `Семь настоящих сэмплов (красные) и семь подделок (синие); все точки получены при фиксированном начальном значении (seed) генератора случайных чисел. Каждому настоящему сэмплу сопоставлена случайная подделка, α берётся из U(0, 1), а зелёная точка α·(настоящий) + (1 − α)·(подделка) — случайная точка на отрезке между ними. Штраф λ(‖∇f‖₂ − 1)² вычисляется в этих точках и подталкивает норму градиента критика в них к 1. Тонкие штриховые линии — линии уровня критика с единичным градиентом, направленным от подделок к настоящим сэмплам; для этого критика штраф равен нулю, а стрелка ∇f, нарисованная в масштабе графика, имеет длину 1.` : `Seven seeded real samples (red) and fake samples (blue). Each real sample is paired with a random fake one, α is drawn from U(0, 1), and the green point α·(real) + (1 − α)·(fake) is a random point on the segment between them. The penalty λ(‖∇f‖₂ − 1)² is evaluated at these points and pushes the critic's gradient norm towards 1 there. Thin dashed lines are level sets of a critic with unit gradient pointing from the fakes to the reals; for this critic the penalty is zero, and the arrow ∇f, drawn at the plot's scale, has length 1.`}
>
  {layouts.map((o) => (
    <svg class={o.cls} viewBox={`0 0 ${o.w} ${o.h}`} role="img" aria-labelledby={`${id}-${o.sfx}-t ${id}-${o.sfx}-d`}>
      <title id={`${id}-${o.sfx}-t`}>{ru ? "Интерполированные точки для штрафа на градиент в WGAN-GP" : "Interpolated points for the WGAN-GP gradient penalty"}</title>
      <desc id={`${id}-${o.sfx}-d`}>{ru ? "Двумерная диаграмма рассеяния. Семь красных настоящих сэмплов справа и семь синих подделок слева. Каждый настоящий сэмпл соединён с подделкой штриховым отрезком, и на каждом отрезке в случайном месте лежит зелёная точка x с крышкой. Бледные параллельные линии — линии уровня критика f. В одной из зелёных точек стрелка единичной длины показывает градиент f с подписью: здесь вычисляется штраф на его норму." : "A two-dimensional scatter. Seven red real samples on the right and seven blue fake samples on the left. Each real sample is joined to a fake sample by a dashed segment, and a green point x hat lies at a random position along each segment. Faint parallel lines are level sets of the critic f. At one green point an arrow of unit length shows the gradient of f, labelled: the penalty on its norm is evaluated here."}</desc>

      {levels.map((c) => <path class="f-grid f-dash" d={o.level(c)} />)}

      {real.map((r, i) => (
        <line class="f-thin f-muted f-dash" x1={o.sx(r[0])} y1={o.sy(r[1])} x2={o.sx(fake[i][0])} y2={o.sy(fake[i][1])} />
      ))}
      {real.map((r) => <circle class="f-solid-red" cx={o.sx(r[0])} cy={o.sy(r[1])} r="5" />)}
      {fake.map((f) => <circle class="f-solid-blue" cx={o.sx(f[0])} cy={o.sy(f[1])} r="5" />)}
      {hats.map((h) => <circle class="f-solid-green" cx={o.sx(h[0])} cy={o.sy(h[1])} r="4.5" />)}

      <text class="f-label f-t-red" x={o.sx(2.95)} y={o.T - 30} text-anchor="end">{ru ? 'настоящие x' : 'real x'}<tspan dy="5" font-size="13">r</tspan><tspan dy="-5"> ~ P</tspan></text>
      <text class="f-label f-t-blue" x={o.sx(-2.95)} y={o.T - 30}>{ru ? 'подделки x' : 'fake x'}<tspan dy="5" font-size="13">f</tspan><tspan dy="-5"> = G(z)</tspan></text>

      <!-- interpolation formula -->
      {o.narrow ? (
        <text class="f-label f-t-green" x={o.w / 2} y="26" text-anchor="middle"><tspan style={hat}>x̂</tspan> = α x<tspan dy="5" font-size="13">r</tspan><tspan dy="-5"> + (1 − α) x</tspan><tspan dy="5" font-size="13">f</tspan><tspan dy="-5">,  α ~ U(0, 1)</tspan></text>
      ) : (
        <text class="f-label f-t-green" x={o.sx(0)} y={o.T - 44} text-anchor="middle"><tspan style={hat}>x̂</tspan> = α x<tspan dy="5" font-size="13">r</tspan><tspan dy="-5"> + (1 − α) x</tspan><tspan dy="5" font-size="13">f</tspan><tspan dy="-5">,  α ~ U(0, 1)</tspan></text>
      )}

      <!-- gradient at one x̂ -->
      <line class="f-line f-bold" x1={o.sx(hk[0])} y1={o.sy(hk[1])} x2={o.gx} y2={o.gy} marker-end="url(#f-arrow)" />
      <text class="f-math f-halo" x={o.gx + 6} y={o.gy - 16}>∇f(x̂)</text>

      {o.narrow ? (
        <g>
          <text class="f-label f-t-muted" x={o.R} y={o.B + 26} text-anchor="end">{ru ? "линии уровня критика f" : "level sets of the critic f"}</text>
          <text class="f-label f-t-amber" x={o.w / 2} y={o.B + 54} text-anchor="middle">{ru ? 'штраф' : 'penalty'} (‖∇f(<tspan style={hat}>x̂</tspan>)‖<tspan dy="5" font-size="13">2</tspan><tspan dy="-5">{ru ? " − 1)² считается здесь" : " − 1)² evaluated here"}</tspan></text>
          <path class="f-thin f-amber" d={`M ${o.w / 2 - 70} ${o.B + 38} Q ${o.sx(hk[0]) - 30} ${o.sy(hk[1]) + 30} ${o.sx(hk[0]) - 3} ${o.sy(hk[1]) + 8}`} marker-end="url(#f-arrow-amber)" />
        </g>
      ) : (
        <g>
          <text class="f-label f-t-muted" x={o.sx(-2.95)} y={o.B + 22}>{ru ? "линии уровня критика f" : "level sets of the critic f"}</text>
          <text class="f-label f-t-amber f-halo" x={o.sx(0.1)} y={o.B - 4} text-anchor="middle">{ru ? 'штраф' : 'penalty'} (‖∇f(<tspan style={hat}>x̂</tspan>)‖<tspan dy="5" font-size="13">2</tspan><tspan dy="-5">{ru ? " − 1)² здесь" : " − 1)² evaluated here"}</tspan></text>
          <path class="f-thin f-amber" d={`M ${o.sx(0.1) - 40} ${o.B - 22} Q ${o.sx(hk[0]) - 30} ${o.sy(hk[1]) + 40} ${o.sx(hk[0]) - 3} ${o.sy(hk[1]) + 9}`} marker-end="url(#f-arrow-amber)" />
        </g>
      )}
    </svg>
  ))}
</Figure>
