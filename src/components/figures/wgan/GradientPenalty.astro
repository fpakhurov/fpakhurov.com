---
import Figure from '../Figure.astro';
import { scale, normals, seeded } from '../geometry';

// Seeded 2-D samples: real x_r ~ P (red) and fake x_f = G(z) (blue).
// As in the notebook's gradient_penalty: α ~ U(0, 1), x̂ = α·x_r + (1 − α)·x_f.
const n = 7;
const zr = normals(2 * n, 4);
const zf = normals(2 * n, 9);
const real = Array.from({ length: n }, (_, i) => [1.75 + 0.42 * zr[2 * i], 0.55 + 0.42 * zr[2 * i + 1]] as const);
const fake = Array.from({ length: n }, (_, i) => [-1.75 + 0.42 * zf[2 * i], -0.55 + 0.42 * zf[2 * i + 1]] as const);
const rand = seeded(18); // α = 0.40 0.60 0.53 0.20 0.80 0.53 0.71: every x̂ visible on its segment
const alphas = Array.from({ length: n }, () => rand());
const hats = real.map((r, i) => {
  const a = alphas[i];
  return [a * r[0] + (1 - a) * fake[i][0], a * r[1] + (1 - a) * fake[i][1]] as const;
});

const L = 20;
const R = 600;
const T = 70;
const B = 330;
const sx = scale([-3, 3], [L, R]);
const sy = scale([-1.35, 1.35], [B, T]); // ≈ 96.3 px/unit, same as sx, so ∇f is drawn perpendicular to the level sets

// Level sets of a critic whose gradient is the unit vector from the fake centre to the real centre.
const dir = (() => {
  const dx = 3.5;
  const dy = 1.1;
  const len = Math.hypot(dx, dy);
  return [dx / len, dy / len] as const;
})();
// Line {x : dir·x = c}, clipped to the plot rectangle in data space.
const level = (c: number) => {
  const yTop = 1.3;
  const yBot = -1.3;
  const xAt = (y: number) => (c - dir[1] * y) / dir[0];
  return `M ${sx(xAt(yTop)).toFixed(1)} ${sy(yTop).toFixed(1)} L ${sx(xAt(yBot)).toFixed(1)} ${sy(yBot).toFixed(1)}`;
};
const levels = [-2, -1, 0, 1, 2];

// The x̂ used for the gradient callout: the one whose α is closest to 0.5.
const k = alphas.map((a, i) => [Math.abs(a - 0.5), i] as const).sort((p, q) => p[0] - q[0])[0][1];
const hk = hats[k];
const gradLen = 0.75; // data units
const gx = sx(hk[0] + dir[0] * gradLen);
const gy = sy(hk[1] + dir[1] * gradLen);
const id = 'wgan-gradient-penalty';
---

<Figure
  id={id}
  title="The gradient penalty is evaluated between real and fake samples"
  caption={`Seven seeded real samples (red) and fake samples (blue). Each real sample is paired with a fake one, α is drawn from U(0, 1), and x̂ = α·(real) + (1 − α)·(fake) is a random point on the segment between them (green). The penalty λ(‖∇f(x̂)‖₂ − 1)² pushes the critic's gradient norm towards 1 there. Thin dashed lines are level sets of a critic with unit gradient pointing from the fakes to the reals.`}
  origin="illustrative"
  pages="25"
>
  <svg class="fig-medium" viewBox="0 0 620 360" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>Interpolated points for the WGAN-GP gradient penalty</title>
    <desc id={`${id}-d`}>A two-dimensional scatter. Seven red real samples on the right and seven blue fake samples on the left. Each real sample is joined to a fake sample by a dashed segment, and a green point x hat lies at a random position along each segment. Faint parallel lines are level sets of the critic f. At one green point an arrow shows the gradient of f, labelled: penalize when its norm is not 1.</desc>

    {levels.map((c) => <path class="f-grid f-dash" d={level(c)} />)}
    <text class="f-label f-t-muted" x={sx(-2.95)} y={B + 22}>level sets of the critic f</text>

    {real.map((r, i) => (
      <line class="f-thin f-muted f-dash" x1={sx(r[0])} y1={sy(r[1])} x2={sx(fake[i][0])} y2={sy(fake[i][1])} />
    ))}
    {real.map((r) => <circle class="f-solid-red" cx={sx(r[0])} cy={sy(r[1])} r="5" />)}
    {fake.map((f) => <circle class="f-solid-blue" cx={sx(f[0])} cy={sy(f[1])} r="5" />)}
    {hats.map((h) => <circle class="f-solid-green" cx={sx(h[0])} cy={sy(h[1])} r="4.5" />)}

    <text class="f-label f-t-red" x={sx(2.95)} y={T - 30} text-anchor="end">real x<tspan dy="5" font-size="13">r</tspan><tspan dy="-5"> ~ P</tspan></text>
    <text class="f-label f-t-blue" x={sx(-2.95)} y={T - 30}>fake x<tspan dy="5" font-size="13">f</tspan><tspan dy="-5"> = G(z)</tspan></text>

    <!-- interpolation formula -->
    <text class="f-label f-t-green" x={sx(0)} y={T - 44} text-anchor="middle">x̂ = α x<tspan dy="5" font-size="13">r</tspan><tspan dy="-5"> + (1 − α) x</tspan><tspan dy="5" font-size="13">f</tspan><tspan dy="-5">,  α ~ U(0, 1)</tspan></text>

    <!-- gradient at one x̂ -->
    <line class="f-line f-bold" x1={sx(hk[0])} y1={sy(hk[1])} x2={gx} y2={gy} marker-end="url(#f-arrow)" />
    <text class="f-math f-halo" x={gx + 6} y={gy - 16}>∇f(x̂)</text>
    <text class="f-label f-t-amber f-halo" x={sx(0.1)} y={B - 4} text-anchor="middle">penalize ‖∇f(x̂)‖₂ ≠ 1</text>
    <path class="f-thin f-amber" d={`M ${sx(0.1) - 40} ${B - 22} Q ${sx(hk[0]) - 30} ${sy(hk[1]) + 40} ${sx(hk[0]) - 3} ${sy(hk[1]) + 9}`} marker-end="url(#f-arrow)" />
  </svg>
</Figure>
