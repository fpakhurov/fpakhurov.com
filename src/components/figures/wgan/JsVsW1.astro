---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';

// P = δ₀ (real) and Q_θ = δ_θ (model). For θ ≠ 0 the supports are disjoint:
// JS(P, Q_θ) = ½·KL(δ₀ ‖ M) + ½·KL(δ_θ ‖ M) with M = ½(δ₀ + δ_θ), each KL = 1·ln(1 / ½) = ln 2.
// W₁(P, Q_θ) = |θ|: all the mass moves a distance |θ|.
const LN2 = Math.log(2);
const js = (theta: number) => (theta === 0 ? 0 : LN2);
const w1 = (theta: number) => Math.abs(theta);

const L = 60;
const R = 500;
const T = 160;
const B = 380;
const th: [number, number] = [-1.2, 1.2];
const sx = scale(th, [L, R]);
const sy = scale([0, 1.6], [B, T]);

const wPath = polyline([[sx(th[0]), sy(w1(th[0]))], [sx(0), sy(0)], [sx(th[1]), sy(w1(th[1]))]]);
const jsY = sy(js(1));

// Top strip: the two point masses on a line, using the same θ axis.
const thetaDemo = 0.7;
const axisY = 104;
const spikeTop = 34;
const id = 'wgan-js-vs-w1';
---

<Figure
  id={id}
  title="JS is flat for disjoint supports; W₁ keeps a slope"
  caption={`P = δ₀ is a point mass at 0 (real data) and the model Qθ is a point mass at θ. For every θ ≠ 0 the supports are disjoint, so JS(P, Qθ) = ln 2 ≈ ${LN2.toFixed(3)} (natural log) no matter how far apart they are, and KL(P ‖ Qθ) = ∞. The Wasserstein-1 distance is the cost of moving all the mass a distance |θ|, so W₁ = |θ| and its derivative ±1 always points the model towards the data.`}
  origin="illustrative"
  pages="25"
>
  <svg class="fig-medium" viewBox="0 0 600 430" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>Jensen–Shannon divergence and Wasserstein-1 distance between two point masses</title>
    <desc id={`${id}-d`}>Top: a red point mass P at zero and a blue point mass Q theta at theta equals 0.7, with a double arrow of length theta between them. Bottom: a plot against theta from minus 1.2 to 1.2. The Jensen–Shannon divergence is a flat red line at ln 2, about 0.693, with a hole at theta equals zero where it drops to a single point at zero; it is labelled flat, no gradient. The Wasserstein-1 distance is a green V shape equal to the absolute value of theta, labelled slope plus or minus 1, useful gradient.</desc>

    <!-- Top strip: the two distributions -->
    <path class="f-axis" d={`M ${L} ${axisY} H ${R + 20}`} marker-end="url(#f-arrow-muted)" />
    <line class="f-line f-red f-bold" x1={sx(0)} x2={sx(0)} y1={axisY} y2={spikeTop + 4} marker-end="url(#f-arrow-red)" />
    <line class="f-line f-blue f-bold" x1={sx(thetaDemo)} x2={sx(thetaDemo)} y1={axisY} y2={spikeTop + 4} marker-end="url(#f-arrow-blue)" />
    <text class="f-label f-t-red" x={sx(0) - 12} y={spikeTop + 14} text-anchor="end">P = δ₀ (real)</text>
    <text class="f-label f-t-blue" x={sx(thetaDemo) + 12} y={spikeTop + 14}>Q<tspan dy="5" font-size="13">θ</tspan><tspan dy="-5"> = δ</tspan><tspan dy="5" font-size="13">θ</tspan><tspan dy="-5"> (model)</tspan></text>
    <line class="f-thin" x1={sx(0) + 4} x2={sx(thetaDemo) - 4} y1="76" y2="76" marker-start="url(#f-arrow)" marker-end="url(#f-arrow)" />
    <text class="f-math f-halo" x={(sx(0) + sx(thetaDemo)) / 2} y="68" text-anchor="middle">θ</text>
    <text class="f-note" x={sx(0)} y={axisY + 20} text-anchor="middle">0</text>
    <text class="f-note" x={sx(thetaDemo)} y={axisY + 20} text-anchor="middle">θ</text>

    <!-- Bottom: the plot -->
    {[0, 0.5, 1].map((v) => <line class="f-grid" x1={L} x2={R} y1={sy(v)} y2={sy(v)} />)}
    {[0, 0.5, 1].map((v) => <text class="f-note" x={L - 10} y={sy(v) + 5} text-anchor="end">{v}</text>)}
    <path class="f-axis" d={`M ${L} ${B} H ${R + 20}`} marker-end="url(#f-arrow-muted)" />
    <path class="f-axis" d={`M ${sx(0)} ${B} V ${T - 12}`} marker-end="url(#f-arrow-muted)" />
    {[-1, -0.5, 0.5, 1].map((v) => <text class="f-note" x={sx(v)} y={B + 22} text-anchor="middle">{v < 0 ? `−${-v}` : v}</text>)}
    <text class="f-math" x={R + 22} y={B + 24} text-anchor="end">θ</text>

    <!-- W₁ = |θ| -->
    <path class="f-line f-green f-bold" d={wPath} />
    <text class="f-label f-t-green" x={R + 8} y={sy(w1(th[1])) + 5}>W₁ = |θ|</text>

    <!-- JS = ln 2 except at θ = 0 -->
    <line class="f-line f-red f-bold" x1={L} x2={sx(0) - 6} y1={jsY} y2={jsY} />
    <line class="f-line f-red f-bold" x1={sx(0) + 6} x2={R} y1={jsY} y2={jsY} />
    <circle class="f-line f-red f-fill-paper" cx={sx(0)} cy={jsY} r="5" />
    <circle class="f-solid-red" cx={sx(0)} cy={sy(0)} r="5" />
    <text class="f-label f-t-red" x={R + 8} y={jsY + 5}>JS = ln 2</text>

    <!-- Annotations -->
    <text class="f-label f-t-red" x={L + 8} y={T + 16}>JS is flat:</text>
    <text class="f-label f-t-red" x={L + 8} y={T + 35}>no gradient for G</text>
    <path class="f-thin f-red" d={`M ${L + 90} ${T + 44} Q ${sx(-0.62)} ${T + 80} ${sx(-0.38)} ${jsY - 8}`} marker-end="url(#f-arrow-red)" />

    <text class="f-label f-t-green" x={R - 6} y={T + 16} text-anchor="end">slope ±1:</text>
    <text class="f-label f-t-green" x={R - 6} y={T + 35} text-anchor="end">useful gradient</text>
    <path class="f-thin f-green" d={`M ${sx(0.86)} ${T + 44} Q ${sx(0.86)} ${sy(1.02)} ${sx(0.97) - 6} ${sy(0.97) - 4}`} marker-end="url(#f-arrow-green)" />

    <text class="f-small f-t-red" x={sx(0)} y={B + 42} text-anchor="middle">JS = 0 only at θ = 0</text>
  </svg>
</Figure>
