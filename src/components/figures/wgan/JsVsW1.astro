---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';

// P = δ₀ (real) and Q_θ = δ_θ (model). For θ ≠ 0 the supports are disjoint:
// D_JS(P ‖ Q_θ) = ½·KL(δ₀ ‖ M) + ½·KL(δ_θ ‖ M) with M = ½(δ₀ + δ_θ), each KL = 1·ln(1 / ½) = ln 2.
// W₁(P, Q_θ) = |θ|: all the mass moves a distance |θ|.
const LN2 = Math.log(2);
const js = (theta: number) => (theta === 0 ? 0 : LN2);
const w1 = (theta: number) => Math.abs(theta);
const th: [number, number] = [-1.2, 1.2];
const thetaDemo = 0.7;
const spikeTop = 34;
const axisY = 104;

// Wide: curve names to the right of the plot. Narrow: curve names merged into the annotations.
const layouts = [
  { cls: 'fig-wide fig-medium', sfx: 'w', w: 600, h: 430, L: 60, R: 500, T: 160, B: 380, narrow: false },
  { cls: 'fig-narrow', sfx: 'n', w: 360, h: 500, L: 40, R: 330, T: 190, B: 440, narrow: true },
].map((o) => {
  const sx = scale(th, [o.L, o.R]);
  const sy = scale([0, 1.6], [o.B, o.T]);
  return {
    ...o,
    sx,
    sy,
    wPath: polyline([[sx(th[0]), sy(w1(th[0]))], [sx(0), sy(0)], [sx(th[1]), sy(w1(th[1]))]]),
    jsY: sy(js(1)),
  };
});
const id = 'wgan-js-vs-w1';
---

<Figure
  id={id}
  title="D_JS is flat for disjoint supports; W₁ keeps a slope"
  caption={`P = δ₀ is a point mass at 0 (real data) and the model Q_θ = δ_θ is a point mass at θ. For every θ ≠ 0 the supports are disjoint, so D_JS(P ‖ Q_θ) = ln 2 ≈ ${LN2.toFixed(3)} nats no matter how far apart they are, and D_KL(P ‖ Q_θ) = ∞. The Wasserstein-1 distance is the cost of moving all the mass a distance |θ|, so W₁ = |θ| and its derivative ±1 always points the model towards the data. Both curves are plotted against the same vertical axis.`}
  origin="illustrative"
>
  {layouts.map((o) => (
    <svg class={o.cls} viewBox={`0 0 ${o.w} ${o.h}`} role="img" aria-labelledby={`${id}-${o.sfx}-t ${id}-${o.sfx}-d`}>
      <title id={`${id}-${o.sfx}-t`}>Jensen–Shannon divergence and Wasserstein-1 distance between two point masses</title>
      <desc id={`${id}-${o.sfx}-d`}>Top: a red point mass P at zero and a blue point mass Q theta at theta equals 0.7, with a double arrow of length theta between them. Bottom: a plot against theta from minus 1.2 to 1.2. The Jensen–Shannon divergence is a flat red line at ln 2, about 0.693, with a hole at theta equals zero where it drops to a single point at zero; it is labelled flat, no gradient. The Wasserstein-1 distance is a green V shape equal to the absolute value of theta, labelled slope plus or minus 1, useful gradient.</desc>

      <!-- Top strip: the two distributions -->
      <path class="f-axis" d={`M ${o.L} ${axisY} H ${o.R + 20}`} marker-end="url(#f-arrow-muted)" />
      <line class="f-line f-red f-bold" x1={o.sx(0)} x2={o.sx(0)} y1={axisY} y2={spikeTop + 4} marker-end="url(#f-arrow-red)" />
      <line class="f-line f-blue f-bold" x1={o.sx(thetaDemo)} x2={o.sx(thetaDemo)} y1={axisY} y2={spikeTop + 4} marker-end="url(#f-arrow-blue)" />
      {o.narrow ? (
        <g>
          <text class="f-label f-t-red" x={o.sx(0) - 12} y={spikeTop + 14} text-anchor="end">P = δ₀</text>
          <text class="f-label f-t-red" x={o.sx(0) - 12} y={spikeTop + 34} text-anchor="end">(real)</text>
          <text class="f-label f-t-blue" x={o.sx(thetaDemo) + 12} y={spikeTop + 14}>Q<tspan dy="5" font-size="13">θ</tspan><tspan dy="-5"> = δ</tspan><tspan dy="5" font-size="13">θ</tspan></text>
          <text class="f-label f-t-blue" x={o.sx(thetaDemo) + 12} y={spikeTop + 34}>(model)</text>
        </g>
      ) : (
        <g>
          <text class="f-label f-t-red" x={o.sx(0) - 12} y={spikeTop + 14} text-anchor="end">P = δ₀ (real)</text>
          <text class="f-label f-t-blue" x={o.sx(thetaDemo) + 12} y={spikeTop + 14}>Q<tspan dy="5" font-size="13">θ</tspan><tspan dy="-5"> = δ</tspan><tspan dy="5" font-size="13">θ</tspan><tspan dy="-5"> (model)</tspan></text>
        </g>
      )}
      <line class="f-thin" x1={o.sx(0) + 4} x2={o.sx(thetaDemo) - 4} y1="76" y2="76" marker-start="url(#f-arrow)" marker-end="url(#f-arrow)" />
      <text class="f-math f-halo" x={(o.sx(0) + o.sx(thetaDemo)) / 2} y="68" text-anchor="middle">θ</text>
      <text class="f-note" x={o.sx(0)} y={axisY + 20} text-anchor="middle">0</text>
      <text class="f-note" x={o.sx(thetaDemo)} y={axisY + 20} text-anchor="middle">θ</text>

      <!-- Bottom: the plot -->
      {[0, 0.5, 1].map((v) => <line class="f-grid" x1={o.L} x2={o.R} y1={o.sy(v)} y2={o.sy(v)} />)}
      {[0, 0.5, 1].map((v) => <text class="f-note" x={o.L - 10} y={o.sy(v) + 5} text-anchor="end">{v}</text>)}
      <path class="f-axis" d={`M ${o.L} ${o.B} H ${o.R + 20}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-axis" d={`M ${o.sx(0)} ${o.B} V ${o.T - 12}`} marker-end="url(#f-arrow-muted)" />
      <text class="f-note" x={o.sx(0) + 10} y={o.T - 2}>value</text>
      {[-1, -0.5, 0.5, 1].map((v) => <text class="f-note" x={o.sx(v)} y={o.B + 22} text-anchor="middle">{v < 0 ? `−${-v}` : v}</text>)}
      <text class="f-math" x={o.R + 22} y={o.B + 24} text-anchor="end">θ</text>

      <!-- W₁ = |θ| -->
      <path class="f-line f-green f-bold" d={o.wPath} />

      <!-- D_JS = ln 2 except at θ = 0 -->
      <line class="f-line f-red f-bold" x1={o.L} x2={o.sx(0) - 6} y1={o.jsY} y2={o.jsY} />
      <line class="f-line f-red f-bold" x1={o.sx(0) + 6} x2={o.R} y1={o.jsY} y2={o.jsY} />
      <circle class="f-line f-red f-fill-paper" cx={o.sx(0)} cy={o.jsY} r="5" />
      <circle class="f-solid-red" cx={o.sx(0)} cy={o.sy(0)} r="5" />

      {!o.narrow && (
        <g>
          <text class="f-label f-t-green" x={o.R + 8} y={o.sy(w1(th[1])) + 5}>W₁ = |θ|</text>
          <text class="f-label f-t-red" x={o.R + 8} y={o.jsY + 5}>D<tspan dy="5" font-size="13">JS</tspan><tspan dy="-5"> = ln 2</tspan></text>
        </g>
      )}

      <!-- Annotations -->
      <text class="f-label f-t-red" x={o.L + 8} y={o.T + 16}>D<tspan dy="5" font-size="13">JS</tspan><tspan dy="-5">{o.narrow ? ' = ln 2: flat,' : ' is flat:'}</tspan></text>
      <text class="f-label f-t-red" x={o.L + 8} y={o.T + 35}>no gradient for G</text>
      <path class="f-thin f-red" d={`M ${o.L + 90} ${o.T + 44} Q ${o.sx(-0.62)} ${o.T + 80} ${o.sx(-0.38)} ${o.jsY - 8}`} marker-end="url(#f-arrow-red)" />

      <text class="f-label f-t-green" x={o.R - 6} y={o.T + 16} text-anchor="end">{o.narrow ? 'W₁ = |θ|: slope ±1,' : 'slope ±1:'}</text>
      <text class="f-label f-t-green" x={o.R - 6} y={o.T + 35} text-anchor="end">useful gradient</text>
      <path class="f-thin f-green" d={`M ${o.sx(0.86)} ${o.T + 44} Q ${o.sx(0.86)} ${o.sy(1.02)} ${o.sx(0.97) - 6} ${o.sy(0.97) - 4}`} marker-end="url(#f-arrow-green)" />

      <text class="f-label f-t-red" x={o.sx(0)} y={o.B + 44} text-anchor="middle">D<tspan dy="5" font-size="13">JS</tspan><tspan dy="-5"> = 0 only at θ = 0</tspan></text>
    </svg>
  ))}
</Figure>
