---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';

// Convex f(x) = ½(x − 1)² + ½ and slope t = 1.
// f*(t) = sup_x [t·x − f(x)]; the sup is at f′(x*) = t, i.e. x* = 1 + t.
// Closed form: f*(t) = t + t²/2 − ½, so f*(1) = 1.
const f = (x: number) => 0.5 * (x - 1) ** 2 + 0.5;
const t = 1;
const xs = 1 + t;
const fx = f(xs);
const fstar = t * xs - fx; // = 1
const tangent = (x: number) => t * x - fstar;
const through0 = (x: number) => t * x;

const L = 50;
const R = 560;
const T = 24;
const B = 340;
const X: [number, number] = [-0.6, 3.6];
const Y: [number, number] = [-1.4, 4.0];
const sx = scale(X, [L, R]);
const sy = scale(Y, [B, T]);

const fPath = plot(f, -0.6, 3.55, sx, sy, 200);
const tanPath = plot(tangent, -0.12, 3.6, sx, sy, 2);
const zeroPath = plot(through0, -0.5, 3.0, sx, sy, 2);

// Slope triangle on the tangent line.
const tri0 = 2.85;
const tri1 = 3.3;
const id = 'wgan-fenchel';
---

<Figure
  id={id}
  title="The Fenchel conjugate read off a tangent line"
  caption={`A convex f(x) = ½(x − 1)² + ½ (blue) and slope t = 1. The line with slope t that touches f at exactly one point (amber) touches it at x* = ${xs}, where f′(x*) = t. Its intercept is −f*(t) = −${fstar}. Equivalently, f*(t) = max over x of t·x − f(x) is the largest vertical gap between the line t·x through the origin (dashed) and f, reached at the same x*. In closed form f*(t) = t + t²/2 − ½.`}
  origin="illustrative"
  pages="25"
>
  <svg class="fig-medium" viewBox="0 0 600 380" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>Geometric meaning of the convex conjugate</title>
    <desc id={`${id}-d`}>A convex parabola f of x with minimum one half at x equals one. An amber straight line with slope t equals one touches the parabola at the single point x star equals 2, height 1, and crosses the vertical axis at minus 1, labelled minus f star of t. A dashed line y equals t x passes through the origin; at x star the vertical gap between the dashed line and the parabola is 1, marked by a green double arrow labelled f star of t, the largest gap. A small slope triangle on the tangent line shows rise t over run 1.</desc>

    <path class="f-axis" d={`M ${L} ${sy(0)} H ${R + 24}`} marker-end="url(#f-arrow-muted)" />
    <path class="f-axis" d={`M ${sx(0)} ${B} V ${T - 6}`} marker-end="url(#f-arrow-muted)" />
    <text class="f-math" x={R + 24} y={sy(0) + 26} text-anchor="end">x</text>
    <text class="f-math" x={sx(0) - 10} y={T + 8} text-anchor="end">y</text>
    <text class="f-note" x={sx(0) + 7} y={sy(0) + 18}>0</text>

    <path class="f-line f-muted f-dash" d={zeroPath} />
    <path class="f-line f-blue f-bold" d={fPath} />
    <path class="f-line f-amber f-bold" d={tanPath} />

    <text class="f-math f-t-blue" x={sx(-0.55)} y={sy(2.15)}>f(x)</text>
    <text class="f-math f-t-muted" x={sx(2.85)} y={sy(3.1)} text-anchor="end">y = t x</text>
    <text class="f-math f-t-amber" x={sx(0.3)} y={sy(-1.12)}>y = t x − f*(t)</text>

    <!-- slope triangle -->
    <path class="f-thin f-amber" d={`M ${sx(tri0)} ${sy(tangent(tri0))} H ${sx(tri1)} V ${sy(tangent(tri1))}`} />
    <text class="f-note" x={(sx(tri0) + sx(tri1)) / 2} y={sy(tangent(tri0)) + 18} text-anchor="middle">1</text>
    <text class="f-note f-t-amber" x={sx(tri1) + 7} y={(sy(tangent(tri0)) + sy(tangent(tri1))) / 2 + 5}>t</text>

    <!-- x* and the touching point -->
    <line class="f-thin f-muted f-dash" x1={sx(xs)} x2={sx(xs)} y1={sy(0)} y2={sy(fx)} />
    <text class="f-math" x={sx(xs)} y={sy(0) + 24} text-anchor="middle">x*</text>
    <circle cx={sx(xs)} cy={sy(fx)} r="5" fill="var(--fig-amber)" />
    <text class="f-label" x={sx(0.2)} y={sy(3.7)}>slope-t line touches f</text>
    <text class="f-label" x={sx(0.2)} y={sy(3.7) + 20}>at one point: f′(x*) = t</text>
    <path class="f-thin" d={`M ${sx(1.15)} ${sy(3.7) + 30} Q ${sx(1.35)} ${sy(1.8)} ${sx(xs) - 8} ${sy(fx) - 4}`} marker-end="url(#f-arrow)" />

    <!-- the gap f*(t) -->
    <line class="f-line f-green" x1={sx(xs)} x2={sx(xs)} y1={sy(fx) - 7} y2={sy(through0(xs)) + 7} marker-start="url(#f-arrow-green)" marker-end="url(#f-arrow-green)" />
    <text class="f-label f-t-green" x={sx(2.3)} y={sy(0.42)}>f*(t) = largest gap</text>
    <text class="f-label f-t-green" x={sx(2.3)} y={sy(0.42) + 20}>between t x and f(x)</text>
    <path class="f-thin f-green" d={`M ${sx(2.45)} ${sy(0.42) - 18} Q ${sx(2.3)} ${sy(1.1)} ${sx(xs) + 6} ${sy(1.55)}`} marker-end="url(#f-arrow-green)" />

    <!-- intercept -->
    <circle cx={sx(0)} cy={sy(-fstar)} r="4.5" fill="var(--fig-amber)" />
    <text class="f-math f-t-amber f-halo" x={sx(0) - 10} y={sy(-fstar) - 6} text-anchor="end">−f*(t)</text>
  </svg>
</Figure>
