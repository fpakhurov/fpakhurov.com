---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The pipeline of the note:  awk '$9 >= 500 {print $7}' < access.log | sort | uniq -c > report.txt
// Three processes, two pipes, two redirections. Each process has descriptors 0, 1 and 2.
const procs = ['awk', 'sort', 'uniq -c'];
const pipes = procs.length - 1;
if (pipes !== 2) throw new Error('three commands need two pipes');
const cmd = "awk '$9 >= 500 {print $7}' < access.log | sort | uniq -c > report.txt";

const t = ru
  ? { shell: 'bash', shellSub: 'pipe() ×2, fork() ×3, затем wait()', shellSubN: 'pipe() ×2, fork() ×3, wait()',
      file: 'access.log', out: 'report.txt', pipe: 'канал', term: 'терминал', termSub: 'fd 2 всех трёх', termN: 'терминал',
      steps: ['bash разбирает строку, создаёт два канала и порождает три процесса', '< access.log: файл открывается как fd 0 процесса awk', 'первый канал соединяет fd 1 awk с fd 0 sort', 'второй канал соединяет fd 1 sort с fd 0 uniq', '> report.txt: файл открывается как fd 1 процесса uniq', 'fd 2 каждого процесса — по-прежнему терминал: ошибки идут мимо каналов', 'bash ждёт все три процесса; $? — статус последнего'] }
  : { shell: 'bash', shellSub: 'pipe() ×2, fork() ×3, then wait()', shellSubN: 'pipe() ×2, fork() ×3, wait()',
      file: 'access.log', out: 'report.txt', pipe: 'pipe', term: 'terminal', termSub: 'fd 2 of all three', termN: 'terminal',
      steps: ['bash parses the line, creates two pipes and forks three processes', '< access.log: the file is opened as fd 0 of awk', 'the first pipe joins fd 1 of awk to fd 0 of sort', 'the second pipe joins fd 1 of sort to fd 0 of uniq', '> report.txt: the file is opened as fd 1 of uniq', 'fd 2 of every process is still the terminal: errors bypass the pipes', 'bash waits for all three; $? is the status of the last one'] };

const blue = toneVar.h, green = toneVar.x, red = toneVar.y, amber = toneVar.g;

// Wide layout: files and processes in one row, the shell above, the terminal below.
const WW = 760, WH = 306;
const row = { y: 116, h: 60 };
const widths = [96, 36, 96, 70, 96, 70, 96, 36, 96];   // file, gap, awk, pipe, sort, pipe, uniq, gap, report
const total = widths.reduce((a, b) => a + b, 0);
const left = (WW - total) / 2;
const xs = widths.map((_, i) => left + widths.slice(0, i).reduce((a, b) => a + b, 0));
const P = [2, 4, 6].map((i) => ({ x: xs[i], w: widths[i] }));
const fileX = xs[0], outX = xs[8];
const pipeX = [3, 5].map((i) => ({ x: xs[i], w: widths[i] }));
if (left < 8) throw new Error('wide row does not fit');
// Label widths: f-label 7.5 px, f-small 6.5 px, monospace f-small 7.5 px.
for (const p of procs) if (p.length * 9 > 96 - 24) throw new Error(`process label ${p}`);
if (t.pipe.length * 6.5 > 70 - 16) throw new Error('pipe label');
if (t.shellSub.length * 6.5 > P[2].x + P[2].w - P[0].x - 20) throw new Error('shell sub');
if (cmd.length * 7.5 > WW - 20) throw new Error('command line');

// Narrow layout: one column, the terminal on the right.
const NW = 360, NH = 560;
const col = { x: 30, w: 186 };
const term = { x: 262, w: 88 };
const ny = { shell: 54, file: 128, p0: 194, pipe0: 270, p1: 312, pipe1: 388, p2: 430, out: 506 };
const nh = { box: 52, file: 34, pipe: 24 };
for (const p of procs) if (p.length * 9.6 > col.w - 70) throw new Error(`narrow process ${p}`);
if (t.shellSubN.length * 7.3 > NW - 40) throw new Error('narrow shell sub');
if (t.termN.length * 8 > term.w - 10) throw new Error('narrow terminal label');
if (ny.out + nh.file > NH - 8) throw new Error('narrow height');
const caption = ru
    ? "Конвейер awk '$9 >= 500 {print $7}' < access.log | sort | uniq -c > report.txt. Командная оболочка создаёт два канала и порождает три процесса (1). Перед exec каждый потомок перенастраивает свои дескрипторы: у awk fd 0 становится файлом access.log (2), а fd 1 — концом первого канала для записи, чей конец для чтения становится fd 0 у sort (3); так же второй канал соединяет sort и uniq (4), а fd 1 у uniq — файл report.txt (5). Дескриптор 2 никто не трогал, поэтому сообщения об ошибках всех трёх идут прямо в терминал (6). Процессы работают одновременно; оболочка ждёт их всех, и статус конвейера — статус последней команды (7)."
    : "The pipeline awk '$9 >= 500 {print $7}' < access.log | sort | uniq -c > report.txt. The shell creates two pipes and forks three processes (1). Before exec, each child rearranges its descriptors: awk's fd 0 becomes the file access.log (2) and its fd 1 the write end of the first pipe, whose read end becomes fd 0 of sort (3); the second pipe joins sort to uniq in the same way (4), and fd 1 of uniq is the file report.txt (5). Nobody touched descriptor 2, so the error messages of all three go straight to the terminal (6). The processes run at the same time; the shell waits for all of them, and the status of the pipeline is that of its last command (7).";
const id = 'pipeline-fds';
---

<Figure
  id={id}
  title={ru ? 'Конвейер из трёх процессов и их файловые дескрипторы' : 'A pipeline of three processes and their file descriptors'}
  caption={caption}
>
  <svg class="fig-wide fig-bp-640" viewBox={`0 0 ${WW} ${WH}`} role="img" aria-labelledby={`${id}-760-t ${id}-760-d`}>
    <title id={`${id}-760-t`}>{ru ? 'Процессы awk, sort и uniq, соединённые каналами' : 'The processes awk, sort and uniq joined by pipes'}</title>
    <desc id={`${id}-760-d`}>{ru
      ? 'Сверху блок bash со стрелками вниз к трём процессам. В ряд: файл access.log, стрелка в fd 0 процесса awk, из его fd 1 через канал в fd 0 процесса sort, из его fd 1 через второй канал в fd 0 процесса uniq -c, из его fd 1 в файл report.txt. Снизу блок терминала, к которому пунктиром идут стрелки от fd 2 всех трёх процессов.'
      : 'At the top a bash box with arrows down to three processes. In a row: the file access.log, an arrow into fd 0 of awk, from its fd 1 through a pipe into fd 0 of sort, from its fd 1 through a second pipe into fd 0 of uniq -c, and from its fd 1 into the file report.txt. At the bottom a terminal box, reached by dashed arrows from fd 2 of all three processes.'}</desc>
    <text class="f-small" x={WW / 2} y={18} text-anchor="middle" style="font-family: var(--mono)">{cmd}</text>
    <g data-s="1 7">
      <rect x={P[0].x} y={30} width={P[2].x + P[2].w - P[0].x} height={44} rx="7" style={`fill: var(--paper-strong); stroke: var(--line); stroke-width: 1.3`} />
      <text class="f-label" x={P[0].x + 14} y={57} style="font-weight: 650">{t.shell}</text>
      <text class="f-small f-t-muted" x={P[0].x + 64} y={56.5} style="font-family: var(--mono)">{t.shellSub}</text>
      <Badge x={P[0].x + 2} y={32} n={1} />
      <Badge x={P[2].x + P[2].w - 2} y={32} n={7} />
      {P.map((p) => <path class="f-line f-muted f-dash" d={`M ${p.x + p.w / 2} 75 V ${row.y - 3}`} marker-end="url(#f-arrow-muted)" />)}
    </g>
    {P.map((p, i) => (
      <g data-s="1">
        <rect x={p.x} y={row.y} width={p.w} height={row.h} rx="7" style={`fill: ${blue}; fill-opacity: 0.12; stroke: ${blue}; stroke-width: 1.3`} />
        <text class="f-label" x={p.x + p.w / 2} y={row.y + 30} text-anchor="middle" style="font-family: var(--mono)">{procs[i]}</text>
        <text class="f-small f-t-muted" x={p.x + 6} y={row.y + 34}>0</text>
        <text class="f-small f-t-muted" x={p.x + p.w - 6} y={row.y + 34} text-anchor="end">1</text>
        <text class="f-small f-t-muted" x={p.x + p.w / 2} y={row.y + row.h - 6} text-anchor="middle">2</text>
      </g>
    ))}
    <g data-s="2">
      <rect x={fileX} y={row.y + 10} width={96} height={40} rx="4" style={`fill: ${green}; fill-opacity: 0.12; stroke: ${green}; stroke-width: 1.3`} />
      <text class="f-small" x={fileX + 48} y={row.y + 34.5} text-anchor="middle" style="font-family: var(--mono)">{t.file}</text>
      <path class="f-line f-green" d={`M ${fileX + 96} ${row.y + 30} H ${P[0].x - 2}`} marker-end="url(#f-arrow-green)" />
      <Badge x={fileX + 2} y={row.y + 12} n={2} />
    </g>
    {pipeX.map((q, i) => (
      <g data-s={String(i + 3)}>
        <path class="f-line" d={`M ${q.x} ${row.y + 30} H ${q.x + 10}`} />
        <rect x={q.x + 10} y={row.y + 19} width={q.w - 20} height={22} rx="11" style={`fill: ${amber}; fill-opacity: 0.16; stroke: ${amber}; stroke-width: 1.3`} />
        <text class="f-small" x={q.x + q.w / 2} y={row.y + 34.5} text-anchor="middle">{t.pipe}</text>
        <path class="f-line" d={`M ${q.x + q.w - 10} ${row.y + 30} H ${q.x + q.w - 2}`} marker-end="url(#f-arrow)" />
        <Badge x={q.x + q.w / 2} y={row.y + 6} n={i + 3} />
      </g>
    ))}
    <g data-s="5">
      <path class="f-line f-red" d={`M ${P[2].x + P[2].w} ${row.y + 30} H ${outX - 2}`} marker-end="url(#f-arrow-red)" />
      <rect x={outX} y={row.y + 10} width={96} height={40} rx="4" style={`fill: ${red}; fill-opacity: 0.12; stroke: ${red}; stroke-width: 1.3`} />
      <text class="f-small" x={outX + 48} y={row.y + 34.5} text-anchor="middle" style="font-family: var(--mono)">{t.out}</text>
      <Badge x={outX + 94} y={row.y + 12} n={5} />
    </g>
    <g data-s="6">
      {P.map((p) => <path class="f-line f-red f-dash" d={`M ${p.x + p.w / 2} ${row.y + row.h} V ${244}`} marker-end="url(#f-arrow-red)" />)}
      <rect x={P[0].x} y={246} width={P[2].x + P[2].w - P[0].x} height={44} rx="7" style={`fill: var(--paper-strong); stroke: var(--line); stroke-width: 1.3`} />
      <text class="f-label" x={P[0].x + 14} y={273} style="font-weight: 650">{t.term}</text>
      <text class="f-small f-t-muted" x={P[2].x + P[2].w - 14} y={272.5} text-anchor="end">{t.termSub}</text>
      <Badge x={P[0].x + 2} y={248} n={6} />
    </g>
  </svg>

  <svg class="fig-narrow seq-narrow fig-bp-640" viewBox={`0 0 ${NW} ${NH}`} role="img" aria-labelledby={`${id}-360-t ${id}-360-d`}>
    <title id={`${id}-360-t`}>{ru ? 'Процессы awk, sort и uniq, соединённые каналами' : 'The processes awk, sort and uniq joined by pipes'}</title>
    <desc id={`${id}-360-d`}>{ru
      ? 'Сверху блок bash. Ниже столбец: файл access.log, процесс awk, канал, процесс sort, канал, процесс uniq -c, файл report.txt; стрелки идут сверху вниз из fd 1 одного процесса в fd 0 следующего. Справа высокий блок терминала, к которому пунктиром идут стрелки от fd 2 всех трёх процессов.'
      : 'At the top a bash box. Below it a column: the file access.log, the process awk, a pipe, the process sort, a pipe, the process uniq -c, the file report.txt; arrows run down from fd 1 of one process into fd 0 of the next. On the right a tall terminal box, reached by dashed arrows from fd 2 of all three processes.'}</desc>
    <g data-s="1 7">
      <rect x={col.x} y={10} width={term.x + term.w - col.x} height={58} rx="7" style={`fill: var(--paper-strong); stroke: var(--line); stroke-width: 1.3`} />
      <text class="f-label" x={col.x + 26} y={34} style="font-weight: 650">{t.shell}</text>
      <text class="f-small f-t-muted" x={col.x + 26} y={56} style="font-family: var(--mono)">{t.shellSubN}</text>
      <Badge x={col.x} y={12} n={1} />
      <Badge x={term.x + term.w} y={12} n={7} />
    </g>
    <g data-s="2">
      <rect x={col.x + 30} y={ny.file} width={col.w - 60} height={nh.file} rx="4" style={`fill: ${green}; fill-opacity: 0.12; stroke: ${green}; stroke-width: 1.3`} />
      <text class="f-small" x={col.x + col.w / 2} y={ny.file + 22} text-anchor="middle" style="font-family: var(--mono)">{t.file}</text>
      <path class="f-line f-green" d={`M ${col.x + col.w / 2} ${ny.file + nh.file} V ${ny.p0 - 2}`} marker-end="url(#f-arrow-green)" />
      <Badge x={col.x + 30} y={ny.file} n={2} />
    </g>
    {[ny.p0, ny.p1, ny.p2].map((y, i) => (
      <g data-s="1">
        <rect x={col.x} y={y} width={col.w} height={nh.box} rx="7" style={`fill: ${blue}; fill-opacity: 0.12; stroke: ${blue}; stroke-width: 1.3`} />
        <text class="f-label" x={col.x + col.w / 2} y={y + 32} text-anchor="middle" style="font-family: var(--mono)">{procs[i]}</text>
        <text class="f-small f-t-muted" x={col.x + 10} y={y + 18}>0</text>
        <text class="f-small f-t-muted" x={col.x + 10} y={y + nh.box - 7}>1</text>
        <text class="f-small f-t-muted" x={col.x + col.w - 10} y={y + 31} text-anchor="end">2</text>
      </g>
    ))}
    {[ny.pipe0, ny.pipe1].map((y, i) => (
      <g data-s={String(i + 3)}>
        <path class="f-line" d={`M ${col.x + col.w / 2} ${y - 24} V ${y}`} />
        <rect x={col.x + 40} y={y} width={col.w - 80} height={nh.pipe} rx="12" style={`fill: ${amber}; fill-opacity: 0.16; stroke: ${amber}; stroke-width: 1.3`} />
        <text class="f-small" x={col.x + col.w / 2} y={y + 17} text-anchor="middle">{t.pipe}</text>
        <path class="f-line" d={`M ${col.x + col.w / 2} ${y + nh.pipe} V ${y + nh.pipe + 16}`} marker-end="url(#f-arrow)" />
        <Badge x={col.x + 40} y={y + nh.pipe / 2} n={i + 3} />
      </g>
    ))}
    <g data-s="5">
      <path class="f-line f-red" d={`M ${col.x + col.w / 2} ${ny.p2 + nh.box} V ${ny.out - 2}`} marker-end="url(#f-arrow-red)" />
      <rect x={col.x + 30} y={ny.out} width={col.w - 60} height={nh.file} rx="4" style={`fill: ${red}; fill-opacity: 0.12; stroke: ${red}; stroke-width: 1.3`} />
      <text class="f-small" x={col.x + col.w / 2} y={ny.out + 22} text-anchor="middle" style="font-family: var(--mono)">{t.out}</text>
      <Badge x={col.x + 30} y={ny.out} n={5} />
    </g>
    <g data-s="6">
      {[ny.p0, ny.p1, ny.p2].map((y) => <path class="f-line f-red f-dash" d={`M ${col.x + col.w} ${y + nh.box / 2} H ${term.x - 2}`} marker-end="url(#f-arrow-red)" />)}
      <rect x={term.x} y={ny.p0 - 10} width={term.w} height={ny.p2 + nh.box + 10 - (ny.p0 - 10)} rx="7" style={`fill: var(--paper-strong); stroke: var(--line); stroke-width: 1.3`} />
      <text class="f-label" x={term.x + term.w / 2} y={ny.pipe0 + 4} text-anchor="middle" style="font-weight: 650">{t.termN}</text>
      <text class="f-small f-t-muted" x={term.x + term.w / 2} y={ny.pipe0 + 26} text-anchor="middle">fd 2</text>
      <Badge x={term.x + term.w} y={ny.p0 - 10} n={6} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
