---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar, type Tone } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The control flow of `for n in items: ... else: ...` with break and continue, as CPython 3.14 compiles it:
// GET_ITER once, then FOR_ITER on every pass; FOR_ITER jumps past the loop body when the iterator is exhausted.
// The worked example of the note: for n in (9, 14, 7) stops at 14 by break, so the else block is skipped.
const items = [9, 14, 7];
const firstEven = items.findIndex((n) => n % 2 === 0);
if (firstEven !== 1) throw new Error('the first even number is the second item');

type Key = 'iter' | 'next' | 'body' | 'else' | 'after';
interface Node { key: Key; tone: Tone; title: string; sub: string; mono: boolean; step: number }
const nodes: Node[] = ru
  ? [
      { key: 'iter', tone: 'x', title: 'iter(items)', sub: 'итератор, один раз', mono: true, step: 1 },
      { key: 'next', tone: 'g', title: 'next(итератор)', sub: 'есть ещё элемент?', mono: true, step: 2 },
      { key: 'body', tone: 'h', title: 'тело цикла', sub: 'n связано с элементом', mono: false, step: 3 },
      { key: 'else', tone: 'h', title: 'блок else', sub: 'если не было break', mono: false, step: 6 },
      { key: 'after', tone: 'y', title: 'после цикла', sub: 'следующий оператор', mono: false, step: 7 },
    ]
  : [
      { key: 'iter', tone: 'x', title: 'iter(items)', sub: 'an iterator, once', mono: true, step: 1 },
      { key: 'next', tone: 'g', title: 'next(iterator)', sub: 'another item?', mono: true, step: 2 },
      { key: 'body', tone: 'h', title: 'the body', sub: 'n bound to the item', mono: false, step: 3 },
      { key: 'else', tone: 'h', title: 'else block', sub: 'only if no break ran', mono: false, step: 6 },
      { key: 'after', tone: 'y', title: 'after the loop', sub: 'the next statement', mono: false, step: 7 },
    ];
const lab = ru
  ? { item: 'есть: n = элемент', back: 'конец тела или continue', none: 'элементов нет', brk: 'break' }
  : { item: 'an item: n = it', back: 'body ends, or continue', none: 'no items left', brk: 'break' };
const steps = ru
  ? ['iter() вызывается один раз и даёт итератор', 'next() просит следующий элемент', 'элемент есть: n связывается с ним, выполняется тело', 'конец тела или continue: снова next()', 'break выходит из цикла, пропуская else', 'элементов нет: выполняется блок else', 'выполнение продолжается после цикла']
  : ['iter() is called once and returns an iterator', 'next() asks for the next item', 'there is one: n is bound to it and the body runs', 'the body ends, or continue: back to next()', 'break leaves the loop and skips the else block', 'no items left: the else block runs', 'execution continues after the loop'];

type Box = { x: number; y: number; w: number; h: number };
interface Layout { cls: string; W: number; H: number; box: Record<Key, Box>; mono: number; sans: number; narrow: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 356, mono: 7.5, sans: 6.5, narrow: false, box: {
    iter: { x: 50, y: 18, w: 200, h: 50 }, next: { x: 50, y: 112, w: 200, h: 50 }, body: { x: 430, y: 106, w: 220, h: 62 },
    else: { x: 50, y: 210, w: 200, h: 50 }, after: { x: 430, y: 290, w: 220, h: 50 } } },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 400, mono: 8.4, sans: 7.3, narrow: true, box: {
    iter: { x: 30, y: 16, w: 200, h: 52 }, next: { x: 30, y: 104, w: 200, h: 52 }, body: { x: 30, y: 206, w: 200, h: 56 },
    else: { x: 244, y: 206, w: 108, h: 62 }, after: { x: 30, y: 330, w: 322, h: 52 } } },
];
// Label fit: every title and subtitle inside its box, every arrow label inside the viewBox.
for (const L of layouts) {
  for (const n of nodes) {
    const b = L.box[n.key];
    const tw = n.title.length * (n.mono ? L.mono : L.sans), sw = n.sub.length * L.sans;
    if (L.narrow && n.key === 'else') {
      // the narrow else box is small: its subtitle wraps onto two lines (split at the middle space)
      const words = n.sub.split(' '), half = Math.ceil(words.length / 2);
      const lines = [words.slice(0, half).join(' '), words.slice(half).join(' ')];
      for (const s of [n.title, ...lines]) if (s.length * L.sans > b.w - 12) throw new Error(`"${s}" overflows the narrow else box`);
    } else if (Math.max(tw, sw) > b.w - 16) throw new Error(`"${n.title}" / "${n.sub}" overflows at ${L.W}`);
  }
}
{ const g = layouts[0].box.body.x - (layouts[0].box.next.x + layouts[0].box.next.w) - 16;
  if (lab.item.length * 6.5 > g || lab.back.length * 6.5 > g) throw new Error('wide arrow labels overflow the gap'); }
if (lab.none.length * 7.3 + 238 > 358) throw new Error('narrow "no items" label overflows');
const id = 'loop-flow';
---

<Figure
  id={id}
  title={ru ? 'Как выполняется цикл for с break, continue и else' : 'How a for loop runs, with break, continue and else'}
  caption={ru
    ? 'Цикл for n in items: … else: …. Python один раз получает итератор (1) и затем перед каждым проходом просит у него следующий элемент (2). Если элемент есть, n связывается с ним и выполняется тело (3); конец тела или continue возвращают к шагу 2 (4). break выходит из цикла сразу, минуя else (5). Блок else выполняется, только когда элементы кончились (6). В примере заметки for n in (9, 14, 7) находит 14, выходит по break, и else не выполняется.'
    : 'The loop for n in items: … else: …. Python gets an iterator once (1) and then, before each pass, asks it for the next item (2). If there is one, n is bound to it and the body runs (3); the end of the body, or continue, goes back to step 2 (4). break leaves the loop at once, past the else block (5). The else block runs only when the items have run out (6). In the example of the note, for n in (9, 14, 7) finds 14 and leaves by break, so the else block does not run.'}
>
  {layouts.map((L) => {
    const B = L.box;
    const mid = (b: Box) => b.x + b.w / 2;
    const sub2 = (n: Node) => {
      const words = n.sub.split(' '), half = Math.ceil(words.length / 2);
      return [words.slice(0, half).join(' '), words.slice(half).join(' ')];
    };
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Блок-схема цикла for' : 'Flow chart of a for loop'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Блоки: iter(items), next(итератор), тело цикла, блок else и «после цикла». От next стрелка «есть» ведёт к телу, от тела стрелка обратно к next, стрелка break ведёт из тела прямо за цикл, а стрелка «элементов нет» — к блоку else и затем за цикл.'
          : 'Boxes: iter(items), next(iterator), the body, the else block, and after the loop. From next, an arrow labelled an item leads to the body; from the body an arrow leads back to next; a break arrow leads from the body straight past the loop; and a no-items-left arrow leads to the else block and then past the loop.'}</desc>
        {nodes.map((n) => {
          const b = B[n.key];
          const two = L.narrow && n.key === 'else';
          return (
            <g data-s={String(n.step)}>
              <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="8" style={`fill: ${toneVar[n.tone]}; fill-opacity: 0.12; stroke: ${toneVar[n.tone]}; stroke-width: 1.3`} />
              <text class="f-small" x={mid(b)} y={b.y + 21} text-anchor="middle" style={n.mono ? 'font-family: var(--mono); font-weight: 650' : 'font-weight: 650'}>{n.title}</text>
              {two
                ? sub2(n).map((s, i) => <text class="f-small f-t-muted" x={mid(b)} y={b.y + 36 + i * 16} text-anchor="middle">{s}</text>)
                : <text class="f-small f-t-muted" x={mid(b)} y={b.y + 40} text-anchor="middle">{n.sub}</text>}
              <Badge x={b.x} y={b.y} n={n.step} />
            </g>
          );
        })}
        <path data-s="1" class="f-line f-muted" d={`M ${mid(B.iter)} ${B.iter.y + B.iter.h + 2} V ${B.next.y - 3}`} marker-end="url(#f-arrow-muted)" />
        {!L.narrow && (
          <g>
            <g data-s="3">
              <path class="f-line f-green" d={`M ${B.next.x + B.next.w + 2} ${B.next.y + 16} H ${B.body.x - 3}`} marker-end="url(#f-arrow-green)" />
              <text class="f-small f-t-green f-halo" x={(B.next.x + B.next.w + B.body.x) / 2} y={B.next.y + 9} text-anchor="middle">{lab.item}</text>
            </g>
            <g data-s="4">
              <path class="f-line f-blue" d={`M ${B.body.x - 2} ${B.next.y + 36} H ${B.next.x + B.next.w + 3}`} marker-end="url(#f-arrow-blue)" />
              <text class="f-small f-t-blue f-halo" x={(B.next.x + B.next.w + B.body.x) / 2} y={B.next.y + 54} text-anchor="middle">{lab.back}</text>
              <Badge x={(B.next.x + B.next.w + B.body.x) / 2} y={B.next.y + 70} n={4} />
            </g>
            <g data-s="5">
              <path class="f-line f-red" d={`M ${mid(B.body)} ${B.body.y + B.body.h + 2} V ${B.after.y - 3}`} marker-end="url(#f-arrow-red)" />
              <text class="f-small f-t-red f-halo" x={mid(B.body) + 10} y={(B.body.y + B.body.h + B.after.y) / 2 + 4} style="font-weight: 650">{lab.brk}</text>
              <Badge x={mid(B.body) - 18} y={(B.body.y + B.body.h + B.after.y) / 2} n={5} />
            </g>
            <g data-s="6">
              <path class="f-line f-muted" d={`M ${mid(B.next)} ${B.next.y + B.next.h + 2} V ${B.else.y - 3}`} marker-end="url(#f-arrow-muted)" />
              <text class="f-small f-t-muted f-halo" x={mid(B.next) + 10} y={(B.next.y + B.next.h + B.else.y) / 2 + 4}>{lab.none}</text>
              <path class="f-line f-muted" d={`M ${mid(B.else)} ${B.else.y + B.else.h + 2} V ${B.after.y + B.after.h / 2} H ${B.after.x - 3}`} marker-end="url(#f-arrow-muted)" />
            </g>
          </g>
        )}
        {L.narrow && (
          <g>
            <g data-s="3">
              <path class="f-line f-green" d={`M ${mid(B.next) - 40} ${B.next.y + B.next.h + 2} V ${B.body.y - 3}`} marker-end="url(#f-arrow-green)" />
              <text class="f-small f-t-green f-halo" x={mid(B.next) - 32} y={(B.next.y + B.next.h + B.body.y) / 2 + 5}>{lab.item}</text>
            </g>
            <g data-s="4">
              <path class="f-line f-blue" d={`M ${B.body.x - 2} ${B.body.y + B.body.h / 2} H ${B.body.x - 18} V ${B.next.y + B.next.h / 2} H ${B.next.x - 3}`} marker-end="url(#f-arrow-blue)" />
              <Badge x={B.body.x - 18} y={(B.next.y + B.next.h / 2 + B.body.y + B.body.h / 2) / 2} n={4} />
            </g>
            <g data-s="5">
              <path class="f-line f-red" d={`M ${mid(B.body)} ${B.body.y + B.body.h + 2} V ${B.after.y - 3}`} marker-end="url(#f-arrow-red)" />
              <text class="f-small f-t-red f-halo" x={mid(B.body) + 10} y={(B.body.y + B.body.h + B.after.y) / 2 + 5} style="font-weight: 650">{lab.brk}</text>
              <Badge x={mid(B.body) - 18} y={(B.body.y + B.body.h + B.after.y) / 2} n={5} />
            </g>
            <g data-s="6">
              <path class="f-line f-muted" d={`M ${B.next.x + B.next.w + 2} ${B.next.y + B.next.h / 2} H ${mid(B.else)} V ${B.else.y - 3}`} marker-end="url(#f-arrow-muted)" />
              <text class="f-small f-t-muted f-halo" x={B.next.x + B.next.w + 8} y={B.next.y + B.next.h / 2 - 8}>{lab.none}</text>
              <path class="f-line f-muted" d={`M ${mid(B.else)} ${B.else.y + B.else.h + 2} V ${B.after.y - 3}`} marker-end="url(#f-arrow-muted)" />
            </g>
          </g>
        )}
      </svg>
    );
  })}
  <Stepper steps={steps} />
</Figure>
