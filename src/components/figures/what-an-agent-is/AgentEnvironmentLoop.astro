---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One turn of the loop in the two-square vacuum world of the note: the agent stands in A, A is dirty,
// and its counter k (steps since it left B) goes from 2 to 3.
const k0 = 2, k1 = k0 + 1;
if (k1 !== 3) throw new Error('AgentEnvironmentLoop: the counter of the example drifted');

const t = ru
  ? {
      title: 'Один оборот цикла «агент–среда»',
      env: 'среда', agent: 'агент', sNow: 'агент в A; A грязная, B чистая', sNext: 'A чистая; B может загрязниться',
      trans: 'P(s_{t+1} | s_t, a_t)', perc1: 'восприятие o_t', perc2: '= (A, грязно)', act1: 'действие a_t', act2: '= Suck',
      upd: 'обновление', updSub: `k: ${k0} → ${k1}`, choose: 'выбор действия', chooseSub: 'грязно → Suck',
      perf: 'мера качества', perfSub: 'задаёт проектировщик, а не агент',
      steps: ['восприятие: датчики сообщают (A, грязно)', 'обновление: программа агента учитывает восприятие в своём состоянии', 'выбор: клетка грязная, значит Suck', 'действие: среда переходит в следующее состояние, на B может появиться грязь', 'оценка: мера качества ставит число всей последовательности состояний среды'],
      desc: 'Слева среда: её состояние s_t (агент в A, A грязная) и следующее состояние s_{t+1}, в которое она переходит с вероятностью P(s_{t+1} | s_t, a_t). Справа программа агента: блок обновления внутреннего состояния (счётчик k с 2 до 3) и блок выбора действия (грязно, значит Suck). Восприятие (A, грязно) идёт от среды к агенту, действие Suck — от агента к среде. Под средой — мера качества, которую задаёт проектировщик.',
    }
  : {
      title: 'One turn of the agent–environment loop',
      env: 'environment', agent: 'agent', sNow: 'agent in A; A dirty, B clean', sNext: 'A clean; B may get dirty',
      trans: 'P(s_{t+1} | s_t, a_t)', perc1: 'percept o_t', perc2: '= (A, dirty)', act1: 'action a_t', act2: '= Suck',
      upd: 'update state', updSub: `k: ${k0} → ${k1}`, choose: 'choose action', chooseSub: 'dirty → Suck',
      perf: 'performance measure', perfSub: 'set by the designer, not the agent',
      steps: ['percept: the sensors report (A, dirty)', 'update: the agent program folds the percept into its state', 'choose: the square is dirty, so Suck', 'act: the environment moves to its next state; dirt may appear on B', 'score: the performance measure rates the sequence of environment states'],
      desc: 'On the left the environment: its state s_t (agent in A, A dirty) and the next state s_{t+1}, reached with probability P(s_{t+1} | s_t, a_t). On the right the agent program: a box that updates the internal state (the counter k goes from 2 to 3) and a box that chooses the action (dirty, so Suck). The percept (A, dirty) goes from the environment to the agent, the action Suck from the agent to the environment. Below the environment, the performance measure set by the designer.',
    };
const id = 'agent-environment-loop';
const caption = ru
  ? 'Агент и среда обмениваются только восприятиями и действиями. Программа агента видит текущее восприятие и собственное внутреннее состояние, но не состояние среды; здесь внутреннее состояние — счётчик k шагов с тех пор, как агент ушёл из B. Переход среды может быть случайным: после действия каждая чистая клетка загрязняется с вероятностью p. Мера качества находится вне агента: она оценивает состояния, через которые прошла среда, и именно её математическое ожидание агент должен максимизировать.'
  : 'The agent and the environment exchange only percepts and actions. The agent program sees the current percept and its own internal state, not the state of the environment; here the internal state is the counter k of steps since the agent left B. The transition of the environment can be random: after the action, a clean square gets dirty with probability p. The performance measure sits outside the agent: it rates the states the environment went through, and it is what the agent should maximize in expectation.';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 300" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <rect class="f-box-soft" x="16" y="30" width="270" height="200" rx="10" />
    <text class="f-small f-t-muted" x="28" y="50">{t.env}</text>
    <rect class="f-box-soft" x="446" y="30" width="298" height="200" rx="10" />
    <text class="f-small f-t-muted" x="458" y="50">{t.agent}</text>
    <Box x={40} y={64} w={222} h={46} label="s_t" sub={t.sNow} tone="h" />
    <g data-s="1">
      <Arrow pts={[[262, 87], [462, 87]]} tone="green" />
      <text class="f-small f-t-green" x="365" y="78" text-anchor="middle"><tspan>{t.perc1.replace('o_t', 'o')}</tspan><tspan baseline-shift="sub" font-size="0.72em">t</tspan></text>
      <text class="f-small f-t-green" x="365" y="106" text-anchor="middle">{t.perc2}</text>
      <Badge x={304} y={74} n={1} />
    </g>
    <g data-s="2">
      <Box x={466} y={64} w={124} h={46} label={t.upd} sub={t.updSub} tone="g" />
      <Badge x={528} y={134} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[590, 87], [602, 87]]} />
      <Box x={604} y={64} w={124} h={46} label={t.choose} sub={t.chooseSub} tone="g" />
      <Badge x={640} y={134} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[700, 110], [700, 185], [264, 185]]} tone="red" />
      <text class="f-small f-t-red" x="365" y="176" text-anchor="middle"><tspan>{t.act1.replace('a_t', 'a')}</tspan><tspan baseline-shift="sub" font-size="0.72em">t</tspan></text>
      <text class="f-small f-t-red" x="365" y="204" text-anchor="middle">{t.act2}</text>
      <Arrow pts={[[151, 110], [151, 160]]} tone="amber" label={t.trans} at={[160, 142]} labelTone="g" />
      <Box x={40} y={162} w={222} h={46} label="s_{t+1}" sub={t.sNext} tone="h" />
      <Badge x={304} y={172} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[151, 230], [151, 248]]} dashed />
      <Box x={16} y={250} w={270} h={46} label={t.perf} sub={t.perfSub} />
      <Badge x={304} y={273} n={5} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 480" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <g data-s="5">
      <Box x={16} y={8} w={328} h={46} label={t.perf} sub={t.perfSub} />
      <Arrow pts={[[180, 76], [180, 58]]} dashed />
      <Badge x={34} y={31} n={5} />
    </g>
    <rect class="f-box-soft" x="16" y="76" width="328" height="180" rx="10" />
    <text class="f-small f-t-muted" x="28" y="94">{t.env}</text>
    <Box x={40} y={102} w={280} h={44} label="s_t" sub={t.sNow} tone="h" />
    <g data-s="4">
      <Arrow pts={[[180, 146], [180, 186]]} tone="amber" label={t.trans} at={[190, 172]} labelTone="g" />
      <Box x={40} y={188} w={280} h={44} label="s_{t+1}" sub={t.sNext} tone="h" />
      <Arrow pts={[[290, 382], [290, 236]]} tone="red" />
      <text class="f-small f-t-red" x="282" y="322" text-anchor="end"><tspan>{t.act1.replace('a_t', 'a')}</tspan><tspan baseline-shift="sub" font-size="0.72em">t</tspan></text>
      <text class="f-small f-t-red" x="282" y="340" text-anchor="end">{t.act2}</text>
      <Badge x={310} y={331} n={4} />
    </g>
    <g data-s="1">
      <Arrow pts={[[100, 256], [100, 378]]} tone="green" />
      <text class="f-small f-t-green" x="108" y="282"><tspan>{t.perc1.replace('o_t', 'o')}</tspan><tspan baseline-shift="sub" font-size="0.72em">t</tspan></text>
      <text class="f-small f-t-green" x="108" y="300">{t.perc2}</text>
      <Badge x={80} y={291} n={1} />
    </g>
    <rect class="f-box-soft" x="16" y="352" width="328" height="122" rx="10" />
    <text class="f-small f-t-muted" x="28" y="370">{t.agent}</text>
    <g data-s="2">
      <Box x={24} y={380} w={152} h={50} label={t.upd} sub={t.updSub} tone="g" />
      <Badge x={100} y={452} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[176, 405], [182, 405]]} />
      <Box x={184} y={380} w={152} h={50} label={t.choose} sub={t.chooseSub} tone="g" />
      <Badge x={260} y={452} n={3} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
