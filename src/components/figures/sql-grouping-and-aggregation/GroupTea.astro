---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? 'Три позиции образуют одну группу' : 'Three lines form one group';
const caption = ru
  ? 'Группировка собирает позиции чая. Каждый агрегат получает те же три строки и вычисляет своё значение.'
  : 'Grouping collects the tea lines. Each aggregate receives the same three rows and computes its own value.';
const desc = ru
  ? 'Строки 101/1, 102/1 и 103/2 дают одну строку чая с тремя позициями, четырьмя единицами и 1400 копейками.'
  : 'Lines 101/1, 102/1 and 103/2 give one row for tea with three lines, four units and 1400 cents.';
const rows = [
  ['101/1', 2, 700],
  ['102/1', 1, 350],
  ['103/2', 1, 350],
] as const;
const units = rows.reduce((total, [, quantity]) => total + quantity, 0);
const cents = rows.reduce((total, [, , amount]) => total + amount, 0);
const labels = ru ? ['Позиции', 'Единицы', 'Копейки'] : ['Lines', 'Units', 'Cents'];
---
<Figure id="sql-group-tea" title={title} caption={caption}>
  <svg viewBox="0 0 340 166" role="img" aria-labelledby="sql-group-tea-title sql-group-tea-desc" style="max-width: 550px; margin-inline: auto">
    <title id="sql-group-tea-title">{title}</title>
    <desc id="sql-group-tea-desc">{desc}</desc>
    <text class="f-label" x="78" y="25" text-anchor="middle">order_lines</text>
    <text class="f-label" x="266" y="25" text-anchor="middle">product = 'tea'</text>
    {rows.map(([line, quantity, amount], i) => (
      <g transform={`translate(0 ${i * 35})`}>
        <rect class="f-fill-blue" x="10" y="39" width="136" height="28" rx="5" />
        <text class="f-label" x="78" y="58" text-anchor="middle">{line} · {quantity} · {amount}</text>
      </g>
    ))}
    <path class="f-line" d="M 150 53 H 164 V 123 H 150 M 150 88 H 193 M 187 82 L 193 88 L 187 94" fill="none" />
    <rect class="f-fill-green" x="201" y="39" width="130" height="98" rx="6" />
    {[rows.length, units, cents].map((value, i) => (
      <text class="f-label" x="266" y={62 + i * 27} text-anchor="middle">{labels[i]} · {value}</text>
    ))}
  </svg>
</Figure>
