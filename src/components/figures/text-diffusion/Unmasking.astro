---
import Figure from '../Figure.astro';

// Confidence-based unmasking: 12 generated positions revealed over 4 steps,
// 3 per step. The reveal order is a fixed illustrative "confidence" ranking.
const n = 12;
const steps = 4;
const perStep = n / steps;
// order[i] = the step at which position i is revealed (0-based)
const revealStep = [0, 2, 1, 0, 3, 1, 2, 0, 3, 1, 2, 3];
const tokens = ['The', 'answer', 'is', '72', 'km', ':', '48', 'plus', '24', 'over', '8', 'hours'];
const cell = 44;
const rowH = 50;

interface Layout { cls: string; w: number; h: number; left: number; top: number; cellW: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', w: 680, h: (steps + 1) * rowH + 50, left: 120, top: 40, cellW: cell },
  { cls: 'fig-narrow', w: 360, h: (steps + 1) * rowH + 50, left: 60, top: 40, cellW: 24 },
];
---

<Figure
  id="confidence-unmasking"
  title="Iterative unmasking: twelve positions revealed over four parallel steps"
  caption={`Each row is one forward pass of the bidirectional model over the whole sequence. At every pass the model predicts a token for every still-masked position; the ${perStep} predictions with the highest probability are kept (blue) and the rest are masked again. After ${steps} passes all ${n} positions are filled. The reveal order is illustrative: in practice short, high-frequency tokens and tokens strongly constrained by the prompt tend to be revealed first. With ${steps} steps for ${n} tokens the model runs ${steps} times instead of ${n}; with ${n} steps it would reveal one token per pass and gain nothing over left-to-right decoding.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`confidence-unmasking-${L.w}-t confidence-unmasking-${L.w}-d`}>
      <title id={`confidence-unmasking-${L.w}-t`}>Confidence-based unmasking over four steps</title>
      <desc id={`confidence-unmasking-${L.w}-d`}>A grid with five rows and twelve columns. The first row is fully masked. In each following row three more cells turn from masked to revealed, showing their tokens, until the last row is a complete sentence.</desc>
      {Array.from({ length: steps + 1 }, (_, s) => (
        <g>
          <text class="f-small f-t-muted" x={L.left - 10} y={L.top + s * rowH + 28} text-anchor="end">{s === 0 ? 'start' : `pass ${s}`}</text>
          {Array.from({ length: n }, (_, i) => {
            const revealed = revealStep[i] < s;
            const justNow = revealStep[i] === s - 1;
            const x = L.left + i * L.cellW;
            return (
              <g>
                <rect class={revealed ? (justNow ? 'f-box f-fill-blue' : 'f-box-soft') : 'f-box-soft f-fill-amber'} x={x} y={L.top + s * rowH} width={L.cellW - 3} height={38} rx="5" />
                <text class={revealed ? (justNow ? 'f-small f-t-blue' : 'f-small') : 'f-small f-t-amber'} x={x + (L.cellW - 3) / 2} y={L.top + s * rowH + 24} text-anchor="middle" font-family="var(--mono)">{revealed ? (L.cls === 'fig-narrow' ? tokens[i].slice(0, 3) : tokens[i]) : '▒'}</text>
              </g>
            );
          })}
        </g>
      ))}
      <text class="f-note" x={L.left} y={L.top + (steps + 1) * rowH + 6}>amber: masked · blue: revealed at this pass · grey: revealed earlier</text>
    </svg>
  ))}
</Figure>
