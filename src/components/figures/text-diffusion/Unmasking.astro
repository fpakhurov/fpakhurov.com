---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Confidence-based unmasking: 12 generated positions revealed over 4 steps,
// 3 per step. The reveal order is a fixed illustrative "confidence" ranking.
const n = 12;
const steps = 4;
const perStep = n / steps;
// revealStep[i] = the step at which position i is revealed (0-based)
const revealStep = [0, 2, 1, 0, 3, 1, 2, 0, 3, 1, 2, 3];
const tokens = ['The', 'answer', 'is', '72', 'km', ':', '48', 'plus', '24', 'over', '8', 'hours'];
const t = ru
  ? { start: 'начало', pass: (s: number) => `проход ${s}`, legend: ['жёлтые: замаскированы', 'синие: открыты на этом проходе', 'серые: открыты раньше'], svgTitle: 'Раскрытие по уверенности за четыре прохода',
      desc: 'Сетка из пяти рядов по двенадцать позиций. Первый ряд полностью замаскирован. В каждом следующем ряду ещё три позиции открываются и показывают свои токены, пока последний ряд не становится законченной фразой.' }
  : { start: 'start', pass: (s: number) => `pass ${s}`, legend: ['amber: masked', 'blue: revealed at this pass', 'grey: revealed earlier'], svgTitle: 'Confidence-based unmasking over four steps',
      desc: 'A grid with five rows of twelve positions. The first row is fully masked. In each following row three more positions turn from masked to revealed, showing their tokens, until the last row is a complete sentence.' };

// Wide: one row of 12 cells per pass. Narrow: two rows of 6 cells per pass.
interface Layout { cls: string; w: number; h: number; left: number; top: number; cellW: number; perRow: number; passH: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', w: 720, h: (steps + 1) * 50 + 50, left: 108, top: 40, cellW: 50, perRow: 12, passH: 50 },
  { cls: 'fig-narrow', w: 360, h: 26 + (steps + 1) * 88 + 46, left: 28, top: 26, cellW: 53, perRow: 6, passH: 88 },
];
---

<Figure
  id="confidence-unmasking"
  title={ru ? 'Итеративное раскрытие: двенадцать позиций за четыре параллельных шага' : 'Iterative unmasking: twelve positions revealed over four parallel steps'}
  caption={ru
    ? `Каждый ряд — один проход двунаправленной модели по всей последовательности. На каждом проходе модель предсказывает токен для каждой ещё замаскированной позиции; ${perStep} предсказания с наибольшей вероятностью сохраняются (синие), остальные снова маскируются. Через ${steps} прохода заполнены все ${n} позиций. Порядок раскрытия условный: на практике первыми обычно открываются короткие частые токены и токены, сильно ограниченные промптом. При ${steps} шагах на ${n} токенов модель запускается ${steps} раза вместо ${n}; при ${n} шагах она открывала бы по одному токену за проход и ничего не выигрывала бы у декодирования слева направо. Сэмплер ноутбука делает то же внутри блоков по 32 позиции, обрабатывая блоки слева направо.`
    : `Each row is one forward pass of the bidirectional model over the whole sequence. At every pass the model predicts a token for every still-masked position; the ${perStep} predictions with the highest probability are kept (blue) and the rest are masked again. After ${steps} passes all ${n} positions are filled. The reveal order is illustrative: in practice short, high-frequency tokens and tokens strongly constrained by the prompt tend to be revealed first. With ${steps} steps for ${n} tokens the model runs ${steps} times instead of ${n}; with ${n} steps it would reveal one token per pass and gain nothing over left-to-right decoding. The notebook's sampler does the same inside blocks of 32 positions, taking the blocks left to right.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`confidence-unmasking-${L.w}-t confidence-unmasking-${L.w}-d`}>
      <title id={`confidence-unmasking-${L.w}-t`}>{t.svgTitle}</title>
      <desc id={`confidence-unmasking-${L.w}-d`}>{t.desc}</desc>
      {Array.from({ length: steps + 1 }, (_, s) => {
        const y0 = L.top + s * L.passH;
        const wide = L.perRow === n;
        return (
          <g>
            {wide
              ? <text class="f-small f-t-muted" x={L.left - 10} y={y0 + 24} text-anchor="end">{s === 0 ? t.start : t.pass(s)}</text>
              : <text class="f-small f-t-muted" x={L.left} y={y0 - 6}>{s === 0 ? t.start : t.pass(s)}</text>}
            {Array.from({ length: n }, (_, i) => {
              const revealed = revealStep[i] < s;
              const justNow = revealStep[i] === s - 1;
              const x = L.left + (i % L.perRow) * L.cellW;
              const y = y0 + Math.floor(i / L.perRow) * 34;
              return (
                <g>
                  <rect class={revealed ? (justNow ? 'f-box f-fill-blue' : 'f-box-soft') : 'f-box-soft f-fill-amber'} x={x} y={y} width={L.cellW - 3} height={wide ? 38 : 30} rx="5" />
                  <text class={revealed ? (justNow ? 'f-small f-t-blue' : 'f-small') : 'f-small f-t-amber'} x={x + (L.cellW - 3) / 2} y={y + (wide ? 24 : 20)} text-anchor="middle" font-family="var(--mono)">{revealed ? tokens[i] : '▒'}</text>
                </g>
              );
            })}
          </g>
        );
      })}
      {L.perRow === n
        ? <text class="f-note" x={L.left} y={L.top + (steps + 1) * L.passH + 6}>{t.legend.join(' · ')}</text>
        : t.legend.map((line, k) => <text class="f-note" x={L.left} y={L.top + (steps + 1) * L.passH - 4 + k * 16}>{line}</text>)}
    </svg>
  ))}
</Figure>
