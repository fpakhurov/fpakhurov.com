---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A trial every Δ time units with success probability λΔ: the waiting time is Δ times a geometric variable,
// and its survival function P(T > t) = (1 − λΔ)^floor(t/Δ) tends to e^(−λt) as Δ → 0. Here λ = 1.
const steps = [0.5, 0.1];
const surv = (d: number, t: number) => (1 - d) ** Math.floor(t / d + 1e-9);
const at1 = steps.map((d) => surv(d, 1));
if ([...at1, Math.exp(-1)].map((v) => v.toFixed(3)).join() !== '0.250,0.349,0.368') throw new Error('GeometricToExponential: values drifted from the note');
const T = 4;
const stairs = (d: number) => {
  const pts: [number, number][] = [];
  for (let k = 0; k * d < T - 1e-9; k++) { const v = (1 - d) ** k; pts.push([k * d, v], [Math.min((k + 1) * d, T), v]); }
  return pts;
};
const curve = Array.from({ length: 81 }, (_, i) => [i * 0.05, Math.exp(-i * 0.05)] as [number, number]);
const id = 'geometric-to-exponential';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 290, x0: 50, x1: 560, y0: 24, y1: 230, legend: [330, 60] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 330, x0: 40, x1: 340, y0: 24, y1: 220, legend: [150, 50] },
];
const t = ru
  ? { axis: 'время t', d: (d: number) => `испытание каждые ${d}`, exp: 'экспонента e^(−t)' }
  : { axis: 'time t', d: (d: number) => `a trial every ${d}`, exp: 'exponential e^(−t)' };
---

<Figure
  id={id}
  title={ru ? 'Показательное распределение — непрерывное геометрическое' : 'The exponential distribution is the continuous geometric'}
  caption={ru
    ? `Вероятность P(T > t) прождать дольше t, если испытание проводится каждые Δ единиц времени с вероятностью успеха Δ (интенсивность 1 успех в единицу времени). При Δ = 0.5 ступенчатая кривая в точке t = 1 равна ${at1[0].toFixed(3)}, при Δ = 0.1 — ${at1[1].toFixed(3)}; в пределе Δ → 0 получается гладкая экспонента e^(−t), в точке 1 — ${Math.exp(-1).toFixed(3)}.`
    : `The probability P(T > t) of waiting longer than t when a trial happens every Δ time units with success probability Δ (a rate of one success per unit time). With Δ = 0.5 the staircase is ${at1[0].toFixed(3)} at t = 1, with Δ = 0.1 it is ${at1[1].toFixed(3)}; in the limit Δ → 0 it becomes the smooth exponential e^(−t), ${Math.exp(-1).toFixed(3)} at t = 1.`}
>
  {layouts.map((L) => {
    const sx = scale([0, T], [L.x0, L.x1]), sy = scale([0, 1], [L.y1, L.y0]);
    const P = (pts: [number, number][]) => polyline(pts.map(([x, y]) => [sx(x), sy(y)]));
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Ступенчатые кривые выживания сходятся к экспоненте' : 'Staircase survival curves converge to the exponential'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Две ступенчатые кривые для шага 0.5 и 0.1 и гладкая экспонента; в точке 1 значения 0.250, 0.349 и 0.368.' : 'Two staircase curves for steps 0.5 and 0.1 and the smooth exponential; at t = 1 the values are 0.250, 0.349 and 0.368.'}</desc>
        {[0, 0.5, 1].map((v) => <g><path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} /><text class="f-note" x={L.x0 - 8} y={sy(v) + 5} text-anchor="end">{v}</text></g>)}
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {[0, 1, 2, 3, 4].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{v}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 42} text-anchor="middle">{t.axis}</text>
        <path class="f-line f-muted" d={P(stairs(0.5))} />
        <path class="f-line f-blue" d={P(stairs(0.1))} />
        <path class="f-line f-red" style="stroke-width: 2.2" d={P(curve)} />
        <path class="f-thin f-muted f-dash" d={`M ${sx(1)} ${L.y1} V ${L.y0}`} />
        {[[t.d(0.5), 'f-muted'], [t.d(0.1), 'f-blue'], [t.exp, 'f-red']].map(([lab, cls], i) => (
          <g>
            <path class={`f-line ${cls}`} d={`M ${L.legend[0]} ${L.legend[1] + i * 22} h 24`} />
            <text class="f-note" x={L.legend[0] + 32} y={L.legend[1] + i * 22 + 5}>{lab}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
