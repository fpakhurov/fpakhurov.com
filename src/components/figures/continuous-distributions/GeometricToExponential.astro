---
// Original computed teaching illustration; Fedor Pakhurov project with Codex assistance.
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const ru=pageLang(Astro.url)==='ru';
const id='geometric-to-exponential';
const point=([x,y]:number[])=>`${48+62*x},${214-176*y}`;
const styles=[{color:'var(--fig-amber)',dash:'6 3'},{color:'var(--fig-green)',dash:'2 3'}];
---
<Figure id={id} title={ru?'Уменьшаем шаг испытаний':'Reducing the trial spacing'} caption={ru?'Интенсивность λ=3/5. Ступени показывают P(TΔ>t) при Δ=0.5 и 0.2; синяя кривая — exp(−3t/5). В моменты испытаний действует нижнее значение ступени. При t=2 значения равны 0.240100, 0.278501 и 0.301194.':'Rate λ=3/5. Steps show P(TΔ>t) for Δ=0.5 and 0.2; the blue curve is exp(−3t/5). At trial times the lower step value applies. At t=2 the values are 0.240100, 0.278501 and 0.301194.'}>
 <div class="layout">
 <svg viewBox="0 0 340 252" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
  <title id={`${id}-title`}>{ru?'Дискретное ожидание приближается к непрерывному':'Discrete waiting approaches continuous waiting'}</title>
  <desc id={`${id}-desc`}>{ru?'Три убывающие кривые начинаются в единице. Ступенчатые кривые приближают гладкую экспоненту. При шаге 0.2 испытания происходят чаще, чем при шаге 0.5. Вертикальная линия отмечает время 2.':'Three decreasing curves start at one. The step curves approximate the smooth exponential. Trials are more frequent with spacing 0.2 than with spacing 0.5. A vertical line marks time 2.'}</desc>
  <path d="M48 25 V214 H310" class="f-axis" />
  <line x1="172" x2="172" y1="38" y2="214" stroke="var(--muted)" stroke-dasharray="3 4" opacity=".5" />
  {cases.exponential.steps.map((s,i)=><polyline data-series={`step-${s.delta}`} points={s.points.map(point).join(' ')} fill="none" stroke={styles[i].color} stroke-dasharray={styles[i].dash} stroke-width="2.2" />)}
  <polyline data-series="limit" points={cases.exponential.limit_grid.map(point).join(' ')} fill="none" stroke="var(--fig-blue)" stroke-width="2.5" />
  {[0,1,2,3,4].map(t=><g><line x1={48+62*t} x2={48+62*t} y1="214" y2="219" class="f-axis" /><text x={48+62*t} y="239" text-anchor="middle">{t}</text></g>)}
  {[0,.5,1].map(y=><text x="37" y={218-176*y} text-anchor="end">{y}</text>)}
  <text x="15" y="19">S(t)</text><text x="318" y="218">t</text>
 </svg>
 <div class="legend" aria-label={ru?'Обозначения':'Legend'}>
  <p><span class="line amber"></span>Δ = 0.5</p>
  <p><span class="line green"></span>Δ = 0.2</p>
  <p><span class="line blue"></span>{ru?'Непрерывный предел':'Continuous limit'}</p>
  <p class="rule">{ru?'Вероятность успеха в одном испытании: λΔ.':'Success probability in one trial: λΔ.'}</p>
 </div>
 </div>
</Figure>
<style>
.layout{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:1.5rem;align-items:center;}
svg{width:100%;height:auto;display:block;max-width:500px;margin:auto;}
text{font:14px system-ui,sans-serif;fill:var(--ink);font-variant-numeric:tabular-nums;}
.legend{color:var(--ink);font-size:.95rem;}.legend p{margin:.6rem 0;}
.line{display:inline-block;width:1.8rem;margin-right:.6rem;vertical-align:middle;border-top:3px solid;}.amber{border-color:var(--fig-amber);border-top-style:dashed;}.green{border-color:var(--fig-green);border-top-style:dotted;}.blue{border-color:var(--fig-blue);}.rule{color:var(--muted);line-height:1.5;}
@media(max-width:700px){.layout{grid-template-columns:1fr;gap:.5rem;}}
</style>
