---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The standard normal: P(-1 < X < 1) as the area under the density and as the rise of the CDF.
// Phi from erf by Abramowitz and Stegun 7.1.26 (absolute error below 1.5e-7).
const erf = (x: number) => {
  const s = Math.sign(x), a = Math.abs(x), t = 1 / (1 + 0.3275911 * a);
  const y = 1 - ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(-a * a);
  return s * y;
};
const Phi = (x: number) => 0.5 * (1 + erf(x / Math.SQRT2));
const phi = (x: number) => Math.exp(-x * x / 2) / Math.sqrt(2 * Math.PI);
const lo = Phi(-1), hi = Phi(1);
if ([lo, hi, hi - lo].map((v) => v.toFixed(3)).join() !== '0.159,0.841,0.683') throw new Error('DensityAndCdf: values drifted from the note');
const xs = Array.from({ length: 141 }, (_, i) => -3.5 + i * 0.05);
const band = xs.filter((x) => Math.abs(x) <= 1 + 1e-9);
const areaPath = (sx: (v: number) => number, sy: (v: number) => number) =>
  `M ${sx(-1)} ${sy(0)} ${band.map((x) => `L ${sx(x).toFixed(1)} ${sy(phi(x)).toFixed(1)}`).join(' ')} L ${sx(1)} ${sy(0)} Z`;
const id = 'density-and-cdf';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 280, a: [40, 30, 340, 200], b: [450, 30, 250, 200] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 560, a: [30, 36, 310, 190], b: [50, 316, 250, 190] },
];
const t = ru
  ? { dens: '(а) плотность f(x)', cdf: '(б) функция распределения F(x)', area: `площадь ${(hi - lo).toFixed(3)}`, rise: `подъём ${(hi - lo).toFixed(3)}` }
  : { dens: '(a) density f(x)', cdf: '(b) distribution function F(x)', area: `area ${(hi - lo).toFixed(3)}`, rise: `rise ${(hi - lo).toFixed(3)}` };
---

<Figure
  id={id}
  title={ru ? 'Одна вероятность как площадь и как подъём' : 'One probability as an area and as a rise'}
  caption={ru
    ? `Стандартное нормальное распределение. (а) Вероятность P(−1 < X < 1) — площадь под плотностью между −1 и 1, ${(hi - lo).toFixed(3)}. (б) Та же вероятность — подъём функции распределения между этими точками: F(1) − F(−1) = ${hi.toFixed(3)} − ${lo.toFixed(3)}. Плотность — производная функции распределения: где плотность высокая, F растёт круто.`
    : `The standard normal distribution. (a) The probability P(−1 < X < 1) is the area under the density between −1 and 1, ${(hi - lo).toFixed(3)}. (b) The same probability is the rise of the distribution function between the two points: F(1) − F(−1) = ${hi.toFixed(3)} − ${lo.toFixed(3)}. The density is the derivative of the distribution function: where the density is high, F climbs steeply.`}
>
  {layouts.map((L) => {
    const [ax, ay, aw, ah] = L.a, [bx, by, bw, bh] = L.b;
    const sxa = scale([-3.5, 3.5], [ax, ax + aw]), sya = scale([0, 0.45], [ay + ah, ay]);
    const sxb = scale([-3.5, 3.5], [bx, bx + bw]), syb = scale([0, 1], [by + bh, by]);
    const area = areaPath(sxa, sya);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Плотность и функция распределения стандартного нормального' : 'Density and distribution function of the standard normal'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? `Колокол плотности с закрашенной областью между −1 и 1 площадью ${(hi - lo).toFixed(3)}; S-образная функция распределения, поднимающаяся от ${lo.toFixed(3)} до ${hi.toFixed(3)} между −1 и 1.` : `The bell-shaped density with the area between −1 and 1 shaded, ${(hi - lo).toFixed(3)}; the S-shaped distribution function rising from ${lo.toFixed(3)} to ${hi.toFixed(3)} between −1 and 1.`}</desc>
        <text class="f-small" x={ax} y={ay - 12}>{t.dens}</text>
        <path d={area} class="f-fill-amber" />
        <path class="f-line f-blue" d={polyline(xs.map((x) => [sxa(x), sya(phi(x))]))} />
        <path class="f-axis" d={`M ${ax} ${ay + ah} H ${ax + aw}`} />
        {[-3, -2, -1, 0, 1, 2, 3].map((v) => <text class="f-note" x={sxa(v)} y={ay + ah + 18} text-anchor="middle">{v}</text>)}
        <text class="f-small f-t-amber f-halo" x={sxa(0)} y={sya(0.12)} text-anchor="middle">{t.area}</text>
        <text class="f-small" x={bx} y={by - 12}>{t.cdf}</text>
        {[0, 0.5, 1].map((v) => <g><path class="f-grid" d={`M ${bx} ${syb(v)} H ${bx + bw}`} /><text class="f-note" x={bx - 8} y={syb(v) + 5} text-anchor="end">{v}</text></g>)}
        <path class="f-line f-blue" d={polyline(xs.map((x) => [sxb(x), syb(Phi(x))]))} />
        <path class="f-axis" d={`M ${bx} ${by + bh} H ${bx + bw}`} />
        {[-3, -2, -1, 0, 1, 2, 3].map((v) => <text class="f-note" x={sxb(v)} y={by + bh + 18} text-anchor="middle">{v}</text>)}
        <path class="f-thin f-muted f-dash" d={`M ${sxb(-1)} ${syb(0)} V ${syb(lo)} H ${sxb(1.6)}`} />
        <path class="f-thin f-muted f-dash" d={`M ${sxb(1)} ${syb(0)} V ${syb(hi)} H ${sxb(1.6)}`} />
        <path class="f-line f-amber" d={`M ${sxb(1.6)} ${syb(lo)} V ${syb(hi)}`} />
        <text class="f-small f-t-amber" x={sxb(1.75)} y={syb((lo + hi) / 2) + 5}>{t.rise}</text>
        <text class="f-note" x={sxb(-1) - 6} y={syb(lo) - 8} text-anchor="end">{lo.toFixed(3)}</text>
        <text class="f-note" x={sxb(1) - 6} y={syb(hi) - 8} text-anchor="end">{hi.toFixed(3)}</text>
      </svg>
    );
  })}
</Figure>
