---
// Original computed teaching illustration; Fedor Pakhurov project with Codex assistance.
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const ru=pageLang(Astro.url)==='ru';
const id='density-and-cdf';
const sx=(x:number)=>48+58*(x+1);
const sy=(y:number,kind:string)=>210-y*(kind==='density'?320:160);
const panels=[{key:'density',label:ru?'Плотность f(x)':'Density f(x)'},{key:'cdf',label:ru?'Накопленная вероятность F(x)':'Cumulative probability F(x)'}];
const area=[[0,0],[0,1/8],[2,3/8],[2,0]].map(([x,y])=>`${sx(x)},${sy(y,'density')}`).join(' ');
---
<Figure id={id} title={ru?'Площадь и прирост вероятности':'Area and accumulated probability'} caption={ru?'Плотность (x+1)/8 на [−1,3]. Закрашенная площадь между 0 и 2 равна 1/2; на CDF ей соответствует прирост с 1/16 до 9/16. Обе панели описывают одну заданную модель.':'Density (x+1)/8 on [−1,3]. The shaded area between 0 and 2 is 1/2; the corresponding CDF increase is from 1/16 to 9/16. Both panels describe the same stipulated model.'}>
  <div class="panels">
    {panels.map(p=><section>
      <h4>{p.label}</h4>
      <svg viewBox="0 0 320 250" role="img" aria-labelledby={`${id}-${p.key}-title ${id}-${p.key}-desc`}>
        <title id={`${id}-${p.key}-title`}>{p.label}</title>
        <desc id={`${id}-${p.key}-desc`}>{p.key==='density'?(ru?'Плотность растёт линейно от 0 до 1/2. Между 0 и 2 закрашена трапеция площадью 1/2.':'Density rises linearly from 0 to 1/2. A trapezoid between 0 and 2 has area 1/2.'):(ru?'CDF растёт квадратично от 0 до 1. При x=0 она равна 1/16, при x=2 равна 9/16.':'The CDF increases quadratically from 0 to 1. It equals 1/16 at x=0 and 9/16 at x=2.')}</desc>
        <path d="M48 30 V210 H294" class="f-axis" />
        {p.key==='density'&&<polygon points={area} fill="var(--fig-blue)" opacity=".2" data-area="1/2" />}
        {[0,2].map(x=><line x1={sx(x)} x2={sx(x)} y1="210" y2={sy(p.key==='density'?(x+1)/8:(x+1)**2/16,p.key)} stroke="var(--fig-amber)" stroke-dasharray="4 3" />)}
        <polyline data-series={p.key} points={cases.rising.grid.map(r=>`${sx(r.x)},${sy(r[p.key as 'density'|'cdf'],p.key)}`).join(' ')} fill="none" stroke="var(--fig-blue)" stroke-width="2.5" />
        {[-1,0,2,3].map(x=><g><line x1={sx(x)} x2={sx(x)} y1="210" y2="215" class="f-axis" /><text x={sx(x)} y="232" text-anchor="middle">{x}</text></g>)}
        <text x="300" y="213">x</text>
        <text x="36" y="214" text-anchor="end">0</text>
        <text x="36" y="54" text-anchor="end">{p.key==='density'?'1/2':'1'}</text>
        {p.key==='density'?<text x="181" y="185" text-anchor="middle">{ru?'площадь 1/2':'area 1/2'}</text>:<>
          <text x="118" y="189">1/16</text><text x="224" y="112">9/16</text>
          {[0,2].map(x=><circle cx={sx(x)} cy={sy((x+1)**2/16,p.key)} r="4" fill="var(--fig-amber)" />)}
        </>}
      </svg>
    </section>)}
  </div>
</Figure>
<style>
.panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;}
h4{margin:0 0 .5rem;font-size:.95rem;color:var(--ink);font-weight:600;}
svg{width:100%;height:auto;display:block;max-width:400px;margin:auto;}
text{font:14px system-ui,sans-serif;fill:var(--ink);font-variant-numeric:tabular-nums;}
@media(max-width:700px){.panels{grid-template-columns:1fr;}}
</style>
