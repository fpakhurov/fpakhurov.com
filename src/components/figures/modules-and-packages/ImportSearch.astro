---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar, type Tone } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// What `import numpy` does in a script run from project/ inside a virtual environment (CPython 3.14).
// sys.meta_path of a plain 3.14 interpreter is [BuiltinImporter, FrozenImporter, PathFinder];
// sys.path is [script folder, python314.zip, lib/python3.14, lib-dynload, site-packages], searched in order.
const path = ['project/', '…/lib/python314.zip', '…/lib/python3.14', '…/python3.14/lib-dynload', '…/site-packages'];
const hit = path.findIndex((p) => p.endsWith('site-packages'));
if (hit !== path.length - 1) throw new Error('numpy is found in the last entry');

interface Line { s: string; cls?: string; mark?: string }
interface Row { tone: Tone; title: string; lines: Line[] }
const miss = '✗', ok = '✓';
const markCol = 28; // the ✗ and ✓ marks of the sys.path rows sit in this character column
const rows: Row[] = ru
  ? [
      { tone: 'h', title: 'уже импортирован? sys.modules', lines: [{ s: "sys.modules['numpy'] → нет" }, { s: '(найден — поиск окончен)', cls: 'f-t-muted' }] },
      { tone: 'g', title: 'искатели из sys.meta_path', lines: [{ s: 'BuiltinImporter: нет' }, { s: 'FrozenImporter: нет' }, { s: 'PathFinder: ищет в sys.path' }] },
      { tone: 'g', title: 'PathFinder идёт по sys.path', lines: path.map((p, i) => ({ s: i === hit ? `${p}/numpy/` : p, mark: i === hit ? ok : miss, cls: i === hit ? 'f-t-red' : 'f-t-muted' })) },
      { tone: 'h', title: 'загрузка', lines: [{ s: 'новый объект модуля' }, { s: "sys.modules['numpy'] = этот объект" }, { s: 'выполнить numpy/__init__.py' }] },
      { tone: 'x', title: 'связать имя', lines: [{ s: "numpy = sys.modules['numpy']" }] },
    ]
  : [
      { tone: 'h', title: 'already imported? sys.modules', lines: [{ s: "sys.modules['numpy'] → absent" }, { s: '(a hit ends the search here)', cls: 'f-t-muted' }] },
      { tone: 'g', title: 'finders on sys.meta_path', lines: [{ s: 'BuiltinImporter: no' }, { s: 'FrozenImporter: no' }, { s: 'PathFinder: search sys.path' }] },
      { tone: 'g', title: 'PathFinder walks sys.path', lines: path.map((p, i) => ({ s: i === hit ? `${p}/numpy/` : p, mark: i === hit ? ok : miss, cls: i === hit ? 'f-t-red' : 'f-t-muted' })) },
      { tone: 'h', title: 'load', lines: [{ s: 'a new module object' }, { s: "sys.modules['numpy'] = it" }, { s: 'run numpy/__init__.py' }] },
      { tone: 'x', title: 'bind the name', lines: [{ s: "numpy = sys.modules['numpy']" }] },
    ];
const steps = ru
  ? ['проверить кэш sys.modules', 'спросить искателей из sys.meta_path по очереди', 'PathFinder просматривает папки sys.path по порядку и находит пакет numpy', 'создать модуль, записать его в sys.modules и выполнить его код', 'связать имя numpy в импортирующем модуле']
  : ['check the cache, sys.modules', 'ask the finders on sys.meta_path in turn', 'PathFinder scans the folders of sys.path in order and finds the package numpy', 'create the module, store it in sys.modules, run its code', 'bind the name numpy in the importing module'];

interface Layout { cls: string; W: number; bx: number; bw: number; head: number; lh: number; gap: number; detailX: number; detailTop: number; mono: number; sans: number; badgeX: number; titleW: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, bx: 40, bw: 700, head: 24, lh: 18, gap: 16, detailX: 300, detailTop: 0, mono: 7.5, sans: 6.5, badgeX: 20, titleW: 250 },
  { cls: 'fig-narrow seq-narrow', W: 360, bx: 30, bw: 322, head: 24, lh: 20, gap: 16, detailX: 12, detailTop: 26, mono: 8.4, sans: 7.3, badgeX: 15, titleW: 310 },
];
const geom = layouts.map((L) => {
  let y = 34;
  const ys = rows.map((r) => {
    const h = Math.max(L.detailTop + r.lines.length * L.lh + 16, 40);
    const top = y;
    y += h + L.gap;
    return { top, h };
  });
  for (const r of rows) {
    if (10 + r.title.length * L.sans > L.titleW) throw new Error(`title "${r.title}" at ${L.W}`);
    for (const l of r.lines) {
      if (L.detailX + l.s.length * L.mono > L.bw - 6) throw new Error(`line "${l.s}" at ${L.W}`);
      if (l.mark && l.s.length >= markCol - 1) throw new Error(`"${l.s}" runs into its mark`);
      if (l.mark && L.detailX + (markCol + 1) * L.mono > L.bw - 6) throw new Error('mark column overflows');
    }
  }
  return { ys, H: y - L.gap + 10 };
});
const id = 'import-search';
---

<Figure
  id={id}
  title={ru ? 'Как import numpy находит модуль' : 'How import numpy finds a module'}
  caption={ru
    ? 'Что делает оператор import numpy в скрипте, запущенном из папки project/ в виртуальном окружении, на CPython 3.14. Сначала Python смотрит в кэш sys.modules (1): если модуль уже импортирован, поиск окончен. Иначе он по очереди спрашивает искателей из sys.meta_path (2); встроенные и замороженные модули numpy не содержат, и PathFinder просматривает папки sys.path по порядку (3): папку скрипта, стандартную библиотеку, затем site-packages, где лежит пакет numpy. Файл numpy.py в папке project/ нашёлся бы первым и заслонил бы библиотеку. Найденный модуль создаётся и записывается в sys.modules до выполнения своего кода (4), и только потом имя numpy связывается в импортирующем модуле (5).'
    : 'What the statement import numpy does in a script run from the folder project/ inside a virtual environment, on CPython 3.14. Python first looks in the cache, sys.modules (1): if the module was imported before, the search ends there. Otherwise it asks the finders on sys.meta_path in turn (2); neither the built-in nor the frozen modules include numpy, so PathFinder scans the folders of sys.path in order (3): the script\'s folder, the standard library, then site-packages, where the package numpy is. A file numpy.py in project/ would be found first and would shadow the library. The module is created and stored in sys.modules before its code runs (4), and only then is the name numpy bound in the importing module (5).'}
>
  {layouts.map((L, li) => {
    const { ys, H } = geom[li];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Пять шагов оператора import' : 'Five steps of an import statement'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Пять блоков сверху вниз: проверка sys.modules, искатели из sys.meta_path, просмотр пяти папок sys.path, из которых пакет numpy найден в последней, site-packages, загрузка модуля и связывание имени numpy.'
          : 'Five boxes from top to bottom: the check of sys.modules, the finders on sys.meta_path, the scan of five sys.path folders in which the package numpy is found in the last one, site-packages, the loading of the module, and the binding of the name numpy.'}</desc>
        <text class="f-small" x={L.bx} y={18} style="font-family: var(--mono); font-weight: 650">import numpy</text>
        {rows.map((r, k) => {
          const { top, h } = ys[k];
          return (
            <g data-s={String(k + 1)}>
              <rect x={L.bx} y={top} width={L.bw} height={h} rx="7" style={`fill: ${toneVar[r.tone]}; fill-opacity: 0.1; stroke: ${toneVar[r.tone]}; stroke-width: 1.2`} />
              <text class="f-small" x={L.bx + 10} y={top + L.head - 2} style="font-weight: 650">{r.title}</text>
              {r.lines.map((l, i) => (
                <text class={`f-small ${l.cls ?? ''}`} x={L.bx + L.detailX} y={top + L.head - 2 + L.detailTop + i * L.lh} style={`font-family: var(--mono); ${l.cls === 'f-t-red' ? 'font-weight: 650' : ''}`}>{l.s}</text>
              ))}
              {r.lines.map((l, i) => l.mark && (
                <text class={`f-small ${l.cls ?? ''}`} x={L.bx + L.detailX + markCol * L.mono} y={top + L.head - 2 + L.detailTop + i * L.lh} style="font-family: var(--mono)">{l.mark}</text>
              ))}
              <Badge x={L.badgeX} y={top + 18} n={k + 1} />
            </g>
          );
        })}
      </svg>
    );
  })}
  <Stepper steps={steps} />
</Figure>
