---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { mixes } from './cases';
const ru = pageLang(Astro.url) === 'ru';
const id = 'base-rate-tree';
const title = ru ? 'Меняем состав задач, сохраняем условные доли' : 'Change the job mix, keep the conditional rates';
const caption = ru
  ? 'Каждая панель — заданная совокупность из 200 задач. Полосы показывают только долгие задачи, с одинаковым масштабом. При прежних долях долгих задач внутри категорий доля архивных восстановлений среди долгих меняется с 16/33 на 64/78. Условие отбора и знаменатель имеют значение.'
  : 'Each panel is a specified population of 200 jobs. Bars show long jobs only, on the same scale. Keeping long-job rates within categories fixed changes the archive share among long jobs from 16/33 to 64/78. The selection condition and denominator matter.';
const names = ru ? ['Синхронизация','Перестроение индекса','Восстановление архива'] : ['Synchronization','Index rebuild','Archive restore'];
const colors = ['blue','green','amber'];
---
<Figure id={id} title={title} caption={caption}>
  <svg viewBox="0 0 350 490" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
    <title id={`${id}-title`}>{title}</title><desc id={`${id}-desc`}>{caption}</desc>
    {mixes.map((mix,k)=><g transform={`translate(0 ${k*244})`}>
      <text x="18" y="24" class="f-label">{ru?'Состав':'Mix'} {k+1}: {mix.jobs.join(' / ')} {ru?'задач':'jobs'}</text>
      {mix.long.map((n,i)=><g>
        <text x="18" y={52+i*50} class="f-small">{names[i]}</text>
        <text x="330" y={52+i*50} text-anchor="end" class="f-small">{n} / {mix.jobs[i]}</text>
        <rect x="18" y={60+i*50} width={n/64*312} height="14" rx="2" fill={`var(--fig-${colors[i]})`} />
      </g>)}
      <text x="18" y="213" class="f-label">{ru?'Архив среди долгих:':'Archive among long jobs:'} {mix.long[2]}/{mix.long.reduce((a,b)=>a+b,0)}</text>
      {k===0&&<path d="M 18 232 H 330" class="f-grid"/>}
    </g>)}
  </svg>
</Figure>
<style>svg{display:block;width:100%;max-width:520px;height:auto;margin-inline:auto}</style>
