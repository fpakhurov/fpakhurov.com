---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Prevalence 1%, sensitivity 90%, false-positive rate 9%, written as counts out of 1,000 people.
const n = 1000, prev = 0.01, sens = 0.9, fpr = 0.09;
const sick = n * prev, healthy = n - sick;
const tp = Math.round(sick * sens), fn = sick - tp, fp = Math.round(healthy * fpr), tn = healthy - fp;
const post = tp / (tp + fp);
if (tp !== 9 || fp !== 89 || post.toFixed(3) !== '0.092') throw new Error('BaseRateTree: numbers drifted from the note');
const t = ru
  ? { people: 'человек', sick: 'больны', healthy: 'здоровы', pos: 'тест +', neg: 'тест −', result: `положительных тестов ${tp + fp}, из них больны ${tp}`, ratio: `P(болен | +) = ${tp}/${tp + fp} ≈ ${post.toFixed(3)}`,
      steps: ['1% из 1000 больны: 10 и 990', 'тест: 90% больных и 9% здоровых дают +', `среди ${tp + fp} положительных больны ${tp}`] }
  : { people: 'people', sick: 'sick', healthy: 'healthy', pos: 'test +', neg: 'test −', result: `${tp + fp} positive tests, ${tp} of them sick`, ratio: `P(sick | +) = ${tp}/${tp + fp} ≈ ${post.toFixed(3)}`,
      steps: ['1% of 1,000 are sick: 10 and 990', 'the test: 90% of the sick and 9% of the healthy test +', `among the ${tp + fp} positives, ${tp} are sick`] };
const id = 'base-rate-tree';
const fmtN = (v: number) => (ru ? v.toLocaleString('ru-RU').replace(/ /g, ' ') : v.toLocaleString('en-US'));
const layouts = [
  { cls: 'fig-wide fig-medium', W: 640, H: 360, root: [260, 16, 120], l2: [[110, 120], [410, 120]], leaf: [[30, 100], [170, 100], [350, 100], [490, 100]], res: [30, 300, 580] },
  { cls: 'fig-narrow seq-narrow', W: 380, H: 380, root: [130, 16, 120], l2: [[20, 150], [210, 150]], leaf: [[4, 84], [94, 84], [204, 84], [294, 84]], res: [20, 300, 340] },
];
const lvlY = [16, 108, 204], bh = 44;
---

<Figure
  id={id}
  title={ru ? 'Положительный тест на редкую болезнь, в числах из 1000 человек' : 'A positive test for a rare disease, in counts out of 1,000 people'}
  caption={ru
    ? `Болезнью страдает 1% людей; тест находит 90% больных и даёт ложный положительный результат у 9% здоровых. Из 1000 человек больны 10, у 9 из них тест положителен (1); из 990 здоровых положителен у 89 (2). Всего положительных ${tp + fp}, и больны из них только ${tp}: вероятность болезни при положительном тесте ≈ ${post.toFixed(3)}, а не 0.9 (3).`
    : `1% of people have the disease; the test detects 90% of the sick and gives a false positive for 9% of the healthy. Of 1,000 people 10 are sick, and 9 of them test positive (1); of the 990 healthy, 89 test positive (2). There are ${tp + fp} positive tests and only ${tp} of them belong to sick people: the probability of the disease given a positive test is ≈ ${post.toFixed(3)}, not 0.9 (3).`}
>
  {layouts.map((L) => {
    const [rx, , rw] = L.root;
    const leaves = [[tp, t.pos, 'y'], [fn, t.neg, 'n'], [fp, t.pos, 'g'], [tn, t.neg, 'n']] as const;
    const cx = (x: number, w: number) => x + w / 2;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Дерево частот для теста' : 'Frequency tree for the test'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? `1000 человек: 10 больны (9 с положительным тестом, 1 с отрицательным), 990 здоровы (89 с положительным, 901 с отрицательным). Среди 98 положительных больны 9.` : `1,000 people: 10 sick (9 test positive, 1 negative), 990 healthy (89 positive, 901 negative). Of the 98 positives, 9 are sick.`}</desc>
        <Box x={rx} y={lvlY[0]} w={rw} h={bh} label={fmtN(n)} sub={t.people} tone="n" subGap={L.cls.includes('narrow') ? 19 : 15} />
        <g data-s="1">
          {[[sick, t.sick, 'y', '1%'], [healthy, t.healthy, 'h', '99%']].map(([v, lab, tone, pct], i) => {
            const [x, w] = L.l2[i];
            return (
              <g>
                <Arrow pts={[[cx(rx, rw) + (i ? 20 : -20), lvlY[0] + bh], [cx(x, w), lvlY[1] - 2]]} label={pct as string} at={[(cx(rx, rw) + cx(x, w)) / 2 + (i ? 10 : -10), (lvlY[0] + bh + lvlY[1]) / 2 + 4]} anchor={i ? 'start' : 'end'} />
                <Box x={x} y={lvlY[1]} w={w} h={bh} label={fmtN(v as number)} sub={lab as string} tone={tone as 'y' | 'h'} subGap={L.cls.includes('narrow') ? 19 : 15} />
              </g>
            );
          })}
          <Badge x={rx + rw + 16} y={lvlY[0] + bh / 2} n={1} />
        </g>
        <g data-s="2">
          {leaves.map(([v, lab, tone], k) => {
            const [x, w] = L.leaf[k];
            const [px, pw] = L.l2[k < 2 ? 0 : 1];
            const pct = k === 0 ? '90%' : k === 1 ? '10%' : k === 2 ? '9%' : '91%';
            return (
              <g>
                <Arrow pts={[[cx(px, pw) + (k % 2 ? 14 : -14), lvlY[1] + bh], [cx(x, w), lvlY[2] - 2]]} label={pct} at={[(cx(px, pw) + cx(x, w)) / 2 + (k % 2 ? 8 : -8), (lvlY[1] + bh + lvlY[2]) / 2 + 4]} anchor={k % 2 ? 'start' : 'end'} />
                <Box x={x} y={lvlY[2]} w={w} h={bh} label={fmtN(v as number)} sub={lab as string} tone={tone as 'y' | 'g' | 'n'} subGap={L.cls.includes('narrow') ? 19 : 15} />
              </g>
            );
          })}
          <Badge x={L.l2[1][0] + L.l2[1][1] + 16} y={lvlY[1] + bh / 2} n={2} />
        </g>
        <g data-s="3">
          {[0, 2].map((k) => <Arrow pts={[[cx(L.leaf[k][0], L.leaf[k][1]), lvlY[2] + bh], [cx(L.leaf[k][0], L.leaf[k][1]), L.res[1] - 2]]} tone="amber" dashed />)}
          <rect x={L.res[0]} y={L.res[1]} width={L.res[2]} height="52" rx="8" style="fill: var(--fig-amber); fill-opacity: 0.12; stroke: var(--fig-amber); stroke-width: 1.4" />
          <text class="f-small" x={L.res[0] + L.res[2] / 2} y={L.res[1] + 20} text-anchor="middle">{t.result}</text>
          <text class="f-label" x={L.res[0] + L.res[2] / 2} y={L.res[1] + 42} text-anchor="middle">{t.ratio}</text>
          <Badge x={L.res[0] - 2} y={L.res[1]} n={3} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
