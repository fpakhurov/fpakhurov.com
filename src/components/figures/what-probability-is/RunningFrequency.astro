---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { runs, probability, sampleSize } from './cases';
const ru = pageLang(Astro.url) === 'ru';
const id = 'running-frequency';
const title = ru ? 'Частота колеблется вокруг заданной вероятности' : 'Frequency fluctuates around the specified probability';
const caption = ru
  ? 'Три воспроизводимые псевдослучайные серии с p=3/8, по 4096 испытаний. Показаны частоты начиная с восьмого испытания; горизонтальная ось логарифмическая. Пунктир отмечает заданное p. Конечные траектории иллюстрируют колебания; они не доказывают закон больших чисел и не задают доверительную полосу.'
  : 'Three reproducible pseudorandom series with p=3/8 and 4096 trials each. Frequencies are shown from trial eight on a logarithmic horizontal axis. The dashed line marks the specified p. Finite paths illustrate fluctuations; they do not prove the law of large numbers or define a confidence band.';
const points = [...new Set(Array.from({length:181}, (_,i)=>Math.round(2 ** (3 + i / 20))))];
const x = (n:number)=>40 + (Math.log2(n)-3)/9*280;
const y = (p:number)=>222-p*190;
const path = (counts:number[])=>'M '+points.map(n=>`${x(n).toFixed(2)} ${y(counts[n-1]/n).toFixed(2)}`).join(' L ');
---
<Figure id={id} title={title} caption={caption}>
  <svg viewBox="0 0 350 308" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
    <title id={`${id}-title`}>{title}</title>
    <desc id={`${id}-desc`}>{caption}</desc>
    {[0, 0.375, 1].map(p=><g><path d={`M 40 ${y(p)} H 320`} class={p===probability?'f-line f-muted f-dash':'f-grid'} /><text x="34" y={y(p)+4} text-anchor="end" class="f-small">{p}</text></g>)}
    {runs.map((counts,i)=><path d={path(counts)} class={`f-line f-${['blue','amber','green'][i]}`} />)}
    {[8,64,512,sampleSize].map(n=><text x={x(n)} y="243" text-anchor="middle" class="f-small f-t-muted">{n}</text>)}
    <text x="320" y="265" text-anchor="end" class="f-small">{ru?'Число испытаний n':'Number of trials n'}</text>
    <text x="40" y="296" class="f-small">{ru?'При n=4096:':'At n=4096:'} {runs.map(r=>(r[sampleSize-1]/sampleSize).toFixed(4)).join(' / ')}</text>
  </svg>
</Figure>
<style>svg{display:block;width:100%;max-width:620px;height:auto;margin-inline:auto}</style>
