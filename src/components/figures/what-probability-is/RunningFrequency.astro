---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { mulberry32 } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Three seeded runs of 10,000 fair-coin flips; the running share of heads after every flip.
const N = 10000, seeds = [1, 7, 2026];
const runs = seeds.map((seed) => {
  const r = mulberry32(seed); let h = 0; const share: number[] = [];
  for (let n = 1; n <= N; n++) { if (r() < 0.5) h++; share.push(h / n); }
  return share;
});
const at = (k: number) => [10, 100, 1000, 10000].map((n) => runs[k][n - 1]);
if (at(0).join() !== '0.3,0.53,0.505,0.501') throw new Error('RunningFrequency: the seeded run drifted from the note');
const tones = ['blue', 'amber', 'green'];
const id = 'running-frequency';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 620, H: 300, left: 54, right: 580, top: 20, bottom: 250 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 300, left: 44, right: 316, top: 20, bottom: 250 },
];
const band = (n: number) => 2 * Math.sqrt(0.25 / n);
// Paths on a log axis, sampled at 10^e for e from 0 to 4.
const grid = (step: number) => Array.from({ length: Math.round(4 / step) + 1 }, (_, i) => Math.max(1, Math.round(10 ** (i * step))));
const geom = (L: { left: number; right: number; top: number; bottom: number }) => {
  const sx = scale([0, 4], [L.left, L.right]), sy = scale([0, 1], [L.bottom, L.top]);
  const pt = (n: number, v: number) => `${sx(Math.log10(n)).toFixed(1)} ${sy(Math.min(1, Math.max(0, v))).toFixed(1)}`;
  const upper = grid(0.02).map((n) => pt(n, 0.5 + band(n)));
  const lower = grid(0.02).map((n) => pt(n, 0.5 - band(n))).reverse();
  const area = `M ${upper.join(' L ')} L ${lower.join(' L ')} Z`;
  const lines = runs.map((share) => `M ${grid(0.01).map((n) => pt(n, share[n - 1])).join(' L ')}`);
  return { sx, sy, area, lines };
};
---

<Figure
  id={id}
  title={ru ? 'Доля орлов в трёх сериях бросков' : 'The share of heads in three runs of coin flips'}
  caption={ru
    ? 'Три серии по 10 000 бросков симметричной монеты (генератор с фиксированными зёрнами), по горизонтали — число бросков в логарифмической шкале. После 10 бросков доля орлов в первой серии равна 0.3, после 100 — 0.53, после 1000 — 0.505, после 10 000 — 0.501. Серая полоса — 0.5 ± 2√(0.25/n), поточечная приближённая 95-процентная полоса: при каждом фиксированном n доля попадает в неё с вероятностью около 0.95. Это не гарантия для всей траектории: серия, за которой следят при каждом n, время от времени из полосы выходит (к этому сводится проблема подглядывания в заметке о проверке гипотез). Полоса сужается как 1/√n, поэтому каждая следующая значащая цифра требует в сто раз больше бросков.'
    : 'Three runs of 10,000 flips of a fair coin (a seeded generator), with the number of flips on a logarithmic axis. After 10 flips the first run has 0.3 heads, after 100 0.53, after 1,000 0.505, after 10,000 0.501. The grey band is 0.5 ± 2√(0.25/n), a pointwise approximate 95% band: at each fixed n the share falls inside it with probability about 0.95. It is not a guarantee for the whole path: a run watched at every n leaves the band now and then (the peeking problem of the hypothesis-tests note). The band narrows like 1/√n, so every further correct digit costs a hundred times more flips.'}
>
  {layouts.map((L) => {
    const { sx, sy, area, lines } = geom(L);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Доля орлов в зависимости от числа бросков' : 'Share of heads against the number of flips'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? `Первая серия: ${at(0).join(', ')} после 10, 100, 1000 и 10 000 бросков; все три серии сходятся к 0.5 внутри сужающейся полосы.` : `First run: ${at(0).join(', ')} after 10, 100, 1,000 and 10,000 flips; all three runs approach 0.5 inside a narrowing band.`}</desc>
        <path d={area} style="fill: var(--muted); fill-opacity: 0.14" />
        <path class="f-axis" d={`M ${L.left} ${L.bottom} H ${L.right + 6}`} />
        <path class="f-axis" d={`M ${L.left} ${L.bottom} V ${L.top - 4}`} />
        <path class="f-thin f-muted f-dash" d={`M ${L.left} ${sy(0.5)} H ${L.right}`} />
        {[0, 1, 2, 3, 4].map((e) => <text class="f-note" x={sx(e)} y={L.bottom + 20} text-anchor="middle">{e === 0 ? '1' : e === 1 ? '10' : e === 2 ? '100' : e === 3 ? (ru ? '1 000' : '1,000') : (ru ? '10 000' : '10,000')}</text>)}
        {[0, 0.5, 1].map((v) => <text class="f-note" x={L.left - 8} y={sy(v) + 4} text-anchor="end">{v}</text>)}
        {lines.map((d, k) => <path class={`f-line f-${tones[k]}`} d={d} />)}
        {at(0).map((v, i) => <circle cx={sx(i + 1)} cy={sy(v)} r="4" class="f-solid-blue" />)}
        <text class="f-small f-t-muted" x={L.right} y={L.bottom + 40} text-anchor="end">{ru ? 'число бросков n' : 'number of flips n'}</text>
      </svg>
    );
  })}
</Figure>
