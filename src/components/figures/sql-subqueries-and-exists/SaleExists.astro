---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? 'Одного совпадения достаточно' : 'One match is enough';
const caption = ru
  ? 'У товаров разное число продаж. EXISTS использует только различие между нулём и положительным числом.'
  : 'Products have different numbers of sales. EXISTS only distinguishes zero from a positive count.';
const desc = ru
  ? 'Какао, кофе и чай имеют одно, два и три совпадения. Для них EXISTS истинен. Для мяты совпадений нет, и EXISTS ложен.'
  : 'Cocoa, coffee and tea have one, two and three matches. EXISTS is true for them. Mint has zero matches and EXISTS is false.';
const matches = [
  ['cocoa', 1],
  ['coffee', 2],
  ['mint', 0],
  ['tea', 3],
] as const;
const label = ru ? 'Совпадения' : 'Matches';
---
<Figure id="sql-sale-exists" title={title} caption={caption}>
  <svg viewBox="0 0 340 181" role="img" aria-labelledby="sql-sale-exists-title sql-sale-exists-desc" style="max-width: 550px; margin-inline: auto">
    <title id="sql-sale-exists-title">{title}</title>
    <desc id="sql-sale-exists-desc">{desc}</desc>
    <text class="f-label" x="57" y="29" text-anchor="middle">product</text>
    <text class="f-label" x="160" y="29" text-anchor="middle">{label}</text>
    <text class="f-label" x="268" y="29" text-anchor="middle">EXISTS</text>
    {matches.map(([product, count], i) => (
      <g transform={`translate(0 ${i * 33})`}>
        <text class="f-label" x="57" y="60" text-anchor="middle">{product}</text>
        <text class="f-label" x="160" y="60" text-anchor="middle">{count}</text>
        <rect class={count > 0 ? 'f-fill-green' : 'f-fill-amber'} x="220" y="41" width="96" height="28" rx="5" />
        <text class="f-label" x="268" y="60" text-anchor="middle">{count > 0 ? 'TRUE' : 'FALSE'}</text>
      </g>
    ))}
  </svg>
</Figure>
