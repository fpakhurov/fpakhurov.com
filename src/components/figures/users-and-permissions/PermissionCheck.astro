---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The access check for report.txt, owner ann, group staff, mode 0640, as in the note's worked example.
// The bits, the octal digits and the ls string are all computed from the one number.
const mode = 0o640;
const bits = Array.from({ length: 12 }, (_, i) => (mode >> (11 - i)) & 1);
const digits = [0, 1, 2, 3].map((g) => (mode >> (9 - 3 * g)) & 7);
const rwx = (d: number) => (d & 4 ? 'r' : '-') + (d & 2 ? 'w' : '-') + (d & 1 ? 'x' : '-');
const ls = '-' + rwx(digits[1]) + rwx(digits[2]) + rwx(digits[3]);
if (digits.join('') !== '0640' || ls !== '-rw-r-----') throw new Error(`PermissionCheck: ${digits} ${ls}`);
const cellNames = ['uid', 'gid', 't', 'r', 'w', 'x', 'r', 'w', 'x', 'r', 'w', 'x'];

const t = ru
  ? {
      file: 'report.txt: ann, staff', groups: ['специальные', 'владелец', 'группа', 'остальные'],
      q: ['euid = 0?', 'euid = владелец?', 'группа совпала?', 'иначе'],
      res: ['без проверок', `биты владельца ${rwx(digits[1])}`, `биты группы ${rwx(digits[2])}`, `биты остальных ${rwx(digits[3])}`],
      who: ['root: разрешено', 'ann: rw разрешено', 'bob: r да, w нет', 'carol: r нет'],
      yes: 'да', no: 'нет',
      steps: ['слово режима 0640: четыре восьмеричные цифры, по одной на группу из трёх битов', 'эффективный UID 0 (root) пропускает проверку', 'если эффективный UID равен владельцу файла, используются только биты владельца: ann может читать и писать', 'иначе, если эффективный GID или дополнительная группа равны группе файла, — только биты группы: bob может читать, но не писать', 'иначе — биты остальных: carol не может ничего'],
    }
  : {
      file: 'report.txt: ann, staff', groups: ['special', 'owner', 'group', 'others'],
      q: ['euid = 0?', 'euid = owner?', 'group matches?', 'otherwise'],
      res: ['no checks', `owner bits ${rwx(digits[1])}`, `group bits ${rwx(digits[2])}`, `others bits ${rwx(digits[3])}`],
      who: ['root: allowed', 'ann: rw allowed', 'bob: r ok, w denied', 'carol: r denied'],
      yes: 'yes', no: 'no',
      steps: ['the mode word 0640: four octal digits, one for each group of three bits', 'effective UID 0 (root) skips the check', 'if the effective UID equals the file\'s owner, only the owner bits count: ann may read and write', 'else, if the effective GID or a supplementary group equals the file\'s group, only the group bits count: bob may read, not write', 'otherwise the others bits count: carol may do nothing'],
    };
const tones = ['n', 'x', 'h', 'y'] as const;

interface Layout {
  cls: string; W: number; H: number; wide: boolean;
  cx0: number; cw: number; ch: number; cy: number; gap: number; lsAt: [number, number];
  Q: [number, number][]; qw: number; qh: number; Rb: [number, number][]; rw: number; rh: number;
  badges: [number, number][];
}
const wide: Layout = {
  cls: 'fig-wide', W: 760, H: 338, wide: true,
  cx0: 40, cw: 38, ch: 30, cy: 40, gap: 12, lsAt: [560, 66],
  Q: [[16, 168], [204, 168], [392, 168], [580, 168]], qw: 164, qh: 44,
  Rb: [[16, 262], [204, 262], [392, 262], [580, 262]], rw: 164, rh: 54,
  badges: [[30, 40], [16, 168], [204, 168], [392, 168], [580, 168]],
};
const narrow: Layout = {
  cls: 'fig-narrow seq-narrow', W: 360, H: 470, wide: false,
  cx0: 22, cw: 25, ch: 30, cy: 44, gap: 8, lsAt: [180, 152],
  Q: [[8, 196], [8, 266], [8, 336], [8, 406]], qw: 146, qh: 44,
  Rb: [[180, 190], [180, 260], [180, 330], [180, 400]], rw: 172, rh: 56,
  badges: [[14, 44], [8, 196], [8, 266], [8, 336], [8, 406]],
};
const cellX = (L: Layout, i: number) => L.cx0 + Math.floor(i / 3) * (3 * L.cw + L.gap) + (i % 3) * L.cw;
const groupMid = (L: Layout, g: number) => cellX(L, 3 * g) + 1.5 * L.cw;
const id = 'permission-check';
const layouts = [wide, narrow];
---

<Figure
  id={id}
  title={ru ? 'Проверка прав доступа: одно слово режима и один выбранный класс' : 'The permission check: one mode word, one class chosen'}
  caption={ru
    ? `Файл report.txt принадлежит ann и группе staff, режим 0640 (${ls}). Двенадцать битов режима — три специальных и по три для владельца, группы и остальных — записываются четырьмя восьмеричными цифрами (1). Ядро проверяет условия по порядку и останавливается на первом выполненном: root проходит без проверки (2), владелец получает только биты владельца (3), член группы файла — только биты группы (4), все остальные — биты остальных (5). Выбирается ровно один класс: биты других классов уже не важны.`
    : `The file report.txt belongs to ann and the group staff, mode 0640 (${ls}). The twelve mode bits, three special ones and three each for owner, group and others, are written as four octal digits (1). The kernel tests the conditions in order and stops at the first that holds: root passes without a check (2), the owner gets only the owner bits (3), a member of the file's group only the group bits (4), everyone else the others bits (5). Exactly one class is chosen; the bits of the other classes no longer matter.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Слово режима 0640 и порядок проверки' : 'The mode word 0640 and the order of the check'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Сверху двенадцать ячеек битов режима, сгруппированных по три, со значениями 000 110 100 000 и восьмеричными цифрами 0, 6, 4, 0. Ниже четыре вопроса по порядку: euid равен 0, euid равен владельцу, совпадает группа, иначе. Каждый ведёт к результату: без проверок, биты владельца rw-, биты группы r--, биты остальных ---, с примерами root, ann, bob и carol.'
        : 'At the top, twelve cells for the mode bits in groups of three, with values 000 110 100 000 and octal digits 0, 6, 4, 0. Below, four questions in order: is the euid 0, is the euid the owner, does the group match, otherwise. Each leads to a result: no checks, owner bits rw-, group bits r--, others bits ---, with the examples root, ann, bob and carol.'}</desc>

      <g data-s="1">
        {bits.map((b, i) => (
          <g>
            <text class="f-small f-t-muted" x={cellX(L, i) + L.cw / 2} y={L.cy - 7} text-anchor="middle">{cellNames[i]}</text>
            <rect x={cellX(L, i)} y={L.cy} width={L.cw} height={L.ch} style={`fill: ${toneVar[tones[Math.floor(i / 3)]]}; fill-opacity: ${b ? 0.35 : 0.08}; stroke: ${toneVar[tones[Math.floor(i / 3)]]}; stroke-width: 1.1`} />
            <text class="f-label" x={cellX(L, i) + L.cw / 2} y={L.cy + L.ch / 2 + 5} text-anchor="middle">{b}</text>
          </g>
        ))}
        {digits.map((d, g) => (
          <g>
            <text class="f-label" x={groupMid(L, g)} y={L.cy + L.ch + 22} text-anchor="middle" style="font-weight: 650">{d}</text>
            <text class="f-small f-t-muted" x={groupMid(L, g)} y={L.cy + L.ch + 40} text-anchor="middle">{t.groups[g]}</text>
          </g>
        ))}
        <text class="f-label" x={L.lsAt[0]} y={L.lsAt[1]} text-anchor={L.wide ? 'start' : 'middle'} style="font-family: var(--mono, monospace)">{ls}</text>
        <text class="f-small f-t-muted" x={L.lsAt[0]} y={L.lsAt[1] + 20} text-anchor={L.wide ? 'start' : 'middle'}>{t.file}</text>
        <Badge x={L.badges[0][0]} y={L.badges[0][1]} n={1} />
      </g>

      {L.Q.map(([x, y], k) => (
        <g data-s={`${k + 2}`}>
          <Box x={x} y={y} w={L.qw} h={L.qh} label={t.q[k]} tone={k === 3 ? 'n' : 'g'} />
          {k === 3
            ? (L.wide
              ? <Arrow pts={[[x + L.qw / 2, y + L.qh + 2], [x + L.qw / 2, L.Rb[k][1] - 3]]} />
              : <Arrow pts={[[x + L.qw + 2, y + L.qh / 2], [L.Rb[k][0] - 3, L.Rb[k][1] + L.rh / 2]]} />)
            : (L.wide
              ? <Arrow pts={[[x + L.qw / 2, y + L.qh + 2], [x + L.qw / 2, L.Rb[k][1] - 3]]} label={t.yes} at={[x + L.qw / 2 + 8, y + L.qh + 27]} labelTone="n" />
              : <Arrow pts={[[x + L.qw + 2, y + L.qh / 2], [L.Rb[k][0] - 3, L.Rb[k][1] + L.rh / 2]]} label={t.yes} at={[(x + L.qw + L.Rb[k][0]) / 2, y + L.qh / 2 - 6]} anchor="middle" labelTone="n" />)}
          {k < 3 && (L.wide
            ? <Arrow pts={[[x + L.qw + 2, y + L.qh / 2], [L.Q[k + 1][0] - 3, y + L.qh / 2]]} label={t.no} at={[x + L.qw + 12, y + L.qh / 2 + 19]} anchor="middle" labelTone="n" />
            : <Arrow pts={[[x + L.qw / 2, y + L.qh + 2], [x + L.qw / 2, L.Q[k + 1][1] - 3]]} label={t.no} at={[x + L.qw / 2 + 8, y + L.qh + 18]} labelTone="n" />)}
          <Box x={L.Rb[k][0]} y={L.Rb[k][1]} w={L.rw} h={L.rh} label={t.res[k]} sub={t.who[k]} tone={tones[k]} subGap={18} />
          <Badge x={L.badges[k + 1][0]} y={L.badges[k + 1][1]} n={k + 2} />
        </g>
      ))}
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
