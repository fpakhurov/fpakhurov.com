---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Multi-document QA with 20 retrieved passages (about 4,000 tokens), NaturalQuestions-Open: accuracy by the position of
// the one passage that holds the answer. Liu et al. (2024), appendix G, table 6; closed-book accuracy from table 1.
const pos = [1, 5, 10, 15, 20];
const series = [
  { name: 'gpt-3.5-turbo-0613', acc: [75.8, 57.2, 53.8, 55.4, 63.2], closed: 56.1, cls: 'blue' },
  { name: 'claude-1.3', acc: [59.9, 55.9, 56.8, 57.2, 60.1], closed: 48.3, cls: 'red' },
];
const g = series[0];
if (!(Math.min(...g.acc) < g.closed && g.acc[0] > g.acc[4] && g.acc[4] > g.acc[2])) throw new Error('LostInTheMiddle: the data no longer show the U shape quoted in the note');
if (g.acc[0] - Math.min(...g.acc) <= 20) throw new Error('LostInTheMiddle: the drop quoted as more than 20 points is not in the data');

const t = ru
  ? { title: 'Доля правильных ответов в зависимости от места нужного отрывка', x: 'позиция отрывка с ответом среди 20', y: 'доля правильных, %', closed: 'без отрывков',
      desc: 'Две кривые доли правильных ответов при 20 отрывках в контексте в зависимости от позиции отрывка с ответом: 1, 5, 10, 15, 20. У gpt-3.5-turbo-0613: 75.8, 57.2, 53.8, 55.4, 63.2 процента — U-образная кривая, середина ниже, чем 56.1 процента без отрывков вовсе. У claude-1.3: 59.9, 55.9, 56.8, 57.2, 60.1 процента, без отрывков 48.3.' }
  : { title: 'Accuracy by where the answer passage sits', x: 'position of the answer passage among 20', y: 'accuracy, %', closed: 'no passages',
      desc: 'Two curves of answer accuracy with 20 passages in the context against the position of the passage holding the answer: 1, 5, 10, 15, 20. For gpt-3.5-turbo-0613: 75.8, 57.2, 53.8, 55.4, 63.2 percent, a U shape whose middle lies below the 56.1 percent reached with no passages at all. For claude-1.3: 59.9, 55.9, 56.8, 57.2, 60.1 percent, and 48.3 with no passages.' };
const id = 'lost-in-the-middle';
const caption = ru
  ? 'Вопросы из NaturalQuestions-Open, 20 отрывков из Википедии (около 4000 токенов), ответ ровно в одном из них (Liu et al., 2024; модели 2023 года). Сплошные линии — доля правильных ответов при данной позиции нужного отрывка, пунктир того же цвета — доля правильных ответов той же модели совсем без отрывков, только по её параметрам. У GPT-3.5-Turbo отрывок в середине хуже, чем ничего; с одним лишь нужным отрывком она отвечает верно в 88.3% случаев. Версии с длинным окном (16K, 100K) дают почти те же кривые.'
  : 'Questions from NaturalQuestions-Open, 20 Wikipedia passages (about 4,000 tokens), the answer in exactly one of them (Liu et al., 2024; models of 2023). Solid lines: accuracy with the answer passage at the given position. Dashed lines of the same colour: the same model with no passages at all, answering from its parameters. For GPT-3.5-Turbo a passage in the middle is worse than none; given only the answer passage it is right 88.3 percent of the time. The long-window versions (16K, 100K) give nearly the same curves.';

const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 300, px: [70, 560] as [number, number], py: [40, 240] as [number, number], leg: [590, 70, 22] as [number, number, number] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 400, px: [52, 340] as [number, number], py: [120, 320] as [number, number], leg: [16, 20, 21] as [number, number, number] },
];
const yTicks = [45, 55, 65, 75];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sx = scale([1, 20], L.px), sy = scale([45, 80], [L.py[1], L.py[0]]);
    const legend: [string, string, string][] = [
      ...series.map((S) => [`f-line f-${S.cls}`, `f-t-${S.cls}`, S.name] as [string, string, string]),
      ['f-line f-muted f-dash', 'f-t-muted', t.closed],
    ];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {yTicks.map((v) => <path class="f-grid" d={`M ${L.px[0]} ${sy(v)} H ${L.px[1]}`} />)}
        <path class="f-axis" d={`M ${L.px[0]} ${L.py[0] - 6} V ${L.py[1]} H ${L.px[1]}`} />
        {yTicks.map((v) => <text class="f-small" x={L.px[0] - 7} y={sy(v) + 4} text-anchor="end">{String(v)}</text>)}
        {pos.map((v) => <text class="f-small" x={sx(v)} y={L.py[1] + 18} text-anchor="middle">{String(v)}</text>)}
        <text class="f-small f-t-muted" x={(L.px[0] + L.px[1]) / 2} y={L.py[1] + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.px[0] - 40} y={L.py[0] - 18}>{t.y}</text>
        {series.map((S) => (
          <g>
            <path class={`f-line f-${S.cls} f-dash`} d={`M ${L.px[0]} ${sy(S.closed)} H ${L.px[1]}`} />
            <path class={`f-line f-${S.cls}`} d={polyline(pos.map((p, i) => [sx(p), sy(S.acc[i])] as [number, number]))} />
            {pos.map((p, i) => <circle cx={sx(p)} cy={sy(S.acc[i])} r="3.4" class={`f-solid-${S.cls}`} />)}
          </g>
        ))}
        {pos.map((p, i) => <text class="f-small f-t-blue f-halo" x={sx(p)} y={sy(g.acc[i]) - 9} text-anchor="middle">{g.acc[i].toFixed(1)}</text>)}
        {legend.map(([cl, tc, label], i) => (
          <g>
            <path class={cl} d={`M ${L.leg[0]} ${L.leg[1] + i * L.leg[2] - 4} h 22`} />
            <text class={`f-small ${tc}`} x={L.leg[0] + 30} y={L.leg[1] + i * L.leg[2]}>{label}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
