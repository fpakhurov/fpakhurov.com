---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { run, lastStep, WINDOW, RESERVE, HIGH } from './budget';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The tokens read at each step by an append-only loop and by the same loop with compaction (numbers of the Code section).
const T = 120;
const full = run(lastStep(), null).reads;
const comp = run(T, HIGH);
const sum = (a: number[]) => a.reduce((x, y) => x + y, 0);
const c80 = run(80, HIGH);
const got = [lastStep(), sum(run(80, null).reads), sum(c80.reads), sum(c80.summarizer), Math.max(...comp.reads)].join(' ');
if (got !== '81 4980000 2791500 105500 63500') throw new Error(`TokenBudget: numbers drifted from the Code section (${got})`);
const drops = comp.reads.map((v, i) => (i > 0 && v < comp.reads[i - 1] ? i + 1 : 0)).filter(Boolean);
if (drops.join(' ') !== '42 74 106') throw new Error(`TokenBudget: unexpected compaction steps ${drops.join(' ')}`);

const k = (v: number) => (v / 1000).toLocaleString('en-US');
const t = ru
  ? { title: 'Сколько токенов читает каждый шаг', x: 'шаг агента t', y: 'токенов на шаге, тыс.', full: 'всё дописывается', comp: 'со сжатием',
      win: `окно минус ответ, ${k(WINDOW - RESERVE)} тыс.`, high: `порог H, ${k(HIGH)} тыс.`, stop: 'окно заполнено',
      desc: `Две линии: число токенов, которое модель читает на шаге t, от 1 до ${T}. Без сжатия линия растёт на 1500 за шаг от 3000 до 121 500 на шаге 81 и обрывается: следующий шаг не помещается в окно. Со сжатием линия растёт до порога в 64 тысячи, падает до 17 тысяч на шагах 42, 74 и 106 и снова растёт — пила, которая никогда не превышает 63 500.` }
  : { title: 'How many tokens each step reads', x: 'agent step t', y: 'tokens read at the step, thousands', full: 'append everything', comp: 'with compaction',
      win: `window minus reply, ${k(WINDOW - RESERVE)}k`, high: `high-water mark H, ${k(HIGH)}k`, stop: 'window full',
      desc: `Two lines: the number of tokens the model reads at step t, from 1 to ${T}. Without compaction the line grows by 1,500 per step from 3,000 to 121,500 at step 81 and ends there: the next step does not fit in the window. With compaction the line grows up to the mark of 64 thousand, drops to 17 thousand at steps 42, 74 and 106 and grows again, a sawtooth that never exceeds 63,500.` };
const id = 'token-budget';
const caption = ru
  ? 'Префикс 3000 токенов, 1500 токенов на шаг, окно 128 000 с запасом 4000 на ответ. Без сжатия контекст растёт линейно, а сумма прочитанных токенов — квадратично: 4 980 000 за 80 шагов, и на шаге 82 цикл останавливается. Сжатие при пороге H = 64 000 оставляет префикс и последние 8 шагов, а остальное заменяет резюме в 2000 токенов: за те же 80 шагов модель читает 2 791 500 токенов и ещё 105 500 читают два вызова суммаризатора, вместе 58% от исходного, и цикл может продолжаться сколько угодно.'
  : 'A prefix of 3,000 tokens, 1,500 tokens per step, a window of 128,000 with 4,000 kept for the reply. Without compaction the context grows linearly and the total read grows quadratically: 4,980,000 tokens over 80 steps, and the loop stops at step 82. Compaction at the mark H = 64,000 keeps the prefix and the last 8 steps and replaces the rest by a summary of 2,000 tokens: over the same 80 steps the model reads 2,791,500 tokens and the two summarizer calls another 105,500, together 58% of the original, and the loop can go on indefinitely.';

const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 320, px: [70, 740] as [number, number], py: [44, 260] as [number, number], leg: [86, 64, 20] as [number, number, number], inline: true },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 384, px: [52, 344] as [number, number], py: [120, 330] as [number, number], leg: [16, 18, 21] as [number, number, number], inline: false },
];
const yTicks = [0, 32000, 64000, 96000, 128000], xTicks = [0, 20, 40, 60, 80, 100, 120];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sx = scale([0, T], L.px), sy = scale([0, 128000], [L.py[1], L.py[0]]);
    const line = (vals: number[]) => polyline(vals.map((v, i) => [sx(i + 1), sy(v)] as [number, number]));
    const end = [sx(full.length), sy(full[full.length - 1])];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {yTicks.map((v) => <path class="f-grid" d={`M ${L.px[0]} ${sy(v)} H ${L.px[1]}`} />)}
        <path class="f-axis" d={`M ${L.px[0]} ${L.py[0] - 6} V ${L.py[1]} H ${L.px[1]}`} />
        {yTicks.map((v) => <text class="f-small" x={L.px[0] - 7} y={sy(v) + 4} text-anchor="end">{String(v / 1000)}</text>)}
        {xTicks.map((v) => <text class="f-small" x={sx(v)} y={L.py[1] + 18} text-anchor="middle">{String(v)}</text>)}
        <text class="f-small f-t-muted" x={(L.px[0] + L.px[1]) / 2} y={L.py[1] + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.px[0] - 40} y={L.py[0] - 20}>{t.y}</text>
        <path class="f-line f-muted f-dash" d={`M ${L.px[0]} ${sy(WINDOW - RESERVE)} H ${L.px[1]}`} />
        {L.inline && <text class="f-small f-t-muted f-halo" x={L.px[1]} y={sy(WINDOW - RESERVE) + 16} text-anchor="end">{t.win}</text>}
        <path class="f-line f-amber f-dash" d={`M ${L.px[0]} ${sy(HIGH)} H ${L.px[1]}`} />
        {L.inline && <text class="f-small f-t-amber f-halo" x={L.px[1]} y={sy(HIGH) - 8} text-anchor="end">{t.high}</text>}
        <path class="f-line f-red" d={line(full)} />
        <path class="f-line f-blue" d={line(comp.reads)} />
        <circle cx={end[0]} cy={end[1]} r="4" class="f-solid-red" />
        <text class="f-small f-t-red f-halo" x={end[0] + 8 + 8 * t.stop.length > L.W ? end[0] - 8 : end[0] + 8} y={end[1] + 34} text-anchor={end[0] + 8 + 8 * t.stop.length > L.W ? 'end' : 'start'}>{t.stop}</text>
        {[['f-line f-red', 'f-t-red', t.full], ['f-line f-blue', 'f-t-blue', t.comp], ...(L.inline ? [] : [['f-line f-muted f-dash', 'f-t-muted', t.win], ['f-line f-amber f-dash', 'f-t-amber', t.high]])].map(([cl, tc, label], i) => (
          <g>
            <path class={cl} d={`M ${L.leg[0]} ${L.leg[1] + i * L.leg[2] - 4} h 22`} />
            <text class={`f-small ${tc}`} x={L.leg[0] + 30} y={L.leg[1] + i * L.leg[2]}>{label}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
