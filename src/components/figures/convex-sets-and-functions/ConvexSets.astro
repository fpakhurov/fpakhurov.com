---
import Figure from '../Figure.astro';
import { polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

type V = [number, number];

// Panel 1: an ellipse (convex) with a chord between two inner points.
const ell = { rx: 95, ry: 70 };
const e1: V = [-60, 25], e2: V = [55, -35];
const inEll = (p: V) => (p[0] / ell.rx) ** 2 + (p[1] / ell.ry) ** 2;
if (!(inEll(e1) <= 1 && inEll(e2) <= 1)) throw new Error('ConvexSets: chord ends outside the ellipse');

// Panel 2: a crescent, the disk of radius R minus a disk of radius r centred d to the right (screen units).
const R = 80, r = 62, d = 45;
const xi = (R * R - r * r + d * d) / (2 * d), yi = Math.sqrt(R * R - xi * xi);
const aBig = Math.atan2(yi, xi), aSmall = Math.atan2(yi, xi - d);
const crescent: V[] = [];
for (let k = 0; k <= 80; k += 1) { const t = aBig + ((2 * Math.PI - 2 * aBig) * k) / 80; crescent.push([R * Math.cos(t), R * Math.sin(t)]); }
for (let k = 0; k <= 60; k += 1) { const t = 2 * Math.PI - aSmall - ((2 * Math.PI - 2 * aSmall) * k) / 60; crescent.push([d + r * Math.cos(t), r * Math.sin(t)]); }
const c1: V = [0, -70], c2: V = [0, 70];
const inCres = (p: V) => p[0] ** 2 + p[1] ** 2 <= R * R && (p[0] - d) ** 2 + p[1] ** 2 >= r * r;
if (!(inCres(c1) && inCres(c2))) throw new Error('ConvexSets: chord ends outside the crescent');
const yGap = Math.sqrt(r * r - d * d); // the chord x = 0 leaves the set for |y| below this
if (Math.abs(yGap - 42.65) > 0.01) throw new Error(`ConvexSets: gap drifted ${yGap}`);

// Panel 3: the convex hull of six points by the monotone chain; (1, 1) inside with weights 1/3, (2, 2) outside.
const pts: V[] = [[0, 0], [3, 0], [0, 3], [0.6, 1.6], [1.6, 0.5], [0.4, 0.5]];
const cross = (o: V, a: V, b: V) => (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0]);
const sorted = [...pts].sort((p, q) => p[0] - q[0] || p[1] - q[1]);
const half = (list: V[]) => { const h: V[] = []; for (const p of list) { while (h.length >= 2 && cross(h[h.length - 2], h[h.length - 1], p) <= 0) h.pop(); h.push(p); } h.pop(); return h; };
const hull = [...half(sorted), ...half([...sorted].reverse())];
if (hull.length !== 3) throw new Error(`ConvexSets: hull has ${hull.length} vertices`);
// barycentric weights with respect to (0,0), (3,0), (0,3): theta2 = x/3, theta3 = y/3, theta1 = 1 - theta2 - theta3
const bary = (p: V) => [1 - p[0] / 3 - p[1] / 3, p[0] / 3, p[1] / 3];
const w11 = bary([1, 1]), w22 = bary([2, 2]);
if (w11.some((t) => Math.abs(t - 1 / 3) > 1e-12) || Math.abs(w22[0] + 1 / 3) > 1e-12) throw new Error('ConvexSets: weights drifted');
const unit = 52;

const id = 'convex-sets';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 300, origins: [[133, 160], [380, 160], [560, 252]] as V[], titles: [[133, 26], [380, 26], [627, 26]] as V[] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 860, origins: [[180, 150], [170, 430], [110, 800]] as V[], titles: [[180, 28], [180, 308], [180, 588]] as V[] },
];
const T = ru
  ? { t1: 'выпуклое', t2: 'невыпуклое', t3: 'выпуклая оболочка', in1: 'хорда остаётся внутри', out2: 'хорда выходит из множества', inside: '(1, 1) внутри', outside: '(2, 2) снаружи' }
  : { t1: 'convex', t2: 'not convex', t3: 'convex hull', in1: 'chord stays inside', out2: 'chord leaves the set', inside: '(1, 1) inside', outside: '(2, 2) outside' };
---

<Figure
  id={id}
  title={ru ? 'Выпуклое множество, невыпуклое множество и выпуклая оболочка' : 'A convex set, a non-convex set and a convex hull'}
  caption={ru
    ? 'Слева эллипс: любая хорда остаётся внутри. В центре полумесяц, круг с вырезанным другим кругом: середина хорды (красный пунктир) проходит через вырезанную часть. Справа выпуклая оболочка шести точек — треугольник (0, 0), (3, 0), (0, 3). У точки (1, 1) веса ⅓, ⅓, ⅓; точке (2, 2) нужен вес −⅓, и она лежит снаружи.'
    : 'Left, an ellipse: every chord stays inside. Centre, a crescent, a disc with another disc removed: the middle of the chord (red dashes) crosses the removed part. Right, the convex hull of six points is the triangle (0, 0), (3, 0), (0, 3). The point (1, 1) has weights ⅓, ⅓, ⅓; the point (2, 2) needs the weight −⅓ and lies outside.'}
>
  {layouts.map((Ly) => {
    const [o1, o2, o3] = Ly.origins;
    const P1 = (p: V): V => [o1[0] + p[0], o1[1] + p[1]];
    const P2 = (p: V): V => [o2[0] + p[0], o2[1] + p[1]];
    const P3 = (p: V): V => [o3[0] + unit * p[0], o3[1] - unit * p[1]];
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{ru ? 'Выпуклое и невыпуклое множества с хордами и выпуклая оболочка точек' : 'Convex and non-convex sets with chords, and the convex hull of points'}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{ru
          ? 'Три панели. Эллипс с зелёной хордой внутри. Полумесяц, через который проходит хорда: её концы зелёные, а середина, вне множества, красная пунктирная. Треугольник выпуклой оболочки шести точек, точка (1, 1) внутри и точка (2, 2) снаружи.'
          : 'Three panels. An ellipse with a green chord inside it. A crescent crossed by a chord whose ends are green and whose middle, outside the set, is red and dashed. The triangle that is the convex hull of six points, with the point (1, 1) inside and the point (2, 2) outside.'}</desc>
        <text class="f-label" x={Ly.titles[0][0]} y={Ly.titles[0][1]} text-anchor="middle">{T.t1}</text>
        <text class="f-label" x={Ly.titles[1][0]} y={Ly.titles[1][1]} text-anchor="middle">{T.t2}</text>
        <text class="f-label" x={Ly.titles[2][0]} y={Ly.titles[2][1]} text-anchor="middle">{T.t3}</text>

        <ellipse cx={o1[0]} cy={o1[1]} rx={ell.rx} ry={ell.ry} class="f-fill-blue" />
        <ellipse cx={o1[0]} cy={o1[1]} rx={ell.rx} ry={ell.ry} class="f-line f-blue" />
        <path class="f-line f-green f-bold" d={polyline([P1(e1), P1(e2)])} />
        <circle cx={P1(e1)[0]} cy={P1(e1)[1]} r="4.5" class="f-solid-green" />
        <circle cx={P1(e2)[0]} cy={P1(e2)[1]} r="4.5" class="f-solid-green" />
        <text class="f-small f-t-green" x={o1[0]} y={o1[1] + ell.ry + 26} text-anchor="middle">{T.in1}</text>

        <path class="f-fill-blue" d={polyline(crescent.map(P2)) + ' Z'} />
        <path class="f-line f-blue" d={polyline(crescent.map(P2)) + ' Z'} />
        <path class="f-line f-green f-bold" d={polyline([P2(c1), P2([0, -yGap])])} />
        <path class="f-line f-green f-bold" d={polyline([P2([0, yGap]), P2(c2)])} />
        <path class="f-line f-red f-bold f-dash" d={polyline([P2([0, -yGap]), P2([0, yGap])])} />
        <circle cx={P2(c1)[0]} cy={P2(c1)[1]} r="4.5" class="f-solid-green" />
        <circle cx={P2(c2)[0]} cy={P2(c2)[1]} r="4.5" class="f-solid-green" />
        <text class="f-small f-t-red" x={o2[0]} y={o2[1] + R + 26} text-anchor="middle">{T.out2}</text>

        <path class="f-fill-blue" d={polyline(hull.map(P3)) + ' Z'} />
        <path class="f-line f-blue" d={polyline(hull.map(P3)) + ' Z'} />
        {pts.map((p) => <circle cx={P3(p)[0]} cy={P3(p)[1]} r="4" class="f-solid-blue" />)}
        <circle cx={P3([1, 1])[0]} cy={P3([1, 1])[1]} r="5" class="f-solid-green" />
        <text class="f-small f-halo" x={P3([1, 1])[0]} y={P3([1, 1])[1] + 20} text-anchor="middle">{T.inside}</text>
        <path class="f-line f-red" d={`M ${P3([2, 2])[0] - 6} ${P3([2, 2])[1] - 6} l 12 12 m 0 -12 l -12 12`} />
        <text class="f-small f-t-red" x={P3([2, 2])[0] - 8} y={P3([2, 2])[1] - 12} text-anchor="middle">{T.outside}</text>
        <text class="f-note" x={P3([0, 0])[0] - 4} y={P3([0, 0])[1] + 18} text-anchor="middle">(0, 0)</text>
        <text class="f-note" x={P3([3, 0])[0]} y={P3([3, 0])[1] + 18} text-anchor="middle">(3, 0)</text>
        <text class="f-note" x={P3([0, 3])[0] + 10} y={P3([0, 3])[1] + 2}>(0, 3)</text>
      </svg>
    );
  })}
</Figure>
