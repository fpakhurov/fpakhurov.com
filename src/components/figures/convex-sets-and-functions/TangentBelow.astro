---
import Figure from '../Figure.astro';
import { scale, plot, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

type V = [number, number];
// Left: f = e^x and its tangents at -1, 0, 1, all below the graph. Right: the baseline f = x^4 - 2x^2 + x/2,
// whose flat tangent at the local minimum lies above the graph around the global minimum.
const ex = (x: number) => Math.exp(x);
const tan = (a: number) => (x: number) => Math.exp(a) * (1 + x - a);
const gapAt1 = ex(1) - tan(0)(1);
const fb = (x: number) => x ** 4 - 2 * x ** 2 + 0.5 * x;
const dfb = (x: number) => 4 * x ** 3 - 4 * x + 0.5;
const newton = (x0: number) => { let x = x0; for (let k = 0; k < 50; k += 1) x -= dfb(x) / (12 * x * x - 4); return x; };
const xLoc = newton(1), xGlob = newton(-1);
const fLoc = fb(xLoc), fGlob = fb(xGlob);
// where the graph crosses the flat tangent y = fLoc on the left: bisection on [-1.6, xGlob] and [xGlob, 0]
const bis = (a: number, b: number) => { let lo = a, hi = b; const s = Math.sign(fb(lo) - fLoc); for (let k = 0; k < 80; k += 1) { const m = (lo + hi) / 2; if (Math.sign(fb(m) - fLoc) === s) lo = m; else hi = m; } return (lo + hi) / 2; };
const xa = bis(-1.6, xGlob), xb = bis(xGlob, 0);
const got = [gapAt1.toFixed(3), xLoc.toFixed(3), fLoc.toFixed(3), xGlob.toFixed(3), fGlob.toFixed(3), (fLoc - fGlob).toFixed(3)].join(' ');
if (got !== '0.718 0.930 -0.517 -1.057 -1.515 0.998') throw new Error(`TangentBelow: numbers drifted: ${got}`);
const below: V[] = [];
for (let k = 0; k <= 60; k += 1) { const x = xa + ((xb - xa) * k) / 60; below.push([x, fb(x)]); }

const id = 'tangent-below';
const panels = [
  { key: 'convex', dx: [-2.2, 1.5] as V, dy: [-1, 4.6] as V, xt: [-2, -1, 0, 1], yt: [2, 4] },
  { key: 'baseline', dx: [-1.6, 1.55] as V, dy: [-1.9, 1.6] as V, xt: [-1, 0, 1], yt: [-1, 1] },
];
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 350, boxes: [[50, 350, 34, 270], [440, 740, 34, 270]], lab: 302 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 740, boxes: [[44, 340, 34, 270], [44, 340, 404, 640]], lab: 0 },
];
const T = ru
  ? { t1: 'выпуклая: касательные ниже графика', t2: 'невыпуклая: касательная выше графика', curve1: 'f(x) = eˣ', curve2: 'x⁴ − 2x² + x/2', gap: '0.718', loc: 'локальный −0.517', glob: 'глобальный −1.515', under: 'на 0.998 ниже' }
  : { t1: 'convex: tangents below the graph', t2: 'not convex: a tangent above the graph', curve1: 'f(x) = eˣ', curve2: 'x⁴ − 2x² + x/2', gap: '0.718', loc: 'local −0.517', glob: 'global −1.515', under: '0.998 below' };
---

<Figure
  id={id}
  title={ru ? 'Касательная выпуклой функции лежит под графиком' : 'The tangent of a convex function lies below the graph'}
  caption={ru
    ? 'Слева f(x) = eˣ и её касательные в точках −1, 0 и 1: каждая целиком лежит под графиком. Касательная в 0 — прямая 1 + x; в точке x = 1 график выше неё на e − 2 = 0.718. Справа невыпуклая функция x⁴ − 2x² + x/2 из начала заметки. В её локальном минимуме x = 0.930 касательная горизонтальна (уровень −0.517), но около глобального минимума x = −1.057 график опускается под неё на 0.998 (закрашено). Ноль производной без выпуклости — только кандидат.'
    : 'Left, f(x) = eˣ and its tangents at −1, 0 and 1: each lies entirely below the graph. The tangent at 0 is the line 1 + x; at x = 1 the graph is above it by e − 2 = 0.718. Right, the non-convex function x⁴ − 2x² + x/2 from the start of the note. At its local minimum x = 0.930 the tangent is flat, at height −0.517, but near the global minimum x = −1.057 the graph drops 0.998 below it (shaded). Without convexity a zero derivative is only a candidate.'}
>
  {layouts.map((Ly) => (
    <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
      <title id={`${id}-${Ly.sfx}-t`}>{ru ? 'Касательные выпуклой и невыпуклой функций' : 'Tangents of a convex and a non-convex function'}</title>
      <desc id={`${id}-${Ly.sfx}-d`}>{ru
        ? 'Слева экспонента и три касательные под ней, с отмеченным зазором 0.718 при x = 1. Справа кривая с двумя ямами: горизонтальная касательная в правой, мелкой яме проходит выше дна левой, глубокой ямы; область под касательной закрашена.'
        : 'Left, the exponential with three tangent lines below it and the gap 0.718 marked at x = 1. Right, a curve with two wells: the flat tangent at the bottom of the shallow right well passes above the bottom of the deeper left well; the region below the tangent is shaded.'}</desc>
      {panels.map((p, j) => {
        const [x0, x1, y0, y1] = Ly.boxes[j];
        const sx = scale(p.dx, [x0, x1]), sy = scale(p.dy, [y1, y0]);
        const S = (v: V): V => [sx(v[0]), sy(v[1])];
        const clip = `${id}-${Ly.sfx}-${p.key}`;
        return (
          <g>
            <defs><clipPath id={clip}><rect x={x0} y={y0} width={x1 - x0} height={y1 - y0} /></clipPath></defs>
            <text class="f-small" x={(x0 + x1) / 2} y={y0 - 14} text-anchor="middle">{j === 0 ? T.t1 : T.t2}</text>
            <path class="f-axis" d={`M ${x0} ${sy(0)} H ${x1} M ${sx(0)} ${y0} V ${y1}`} />
            {p.xt.map((v) => <text class="f-note" x={sx(v)} y={sy(0) + (j === 0 ? 17 : -7)} text-anchor="middle">{v === 0 ? '' : v}</text>)}
            {p.yt.map((v) => <text class="f-note" x={sx(0) - 6} y={sy(v) + 5} text-anchor="end">{v}</text>)}
            <g clip-path={`url(#${clip})`}>
              {j === 0 && [-1, 0, 1].map((a) => <path class={a === 0 ? 'f-line f-green' : 'f-thin f-green'} d={plot(tan(a), p.dx[0], p.dx[1], sx, sy, 2)} />)}
              {j === 0 && <path class="f-line f-blue f-bold" d={plot(ex, p.dx[0], p.dx[1], sx, sy, 120)} />}
              {j === 1 && <path class="f-fill-red" d={polyline(below.map(S)) + ' Z'} />}
              {j === 1 && <path class="f-line f-red f-dash" d={`M ${x0} ${sy(fLoc)} H ${x1}`} />}
              {j === 1 && <path class="f-line f-blue f-bold" d={plot(fb, p.dx[0], p.dx[1], sx, sy, 160)} />}
            </g>
            {j === 0 && (
              <g>
                {[-1, 0, 1].map((a) => <circle cx={sx(a)} cy={sy(ex(a))} r="4" class="f-solid-green" />)}
                <path class="f-line f-amber" d={`M ${sx(1)} ${sy(tan(0)(1))} V ${sy(ex(1))}`} />
                <text class="f-small f-t-amber f-halo" x={sx(1) + 6} y={sy(1.65)}>{T.gap}</text>
                <text class="f-small f-t-blue f-halo" x={sx(0.62)} y={sy(4.2)} text-anchor="end">{T.curve1}</text>
              </g>
            )}
            {j === 1 && (
              <g>
                <circle cx={sx(xLoc)} cy={sy(fLoc)} r="4.5" class="f-solid-red" />
                <circle cx={sx(xGlob)} cy={sy(fGlob)} r="4.5" class="f-solid-blue" />
                <path class="f-line f-amber" d={`M ${sx(xGlob)} ${sy(fGlob)} V ${sy(fLoc)}`} />
                <text class="f-small f-t-red f-halo" x={x1} y={sy(fLoc) + 20} text-anchor="end">{T.loc}</text>
                <text class="f-small f-t-blue f-halo" x={sx(xGlob)} y={sy(fGlob) + 20} text-anchor="middle">{T.glob}</text>
                <text class="f-small f-t-amber f-halo" x={sx(-0.88)} y={sy(fLoc) - 8} text-anchor="middle">{T.under}</text>
                <text class="f-small f-t-blue f-halo" x={sx(-0.5)} y={sy(1.25)} text-anchor="middle">{T.curve2}</text>
              </g>
            )}
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
