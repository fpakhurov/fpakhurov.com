---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The asyncio program of the note: three tasks a, b, c that sleep 0.3, 0.1 and 0.2 s inside one TaskGroup.
// Simulate the event loop: run every ready task until it awaits, then wake the task with the earliest timer.
const delays: Record<string, number> = { a: 0.3, b: 0.1, c: 0.2 };
const order = Object.keys(delays).sort((p, q) => delays[p] - delays[q]);
if (order.join('') !== 'bca') throw new Error('wake order');
const timers = (left: string[]) => left.map((k) => `${k}@${delays[k].toFixed(1)}`).join(' ');
// One row per step: time, what runs, what waits on a timer afterwards, what is printed (the program printed these lines).
const rows = [
  { time: 0, runs: 'main', waits: '', prints: ru ? 'создаёт задачи a, b, c' : 'creates tasks a, b, c', isPrint: false },
  { time: 0, runs: 'a, b, c', waits: timers(order), prints: 'a starts, b starts, c starts', isPrint: true },
  { time: 0.1, runs: 'b', waits: timers(order.slice(1)), prints: 'b done', isPrint: true },
  { time: 0.2, runs: 'c', waits: timers(order.slice(2)), prints: 'c done', isPrint: true },
  { time: 0.3, runs: 'a, main', waits: '', prints: "a done; results [...]", isPrint: true },
];
if (rows[1].waits !== 'b@0.1 c@0.2 a@0.3') throw new Error('timers after the first round');
const total = Math.max(...Object.values(delays));
const sequential = Object.values(delays).reduce((x, y) => x + y, 0);
if (total !== 0.3 || Math.abs(sequential - 0.6) > 1e-12) throw new Error('0.3 s together, 0.6 s one after another');

const t = ru
  ? { cols: ['время', 'выполняется', 'ждут таймера', 'печать'], none: '—', runs: 'выполняется: ', waits: 'ждут: ', prints: 'печать: ',
      loop: ['цикл событий: выполнить готовые задачи до их await,', 'затем ждать ближайший таймер или ввод-вывод'],
      loopN: ['цикл событий: выполнить готовые', 'задачи до их await, затем ждать', 'ближайший таймер или ввод-вывод'],
      steps: ['asyncio.run запускает цикл; main создаёт три задачи', 'каждая задача идёт до await asyncio.sleep и уступает', 'в 0.1 с срабатывает таймер b; b завершается', 'в 0.2 с завершается c', 'в 0.3 с завершается a; TaskGroup отпускает main'] }
  : { cols: ['time', 'runs', 'waiting on a timer', 'prints'], none: '—', runs: 'runs: ', waits: 'waiting: ', prints: 'prints: ',
      loop: ['the event loop: run the ready tasks until they await,', 'then wait for the earliest timer or I/O event'],
      loopN: ['the event loop: run ready tasks', 'until they await, then wait for', 'the earliest timer or I/O event'],
      steps: ['asyncio.run starts the loop; main creates three tasks', 'each task runs to await asyncio.sleep and yields', "at 0.1 s b's timer fires; b finishes", 'at 0.2 s c finishes', 'at 0.3 s a finishes; the TaskGroup lets main go on'] };
const timeText = (v: number) => (ru ? `${v.toFixed(2)} с` : `${v.toFixed(2)} s`);

interface Layout { cls: string; W: number; wide: boolean; y0: number; rowH: number; cols: number[]; mono: number; sans: number; badgeX: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, wide: true, y0: 78, rowH: 34, cols: [44, 124, 244, 420], mono: 7.5, sans: 6.5, badgeX: 22 },
  { cls: 'fig-narrow seq-narrow', W: 360, wide: false, y0: 100, rowH: 74, cols: [34], mono: 8.4, sans: 7.3, badgeX: 17 },
];
for (const L of layouts) {
  for (const s of L.wide ? t.loop : t.loopN) if (22 + s.length * L.sans > L.W - 14) throw new Error(`loop text overflows at ${L.W}`);
  for (const r of rows) {
    if (L.wide) {
      if (L.cols[1] + r.runs.length * L.mono > L.cols[2] - 8) throw new Error('runs column');
      if (L.cols[2] + r.waits.length * L.mono > L.cols[3] - 8) throw new Error('waits column');
      if (L.cols[3] + r.prints.length * (r.isPrint ? L.mono : L.sans) > L.W - 4) throw new Error(`prints "${r.prints}"`);
    } else {
      if (L.cols[0] + (t.runs.length + r.runs.length + 9) * L.sans > L.W - 4) throw new Error('narrow line 1');
      if (L.cols[0] + t.waits.length * L.sans + r.waits.length * L.mono > L.W - 4) throw new Error('narrow line 2');
      if (L.cols[0] + t.prints.length * L.sans + r.prints.length * L.mono > L.W - 4) throw new Error(`narrow line 3 "${r.prints}"`);
    }
  }
}
const H = (L: Layout) => L.y0 + rows.length * L.rowH + 4;
const id = 'event-loop';
---

<Figure
  id={id}
  title={ru ? 'Цикл событий выполняет три задачи' : 'The event loop runs three tasks'}
  caption={ru
    ? 'Программа из заметки: задачи a, b и c внутри одного TaskGroup ждут asyncio.sleep 0.3, 0.1 и 0.2 с. Всё происходит в одном потоке. Цикл событий выполняет каждую готовую задачу до её await, где она уступает управление и оставляет таймер (1, 2). Пока таймеры не сработали, цикл ждёт, не занимая процессор; ближайший таймер будит b в 0.1 с (3), затем c (4) и a (5). Вся программа занимает 0.30 с — столько, сколько самая долгая задача, а не сумму 0.6 с. Времена — те, что напечатала программа на CPython 3.14.7.'
    : 'The program of the note: tasks a, b and c in one TaskGroup await asyncio.sleep for 0.3, 0.1 and 0.2 s. Everything happens in one thread. The event loop runs each ready task until its await, where it yields and leaves a timer behind (1, 2). Until a timer fires, the loop waits without using the processor; the earliest timer wakes b at 0.1 s (3), then c (4) and a (5). The whole program takes 0.30 s, the longest task rather than the sum of 0.6 s. The times are those the program printed on CPython 3.14.7.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${H(L)}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Пять шагов цикла событий' : 'Five steps of the event loop'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Сверху — правило цикла событий. Ниже пять строк: время, какая задача выполняется, какие задачи ждут таймера и что напечатано. В 0 с main создаёт задачи, затем a, b и c начинают и засыпают; в 0.1 с завершается b, в 0.2 с — c, в 0.3 с — a и main.'
        : 'At the top, the rule of the event loop. Below, five rows: the time, which task runs, which tasks wait on a timer, and what is printed. At 0 s main creates the tasks, then a, b and c start and sleep; at 0.1 s b finishes, at 0.2 s c, at 0.3 s a and main.'}</desc>
      <rect x="10" y="8" width={L.W - 20} height={L.wide ? 44 : 70} rx="7" style={`fill: ${toneVar.h}; fill-opacity: 0.1; stroke: ${toneVar.h}; stroke-width: 1.2`} />
      {(L.wide ? t.loop : t.loopN).map((s, i) => <text class="f-small" x="22" y={26 + i * 20}>{s}</text>)}
      {L.wide && t.cols.map((c, i) => <text class="f-small f-t-muted" x={L.cols[i]} y={L.y0 - 8} style="font-weight: 650">{c}</text>)}
      {rows.map((r, k) => {
        const top = L.y0 + k * L.rowH;
        const printCls = r.isPrint ? 'f-small f-t-red' : 'f-small f-t-muted';
        const printStyle = r.isPrint ? 'font-family: var(--mono)' : '';
        return (
          <g data-s={String(k + 1)}>
            <Badge x={L.badgeX} y={top + (L.wide ? 13 : 12)} n={k + 1} />
            {L.wide && (
              <g>
                <text class="f-small" x={L.cols[0]} y={top + 17}>{timeText(r.time)}</text>
                <text class="f-small f-t-blue" x={L.cols[1]} y={top + 17} style="font-family: var(--mono)">{r.runs}</text>
                <text class="f-small" x={L.cols[2]} y={top + 17} style="font-family: var(--mono)">{r.waits || t.none}</text>
                <text class={printCls} x={L.cols[3]} y={top + 17} style={printStyle}>{r.prints}</text>
              </g>
            )}
            {!L.wide && (
              <g>
                <text class="f-small" x={L.cols[0]} y={top + 16}>{timeText(r.time)}<tspan style="fill: var(--muted)">{`   ${t.runs}`}</tspan><tspan style="fill: var(--fig-blue); font-family: var(--mono)">{r.runs}</tspan></text>
                <text class="f-small" x={L.cols[0]} y={top + 38}><tspan style="fill: var(--muted)">{t.waits}</tspan><tspan style="font-family: var(--mono)">{r.waits || t.none}</tspan></text>
                <text class="f-small" x={L.cols[0]} y={top + 60}><tspan style="fill: var(--muted)">{t.prints}</tspan><tspan style={r.isPrint ? 'fill: var(--fig-red); font-family: var(--mono)' : 'fill: var(--muted)'}>{r.prints}</tspan></text>
              </g>
            )}
          </g>
        );
      })}
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
