---
import Figure from '../Figure.astro';
import { scale } from '../regressionGeometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
// Original residual accounting illustration, replacing the former 3D projection scene.
const xs = [0, 1, 2, 3], observed = [1, 3, 2, 5];
const fitted = xs.map((x) => 1.1 + 1.1 * x);
const residual = observed.map((y, i) => y - fitted[i]);
const alternative = xs.map((x) => 1 + x);
const squared = (a: number[]) => a.reduce((sum, v) => sum + v * v, 0);
const rss = squared(residual);
const gap = squared(fitted.map((v, i) => v - alternative[i]));
const other = squared(observed.map((v, i) => v - alternative[i]));
if (Math.abs(residual.reduce((a, b) => a + b, 0)) > 1e-12 || Math.abs(residual.reduce((a, b, i) => a + b * xs[i], 0)) > 1e-12) throw new Error('ProjectionGeometry: residual is not orthogonal');
if (Math.abs(other - rss - gap) > 1e-12 || rss.toFixed(1) !== '2.7' || gap.toFixed(1) !== '0.3') throw new Error('ProjectionGeometry: Pythagorean identity failed');
const id = 'projection-geometry';
const layouts = [
  { key: 'w', cls: 'fig-wide', W: 760, H: 310, left: 48, right: 410, top: 28, bottom: 250, tx: 455, ty: 65 },
  { key: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 470, left: 42, right: 338, top: 28, bottom: 250, tx: 20, ty: 310 },
];
---
<Figure id={id}
  title={ru ? 'Остатки отделены от пространства прогнозов' : 'Residuals separate from the prediction space'}
  caption={ru
    ? 'Прямая МНК даёт RSS = 2.7; другая прямая добавляет 0.3. Нулевые суммы остатков и их произведений на x выражают ортогональность в пространстве четырёх наблюдений. Углы отрезков на диаграмме её не изображают.'
    : 'The least-squares line has RSS = 2.7; another line adds 0.3. Zero sums of residuals and residual–x products express orthogonality in the four-observation space. Segment angles in this chart do not represent it.'}>
  {layouts.map((a) => {
    const sx = scale([-0.2, 3.2], [a.left, a.right]);
    const sy = scale([0, 5.5], [a.bottom, a.top]);
    return <svg class={a.cls} viewBox={`0 0 ${a.W} ${a.H}`} role="img" aria-labelledby={`${id}-${a.key}-t ${id}-${a.key}-d`}>
      <title id={`${id}-${a.key}-t`}>{ru ? 'Четыре наблюдения и ортогональные остатки МНК' : 'Four observations and orthogonal least-squares residuals'}</title>
      <desc id={`${id}-${a.key}-d`}>{ru ? 'Точки, синяя прямая МНК и серый альтернативный прогноз. Красные вертикальные отрезки показывают ошибки; рядом выписаны две нулевые суммы и разложение RSS.' : 'Points, a blue least-squares line and a grey alternative prediction. Red vertical segments show errors; two zero sums and the RSS decomposition are listed beside the chart.'}</desc>
      {[1, 2, 3, 4, 5].map((v) => <g><path class="f-grid" d={`M ${a.left} ${sy(v)} H ${a.right}`} /><text class="f-note" x={a.left - 8} y={sy(v) + 4} text-anchor="end">{v}</text></g>)}
      <path class="f-axis" d={`M ${a.left} ${a.top} V ${a.bottom} H ${a.right}`} />
      <path class="f-line f-blue f-bold" d={`M ${sx(0)} ${sy(1.1)} L ${sx(3)} ${sy(4.4)}`} />
      <path class="f-thin f-muted f-dash" d={`M ${sx(0)} ${sy(1)} L ${sx(3)} ${sy(4)}`} />
      {xs.map((x, i) => <g>
        <path class="f-line f-red" d={`M ${sx(x)} ${sy(observed[i])} V ${sy(fitted[i])}`} />
        <circle cx={sx(x)} cy={sy(observed[i])} r="4" class="f-solid-muted" />
        <circle cx={sx(x)} cy={sy(fitted[i])} r="3" class="f-solid-blue" />
        <text class="f-note" x={sx(x)} y={a.bottom + 20} text-anchor="middle">{x}</text>
      </g>)}
      <text class="f-small" x={a.tx} y={a.ty}>Σrᵢ = 0</text>
      <text class="f-small" x={a.tx} y={a.ty + 30}>Σxᵢrᵢ = 0</text>
      <text class="f-small" x={a.tx} y={a.ty + 70}>{ru ? 'МНК: RSS = 2.7' : 'Least squares: RSS = 2.7'}</text>
      <text class="f-small" x={a.tx} y={a.ty + 100}>1 + x: RSS = 2.7 + 0.3</text>
      <text class="f-note" x={a.tx} y={a.ty + 130}>{ru ? 'Другие веса добавляют ошибку' : 'Different weights add error'}</text>
    </svg>;
  })}
</Figure>
