---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Q(w) = ½ wᵀHw with eigenvalues L = 4.5 and μ = 0.045 (κ = 100), minimum at 0, exact gradients.
// Left: H = diag(L, μ), the axes are the eigenvectors (features on different scales). Right: the same bowl rotated
// by 30° (correlated features), started from the rotated starting point, so that any rotation-invariant method
// traces the rotated copy of its left path. Steps are counted until Q falls below 1/1000 of Q(w₀).
type V = [number, number];
const mu = 0.045, Lh = 4.5;
const c = Math.cos(Math.PI / 6), s = Math.sin(Math.PI / 6);
const rot = (v: V): V => [c * v[0] - s * v[1], s * v[0] + c * v[1]];
const H1 = [[Lh, 0], [0, mu]];
const H2 = [[Lh * c * c + mu * s * s, (Lh - mu) * c * s], [(Lh - mu) * c * s, Lh * s * s + mu * c * c]];
const w0: V = [-2.4, 1.6];
type Method = 'gd' | 'momentum' | 'adam';
const run = (H: number[][], start: V, method: Method, eta: number, beta = 0) => {
  const Hv = (v: V): V => [H[0][0] * v[0] + H[0][1] * v[1], H[1][0] * v[0] + H[1][1] * v[1]];
  const q = (v: V) => { const h = Hv(v); return 0.5 * (v[0] * h[0] + v[1] * h[1]); };
  let w: V = start, v: V = [0, 0], m: V = [0, 0], s2: V = [0, 0];
  const path: V[] = [w];
  let steps = 0;
  for (let k = 1; k <= 2000; k += 1) {
    const g = Hv(w);
    if (method === 'gd') w = [w[0] - eta * g[0], w[1] - eta * g[1]];
    if (method === 'momentum') { v = [beta * v[0] + g[0], beta * v[1] + g[1]]; w = [w[0] - eta * v[0], w[1] - eta * v[1]]; }
    if (method === 'adam') {
      m = [0.9 * m[0] + 0.1 * g[0], 0.9 * m[1] + 0.1 * g[1]];
      s2 = [0.999 * s2[0] + 0.001 * g[0] ** 2, 0.999 * s2[1] + 0.001 * g[1] ** 2];
      const b1 = 1 - 0.9 ** k, b2 = 1 - 0.999 ** k;
      w = [w[0] - (eta * m[0] / b1) / (Math.sqrt(s2[0] / b2) + 1e-8), w[1] - (eta * m[1] / b1) / (Math.sqrt(s2[1] / b2) + 1e-8)];
    }
    path.push(w);
    if (!steps && q(w) < 1e-3 * q(start)) steps = k;
  }
  return { path, steps };
};
const methods = [
  { key: 'gd' as Method, eta: 2 / (Lh + mu), beta: 0, cls: 'f-line f-blue', dot: 'f-solid-blue', show: 40 },
  { key: 'momentum' as Method, eta: 0.05, beta: 0.9, cls: 'f-line f-green f-bold', dot: 'f-solid-green', show: 60 },
  { key: 'adam' as Method, eta: 0.2, beta: 0, cls: 'f-line f-red f-bold', dot: 'f-solid-red', show: 60 },
];
const res = [H1, H2].map((H, j) => methods.map((M) => run(H, j === 0 ? w0 : rot(w0), M.key, M.eta, M.beta)));
const got = res.map((r) => r.map((x) => x.steps).join(',')).join(' | ');
if (got !== '173,48,13 | 173,48,171') throw new Error(`OptimizerPaths: step counts drifted: ${got}`);
const legend = [
  { en: 'gradient descent, η = 2/(L + μ): 173 | 173 steps', ru: 'градиентный спуск, η = 2/(L + μ): 173 | 173 шага', sen: 'gradient descent: 173 | 173', sru: 'град. спуск: 173 | 173' },
  { en: 'momentum, β = 0.9, η = 0.05: 48 | 48 steps', ru: 'импульс, β = 0.9, η = 0.05: 48 | 48 шагов', sen: 'momentum, β = 0.9: 48 | 48', sru: 'импульс, β = 0.9: 48 | 48' },
  { en: 'Adam, η = 0.2: 13 | 171 steps', ru: 'Adam, η = 0.2: 13 | 171 шаг', sen: 'Adam, η = 0.2: 13 | 171', sru: 'Adam, η = 0.2: 13 | 171' },
];
const panels = [
  { H: H1, en: 'different scales: H diagonal', ru: 'разные масштабы: H диагональна' },
  { H: H2, en: 'correlated features: the same H rotated by 30°', ru: 'коррелированные признаки: та же H, повёрнутая на 30°',
    split: { en: ['correlated features:', 'the same H rotated by 30°'], ru: ['коррелированные признаки:', 'та же H, повёрнутая на 30°'] } },
];
// the panel title, on two lines in the narrow layout when the panel has a split form
const titleLines = (p: { en: string; ru: string; split?: { en: string[]; ru: string[] } }, short: boolean) =>
  (short && p.split ? (ru ? p.split.ru : p.split.en) : [ru ? p.ru : p.en]);
const ellipse = (H: number[][], cq: number) => {
  // ½ wᵀHw = cq: semi-axes √(2cq/λ) along the eigenvectors; panel 1 is axis-aligned, panel 2 rotated
  const aligned = H === H1;
  return Array.from({ length: 121 }, (_, k) => {
    const th = (2 * Math.PI * k) / 120;
    const p: V = [Math.sqrt((2 * cq) / Lh) * Math.cos(th), Math.sqrt((2 * cq) / mu) * Math.sin(th)];
    return aligned ? p : rot(p);
  });
};
const levels = [0.005, 0.03, 0.12, 0.5, 2, 8];
const dom = { x: [-3.1, 2.6] as V, y: [-0.75, 2.75] as V };
const id = 'optimizers-paths';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 340, unit: 58, boxes: [[30, 30], [410, 30]] as V[], lx: 30, ly: 266, short: false },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 576, unit: 56, boxes: [[20, 30], [20, 278]] as V[], lx: 14, ly: 510, short: true },
];
---

<Figure
  id={id}
  title={ru ? 'Импульс и Adam на вытянутой чаше' : 'Momentum and Adam on a stretched bowl'}
  caption={ru
    ? 'Квадратичная функция Q(w) = ½wᵀHw с собственными числами 4.5 и 0.045 (κ = 100), точные градиенты, первые 40–60 шагов каждого метода; число шагов до уменьшения Q в 1000 раз указано для левой | правой панели. Слева оси совпадают с собственными векторами, как у признаков разного масштаба; справа та же чаша повёрнута на 30°, как у коррелированных признаков, и старт повёрнут вместе с ней. Градиентный спуск с лучшим постоянным шагом мечется поперёк долины (173 шага). Импульс накапливает скорость вдоль дна и доходит за 48 шагов. Оба метода не замечают поворота: правый путь — повёрнутая копия левого. Adam делит шаг по каждой координате на её типичный градиент и на диагональной чаше идёт почти прямо к минимуму, проскакивает его по инерции и возвращается (13 шагов), но после поворота долина больше не идёт вдоль осей, и он не быстрее градиентного спуска (171 шаг).'
    : 'The quadratic Q(w) = ½wᵀHw with eigenvalues 4.5 and 0.045 (κ = 100), exact gradients, the first 40–60 steps of each method; the number of steps until Q falls 1000-fold is given for the left | right panel. Left, the axes are the eigenvectors, as for features on different scales; right, the same bowl rotated by 30°, as for correlated features, with the start rotated too. Gradient descent with the best constant step bounces across the valley (173 steps). Momentum builds up speed along the floor and arrives in 48 steps. Neither method notices the rotation: the right path is a rotated copy of the left one. Adam divides each coordinate\'s step by that coordinate\'s typical gradient and heads almost straight for the minimum on the diagonal bowl, overshoots it under its own momentum and loops back (13 steps), but after the rotation the valley no longer runs along an axis, and it is no faster than gradient descent (171 steps).'}
>
  {layouts.map((Ly) => (
    <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
      <title id={`${id}-${Ly.sfx}-t`}>{ru ? 'Пути градиентного спуска, импульса и Adam' : 'Paths of gradient descent, momentum and Adam'}</title>
      <desc id={`${id}-${Ly.sfx}-d`}>{ru
        ? 'Две панели с вытянутыми эллипсами линий уровня, слева горизонтальными, справа наклонными. Синий зигзаг градиентного спуска и зелёная дуга импульса одинаковы в обеих панелях с точностью до поворота. Красный путь Adam слева идёт почти прямо к центру и делает петлю вокруг него, справа уходит в сторону и затем медленно петляет.'
        : 'Two panels of stretched contour ellipses, horizontal on the left and tilted on the right. The blue zigzag of gradient descent and the green arc of momentum are the same in both panels up to the rotation. The red path of Adam heads almost straight for the centre on the left and loops around it; on the right it veers off and then winds slowly.'}</desc>
      {panels.map((p, j) => {
        const [bx, by] = Ly.boxes[j];
        const w = Ly.unit * (dom.x[1] - dom.x[0]), h = Ly.unit * (dom.y[1] - dom.y[0]);
        const sx = scale(dom.x, [bx, bx + w]), sy = scale(dom.y, [by + h, by]);
        const S = (v: V) => [sx(v[0]), sy(v[1])] as [number, number];
        const clip = `${id}-${Ly.sfx}-${j}`;
        const start = j === 0 ? w0 : rot(w0);
        const tl = titleLines(p, Ly.short);
        return (
          <g>
            <defs><clipPath id={clip}><rect x={bx} y={by} width={w} height={h} /></clipPath></defs>
            <rect x={bx} y={by} width={w} height={h} class="f-box-soft" style="fill: none" />
            {tl.map((s, i) => <text class="f-small" x={bx} y={by - 10 - (tl.length - 1 - i) * 17}>{s}</text>)}
            <g clip-path={`url(#${clip})`}>
              {levels.map((cq) => <path class="f-thin f-muted" style="stroke-opacity: .5" d={polyline(ellipse(p.H, cq).map(S)) + ' Z'} />)}
              {methods.map((M, i) => <path class={M.cls} style={M.key === 'gd' ? 'stroke-width: 1.2; stroke-opacity: .8' : undefined} d={polyline(res[j][i].path.slice(0, M.show + 1).map(S))} />)}
            </g>
            <circle cx={S(start)[0]} cy={S(start)[1]} r="4" class="f-solid-muted" />
            <text class="f-note f-halo" x={S(start)[0] + 7} y={S(start)[1] - 8}>w₀</text>
            <circle cx={S([0, 0])[0]} cy={S([0, 0])[1]} r="4" class="f-solid-muted" style="fill: var(--ink)" />
          </g>
        );
      })}
      {legend.map((g, i) => (
        <g>
          <path class={methods[i].cls} d={`M ${Ly.lx} ${Ly.ly + i * 24 - 4} h 24`} />
          <text class="f-small" x={Ly.lx + 31} y={Ly.ly + i * 24}>{Ly.short ? (ru ? g.sru : g.sen) : (ru ? g.ru : g.en)}</text>
        </g>
      ))}
    </svg>
  ))}
</Figure>
