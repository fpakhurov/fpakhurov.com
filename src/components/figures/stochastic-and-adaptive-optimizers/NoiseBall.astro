---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { n, epochs, every, sgdCurve, gdCurve, schedules, sigma2, mu, L } from './noiseBall';

const ru = pageLang(Astro.url) === 'ru';

const big = sgdCurve(schedules.big), small = sgdCurve(schedules.small), decay = sgdCurve(schedules.decay), gd = gdCurve();
const lastEpoch = (c: number[]) => c.slice(-n / every).reduce((a, b) => a + b, 0) / (n / every);
const floor = (eta: number) => (eta * sigma2 * (mu + L)) / 4;   // small-step approximation η σ² tr(H) / 4
const e2 = (v: number) => v.toExponential(1);
const got = [lastEpoch(big).toFixed(3), lastEpoch(small).toFixed(4), floor(0.1).toFixed(3), floor(0.02).toFixed(4), e2(decay[decay.length - 1]), gd[1].toFixed(2), e2(gd[epochs]), big[1].toFixed(3), gd[0].toFixed(2)].join(' ');
if (got !== '0.050 0.0072 0.045 0.0090 7.8e-4 0.50 1.9e-3 0.049 1.27') throw new Error(`NoiseBall: numbers drifted: ${got}`);

const curves = [
  { c: big, cls: 'f-line f-red', en: 'SGD, η = 0.1', ru: 'SGD, η = 0.1', fl: floor(0.1), flCls: 'f-thin f-red f-dash' },
  { c: small, cls: 'f-line f-amber', en: 'SGD, η = 0.02', ru: 'SGD, η = 0.02', fl: floor(0.02), flCls: 'f-thin f-amber f-dash' },
  { c: decay, cls: 'f-line f-green f-bold', en: 'SGD, η = 0.1 / (1 + k/250)', ru: 'SGD, η = 0.1 / (1 + k/250)', fl: 0, flCls: '' },
];
const ticks = [0, -1, -2, -3, -4];
const id = 'optimizers-noise-ball';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 340, px: [62, 500] as [number, number], py: [16, 280] as [number, number], lx: 526, ly: 40 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 520, px: [52, 344] as [number, number], py: [16, 280] as [number, number], lx: 14, ly: 352 },
];
---

<Figure
  id={id}
  title={ru ? 'Постоянный шаг останавливается в шумовом шаре' : 'A constant step stalls in a noise ball'}
  caption={ru
    ? 'Метод наименьших квадратов на 500 точках с двумя коррелированными признаками, шум с дисперсией 1. По горизонтали — число просмотренных примеров в эпохах, по вертикали — избыток потерь Q(w) − Q(ŵ) в логарифмическом масштабе; кривые SGD усреднены по 30 случайным порядкам примеров. Полный градиентный спуск (синие точки) делает один шаг 1/L за эпоху: 0.50 после первой эпохи и 1.9·10⁻³ после десятой. SGD с шагом 0.1 уже за 50 примеров спускается до 0.049 и дальше не идёт: в последнюю эпоху среднее 0.050. Шаг 0.02 спускается медленнее, но до уровня примерно в семь раз ниже, 0.0072 (формула для малого шага предсказывает пять раз). Пунктир — приближение для малого шага ησ²tr(H)/4: 0.045 и 0.0090. Убывающий шаг сочетает быстрый старт с продолжением спуска: 7.8·10⁻⁴ после десяти эпох.'
    : 'Least squares on 500 points with two correlated features, noise variance 1. Horizontal: examples processed, in epochs; vertical: the excess loss Q(w) − Q(ŵ) on a log scale; the SGD curves average 30 random orders of the examples. Full gradient descent (blue dots) takes one step of 1/L per epoch: 0.50 after the first epoch and 1.9·10⁻³ after the tenth. SGD with step 0.1 is down to 0.049 after 50 examples and goes no further: its mean over the last epoch is 0.050. Step 0.02 descends more slowly but to a level about seven times lower, 0.0072 (the small-step formula predicts five times). Dashed: the small-step approximation ησ²tr(H)/4, 0.045 and 0.0090. A decreasing step combines the fast start with continued progress: 7.8·10⁻⁴ after ten epochs.'}
>
  {layouts.map((Ly) => {
    const sx = scale([0, epochs], Ly.px), sy = scale([-4, 0.3], [Ly.py[1], Ly.py[0]]);
    const pts = (c: number[]) => c.map((v, i) => [sx((i * every) / n), sy(Math.log10(Math.max(v, 1e-6)))] as [number, number]);
    const clip = `${id}-${Ly.sfx}-clip`;
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{ru ? 'Избыток потерь SGD при постоянном и убывающем шаге' : 'Excess loss of SGD with constant and decreasing steps'}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{ru
          ? 'Логарифмический график избытка потерь от числа эпох. Красная кривая сразу падает и остаётся около 0.05, жёлтая падает медленнее и остаётся около 0.007, зелёная продолжает опускаться до 10⁻³. Синие точки полного градиентного спуска спускаются по прямой на каждой эпохе.'
          : 'A log-scale plot of excess loss against epochs. The red curve drops at once and stays near 0.05, the amber curve drops more slowly and stays near 0.007, the green curve keeps descending to 10⁻³. The blue dots of full gradient descent fall along a straight line, one per epoch.'}</desc>
        <defs><clipPath id={clip}><rect x={Ly.px[0]} y={Ly.py[0]} width={Ly.px[1] - Ly.px[0]} height={Ly.py[1] - Ly.py[0]} /></clipPath></defs>
        {ticks.map((v) => <path class="f-grid" d={`M ${Ly.px[0]} ${sy(v)} H ${Ly.px[1]}`} />)}
        <path class="f-axis" d={`M ${Ly.px[0]} ${Ly.py[1]} H ${Ly.px[1]} M ${Ly.px[0]} ${Ly.py[0]} V ${Ly.py[1]}`} />
        {[0, 2, 4, 6, 8, 10].map((v) => <text class="f-note" x={sx(v)} y={Ly.py[1] + 18} text-anchor="middle">{v}</text>)}
        {ticks.map((v) => <text class="f-note" x={Ly.px[0] - 7} y={sy(v) + 5} text-anchor="end">{v === 0 ? '1' : `10${['', '⁻¹', '⁻²', '⁻³', '⁻⁴'][-v]}`}</text>)}
        <text class="f-small" x={(Ly.px[0] + Ly.px[1]) / 2} y={Ly.py[1] + 40} text-anchor="middle">{ru ? 'просмотрено примеров, эпох' : 'examples processed, epochs'}</text>
        <g clip-path={`url(#${clip})`}>
          {curves.filter((c) => c.fl).map((c) => <path class={c.flCls} d={`M ${Ly.px[0]} ${sy(Math.log10(c.fl))} H ${Ly.px[1]}`} />)}
          {curves.map((c) => <path class={c.cls} d={polyline(pts(c.c))} />)}
          <path class="f-thin f-blue" d={polyline(gd.map((v, e) => [sx(e), sy(Math.log10(v))] as [number, number]))} />
        </g>
        {gd.map((v, e) => <circle cx={sx(e)} cy={sy(Math.log10(v))} r="3.6" class="f-solid-blue" />)}
        {curves.map((c, i) => (
          <g>
            <path class={c.cls} d={`M ${Ly.lx} ${Ly.ly + i * 26 - 4} h 26`} />
            <text class="f-small" x={Ly.lx + 34} y={Ly.ly + i * 26}>{ru ? c.ru : c.en}</text>
          </g>
        ))}
        <circle cx={Ly.lx + 13} cy={Ly.ly + 3 * 26 - 4} r="3.6" class="f-solid-blue" />
        <text class="f-small" x={Ly.lx + 34} y={Ly.ly + 3 * 26}>{ru ? 'полный спуск, шаг 1/L' : 'full gradient, step 1/L'}</text>
        <path class="f-thin f-muted f-dash" d={`M ${Ly.lx} ${Ly.ly + 4 * 26 - 4} h 26`} />
        <text class="f-small" x={Ly.lx + 34} y={Ly.ly + 4 * 26}>{ru ? 'уровень ησ²tr(H)/4' : 'level ησ²tr(H)/4'}</text>
      </svg>
    );
  })}
</Figure>
