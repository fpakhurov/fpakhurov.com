---
import Figure from '../Figure.astro';
import { scale, polyline } from '../regressionGeometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
// Original deterministic illustration: Q(w)=w^2/2, w0=2, independent additive gradient noise of variance 1.
// Exact expectation, not a Monte Carlo run. E[w_next]=(1-eta)E[w], Var(w_next)=(1-eta)^2 Var(w)+eta^2.
const count = 240;
const specs = [
  { en: 'constant 0.12', ru: 'постоянный 0.12', css: 'f-line f-red', rate: (_k: number) => 0.12 },
  { en: 'constant 0.025', ru: 'постоянный 0.025', css: 'f-line f-blue', rate: (_k: number) => 0.025 },
  { en: '0.12 / (1 + k/30)', ru: '0.12 / (1 + k/30)', css: 'f-line f-green f-bold', rate: (k: number) => 0.12 / (1 + k / 30) },
];
const traces = specs.map((s) => {
  let mean = 2, variance = 0;
  const values = [2];
  for (let k = 0; k < count; k += 1) {
    const eta = s.rate(k);
    mean *= 1 - eta;
    variance = (1 - eta) ** 2 * variance + eta ** 2;
    values.push((mean * mean + variance) / 2);
  }
  return { ...s, values };
});
const expected = [0.12 / (2 * (2 - 0.12)), 0.025 / (2 * (2 - 0.025))];
if (Math.abs(traces[0].values[count] - expected[0]) > 1e-12) throw new Error('NoiseBall: stationary limit check failed');
const end = traces.map((t) => t.values[count].toFixed(5)).join(', ');
const id = 'optimizers-noise-ball';
const layouts = [
  { key: 'w', cls: 'fig-wide', W: 760, H: 365, left: 60, right: 736, top: 30, bottom: 250 },
  { key: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 370, left: 48, right: 344, top: 30, bottom: 250 },
];
---
<Figure id={id}
  title={ru ? 'Ожидаемые потери при трёх расписаниях шага' : 'Expected loss under three step schedules'}
  caption={ru
    ? `Точная рекурсия среднего и дисперсии для Q(w) = w²/2 с независимым шумом градиента: после 240 шагов потери равны ${end}. Уменьшение шага снижает шумовой уровень и замедляет устранение начального смещения. Это математическое ожидание, а не случайная траектория.`
    : `Exact mean/variance recurrence for Q(w) = w²/2 with independent gradient noise: after 240 steps, losses are ${end}. Reducing the step lowers the noise floor and slows removal of the initial bias. These are expectations, not random trajectories.`}>
  {layouts.map((a) => {
    const sx = scale([0, count], [a.left, a.right]);
    const sy = scale([-3, 0.4], [a.bottom, a.top]);
    return <svg class={a.cls} viewBox={`0 0 ${a.W} ${a.H}`} role="img" aria-labelledby={`${id}-${a.key}-title ${id}-${a.key}-desc`}>
      <title id={`${id}-${a.key}-title`}>{ru ? 'Точная рекурсия ожидаемых потерь SGD' : 'Exact expected-loss recurrence for SGD'}</title>
      <desc id={`${id}-${a.key}-desc`}>{ru ? 'Две кривые постоянного шага выходят на плато; зелёная кривая убывающего шага продолжает снижаться. По вертикали логарифмический масштаб.' : 'Two constant-step curves plateau; the green decreasing-step curve keeps falling. The vertical axis is logarithmic.'}</desc>
      {[0, -1, -2, -3].map((v) => <g><path class="f-grid" d={`M ${a.left} ${sy(v)} H ${a.right}`} /><text class="f-note" x={a.left - 6} y={sy(v) + 4} text-anchor="end">{['1', '0.1', '0.01', '0.001'][-v]}</text></g>)}
      <path class="f-axis" d={`M ${a.left} ${a.top} V ${a.bottom} H ${a.right}`} />
      {[0, 60, 120, 180, 240].map((v) => <text class="f-note" x={sx(v)} y={a.bottom + 20} text-anchor="middle">{v}</text>)}
      {traces.map((t) => <path class={t.css} d={polyline(t.values.map((v, k) => [sx(k), sy(Math.log10(v))] as [number, number]))} />)}
      {traces.map((t, i) => <g><path class={t.css} d={`M ${a.left} ${a.bottom + 45 + i * 22} h 24`} /><text class="f-small" x={a.left + 32} y={a.bottom + 49 + i * 22}>{ru ? t.ru : t.en}</text></g>)}
    </svg>;
  })}
</Figure>
