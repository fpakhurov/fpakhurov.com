---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The pipeline from raw sources to training batches. Steps 1–5 carry the share of Common Crawl still kept
// after each stage of the RefinedWeb pipeline (Penedo et al., 2023, Figure 2): documents up to language
// identification, tokens afterwards, as printed there. Steps 6–9 carry one concrete example each.
const removal = [2.24, 1.49, 50.66, 24.28, 16.19, 22.59, 37.88, 18.47]; // % removed, relative to the previous stage
const printed = [100, 97.76, 96.31, 47.51, 35.97, 30.15, 23.34, 14.5, 11.67]; // % kept overall, as printed
let kept = 100;
removal.forEach((r, i) => {
  kept *= 1 - r / 100;
  // The products reproduce the printed shares to rounding, except the last stage (11.82 against 11.67).
  const tol = i === removal.length - 1 ? 0.2 : 0.02;
  if (Math.abs(kept - printed[i + 1]) > tol) throw new Error(`Pipeline: stage ${i + 1} kept ${kept.toFixed(2)} vs printed ${printed[i + 1]}`);
});
// Our steps merge some of RefinedWeb's stages: 2 = URL filtering + text extraction, 4 = repetition + document + line filters,
// 5 = fuzzy then exact deduplication.
const share = { 1: 100, 2: printed[2], 3: printed[3], 4: printed[6], 5: printed[8] } as Record<number, number>;
const fuzzy = printed[7];
if (share[3] !== 47.51 || share[4] !== 23.34 || share[5] !== 11.67) throw new Error('Pipeline: shares out of sync with the text');

type Tone = 'green' | 'plain' | 'amber' | 'red';
const fill: Record<Tone, string> = { green: 'f-fill-green', plain: 'f-fill-paper', amber: 'f-fill-amber', red: 'f-fill-red' };
const stroke: Record<Tone, string> = { green: 'f-green', plain: '', amber: 'f-amber', red: 'f-red' };
const textTone: Record<Tone, string> = { green: 'f-t-green', plain: '', amber: 'f-t-amber', red: 'f-t-red' };

const steps: { label: string; sub: string; tone: Tone; note?: string; noteN?: string }[] = ru
  ? [
      { label: 'Сырые источники', sub: 'веб, книги, код, отобранные корпусы', tone: 'green' },
      { label: 'Извлечение текста', sub: 'фильтр URL, HTML → основной текст', tone: 'plain' },
      { label: 'Определение языка', sub: 'fastText, оценка ≥ 0.65', tone: 'plain' },
      { label: 'Фильтрация по качеству', sub: 'повторы, правила документов и строк', tone: 'plain' },
      { label: 'Дедупликация', sub: 'MinHash, затем точные подстроки', tone: 'plain' },
      { label: 'Очистка от тестовых данных', sub: 'убрать n-граммы, общие с бенчмарками', tone: 'plain', note: 'GPT-3: совпадения 13-грамм вырезаются с окном в 200 символов', noteN: 'GPT-3: убрать совпадения 13-грамм' },
      { label: 'Безопасность и личные данные', sub: 'чёрные списки, обезличенные адреса', tone: 'plain', note: 'FineWeb: адреса e-mail и публичные IP обезличены', noteN: 'FineWeb: скрыть e-mail и IP' },
      { label: 'Смешивание источников', sub: 'веса wᵢ, эпохи eᵢ', tone: 'amber', note: 'LLaMA: 67% CommonCrawl, 15% C4, 4.5% GitHub, …', noteN: 'LLaMA: 67% CommonCrawl, …' },
      { label: 'Токенизация и упаковка', sub: 'BPE, последовательности одной длины', tone: 'red', note: 'GPT-3: упаковка в последовательности по 2048 токенов', noteN: 'GPT-3: по 2048 токенов' },
    ]
  : [
      { label: 'Raw sources', sub: 'web crawl, books, code, curated', tone: 'green' },
      { label: 'Extract text', sub: 'URL blocklist, HTML → main text', tone: 'plain' },
      { label: 'Identify language', sub: 'fastText score ≥ 0.65', tone: 'plain' },
      { label: 'Filter for quality', sub: 'repetition, document and line rules', tone: 'plain' },
      { label: 'Deduplicate', sub: 'MinHash, then exact substrings', tone: 'plain' },
      { label: 'Decontaminate', sub: 'drop n-gram matches with benchmarks', tone: 'plain', note: 'GPT-3: 13-gram matches cut out with a 200-character window', noteN: 'GPT-3: cut 13-gram matches' },
      { label: 'Safety and personal data', sub: 'blocklists, anonymized addresses', tone: 'plain', note: 'FineWeb: e-mail and public IP addresses anonymized', noteN: 'FineWeb: mask e-mails and IPs' },
      { label: 'Mix sources', sub: 'weights wᵢ, epochs eᵢ', tone: 'amber', note: 'LLaMA: 67 % CommonCrawl, 15 % C4, 4.5 % GitHub, …', noteN: 'LLaMA: 67 % CommonCrawl, …' },
      { label: 'Tokenize and pack', sub: 'BPE, fixed-length sequences', tone: 'red', note: 'GPT-3: documents packed into 2,048-token sequences', noteN: 'GPT-3: 2,048-token sequences' },
    ];
const num = (v: number) => v.toFixed(1);
const pc = ru ? '%' : ' %'; // Russian typography: no space before the percent sign
const pct = (v: number) => (v === 100 ? `100${pc}` : `${num(v)}${pc}`);
const t = ru
  ? { head: 'доля Common Crawl, которая остаётся (RefinedWeb)', headN: 'остаётся от Common Crawl (RefinedWeb)', dedup: `${num(fuzzy)} → ${num(share[5])}%`,
      stepNames: ['источники', 'извлечение текста', 'определение языка', 'фильтрация по качеству', 'дедупликация', 'очистка от тестовых данных', 'безопасность и личные данные', 'смешивание источников', 'токенизация и упаковка'] }
  : { head: 'share of Common Crawl still kept (RefinedWeb)', headN: 'Common Crawl kept (RefinedWeb)', dedup: `${num(fuzzy)} → ${num(share[5])} %`,
      stepNames: ['sources', 'extract text', 'identify language', 'filter for quality', 'deduplicate', 'decontaminate', 'safety and personal data', 'mix sources', 'tokenize and pack'] };

const id = 'pretraining-data-pipeline';
// Wide: one row per step, the stage on the left, the kept share or an example on the right.
const W = { w: 760, h: 512, y0: 50, row: 50, box: [34, 270] as const, bar: [326, 380] as const };
const rowsW = steps.map((s, i) => {
  const y = W.y0 + i * W.row;
  const v = share[i + 1];
  return { ...s, n: i + 1, y, v, bw: v === undefined ? 0 : (W.bar[1] * v) / 100 };
});
const fuzzyW = (W.bar[1] * fuzzy) / 100;
// Narrow: the label on one line, the bar or the example under it.
const N = { w: 360, h: 590, y0: 46, row: 60, x: 32, barW: 250 };
const rowsN = steps.map((s, i) => {
  const y = N.y0 + i * N.row;
  const v = share[i + 1];
  return { ...s, n: i + 1, y, v, bw: v === undefined ? 0 : (N.barW * v) / 100 };
});
const fuzzyN = (N.barW * fuzzy) / 100;
const gridW = [0, 50, 100].map((p) => ({ p, x: W.bar[0] + (W.bar[1] * p) / 100 }));
const gridBottom = W.y0 + 5 * W.row - 8;
const desc = ru
  ? 'Девять шагов сверху вниз: сырые источники, извлечение текста, определение языка, фильтр качества, дедупликация, очистка от тестовых данных, безопасность и персональные данные, смешивание источников, токенизация и упаковка. Для первых пяти шагов полоса показывает долю Common Crawl, которая остаётся в конвейере RefinedWeb: 100, 96.3, 47.5, 23.3 и 11.7 процента (14.5 после нечёткой дедупликации). Для остальных шагов приведён пример из GPT-3, FineWeb или LLaMA.'
  : 'Nine steps from top to bottom: raw sources, text extraction, language identification, quality filtering, deduplication, decontamination, safety and personal data, mixing sources, tokenizing and packing. For the first five steps a bar shows the share of Common Crawl still kept in the RefinedWeb pipeline: 100, 96.3, 47.5, 23.3 and 11.7 per cent (14.5 after fuzzy deduplication). The other steps show one example each from GPT-3, FineWeb or LLaMA.';
---

<Figure
  id={id}
  title={ru ? 'От веб-обхода к батчам: конвейер данных для предобучения' : 'From crawl to batches: the pretraining data pipeline'}
  caption={ru
    ? 'Девять шагов конвейера, каждый убирает один вид плохих токенов или решает, сколько раз модель увидит хорошие. Полосы на шагах 1–5 — данные конвейера RefinedWeb (Penedo et al., 2023, рисунок 2): доля исходного Common Crawl, которая остаётся после шага, — в документах до определения языка включительно и в токенах после, как в статье. Шаг 2 здесь объединяет фильтр URL и извлечение текста, шаг 4 — три фильтра (повторы, документы, строки), шаг 5 — нечёткую и точную дедупликацию (светлая часть полосы — 14.5% после нечёткой). Произведение долей, оставшихся на каждом этапе, воспроизводит напечатанные значения с точностью до округления, кроме последнего: 11.82% против напечатанных 11.67%. Для шагов 6–9 RefinedWeb долей не приводит; справа — по одному примеру из GPT-3, FineWeb и LLaMA.'
    : 'Nine steps of the pipeline; each removes one kind of bad token or decides how often the model sees the good ones. The bars on steps 1–5 are data from the RefinedWeb pipeline (Penedo et al., 2023, Figure 2): the share of the original Common Crawl still kept after the step, counted in documents up to language identification and in tokens afterwards, as in the paper. Step 2 merges its URL filtering and text extraction, step 4 its three filters (repetition, document-wise, line-wise), step 5 its fuzzy and exact deduplication (the light part of the bar is the 14.5 % left after fuzzy deduplication). The products of the per-stage kept fractions reproduce the printed shares to rounding, except the last: 11.82 % against the printed 11.67 %. RefinedWeb reports no shares for steps 6–9; the right column gives one example each from GPT-3, FineWeb and LLaMA.'}
>
  <svg class="fig-wide fig-bp-640" viewBox={`0 0 ${W.w} ${W.h}`} role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{ru ? 'Конвейер данных для предобучения и доля, которая остаётся' : 'The pretraining data pipeline and the share kept'}</title>
    <desc id={`${id}-w-d`}>{desc}</desc>
    <text class="f-small f-t-blue" x={W.bar[0]} y="18">{t.head}</text>
    {gridW.map((g) => (
      <g>
        <path class="f-grid" d={`M ${g.x} ${W.y0 - 6} V ${gridBottom}`} />
        <text class="f-small f-t-muted" x={g.x} y="36" text-anchor="middle">{g.p === 0 ? '0' : `${g.p}${pc}`}</text>
      </g>
    ))}
    {rowsW.map((r) => (
      <g data-s={`${r.n}`}>
        <rect class={fill[r.tone]} x={W.box[0]} y={r.y} width={W.box[1]} height="40" rx="7" />
        <rect class={`f-thin ${stroke[r.tone]}`} x={W.box[0]} y={r.y} width={W.box[1]} height="40" rx="7" fill="none" />
        <text class={`f-label ${textTone[r.tone]}`} x={W.box[0] + 12} y={r.y + 17}>{r.label}</text>
        <text class="f-small f-t-muted" x={W.box[0] + 12} y={r.y + 33}>{r.sub}</text>
        {r.v !== undefined && (
          <g>
            <rect class="f-box-soft" x={W.bar[0]} y={r.y + 12} width={W.bar[1]} height="16" />
            {r.n === 5 && <rect class="f-fill-blue" x={W.bar[0]} y={r.y + 12} width={fuzzyW} height="16" style="fill-opacity: 0.08" />}
            {r.n === 5 && <rect class="f-thin f-blue f-dash" x={W.bar[0]} y={r.y + 12} width={fuzzyW} height="16" fill="none" />}
            <rect class="f-fill-blue" x={W.bar[0]} y={r.y + 12} width={r.bw} height="16" />
            <rect class="f-thin f-blue" x={W.bar[0]} y={r.y + 12} width={r.bw} height="16" fill="none" />
            <text class="f-small f-t-blue f-halo" x={W.bar[0] + (r.n === 5 ? fuzzyW : r.v === 100 ? W.bar[1] : r.bw) + 6} y={r.y + 25}>{r.n === 5 ? t.dedup : pct(r.v)}</text>
          </g>
        )}
        {r.note && <text class="f-small f-t-muted" x={W.bar[0]} y={r.y + 25}>{r.note}</text>}
        <Badge x={W.box[0] - 14} y={r.y + 20} n={r.n} />
      </g>
    ))}
  </svg>
  <svg class="fig-narrow seq-narrow fig-bp-640" viewBox={`0 0 ${N.w} ${N.h}`} role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{ru ? 'Конвейер данных для предобучения и доля, которая остаётся' : 'The pretraining data pipeline and the share kept'}</title>
    <desc id={`${id}-n-d`}>{desc}</desc>
    <text class="f-small f-t-blue" x={N.x} y="18">{t.headN}</text>
    {rowsN.map((r) => (
      <g data-s={`${r.n}`}>
        <text class={`f-label ${textTone[r.tone]}`} x={N.x} y={r.y + 16}>{r.label}</text>
        {r.v !== undefined && (
          <g>
            <rect class="f-box-soft" x={N.x} y={r.y + 26} width={N.barW} height="16" />
            {r.n === 5 && <rect class="f-thin f-blue f-dash" x={N.x} y={r.y + 26} width={fuzzyN} height="16" fill="none" />}
            <rect class="f-fill-blue" x={N.x} y={r.y + 26} width={r.bw} height="16" />
            <rect class="f-thin f-blue" x={N.x} y={r.y + 26} width={r.bw} height="16" fill="none" />
            <text class="f-small f-t-blue f-halo" x={N.x + (r.n === 5 ? fuzzyN : r.v === 100 ? N.barW : r.bw) + 5} y={r.y + 39}>{r.n === 5 ? t.dedup : pct(r.v)}</text>
          </g>
        )}
        {r.noteN && <text class="f-small f-t-muted" x={N.x} y={r.y + 39}>{r.noteN}</text>}
        <Badge x={14} y={r.y + 11} n={r.n} />
      </g>
    ))}
  </svg>
  <Stepper steps={t.stepNames} />
</Figure>
