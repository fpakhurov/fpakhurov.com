---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The LLaMA pretraining mixture (Touvron et al., 2023, Table 1): sampling proportion w_i of the 1.4T training tokens
// and the epochs e_i that proportion implies. The source size in tokens follows from e_i = w_i D / |S_i|.
const D = 1.4e12;
const data = [
  { name: 'CommonCrawl', w: 67.0, e: 1.10 },
  { name: 'C4', w: 15.0, e: 1.06 },
  { name: 'GitHub', w: 4.5, e: 0.64 },
  { name: 'Wikipedia', w: 4.5, e: 2.45 },
  { name: 'Books', w: 4.5, e: 2.23 },
  { name: 'ArXiv', w: 2.5, e: 1.06 },
  { name: 'StackExchange', w: 2.0, e: 1.03 },
];
const total = data.reduce((a, d) => a + d.w, 0);
if (Math.abs(total - 100) > 1e-9) throw new Error(`Mixture: weights sum to ${total}`);
const rows = data.map((d) => ({ ...d, size: (d.w / 100) * D / d.e / 1e9 }));
// Implied sizes quoted in the text: CommonCrawl ≈ 853B, GitHub ≈ 98B, Wikipedia ≈ 26B, Books ≈ 28B tokens.
const quoted: Record<string, number> = { CommonCrawl: 853, GitHub: 98, Wikipedia: 26, Books: 28 };
for (const r of rows) if (quoted[r.name] !== undefined && Math.round(r.size) !== quoted[r.name]) throw new Error(`Mixture: ${r.name} implies ${r.size}`);

const dec = (v: number, d: number) => v.toFixed(d);
const pc = ru ? '%' : ' %'; // Russian typography: no space before the percent sign
const t = ru
  ? { share: 'доля wᵢ из 1.4 трлн токенов', epochs: 'эпохи eᵢ', size: 'размер источника', one: '1 эпоха', B: 'млрд' }
  : { share: 'share wᵢ of the 1.4T tokens', epochs: 'epochs eᵢ', size: 'source, tokens', one: '1 epoch', B: 'B' };
const id = 'pretraining-data-mixture';

// Wide: name | share bar | epochs bar | implied size.
const W = { y0: 62, row: 28, name: 20, s0: 140, sW: 220, e0: 430, eW: 170, size: 740 };
const sxW = (w: number) => (W.sW * w) / 70;
const exW = (e: number) => (W.eW * e) / 2.5;
// Narrow: name above, share and epochs bars side by side.
const N = { y0: 64, row: 42, s0: 10, sW: 120, e0: 196, eW: 110 };
const sxN = (w: number) => (N.sW * w) / 70;
const exN = (e: number) => (N.eW * e) / 2.5;
const desc = ru
  ? 'Смесь LLaMA по строкам: CommonCrawl 67 процентов и 1.10 эпохи, C4 15 и 1.06, GitHub 4.5 и 0.64, Википедия 4.5 и 2.45, книги 4.5 и 2.23, ArXiv 2.5 и 1.06, StackExchange 2 и 1.03. Пунктир отмечает одну эпоху. Справа размер источника, который следует из доли и числа эпох.'
  : 'The LLaMA mixture by row: CommonCrawl 67 per cent and 1.10 epochs, C4 15 and 1.06, GitHub 4.5 and 0.64, Wikipedia 4.5 and 2.45, Books 4.5 and 2.23, ArXiv 2.5 and 1.06, StackExchange 2 and 1.03. A dashed line marks one epoch. On the right, the source size implied by the share and the epochs.';
---

<Figure
  id={id}
  title={ru ? 'Смесь источников: доля в обучении и число эпох' : 'A data mixture: share of training and number of epochs'}
  caption={ru
    ? 'Смесь для предобучения LLaMA (Touvron et al., 2023, таблица 1): какая доля из 1.4 трлн токенов обучения берётся из каждого источника и сколько эпох по источнику это даёт. Доля не пропорциональна размеру: Википедия и книги дают по 4.5% токенов при размере около 26 и 28 млрд токенов, поэтому модель видит их больше двух раз, а из GitHub берётся 0.64 эпохи. Размер справа не из таблицы, а выведен из формулы eᵢ = wᵢ·D / |Sᵢ| по напечатанным долям и эпохам, поэтому округлён.'
    : 'The LLaMA pretraining mixture (Touvron et al., 2023, Table 1): the share of the 1.4T training tokens drawn from each source and the number of epochs over that source it amounts to. The share is not proportional to size: Wikipedia and Books each supply 4.5 % of the tokens from about 26B and 28B tokens of text, so the model sees them more than twice, while GitHub is used for 0.64 of an epoch. The size column is not in the table; it is implied by eᵢ = wᵢ·D / |Sᵢ| from the printed shares and epochs, and is rounded.'}
>
  <svg class="fig-wide fig-bp-640" viewBox="0 0 760 290" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{ru ? 'Доли и эпохи смеси LLaMA' : 'Shares and epochs of the LLaMA mixture'}</title>
    <desc id={`${id}-w-d`}>{desc}</desc>
    <text class="f-small f-t-amber" x={W.s0} y="24" style="font-weight: 650">{t.share}</text>
    <text class="f-small f-t-blue" x={W.e0} y="24" style="font-weight: 650">{t.epochs}</text>
    <text class="f-small f-t-muted" x={W.size} y="24" text-anchor="end" style="font-weight: 650">{t.size}</text>
    <path class="f-line f-muted f-dash" d={`M ${W.e0 + exW(1)} 52 V ${W.y0 + data.length * W.row - 6}`} />
    <text class="f-small f-t-muted" x={W.e0 + exW(1)} y="46" text-anchor="middle">{t.one}</text>
    {rows.map((r, i) => {
      const y = W.y0 + i * W.row;
      return (
        <g>
          <text class="f-small" x={W.name} y={y + 13}>{r.name}</text>
          <rect class="f-fill-amber" x={W.s0} y={y} width={sxW(r.w)} height="16" />
          <rect class="f-thin f-amber" x={W.s0} y={y} width={sxW(r.w)} height="16" fill="none" />
          <text class="f-small f-t-amber" x={W.s0 + sxW(r.w) + 6} y={y + 13}>{`${dec(r.w, 1)}${pc}`}</text>
          <rect class="f-fill-blue" x={W.e0} y={y} width={exW(r.e)} height="16" />
          <rect class="f-thin f-blue" x={W.e0} y={y} width={exW(r.e)} height="16" fill="none" />
          <text class="f-small f-t-blue f-halo" x={Math.max(W.e0 + exW(r.e), W.e0 + exW(1)) + 6} y={y + 13}>{dec(r.e, 2)}</text>
          <text class="f-small f-t-muted" x={W.size} y={y + 13} text-anchor="end">{`≈ ${Math.round(r.size)} ${t.B}`}</text>
        </g>
      );
    })}
  </svg>
  <svg class="fig-narrow seq-narrow fig-bp-640" viewBox="0 0 360 370" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{ru ? 'Доли и эпохи смеси LLaMA' : 'Shares and epochs of the LLaMA mixture'}</title>
    <desc id={`${id}-n-d`}>{desc}</desc>
    <text class="f-small f-t-amber" x={N.s0} y="20" style="font-weight: 650">{ru ? 'доля wᵢ' : 'share wᵢ'}</text>
    <text class="f-small f-t-blue" x={N.e0} y="20" style="font-weight: 650">{t.epochs}</text>
    <path class="f-line f-muted f-dash" d={`M ${N.e0 + exN(1)} 50 V ${N.y0 + data.length * N.row - 8}`} />
    <text class="f-small f-t-muted" x={N.e0 + exN(1)} y="44" text-anchor="middle">{t.one}</text>
    {rows.map((r, i) => {
      const y = N.y0 + i * N.row;
      return (
        <g>
          <text class="f-small" x={N.s0} y={y + 4}>{r.name}</text>
          <rect class="f-fill-amber" x={N.s0} y={y + 10} width={sxN(r.w)} height="14" />
          <rect class="f-thin f-amber" x={N.s0} y={y + 10} width={sxN(r.w)} height="14" fill="none" />
          <text class="f-small f-t-amber" x={N.s0 + sxN(r.w) + 5} y={y + 22}>{`${dec(r.w, 1)}${pc}`}</text>
          <rect class="f-fill-blue" x={N.e0} y={y + 10} width={exN(r.e)} height="14" />
          <rect class="f-thin f-blue" x={N.e0} y={y + 10} width={exN(r.e)} height="14" fill="none" />
          <text class="f-small f-t-blue f-halo" x={Math.max(N.e0 + exN(r.e), N.e0 + exN(1)) + 5} y={y + 22}>{dec(r.e, 2)}</text>
        </g>
      );
    })}
  </svg>
</Figure>
