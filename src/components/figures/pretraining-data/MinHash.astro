---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { plot, scale } from '../geometry';
import { mulberry32 } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Two templated pages that differ in two place names (the documents of the Code section).
// 1: word 3-gram shingles; 2: Jaccard similarity; 3: ten min-hashes, each the first shingle of A ∪ B under one random
// order; 4: the banding curve P = 1 − (1 − s^r)^b for two settings, read at this pair's similarity.
const A = 'Book a cheap flight from Halifax to Basel this spring and look forward to your trip with our friendly team, free cancellation on every booking.';
const B = A.replace('Halifax', 'Maui').replace('Basel', 'Dubrovnik');
const words = (s: string) => s.toLowerCase().replace(/[^\w\s]/g, ' ').split(/\s+/).filter(Boolean);
const shingles = (s: string) => {
  const w = words(s), out: string[] = [];
  for (let i = 0; i + 3 <= w.length; i++) {
    const g = w.slice(i, i + 3).join(' ');
    if (!out.includes(g)) out.push(g);
  }
  return out;
};
const sa = shingles(A), sb = shingles(B);
const inB = new Set(sb), inA = new Set(sa);
const onlyA = sa.filter((x) => !inB.has(x)), both = sa.filter((x) => inB.has(x)), onlyB = sb.filter((x) => !inA.has(x));
const J = both.length / (onlyA.length + both.length + onlyB.length);
if (onlyA.length !== 5 || both.length !== 18 || onlyB.length !== 5 || J.toFixed(3) !== '0.643') throw new Error(`MinHash: shingle counts changed (J = ${J})`);

// One min-hash = one random order of the 28 shingles of A ∪ B; A and B agree when the first shingle in that order is shared.
const union = [...onlyA, ...both, ...onlyB];
const group = (k: number) => (k < onlyA.length ? 'a' : k < onlyA.length + both.length ? 'both' : 'b');
const rand = mulberry32(2);
const K = 10;
const rows = Array.from({ length: K }, () => {
  const pr = union.map(() => rand());
  let k = 0;
  pr.forEach((v, j) => { if (v < pr[k]) k = j; });
  return { text: union[k], g: group(k) };
});
const agree = rows.filter((r) => r.g === 'both').length;
if (agree !== 6) throw new Error(`MinHash: the seeded draw now agrees in ${agree} of ${K}`);
const sd = Math.sqrt((J * (1 - J)) / K);
if (sd.toFixed(2) !== '0.15') throw new Error(`MinHash: sd ${sd}`);

// Banding: b bands of r rows; a pair becomes a candidate if all r rows of some band agree.
const P = (s: number, b: number, r: number) => 1 - (1 - s ** r) ** b;
const settings = [{ b: 32, r: 4, cls: 'blue' }, { b: 16, r: 8, cls: 'amber' }];
const atJ = settings.map((st) => P(J, st.b, st.r));
if (atJ[0].toFixed(3) !== '0.998' || atJ[1].toFixed(3) !== '0.377') throw new Error(`MinHash: P at J = ${atJ}`);
// s at which a curve reaches a given P (bisection; P is increasing in s)
const sAt = (p: number, b: number, r: number) => {
  let lo = 0, hi = 1;
  for (let i = 0; i < 50; i++) { const m = (lo + hi) / 2; if (P(m, b, r) < p) lo = m; else hi = m; }
  return (lo + hi) / 2;
};

const dec = (v: number, d = 3) => v.toFixed(d);
const sub = (i: number) => String(i).split('').map((c) => '₀₁₂₃₄₅₆₇₈₉'[Number(c)]).join('');
const tone = { a: 'f-t-blue', b: 'f-t-red', both: 'f-t-green' } as Record<string, string>;
const t = ru
  ? { onlyA: `только в A: ${onlyA.length}`, onlyB: `только в B: ${onlyB.length}`, both: `в обоих: ${both.length}`, more: `… ещё ${both.length - 4}`,
      jac: `J(A, B) = |A ∩ B| / |A ∪ B| = ${both.length} / (${onlyA.length} + ${both.length} + ${onlyB.length}) = ${dec(J)}`, jacN: `J = ${both.length} / ${union.length} = ${dec(J)}`,
      rowsHead: 'первый шингл A ∪ B в порядке hᵢ', same: 'A = B', diff: 'A ≠ B', est: `совпали ${agree} из ${K} → оценка ${dec(agree / K, 1)}`,
      bandsHead: 'полосы: кандидат, если совпала хоть одна', bandsHeadN: 'кандидат, если совпала полоса', xAxis: 'сходство Жаккара s', yAxis: 'P(пара — кандидат)', thisPair: `J = ${dec(J)}`,
      steps: ['шинглы двух документов', 'Жаккар: доля общих шинглов', 'по одному минхешу на хеш-функцию', 'полосы решают, какие пары сравнивать'] }
  : { onlyA: `only in A: ${onlyA.length}`, onlyB: `only in B: ${onlyB.length}`, both: `in both: ${both.length}`, more: `… ${both.length - 4} more`,
      jac: `J(A, B) = |A ∩ B| / |A ∪ B| = ${both.length} / (${onlyA.length} + ${both.length} + ${onlyB.length}) = ${dec(J)}`, jacN: `J = ${both.length} / ${union.length} = ${dec(J)}`,
      rowsHead: 'first shingle of A ∪ B under hᵢ', same: 'A = B', diff: 'A ≠ B', est: `agree in ${agree} of ${K} → estimate ${dec(agree / K, 1)}`,
      bandsHead: 'bands: a candidate if any one band agrees', bandsHeadN: 'a candidate if one band agrees', xAxis: 'Jaccard similarity s', yAxis: 'P(candidate pair)', thisPair: `J = ${dec(J)}`,
      steps: ['shingle the two documents', 'Jaccard: shared over all', 'one min-hash per hash function', 'bands decide which pairs get compared'] };
const docA = { pre: 'A: book a cheap flight from ', x1: 'halifax', mid: ' to ', x2: 'basel', post: ' this spring and look forward … on every booking' };
const docB = { pre: 'B: book a cheap flight from ', x1: 'maui', mid: ' to ', x2: 'dubrovnik', post: ' this spring and look forward … on every booking' };
const docAN = { pre: 'A: … from ', x1: 'halifax', mid: ' to ', x2: 'basel', post: ' this …' };
const docBN = { pre: 'B: … from ', x1: 'maui', mid: ' to ', x2: 'dubrovnik', post: ' this …' };
const shownBoth = [...both.slice(0, 4), t.more];

// Plot geometry for both layouts.
function plotGeom(x0: number, x1: number, yTop: number, yBot: number) {
  const sx = scale([0, 1], [x0, x1]), sy = scale([0, 1], [yBot, yTop]);
  const curves = settings.map((st, i) => {
    const sb75 = sAt(0.75, st.b, st.r), sa60 = sAt(0.6, st.b, st.r);
    return {
      ...st,
      d: plot((s) => P(s, st.b, st.r), 0, 1, sx, sy, 200),
      label: `b = ${st.b}, r = ${st.r}`,
      // blue label left of its curve at P = 0.75; amber label right of its curve at P = 0.6
      lx: i === 0 ? sx(sb75) - 8 : sx(sa60) + 8, ly: i === 0 ? sy(0.75) : sy(0.6), anchor: i === 0 ? 'end' : 'start',
      // the blue value sits above the plot, clear of the flat top of its curve
      dotY: sy(atJ[i]), val: dec(atJ[i]), valY: i === 0 ? yTop - 11 : sy(atJ[i]) + 4,
    };
  });
  return { sx, sy, x0, x1, yTop, yBot, xJ: sx(J), curves };
}
const gw = plotGeom(450, 730, 252, 436);
const gn = plotGeom(56, 300, 662, 846);
const id = 'pretraining-data-minhash';
const desc = ru
  ? `Две страницы по одному шаблону отличаются двумя названиями городов. У каждой 23 шингла (тройки слов): 18 общих, по 5 своих, сходство Жаккара 18/28 = 0.643. Десять случайных порядков шинглов: в каждом A и B совпадают, если первым в порядке оказался общий шингл; совпали ${agree} из 10. Справа график вероятности стать кандидатом 1 − (1 − s^r)^b для b = 32, r = 4 (${dec(atJ[0])} при s = ${dec(J)}) и b = 16, r = 8 (${dec(atJ[1])}).`
  : `Two pages built from one template differ in two place names. Each has 23 shingles (word 3-grams): 18 shared and 5 of its own, Jaccard similarity 18/28 = 0.643. Ten random orders of the shingles: in each, A and B agree when the first shingle in the order is a shared one; they agree in ${agree} of 10. On the right, the probability of becoming a candidate pair, 1 − (1 − s^r)^b, for b = 32, r = 4 (${dec(atJ[0])} at s = ${dec(J)}) and b = 16, r = 8 (${dec(atJ[1])}).`;
---

<Figure
  id={id}
  title={ru ? 'MinHash: сходство Жаккара по нескольким числам на документ' : 'MinHash: Jaccard similarity from a few numbers per document'}
  caption={ru
    ? `Две страницы, собранные по одному шаблону, как в коде заметки. (1) Каждая разбита на тройки слов (шинглы); замена двух названий меняет 5 из 23 шинглов. (2) Сходство Жаккара — доля общих шинглов среди всех: 18 / 28 = ${dec(J)}. (3) Минхеш (min-hash) — первый шингл документа в случайном порядке. Первый шингл всего объединения A ∪ B — случайный элемент объединения; если он общий, минхеши A и B совпадают, иначе нет, поэтому вероятность совпадения равна J. Здесь k = ${K} порядков (seed = 2): совпали ${agree}, оценка ${dec(agree / K, 1)}; стандартное отклонение такой оценки √(J(1 − J)/k) = ${dec(sd, 2)}, поэтому на практике k измеряется сотнями. (4) Сигнатура из k = b·r минхешей разрезается на b полос по r строк; пара становится кандидатом на сравнение, если хотя бы одна полоса совпала целиком. При s = ${dec(J)} настройка b = 32, r = 4 ловит пару с вероятностью ${dec(atJ[0])}, а b = 16, r = 8 — с вероятностью ${dec(atJ[1])}: второй порог выше.`
    : `Two pages built from one template, as in the note’s code. (1) Each is cut into word 3-grams (shingles); swapping two names changes 5 of the 23. (2) Jaccard similarity is the share of shingles the two have in common: 18 / 28 = ${dec(J)}. (3) A min-hash is a document’s first shingle in a random order. The first shingle of the whole union A ∪ B is a random element of it; if it is shared, A’s and B’s min-hashes agree, otherwise they do not, so they agree with probability J. Here k = ${K} orders (seed 2): ${agree} agree, an estimate of ${dec(agree / K, 1)}; the standard deviation of such an estimate is √(J(1 − J)/k) = ${dec(sd, 2)}, which is why k is in the hundreds in practice. (4) A signature of k = b·r min-hashes is cut into b bands of r rows; a pair becomes a candidate for comparison if all rows of at least one band agree. At s = ${dec(J)}, b = 32, r = 4 catches the pair with probability ${dec(atJ[0])} and b = 16, r = 8 with probability ${dec(atJ[1])}: the second threshold is higher.`}
>
  <svg class="fig-wide fig-bp-640" viewBox="0 0 760 490" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{ru ? 'Шинглы, сходство Жаккара, минхеши и полосы' : 'Shingles, Jaccard similarity, min-hashes and bands'}</title>
    <desc id={`${id}-w-d`}>{desc}</desc>
    <g data-s="1">
      <text class="f-small" x="34" y="26">{docA.pre}<tspan style="fill: var(--fig-blue); font-weight: 650">{docA.x1}</tspan>{docA.mid}<tspan style="fill: var(--fig-blue); font-weight: 650">{docA.x2}</tspan>{docA.post}</text>
      <text class="f-small" x="34" y="46">{docB.pre}<tspan style="fill: var(--fig-red); font-weight: 650">{docB.x1}</tspan>{docB.mid}<tspan style="fill: var(--fig-red); font-weight: 650">{docB.x2}</tspan>{docB.post}</text>
      <rect class="f-fill-blue" x="26" y="62" width="226" height="108" rx="7" style="fill-opacity: 0.07" />
      <rect class="f-fill-green" x="268" y="62" width="226" height="108" rx="7" style="fill-opacity: 0.07" />
      <rect class="f-fill-red" x="510" y="62" width="226" height="108" rx="7" style="fill-opacity: 0.07" />
      <text class="f-small f-t-blue" x="38" y="80" style="font-weight: 650">{t.onlyA}</text>
      <text class="f-small f-t-green" x="280" y="80" style="font-weight: 650">{t.both}</text>
      <text class="f-small f-t-red" x="522" y="80" style="font-weight: 650">{t.onlyB}</text>
      {onlyA.map((s, i) => <text class="f-small" x="38" y={98 + i * 16}>{s}</text>)}
      {shownBoth.map((s, i) => <text class={`f-small ${i === 4 ? 'f-t-muted' : ''}`} x="280" y={98 + i * 16}>{s}</text>)}
      {onlyB.map((s, i) => <text class="f-small" x="522" y={98 + i * 16}>{s}</text>)}
      <Badge x={14} y={22} n={1} />
    </g>
    <g data-s="2">
      <text class="f-label" x="381" y="196" text-anchor="middle">{t.jac}</text>
      <Badge x={110} y={191} n={2} />
    </g>
    <g data-s="3">
      <text class="f-small" x="34" y="226" style="font-weight: 650">{t.rowsHead}</text>
      {rows.map((r, i) => (
        <g>
          <text class="f-small f-t-muted" x="34" y={250 + i * 19}>{`h${sub(i + 1)}`}</text>
          <text class={`f-small ${tone[r.g]}`} x="66" y={250 + i * 19}>{r.text}</text>
          <text class={`f-small ${r.g === 'both' ? 'f-t-green' : 'f-t-muted'}`} x="360" y={250 + i * 19} text-anchor="end">{r.g === 'both' ? t.same : t.diff}</text>
        </g>
      ))}
      <text class="f-small" x="34" y="452" style="font-weight: 650">{t.est}</text>
      <Badge x={14} y={222} n={3} />
    </g>
    <g data-s="4">
      <text class="f-small" x="414" y="226" style="font-weight: 650">{t.bandsHead}</text>
      <text class="f-small f-t-muted" x={gw.x0} y={gw.yTop - 10}>{t.yAxis}</text>
      <path class="f-axis" d={`M ${gw.x0} ${gw.yTop} V ${gw.yBot} H ${gw.x1}`} />
      {[0, 0.5, 1].map((v) => (
        <g>
          <text class="f-small f-t-muted" x={gw.sx(v)} y={gw.yBot + 16} text-anchor="middle">{dec(v, v === 0.5 ? 1 : 0)}</text>
          <text class="f-small f-t-muted" x={gw.x0 - 6} y={gw.sy(v) + 4} text-anchor="end">{dec(v, v === 0.5 ? 1 : 0)}</text>
        </g>
      ))}
      <text class="f-small f-t-muted" x={(gw.x0 + gw.x1) / 2} y={gw.yBot + 34} text-anchor="middle">{t.xAxis}</text>
      <path class="f-line f-muted f-dash" d={`M ${gw.xJ} ${gw.yBot} V ${gw.yTop}`} />
      {gw.curves.map((c) => (
        <g>
          <path class={`f-line f-${c.cls}`} d={c.d} />
          <text class={`f-small f-t-${c.cls} f-halo`} x={c.lx} y={c.ly} text-anchor={c.anchor}>{c.label}</text>
          <circle cx={gw.xJ} cy={c.dotY} r="4" class={`f-solid-${c.cls === 'blue' ? 'blue' : 'muted'}`} style={c.cls === 'amber' ? 'fill: var(--fig-amber)' : undefined} />
          <text class={`f-small f-t-${c.cls} f-halo`} x={gw.xJ + 8} y={c.valY}>{c.val}</text>
        </g>
      ))}
      <text class="f-small f-t-muted f-halo" x={gw.xJ + 6} y={gw.yBot - 8}>{t.thisPair}</text>
      <Badge x={400} y={222} n={4} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow fig-bp-640" viewBox="0 0 360 900" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{ru ? 'Шинглы, сходство Жаккара, минхеши и полосы' : 'Shingles, Jaccard similarity, min-hashes and bands'}</title>
    <desc id={`${id}-n-d`}>{desc}</desc>
    <g data-s="1">
      <text class="f-small" x="32" y="22">{docAN.pre}<tspan style="fill: var(--fig-blue); font-weight: 650">{docAN.x1}</tspan>{docAN.mid}<tspan style="fill: var(--fig-blue); font-weight: 650">{docAN.x2}</tspan>{docAN.post}</text>
      <text class="f-small" x="32" y="44">{docBN.pre}<tspan style="fill: var(--fig-red); font-weight: 650">{docBN.x1}</tspan>{docBN.mid}<tspan style="fill: var(--fig-red); font-weight: 650">{docBN.x2}</tspan>{docBN.post}</text>
      <text class="f-small f-t-blue" x="10" y="80" style="font-weight: 650">{t.onlyA}</text>
      <text class="f-small f-t-red" x="186" y="80" style="font-weight: 650">{t.onlyB}</text>
      {onlyA.map((s, i) => <text class="f-small" x="10" y={102 + i * 19}>{s}</text>)}
      {onlyB.map((s, i) => <text class="f-small" x="186" y={102 + i * 19}>{s}</text>)}
      <text class="f-small f-t-green" x="10" y="212" style="font-weight: 650">{t.both}</text>
      {shownBoth.map((s, i) => <text class={`f-small ${i === 4 ? 'f-t-muted' : ''}`} x={i % 2 ? 186 : 10} y={234 + Math.floor(i / 2) * 19}>{s}</text>)}
      <Badge x={14} y={18} n={1} />
    </g>
    <g data-s="2">
      <text class="f-label" x="40" y="314">{t.jacN}</text>
      <Badge x={22} y={309} n={2} />
    </g>
    <g data-s="3">
      <text class="f-small" x="32" y="356" style="font-weight: 650">{t.rowsHead}</text>
      {rows.map((r, i) => (
        <g>
          <text class="f-small f-t-muted" x="10" y={382 + i * 20}>{`h${sub(i + 1)}`}</text>
          <text class={`f-small ${tone[r.g]}`} x="44" y={382 + i * 20}>{r.text}</text>
          <text class={`f-small ${r.g === 'both' ? 'f-t-green' : 'f-t-muted'}`} x="350" y={382 + i * 20} text-anchor="end">{r.g === 'both' ? t.same : t.diff}</text>
        </g>
      ))}
      <text class="f-small" x="10" y="590" style="font-weight: 650">{t.est}</text>
      <Badge x={14} y={351} n={3} />
    </g>
    <g data-s="4">
      <text class="f-small" x="32" y="626" style="font-weight: 650">{t.bandsHeadN}</text>
      <text class="f-small f-t-muted" x={gn.x0} y={gn.yTop - 12}>{t.yAxis}</text>
      <path class="f-axis" d={`M ${gn.x0} ${gn.yTop} V ${gn.yBot} H ${gn.x1}`} />
      {[0, 0.5, 1].map((v) => (
        <g>
          <text class="f-small f-t-muted" x={gn.sx(v)} y={gn.yBot + 18} text-anchor="middle">{dec(v, v === 0.5 ? 1 : 0)}</text>
          <text class="f-small f-t-muted" x={gn.x0 - 6} y={gn.sy(v) + 5} text-anchor="end">{dec(v, v === 0.5 ? 1 : 0)}</text>
        </g>
      ))}
      <text class="f-small f-t-muted" x={(gn.x0 + gn.x1) / 2} y={gn.yBot + 40} text-anchor="middle">{t.xAxis}</text>
      <path class="f-line f-muted f-dash" d={`M ${gn.xJ} ${gn.yBot} V ${gn.yTop}`} />
      {gn.curves.map((c) => (
        <g>
          <path class={`f-line f-${c.cls}`} d={c.d} />
          <text class={`f-small f-t-${c.cls} f-halo`} x={c.lx} y={c.ly} text-anchor={c.anchor}>{c.label}</text>
          <circle cx={gn.xJ} cy={c.dotY} r="4" class={`f-solid-${c.cls === 'blue' ? 'blue' : 'muted'}`} style={c.cls === 'amber' ? 'fill: var(--fig-amber)' : undefined} />
          <text class={`f-small f-t-${c.cls} f-halo`} x={gn.xJ + 8} y={c.valY + 1}>{c.val}</text>
        </g>
      ))}
      <text class="f-small f-t-muted f-halo" x={gn.xJ + 6} y={gn.yBot - 8}>{t.thisPair}</text>
      <Badge x={14} y={621} n={4} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
