---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
const copy = ru
  ? {
      title: 'Задание получает доступ через роль',
      caption: 'Членство даёт report_job права report_reader. Роль открывает отчётное представление, из которого исключён email.',
      desc: 'report_job наследует права report_reader. report_reader читает shop_report.order_amounts.',
      links: ['наследует права', 'может читать'],
    }
  : {
      title: 'The job gets access through a role',
      caption: 'Membership gives report_job the permissions of report_reader. The role can read the reporting view, which omits email.',
      desc: 'report_job inherits report_reader privileges. report_reader can read shop_report.order_amounts.',
      links: ['inherits privileges', 'can read'],
    };
const names = ['report_job', 'report_reader', 'shop_report.order_amounts'];
---
<Figure id="db-report-access" title={copy.title} caption={copy.caption}>
  <svg viewBox="0 0 350 239" role="img" aria-labelledby="db-report-access-title db-report-access-desc" style="max-width: 520px; margin-inline: auto">
    <title id="db-report-access-title">{copy.title}</title>
    <desc id="db-report-access-desc">{copy.desc}</desc>
    {names.map((name, i) => (
      <g transform={`translate(0 ${i * 82})`}>
        <rect class={i === 2 ? 'f-fill-green' : 'f-fill-blue'} x="35" y="14" width="280" height="40" rx="8" />
        <text class="f-label" x="175" y="39" text-anchor="middle">{name}</text>
        {i < 2 && <path class="f-line" d="M 175 59 V 91 M 170 86 L 175 91 L 180 86" />}
        {i < 2 && <text class="f-label f-t-muted" x="187" y="79">{copy.links[i]}</text>}
      </g>
    ))}
  </svg>
</Figure>
