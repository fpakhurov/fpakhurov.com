---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The incident of the note, in minutes after 14:00 on day 9. Errors at 12 % from 14:02 to 14:31.
const at = { start: 2, page: 9, ack: 12, declare: 15, opsJoin: 18, update: 21, rollback: 24, mitigated: 31, resolved: 70 };
const detect = at.page - at.start, ackT = at.ack - at.page, mitigate = at.mitigated - at.start;
if (detect !== 7 || ackT !== 3 || mitigate !== 29 || at.resolved - at.mitigated !== 39) throw new Error('timeline durations');
// 12 % errors for 29 minutes at SLO 99.9 % over 30 days: 0.12 * 29 / (0.001 * 43200) = 8.06 % of the budget;
// at 200 checkouts per second, 0.12 * 200 * 29 * 60 = 41,760 failed checkouts.
const share = (0.12 * mitigate) / (0.001 * 43200);
if (Math.abs(share - 0.0806) > 5e-4) throw new Error('budget share');
if (Math.round(0.12 * 200 * mitigate * 60) !== 41760) throw new Error('failed checkouts');
// The 1-hour rule at 14.4x fires when the 1-hour mean error rate exceeds 1.44 %: after 0.0144 / 0.12 h = 7.2 min.
if (Math.abs((0.0144 / 0.12) * 60 - 7.2) > 1e-9) throw new Error('detection time');
const hm = (m: number) => `${14 + Math.floor(m / 60)}:${String(m % 60).padStart(2, '0')}`;

const steps = [at.start, at.page, at.ack, at.declare, at.rollback, at.mitigated, at.resolved];
const t = ru
  ? {
      head: 'checkout, SLO 99.9%: 9-й день графика бюджета', lanes: ['ошибки', 'дежурный / IC', 'операции', 'коммуникации'],
      errors: 'ошибка у 12% оформлений', ic: 'руководитель инцидента', ops: 'откат', comms: 'обновления статуса каждые 20 мин',
      detect: `обнаружение ${detect} мин`, mitig: `устранение ${mitigate} мин`, day12: '12-й день',
      stepper: ['14:02 изменение конфигурации на всех подах; 12% ошибок', '14:09 правило скорости расходования вызывает дежурного', '14:12 дежурный подтверждает вызов и находит изменение', '14:15 объявлен SEV-2, дежурный становится IC', '14:24 оперативный руководитель начинает откат', '14:31 откат завершён: последствия устранены', '15:10 инцидент закрыт после 39 минут нормальных метрик', '12-й день: постмортем рассмотрен, задачи назначены'],
      rows: [['изменение конфигурации на всех', 'подах; ошибка у 12% оформлений'], ['правило скорости расходования', 'вызывает дежурного'], ['подтверждено; ошибки начались', 'с изменением конфигурации'], ['объявлен SEV-2; IC — дежурный,', 'с ним ответственный за коммуникации'], ['оперативный руководитель', 'начинает откат'], ['откат завершён: последствия', `устранены (${mitigate} мин от начала)`], ['закрыто после 39 минут', 'нормальных метрик'], ['постмортем рассмотрен,', 'задачи назначены']],
      sumN: [`обнаружение ${detect} мин · подтверждение ${ackT} мин`, `устранение ${mitigate} мин · ${(share * 100).toFixed(1)}% бюджета`],
    }
  : {
      head: 'checkout, SLO 99.9 %: day 9 of the budget chart', lanes: ['errors', 'on-call / IC', 'operations', 'communications'],
      errors: '12 % of checkouts fail', ic: 'incident commander', ops: 'rollback', comms: 'status updates every 20 min',
      detect: `detect ${detect} min`, mitig: `mitigate ${mitigate} min`, day12: 'day 12',
      stepper: ['14:02 a config change reaches all pods; 12 % errors', '14:09 the burn-rate alert pages the on-call', '14:12 the on-call acknowledges and finds the change', '14:15 SEV-2 declared; the on-call becomes IC', '14:24 the operations lead starts the rollback', '14:31 rollback done: mitigated', '15:10 resolved after 39 minutes of normal metrics', 'day 12: postmortem reviewed, action items assigned'],
      rows: [['config change on all pods;', '12 % of checkouts fail'], ['the burn-rate alert pages', 'the on-call'], ['acknowledged; errors began', 'with the config change'], ['SEV-2 declared; on-call is IC;', 'communications lead joins'], ['the operations lead starts', 'the rollback'], ['rollback done: mitigated', `(${mitigate} min from the start)`], ['resolved after 39 minutes', 'of normal metrics'], ['postmortem reviewed, action', 'items assigned']],
      sumN: [`detect ${detect} min · acknowledge ${ackT} min`, `mitigate ${mitigate} min · ${(share * 100).toFixed(1)} % of the budget`],
    };

// Wide layout: minutes 0..75 after 14:00 on x from 112 to 672; badge 8 sits past a break at x = 724.
const W = 760, X0 = 112, X1 = 672, B8 = 724;
const x = (m: number) => X0 + ((X1 - X0) * m) / 75;
const lane = (i: number) => 32 + i * 30, laneH = 20, axisY = 168;
const HW = 256;
// Wide checks: lane labels fit their column; texts fit their bars; badges do not overlap.
for (const s of t.lanes) if (14 + s.length * 6.5 > X0 - 6) throw new Error(`lane label ${s}`);
const bars = [
  { s: t.errors, m0: at.start, m1: at.mitigated },
  { s: t.ic, m0: at.declare, m1: at.resolved },
  { s: t.ops, m0: at.opsJoin, m1: 40 },
  { s: t.comms, m0: at.opsJoin, m1: at.resolved },
];
for (const b of bars) if (b.s.length * 6.5 + 12 > x(b.m1) - x(b.m0)) throw new Error(`bar text ${b.s}`);
// The rollback label starts after the rollback mark and must end inside the operations bar.
if (x(at.rollback) + 6 + t.ops.length * 6.5 > x(40) - 4) throw new Error('rollback label');
const badgeX = [...steps.map(x), B8];
for (let i = 1; i < badgeX.length; i++) if (badgeX[i] - badgeX[i - 1] < 21) throw new Error(`badges ${i} and ${i + 1} overlap`);
if (x(at.page) + 8 + t.detect.length * 6.5 > W - 4 || x(at.mitigated) + 8 + t.mitig.length * 6.5 > W - 4) throw new Error('bracket labels');
if (14 + t.head.length * 6.5 > W - 4) throw new Error('head');

// Narrow layout: one row per step (badge, time, two lines of text), with seq-narrow text (about 7.3 px per character).
const WN = 360, rowH = 46, top = 34, CN = 7.3;
const HN = top + 8 * rowH + 50;
t.rows.forEach((r, i) => r.forEach((s) => { if (82 + s.length * CN > WN - 6) throw new Error(`narrow row ${i + 1}: "${s}"`); }));
for (const s of t.sumN) if (14 + s.length * CN > WN - 6) throw new Error(`narrow summary "${s}"`);
const times = [...steps.map(hm), ru ? 'д. 12' : 'day 12'];
for (const s of times) if (34 + s.length * CN > 80) throw new Error(`narrow time ${s}`);
const id = 'incident-timeline';
---

<Figure
  id={id}
  title={ru ? 'Хронология одного инцидента' : 'The timeline of one incident'}
  caption={ru
    ? 'Инцидент из заметки, 9-й день графика бюджета ошибок. С 14:02 до 14:31 ошибкой завершаются 12% запросов на оформление заказа. Дежурный получает вызов через 7 минут, подтверждает его через 3, объявляет SEV-2 и становится руководителем инцидента; оперативный руководитель делает откат, а ответственный за коммуникации публикует обновления статуса. Последствия устранены через 29 минут после начала, ценой 8.1% 30-дневного бюджета; инцидент закрыт в 15:10, постмортем рассмотрен на 12-й день. Времена — из журнала инцидента в примере.'
    : 'The incident of the note, on day 9 of the error-budget chart. From 14:02 to 14:31, 12 % of checkout requests fail. The on-call is paged 7 minutes in, acknowledges 3 minutes later, declares a SEV-2 and becomes incident commander; an operations lead performs the rollback while a communications lead posts status updates. The incident is mitigated 29 minutes after it started, at a cost of 8.1 % of the 30-day budget; it is resolved at 15:10, and the postmortem is reviewed on day 12. The times are those of the incident log in the example.'}
>
  <svg class="fig-wide" viewBox={`0 0 ${W} ${HW}`} role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{ru ? 'Дорожки ролей и события инцидента на оси времени' : 'Role lanes and incident events on a time axis'}</title>
    <desc id={`${id}-w-d`}>{ru
      ? 'Ось времени от 14:00 до 15:15. Над ней четыре дорожки: ошибки с 14:02 до 14:31; дежурный с 14:09 и руководитель инцидента с 14:15 до 15:10; операции с 14:18 до 14:40 с откатом в 14:24; коммуникации с 14:18 до 15:10. На оси восемь пронумерованных событий, последнее — постмортем на 12-й день. Под осью скобки: обнаружение 7 минут и устранение последствий 29 минут.'
      : 'A time axis from 14:00 to 15:15. Above it four lanes: errors from 14:02 to 14:31; the on-call from 14:09 and the incident commander from 14:15 to 15:10; operations from 14:18 to 14:40 with the rollback at 14:24; communications from 14:18 to 15:10. On the axis, eight numbered events, the last being the postmortem on day 12. Below the axis, brackets: detection 7 minutes and mitigation 29 minutes.'}</desc>
    <text class="f-small f-t-muted" x="14" y="18">{t.head}</text>
    {t.lanes.map((s, i) => <text class="f-small f-t-muted" x="14" y={lane(i) + 14}>{s}</text>)}
    {steps.map((m, i) => <path class="f-grid f-dash" d={`M ${x(m)} ${lane(3) + laneH + 3} V ${axisY}`} data-s={String(i + 1)} />)}
    <path class="f-thin f-muted" d={`M ${X0} ${lane(0) + laneH / 2} H ${X1}`} />
    <g data-s="1 2 3 4 5 6">
      <rect x={x(at.start)} y={lane(0)} width={x(at.mitigated) - x(at.start)} height={laneH} rx="3" class="f-fill-red" style="stroke: var(--fig-red); stroke-width: 1.1" />
      <text class="f-small f-t-red" x={x(at.start) + 6} y={lane(0) + 14}>{t.errors}</text>
    </g>
    <rect data-s="2 3" x={x(at.page)} y={lane(1)} width={x(at.declare) - x(at.page)} height={laneH} rx="3" class="f-fill-blue" style="stroke: var(--fig-blue); stroke-width: 1.1" />
    <g data-s="4 5 6 7">
      <rect x={x(at.declare)} y={lane(1)} width={x(at.resolved) - x(at.declare)} height={laneH} rx="3" class="f-fill-amber" style="stroke: var(--fig-amber); stroke-width: 1.1" />
      <text class="f-small" x={x(at.declare) + 6} y={lane(1) + 14}>{t.ic}</text>
    </g>
    <g data-s="5 6">
      <rect x={x(at.opsJoin)} y={lane(2)} width={x(40) - x(at.opsJoin)} height={laneH} rx="3" class="f-fill-green" style="stroke: var(--fig-green); stroke-width: 1.1" />
      <text class="f-small" x={x(at.rollback) + 6} y={lane(2) + 14}>{t.ops}</text>
      <path class="f-line f-green" d={`M ${x(at.rollback)} ${lane(2) - 2} V ${lane(2) + laneH + 2}`} />
    </g>
    <g data-s="4 5 6 7">
      <rect x={x(at.opsJoin)} y={lane(3)} width={x(at.resolved) - x(at.opsJoin)} height={laneH} rx="3" class="f-fill-blue" style="stroke: var(--fig-blue); stroke-width: 1.1" />
      <text class="f-small" x={x(at.opsJoin) + 6} y={lane(3) + 14}>{t.comms}</text>
      {[at.update, at.update + 20, at.update + 40].map((m) => <path class="f-line f-blue" d={`M ${x(m)} ${lane(3) + laneH - 2} V ${lane(3) + laneH + 4}`} />)}
    </g>
    <path class="f-axis" d={`M ${X0} ${axisY} H ${X1}`} />
    <path class="f-axis f-dash" d={`M ${X1} ${axisY} H ${B8 - 14}`} />
    {[0, 15, 30, 45, 60, 75].map((m) => (
      <g>
        <path class="f-axis" d={`M ${x(m)} ${axisY} v 5`} />
        <text class="f-note" x={x(m)} y={axisY + 30} text-anchor="middle">{hm(m)}</text>
      </g>
    ))}
    <text class="f-note" x={B8} y={axisY + 30} text-anchor="middle">{t.day12}</text>
    {badgeX.map((bx, i) => <g data-s={String(i + 1)}><Badge x={bx} y={axisY} n={i + 1} /></g>)}
    <g data-s="2">
      <path class="f-thin f-red" d={`M ${x(at.start)} ${axisY + 40} v 6 H ${x(at.page)} v -6`} />
      <text class="f-small f-t-red" x={x(at.page) + 8} y={axisY + 50}>{t.detect}</text>
    </g>
    <g data-s="6">
      <path class="f-thin f-green" d={`M ${x(at.start)} ${axisY + 62} v 6 H ${x(at.mitigated)} v -6`} />
      <text class="f-small f-t-green" x={x(at.mitigated) + 8} y={axisY + 72}>{t.mitig}</text>
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox={`0 0 ${WN} ${HN}`} role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{ru ? 'Восемь событий инцидента по порядку' : 'The eight events of the incident in order'}</title>
    <desc id={`${id}-n-d`}>{ru
      ? 'Вертикальный список из восьми пронумерованных событий со временем: от изменения конфигурации в 14:02 до постмортема на 12-й день. Внизу итоги: обнаружение 7 минут, подтверждение 3 минуты, устранение последствий 29 минут, 8.1% бюджета.'
      : 'A vertical list of eight numbered events with their times, from the configuration change at 14:02 to the postmortem on day 12. At the bottom, the totals: detection 7 minutes, acknowledgement 3 minutes, mitigation 29 minutes, 8.1 % of the budget.'}</desc>
    <path class="f-thin f-muted" d={`M 17 ${top + 12} V ${top + 7 * rowH + 12}`} />
    {t.rows.map((r, i) => (
      <g data-s={String(i + 1)}>
        <Badge x={17} y={top + i * rowH + 12} n={i + 1} />
        <text class="f-small" x="34" y={top + i * rowH + 17} style="font-weight: 650">{times[i]}</text>
        <text class="f-small" x="82" y={top + i * rowH + 17}>{r[0]}</text>
        <text class="f-small f-t-muted" x="82" y={top + i * rowH + 36}>{r[1]}</text>
      </g>
    ))}
    {t.sumN.map((s, k) => <text class="f-small f-t-red" x="14" y={top + 8 * rowH + 14 + k * 20}>{s}</text>)}
  </svg>
  <Stepper steps={t.stepper} />
</Figure>
