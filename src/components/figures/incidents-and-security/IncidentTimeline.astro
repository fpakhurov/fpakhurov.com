---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import data from './incident-data.json';

const ru = pageLang(Astro.url) === 'ru';
const clock = (minute: number) => `09:${String(30 + minute).padStart(2, '0')}`;
---

<Figure
  id="incident-timeline"
  title={ru ? 'Восстановление сохранения ответов' : 'Restoring answer saves'}
  caption={ru
    ? 'Вымышленный журнал. Строки показывают порядок событий, а не равные промежутки времени. От начала до восстановления — 11 минут; затем 7 минут проверки. Ошибки считаются по запросам отдельно от этой хронологии.'
    : 'Fictional log. Rows show event order, not equal time intervals. Recovery takes 11 minutes, followed by 7 minutes of verification. Request failures are counted separately from this timeline.'}
>
  <ol class="incident-events">
    {data.events.map((event) => (
      <li>
        <time>{clock(event.minute)}</time>
        <span>{ru ? event.ru : event.en}</span>
      </li>
    ))}
  </ol>
</Figure>

<style>
  .incident-events { list-style: none; margin: 0; padding: 0; }
  .incident-events li { display: grid; grid-template-columns: 3.75rem minmax(0, 1fr); gap: .75rem; padding: .7rem 0; border-bottom: 1px solid var(--fig-grid, currentColor); }
  .incident-events li:last-child { border-bottom: 0; }
  .incident-events time { font-variant-numeric: tabular-nums; font-weight: 650; }
  .incident-events span { overflow-wrap: anywhere; line-height: 1.5; }
</style>
