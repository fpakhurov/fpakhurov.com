---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { Phi, phi } from '../normal';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// K models with the same true accuracy 0.8, each validated on n = 10,000 independent examples. Typical gap: how far the
// best measured accuracy lies above 0.8 on average (sd 0.004 times the expected maximum of K standard normals).
// Guarantee: Hoeffding plus the union bound, sqrt((ln K + ln(2/δ)) / 2n) with δ = 0.05.
const n = 10000, sd = Math.sqrt(0.8 * 0.2 / n), Ks = [1, 10, 100, 1000];
const xs = Array.from({ length: 16000 }, (_, i) => -8 + (i + 0.5) * 0.001);
const emax = (K: number) => xs.reduce((s, x) => s + x * K * phi(x) * Phi(x) ** (K - 1) * 0.001, 0);
const rows = Ks.map((K) => ({ K, typical: Math.max(0, 100 * sd * emax(K)), bound: 100 * Math.sqrt((Math.log(K) + Math.log(40)) / (2 * n)) }));
if (rows.map((r) => `${r.typical.toFixed(2)}/${r.bound.toFixed(2)}`).join() !== '0.00/1.36,0.62/1.73,1.00/2.04,1.30/2.30') throw new Error('SelectionGap: numbers drifted from the note');
const t = ru
  ? { typ: 'типичный разрыв: лучшая измеренная − 0.8', bnd: 'гарантия: Хёфдинг + оценка объединения', y: 'процентные пункты', K: 'K моделей' }
  : { typ: 'typical gap: best measured − 0.8', bnd: 'guarantee: Hoeffding + union bound', y: 'percentage points', K: 'K models' };
const id = 'selection-gap';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 320, x0: 60, x1: 580, y0: 70, y1: 260, leg: [60, 20] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 340, x0: 40, x1: 350, y0: 80, y1: 270, leg: [16, 20] },
];
---

<Figure
  id={id}
  title={ru ? 'Насколько лучшая из K одинаково точных моделей выглядит лучше, чем есть' : 'How much better the best of K equally good models looks than it is'}
  caption={ru
    ? `K моделей с одной и той же истинной долей правильных ответов 0.8, каждая проверена на 10 000 независимых примеров. Синие столбцы — насколько лучшая измеренная доля в среднем выше 0.8: ${rows.map((r) => r.typical.toFixed(2)).join(', ')} п. п. для K = 1, 10, 100, 1000. Жёлтые — граница, которую неравенство Хёфдинга с оценкой объединения гарантирует для всех K моделей сразу с вероятностью 95%: ${rows.map((r) => r.bound.toFixed(2)).join(', ')} п. п. Граница растёт как корень из ln K.`
    : `K models with the same true accuracy 0.8, each validated on 10,000 independent examples. Blue bars: how far the best measured accuracy lies above 0.8 on average, ${rows.map((r) => r.typical.toFixed(2)).join(', ')} percentage points for K = 1, 10, 100, 1000. Amber bars: the margin that Hoeffding's inequality with the union bound guarantees for all K models at once with probability 95%, ${rows.map((r) => r.bound.toFixed(2)).join(', ')} points. The margin grows like the square root of ln K.`}
>
  {layouts.map((L) => {
    const gw = (L.x1 - L.x0) / Ks.length, bw = gw * 0.3, sy = scale([0, 2.5], [L.y1, L.y0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Типичный разрыв и гарантированная граница по K' : 'Typical gap and guaranteed margin by K'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Пары столбцов для K = 1, 10, 100, 1000; синие растут от 0 до 1.30, жёлтые от 1.36 до 2.30.' : 'Pairs of bars for K = 1, 10, 100, 1000; blue grows from 0 to 1.30, amber from 1.36 to 2.30.'}</desc>
        {[0, 1, 2].map((v) => <g><path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} /><text class="f-note" x={L.x0 - 8} y={sy(v) + 5} text-anchor="end">{v}</text></g>)}
        {rows.map((r, i) => {
          const cx = L.x0 + gw * (i + 0.5);
          return (
            <g>
              <rect x={cx - bw - 2} y={sy(r.typical)} width={bw} height={sy(0) - sy(r.typical)} style="fill: var(--fig-blue); fill-opacity: .5" />
              <rect x={cx + 2} y={sy(r.bound)} width={bw} height={sy(0) - sy(r.bound)} style="fill: var(--fig-amber); fill-opacity: .5" />
              <text class="f-note" x={cx - bw / 2 - 2} y={sy(r.typical) - 6} text-anchor="middle">{r.typical.toFixed(2)}</text>
              <text class="f-note" x={cx + bw / 2 + 2} y={sy(r.bound) - 6} text-anchor="middle">{r.bound.toFixed(2)}</text>
              <text class="f-small" x={cx} y={L.y1 + 20} text-anchor="middle">{`K = ${r.K}`}</text>
            </g>
          );
        })}
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        <rect x={L.leg[0]} y={L.leg[1] - 10} width="14" height="10" style="fill: var(--fig-blue); fill-opacity: .5" />
        <text class="f-note" x={L.leg[0] + 20} y={L.leg[1]}>{t.typ}</text>
        <rect x={L.leg[0]} y={L.leg[1] + 12} width="14" height="10" style="fill: var(--fig-amber); fill-opacity: .5" />
        <text class="f-note" x={L.leg[0] + 20} y={L.leg[1] + 22}>{t.bnd}</text>
        <text class="f-note f-t-muted" x={L.x0 - 8} y={L.y0 - 12}>{t.y}</text>
      </svg>
    );
  })}
</Figure>
