---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const id='tail-bounds';
const ru=pageLang(Astro.url)==='ru';
const title=ru?'Один хвостовой риск и три верхние границы':'One tail probability and three upper bounds';
const caption=ru?'Независимые Bernoulli(0.4), отклонение среднего хотя бы на 0.1, оба хвоста с границей включительно. Точки для n = 40, 50, …, 400 соединены линиями. Вертикальная шкала логарифмическая; границы обрезаны на уровне 1. Точная вероятность вычислена суммированием биномиальных масс.':'Independent Bernoulli(0.4) observations; absolute mean deviation at least 0.1, including both boundary counts. Points for n = 40, 50, …, 400 are joined. The vertical scale is logarithmic; bounds are clipped at 1. Exact probabilities come from binomial sums.';
const curves=[{key:'actual',label:ru?'Точная вероятность':'Exact probability'},{key:'chebyshev',label:ru?'Чебышёв':'Chebyshev'},{key:'hoeffding',label:ru?'Хёфдинг':'Hoeffding'},{key:'chernoff',label:ru?'Чернов, Bernoulli':'Chernoff, Bernoulli'}] as const;
const xp=(n:number)=>48+(n-40)*2/3,yp=(p:number)=>48-35.2*Math.log10(Math.min(1,p));
---
<Figure id={id} title={title} caption={caption}>
 <div class="tail-panels">
  <svg viewBox="0 0 320 280" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
   <title id={`${id}-title`}>{ru?'Точная вероятность и границы при росте выборки':'Exact probability and bounds as sample size increases'}</title>
   <desc id={`${id}-desc`}>{ru?'Все четыре кривые убывают на показанной сетке. Синяя точная вероятность ниже трёх границ. Красный пунктир Чебышёва убывает медленнее экспоненциальных границ. Каждое деление вертикальной шкалы отличается в десять раз.':'All four curves decrease on the plotted grid. The blue exact probability lies below all three bounds. Dashed red Chebyshev decreases more slowly than the exponential bounds. Each vertical tick differs by a factor of ten.'}</desc>
   <path d="M48 40V224H292" class="axis"/>
   {[0,-1,-2,-3,-4,-5].map(k=><g><path d={`M44 ${yp(10**k)}H288`} class="grid"/><text x="38" y={yp(10**k)+5} text-anchor="end">{k===0?'1':`1e${k}`}</text></g>)}
   {[40,150,250,400].map(n=><text x={xp(n)} y="246" text-anchor="middle">{n}</text>)}
   {curves.map(c=><polyline data-series={c.key} points={cases.tailRows.map(row=>`${xp(row.n)},${yp(row[c.key])}`).join(' ')} class={`curve ${c.key}`}/>)}
   <text x="48" y="23">{ru?'Вероятность / граница':'Probability / bound'}</text><text x="280" y="271">n</text>
  </svg>
  <div><ul>{curves.map(c=><li><span class={`swatch ${c.key}`}></span>{c.label}</li>)}</ul><p>{ru?'При n = 150 точная вероятность ≈ 0.01538. Границы: 0.16, 0.09957 и 0.08597. Это сравнение относится к заданному распределению и порогу.':'At n = 150 the exact probability is about 0.01538. Bounds are 0.16, 0.09957 and 0.08597. This comparison concerns the stipulated distribution and threshold.'}</p></div>
 </div>
</Figure>
<style>
.tail-panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;align-items:center}.tail-panels svg{width:100%;height:auto;min-width:0}.tail-panels text{fill:var(--ink);font:15px var(--sans);font-variant-numeric:tabular-nums}.axis{fill:none;stroke:var(--ink);stroke-width:1.2}.grid{fill:none;stroke:var(--muted);stroke-opacity:.2}.curve{fill:none;stroke:var(--fig-blue);stroke-width:2.6}.curve.chebyshev{stroke:var(--fig-red);stroke-dasharray:7 4}.curve.hoeffding{stroke:var(--fig-green);stroke-dasharray:2 4}.curve.chernoff{stroke:var(--fig-amber);stroke-dasharray:9 3 2 3}ul{list-style:none;padding:0}li{margin:.6rem 0}.swatch{display:inline-block;width:1.4rem;border-top:3px solid var(--fig-blue);margin-right:.5rem;vertical-align:middle}.swatch.chebyshev{border-color:var(--fig-red);border-top-style:dashed}.swatch.hoeffding{border-color:var(--fig-green);border-top-style:dotted}.swatch.chernoff{border-color:var(--fig-amber);border-top-style:double}@media(max-width:700px){.tail-panels{grid-template-columns:1fr}}
</style>
