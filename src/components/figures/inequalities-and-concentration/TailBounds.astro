---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// n fair coin flips: the probability that the share of heads is off by at least 0.1, exactly (binomial) and as bounded
// by Chebyshev (0.25 / (n · 0.01)) and Hoeffding (2 e^(−2n · 0.01)), on a logarithmic scale.
const lf: number[] = [0];
for (let k = 1; k <= 1000; k++) lf.push(lf[k - 1] + Math.log(k));
const pmf = (n: number, k: number) => Math.exp(lf[n] - lf[k] - lf[n - k] - n * Math.LN2);
const exact = (n: number) => {
  let p = 0;
  for (let k = 0; k <= n; k++) if (Math.abs(k / n - 0.5) >= 0.1 - 1e-12) p += pmf(n, k);
  return p;
};
const ns = Array.from({ length: 100 }, (_, i) => 10 * (i + 1));
const curves = [
  { key: 'cheb', f: (n: number) => Math.min(1, 25 / n), tone: 'muted' },
  { key: 'hoef', f: (n: number) => Math.min(1, 2 * Math.exp(-0.02 * n)), tone: 'amber' },
  { key: 'exact', f: exact, tone: 'blue' },
];
const at = (n: number) => curves.map((c) => c.f(n));
if ([...at(100), ...at(1000)].map((v) => v.toExponential(1)).join() !== '2.5e-1,2.7e-1,5.7e-2,2.5e-2,4.1e-9,2.7e-10') throw new Error('TailBounds: numbers drifted from the note');
const t = ru
  ? { cheb: 'Чебышёв: 25 / n', hoef: 'Хёфдинг: 2e^(−0.02n)', exact: 'точно (биномиальное)', x: 'число бросков n', y: 'P(|доля − 0.5| ≥ 0.1)' }
  : { cheb: 'Chebyshev: 25 / n', hoef: 'Hoeffding: 2e^(−0.02n)', exact: 'exact (binomial)', x: 'number of flips n', y: 'P(|share − 0.5| ≥ 0.1)' };
const id = 'tail-bounds';
const ticks: [number, string][] = [[0, '1'], [-2, '10⁻²'], [-4, '10⁻⁴'], [-6, '10⁻⁶'], [-8, '10⁻⁸'], [-10, '10⁻¹⁰']];
const layouts = [
  { cls: 'fig-wide fig-medium', W: 620, H: 320, x0: 60, x1: 590, y0: 36, y1: 260 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 330, x0: 50, x1: 344, y0: 36, y1: 250 },
];
---

<Figure
  id={id}
  title={ru ? 'Две оценки хвоста и точная вероятность' : 'Two tail bounds and the exact probability'}
  caption={ru
    ? 'Вероятность того, что доля орлов в n бросках честной монеты отклонится от 0.5 хотя бы на 0.1, в логарифмическом масштабе. Неравенство Чебышёва убывает как 1/n: 0.25 при n = 100 и 0.025 при n = 1000. Неравенство Хёфдинга убывает экспоненциально: 0.27 и 4.1·10⁻⁹. Точная вероятность — 0.057 и 2.7·10⁻¹⁰: обе оценки верны, но только экспоненциальная передаёт, как быстро исчезают большие отклонения.'
    : 'The probability that the share of heads in n flips of a fair coin is off from 0.5 by at least 0.1, on a log scale. Chebyshev\'s bound falls like 1/n: 0.25 at n = 100 and 0.025 at n = 1000. Hoeffding\'s bound falls exponentially: 0.27 and 4.1·10⁻⁹. The exact probability is 0.057 and 2.7·10⁻¹⁰: both bounds hold, but only the exponential one captures how fast large deviations vanish.'}
>
  {layouts.map((L) => {
    const sx = scale([0, 1000], [L.x0, L.x1]), sy = scale([-10.5, 0], [L.y1, L.y0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Оценки Чебышёва и Хёфдинга против точной вероятности' : 'Chebyshev and Hoeffding bounds against the exact probability'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Три кривые на логарифмической оси: пологая кривая Чебышёва, прямая Хёфдинга и точная вероятность ниже обеих.' : 'Three curves on a log axis: the shallow Chebyshev curve, the straight Hoeffding line and the exact probability below both.'}</desc>
        {ticks.map(([e, lab]) => <g><path class="f-grid" d={`M ${L.x0} ${sy(e)} H ${L.x1}`} /><text class="f-note" x={L.x0 - 8} y={sy(e) + 5} text-anchor="end">{lab}</text></g>)}
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {[0, 250, 500, 750, 1000].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{v}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 42} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.x0} y={L.y0 - 14}>{t.y}</text>
        {curves.map((c) => <path class={`f-line f-${c.tone}`} d={polyline(ns.map((n) => [sx(n), sy(Math.log10(c.f(n)))]))} />)}
        {curves.map((c, i) => (
          <g>
            <path class={`f-line f-${c.tone}`} d={`M ${L.x0 + 14} ${sy(-7.2) + i * 22} h 24`} />
            <text class="f-note" x={L.x0 + 46} y={sy(-7.2) + i * 22 + 5}>{t[c.key as 'cheb' | 'hoef' | 'exact']}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
