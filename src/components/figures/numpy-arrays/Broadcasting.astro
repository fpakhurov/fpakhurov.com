---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// col (3, 1) + row (4,) -> (3, 4), the REPL example of the note (NumPy 2.5.4).
const col = [0, 10, 20];
const row = [1, 2, 3, 4];
// The broadcasting rule, applied to the two shapes: right-align, pad with 1, sizes equal or one of them 1.
const broadcast = (a: number[], b: number[]) => {
  const n = Math.max(a.length, b.length);
  const pa = [...Array(n - a.length).fill(1), ...a], pb = [...Array(n - b.length).fill(1), ...b];
  return pa.map((x, k) => {
    if (x !== pb[k] && x !== 1 && pb[k] !== 1) throw new Error('incompatible shapes');
    return Math.max(x, pb[k]);
  });
};
const out = broadcast([3, 1], [4]);
if (out.join() !== '3,4') throw new Error('shape');
const sum = col.map((c) => row.map((r) => c + r));
if (sum.map((r) => r.join(' ')).join(' | ') !== '1 2 3 4 | 11 12 13 14 | 21 22 23 24') throw new Error('values');

const t = ru
  ? { shapes: 'формы, выровненные по правому краю', names: ['col', 'row', 'результат'], pair: '3 и 1 → 3;  1 и 4 → 4',
      heads: ['col (3, 1)', 'row (4,)', 'col + row (3, 4)'], stride: 'шаг 0 вдоль растянутой оси',
      steps: ['Формы выравниваются по правому краю: (3, 1) и (4,)', 'У row не хватает оси: слева дописывается 1, получается (1, 4). Пары размеров совместимы: размеры равны или один из них равен 1', 'Ось размера 1 растягивается: col повторяется по столбцам, row — по строкам. Копий нет: шаг вдоль растянутой оси равен 0', 'Поэлементное сложение даёт массив (3, 4): элемент (i, j) равен col[i] + row[j]'] }
  : { shapes: 'shapes, aligned on the right', names: ['col', 'row', 'result'], pair: '3 with 1 → 3;  1 with 4 → 4',
      heads: ['col (3, 1)', 'row (4,)', 'col + row (3, 4)'], stride: 'stride 0 along the stretched axis',
      steps: ['Line the shapes up on the right: (3, 1) and (4,)', 'row has one axis fewer: pad it with a 1 on the left, (1, 4). Each pair of sizes is equal or contains a 1', 'A size-1 axis is stretched: col repeats across the columns, row down the rows. Nothing is copied: the stretched axis has stride 0', 'Add elementwise. The result has shape (3, 4), and entry (i, j) is col[i] + row[j]'] };

interface Layout { cls: string; W: number; H: number; sans: number; mono: number;
  head: [number, number]; labelX: number; dimX: [number, number]; dim: [number, number]; rowY: [number, number, number]; ruleY: number; pairY: number;
  cw: number; ch: number; grids: [number, number][]; ops: [string, number, number][]; strideAt: [number, number]; badges: [number, number][] }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 210, sans: 6.5, mono: 7.5, head: [40, 26], labelX: 40, dimX: [150, 196], dim: [38, 26], rowY: [44, 80, 136], ruleY: 122, pairY: 186,
    cw: 32, ch: 28, grids: [[290, 58], [450, 58], [610, 58]], ops: [['+', 434, 106], ['=', 594, 106]], strideAt: [434, 168],
    badges: [[18, 57], [254, 93], [290, 38], [750, 72]] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 440, sans: 7.3, mono: 8.4, head: [40, 24], labelX: 40, dimX: [176, 224], dim: [40, 26], rowY: [40, 74, 128], ruleY: 116, pairY: 178,
    cw: 26, ch: 24, grids: [[30, 222], [196, 222], [126, 352]], ops: [['+', 165, 262], ['=', 100, 392]], strideAt: [180, 314],
    badges: [[18, 53], [282, 87], [18, 212], [252, 388]] },
];
for (const L of layouts) {
  if (L.head[0] + t.shapes.length * L.sans > L.W - 4) throw new Error(`"${t.shapes}" overflows at ${L.W}`);
  if (L.labelX + Math.max(...t.names.map((n) => n.length)) * L.sans > L.dimX[0] - 6) throw new Error('names run into shapes');
  if (L.labelX + t.pair.length * L.mono > L.W - 4) throw new Error(`"${t.pair}" overflows at ${L.W}`);
  for (const [x, y] of L.grids) if (x + 4 * L.cw > L.W - 4 || y + 3 * L.ch > L.H - 4) throw new Error(`grid off canvas at ${L.W}`);
  if (L.strideAt[0] - (t.stride.length * L.sans) / 2 < 2 || L.strideAt[0] + (t.stride.length * L.sans) / 2 > L.W - 2) throw new Error('stride note overflows');
  for (const [k, h] of t.heads.entries()) {
    const [x] = L.grids[k];
    if (x + 2 * L.cw - (h.length * L.mono) / 2 < 2 || x + 2 * L.cw + (h.length * L.mono) / 2 > L.W - 2) throw new Error(`head "${h}" overflows at ${L.W}`);
  }
  // the two grid heads on one line must not meet
  if (L.grids[0][1] === L.grids[1][1]) {
    const r0 = L.grids[0][0] + 2 * L.cw + (t.heads[0].length * L.mono) / 2, l1 = L.grids[1][0] + 2 * L.cw - (t.heads[1].length * L.mono) / 2;
    if (r0 + 6 > l1) throw new Error('grid heads collide');
  }
  if (L.grids[2][1] - 8 - 12 < L.strideAt[1] + 4 && L.grids[2][1] > L.strideAt[1]) throw new Error('result head meets the stride note');
  if (L.W === 760 && L.dimX[1] + L.dim[0] > L.grids[0][0] - 20) throw new Error('shape table runs into grids');
}
const id = 'broadcasting';
const tone = { col: toneVar.x, row: toneVar.h, out: toneVar.y, pad: toneVar.g };
---

<Figure
  id={id}
  title={ru ? 'Трансляция: (3, 1) + (4,) → (3, 4)' : 'Broadcasting: (3, 1) + (4,) → (3, 4)'}
  caption={ru
    ? 'Сложение столбца формы (3, 1) и строки формы (4,), по шагам. Формы выравниваются по правому краю, недостающая ось дописывается слева как 1, и на каждой оси размеры должны совпадать или один из них должен быть 1. Ось размера 1 растягивается до размера другого операнда (бледные ячейки): это не копия, а шаг 0 по этой оси, так что каждая позиция читает один и тот же элемент. Результат: элемент (i, j) равен col[i] + row[j].'
    : 'Adding a column of shape (3, 1) and a row of shape (4,), step by step. The shapes are lined up on the right, the missing axis is padded on the left with a 1, and on every axis the sizes must be equal or one of them 1. A size-1 axis is stretched to the other operand\'s size (faint cells): not a copy, but stride 0 along that axis, so every position reads the same element. The result: entry (i, j) is col[i] + row[j].'}
>
  {layouts.map((L) => {
    const dimBox = (k: number, y: number, v: string, c: string, dashed = false) => (
      <g>
        <rect x={L.dimX[k]} y={y} width={L.dim[0]} height={L.dim[1]} rx="4" class={dashed ? 'f-dash' : ''} style={`fill: ${c}; fill-opacity: 0.14; stroke: ${c}; stroke-width: 1.3`} />
        <text class="f-label" x={L.dimX[k] + L.dim[0] / 2} y={y + L.dim[1] / 2 + 5} text-anchor="middle">{v}</text>
      </g>
    );
    const cell = (gx: number, gy: number, i: number, j: number, v: number, c: string, ghost: boolean, s: string) => (
      <g data-s={s}>
        <rect x={gx + j * L.cw} y={gy + i * L.ch} width={L.cw} height={L.ch} class={ghost ? 'f-dash' : ''} style={`fill: ${c}; fill-opacity: ${ghost ? 0.05 : 0.16}; stroke: ${c}; stroke-width: ${ghost ? 1 : 1.2}; stroke-opacity: ${ghost ? 0.6 : 1}`} />
        <text class={`f-small${ghost ? ' f-t-muted' : ''}`} x={gx + j * L.cw + L.cw / 2} y={gy + i * L.ch + L.ch / 2 + 4.5} text-anchor="middle">{v}</text>
      </g>
    );
    const [A, B, C] = L.grids;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Трансляция столбца (3, 1) и строки (4,)' : 'Broadcasting a (3, 1) column against a (4,) row'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Слева таблица форм: col (3, 1), row (4,) с дописанной слева единицей, результат (3, 4). Справа три сетки 3 на 4: столбец 0, 10, 20, повторённый по четырём столбцам; строка 1, 2, 3, 4, повторённая по трём строкам; их сумма от 1 до 24.'
          : 'On the left a table of shapes: col (3, 1), row (4,) padded with a 1 on the left, result (3, 4). On the right three 3 by 4 grids: the column 0, 10, 20 repeated across four columns; the row 1, 2, 3, 4 repeated down three rows; and their sum, from 1 to 24.'}</desc>
        <text class="f-small f-t-muted" x={L.head[0]} y={L.head[1]} style="font-weight: 650">{t.shapes}</text>
        <g data-s="1">
          <Badge x={L.badges[0][0]} y={L.badges[0][1]} n={1} />
          <text class="f-label" x={L.labelX} y={L.rowY[0] + L.dim[1] / 2 + 5} style="font-family: var(--mono)">{t.names[0]}</text>
          {dimBox(0, L.rowY[0], '3', tone.col)}
          {dimBox(1, L.rowY[0], '1', tone.col)}
          <text class="f-label" x={L.labelX} y={L.rowY[1] + L.dim[1] / 2 + 5} style="font-family: var(--mono)">{t.names[1]}</text>
          {dimBox(1, L.rowY[1], '4', tone.row)}
        </g>
        <g data-s="2">
          <Badge x={L.badges[1][0]} y={L.badges[1][1]} n={2} />
          {dimBox(0, L.rowY[1], '1', tone.pad, true)}
          <path class="f-grid" d={`M ${L.labelX} ${L.ruleY} H ${L.dimX[1] + L.dim[0]}`} />
          <text class="f-label" x={L.labelX} y={L.rowY[2] + L.dim[1] / 2 + 5} style="font-family: var(--mono)">{t.names[2]}</text>
          {dimBox(0, L.rowY[2], '3', tone.out)}
          {dimBox(1, L.rowY[2], '4', tone.out)}
          <text class="f-small f-t-muted" x={L.labelX} y={L.pairY} style="font-family: var(--mono)">{t.pair}</text>
        </g>
        {t.heads.map((h, k) => (
          <text class="f-small f-t-muted" x={L.grids[k][0] + 2 * L.cw} y={L.grids[k][1] - 8} text-anchor="middle" data-s={k === 2 ? '4' : '1'} style="font-family: var(--mono)">{h}</text>
        ))}
        {col.map((v, i) => [0, 1, 2, 3].map((j) => cell(A[0], A[1], i, j, v, tone.col, j !== 0, j !== 0 ? '3' : '1')))}
        {row.map((v, j) => [0, 1, 2].map((i) => cell(B[0], B[1], i, j, v, tone.row, i !== 0, i !== 0 ? '3' : '1')))}
        {sum.map((r, i) => r.map((v, j) => cell(C[0], C[1], i, j, v, tone.out, false, '4')))}
        {L.ops.map(([op, x, y], k) => <text class="f-label" x={x} y={y} text-anchor="middle" data-s={k === 0 ? '1' : '4'}>{op}</text>)}
        <g data-s="3">
          <Badge x={L.badges[2][0]} y={L.badges[2][1]} n={3} />
          <text class="f-small f-t-amber" x={L.strideAt[0]} y={L.strideAt[1]} text-anchor="middle">{t.stride}</text>
        </g>
        <g data-s="4"><Badge x={L.badges[3][0]} y={L.badges[3][1]} n={4} /></g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
