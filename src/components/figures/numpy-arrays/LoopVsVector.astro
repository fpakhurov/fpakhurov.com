---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Sum of squares of n random float64 values, nanoseconds per element, best of 5 repetitions.
// Measured once with timeit on CPython 3.14.7, NumPy 2.5.4 (BLAS: Apple Accelerate), Apple M1, macOS, and embedded here.
const ns = [10, 100, 1_000, 10_000, 100_000, 1_000_000];
const series = [
  { key: 'list', tone: 'red', values: [26.1, 19.8, 19.3, 19.3, 19.5, 19.6] },
  { key: 'array', tone: 'amber', values: [140.0, 102.9, 99.3, 99.0, 99.6, 101.2] },
  { key: 'sum', tone: 'blue', values: [61.88, 6.27, 1.00, 0.49, 0.39, 0.53] },
  { key: 'dot', tone: 'green', values: [53.44, 5.34, 0.679, 0.213, 0.169, 0.174] },
] as const;
// The claims of the note and caption, checked against the data.
const [list, array, sum, dot] = series.map((s) => s.values);
if (Math.round(list[5] / sum[5]) !== 37 || Math.round(list[5] / dot[5]) !== 113) throw new Error('speedups at 10^6');
if (!(list[0] * 10 < sum[0] * 10 && list[0] * 10 < dot[0] * 10)) throw new Error('the list loop should win at n = 10');
if (Math.round(array[5] / list[5]) !== 5) throw new Error('array loop about 5x slower than list loop');
if (!(sum[5] > sum[4])) throw new Error('the temporary should cost more at 10^6');

const t = ru
  ? { x: 'число элементов n', y: 'нс на элемент', labels: { list: 'цикл Python по списку', array: 'цикл Python по массиву', sum: '(x * x).sum()', dot: 'x @ x' } }
  : { x: 'number of elements n', y: 'ns per element', labels: { list: 'Python loop over a list', array: 'Python loop over the array', sum: '(x * x).sum()', dot: 'x @ x' } };
// Where each label sits: at log10 n = at, above (dy < 0) or below (dy > 0) its line.
const place = { list: { at: 2.2, dy: -8 }, array: { at: 2.2, dy: -8 }, sum: { at: 4.2, dy: -8 }, dot: { at: 4.2, dy: 17 } } as const;
const interp = (vals: readonly number[], at: number) => {
  const k = Math.min(Math.floor(at) - 1, vals.length - 2), f = at - Math.floor(at);
  return Math.pow(10, Math.log10(vals[k]) * (1 - f) + Math.log10(vals[k + 1]) * f);
};

interface Layout { cls: string; W: number; H: number; x0: number; x1: number; y0: number; y1: number; xticks: number[] }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 300, x0: 70, x1: 730, y0: 250, y1: 30, xticks: [1, 2, 3, 4, 5, 6] },
  { cls: 'fig-narrow', W: 360, H: 300, x0: 50, x1: 344, y0: 250, y1: 30, xticks: [1, 2, 3, 4, 5, 6] },
];
const yticks = [0.1, 1, 10, 100];
const sans = 6.5;
const id = 'loop-vs-vector';
const plots = layouts.map((L) => {
  const sx = scale([1, 6], [L.x0, L.x1]);
  const sy = scale([-1.25, Math.log10(300)], [L.y0, L.y1]);
  const labels = series.map((s) => {
    const p = place[s.key];
    const x = sx(p.at), y = sy(Math.log10(interp(s.values, p.at))) + p.dy;
    const text = t.labels[s.key];
    if (x + text.length * sans > L.W - 4) throw new Error(`label "${text}" overflows at ${L.W}`);
    if (y < 12 || y > L.y0 - 4) throw new Error(`label "${text}" leaves the plot at ${L.W}`);
    return { x, y, text, tone: s.tone };
  });
  // labels that share a column must be at least 15 px apart vertically
  for (const a of labels) for (const b of labels) if (a !== b && a.x === b.x && Math.abs(a.y - b.y) < 15) throw new Error(`labels "${a.text}" and "${b.text}" collide at ${L.W}`);
  // and no label may sit on another series' line at its own x
  for (const a of labels) for (const s of series) {
    if (t.labels[s.key] === a.text) continue;
    const at = place[series.find((q) => t.labels[q.key] === a.text)!.key].at;
    const lineY = sy(Math.log10(interp(s.values, at)));
    if (lineY > a.y - 12 && lineY < a.y + 4) throw new Error(`label "${a.text}" sits on the ${s.key} line at ${L.W}`);
  }
  return { sx, sy, labels, paths: series.map((s) => polyline(s.values.map((v, k) => [sx(Math.log10(ns[k])), sy(Math.log10(v))]))) };
});
const sup = ['', '', '²', '³', '⁴', '⁵', '⁶'];
---

<Figure
  id={id}
  title={ru ? 'Цикл Python против векторизованного кода' : 'A Python loop against vectorized code'}
  caption={ru
    ? 'Сумма квадратов n случайных чисел float64 четырьмя способами, время на один элемент в наносекундах, обе оси логарифмические. Измерено один раз (лучшее из пяти повторений timeit) на CPython 3.14.7 и NumPy 2.5.4 с BLAS Apple Accelerate, Apple M1. Цикл по списку стоит около 20 нс на элемент при любом n; цикл по массиву NumPy в 5 раз медленнее. Векторизованный код платит около 0.5 мкс за вызов, поэтому при n = 10 проигрывает циклу, а при n = 10⁶ (x * x).sum() быстрее цикла в 37 раз, а x @ x — в 113 раз. Подъём кривой (x * x).sum() справа объясняется временным массивом, который перестаёт помещаться в кэш.'
    : 'The sum of squares of n random float64 values four ways, time per element in nanoseconds, both axes logarithmic. Measured once (best of five timeit repetitions) on CPython 3.14.7 and NumPy 2.5.4 with Apple Accelerate as BLAS, Apple M1. The loop over a list costs about 20 ns per element at every n; the loop over a NumPy array is 5 times slower. Vectorized code pays about 0.5 µs per call, so at n = 10 it loses to the loop, while at n = 10⁶ (x * x).sum() is 37 times faster than the loop and x @ x 113 times. The rise of (x * x).sum() at the right is its temporary array no longer fitting in the cache.'}
>
  {layouts.map((L, li) => {
    const { sx, sy, labels, paths } = plots[li];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Время на элемент в зависимости от n для четырёх способов' : 'Time per element against n for four ways of computing'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Две горизонтальные линии сверху: цикл по массиву около 100 нс и цикл по списку около 20 нс на элемент. Две линии снизу падают от 50–60 нс при n = 10 до долей наносекунды начиная с n = 10 000: (x * x).sum() и x @ x.'
          : 'Two flat lines near the top: the loop over the array at about 100 ns and the loop over a list at about 20 ns per element. Two lines below fall from 50 to 60 ns at n = 10 to fractions of a nanosecond from n = 10 000 on: (x * x).sum() and x @ x.'}</desc>
        {yticks.map((v) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(Math.log10(v))} H ${L.x1}`} />
            <text class="f-small f-t-muted" x={L.x0 - 8} y={sy(Math.log10(v)) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        {L.xticks.map((k) => (
          <text class="f-small f-t-muted" x={sx(k)} y={L.y0 + 18} text-anchor="middle">{k === 1 ? '10' : `10${sup[k]}`}</text>
        ))}
        <path class="f-axis" d={`M ${L.x0} ${L.y1 - 6} V ${L.y0} H ${L.x1 + 6}`} />
        {series.map((s, k) => (
          <g>
            <path class={`f-line f-${s.tone}`} d={paths[k]} />
            {s.values.map((v, j) => <circle cx={sx(Math.log10(ns[j]))} cy={sy(Math.log10(v))} r="3.2" style={`fill: var(--fig-${s.tone})`} />)}
          </g>
        ))}
        {labels.map((l) => <text class={`f-small f-t-${l.tone} f-halo`} x={l.x} y={l.y}>{l.text}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.H - 6} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.x0 - 8} y={L.y1 - 12} text-anchor="start">{t.y}</text>
      </svg>
    );
  })}
</Figure>
