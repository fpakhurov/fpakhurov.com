---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { mulberry32, normal } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Two classes with equal priors: class 0 ~ N((0, −0.3), I), class 1 ~ ½ N((−1.5, 1.3), 0.7²I) + ½ N((1.5, 1.3), 0.7²I).
// 200 training points (100 per class). For k = 1, 15, 101 the kNN vote is evaluated on a grid of step 0.1 over
// [−4.5, 4.5] × [−4, 4], which carries 99.99% of the probability. The boundary is the 0.5 contour of the vote share,
// the amber curve the Bayes boundary p₀ = p₁ (both by marching squares); the risk of each rule is the grid integral of
// the probability of the class it does not predict, and the Bayes error the integral of min(½p₀, ½p₁).
const g = (x: number, y: number, mx: number, my: number, s: number) => Math.exp(-((x - mx) ** 2 + (y - my) ** 2) / (2 * s * s)) / (2 * Math.PI * s * s);
const P0 = (x: number, y: number) => 0.5 * g(x, y, 0, -0.3, 1);
const P1 = (x: number, y: number) => 0.25 * g(x, y, -1.5, 1.3, 0.7) + 0.25 * g(x, y, 1.5, 1.3, 0.7);
const u = mulberry32(11), z = normal(u);
const pts: [number, number, number][] = [];
for (let i = 0; i < 100; i++) pts.push([z(), -0.3 + z(), 0]);
for (let i = 0; i < 100; i++) { const side = u() < 0.5 ? -1.5 : 1.5; pts.push([side + 0.7 * z(), 1.3 + 0.7 * z(), 1]); }
const ks = [1, 15, 101];
const gx = Array.from({ length: 91 }, (_, i) => -4.5 + 0.1 * i), gy = Array.from({ length: 81 }, (_, j) => -4 + 0.1 * j);
const sortedLabels = (x: number, y: number) =>
  pts.map((p) => [(p[0] - x) ** 2 + (p[1] - y) ** 2, p[2]]).sort((a, b) => a[0] - b[0]).map((q) => q[1]);
const share = gx.map((x) => gy.map((y) => { const lab = sortedLabels(x, y); return ks.map((k) => lab.slice(0, k).reduce((s, v) => s + v, 0) / k); }));
const dA = 0.01;
let bayes = 0;
gx.forEach((x) => gy.forEach((y) => { bayes += Math.min(P0(x, y), P1(x, y)) * dA; }));
const risk = ks.map((_, a) => { let r = 0; gx.forEach((x, i) => gy.forEach((y, j) => { r += (share[i][j][a] > 0.5 ? P0(x, y) : P1(x, y)) * dA; })); return r; });
// Training error: each training point classified by its k nearest training points, itself included.
const train = ks.map((k) => pts.filter((p) => (sortedLabels(p[0], p[1]).slice(0, k).reduce((s, v) => s + v, 0) / k > 0.5 ? 1 : 0) !== p[2]).length / pts.length);
const quoted = [bayes, ...risk, ...train].map((v) => v.toFixed(3)).join();
if (quoted !== '0.135,0.188,0.141,0.204,0.000,0.115,0.175') throw new Error(`KnnBoundaries: numbers drifted from the note (${quoted})`);
// Marching squares for the level-0 contour of a grid function F[i][j] (linear interpolation along cell edges).
const contour = (F: number[][]) => {
  const segs: [number, number, number, number][] = [];
  for (let i = 0; i < gx.length - 1; i++) for (let j = 0; j < gy.length - 1; j++) {
    const c = [[gx[i], gy[j], F[i][j]], [gx[i + 1], gy[j], F[i + 1][j]], [gx[i + 1], gy[j + 1], F[i + 1][j + 1]], [gx[i], gy[j + 1], F[i][j + 1]]];
    const cross: [number, number][] = [];
    for (let e = 0; e < 4; e++) {
      const A = c[e], B = c[(e + 1) % 4];
      if ((A[2] > 0) !== (B[2] > 0)) { const t = A[2] / (A[2] - B[2]); cross.push([A[0] + t * (B[0] - A[0]), A[1] + t * (B[1] - A[1])]); }
    }
    if (cross.length >= 2) segs.push([...cross[0], ...cross[1]]);
    if (cross.length === 4) segs.push([...cross[2], ...cross[3]]);
  }
  return segs;
};
const knnSegs = ks.map((_, a) => contour(share.map((col) => col.map((v) => v[a] - 0.5))));
const bayesSegs = contour(gx.map((x) => gy.map((y) => P1(x, y) - P0(x, y))));
const view = { x: [-4, 4] as [number, number], y: [-3.4, 3.6] as [number, number] };
const inView = (x: number, y: number) => x >= view.x[0] && x <= view.x[1] && y >= view.y[0] && y <= view.y[1];
const shown = pts.filter((p) => inView(p[0], p[1]));
const t = ru
  ? { k: 'k', train: 'обучение', risk: 'риск', bayes: 'граница Байеса' }
  : { k: 'k', train: 'training', risk: 'risk', bayes: 'Bayes boundary' };
const id = 'knn-boundaries';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 300, pos: (a: number) => [8 + a * 252, 46], pw: 240, ph: 210, narrow: false },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 1050, pos: (a: number) => [16, 50 + a * 340], pw: 328, ph: 287, narrow: true },
];
---

<Figure
  id={id}
  title={ru ? 'Граница метода k ближайших соседей при трёх значениях k' : 'The k-nearest-neighbour boundary for three values of k'}
  caption={ru
    ? `200 обучающих точек двух классов (синие и красные); сплошная линия — граница голосования k соседей, жёлтая — граница Байеса. При k = 1 граница обходит каждую точку: ошибка на обучении ${train[0].toFixed(3)}, риск ${risk[0].toFixed(3)}. При k = 15 граница близка к байесовской: риск ${risk[1].toFixed(3)}. При k = 101, половине выборки, голосование усредняет слишком далёких соседей и граница сглаживается сильнее нужного: риск ${risk[2].toFixed(3)}. Ошибка Байеса ${bayes.toFixed(3)}.`
    : `200 training points of two classes (blue and red); the solid line is the boundary of the k-neighbour vote, the amber line the Bayes boundary. At k = 1 the boundary goes around every point: training error ${train[0].toFixed(3)}, risk ${risk[0].toFixed(3)}. At k = 15 it is close to the Bayes boundary: risk ${risk[1].toFixed(3)}. At k = 101, half the sample, the vote averages neighbours that are too far away and the boundary is oversmoothed: risk ${risk[2].toFixed(3)}. The Bayes error is ${bayes.toFixed(3)}.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Три панели с границами kNN для k = 1, 15 и 101' : 'Three panels with kNN boundaries for k = 1, 15 and 101'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'Синие точки внизу в центре, красные — двумя облаками сверху. При k = 1 граница изрезана и окружает отдельные точки, при k = 15 она гладкая и близка к жёлтой границе Байеса, при k = 101 слишком гладкая.' : 'Blue points at the bottom centre, red points in two clouds at the top. At k = 1 the boundary is ragged and encircles single points, at k = 15 it is smooth and close to the amber Bayes boundary, at k = 101 it is too smooth.'}</desc>
      {ks.map((k, a) => {
        const [x0, y0] = L.pos(a);
        const sx = scale(view.x, [x0, x0 + L.pw]), sy = scale(view.y, [y0 + L.ph, y0]);
        const seg = (s: number[]) => `M ${sx(s[0]).toFixed(1)} ${sy(s[1]).toFixed(1)} L ${sx(s[2]).toFixed(1)} ${sy(s[3]).toFixed(1)}`;
        const clipId = `${id}-${L.W}-clip-${a}`;
        return (
          <g>
            <text class="f-small" x={x0} y={y0 - 26} style="font-weight: 650">{`k = ${k}`}</text>
            <text class="f-note" x={x0} y={y0 - 9}>{`${t.train} ${train[a].toFixed(3)}, ${t.risk} ${risk[a].toFixed(3)}`}</text>
            <clipPath id={clipId}><rect x={x0} y={y0} width={L.pw} height={L.ph} /></clipPath>
            <rect x={x0} y={y0} width={L.pw} height={L.ph} style="fill: none; stroke: var(--line); stroke-width: 1" />
            <g clip-path={`url(#${clipId})`}>
              {shown.map((p) => <circle cx={sx(p[0])} cy={sy(p[1])} r={L.narrow ? 2.6 : 2.2} style={`fill: var(--fig-${p[2] ? 'red' : 'blue'}); fill-opacity: .6`} />)}
              <path class="f-line f-amber" style="stroke-width: 1.3" d={bayesSegs.map(seg).join(' ')} />
              <path class="f-line" style="stroke-width: 1.4" d={knnSegs[a].map(seg).join(' ')} />
            </g>
          </g>
        );
      })}
      <path class="f-line f-amber" style="stroke-width: 1.3" d={`M ${L.narrow ? 16 : L.W - 170} ${L.H - 12} h 26`} />
      <text class="f-note" x={(L.narrow ? 16 : L.W - 170) + 32} y={L.H - 7}>{t.bayes}</text>
    </svg>
  ))}
</Figure>
