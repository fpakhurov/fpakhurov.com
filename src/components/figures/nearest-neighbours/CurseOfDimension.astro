---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { mulberry32 } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Two faces of the curse of dimensionality, against the dimension d (log scale).
// Blue: 1,000 points uniform in the unit cube [0, 1]^d and 20 query points from the same distribution; the mean over the
// queries of (distance to the nearest point) / (distance to the farthest point). Seeded simulation.
// Red: the share of the volume of a d-dimensional ball that lies within 5% of its radius from the surface,
// 1 − 0.95^d, exactly.
const ds = [1, 2, 3, 5, 10, 20, 50, 100, 200, 500, 1000];
const u = mulberry32(5);
const ratio = ds.map((d) => {
  const P = Array.from({ length: 1000 }, () => Array.from({ length: d }, u));
  let s = 0;
  for (let q = 0; q < 20; q++) {
    const x = Array.from({ length: d }, u);
    let lo = Infinity, hi = 0;
    for (const p of P) { let r = 0; for (let j = 0; j < d; j++) r += (p[j] - x[j]) ** 2; lo = Math.min(lo, r); hi = Math.max(hi, r); }
    s += Math.sqrt(lo / hi) / 20;
  }
  return s;
});
const shell = ds.map((d) => 1 - 0.95 ** d);
const at = (d: number) => ds.indexOf(d);
const quoted = [2, 10, 100, 1000].map((d) => ratio[at(d)].toFixed(2)).join() + ',' + [2, 10, 100].map((d) => shell[at(d)].toFixed(3)).join();
if (quoted !== '0.02,0.26,0.69,0.89,0.098,0.401,0.994') throw new Error(`CurseOfDimension: numbers drifted from the note (${quoted})`);
const t = ru
  ? { x: 'размерность d', ratio: 'ближайший / дальний сосед', shell: 'доля объёма шара в слое 5% у поверхности' }
  : { x: 'dimension d', ratio: 'nearest / farthest distance', shell: 'share of a ball’s volume within 5% of its surface' };
const id = 'curse-of-dimension';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 320, x0: 50, x1: 580, y0: 24, y1: 260, narrow: false },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 360, x0: 40, x1: 346, y0: 70, y1: 300, narrow: true },
];
---

<Figure
  id={id}
  title={ru ? 'В большой размерности все точки далеко и все одинаково далеко' : 'In high dimension every point is far, and equally far'}
  caption={ru
    ? `Синяя кривая: 1000 точек, равномерно распределённых в кубе [0, 1]^d; для случайной точки из того же распределения отношение расстояния до ближайшей точки к расстоянию до самой дальней, среднее по 20 запросам: ${ratio[at(2)].toFixed(2)} при d = 2, ${ratio[at(10)].toFixed(2)} при d = 10, ${ratio[at(100)].toFixed(2)} при d = 100 и ${ratio[at(1000)].toFixed(2)} при d = 1000. Красная кривая: доля объёма d-мерного шара на расстоянии не больше 5% радиуса от поверхности, 1 − 0.95^d: ${shell[at(2)].toFixed(3)}, ${shell[at(10)].toFixed(3)} и ${shell[at(100)].toFixed(3)} при d = 2, 10, 100.`
    : `Blue: 1,000 points uniform in the cube [0, 1]^d; for a random query from the same distribution, the distance to the nearest point divided by the distance to the farthest, averaged over 20 queries: ${ratio[at(2)].toFixed(2)} at d = 2, ${ratio[at(10)].toFixed(2)} at d = 10, ${ratio[at(100)].toFixed(2)} at d = 100 and ${ratio[at(1000)].toFixed(2)} at d = 1000. Red: the share of the volume of a d-dimensional ball within 5% of its radius from the surface, 1 − 0.95^d: ${shell[at(2)].toFixed(3)}, ${shell[at(10)].toFixed(3)} and ${shell[at(100)].toFixed(3)} at d = 2, 10, 100.`}
>
  {layouts.map((L) => {
    const sx = scale([0, 3], [L.x0 + 8, L.x1 - 8]), sy = scale([0, 1], [L.y1, L.y0]);
    const lx = (d: number) => sx(Math.log10(d));
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Отношение расстояний и доля объёма в тонком слое по размерности' : 'Distance ratio and thin-shell volume against the dimension'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Обе кривые растут от нуля к единице с ростом размерности: красная быстрее, синяя медленнее.' : 'Both curves rise from zero towards one as the dimension grows: red faster, blue more slowly.'}</desc>
        {[0, 0.25, 0.5, 0.75, 1].map((v) => <g><path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} /><text class="f-note" x={L.x0 - 8} y={sy(v) + 5} text-anchor="end">{v}</text></g>)}
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {[1, 10, 100, 1000].map((d) => <text class="f-note" x={lx(d)} y={L.y1 + 18} text-anchor="middle">{d}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 40} text-anchor="middle">{t.x}</text>
        <path class="f-line f-blue" d={polyline(ds.map((d, i) => [lx(d), sy(ratio[i])]))} />
        <path class="f-line f-red" d={polyline(ds.map((d, i) => [lx(d), sy(shell[i])]))} />
        {ds.map((d, i) => <circle cx={lx(d)} cy={sy(ratio[i])} r="3.2" class="f-solid-blue" />)}
        {ds.map((d, i) => <circle cx={lx(d)} cy={sy(shell[i])} r="3.2" class="f-solid-red" />)}
        {L.narrow
          ? [<text class="f-small f-t-red" x={8} y={24}>{t.shell}</text>, <text class="f-small f-t-blue" x={8} y={44}>{t.ratio}</text>]
          : [<text class="f-small f-t-red f-halo" x={L.x1} y={sy(0.08)} text-anchor="end">{t.shell}</text>, <text class="f-small f-t-blue f-halo" x={L.x1} y={sy(0.2)} text-anchor="end">{t.ratio}</text>]}
      </svg>
    );
  })}
</Figure>
