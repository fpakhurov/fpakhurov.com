---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Op from '../seqflow/Op.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Vec from '../seqflow/Vec.astro';
import Stepper from '../seqflow/Stepper.astro';
import Sub from '../generative-modeling/Sub.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One StarGAN training step in the colours of the sequence-model figures: real image and labels green (inputs),
// generated images red, the discriminator amber. Labels have five CelebA entries: black, blond, brown hair, male, young.
// The input is a black-haired young woman, c′ = (1,0,0,0,1); the target is blond, male and young, c = (0,1,0,1,1).
const cOrig = [1, 0, 0, 0, 1];
const cTrg = [0, 1, 0, 1, 1];
const inCh = 3 + cTrg.length; // colour channels plus one tiled map per label entry
const lambdaCls = 1, lambdaRec = 10, lambdaGp = 10;
if (cOrig.length !== 5 || cTrg.length !== 5 || inCh !== 8 || lambdaCls !== 1 || lambdaRec !== 10 || lambdaGp !== 10)
  throw new Error('StarGanFlow: the label size or the loss weights drifted from the note');

const t = ru
  ? {
      realSub: 'настоящее, c′', fakeSub: 'подделка, домен c', recSub: 'реконструкция', fakeSubN: 'подделка, c', realSubN: 'настоящее, c′',
      target: 'целевая c', tiled: '(размножена, конкатенирована)', orig: 'исходная c′', rec: 'восстановление', recN: 'восст.',
      dReal1: 'D_{src}: x ↑, подделка ↓, + GP', dReal2: 'D_{cls}(x) → c′', dRealN1: 'D_{src}: x ↑, подделка ↓',
      dFake1: 'D_{src}: значение ↑ (для G)', dFake2: 'D_{cls} → c', dFakeN1: 'D_{src}: значение ↑',
      steps: [
        'G получает настоящее изображение x и случайную целевую метку c, размноженную по пикселям и конкатенированную с изображением как дополнительные каналы, и строит G(x, c)',
        'D судит подделку: критик D_src оценивает реалистичность (G стремится к высокому значению), классификатор D_cls должен отнести её к c; эта потеря обучает G',
        'тот же G возвращает подделку обратно с исходной меткой c′; потеря реконструкции ‖x − G(G(x, c), c′)‖₁',
        'шаг D: критик D_src ставит настоящие изображения выше подделок со штрафом на градиент, классификатор D_cls учит исходную метку c′ настоящего изображения',
      ],
    }
  : {
      realSub: 'real, label c′', fakeSub: 'fake in domain c', recSub: 'reconstruction', fakeSubN: 'fake, c', realSubN: 'real, c′',
      target: 'target c', tiled: '(tiled, concatenated)', orig: 'original c′', rec: 'rec', recN: 'rec',
      dReal1: 'D_{src}: x ↑, fake ↓, + GP', dReal2: 'D_{cls}(x) → c′', dRealN1: 'D_{src}: x ↑, fake ↓',
      dFake1: 'D_{src}: score ↑ (for G)', dFake2: 'D_{cls} → c', dFakeN1: 'D_{src}: score ↑',
      steps: [
        'G takes the real image x and a random target label c, tiled over the pixels and concatenated as extra channels, and produces G(x, c)',
        'D judges the fake: the critic D_src scores realism (G wants a high score), and the classifier D_cls must assign it to c; this loss trains G',
        'the same G maps the fake back with the original label c′; the reconstruction loss is ‖x − G(G(x, c), c′)‖₁',
        'D’s own step: the critic D_src scores real images above fakes under a gradient penalty, and the classifier D_cls learns the original label c′ of the real image',
      ],
    };
const recFormula = '‖x − G(G(x, c), c′)‖₁';
const id = 'stargan-flow';
const vals = (v: number[]) => v.map(String);
---

<Figure
  id={id}
  title={ru ? 'Один шаг обучения StarGAN: перевести, обмануть D, вернуться' : 'One StarGAN training step: translate, fool D, return'}
  caption={ru
    ? `Зелёные — входы (настоящее изображение и метки), красные — сгенерированные изображения, жёлтый — дискриминатор. Метки CelebA из пяти элементов (чёрные, светлые, каштановые волосы, мужчина, молодой): на входе молодая женщина с чёрными волосами, c′ = (${cOrig.join(', ')}), цель — светлые волосы, мужчина, молодой, c = (${cTrg.join(', ')}). Генератор видит изображение и размноженную метку как один тензор 128 × 128 × ${inCh} (1). Критик D_src оценивает подделку, а классификатор D_cls должен найти в ней целевую метку (2). Тот же генератор с меткой c′ должен вернуть вход; эту потерю взвешивает λ_rec = ${lambdaRec} (3). В своём шаге дискриминатор ставит настоящие изображения выше подделок со штрафом на градиент (λ_gp = ${lambdaGp}) и учится классифицировать настоящие изображения (4); λ_cls = ${lambdaCls}.`
    : `Green: inputs (the real image and the labels); red: generated images; amber: the discriminator. CelebA labels have five entries (black, blond, brown hair, male, young): the input is a black-haired young woman, c′ = (${cOrig.join(', ')}), and the target is blond, male and young, c = (${cTrg.join(', ')}). The generator sees the image and the tiled label as one 128 × 128 × ${inCh} tensor (1). The critic D_src scores the fake, and the classifier D_cls must find the target label in it (2). The same generator with the label c′ must return the input; λ_rec = ${lambdaRec} weights this loss (3). In its own step the discriminator scores real images above fakes under a gradient penalty (λ_gp = ${lambdaGp}) and learns to classify real images (4); λ_cls = ${lambdaCls}.`}
>
  <svg class="fig-wide" viewBox="0 0 760 350" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{ru ? 'Поток данных StarGAN' : 'The data flow of StarGAN'}</title>
    <desc id={`${id}-w-d`}>{ru
      ? 'Верхний ряд: x, генератор G с целевой меткой c снизу, подделка G(x, c), снова G с исходной меткой c′, реконструкция и пунктирная стрелка восстановления к x. Внизу два дискриминатора D: под x для настоящего изображения и под подделкой.'
      : 'Top row: x, the generator G with the target label c below it, the fake G(x, c), G again with the original label c′, the reconstruction and a dashed reconstruction arrow back to x. Below, the discriminator D twice: under x for the real image and under the fake.'}</desc>
    <Box x={20} y={80} w={110} h={50} label="x" sub={t.realSub} tone="x" />
    <g data-s="1">
      <Arrow pts={[[130, 105], [235, 105]]} />
      <Op x={250} y={105} sym="G" />
      <Vec x={205} y={150} values={vals(cTrg)} tone="x" dir="row" cw={18} ch={18} />
      <Arrow pts={[[250, 150], [250, 120]]} tone="green" />
      <text class="f-small" x={250} y={186} text-anchor="middle">{t.target}</text>
      <text class="f-small f-t-muted" x={250} y={202} text-anchor="middle">{t.tiled}</text>
      <Arrow pts={[[263, 105], [298, 105]]} />
      <Box x={300} y={80} w={120} h={50} label="G(x, c)" sub={t.fakeSub} tone="y" />
    </g>
    <g data-s="2">
      <Arrow pts={[[360, 130], [360, 248]]} />
      <Box x={300} y={250} w={120} h={40} label="D" tone="g" />
      <text class="f-small f-t-amber" x={300} y={308}><Sub label={t.dFake1} /></text>
      <text class="f-small f-t-amber" x={300} y={329}><Sub label={t.dFake2} /></text>
    </g>
    <g data-s="3">
      <Arrow pts={[[420, 105], [485, 105]]} />
      <Op x={500} y={105} sym="G" />
      <Vec x={455} y={150} values={vals(cOrig)} tone="x" dir="row" cw={18} ch={18} />
      <Arrow pts={[[500, 150], [500, 120]]} tone="green" />
      <text class="f-small" x={500} y={186} text-anchor="middle">{t.orig}</text>
      <Arrow pts={[[513, 105], [555, 105]]} />
      <Box x={557} y={80} w={183} h={50} label="G(G(x, c), c′)" sub={t.recSub} tone="y" />
      <path class="f-line f-red f-dash" d="M 648.5 80 C 648.5 36, 75 36, 75 78" marker-end="url(#f-arrow-red)" />
      <text class="f-small f-t-red f-halo" x={361.75} y={40} text-anchor="middle">{`${t.rec}: ${recFormula}`}</text>
    </g>
    <g data-s="4">
      <Arrow pts={[[75, 130], [75, 248]]} />
      <Box x={20} y={250} w={110} h={40} label="D" tone="g" />
      <text class="f-small f-t-amber" x={20} y={308}><Sub label={t.dReal1} /></text>
      <text class="f-small f-t-amber" x={20} y={329}><Sub label={t.dReal2} /></text>
    </g>
    <Badge x={228} y={84} n={1} />
    <Badge x={300} y={250} n={2} />
    <Badge x={478} y={84} n={3} />
    <Badge x={20} y={250} n={4} />
  </svg>

  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 410" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{ru ? 'Поток данных StarGAN' : 'The data flow of StarGAN'}</title>
    <desc id={`${id}-n-d`}>{ru
      ? 'Сверху вниз: x, генератор G с целевой меткой c, подделка G(x, c), снова G с исходной меткой c′ и реконструкция; пунктирная стрелка ведёт от реконструкции к x. Справа дискриминатор D для x и для подделки.'
      : 'Top to bottom: x, the generator G with the target label c, the fake G(x, c), G again with the original label c′ and the reconstruction; a dashed arrow leads from the reconstruction back to x. On the right, the discriminator D for x and for the fake.'}</desc>
    <Box x={96} y={28} w={108} h={46} label="x" sub={t.realSubN} tone="x" subGap={19} />
    <g data-s="1">
      <Arrow pts={[[150, 74], [150, 109]]} />
      <Op x={150} y={124} sym="G" />
      <Vec x={178} y={116} values={vals(cTrg)} tone="x" dir="row" cw={16} ch={16} />
      <Arrow pts={[[178, 124], [165, 124]]} tone="green" />
      <text class="f-small" x={218} y={150} text-anchor="middle">{t.target}</text>
      <Arrow pts={[[150, 137], [150, 170]]} />
      <Box x={96} y={172} w={108} h={46} label="G(x, c)" sub={t.fakeSubN} tone="y" subGap={19} />
    </g>
    <g data-s="2">
      <Arrow pts={[[204, 195], [260, 195]]} />
      <Box x={262} y={177} w={86} h={36} label="D" tone="g" />
      <text class="f-small f-t-amber" x={348} y={231} text-anchor="end"><Sub label={t.dFakeN1} /></text>
      <text class="f-small f-t-amber" x={348} y={253} text-anchor="end"><Sub label={t.dFake2} /></text>
    </g>
    <g data-s="3">
      <Arrow pts={[[150, 218], [150, 261]]} />
      <Op x={150} y={276} sym="G" />
      <Vec x={178} y={268} values={vals(cOrig)} tone="x" dir="row" cw={16} ch={16} />
      <Arrow pts={[[178, 276], [165, 276]]} tone="green" />
      <text class="f-small" x={218} y={302} text-anchor="middle">{t.orig}</text>
      <Arrow pts={[[150, 289], [150, 322]]} />
      <Box x={76} y={324} w={148} h={46} label="G(G(x, c), c′)" sub={t.recSub} tone="y" subGap={19} />
      <path class="f-line f-red f-dash" d="M 76 347 C 30 347, 30 51, 94 51" marker-end="url(#f-arrow-red)" />
      <text class="f-small f-t-red f-halo" x={150} y={394} text-anchor="middle">{`${t.recN}: ${recFormula}`}</text>
    </g>
    <g data-s="4">
      <Arrow pts={[[204, 51], [260, 51]]} />
      <Box x={262} y={33} w={86} h={36} label="D" tone="g" />
      <text class="f-small f-t-amber" x={348} y={87} text-anchor="end"><Sub label={t.dRealN1} /></text>
      <text class="f-small f-t-amber" x={348} y={109} text-anchor="end"><Sub label={t.dReal2} /></text>
    </g>
    <Badge x={118} y={124} n={1} />
    <Badge x={262} y={177} n={2} />
    <Badge x={118} y={276} n={3} />
    <Badge x={262} y={33} n={4} />
  </svg>
  <Stepper steps={t.steps} />
</Figure>
