---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Op from '../seqflow/Op.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import NewMark from '../seqflow/NewMark.astro';
import Stepper from '../seqflow/Stepper.astro';
import Sub from '../generative-modeling/Sub.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One latent-guided StarGAN v2 training step in the colours of the sequence-model figures: inputs green (x, latent
// codes), style codes blue, generated images red, the discriminator amber. Sizes and weights of the paper
// (Appendices B and E): z has 16 entries, a style code 64; λ_sty = λ_cyc = 1, λ_ds = 1 on CelebA-HQ.
const latentDim = 16, styleDim = 64;
const lambdaSty = 1, lambdaCyc = 1, lambdaDs = 1;
if (latentDim !== 16 || styleDim !== 64 || lambdaSty !== 1 || lambdaCyc !== 1 || lambdaDs !== 1)
  throw new Error('StarGanV2Flow: the sizes or the loss weights drifted from the note');

// Endpoint of an arrow from (x0, y0) that stops on the rim of an Op circle (radius 13, plus a 2 px gap) at (cx, cy).
const rim = (x0: number, y0: number, cx: number, cy: number): [number, number] => {
  const dx = cx - x0, dy = cy - y0, d = Math.hypot(dx, dy);
  return [Number((cx - (dx / d) * 15).toFixed(1)), Number((cy - (dy / d) * 15).toFixed(1))];
};

const t = ru
  ? {
      newW: 'новое: код стиля вместо метки', branch: 'ветвь ỹ', domain: 'домен y', d1: 'настоящее', d2: 'из домена ỹ?', dN: 'настоящее для ỹ?',
      sty: 'стиль', cyc: 'цикл', ds: 'разнообразие ↑',
      steps: [
        'стиль: отображающая сеть превращает шум z в код стиля s = F_ỹ(z) случайного целевого домена ỹ (или энкодер стиля читает его с образца: s = E_ỹ(x_ref))',
        'перевод: G получает x и встраивает s через AdaIN; голова дискриминатора D_ỹ решает, настоящее ли G(x, s) изображение домена ỹ',
        'восстановление стиля: энкодер стиля должен прочитать s обратно по выходу',
        'цикл: со стилем самого входа ŝ = E_y(x) генератор должен вернуть выход к x',
        'разнообразие: второй код s₂ даёт второй выход, и генератор получает награду за различие двух выходов',
      ],
    }
  : {
      newW: 'new: a style code replaces the label', branch: 'branch ỹ', domain: 'domain y', d1: 'real image', d2: 'of domain ỹ?', dN: 'real for ỹ?',
      sty: 'style', cyc: 'cycle', ds: 'diversity ↑',
      steps: [
        'style: the mapping network turns noise z into a style code s = F_ỹ(z) of a random target domain ỹ (or the style encoder reads it from a reference, s = E_ỹ(x_ref))',
        'translate: G takes x and injects s through AdaIN; the discriminator head D_ỹ judges whether G(x, s) is a real image of domain ỹ',
        'style reconstruction: the style encoder must read s back from the output',
        'cycle: with the style of the input itself, ŝ = E_y(x), G must map the output back to x',
        'diversity: a second code s₂ gives a second output, and the generator is rewarded for making the two differ',
      ],
    };
const styF = `${t.sty}: ‖s − E_{ỹ}(G(x, s))‖₁`;
const cycF = `${t.cyc}: ‖x − G(G(x, s), ŝ)‖₁`;
const dsF = `${t.ds}: ‖G(x, s) − G(x, s₂)‖₁`;
const id = 'stargan-v2-flow';
// Wide layout: arrows that end on an Op circle.
const wAda = rim(227, 72, 200, 151), wCyc = rim(256, 174, 200, 273);
// Narrow layout.
const nAda = rim(180, 74, 120, 143);
---

<Figure
  id={id}
  title={ru ? 'Один шаг обучения StarGAN v2: стиль, перевод и три проверки' : 'One StarGAN v2 training step: a style, a translation and three checks'}
  caption={ru
    ? `Зелёные — входы (изображение x и латентные коды), синие — коды стиля, красные — сгенерированные изображения, жёлтый — дискриминатор. Жёлтая пунктирная рамка отмечает то, что заменило метку StarGAN: код стиля s из ${styleDim} чисел, который отображающая сеть строит из z (${latentDim} чисел) для целевого домена ỹ (1). G встраивает стиль через AdaIN, а голова дискриминатора домена ỹ судит результат (2). Энкодер стиля должен прочитать s по выходу (3). Со стилем самого входа ŝ = E_y(x) генератор должен вернуться к x (4). Второй код s₂ даёт второй выход, и генератор получает награду за расстояние между ними (5). Веса: λ_sty = λ_cyc = ${lambdaSty}, λ_ds = ${lambdaDs} на CelebA-HQ.`
    : `Green: inputs (the image x and the latent codes); blue: style codes; red: generated images; amber: the discriminator. The amber dashed frame marks what replaced StarGAN's label: a style code s of ${styleDim} numbers, made by the mapping network from z (${latentDim} numbers) for the target domain ỹ (1). G injects the style through AdaIN, and the discriminator head of domain ỹ judges the result (2). The style encoder must read s back from the output (3). With the style of the input itself, ŝ = E_y(x), G must return to x (4). A second code s₂ gives a second output, and the generator is rewarded for the distance between the two (5). Weights: λ_sty = λ_cyc = ${lambdaSty}, λ_ds = ${lambdaDs} on CelebA-HQ.`}
>
  <svg class="fig-wide" viewBox="0 0 760 430" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{ru ? 'Поток данных StarGAN v2' : 'The data flow of StarGAN v2'}</title>
    <desc id={`${id}-w-d`}>{ru
      ? 'Ряд 1: z, отображающая сеть F, код стиля s и голова дискриминатора D_ỹ. Ряд 2: x, генератор G, выход G(x, s), энкодер стиля E и восстановленный стиль. Ряд 3: стиль входа ŝ = E_y(x), снова G и реконструкция. Ряд 4: второй код s₂, G и второй выход, пунктирная двусторонняя стрелка к первому выходу.'
      : 'Row 1: z, the mapping network F, the style code s and the discriminator head D_ỹ. Row 2: x, the generator G, the output G(x, s), the style encoder E and the recovered style. Row 3: the input style ŝ = E_y(x), G again and the reconstruction. Row 4: a second code s₂, G and a second output, with a dashed double arrow to the first output.'}</desc>
    <Box x={20} y={128} w={90} h={46} label="x" sub={t.domain} tone="x" />
    <g data-s="1">
      <NewMark x={10} y={20} w={300} h={62} label={t.newW} />
      <Box x={20} y={28} w={60} h={44} label="z" tone="x" />
      <Arrow pts={[[80, 50], [103, 50]]} />
      <Op x={118} y={50} sym="F" />
      <text class="f-small f-t-muted" x={118} y={98} text-anchor="middle">{t.branch}</text>
      <Arrow pts={[[131, 50], [152, 50]]} />
      <Box x={154} y={28} w={146} h={44} label="s = F_{ỹ}(z)" tone="h" />
    </g>
    <g data-s="2">
      <Arrow pts={[[110, 151], [185, 151]]} />
      <Arrow pts={[[227, 72], wAda]} tone="blue" />
      <text class="f-small f-t-blue" x={222} y={112}>AdaIN</text>
      <Op x={200} y={151} sym="G" />
      <Arrow pts={[[213, 151], [238, 151]]} />
      <Box x={240} y={128} w={140} h={46} label="G(x, s)" tone="y" />
      <Arrow pts={[[330, 128], [330, 50], [438, 50]]} />
      <Box x={440} y={28} w={90} h={44} label="D_{ỹ}" tone="g" />
      <text class="f-small f-t-amber" x={542} y={46}>{t.d1}</text>
      <text class="f-small f-t-amber" x={542} y={64}>{t.d2}</text>
    </g>
    <g data-s="3">
      <Arrow pts={[[380, 151], [417, 151]]} />
      <Op x={432} y={151} sym="E" />
      <Arrow pts={[[445, 151], [468, 151]]} />
      <Box x={470} y={128} w={170} h={46} label="E_{ỹ}(G(x, s))" tone="h" />
      <text class="f-small f-t-blue" x={555} y={196} text-anchor="middle"><Sub label={styF} /></text>
    </g>
    <g data-s="4">
      <Arrow pts={[[65, 174], [65, 197]]} />
      <Op x={65} y={212} sym="E" />
      <Arrow pts={[[65, 225], [65, 248]]} tone="blue" />
      <Box x={20} y={250} w={130} h={46} label="ŝ = E_{y}(x)" tone="h" />
      <Arrow pts={[[150, 273], [185, 273]]} tone="blue" />
      <Arrow pts={[[256, 174], wCyc]} />
      <Op x={200} y={273} sym="G" />
      <Arrow pts={[[213, 273], [238, 273]]} />
      <Box x={240} y={250} w={140} h={46} label="G(G(x, s), ŝ)" tone="y" />
      <text class="f-small f-t-red" x={422} y={278}>{cycF}</text>
    </g>
    <g data-s="5">
      <Box x={20} y={360} w={130} h={46} label="s₂ = F_{ỹ}(z₂)" tone="h" />
      <Arrow pts={[[150, 383], [185, 383]]} tone="blue" />
      <text class="f-label f-t-green" x={200} y={336} text-anchor="middle">x</text>
      <Arrow pts={[[200, 342], [200, 368]]} tone="green" />
      <Op x={200} y={383} sym="G" />
      <Arrow pts={[[213, 383], [238, 383]]} />
      <Box x={240} y={360} w={140} h={46} label="G(x, s₂)" tone="y" />
      <path class="f-line f-red f-dash" d="M 382 166 H 410 V 383 H 383" marker-start="url(#f-arrow-red)" marker-end="url(#f-arrow-red)" />
      <text class="f-small f-t-red" x={422} y={388}>{dsF}</text>
    </g>
    <Badge x={300} y={28} n={1} />
    <Badge x={178} y={130} n={2} />
    <Badge x={432} y={124} n={3} />
    <Badge x={178} y={252} n={4} />
    <Badge x={178} y={362} n={5} />
  </svg>

  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 510" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{ru ? 'Поток данных StarGAN v2' : 'The data flow of StarGAN v2'}</title>
    <desc id={`${id}-n-d`}>{ru
      ? 'Сверху вниз: z, F и код стиля s; x, G, выход G(x, s) и голова D_ỹ; энкодер стиля E и восстановленный стиль; стиль входа ŝ, G и реконструкция; второй код s₂, G и второй выход.'
      : 'Top to bottom: z, F and the style code s; x, G, the output G(x, s) and the head D_ỹ; the style encoder E and the recovered style; the input style ŝ, G and the reconstruction; a second code s₂, G and a second output.'}</desc>
    <Box x={12} y={120} w={70} h={46} label="x" sub={t.domain} tone="x" subGap={19} />
    <g data-s="1">
      <NewMark x={6} y={20} w={278} h={64} />
      <Box x={12} y={30} w={44} h={44} label="z" tone="x" />
      <Arrow pts={[[56, 52], [75, 52]]} />
      <Op x={90} y={52} sym="F" />
      <text class="f-small f-t-muted" x={90} y={100} text-anchor="middle">{t.branch}</text>
      <Arrow pts={[[103, 52], [116, 52]]} />
      <Box x={118} y={30} w={158} h={44} label="s = F_{ỹ}(z)" tone="h" />
    </g>
    <g data-s="2">
      <Arrow pts={[[82, 143], [105, 143]]} />
      <Arrow pts={[[180, 74], nAda]} tone="blue" />
      <text class="f-small f-t-blue" x={170} y={108}>AdaIN</text>
      <Op x={120} y={143} sym="G" />
      <Arrow pts={[[133, 143], [150, 143]]} />
      <Box x={152} y={120} w={100} h={46} label="G(x, s)" tone="y" />
      <Arrow pts={[[252, 143], [274, 143]]} />
      <Box x={276} y={120} w={72} h={46} label="D_{ỹ}" tone="g" />
      <text class="f-small f-t-amber" x={348} y={186} text-anchor="end">{t.dN}</text>
    </g>
    <g data-s="3">
      <Arrow pts={[[202, 166], [202, 209]]} />
      <Op x={202} y={224} sym="E" />
      <Arrow pts={[[189, 224], [172, 224]]} />
      <Box x={12} y={205} w={158} h={38} label="E_{ỹ}(G(x, s))" tone="h" />
      <text class="f-small f-t-blue" x={12} y={264}><Sub label={styF} /></text>
    </g>
    <g data-s="4">
      <Box x={12} y={300} w={110} h={46} label="ŝ = E_{y}(x)" tone="h" />
      <Arrow pts={[[122, 323], [155, 323]]} tone="blue" />
      <text class="f-small f-t-red" x={170} y={288} text-anchor="middle">G(x, s)</text>
      <Arrow pts={[[170, 293], [170, 308]]} />
      <Op x={170} y={323} sym="G" />
      <Arrow pts={[[183, 323], [198, 323]]} />
      <Box x={200} y={300} w={148} h={46} label="G(G(x, s), ŝ)" tone="y" />
      <text class="f-small f-t-red" x={180} y={366} text-anchor="middle">{cycF}</text>
    </g>
    <g data-s="5">
      <Box x={12} y={420} w={124} h={46} label="s₂ = F_{ỹ}(z₂)" tone="h" />
      <Arrow pts={[[136, 443], [155, 443]]} tone="blue" />
      <text class="f-label f-t-green" x={170} y={402} text-anchor="middle">x</text>
      <Arrow pts={[[170, 407], [170, 428]]} tone="green" />
      <Op x={170} y={443} sym="G" />
      <Arrow pts={[[183, 443], [204, 443]]} />
      <Box x={206} y={420} w={142} h={46} label="G(x, s₂)" tone="y" />
      <text class="f-small f-t-red" x={277} y={390} text-anchor="middle">G(x, s)</text>
      <path class="f-line f-red f-dash" d="M 277 396 V 418" marker-start="url(#f-arrow-red)" marker-end="url(#f-arrow-red)" />
      <text class="f-small f-t-red" x={180} y={492} text-anchor="middle">{dsF}</text>
    </g>
    <Badge x={300} y={52} n={1} />
    <Badge x={98} y={124} n={2} />
    <Badge x={226} y={224} n={3} />
    <Badge x={146} y={306} n={4} />
    <Badge x={146} y={426} n={5} />
  </svg>
  <Stepper steps={t.steps} />
</Figure>
