---
import BlockDiagram, { type DLayout } from '../BlockDiagram.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One generation step of a decoder-only model and where each decoding knob acts.
const t = ru
  ? { prefix: 'префикс', prefixSub: 'w₁ … wₜ₋₁', dec: 'декодер', decSub: 'каузальный, KV-кэш', logits: 'логиты zₜ', logitsSub: 'по словарю', adjust: 'преобразовать', adjustSub: 'τ, штрафы, top-k / top-p', pick: 'выбрать', pickSub: 'argmax или сэмпл', loop: 'дописать wₜ и повторить до [EOS]' }
  : { prefix: 'prefix', prefixSub: 'w₁ … wₜ₋₁', dec: 'decoder', decSub: 'causal, KV cache', logits: 'logits zₜ', logitsSub: 'over the vocabulary', adjust: 'adjust', adjustSub: 'τ, penalties, top-k / top-p', pick: 'pick', pickSub: 'argmax or sample', loop: 'append wₜ, repeat until [EOS]' };
const desc = ru
  ? 'Цикл слева направо: префикс, декодер с каузальной маской и KV-кэшем, логиты по словарю, преобразование распределения температурой, штрафами и усечением top-k или top-p, выбор токена через argmax или сэмплирование. Стрелка снизу возвращается к префиксу: выбранный токен дописывается, и шаг повторяется до символа конца.'
  : 'A loop from left to right: the prefix, the decoder with a causal mask and a KV cache, logits over the vocabulary, the distribution adjusted by temperature, penalties and top-k or top-p truncation, and the token picked by argmax or sampling. An arrow along the bottom returns to the prefix: the chosen token is appended and the step repeats until the end token.';

const wide: DLayout = {
  cls: 'fig-wide', w: 700, h: 190, desc,
  nodes: [
    { id: 'prefix', x: 10, y: 50, w: 104, h: 54, label: t.prefix, sub: t.prefixSub, tone: 'soft' },
    { id: 'dec', x: 146, y: 50, w: 128, h: 54, label: t.dec, sub: t.decSub, tone: 'blue' },
    { id: 'logits', x: 306, y: 50, w: 108, h: 54, label: t.logits, sub: t.logitsSub },
    { id: 'adjust', x: 446, y: 50, w: 134, h: 54, label: t.adjust, sub: ru ? 'τ, штрафы, top-k/p' : 'τ, penalties, top-k/p', tone: 'amber' },
    { id: 'pick', x: 598, y: 50, w: 96, h: 54, label: t.pick, sub: ru ? 'argmax / сэмпл' : 'argmax / sample', tone: 'green' },
  ],
  edges: [
    { from: 'prefix', to: 'dec' }, { from: 'dec', to: 'logits' }, { from: 'logits', to: 'adjust' }, { from: 'adjust', to: 'pick' },
    { from: 'pick', to: 'prefix', via: [[646, 150], [62, 150]], label: t.loop, tone: 'green', at: [355, 172] },
  ],
};
const narrow: DLayout = {
  cls: 'fig-narrow', w: 360, h: 380, desc,
  nodes: [
    { id: 'prefix', x: 40, y: 10, w: 220, h: 54, label: t.prefix, sub: t.prefixSub, tone: 'soft' },
    { id: 'dec', x: 40, y: 84, w: 220, h: 54, label: t.dec, sub: t.decSub, tone: 'blue' },
    { id: 'logits', x: 40, y: 158, w: 220, h: 54, label: t.logits, sub: t.logitsSub },
    { id: 'adjust', x: 40, y: 232, w: 220, h: 54, label: t.adjust, sub: t.adjustSub, tone: 'amber' },
    { id: 'pick', x: 40, y: 306, w: 220, h: 54, label: t.pick, sub: t.pickSub, tone: 'green' },
  ],
  edges: [
    { from: 'prefix', to: 'dec' }, { from: 'dec', to: 'logits' }, { from: 'logits', to: 'adjust' }, { from: 'adjust', to: 'pick' },
    { from: 'pick', to: 'prefix', via: [[284, 333], [284, 37]], tone: 'green' },
  ],
  texts: [{ x: 292, y: 190, text: ru ? 'дописать' : 'append', cls: 'f-small f-t-green' }, { x: 292, y: 206, text: ru ? 'повторить' : 'and repeat', cls: 'f-small f-t-green' }],
};
---

<BlockDiagram
  id="gpt-generation-loop"
  title={ru ? 'Цикл порождения и где действуют настройки декодирования' : 'The generation loop and where the decoding choices act'}
  svgTitle={ru ? 'Один шаг порождения модели из одного декодера' : 'One generation step of a decoder-only model'}
  caption={ru
    ? 'Один шаг порождения и место каждой настройки декодирования. Декодер читает префикс (с KV-кэшем вычисляется только новая позиция) и выдаёт логиты по словарю. Температура, штрафы за повтор и усечение top-k или top-p меняют это распределение; затем жадное декодирование берёт argmax, сэмплирование вытягивает токен из распределения, а лучевой поиск держит в живых не один префикс, а несколько. Выбранный токен дописывается, и цикл повторяется до символа конца или предела длины. Спекулятивное декодирование меняет то, кто предлагает токены, но в точной арифметике не меняет выход этого цикла.'
    : 'One step of generation and where each decoding choice acts. The decoder reads the prefix (with a KV cache only the newest position is computed) and outputs logits over the vocabulary. Temperature, repetition penalties and top-k or top-p truncation reshape that distribution; greedy decoding then takes the argmax, sampling draws from it, and beam search keeps several prefixes alive instead of one. The chosen token is appended and the loop runs again until an end token or the length limit. Speculative decoding changes who proposes the tokens but, in exact arithmetic, not the output of this loop.'}
  layouts={[wide, narrow]}
/>
