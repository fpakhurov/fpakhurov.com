---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Five tokens A–E with logits (3, 2, 1.5, 0.5, −1). Temperature reshapes the whole distribution and keeps all five
// tokens; top-k (k = 2) and top-p (p = 0.9) cut the tail and renormalize what is left. The model's own distribution
// (τ = 1) is drawn as a dashed outline in every other panel.
const z = [3, 2, 1.5, 0.5, -1];
const softmax = (v: number[]) => {
  const m = Math.max(...v);
  const e = v.map((x) => Math.exp(x - m));
  const s = e.reduce((a, b) => a + b, 0);
  return e.map((x) => x / s);
};
const base = softmax(z);
const keep = (n: number) => {
  const kept = base.map((p, i) => (i < n ? p : 0));
  const s = kept.reduce((a, b) => a + b, 0);
  return kept.map((p) => p / s);
};
// Top-p: the smallest prefix of the sorted tokens whose mass reaches p (the logits are already sorted).
const nucleus = (p: number) => {
  let c = 0;
  for (let i = 0; i < base.length; i += 1) {
    c += base[i];
    if (c >= p) return i + 1;
  }
  return base.length;
};
const nP = nucleus(0.9);
const panels = [
  { title: 'τ = 0.5', p: softmax(z.map((x) => x / 0.5)), group: 0 },
  { title: ru ? 'τ = 1 (модель)' : 'τ = 1 (model)', p: base, group: 0, isBase: true },
  { title: 'τ = 2', p: softmax(z.map((x) => x / 2)), group: 0 },
  { title: 'top-k, k = 2', p: keep(2), group: 1 },
  { title: 'top-p, p = 0.9', p: keep(nP), group: 1 },
];
const f3 = (v: number) => v.toFixed(3);
const check = [base.map(f3).join(), keep(2).slice(0, 2).map(f3).join(), keep(nP).slice(0, 3).map(f3).join(), String(nP), f3(panels[0].p[0]), f3(panels[2].p[0])];
if (check.join('|') !== '0.591,0.217,0.132,0.049,0.011|0.731,0.269|0.629,0.231,0.140|3|0.839|0.400') throw new Error('DecodingShapes: numbers drifted ' + check.join('|'));
const support = (p: number[]) => p.filter((x) => x > 0).length;
const tokens = ['A', 'B', 'C', 'D', 'E'];
const supLabel = (n: number) => (ru ? `носитель: ${n} ${n === 5 ? 'токенов' : 'токена'}` : `support: ${n} tokens`);
const groups = ru ? ['изменить форму', 'усечь'] : ['reshape', 'truncate'];

interface Slot { x: number; y: number }
interface Layout { sfx: string; cls: string; W: number; H: number; pos: Slot[]; heads: { x: number; y: number; w: number }[]; slot: number; bar: number; maxH: number; base: number }
const layouts: Layout[] = [
  {
    sfx: 'w', cls: 'fig-wide fig-bp-640', W: 760, H: 250, slot: 24, bar: 16, maxH: 110, base: 150,
    pos: [{ x: 20, y: 36 }, { x: 166, y: 36 }, { x: 312, y: 36 }, { x: 478, y: 36 }, { x: 624, y: 36 }],
    heads: [{ x: 12, y: 16, w: 420 }, { x: 470, y: 16, w: 282 }],
  },
  {
    sfx: 'n', cls: 'fig-narrow seq-narrow fig-bp-640', W: 360, H: 650, slot: 30, bar: 20, maxH: 90, base: 132,
    pos: [{ x: 14, y: 44 }, { x: 14, y: 246 }, { x: 14, y: 448 }, { x: 196, y: 44 }, { x: 196, y: 246 }],
    heads: [{ x: 6, y: 20, w: 168 }, { x: 188, y: 20, w: 168 }],
  },
];
const id = 'gpt-decoding-shapes';
const caption = ru
  ? `Пять токенов A–E с логитами (3, 2, 1.5, 0.5, −1). Пунктирный контур в каждой панели — распределение модели при τ = 1. Температура меняет форму всего распределения: при τ = 0.5 токен A получает ${f3(panels[0].p[0])}, при τ = 2 — ${f3(panels[2].p[0])}, но все пять токенов сохраняют ненулевую вероятность, и их порядок не меняется. Усечение убирает хвост: top-k с k = 2 оставляет A и B, top-p с p = 0.9 — три токена, потому что 0.591 + 0.217 = 0.809 ещё меньше 0.9, а с C набирается 0.941. Оставшиеся вероятности перенормируются, а их отношения сохраняются: 0.731 / 0.269 = 0.591 / 0.217 = e ≈ 2.72.`
  : `Five tokens A–E with logits (3, 2, 1.5, 0.5, −1). The dashed outline in every panel is the model's distribution at τ = 1. Temperature reshapes the whole distribution: at τ = 0.5 token A gets ${f3(panels[0].p[0])}, at τ = 2 it gets ${f3(panels[2].p[0])}, but all five tokens keep a nonzero probability and their order does not change. Truncation removes the tail: top-k with k = 2 keeps A and B, top-p with p = 0.9 keeps three tokens, because 0.591 + 0.217 = 0.809 is still below 0.9 and adding C reaches 0.941. What is kept is renormalized with its ratios unchanged: 0.731 / 0.269 = 0.591 / 0.217 = e ≈ 2.72.`;
---

<Figure
  id={id}
  title={ru ? 'Температура меняет форму распределения, top-k и top-p усекают его носитель' : 'Temperature reshapes the distribution, top-k and top-p truncate its support'}
  caption={caption}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{ru ? 'Одно распределение по пяти токенам при пяти правилах декодирования' : 'One distribution over five tokens under five decoding rules'}</title>
      <desc id={`${id}-${L.sfx}-d`}>{ru
        ? 'Пять столбчатых диаграмм по токенам A–E. Три синие слева, под заголовком «изменить форму»: при τ = 0.5 столбец A почти до верха, а остальные малы; при τ = 1 распределение модели; при τ = 2 столбцы ближе друг к другу. Во всех трёх у каждого токена есть столбец. Две янтарные справа, под заголовком «усечь»: при top-k столбцы есть только у A и B, при top-p — у A, B и C, и они выше пунктирного контура модели, потому что вероятность перенормирована.'
        : 'Five bar charts over tokens A to E. Three blue ones on the left, headed reshape: at τ = 0.5 the bar for A nearly reaches the top and the others are small; at τ = 1 the model distribution; at τ = 2 the bars are closer together. In all three every token has a bar. Two amber ones on the right, headed truncate: with top-k only A and B have bars, with top-p A, B and C, and they stand above the dashed outline of the model because the probability has been renormalized.'}</desc>
      {L.heads.map((h, g) => (
        <g>
          <text class={`f-small ${g === 0 ? 'f-t-blue' : 'f-t-amber'}`} x={h.x + h.w / 2} y={h.y} text-anchor="middle" font-weight="650">{groups[g]}</text>
          <path class={`f-thin ${g === 0 ? 'f-blue' : 'f-amber'}`} d={`M ${h.x} ${h.y + 6} H ${h.x + h.w}`} />
        </g>
      ))}
      {panels.map((P, i) => {
        const o = L.pos[i];
        const w5 = L.slot * 5;
        const y0 = o.y + L.base;
        return (
          <g>
            <text class="f-label" x={o.x + w5 / 2} y={o.y + 4} text-anchor="middle">{P.title}</text>
            <path class="f-axis" d={`M ${o.x} ${y0} H ${o.x + w5}`} />
            {P.p.map((v, j) => {
              const x = o.x + j * L.slot + (L.slot - L.bar) / 2;
              const h = v * L.maxH;
              return <rect x={x} y={(y0 - h).toFixed(1)} width={L.bar} height={h.toFixed(1)} style={`fill: ${P.group === 0 ? 'var(--fig-blue)' : 'var(--fig-amber)'}; fill-opacity: .8`} />;
            })}
            {!P.isBase && base.map((v, j) => {
              const x = o.x + j * L.slot + (L.slot - L.bar) / 2;
              const h = v * L.maxH;
              return <rect x={x} y={(y0 - h).toFixed(1)} width={L.bar} height={h.toFixed(1)} class="f-thin f-dash" style="fill: none" />;
            })}
            {tokens.map((tk, j) => (
              <text class="f-small f-t-muted" x={o.x + j * L.slot + L.slot / 2} y={y0 + 17} text-anchor="middle">{tk}</text>
            ))}
            <text class="f-small" x={o.x + w5 / 2} y={y0 + 38} text-anchor="middle">P(A) = {f3(P.p[0])}</text>
            <text class="f-small f-t-muted" x={o.x + w5 / 2} y={y0 + 56} text-anchor="middle">{supLabel(support(P.p))}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
