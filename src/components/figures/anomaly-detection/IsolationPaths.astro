---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { mulberry32, normal } from '../random';
import { isolationPath, iForest, cExact, type P } from './scores';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// 64 points from a standard 2-D Gaussian (seed 11) and one outlier at (3.2, 2.6). Each panel grows one random isolation
// tree (random coordinate, random split between the current minimum and maximum) until the marked point is alone, and
// draws the cuts on its path. Then a forest of 200 trees on subsamples of 64 gives the average path lengths and scores.
const z = normal(mulberry32(11));
const pts: P[] = Array.from({ length: 64 }, () => [z(), z()] as P);
pts.push([3.2, 2.6]);
const io = 64;
const ii = pts.reduce((b, p, i) => (i < 64 && Math.hypot(p[0], p[1]) < Math.hypot(pts[b][0], pts[b][1]) ? i : b), 0);
const box: [number, number, number, number] = [-3.4, 4.0, -3.2, 3.4];
const paths = [isolationPath(pts, io, 2, box), isolationPath(pts, ii, 2, box)];
const forest = iForest(pts, 200, 64, 3, [pts[io], pts[ii]]);
const c64 = cExact(64);
if (paths.map((p) => p.length).join() !== '3,10') throw new Error('IsolationPaths: path lengths drifted from the note');
if (forest.Eh.map((v) => v.toFixed(2)).join() !== '3.05,9.50' || forest.s.map((v) => v.toFixed(2)).join() !== '0.75,0.41') throw new Error('IsolationPaths: forest scores drifted from the note');
if (c64.toFixed(2) !== '7.49') throw new Error('IsolationPaths: c(64) drifted');

const targets = [io, ii];
// The final region of each target: the box of the last cut, cut once more on the target's side.
const finals = paths.map((path, k) => {
  const last = path[path.length - 1], tp = pts[targets[k]], fin = [...last.box] as [number, number, number, number];
  const below = tp[last.q] < last.p;
  if (last.q === 0) { if (below) fin[1] = last.p; else fin[0] = last.p; } else { if (below) fin[3] = last.p; else fin[2] = last.p; }
  return fin;
});
// The first three cuts are drawn thicker.
const widths = paths.map((path) => path.map((_, j) => (j < 3 ? 2 : 1.4)));
const tones = ['red', 'green'];
const t = ru
  ? { titles: ['выброс: 3 разреза', 'точка в центре: 10 разрезов'], foot: [`в среднем по лесу ${forest.Eh[0].toFixed(2)}, s = ${forest.s[0].toFixed(2)}`, `в среднем по лесу ${forest.Eh[1].toFixed(2)}, s = ${forest.s[1].toFixed(2)}`] }
  : { titles: ['outlier: 3 cuts', 'central point: 10 cuts'], foot: [`forest average ${forest.Eh[0].toFixed(2)}, s = ${forest.s[0].toFixed(2)}`, `forest average ${forest.Eh[1].toFixed(2)}, s = ${forest.s[1].toFixed(2)}`] };
const id = 'isolation-paths';
// Data box 7.4 × 6.6.
const layouts = [
  { cls: 'fig-wide', W: 760, H: 400, boxes: [[12, 32, 362, 322.9], [388, 32, 362, 322.9]] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 734, boxes: [[6, 32, 348, 310.4], [6, 392, 348, 310.4]] },
];
---

<Figure
  id={id}
  title={ru ? 'Изоляция случайными разрезами' : 'Isolation by random cuts'}
  caption={ru
    ? `64 точки из стандартного двумерного нормального распределения и выброс в (3.2, 2.6). На каждой панели одно случайное дерево: координата и порог выбираются случайно (порог — равномерно между минимумом и максимумом точек в текущей области), пока отмеченная точка не останется одна; жёлтые отрезки — разрезы на её пути, заливка — итоговая область. Выброс отделён тремя разрезами, точка в центре облака — десятью. По лесу из 200 деревьев на подвыборках по 64 точки средняя длина пути ${forest.Eh[0].toFixed(2)} против ${forest.Eh[1].toFixed(2)}; при c(64) = ${c64.toFixed(2)} это оценки s = 2^(−E h / c) = ${forest.s[0].toFixed(2)} и ${forest.s[1].toFixed(2)}.`
    : `64 points from a standard 2-D Gaussian and an outlier at (3.2, 2.6). Each panel grows one random tree: a coordinate and a threshold are drawn at random (the threshold uniformly between the minimum and maximum of the points in the current region) until the marked point is alone; the amber segments are the cuts on its path, the shading the final region. The outlier is separated by three cuts, the point in the middle of the cloud by ten. Over a forest of 200 trees on subsamples of 64 points the average path lengths are ${forest.Eh[0].toFixed(2)} and ${forest.Eh[1].toFixed(2)}; with c(64) = ${c64.toFixed(2)} the scores s = 2^(−E h / c) are ${forest.s[0].toFixed(2)} and ${forest.s[1].toFixed(2)}.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Путь изоляции выброса и центральной точки' : 'The isolation path of an outlier and of a central point'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'Слева три разреза отделяют выброс в правом верхнем углу; справа десять вложенных разрезов отделяют точку в центре облака.' : 'Left: three cuts separate the outlier in the upper right corner. Right: ten nested cuts separate a point in the middle of the cloud.'}</desc>
      {paths.map((path, k) => {
        const [bx, by, bw, bh] = L.boxes[k];
        const sx = scale([box[0], box[1]], [bx, bx + bw]), sy = scale([box[2], box[3]], [by + bh, by]);
        const fin = finals[k], tp = pts[targets[k]];
        return (
          <g>
            <text class="f-small" x={bx + bw / 2} y={by - 11} text-anchor="middle">{t.titles[k]}</text>
            <rect x={sx(fin[0])} y={sy(fin[3])} width={sx(fin[1]) - sx(fin[0])} height={sy(fin[2]) - sy(fin[3])} class="f-fill-amber" />
            <rect x={bx} y={by} width={bw} height={bh} class="f-grid" />
            {pts.map((p, j) => j !== targets[k] && <circle cx={sx(p[0]).toFixed(1)} cy={sy(p[1]).toFixed(1)} r="2.6" style="fill: var(--fig-blue); fill-opacity: .6" />)}
            {path.map((c, j) => {
              const d = c.q === 0 ? `M ${sx(c.p)} ${sy(c.box[2])} V ${sy(c.box[3])}` : `M ${sx(c.box[0])} ${sy(c.p)} H ${sx(c.box[1])}`;
              return <path class="f-line f-amber" d={d} style={`stroke-width: ${widths[k][j]}`} />;
            })}
            <circle cx={sx(tp[0])} cy={sy(tp[1])} r="5" style={`fill: var(--fig-${tones[k]}); stroke: var(--paper); stroke-width: 1.5`} />
            <text class="f-small f-t-muted" x={bx + bw / 2} y={by + bh + 20} text-anchor="middle">{t.foot[k]}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
