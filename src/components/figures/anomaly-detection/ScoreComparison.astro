---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { planted, gaussScore, knnScore, lofScore, iForest, averagePrecision } from './scores';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A dense cluster (120 points, sd 0.25), a sparse cluster (100 points, sd 1) and eight planted anomalies: two next to
// the dense cluster, six far from everything (seed 1). Four scores; each panel rings the eight highest-scoring points.
const { pts, lab } = planted(1);
const methods = [
  { s: gaussScore(pts), en: 'Gaussian (Mahalanobis)', ru: 'гауссиана (Махаланобис)', enShort: 'Gaussian', ruShort: 'гауссиана' },
  { s: knnScore(pts, 10), en: '10-NN distance', ru: 'расстояние до 10-го соседа', enShort: '10-NN distance', ruShort: 'до 10-го соседа' },
  { s: lofScore(pts, 10), en: 'LOF, k = 10', ru: 'LOF, k = 10', enShort: 'LOF, k = 10', ruShort: 'LOF, k = 10' },
  { s: iForest(pts, 100, 128, 7).s, en: 'isolation forest', ru: 'изолирующий лес', enShort: 'isolation forest', ruShort: 'изолирующий лес' },
].map((m) => {
  const top = m.s.map((_, i) => i).sort((a, b) => m.s[b] - m.s[a]).slice(0, 8);
  return { ...m, top, hits: top.filter((i) => lab[i]).length, ap: averagePrecision(m.s, lab) };
});
if (methods.map((m) => m.hits).join() !== '5,6,8,6') throw new Error('ScoreComparison: hit counts drifted from the note');
if (methods.map((m) => m.ap.toFixed(2)).join() !== '0.64,0.80,1.00,0.85') throw new Error('ScoreComparison: average precision drifted from the note');
const local = [220, 221];
if (!methods.every((m, k) => local.every((i) => m.top.includes(i)) === (k === 2))) throw new Error('ScoreComparison: only LOF should flag both local anomalies');

const dom = { x: [-3.8, 8.6] as [number, number], y: [-3.3, 7.2] as [number, number] };
const id = 'score-comparison';
const layouts = [
  { cls: 'fig-wide', short: false, W: 760, H: 236, boxes: [0, 1, 2, 3].map((i) => [12 + i * 188, 30, 172, 145.6]) },
  { cls: 'fig-narrow seq-narrow', short: true, W: 360, H: 420, boxes: [0, 1, 2, 3].map((i) => [6 + (i % 2) * 178, 30 + Math.floor(i / 2) * 206, 170, 144]) },
];
const of = ru ? 'из' : 'of';
---

<Figure
  id={id}
  title={ru ? 'Четыре оценки аномальности на одних данных' : 'Four anomaly scores on the same data'}
  caption={ru
    ? `Плотное облако (120 точек, стандартное отклонение 0.25), разреженное облако (100 точек, 1) и восемь подложенных аномалий (красные крестики): две рядом с плотным облаком, шесть вдали от всего. Кольца — восемь точек с наибольшей оценкой у каждого метода; подпись — сколько из них аномалии и средняя точность (AP) по всей выборке. Одна гауссиана растянута по диагонали через оба облака и пропускает аномалии, лежащие вдоль этой оси; расстояние до соседа и изолирующий лес отмечают края разреженного облака вместо двух локальных аномалий; LOF сравнивает плотность точки с плотностью её соседей и находит все восемь.`
    : `A dense cloud (120 points, standard deviation 0.25), a sparse cloud (100 points, 1) and eight planted anomalies (red crosses): two next to the dense cloud, six far from everything. Rings mark the eight highest-scoring points of each method; the label gives how many of them are anomalies and the average precision (AP) over the whole sample. A single Gaussian is stretched along the diagonal through both clouds and misses the anomalies that lie along that axis; the neighbour distance and the isolation forest flag the fringe of the sparse cloud instead of the two local anomalies; LOF compares a point's density with that of its neighbours and finds all eight.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Восемь точек с наибольшей оценкой для четырёх методов' : 'The eight top-scoring points for four methods'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? `Четыре панели с одними и теми же точками; найдено аномалий среди восьми отмеченных: ${methods.map((m) => m.hits).join(', ')}.` : `Four panels of the same points; anomalies among the eight flagged: ${methods.map((m) => m.hits).join(', ')}.`}</desc>
      {methods.map((m, k) => {
        const [bx, by, bw, bh] = L.boxes[k];
        const sx = scale(dom.x, [bx, bx + bw]), sy = scale(dom.y, [by + bh, by]);
        return (
          <g>
            <text class="f-small" x={bx + bw / 2} y={by - 10} text-anchor="middle">{L.short ? (ru ? m.ruShort : m.enShort) : (ru ? m.ru : m.en)}</text>
            <rect x={bx} y={by} width={bw} height={bh} class="f-grid" />
            {pts.map((p, i) => !lab[i] && <circle cx={sx(p[0]).toFixed(1)} cy={sy(p[1]).toFixed(1)} r="1.6" style="fill: var(--fig-blue); fill-opacity: .55" />)}
            {pts.map((p, i) => { const x = sx(p[0]), y = sy(p[1]); return lab[i] ? <path d={`M ${x - 3} ${y - 3} L ${x + 3} ${y + 3} M ${x - 3} ${y + 3} L ${x + 3} ${y - 3}`} class="f-thin f-red" style="stroke-width: 1.7" /> : null; })}
            {m.top.map((i) => <circle cx={sx(pts[i][0]).toFixed(1)} cy={sy(pts[i][1]).toFixed(1)} r="5.5" class="f-thin f-amber" style="stroke-width: 1.6" />)}
            <text class="f-small f-t-muted" x={bx + bw / 2} y={by + bh + 19} text-anchor="middle">{`${m.hits} ${of} 8 · AP ${m.ap.toFixed(2)}`}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
