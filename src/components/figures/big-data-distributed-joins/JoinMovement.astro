---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? "Три объёма полезной нагрузки" : "Three amounts of network payload";
const caption = ru ? "Для локального случая таблицы уже размещены совместимо. Другие строки используют четыре назначения и учебные объёмы из текста." : "The colocation case assumes the tables already share a compatible partitioner. The other rows use four destinations and the toy sizes in the text.";
const desc = ru ? "При совместном размещении объём нулевой. Broadcast каталога передаёт 180 МБ. Перераспределение обоих входов при равномерном хеше даёт 450 ГБ и 45 МБ." : "The payload is zero with colocated data, 180 MB for a catalogue broadcast, and 450 GB plus 45 MB when both inputs are repartitioned under the uniform assumption.";
const rows = ru
  ? [['Локальное', '0'], ['Broadcast', '180 МБ'], ['Перераспределение', '450 ГБ + 45 МБ']]
  : [['Colocated', '0'], ['Broadcast', '180 MB'], ['Repartition', '450 GB + 45 MB']];
---
<Figure id="bd-join-movement" title={title} caption={caption}>
  <svg viewBox="0 0 340 189" role="img" aria-labelledby="bd-join-movement-title bd-join-movement-desc" style="max-width: 550px; margin-inline: auto">
    <title id="bd-join-movement-title">{title}</title>
    <desc id="bd-join-movement-desc">{desc}</desc>
    {rows.map(([mode, payload], i) => (
      <g transform={`translate(0 ${i * 53})`}>
        <rect class={i === 2 ? 'f-fill-amber' : 'f-fill-blue'} x="10" y="15" width="320" height="43" rx="5" />
        <text class="f-label" x="24" y="42">{mode}</text>
        <text class="f-label" x="315" y="42" text-anchor="end">{payload}</text>
      </g>
    ))}
  </svg>
</Figure>
