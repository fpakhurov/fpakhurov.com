---
import Figure from '../Figure.astro';
import { standardPairs, apply, affine, panel, ellipsePath, type Mat, type Vec } from './cloud';

// Cholesky factor of Sigma = [[1, .5], [.5, 1]]: L Lᵀ = Sigma.
const l22 = Math.sqrt(0.75);
const L: Mat = [[1, 0], [0.5, l22]];
const I: Mat = [[1, 0], [0, 1]];
const mu: Vec = [1.5, 1];
const zero: Vec = [0, 0];
const z = standardPairs(220, 5);
// One example point, followed through both steps. |z*| = √5 > 2 puts it outside the 2σ contour in every panel,
// so its label stays clear of the curves.
const zStar: Vec = [2, 1];
const azStar = apply(L, zStar);
const xStar = affine(L, mu, zStar);

// Common data window for all three panels so the shift is visible.
const lo = -3.1;
const hi = 4.5;
const inWindow = (p: Vec) => p[0] >= lo && p[0] <= hi && p[1] >= lo && p[1] <= hi;

type Stage = { key: string; title: string; caption: string; a: Mat; m: Vec; dot: string; star: Vec };
const stages: Stage[] = [
  { key: 'z', title: 'standard noise', caption: 'Z ~ N(0, I)', a: I, m: zero, dot: 'f-solid-muted', star: zStar },
  { key: 'az', title: 'stretch and shear', caption: 'AZ ~ N(0, AAᵀ)', a: L, m: zero, dot: 'f-solid-blue', star: azStar },
  { key: 'x', title: 'shift', caption: 'μ + AZ ~ N(μ, Σ)', a: L, m: mu, dot: 'f-solid-red', star: xStar },
];

function build(u: number) {
  const map = panel(0, 0, u);
  return stages.map((s) => ({
    ...s,
    dots: z.map((p) => affine(s.a, s.m, p)).filter(inWindow).map((p) => [map.x(p[0]), map.y(p[1])]),
    one: ellipsePath(s.a, s.m, 1, map),
    two: ellipsePath(s.a, s.m, 2, map),
    sx: map.x(s.star[0]),
    sy: map.y(s.star[1]),
    frame: { x: map.x(lo), y: map.y(hi), w: map.len(hi - lo), h: map.len(hi - lo) },
    map,
  }));
}

const id = 'gaussian-distributions-sampling';
const wideU = 22;
const narrowU = 26;
const wide = build(wideU);
const narrow = build(narrowU);
// Wide: panels side by side. Narrow: stacked.
const wideAt = [[78, 150], [323, 150], [568, 150]];
const nFrame = narrowU * (hi - lo);
const nX = 180 - nFrame / 2 - narrowU * lo;
const nStep = nFrame + 150;
const narrowAt = [0, 1, 2].map((i) => [nX, 60 + narrowU * hi + i * nStep]);
const fmtN = (v: number) => v.toFixed(3).replace(/\.?0+$/, '');
---

<Figure
  id={id}
  title="Sampling any Gaussian from standard noise"
  caption="Independent standard normal pairs Z are multiplied by a matrix A with AAᵀ = Σ (here the Cholesky factor L of the running example's Σ = [[1, 0.5], [0.5, 1]]) and then shifted by μ = (1.5, 1). The amber point is one example point z = (2, 1) followed through both steps: it moves to Az = (2, 1.87) and then to μ + Az = (3.5, 2.87). Curves are 1σ and 2σ contours; all panels share the same window."
>
  {[{ cls: 'fig-wide', s: 'w', vb: '0 0 680 330', at: wideAt, data: wide, u: wideU }, { cls: 'fig-narrow', s: 'n', vb: `0 0 360 ${Math.round(narrowAt[2][1] - narrowU * lo + 185)}`, at: narrowAt, data: narrow, u: narrowU }].map((v) => (
    <svg class={v.cls} viewBox={v.vb} role="img" aria-labelledby={`${id}-${v.s}-t ${id}-${v.s}-d`}>
      <title id={`${id}-${v.s}-t`}>Three-step sampling pipeline: Z, then A Z, then μ + A Z</title>
      <desc id={`${id}-${v.s}-d`}>Three scatter plots in the same window. First, a round cloud of standard normal noise Z centred at the origin with circular 1-sigma and 2-sigma contours. An arrow labelled times A, stretch and shear, leads to the second panel, where the cloud A Z leans along the diagonal with elliptical contours; A is the Cholesky factor L with rows (1, 0) and (0.5, 0.866). An arrow labelled plus mu, shift, leads to the third panel, where the same tilted cloud is centred at mu = (1.5, 1), marked with a cross and an arrow from the origin. One highlighted example point moves from z = (2, 1) to A z = (2, 1.87) and then to μ + A z = (3.5, 2.87).</desc>
      {v.data.map((p, i) => (
        <g transform={`translate(${v.at[i][0]} ${v.at[i][1]})`}>
          <text class="f-title" x={(p.frame.x + p.frame.w / 2).toFixed(1)} y={p.frame.y - 34} text-anchor="middle">{p.title}</text>
          <rect class="f-grid" x={p.frame.x} y={p.frame.y} width={p.frame.w} height={p.frame.h} fill="none" />
          <line class="f-axis" x1={p.frame.x} x2={p.frame.x + p.frame.w} y1="0" y2="0" />
          <line class="f-axis" x1="0" x2="0" y1={p.frame.y} y2={p.frame.y + p.frame.h} />
          {p.dots.map(([x, y]) => <circle class={p.dot} cx={x} cy={y} r="1.8" fill-opacity="0.5" />)}
          <path class="f-line" d={p.one} />
          <path class="f-thin f-dash" d={p.two} />
          {p.key === 'x' && (
            <g>
              {/* Paper underlay keeps the μ arrow and cross readable on top of the dots */}
              <path d={`M 0 0 L ${p.map.x(mu[0]) - 5} ${p.map.y(mu[1]) + 3}`} stroke="var(--paper)" stroke-width="6" fill="none" stroke-linecap="round" />
              <path d={`M ${p.map.x(mu[0]) - 6} ${p.map.y(mu[1]) - 6} l 12 12 m 0 -12 l -12 12`} stroke="var(--paper)" stroke-width="6" fill="none" stroke-linecap="round" />
              <path class="f-line f-bold" d={`M 0 0 L ${p.map.x(mu[0]) - 5} ${p.map.y(mu[1]) + 3}`} marker-end="url(#f-arrow)" />
              <path class="f-line" d={`M ${p.map.x(mu[0]) - 6} ${p.map.y(mu[1]) - 6} l 12 12 m 0 -12 l -12 12`} />
              {/* μ label outside the 2σ ellipse, lower right, with a short leader to the cross */}
              <text class="f-math f-halo" x={p.map.x(3.45)} y={p.map.y(-1.15)}>μ</text>
              <path class="f-thin" d={`M ${p.map.x(3.4)} ${p.map.y(-0.75)} Q ${p.map.x(3.2)} ${p.map.y(0.4)} ${p.map.x(mu[0]) + 9} ${p.map.y(mu[1]) + 7}`} marker-end="url(#f-arrow)" />
            </g>
          )}
          {/* In the shifted panel the label sits above the point, clear of the 2σ contour (its top is at x₂ = 3) */}
          <circle cx={p.sx} cy={p.sy} r="5.5" fill="var(--fig-amber)" stroke="var(--paper)" stroke-width="1.5" />
          <text class="f-math f-t-amber f-halo" x={p.key === 'x' ? p.sx + 6 : p.sx + 9} y={p.key === 'x' ? p.sy - 14 : p.sy - 10} text-anchor={p.key === 'x' ? 'end' : 'start'}>{p.key === 'z' ? 'z' : p.key === 'az' ? 'Az' : 'μ + Az'}</text>
          <text class="f-math" x={(p.frame.x + p.frame.w / 2).toFixed(1)} y={p.frame.y + p.frame.h + 28} text-anchor="middle">{p.caption}</text>
        </g>
      ))}

      {v.s === 'w' ? (
        <g>
          {[0, 1].map((i) => {
            const x1 = v.at[i][0] + v.data[i].frame.x + v.data[i].frame.w + 8;
            const x2 = v.at[i + 1][0] + v.data[i + 1].frame.x - 8;
            const y = v.at[i][1] - 20;
            return (
              <g>
                <path class={`f-line ${i === 0 ? 'f-blue' : 'f-red'}`} d={`M ${x1} ${y} H ${x2}`} marker-end={`url(#f-arrow-${i === 0 ? 'blue' : 'red'})`} />
                <text class={`f-math f-upright ${i === 0 ? 'f-t-blue' : 'f-t-red'}`} x={(x1 + x2) / 2} y={y - 12} text-anchor="middle">{i === 0 ? '× A' : '+ μ'}</text>
              </g>
            );
          })}
        </g>
      ) : (
        <g>
          {[0, 1].map((i) => {
            const x = 180;
            const y1 = v.at[i][1] + v.data[i].frame.y + v.data[i].frame.h + 44;
            const y2 = v.at[i + 1][1] + v.data[i + 1].frame.y - 58;
            return (
              <g>
                <path class={`f-line ${i === 0 ? 'f-blue' : 'f-red'}`} d={`M ${x} ${y1} V ${y2}`} marker-end={`url(#f-arrow-${i === 0 ? 'blue' : 'red'})`} />
                <text class={`f-math f-upright ${i === 0 ? 'f-t-blue' : 'f-t-red'}`} x={x + 14} y={(y1 + y2) / 2 + 6}>{i === 0 ? '× A' : '+ μ'}</text>
              </g>
            );
          })}
        </g>
      )}

      {/* The matrix and the shift used in the figure */}
      <g transform={v.s === 'w' ? 'translate(340 292)' : `translate(180 ${v.at[2][1] - narrowU * lo + 80})`}>
        <g transform={v.s === 'w' ? '' : 'translate(92 0)'}>
          <text class="f-math" x="-150" y="6" text-anchor="end">A = L =</text>
          <path class="f-thin" d="M -136 -24 h -6 v 50 h 6 M -38 -24 h 6 v 50 h -6" />
          <text class="f-label" x="-112" y="-4" text-anchor="middle">1</text>
          <text class="f-label" x="-62" y="-4" text-anchor="middle">0</text>
          <text class="f-label" x="-112" y="18" text-anchor="middle">0.5</text>
          <text class="f-label" x="-62" y="18" text-anchor="middle">{fmtN(l22)}</text>
        </g>
        <text class="f-math" x="0" y={v.s === 'w' ? 6 : 64} text-anchor={v.s === 'w' ? 'start' : 'middle'}>μ = (1.5, 1)</text>
        <text class="f-note" x="0" y={v.s === 'w' ? 26 : 86} text-anchor={v.s === 'w' ? 'start' : 'middle'}>LLᵀ = Σ = [[1, 0.5], [0.5, 1]]</text>
      </g>
    </svg>
  ))}
</Figure>
