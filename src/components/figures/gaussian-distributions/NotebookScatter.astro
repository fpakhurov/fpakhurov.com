---
import Figure from '../Figure.astro';
import { scale, curve } from '../geometry';
import { standardPairs, type Vec } from './cloud';

// The notebook's first experiment: target P = N((−5, −5), I), fixed; model Q = N((0, 0), I) at initialization.
const raw = (mu: Vec, seed: number) =>
  standardPairs(400, seed).map(([a, b]) => ({
    p: [mu[0] + a, mu[1] + b] as Vec,
    // Colour intensity follows each cloud's own density, as plot_2d_dots(color=p(x)) and (color=q(x)) do with a colormap.
    o: (0.18 + 0.72 * Math.exp(-0.5 * (a * a + b * b))).toFixed(2),
  }));
const targetRaw = raw([-5, -5], 21);
const modelRaw = raw([0, 0], 22);
function layout(left: number, top: number, size: number) {
  const sx = scale([-10, 10], [left, left + size]);
  const sy = scale([-10, 10], [top + size, top]);
  const place = (pts: typeof targetRaw) => pts.map((d) => ({ x: sx(d.p[0]).toFixed(1), y: sy(d.p[1]).toFixed(1), o: d.o }));
  return { left, top, size, sx, sy, target: place(targetRaw), model: place(modelRaw) };
}
const wide = layout(54, 38, 320);
const narrow = layout(44, 40, 320);
const ticks = [-10, -5, 0, 5, 10];
const lab = (t: number) => (t < 0 ? `−${-t}` : `${t}`);
const id = 'gaussian-distributions-plot-2d-dots';
const tx = 404;
---

<Figure
  id={id}
  title="Target P and model Q before fitting"
  caption="400 samples each of the fixed target P = N((−5, −5), I) and of the trainable model Q, initialized at N(0, I), on the plot limits (−10, 10). Each dot is coloured by its own cloud’s density, p(x) for target samples and q(x) for model samples, so stronger colour means higher density."
>
  <svg class="fig-wide fig-medium" viewBox="0 0 600 412" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>Two Gaussian sample clouds plotted as dots</title>
    <desc id={`${id}-w-d`}>A square plot with both axes from −10 to 10. A red cloud of 400 dots is centred at (−5, −5), labelled target distribution P with mean (−5, −5), identity covariance and requires_grad False. A blue cloud of 400 dots is centred at the origin, labelled train distribution Q with mean (0, 0) and covariance L L transpose equal to the identity at initialization; its parameters have requires_grad True. Dots near each centre are drawn more intensely because their own density, p(x) for P and q(x) for Q, is higher.</desc>

    <rect class="f-grid" x={wide.left} y={wide.top} width={wide.size} height={wide.size} fill="none" />
    {ticks.map((t) => <line class="f-grid" x1={wide.sx(t)} x2={wide.sx(t)} y1={wide.top} y2={wide.top + wide.size} />)}
    {ticks.map((t) => <line class="f-grid" x1={wide.left} x2={wide.left + wide.size} y1={wide.sy(t)} y2={wide.sy(t)} />)}
    {ticks.map((t) => <text class="f-note" x={wide.sx(t)} y={wide.top + wide.size + 20} text-anchor="middle">{lab(t)}</text>)}
    {ticks.map((t) => <text class="f-note" x={wide.left - 8} y={wide.sy(t) + 5} text-anchor="end">{lab(t)}</text>)}

    {wide.target.map((p) => <circle class="f-solid-red" cx={p.x} cy={p.y} r="1.9" fill-opacity={p.o} />)}
    {wide.model.map((p) => <circle class="f-solid-blue" cx={p.x} cy={p.y} r="1.9" fill-opacity={p.o} />)}

    <text class="f-label f-t-blue f-title" x={tx} y="82">train distr Q</text>
    <text class="f-note" x={tx} y="104">μ = (0, 0), Σ = LLᵀ = I</text>
    <text class="f-note" x={tx} y="124">requires_grad=True:</text>
    <text class="f-note" x={tx} y="142">μ and L are trained</text>
    <path class="f-line f-blue" d={curve(tx - 8, 94, wide.sx(1.6), wide.sy(1.6), -26)} marker-end="url(#f-arrow-blue)" />

    <text class="f-label f-t-red f-title" x={tx} y="256">target distr P</text>
    <text class="f-note" x={tx} y="278">μ = (−5, −5), Σ = I</text>
    <text class="f-note" x={tx} y="298">requires_grad=False:</text>
    <text class="f-note" x={tx} y="316">fixed</text>
    <path class="f-line f-red" d={curve(tx - 8, 264, wide.sx(-3.2), wide.sy(-4.0), 30)} marker-end="url(#f-arrow-red)" />

    <text class="f-math" x={wide.left + wide.size / 2} y={wide.top + wide.size + 44} text-anchor="middle">x₁</text>
    <text class="f-math" x={wide.left - 8} y={wide.top - 16} text-anchor="end">x₂</text>
    <text class="f-note" x={tx} y="348">stronger colour = higher density:</text>
    <text class="f-note" x={tx} y="367">p(x) for P, q(x) for Q</text>
  </svg>
  <svg class="fig-narrow" viewBox="0 0 380 532" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>Two Gaussian sample clouds plotted as dots</title>
    <desc id={`${id}-n-d`}>A square plot with both axes from −10 to 10. A red cloud of 400 dots centred at (−5, −5) is the fixed target distribution P with identity covariance (requires_grad False). A blue cloud centred at the origin is the trainable distribution Q with covariance L L transpose equal to the identity at initialization (requires_grad True). Dots near each centre are drawn more intensely, following p(x) for P and q(x) for Q.</desc>
    <rect class="f-grid" x={narrow.left} y={narrow.top} width={narrow.size} height={narrow.size} fill="none" />
    {ticks.map((t) => <line class="f-grid" x1={narrow.sx(t)} x2={narrow.sx(t)} y1={narrow.top} y2={narrow.top + narrow.size} />)}
    {ticks.map((t) => <line class="f-grid" x1={narrow.left} x2={narrow.left + narrow.size} y1={narrow.sy(t)} y2={narrow.sy(t)} />)}
    {ticks.map((t) => <text class="f-note" x={narrow.sx(t)} y={narrow.top + narrow.size + 20} text-anchor="middle">{lab(t)}</text>)}
    {ticks.map((t) => <text class="f-note" x={narrow.left - 8} y={narrow.sy(t) + 5} text-anchor="end">{lab(t)}</text>)}
    {narrow.target.map((p) => <circle class="f-solid-red" cx={p.x} cy={p.y} r="1.9" fill-opacity={p.o} />)}
    {narrow.model.map((p) => <circle class="f-solid-blue" cx={p.x} cy={p.y} r="1.9" fill-opacity={p.o} />)}

    <text class="f-label f-t-red f-title" x="14" y="432">target distr P</text>
    <text class="f-note" x="14" y="454">μ = (−5, −5), Σ = I</text>
    <text class="f-note" x="14" y="474">requires_grad=False:</text>
    <text class="f-note" x="14" y="492">fixed</text>
    <path class="f-line f-red" d={curve(92, 416, narrow.sx(-5.6), narrow.sy(-7.2), -14)} marker-end="url(#f-arrow-red)" />

    <text class="f-label f-t-blue f-title" x="200" y="432">train distr Q</text>
    <text class="f-note" x="200" y="454">μ = (0, 0), Σ = LLᵀ = I</text>
    <text class="f-note" x="200" y="474">requires_grad=True:</text>
    <text class="f-note" x="200" y="492">μ and L are trained</text>
    <path class="f-line f-blue" d={curve(248, 416, narrow.sx(1.0), narrow.sy(-1.6), 16)} marker-end="url(#f-arrow-blue)" />

    <text class="f-math" x={narrow.left + narrow.size / 2} y={narrow.top + narrow.size + 44} text-anchor="middle">x₁</text>
    <text class="f-math" x={narrow.left - 8} y={narrow.top - 16} text-anchor="end">x₂</text>
    <text class="f-note" x="190" y="522" text-anchor="middle">stronger colour = higher density: p(x) for P, q(x) for Q</text>
  </svg>
</Figure>
