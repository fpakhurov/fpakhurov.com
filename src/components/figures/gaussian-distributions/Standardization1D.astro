---
import Figure from '../Figure.astro';
import { plot, area, scale, curve, gaussian } from '../geometry';

const mu = 2;
const sigma = 1.5;
const zStar = 1;
const xStar = mu + sigma * zStar;

const standard = (x: number) => gaussian(x, 0, 1);
const target = (x: number) => gaussian(x, mu, sigma);
const hSigma = target(mu + sigma);

// Wide: labels beside the curves. Narrow: fewer ticks, curve labels stacked above the plot.
function layout(left: number, right: number, top: number, bottom: number, x0: number, x1: number, ticks: number[]) {
  const sx = scale([x0, x1], [left, right]);
  const sy = scale([0, 0.42], [bottom, top]);
  return {
    left, right, top, bottom, sx, sy, ticks,
    standardPath: plot(standard, Math.max(x0, -4), 4, sx, sy, 200),
    targetPath: plot(target, Math.max(x0, -2.6), x1, sx, sy, 200),
    targetArea: area(target, Math.max(x0, -2.6), x1, sx, sy, 200),
  };
}
const w = layout(40, 570, 40, 230, -4, 7.5, [-3, -2, -1, 0, 1, 2, 3, 4, 5, 6, 7]);
const n = layout(22, 338, 82, 262, -3.4, 7.4, [-2, 0, 2, 4, 6]);
const lab = (t: number) => (t < 0 ? `−${-t}` : `${t}`);
const id = 'gaussian-distributions-standardization';
---

<Figure
  id={id}
  title="Standardization and its inverse in one dimension"
  caption="The point z = 1 of the standard normal maps to x = μ + σz = 3.5 for μ = 2, σ = 1.5; dividing (x − μ) by σ maps it back. Both points sit one standard deviation above their own mean."
>
  {[{ v: w, cls: 'fig-wide fig-medium', s: 'w', vb: '0 0 600 315' }, { v: n, cls: 'fig-narrow', s: 'n', vb: '0 0 360 356' }].map(({ v, cls, s, vb }) => (
    <svg class={cls} viewBox={vb} role="img" aria-labelledby={`${id}-${s}-t ${id}-${s}-d`}>
      <title id={`${id}-${s}-t`}>Standard normal density and a shifted, stretched normal density</title>
      <desc id={`${id}-${s}-d`}>Two bell curves on one axis. The taller grey curve is the standard normal Z ~ N(0, 1), centred at 0. The lower, wider red curve is X ~ N(2, 1.5²), centred at mu = 2 with a horizontal arrow of length sigma = 1.5 drawn at the inflection height. The point z = 1 on the axis is connected by a curved arrow labelled X = mu + sigma Z to the point x = 3.5, and a second arrow below the axis labelled Z = (X − mu) / sigma goes back.</desc>

      <path class="f-fill-red" d={v.targetArea} />
      <path class="f-line f-red f-bold" d={v.targetPath} />
      <path class="f-line f-muted f-bold" d={v.standardPath} />

      <path class="f-axis" d={`M ${v.left} ${v.bottom} H ${v.right + 16}`} marker-end="url(#f-arrow-muted)" />
      {v.ticks.map((t) => <line class="f-axis" x1={v.sx(t)} x2={v.sx(t)} y1={v.bottom} y2={v.bottom + 5} />)}
      {v.ticks.map((t) => <text class="f-note" x={v.sx(t)} y={v.bottom + 22} text-anchor="middle">{lab(t)}</text>)}

      {s === 'w' ? (
        <g>
          <text class="f-math f-t-muted" x={v.sx(-0.55)} y={v.sy(0.395)} text-anchor="end">Z ~ N(0, 1)</text>
          <text class="f-math f-t-red" x={v.sx(4.3)} y={v.sy(0.255)}>X ~ N(μ, σ²)</text>
          <text class="f-note" x={v.sx(4.3)} y={v.sy(0.255) + 22}>μ = 2, σ = 1.5</text>
        </g>
      ) : (
        <g>
          <text class="f-math f-t-muted" x="22" y="24">Z ~ N(0, 1)</text>
          <text class="f-math f-t-red" x="22" y="52">X ~ N(μ, σ²)</text>
          <text class="f-note" x="136" y="52">μ = 2, σ = 1.5</text>
        </g>
      )}

      {/* mean and sigma of X */}
      <line class="f-thin f-red f-dash" x1={v.sx(mu)} x2={v.sx(mu)} y1={v.bottom} y2={v.sy(target(mu)) - 4} />
      <text class="f-math f-t-red" x={v.sx(mu) + 6} y={v.sy(target(mu)) - 8}>μ</text>
      <path class="f-thin f-red" d={`M ${v.sx(mu) + 3} ${v.sy(hSigma)} H ${v.sx(mu + sigma) - 2}`} marker-end="url(#f-arrow-red)" />
      <text class="f-math f-t-red f-halo" x={(v.sx(mu) + v.sx(mu + sigma)) / 2} y={v.sy(hSigma) - 8} text-anchor="middle">σ</text>

      {/* the mapped point */}
      <circle class="f-solid-muted" cx={v.sx(zStar)} cy={v.bottom} r="5" />
      <circle class="f-solid-red" cx={v.sx(xStar)} cy={v.bottom} r="5" />
      <path class="f-line f-blue" d={curve(v.sx(zStar) + 4, v.bottom - 9, v.sx(xStar) - 4, v.bottom - 9, s === 'w' ? -40 : -30)} marker-end="url(#f-arrow-blue)" />
      {s === 'w' ? (
        <g>
          <text class="f-math f-t-blue f-halo" x={v.sx(4.5)} y={v.bottom - 60}>X = μ + σZ</text>
          <path class="f-thin f-blue" d={curve(v.sx(4.45), v.bottom - 66, v.sx(2.6), v.bottom - 30, -14)} marker-end="url(#f-arrow-blue)" />
        </g>
      ) : (
        <g>
          <text class="f-math f-t-blue f-halo" x="350" y={v.bottom - 74} text-anchor="end">X = μ + σZ</text>
          <path class="f-thin f-blue" d={curve(300, v.bottom - 66, v.sx(2.55), v.bottom - 26, -12)} marker-end="url(#f-arrow-blue)" />
        </g>
      )}
      <path class="f-line f-amber" d={curve(v.sx(xStar) - 4, v.bottom + 32, v.sx(zStar) + 4, v.bottom + 32, s === 'w' ? -18 : -14)} marker-end="url(#f-arrow-amber)" />
      <text class="f-math f-t-amber" x={(v.sx(zStar) + v.sx(xStar)) / 2} y={v.bottom + 74} text-anchor="middle">Z = (X − μ) / σ</text>
    </svg>
  ))}
</Figure>
