---
import Figure from '../Figure.astro';
import { standardPairs, apply, panel, ellipsePath, bracePath, type Mat, type Vec } from './cloud';

// Same standard-normal draws for both clouds, so the right cloud is the left one rotated by 45°.
const z = standardPairs(260, 11);
const s1 = Math.sqrt(1.5);
const s2 = Math.sqrt(0.5);
const c = Math.SQRT1_2;
// Left: independent coordinates, Sigma = diag(1.5, 0.5).
const aLeft: Mat = [[s1, 0], [0, s2]];
// Right: A = Q Lambda^(1/2) with eigenvectors (1, 1)/√2 (λ = 1.5) and (−1, 1)/√2 (λ = 0.5); A Aᵀ = [[1, .5], [.5, 1]].
const aRight: Mat = [[c * s1, -c * s2], [c * s1, c * s2]];
const origin: Vec = [0, 0];
const u = 40;
const limit = 2.85;
const inside = (p: Vec) => Math.abs(p[0]) <= limit && Math.abs(p[1]) <= limit;
const local = panel(0, 0, u);

// Keep a draw only if it fits both panels, so the displayed clouds really are rotations of each other.
const kept = z.filter((p) => inside(apply(aLeft, p)) && inside(apply(aRight, p)));

// cov = A Aᵀ. The 1σ ellipse touches x₁ = ±√Σ11 at x₂ = ±Σ12/√Σ11, and x₂ = ±√Σ22 at x₁ = ±Σ12/√Σ22.
const make = (a: Mat) => {
  const s11 = a[0][0] ** 2 + a[0][1] ** 2;
  const s22 = a[1][0] ** 2 + a[1][1] ** 2;
  const s12 = a[0][0] * a[1][0] + a[0][1] * a[1][1];
  const sd1 = Math.sqrt(s11);
  const sd2 = Math.sqrt(s22);
  return {
  dots: kept.map((p) => apply(a, p)).map((p) => [local.x(p[0]), local.y(p[1])]),
  one: ellipsePath(a, origin, 1, local),
  two: ellipsePath(a, origin, 2, local),
  // 1σ and 2σ labels sit just outside each ellipse at 45° in z-space.
  oneAt: apply(a, [Math.cos(Math.PI / 4) * 1.02, Math.sin(Math.PI / 4) * 1.02]),
  twoAt: apply(a, [Math.cos(Math.PI / 4) * 2.02, Math.sin(Math.PI / 4) * 2.02]),
  sd1: local.len(sd1),
  sd2: local.len(sd2),
  // Tangent points of the 1σ ellipse: (x, y) for the x₁ extremes and the x₂ extremes (positive side).
  t1: [local.len(sd1), local.len(s12 / sd1)],
  t2: [local.len(s12 / sd2), local.len(sd2)],
  };
};
const left = make(aLeft);
const right = make(aRight);

// Eigenvector semi-axes of the 1σ ellipse on the right.
const major = apply(aRight, [1, 0]);
const minor = apply(aRight, [0, 1]);

const braceY = local.len(2.9);
const braceX = -local.len(3.0);
const axisNeg = local.len(2.7);
const axisPos = local.len(3.2);

const panels = [
  { key: 'indep', data: left, title: 'Variances only', sub: 'Cov(X₁, X₂) = 0', v1: '√1.5', v2: '√0.5', eigen: false },
  { key: 'corr', data: right, title: 'With covariance', sub: 'Cov(X₁, X₂) = 0.5', v1: '1', v2: '1', eigen: true },
];

const variants = [
  { cls: 'fig-wide', suffix: 'w', width: 680, height: 355, at: [[195, 195], [535, 195]] },
  { cls: 'fig-narrow', suffix: 'n', width: 360, height: 727, at: [[195, 195], [195, 567]] },
];
const id = 'gaussian-distributions-clouds';
---

<Figure
  id={id}
  title="A diagonal matrix only stretches along the axes; covariance tilts the cloud"
  caption="Both clouds are drawn from the same standard-normal pairs (260, minus the few that fall outside either window). Left: Σ = diag(1.5, 0.5), independent coordinates, so the spread is described by Var(X₁) and Var(X₂) alone. Right: Σ = [[1, 0.5], [0.5, 1]], the running example. Its eigenvalues are 1.5 and 0.5, so it is the left cloud rotated by 45°. Its variances along the axes are both 1, and only the off-diagonal entry records the tilt. Braces span ±1 standard deviation, ±√Var, and dashed guides drop to them from where the 1σ ellipse touches its extremes; solid and dashed curves are the 1σ and 2σ ellipses."
  origin="expanded"
>
  {variants.map((v) => (
    <svg class={v.cls} viewBox={`0 0 ${v.width} ${v.height}`} role="img" aria-labelledby={`${id}-${v.suffix}-t ${id}-${v.suffix}-d`}>
      <title id={`${id}-${v.suffix}-t`}>Axis-aligned Gaussian cloud next to a tilted, correlated cloud</title>
      <desc id={`${id}-${v.suffix}-d`}>Two scatter plots of 2-D Gaussian samples with their 1-sigma and 2-sigma ellipses. The left cloud has covariance diag(1.5, 0.5): it is wider than tall and aligned with the axes. Braces under the horizontal axis and beside the vertical axis mark the spreads, each spanning plus and minus one standard deviation and labelled plus or minus the square root of Var(X1) = 1.5 and of Var(X2) = 0.5. The right cloud has covariance with unit variances and covariance 0.5. It leans along the diagonal x1 = x2. Its braces span plus and minus 1 along both axes, because Var(X1) = Var(X2) = 1, the same as for an untilted circle. Arrows along the eigenvectors show the semi-axes of the 1-sigma ellipse, of lengths square root of 1.5 along the diagonal and square root of 0.5 across it.</desc>
      {panels.map((p, i) => (
        <g transform={`translate(${v.at[i][0]} ${v.at[i][1]})`}>
          <text class="f-title" x="0" y="-178" text-anchor="middle">{p.title}</text>
          <text class="f-note" x="0" y="-158" text-anchor="middle">{p.sub}</text>

          <path class="f-axis" d={`M ${-axisNeg} 0 H ${axisPos}`} marker-end="url(#f-arrow-muted)" />
          <path class="f-axis" d={`M 0 ${axisNeg} V ${-axisPos}`} marker-end="url(#f-arrow-muted)" />
          <text class="f-math" x={axisPos - 2} y="24" text-anchor="end">x₁</text>
          <text class="f-math" x="10" y={-axisPos + 8}>x₂</text>

          {p.data.dots.map(([x, y]) => <circle class="f-solid-blue" cx={x} cy={y} r="2.1" fill-opacity="0.42" />)}
          <path class="f-line" d={p.data.one} />
          <path class="f-thin f-dash" d={p.data.two} />
          <text class="f-small f-halo" x={local.x(p.data.oneAt[0]) + 4} y={local.y(p.data.oneAt[1]) - 4}>1σ</text>
          <text class="f-small f-halo" x={local.x(p.data.twoAt[0]) + 4} y={local.y(p.data.twoAt[1]) - 4}>2σ</text>

          {/* Spread along x1: dashed guides from the 1σ ellipse's tangent points down to the brace */}
          <line class="f-grid f-dash" x1={-p.data.t1[0]} x2={-p.data.t1[0]} y1={p.data.t1[1]} y2={braceY - 2} />
          <line class="f-grid f-dash" x1={p.data.t1[0]} x2={p.data.t1[0]} y1={-p.data.t1[1]} y2={braceY - 2} />
          <path class="f-thin f-red" d={bracePath(p.data.sd1, braceY, -p.data.sd1, braceY, 10)} />
          <text class="f-label f-t-red" x="0" y={braceY + 30} text-anchor="middle">±√Var(X₁) = ±{p.v1}</text>

          {/* Spread along x2 */}
          <line class="f-grid f-dash" x1={braceX + 2} x2={p.data.t2[0]} y1={-p.data.t2[1]} y2={-p.data.t2[1]} />
          <line class="f-grid f-dash" x1={braceX + 2} x2={-p.data.t2[0]} y1={p.data.t2[1]} y2={p.data.t2[1]} />
          <path class="f-thin f-red" d={bracePath(braceX, p.data.sd2, braceX, -p.data.sd2, 10)} />
          <text class="f-label f-t-red" x={braceX - 16} y="-3" text-anchor="end">±√Var(X₂)</text>
          <text class="f-label f-t-red" x={braceX - 16} y="17" text-anchor="end">= ±{p.v2}</text>

          {p.eigen && (
            <g>
              <line class="f-thin f-dot" x1={local.x(-2.6)} y1={local.y(-2.6)} x2={local.x(2.75)} y2={local.y(2.75)} />
              <text class="f-note f-halo" x={local.x(2.05)} y={local.y(2.75)} text-anchor="end">x₁ = x₂</text>
              <path class="f-line f-bold" d={`M 0 0 L ${local.x(major[0])} ${local.y(major[1])}`} marker-end="url(#f-arrow)" />
              <path class="f-line f-bold" d={`M 0 0 L ${local.x(minor[0])} ${local.y(minor[1])}`} marker-end="url(#f-arrow)" />
              {/* √1.5 sits outside the 2σ ellipse, lower right, with a leader to the major semi-axis */}
              <text class="f-math f-halo" x="86" y="54">√1.5</text>
              <path class="f-thin" d={`M 82 42 Q 58 12 ${local.x(major[0] / 2) + 5} ${local.y(major[1] / 2) + 4}`} marker-end="url(#f-arrow)" />
              <text class="f-math f-halo" x="-74" y="-66" text-anchor="end">√0.5</text>
              {/* Leader stops beside the middle of the minor semi-axis, clear of its arrowhead */}
              <path class="f-thin" d={`M -72 -60 Q -56 -14 ${local.x(minor[0] / 2) - 7} ${local.y(minor[1] / 2) + 3}`} marker-end="url(#f-arrow)" />
            </g>
          )}
        </g>
      ))}
    </svg>
  ))}
</Figure>
