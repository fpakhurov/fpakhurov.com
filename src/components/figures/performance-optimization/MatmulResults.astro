---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One run on an Apple M1 (macOS 26.5, Apple clang 21.0.0), n = 1024 doubles, one thread, the minimum of five
// timings per version (the Code section prints them). GFLOP/s = 2 n^3 / t; the printed rates use the unrounded time.
const n = 1024;
const rows = [
  { name: 'i, j, k', flag: '-O0', t: 3.871, rate: 0.55, tone: 'muted' },
  { name: 'i, k, j', flag: '-O0', t: 1.385, rate: 1.55, tone: 'muted' },
  { name: ru ? 'блоки' : 'blocked', flag: '-O0', t: 1.55, rate: 1.39, tone: 'muted' },
  { name: 'i, j, k', flag: '-O2', t: 1.39, rate: 1.54, tone: 'blue' },
  { name: 'i, k, j', flag: '-O2', t: 0.175, rate: 12.29, tone: 'blue' },
  { name: ru ? 'блоки' : 'blocked', flag: '-O2', t: 0.147, rate: 14.57, tone: 'blue' },
  { name: 'Accelerate dgemm', flag: '', t: 0.0084, rate: 255.5, tone: 'amber' },
];
for (const r of rows) {
  const g = (2 * n ** 3) / r.t / 1e9;
  if (Math.abs(g / r.rate - 1) > 0.01) throw new Error(`${r.name} ${r.flag}: ${g} vs ${r.rate}`);
}
const speedup = rows[0].t / rows[5].t;
if (speedup.toFixed(1) !== '26.3') throw new Error(`overall ${speedup}`);
const lx: [number, number] = [Math.log10(0.3), Math.log10(400)];
const ticks = [1, 10, 100];

interface Layout { cls: string; W: number; H: number; x0: number; x1: number; ys: number[]; bh: number; labelX: number; labelDy: number; anchor: 'end' | 'start'; axisY: number }
const wideYs = [20, 50, 80, 124, 154, 184, 228];
const narrowYs = [30, 76, 122, 180, 226, 272, 330];
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 310, x0: 210, x1: 680, ys: wideYs, bh: 20, labelX: 198, labelDy: 15, anchor: 'end', axisY: 262 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 420, x0: 14, x1: 290, ys: narrowYs, bh: 18, labelX: 14, labelDy: -6, anchor: 'start', axisY: 366 },
];
const label = (r: (typeof rows)[number]) => (r.flag ? `${r.name}, ${r.flag}` : r.name);
const shown = rows.map((r) => r.rate.toFixed(r.rate >= 100 ? 1 : 2));
const id = 'matmul-results';
---

<Figure
  id={id}
  title={ru ? 'Скорость умножения матриц 1024 × 1024 на одном ядре Apple M1' : 'Speed of a 1024 × 1024 matrix product on one core of an Apple M1'}
  caption={ru
    ? `Миллиарды операций с плавающей точкой в секунду (2n³ / t) для трёх вариантов цикла из этой заметки при -O0 и -O2 и для dgemm из Apple Accelerate на той же машине. Один прогон: Apple M1, macOS 26.5, Apple clang 21.0.0, n = 1024, числа double, лучшее из пяти измерений. Шкала логарифмическая. Перестановка циклов и -O2 вместе ускоряют вариант i, j, k в ${(rows[0].t / rows[4].t).toFixed(1)} раза, блоки ускоряют его ещё в ${(rows[4].t / rows[5].t).toFixed(2)} раза, всего в ${speedup.toFixed(1)} раза; библиотека быстрее лучшего варианта ещё в ${(rows[5].t / rows[6].t).toFixed(0)} раз. На загруженной машине времена меняются от прогона к прогону на 10–20%.`
    : `Billions of floating-point operations per second (2n³ / t) for the three loop versions of this note at -O0 and -O2, and for dgemm from Apple's Accelerate library on the same machine. One run: Apple M1, macOS 26.5, Apple clang 21.0.0, n = 1024, doubles, the best of five timings. The scale is logarithmic. Loop interchange and -O2 together make the i, j, k version ${(rows[0].t / rows[4].t).toFixed(1)} times faster, blocking adds a factor of ${(rows[4].t / rows[5].t).toFixed(2)}, ${speedup.toFixed(1)} in all; the library is another ${(rows[5].t / rows[6].t).toFixed(0)} times faster than the best loop. On a busy machine the times vary by 10–20 % from run to run.`}
>
  {layouts.map((L) => {
    const sx = scale(lx, [L.x0, L.x1]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Производительность семи вариантов умножения матриц в GFLOP/с' : 'GFLOP/s of seven versions of matrix multiplication'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Горизонтальные полосы на логарифмической шкале. При -O0: i, j, k 0.55, i, k, j 1.55, блоки 1.39 GFLOP/с. При -O2: i, j, k 1.54, i, k, j 12.29, блоки 14.57. Accelerate dgemm: 255.5.'
          : 'Horizontal bars on a logarithmic scale. At -O0: i, j, k 0.55, i, k, j 1.55, blocked 1.39 GFLOP/s. At -O2: i, j, k 1.54, i, k, j 12.29, blocked 14.57. Accelerate dgemm: 255.5.'}</desc>
        {ticks.map((v) => (
          <g>
            <path class="f-grid" d={`M ${sx(Math.log10(v))} ${L.ys[0] - 12} V ${L.axisY}`} />
            <path class="f-axis" d={`M ${sx(Math.log10(v))} ${L.axisY} v 5`} />
            <text class="f-note" x={sx(Math.log10(v))} y={L.axisY + 21} text-anchor="middle">{v}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${L.x0} ${L.axisY} H ${L.x1}`} />
        <text class="f-note" x={L.x1} y={L.axisY + 40} text-anchor="end">{ru ? 'GFLOP/с, логарифмическая шкала' : 'GFLOP/s, log scale'}</text>
        {rows.map((r, k) => {
          const y = L.ys[k];
          const xe = sx(Math.log10(r.rate));
          return (
            <g>
              <rect class={`f-fill-${r.tone === 'muted' ? 'paper' : r.tone}`} x={L.x0} y={y} width={xe - L.x0} height={L.bh} style={r.tone === 'muted' ? 'fill: var(--muted); fill-opacity: 0.22' : 'fill-opacity: 0.35'} />
              <rect class={`f-thin f-${r.tone}`} x={L.x0} y={y} width={xe - L.x0} height={L.bh} fill="none" />
              <text class="f-small" x={L.labelX} y={y + L.labelDy} text-anchor={L.anchor}>{label(r)}</text>
              <text class="f-small" x={xe + 6} y={y + L.bh / 2 + 4.5}>{shown[k]}</text>
            </g>
          );
        })}
      </svg>
    );
  })}
</Figure>
