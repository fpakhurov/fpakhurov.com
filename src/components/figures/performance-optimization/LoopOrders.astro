---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Toy matrices: n = 8, stored row by row, with 4 elements per cache line (a row is two lines).
// For each loop order, the cells the innermost loop touches in one pass, and the cache lines they lie in.
const n = 8, per = 4, b = 4;
type Cell = [number, number];
interface Panel { C: Cell[]; A: Cell[]; B: Cell[]; arrow: { A?: 'right' | 'down'; B?: 'right' | 'down'; C?: 'right' | 'down' } }
const range = (k: number, s = 0) => Array.from({ length: k }, (_, i) => s + i);
const i0 = 2, j0 = 5, k0 = 3;
const blk = (r0: number, c0: number) => range(b, r0).flatMap((r) => range(b, c0).map((c) => [r, c] as Cell));
const panels: Panel[] = [
  // i, j, k: C[i][j] += A[i][k] * B[k][j] over k: a row of A, a column of B, one element of C
  { C: [[i0, j0]], A: range(n).map((k) => [i0, k] as Cell), B: range(n).map((k) => [k, j0] as Cell), arrow: { A: 'right', B: 'down' } },
  // i, k, j: over j: one element of A (held in a register), a row of B, a row of C
  { C: range(n).map((j) => [i0, j] as Cell), A: [[i0, k0]], B: range(n).map((j) => [k0, j] as Cell), arrow: { B: 'right', C: 'right' } },
  // blocked: i, k, j inside b x b blocks
  { C: blk(4, 0), A: blk(4, 4), B: blk(4, 0), arrow: {} },
];
// cache lines touched per multiply-add in one pass of the inner loop, if nothing was in the cache before
const lineOf = ([r, c]: Cell) => `${r}:${Math.floor(c / per)}`;
const linesPer = (cells: Cell[], macs: number) => new Set(cells.map(lineOf)).size / macs;
const ijk = { A: linesPer(panels[0].A, n), B: linesPer(panels[0].B, n) };
const ikj = { B: linesPer(panels[1].B, n), C: linesPer(panels[1].C, n) };
if (ijk.A !== 1 / per || ijk.B !== 1 || ikj.B !== 1 / per || ikj.C !== 1 / per) throw new Error(`line counts ${JSON.stringify([ijk, ikj])}`);
// blocked: three b x b blocks are loaded once (b*b/per lines each) and used for b^3 multiply-adds
const blockedPer = (3 * (b * b) / per) / b ** 3;
if (blockedPer !== 3 / (per * b)) throw new Error(`blocked ${blockedPer}`);

const t = ru
  ? {
      names: ['i, j, k', 'i, k, j', 'блоки'],
      notes: [
        ['внутренний цикл по k:', 'A по строке, B по столбцу;', 'каждый шаг — новая строка кэша B'],
        ['внутренний цикл по j:', 'B и C по строкам;', 'новая строка кэша раз в 4 шага'],
        ['i, k, j внутри блоков b × b:', 'три блока остаются в кэше;', 'строка кэша используется b раз'],
      ],
      steps: ['i, j, k: столбец B даёт промах на каждом шаге', 'i, k, j: B и C читаются подряд, один промах на 4 шага', 'блоки: три блока b × b остаются в кэше и используются b раз'],
    }
  : {
      names: ['i, j, k', 'i, k, j', 'blocked'],
      notes: [
        ['inner loop over k:', 'A along a row, B down a column;', 'every step needs a new line of B'],
        ['inner loop over j:', 'B and C along rows;', 'a new line once every 4 steps'],
        ['i, k, j inside b × b blocks:', 'the three blocks stay cached;', 'each cached line is used b times'],
      ],
      steps: ['i, j, k: the column of B misses on every step', 'i, k, j: B and C are read in order, one miss per 4 steps', 'blocks: three b × b blocks stay in the cache and are reused b times'],
    };

interface Layout {
  cls: string; W: number; H: number; cell: number;
  rowY: number[]; gridY: number; mx: [number, number, number]; opX: [number, number];
  nameAt: [number, number]; noteAt: [number, number]; noteDy: number; badge: [number, number];
}
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 444, cell: 12, rowY: [10, 154, 298], gridY: 22, mx: [156, 286, 416], opX: [271, 401],
    nameAt: [36, 48], noteAt: [536, 52], noteDy: 20, badge: [18, 43] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 606, cell: 10, rowY: [8, 208, 408], gridY: 38, mx: [28, 140, 252], opX: [124, 236],
    nameAt: [36, 21], noteAt: [180, 158], noteDy: 17, badge: [18, 16] },
];
const id = 'loop-orders';
const mat = ['C', 'A', 'B'] as const;
const tone = { C: 'red', A: 'green', B: 'green' } as const;
---

<Figure
  id={id}
  title={ru ? 'К каким элементам обращается внутренний цикл умножения матриц' : 'What the inner loop of a matrix product touches'}
  caption={ru
    ? `Игрушечные матрицы 8 × 8, хранящиеся по строкам, по 4 элемента в строке кэша (контуры). Для каждого порядка циклов закрашены элементы, к которым внутренний цикл обращается за один проход: красным — результат C, зелёным — входы A и B. В порядке i, j, k (1) столбец B лежит в 8 разных строках кэша, и из каждой используется один элемент из четырёх: если кэш не удерживает столбец, каждый шаг даёт промах. В порядке i, k, j (2) A[i][k] держится в регистре, а B и C читаются подряд: одна новая строка кэша на 4 шага. В блочном варианте (3) три блока b × b (здесь b = 4) загружаются один раз и используются b раз каждый: 3/(4b) = ${blockedPer.toFixed(3)} новых строк на умножение-сложение. На M1 в строке кэша 16 чисел double, поэтому дроби 1/4 становятся 1/16.`
    : `Toy 8 × 8 matrices stored row by row, with 4 elements per cache line (the outlines). For each loop order, the shaded cells are the ones the inner loop touches in one pass: red for the result C, green for the inputs A and B. In the order i, j, k (1) the column of B lies in 8 different cache lines, and only one element of each four is used: unless the cache keeps the column, every step is a miss. In the order i, k, j (2) A[i][k] sits in a register while B and C are read in order: one new cache line every 4 steps. Blocked (3), three b × b blocks (here b = 4) are loaded once and used b times each, 3/(4b) = ${blockedPer.toFixed(3)} new lines per multiply-add. On the M1 a cache line holds 16 doubles, so the fractions 1/4 become 1/16.`}
>
  {layouts.map((L) => {
    const g = n * L.cell;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Доступ к памяти в трёх вариантах умножения матриц' : 'Memory access of three versions of matrix multiplication'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Три ряда, в каждом три сетки 8 на 8: C равно A умножить на B. В первом ряду закрашены одна клетка C, строка A и столбец B, каждая клетка столбца B лежит в отдельной строке кэша. Во втором ряду закрашены одна клетка A, строка B и строка C. В третьем ряду закрашены по одному блоку 4 на 4 в каждой матрице.'
          : 'Three rows, each with three 8 by 8 grids: C equals A times B. In the first row one cell of C, a row of A and a column of B are shaded, and each cell of the column of B lies in its own cache line. In the second row one cell of A, a row of B and a row of C are shaded. In the third row one 4 by 4 block of each matrix is shaded.'}</desc>
        {panels.map((P, p) => {
          const y0 = L.rowY[p] + L.gridY;
          const mxOf = { C: L.mx[0], A: L.mx[1], B: L.mx[2] };
          return (
            <g data-s={String(p + 1)}>
              <Badge x={L.badge[0]} y={L.rowY[p] + L.badge[1]} n={p + 1} />
              <text class="f-label" x={L.nameAt[0]} y={L.rowY[p] + L.nameAt[1]} style="font-weight: 650">{t.names[p]}</text>
              {mat.map((m) => {
                const x0 = mxOf[m];
                const cells = P[m];
                const lines = [...new Set(cells.map(lineOf))].map((s) => s.split(':').map(Number));
                const arrow = P.arrow[m];
                return (
                  <g>
                    {range(n).map((r) => range(n).map((c) => (
                      <rect class="f-grid" x={x0 + c * L.cell} y={y0 + r * L.cell} width={L.cell} height={L.cell} style="fill: var(--paper)" />
                    )))}
                    {cells.map(([r, c]) => (
                      <rect class={`f-fill-${tone[m]}`} x={x0 + c * L.cell} y={y0 + r * L.cell} width={L.cell} height={L.cell} style="fill-opacity: 0.55" />
                    ))}
                    {lines.map(([r, q]) => (
                      <rect class={`f-thin f-${tone[m]}`} x={x0 + q * per * L.cell + 0.8} y={y0 + r * L.cell + 0.8} width={per * L.cell - 1.6} height={L.cell - 1.6} rx="2" />
                    ))}
                    <rect class="f-thin f-muted" x={x0} y={y0} width={g} height={g} fill="none" />
                    {arrow === 'right' && <path class={`f-line f-${tone[m]}`} d={`M ${x0} ${y0 - 6} h ${g}`} marker-end={`url(#f-arrow-${tone[m]})`} />}
                    {arrow === 'down' && <path class={`f-line f-${tone[m]}`} d={`M ${x0 + g + 6} ${y0} v ${g}`} marker-end={`url(#f-arrow-${tone[m]})`} />}
                    <text class="f-math" x={x0 + g / 2} y={y0 + g + 20} text-anchor="middle">{m}</text>
                  </g>
                );
              })}
              <text class="f-label" x={L.opX[0]} y={y0 + g / 2 + 5} text-anchor="middle">=</text>
              <text class="f-label" x={L.opX[1]} y={y0 + g / 2 + 5} text-anchor="middle">×</text>
              {t.notes[p].map((line, k) => (
                <text class={`f-small ${k === 2 ? '' : 'f-t-muted'}`} x={L.noteAt[0]} y={L.rowY[p] + L.noteAt[1] + k * L.noteDy} text-anchor={L.W === 760 ? 'start' : 'middle'}>{line}</text>
              ))}
            </g>
          );
        })}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
