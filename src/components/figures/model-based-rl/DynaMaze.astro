---
import Figure from '../Figure.astro';
import Curves from '../temporal-difference-learning/Curves.astro';
import { scale } from '../geometry';
import { spread } from '../temporal-difference-learning/td';
import { dynaQ, MAZE } from './mb';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Dyna-Q on the 6 x 9 maze of Sutton and Barto (example 8.1): reward 1 at the goal, γ = 0.95, α = 0.1, ε = 0.1,
// n planning updates per real step; steps per episode averaged over 30 runs.
const ns = [0, 5, 50];
const res = ns.map((n) => Array.from(dynaQ(n)));
const chk = res.map((s) => [s[1], s[4], s[9], s[49]].map((v) => v.toFixed(0)).join(' ')).join(' | ');
if (chk !== '647 241 108 18 | 186 23 16 17 | 40 17 16 17') throw new Error(`DynaMaze: numbers drifted from the note (${chk})`);

const cls = ['f-line f-red', 'f-line f-amber', 'f-line f-blue f-bold'];
const tcls = ['f-t-red', 'f-t-amber', 'f-t-blue'];
const names = ru ? ['n = 0 (Q-обуч.)', 'n = 5', 'n = 50'] : ['n = 0 (Q-learning)', 'n = 5', 'n = 50'];
const t = ru
  ? { title: 'Dyna-Q: планирование по выученной модели в лабиринте', x: 'эпизоды', y: 'шагов за эпизод', start: 'S', goal: 'G',
      desc: `Слева лабиринт 6 на 9 клеток со стенами, стартом S и целью G. Справа число шагов за эпизод для эпизодов со 2-го по 50-й. Без планирования (n = 0) во втором эпизоде ${res[0][1].toFixed(0)} шагов и около 18 только к 50-му; с 5 шагами планирования ${res[1][1].toFixed(0)} во втором и около 17 с 10-го; с 50 — ${res[2][1].toFixed(0)} во втором и около 17 уже с 5-го.` }
  : { title: 'Dyna-Q: planning with a learned model in a maze', x: 'episodes', y: 'steps per episode', start: 'S', goal: 'G',
      desc: `Left: the 6 by 9 maze with walls, the start S and the goal G. Right: steps per episode for episodes 2 to 50. Without planning (n = 0), episode 2 takes ${res[0][1].toFixed(0)} steps and only episode 50 gets near 18; with 5 planning updates per step, ${res[1][1].toFixed(0)} in episode 2 and about 17 from episode 10; with 50, ${res[2][1].toFixed(0)} in episode 2 and about 17 from episode 5.` };
const id = 'mb-dyna-maze';
const caption = ru
  ? 'Награда 1 за достижение цели и 0 иначе, γ = 0.95, α = 0.1, ε = 0.1; среднее по 30 запускам. Первый эпизод у всех вариантов одинаково долгий (около 800 шагов): пока цель не найдена, ни одна ценность не отлична от нуля, и планировать нечего. После него модель-таблица помнит каждый увиденный переход, и n обновлений по ней за каждый реальный шаг распространяют ценность цели назад по уже пройденному пути, не дожидаясь, пока агент пройдёт его снова. Кратчайший путь — 14 шагов; ε-жадное поведение удлиняет его в среднем примерно до 17.'
  : 'Reward 1 for reaching the goal and 0 otherwise, γ = 0.95, α = 0.1, ε = 0.1; averaged over 30 runs. The first episode is equally long for all variants (about 800 steps): until the goal has been found, no value differs from zero and there is nothing to plan with. After it, the table model remembers every transition seen, and n updates from it per real step carry the value of the goal back along the path already walked, without waiting for the agent to walk it again. The shortest path takes 14 steps; ε-greedy behaviour stretches it to about 17 on average.';

const xs = Array.from({ length: 49 }, (_, i) => i + 2);
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, gx: 16, gy: 90, cell: 26, px: [330, 640] as [number, number], py: [40, 270] as [number, number], legend: false },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 560, gx: 63, gy: 16, cell: 26, px: [60, 340] as [number, number], py: [222, 432] as [number, number], legend: true },
];
const dy: [number, number] = [0, 700];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sy = scale(dy, [L.py[1], L.py[0]]);
    const ends = spread(res.map((s) => sy(s[49])), 16);
    const cells = Array.from({ length: MAZE.rows * MAZE.cols }, (_, i) => [Math.floor(i / MAZE.cols), i % MAZE.cols]);
    const wall = (r: number, c: number) => MAZE.walls.some(([wr, wc]) => wr === r && wc === c);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {cells.map(([r, c]) => <rect x={L.gx + c * L.cell} y={L.gy + r * L.cell} width={L.cell} height={L.cell}
          class={wall(r, c) ? 'f-fill-ink' : 'f-fill-paper'} style="stroke: var(--line); stroke-width: 1" />)}
        <text class="f-label" x={L.gx + (MAZE.start[1] + 0.5) * L.cell} y={L.gy + (MAZE.start[0] + 0.5) * L.cell + 5} text-anchor="middle">{t.start}</text>
        <text class="f-label" x={L.gx + (MAZE.goal[1] + 0.5) * L.cell} y={L.gy + (MAZE.goal[0] + 0.5) * L.cell + 5} text-anchor="middle">{t.goal}</text>
        <Curves px={L.px} py={L.py} dx={[0, 50]} dy={dy} xTicks={[2, 10, 20, 30, 40, 50]} yTicks={[0, 100, 200, 300, 400, 500, 600, 700]}
          xLabel={t.x} yLabel={t.y} yLabelAt={[L.px[0] - 44, L.py[0] - 20]} series={res.map((s, i) => ({ xs, ys: s.slice(1), cls: cls[i] }))} />
        {!L.legend && res.map((_, i) => <text class={`f-small ${tcls[i]}`} x={L.px[1] + 8} y={ends[i] + 4}>{names[i]}</text>)}
        {L.legend && names.map((name, i) => (
          <g>
            <path class={cls[i]} d={`M 16 ${494 + i * 24 - 5} h 24`} />
            <text class={`f-small ${tcls[i]}`} x={48} y={494 + i * 24}>{name}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
