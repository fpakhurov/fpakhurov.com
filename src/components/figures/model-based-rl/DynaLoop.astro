---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The Dyna architecture (Sutton, 1990) in its tabular form, Dyna-Q: each real step is used three times, for a
// Q-learning update, to update a table model, and as one of the transitions that planning can replay.
const n = 50;
if (n !== 50) throw new Error('DynaLoop: planning count changed');

const t = ru
  ? {
      title: 'Цикл Dyna-Q: действие, обучение, модель, планирование',
      env: 'среда', envSub: 'реальные переходы', real: 'реальный переход', realSub: '(S, A, R, S′)',
      model: 'обучение модели', modelSub: 'Model(S, A) ← (R, S′)', q: 'обновление Q', qSub: 'одно правило для обоих',
      plan: `планирование, n = ${n} раз`, planSub: 'пара (s, a) → модель → (r, s′)', planSubN: 'переходы из модели',
      act: 'ε-жадное действие', actSub: 'по текущим Q',
      steps: ['действие: агент выбирает A ε-жадно по Q и получает R и S′ от среды', 'прямое обучение: одно обновление Q-обучения по реальному переходу', 'обучение модели: таблица запоминает, к чему привело (S, A)', `планирование: ${n} раз выбрать увиденную пару (s, a), спросить модель и сделать то же обновление`, 'продолжение: из S′ с обновлёнными Q'],
      desc: `Шесть блоков. Среда возвращает реальный переход (S, A, R, S′). Он идёт в обновление Q-обучения и в модель-таблицу. Модель порождает смоделированные переходы для ${n} обновлений планирования по тому же правилу. Обновлённые Q определяют следующее ε-жадное действие в среде.`,
    }
  : {
      title: 'The Dyna-Q loop: act, learn, model, plan',
      env: 'environment', envSub: 'real transitions', real: 'real transition', realSub: '(S, A, R, S′)',
      model: 'model learning', modelSub: 'Model(S, A) ← (R, S′)', q: 'Q-learning update', qSub: 'the same rule for both',
      plan: `planning, n = ${n} times`, planSub: 'a seen (s, a) → model → (r, s′)', planSubN: 'from the model',
      act: 'ε-greedy action', actSub: 'from the current Q',
      steps: ['act: the agent picks A ε-greedily from Q and receives R and S′ from the environment', 'direct RL: one Q-learning update from the real transition', 'model learning: the table records where (S, A) led', `planning: ${n} times, pick a pair (s, a) seen before, ask the model, and apply the same update`, 'continue: from S′, with the updated Q'],
      desc: `Six blocks. The environment returns a real transition (S, A, R, S′). It feeds a Q-learning update and a table model. The model generates simulated transitions for ${n} planning updates with the same rule. The updated Q decides the next ε-greedy action in the environment.`,
    };
const id = 'mb-dyna-loop';
const caption = ru
  ? 'Прямое обучение и планирование используют одно и то же правило обновления; разница только в происхождении перехода — из среды или из модели. Модель здесь — таблица, которая просто помнит последний исход каждой пары (s, a) в детерминированном лабиринте; в стохастической среде она хранила бы частоты, а в большой — была бы нейросетью. Каждый реальный шаг оплачивает n обновлений, которые не требуют никакого взаимодействия со средой.'
  : 'Direct learning and planning use the same update rule; they differ only in where the transition comes from, the environment or the model. The model here is a table that remembers the last outcome of each pair (s, a) in a deterministic maze; in a stochastic world it would keep frequencies, and in a large one it would be a neural network. Each real step pays for n updates that cost nothing in interaction with the environment.';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 230" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <Box x={16} y={40} w={180} h={50} label={t.env} sub={t.envSub} />
    <g data-s="1">
      <Box x={16} y={150} w={180} h={50} label={t.act} sub={t.actSub} tone="y" />
      <Arrow pts={[[106, 150], [106, 92]]} tone="red" />
      <Arrow pts={[[196, 65], [258, 65]]} tone="green" />
      <Box x={260} y={40} w={210} h={50} label={t.real} sub={t.realSub} tone="x" />
      <Badge x={125} y={121} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[365, 90], [365, 148]]} tone="green" />
      <Box x={260} y={150} w={210} h={50} label={t.q} sub={t.qSub} tone="h" />
      <Badge x={384} y={119} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[470, 65], [528, 65]]} tone="green" />
      <Box x={530} y={40} w={214} h={50} label={t.model} sub={t.modelSub} tone="g" />
      <Badge x={499} y={44} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[637, 90], [637, 148]]} tone="amber" />
      <Box x={530} y={150} w={214} h={50} label={t.plan} sub={t.planSub} tone="g" />
      <Arrow pts={[[530, 175], [472, 175]]} tone="amber" />
      <Badge x={656} y={119} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[260, 175], [198, 175]]} tone="blue" />
      <Badge x={229} y={196} n={5} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 440" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <Box x={16} y={16} w={320} h={50} label={t.env} sub={t.envSub} />
    <g data-s="1">
      <Arrow pts={[[176, 66], [176, 98]]} tone="green" />
      <Box x={16} y={100} w={320} h={50} label={t.real} sub={t.realSub} tone="x" />
      <Box x={16} y={376} w={320} h={50} label={t.act} sub={t.actSub} tone="y" />
      <Arrow pts={[[336, 401], [350, 401], [350, 41], [338, 41]]} tone="red" />
      <Badge x={350} y={220} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[94, 150], [94, 188]]} tone="green" />
      <Box x={16} y={190} w={156} h={56} label={ru ? 'обновление Q' : 'Q update'} sub={ru ? 'одно правило' : 'the same rule'} tone="h" />
      <Badge x={113} y={169} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[266, 150], [266, 188]]} tone="green" />
      <Box x={180} y={190} w={156} h={56} label={ru ? 'модель' : 'model'} sub="(S, A) → (R, S′)" tone="g" />
      <Badge x={285} y={169} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[258, 246], [258, 278]]} tone="amber" />
      <Box x={180} y={280} w={156} h={56} label={ru ? `план, n = ${n}` : `plan, n = ${n}`} sub={t.planSubN} tone="g" />
      <Arrow pts={[[180, 308], [94, 308], [94, 248]]} tone="amber" />
      <Badge x={277} y={262} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[40, 246], [40, 374]]} tone="blue" />
      <Badge x={59} y={340} n={5} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
