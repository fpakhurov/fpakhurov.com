---
import Figure from '../Figure.astro';
import Curves from '../temporal-difference-learning/Curves.astro';
import { scale } from '../geometry';
import { spread } from '../temporal-difference-learning/td';
import { fitModels, rolloutError } from './mb';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Two models of the pendulum fitted by least squares on a grid of 25 angles x 17 speeds x 3 torques: a linear one and
// one with the feature sin θ. Free-swinging rollouts (no torque) from 12 start angles; RMS error of the predicted angle.
const m = fitModels();
const lin = rolloutError(m.linear), feat = rolloutError(m.features);
const H = lin.length;
const chk = [m.oneLinear, m.oneFeatures, lin[4], lin[9], lin[19], feat[9], feat[39]].map((v) => v.toFixed(3)).join(' ');
if (chk !== '0.018 0.006 0.260 0.949 1.936 0.106 0.725') throw new Error(`CompoundingError: numbers drifted from the note (${chk})`);
const chance = Math.PI / Math.sqrt(3);                           // RMS of an angle error spread uniformly over the circle

const lg = (v: number) => Math.log10(Math.max(1e-3, v));
const t = ru
  ? { title: 'Ошибка модели накапливается с горизонтом', x: 'горизонт прогноза, шаги', y: 'ошибка угла, рад (лог. шкала)',
      lin: 'линейная модель', feat: 'модель с sin θ', add: 'H × ошибка одного шага', chance: 'случайный угол',
      desc: `Ошибка предсказанного угла маятника в зависимости от горизонта, от 1 до 40 шагов, в логарифмической шкале. У линейной модели ошибка одного шага ${lin[0].toFixed(3)} радиана, через 10 шагов ${lin[9].toFixed(2)}, через 20 шагов ${lin[19].toFixed(2)} — уровень случайного угла ${chance.toFixed(2)}. У модели с признаком sin θ ошибка на этих прогнозах примерно в девять раз меньше, но тоже растёт: ${feat[9].toFixed(3)} через 10 шагов и ${feat[39].toFixed(2)} через 40. Пунктир — линейный рост, если бы ошибки одного шага просто складывались.` }
  : { title: 'Model error compounds with the horizon', x: 'prediction horizon, steps', y: 'angle error, rad (log scale)',
      lin: 'linear model', feat: 'model with sin θ', add: 'H × one-step error', chance: 'random guess',
      desc: `The error of the predicted pendulum angle against the horizon, from 1 to 40 steps, on a log scale. The linear model's one-step error is ${lin[0].toFixed(3)} radians, ${lin[9].toFixed(2)} after 10 steps and ${lin[19].toFixed(2)} after 20, the level of a random guess (${chance.toFixed(2)}). The model with the feature sin θ is about nine times more accurate on these rollouts, but its error grows too: ${feat[9].toFixed(3)} after 10 steps and ${feat[39].toFixed(2)} after 40. The dashed line is the linear growth that would result if one-step errors simply added up.` };
const id = 'mb-compounding-error';
const caption = ru
  ? `Маятник с шагом 0.05 с, обе модели подогнаны методом наименьших квадратов к 1275 переходам на сетке состояний и моментов; прогноз — свободные качания из 12 начальных углов, модель получает на вход собственные предсказания. Линейная модель ошибается за один шаг всего на ${m.oneLinear.toFixed(3)} радиана, но её ошибки возвращаются на вход и растут быстрее, чем линейно: через 10 шагов ${lin[9].toFixed(2)} против ${(10 * m.oneLinear).toFixed(2)}, которые дало бы простое сложение. Через 20 шагов прогноз не лучше случайного. Модель, в класс которой почти входит истинная динамика, держится дольше, но и её ошибка растёт с горизонтом.`
  : `The pendulum with a time step of 0.05 s; both models are fitted by least squares to 1275 transitions on a grid of states and torques; the predictions are free swings from 12 start angles, with the model fed its own outputs. The linear model is off by only ${m.oneLinear.toFixed(3)} radians in one step, but its errors are fed back as inputs and grow faster than linearly: ${lin[9].toFixed(2)} after 10 steps against the ${(10 * m.oneLinear).toFixed(2)} that simple addition would give. After 20 steps the prediction is no better than a random guess. A model whose class almost contains the true dynamics lasts longer, but its error also grows with the horizon.`;

const xs = Array.from({ length: H }, (_, i) => i + 1);
const keys = ['lin', 'feat', 'add'] as const;
const series = { lin: lin.map(lg), feat: feat.map(lg), add: xs.map((h) => lg(h * m.oneLinear)) };
const cls = { lin: 'f-line f-red f-bold', feat: 'f-line f-blue', add: 'f-line f-red f-dash' };
const tcls = { lin: 'f-t-red', feat: 'f-t-blue', add: 'f-t-red' };
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [70, 560] as [number, number], py: [40, 270] as [number, number], legend: false },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 430, px: [56, 344] as [number, number], py: [44, 270] as [number, number], legend: true },
];
const dy: [number, number] = [-3, 1];
const yFmt = (v: number) => ['0.001', '0.01', '0.1', '1', '10'][v + 3];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sy = scale(dy, [L.py[1], L.py[0]]);
    const ends = spread(keys.map((k) => sy(series[k][H - 1])), 16);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        <Curves px={L.px} py={L.py} dx={[0, H]} dy={dy} xTicks={[0, 10, 20, 30, 40]} yTicks={[-3, -2, -1, 0, 1]}
          yFmt={yFmt} xLabel={t.x} yLabel={t.y} yLabelAt={[L.px[0] - 48, L.py[0] - 20]}
          series={keys.map((k) => ({ xs, ys: series[k], cls: cls[k] }))} />
        <path class="f-line f-muted f-dot" d={`M ${L.px[0]} ${sy(lg(chance))} H ${L.px[1]}`} />
        <text class="f-small f-t-muted f-halo" x={L.px[0] + 8} y={sy(lg(chance)) - 6}>{`${t.chance}: ${chance.toFixed(2)}`}</text>
        {!L.legend && keys.map((k, i) => <text class={`f-small ${tcls[k]}`} x={L.px[1] + 8} y={ends[i] + 4}>{t[k]}</text>)}
        {L.legend && keys.map((k, i) => (
          <g>
            <path class={cls[k]} d={`M 16 ${338 + i * 24 - 5} h 24`} />
            <text class={`f-small ${tcls[k]}`} x={48} y={338 + i * 24}>{t[k]}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
