---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { attemptMs, earlyResultMs, lateReplyMs, lateResultMs } from './example';

const ru = pageLang(Astro.url) === 'ru';
const id = 'big-data-timeout-histories';
const x = (ms: number) => 20 + (310 * ms) / 180;
const milliseconds = ru ? 'мс' : 'ms';
const histories = [
  { title: ru ? 'Запрос потерялся' : 'Request lost', result: null, reply: null },
  { title: ru ? 'Ответ потерялся' : 'Reply lost', result: earlyResultMs, reply: null },
  { title: ru ? 'Ответ опоздал' : 'Reply delayed', result: lateResultMs, reply: lateReplyMs },
];
---

<Figure id={id}
  title={ru ? 'Один тайм-аут, разные события' : 'One timeout, different histories'}
  caption={ru
    ? 'Во всех случаях координатор отправляет запрос в момент 0 и ждёт до ' + attemptMs + ' мс. Синие отметки относятся к готовности результата у исполнителя, зелёная к доставке ответа координатору.'
    : 'In every history the coordinator sends at time 0 and waits until ' + attemptMs + ' ms. Blue marks show when the worker finishes, and the green mark shows when a reply reaches the coordinator.'}>
  <svg class="fig-compact" viewBox="0 0 350 235" role="img" aria-labelledby={id + '-title ' + id + '-desc'}>
    <title id={id + '-title'}>{ru ? 'Три истории с одинаковым тайм-аутом' : 'Three histories with the same timeout'}</title>
    <desc id={id + '-desc'}>{ru
      ? 'К ' + attemptMs + ' мс ни в одном случае нет ответа. В первом случае запрос потерялся. Во втором результат готов в ' + earlyResultMs + ' мс, но ответ потерялся. В третьем результат готов в ' + lateResultMs + ' мс, а ответ приходит в ' + lateReplyMs + ' мс.'
      : 'No reply arrives by ' + attemptMs + ' ms in any history. The first request is lost. The second result is ready at ' + earlyResultMs + ' ms but the reply is lost. The third result is ready at ' + lateResultMs + ' ms and the reply arrives at ' + lateReplyMs + ' ms.'}</desc>
    <text class="f-label f-t-muted" x={x(0)} y="19" text-anchor="middle">0</text>
    <text class="f-label f-t-red" x={x(attemptMs)} y="19" text-anchor="middle">{attemptMs + ' ' + milliseconds}</text>
    <line class="f-line f-red" x1={x(attemptMs)} x2={x(attemptMs)} y1="27" y2="213" stroke-dasharray="4 4" />
    {histories.map(({ title, result, reply }, index) => {
      const y = 65 + 67 * index;
      return <>
        <text class="f-label" x={x(0)} y={y - 12}>{title}</text>
        <line class="f-axis" x1={x(0)} x2={x(180)} y1={y} y2={y} />
        <circle class="f-solid-muted" cx={x(0)} cy={y} r="4" />
        <circle class="f-solid-red" cx={x(attemptMs)} cy={y} r="4" />
        {result !== null && <>
          <circle class="f-solid-blue" cx={x(result)} cy={y} r="4" />
          <text class="f-label f-t-blue" x={x(result)} y={y + 21} text-anchor="middle">{result}</text>
        </>}
        {reply !== null && <>
          <circle class="f-solid-green" cx={x(reply)} cy={y} r="4" />
          <text class="f-label f-t-green" x={x(reply)} y={y + 21} text-anchor="middle">{reply}</text>
        </>}
      </>;
    })}
  </svg>
</Figure>
