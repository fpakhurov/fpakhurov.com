---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { correctCents, duplicatedCents, missingCents, readyCents, retryReplyMs, lateReplyMs } from './example';

const ru = pageLang(Astro.url) === 'ru';
const id = 'big-data-retry-totals';
const milliseconds = ru ? 'мс' : 'ms';
const rows = [
  { time: '—', event: ru ? 'Части 1–3' : 'Parts 1–3', summed: readyCents, keyed: readyCents },
  { time: retryReplyMs + ' ' + milliseconds, event: ru ? 'Часть 4 · B' : 'Part 4 · B', summed: correctCents, keyed: correctCents },
  { time: lateReplyMs + ' ' + milliseconds, event: ru ? 'Часть 4 · A' : 'Part 4 · A', summed: duplicatedCents, keyed: correctCents },
];
---

<Figure id={id}
  title={ru ? 'Два ответа на одну задачу' : 'Two replies for the same task'}
  caption={ru
    ? 'В обеих попытках результат для части 4 равен ' + missingCents + ' копейкам. Первый итог учитывает каждое сообщение. Второй учитывает не больше одного результата на часть.'
    : 'Both attempts produce ' + missingCents + ' cents for part 4. The first total adds every message. The second accepts at most one result per part.'}>
  <svg class="fig-compact" viewBox="0 0 350 140" role="img" aria-labelledby={id + '-title ' + id + '-desc'}>
    <title id={id + '-title'}>{ru ? 'Итог с учётом всех ответов и итог по частям' : 'Total by reply compared with total by part'}</title>
    <desc id={id + '-desc'}>{ru
      ? 'До части 4 оба итога равны ' + readyCents + '. Ответ B даёт ' + correctCents + '. Ответ A завышает итог до ' + duplicatedCents + ' только при сложении каждого сообщения.'
      : 'Before part 4 both totals are ' + readyCents + '. Reply B brings both to ' + correctCents + '. Reply A increases the sum to ' + duplicatedCents + ' only when every message is added.'}</desc>
    <text class="f-label f-t-muted" x="10" y="22">{ru ? 'Время' : 'Time'}</text>
    <text class="f-label f-t-muted" x="83" y="22">{ru ? 'Результат' : 'Result'}</text>
    <text class="f-label f-t-muted" x="242" y="22" text-anchor="end">{ru ? 'По ответам' : 'By reply'}</text>
    <text class="f-label f-t-muted" x="340" y="22" text-anchor="end">{ru ? 'По частям' : 'By part'}</text>
    {rows.map(({ time, event, summed, keyed }, index) => {
      const y = 49 + 37 * index;
      return <>
        <line class="f-axis" x1="10" x2="340" y1={y - 15} y2={y - 15} />
        <text class="f-label" x="10" y={y + 8}>{time}</text>
        <text class="f-label" x="83" y={y + 8}>{event}</text>
        <text class:list={['f-label', { 'f-t-red': summed !== keyed }]} x="242" y={y + 8} text-anchor="end">{summed}</text>
        <text class:list={['f-label', { 'f-t-green': summed !== keyed }]} x="340" y={y + 8} text-anchor="end">{keyed}</text>
      </>;
    })}
  </svg>
</Figure>
