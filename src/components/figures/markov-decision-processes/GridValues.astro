---
import Figure from '../Figure.astro';
import { CELLS, ACTS, GOAL, PIT, ix, isTerminal, q, valueIteration } from './gridworld';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// V* and the greedy policy of the 4 × 3 world at gamma = 0.9, by value iteration run to convergence.
const gamma = 0.9;
const hist = valueIteration(gamma, 400);
const V = hist[hist.length - 1];
const pol = CELLS.map((c) => (isTerminal(c) ? '' : ACTS.reduce((b, a) => (q(V, c, a, gamma) > q(V, c, b, gamma) ? a : b))));
const grid = [3, 2, 1].map((y) => [1, 2, 3, 4].map((x) => { const i = ix([x, y]); return i < 0 ? '#' : isTerminal([x, y]) ? 'T' : `${V[i].toFixed(3)}${pol[i]}`; }).join(' ')).join(' / ');
if (grid !== '0.610E 0.766E 0.928E T / 0.487N # 0.585N T / 0.374N 0.327E 0.428N 0.189W')
  throw new Error(`GridValues: values drifted from the note (${grid})`);

const t = ru
  ? { title: 'Оптимальные ценности и стратегия в мире 4 × 3', goal: 'цель +1', pit: 'яма −1', wall: 'стена', start: 'старт',
      desc: 'Сетка из четырёх столбцов и трёх рядов. В каждой клетке её оптимальная ценность и стрелка оптимального действия. Верхний ряд: 0.610, 0.766, 0.928 со стрелками вправо и цель +1. Средний ряд: 0.487 вверх, стена, 0.585 вверх и яма −1. Нижний ряд: 0.374 вверх, 0.327 вправо, 0.428 вверх, 0.189 влево.' }
  : { title: 'Optimal values and policy in the 4 × 3 world', goal: 'goal +1', pit: 'pit −1', wall: 'wall', start: 'start',
      desc: 'A grid of four columns and three rows. Each cell shows its optimal value and an arrow for the optimal action. Top row: 0.610, 0.766, 0.928 with arrows to the right, then the goal +1. Middle row: 0.487 up, the wall, 0.585 up, then the pit −1. Bottom row: 0.374 up, 0.327 right, 0.428 up, 0.189 left.' };
const id = 'grid-values';
const caption = ru
  ? 'Действие удаётся с вероятностью 0.8 и с вероятностью 0.1 сносит агента в каждую из сторон под прямым углом; удар о стену или край оставляет на месте. Награда −0.04 за каждый шаг, +1 за вход в цель и −1 за вход в яму, γ = 0.9. Клетка тем светлее, чем меньше её ценность. В (3, 1) и (3, 2) стратегия идёт вверх, рядом с ямой, и мирится с шансом 0.1 соскользнуть в неё из (3, 2): обход через (1, 1) длиннее, а γ = 0.9 обесценивает длинные пути. В (4, 1) она идёт влево, прочь от ямы, а не вверх прямо в неё.'
  : 'An action succeeds with probability 0.8 and slips to either side with probability 0.1; bumping into the wall or the edge stays put. The reward is −0.04 per step, +1 for entering the goal and −1 for entering the pit, with γ = 0.9. The paler the cell, the lower its value. In (3, 1) and (3, 2) the policy goes up, next to the pit, and accepts a 0.1 chance of slipping into it from (3, 2): the way round through (1, 1) is longer, and γ = 0.9 discounts long paths. In (4, 1) it moves left, away from the pit, rather than up into it.';
const arrow: Record<string, string> = { N: '↑', E: '→', S: '↓', W: '←' };
const layouts = [
  { sfx: 'w', cls: 'fig-wide fig-medium', W: 560, H: 310, cw: 128, ch: 86, x0: 24, y0: 20, big: true },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 250, cw: 82, ch: 74, x0: 16, y0: 12, big: false },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
      {[1, 2, 3, 4].flatMap((x) => [1, 2, 3].map((y) => {
        const X = L.x0 + (x - 1) * L.cw, Y = L.y0 + (3 - y) * L.ch, i = ix([x, y]);
        const cx = X + L.cw / 2, cy = Y + L.ch / 2;
        if (i < 0) return (
          <g><rect x={X} y={Y} width={L.cw} height={L.ch} class="f-fill-ink" style="opacity: .75" /></g>
        );
        const goal = x === GOAL[0] && y === GOAL[1], pit = x === PIT[0] && y === PIT[1];
        const fill = goal ? 'f-fill-green' : pit ? 'f-fill-red' : 'f-fill-blue';
        return (
          <g>
            <rect x={X} y={Y} width={L.cw} height={L.ch} class={fill} style={goal || pit ? '' : `fill-opacity: ${(0.06 + 0.3 * Math.max(0, V[i])).toFixed(3)}`} />
            <rect x={X} y={Y} width={L.cw} height={L.ch} class="f-thin f-muted" fill="none" />
            {goal || pit
              ? <text class={`f-label ${goal ? 'f-t-green' : 'f-t-red'}`} x={cx} y={cy + 5} text-anchor="middle">{goal ? t.goal : t.pit}</text>
              : <g>
                  <text class="f-label" x={cx} y={cy - 6} text-anchor="middle">{V[i].toFixed(3)}</text>
                  <text class="f-label f-t-blue" x={cx} y={cy + 20} text-anchor="middle" style="font-size: 20px">{arrow[pol[i]]}</text>
                </g>}
            <text class="f-small f-t-muted" x={X + 5} y={Y + 14}>{`(${x}, ${y})`}</text>
          </g>
        );
      }))}
      {L.big && <text class="f-small f-t-muted" x={L.x0} y={L.y0 + 3 * L.ch + 20}>{`${t.start}: (1, 1) · γ = 0.9`}</text>}
    </svg>
  ))}
</Figure>
