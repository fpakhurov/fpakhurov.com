---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { ACTS, ix, outcomes, q, valueIteration } from './gridworld';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One Bellman optimality backup at s = (3, 3) of the 4 × 3 world, gamma = 0.9, with the converged values V*.
const gamma = 0.9;
const hist = valueIteration(gamma, 400);
const V = hist[hist.length - 1];
const s: [number, number] = [3, 3];
const Q = Object.fromEntries(ACTS.map((a) => [a, q(V, s, a, gamma)]));
const outs = outcomes(s, 'E').map(([n, p, r]) => ({ n, p, r, v: V[ix(n)], back: r + gamma * V[ix(n)] }));
const f3 = (x: number) => x.toFixed(3).replace('-', '−');
const got = [ACTS.map((a) => f3(Q[a])).join(' '), outs.map((o) => `${o.n.join(',')}:${o.p}:${f3(o.back)}`).join(' '), f3(V[ix(s)])].join(' | ');
if (got !== '0.801 0.928 0.554 0.648 | 4,3:0.8:1.000 3,3:0.1:0.795 3,2:0.1:0.486 | 0.928') throw new Error(`BellmanBackup: drifted from the note (${got})`);
const sumQ = outs.reduce((a, o) => a + o.p * o.back, 0);
if (Math.abs(sumQ - Q.E) > 1e-12 || Math.abs(Q.E - V[ix(s)]) > 1e-9) throw new Error('BellmanBackup: the backup does not close');

const name = (n: [number, number]) => `(${n[0]}, ${n[1]})`;
const t = ru
  ? { title: 'Одно обновление Беллмана в клетке (3, 3)', goal: 'цель', stay: 'удар о край', slip: 'снос вниз',
      steps: ['состояние s = (3, 3): четыре действия на выбор', 'действие E: три исхода с вероятностями 0.8, 0.1, 0.1', 'каждый исход: награда плюс γ, умноженное на ценность следующего состояния', `среднее по исходам: Q(s, E) = ${f3(Q.E)}`, `максимум по действиям: V*(s) = ${f3(V[ix(s)])}`],
      desc: `Дерево обновления: состояние (3, 3) слева, его четыре действия N, E, S, W с ценностями действий ${ACTS.map((a) => f3(Q[a])).join(', ')}. Действие E раскрыто на три исхода: в цель (4, 3) с вероятностью 0.8, остаться на месте в (3, 3) с вероятностью 0.1 и в (3, 2) с вероятностью 0.1. Их обновлённые значения 1.000, 0.795 и 0.486 в среднем дают ${f3(Q.E)}, а максимум по действиям даёт V* = ${f3(V[ix(s)])}.` }
  : { title: 'One Bellman backup at cell (3, 3)', goal: 'goal', stay: 'bumps the edge', slip: 'slips down',
      steps: ['state s = (3, 3): four actions to choose from', 'action E: three outcomes, with probabilities 0.8, 0.1, 0.1', 'each outcome: its reward plus γ times the value of the next state', `average over the outcomes: Q(s, E) = ${f3(Q.E)}`, `maximum over the actions: V*(s) = ${f3(V[ix(s)])}`],
      desc: `A backup tree: the state (3, 3) on the left, its four actions N, E, S, W with action values ${ACTS.map((a) => f3(Q[a])).join(', ')}. Action E is expanded into three outcomes: the goal (4, 3) with probability 0.8, staying at (3, 3) with probability 0.1, and (3, 2) with probability 0.1. Their backed-up values 1.000, 0.795 and 0.486 average to ${f3(Q.E)}, and the maximum over actions gives V* = ${f3(V[ix(s)])}.` };
const tags = [t.goal, t.stay, t.slip];
const lines = outs.map((o) => `${o.r === 1 ? '1' : '−0.04'} + 0.9 · ${o.v.toFixed(3)} = ${f3(o.back)}`);
const qLine1 = `Q(s, E) = 0.8 · ${f3(outs[0].back)} + 0.1 · ${f3(outs[1].back)}`;
const qLine2 = `+ 0.1 · ${f3(outs[2].back)} = ${f3(Q.E)}`;
const vLine = `V*(s) = max(${ACTS.map((a) => f3(Q[a])).join(', ')}) = ${f3(V[ix(s)])}`;
const id = 'bellman-backup';
const caption = ru
  ? `Ценности следующих состояний — оптимальные, из итерации по ценностям при γ = 0.9: V*(3, 3) = ${f3(V[ix([3, 3])])}, V*(3, 2) = ${f3(V[ix([3, 2])])}, у цели 0, так как эпизод там кончается. Действие E с вероятностью 0.8 ведёт в цель и даёт награду +1, с вероятностью 0.1 сносит вверх, в край, и оставляет на месте, с вероятностью 0.1 сносит вниз, в (3, 2). Обновление для V* выполняется точно, потому что V* — неподвижная точка: максимум четырёх Q снова даёт ${f3(V[ix(s)])}.`
  : `The values of the next states are the optimal ones, from value iteration with γ = 0.9: V*(3, 3) = ${f3(V[ix([3, 3])])}, V*(3, 2) = ${f3(V[ix([3, 2])])}, and 0 at the goal, where the episode ends. Action E reaches the goal and the reward +1 with probability 0.8, slips up into the edge and stays put with probability 0.1, and slips down to (3, 2) with probability 0.1. The backup of V* holds exactly, because V* is the fixed point: the maximum of the four Q values gives ${f3(V[ix(s)])} again.`;
const ay = [52, 122, 192, 262];
const oy = [56, 130, 204];
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 310" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <g data-s="1">
      {ay.map((y) => <path class="f-line f-muted" d={`M 82 150 L 192 ${y}`} />)}
      <circle cx="60" cy="150" r="22" class="f-fill-blue" style="stroke: var(--fig-blue); stroke-width: 1.4" />
      <text class="f-math" x="60" y="156" text-anchor="middle">s</text>
      <text class="f-small" x="60" y="194" text-anchor="middle">{name(s)}</text>
      {ACTS.map((a, i) => (
        <g>
          <circle cx="200" cy={ay[i]} r="8" class="f-solid-muted" />
          <text class="f-label" x="186" y={ay[i] - 10} text-anchor="end">{a}</text>
        </g>
      ))}
      <Badge x={60} y={112} n={1} />
    </g>
    <g data-s="2">
      {oy.map((y, i) => (
        <g>
          <path class="f-line f-amber" d={`M 208 122 L 396 ${y}`} />
          <text class="f-small f-t-amber f-halo" x={300} y={(122 + y) / 2 + (i === 1 ? -6 : i === 0 ? -4 : 14)} text-anchor="middle">{String(outs[i].p)}</text>
          <rect x="398" y={y - 16} width="64" height="32" rx="6" class={i === 0 ? 'f-fill-green' : 'f-fill-blue'} style={`stroke: var(${i === 0 ? '--fig-green' : '--fig-blue'}); stroke-width: 1.2`} />
          <text class="f-small" x="430" y={y + 4} text-anchor="middle">{name(outs[i].n)}</text>
          <text class="f-small f-t-muted" x="430" y={y + 30} text-anchor="middle">{tags[i]}</text>
        </g>
      ))}
      <Badge x={300} y={150} n={2} />
    </g>
    <g data-s="3">
      {lines.map((l, i) => <text class="f-small" x="476" y={oy[i] + 4}>{l}</text>)}
      <Badge x={740} y={oy[0]} n={3} />
    </g>
    <g data-s="4">
      <text class="f-small f-t-red" x="476" y="254">{qLine1}</text>
      <text class="f-small f-t-red" x="476" y="274">{qLine2}</text>
      <Badge x={740} y={258} n={4} />
    </g>
    <g data-s="5">
      {ACTS.map((a, i) => (a === 'E' ? null : <text class="f-small f-t-muted" x="214" y={ay[i] + 4}>{`Q = ${f3(Q[a])}`}</text>))}
      <text class="f-small f-t-red" x="60" y="214" text-anchor="middle">{`V* = ${f3(V[ix(s)])}`}</text>
      <text class="f-small f-t-muted" x="16" y="300">{vLine}</text>
      <Badge x={110} y={214} n={5} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 500" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <g data-s="1">
      {[60, 140, 220, 300].map((x) => <path class="f-line f-muted" d={`M 180 54 L ${x} 104`} />)}
      <circle cx="180" cy="34" r="20" class="f-fill-blue" style="stroke: var(--fig-blue); stroke-width: 1.4" />
      <text class="f-math" x="180" y="40" text-anchor="middle">s</text>
      <text class="f-small" x="216" y="30">{name(s)}</text>
      {ACTS.map((a, i) => (
        <g>
          <circle cx={60 + 80 * i} cy="110" r="7" class="f-solid-muted" />
          <text class="f-label" x={48 + 80 * i} y="104" text-anchor="end">{a}</text>
        </g>
      ))}
      <Badge x={140} y={30} n={1} />
    </g>
    <g data-s="2">
      {[60, 170, 280].map((x, i) => (
        <g>
          <path class="f-line f-amber" d={`M 140 117 L ${x} 196`} />
          <text class="f-small f-t-amber f-halo" x={(140 + x) / 2 + (i === 0 ? -14 : i === 1 ? 8 : 16)} y="160" text-anchor="middle">{String(outs[i].p)}</text>
          <rect x={x - 34} y="198" width="68" height="30" rx="6" class={i === 0 ? 'f-fill-green' : 'f-fill-blue'} style={`stroke: var(${i === 0 ? '--fig-green' : '--fig-blue'}); stroke-width: 1.2`} />
          <text class="f-small" x={x} y="218" text-anchor="middle">{name(outs[i].n)}</text>
        </g>
      ))}
      <Badge x={330} y={160} n={2} />
    </g>
    <g data-s="3">
      {lines.map((l, i) => <text class="f-small" x="16" y={266 + 24 * i}>{`${name(outs[i].n)}: ${l}`}</text>)}
      <Badge x={340} y={262} n={3} />
    </g>
    <g data-s="4">
      <text class="f-small f-t-red" x="16" y="350">{qLine1}</text>
      <text class="f-small f-t-red" x="16" y="372">{qLine2}</text>
      <Badge x={340} y={358} n={4} />
    </g>
    <g data-s="5">
      <text class="f-small f-t-red" x="16" y="420">{`V*(s) = max(${ACTS.map((a) => f3(Q[a])).join(', ')})`}</text>
      <text class="f-small f-t-red" x="16" y="442">{`= ${f3(V[ix(s)])}`}</text>
      <Badge x={340} y={424} n={5} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
