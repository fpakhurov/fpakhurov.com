---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { valueIteration } from './gridworld';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Value iteration on the 4 × 3 world from V_0 = 0: the max-norm error against the fixed point after k sweeps, and the
// contraction bound gamma^k · ||V_0 − V*||, for three discounts.
const K = 30;
const runs = [0.5, 0.9, 0.99].map((gamma, i) => {
  const hist = valueIteration(gamma, 2000);
  const Vs = hist[hist.length - 1];
  const err = hist.slice(0, K + 1).map((V) => Math.max(...V.map((v, j) => Math.abs(v - Vs[j]))));
  for (let k = 0; k < K; k++) if (err[k + 1] > gamma * err[k] + 1e-12) throw new Error('ViConvergence: the contraction bound is violated');
  return { gamma, err, bound: err.map((_, k) => err[0] * gamma ** k), tone: ['green', 'blue', 'red'][i] };
});
const sweeps = runs.map((r) => r.err.findIndex((e) => e < 1e-6)).join(' ');
const at10 = runs.map((r) => `${r.err[10].toFixed(3)}/${r.bound[10].toFixed(3)}`).join(' ');
if (sweeps !== '14 20 26' || at10 !== '0.000/0.001 0.006/0.324 0.058/0.863') throw new Error(`ViConvergence: drifted from the note (${sweeps}; ${at10})`);

const t = ru
  ? { title: 'Ошибка итерации по ценностям и оценка из сжатия', y: 'ошибка в max-норме ‖V_k − V*‖', x: 'число проходов k', err: 'ошибка', bound: 'оценка γᵏ‖V₀ − V*‖',
      desc: 'Логарифмическая шкала ошибки от 1 до 10⁻⁸ в зависимости от числа проходов от 0 до 30. Для γ = 0.5, 0.9 и 0.99 сплошные кривые ошибки падают ниже 10⁻⁶ за 14, 20 и 26 проходов. Пунктирные оценки, γᵏ, умноженное на начальную ошибку, падают медленнее, а для γ = 0.99 почти не убывают.' }
  : { title: 'The error of value iteration and the contraction bound', y: 'max error ‖V_k − V*‖', x: 'sweeps k', err: 'error', bound: 'bound γᵏ‖V₀ − V*‖',
      desc: 'A log scale of the error from 1 to 10⁻⁸ against the number of sweeps from 0 to 30. For γ = 0.5, 0.9 and 0.99 the solid error curves fall below 10⁻⁶ after 14, 20 and 26 sweeps. The dashed bounds, γᵏ times the initial error, fall more slowly, and for γ = 0.99 they hardly fall at all.' };
const id = 'vi-convergence';
const caption = ru
  ? `Итерация по ценностям в мире 4 × 3 из V₀ = 0. Сплошные линии — фактическая ошибка в max-норме после k проходов, пунктир того же цвета — гарантия сжатия γᵏ‖V₀ − V*‖. Каждый проход уменьшает ошибку не меньше чем в γ раз, как и обещает теорема; здесь — гораздо сильнее, потому что эпизоды кончаются: после 10 проходов при γ = 0.9 ошибка ${runs[1].err[10].toFixed(3)} при оценке ${runs[1].bound[10].toFixed(3)}, при γ = 0.99 — ${runs[2].err[10].toFixed(3)} при оценке ${runs[2].bound[10].toFixed(3)}. Оценка описывает худший случай — задачу, которая никогда не кончается.`
  : `Value iteration on the 4 × 3 world from V₀ = 0. Solid lines are the actual max-norm error after k sweeps; the dashed line of the same colour is the contraction guarantee γᵏ‖V₀ − V*‖. Every sweep shrinks the error by at least the factor γ, as the theorem promises; here by much more, because the episodes end: after 10 sweeps the error is ${runs[1].err[10].toFixed(3)} against a bound of ${runs[1].bound[10].toFixed(3)} at γ = 0.9, and ${runs[2].err[10].toFixed(3)} against ${runs[2].bound[10].toFixed(3)} at γ = 0.99. The bound describes the worst case, a task that never ends.`;
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [76, 580] as [number, number], py: [40, 270] as [number, number], lx: 596, ly: 70 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 456, px: [60, 344] as [number, number], py: [40, 270] as [number, number], lx: 60, ly: 340 },
];
const lo = -8;
// a log-scale polyline that stops one point below the floor of the plot
function curve(vals: number[], sx: (v: number) => number, sy: (v: number) => number) {
  const ly = (v: number) => sy(Math.max(lo, Math.log10(Math.max(v, 1e-12))));
  const keep = vals.map((v, k) => [k, v] as [number, number]).filter(([, v], j, a) => v >= 10 ** lo || (j > 0 && a[j - 1][1] >= 10 ** lo));
  return polyline(keep.map(([k, v]) => [sx(k), ly(v)] as [number, number]));
}
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sx = scale([0, K], L.px), sy = scale([lo, 0], [L.py[1], L.py[0]]);
    const pts = (vals: number[]) => curve(vals, sx, sy);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {[0, -2, -4, -6, -8].map((e) => <path class="f-grid" d={`M ${L.px[0]} ${sy(e)} H ${L.px[1]}`} />)}
        <path class="f-axis" d={`M ${L.px[0]} ${L.py[0] - 6} V ${L.py[1]} H ${L.px[1]}`} />
        {[0, -2, -4, -6, -8].map((e) => <text class="f-small" x={L.px[0] - 7} y={sy(e) + 4} text-anchor="end">{e === 0 ? '1' : `10${'⁻'}${String(-e).replace('2', '²').replace('4', '⁴').replace('6', '⁶').replace('8', '⁸')}`}</text>)}
        {[0, 5, 10, 15, 20, 25, 30].map((k) => <text class="f-small" x={sx(k)} y={L.py[1] + 18} text-anchor="middle">{String(k)}</text>)}
        <text class="f-small f-t-muted" x={(L.px[0] + L.px[1]) / 2} y={L.py[1] + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.px[0] - 44} y={L.py[0] - 20}>{t.y.replace('V_k', 'Vₖ')}</text>
        {runs.map((r) => (
          <g>
            <path class={`f-line f-${r.tone} f-dash`} d={pts(r.bound)} />
            <path class={`f-line f-${r.tone}`} d={pts(r.err)} />
          </g>
        ))}
        {runs.map((r, i) => (
          <g>
            <path class={`f-line f-${r.tone}`} d={`M ${L.lx} ${L.ly + i * 22 - 4} h 22`} />
            <text class={`f-small f-t-${r.tone}`} x={L.lx + 30} y={L.ly + i * 22}>{`γ = ${r.gamma}`}</text>
          </g>
        ))}
        <path class="f-line f-muted f-dash" d={`M ${L.lx} ${L.ly + 3 * 22 + 6} h 22`} />
        <text class="f-small f-t-muted" x={L.lx + 30} y={L.ly + 3 * 22 + 10}>{t.bound}</text>
        <path class="f-line f-muted" d={`M ${L.lx} ${L.ly + 4 * 22 + 6} h 22`} />
        <text class="f-small f-t-muted" x={L.lx + 30} y={L.ly + 4 * 22 + 10}>{t.err}</text>
      </svg>
    );
  })}
</Figure>
