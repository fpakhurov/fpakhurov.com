---
import Figure from '../Figure.astro';
import { normals } from '../geometry';

const id = 'ddpm-training-objective-chain';

// An 8×8 "image" (a ring with a dot) in [-1, 1]; each tile is a real sample
// x = sqrt(abar) x0 + sqrt(1 - abar) eps with one shared noise draw.
const N = 8;
const photo: number[] = [];
for (let r = 0; r < N; r += 1) {
  for (let c = 0; c < N; c += 1) {
    const d = Math.hypot(r - 3.5, c - 3.5);
    photo.push((d > 2.0 && d < 3.4) || d < 0.8 ? 1 : -1);
  }
}
const eps = normals(N * N, 11);
const nodes = [
  { sub: '0', abar: 1, note: 'image', tone: 'f-t-red' },
  { sub: 't−1', abar: 0.6, note: '', tone: '' },
  { sub: 't', abar: 0.42, note: '', tone: '' },
  { sub: 'T', abar: 0, note: 'noise', tone: 'f-t-blue' },
];
const tiles = nodes.map((n) =>
  photo.map((x0, i) => {
    const x = Math.sqrt(n.abar) * x0 + Math.sqrt(1 - n.abar) * eps[i];
    return Math.min(1, Math.max(0, (x + 1) / 2)) * 0.88;
  }),
);

function tile(k: number, cx: number, cy: number, size: number) {
  const p = size / N;
  const x0 = cx - size / 2;
  const y0 = cy - size / 2;
  return {
    cells: tiles[k].map((o, i) => ({ x: x0 + (i % N) * p, y: y0 + Math.floor(i / N) * p, w: p + 0.3, o: o.toFixed(3) })),
    frame: { x: x0, y: y0, w: size },
  };
}

// Wide layout: a row of tiles.
const W = { size: 56, y: 104, xs: [70, 258, 410, 582], dots: [164, 496] };
const wide = W.xs.map((x, k) => tile(k, x, W.y, W.size));
// Narrow layout: a column of tiles.
const Nn = { size: 50, x: 180, ys: [48, 196, 344, 492], dots: [122, 418] };
const narrow = Nn.ys.map((y, k) => tile(k, Nn.x, y, Nn.size));
const h = W.size / 2;
const hn = Nn.size / 2;
const midW = (W.xs[1] + W.xs[2]) / 2;
const midN = (Nn.ys[1] + Nn.ys[2]) / 2;
---

<Figure
  id={id}
  title="The forward step is known; the backward step must be learned"
  caption="The fixed forward step q(xₜ | xₜ₋₁) adds noise and moves from the image x₀ towards pure noise at the last step T. The reverse step pθ(xₜ₋₁ | xₜ) is the probability density we have to learn to invert the process; θ are the parameters of the neural network. Tiles are real samples √ᾱ x₀ + √(1 − ᾱ) ε with one shared noise draw."
  origin="expanded"
  pages="40"
>
  <svg class="fig-wide" viewBox="0 0 650 278" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>Forward and reverse steps of the diffusion chain</title>
    <desc id={`${id}-w-d`}>A row of four pixel tiles: x0, the image; x t minus 1; x t; and x T, pure noise, with ellipses between x0 and x t minus 1 and between x t and x T. A curved arrow above goes from x t minus 1 to x t, labelled q of x t given x t minus 1, fixed forward step. A curved blue arrow below goes back from x t to x t minus 1, labelled p theta of x t minus 1 given x t, the probability density to invert, learned with network parameters theta.</desc>

    {wide.map((t) => (
      <g>
        {t.cells.map((c) => <rect x={c.x} y={c.y} width={c.w} height={c.w} fill="var(--ink)" fill-opacity={c.o} />)}
        <rect x={t.frame.x} y={t.frame.y} width={t.frame.w} height={t.frame.w} fill="none" stroke="var(--ink)" stroke-width="1.1" />
      </g>
    ))}
    {nodes.map((n, k) => (
      <g>
        <text class="f-math" x={W.xs[k]} y={W.y + h + 26} text-anchor="middle">x<tspan dy="5" font-size="13">{n.sub}</tspan></text>
        {n.note && <text class={`f-label ${n.tone}`} x={W.xs[k]} y={W.y - h - 12} text-anchor="middle">{n.note}</text>}
      </g>
    ))}
    {W.dots.map((x) => <text class="f-math" x={x} y={W.y + 6} text-anchor="middle">⋯</text>)}

    {/* fixed forward moves outside the highlighted pair */}
    <path class="f-thin f-muted" d={`M ${W.xs[0] + h + 8} ${W.y} H ${W.dots[0] - 18}`} marker-end="url(#f-arrow-muted)" />
    <path class="f-thin f-muted" d={`M ${W.dots[0] + 18} ${W.y} H ${W.xs[1] - h - 8}`} marker-end="url(#f-arrow-muted)" />
    <path class="f-thin f-muted" d={`M ${W.xs[2] + h + 8} ${W.y} H ${W.dots[1] - 18}`} marker-end="url(#f-arrow-muted)" />
    <path class="f-thin f-muted" d={`M ${W.dots[1] + 18} ${W.y} H ${W.xs[3] - h - 8}`} marker-end="url(#f-arrow-muted)" />

    {/* forward step q(x_t | x_{t-1}) above */}
    <path class="f-line" d={`M ${W.xs[1] + 12} ${W.y - h - 6} Q ${midW} ${W.y - h - 62} ${W.xs[2] - 12} ${W.y - h - 6}`} marker-end="url(#f-arrow)" />
    <text class="f-math" x={midW} y={W.y - h - 54} text-anchor="middle">q(xₜ | xₜ₋₁)</text>
    <text class="f-note" x={W.xs[2] + 44} y={W.y - h - 30}>fixed: adds noise</text>

    {/* reverse step p_theta(x_{t-1} | x_t) below */}
    <path class="f-line f-blue" d={`M ${W.xs[2] - 6} ${W.y + h + 38} Q ${midW} ${W.y + h + 92} ${W.xs[1] + 6} ${W.y + h + 38}`} marker-end="url(#f-arrow-blue)" />
    <text class="f-math f-t-blue" x={midW} y={W.y + h + 100} text-anchor="middle">p<tspan dy="5" font-size="13">θ</tspan><tspan dy="-5">(xₜ₋₁ | xₜ)</tspan></text>
    <text class="f-label f-t-blue" x={W.xs[2] + 40} y={W.y + h + 72}>pdf to invert:</text>
    <text class="f-note" x={W.xs[2] + 40} y={W.y + h + 92}>learned; θ: NN parameters</text>
  </svg>

  <svg class="fig-narrow" viewBox="0 0 360 540" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>Forward and reverse steps of the diffusion chain</title>
    <desc id={`${id}-n-d`}>A column of four pixel tiles from top to bottom: x0, the image; x t minus 1; x t; and x T, pure noise, with vertical ellipses in between. On the right a curved arrow goes down from x t minus 1 to x t, labelled q of x t given x t minus 1, fixed. On the left a curved blue arrow goes up from x t to x t minus 1, labelled p theta of x t minus 1 given x t, the learned probability density to invert.</desc>

    {narrow.map((t) => (
      <g>
        {t.cells.map((c) => <rect x={c.x} y={c.y} width={c.w} height={c.w} fill="var(--ink)" fill-opacity={c.o} />)}
        <rect x={t.frame.x} y={t.frame.y} width={t.frame.w} height={t.frame.w} fill="none" stroke="var(--ink)" stroke-width="1.1" />
      </g>
    ))}
    {nodes.map((n, k) => (
      <g>
        <text class="f-math" x={Nn.x + hn + 12} y={Nn.ys[k] + 6}>x<tspan dy="5" font-size="13">{n.sub}</tspan></text>
        {n.note && <text class={`f-label ${n.tone}`} x={Nn.x - hn - 12} y={Nn.ys[k] + 5} text-anchor="end">{n.note}</text>}
      </g>
    ))}
    {Nn.dots.map((y) => <text class="f-math" x={Nn.x} y={y + 6} text-anchor="middle">⋮</text>)}
    <path class="f-thin f-muted" d={`M ${Nn.x} ${Nn.ys[0] + hn + 6} V ${Nn.dots[0] - 14}`} marker-end="url(#f-arrow-muted)" />
    <path class="f-thin f-muted" d={`M ${Nn.x} ${Nn.dots[0] + 14} V ${Nn.ys[1] - hn - 6}`} marker-end="url(#f-arrow-muted)" />
    <path class="f-thin f-muted" d={`M ${Nn.x} ${Nn.ys[2] + hn + 6} V ${Nn.dots[1] - 14}`} marker-end="url(#f-arrow-muted)" />
    <path class="f-thin f-muted" d={`M ${Nn.x} ${Nn.dots[1] + 14} V ${Nn.ys[3] - hn - 6}`} marker-end="url(#f-arrow-muted)" />

    {/* forward on the right */}
    <path class="f-line" d={`M ${Nn.x + 16} ${Nn.ys[1] + hn + 6} Q ${Nn.x + 96} ${midN} ${Nn.x + 16} ${Nn.ys[2] - hn - 6}`} marker-end="url(#f-arrow)" />
    <text class="f-math" x={Nn.x + 64} y={midN + 6}>q(xₜ | xₜ₋₁)</text>
    <text class="f-note" x={Nn.x + 64} y={midN + 26}>fixed</text>

    {/* reverse on the left */}
    <path class="f-line f-blue" d={`M ${Nn.x - 16} ${Nn.ys[2] - hn - 6} Q ${Nn.x - 96} ${midN} ${Nn.x - 16} ${Nn.ys[1] + hn + 6}`} marker-end="url(#f-arrow-blue)" />
    <text class="f-math f-t-blue" x={Nn.x - 64} y={midN + 6} text-anchor="end">p<tspan dy="5" font-size="13">θ</tspan><tspan dy="-5">(xₜ₋₁ | xₜ)</tspan></text>
    <text class="f-note" x={Nn.x - 64} y={midN + 26} text-anchor="end">pdf to invert</text>
    <text class="f-note" x={Nn.x - 64} y={midN + 44} text-anchor="end">(learned)</text>
  </svg>
</Figure>
