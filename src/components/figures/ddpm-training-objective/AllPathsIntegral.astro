---
import Figure from '../Figure.astro';
import { normals, polyline, type Point } from '../geometry';

const id = 'ddpm-training-objective-paths';

// Each path is a smooth random bridge from a noise sample to x0:
// position = straight line + sum_k Z_k sqrt(2) sin(k pi s) / (k pi)  (first terms of a Brownian bridge).
const nPaths = 11;
const modes = 4;
const z = normals(nPaths * modes + nPaths * 2, 7);

type Layout = {
  x0: Point; // the image
  starts: Point[]; // noise samples x_T
  amp: number; // bridge amplitude in px
  perp: Point; // unit direction of the wiggle
};

function bridge(L: Layout, k: number): Point[] {
  const start = L.starts[k % L.starts.length];
  const pts: Point[] = [];
  for (let i = 0; i <= 40; i += 1) {
    const s = i / 40;
    let w = 0;
    for (let m = 1; m <= modes; m += 1) w += (z[k * modes + m - 1] * Math.SQRT2 * Math.sin(m * Math.PI * s)) / (m * Math.PI);
    const x = start[0] + (L.x0[0] - start[0]) * s + L.perp[0] * L.amp * w;
    const y = start[1] + (L.x0[1] - start[1]) * s + L.perp[1] * L.amp * w;
    pts.push([x, y]);
  }
  return pts;
}

// Noise samples spread inside the noise blob (deterministic).
const extra = z.slice(nPaths * modes);
const wideL: Layout = {
  x0: [112, 176],
  starts: Array.from({ length: nPaths }, (_, k) => [488 + 26 * extra[2 * k], 176 + 48 * extra[2 * k + 1]] as Point),
  amp: 70,
  perp: [0, 1],
};
wideL.starts[0] = [534, 196];
const narrowL: Layout = {
  x0: [176, 108],
  starts: Array.from({ length: nPaths }, (_, k) => [180 + 40 * extra[2 * k], 420 + 18 * extra[2 * k + 1]] as Point),
  amp: 62,
  perp: [1, 0],
};
narrowL.starts[0] = [186, 416];

const widePaths = Array.from({ length: nPaths }, (_, k) => bridge(wideL, k));
const narrowPaths = Array.from({ length: nPaths }, (_, k) => bridge(narrowL, k));
// One highlighted path with a few intermediate states marked.
const marks = [10, 20, 30];
// The red "can't compute" callout points at the lowest dashed path where the bundle is dense.
const redIdx = 27;
const redTarget = widePaths.slice(1).map((p) => p[redIdx]).reduce((a, b) => (b[1] > a[1] ? b : a));
---

<Figure
  id={id}
  title="The likelihood integral sums over every path from noise to the image"
  caption="The exact likelihood integrates the joint reverse density over all intermediate states, from x₁ to the last, pure-noise state. Every value of these states is one path from a noise sample to the image x₀ (the last state is integrated over too, so paths start anywhere in the noise). With image-sized states and hundreds of steps, we cannot compute all of these paths. The paths are smooth random bridges drawn with a fixed seed."
  origin="expanded"
  pages="41"
>
  <svg class="fig-wide" viewBox="0 0 620 330" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>Many paths from noise to an image</title>
    <desc id={`${id}-w-d`}>Two ovals: images on the left containing the point x0, noise on the right containing the point x T and other noise samples. Many dashed wiggly paths run from points in the noise oval to x0. One path is highlighted in blue with three intermediate dots labelled one path equals one value of x 1 to T. Above, the integral of p theta of x 0 to T over x 1 to T. Below, a red note: we can't really compute all of these paths.</desc>

    <text class="f-math" x="310" y="28" text-anchor="middle">−log ∫ p<tspan dy="5" font-size="13">θ</tspan><tspan dy="-5">(x</tspan><tspan dy="5" font-size="13">0:T</tspan><tspan dy="-5">) dx</tspan><tspan dy="5" font-size="13">1:T</tspan></text>

    <ellipse class="f-fill-red" cx="122" cy="176" rx="82" ry="104" stroke="var(--fig-red)" stroke-width="1.5" />
    <ellipse class="f-fill-blue" cx="500" cy="176" rx="82" ry="104" stroke="var(--fig-blue)" stroke-width="1.5" />
    <text class="f-label f-t-red" x="122" y="62" text-anchor="middle">images</text>
    <text class="f-label f-t-blue" x="500" y="62" text-anchor="middle">noise</text>

    {widePaths.slice(1).map((p) => <path class="f-thin f-muted f-dash" d={polyline(p)} />)}
    <path class="f-line f-blue" d={polyline(widePaths[0])} marker-end="url(#f-arrow-blue)" />
    {marks.map((i) => <circle class="f-solid-blue" cx={widePaths[0][i][0]} cy={widePaths[0][i][1]} r="3.5" />)}
    {wideL.starts.slice(1).map(([x, y]) => <circle class="f-solid-muted" cx={x} cy={y} r="2.5" />)}
    <circle class="f-fill-ink" cx={wideL.starts[0][0]} cy={wideL.starts[0][1]} r="4" />
    <text class="f-math f-halo" x={wideL.starts[0][0] + 9} y={wideL.starts[0][1] + 20}>x<tspan dy="5" font-size="13">T</tspan></text>
    <circle class="f-fill-ink" cx={wideL.x0[0]} cy={wideL.x0[1]} r="4.5" />
    <text class="f-math f-halo" x={wideL.x0[0] - 12} y={wideL.x0[1] + 6} text-anchor="end">x<tspan dy="5" font-size="13">0</tspan></text>

    <text class="f-note" x="310" y="70" text-anchor="middle">one path = one value of x<tspan dy="4" font-size="10">1:T</tspan></text>
    <path class="f-thin f-muted" d={`M 300 76 Q ${widePaths[0][20][0] - 4} 96 ${widePaths[0][20][0]} ${widePaths[0][20][1] - 8}`} marker-end="url(#f-arrow-muted)" />

    <text class="f-label f-t-red" x="310" y="318" text-anchor="middle">can't really compute all of these paths</text>
    <path class="f-thin f-red" d={`M 270 300 Q 262 ${redTarget[1] + 30} ${redTarget[0]} ${redTarget[1] + 6}`} marker-end="url(#f-arrow-red)" />
  </svg>

  <svg class="fig-narrow" viewBox="0 0 360 560" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>Many paths from noise to an image</title>
    <desc id={`${id}-n-d`}>Two ovals: images at the top containing x0, noise at the bottom containing x T and other noise samples. Many dashed wiggly paths run upward from the noise oval to x0; one is highlighted in blue with three dots, one path equals one value of x 1 to T. Below, a red note: we can't really compute all of these paths.</desc>

    <text class="f-math" x="180" y="24" text-anchor="middle">−log ∫ p<tspan dy="5" font-size="13">θ</tspan><tspan dy="-5">(x</tspan><tspan dy="5" font-size="13">0:T</tspan><tspan dy="-5">) dx</tspan><tspan dy="5" font-size="13">1:T</tspan></text>
    <ellipse class="f-fill-red" cx="180" cy="110" rx="110" ry="56" stroke="var(--fig-red)" stroke-width="1.5" />
    <ellipse class="f-fill-blue" cx="180" cy="420" rx="110" ry="56" stroke="var(--fig-blue)" stroke-width="1.5" />
    <text class="f-label f-t-red" x="352" y="76" text-anchor="end">images</text>
    <text class="f-label f-t-blue" x="300" y="490" text-anchor="end">noise</text>

    {narrowPaths.slice(1).map((p) => <path class="f-thin f-muted f-dash" d={polyline(p)} />)}
    <path class="f-line f-blue" d={polyline(narrowPaths[0])} marker-end="url(#f-arrow-blue)" />
    {marks.map((i) => <circle class="f-solid-blue" cx={narrowPaths[0][i][0]} cy={narrowPaths[0][i][1]} r="3.5" />)}
    {narrowL.starts.slice(1).map(([x, y]) => <circle class="f-solid-muted" cx={x} cy={y} r="2.5" />)}
    <circle class="f-fill-ink" cx={narrowL.starts[0][0]} cy={narrowL.starts[0][1]} r="4" />
    <text class="f-math f-halo" x={narrowL.starts[0][0] + 10} y={narrowL.starts[0][1] + 22}>x<tspan dy="5" font-size="13">T</tspan></text>
    <circle class="f-fill-ink" cx={narrowL.x0[0]} cy={narrowL.x0[1]} r="4.5" />
    <text class="f-math f-halo" x={narrowL.x0[0]} y={narrowL.x0[1] - 14} text-anchor="middle">x<tspan dy="5" font-size="13">0</tspan></text>

    <text class="f-note f-halo" x="352" y="198" text-anchor="end">one path =</text>
    <text class="f-note f-halo" x="352" y="216" text-anchor="end">one x<tspan dy="4" font-size="10">1:T</tspan></text>
    <path class="f-thin f-muted" d={`M 322 228 Q 322 ${narrowPaths[0][20][1]} ${narrowPaths[0][20][0] + 9} ${narrowPaths[0][20][1]}`} marker-end="url(#f-arrow-muted)" />

    <text class="f-label f-t-red" x="180" y="526" text-anchor="middle">can't really compute</text>
    <text class="f-label f-t-red" x="180" y="546" text-anchor="middle">all of these paths</text>
  </svg>
</Figure>
