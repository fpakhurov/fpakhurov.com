---
import Figure from '../Figure.astro';

const id = 'ddpm-training-objective-posterior';

type Pt = { x: number; y: number };
type Layout = { prev: Pt; cur: Pt; orig: Pt; r: number };
const Wl: Layout = { prev: { x: 196, y: 132 }, cur: { x: 432, y: 132 }, orig: { x: 432, y: 272 }, r: 29 };
const Nl: Layout = { prev: { x: 84, y: 136 }, cur: { x: 276, y: 136 }, orig: { x: 276, y: 290 }, r: 27 };

// Point on a circle at angle a (degrees, 0 = right, 90 = down).
const on = (c: Pt, r: number, a: number) => ({ x: c.x + r * Math.cos((a * Math.PI) / 180), y: c.y + r * Math.sin((a * Math.PI) / 180) });
const f = (v: number) => v.toFixed(1);

function arcs(L: Layout, lift: number, dip: number, sweep: number) {
  const { prev, cur, orig, r } = L;
  const mid = (prev.x + cur.x) / 2;
  const a1 = on(prev, r + 4, -50);
  const b1 = on(cur, r + 6, -130);
  const fwd = `M ${f(a1.x)} ${f(a1.y)} Q ${f(mid)} ${f(prev.y - lift)} ${f(b1.x)} ${f(b1.y)}`;
  const a2 = on(cur, r + 4, 150);
  const b2 = on(prev, r + 6, 30);
  const back = `M ${f(a2.x)} ${f(a2.y)} Q ${f(mid)} ${f(prev.y + dip)} ${f(b2.x)} ${f(b2.y)}`;
  const a3 = on(orig, r + 4, 160);
  const b3 = on(prev, r + 6, 95);
  const post = `M ${f(a3.x)} ${f(a3.y)} Q ${f(prev.x + sweep * 0.2)} ${f(orig.y + 40)} ${f(b3.x)} ${f(b3.y)}`;
  const dep = `M ${cur.x} ${cur.y + r + 4} V ${orig.y - r - 4}`;
  return {
    fwd, back, post, dep, mid,
    fwdPeak: 0.25 * a1.y + 0.5 * (prev.y - lift) + 0.25 * b1.y,
    backValley: 0.25 * a2.y + 0.5 * (prev.y + dip) + 0.25 * b2.y,
  };
}
const aw = arcs(Wl, 120, 80, 10);
const an = arcs(Nl, 110, 76, 0);
---

<Figure
  id={id}
  title="Forward step, model step and the true posterior"
  caption="x₀ is the original image, xₜ₋₁ is noisy and xₜ is more noisy. The forward step q(xₜ | xₜ₋₁) adds noise. The model's reverse diffusion step pθ(xₜ₋₁ | xₜ) only sees xₜ. The true posterior q(xₜ₋₁ | xₜ, x₀) goes back to xₜ₋₁ too, but it also uses x₀; it has a closed form, yet it cannot be used for generation, where no image is available. The dotted line groups xₜ and x₀: the true posterior conditions on both."
  origin="redrawn"
  pages="42"
>
  <svg class="fig-wide" viewBox="0 0 640 350" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>Graph of x t minus 1, x t and x 0 with three conditional distributions</title>
    <desc id={`${id}-w-d`}>Three circled nodes: x t minus 1 on the left, tagged noisy; x t on the right, tagged more noisy; and x 0 below x t, tagged original image. A solid arrow arcs over the top from x t minus 1 to x t, labelled q of x t given x t minus 1. A dashed blue arrow returns from x t to x t minus 1, labelled p theta of x t minus 1 given x t, the reverse diffusion step. A dotted line links x t and x 0, grouping the two conditions of the true posterior. A green arrow sweeps from x 0 along the bottom to x t minus 1, labelled q of x t minus 1 given x t and x 0, the true posterior.</desc>

    {/* tag boxes, joined to their nodes by dotted lines */}
    <rect class="f-box-soft" x="28" y="114" width="88" height="36" rx="4" />
    <text class="f-label" x="72" y="137" text-anchor="middle">noisy</text>
    <path class="f-thin f-dot" d={`M 116 132 H ${Wl.prev.x - Wl.r - 4}`} />
    <rect class="f-box-soft" x="500" y="114" width="112" height="36" rx="4" />
    <text class="f-label" x="556" y="137" text-anchor="middle">more noisy</text>
    <path class="f-thin f-dot" d={`M ${Wl.cur.x + Wl.r + 4} 132 H 500`} />
    <rect class="f-box-soft" x="500" y="244" width="112" height="56" rx="4" />
    <text class="f-label f-t-red" x="556" y="267" text-anchor="middle">original</text>
    <text class="f-label f-t-red" x="556" y="287" text-anchor="middle">image</text>
    <path class="f-thin f-dot" d={`M ${Wl.orig.x + Wl.r + 4} 272 H 500`} />

    <path class="f-line" d={aw.fwd} marker-end="url(#f-arrow)" />
    <text class="f-math" x={aw.mid} y={aw.fwdPeak - 16} text-anchor="middle">q(xₜ | xₜ₋₁)</text>

    <path class="f-line f-blue f-dash" d={aw.back} marker-end="url(#f-arrow-blue)" />
    <text class="f-math f-t-blue" x={aw.mid} y={aw.backValley + 28} text-anchor="middle">p<tspan dy="5" font-size="13">θ</tspan><tspan dy="-5">(xₜ₋₁ | xₜ)</tspan></text>
    <text class="f-note" x={aw.mid} y={aw.backValley + 47} text-anchor="middle">reverse diffusion step</text>

    <path class="f-thin f-muted f-dot" d={aw.dep} />

    <path class="f-line f-green" d={aw.post} marker-end="url(#f-arrow-green)" />
    <text class="f-math f-t-green" x="292" y="318" text-anchor="middle">q(xₜ₋₁ | xₜ, x<tspan dy="5" font-size="13">0</tspan><tspan dy="-5">)</tspan></text>
    <text class="f-note" x="292" y="338" text-anchor="middle">“true posterior”: needs x₀</text>

    {[{ c: Wl.prev, s: 't−1' }, { c: Wl.cur, s: 't' }, { c: Wl.orig, s: '0' }].map(({ c, s }) => (
      <g>
        <circle class="f-box" cx={c.x} cy={c.y} r={Wl.r} />
        <text class="f-math" x={c.x - (s.length > 1 ? 3 : 0)} y={c.y + 4} text-anchor="middle">x<tspan dy="5" font-size="13">{s}</tspan></text>
      </g>
    ))}
  </svg>

  <svg class="fig-narrow" viewBox="0 0 360 400" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>Graph of x t minus 1, x t and x 0 with three conditional distributions</title>
    <desc id={`${id}-n-d`}>Three circled nodes: x t minus 1 on the left, noisy; x t on the right, more noisy; x 0 below x t, original image. A solid arrow arcs over the top from x t minus 1 to x t, labelled q of x t given x t minus 1. A dashed blue arrow returns from x t to x t minus 1, labelled p theta of x t minus 1 given x t. A dotted line links x t and x 0, grouping the two conditions of the true posterior. A green arrow sweeps from x 0 to x t minus 1, labelled q of x t minus 1 given x t and x 0, the true posterior.</desc>

    <text class="f-note" x={Nl.prev.x - 30} y={Nl.prev.y - 34} text-anchor="middle">noisy</text>
    <text class="f-note" x={Nl.cur.x + 26} y={Nl.cur.y - 34} text-anchor="middle">more noisy</text>
    <text class="f-note f-t-red" x={Nl.orig.x + 34} y={Nl.orig.y + 44} text-anchor="middle">original image</text>

    <path class="f-line" d={an.fwd} marker-end="url(#f-arrow)" />
    <text class="f-math" x={an.mid} y={an.fwdPeak - 16} text-anchor="middle">q(xₜ | xₜ₋₁)</text>

    <path class="f-line f-blue f-dash" d={an.back} marker-end="url(#f-arrow-blue)" />
    <text class="f-math f-t-blue" x={an.mid} y={an.backValley + 28} text-anchor="middle">p<tspan dy="5" font-size="13">θ</tspan><tspan dy="-5">(xₜ₋₁ | xₜ)</tspan></text>

    <path class="f-thin f-muted f-dot" d={an.dep} />

    <path class="f-line f-green" d={an.post} marker-end="url(#f-arrow-green)" />
    <text class="f-math f-t-green" x="128" y="350" text-anchor="middle">q(xₜ₋₁ | xₜ, x<tspan dy="5" font-size="13">0</tspan><tspan dy="-5">)</tspan></text>
    <text class="f-note" x="128" y="370" text-anchor="middle">“true posterior”</text>

    {[{ c: Nl.prev, s: 't−1' }, { c: Nl.cur, s: 't' }, { c: Nl.orig, s: '0' }].map(({ c, s }) => (
      <g>
        <circle class="f-box" cx={c.x} cy={c.y} r={Nl.r} />
        <text class="f-math" x={c.x - (s.length > 1 ? 3 : 0)} y={c.y + 4} text-anchor="middle">x<tspan dy="5" font-size="13">{s}</tspan></text>
      </g>
    ))}
  </svg>
</Figure>
