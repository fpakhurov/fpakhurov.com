---
import Figure from '../Figure.astro';
import { polyline, scale, type Point } from '../geometry';

const id = 'ddpm-training-objective-weight';

// Linear schedule of Ho et al.: T = 1000, beta from 1e-4 to 0.02.
const T = 1000;
const beta = Array.from({ length: T + 1 }, (_, t) => (t === 0 ? 0 : 1e-4 + ((0.02 - 1e-4) * (t - 1)) / (T - 1)));
const alpha = beta.map((b) => 1 - b);
const abar: number[] = [1];
for (let t = 1; t <= T; t += 1) abar.push(abar[t - 1] * alpha[t]);
const betaTilde = (t: number) => ((1 - abar[t - 1]) / (1 - abar[t])) * beta[t];
// w_t = beta_t^2 / (2 sigma_t^2 alpha_t (1 - abar_t)) for t >= 2.
const weight = (t: number, s2: number) => (beta[t] * beta[t]) / (2 * s2 * alpha[t] * (1 - abar[t]));
const wBeta = (t: number) => weight(t, beta[t]);
const wTilde = (t: number) => weight(t, betaTilde(t));

let tMin = 2;
for (let t = 2; t <= T; t += 1) if (wBeta(t) < wBeta(tMin)) tMin = t;

const ts: number[] = [];
for (let t = 2; t <= 100; t += 1) ts.push(t);
for (let t = 105; t <= T; t += 5) ts.push(t);
const fmt = (v: number, d = 3) => v.toFixed(d);

// Both axes are logarithmic: the two variance choices differ only over the first few dozen steps.
type Box = { cls: string; vb: string; left: number; right: number; top: number; bottom: number; xTicks: number[]; yTicks: number[]; sfx: string };
const layouts: Box[] = [
  { cls: 'fig-wide', vb: '0 0 600 330', left: 70, right: 560, top: 30, bottom: 270, xTicks: [1, 2, 5, 10, 20, 50, 100, 200, 500, 1000], yTicks: [0.005, 0.01, 0.05, 0.1, 0.5, 1], sfx: 'w' },
  { cls: 'fig-narrow', vb: '0 0 360 330', left: 62, right: 330, top: 30, bottom: 270, xTicks: [1, 10, 100, 1000], yTicks: [0.005, 0.01, 0.1, 1], sfx: 'n' },
];
const lo = Math.log10(0.002);
const hi = Math.log10(2);
const panels = layouts.map((L) => {
  const sxl = scale([0, Math.log10(T)], [L.left, L.right]);
  const sx = (t: number) => sxl(Math.log10(t));
  const syl = scale([lo, hi], [L.bottom, L.top]);
  const sy = (w: number) => syl(Math.log10(w));
  return {
    L, sx, sy,
    curveBeta: polyline(ts.map((t) => [sx(t), sy(wBeta(t))] as Point)),
    curveTilde: polyline(ts.map((t) => [sx(t), sy(wTilde(t))] as Point)),
    p2: { x: sx(2), y: sy(wBeta(2)), v: wBeta(2) },
    q2: { x: sx(2), y: sy(wTilde(2)), v: wTilde(2) },
    pMin: { x: sx(tMin), y: sy(wBeta(tMin)), v: wBeta(tMin) },
    pEnd: { x: sx(T), y: sy(wBeta(T)), v: wBeta(T) },
  };
});
---

<Figure
  id={id}
  title="The bound's weight favours the nearly clean steps"
  caption={`Weight wₜ = βₜ² / (2σₜ² αₜ (1 − ᾱₜ)) of the weighted noise-prediction loss for the linear schedule (T = 1000, β from 10⁻⁴ to 0.02); both axes are logarithmic. With σₜ² = βₜ it is ${fmt(wBeta(2))} at t = 2, has its minimum ${fmt(wBeta(tMin), 4)} at t = ${tMin} and ends at ${fmt(wBeta(T), 4)}. With σₜ² set to the true posterior variance (dashed) it is always larger, by the ratio of the two variances (it is ${fmt(wTilde(2))} at t = 2), but the gap matters only for the first few dozen steps. DDPM's simple loss uses wₜ = 1 for every step (only its relative shape matters), so compared with the bound it shifts weight towards the noisier steps.`}
  origin="illustrative"
  pages="44"
>
  {panels.map(({ L, sx, sy, curveBeta, curveTilde, p2, q2, pMin, pEnd }) => (
    <svg class={L.cls} viewBox={L.vb} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>Loss weight against the timestep</title>
      <desc id={`${id}-${L.sfx}-d`}>A log-log plot of the weight w t against t from 1 to 1000. The blue curve for sigma squared equal to beta t starts at {fmt(p2.v)} at t equals 2, drops steeply, reaches a minimum of {fmt(pMin.v, 4)} at t equals {tMin} and rises to {fmt(pEnd.v, 4)} at t equals 1000. A dashed grey curve for sigma squared equal to beta tilde t starts higher, at {fmt(q2.v)}, and merges with the blue curve within a few dozen steps. A flat green line at 1 marks the simple loss.</desc>

      {L.yTicks.map((v) => <line class="f-grid" x1={L.left} x2={L.right} y1={sy(v)} y2={sy(v)} />)}
      {L.yTicks.map((v) => <text class="f-note" x={L.left - 10} y={sy(v) + 5} text-anchor="end">{v}</text>)}
      {L.xTicks.map((v) => <text class="f-note" x={sx(v)} y={L.bottom + 22} text-anchor="middle">{v}</text>)}
      <path class="f-axis" d={`M ${L.left} ${L.bottom} H ${L.right + 20}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-axis" d={`M ${L.left} ${L.bottom} V ${L.top - 12}`} marker-end="url(#f-arrow-muted)" />
      <text class="f-label" x={L.right + 20} y={L.bottom + 44} text-anchor="end"><tspan style="font-family: var(--serif); font-style: italic; font-size: 18px">t</tspan> (log scale)</text>
      <text class="f-label" transform={`translate(${L.left - 48} ${(L.top + L.bottom) / 2}) rotate(-90)`} text-anchor="middle">weight wₜ (log scale)</text>

      <line class="f-line f-green" x1={sx(1)} x2={L.right} y1={sy(1)} y2={sy(1)} />
      <text class="f-label f-t-green" x={L.right - 4} y={sy(1) - 10} text-anchor="end">L<tspan dy="4" font-size="11">simple</tspan><tspan dy="-4">: wₜ = 1</tspan></text>

      <path class="f-line f-muted f-dash" d={curveTilde} />
      <path class="f-line f-blue f-bold" d={curveBeta} />

      <circle class="f-solid-blue" cx={p2.x} cy={p2.y} r="4.5" />
      <text class="f-small" x={p2.x} y={p2.y + 24} text-anchor="middle">{fmt(p2.v)}</text>
      <circle class="f-solid-muted" cx={q2.x} cy={q2.y} r="3.5" />
      <circle class="f-solid-blue" cx={pMin.x} cy={pMin.y} r="4.5" />
      <text class="f-small" x={pMin.x - 8} y={pMin.y + 18} text-anchor="end">min {fmt(pMin.v, 4)} at t = {tMin}</text>
      <circle class="f-solid-blue" cx={pEnd.x} cy={pEnd.y} r="4.5" />
      <text class="f-small" x={pEnd.x - 4} y={pEnd.y - 12} text-anchor="end">{fmt(pEnd.v, 4)}</text>

      <text class="f-label f-t-blue" x={sx(3)} y={sy(0.025)}>σₜ² = βₜ</text>
      <path class="f-thin f-blue" d={`M ${sx(3) + 66} ${sy(0.025) - 6} Q ${sx(24)} ${sy(0.025) - 6} ${sx(24) + 2} ${sy(wBeta(24)) + 7}`} marker-end="url(#f-arrow-blue)" />
      <text class="f-label f-t-muted" x={sx(6)} y={sy(0.45)}>σₜ² = <tspan style="font-family: var(--serif)">β̃</tspan><tspan dy="4" font-size="11">t</tspan><tspan dy="-4"> (dashed)</tspan></text>
      <path class="f-thin f-muted" d={`M ${sx(6) - 5} ${sy(0.45) - 5} Q ${sx(3.6)} ${sy(0.45) - 5} ${sx(3) + 3} ${sy(wTilde(3)) - 7}`} marker-end="url(#f-arrow-muted)" />
    </svg>
  ))}
</Figure>
