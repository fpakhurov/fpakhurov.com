---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import Sub from '../generative-modeling/Sub.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The denoising U-Net of DDPM for 32 x 32 images (Ho et al. 2020, App. B): four resolutions 32 -> 16 -> 8 -> 4 and back,
// skip connections between levels of equal size, self-attention at 16 x 16, and the timestep embedding
// (sinusoidal code -> MLP -> per-block projection) added to every block. Colours follow the seqflow series:
// inputs green, states blue, learned maps amber, output red.
const t = ru
  ? {
      attn: '+ внимание', skip: 'обходная связь', skipShort: 'обход', sincos: 'sin, cos', mlp: 'MLP', add: 'в каждый блок: + A_k m(t)', addShort: '+ A_k m(t)',
      loss: '‖ε − ε_θ‖²',
      steps: [
        'xₜ спускается по энкодеру: каждый уровень вдвое уменьшает разрешение, на 16 × 16 добавлен self-attention',
        'шаг t превращается в вектор синусов и косинусов e(t)',
        'MLP переводит e(t) в m(t); каждый блок прибавляет к своим каналам свою проекцию Aₖ m(t)',
        'декодер вдвое увеличивает разрешение; обходные связи приносят признаки энкодера того же размера',
        'выход ε_θ(xₜ, t) имеет форму xₜ и сравнивается с истинным шумом ε',
      ],
    }
  : {
      attn: '+ attention', skip: 'skip connection', skipShort: 'skip', sincos: 'sin, cos', mlp: 'MLP', add: 'into every block: + A_k m(t)', addShort: '+ A_k m(t)',
      loss: '‖ε − ε_θ‖²',
      steps: [
        'xₜ goes down the encoder: each level halves the resolution, with self-attention at 16 × 16',
        'the step t becomes a vector of sines and cosines e(t)',
        'an MLP maps e(t) to m(t); every block adds its own projection Aₖ m(t) to its channels',
        'the decoder doubles the resolution back; skip connections bring the encoder features of the same size',
        'the output ε_θ(xₜ, t) has the shape of xₜ and is compared with the true noise ε',
      ],
    };

const res = ['32 × 32', '16 × 16', '8 × 8'];
const shape = '3 × 32 × 32';
const id = 'ddpm-denoiser-flow';

// Wide layout: a U drawn left to right. Encoder blocks step down to the right, decoder blocks step up.
const bw = 104, bh = 44;
const rows = [56, 136, 216];
const midY = 296;
const encX = [120, 170, 220];
const decX = [536, 486, 436];
const mid = { x: 300, w: 160 };
const busY = 352;
const timeY = 380;
const wide = {
  enc: encX.map((x, k) => ({ x, y: rows[k] })),
  dec: decX.map((x, k) => ({ x, y: rows[k] })),
  // vertical arrows from the time bus into every block, placed where no other box lies above
  taps: [
    { x: 130, y: rows[0] + bh }, { x: 180, y: rows[1] + bh }, { x: 230, y: rows[2] + bh },
    { x: 380, y: midY + bh }, { x: 530, y: rows[2] + bh }, { x: 580, y: rows[1] + bh }, { x: 630, y: rows[0] + bh },
  ],
  down: [
    [[197, rows[0] + bh], [197, rows[1] - 2]], [[247, rows[1] + bh], [247, rows[2] - 2]], [[312, rows[2] + bh], [312, midY - 2]],
  ] as [number, number][][],
  up: [
    [[448, midY], [448, rows[2] + bh + 2]], [[513, rows[2]], [513, rows[1] + bh + 2]], [[563, rows[1]], [563, rows[0] + bh + 2]],
  ] as [number, number][][],
};
// Narrow layout: encoder in the left column, decoder in the right, the time bus around the outside.
const nb = { w: 130, h: 44 };
const nRows = [92, 164, 236];
const nMid = { x: 110, y: 308, w: 140 };
const nBus = 374;
const nTime = 400;
const narrow = {
  enc: nRows.map((y) => ({ x: 20, y })),
  dec: nRows.map((y) => ({ x: 210, y })),
  down: [
    [[85, 64], [85, nRows[0] - 2]], [[85, nRows[0] + nb.h], [85, nRows[1] - 2]], [[85, nRows[1] + nb.h], [85, nRows[2] - 2]], [[130, nRows[2] + nb.h], [130, nMid.y - 2]],
  ] as [number, number][][],
  up: [
    [[230, nMid.y], [230, nRows[2] + nb.h + 2]], [[275, nRows[2]], [275, nRows[1] + nb.h + 2]], [[275, nRows[1]], [275, nRows[0] + nb.h + 2]], [[275, nRows[0]], [275, 66]],
  ] as [number, number][][],
};
const encLabel = (k: number) => res[k];
const encSub = (k: number) => (k === 1 ? t.attn : undefined);
---

<Figure
  id={id}
  title={ru ? 'Денойзер DDPM: U-Net, получающая на вход шаг t' : 'The DDPM denoiser: a U-Net that receives the step t'}
  caption={ru
    ? 'Сеть шумоподавления DDPM для изображений 32 × 32: входы зелёные, состояния синие, обучаемые отображения жёлтые, выход красный. Энкодер уменьшает разрешение до 4 × 4, декодер возвращает его, пунктирные обходные связи соединяют уровни одного размера. Шаг t входит через синусоидальный код и MLP и прибавляется в каждом блоке.'
    : 'DDPM’s denoising U-Net for 32 × 32 images: inputs green, states blue, learned maps amber, output red. The encoder halves the resolution down to 4 × 4, the decoder restores it, and dashed skip connections join levels of equal size. The step t enters through a sinusoidal code and an MLP, added in every block.'}
>
  <svg class="fig-wide" viewBox="0 0 760 450" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{ru ? 'U-Net денойзера DDPM с эмбеддингом шага' : 'The DDPM denoising U-Net with its timestep embedding'}</title>
    <desc id={`${id}-w-d`}>{ru
      ? 'Слева x_t входит в энкодер из трёх блоков 32 на 32, 16 на 16 с вниманием и 8 на 8, спускающихся к среднему блоку 4 на 4; справа декодер поднимается через 8 на 8, 16 на 16 и 32 на 32 к выходу эпсилон тета. Пунктирные обходные связи соединяют блоки одного разрешения. Внизу шаг t превращается в синусоидальный код e(t), MLP даёт m(t), и жёлтая шина со стрелками ведёт его в каждый блок.'
      : 'On the left, x_t enters an encoder of three blocks, 32 by 32, 16 by 16 with attention, and 8 by 8, stepping down to a middle block of 4 by 4; on the right, the decoder climbs back through 8 by 8, 16 by 16 and 32 by 32 to the output epsilon theta. Dashed skip connections join blocks of equal resolution. At the bottom, the step t becomes a sinusoidal code e(t), an MLP gives m(t), and an amber bus with arrows carries it into every block.'}</desc>

    <g data-s="1">
      <Box x={12} y={rows[0] - 5} w={84} h={bh + 10} label="x_t" sub={shape} tone="x" math subGap={19} />
      <Arrow pts={[[96, rows[0] + bh / 2], [118, rows[0] + bh / 2]]} />
      {wide.enc.map((b, k) => <Box x={b.x} y={b.y} w={bw} h={bh} label={encLabel(k)} sub={encSub(k)} tone="h" />)}
      {wide.down.map((p) => <Arrow pts={p} />)}
      <Box x={mid.x} y={midY} w={mid.w} h={bh} label="4 × 4" tone="h" />
    </g>

    <g data-s="2">
      <Box x={12} y={timeY} w={50} h={bh} label="t" tone="x" math />
      <Arrow pts={[[62, timeY + bh / 2], [78, timeY + bh / 2]]} />
      <Box x={80} y={timeY} w={112} h={bh} label="e(t)" sub={t.sincos} tone="x" math />
    </g>

    <g data-s="3">
      <Arrow pts={[[192, timeY + bh / 2], [212, timeY + bh / 2]]} />
      <Box x={214} y={timeY} w={96} h={bh} label={t.mlp} sub="m(t)" tone="g" />
      <Arrow pts={[[262, timeY], [262, busY + 2]]} tone="amber" head={false} />
      <path class="f-line f-amber" d={`M 130 ${busY} H 630`} />
      {wide.taps.map((p) => <Arrow pts={[[p.x, busY], [p.x, p.y + 2]]} tone="amber" />)}
      <text class="f-small f-t-amber f-halo" x={330} y={busY + 20}>{t.add.replace('A_k', 'Aₖ')}</text>
    </g>

    <g data-s="4">
      {wide.up.map((p) => <Arrow pts={p} />)}
      {wide.dec.map((b, k) => <Box x={b.x} y={b.y} w={bw} h={bh} label={encLabel(k)} sub={encSub(k)} tone="h" />)}
      {[0, 1, 2].map((k) => <Arrow pts={[[encX[k] + bw, rows[k] + bh / 2], [decX[k] - 2, rows[k] + bh / 2]]} tone="blue" dashed />)}
      <text class="f-small f-t-blue f-halo" x={380} y={rows[0] + bh / 2 - 8} text-anchor="middle">{t.skip}</text>
    </g>

    <g data-s="5">
      <Arrow pts={[[decX[0] + bw, rows[0] + bh / 2], [662, rows[0] + bh / 2]]} />
      <Box x={664} y={rows[0] - 5} w={84} h={bh + 10} label="ε_θ" sub={shape} tone="y" math subGap={19} />
      <text class="f-small f-t-red" x={706} y={rows[0] + bh + 26} text-anchor="middle"><Sub label={t.loss} /></text>
    </g>

    <Badge x={12} y={rows[0] - 16} n={1} />
    <Badge x={80} y={timeY - 10} n={2} />
    <Badge x={214} y={timeY - 10} n={3} />
    <Badge x={decX[2]} y={rows[2] - 12} n={4} />
    <Badge x={664} y={rows[0] - 16} n={5} />
    <Legend x={360} y={438} step={112} />
  </svg>

  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 520" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{ru ? 'U-Net денойзера DDPM с эмбеддингом шага' : 'The DDPM denoising U-Net with its timestep embedding'}</title>
    <desc id={`${id}-n-d`}>{ru
      ? 'Левая колонка: x_t и энкодер из блоков 32 на 32, 16 на 16 с вниманием и 8 на 8 сверху вниз, затем средний блок 4 на 4. Правая колонка: декодер снизу вверх и выход эпсилон тета. Короткие пунктирные обходные связи соединяют колонки. Внизу t, код e(t) и MLP; жёлтая шина обходит рисунок и подводит m(t) к каждому блоку.'
      : 'Left column: x_t and the encoder blocks 32 by 32, 16 by 16 with attention, and 8 by 8 from top to bottom, then the middle block 4 by 4. Right column: the decoder from bottom to top and the output epsilon theta. Short dashed skip connections join the columns. At the bottom, t, the code e(t) and the MLP; an amber bus runs around the figure and brings m(t) to every block.'}</desc>

    <g data-s="1">
      <Box x={20} y={20} w={nb.w} h={nb.h} label="x_t" tone="x" math />
      {narrow.enc.map((b, k) => <Box x={b.x} y={b.y} w={nb.w} h={nb.h} label={encLabel(k)} sub={encSub(k)} tone="h" subGap={19} />)}
      {narrow.down.map((p) => <Arrow pts={p} />)}
      <Box x={nMid.x} y={nMid.y} w={nMid.w} h={nb.h} label="4 × 4" tone="h" />
    </g>

    <g data-s="2">
      <Box x={20} y={nTime} w={46} h={nb.h} label="t" tone="x" math />
      <Arrow pts={[[66, nTime + nb.h / 2], [78, nTime + nb.h / 2]]} />
      <Box x={80} y={nTime} w={112} h={nb.h} label="e(t)" sub={t.sincos} tone="x" math subGap={19} />
    </g>

    <g data-s="3">
      <Arrow pts={[[192, nTime + nb.h / 2], [208, nTime + nb.h / 2]]} />
      <Box x={210} y={nTime} w={100} h={nb.h} label={t.mlp} sub="m(t)" tone="g" subGap={19} />
      <Arrow pts={[[260, nTime], [260, nBus + 2]]} tone="amber" head={false} />
      <path class="f-line f-amber" d={`M 8 ${nBus} H 352 M 8 ${nBus} V ${nRows[0] + nb.h / 2} M 352 ${nBus} V ${nRows[0] + nb.h / 2}`} />
      {nRows.map((y) => <Arrow pts={[[8, y + nb.h / 2], [18, y + nb.h / 2]]} tone="amber" />)}
      {nRows.map((y) => <Arrow pts={[[352, y + nb.h / 2], [342, y + nb.h / 2]]} tone="amber" />)}
      <Arrow pts={[[180, nBus], [180, nMid.y + nb.h + 2]]} tone="amber" />
      <text class="f-small f-t-amber" x={272} y={nBus + 20}>{t.addShort.replace('A_k', 'Aₖ')}</text>
    </g>

    <g data-s="4">
      {narrow.up.slice(0, 3).map((p) => <Arrow pts={p} />)}
      {narrow.dec.map((b, k) => <Box x={b.x} y={b.y} w={nb.w} h={nb.h} label={encLabel(k)} sub={encSub(k)} tone="h" subGap={19} />)}
      {nRows.map((y) => <Arrow pts={[[150, y + nb.h / 2], [208, y + nb.h / 2]]} tone="blue" dashed />)}
      <text class="f-small f-t-blue" x={180} y={nRows[1] - 8} text-anchor="middle">{t.skipShort}</text>
    </g>

    <g data-s="5">
      <Arrow pts={narrow.up[3]} />
      <Box x={210} y={20} w={nb.w} h={nb.h} label="ε_θ" tone="y" math />
      <text class="f-small f-t-red" x={180} y={82} text-anchor="middle"><Sub label={t.loss} /></text>
    </g>

    <Badge x={20} y={10} n={1} />
    <Badge x={80} y={nTime - 10} n={2} />
    <Badge x={210} y={nTime - 10} n={3} />
    <Badge x={210} y={nRows[2] - 10} n={4} />
    <Badge x={340} y={10} n={5} />
    <Legend x={24} y={476} step={170} rows={2} />
  </svg>
  <Stepper steps={t.steps} />
</Figure>
