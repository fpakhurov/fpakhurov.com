---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Two cores A and B with write-back caches and the MESI protocol, one variable X (0 in memory), five accesses.
// A tiny simulator of the protocol produces the state of each copy after every step; the drawing shows it.
type St = 'M' | 'E' | 'S' | 'I';
interface Line { st: St; v: number }
const cache: Record<'A' | 'B', Line> = { A: { st: 'I', v: 0 }, B: { st: 'I', v: 0 } };
let mem = 0;
const other = (c: 'A' | 'B') => (c === 'A' ? 'B' : 'A');
function read(c: 'A' | 'B') {
  const me = cache[c], o = cache[other(c)];
  if (me.st !== 'I') return;                     // hit
  if (o.st === 'M') { mem = o.v; o.st = 'S'; me.st = 'S'; me.v = o.v; return; }   // the owner supplies and writes back
  if (o.st === 'E' || o.st === 'S') { o.st = 'S'; me.st = 'S'; me.v = mem; return; }
  me.st = 'E'; me.v = mem;                       // nobody else has it
}
function write(c: 'A' | 'B', v: number) {
  const me = cache[c], o = cache[other(c)];
  if (me.st === 'I') { if (o.st === 'M') mem = o.v; me.v = mem; }   // read for ownership
  o.st = 'I';                                    // invalidate the other copy (no-op if it has none)
  me.st = 'M'; me.v = v;
}
const ops: [() => void][] = [[() => read('A')], [() => read('B')], [() => write('A', 1)], [() => read('B')], [() => write('B', 2)]];
const after = ops.map(([op]) => { op(); return { A: { ...cache.A }, B: { ...cache.B }, mem }; });
const code = after.map((s) => `${s.A.st}${s.A.st === 'I' ? '' : s.A.v} ${s.B.st}${s.B.st === 'I' ? '' : s.B.v} ${s.mem}`).join(' | ');
if (code !== 'E0 I 0 | S0 S0 0 | M1 I 0 | S1 S1 1 | I M2 1') throw new Error(`MESI steps: ${code}`);
const before = [{ A: { st: 'I', v: 0 }, B: { st: 'I', v: 0 }, mem: 0 }, ...after.slice(0, -1)];
const changed = after.map((s, k) => ({ A: s.A.st !== before[k].A.st || s.A.v !== before[k].A.v, B: s.B.st !== before[k].B.st || s.B.v !== before[k].B.v, mem: s.mem !== before[k].mem }));

// A semicolon after every part of a split bus message except the last.
const semi = (j: number, count: number) => (j === count - 1 ? '' : ';');
const fill: Record<St, string> = { M: 'f-fill-red', E: 'f-fill-amber', S: 'f-fill-blue', I: 'f-fill-paper' };
const stroke: Record<St, string> = { M: 'f-red', E: 'f-amber', S: 'f-blue', I: 'f-muted' };
const t = ru
  ? { events: ['A читает X', 'B читает X', 'A пишет 1 в X', 'B читает X', 'B пишет 2 в X'],
      bus: ['чтение; отвечает память', 'чтение; A отслеживает его', 'инвалидация X', 'чтение; A отдаёт 1', 'инвалидация X'],
      rows: ['кэш ядра A', 'кэш ядра B', 'шина', 'память'], step: 'шаг', mem: 'X =',
      legend: [['M', 'изменённая'], ['E', 'эксклюзивная'], ['S', 'разделяемая'], ['I', 'недействительная']],
      steps: ['A читает X: промах, других копий нет, строка переходит в E', 'B читает X: A отслеживает запрос, обе копии переходят в S', 'A пишет 1: инвалидация, копия B переходит в I, копия A в M; память устарела', 'B читает X: A отдаёт 1 и записывает его в память, обе копии переходят в S', 'B пишет 2: инвалидация, копия A переходит в I, копия B в M'] }
  : { events: ['A reads X', 'B reads X', 'A writes 1 to X', 'B reads X', 'B writes 2 to X'],
      bus: ['read; memory answers', 'read; A snoops it', 'invalidate X', 'read; A supplies 1', 'invalidate X'],
      rows: ["core A's cache", "core B's cache", 'bus', 'memory'], step: 'step', mem: 'X =',
      legend: [['M', 'modified'], ['E', 'exclusive'], ['S', 'shared'], ['I', 'invalid']],
      steps: ['A reads X: a miss, no other copy, the line goes to E', 'B reads X: A snoops the request, both copies go to S', 'A writes 1: an invalidation, B goes to I, A to M; memory is stale', 'B reads X: A supplies 1 and writes it back, both go to S', 'B writes 2: an invalidation, A goes to I, B to M'] };

interface Layout {
  cls: string; W: number; H: number; wide: boolean;
  cell: (k: number, row: 0 | 1 | 2) => [number, number]; cw: number; ch: number;
  event: (k: number) => [number, number]; bus: (k: number) => [number, number]; badge: (k: number) => [number, number];
  heads: [number, number, 'start' | 'middle' | 'end'][]; legend: [number, number, number]; busStep: number;
}
const layouts: Layout[] = [
  {
    cls: 'fig-wide', W: 760, H: 340, wide: true, cw: 92, ch: 38,
    cell: (k, row) => [134 + k * 126, [80, 132, 250][row]],
    event: (k) => [180 + k * 126, 50], bus: (k) => [180 + k * 126, 200], busStep: 16, badge: (k) => [180 + k * 126, 20],
    heads: [[10, 104, 'start'], [10, 156, 'start'], [10, 210, 'start'], [10, 274, 'start']], legend: [134, 326, 150],
  },
  {
    cls: 'fig-narrow seq-narrow', W: 360, H: 470, wide: false, cw: 56, ch: 40,
    cell: (k, row) => [[160, 224, 296][row], 52 + k * 76],
    event: (k) => [34, 68 + k * 76], bus: (k) => [34, 86 + k * 76], busStep: 18, badge: (k) => [16, 64 + k * 76],
    heads: [[188, 38, 'middle'], [252, 38, 'middle'], [34, 38, 'start'], [324, 38, 'middle']], legend: [10, 452, 88],
  },
];
const narrowHeads = ru ? ['A', 'B', 'шаг и шина', 'память'] : ['A', 'B', 'step and bus', 'memory'];
const id = 'mesi-steps';
---

<Figure
  id={id}
  title={ru ? 'Протокол MESI: пять обращений двух ядер к одной переменной' : 'The MESI protocol: two cores, one variable, five accesses'}
  caption={ru
    ? 'Состояние строки с переменной X в кэшах двух ядер после каждого шага, с её значением; X вначале равна 0 в памяти. Жирной рамкой выделено то, что изменил шаг. После шага 3 единственная действительная копия X = 1 находится в кэше A (M), а память ещё хранит 0; в шаге 4 A сам отдаёт значение B и записывает его в память. Без протокола B в шаге 4 прочитал бы из своей копии устаревший 0. Цвета: M красный, E янтарный, S синий, I без заливки.'
    : "The state of the line holding X in the two cores' caches after each step, with its value; X starts as 0 in memory. A bold border marks what the step changed. After step 3 the only valid copy, X = 1, is in A's cache (M), while memory still holds 0; in step 4, A itself supplies the value to B and writes it back to memory. Without the protocol, B would have read the stale 0 from its own copy in step 4. Colours: M red, E amber, S blue, I unfilled."}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Состояния MESI после каждого шага' : 'MESI states after each step'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Пять шагов. Шаг 1: A в E со значением 0. Шаг 2: A и B в S со значением 0. Шаг 3: A в M со значением 1, B в I, память 0. Шаг 4: A и B в S со значением 1, память 1. Шаг 5: A в I, B в M со значением 2, память 1.'
        : 'Five steps. Step 1: A in E with value 0. Step 2: A and B in S with value 0. Step 3: A in M with value 1, B in I, memory 0. Step 4: A and B in S with value 1, memory 1. Step 5: A in I, B in M with value 2, memory 1.'}</desc>
      {(L.wide ? t.rows : narrowHeads).map((h, r) => (
        <text class="f-small f-t-muted" x={L.heads[r][0]} y={L.heads[r][1]} text-anchor={L.heads[r][2]}>{h}</text>
      ))}
      {after.map((s, k) => {
        const lines: [Line, boolean][] = [[s.A, changed[k].A], [s.B, changed[k].B]];
        const [mx, my] = L.cell(k, 2);
        return (
          <g data-s={String(k + 1)}>
            <Badge x={L.badge(k)[0]} y={L.badge(k)[1]} n={k + 1} />
            <text class="f-small" x={L.event(k)[0]} y={L.event(k)[1]} text-anchor={L.wide ? 'middle' : 'start'}>{t.events[k]}</text>
            {t.bus[k].split('; ').map((part, j, all) => (
              <text class="f-small f-t-muted" x={L.bus(k)[0]} y={L.bus(k)[1] + j * L.busStep} text-anchor={L.wide ? 'middle' : 'start'}>{part}{semi(j, all.length)}</text>
            ))}
            {lines.map(([ln, ch], row) => {
              const [x, y] = L.cell(k, row as 0 | 1);
              return (
                <g>
                  <rect class={fill[ln.st as St]} x={x} y={y} width={L.cw} height={L.ch} rx="5" />
                  <rect class={`${ch ? 'f-line' : 'f-thin'} ${stroke[ln.st as St]}`} x={x} y={y} width={L.cw} height={L.ch} rx="5" fill="none" />
                  <text class="f-label" x={x + (L.wide ? 22 : L.cw / 2)} y={y + (L.wide || ln.st === 'I' ? L.ch / 2 + 5 : 17)} text-anchor="middle" style="font-weight: 650">{ln.st}</text>
                  {ln.st !== 'I' && <text class="f-small" x={x + (L.wide ? 60 : L.cw / 2)} y={y + (L.wide ? L.ch / 2 + 4.5 : 34)} text-anchor="middle">{L.wide ? `X = ${ln.v}` : ln.v}</text>}
                </g>
              );
            })}
            <rect class="f-box-soft" x={mx} y={my} width={L.cw} height={L.ch} rx="5" />
            {changed[k].mem && <rect class="f-line" x={mx} y={my} width={L.cw} height={L.ch} rx="5" fill="none" />}
            <text class="f-small" x={mx + L.cw / 2} y={my + L.ch / 2 + 4.5} text-anchor="middle">{L.wide ? `X = ${s.mem}` : s.mem}</text>
          </g>
        );
      })}
      {t.legend.map(([st, label], k) => (
        <g>
          <rect class={fill[st as St]} x={L.legend[0] + k * L.legend[2]} y={L.legend[1] - 11} width="14" height="13" rx="2" />
          <rect class={`f-thin ${stroke[st as St]}`} x={L.legend[0] + k * L.legend[2]} y={L.legend[1] - 11} width="14" height="13" rx="2" fill="none" />
          <text class="f-small f-t-muted" x={L.legend[0] + k * L.legend[2] + 20} y={L.legend[1]}>{L.wide ? `${st}: ${label}` : st}</text>
        </g>
      ))}
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
