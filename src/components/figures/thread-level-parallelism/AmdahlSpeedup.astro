---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Amdahl's law S(n) = 1 / ((1 - p) + p / n) for four parallel fractions, Gustafson's scaled speed-up
// s + (1 - s) n for s = 0.05, and the ideal S = n, for n = 1 ... 1024 cores. Both axes are log2.
const amdahl = (p: number, n: number) => 1 / ((1 - p) + p / n);
const gustafson = (s: number, n: number) => s + (1 - s) * n;
const ps = [0.5, 0.9, 0.95, 0.99];
const at8 = amdahl(0.95, 8), at1024 = amdahl(0.95, 1024);
if (at8.toFixed(2) !== '5.93' || at1024.toFixed(2) !== '19.64') throw new Error(`Amdahl p = 0.95: ${at8} ${at1024}`);
if (gustafson(0.05, 8).toFixed(2) !== '7.65' || gustafson(0.05, 1024).toFixed(2) !== '972.85') throw new Error('Gustafson');
const end = ps.map((p) => amdahl(p, 1024));
const minGap = Math.min(...end.slice(1).map((v, i) => Math.log2(v) - Math.log2(end[i])));
if (minGap < 0.9) throw new Error(`end labels too close: ${minGap}`);

const t = ru
  ? { x: 'число ядер n', y: 'ускорение', ideal: 'идеал: S = n', gus: 'Густафсон, s = 0.05', lim: 'предел 20', gusShort: 'Густафсон', pt: '5.93 на 8 ядрах' }
  : { x: 'number of cores n', y: 'speed-up', ideal: 'ideal: S = n', gus: 'Gustafson, s = 0.05', lim: 'limit 20', gusShort: 'Gustafson', pt: '5.93 on 8 cores' };
interface Layout { cls: string; W: number; H: number; box: [number, number, number, number]; endX: number; ptDx: number; wide: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 350, box: [72, 20, 620, 300], endX: 628, ptDx: 10, wide: true },
  { cls: 'fig-narrow', W: 360, H: 380, box: [48, 20, 290, 326], endX: 296, ptDx: 8, wide: false },
];
const ticks = [0, 2, 4, 6, 8, 10];
const plots = layouts.map((L) => {
  const [x0, y0, x1, y1] = L.box;
  const sx = scale([0, 10], [x0, x1]);
  const sy = scale([0, 10], [y1, y0]);
  const path = (f: (n: number) => number) =>
    Array.from({ length: 101 }, (_, k) => k / 10)
      .map((l, k) => `${k ? 'L' : 'M'} ${sx(l).toFixed(1)} ${sy(Math.log2(f(2 ** l))).toFixed(1)}`).join(' ');
  return { L, sx, sy, curves: ps.map((p) => path((n) => amdahl(p, n))), gus: path((n) => gustafson(0.05, n)) };
});
const id = 'amdahl-speedup';
---

<Figure
  id={id}
  title={ru ? 'Закон Амдала: ускорение при росте числа ядер' : "Amdahl's law: speed-up as the number of cores grows"}
  caption={ru
    ? `Ускорение S(n) = 1/((1 − p) + p/n) программы, у которой доля p времени на одном ядре делится между ядрами, для p = 0.5, 0.9, 0.95 и 0.99, от 1 до 1024 ядер; обе оси логарифмические по основанию 2. Каждая кривая выходит на полку 1/(1 − p): при p = 0.95 это 5.93 на 8 ядрах, 19.64 на 1024 и никогда больше 20 (пунктир). Пунктир сверху — масштабируемое ускорение Густафсона s + (1 − s)n при s = 0.05, где задача растёт вместе с числом ядер; оно идёт близко к идеалу S = n (точечная линия) и на 1024 ядрах равно 972.85.`
    : `Speed-up S(n) = 1/((1 − p) + p/n) of a program whose one-core time is a fraction p parallel, for p = 0.5, 0.9, 0.95 and 0.99, from 1 to 1,024 cores; both axes are base-2 logarithmic. Each curve levels off at 1/(1 − p): for p = 0.95 it is 5.93 on 8 cores, 19.64 on 1,024 and never more than 20 (dashed). The dashed curve at the top is Gustafson's scaled speed-up s + (1 − s)n with s = 0.05, for a problem that grows with the number of cores; it stays close to the ideal S = n (dotted) and reaches 972.85 on 1,024 cores.`}
>
  {plots.map(({ L, sx, sy, curves, gus }) => {
    const [x0, y0, x1, y1] = L.box;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Ускорение по закону Амдала и по Густафсону' : "Speed-up by Amdahl's and by Gustafson's law"}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Четыре кривые Амдала поднимаются из точки (1, 1) и выходят на полки 2, 10, 20 и 100. Прямая идеального ускорения и почти совпадающая с ней кривая Густафсона идут по диагонали до 1024.'
          : "Four Amdahl curves rise from the point (1, 1) and level off at 2, 10, 20 and 100. The ideal speed-up line and Gustafson's curve, almost on top of it, run diagonally up to 1,024."}</desc>
        {ticks.map((l) => (
          <g>
            <path class="f-grid" d={`M ${x0} ${sy(l)} H ${x1}`} />
            <path class="f-grid" d={`M ${sx(l)} ${y0} V ${y1}`} />
            <text class="f-small f-t-muted" x={x0 - 7} y={sy(l) + 4.5} text-anchor="end">{2 ** l}</text>
            <text class="f-small f-t-muted" x={sx(l)} y={y1 + 18} text-anchor="middle">{2 ** l}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${x0} ${y0} V ${y1} H ${x1}`} />
        <text class="f-small f-t-muted" x={x1} y={y1 + 36} text-anchor="end">{t.x}</text>
        <text class="f-small f-t-muted" x={x0 + 8} y={y0 + 12}>{t.y}</text>
        <path class="f-line f-muted f-dot" d={`M ${sx(0)} ${sy(0)} L ${sx(10)} ${sy(10)}`} />
        <path class="f-line f-green f-dash" d={gus} />
        <text class="f-small f-t-muted f-halo" x={sx(7.4) - 10} y={sy(7.4) + 4} text-anchor="end">{t.ideal}</text>
        <text class="f-small f-t-green f-halo" x={sx(8) + 14} y={sy(8) + 16}>{L.wide ? t.gus : t.gusShort}</text>
        <path class="f-line f-muted f-dash" d={`M ${x0} ${sy(Math.log2(20))} H ${x1}`} />
        <text class="f-small f-t-muted f-halo" x={sx(6.2)} y={sy(Math.log2(20)) - 7}>{t.lim}</text>
        {curves.map((d, k) => <path class={`f-line ${k === 2 ? 'f-blue f-bold' : 'f-blue'}`} d={d} style={k === 2 ? undefined : 'opacity: 0.55'} />)}
        {ps.map((p, k) => <text class="f-small f-t-blue" x={L.endX} y={sy(Math.log2(end[k])) + 4.5}>p = {p}</text>)}
        <circle cx={sx(3)} cy={sy(Math.log2(at8))} r="4" class="f-solid-blue" />
        <text class="f-small f-halo" x={sx(3) + L.ptDx} y={sy(Math.log2(at8)) + 18}>{t.pt}</text>
      </svg>
    );
  })}
</Figure>
