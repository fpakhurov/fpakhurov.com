---
import Figure from '../Figure.astro';

const ru = Astro.props.lang === 'ru';
const title = ru ? 'Уплотнение сохраняет конкурентное добавление' : 'Compaction retains the concurrent append';
const caption = ru
  ? 'S11 добавляет D. После проверки нового основания S12 заменяет A и B на C, сохраняя D и 1050 строк.'
  : 'S11 adds D. After checking its new base, S12 replaces A and B with C, retaining D and all 1050 rows.';
const snapshots = [
  {id: 'S10', files: 'A, B', rows: '1000'},
  {id: 'S11', files: 'A, B, D', rows: '1050'},
  {id: 'S12', files: 'C, D', rows: '1050'},
];
---
<Figure id="big-data-snapshot-files" title={title} caption={caption}>
  <svg viewBox="0 0 340 156" role="img" aria-labelledby="snapshot-files-title snapshot-files-desc" style="max-width: 510px; margin-inline: auto">
    <title id="snapshot-files-title">{title}</title>
    <desc id="snapshot-files-desc">{caption}</desc>
    {snapshots.map(({id, files, rows}, i) => (
      <g transform={`translate(0 ${i * 50})`}>
        <rect class={i === 2 ? 'f-fill-green' : 'f-fill-blue'} x="7" y="8" width="326" height="37" rx="6" />
        <text class="f-label" x="18" y="31">{id}</text>
        <text class="f-label" x="167" y="31" text-anchor="middle">{files}</text>
        <text class="f-label" x="323" y="31" text-anchor="end">{rows} {ru ? 'строк' : 'rows'}</text>
      </g>
    ))}
  </svg>
</Figure>
