---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The Code section of the note: SGD with momentum 0.9 at eta = 0.1, batches of 64, 60 epochs; training and validation
// cross-entropy (evaluation mode) at epochs 1, 2, 5, 10, 20, 40, 60.
const ep = [1, 2, 5, 10, 20, 40, 60];
const runs = [
  { tr: [2.18, 1.873, 1.657, 1.547, 1.47, 1.37, 1.278], va: [2.183, 1.883, 1.691, 1.584, 1.501, 1.403, 1.367], acc: 0.331 },
  { tr: [2.289, 2.252, 2.083, 1.1, 0.099, 0.002, 0.001], va: [2.297, 2.271, 2.152, 1.243, 0.535, 0.48, 0.482], acc: 0.906 },
  { tr: [1.306, 0.355, 0.067, 0.022, 0.002, 0.001, 0.0], va: [1.318, 0.398, 0.103, 0.085, 0.073, 0.08, 0.084], acc: 0.983 },
];
const gaps = runs.map((r) => (r.va[6] - r.tr[6]).toFixed(3));
if (gaps.join(' ') !== '0.089 0.481 0.084') throw new Error(`LearningCurves: final gaps drifted (${gaps.join(' ')})`);
const bestVal = Math.min(...runs[2].va);
if (bestVal !== 0.073 || runs[2].va.indexOf(bestVal) !== 4) throw new Error('LearningCurves: the minimum of the last validation curve should be 0.073 at epoch 20');

const t = ru
  ? { title: 'Кривые обучения: недообучение, переобучение и хорошая подгонка', x: 'эпоха (лог. шкала)', y: 'потери',
      heads: ['сеть 64 → 2 → 2 → 10', '100 изображений', '1257 изображений'], diag: ['недообучение', 'переобучение', 'хорошо; лучшая эпоха ≈ 20'],
      acc: 'доля правильных ответов', train: 'обучение', val: 'валидация',
      desc: 'Три панели с потерями на обучении и валидации против эпохи. Слишком маленькая сеть: обе кривые высокие и близкие, 1.278 и 1.367 к 60-й эпохе. Большая сеть на 100 изображениях: потери на обучении падают до 0.001, на валидации застревают около 0.48. Большая сеть на 1257 изображениях: потери на валидации достигают 0.073 на 20-й эпохе и слегка растут до 0.084.' }
  : { title: 'Learning curves: underfitting, overfitting and a good fit', x: 'epoch (log scale)', y: 'loss',
      heads: ['net 64 → 2 → 2 → 10', '100 images', '1257 images'], diag: ['underfitting', 'overfitting', 'good; best near 20'],
      acc: 'accuracy', train: 'training', val: 'validation',
      desc: 'Three panels with training and validation loss against the epoch. A network too small: both curves high and close, 1.278 and 1.367 at epoch 60. The large network on 100 images: training falls to 0.001, validation stays near 0.48. The large network on 1257 images: validation reaches 0.073 at epoch 20 and rises slightly to 0.084.' };
const id = 'practice-learning-curves';
const caption = ru
  ? 'Сеть 64 → 256 → 256 → 10 (кроме первой панели, где скрытые слои по 2 нейрона), SGD с импульсом 0.9, η = 0.1, 60 эпох, один запуск из раздела «Код»; синие — потери на обучающих изображениях, красные — на 540 валидационных, в режиме оценки. Под каждой панелью — итоговая доля правильных ответов на валидации. Диагноз ставится по форме кривых и разрыву между ними, а не по одной итоговой доле правильных ответов.'
  : 'The 64 → 256 → 256 → 10 network (except the first panel, whose hidden layers have 2 units), SGD with momentum 0.9, η = 0.1, 60 epochs, one run of the Code section; blue: loss on the training images, red: on the 540 validation images, in evaluation mode. Under each panel, the final validation accuracy. The diagnosis comes from the shape of the curves and the gap between them, not from one final accuracy.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, panels: [[60, 40], [305, 40], [550, 40]], pw: 190, ph: 180, leg: [180, 316], xl: [560, 316] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 716, panels: [[56, 40], [56, 256], [56, 472]], pw: 284, ph: 130, leg: [40, 704], xl: [198, 678] },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => (
    <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
      <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
      {runs.map((r, k) => {
        const [x0, y0] = Ly.panels[k];
        const sxl = scale([0, Math.log10(60)], [x0, x0 + Ly.pw]), sx = (e: number) => sxl(Math.log10(e));
        const sy = scale([0, 2.4], [y0 + Ly.ph, y0]);
        return (
          <g>
            <text class="f-small" x={x0 + Ly.pw / 2} y={y0 - 14} text-anchor="middle">{t.heads[k]}</text>
            {[1, 2].map((v) => <path class="f-grid" d={`M ${x0} ${sy(v)} H ${x0 + Ly.pw}`} />)}
            <path class="f-axis" d={`M ${x0} ${y0} V ${y0 + Ly.ph} H ${x0 + Ly.pw}`} />
            {[0, 1, 2].map((v) => <text class="f-note" x={x0 - 7} y={sy(v) + 5} text-anchor="end">{String(v)}</text>)}
            {[1, 10, 60].map((e) => <text class="f-note" x={sx(e)} y={y0 + Ly.ph + 18} text-anchor="middle">{String(e)}</text>)}
            <path class="f-line f-blue" d={polyline(ep.map((e, i) => [sx(e), sy(r.tr[i])]))} />
            <path class="f-line f-red" d={polyline(ep.map((e, i) => [sx(e), sy(r.va[i])]))} />
            {ep.map((e, i) => <circle cx={sx(e)} cy={sy(r.tr[i])} r="2.8" class="f-solid-blue" />)}
            {ep.map((e, i) => <circle cx={sx(e)} cy={sy(r.va[i])} r="2.8" class="f-solid-red" />)}
            <text class="f-small" x={x0 + Ly.pw / 2} y={y0 + Ly.ph + 38} text-anchor="middle">{t.diag[k]}</text>
            <text class="f-small f-t-muted" x={x0 + Ly.pw / 2} y={y0 + Ly.ph + 56} text-anchor="middle">{`${t.acc} ${r.acc.toFixed(3)}`}</text>
          </g>
        );
      })}
      <text class="f-small f-t-muted" x={Ly.panels[0][0] - 50} y={Ly.panels[0][1] - 14}>{t.y}</text>
      <path class="f-line f-blue" d={`M ${Ly.leg[0]} ${Ly.leg[1] - 4} h 24`} />
      <text class="f-small" x={Ly.leg[0] + 30} y={Ly.leg[1]}>{t.train}</text>
      <path class="f-line f-red" d={`M ${Ly.leg[0] + 130} ${Ly.leg[1] - 4} h 24`} />
      <text class="f-small" x={Ly.leg[0] + 160} y={Ly.leg[1]}>{t.val}</text>
      <text class="f-small f-t-muted" x={Ly.xl[0]} y={Ly.xl[1]} text-anchor="middle">{t.x}</text>
    </svg>
  ))}
</Figure>
