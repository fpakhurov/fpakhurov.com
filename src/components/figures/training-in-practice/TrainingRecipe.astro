---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The numbers under the steps are those of the note's Code section (the 64 -> 256 -> 256 -> 10 network on the digits).
const lnC = Math.log(10);
const floor = Math.log(Math.E + 9) - 1;
if (lnC.toFixed(3) !== '2.303' || floor.toFixed(3) !== '1.461') throw new Error('TrainingRecipe: ln 10 or the softmax-twice floor drifted');

const t = ru
  ? {
      title: 'Рецепт обучения сети с нуля',
      boxes: ['посмотреть данные', 'потери в начале', 'переобучить батч', 'подбор η', 'обучить, кривые', 'регуляризация'],
      exp: [['классы, разбиения,', 'линейная модель'], [`ln 10 = ${lnC.toFixed(3)};`, 'измерено 2.310'], ['32 изображения: 0.001;', 'ошибки: 1.551, 2.082'],
        ['минимум при η = 0.31;', 'берём 0.03–0.1'], ['обучение и валидация:', 'недо- или переобучение'], ['одно изменение за раз;', 'seed и запись запуска']],
      steps: ['посмотреть на данные и завести простые базовые модели', 'потери в начале обучения должны быть около ln C', 'один маленький батч должен выучиться почти до нулевых потерь', 'тест диапазона шага обучения: η в 3–10 раз ниже минимума кривой', 'полное обучение: по кривым обучения и валидации понять, недо- или переобучение', 'регуляризовать или увеличить модель, по одному изменению за раз, каждый запуск с фиксированным seed и записью'],
      desc: 'Шесть шагов по порядку: посмотреть на данные, проверить потери в начале (ln 10 = 2.303, измерено 2.310), переобучить один батч (0.001; с ошибками 1.551 и 2.082), найти шаг обучения тестом диапазона (минимум при 0.31, берём 0.03–0.1), обучить полностью и прочитать кривые, затем менять по одному параметру.',
    }
  : {
      title: 'A recipe for training a network from scratch',
      boxes: ['look at the data', 'loss at init', 'overfit a batch', 'range test for η', 'full run, curves', 'regularize, tune'],
      exp: [['class counts, splits,', 'a linear baseline'], [`ln 10 = ${lnC.toFixed(3)};`, 'measured 2.310'], ['32 images: 0.001;', 'bugs: 1.551, 2.082'],
        ['minimum at η = 0.31;', 'use 0.03 to 0.1'], ['training vs validation:', 'under- or overfit?'], ['one change per run,', 'seeded and recorded']],
      steps: ['look at the data and set up simple baselines', 'the loss at initialization should be about ln C', 'one small batch must be fitted to a loss near zero', 'a learning-rate range test: a rate 3 to 10 times below the minimum of the curve', 'the full run: read the training and validation curves for under- or overfitting', 'regularize or enlarge the model, one change at a time, every run seeded and recorded'],
      desc: 'Six steps in order: look at the data, check the loss at initialization (ln 10 = 2.303, measured 2.310), overfit one batch (0.001; with bugs 1.551 and 2.082), find the learning rate with a range test (minimum at 0.31, use 0.03 to 0.1), train fully and read the curves, then change one thing at a time.',
    };
const tones = ['x', 'n', 'n', 'n', 'n', 'y'] as const;
const id = 'practice-training-recipe';
const caption = ru
  ? 'Каждый шаг — маленький эксперимент с заранее известным ответом; числа под шагами — из раздела «Код» (сеть 64 → 256 → 256 → 10 на цифрах). Если ответ не сходится, ошибка — в этом шаге или до него, и дальше идти рано. Шаги 2–4 занимают секунды; дорогие полные запуски начинаются только на шаге 5.'
  : 'Each step is a small experiment whose answer is known in advance; the numbers under the steps come from the Code section (the 64 → 256 → 256 → 10 network on the digits). If the answer does not match, the bug is in this step or before it, and it is too early to go on. Steps 2–4 take seconds; the expensive full runs begin only at step 5.';
// wide: two rows of three boxes; narrow: one column of six with the expectations to the right
const wide = [0, 1, 2, 3, 4, 5].map((k) => ({ x: 30 + 260 * (k % 3), y: k < 3 ? 40 : 196 }));
const narrow = [0, 1, 2, 3, 4, 5].map((k) => ({ x: 26, y: 16 + 74 * k }));
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 330" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    {wide.map((p, k) => (
      <g data-s={String(k + 1)}>
        <Box x={p.x} y={p.y} w={180} h={46} label={t.boxes[k]} tone={tones[k]} />
        <text class="f-small f-t-muted" x={p.x + 90} y={p.y + 70} text-anchor="middle">{t.exp[k][0]}</text>
        <text class="f-small f-t-muted" x={p.x + 90} y={p.y + 88} text-anchor="middle">{t.exp[k][1]}</text>
        <Badge x={p.x} y={p.y} n={k + 1} />
        {k % 3 !== 2 && <Arrow pts={[[p.x + 180, p.y + 23], [p.x + 258, p.y + 23]]} />}
        {k === 2 && <Arrow pts={[[p.x + 90, p.y + 98], [p.x + 90, 160], [120, 160], [120, 194]]} />}
      </g>
    ))}
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 468" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    {narrow.map((p, k) => (
      <g data-s={String(k + 1)}>
        <Box x={p.x} y={p.y} w={150} h={44} label={t.boxes[k]} tone={tones[k]} />
        <text class="f-small f-t-muted" x={p.x + 160} y={p.y + 18}>{t.exp[k][0]}</text>
        <text class="f-small f-t-muted" x={p.x + 160} y={p.y + 36}>{t.exp[k][1]}</text>
        <Badge x={p.x} y={p.y} n={k + 1} />
        {k !== 5 && <Arrow pts={[[p.x + 75, p.y + 44], [p.x + 75, p.y + 72]]} />}
      </g>
    ))}
  </svg>
  <Stepper steps={t.steps} />
</Figure>
