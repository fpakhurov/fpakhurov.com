---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The Code section of the note: SGD with momentum 0.9, batches of 64 digits, the rate eta_k = 1e-5 * (1e6)^(k / 299).
// Top: the bias-corrected moving average of the training loss, printed every 15 steps; the minimum (0.433 at step 224,
// eta = 0.313) and the stop (step 246, eta = 0.864). Bottom: validation accuracy after 10 epochs at five fixed rates.
const etaAt = (k: number) => 1e-5 * 1e6 ** (k / 299);
const smooth = [2.294, 2.311, 2.312, 2.311, 2.309, 2.308, 2.307, 2.303, 2.291, 2.277, 2.238, 2.158, 1.872, 1.034, 0.554, 0.441, 0.657];
const pts = smooth.map((l, i) => [etaAt(15 * i), l] as [number, number]);
const minEta = etaAt(224), stopEta = etaAt(246);
if (minEta.toFixed(3) !== '0.313' || stopEta.toFixed(3) !== '0.864') throw new Error(`LrRangeTest: steps and rates disagree (${minEta}, ${stopEta})`);
if (Math.abs(etaAt(150) - 0.0102) > 1e-4 || (1e6 ** (1 / 299)).toFixed(3) !== '1.047') throw new Error('LrRangeTest: worked example drifted');
const minLoss = 0.433;
const fixed = [[1e-3, 0.596], [1e-2, 0.933], [0.1, 0.978], [0.3, 0.961], [1, 0.098]] as [number, number][];
const band: [number, number] = [0.03, 0.1];
// label offsets of the five accuracies (dx, dy, anchor): placed where the connecting line does not pass
const fixedLab: [number, number, string][] = [[8, 16, 'start'], [8, 16, 'start'], [-8, -8, 'end'], [8, -8, 'start'], [-10, 4, 'end']];
if (!(band[1] * 3 <= minEta + 1e-9 && band[0] * 10 <= minEta + 1e-9)) throw new Error('LrRangeTest: the band should lie 3 to 10 times below the minimum');

const t = ru
  ? { title: 'Тест диапазона шага обучения и его проверка', x: 'шаг обучения η (лог. шкала)', yTop: 'сглаженные потери', yBot: 'доля правильных ответов, 10 эпох',
      min: `минимум ${minLoss} при η = 0.31`, stop: 'стоп', band: 'выбор: 0.03–0.1',
      desc: 'Сверху: сглаженные потери при росте η от 10⁻⁵ до 0.86; плато около 2.3 до η ≈ 10⁻³, падение, минимум 0.433 при η = 0.31, затем рост. Снизу: доля правильных ответов на валидации после 10 эпох с постоянным η: 0.596 при 0.001, 0.933 при 0.01, 0.978 при 0.1, 0.961 при 0.3 и 0.098 при 1. Выделена полоса 0.03–0.1.' }
  : { title: 'A learning-rate range test and its check', x: 'learning rate η (log scale)', yTop: 'smoothed loss', yBot: 'accuracy after 10 epochs',
      min: `minimum ${minLoss} at η = 0.31`, stop: 'stop', band: 'choice: 0.03–0.1',
      desc: 'Top: the smoothed loss as η grows from 10⁻⁵ to 0.86; a plateau near 2.3 up to η ≈ 10⁻³, a fall, a minimum of 0.433 at η = 0.31, then a rise. Bottom: validation accuracy after 10 epochs at a constant η: 0.596 at 0.001, 0.933 at 0.01, 0.978 at 0.1, 0.961 at 0.3 and 0.098 at 1. The band 0.03–0.1 is shaded.' };
const id = 'practice-lr-range-test';
const caption = ru
  ? 'Сеть 64 → 256 → 256 → 10 на цифрах, SGD с импульсом 0.9, батчи по 64. Сверху — один короткий запуск: η растёт в 1.047 раза на каждой итерации, потери сглажены скользящим средним с поправкой на смещение, запуск остановлен, когда потери превысили минимум в 4 раза. Снизу — пять отдельных обучений по 10 эпох с постоянным η. Полоса в 3–10 раз ниже минимума кривой содержит лучший из проверенных шагов, 0.1.'
  : 'The 64 → 256 → 256 → 10 network on the digits, SGD with momentum 0.9, batches of 64. Top: one short run in which η grows by a factor of 1.047 per step; the loss is smoothed by a bias-corrected moving average and the run stops when it exceeds 4 times its minimum. Bottom: five separate trainings of 10 epochs at a constant η. The band 3 to 10 times below the minimum of the curve contains the best rate tested, 0.1.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 400, px: [80, 600] as [number, number], top: [30, 190] as [number, number], bot: [236, 336] as [number, number], stopDx: 6, stopAnchor: 'start' },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 450, px: [58, 340] as [number, number], top: [34, 200] as [number, number], bot: [262, 362] as [number, number], stopDx: -6, stopAnchor: 'end' },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => {
    const sxl = scale([-5, 0], Ly.px), sx = (v: number) => sxl(Math.log10(v));
    const syT = scale([0, 2.5], [Ly.top[1], Ly.top[0]]), syB = scale([0, 1], [Ly.bot[1], Ly.bot[0]]);
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
        <rect x={sx(band[0])} y={Ly.top[0]} width={sx(band[1]) - sx(band[0])} height={Ly.bot[1] - Ly.top[0]} class="f-fill-amber" />
        {[0.5, 1, 1.5, 2, 2.5].map((v) => <path class="f-grid" d={`M ${Ly.px[0]} ${syT(v)} H ${Ly.px[1]}`} />)}
        {[0.5, 1].map((v) => <path class="f-grid" d={`M ${Ly.px[0]} ${syB(v)} H ${Ly.px[1]}`} />)}
        <path class="f-axis" d={`M ${Ly.px[0]} ${Ly.top[0]} V ${Ly.top[1]} H ${Ly.px[1]}`} />
        <path class="f-axis" d={`M ${Ly.px[0]} ${Ly.bot[0]} V ${Ly.bot[1]} H ${Ly.px[1]}`} />
        {[0, 1, 2].map((v) => <text class="f-note" x={Ly.px[0] - 7} y={syT(v) + 5} text-anchor="end">{String(v)}</text>)}
        {[0, 0.5, 1].map((v) => <text class="f-note" x={Ly.px[0] - 7} y={syB(v) + 5} text-anchor="end">{v === 0 ? '0' : v.toFixed(1)}</text>)}
        {[-5, -4, -3, -2, -1, 0].map((e) => <text class="f-note" x={sxl(e)} y={Ly.bot[1] + 18} text-anchor="middle">{e === 0 ? '1' : `10${['⁻⁵', '⁻⁴', '⁻³', '⁻²', '⁻¹'][e + 5]}`}</text>)}
        <text class="f-small f-t-muted" x={(Ly.px[0] + Ly.px[1]) / 2} y={Ly.bot[1] + 40} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={Ly.px[0] - 50} y={Ly.top[0] - 14}>{t.yTop}</text>
        <text class="f-small f-t-muted" x={Ly.px[0] - 50} y={Ly.bot[0] - 12}>{t.yBot}</text>
        <path class="f-line f-blue" d={polyline(pts.map(([e, l]) => [sx(e), syT(l)]))} />
        {pts.map(([e, l]) => <circle cx={sx(e)} cy={syT(l)} r="3" class="f-solid-blue" />)}
        <circle cx={sx(minEta)} cy={syT(minLoss)} r="5" class="f-solid-red" />
        <text class="f-small f-halo" x={sx(minEta) - 8} y={syT(minLoss) + 20} text-anchor="end">{t.min}</text>
        <path class="f-thin f-red f-dash" d={`M ${sx(stopEta)} ${Ly.top[0]} V ${Ly.top[1]}`} />
        <text class="f-small f-t-red" x={sx(stopEta) + Ly.stopDx} y={Ly.top[0] + 12} text-anchor={Ly.stopAnchor}>{t.stop}</text>
        <text class="f-small f-t-amber f-halo" x={(sx(band[0]) + sx(band[1])) / 2} y={(Ly.top[1] + Ly.bot[0]) / 2 + 6} text-anchor="middle">{t.band}</text>
        <path class="f-line f-green" d={polyline(fixed.map(([e, a]) => [sx(e), syB(a)]))} />
        {fixed.map(([e, a]) => <circle cx={sx(e)} cy={syB(a)} r="4" class="f-solid-green" />)}
        {fixed.map(([e, a], i) => <text class="f-small f-halo" x={sx(e) + fixedLab[i][0]} y={syB(a) + fixedLab[i][1]} text-anchor={fixedLab[i][2]}>{a.toFixed(3)}</text>)}
      </svg>
    );
  })}
</Figure>
