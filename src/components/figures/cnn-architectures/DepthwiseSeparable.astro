---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import NewMark from '../seqflow/NewMark.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A MobileNet layer: M = N = 512 channels, 3 × 3 kernels, on a 14 × 14 grid. Weights without biases.
const M = 512, N = 512, k = 3, HW = 14 * 14;
const standard = k * k * M * N;
const depthwise = k * k * M, pointwise = M * N, separable = depthwise + pointwise;
const ratio = separable / standard;
if (standard !== 2359296 || separable !== 266752) throw new Error('DepthwiseSeparable: counts drifted');
if (Math.abs(ratio - (1 / N + 1 / (k * k))) > 1e-12 || ratio.toFixed(3) !== '0.113' || (1 / ratio).toFixed(1) !== '8.8') throw new Error('DepthwiseSeparable: ratio drifted');
if (standard * HW !== 462422016 || separable * HW !== 52283392) throw new Error('DepthwiseSeparable: multiply-adds drifted');
const n = (v: number) => (ru ? v.toLocaleString('en-US').replace(/,/g, ' ') : v.toLocaleString('en-US'));

const t = ru
  ? {
      title: 'Обычная и разделимая (depthwise-separable) свёртки',
      std: 'обычная свёртка', sep: 'разделимая свёртка', filters: 'N фильтров', dw: 'поканальная',
      costA: 'k²MN весов:', costB: 'k²M + MN весов:',
      ratio1: `отношение 1/N + 1/k² = ${ratio.toFixed(3)}:`, ratio2: `в ${(1 / ratio).toFixed(1)} раза меньше весов и операций`,
      steps: ['обычная свёртка: каждый фильтр 3 × 3 × M смешивает соседей и все каналы сразу', 'поканальная (depthwise): свой фильтр 3 × 3 для каждого канала, каналы не смешиваются', 'поточечная (pointwise): свёртка 1 × 1 смешивает каналы в каждом пикселе', 'стоимость при M = N = 512: в 8.8 раза меньше'],
      desc: 'Сверху обычная свёртка: все M входных каналов идут в N фильтров размера 3 × 3 × M, k²MN = 2 359 296 весов. Снизу разделимая свёртка: каждый входной канал фильтруется своим ядром 3 × 3, затем свёртка 1 × 1 с N фильтрами смешивает каналы; k²M + MN = 4 608 + 262 144 = 266 752 веса. Отношение 0.113, в 8.8 раза меньше.',
    }
  : {
      title: 'A standard and a depthwise-separable convolution',
      std: 'standard convolution', sep: 'depthwise separable', filters: 'N filters', dw: 'depthwise',
      costA: 'k²MN weights:', costB: 'k²M + MN weights:',
      ratio1: `ratio 1/N + 1/k² = ${ratio.toFixed(3)}:`, ratio2: `${(1 / ratio).toFixed(1)}× fewer weights and multiply-adds`,
      steps: ['standard: each 3 × 3 × M filter mixes neighbours and all channels at once', 'depthwise: one 3 × 3 filter per channel, no mixing across channels', 'pointwise: a 1 × 1 convolution mixes the channels at each pixel', 'cost at M = N = 512: 8.8 times less'],
      desc: 'Top, a standard convolution: all M input channels feed N filters of size 3 × 3 × M, k²MN = 2,359,296 weights. Bottom, the separable version: each input channel is filtered by its own 3 × 3 kernel, then a 1 × 1 convolution with N filters mixes the channels; k²M + MN = 4,608 + 262,144 = 266,752 weights. The ratio is 0.113, 8.8 times fewer.',
    };
const id = 'cnn-depthwise-separable';
const caption = ru
  ? `Схема с четырьмя входными и тремя выходными каналами; числа — для слоя MobileNet с M = N = 512 каналами и ядрами 3 × 3. На сетке 14 × 14 обычная свёртка стоит ${n(standard * HW)} умножений-сложений, разделимая — ${n(separable * HW)}: и число весов, и число операций умножаются на одно и то же отношение 1/N + 1/k², потому что обе части работают в каждом пикселе. Почти вся стоимость приходится на свёртку 1 × 1.`
  : `The drawing has four input and three output channels; the numbers are for a MobileNet layer with M = N = 512 channels and 3 × 3 kernels. On a 14 × 14 grid the standard convolution costs ${n(standard * HW)} multiply-adds and the separable one ${n(separable * HW)}: weights and operations shrink by the same ratio 1/N + 1/k², since both parts run at every pixel. Almost all of the cost is in the 1 × 1 convolution.`;

const L = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 360, cw: 34, ch: 22, inX: 40, aY: 46, bY: 200, boxA: [150, 230], dwX: 104, dwW: 48, midX: 186, boxB: [262, 170], outX: 470, costX: 540, ratioY: [328, 348], ratioX: 40, titleDy: -22 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 430, cw: 30, ch: 22, inX: 20, aY: 40, bY: 220, boxA: [86, 172], dwX: 70, dwW: 40, midX: 132, boxB: [184, 108], outX: 314, costX: 20, ratioY: [392, 414], ratioX: 20, titleDy: -14 },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {L.map((g) => {
    const cyIn = (y0: number, i: number) => y0 + g.ch * i + g.ch / 2;
    const narrow = g.sfx === 'n';
    const midA = g.aY + 2 * g.ch, midB = g.bY + 2 * g.ch;
    const outA = g.aY + g.ch / 2, outB = g.bY + g.ch / 2;
    return (
      <svg class={g.cls} viewBox={`0 0 ${g.W} ${g.H}`} role="img" aria-labelledby={`${id}-${g.sfx}-t ${id}-${g.sfx}-d`}>
        <title id={`${id}-${g.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${g.sfx}-d`}>{t.desc}</desc>
        <g data-s="1">
          <text class="f-small f-t-muted" x={g.inX} y={g.aY + g.titleDy}>{t.std}</text>
          <Vec x={g.inX} y={g.aY} values={['1', '2', '3', '4']} tone="x" cw={g.cw} ch={g.ch} />
          {[0, 1, 2, 3].map((i) => <path class="f-thin" style="stroke: var(--muted)" d={`M ${g.inX + g.cw} ${cyIn(g.aY, i)} L ${g.boxA[0]} ${midA}`} />)}
          <Box x={g.boxA[0]} y={midA - 24} w={g.boxA[1]} h={48} label="3 × 3 × M" sub={t.filters} tone="g" />
          <Arrow pts={[[g.boxA[0] + g.boxA[1], midA], [g.outX - 2, midA]]} />
          <Vec x={g.outX} y={midA - 1.5 * g.ch} values={['1', '2', '3']} tone="y" cw={g.cw} ch={g.ch} />
          <Badge x={g.boxA[0] + g.boxA[1] / 2} y={midA - 38} n={1} />
        </g>
        <text class="f-small f-t-muted" x={g.inX} y={g.bY + g.titleDy}>{t.sep}</text>
        <Vec x={g.inX} y={g.bY} values={['1', '2', '3', '4']} tone="x" cw={g.cw} ch={g.ch} />
        <g data-s="2">
          <NewMark x={g.dwX - 6} y={g.bY - 6} w={g.dwW + 12} h={4 * g.ch + 12} label={narrow ? '' : t.dw} at="bl" />
          {[0, 1, 2, 3].map((i) => (
            <g>
              <Arrow pts={[[g.inX + g.cw, cyIn(g.bY, i)], [g.dwX - 1, cyIn(g.bY, i)]]} />
              <rect x={g.dwX} y={g.bY + g.ch * i + 2} width={g.dwW} height={g.ch - 4} rx="3" style={`fill: ${toneVar.g}; fill-opacity: 0.14; stroke: ${toneVar.g}; stroke-width: 1.1`} />
              <text class="f-small" x={g.dwX + g.dwW / 2} y={cyIn(g.bY, i) + 4.5} text-anchor="middle">3×3</text>
              <Arrow pts={[[g.dwX + g.dwW, cyIn(g.bY, i)], [g.midX - 1, cyIn(g.bY, i)]]} />
            </g>
          ))}
          <Vec x={g.midX} y={g.bY} values={['1', '2', '3', '4']} tone="h" cw={g.cw} ch={g.ch} />
          <Badge x={g.midX + g.cw + 14} y={g.bY - 12} n={2} />
        </g>
        <g data-s="3">
          {[0, 1, 2, 3].map((i) => <path class="f-thin" style="stroke: var(--muted)" d={`M ${g.midX + g.cw} ${cyIn(g.bY, i)} L ${g.boxB[0]} ${midB}`} />)}
          <Box x={g.boxB[0]} y={midB - 24} w={g.boxB[1]} h={48} label="1 × 1 × M" sub={t.filters} tone="g" />
          <Arrow pts={[[g.boxB[0] + g.boxB[1], midB], [g.outX - 2, midB]]} />
          <Vec x={g.outX} y={midB - 1.5 * g.ch} values={['1', '2', '3']} tone="y" cw={g.cw} ch={g.ch} />
          <Badge x={g.boxB[0] + g.boxB[1] / 2} y={midB - 38} n={3} />
        </g>
        <g data-s="4">
          <text class="f-small f-t-muted" x={g.costX} y={narrow ? g.aY + 4 * g.ch + 26 : midA - 4}>{t.costA}</text>
          <text class="f-small" x={g.costX} y={narrow ? g.aY + 4 * g.ch + 48 : midA + 16}>{n(standard)}</text>
          <text class="f-small f-t-muted" x={g.costX} y={narrow ? g.bY + 4 * g.ch + 26 : midB - 4}>{t.costB}</text>
          <text class="f-small" x={g.costX} y={narrow ? g.bY + 4 * g.ch + 48 : midB + 16}>{`${n(depthwise)} + ${n(pointwise)} = ${n(separable)}`}</text>
          <text class="f-small" x={g.ratioX} y={g.ratioY[0]}>{t.ratio1}</text>
          <text class="f-small" x={g.ratioX} y={g.ratioY[1]}>{t.ratio2}</text>
          <Badge x={narrow ? 330 : g.costX - 20} y={narrow ? g.ratioY[0] - 5 : midB + 6} n={4} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
