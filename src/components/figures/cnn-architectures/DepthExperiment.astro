---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The experiment of the Code section, seed 0: 1078 training digits (8 × 8), CNNs with 16 channels, SGD with momentum 0.9
// and a one-cycle schedule up to 0.05, batches of 64, 12 epochs. Mean training loss of each epoch (in training mode).
const runs = [
  { layers: 7, residual: false, curve: [2.31, 2.012, 1.501, 0.913, 0.439, 0.21, 0.124, 0.087, 0.063, 0.035, 0.028, 0.024], acc: 0.992 },
  { layers: 7, residual: true, curve: [2.31, 1.751, 0.976, 0.425, 0.239, 0.139, 0.09, 0.061, 0.047, 0.029, 0.027, 0.021], acc: 0.992 },
  { layers: 21, residual: false, curve: [2.307, 2.051, 1.682, 1.333, 1.075, 1.006, 0.939, 0.696, 0.486, 0.381, 0.305, 0.27], acc: 0.96 },
  { layers: 21, residual: true, curve: [2.291, 1.373, 0.724, 0.384, 0.191, 0.093, 0.048, 0.024, 0.018, 0.013, 0.013, 0.009], acc: 0.986 },
];
const finals = runs.map((r) => r.curve[11]).join(' ');
if (finals !== '0.024 0.021 0.27 0.009' || runs.some((r) => r.curve.length !== 12)) throw new Error(`DepthExperiment: curves drifted (${finals})`);
// the degradation: the deeper plain network ends with a higher training loss than the shallower one
if (!(runs[2].curve[11] > 10 * runs[0].curve[11]) || !(runs[3].curve[11] < runs[1].curve[11])) throw new Error('DepthExperiment: the ordering of the text no longer holds');

const t = ru
  ? {
      title: 'Глубже — хуже без остаточных связей, лучше с ними',
      x: 'эпоха', y: 'потери на обучении (лог. шкала)',
      name: (l: number, r: boolean) => `${l} ${l % 10 === 1 && l % 100 !== 11 ? 'слой' : 'слоёв'}, ${r ? 'остаточная' : 'простая'}`,
      desc: 'Средние потери на обучающей выборке по эпохам для четырёх свёрточных сетей на цифрах 8 × 8. Простая сеть из 7 слоёв доходит до 0.024, из 21 слоя — только до 0.27. Остаточные сети доходят до 0.021 (7 слоёв) и 0.009 (21 слой).',
    }
  : {
      title: 'Deeper is worse without residual connections and better with them',
      x: 'epoch', y: 'training loss (log scale)',
      name: (l: number, r: boolean) => `${l} layers, ${r ? 'residual' : 'plain'}`,
      desc: 'Mean training loss per epoch for four convolutional networks on 8 × 8 digits. The plain 7-layer network reaches 0.024, the plain 21-layer network only 0.27. The residual networks reach 0.021 (7 layers) and 0.009 (21 layers).',
    };
const id = 'cnn-depth-experiment';
const caption = ru
  ? '1078 обучающих изображений цифр 8 × 8; сети с 16 каналами, свёртки 3 × 3 с BN, глобальный усредняющий пулинг; SGD с импульсом 0.9 и расписанием one-cycle до 0.05, батчи по 64, 12 эпох, seed 0. Сплошные линии — остаточные сети, пунктир — простые с теми же слоями и тем же числом параметров. Простая сеть из 21 слоя обучается хуже простой сети из 7: это деградация, а не переобучение, потому что речь идёт о потерях на обучающей выборке. С остаточными связями более глубокая сеть обучается лучше. С seed 1 и 2 картина та же.'
  : '1078 training images of 8 × 8 digits; networks with 16 channels, 3 × 3 convolutions with BN, global average pooling; SGD with momentum 0.9 and a one-cycle schedule up to 0.05, batches of 64, 12 epochs, seed 0. Solid lines are residual networks, dashed lines plain networks with the same layers and the same number of parameters. The plain 21-layer network trains worse than the plain 7-layer one: degradation, not overfitting, since this is the training loss. With residual connections the deeper network trains better. Seeds 1 and 2 give the same picture.';

const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [70, 500], py: [30, 260], leg: [530, 60], legStep: 26 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 450, px: [56, 336], py: [40, 270], leg: [20, 342], legStep: 24 },
];
const yt = [0.01, 0.1, 1];
const lo = Math.log10(0.005), hi = Math.log10(4);
const style = (r: (typeof runs)[number]) => `f-line ${r.layers === 21 ? 'f-red' : 'f-blue'}${r.residual ? '' : ' f-dash'}`;
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => {
    const sx = scale([1, 12], Ly.px as [number, number]);
    const sy = scale([lo, hi], [Ly.py[1], Ly.py[0]]);
    const ly = (v: number) => sy(Math.log10(v));
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
        {yt.map((v) => <path class="f-grid" d={`M ${Ly.px[0]} ${ly(v)} H ${Ly.px[1]}`} />)}
        <path class="f-axis" d={`M ${Ly.px[0]} ${Ly.py[1]} H ${Ly.px[1]} M ${Ly.px[0]} ${Ly.py[0]} V ${Ly.py[1]}`} />
        {yt.map((v) => <text class="f-note" x={Ly.px[0] - 7} y={ly(v) + 5} text-anchor="end">{String(v)}</text>)}
        {[1, 3, 6, 9, 12].map((e) => <text class="f-note" x={sx(e)} y={Ly.py[1] + 20} text-anchor="middle">{e}</text>)}
        <text class="f-small" x={Ly.px[1]} y={Ly.py[1] + 40} text-anchor="end">{t.x}</text>
        <text class="f-small f-t-muted" x={Ly.px[0] - 40} y={Ly.py[0] - 14}>{t.y}</text>
        {runs.map((r) => <path class={style(r)} d={polyline(r.curve.map((v, i) => [sx(i + 1), ly(v)]))} />)}
        {runs.map((r, i) => (
          <g>
            <path class={style(r)} d={`M ${Ly.leg[0]} ${Ly.leg[1] + i * Ly.legStep - 4} h 30`} />
            <text class="f-small" x={Ly.leg[0] + 38} y={Ly.leg[1] + i * Ly.legStep}>{`${t.name(r.layers, r.residual)}: ${r.curve[11]}`}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
