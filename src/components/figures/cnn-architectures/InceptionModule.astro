---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import NewMark from '../seqflow/NewMark.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Inception (3a) of GoogLeNet: 28 × 28 × 192 in, branches 1×1→64 | 1×1→96, 3×3→128 | 1×1→16, 5×5→32 | 3×3 pool, 1×1→32.
const Cin = 192;
const w = (cin: number, cout: number, k: number) => cin * cout * k * k;
const parts = {
  b1: w(Cin, 64, 1), r3: w(Cin, 96, 1), c3: w(96, 128, 3), r5: w(Cin, 16, 1), c5: w(16, 32, 5), pp: w(Cin, 32, 1),
};
const total = Object.values(parts).reduce((a, b) => a + b, 0);
const outC = 64 + 128 + 32 + 32;
if (total !== 163328 || outC !== 256) throw new Error(`InceptionModule: totals drifted (${total}, ${outC})`);
if (Math.round(total / 1024) !== 160 || Math.round((total * 28 * 28) / 1e6) !== 128) throw new Error('InceptionModule: 159K / 128M of Table 1 drifted');
const noReduce = w(Cin, 128, 3) + w(Cin, 32, 5);
const withReduce = parts.r3 + parts.c3 + parts.r5 + parts.c5;
if (noReduce !== 374784 || withReduce !== 144896) throw new Error('InceptionModule: reduction saving drifted');
const n = (v: number) => (ru ? v.toLocaleString('en-US').replace(/,/g, ' ') : v.toLocaleString('en-US'));
const vesa = (v: number) => (v % 10 === 1 && v % 100 !== 11 ? 'вес' : v % 10 >= 2 && v % 10 <= 4 && (v % 100 < 12 || v % 100 > 14) ? 'веса' : 'весов');

const t = ru
  ? {
      title: 'Модуль Inception (3a): четыре ветви и свёртки 1 × 1 перед дорогими',
      input: '28 × 28 × 192', concat: 'конкатенация по каналам', out: '28 × 28 × 256', pool: '3 × 3 max pool', wts: (v: number) => `${n(v)} ${vesa(v)}`, none: 'без весов',
      red: 'сжатие',
      steps: ['все четыре ветви читают один и тот же вход 28 × 28 × 192', 'свёртки 1 × 1 сжимают 192 канала до 96 и 16', 'свёртки 3 × 3 и 5 × 5 работают на сжатом входе', 'выходы ветвей склеиваются по каналам: 64 + 128 + 32 + 32 = 256 каналов'],
      desc: 'Вход 28 × 28 × 192 идёт в четыре параллельные ветви: свёртка 1 × 1 на 64 канала; свёртка 1 × 1 на 96 каналов и затем 3 × 3 на 128; свёртка 1 × 1 на 16 каналов и затем 5 × 5 на 32; max pooling 3 × 3 и затем свёртка 1 × 1 на 32. Выходы склеиваются в 28 × 28 × 256. У каждой свёртки подписано число весов, всего 163 328.',
    }
  : {
      title: 'The Inception (3a) module: four branches, and 1 × 1 convolutions before the expensive ones',
      input: '28 × 28 × 192', concat: 'concatenate channels', out: '28 × 28 × 256', pool: '3 × 3 max pool', wts: (v: number) => `${n(v)} weights`, none: 'no weights',
      red: 'reductions',
      steps: ['all four branches read the same 28 × 28 × 192 input', '1 × 1 convolutions shrink 192 channels to 96 and 16', 'the 3 × 3 and 5 × 5 convolutions run on the reduced input', 'the branch outputs are concatenated: 64 + 128 + 32 + 32 = 256 channels'],
      desc: 'A 28 × 28 × 192 input feeds four parallel branches: a 1 × 1 convolution to 64 channels; a 1 × 1 convolution to 96 channels, then a 3 × 3 to 128; a 1 × 1 convolution to 16 channels, then a 5 × 5 to 32; a 3 × 3 max pooling, then a 1 × 1 convolution to 32. The outputs are concatenated into 28 × 28 × 256. Each convolution is labelled with its number of weights, 163,328 in all.',
    };
const id = 'cnn-inception-module';
const caption = ru
  ? `Числа — из таблицы 1 статьи GoogLeNet. Веса посчитаны без смещений: всего ${n(total)} (в таблице 159K, тысячи по 1024) и ${n(total * 28 * 28)} умножений-сложений на изображение. Без сжатия свёртками 1 × 1 свёртки 3 × 3 и 5 × 5 на всех 192 каналах имели бы ${n(noReduce)} ${vesa(noReduce)} вместо ${n(withReduce)} у двух средних ветвей. Каждая свёртка сопровождается ReLU; все ветви сохраняют размер 28 × 28 (дополнение нулями, у пулинга шаг 1).`
  : `Numbers from Table 1 of the GoogLeNet paper. Weights are counted without biases: ${n(total)} in all (159K in the table, which counts thousands of 1024) and ${n(total * 28 * 28)} multiply-adds per image. Without the 1 × 1 reductions, 3 × 3 and 5 × 5 convolutions on all 192 channels would need ${n(noReduce)} weights instead of the ${n(withReduce)} of the two middle branches. Every convolution is followed by a ReLU; all branches keep the 28 × 28 size (zero padding, and stride 1 for the pooling).`;

const L = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 400, cols: [100, 290, 470, 660], bw: 160, bh: 40, inY: 24, r1: 104, r2: 194, cY: 290, outY: 372, short: false, sub: 16 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 450, cols: [48, 136, 224, 312], bw: 82, bh: 46, inY: 20, r1: 108, r2: 206, cY: 318, outY: 424, short: true, sub: 17 },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {L.map((g) => {
    const half = g.bw / 2;
    const lab = (long: string, short: string) => (g.short ? short : long);
    const inBox = { x: g.W / 2 - 90, w: 180 };
    return (
      <svg class={g.cls} viewBox={`0 0 ${g.W} ${g.H}`} role="img" aria-labelledby={`${id}-${g.sfx}-t ${id}-${g.sfx}-d`}>
        <title id={`${id}-${g.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${g.sfx}-d`}>{t.desc}</desc>
        <Box x={inBox.x} y={g.inY} w={inBox.w} h={36} label={t.input} tone="x" />
        <g data-s="1">
          {g.cols.map((cx) => <Arrow pts={[[g.W / 2, g.inY + 36], [g.W / 2, g.inY + 52], [cx, g.inY + 52], [cx, g.r1 - 2]]} />)}
          <Badge x={inBox.x + inBox.w + 18} y={g.inY + 18} n={1} />
        </g>
        <g data-s="1 3">
          <Box x={g.cols[0] - half} y={g.r1} w={g.bw} h={g.bh} label={lab('1 × 1 conv, 64', '1×1, 64')} sub={g.short ? n(parts.b1) : t.wts(parts.b1)} subGap={g.sub} tone="g" />
          <Box x={g.cols[3] - half} y={g.r1} w={g.bw} h={g.bh} label={lab(t.pool, 'pool')} sub={g.short ? '' : t.none} subGap={g.sub} />
        </g>
        <g data-s="2">
          <NewMark x={g.cols[1] - half - 8} y={g.r1 - 8} w={g.cols[2] - g.cols[1] + g.bw + 16} h={g.bh + 16} label={g.short ? '' : t.red} at="tl" />
          <Box x={g.cols[1] - half} y={g.r1} w={g.bw} h={g.bh} label={lab('1 × 1 conv, 96', '1×1, 96')} sub={g.short ? n(parts.r3) : t.wts(parts.r3)} subGap={g.sub} tone="g" />
          <Box x={g.cols[2] - half} y={g.r1} w={g.bw} h={g.bh} label={lab('1 × 1 conv, 16', '1×1, 16')} sub={g.short ? n(parts.r5) : t.wts(parts.r5)} subGap={g.sub} tone="g" />
          <Badge x={g.short ? g.cols[2] + half - 4 : g.cols[2] + half + 19} y={g.short ? g.r1 - 14 : g.r1 + g.bh / 2} n={2} />
        </g>
        <g data-s="3">
          {[0, 1, 2, 3].map((i) => <Arrow pts={[[g.cols[i], g.r1 + g.bh], [g.cols[i], i === 0 ? g.cY - 2 : g.r2 - 2]]} />)}
          <Box x={g.cols[1] - half} y={g.r2} w={g.bw} h={g.bh} label={lab('3 × 3 conv, 128', '3×3, 128')} sub={g.short ? n(parts.c3) : t.wts(parts.c3)} subGap={g.sub} tone="g" />
          <Box x={g.cols[2] - half} y={g.r2} w={g.bw} h={g.bh} label={lab('5 × 5 conv, 32', '5×5, 32')} sub={g.short ? n(parts.c5) : t.wts(parts.c5)} subGap={g.sub} tone="g" />
          <Box x={g.cols[3] - half} y={g.r2} w={g.bw} h={g.bh} label={lab('1 × 1 conv, 32', '1×1, 32')} sub={g.short ? n(parts.pp) : t.wts(parts.pp)} subGap={g.sub} tone="g" />
          <Badge x={g.cols[0] + (g.short ? 24 : 30)} y={g.r2 + g.bh / 2} n={3} />
        </g>
        <g data-s="4">
          {[1, 2, 3].map((i) => <Arrow pts={[[g.cols[i], g.r2 + g.bh], [g.cols[i], g.cY - 2]]} />)}
          <Box x={g.cols[0] - half} y={g.cY} w={g.cols[3] - g.cols[0] + g.bw} h={36} label={t.concat} tone="h" />
          <Arrow pts={[[g.W / 2, g.cY + 36], [g.W / 2, g.outY - 18]]} />
          <text class="f-label" x={g.W / 2 + 14} y={g.outY - 2}>{t.out}</text>
          <Badge x={g.W / 2 - 22} y={g.outY - 8} n={4} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
