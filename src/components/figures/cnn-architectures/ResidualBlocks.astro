---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Op from '../seqflow/Op.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import NewMark from '../seqflow/NewMark.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The two ResNet blocks: the basic block (two 3 × 3 convolutions) and the bottleneck (1 × 1 → 3 × 3 → 1 × 1),
// weights without biases, as printed in the Code section for 256 channels.
const w = (cin: number, cout: number, k: number) => cin * cout * k * k;
const basic64 = 2 * w(64, 64, 3);
const basic256 = 2 * w(256, 256, 3);
const bott = [w(256, 64, 1), w(64, 64, 3), w(64, 256, 1)];
const bottTotal = bott.reduce((a, b) => a + b, 0);
if (basic64 !== 73728 || basic256 !== 1179648 || bottTotal !== 69632) throw new Error('ResidualBlocks: weight counts drifted');
const n = (v: number) => (ru ? v.toLocaleString('en-US').replace(/,/g, ' ') : v.toLocaleString('en-US'));
const vesa = (v: number) => (v % 10 === 1 && v % 100 !== 11 ? 'вес' : v % 10 >= 2 && v % 10 <= 4 && (v % 100 < 12 || v % 100 > 14) ? 'веса' : 'весов');

const t = ru
  ? {
      title: 'Остаточные блоки ResNet: базовый и bottleneck',
      basic: 'базовый блок, 64 канала', bott: 'bottleneck, 256 каналов', basicShort: 'базовый, 64 канала', identity: 'тождественно',
      bnrelu: 'BN, ReLU', bn: 'BN', wts: (v: number) => `${n(v)} ${vesa(v)}`, total: (v: number) => `всего ${n(v)} ${vesa(v)}`,
      steps: ['ветвь F(x): две свёртки 3 × 3 с BN вычисляют поправку', 'обход: x передаётся без изменений и без весов', 'сложение x + F(x), затем ReLU', 'bottleneck: 1 × 1 сжимает 256 каналов до 64, 3 × 3 работает на 64, 1 × 1 восстанавливает 256'],
      desc: 'Слева базовый блок: вход x с 64 каналами проходит через свёртку 3 × 3, BN и ReLU, свёртку 3 × 3 и BN; параллельно x идёт по обходному пути; оба складываются, затем ReLU. Справа блок bottleneck для 256 каналов: свёртка 1 × 1 до 64 каналов, 3 × 3 на 64 канала и 1 × 1 обратно до 256, обход и сложение. Подписаны числа весов: 73 728 у базового блока и 69 632 у bottleneck.',
    }
  : {
      title: 'ResNet\'s residual blocks: the basic block and the bottleneck',
      basic: 'basic block, 64 channels', bott: 'bottleneck, 256 channels', basicShort: 'basic, 64 channels', identity: 'identity',
      bnrelu: 'BN, ReLU', bn: 'BN', wts: (v: number) => `${n(v)} weights`, total: (v: number) => `${n(v)} weights in all`,
      steps: ['the branch F(x): two 3 × 3 convolutions with BN compute a correction', 'the shortcut carries x unchanged, with no weights', 'add x + F(x), then ReLU', 'bottleneck: 1 × 1 shrinks 256 channels to 64, 3 × 3 works on 64, 1 × 1 restores 256'],
      desc: 'Left, the basic block: an input x with 64 channels goes through a 3 × 3 convolution, BN and ReLU, a 3 × 3 convolution and BN; in parallel x takes the shortcut; the two are added, then a ReLU. Right, the bottleneck block for 256 channels: 1 × 1 convolution to 64 channels, 3 × 3 at 64, 1 × 1 back to 256, the shortcut and the addition. Weight counts are labelled: 73,728 for the basic block and 69,632 for the bottleneck.',
    };
const id = 'cnn-residual-blocks';
const caption = ru
  ? `Обход ничего не вычисляет, поэтому при F(x) ≈ 0 блок пропускает вход без изменений, и градиент доходит до x через тождественное слагаемое. Базовый блок (ResNet-18 и 34) на 64 каналах имеет ${n(basic64)} весов. Bottleneck (ResNet-50, 101 и 152) на 256 каналах имеет ${n(bottTotal)} ${vesa(bottTotal)}, тогда как две свёртки 3 × 3 на 256 каналах имели бы ${n(basic256)}. После каждой свёртки идёт BN, после первых двух свёрток bottleneck — ещё и ReLU.`
  : `The shortcut computes nothing, so with F(x) ≈ 0 the block passes its input through, and the gradient reaches x through the identity term. The basic block (ResNet-18 and 34) has ${n(basic64)} weights at 64 channels. The bottleneck (ResNet-50, 101 and 152) has ${n(bottTotal)} weights at 256 channels, where two 3 × 3 convolutions at 256 channels would have ${n(basic256)}. Every convolution is followed by BN, and the first two convolutions of the bottleneck also by a ReLU.`;

const L = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 470, cx: [190, 560], bw: 190, bh: 40, y0: 52, gap: 64, skip: 120, short: false },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 520, cx: [80, 262], bw: 128, bh: 46, y0: 62, gap: 70, skip: 82, short: true },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {L.map((g) => {
    const half = g.bw / 2;
    const ys = [0, 1, 2, 3].map((i) => g.y0 + 40 + i * g.gap);
    const addY = ys[3] + g.bh + 34;
    const reluY = addY + 52;
    const blocks = [
      { title: g.short ? t.basicShort : t.basic, boxes: [['3 × 3 conv, 64', t.wts(w(64, 64, 3))], [t.bnrelu, ''], ['3 × 3 conv, 64', t.wts(w(64, 64, 3))], [t.bn, '']], total: basic64 },
      { title: t.bott, boxes: [['1 × 1 conv, 64', t.wts(bott[0])], ['3 × 3 conv, 64', t.wts(bott[1])], ['1 × 1 conv, 256', t.wts(bott[2])], [t.bn, '']], total: bottTotal },
    ];
    return (
      <svg class={g.cls} viewBox={`0 0 ${g.W} ${g.H}`} role="img" aria-labelledby={`${id}-${g.sfx}-t ${id}-${g.sfx}-d`}>
        <title id={`${id}-${g.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${g.sfx}-d`}>{t.desc}</desc>
        {blocks.map((b, k) => {
          const cx = g.cx[k];
          const sx = cx + g.skip;
          const steps = k === 0 ? ['1', '2', '3'] : ['4', '4', '4'];
          return (
            <g>
              <text class="f-small f-t-muted" x={cx} y={g.y0 - 30} text-anchor="middle">{b.title}</text>
              <text class="f-math" x={cx} y={g.y0} text-anchor="middle">x</text>
              <g data-s={steps[0]}>
                <Arrow pts={[[cx, g.y0 + 8], [cx, ys[0] - 2]]} />
                {b.boxes.map(([label, sub], i) => (
                  <g>
                    <Box x={cx - half} y={ys[i]} w={g.bw} h={g.bh} label={g.short && sub ? label.replace(' conv', '') : label} sub={sub ? (g.short ? sub.replace(/ (weights|весов|веса|вес)$/, '') : sub) : undefined} subGap={g.short ? 17 : 16} tone={sub ? 'g' : 'n'} />
                    {i < 3 && <Arrow pts={[[cx, ys[i] + g.bh], [cx, ys[i + 1] - 2]]} />}
                  </g>
                ))}
                <Arrow pts={[[cx, ys[3] + g.bh], [cx, addY - 15]]} />
                {k === 0 && <Badge x={g.short ? cx - 20 : cx - half - 16} y={g.short ? ys[0] - 14 : ys[0] + g.bh / 2} n={1} />}
              </g>
              <g data-s={steps[1]}>
                <Arrow pts={[[cx, g.y0 + 14], [sx, g.y0 + 14], [sx, addY], [cx + 15, addY]]} tone="blue" />
                {k === 0 && <NewMark x={sx - 14} y={g.y0 + 4} w={28} h={addY - g.y0 + 6} label={g.short ? '' : t.identity} at="tr" />}
                {k === 0 && <Badge x={sx + (g.short ? 25 : 26)} y={(g.y0 + addY) / 2} n={2} />}
              </g>
              <g data-s={steps[2]}>
                <Op x={cx} y={addY} sym="+" />
                <Arrow pts={[[cx, addY + 13], [cx, reluY - 15]]} />
                <Op x={cx} y={reluY} sym="ReLU" />
                <text class="f-small f-t-muted" x={cx} y={reluY + 36} text-anchor="middle">{g.short ? n(b.total) : t.total(b.total)}</text>
                {k === 0 && <Badge x={cx - 30} y={addY} n={3} />}
                {k === 1 && <Badge x={g.short ? cx - 20 : cx - half - 16} y={g.short ? ys[0] - 14 : ys[0] + g.bh / 2} n={4} />}
              </g>
            </g>
          );
        })}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
