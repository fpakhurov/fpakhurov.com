---
import BlockDiagram, { type DLayout } from '../BlockDiagram.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The loop of a tool-using agent: the model decides, the runtime executes, the observation goes back.
const t = ru
  ? { task: 'задача', model: 'модель', modelSub: 'ответить или вызвать?', run: 'среда выполнения', runSub: 'проверяет и запускает', tool: 'инструмент', toolSub: 'поиск, код, API', ok: 'подтверждение', okSub: 'перед изменениями', ans: 'ответ', call: 'вызов', obs: 'наблюдение добавляется в контекст', stop1: 'остановка: финальный ответ,', stop2: 'бюджет шагов или стоимости, повтор вызова' }
  : { task: 'task', model: 'model', modelSub: 'answer or call?', run: 'runtime', runSub: 'checks args, runs', tool: 'tool', toolSub: 'search, code, API', ok: 'human approval', okSub: 'before side effects', ans: 'answer', call: 'call', obs: 'observation appended to the context', stop1: 'stops on: a final answer,', stop2: 'a step or cost budget, a repeated call' };
const desc = ru
  ? 'Задача поступает в модель. Модель либо отвечает, либо выдаёт вызов; среда выполнения проверяет аргументы и запускает инструмент, а для действий с побочными эффектами сначала ждёт подтверждения человека. Результат инструмента как наблюдение возвращается в контекст модели, и цикл повторяется до финального ответа, исчерпания бюджета шагов или стоимости или повтора вызова.'
  : 'The task goes to the model. The model either answers or emits a call; the runtime checks the arguments and runs the tool, waiting for human approval first when the action has side effects. The tool result returns to the model as an observation in its context, and the loop repeats until a final answer, an exhausted step or cost budget, or a repeated call.';
const wide: DLayout = {
  cls: 'fig-wide', w: 720, h: 252, desc,
  nodes: [
    { id: 'task', x: 8, y: 40, w: 90, h: 44, label: t.task, tone: 'soft' },
    { id: 'model', x: 140, y: 34, w: 150, h: 56, label: t.model, sub: t.modelSub, tone: 'blue' },
    { id: 'run', x: 340, y: 34, w: 160, h: 56, label: t.run, sub: t.runSub },
    { id: 'tool', x: 552, y: 34, w: 160, h: 56, label: t.tool, sub: t.toolSub, tone: 'amber' },
    { id: 'ok', x: 340, y: 132, w: 160, h: 50, label: t.ok, sub: t.okSub, tone: 'red' },
    { id: 'ans', x: 8, y: 140, w: 104, h: 44, label: t.ans, tone: 'green' },
  ],
  edges: [
    { from: 'task', to: 'model' },
    { from: 'model', to: 'run', label: t.call },
    { from: 'run', to: 'tool' },
    { from: 'run', to: 'ok', tone: 'red', dashed: true },
    { from: 'tool', to: 'model', via: [[632, 212], [215, 212]], label: t.obs, tone: 'blue', pos: 0.5, shift: [0, 22] },
    { from: 'model', to: 'ans', tone: 'green' },
  ],
  texts: [
    { x: 8, y: 228, text: t.stop1, cls: 'f-small f-t-muted' },
    { x: 8, y: 244, text: t.stop2, cls: 'f-small f-t-muted' },
  ],
};
const narrow: DLayout = {
  cls: 'fig-narrow', w: 360, h: 392, desc,
  nodes: [
    { id: 'task', x: 30, y: 8, w: 150, h: 36, label: t.task, tone: 'soft' },
    { id: 'model', x: 30, y: 66, w: 150, h: 52, label: t.model, sub: t.modelSub, tone: 'blue' },
    { id: 'ans', x: 216, y: 70, w: 136, h: 44, label: t.ans, tone: 'green' },
    { id: 'run', x: 30, y: 158, w: 150, h: 52, label: t.run, sub: t.runSub },
    { id: 'ok', x: 216, y: 158, w: 136, h: 52, label: t.ok, sub: t.okSub, tone: 'red' },
    { id: 'tool', x: 30, y: 250, w: 150, h: 52, label: t.tool, sub: t.toolSub, tone: 'amber' },
  ],
  edges: [
    { from: 'task', to: 'model' },
    { from: 'model', to: 'ans', tone: 'green' },
    { from: 'model', to: 'run', label: t.call, at: [112, 142], anchor: 'start' },
    { from: 'run', to: 'ok', tone: 'red', dashed: true },
    { from: 'run', to: 'tool' },
    { from: 'tool', to: 'model', via: [[105, 322], [14, 322], [14, 92]], tone: 'blue', at: [14, 340], anchor: 'start', label: t.obs },
  ],
  texts: [
    { x: 14, y: 366, text: t.stop1, cls: 'f-small f-t-muted' },
    { x: 14, y: 382, text: t.stop2, cls: 'f-small f-t-muted' },
  ],
};
---

<BlockDiagram
  id="agent-loop"
  title={ru ? 'Цикл агента с инструментами' : 'The loop of a tool-using agent'}
  svgTitle={ru ? 'Модель, среда выполнения и инструмент в цикле' : 'Model, runtime and tool in a loop'}
  caption={ru
    ? 'Цикл агента, использующего инструменты. Модель читает свой контекст и либо отвечает, либо выдаёт вызов; среда выполнения, а не модель, проверяет аргументы по схеме инструмента, запускает его и добавляет результат в контекст как наблюдение, после чего модель решает снова. Вызовы с побочными эффектами ждут одобрения человека. Цикл заканчивается финальным ответом или останавливается извне — бюджетом шагов или стоимости либо вызовом, который повторяется с тем же результатом. В кодовом агенте, например CodeAgent из smolagents, вызов — это короткая программа на Python.'
    : 'The loop of a tool-using agent. The model reads its context and either answers or emits a call; the runtime, not the model, checks the arguments against the tool\'s schema, runs the tool and appends the result to the context as an observation, and the model decides again. Calls with side effects wait for a person to approve them. The loop ends with a final answer, or is stopped from outside by a step or cost budget or by a call that repeats with the same result. In a code agent, such as the CodeAgent of smolagents, a call is a short Python program.'}
  layouts={[wide, narrow]}
/>
