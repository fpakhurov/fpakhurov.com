---
/**
 * Boxes and arrows from data, for pipeline and loop diagrams.
 *
 * Each layout is one SVG (`fig-wide` / `fig-narrow`). A node is a box with a label (lines split on
 * "\n") and an optional muted sub-label. An edge goes from the border of one box to the border of
 * another; `via` adds bend points, `label` is drawn at the middle of the path (or at `at`).
 */
import Figure from './Figure.astro';

export type Tone = 'blue' | 'green' | 'amber' | 'red' | 'plain' | 'soft';
export interface DNode { id: string; x: number; y: number; w: number; h: number; label: string; sub?: string; tone?: Tone; math?: boolean }
export interface DEdge { from: string; to: string; via?: [number, number][]; label?: string; at?: [number, number]; tone?: 'blue' | 'green' | 'amber' | 'red' | 'muted'; dashed?: boolean; anchor?: 'start' | 'middle' | 'end' }
export interface DText { x: number; y: number; text: string; cls?: string; anchor?: 'start' | 'middle' | 'end' }
export interface DLayout { cls: string; w: number; h: number; nodes: DNode[]; edges: DEdge[]; texts?: DText[]; desc: string }
interface Props { id: string; title: string; caption: string; svgTitle: string; layouts: DLayout[] }
const { id, title, caption, svgTitle, layouts } = Astro.props;

const fill: Record<Tone, string> = { blue: 'f-fill-blue', green: 'f-fill-green', amber: 'f-fill-amber', red: 'f-fill-red', plain: 'f-fill-paper', soft: 'f-box-soft' };
const stroke: Record<Tone, string> = { blue: 'f-blue', green: 'f-green', amber: 'f-amber', red: 'f-red', plain: '', soft: 'f-muted' };
const textTone: Record<Tone, string> = { blue: 'f-t-blue', green: 'f-t-green', amber: 'f-t-amber', red: 'f-t-red', plain: '', soft: '' };

// Point where the segment from the box centre towards (tx, ty) leaves the box, pulled back by `gap`.
function exit(n: DNode, tx: number, ty: number, gap = 3): [number, number] {
  const cx = n.x + n.w / 2, cy = n.y + n.h / 2, dx = tx - cx, dy = ty - cy;
  if (dx === 0 && dy === 0) return [cx, cy];
  const sx = dx === 0 ? Infinity : (n.w / 2) / Math.abs(dx);
  const sy = dy === 0 ? Infinity : (n.h / 2) / Math.abs(dy);
  const s = Math.min(sx, sy);
  const len = Math.hypot(dx, dy);
  return [cx + dx * s + (dx / len) * gap, cy + dy * s + (dy / len) * gap];
}
function edgePath(L: DLayout, e: DEdge) {
  const a = L.nodes.find((n) => n.id === e.from), b = L.nodes.find((n) => n.id === e.to);
  if (!a || !b) throw new Error(`BlockDiagram ${id}: edge ${e.from} → ${e.to} names an unknown node`);
  const via = e.via ?? [];
  const first = via[0] ?? [b.x + b.w / 2, b.y + b.h / 2];
  const last = via[via.length - 1] ?? [a.x + a.w / 2, a.y + a.h / 2];
  const p0 = exit(a, first[0], first[1], 1);
  const p1 = exit(b, last[0], last[1], 3);
  const pts = [p0, ...via, p1];
  const d = pts.map((p, i) => `${i ? 'L' : 'M'} ${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(' ');
  // label position: the given point, or the middle of the longest segment
  let at = e.at;
  if (!at) {
    let best = 0;
    for (let i = 0; i < pts.length - 1; i++) {
      const l = Math.hypot(pts[i + 1][0] - pts[i][0], pts[i + 1][1] - pts[i][1]);
      if (l > best) { best = l; at = [(pts[i][0] + pts[i + 1][0]) / 2, (pts[i][1] + pts[i + 1][1]) / 2 - 6]; }
    }
  }
  return { d, at: at! };
}
const marker = (tone?: string) => `url(#f-arrow${tone ? `-${tone}` : ''})`;
---

<Figure id={id} title={title} caption={caption}>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`${id}-${L.w}-t ${id}-${L.w}-d`}>
      <title id={`${id}-${L.w}-t`}>{svgTitle}</title>
      <desc id={`${id}-${L.w}-d`}>{L.desc}</desc>
      {L.edges.map((e) => {
        const { d } = edgePath(L, e);
        return <path class={`f-line ${e.tone ? `f-${e.tone}` : ''} ${e.dashed ? 'f-dash' : ''}`} d={d} marker-end={marker(e.tone)} />;
      })}
      {L.nodes.map((n) => {
        const tone = n.tone ?? 'plain';
        const lines = n.label.split('\n');
        const lineH = 17;
        const top = n.y + n.h / 2 - ((lines.length - 1) * lineH) / 2 + (n.sub ? -7 : 5);
        return (
          <g>
            <rect class={fill[tone]} x={n.x} y={n.y} width={n.w} height={n.h} rx="7" />
            <rect class={`f-thin ${stroke[tone]}`} x={n.x} y={n.y} width={n.w} height={n.h} rx="7" fill="none" />
            {lines.map((line, i) => <text class={`${n.math ? 'f-math' : 'f-label'} ${textTone[tone]}`} x={n.x + n.w / 2} y={top + i * lineH} text-anchor="middle">{line}</text>)}
            {n.sub && <text class="f-small f-t-muted" x={n.x + n.w / 2} y={top + (lines.length - 1) * lineH + 18} text-anchor="middle">{n.sub}</text>}
          </g>
        );
      })}
      {L.edges.filter((e) => e.label).map((e) => {
        const { at } = edgePath(L, e);
        return <text class={`f-small f-halo ${e.tone ? `f-t-${e.tone}` : 'f-t-muted'}`} x={at[0]} y={at[1]} text-anchor={e.anchor ?? 'middle'}>{e.label}</text>;
      })}
      {(L.texts ?? []).map((t) => <text class={t.cls ?? 'f-small f-t-muted'} x={t.x} y={t.y} text-anchor={t.anchor ?? 'start'}>{t.text}</text>)}
    </svg>
  ))}
</Figure>
