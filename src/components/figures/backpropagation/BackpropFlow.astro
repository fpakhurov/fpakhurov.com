---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Op from '../seqflow/Op.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import MathLabel from './MathLabel.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The worked example of the note: x = (1, 2), W₁ = [[1, 0], [−1, 1], [0.5, −1]], W₂ = [[1, −1, 2], [0.5, 1, −1]],
// zero biases, ReLU hidden layer, softmax output, true class 1. Forward values flow right (top row), gradients left.
const x = [1, 2];
const W1 = [[1, 0], [-1, 1], [0.5, -1]], W2 = [[1, -1, 2], [0.5, 1, -1]];
const y = 0;
const z1 = W1.map((r) => r[0] * x[0] + r[1] * x[1]);
const h = z1.map((v) => Math.max(0, v));
const z2 = W2.map((r) => r.reduce((s, w, j) => s + w * h[j], 0));
const e = z2.map((v) => Math.exp(v - Math.max(...z2))), S = e.reduce((a, b) => a + b, 0);
const p = e.map((v) => v / S);
const L = -Math.log(p[y]);
const dz2 = p.map((v, k) => v - (k === y ? 1 : 0));
const dW2 = dz2.map((g) => h.map((v) => g * v));
const dh = h.map((_, j) => W2.reduce((s, r, k) => s + r[j] * dz2[k], 0));
const dz1 = dh.map((g, j) => (z1[j] > 0 ? g : 0));
const dW1 = dz1.map((g) => x.map((v) => g * v));
const f2 = (v: number) => (Math.abs(v) < 5e-13 ? '0' : Number.isInteger(v) ? String(v) : v.toFixed(2).replace('-', '−'));
const f3 = (v: number) => v.toFixed(3);
const quoted = [z1, h, z2, p, [L], dz2, dh, dz1, dW1.flat()].map((a) => a.map(f3).join(' ')).join(' | ');
if (quoted !== '1.000 1.000 -1.500 | 1.000 1.000 0.000 | 0.000 1.500 | 0.182 0.818 | 1.701 | -0.818 0.818 | -0.409 1.635 -2.453 | -0.409 1.635 0.000 | -0.409 -0.818 1.635 3.270 0.000 0.000')
  throw new Error(`BackpropFlow: the worked example drifted from the note (${quoted})`);
const V = (a: number[]) => a.map(f2);
const t = ru
  ? { fwd: 'прямой проход: значения', bwd: 'обратный проход: градиенты', grad: 'градиент', loss: '−log p₁', mask: '1[z₁ > 0]', dW1: '~W_1 = ~z_1x^T', dW2: '~W_2 = ~z_2h^T',
      steps: ['первый слой: z₁ = W₁x + b₁', 'ReLU: h = max(0, z₁)', 'второй слой и потери: z₂ = W₂h + b₂, p = softmax(z₂), L = −log p₁', 'через softmax и кросс-энтропию: z̄₂ = p − e₁', 'второй слой назад: W̄₂ = z̄₂hᵀ, h̄ = W₂ᵀz̄₂', 'через ReLU: z̄₁ = h̄ ⊙ 1[z₁ > 0]', 'первый слой назад: W̄₁ = z̄₁xᵀ, b̄₁ = z̄₁'] }
  : { fwd: 'forward pass: values', bwd: 'backward pass: gradients', grad: 'gradient', loss: '−log p₁', mask: '1[z₁ > 0]', dW1: '~W_1 = ~z_1x^T', dW2: '~W_2 = ~z_2h^T',
      steps: ['first layer: z₁ = W₁x + b₁', 'ReLU: h = max(0, z₁)', 'second layer and loss: z₂ = W₂h + b₂, p = softmax(z₂), L = −log p₁', 'through softmax and cross-entropy: z̄₂ = p − e₁', 'second layer backwards: W̄₂ = z̄₂hᵀ, h̄ = W₂ᵀz̄₂', 'through the ReLU: z̄₁ = h̄ ⊙ 1[z₁ > 0]', 'first layer backwards: W̄₁ = z̄₁xᵀ, b̄₁ = z̄₁'] };
const id = 'backprop-flow';
const caption = ru
  ? `Пример из текста: x = (1, 2), веса W₁ и W₂ из текста, нулевые смещения, истинный класс 1. Верхний ряд — прямой проход слева направо (1–3): z₁ = (1, 1, −1.5), h = (1, 1, 0), z₂ = (0, 1.5), p = (${f3(p[0])}, ${f3(p[1])}), L = ${f3(L)}. Нижний ряд — обратный проход справа налево (4–7): начиная с L̄ = 1, каждый шаг умножает градиент на транспонированный якобиан своей операции и использует значения, сохранённые при прямом проходе (пунктир). Третий нейрон выключен (z₁ < 0), поэтому маска ReLU обнуляет его градиент, и его входные веса для этого примера не меняются.`
  : `The worked example of the text: x = (1, 2), the weights W₁ and W₂ of the text, zero biases, true class 1. The top row is the forward pass, left to right (1–3): z₁ = (1, 1, −1.5), h = (1, 1, 0), z₂ = (0, 1.5), p = (${f3(p[0])}, ${f3(p[1])}), L = ${f3(L)}. The bottom row is the backward pass, right to left (4–7): starting from L̄ = 1, each step multiplies the gradient by the transposed Jacobian of its operation and uses values stored during the forward pass (dashed). The third hidden unit is off (z₁ < 0), so the ReLU mask zeroes its gradient and its incoming weights do not change for this example.`;
---

<Figure
  id={id}
  title={ru ? 'Обратное распространение в сети с двумя слоями' : 'Backpropagation through a two-layer network'}
  caption={caption}
>
  <svg class="fig-wide" viewBox="0 0 760 500" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{ru ? 'Прямой и обратный проход' : 'Forward and backward pass'}</title>
    <desc id={`${id}-w-d`}>{ru
      ? 'Верхний ряд: x, W₁, z₁, ReLU, h, W₂, z₂, softmax, p и потери L, стрелки вправо. Нижний ряд: градиенты L̄, z̄₂, h̄, z̄₁, стрелки влево через p − e₁, W₂ᵀ и маску ReLU; снизу матрицы градиентов весов W̄₁ и W̄₂.'
      : 'Top row: x, W₁, z₁, ReLU, h, W₂, z₂, softmax, p and the loss L, arrows to the right. Bottom row: the gradients L̄, z̄₂, h̄, z̄₁, arrows to the left through p − e₁, W₂ᵀ and the ReLU mask; below, the weight gradients W̄₁ and W̄₂ as matrices.'}</desc>
    <text class="f-small f-t-muted" x="16" y="28">{t.fwd}</text>
    <text class="f-small f-t-muted" x="16" y="232">{t.bwd}</text>
    <g data-s="1">
      <Vec x={16} y={78} values={V(x)} tone="x" cw={48} label="x" />
      <Arrow pts={[[64, 100], [86, 100]]} />
      <Box x={88} y={85} w={48} h={30} label="W_1" tone="g" math />
      <Arrow pts={[[136, 100], [156, 100]]} />
      <Vec x={158} y={67} values={V(z1)} tone="h" cw={48} label="z_1" />
      <Badge x={112} y={68} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[206, 100], [222, 100]]} />
      <Op x={246} y={100} sym="ReLU" />
      <Arrow pts={[[268, 100], [286, 100]]} />
      <Vec x={288} y={67} values={V(h)} tone="h" cw={48} label="h" />
      <Badge x={246} y={70} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[336, 100], [352, 100]]} />
      <Box x={354} y={85} w={48} h={30} label="W_2" tone="g" math />
      <Arrow pts={[[402, 100], [420, 100]]} />
      <Vec x={422} y={78} values={V(z2)} tone="y" cw={48} label="z_2" />
      <Arrow pts={[[470, 100], [483, 100]]} />
      <Op x={518} y={100} sym="softmax" />
      <Arrow pts={[[552, 100], [566, 100]]} />
      <Vec x={568} y={78} values={p.map((v) => v.toFixed(2))} tone="y" cw={48} label="p" />
      <Arrow pts={[[616, 100], [674, 100]]} label={t.loss} at={[645, 90]} anchor="middle" labelTone="y" />
      <Vec x={676} y={89} values={[L.toFixed(2)]} tone="y" cw={56} label="L" />
      <Badge x={518} y={70} n={3} />
    </g>
    <g data-s="4">
      <Vec x={676} y={289} values={['1']} tone="y" cw={56} />
      <MathLabel x={704} y={278} anchor="middle" label="~L" />
      <Arrow pts={[[676, 300], [616, 300]]} tone="red" />
      <Op x={584} y={300} sym="p − e₁" />
      <path class="f-thin f-muted f-dash" d="M 592 122 V 286" />
      <Arrow pts={[[553, 300], [472, 300]]} tone="red" />
      <Vec x={422} y={278} values={V(dz2)} tone="y" cw={48} />
      <MathLabel x={446} y={267} anchor="middle" label="~z_2" />
      <Badge x={584} y={332} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[422, 300], [404, 300]]} tone="red" />
      <Box x={354} y={285} w={48} h={30} label="" tone="g" />
      <MathLabel x={378} y={305} anchor="middle" label="W_2^T" />
      <Arrow pts={[[354, 300], [338, 300]]} tone="red" />
      <Vec x={288} y={267} values={V(dh)} tone="h" cw={48} />
      <MathLabel x={312} y={256} anchor="middle" label="~h" />
      <Arrow pts={[[446, 322], [446, 366]]} tone="red" />
      {dW2.map((row, k) => <Vec x={374} y={370 + 22 * k} values={V(row)} tone="g" dir="row" cw={48} />)}
      <MathLabel x={446} y={438} anchor="middle" label={t.dW2} />
      <Badge x={378} y={332} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[288, 300], [261, 300]]} tone="red" />
      <Op x={246} y={300} sym="⊙" />
      <path class="f-thin f-muted f-dash" d="M 246 114 V 286" />
      <text class="f-small f-t-muted f-halo" x={254} y={200}>{t.mask}</text>
      <Arrow pts={[[232, 300], [208, 300]]} tone="red" />
      <Vec x={158} y={267} values={V(dz1)} tone="h" cw={48} />
      <MathLabel x={182} y={256} anchor="middle" label="~z_1" />
      <Badge x={246} y={332} n={6} />
    </g>
    <g data-s="7">
      <Arrow pts={[[182, 334], [182, 358]]} tone="red" />
      {dW1.map((row, k) => <Vec x={134} y={360 + 22 * k} values={V(row)} tone="g" dir="row" cw={48} />)}
      <MathLabel x={182} y={448} anchor="middle" label={t.dW1} />
      <Badge x={118} y={393} n={7} />
    </g>
    <Legend x={16} y={482} step={128} />
    <path class="f-line f-red" d="M 540 478 h 26" marker-end="url(#f-arrow-red)" />
    <text class="f-small f-t-muted" x={574} y={482}>{t.grad}</text>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 770" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{ru ? 'Прямой и обратный проход' : 'Forward and backward pass'}</title>
    <desc id={`${id}-n-d`}>{ru
      ? 'Левый столбец сверху вниз: x, W₁, z₁, ReLU, h, W₂, z₂, softmax, p, L. Правый столбец снизу вверх: L̄, p − e₁, z̄₂, W₂ᵀ, h̄, маска ReLU, z̄₁. Внизу матрицы W̄₁ и W̄₂.'
      : 'Left column, top to bottom: x, W₁, z₁, ReLU, h, W₂, z₂, softmax, p, L. Right column, bottom to top: L̄, p − e₁, z̄₂, W₂ᵀ, h̄, the ReLU mask, z̄₁. Below, the matrices W̄₁ and W̄₂.'}</desc>
    <text class="f-small f-t-muted" x="8" y="18">{ru ? 'прямой проход ↓' : 'forward ↓'}</text>
    <text class="f-small f-t-muted" x="352" y="18" text-anchor="end">{ru ? 'обратный проход ↑' : 'backward ↑'}</text>
    <g data-s="1">
      <Vec x={46} y={48} values={V(x)} tone="x" dir="row" cw={42} label="x" labelPos="left" />
      <Arrow pts={[[88, 70], [88, 84]]} />
      <Box x={63} y={86} w={50} h={26} label="W_1" tone="g" math />
      <Arrow pts={[[88, 112], [88, 128]]} />
      <Vec x={25} y={152} values={V(z1)} tone="h" dir="row" cw={42} label="z_1" />
      <Badge x={128} y={99} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[88, 174], [88, 188]]} />
      <Op x={88} y={203} sym="ReLU" />
      <Arrow pts={[[88, 216], [88, 230]]} />
      <Vec x={25} y={254} values={V(h)} tone="h" dir="row" cw={42} label="h" />
      <Badge x={52} y={203} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[88, 276], [88, 290]]} />
      <Box x={63} y={292} w={50} h={26} label="W_2" tone="g" math />
      <Arrow pts={[[88, 318], [88, 332]]} />
      <Vec x={46} y={356} values={V(z2)} tone="y" dir="row" cw={42} label="z_2" />
      <Arrow pts={[[88, 378], [88, 392]]} />
      <Op x={88} y={405} sym="softmax" />
      <Arrow pts={[[88, 418], [88, 432]]} />
      <Vec x={46} y={456} values={p.map((v) => v.toFixed(2))} tone="y" dir="row" cw={42} label="p" />
      <Arrow pts={[[88, 478], [88, 514]]} label={t.loss} at={[96, 500]} labelTone="y" />
      <Vec x={62} y={538} values={[L.toFixed(2)]} tone="y" cw={52} label="L" />
      <Badge x={36} y={405} n={3} />
    </g>
    <g data-s="4">
      <Vec x={246} y={538} values={['1']} tone="y" cw={52} />
      <MathLabel x={240} y={554} anchor="end" label="~L" />
      <Arrow pts={[[272, 538], [272, 482]]} tone="red" />
      <Op x={272} y={467} sym="p − e₁" />
      <path class="f-thin f-muted f-dash" d="M 132 467 H 240" />
      <Arrow pts={[[272, 454], [272, 380]]} tone="red" />
      <Vec x={230} y={356} values={V(dz2)} tone="y" dir="row" cw={42} />
      <MathLabel x={224} y={372} anchor="end" label="~z_2" />
      <Badge x={318} y={467} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[272, 356], [272, 320]]} tone="red" />
      <Box x={247} y={292} w={50} h={26} label="" tone="g" />
      <MathLabel x={272} y={311} anchor="middle" label="W_2^T" />
      <Arrow pts={[[272, 292], [272, 278]]} tone="red" />
      <Vec x={209} y={254} values={V(dh)} tone="h" dir="row" cw={42} />
      <MathLabel x={203} y={270} anchor="end" label="~h" />
      <Badge x={312} y={305} n={5} />
      {dW2.map((row, k) => <Vec x={200} y={614 + 22 * k} values={V(row)} tone="g" dir="row" cw={42} />)}
      <MathLabel x={263} y={602} anchor="middle" label={t.dW2} />
    </g>
    <g data-s="6">
      <Arrow pts={[[272, 254], [272, 216]]} tone="red" />
      <Op x={272} y={203} sym="⊙" />
      <path class="f-thin f-muted f-dash" d="M 112 203 H 258" />
      <text class="f-small f-t-muted f-halo" x={185} y={196} text-anchor="middle">{t.mask}</text>
      <Arrow pts={[[272, 190], [272, 176]]} tone="red" />
      <Vec x={209} y={152} values={V(dz1)} tone="h" dir="row" cw={42} />
      <MathLabel x={203} y={168} anchor="end" label="~z_1" />
      <Badge x={298} y={203} n={6} />
    </g>
    <g data-s="7">
      {dW1.map((row, k) => <Vec x={40} y={614 + 22 * k} values={V(row)} tone="g" dir="row" cw={42} />)}
      <MathLabel x={82} y={602} anchor="middle" label={t.dW1} />
      <Badge x={24} y={647} n={7} />
    </g>
    <Legend x={16} y={710} step={170} rows={2} />
    <path class="f-line f-red" d="M 16 746 h 26" marker-end="url(#f-arrow-red)" />
    <text class="f-small f-t-muted" x={50} y={750}>{t.grad}</text>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
