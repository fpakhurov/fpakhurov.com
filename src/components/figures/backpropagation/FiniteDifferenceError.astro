---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The loss of the worked example as a function of the single weight a = (W₁)₁₁ near a = 1, in double precision.
// Its exact derivative from backpropagation is −0.40879. Finite differences with step ε: the central difference
// [L(a + ε) − L(a − ε)] / 2ε has truncation error ∝ ε², the forward difference [L(a + ε) − L(a)] / ε ∝ ε; both have
// a rounding error ∝ 1/ε (about 10⁻¹⁶ relative error in each L, divided by ε), so the total is V-shaped.
const loss = (a: number) => {
  const x = [1, 2], W1 = [[a, 0], [-1, 1], [0.5, -1]], W2 = [[1, -1, 2], [0.5, 1, -1]];
  const h = W1.map((r) => Math.max(0, r[0] * x[0] + r[1] * x[1]));
  const z = W2.map((r) => r[0] * h[0] + r[1] * h[1] + r[2] * h[2]);
  const m = Math.max(...z);
  return -(z[0] - m) + Math.log(Math.exp(z[0] - m) + Math.exp(z[1] - m));
};
const p1 = 1 / (1 + Math.exp(-1.5));
const grad = 1 * (1 - p1 - 1) + 0.5 * p1; // dL/da = z̄₁[0] · x[0] = (W₂[0][0](p₀ − 1) + W₂[1][0] p₁) · 1
if (grad.toFixed(5) !== '-0.40879') throw new Error('FiniteDifferenceError: the gradient drifted from the note');
const ks = Array.from({ length: 25 }, (_, i) => 1 + i / 2); // ε = 10^−1 … 10^−13 in half decades
const rows = ks.map((k) => {
  const e = 10 ** -k;
  const c = (loss(1 + e) - loss(1 - e)) / (2 * e), f = (loss(1 + e) - loss(1)) / e;
  return { k, c: Math.max(Math.abs(c - grad), 1e-16), f: Math.max(Math.abs(f - grad), 1e-16) };
});
const best = (key: 'c' | 'f') => rows.reduce((a, b) => (b[key] < a[key] ? b : a));
const bc = best('c'), bf = best('f');
const exp = (v: number) => Math.floor(Math.log10(v));
const quoted = [rows[0].c.toExponential(1), rows[0].f.toExponential(1), bc.k, exp(bc.c), bf.k, exp(bf.f)].join();
if (quoted !== '2.0e-5,1.9e-3,4.5,-12,7.5,-10') throw new Error(`FiniteDifferenceError: numbers drifted from the note (${quoted})`);
const t = ru
  ? { x: 'шаг ε', y: 'ошибка производной', c: 'центральная разность', f: 'правая разность', trunc: 'усечение ∼ ε² и ε', round: 'округление ∼ 1/ε' }
  : { x: 'step ε', y: 'error of the derivative', c: 'central difference', f: 'forward difference', trunc: 'truncation ∼ ε² and ε', round: 'rounding ∼ 1/ε' };
const id = 'finite-difference-error';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 340, x0: 70, x1: 580, y0: 20, y1: 260, leg: [150, 322], legStep: 200, legRow: 0 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 360, x0: 56, x1: 344, y0: 20, y1: 250, leg: [56, 310], legStep: 0, legRow: 24 },
];
const sup = (n: number) => String(n).replace('-', '⁻').replace(/\d/g, (d) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[+d]);
const sci = (v: number) => { const [m, e] = v.toExponential(1).split('e'); return `${m}·10${sup(+e)}`; };
const g5 = grad.toFixed(5).replace('-', '−');
---

<Figure
  id={id}
  title={ru ? 'Ошибка конечных разностей в зависимости от шага' : 'The error of finite differences against the step'}
  caption={ru
    ? `Производная функции потерь из примера в тексте по одному весу (W₁)₁₁, точное значение из обратного распространения ${g5}, вычисления в двойной точности; обе оси логарифмические. Справа ошибка определяется усечением ряда Тейлора: при ε = 0.1 она равна ${sci(rows[0].c)} для центральной разности и ${sci(rows[0].f)} для правой и падает как ε² и как ε. Слева её определяет округление, которое растёт как 1/ε. Центральная разность лучше всего при ε ≈ 10⁻⁴·⁵ (ошибка порядка 10⁻¹²), правая — при ε ≈ 10⁻⁷·⁵ (порядка 10⁻¹⁰).`
    : `The derivative of the worked example's loss with respect to one weight (W₁)₁₁, exact value ${g5} from backpropagation, computed in double precision; both axes are logarithmic. On the right the error is the truncation of the Taylor series: at ε = 0.1 it is ${sci(rows[0].c)} for the central difference and ${sci(rows[0].f)} for the forward one, falling like ε² and like ε. On the left rounding dominates and grows like 1/ε. The central difference is best near ε ≈ 10⁻⁴·⁵ (error of order 10⁻¹²), the forward one near ε ≈ 10⁻⁷·⁵ (order 10⁻¹⁰).`}
>
  {layouts.map((L) => {
    const sx = scale([-13, -1], [L.x0, L.x1]), sy = scale([-16, -2], [L.y1, L.y0]);
    const pts = (key: 'c' | 'f') => rows.map((r) => [sx(-r.k), sy(Math.log10(r[key]))] as [number, number]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Две V-образные кривые ошибки' : 'Two V-shaped error curves'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Ошибка центральной и правой разностей против шага в логарифмическом масштабе: справа обе падают с уменьшением шага, слева растут из-за округления; минимум центральной разности ниже и правее.' : 'Error of central and forward differences against the step on log scales: on the right both fall as the step shrinks, on the left both grow because of rounding; the central difference has the lower minimum at a larger step.'}</desc>
        {[-14, -12, -10, -8, -6, -4, -2].map((v) => <g><path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} /><text class="f-note" x={L.x0 - 8} y={sy(v) + 5} text-anchor="end">{`10${sup(v)}`}</text></g>)}
        {[-13, -10, -7, -4, -1].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{`10${sup(v)}`}</text>)}
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 38} text-anchor="middle">{t.x}</text>
        <path class="f-line f-blue" d={polyline(pts('c'))} />
        <path class="f-line f-red f-dash" d={polyline(pts('f'))} />
        {pts('c').map(([a, b]) => <circle cx={a.toFixed(1)} cy={b.toFixed(1)} r="2.6" class="f-solid-blue" />)}
        {pts('f').map(([a, b]) => <circle cx={a.toFixed(1)} cy={b.toFixed(1)} r="2.6" class="f-solid-red" />)}
        <text class="f-small f-t-muted f-halo" x={L.x1 - 4} y={sy(-14.8)} text-anchor="end">{t.trunc}</text>
        <text class="f-small f-t-muted f-halo" x={L.x0 + 4} y={sy(-14.8)}>{t.round}</text>
        <path class="f-line f-blue" d={`M ${L.leg[0]} ${L.leg[1]} h 24`} />
        <text class="f-small" x={L.leg[0] + 32} y={L.leg[1] + 5}>{t.c}</text>
        <path class="f-line f-red f-dash" d={`M ${L.leg[0] + L.legStep} ${L.leg[1] + L.legRow} h 24`} />
        <text class="f-small" x={L.leg[0] + L.legStep + 32} y={L.leg[1] + L.legRow + 5}>{t.f}</text>
      </svg>
    );
  })}
</Figure>
