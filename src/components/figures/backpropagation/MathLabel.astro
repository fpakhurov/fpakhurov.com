---
/**
 * An SVG math label with overlines, used for gradients (z̄ = ∂L/∂z) because combining macrons render unreliably in
 * the figure fonts. Syntax: "~z" overlines the next character, "_1" or "_{12}" is a subscript, "^T" a superscript.
 */
interface Props { x: number; y: number; label: string; anchor?: 'start' | 'middle' | 'end'; cls?: string }
const { x, y, label, anchor = 'start', cls = 'f-math' } = Astro.props;
type Part = { t: string; bar?: boolean; sub?: boolean; sup?: boolean };
const parts: Part[] = [];
for (let i = 0; i < label.length; i += 1) {
  const c = label[i];
  if (c === '~') { parts.push({ t: label[i + 1], bar: true }); i += 1; continue; }
  if (c === '_' || c === '^') {
    let s = label[i + 1];
    let j = i + 1;
    if (s === '{') { const k = label.indexOf('}', i); s = label.slice(i + 2, k); j = k; }
    parts.push(c === '_' ? { t: s, sub: true } : { t: s, sup: true });
    i = j;
    continue;
  }
  const last = parts[parts.length - 1];
  if (last && !last.bar && !last.sub && !last.sup) last.t += c; else parts.push({ t: c });
}
---
<text class={cls} x={x} y={y} text-anchor={anchor}>{parts.map((p) => p.bar
  ? <tspan style="text-decoration: overline">{p.t}</tspan>
  : p.sub ? <tspan baseline-shift="sub" font-size="0.72em">{p.t}</tspan>
  : p.sup ? <tspan baseline-shift="super" font-size="0.72em" font-style="normal">{p.t}</tspan>
  : p.t)}</text>
