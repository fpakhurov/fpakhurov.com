---
import Figure from '../Figure.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The calc pipeline with toy durations in minutes; needs are the edges of the graph.
const jobs = ['lint', 'unit', 'build', 'integration', 'release'] as const;
type Job = (typeof jobs)[number];
const d: Record<Job, number> = { lint: 1, unit: 4, build: 6, integration: 5, release: 1 };
const needs: Record<Job, Job[]> = { lint: [], unit: [], build: [], integration: ['build'], release: ['build', 'lint', 'unit', 'integration'] };

// Earliest start and finish (forward pass), latest finish (backward pass), slack.
const ES = {} as Record<Job, number>, EF = {} as Record<Job, number>, LF = {} as Record<Job, number>;
for (const j of jobs) { ES[j] = Math.max(0, ...needs[j].map((i) => EF[i])); EF[j] = ES[j] + d[j]; }
const T = Math.max(...jobs.map((j) => EF[j]));
for (const j of [...jobs].reverse()) {
  const succ = jobs.filter((k) => needs[k].includes(j));
  LF[j] = succ.length ? Math.min(...succ.map((k) => LF[k] - d[k])) : T;
}
const slack = (j: Job) => LF[j] - EF[j];
const critical = jobs.filter((j) => slack(j) === 0);
const serial = jobs.reduce((s, j) => s + d[j], 0);
if (T !== 12 || serial !== 17) throw new Error(`T = ${T}, serial = ${serial}`);
if (critical.join(' ') !== 'build integration release') throw new Error(`critical path ${critical.join(' ')}`);
if (slack('lint') !== 10 || slack('unit') !== 7) throw new Error('slack');
if (ES.release !== EF.integration) throw new Error('release waits for integration');

const head = ru
  ? `критический путь: ${critical.map((j) => d[j]).join(' + ')} = ${T} мин`
  : `critical path: ${critical.map((j) => d[j]).join(' + ')} = ${T} min`;
const tail = ru ? `подряд: ${jobs.map((j) => d[j]).join(' + ')} = ${serial} мин` : `in sequence: ${jobs.map((j) => d[j]).join(' + ')} = ${serial} min`;
const minLabel = ru ? 'мин' : 'min';
const dur = (j: Job) => `${d[j]} ${minLabel}`;
const steps = ru
  ? ['lint, unit и build ни от чего не зависят и стартуют в минуту 0', 'integration нужен образ, поэтому задание стартует, когда заканчивается build, в минуту 6', 'release нужны все четыре задания: оно стартует в минуту 11, когда заканчивается integration', `критический путь build, integration, release: ${critical.map((j) => d[j]).join(' + ')} = ${T} мин; пунктир — резерв времени`]
  : ['lint, unit and build need nothing and start at minute 0', 'integration needs the image and starts when build ends, at minute 6', 'release needs all four and starts at minute 11, when integration ends', `the critical path build, integration, release: ${critical.map((j) => d[j]).join(' + ')} = ${T} minutes; dotted lines are slack`];
const stepOf = (j: Job) => (needs[j].length === 0 ? 1 : j === 'integration' ? 2 : 3);

interface Layout {
  cls: string; W: number; H: number; x0: number; x1: number; top: number; rowH: number; barY: number; barH: number;
  nameX: number | null; nameDy: number; axisY: number; tailY: number; sans: number; mono: number;
}
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 282, x0: 140, x1: 728, top: 36, rowH: 36, barY: 6, barH: 22, nameX: 128, nameDy: 0, axisY: 222, tailY: 270, sans: 6.5, mono: 7.5 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 346, x0: 30, x1: 340, top: 34, rowH: 50, barY: 20, barH: 20, nameX: null, nameDy: -6, axisY: 290, tailY: 334, sans: 7.3, mono: 8.4 },
];
const geo = layouts.map((L) => {
  const x = (t: number) => L.x0 + (t / T) * (L.x1 - L.x0);
  const rowTop = (i: number) => L.top + i * L.rowH;
  const bar = (j: Job) => ({ x: x(ES[j]), y: rowTop(jobs.indexOf(j)) + L.barY, w: x(EF[j]) - x(ES[j]), h: L.barH });
  // Duration labels sit inside a bar when they fit, else just after it, else just before it.
  const durPos = (j: Job) => {
    const b = bar(j), w = dur(j).length * L.sans;
    if (w + 10 < b.w) return { x: b.x + b.w / 2, anchor: 'middle', inside: true };
    if (b.x + b.w + 5 + w <= L.W - 4) return { x: b.x + b.w + 5, anchor: 'start', inside: false };
    return { x: b.x - 5, anchor: 'end', inside: false };
  };
  // Wide: names in a column left of the plot. Narrow: each name above the left end of its row.
  const namePos = (j: Job) => {
    const b = bar(j);
    return L.nameX !== null ? { x: L.nameX, anchor: 'end', y: b.y + L.barH / 2 + 4.5 } : { x: L.x0, anchor: 'start', y: b.y + L.nameDy };
  };
  for (const j of jobs) {
    const p = durPos(j), w = dur(j).length * L.sans;
    if (p.anchor === 'end' && (p.x - w < L.x0 || ES[j] === 0)) throw new Error(`no room for the duration of ${j} at ${L.W}`);
    if (L.nameX !== null && L.nameX - j.length * L.sans < 32) throw new Error(`name ${j} runs into the badges at ${L.W}`);
  }
  const textX = L.x0 + 18;
  for (const t of [head, tail]) if (textX + t.length * L.sans > L.W - 4) throw new Error(`text "${t}" too wide at ${L.W}`);
  if (rowTop(jobs.length) > L.axisY) throw new Error('rows run into the axis');
  return { x, rowTop, bar, durPos, namePos, textX };
});
const ticks = Array.from({ length: T / 2 + 1 }, (_, k) => 2 * k);
const id = 'pipeline-graph';
---

<Figure
  id={id}
  title={ru ? 'Конвейер calc во времени и его критический путь' : 'The calc pipeline over time, and its critical path'}
  caption={ru
    ? 'Каждая полоса — задание конвейера, от раннего начала до раннего окончания; длительности условные, в минутах. lint, unit и build стартуют вместе (1); integration ждёт образ и начинается в минуту 6 (2); release ждёт все четыре задания и начинается в минуту 11 (3). Самая длинная цепочка, build → integration → release, задаёт длину конвейера: 6 + 5 + 1 = 12 минут, хотя подряд задания заняли бы 17 (4). Пунктир — резерв времени: lint может стать на 10 минут дольше, unit на 7, и конвейер не удлинится; ускорять имеет смысл только задания на критическом пути.'
    : 'Each bar is a job of the pipeline, from its earliest start to its earliest finish; durations are toy values in minutes. lint, unit and build start together (1); integration waits for the image and starts at minute 6 (2); release waits for all four jobs and starts at 11 (3). The longest chain, build → integration → release, sets the length of the pipeline: 6 + 5 + 1 = 12 minutes, although the jobs one after another would take 17 (4). Dotted lines are slack: lint could take 10 minutes longer and unit 7 without delaying the pipeline, so only jobs on the critical path are worth speeding up.'}
>
  {layouts.map((L, li) => {
    const g = geo[li];
    const xRel = g.x(ES.release);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Конвейер как граф заданий на оси времени' : 'A pipeline as a graph of jobs on a time axis'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Пять полос на оси времени от 0 до 12 минут: lint от 0 до 1, unit от 0 до 4, build от 0 до 6, integration от 6 до 11 и release от 11 до 12. Цепочка build, integration, release выделена как критический путь.'
          : 'Five bars on a time axis from 0 to 12 minutes: lint from 0 to 1, unit from 0 to 4, build from 0 to 6, integration from 6 to 11 and release from 11 to 12. The chain build, integration, release is highlighted as the critical path.'}</desc>
        {ticks.map((t) => <line class="f-grid" x1={g.x(t)} x2={g.x(t)} y1={L.top - 4} y2={L.axisY} />)}
        <line class="f-axis" x1={L.x0} x2={L.x1} y1={L.axisY} y2={L.axisY} />
        {ticks.map((t) => <text class="f-small f-t-muted" x={g.x(t)} y={L.axisY + 16} text-anchor="middle">{t}</text>)}
        {jobs.map((j) => {
          const b = g.bar(j), p = g.durPos(j), n = g.namePos(j), s = slack(j);
          return (
            <g data-s={String(stepOf(j))}>
              {s !== 0 && <line class="f-thin f-muted f-dot" x1={b.x + b.w} x2={g.x(LF[j])} y1={b.y + b.h / 2} y2={b.y + b.h / 2} />}
              <rect x={b.x} y={b.y} width={b.w} height={b.h} rx="4" style="fill: var(--fig-blue); fill-opacity: 0.16; stroke: var(--fig-blue); stroke-width: 1.3" />
              <text class="f-small" x={n.x} y={n.y} text-anchor={n.anchor} style="font-family: var(--mono)">{j}</text>
              <text class={`f-small ${p.inside ? '' : 'f-halo'}`} x={p.x} y={b.y + b.h / 2 + 4.5} text-anchor={p.anchor}>{dur(j)}</text>
            </g>
          );
        })}
        <g data-s="2">
          <Arrow pts={[[g.bar('build').x + g.bar('build').w, g.bar('build').y + L.barH], [g.bar('integration').x, g.bar('integration').y - 2]]} tone="ink" />
        </g>
        <g data-s="3">
          <Arrow pts={[[xRel, g.bar('lint').y + L.barH / 2], [xRel, g.bar('release').y - 2]]} tone="ink" />
        </g>
        <g data-s="4">
          {critical.map((j) => { const b = g.bar(j); return <rect x={b.x - 2} y={b.y - 2} width={b.w + 4} height={b.h + 4} rx="5" style="fill: none; stroke: var(--fig-red); stroke-width: 2.4" />; })}
          <text class="f-small f-t-red" x={g.textX} y={18} style="font-weight: 650">{head}</text>
        </g>
        <text class="f-small f-t-muted" x={g.textX} y={L.tailY}>{tail}</text>
        <g data-s="1"><Badge x={L.W === 760 ? 20 : 12} y={g.rowTop(0) + L.barY + L.barH / 2} n={1} /></g>
        <g data-s="2"><Badge x={L.W === 760 ? 20 : 12} y={g.rowTop(3) + L.barY + L.barH / 2} n={2} /></g>
        <g data-s="3"><Badge x={L.W === 760 ? 20 : 12} y={g.rowTop(4) + L.barY + L.barH / 2} n={3} /></g>
        <g data-s="4"><Badge x={L.x0 + 4} y={13} n={4} /></g>
      </svg>
    );
  })}
  <Stepper steps={steps} />
</Figure>
