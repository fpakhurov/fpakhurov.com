---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Two softmaxes over positions for "Where was Obama born?" over "Obama was born in Hawaii."
// Illustrative probabilities; question tokens are excluded from the span search.
type Seg = 'cls' | 'q' | 'sep' | 'c';
const toks: { t: string; seg: Seg; ps: number; pe: number }[] = [
  { t: '[CLS]', seg: 'cls', ps: 0.02, pe: 0.02 },
  { t: 'Where', seg: 'q', ps: 0, pe: 0 }, { t: 'was', seg: 'q', ps: 0, pe: 0 }, { t: 'Obama', seg: 'q', ps: 0, pe: 0 },
  { t: 'born', seg: 'q', ps: 0, pe: 0 }, { t: '?', seg: 'q', ps: 0, pe: 0 },
  { t: '[SEP]', seg: 'sep', ps: 0, pe: 0 },
  { t: 'Obama', seg: 'c', ps: 0.03, pe: 0.01 }, { t: 'was', seg: 'c', ps: 0.01, pe: 0.01 }, { t: 'born', seg: 'c', ps: 0.02, pe: 0.01 },
  { t: 'in', seg: 'c', ps: 0.12, pe: 0.02 }, { t: 'Hawaii', seg: 'c', ps: 0.78, pe: 0.85 }, { t: '.', seg: 'c', ps: 0.01, pe: 0.07 },
  { t: '[SEP]', seg: 'sep', ps: 0.01, pe: 0.01 },
];
const best = toks.findIndex((k) => k.t === 'Hawaii');
const t = ru
  ? { q: 'вопрос', c: 'отрывок', start: 'начало', end: 'конец', excl: 'вопрос не участвует в поиске', cls: '[CLS]: «ответа нет»', result: 'лучшая пара с началом ≤ конца: Hawaii' }
  : { q: 'question', c: 'passage', start: 'start', end: 'end', excl: 'question excluded from the search', cls: '[CLS]: "no answer"', result: 'best pair with start ≤ end: Hawaii' };
const id = 'qa-span-heads';
const charW = 7.4;
const widths = toks.map((k) => Math.max(26, k.t.length * charW + 10));
const xs: number[] = [];
widths.reduce((x, w) => (xs.push(x), x + w + 3), 96);
const right = xs[xs.length - 1] + widths[widths.length - 1];
const span = (from: number, to: number) => [xs[from], xs[to] + widths[to]];
---

<Figure
  id={id}
  title={ru ? 'Экстрактивный QA: два распределения по позициям' : 'Extractive QA: two distributions over positions'}
  caption={ru
    ? 'Вопрос и отрывок идут в энкодер одной последовательностью, и два линейных выхода дают в каждой позиции оценку «здесь начало ответа» и «здесь конец ответа». Каждый softmax берётся по позициям, а не по классам: одна позиция начала и одна позиция конца. Токены вопроса (серые) из поиска исключаются по sequence_ids; позиция [CLS] означает «в этом окне ответа нет». Ответ — пара начало ≤ конец внутри отрывка с наибольшей суммой оценок, здесь начало и конец совпадают на Hawaii. Вероятности условные.'
    : 'Question and passage enter the encoder as one sequence, and two linear outputs score every position as "the answer starts here" and "the answer ends here". Each softmax runs over positions, not over classes: one start position and one end position. Question tokens (grey) are excluded from the search through sequence_ids; the [CLS] position stands for "no answer in this window". The answer is the start ≤ end pair inside the passage with the highest total score; here start and end coincide on Hawaii. Probabilities are illustrative.'}
>
  <svg class="fig-wide" viewBox="0 0 720 250" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{ru ? 'Оценки начала и конца по позициям' : 'Start and end scores over positions'}</title>
    <desc id={`${id}-w-d`}>{toks.map((k) => `${k.t}: ${k.seg === 'q' ? '—' : `${k.ps}/${k.pe}`}`).join(', ')}. {t.result}.</desc>
    {[[1, 5, t.q, 'f-t-muted'], [7, 12, t.c, 'f-t-blue']].map(([a, b, label, cls]) => {
      const [l, r] = span(a as number, b as number);
      return (
        <g>
          <path class="f-thin f-muted" d={`M ${l} 26 V 20 H ${r} V 26`} />
          <text class={`f-small ${cls}`} x={(l + r) / 2} y={15} text-anchor="middle">{label}</text>
        </g>
      );
    })}
    <text class="f-small f-t-muted" x={84} y={130} text-anchor="end">{t.start}</text>
    <text class="f-small f-t-muted" x={84} y={200} text-anchor="end">{t.end}</text>
    {toks.map((k, i) => {
      const x = xs[i], w = widths[i], q = k.seg === 'q';
      return (
        <g>
          <rect class={q ? 'f-box-soft' : k.seg === 'c' ? 'f-box' : 'f-box-soft'} x={x} y={30} width={w} height="26" rx="4" />
          <text class={`f-small${q || k.seg !== 'c' ? ' f-t-muted' : ''}`} x={x + w / 2} y={47} text-anchor="middle" font-family="var(--mono)">{k.t}</text>
          {!q && <rect x={x + 4} y={140 - k.ps * 70} width={w - 8} height={Math.max(1, k.ps * 70)} style={`fill: var(--fig-${i === best ? 'green' : 'blue'}); fill-opacity: ${i === best ? 0.7 : 0.45}`} />}
          {!q && <rect x={x + 4} y={210 - k.pe * 70} width={w - 8} height={Math.max(1, k.pe * 70)} style={`fill: var(--fig-${i === best ? 'green' : 'amber'}); fill-opacity: ${i === best ? 0.7 : 0.5}`} />}
          {q && <text class="f-small f-t-muted" x={x + w / 2} y={136} text-anchor="middle">·</text>}
          {q && <text class="f-small f-t-muted" x={x + w / 2} y={206} text-anchor="middle">·</text>}
        </g>
      );
    })}
    <path class="f-thin f-muted" d={`M 96 140 H ${right}`} />
    <path class="f-thin f-muted" d={`M 96 210 H ${right}`} />
    <text class="f-small f-t-muted" x={(span(1, 5)[0] + span(1, 5)[1]) / 2} y={96} text-anchor="middle">{t.excl}</text>
    <text class="f-small f-t-muted" x={xs[0]} y={232}>{t.cls}</text>
    <text class="f-small f-t-green" x={right} y={232} text-anchor="end">{t.result}</text>
  </svg>
  <svg class="fig-narrow" viewBox="0 0 360 420" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{ru ? 'Оценки начала и конца по позициям' : 'Start and end scores over positions'}</title>
    <desc id={`${id}-n-d`}>{toks.map((k) => `${k.t}: ${k.seg === 'q' ? '—' : `${k.ps}/${k.pe}`}`).join(', ')}. {t.result}.</desc>
    <text class="f-small f-t-muted" x={162} y={18}>{t.start}</text>
    <text class="f-small f-t-muted" x={262} y={18}>{t.end}</text>
    {toks.map((k, i) => {
      const y = 28 + i * 25, q = k.seg === 'q';
      return (
        <g>
          <rect class={q || k.seg !== 'c' ? 'f-box-soft' : 'f-box'} x={8} y={y} width={78} height="21" rx="4" />
          <text class={`f-small${q || k.seg !== 'c' ? ' f-t-muted' : ''}`} x={47} y={y + 15} text-anchor="middle" font-family="var(--mono)">{k.t}</text>
          <text class="f-small f-t-muted" x={96} y={y + 15}>{q ? t.q : k.seg === 'c' ? t.c : ''}</text>
          {!q && <rect x={162} y={y + 4} width={Math.max(1, k.ps * 90)} height="13" style={`fill: var(--fig-${i === best ? 'green' : 'blue'}); fill-opacity: ${i === best ? 0.7 : 0.45}`} />}
          {!q && <rect x={262} y={y + 4} width={Math.max(1, k.pe * 100)} height="13" style={`fill: var(--fig-${i === best ? 'green' : 'amber'}); fill-opacity: ${i === best ? 0.7 : 0.5}`} />}
        </g>
      );
    })}
    <text class="f-small f-t-muted" x={8} y={390}>{t.cls}</text>
    <text class="f-small f-t-green" x={8} y={410}>{t.result}</text>
  </svg>
</Figure>
