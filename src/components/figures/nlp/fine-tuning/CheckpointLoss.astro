---
import Figure from '../../Figure.astro';
import { pageLang } from '../../../../utils/lang';
import data from './cases.json';
const ru=pageLang(Astro.url)==='ru';
const {trace,best}=data.checkpoint;
const x=(step:number)=>48+step/40*246;
const y=(loss:number)=>220-loss/.8*166;
const points=(key:'train'|'validation')=>trace.map(p=>`${x(p.step)},${y(p[key])}`).join(' ');
---
<Figure id="ft-checkpoint-loss" title={ru?'Разные цели выбирают разные точки':'Different objectives select different checkpoints'} caption={ru?'Сорок шагов по обучающему градиенту. Минимум заданной валидационной ошибки среди сохранённых точек — шаг 12. Это точные ожидания на составленных распределениях.':'Forty training-gradient steps. The specified validation loss is smallest at saved step 12. These are exact expectations under constructed distributions.'}>
 <svg class="fig-compact" viewBox="0 0 320 286" role="img" aria-labelledby="ft-loss-title ft-loss-desc">
 <title id="ft-loss-title">{ru?'Обучающая и валидационная ошибки по шагам':'Training and validation loss by step'}</title>
 <desc id="ft-loss-desc">{ru?'Обучающая ошибка продолжает падать, а валидационная после шага 12 растёт.':'Training loss keeps falling while validation loss rises after step 12.'}</desc>
 {[0,.2,.4,.6,.8].map(t=><g><line x1="48" x2="294" y1={y(t)} y2={y(t)} class="f-grid"/><text x="39" y={y(t)+5} text-anchor="end">{t.toFixed(1)}</text></g>)}
 <line x1="48" y1="54" x2="48" y2="220" class="f-axis"/><line x1="48" y1="220" x2="294" y2="220" class="f-axis"/>
 {[0,10,20,30,40].map(t=><text x={x(t)} y="241" text-anchor="middle">{t}</text>)}
 <text x="171" y="266" text-anchor="middle">{ru?'Шаг':'Step'}</text>
 <polyline data-series="train" points={points('train')} class="f-line f-blue f-bold"/>
 <polyline data-series="validation" points={points('validation')} class="f-line f-amber f-bold f-dash"/>
 <line x1={x(best.step)} x2={x(best.step)} y1={y(best.validation)} y2="220" class="f-axis f-dot"/>
 <circle cx={x(best.step)} cy={y(best.validation)} r="4" class="f-solid-amber"/>
 <text x={x(best.step)+8} y={y(best.validation)-11}>{best.step}</text>
 <line x1="48" x2="72" y1="15" y2="15" class="f-line f-blue f-bold"/><text x="81" y="20">{ru?'Обучение':'Training'}</text>
 <line x1="48" x2="72" y1="36" y2="36" class="f-line f-amber f-bold f-dash"/><text x="81" y="41">{ru?'Валидация':'Validation'}</text>
 </svg>
</Figure>
<style>svg text {font-size:16px;font-variant-numeric:tabular-nums;} .f-solid-amber {fill:var(--fig-amber);}</style>
