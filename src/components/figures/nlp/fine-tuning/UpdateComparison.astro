---
import Figure from '../../Figure.astro';
import { pageLang } from '../../../../utils/lang';
import data from './cases.json';
const ru=pageLang(Astro.url)==='ru';
const variants=[
 {key:'full', label:ru?'Полный шаг':'Full step', result:data.full},
 {key:'probe', label:ru?'Только голова':'Head only', result:data.probe},
 {key:'probe-full', label:ru?'Голова, затем полный шаг':'Head, then full step', result:data.probe_then_full},
];
const fmt=(x:number)=>x.toFixed(3);
---
<Figure id="ft-update-comparison" title={ru?'Обновляемые координаты':'Which coordinates change'} caption={ru?'Матрица W слева, вектор v справа. Цвет отмечает изменение относительно начального состояния. В третьем варианте два обновления, в первых двух — одно.':'Matrix W on the left, vector v on the right. Color marks changes from the initial state. The third variant uses two updates; the first two use one.'}>
 <div class="update-grid">
 {variants.map(({key,label,result})=><div>
  <p class="variant-label">{label}</p>
  <svg viewBox="0 0 300 150" role="img" aria-labelledby={`ft-${key}-title ft-${key}-desc`}>
   <title id={`ft-${key}-title`}>{label}</title>
   <desc id={`ft-${key}-desc`}>{`W: ${result.matrix.map(r=>r.map(fmt).join(', ')).join('; ')}. v: ${result.head.map(fmt).join(', ')}.`}</desc>
   <text x="82" y="20" text-anchor="middle">W</text><text x="239" y="20" text-anchor="middle">v</text>
   {result.matrix.map((row,i)=>row.map((value,j)=><g>
    <rect x={12+j*72} y={32+i*46} width="70" height="44" rx="4" class={Math.abs(value-data.initial_matrix[i][j])>1e-12?'f-box f-fill-blue':'f-box-soft'} />
    <text x={47+j*72} y={60+i*46} text-anchor="middle">{fmt(value)}</text>
   </g>))}
   {result.head.map((value,i)=><g>
    <rect x="204" y={32+i*46} width="70" height="44" rx="4" class="f-box f-fill-green" />
    <text x="239" y={60+i*46} text-anchor="middle">{fmt(value)}</text>
   </g>)}
  </svg>
  <p class="result-label">{ru?'Ошибка':'Loss'}: {result.loss.toFixed(6)}</p>
 </div>)}
 </div>
</Figure>
<style>
.update-grid {display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:1rem;}
.variant-label,.result-label {margin:.3rem 0!important;font-size:.85rem!important;line-height:1.4;}
.variant-label {font-weight:600;}
svg {max-width:320px;}
svg text {font-variant-numeric:tabular-nums;font-size:16px;}
</style>
