---
import Figure from '../../Figure.astro';
import {pageLang} from '../../../../utils/lang';
import data from './cases.json';
const ru=pageLang(Astro.url)==='ru';
const c=data.count;
const scale=272/c.full_mib;
---
<Figure id="peft-state-budget" title={ru?'Массивы одного слоя: FP32':'One layer’s state arrays: FP32'} caption={ru?'Слой 2048 × 2048, ранг 8. Полное обучение хранит веса, градиенты и два момента. LoRA хранит замороженную базу и четыре массива для множителей. Активации и буферы исключены.':'A 2048 × 2048 layer, rank 8. Full training stores weights, gradients, and two moments. LoRA stores the frozen base and four arrays for the factors. Activations and buffers are excluded.'}>
 <svg class="fig-compact" viewBox="0 0 320 190" role="img" aria-labelledby="peft-budget-title peft-budget-desc">
  <title id="peft-budget-title">{ru?'64 MiB и 16.5 MiB при объявленных предположениях':'64 MiB and 16.5 MiB under the declared assumptions'}</title>
  <desc id="peft-budget-desc">{ru?'LoRA: 16 MiB базы плюс 0.5 MiB множителей, градиентов и моментов.':'LoRA: 16 MiB base plus 0.5 MiB factors, gradients, and moments.'}</desc>
  <text x="24" y="23">{ru?'Полное обучение':'Full training'}: {c.full_mib} MiB</text>
  <rect data-budget="full" x="24" y="34" width={c.full_mib*scale} height="25" rx="3" class="f-solid-blue"/>
  <text x="24" y="89">LoRA: {c.total_mib} MiB</text>
  <rect data-budget="frozen" x="24" y="100" width={c.frozen_mib*scale} height="25" class="f-solid-blue"/>
  <rect data-budget="update" x={24+c.frozen_mib*scale} y="100" width={c.update_mib*scale} height="25" class="f-solid-green"/>
  <text x="24" y="151">{ru?'База':'Base'}: {c.frozen_mib} MiB</text>
  <text x="24" y="177">{ru?'Обучаемые состояния':'Trainable state'}: {c.update_mib} MiB</text>
 </svg>
</Figure>
<style>svg text {font-size:16px;font-variant-numeric:tabular-nums;}</style>
