---
import Figure from '../../Figure.astro';
import {pageLang} from '../../../../utils/lang';
import data from './cases.json';
const ru=pageLang(Astro.url)==='ru';
const entries=[{id:'first',values:data.rank.first,rank:1},{id:'second',values:data.rank.second,rank:1},{id:'sum',values:data.rank.sum,rank:2}];
---
<Figure id="peft-rank-addition" title={ru?'Ранг может вырасти при сложении':'Rank can grow when updates are added'} caption={ru?'Первые две матрицы имеют по одному независимому столбцу. Их сумма — единичная матрица с двумя независимыми столбцами.':'The first two matrices each have one independent column. Their sum is the identity with two independent columns.'}>
 <div class="rank-grid">
 {entries.map(({id,values,rank},index)=><svg viewBox="0 0 200 170" role="img" aria-labelledby={`rank-${id}-title rank-${id}-desc`}>
  <title id={`rank-${id}-title`}>{ru?`Ранг ${rank}`:`Rank ${rank}`}</title>
  <desc id={`rank-${id}-desc`}>{`${values[0].join(', ')}; ${values[1].join(', ')}.`}</desc>
  <text x="100" y="22" text-anchor="middle">{index===0?'ΔW₁':index===1?'+ ΔW₂':'= I₂'}</text>
  {values.map((row,i)=>row.map((value,j)=><g>
   <rect x={47+j*54} y={35+i*46} width="52" height="44" rx="4" class={value?'f-box f-fill-green':'f-box-soft'}/>
   <text x={73+j*54} y={64+i*46} text-anchor="middle">{value}</text>
  </g>))}
  <text x="100" y="151" text-anchor="middle">{ru?'Ранг':'Rank'} {rank}</text>
 </svg>)}
 </div>
</Figure>
<style>.rank-grid {display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,170px),1fr));gap:.5rem;}svg {max-width:240px;}svg text {font-size:18px;}</style>
