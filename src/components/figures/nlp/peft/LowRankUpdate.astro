---
import Figure from '../../Figure.astro';
import {pageLang} from '../../../../utils/lang';
import data from './cases.json';
const ru=pageLang(Astro.url)==='ru';
const grids=[
 {id:'base',label:'W₀',values:data.base},
 {id:'update',label:'2BA',values:data.update},
 {id:'merged',label:'W₀ + 2BA',values:data.merged},
];
const fmt=(x:number)=>x.toFixed(1);
---
<Figure id="peft-numeric-update" title={ru?'Одна поправка ранга один':'One rank-one correction'} caption={ru?'После шага A = [1, −1, 2], B = [0.2, −0.4]ᵀ. Вторая строка поправки равна первой, умноженной на −2. Объединённая матрица даёт тот же выход (2.6, 0.8).':'After the step, A = [1, −1, 2], B = [0.2, −0.4]ᵀ. The second correction row is −2 times the first. The merged matrix gives the same output (2.6, 0.8).'}>
 <div class="matrix-grid">
 {grids.map(({id,label,values})=><svg viewBox="0 0 280 140" role="img" aria-labelledby={`peft-${id}-title peft-${id}-desc`}>
  <title id={`peft-${id}-title`}>{label}</title>
  <desc id={`peft-${id}-desc`}>{values.map(row=>row.map(fmt).join(', ')).join('; ')}</desc>
  <text x="140" y="23" text-anchor="middle" class="f-title">{label}</text>
  {values.map((row,i)=>row.map((value,j)=><g>
   <rect x={24+j*78} y={38+i*44} width="76" height="42" rx="4" class={id==='update'?'f-box f-fill-blue':'f-box-soft'}/>
   <text x={62+j*78} y={65+i*44} text-anchor="middle">{fmt(value)}</text>
  </g>))}
 </svg>)}
 </div>
</Figure>
<style>.matrix-grid {display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:1rem;}svg {max-width:320px;} svg text {font-size:17px;font-variant-numeric:tabular-nums;}</style>
