---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const id='best-predictor';
const ru=pageLang(Astro.url)==='ru';
const title=ru?'Квадратичный риск в каждой группе':'Squared risk within each group';
const caption=ru?'Условные риски для заданных групп A, B, C. По горизонтали прогноз a, по вертикали средняя квадратичная ошибка внутри группы. Минимумы достигаются при условных средних 2, 2.5 и 5; высота минимума равна условной дисперсии.':'Conditional risks for the stipulated groups A, B and C. Horizontal position is prediction a; height is mean squared error within the group. Minima occur at conditional means 2, 2.5 and 5; each minimum height equals the conditional variance.';
const number=(v:string)=>v.split('/').map(Number).reduce((a,b)=>a/b);
const xp=(x:number)=>48+40*x,yp=(y:number)=>224-5.5*y;
---
<Figure id={id} title={title} caption={caption}>
 <div class="risk-panels">
  <svg viewBox="0 0 320 280" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
   <title id={`${id}-title`}>{ru?'Три параболы условного риска':'Three conditional-risk parabolas'}</title>
   <desc id={`${id}-desc`}>{ru?'Синяя сплошная кривая A имеет минимум в точке (2, 6), красный пунктир B — (2.5, 4.75), зелёная точечная C — (5, 3). Каждая ошибка увеличивается на квадрат расстояния прогноза от своего условного среднего.':'The solid blue A curve has minimum (2, 6), dashed red B has (2.5, 4.75), and dotted green C has (5, 3). Each risk rises by the squared distance of the prediction from its conditional mean.'}</desc>
   <path d="M48 34V224H292" class="axis"/>
   {[0,8,16,24,32].map(y=><g><path d={`M44 ${yp(y)}H288`} class="grid"/><text x="38" y={yp(y)+5} text-anchor="end">{y}</text></g>)}
   {[0,1,2,3,4,5,6].map(x=><text x={xp(x)} y="246" text-anchor="middle">{x}</text>)}
   {cases.groups.map(g=><g><polyline data-series={`risk-${g.label}`} points={g.points.map(([x,y])=>`${xp(x)},${yp(y)}`).join(' ')} class={`curve ${g.label}`}/><circle data-minimum={g.label} cx={xp(number(g.mean))} cy={yp(number(g.variance))} r="4" class={`minimum ${g.label}`}/></g>)}
   <text x="48" y="22">{ru?'Квадратичный риск':'Squared risk'}</text><text x="280" y="271">a</text>
  </svg>
  <div><ul>{cases.groups.map(g=><li><span class={`swatch ${g.label}`}></span>{g.label}: {ru?'среднее':'mean'} {number(g.mean)}, {ru?'дисперсия':'variance'} {number(g.variance)}</li>)}</ul><p>{ru?'Высоты кривых сравнивают ошибки внутри разных групп. Общий риск дополнительно взвешивает их по вероятностям групп.':'Curve heights compare errors within different groups. Overall risk additionally weights them by group probabilities.'}</p></div>
 </div>
</Figure>
<style>
.risk-panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;align-items:center}.risk-panels svg{width:100%;height:auto;min-width:0}.risk-panels text{fill:var(--ink);font:15px var(--sans);font-variant-numeric:tabular-nums}.axis{fill:none;stroke:var(--ink);stroke-width:1.2}.grid{fill:none;stroke:var(--muted);stroke-opacity:.2}.curve{fill:none;stroke:var(--fig-blue);stroke-width:2.6}.curve.B{stroke:var(--fig-red);stroke-dasharray:7 4}.curve.C{stroke:var(--fig-green);stroke-dasharray:2 4}.minimum{fill:var(--fig-blue)}.minimum.B{fill:var(--fig-red)}.minimum.C{fill:var(--fig-green)}ul{list-style:none;padding:0}li{margin:.7rem 0}.swatch{display:inline-block;width:1.4rem;border-top:3px solid var(--fig-blue);margin-right:.5rem;vertical-align:middle}.swatch.B{border-color:var(--fig-red);border-top-style:dashed}.swatch.C{border-color:var(--fig-green);border-top-style:dotted}@media(max-width:700px){.risk-panels{grid-template-columns:1fr}}
</style>
