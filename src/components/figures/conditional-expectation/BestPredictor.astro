---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { mulberry32, normal } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// X ~ U(−2, 2), Y = sin(1.5 X) + 0.3 ε. The conditional mean m(x) = sin(1.5 x) has mean squared error 0.3² = 0.09,
// the noise that no predictor can remove; the best straight line bx, b = Cov(X, Y)/Var(X), adds the error of its shape.
const m = (x: number) => Math.sin(1.5 * x);
const grid = Array.from({ length: 4000 }, (_, i) => -2 + (i + 0.5) * 0.001);
const avg = (g: (x: number) => number) => grid.reduce((s, x) => s + g(x), 0) / grid.length;
const b = avg((x) => x * m(x)) / avg((x) => x * x);
const lineMse = 0.09 + avg((x) => (m(x) - b * x) ** 2);
if ([b, lineMse].map((v) => v.toFixed(3)).join() !== '0.519,0.255') throw new Error('BestPredictor: numbers drifted from the note');
const u = mulberry32(3), z = normal(u);
const pts = Array.from({ length: 260 }, () => { const x = -2 + 4 * u(); return [x, m(x) + 0.3 * z()] as [number, number]; });
const xs = Array.from({ length: 81 }, (_, i) => -2 + i * 0.05);
const id = 'best-predictor';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 620, H: 330, x0: 40, x1: 590, y0: 20, y1: 260, leg: [40, 292] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 340, x0: 16, x1: 344, y0: 16, y1: 236, leg: [16, 270] },
];
const t = ru
  ? { m: 'E[Y | X = x] = sin 1.5x: ошибка 0.090', line: `лучшая прямая ${b.toFixed(2)}x: ошибка ${lineMse.toFixed(3)}` }
  : { m: 'E[Y | X = x] = sin 1.5x: error 0.090', line: `best line ${b.toFixed(2)}x: error ${lineMse.toFixed(3)}` };
---

<Figure
  id={id}
  title={ru ? 'Условное среднее — лучший прогноз' : 'The conditional mean is the best predictor'}
  caption={ru
    ? `260 точек: X равномерно на [−2, 2], Y = sin 1.5X + шум со стандартным отклонением 0.3. Условное среднее E[Y | X] = sin 1.5X (красная кривая) имеет среднеквадратичную ошибку 0.3² = 0.090 — это шум, который не убрать никаким прогнозом. Лучшая прямая ${b.toFixed(3)}x (жёлтая) добавляет ошибку формы и даёт ${lineMse.toFixed(3)}.`
    : `260 points: X uniform on [−2, 2], Y = sin 1.5X plus noise with standard deviation 0.3. The conditional mean E[Y | X] = sin 1.5X (red curve) has mean squared error 0.3² = 0.090, the noise that no predictor can remove. The best straight line ${b.toFixed(3)}x (amber) adds the error of its shape and gets ${lineMse.toFixed(3)}.`}
>
  {layouts.map((L) => {
    const sx = scale([-2, 2], [L.x0, L.x1]), sy = scale([-1.9, 1.9], [L.y1, L.y0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Облако точек, условное среднее и лучшая прямая' : 'Point cloud, conditional mean and best line'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Точки вокруг синусоиды; красная синусоида проходит через центр облака, жёлтая прямая пересекает его наискосок.' : 'Points around a sine curve; the red sine passes through the middle of the cloud, the amber line crosses it diagonally.'}</desc>
        <path class="f-grid" d={`M ${L.x0} ${sy(0)} H ${L.x1} M ${sx(0)} ${L.y0} V ${L.y1}`} />
        {pts.map(([x, y]) => <circle cx={sx(x).toFixed(1)} cy={sy(y).toFixed(1)} r="2" style="fill: var(--fig-blue); fill-opacity: .45" />)}
        <path class="f-line f-red" style="stroke-width: 2.4" d={polyline(xs.map((x) => [sx(x), sy(m(x))]))} />
        <path class="f-line f-amber f-dash" style="stroke-width: 2.2" d={`M ${sx(-2)} ${sy(-2 * b)} L ${sx(2)} ${sy(2 * b)}`} />
        {[-2, -1, 0, 1, 2].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{v}</text>)}
        <path class="f-line f-red" d={`M ${L.leg[0]} ${L.leg[1]} h 24`} />
        <text class="f-small" x={L.leg[0] + 32} y={L.leg[1] + 5}>{t.m}</text>
        <path class="f-line f-amber f-dash" d={`M ${L.leg[0]} ${L.leg[1] + 22} h 24`} />
        <text class="f-small" x={L.leg[0] + 32} y={L.leg[1] + 27}>{t.line}</text>
      </svg>
    );
  })}
</Figure>
