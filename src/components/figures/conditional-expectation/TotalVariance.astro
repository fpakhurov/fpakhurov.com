---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Two dice, X the first and Y the larger. For each x the conditional distribution of Y (circle areas), its mean
// E[Y | X = x], and the split Var(Y) = E[Var(Y | X)] + Var(E[Y | X]).
const faces = [1, 2, 3, 4, 5, 6];
const cond = faces.map((x) => faces.map((y) => (y < x ? 0 : y === x ? x / 6 : 1 / 6)));
const means = cond.map((row) => row.reduce((s, p, j) => s + p * faces[j], 0));
const vars = cond.map((row, i) => row.reduce((s, p, j) => s + p * (faces[j] - means[i]) ** 2, 0));
const EY = means.reduce((a, b) => a + b, 0) / 6;
const unexplained = vars.reduce((a, b) => a + b, 0) / 6, explained = means.reduce((s, v) => s + (v - EY) ** 2, 0) / 6;
if ([unexplained, explained, unexplained + explained].map((v) => v.toFixed(2)).join() !== '1.20,0.77,1.97') throw new Error('TotalVariance: numbers drifted from the note');
const t = ru
  ? { x: 'X — первая кость', y: 'Y — большая', total: `Var(Y) = ${(unexplained + explained).toFixed(2)}`, un: `E[Var(Y | X)] = ${unexplained.toFixed(2)}`, ex: `Var(E[Y | X]) = ${explained.toFixed(2)}` }
  : { x: 'X: the first die', y: 'Y: the larger', total: `Var(Y) = ${(unexplained + explained).toFixed(2)}`, un: `E[Var(Y | X)] = ${unexplained.toFixed(2)}`, ex: `Var(E[Y | X]) = ${explained.toFixed(2)}` };
const id = 'total-variance';
const diamond = (x: number, y: number) => `M ${x} ${y - 6} L ${x + 6} ${y} L ${x} ${y + 6} L ${x - 6} ${y} Z`;
---

<Figure
  id={id}
  title={ru ? 'Закон полной дисперсии на двух костях' : 'The law of total variance on two dice'}
  caption={ru
    ? `Для каждого значения первой кости X — условное распределение большего значения Y (площадь кружка пропорциональна вероятности) и его среднее E[Y | X = x] (ромбы): 3.5, 3.67, 4, 4.5, 5.17, 6. Дисперсия Y = ${(unexplained + explained).toFixed(2)} складывается из средней дисперсии внутри столбцов, ${unexplained.toFixed(2)}, и дисперсии самих средних, ${explained.toFixed(2)}: знание X объясняет ${((explained / (unexplained + explained)) * 100).toFixed(0)}% разброса Y.`
    : `For each value of the first die X, the conditional distribution of the larger value Y (circle area proportional to probability) and its mean E[Y | X = x] (diamonds): 3.5, 3.67, 4, 4.5, 5.17, 6. The variance of Y, ${(unexplained + explained).toFixed(2)}, splits into the average variance within the columns, ${unexplained.toFixed(2)}, and the variance of the means themselves, ${explained.toFixed(2)}: knowing X explains ${((explained / (unexplained + explained)) * 100).toFixed(0)}% of the spread of Y.`}
>
  {[
    { cls: 'fig-wide fig-medium', W: 640, H: 340, gx: [70, 330], gy: [280, 40], bar: { x: 440, y0: 280, h: 240, w: 36, lx: 486 }, wide: true },
    { cls: 'fig-narrow seq-narrow', W: 360, H: 450, gx: [60, 330], gy: [280, 40], bar: { x: 20, y0: 360, h: 320, w: 26, lx: 0 }, wide: false },
  ].map((L) => {
    const sx = scale([0.5, 6.5], L.gx as [number, number]), sy = scale([0.5, 6.5], L.gy as [number, number]);
    const tot = unexplained + explained, k = L.bar.h / tot;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Условные распределения по столбцам и разложение дисперсии' : 'Conditional distributions by column and the split of the variance'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Шесть столбцов кружков; средние растут от 3.5 до 6; полоса дисперсии делится на 1.20 и 0.77.' : 'Six columns of circles; the means rise from 3.5 to 6; the variance bar splits into 1.20 and 0.77.'}</desc>
        {faces.map((v) => <text class="f-note" x={sx(v)} y={L.gy[0] + 22} text-anchor="middle">{v}</text>)}
        {faces.map((v) => <text class="f-note" x={L.gx[0] - 12} y={sy(v) + 5} text-anchor="middle">{v}</text>)}
        <text class="f-small f-t-muted" x={(L.gx[0] + L.gx[1]) / 2} y={L.gy[0] + 44} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.gx[0] - 20} y={L.gy[1] - 16}>{t.y}</text>
        {cond.map((row, i) => row.map((p, j) => <circle cx={sx(faces[i])} cy={sy(faces[j])} r={(17 * Math.sqrt(p)).toFixed(1)} style="fill: var(--fig-blue); fill-opacity: .4" />))}
        <path class="f-thin f-red" d={means.map((mu, i) => `${i ? 'L' : 'M'} ${sx(faces[i])} ${sy(mu)}`).join(' ')} />
        {means.map((mu, i) => <path d={diamond(sx(faces[i]), sy(mu))} class="f-solid-red" />)}
        {L.wide
          ? <g>
              <rect x={L.bar.x} y={L.bar.y0 - unexplained * k} width={L.bar.w} height={unexplained * k} style="fill: var(--fig-blue); fill-opacity: .45" />
              <rect x={L.bar.x} y={L.bar.y0 - tot * k} width={L.bar.w} height={explained * k} style="fill: var(--fig-red); fill-opacity: .5" />
              <text class="f-small" x={L.bar.x} y={L.bar.y0 - tot * k - 10}>{t.total}</text>
              <text class="f-small f-t-blue" x={L.bar.lx} y={L.bar.y0 - (unexplained * k) / 2 + 5}>{t.un}</text>
              <text class="f-small f-t-red" x={L.bar.lx} y={L.bar.y0 - unexplained * k - (explained * k) / 2 + 5}>{t.ex}</text>
            </g>
          : <g>
              <rect x={L.bar.x} y={L.bar.y0} width={unexplained * k} height={L.bar.w} style="fill: var(--fig-blue); fill-opacity: .45" />
              <rect x={L.bar.x + unexplained * k} y={L.bar.y0} width={explained * k} height={L.bar.w} style="fill: var(--fig-red); fill-opacity: .5" />
              <text class="f-small" x={L.bar.x} y={L.bar.y0 - 10}>{t.total}</text>
              <text class="f-small f-t-blue" x={L.bar.x} y={L.bar.y0 + L.bar.w + 22}>{t.un}</text>
              <text class="f-small f-t-red" x={L.bar.x + tot * k} y={L.bar.y0 + L.bar.w + 46} text-anchor="end">{t.ex}</text>
            </g>}
      </svg>
    );
  })}
</Figure>
