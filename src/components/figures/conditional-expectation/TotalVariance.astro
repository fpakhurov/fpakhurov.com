---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const id='total-variance';
const ru=pageLang(Astro.url)==='ru';
const title=ru?'Какая часть разброса остаётся после наблюдения':'Variation left after an observation';
const caption=ru?'Полная дисперсия 6 складывается из средней дисперсии внутри групп 37/8 и дисперсии групповых средних 11/8. Таблица показывает минимальные квадратичные риски при трёх объёмах информации. Различение A и B уменьшает риск лишь на 1/24.':'Total variance 6 is the sum of average within-group variance 37/8 and variance of group means 11/8. The table gives minimum squared risks for three amounts of information. Distinguishing A from B reduces risk by only 1/24.';
const number=(v:string)=>v.split('/').map(Number).reduce((a,b)=>a/b);
const within=number(cases.withinVariance),between=number(cases.betweenVariance),scale=40;
const rows=[{name:ru?'Только константа':'Constant only',risk:cases.totalVariance},{name:ru?'AB или C':'AB or C',risk:cases.coarseMse},{name:ru?'A, B или C':'A, B or C',risk:cases.withinVariance}];
---
<Figure id={id} title={title} caption={caption}>
 <div class="variance-panels">
  <svg viewBox="0 0 320 220" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
   <title id={`${id}-title`}>{ru?'Разложение дисперсии на две части':'Variance split into two parts'}</title>
   <desc id={`${id}-desc`}>{ru?'Синяя часть полосы имеет длину 4.625 единицы дисперсии, оранжевая — 1.375. Вместе они дают 6. При наблюдении группы минимальный квадратичный риск равен синей части.':'The blue bar segment has length 4.625 variance units and the amber segment has length 1.375. Together they give 6. After observing the group, minimum squared risk equals the blue part.'}</desc>
   <text x="38" y="25">{ru?'Дисперсия отклика':'Response variance'}</text>
   <rect data-variance="within" x="38" y="45" width={scale*within} height="36" class="within"/>
   <rect data-variance="between" x={38+scale*within} y="45" width={scale*between} height="36" class="between"/>
   <path d="M38 90H278" class="axis"/>
   {[0,2,4,6].map(x=><text x={38+scale*x} y="111" text-anchor="middle">{x}</text>)}
   <rect x="38" y="133" width="12" height="12" class="within"/><text x="59" y="145">{ru?'Внутри групп: 37/8':'Within groups: 37/8'}</text>
   <rect x="38" y="169" width="12" height="12" class="between"/><text x="59" y="181">{ru?'Между средними: 11/8':'Between means: 11/8'}</text>
  </svg>
  <div><table><thead><tr><th scope="col">{ru?'Информация':'Information'}</th><th scope="col">{ru?'Мин. риск':'Min. risk'}</th></tr></thead><tbody>{rows.map(r=><tr><th scope="row">{r.name}</th><td>{r.risk}</td></tr>)}</tbody></table><p>{ru?'Оставшаяся ошибка зависит от того, какие признаки доступны. Дополнительное измерение может уменьшить её.':'The remaining error depends on the available features. An additional measurement can reduce it.'}</p></div>
 </div>
</Figure>
<style>
.variance-panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;align-items:center}.variance-panels svg{width:100%;height:auto;min-width:0}.variance-panels text{fill:var(--ink);font:15px var(--sans);font-variant-numeric:tabular-nums}.axis{fill:none;stroke:var(--ink);stroke-width:1.2}.within{fill:var(--fig-blue)}.between{fill:var(--fig-amber)}.variance-panels table{display:table;width:100%;font-variant-numeric:tabular-nums}.variance-panels th,.variance-panels td{text-align:left;padding:.5rem .35rem}.variance-panels th{font-weight:500}@media(max-width:700px){.variance-panels{grid-template-columns:1fr}}
</style>
