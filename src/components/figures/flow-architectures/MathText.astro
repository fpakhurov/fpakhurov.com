---
/**
 * SVG <text> with a tiny sub/superscript markup for the flow-architecture figures.
 *   `_x` or `_{xy}`  -> subscript,   `^x` or `^{xy}` -> superscript.
 * Everything else is literal. Shifts are numeric (user units), computed from the
 * base font size of the class, so nothing depends on baseline-shift support.
 */
interface Props {
  x: number;
  y: number;
  t: string;
  class?: string;
  anchor?: 'start' | 'middle' | 'end';
  size?: number;
}

const { x, y, t, class: cls = 'f-math', anchor = 'start', size } = Astro.props;

const base =
  size ?? (cls.includes('f-math') ? 18 : cls.includes('f-small') ? 12.5 : cls.includes('f-note') ? 13.5 : 15);

// level: 0 normal, -1 subscript, 1 superscript, 2 subscript inside a superscript
type Seg = { text: string; level: -1 | 0 | 1 | 2 };
function parse(src: string, outer: 0 | 1 | -1): Seg[] {
  const out: Seg[] = [];
  let buffer = '';
  const flush = () => {
    if (buffer) out.push({ text: buffer, level: outer });
    buffer = '';
  };
  let i = 0;
  while (i < src.length) {
    const ch = src[i];
    if ((ch === '_' || ch === '^') && i + 1 < src.length) {
      flush();
      let arg: string;
      if (src[i + 1] === '{') {
        const end = src.indexOf('}', i + 2);
        arg = src.slice(i + 2, end);
        i = end + 1;
      } else {
        arg = String.fromCodePoint(src.codePointAt(i + 1)!);
        i += 1 + arg.length;
      }
      if (outer === 0) out.push(...parse(arg, ch === '_' ? -1 : 1));
      else if (outer === 1 && ch === '_') out.push({ text: arg, level: 2 });
      else out.push({ text: arg, level: outer });
      continue;
    }
    buffer += ch;
    i += 1;
  }
  flush();
  return out;
}
const segs = parse(t, 0);

const offset = (level: number) =>
  level === -1 ? 0.3 * base : level === 1 ? -0.42 * base : level === 2 ? -0.2 * base : 0;
const scaleOf = (level: number) => (level === 0 ? 1 : level === 2 ? 0.58 : 0.72);
let current = 0;
const parts = segs.map((seg) => {
  const target = offset(seg.level);
  const dy = target - current;
  current = target;
  return {
    text: seg.text,
    dy: Math.abs(dy) < 1e-6 ? undefined : dy.toFixed(2),
    size: seg.level === 0 ? undefined : (scaleOf(seg.level) * base).toFixed(1),
  };
});
---

<text x={x} y={y} class={cls} text-anchor={anchor} style={size ? `font-size: ${size}px` : undefined}>{parts.map((p) => <tspan dy={p.dy} font-size={p.size}>{p.text}</tspan>)}</text>
