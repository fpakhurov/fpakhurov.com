---
import Figure from '../Figure.astro';
import MathText from './MathText.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

/**
 * Affine coupling layer, forward and inverse, as data-driven panels.
 * Each panel is a list of primitives so the same geometry serves the wide
 * (left-to-right) and narrow (top-to-bottom) variants, and the inverse panel is
 * the forward one with every arrow along the data path reversed.
 */
type Line = { d: string; cls: string; marker?: string };
type Txt = { x: number; y: number; t: string; cls?: string; anchor?: 'start' | 'middle' | 'end'; size?: number };
type Box = { x: number; y: number; w: number; h: number; cls: string };
type Node = { x: number; y: number; sym: string };
type Panel = { lines: Line[]; texts: Txt[]; boxes: Box[]; nodes: Node[]; dots: [number, number][] };

const R = 13; // radius of the ⊙ / + nodes
const ARROW = 'url(#f-arrow)';
const ARROW_BLUE = 'url(#f-arrow-blue)';

function widePanel(y0: number, inverse: boolean): Panel {
  const inL = 24, inR = 84, outL = 596, outR = 656;
  const top = y0 + 44, bottom = y0 + 244, split = y0 + 144;
  const ya = y0 + 94, yb = y0 + 194;
  const xs = 250, xt = 420;
  const boxTop = y0 + 116, boxH = 34, boxW = 64;
  const p: Panel = { lines: [], texts: [], boxes: [], nodes: [], dots: [] };

  p.boxes.push({ x: inL, y: top, w: inR - inL, h: bottom - top, cls: 'f-box' });
  p.boxes.push({ x: outL, y: top, w: outR - outL, h: bottom - top, cls: 'f-box' });
  p.lines.push({ d: `M ${inL} ${split} H ${inR}`, cls: 'f-thin f-dash' });
  p.lines.push({ d: `M ${outL} ${split} H ${outR}`, cls: 'f-thin f-dash' });
  const left = inverse ? ['z_a', 'z_b'] : ['z_a', 'z_b'];
  const right = ['z′_a', 'z′_b'];
  p.texts.push({ x: (inL + inR) / 2, y: ya + 6, t: left[0], anchor: 'middle' });
  p.texts.push({ x: (inL + inR) / 2, y: yb + 6, t: left[1], anchor: 'middle' });
  p.texts.push({ x: (outL + outR) / 2, y: ya + 6, t: right[0], anchor: 'middle' });
  p.texts.push({ x: (outL + outR) / 2, y: yb + 6, t: right[1], anchor: 'middle' });
  p.texts.push({ x: (inL + inR) / 2, y: top - 10, t: 'z', anchor: 'middle' });
  p.texts.push({ x: (outL + outR) / 2, y: top - 10, t: 'z′', anchor: 'middle' });
  p.texts.push({ x: 340, y: y0 + 24, t: inverse ? (ru ? "Обратный проход:  z′ → z" : "Inverse pass:  z′ → z") : (ru ? "Прямой проход:  z → z′" : "Forward pass:  z → z′"), cls: 'f-title', anchor: 'middle' });

  // The conditioning half passes straight through.
  p.lines.push(inverse
    ? { d: `M ${outL} ${ya} H ${inR}`, cls: 'f-line', marker: ARROW }
    : { d: `M ${inR} ${ya} H ${outL}`, cls: 'f-line', marker: ARROW });
  p.texts.push({ x: 510, y: ya - 10, t: inverse ? (ru ? "тождественно: z_a = z′_a" : "identity: z_a = z′_a") : (ru ? "тождественно: z′_a = z_a" : "identity: z′_a = z_a"), cls: 'f-math', anchor: 'middle', size: 16 });

  // Networks s and t read the conditioning half.
  for (const [x, name] of [[xs, 's(·)'], [xt, 't(·)']] as const) {
    p.dots.push([x, ya]);
    p.lines.push({ d: `M ${x} ${ya} V ${boxTop}`, cls: 'f-thin f-blue', marker: ARROW_BLUE });
    p.boxes.push({ x: x - boxW / 2, y: boxTop, w: boxW, h: boxH, cls: 'f-box-soft' });
    p.texts.push({ x, y: boxTop + 23, t: name, anchor: 'middle' });
    p.lines.push({ d: `M ${x} ${boxTop + boxH} V ${yb - R}`, cls: 'f-thin f-blue', marker: ARROW_BLUE });
  }
  p.texts.push({ x: xs + 8, y: boxTop + boxH + 21, t: inverse ? 'exp(−s)' : 'exp(s)', cls: 'f-small f-t-blue' });
  p.texts.push({ x: xt + 8, y: boxTop + boxH + 21, t: 't', cls: 'f-small f-t-blue' });

  // The transformed half: scale, then shift (forward), or unshift, then unscale (inverse).
  if (!inverse) {
    p.nodes.push({ x: xs, y: yb, sym: '⊙' }, { x: xt, y: yb, sym: '+' });
    p.lines.push({ d: `M ${inR} ${yb} H ${xs - R}`, cls: 'f-line', marker: ARROW });
    p.lines.push({ d: `M ${xs + R} ${yb} H ${xt - R}`, cls: 'f-line', marker: ARROW });
    p.lines.push({ d: `M ${xt + R} ${yb} H ${outL}`, cls: 'f-line', marker: ARROW });
    p.texts.push({ x: (xs + xt) / 2, y: yb + 26, t: 'z_b ⊙ exp(s(z_a))', anchor: 'middle', size: 16 });
    p.texts.push({ x: (xt + outL) / 2 + 6, y: yb + 26, t: '+ t(z_a)', anchor: 'middle', size: 16 });
  } else {
    p.nodes.push({ x: xt, y: yb, sym: '−' }, { x: xs, y: yb, sym: '⊙' });
    p.lines.push({ d: `M ${outL} ${yb} H ${xt + R}`, cls: 'f-line', marker: ARROW });
    p.lines.push({ d: `M ${xt - R} ${yb} H ${xs + R}`, cls: 'f-line', marker: ARROW });
    p.lines.push({ d: `M ${xs - R} ${yb} H ${inR}`, cls: 'f-line', marker: ARROW });
    p.texts.push({ x: (xs + xt) / 2, y: yb + 26, t: 'z′_b − t(z_a)', anchor: 'middle', size: 16 });
    p.texts.push({ x: (inR + xs) / 2 + 4, y: yb + 26, t: '⊙ exp(−s(z_a))', anchor: 'middle', size: 16 });
  }
  p.texts.push({
    x: 340,
    y: y0 + 270,
    t: inverse ? (ru ? "те же s и t, вычисленные заново на z_a: ни одна сеть не обращается" : "same s and t, re-evaluated on z_a: no network is ever inverted") : (ru ? "s(·), t(·): произвольные нейронные сети от z_a" : "s(·), t(·): arbitrary neural networks of z_a"),
    cls: 'f-note',
    anchor: 'middle',
  });
  return p;
}

function narrowPanel(y0: number, inverse: boolean): Panel {
  const barL = 20, barR = 340, split = 180;
  const xa = 100, xb = 260;
  const topBar = [y0 + 40, y0 + 80] as const;
  const botBar = [y0 + 272, y0 + 312] as const;
  const ys = y0 + 140, yt = y0 + 215;
  const boxL = 124, boxW = 64, boxH = 34;
  const p: Panel = { lines: [], texts: [], boxes: [], nodes: [], dots: [] };

  for (const [y1, y2] of [topBar, botBar]) {
    p.boxes.push({ x: barL, y: y1, w: barR - barL, h: y2 - y1, cls: 'f-box' });
    p.lines.push({ d: `M ${split} ${y1} V ${y2}`, cls: 'f-thin f-dash' });
  }
  p.texts.push({ x: 180, y: y0 + 24, t: inverse ? (ru ? "Обратный:  z′ → z" : "Inverse:  z′ → z") : (ru ? "Прямой:  z → z′" : "Forward:  z → z′"), cls: 'f-title', anchor: 'middle' });
  const topNames = ['z_a', 'z_b'];
  const botNames = ['z′_a', 'z′_b'];
  p.texts.push({ x: xa, y: topBar[0] + 26, t: topNames[0], anchor: 'middle' });
  p.texts.push({ x: xb, y: topBar[0] + 26, t: topNames[1], anchor: 'middle' });
  p.texts.push({ x: xa, y: botBar[0] + 26, t: botNames[0], anchor: 'middle' });
  p.texts.push({ x: xb, y: botBar[0] + 26, t: botNames[1], anchor: 'middle' });

  p.lines.push(inverse
    ? { d: `M ${xa} ${botBar[0]} V ${topBar[1]}`, cls: 'f-line', marker: ARROW }
    : { d: `M ${xa} ${topBar[1]} V ${botBar[0]}`, cls: 'f-line', marker: ARROW });
  p.texts.push({ x: xa - 12, y: (ys + yt) / 2 + 6, t: inverse ? 'z_a = z′_a' : 'z′_a = z_a', anchor: 'end', size: 16 });

  for (const [y, name] of [[ys, 's(·)'], [yt, 't(·)']] as const) {
    p.dots.push([xa, y]);
    p.lines.push({ d: `M ${xa} ${y} H ${boxL}`, cls: 'f-thin f-blue', marker: ARROW_BLUE });
    p.boxes.push({ x: boxL, y: y - boxH / 2, w: boxW, h: boxH, cls: 'f-box-soft' });
    p.texts.push({ x: boxL + boxW / 2, y: y + 6, t: name, anchor: 'middle' });
    p.lines.push({ d: `M ${boxL + boxW} ${y} H ${xb - R}`, cls: 'f-thin f-blue', marker: ARROW_BLUE });
  }
  const mid = (boxL + boxW + xb - R) / 2;
  p.texts.push({ x: mid, y: ys - 9, t: inverse ? 'exp(−s)' : 'exp(s)', cls: 'f-small f-t-blue', anchor: 'middle' });
  p.texts.push({ x: mid, y: yt - 9, t: 't', cls: 'f-small f-t-blue', anchor: 'middle' });

  if (!inverse) {
    p.nodes.push({ x: xb, y: ys, sym: '⊙' }, { x: xb, y: yt, sym: '+' });
    p.lines.push({ d: `M ${xb} ${topBar[1]} V ${ys - R}`, cls: 'f-line', marker: ARROW });
    p.lines.push({ d: `M ${xb} ${ys + R} V ${yt - R}`, cls: 'f-line', marker: ARROW });
    p.lines.push({ d: `M ${xb} ${yt + R} V ${botBar[0]}`, cls: 'f-line', marker: ARROW });
  } else {
    p.nodes.push({ x: xb, y: ys, sym: '⊙' }, { x: xb, y: yt, sym: '−' });
    p.lines.push({ d: `M ${xb} ${botBar[0]} V ${yt + R}`, cls: 'f-line', marker: ARROW });
    p.lines.push({ d: `M ${xb} ${yt - R} V ${ys + R}`, cls: 'f-line', marker: ARROW });
    p.lines.push({ d: `M ${xb} ${ys - R} V ${topBar[1]}`, cls: 'f-line', marker: ARROW });
  }
  p.texts.push({
    x: 180,
    y: botBar[1] + 24,
    t: inverse ? (ru ? "те же s и t; ни одна сеть не обращается" : "same s and t; no network is inverted") : (ru ? "s, t: произвольные нейросети от z_a" : "s, t: arbitrary neural networks of z_a"),
    cls: 'f-note',
    anchor: 'middle',
  });
  return p;
}

const wide = [widePanel(0, false), widePanel(296, true)];
const narrow = [narrowPanel(0, false), narrowPanel(360, true)];
const separators = { wide: 286, narrow: 352 };
---

<Figure
  id="flow-architectures-coupling"
  title={ru ? "Аффинный слой связи и обратный к нему" : "An affine coupling layer and its inverse"}
  caption={ru ? "Первая половина копируется без изменений и подаётся на вход двух сетей s и t. Вторая половина поэлементно умножается на exp(s) и сдвигается на t, причём обе величины вычисляются по первой половине. При обращении слоя обращается только этот дешёвый поэлементный шаг: s и t снова вычисляются на той же первой половине и никогда не обращаются." : "The first half is copied unchanged and fed to two networks s and t. The second half is multiplied element-wise by exp(s) and shifted by t, both computed from the first half. Inverting the layer only reverses this cheap element-wise step: s and t are evaluated again on the same first half, never inverted."}
>
  <svg class="fig-wide" viewBox="0 0 680 584" role="img" aria-labelledby="flow-architectures-coupling-t flow-architectures-coupling-d">
    <title id="flow-architectures-coupling-t">{ru ? "Блок-схема слоя связи: прямой и обратный проходы" : "Coupling layer block diagram, forward and inverse"}</title>
    <desc id="flow-architectures-coupling-d">{ru ? "Верхняя панель, прямой проход: входной вектор z разбивается на z_a и z_b. z_a проходит прямо на выход как z штрих a и, кроме того, подаётся на два блока сетей s и t. z_b поэлементно умножается на exp от s, затем к нему прибавляется t, что даёт z штрих b. Выходные половины объединяются в z штрих. Нижняя панель, обратный проход, нарисована с обращёнными стрелками: z штрих a копируется обратно в z_a, его читают те же сети s и t, из z штрих b вычитается t, и результат умножается на exp от минус s, что даёт z_b." : "Top panel, forward pass: the input vector z is split into z_a and z_b. z_a passes straight through to the output as z prime a, and also feeds two network boxes s and t. z_b is multiplied element-wise by exp of s, then t is added, giving z prime b. The output halves are concatenated into z prime. Bottom panel, inverse pass, drawn with arrows reversed: z prime a is copied back to z_a, the same networks s and t read it, t is subtracted from z prime b and the result is multiplied by exp of minus s, giving z_b."}</desc>
    <line class="f-grid" x1="20" x2="660" y1={separators.wide} y2={separators.wide} />
    {wide.map((p) => (
      <g>
        {p.boxes.map((b) => <rect class={b.cls} x={b.x} y={b.y} width={b.w} height={b.h} rx="6" />)}
        {p.lines.map((l) => <path class={l.cls} d={l.d} marker-end={l.marker} />)}
        {p.dots.map(([x, y]) => <circle class="f-solid-blue" cx={x} cy={y} r="3.5" />)}
        {p.nodes.map((n) => (
          <g>
            <circle class="f-box" cx={n.x} cy={n.y} r={R} />
            <text x={n.x} y={n.y + 6} text-anchor="middle" style="font-size: 18px">{n.sym}</text>
          </g>
        ))}
        {p.texts.map((t) => <MathText x={t.x} y={t.y} t={t.t} class={t.cls ?? 'f-math'} anchor={t.anchor} size={t.size} />)}
      </g>
    ))}
  </svg>
  <svg class="fig-narrow" viewBox="0 0 360 706" role="img" aria-labelledby="flow-architectures-coupling-nt flow-architectures-coupling-nd">
    <title id="flow-architectures-coupling-nt">{ru ? "Блок-схема слоя связи: прямой и обратный проходы (вертикальная компоновка)" : "Coupling layer block diagram, forward and inverse (stacked)"}</title>
    <desc id="flow-architectures-coupling-nd">{ru ? "Прямой проход сверху вниз: z разбивается на z_a и z_b. z_a идёт прямо вниз в z штрих a и подаётся на сети s и t. z_b умножается на exp от s и сдвигается на t, что даёт z штрих b. Обратный проход снизу вверх: z штрих b минус t, умноженное на exp от минус s, даёт z_b, а z штрих a копируется обратно в z_a." : "Forward pass, top to bottom: z splits into z_a and z_b. z_a goes straight down to z prime a and feeds networks s and t. z_b is multiplied by exp of s and shifted by t, giving z prime b. Inverse pass, bottom to top: z prime b minus t, times exp of minus s, gives z_b, while z prime a is copied back to z_a."}</desc>
    <line class="f-grid" x1="16" x2="344" y1={separators.narrow} y2={separators.narrow} />
    {narrow.map((p) => (
      <g>
        {p.boxes.map((b) => <rect class={b.cls} x={b.x} y={b.y} width={b.w} height={b.h} rx="6" />)}
        {p.lines.map((l) => <path class={l.cls} d={l.d} marker-end={l.marker} />)}
        {p.dots.map(([x, y]) => <circle class="f-solid-blue" cx={x} cy={y} r="3.5" />)}
        {p.nodes.map((n) => (
          <g>
            <circle class="f-box" cx={n.x} cy={n.y} r={R} />
            <text x={n.x} y={n.y + 6} text-anchor="middle" style="font-size: 18px">{n.sym}</text>
          </g>
        ))}
        {p.texts.map((t) => <MathText x={t.x} y={t.y} t={t.t} class={t.cls ?? 'f-math'} anchor={t.anchor} size={t.size} />)}
      </g>
    ))}
  </svg>
</Figure>
