---
import Figure from '../Figure.astro';
import MathText from './MathText.astro';
import { scale, polyline } from '../geometry';
import type { Point } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

/**
 * A monotone rational-quadratic spline (Durkan et al., 2019, eq. 4–5) with K = 4 bins on
 * [−B, B], B = 3, and identity tails outside. Toy knots and inner derivatives; the boundary
 * derivatives are 1 so that the spline joins the tails with a continuous slope.
 * Everything drawn is computed from the formulas below.
 */
const B = 3;
const xk = [-3, -1.2, 0, 1.5, 3];
const yk = [-3, -2.4, 1.2, 2.2, 3];
const dk = [1, 0.4, 2.5, 0.5, 1];
const K = xk.length - 1;

function bin(x: number): number {
  let k = 0;
  while (k < K - 1 && x >= xk[k + 1]) k += 1;
  return k;
}

/** Spline value and derivative; identity outside [−B, B]. */
function rqs(x: number): [number, number] {
  if (x <= -B || x >= B) return [x, 1];
  const k = bin(x);
  const w = xk[k + 1] - xk[k];
  const h = yk[k + 1] - yk[k];
  const s = h / w;
  const xi = (x - xk[k]) / w;
  const den = s + (dk[k + 1] + dk[k] - 2 * s) * xi * (1 - xi);
  const g = yk[k] + (h * (s * xi * xi + dk[k] * xi * (1 - xi))) / den;
  const dg = (s * s * (dk[k + 1] * xi * xi + 2 * s * xi * (1 - xi) + dk[k] * (1 - xi) * (1 - xi))) / (den * den);
  return [g, dg];
}

/** Inverse through the root of a quadratic (Durkan et al., 2019, eq. 6–8). */
function rqsInv(y: number): number {
  if (y <= -B || y >= B) return y;
  let k = 0;
  while (k < K - 1 && y >= yk[k + 1]) k += 1;
  const w = xk[k + 1] - xk[k];
  const h = yk[k + 1] - yk[k];
  const s = h / w;
  const dy = y - yk[k];
  const a = h * (s - dk[k]) + dy * (dk[k + 1] + dk[k] - 2 * s);
  const b = h * dk[k] - dy * (dk[k + 1] + dk[k] - 2 * s);
  const c = -s * dy;
  const xi = (2 * c) / (-b - Math.sqrt(b * b - 4 * a * c));
  return xk[k] + xi * w;
}

// The worked example of the text: x = −0.6, the middle of the second bin.
const x0 = -0.6;
const [g0, dg0] = rqs(x0);
const g0Label = g0.toFixed(3);
const dg0Label = dg0.toFixed(2);
const g0Show = g0Label.replace('-', '−');
if (g0Label !== '-1.025') throw new Error(`RationalQuadraticSpline: g(-0.6) = ${g0}, caption says -1.025`);
if (dg0Label !== '4.04') throw new Error(`RationalQuadraticSpline: g'(-0.6) = ${dg0}, caption says 4.04`);
if (Math.abs(rqsInv(g0) - x0) > 1e-9) throw new Error('RationalQuadraticSpline: quadratic inverse does not recover x');
if (3 * K - 1 !== 11) throw new Error('RationalQuadraticSpline: parameter count');

// Sanity: the spline passes through the knots, has slope δ_k there, and increases strictly.
const n = 1200;
const xs = Array.from({ length: n + 1 }, (_, i) => -B + 1e-9 + ((2 * B - 2e-9) * i) / n);
let prev = -Infinity;
let maxD = 0;
for (const x of xs) {
  const [g, dg] = rqs(x);
  if (!(g > prev)) throw new Error('RationalQuadraticSpline: not increasing');
  prev = g;
  maxD = Math.max(maxD, dg);
}
xk.forEach((x, k) => {
  const xin = Math.min(Math.max(x, -B + 1e-9), B - 1e-9);
  const [g, dg] = rqs(xin);
  if (Math.abs(g - yk[k]) > 1e-6 || Math.abs(dg - dk[k]) > 1e-5) throw new Error(`RationalQuadraticSpline: knot ${k}`);
});
if (maxD.toFixed(2) !== '4.25') throw new Error(`RationalQuadraticSpline: peak derivative ${maxD}, description says 4.25`);
const yMaxD = 4.6;
if (maxD > yMaxD - 0.2) throw new Error(`RationalQuadraticSpline: derivative ${maxD} leaves the plot`);

const dom: [number, number] = [-4.2, 4.2];

function panels(o: { L: number; R: number; T1: number; B1: number; T2: number; B2: number; L2: number; R2: number }) {
  const sx1 = scale(dom, [o.L, o.R]);
  const sy1 = scale(dom, [o.B1, o.T1]);
  const sx2 = scale(dom, [o.L2, o.R2]);
  const sy2 = scale([0, yMaxD], [o.B2, o.T2]);
  const inner = xs.map((x): Point => [sx1(x), sy1(rqs(x)[0])]);
  const innerD = xs.map((x): Point => [sx2(x), sy2(rqs(x)[1])]);
  const rects = xk.slice(0, -1).map((x, k) => ({
    x: sx1(x),
    y: sy1(yk[k + 1]),
    w: sx1(xk[k + 1]) - sx1(x),
    h: sy1(yk[k]) - sy1(yk[k + 1]),
  }));
  return {
    ...o,
    sx1,
    sy1,
    sx2,
    sy2,
    curve: polyline(inner),
    curveD: polyline(innerD),
    tailL: polyline([[sx1(dom[0]), sy1(dom[0])], [sx1(-B), sy1(-B)]]),
    tailR: polyline([[sx1(B), sy1(B)], [sx1(dom[1]), sy1(dom[1])]]),
    tailDL: polyline([[sx2(dom[0]), sy2(1)], [sx2(-B), sy2(1)]]),
    tailDR: polyline([[sx2(B), sy2(1)], [sx2(dom[1]), sy2(1)]]),
    rects,
    knots: xk.map((x, k): Point => [sx1(x), sy1(yk[k])]),
    knotsD: xk.map((x, k): Point => [sx2(x), sy2(dk[k])]),
    p: [sx1(x0), sy1(g0)] as Point,
    pD: [sx2(x0), sy2(dg0)] as Point,
  };
}

const W = panels({ L: 70, R: 340, T1: 46, B1: 316, L2: 450, R2: 720, T2: 46, B2: 316 });
const N = panels({ L: 50, R: 320, T1: 50, B1: 320, L2: 50, R2: 320, T2: 420, B2: 640 });
// Where the "identity tail" label fits: beside the upper tail (wide) or above its end (narrow, right-aligned).
const tailLabelW: Point = [W.sx1(B) + 6, W.sy1(2.4)];
const tailLabelN: Point = [N.R + 20, N.T1 - 14];

const dTicks = [0, 1, 2, 3, 4];
const t = {
  title: ru ? 'Монотонный рационально-квадратичный сплайн и его производная' : 'A monotone rational-quadratic spline and its derivative',
  left: ru ? 'сплайн g(x)' : 'spline g(x)',
  right: ru ? 'производная g′(x)' : 'derivative g′(x)',
  tail: ru ? 'тождественный хвост' : 'identity tail',
  knot: ru ? 'узел' : 'knot',
  bins: ru ? 'K = 4 бина' : 'K = 4 bins',
  edge: ru ? 'δ = 1 на краях' : 'δ = 1 at the edges',
};
const caption = ru
  ? `Игрушечный сплайн с K = 4 бинами на [−B, B], B = 3. Узлы (x_k, y_k): (−3, −3), (−1.2, −2.4), (0, 1.2), (1.5, 2.2), (3, 3); производные во внутренних узлах δ = (0.4, 2.5, 0.5), на краях δ = 1. Вместе это 3K − 1 = 11 чисел на координату: K ширин, K высот и K − 1 производных. Слева: каждый кусок сплайна соединяет противоположные углы своего прямоугольника (ширина бина × высота бина) и монотонно возрастает; вне [−3, 3] преобразование тождественное. Справа: производная g′(x), логарифм которой входит в log|det J|; на краях она равна 1, поэтому стыкуется с хвостами без скачка. Отмеченная точка x = −0.6 (середина второго бина) переходит в g = ${g0Show}, g′ = ${dg0Label}.`
  : `A toy spline with K = 4 bins on [−B, B], B = 3. Knots (x_k, y_k): (−3, −3), (−1.2, −2.4), (0, 1.2), (1.5, 2.2), (3, 3); inner derivatives δ = (0.4, 2.5, 0.5), and δ = 1 at the two edges. That is 3K − 1 = 11 numbers per coordinate: K widths, K heights and K − 1 derivatives. Left: each piece joins opposite corners of its box (bin width × bin height) and increases; outside [−3, 3] the map is the identity. Right: the derivative g′(x), whose logarithm enters log|det J|; it equals 1 at the edges, so it meets the tails without a jump. The marked point x = −0.6, the middle of the second bin, maps to g = ${g0Show} with g′ = ${dg0Label}.`;
const desc = ru
  ? `Слева: возрастающая кривая через пять узлов, отмеченных точками, внутри пунктирного квадрата от −3 до 3; под каждым куском заштрихован прямоугольник его бина. Вне квадрата кривая продолжается диагональю y = x. Справа: производная той же функции, положительная везде, с пиком около 4.25 во втором бине и значением 1 на краях и в хвостах. Точка x = −0.6 отмечена на обоих графиках: g = ${g0Show}, g′ = ${dg0Label}.`
  : `Left: an increasing curve through five knots, marked by dots, inside a dashed square from −3 to 3; the box of each bin is shaded behind its piece. Outside the square the curve continues as the diagonal y = x. Right: the derivative of the same function, positive everywhere, peaking near 4.25 in the second bin and equal to 1 at the edges and in the tails. The point x = −0.6 is marked on both plots: g = ${g0Show}, g′ = ${dg0Label}.`;
---

<Figure id="flow-architectures-rq-spline" title={t.title} caption={caption}>
  {[{ o: W, cls: 'fig-wide', vb: '0 0 760 370', sfx: 'w', narrow: false }, { o: N, cls: 'fig-narrow', vb: '0 0 360 700', sfx: 'n', narrow: true }].map(({ o, cls, vb, sfx, narrow }) => (
    <svg class={cls} viewBox={vb} role="img" aria-labelledby={`rqs-${sfx}-t rqs-${sfx}-d`}>
      <title id={`rqs-${sfx}-t`}>{t.title}</title>
      <desc id={`rqs-${sfx}-d`}>{desc}</desc>

      <!-- Left: the spline -->
      <text class="f-title" x={o.L} y={o.T1 - 18}>{t.left}</text>
      {o.rects.map((r) => <rect class="f-fill-blue" x={r.x} y={r.y} width={r.w} height={r.h} />)}
      <rect class="f-thin f-muted f-dash" x={o.sx1(-B)} y={o.sy1(B)} width={o.sx1(B) - o.sx1(-B)} height={o.sy1(-B) - o.sy1(B)} />
      <path class="f-axis" d={`M ${o.L} ${o.sy1(0)} H ${o.R + 8}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-axis" d={`M ${o.sx1(0)} ${o.B1} V ${o.T1 - 6}`} marker-end="url(#f-arrow-muted)" />
      <MathText x={o.R + 10} y={o.sy1(0) + 20} t="x" anchor="end" size={16} />
      <text class="f-note" x={o.sx1(-B) - 5} y={o.sy1(0) + 18} text-anchor="end">−3</text>
      <text class="f-note" x={o.sx1(B) + 5} y={o.sy1(0) - 8}>3</text>
      <text class="f-note" x={o.sx1(0) + 7} y={o.sy1(B) - 7}>3</text>
      <text class="f-note" x={o.sx1(0) - 7} y={o.sy1(-B) + 18} text-anchor="end">−3</text>
      <path class="f-line f-muted" d={o.tailL} />
      <path class="f-line f-muted" d={o.tailR} />
      <path class="f-line f-blue f-bold" d={o.curve} />
      {o.knots.map(([x, y]) => <circle class="f-solid-blue" cx={x} cy={y} r="4.5" />)}
      <line class="f-thin f-red f-dot" x1={o.p[0]} x2={o.p[0]} y1={o.sy1(0)} y2={o.p[1]} />
      <line class="f-thin f-red f-dot" x1={o.sx1(0)} x2={o.p[0]} y1={o.p[1]} y2={o.p[1]} />
      <circle class="f-solid-red" cx={o.p[0]} cy={o.p[1]} r="4.5" />
      <text class="f-small f-t-red f-halo" x={o.p[0] - 8} y={o.sy1(0) - 8} text-anchor="end">x = −0.6</text>
      <text class="f-small f-t-red f-halo" x={o.p[0] - 8} y={o.p[1] + 16} text-anchor="end">g = {g0Show}</text>
      <text class="f-small f-t-muted" x={narrow ? tailLabelN[0] : tailLabelW[0]} y={narrow ? tailLabelN[1] : tailLabelW[1]} text-anchor={narrow ? 'end' : 'start'}>{t.tail}</text>
      <text class="f-small f-t-blue f-halo" x={o.knots[2][0] - 10} y={o.knots[2][1] - 10} text-anchor="end">{t.knot} (0, 1.2)</text>
      <text class="f-small f-t-blue" x={o.sx1(2.8)} y={o.sy1(-2.4)} text-anchor="end">{t.bins}</text>

      <!-- Right: the derivative -->
      <text class="f-title" x={o.L2} y={o.T2 - 18}>{t.right}</text>
      {dTicks.map((v) => <line class="f-grid" x1={o.L2} x2={o.R2} y1={o.sy2(v)} y2={o.sy2(v)} />)}
      {dTicks.map((v) => <text class="f-note" x={o.L2 - 8} y={o.sy2(v) + 5} text-anchor="end">{v}</text>)}
      <path class="f-axis" d={`M ${o.L2} ${o.B2} H ${o.R2 + 8}`} marker-end="url(#f-arrow-muted)" />
      <MathText x={o.R2 + 10} y={o.B2 + 22} t="x" anchor="end" size={16} />
      <text class="f-note" x={o.sx2(-B)} y={o.B2 + 20} text-anchor="middle">−3</text>
      <text class="f-note" x={o.sx2(0)} y={o.B2 + 20} text-anchor="middle">0</text>
      <text class="f-note" x={o.sx2(B)} y={o.B2 + 20} text-anchor="middle">3</text>
      <path class="f-line f-muted" d={o.tailDL} />
      <path class="f-line f-muted" d={o.tailDR} />
      <path class="f-line f-amber f-bold" d={o.curveD} />
      {o.knotsD.map(([x, y]) => <circle class="f-solid-blue" cx={x} cy={y} r="4.5" />)}
      <circle class="f-solid-red" cx={o.pD[0]} cy={o.pD[1]} r="4.5" />
      <text class="f-small f-t-red f-halo" x={o.pD[0] - 10} y={o.pD[1] + 4} text-anchor="end">g′ = {dg0Label}</text>
      <text class="f-small f-t-muted f-halo" x={o.sx2(0.6)} y={o.sy2(1) - 22}>{t.edge}</text>
      {narrow ? null : <text class="f-small f-t-blue" x={o.sx2(0.9)} y={o.sy2(3.4)}>δ<tspan dy="4" font-size="10">k</tspan><tspan dy="-4"> {ru ? 'в узлах' : 'at the knots'}</tspan></text>}
    </svg>
  ))}
</Figure>
