---
import Figure from '../Figure.astro';
import MathText from './MathText.astro';
import { curve } from '../geometry';

/**
 * Sparsity pattern of the Jacobian of an affine coupling layer, d = 6, split 3 / 3.
 * Entry (i, j) = ∂z′_i / ∂z_j. The pattern is computed from the layer's dependency
 * structure: z′_a = z_a (identity), z′_b = z_b ⊙ exp(s(z_a)) + t(z_a).
 */
const d = 6;
const k = 3; // size of z_a

type Kind = 'one' | 'zero-upper' | 'zero' | 'dense' | 'diag';
function kind(i: number, j: number): Kind {
  const rowA = i < k;
  const colA = j < k;
  if (rowA && colA) return i === j ? 'one' : j > i ? 'zero-upper' : 'zero'; // ∂z′_a/∂z_a = I
  if (rowA && !colA) return 'zero-upper'; // z′_a ignores z_b
  if (!rowA && colA) return 'dense'; // s(z_a), t(z_a) depend on all of z_a
  return i === j ? 'diag' : j > i ? 'zero-upper' : 'zero'; // element-wise in z_b
}

function layout(x0: number, y0: number, c: number) {
  const cells = [];
  for (let i = 0; i < d; i += 1) {
    for (let j = 0; j < d; j += 1) {
      cells.push({ i, j, x: x0 + j * c, y: y0 + i * c, kind: kind(i, j) });
    }
  }
  const blocks = [
    { x: x0, y: y0, w: k * c, h: k * c },
    { x: x0 + k * c, y: y0, w: (d - k) * c, h: k * c },
    { x: x0, y: y0 + k * c, w: k * c, h: (d - k) * c },
    { x: x0 + k * c, y: y0 + k * c, w: (d - k) * c, h: (d - k) * c },
  ];
  const size = d * c;
  const bracket = (side: 'l' | 'r') => {
    const x = side === 'l' ? x0 - 7 : x0 + size + 7;
    const s = side === 'l' ? 8 : -8;
    return `M ${x + s} ${y0 - 4} H ${x} V ${y0 + size + 4} H ${x + s}`;
  };
  return { x0, y0, c, size, cells, blocks, bracket };
}

const W = layout(214, 66, 42);
const N = layout(98, 66, 34);

const fill: Record<Kind, string> = {
  one: 'f-fill-paper',
  'zero-upper': '',
  zero: 'f-fill-paper',
  dense: 'f-fill-blue',
  diag: 'f-fill-amber',
};
---

<Figure
  id="flow-architectures-coupling-jacobian"
  title="Why the coupling Jacobian is lower-triangular"
  caption="Jacobian of a coupling layer with d = 6, split into three and three coordinates; entry (i, j) is the derivative of output coordinate i with respect to input coordinate j. Everything above the diagonal (hatched) is zero, so the determinant is the product of the diagonal: three ones from the identity block and exp(sᵢ) from the element-wise block. The dense block never enters the determinant, so s and t can be arbitrarily complicated."
>
  <svg class="fig-wide" viewBox="0 0 680 396" role="img" aria-labelledby="flow-architectures-cj-t flow-architectures-cj-d">
    <title id="flow-architectures-cj-t">Block structure of the coupling-layer Jacobian</title>
    <desc id="flow-architectures-cj-d">A six by six matrix with rows z prime a, z prime b and columns z_a, z_b, split three and three. Top-left block: identity, ones on the diagonal. Top-right block: hatched zeros, because z prime a does not depend on z_b. Bottom-left block: dense, filled with stars, the derivative of z prime b with respect to z_a. Bottom-right block: diagonal with entries e to the s1, e to the s2, e to the s3. Everything above the main diagonal is hatched. The determinant is the product of exp of s_i, which equals exp of the sum of s_i.</desc>
    <defs>
      <pattern id="flow-architectures-cj-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="7" style="stroke: var(--muted); stroke-width: 1.1; opacity: 0.55" />
      </pattern>
    </defs>

    <MathText x={W.x0 + W.size / 2} y={26} t="J_{ij} = ∂z′_i / ∂z_j" anchor="middle" />
    <MathText x={W.x0 + 1.5 * W.c} y={W.y0 - 14} t="z_a" anchor="middle" />
    <MathText x={W.x0 + 4.5 * W.c} y={W.y0 - 14} t="z_b" anchor="middle" />
    <MathText x={W.x0 - 18} y={W.y0 + 1.5 * W.c + 6} t="z′_a" anchor="end" />
    <MathText x={W.x0 - 18} y={W.y0 + 4.5 * W.c + 6} t="z′_b" anchor="end" />

    {W.cells.map((cell) => (
      <rect class={`f-grid ${fill[cell.kind]}`} x={cell.x} y={cell.y} width={W.c} height={W.c} style={cell.kind === 'zero-upper' ? 'fill: url(#flow-architectures-cj-hatch)' : undefined} />
    ))}
    {W.cells.map((cell) => {
      const cx = cell.x + W.c / 2;
      const cy = cell.y + W.c / 2;
      if (cell.kind === 'one') return <text class="f-math f-upright" x={cx} y={cy + 6} text-anchor="middle">1</text>;
      if (cell.kind === 'diag') return <MathText x={cx} y={cy + 6} t={`e^{s_${cell.i - k + 1}}`} anchor="middle" size={18} />;
      if (cell.kind === 'dense') return <text class="f-t-blue" x={cx} y={cy + 9} text-anchor="middle" style="font-size: 22px">∗</text>;
      if (cell.kind === 'zero')
        return <text class="f-note" x={cx} y={cy + 5} text-anchor="middle">0</text>;
      return null;
    })}
    <text class="f-math f-upright f-halo" x={W.x0 + 4.5 * W.c} y={W.y0 + 1.5 * W.c + 10} text-anchor="middle" style="font-size: 28px">0</text>
    {W.blocks.map((b) => <rect class="f-line" x={b.x} y={b.y} width={b.w} height={b.h} />)}
    <path class="f-line" d={W.bracket('l')} />
    <path class="f-line" d={W.bracket('r')} />

    <!-- identity block -->
    <text class="f-label" x="22" y="80">identity block</text>
    <MathText x={22} y={102} t="z′_a = z_a" size={16} />
    <path class="f-thin" d={curve(118, 86, W.x0 - 2, W.y0 + 22, -18)} marker-end="url(#f-arrow)" />

    <!-- zero block -->
    <text class="f-label" x="500" y="86">zero block:</text>
    <MathText x={500} y={108} t="z′_a does not" class="f-label" />
    <MathText x={500} y={128} t="depend on z_b" class="f-label" />
    <path class="f-thin" d={curve(496, 96, W.x0 + 5.6 * W.c, W.y0 + 0.75 * W.c, 14)} marker-end="url(#f-arrow)" />

    <!-- diagonal block -->
    <text class="f-label f-t-amber" x="500" y="222">diagonal block:</text>
    <MathText x={500} y={244} t="z′_b depends on z_b" class="f-label" />
    <text class="f-label" x="500" y="264">element-wise, affinely</text>
    <path class="f-thin f-amber" d={curve(496, 230, W.x0 + 4 * W.c + 3, W.y0 + 3.5 * W.c - 2, 22)} marker-end="url(#f-arrow)" />

    <!-- dense block -->
    <MathText x={W.x0 + 1.5 * W.c} y={W.y0 + W.size + 36} t="∂z′_b / ∂z_a: dense" class="f-label f-t-blue" anchor="middle" />
    <MathText x={W.x0 + 1.5 * W.c} y={W.y0 + W.size + 56} t="s, t see all of z_a" class="f-note" anchor="middle" />

    <!-- determinant -->
    <MathText x={500} y={W.y0 + W.size + 30} t="det J = ∏ᵢ exp(s_i(z_a))" />
    <MathText x={538} y={W.y0 + W.size + 56} t="= exp(Σᵢ s_i(z_a))" />
  </svg>

  <svg class="fig-narrow" viewBox="0 0 360 500" role="img" aria-labelledby="flow-architectures-cj-nt flow-architectures-cj-nd">
    <title id="flow-architectures-cj-nt">Block structure of the coupling-layer Jacobian (compact)</title>
    <desc id="flow-architectures-cj-nd">The same six by six Jacobian: identity block top-left, hatched zero block top-right, dense block bottom-left, diagonal block with e to the s_i bottom-right. A legend below explains each block, and the determinant equals the product of exp of s_i.</desc>
    <defs>
      <pattern id="flow-architectures-cj-nhatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="7" style="stroke: var(--muted); stroke-width: 1.1; opacity: 0.55" />
      </pattern>
    </defs>
    <MathText x={180} y={26} t="J_{ij} = ∂z′_i / ∂z_j" anchor="middle" />
    <MathText x={N.x0 + 1.5 * N.c} y={N.y0 - 12} t="z_a" anchor="middle" />
    <MathText x={N.x0 + 4.5 * N.c} y={N.y0 - 12} t="z_b" anchor="middle" />
    <MathText x={N.x0 - 16} y={N.y0 + 1.5 * N.c + 6} t="z′_a" anchor="end" />
    <MathText x={N.x0 - 16} y={N.y0 + 4.5 * N.c + 6} t="z′_b" anchor="end" />
    {N.cells.map((cell) => (
      <rect class={`f-grid ${fill[cell.kind]}`} x={cell.x} y={cell.y} width={N.c} height={N.c} style={cell.kind === 'zero-upper' ? 'fill: url(#flow-architectures-cj-nhatch)' : undefined} />
    ))}
    {N.cells.map((cell) => {
      const cx = cell.x + N.c / 2;
      const cy = cell.y + N.c / 2;
      if (cell.kind === 'one') return <text class="f-math f-upright" x={cx} y={cy + 6} text-anchor="middle" style="font-size: 16px">1</text>;
      if (cell.kind === 'diag') return <MathText x={cx} y={cy + 5} t={`e^{s_${cell.i - k + 1}}`} anchor="middle" size={16} />;
      if (cell.kind === 'dense') return <text class="f-t-blue" x={cx} y={cy + 8} text-anchor="middle" style="font-size: 20px">∗</text>;
      if (cell.kind === 'zero')
        return <text class="f-small f-t-muted" x={cx} y={cy + 4} text-anchor="middle">0</text>;
      return null;
    })}
    <text class="f-math f-upright f-halo" x={N.x0 + 4.5 * N.c} y={N.y0 + 1.5 * N.c + 9} text-anchor="middle" style="font-size: 24px">0</text>
    {N.blocks.map((b) => <rect class="f-line" x={b.x} y={b.y} width={b.w} height={b.h} />)}
    <path class="f-line" d={N.bracket('l')} />
    <path class="f-line" d={N.bracket('r')} />

    <g transform="translate(0 306)">
      <rect class="f-grid f-fill-paper" x="24" y="0" width="22" height="22" />
      <text class="f-math f-upright" x="35" y="17" text-anchor="middle" style="font-size: 15px">1</text>
      <MathText x={58} y={16} t="identity: z′_a = z_a" class="f-label" />
      <rect class="f-grid" x="24" y="34" width="22" height="22" style="fill: url(#flow-architectures-cj-nhatch)" />
      <MathText x={58} y={50} t="zero: z′_a ignores z_b" class="f-label" />
      <rect class="f-grid f-fill-blue" x="24" y="68" width="22" height="22" />
      <MathText x={58} y={84} t="dense ∂z′_b/∂z_a: s, t see all of z_a" class="f-label" />
      <rect class="f-grid f-fill-amber" x="24" y="102" width="22" height="22" />
      <MathText x={58} y={118} t="diagonal: element-wise in z_b" class="f-label" />
    </g>
    <MathText x={180} y={470} t="det J = ∏ᵢ exp(s_i) = exp(Σᵢ s_i)" anchor="middle" />
  </svg>
</Figure>
