---
import Figure from '../Figure.astro';
import MathText from './MathText.astro';

/**
 * A tiny MADE network (3 inputs, one hidden layer of 4 units, 3 outputs) with
 * masks derived from the degree rule used in nflib/made.py:
 *   hidden layer:  connect input j -> hidden u   iff m(j) ≤ m(u)
 *   output layer:  connect hidden u -> output i  iff m(u) < i   (strict)
 * Input degrees are the natural order 1..d; hidden degrees lie in 1..d-1.
 * The Jacobian pattern on the right is computed from the same masks.
 */
const D = 3;
const dIn = [1, 2, 3];
const mHid = [1, 2, 1, 2];
const dOut = [1, 2, 3];

const M1 = mHid.map((m) => dIn.map((d) => (d <= m ? 1 : 0))); // 4 x 3, rows: hidden, cols: inputs
const M2 = dOut.map((d) => mHid.map((m) => (m < d ? 1 : 0))); // 3 x 4, rows: outputs, cols: hidden

// Number of paths from input j to output i through the masked net.
const paths = dOut.map((_, i) => dIn.map((_, j) => mHid.reduce((acc, _m, k) => acc + M2[i][k] * M1[k][j], 0)));
// z′_i = z_i · exp(s_i) + t_i: the network supplies the strictly lower part, the element-wise step the diagonal.
const J = paths.map((row, i) => row.map((p, j) => (i === j ? 'diag' : p > 0 ? 'dense' : 'zero')));
if (J.some((row, i) => row.some((v, j) => j > i && v !== 'zero'))) {
  throw new Error('MADE masks do not give a lower-triangular Jacobian');
}

const edges1 = M1.flatMap((row, k) => row.flatMap((on, j) => (on ? [{ j, k }] : [])));
const edges2 = M2.flatMap((row, i) => row.flatMap((on, k) => (on ? [{ k, i }] : [])));

// ---- wide layout: left to right ----
const W = {
  xin: 74,
  xh: 206,
  xout: 340,
  yin: [100, 180, 260],
  yh: [72, 144, 216, 288],
  yout: [100, 180, 260],
  rIn: 19,
  rH: 16,
  boxW: 64,
  boxH: 32,
};
const WJ = { x0: 556, y0: 128, c: 36 };

// ---- narrow layout: top to bottom ----
const N = {
  xin: [130, 210, 290],
  xh: [100, 170, 240, 310],
  xout: [130, 210, 290],
  yin: 74,
  yh: 186,
  yout: 296,
  rIn: 19,
  rH: 16,
  boxW: 60,
  boxH: 32,
};
const NJ = { x0: 140, y0: 452, c: 36 };

const sub = ['₁', '₂', '₃'];
---

<Figure
  id="flow-architectures-made"
  title="Masked weights make the network autoregressive"
  caption="Degrees: input number j has degree j; each hidden unit gets a degree between 1 and d − 1 = 2. Hidden unit u may read input j only if m(j) ≤ m(u), and output i may read hidden unit u only if m(u) < i. Only the surviving connections are drawn. Output 1 receives nothing, so s₁ and t₁ are plain learned constants, and input z₃ feeds nothing. Tracing paths shows that sᵢ and tᵢ depend only on z₁, …, zᵢ₋₁; the element-wise step z′ᵢ = zᵢ·exp(sᵢ) + tᵢ adds the diagonal, and the Jacobian is lower-triangular."
  origin="expanded"
  pages="36"
>
  <svg class="fig-wide" viewBox="0 0 680 372" role="img" aria-labelledby="flow-architectures-made-t flow-architectures-made-d">
    <title id="flow-architectures-made-t">MADE masks and the resulting Jacobian pattern</title>
    <desc id="flow-architectures-made-d">A masked network with inputs z1, z2, z3 of degrees 1, 2, 3, four hidden units of degrees 1, 2, 1, 2, and three outputs (s1, t1), (s2, t2), (s3, t3) of degrees 1, 2, 3. Hidden units of degree 1 read only z1; hidden units of degree 2 read z1 and z2; z3 feeds nothing. Output 1 has no incoming connections, output 2 reads the degree-1 hidden units, output 3 reads all hidden units. On the right, the three by three Jacobian of z prime with respect to z: diagonal entries e to the s_i, entries below the diagonal non-zero, entries above the diagonal hatched zeros.</desc>
    <defs>
      <pattern id="flow-architectures-made-hatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="7" style="stroke: var(--muted); stroke-width: 1.1; opacity: 0.55" />
      </pattern>
    </defs>

    <text class="f-note" x={W.xin} y="34" text-anchor="middle">inputs</text>
    <text class="f-note" x={W.xh} y="34" text-anchor="middle">hidden (degree m)</text>
    <text class="f-note" x={W.xout} y="34" text-anchor="middle">outputs</text>

    {edges1.map(({ j, k }) => (
      <line class="f-thin f-blue" x1={W.xin + W.rIn} y1={W.yin[j]} x2={W.xh - W.rH} y2={W.yh[k]} />
    ))}
    {edges2.map(({ k, i }) => (
      <line class="f-thin f-blue" x1={W.xh + W.rH} y1={W.yh[k]} x2={W.xout - W.boxW / 2} y2={W.yout[i]} />
    ))}

    {dIn.map((d, j) => (
      <g>
        <circle class="f-box" cx={W.xin} cy={W.yin[j]} r={W.rIn} />
        <MathText x={W.xin} y={W.yin[j] + 6} t={`z_${d}`} anchor="middle" />
        <text class="f-small f-t-muted" x={W.xin - W.rIn - 8} y={W.yin[j] + 5} text-anchor="end">m = {d}</text>
      </g>
    ))}
    {mHid.map((m, k) => (
      <g>
        <circle class="f-box-soft" cx={W.xh} cy={W.yh[k]} r={W.rH} />
        <text class="f-label" x={W.xh} y={W.yh[k] + 5} text-anchor="middle">{m}</text>
      </g>
    ))}
    {dOut.map((d, i) => (
      <g>
        <rect class="f-box" x={W.xout - W.boxW / 2} y={W.yout[i] - W.boxH / 2} width={W.boxW} height={W.boxH} rx="6" />
        <MathText x={W.xout} y={W.yout[i] + 5} t={`s_${d}, t_${d}`} anchor="middle" size={16} />
        <text class="f-small f-t-muted" x={W.xout + W.boxW / 2 + 8} y={W.yout[i] + 5}>m = {d}</text>
      </g>
    ))}
    <text class="f-note" x={W.xout + W.boxW / 2 + 8} y={W.yout[0] + 23}>constant</text>
    <text class="f-note" x={W.xin - W.rIn - 8} y={W.yin[2] + 23} text-anchor="end">unused</text>

    <MathText x={(W.xin + W.xh) / 2} y={326} t="m(j) ≤ m(u)" class="f-label" anchor="middle" />
    <MathText x={(W.xh + W.xout) / 2 + 6} y={326} t="m(u) < i" class="f-label" anchor="middle" />
    <text class="f-note" x={(W.xin + W.xh) / 2} y={346} text-anchor="middle">hidden mask</text>
    <text class="f-note" x={(W.xh + W.xout) / 2 + 6} y={346} text-anchor="middle">output mask (strict)</text>

    <path class="f-line" d={`M 440 ${WJ.y0 + 1.5 * WJ.c} H ${WJ.x0 - 44}`} marker-end="url(#f-arrow)" />
    <MathText x={470} y={WJ.y0 + 1.5 * WJ.c - 26} t="z′_i = z_i e^{s_i} + t_i" anchor="middle" size={16} />
    <text class="f-note" x={470} y={WJ.y0 + 1.5 * WJ.c + 24} text-anchor="middle">element-wise</text>

    <MathText x={WJ.x0 + 1.5 * WJ.c} y={WJ.y0 - 40} t="J = ∂z′ / ∂z" anchor="middle" />
    {dIn.map((d, j) => <MathText x={WJ.x0 + (j + 0.5) * WJ.c} y={WJ.y0 - 10} t={`z_${d}`} anchor="middle" size={16} />)}
    {dOut.map((d, i) => <MathText x={WJ.x0 - 10} y={WJ.y0 + (i + 0.5) * WJ.c + 5} t={`z′_${d}`} anchor="end" size={16} />)}
    {J.map((row, i) => row.map((v, j) => (
      <rect
        class={`f-grid ${v === 'diag' ? 'f-fill-amber' : v === 'dense' ? 'f-fill-blue' : ''}`}
        x={WJ.x0 + j * WJ.c}
        y={WJ.y0 + i * WJ.c}
        width={WJ.c}
        height={WJ.c}
        style={v === 'zero' ? 'fill: url(#flow-architectures-made-hatch)' : undefined}
      />
    )))}
    {J.map((row, i) => row.map((v, j) => {
      const cx = WJ.x0 + (j + 0.5) * WJ.c;
      const cy = WJ.y0 + (i + 0.5) * WJ.c;
      if (v === 'diag') return <MathText x={cx} y={cy + 5} t={`e^{s_${i + 1}}`} anchor="middle" size={16} />;
      if (v === 'dense') return <text class="f-t-blue" x={cx} y={cy + 8} text-anchor="middle" style="font-size: 20px">∗</text>;
      return null;
    }))}
    <rect class="f-line" x={WJ.x0} y={WJ.y0} width={3 * WJ.c} height={3 * WJ.c} />
    <text class="f-note" x={WJ.x0 + 1.5 * WJ.c} y={WJ.y0 + 3 * WJ.c + 24} text-anchor="middle">lower-triangular</text>
  </svg>

  <svg class="fig-narrow" viewBox="0 0 360 600" role="img" aria-labelledby="flow-architectures-made-nt flow-architectures-made-nd">
    <title id="flow-architectures-made-nt">MADE masks and the resulting Jacobian pattern (stacked)</title>
    <desc id="flow-architectures-made-nd">The same masked network drawn top to bottom: inputs z1, z2, z3, four hidden units with degrees 1, 2, 1, 2, and outputs (s1, t1), (s2, t2), (s3, t3). Below it, the element-wise step z prime i equals z_i times e to the s_i plus t_i, and the resulting lower-triangular three by three Jacobian.</desc>
    <defs>
      <pattern id="flow-architectures-made-nhatch" width="7" height="7" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="7" style="stroke: var(--muted); stroke-width: 1.1; opacity: 0.55" />
      </pattern>
    </defs>
    <text class="f-note" x="12" y={N.yin + 5}>inputs</text>
    <text class="f-note" x="12" y={N.yh + 5}>hidden</text>
    <text class="f-note" x="12" y={N.yout + 5}>outputs</text>
    <MathText x={12} y={(N.yin + N.yh) / 2 + 5} t="m(j) ≤ m(u)" class="f-small" />
    <MathText x={12} y={(N.yh + N.yout) / 2 + 5} t="m(u) < i" class="f-small" />

    {edges1.map(({ j, k }) => (
      <line class="f-thin f-blue" x1={N.xin[j]} y1={N.yin + N.rIn} x2={N.xh[k]} y2={N.yh - N.rH} />
    ))}
    {edges2.map(({ k, i }) => (
      <line class="f-thin f-blue" x1={N.xh[k]} y1={N.yh + N.rH} x2={N.xout[i]} y2={N.yout - N.boxH / 2} />
    ))}
    {dIn.map((d, j) => (
      <g>
        <circle class="f-box" cx={N.xin[j]} cy={N.yin} r={N.rIn} />
        <MathText x={N.xin[j]} y={N.yin + 6} t={`z_${d}`} anchor="middle" />
        <text class="f-small f-t-muted" x={N.xin[j]} y={N.yin - N.rIn - 8} text-anchor="middle">m = {d}</text>
      </g>
    ))}
    {mHid.map((m, k) => (
      <g>
        <circle class="f-box-soft" cx={N.xh[k]} cy={N.yh} r={N.rH} />
        <text class="f-label" x={N.xh[k]} y={N.yh + 5} text-anchor="middle">{m}</text>
      </g>
    ))}
    {dOut.map((d, i) => (
      <g>
        <rect class="f-box" x={N.xout[i] - N.boxW / 2} y={N.yout - N.boxH / 2} width={N.boxW} height={N.boxH} rx="6" />
        <MathText x={N.xout[i]} y={N.yout + 5} t={`s_${d}, t_${d}`} anchor="middle" size={15} />
        <text class="f-small f-t-muted" x={N.xout[i]} y={N.yout + N.boxH / 2 + 18} text-anchor="middle">m = {d}</text>
      </g>
    ))}
    <text class="f-note" x={N.xout[0]} y={N.yout + N.boxH / 2 + 36} text-anchor="middle">constant</text>
    <text class="f-note" x={N.xin[2]} y={N.yin - N.rIn - 26} text-anchor="middle">unused</text>

    <MathText x={180} y={376} t="z′_i = z_i e^{s_i} + t_i" anchor="middle" size={17} />
    <path class="f-line" d={`M 180 388 V ${NJ.y0 - 34}`} marker-end="url(#f-arrow)" />
    <MathText x={196} y={(388 + NJ.y0 - 34) / 2 + 6} t="J = ∂z′ / ∂z" size={16} />
    {dIn.map((d, j) => <MathText x={NJ.x0 + (j + 0.5) * NJ.c} y={NJ.y0 - 10} t={`z_${d}`} anchor="middle" size={16} />)}
    {dOut.map((d, i) => <MathText x={NJ.x0 - 10} y={NJ.y0 + (i + 0.5) * NJ.c + 5} t={`z′_${d}`} anchor="end" size={16} />)}
    {J.map((row, i) => row.map((v, j) => (
      <rect
        class={`f-grid ${v === 'diag' ? 'f-fill-amber' : v === 'dense' ? 'f-fill-blue' : ''}`}
        x={NJ.x0 + j * NJ.c}
        y={NJ.y0 + i * NJ.c}
        width={NJ.c}
        height={NJ.c}
        style={v === 'zero' ? 'fill: url(#flow-architectures-made-nhatch)' : undefined}
      />
    )))}
    {J.map((row, i) => row.map((v, j) => {
      const cx = NJ.x0 + (j + 0.5) * NJ.c;
      const cy = NJ.y0 + (i + 0.5) * NJ.c;
      if (v === 'diag') return <MathText x={cx} y={cy + 5} t={`e^{s_${i + 1}}`} anchor="middle" size={16} />;
      if (v === 'dense') return <text class="f-t-blue" x={cx} y={cy + 8} text-anchor="middle" style="font-size: 20px">∗</text>;
      return null;
    }))}
    <rect class="f-line" x={NJ.x0} y={NJ.y0} width={3 * NJ.c} height={3 * NJ.c} />
    <text class="f-note" x={NJ.x0 + 3 * NJ.c + 12} y={NJ.y0 + 1.5 * NJ.c + 5}>lower-triangular</text>
  </svg>
</Figure>
