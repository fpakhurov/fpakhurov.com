---
import Figure from '../Figure.astro';
import MathText from './MathText.astro';
import { curve } from '../geometry';

/**
 * Glow's invertible 1×1 convolution: the C-vector at one pixel is multiplied by a
 * C×C matrix W = L U. L is unit lower-triangular, U upper-triangular, so
 * log|det W| = Σ log|U_ii|. Patterns are generated from the triangular structure.
 */
const C = 4;
type Cell = { i: number; j: number; kind: 'one' | 'free' | 'diag' | 'zero' };
const lower: Cell[] = [];
const upper: Cell[] = [];
for (let i = 0; i < C; i += 1) {
  for (let j = 0; j < C; j += 1) {
    lower.push({ i, j, kind: i === j ? 'one' : j < i ? 'free' : 'zero' });
    upper.push({ i, j, kind: i === j ? 'diag' : j > i ? 'free' : 'zero' });
  }
}
const cellClass = (kind: Cell['kind']) =>
  kind === 'free' ? 'f-grid f-fill-blue' : kind === 'diag' ? 'f-grid f-fill-amber' : kind === 'one' ? 'f-grid f-fill-paper' : 'f-grid';

/** Oblique box for an h × w × C feature map with one highlighted pixel in the top row. */
function tensor(x: number, y: number, cell: number, n: number, dx: number, dy: number, col: number) {
  const s = cell * n;
  const front = { x, y, s };
  const topFace = `M ${x} ${y} L ${x + s} ${y} L ${x + s + dx} ${y - dy} L ${x + dx} ${y - dy} Z`;
  const sideFace = `M ${x + s} ${y} L ${x + s + dx} ${y - dy} L ${x + s + dx} ${y + s - dy} L ${x + s} ${y + s} Z`;
  const px = x + col * cell;
  const pixelFront = { x: px, y, w: cell, h: cell };
  const tube = `M ${px} ${y} L ${px + cell} ${y} L ${px + cell + dx} ${y - dy} L ${px + dx} ${y - dy} Z`;
  const grid: string[] = [];
  for (let k = 1; k < n; k += 1) {
    grid.push(`M ${x + k * cell} ${y} V ${y + s}`, `M ${x} ${y + k * cell} H ${x + s}`);
  }
  const tubeTop = { x: px + cell / 2 + dx, y: y - dy };
  return { front, topFace, sideFace, pixelFront, tube, grid, tubeTop, right: x + s + dx };
}

const WT = tensor(30, 132, 22, 4, 40, 32, 2);
const NT = tensor(40, 90, 22, 4, 40, 32, 2);

const cw = 22; // matrix cell size
const vec = (x: number, y: number) => Array.from({ length: C }, (_, i) => ({ x, y: y + i * cw }));

// Wide geometry
const yTop = 118;
const zW = vec(214, yTop);
const L0 = { x: 296, y: yTop };
const U0 = { x: 410, y: yTop };
const zpW = vec(560, yTop);
const box = { x: 282, y: 90, w: 230, h: 130 };
const midY = yTop + (C * cw) / 2;

// Narrow geometry
const zN = vec(258, 80);
const NL0 = { x: 84, y: 276 };
const NU0 = { x: 198, y: 276 };
const nbox = { x: 70, y: 248, w: 230, h: 130 };
const zpN = vec(258, 414);
---

<Figure
  id="flow-architectures-glow"
  title="Glow's invertible 1×1 convolution"
  caption="At every spatial position the vector of C channel values is multiplied by the same learned C × C matrix W, which mixes the channels. W is stored as an LU product: L has ones on its diagonal (det L = 1) and U is upper-triangular, so log|det W| is just the sum of log|Uᵢᵢ|. Over a whole h × w map the layer's log-determinant is h·w times that sum. Drawn for C = 4."
  origin="expanded"
  pages="37"
>
  <svg class="fig-wide" viewBox="0 0 680 340" role="img" aria-labelledby="flow-architectures-glow-t flow-architectures-glow-d">
    <title id="flow-architectures-glow-t">A one by one convolution as a per-pixel matrix product W = LU</title>
    <desc id="flow-architectures-glow-d">Left: a feature map drawn as a box of height h, width w and depth C, with one pixel highlighted through all channels. An arrow takes that pixel's channel vector z, of length C, into a box labelled W = L U, containing a lower-triangular matrix L with ones on the diagonal and an upper-triangular matrix U with its diagonal highlighted. The output vector z prime goes back to the same pixel. Below: det L = 1, det U = product of U_ii, and log absolute det W = sum of log absolute U_ii; applied at all h times w pixels the layer log-determinant is h times w times that sum.</desc>
    <defs>
      <pattern id="flow-architectures-glow-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" style="stroke: var(--muted); stroke-width: 1; opacity: 0.5" />
      </pattern>
    </defs>

    <!-- feature map -->
    <path class="f-box-soft" d={WT.topFace} />
    <path class="f-box-soft" d={WT.sideFace} />
    <rect class="f-box" x={WT.front.x} y={WT.front.y} width={WT.front.s} height={WT.front.s} />
    {WT.grid.map((d) => <path class="f-grid" d={d} />)}
    <path class="f-fill-amber f-thin f-amber" d={WT.tube} />
    <rect class="f-fill-amber f-thin f-amber" x={WT.pixelFront.x} y={WT.pixelFront.y} width={WT.pixelFront.w} height={WT.pixelFront.h} />
    <text class="f-math" x={WT.front.x + WT.front.s / 2} y={WT.front.y + WT.front.s + 24} text-anchor="middle">h × w</text>
    <text class="f-math" x={WT.right + 8} y={WT.front.y + 8}>C</text>
    <text class="f-note" x={20} y={58}>one pixel, all channels:</text>
    <MathText x={20} y={78} t="z ∈ ℝ^C" class="f-math" size={17} />
    <path class="f-thin f-amber" d={curve(WT.tubeTop.x, WT.tubeTop.y - 4, zW[0].x + cw / 2, zW[0].y - 6, -26)} marker-end="url(#f-arrow)" />

    <!-- input vector -->
    {zW.map((c) => <rect class="f-grid f-fill-amber" x={c.x} y={c.y} width={cw} height={cw} />)}
    <rect class="f-line" x={zW[0].x} y={zW[0].y} width={cw} height={C * cw} />
    <text class="f-math" x={zW[0].x + cw / 2} y={zW[0].y + C * cw + 24} text-anchor="middle">z</text>
    <path class="f-line" d={`M ${zW[0].x + cw + 6} ${midY} H ${box.x - 2}`} marker-end="url(#f-arrow)" />

    <!-- W = L U -->
    <rect class="f-box-soft" x={box.x} y={box.y} width={box.w} height={box.h} rx="8" />
    <MathText x={box.x + box.w / 2} y={box.y - 12} t="W = L U   (C × C)" anchor="middle" size={17} />
    <text class="f-math" x={L0.x + 2 * cw} y={L0.y - 8} text-anchor="middle">L</text>
    <text class="f-math" x={U0.x + 2 * cw} y={U0.y - 8} text-anchor="middle">U</text>
    {lower.map((c) => (
      <rect class={cellClass(c.kind)} x={L0.x + c.j * cw} y={L0.y + c.i * cw} width={cw} height={cw} style={c.kind === 'zero' ? 'fill: url(#flow-architectures-glow-hatch)' : undefined} />
    ))}
    {lower.filter((c) => c.kind === 'one').map((c) => (
      <text class="f-small" x={L0.x + (c.j + 0.5) * cw} y={L0.y + (c.i + 0.5) * cw + 4.5} text-anchor="middle">1</text>
    ))}
    {upper.map((c) => (
      <rect class={cellClass(c.kind)} x={U0.x + c.j * cw} y={U0.y + c.i * cw} width={cw} height={cw} style={c.kind === 'zero' ? 'fill: url(#flow-architectures-glow-hatch)' : undefined} />
    ))}
    <rect class="f-line" x={L0.x} y={L0.y} width={C * cw} height={C * cw} />
    <rect class="f-line" x={U0.x} y={U0.y} width={C * cw} height={C * cw} />
    <text class="f-math" x={(L0.x + C * cw + U0.x) / 2} y={midY + 6} text-anchor="middle">·</text>

    <!-- output vector -->
    <path class="f-line" d={`M ${box.x + box.w + 2} ${midY} H ${zpW[0].x - 6}`} marker-end="url(#f-arrow)" />
    {zpW.map((c) => <rect class="f-grid f-fill-blue" x={c.x} y={c.y} width={cw} height={cw} />)}
    <rect class="f-line" x={zpW[0].x} y={zpW[0].y} width={cw} height={C * cw} />
    <MathText x={zpW[0].x + cw / 2} y={zpW[0].y + C * cw + 24} t="z′ = W z" anchor="middle" size={17} />
    <text class="f-note" x={zpW[0].x + cw + 12} y={midY - 4}>back to</text>
    <text class="f-note" x={zpW[0].x + cw + 12} y={midY + 14}>the same pixel</text>

    <!-- determinants -->
    <MathText x={L0.x + 2 * cw} y={box.y + box.h + 24} t="det L = 1" class="f-label" anchor="middle" />
    <MathText x={U0.x + 2 * cw} y={box.y + box.h + 24} t="det U = ∏ U_{ii}" class="f-label f-t-amber" anchor="middle" />
    <MathText x={340} y={292} t="log |det W| = Σᵢ log |U_{ii}|" anchor="middle" size={19} />
    <text class="f-note" x={340} y={320} text-anchor="middle">same W at all h·w positions, so the layer adds h·w · log|det W| to the log-likelihood</text>
  </svg>

  <svg class="fig-narrow" viewBox="0 0 360 590" role="img" aria-labelledby="flow-architectures-glow-nt flow-architectures-glow-nd">
    <title id="flow-architectures-glow-nt">A one by one convolution as a per-pixel matrix product (stacked)</title>
    <desc id="flow-architectures-glow-nd">A feature map with one highlighted pixel; its channel vector z goes down into a box W = L U with a unit lower-triangular L and an upper-triangular U, and comes out as z prime. Below: log absolute det W equals the sum of log absolute U_ii.</desc>
    <defs>
      <pattern id="flow-architectures-glow-nhatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" style="stroke: var(--muted); stroke-width: 1; opacity: 0.5" />
      </pattern>
    </defs>
    <path class="f-box-soft" d={NT.topFace} />
    <path class="f-box-soft" d={NT.sideFace} />
    <rect class="f-box" x={NT.front.x} y={NT.front.y} width={NT.front.s} height={NT.front.s} />
    {NT.grid.map((d) => <path class="f-grid" d={d} />)}
    <path class="f-fill-amber f-thin f-amber" d={NT.tube} />
    <rect class="f-fill-amber f-thin f-amber" x={NT.pixelFront.x} y={NT.pixelFront.y} width={NT.pixelFront.w} height={NT.pixelFront.h} />
    <text class="f-math" x={NT.front.x + NT.front.s / 2} y={NT.front.y + NT.front.s + 24} text-anchor="middle">h × w</text>
    <text class="f-math" x={NT.right + 8} y={NT.front.y + 8}>C</text>
    <path class="f-thin f-amber" d={curve(NT.tubeTop.x, NT.tubeTop.y - 4, zN[0].x - 4, zN[0].y + 6, -30)} marker-end="url(#f-arrow)" />
    {zN.map((c) => <rect class="f-grid f-fill-amber" x={c.x} y={c.y} width={cw} height={cw} />)}
    <rect class="f-line" x={zN[0].x} y={zN[0].y} width={cw} height={C * cw} />
    <MathText x={zN[0].x + cw + 10} y={zN[0].y + 2 * cw + 6} t="z ∈ ℝ^C" size={17} />
    <path class="f-line" d={`M ${zN[0].x + cw / 2} ${zN[0].y + C * cw + 6} V ${nbox.y - 2}`} marker-end="url(#f-arrow)" />

    <rect class="f-box-soft" x={nbox.x} y={nbox.y} width={nbox.w} height={nbox.h} rx="8" />
    <MathText x={nbox.x + 10} y={nbox.y - 12} t="W = L U" size={17} />
    <text class="f-math" x={NL0.x + 2 * cw} y={NL0.y - 8} text-anchor="middle">L</text>
    <text class="f-math" x={NU0.x + 2 * cw} y={NU0.y - 8} text-anchor="middle">U</text>
    {lower.map((c) => (
      <rect class={cellClass(c.kind)} x={NL0.x + c.j * cw} y={NL0.y + c.i * cw} width={cw} height={cw} style={c.kind === 'zero' ? 'fill: url(#flow-architectures-glow-nhatch)' : undefined} />
    ))}
    {lower.filter((c) => c.kind === 'one').map((c) => (
      <text class="f-small" x={NL0.x + (c.j + 0.5) * cw} y={NL0.y + (c.i + 0.5) * cw + 4.5} text-anchor="middle">1</text>
    ))}
    {upper.map((c) => (
      <rect class={cellClass(c.kind)} x={NU0.x + c.j * cw} y={NU0.y + c.i * cw} width={cw} height={cw} style={c.kind === 'zero' ? 'fill: url(#flow-architectures-glow-nhatch)' : undefined} />
    ))}
    <rect class="f-line" x={NL0.x} y={NL0.y} width={C * cw} height={C * cw} />
    <rect class="f-line" x={NU0.x} y={NU0.y} width={C * cw} height={C * cw} />
    <text class="f-math" x={(NL0.x + C * cw + NU0.x) / 2} y={NL0.y + 2 * cw + 6} text-anchor="middle">·</text>

    <path class="f-line" d={`M ${zpN[0].x + cw / 2} ${nbox.y + nbox.h + 2} V ${zpN[0].y - 6}`} marker-end="url(#f-arrow)" />
    {zpN.map((c) => <rect class="f-grid f-fill-blue" x={c.x} y={c.y} width={cw} height={cw} />)}
    <rect class="f-line" x={zpN[0].x} y={zpN[0].y} width={cw} height={C * cw} />
    <MathText x={zpN[0].x - 12} y={zpN[0].y + 2 * cw + 6} t="z′ = W z" anchor="end" size={17} />

    <MathText x={180} y={538} t="det L = 1,   det U = ∏ U_{ii}" class="f-label" anchor="middle" />
    <MathText x={180} y={570} t="log |det W| = Σᵢ log |U_{ii}|" anchor="middle" size={18} />
  </svg>
</Figure>
