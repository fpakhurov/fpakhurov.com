---
import Figure from '../Figure.astro';
import MathText from './MathText.astro';
import { polyline, curve } from '../geometry';
import type { Point } from '../geometry';

/**
 * How one 2-D affine coupling layer warps a grid (illustrative, computed):
 *   z′₁ = z₁,   z′₂ = z₂ · exp(s(z₁)) + t(z₁),   s(u) = 0.5 tanh u,  t(u) = 0.5 sin 1.5u.
 * The highlighted cell's area is multiplied by the average of exp(s) over its column,
 * i.e. by |det J| = exp(s(z₁)), computed below by numerical integration.
 */
const s = (u: number) => 0.5 * Math.tanh(u);
const t = (u: number) => 0.5 * Math.sin(1.5 * u);
const f = (z1: number, z2: number): Point => [z1, z2 * Math.exp(s(z1)) + t(z1)];

const unit = 48;
const ticks = [-1.5, -1, -0.5, 0, 0.5, 1, 1.5];
const cell = { u0: 0.5, u1: 1.0, v0: 0, v1: 0.5 };

// Exact area ratio of the highlighted cell: (1 / Δu) ∫ exp(s(u)) du.
const n = 2000;
let integral = 0;
for (let k = 0; k < n; k += 1) integral += Math.exp(s(cell.u0 + ((cell.u1 - cell.u0) * (k + 0.5)) / n));
const ratio = integral / n;
const ratioLabel = ratio.toFixed(2);

function panel(cx: number, cy: number, warp: boolean) {
  const X = (u: number) => cx + u * unit;
  const Y = (v: number) => cy - v * unit;
  const map = (z1: number, z2: number): Point => {
    const [a, b] = warp ? f(z1, z2) : [z1, z2];
    return [X(a), Y(b)];
  };
  const samples = 60;
  const vertical = ticks.map((u) => polyline([map(u, -1.5), map(u, 1.5)]));
  const horizontal = ticks.map((v) =>
    polyline(Array.from({ length: samples + 1 }, (_, i) => map(-1.5 + (3 * i) / samples, v))),
  );
  const m = 24;
  const top = Array.from({ length: m + 1 }, (_, i) => map(cell.u0 + ((cell.u1 - cell.u0) * i) / m, cell.v1));
  const bottom = Array.from({ length: m + 1 }, (_, i) => map(cell.u1 - ((cell.u1 - cell.u0) * i) / m, cell.v0));
  const highlight = `${polyline([...top, ...bottom])} Z`;
  const centre = map((cell.u0 + cell.u1) / 2, (cell.v0 + cell.v1) / 2);
  return { vertical, horizontal, highlight, centre, X, Y };
}

// Wide: side by side, shared scale, z₂ = 0 on the same screen row.
const WL = panel(132, 209, false);
const WR = panel(476, 209, true);
// Narrow: stacked.
const NL = panel(180, 136, false);
const NR = panel(180, 470, true);
---

<Figure
  id="flow-architectures-grid-warp"
  title="The Jacobian measures how a layer warps space"
  caption={`A single 2-D affine coupling layer applied to a square grid, with s(z₁) = 0.5 tanh z₁ and t(z₁) = 0.5 sin 1.5z₁. Vertical lines stay where they are because z′₁ = z₁; each vertical strip is stretched by exp(s(z₁)) and shifted by t(z₁). The highlighted cell's area grows by a factor ${ratioLabel}, the average of |det J| = exp(s(z₁)) over its strip. The course notebook visualizes trained flows the same way, by pushing a grid backward through every layer.`}
>
  <svg class="fig-wide" viewBox="0 0 640 360" role="img" aria-labelledby="flow-architectures-gw-t flow-architectures-gw-d">
    <title id="flow-architectures-gw-t">A square grid before and after one coupling layer</title>
    <desc id={`flow-architectures-gw-d`}>{`Left: a square grid in the z plane with one highlighted cell. Right: the same grid after the coupling layer. Vertical lines remain vertical, horizontal lines become wavy curves whose spacing grows to the right, where exp(s) exceeds 1, and shrinks to the left. The highlighted cell becomes a taller curved quadrilateral with ${ratioLabel} times the original area.`}</desc>

    <text class="f-title" x={132} y={118} text-anchor="middle">before: z</text>
    <text class="f-title" x={476} y={40} text-anchor="middle">after: z′ = f(z)</text>
    {WL.vertical.map((d) => <path class="f-thin f-muted" d={d} />)}
    {WL.horizontal.map((d) => <path class="f-thin f-muted" d={d} />)}
    <path class="f-fill-amber f-line f-amber" d={WL.highlight} />
    {WR.vertical.map((d) => <path class="f-thin f-muted" d={d} />)}
    {WR.horizontal.map((d) => <path class="f-thin f-blue" d={d} />)}
    <path class="f-fill-amber f-line f-amber" d={WR.highlight} />

    <MathText x={WL.X(1.5) + 8} y={WL.Y(-1.5) + 22} t="z_1" size={16} />
    <MathText x={WL.X(-1.5) - 8} y={WL.Y(1.5) + 4} t="z_2" anchor="end" size={16} />
    <MathText x={WR.X(1.5) + 8} y={WR.Y(-1.5) + 4} t="z′_1" size={16} />
    <MathText x={WR.X(-1.5) - 8} y={WR.Y(1.2)} t="z′_2" anchor="end" size={16} />

    <path class="f-line" d="M 226 209 H 384" marker-end="url(#f-arrow)" />
    <text class="f-label" x={305} y={198} text-anchor="middle">coupling layer</text>
    <MathText x={305} y={234} t="z′_2 = z_2 e^{s(z_1)} + t(z_1)" anchor="middle" size={15} />

    <text class="f-label f-t-amber" x={566} y={128}>area × {ratioLabel}</text>
    <path class="f-thin f-amber" d={curve(580, 134, WR.centre[0] + 14, WR.centre[1] - 6, 18)} marker-end="url(#f-arrow)" />
    <text class="f-note" x={320} y={348} text-anchor="middle">vertical lines stay put; each strip is stretched by exp(s(z₁)) and shifted by t(z₁)</text>
  </svg>

  <svg class="fig-narrow" viewBox="0 0 360 650" role="img" aria-labelledby="flow-architectures-gw-nt flow-architectures-gw-nd">
    <title id="flow-architectures-gw-nt">A square grid before and after one coupling layer (stacked)</title>
    <desc id="flow-architectures-gw-nd">{`Top: a square grid with one highlighted cell. Bottom: the grid after the coupling layer, vertical lines unchanged and horizontal lines bent and stretched; the highlighted cell has ${ratioLabel} times its original area.`}</desc>
    <text class="f-title" x={180} y={46} text-anchor="middle">before: z</text>
    {NL.vertical.map((d) => <path class="f-thin f-muted" d={d} />)}
    {NL.horizontal.map((d) => <path class="f-thin f-muted" d={d} />)}
    <path class="f-fill-amber f-line f-amber" d={NL.highlight} />
    <MathText x={NL.X(1.5) + 8} y={NL.Y(-1.5) + 5} t="z_1" size={16} />
    <MathText x={NL.X(-1.5) - 8} y={NL.Y(1.5) + 4} t="z_2" anchor="end" size={16} />
    <path class="f-line" d="M 120 222 V 290" marker-end="url(#f-arrow)" />
    <text class="f-label" x={136} y={252}>coupling layer</text>
    <MathText x={136} y={278} t="z′_2 = z_2 e^{s(z_1)} + t(z_1)" size={15} />
    {NR.vertical.map((d) => <path class="f-thin f-muted" d={d} />)}
    {NR.horizontal.map((d) => <path class="f-thin f-blue" d={d} />)}
    <path class="f-fill-amber f-line f-amber" d={NR.highlight} />
    <MathText x={NR.X(1.5) + 8} y={NR.Y(-1.5) + 4} t="z′_1" size={16} />
    <MathText x={NR.X(-1.5) - 8} y={NR.Y(1.2)} t="z′_2" anchor="end" size={16} />
    <text class="f-title" x={180} y={322} text-anchor="middle">after: z′ = f(z)</text>
    <text class="f-label f-t-amber" x={268} y={NR.Y(2.1)}>area</text>
    <text class="f-label f-t-amber" x={268} y={NR.Y(2.1) + 18}>× {ratioLabel}</text>
    <path class="f-thin f-amber" d={curve(282, NR.Y(2.1) + 26, NR.centre[0] + 14, NR.centre[1] - 6, 14)} marker-end="url(#f-arrow)" />
    <text class="f-note" x={180} y={NR.Y(-2.1) + 28} text-anchor="middle">vertical lines stay put; strips are</text>
    <text class="f-note" x={180} y={NR.Y(-2.1) + 46} text-anchor="middle">stretched by exp(s(z₁)), shifted by t(z₁)</text>
  </svg>
</Figure>
