---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { samplers, rho, start, budget, shownEvals, rwmStep, malaStep, hmcStep, hmcL, acfX1, maxLagEvals, type P2 } from './simulation';

const ru = pageLang(Astro.url) === 'ru';

// Random-walk Metropolis, MALA and HMC on a bivariate normal with correlation 0.95, each given 3000 evaluations of
// the target. Top: the first 300 evaluations' worth of each chain. Bottom: the autocorrelation of x₁ against the lag
// measured in evaluations, from the full runs. Each sampler has its own colour in both parts.
const pct = (a: number) => `${Math.round(a * 100)}%`;
const r0 = (v: number) => Math.round(v).toString();
const f2 = (v: number) => v.toFixed(2).replace('-', '−');
const at10 = { rwm: acfX1.rwm[10][1], mala: acfX1.mala[10][1], hmc: acfX1.hmc[1][1] };
// The numbers the note and the caption quote.
const quoted = { rwm: ['22%', '92', '0.59'], mala: ['57%', '38', '0.79'], hmc: ['86%', '300', '−0.41'] };
for (const [k, [acc, e, a10]] of Object.entries(quoted)) {
  const key = k as keyof typeof samplers;
  const got = [pct(samplers[key].acc), r0(samplers[key].essX1), f2(at10[key])];
  if (got.join() !== [acc, e, a10].join()) throw new Error(`SamplerPaths: ${k} gives ${got.join(', ')}, the note quotes ${acc}, ${e}, ${a10}`);
}
if (budget !== 3000 || shownEvals !== 300 || acfX1.hmc[1][0] !== 10) throw new Error('SamplerPaths: budget or lags changed');

const ell = (k: number): P2[] => Array.from({ length: 121 }, (_, i) => {
  const a = (2 * Math.PI * i) / 120, u = k * Math.sqrt(1 + rho) * Math.cos(a), v = k * Math.sqrt(1 - rho) * Math.sin(a);
  return [(u - v) / Math.SQRT2, (u + v) / Math.SQRT2];
});
const nHmc = shownEvals / hmcL;
const panels = [
  { title: ru ? 'Случайное блуждание' : 'Random-walk Metropolis', short: ru ? 'Блуждание' : 'Random walk', tone: 'amber', chain: [start, ...samplers.rwm.states.slice(0, shownEvals)], paths: [] as P2[][], dots: false, s: samplers.rwm, acf: acfX1.rwm, legend: ru ? 'блуждание' : 'random walk' },
  { title: 'MALA', short: 'MALA', tone: 'green', chain: [start, ...samplers.mala.states.slice(0, shownEvals)], paths: [] as P2[][], dots: false, s: samplers.mala, acf: acfX1.mala, legend: 'MALA' },
  { title: ru ? 'Гамильтонов Монте-Карло' : 'Hamiltonian Monte Carlo', short: 'HMC', tone: 'blue', chain: [start, ...samplers.hmc.states.slice(0, nHmc)], paths: samplers.hmc.paths.slice(0, nHmc), dots: true, s: samplers.hmc, acf: acfX1.hmc, legend: 'HMC' },
];
const t = ru
  ? { acc: 'принято', ess: 'ESS по x₁', budget: `бюджет: ${budget}`, budget2: 'вычислений плотности', startL: 'старт (−2, −2)', acfTitle: 'автокорреляция x₁ за весь бюджет', lag: 'лаг в вычислениях плотности' }
  : { acc: 'accepted', ess: 'ESS of x₁', budget: `budget: ${budget} evaluations`, budget2: 'of the target', startL: 'start (−2, −2)', acfTitle: 'autocorrelation of x₁ over the whole budget', lag: 'lag in target evaluations' };
const id = 'mcmc-sampler-paths';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 560, size: 220, pos: (i: number) => [25 + i * 250, 46], wide: true, ax: [64, 730], ay: [372, 508] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 712, size: 160, pos: (i: number) => [12 + (i % 2) * 180, 44 + Math.floor(i / 2) * 236], wide: false, ax: [52, 340], ay: [548, 662] },
];
type Lay = (typeof layouts)[number];
const panelGeom = (L: Lay, i: number) => {
  const [x0, y0] = L.pos(i);
  const sx = scale([-3, 3], [x0, x0 + L.size]), sy = scale([-3, 3], [y0 + L.size, y0]);
  const P = (q: P2[]) => polyline(q.map(([a, b]) => [sx(a), sy(b)]));
  return { x0, y0, sx, sy, P };
};
const acfGeom = (L: Lay) => {
  const sx = scale([0, maxLagEvals], L.ax as [number, number]), sy = scale([-0.5, 1], [L.ay[1], L.ay[0]]);
  return {
    sx, sy,
    P: (q: P2[]) => polyline(q.map(([a, b]) => [sx(a), sy(b)])),
    xTicks: [0, 50, 100, 150, 200].map((v) => ({ x: sx(v), label: v.toString() })),
    yTicks: [-0.5, 0, 0.5, 1].map((v) => ({ y: sy(v), label: v.toString().replace('-', '−') })),
    legend: panels.map((pn, i) => ({ x: L.ax[1] - (L.wide ? 120 : 104), y: L.ay[0] + 14 + i * (L.wide ? 18 : 20), pn })),
  };
};
---

<Figure
  id={id}
  title={ru ? 'Три сэмплера с одинаковым бюджетом на вытянутой гауссиане' : 'Three samplers with the same budget on a narrow Gaussian'}
  caption={ru
    ? `Двумерное нормальное распределение с единичными дисперсиями и корреляцией ${rho} (эллипсы расстояния 1 и 2), старт в точке (−2, −2). Каждому сэмплеру дано ${budget} вычислений целевой плотности: значений плотности для блуждания (шаг σ = ${rwmStep}), градиентов для MALA (ε = ${malaStep}) и HMC (ε = ${hmcStep}, L = ${hmcL}, то есть ${budget / hmcL} итераций). Сверху — первые ${shownEvals} вычислений каждой цепи; у HMC бледным показаны траектории leapfrog, точки — состояния цепи. Блуждание принимает ${pct(samplers.rwm.acc)} предложений, MALA — ${pct(samplers.mala.acc)}, HMC — ${pct(samplers.hmc.acc)}. Снизу — автокорреляция x₁ по всему прогону в зависимости от лага, измеренного в вычислениях целевой плотности: через ${hmcL} вычислений она равна ${f2(at10.rwm)} у блуждания, ${f2(at10.mala)} у MALA и ${f2(at10.hmc)} у HMC (одна итерация). Эффективный размер выборки по x₁ за весь бюджет: ${r0(samplers.rwm.essX1)}, ${r0(samplers.mala.essX1)} и ${r0(samplers.hmc.essX1)}; у HMC эта оценка упирается в число итераций и занижает результат (см. текст).`
    : `A bivariate normal with unit variances and correlation ${rho} (ellipses at distance 1 and 2), started at (−2, −2). Each sampler gets ${budget} evaluations of the target: density values for the random walk (step σ = ${rwmStep}), gradients for MALA (ε = ${malaStep}) and HMC (ε = ${hmcStep}, L = ${hmcL}, so ${budget / hmcL} iterations). Top: the first ${shownEvals} evaluations of each chain; for HMC the leapfrog trajectories are drawn faintly and the dots are the states of the chain. The random walk accepts ${pct(samplers.rwm.acc)} of its proposals, MALA ${pct(samplers.mala.acc)}, HMC ${pct(samplers.hmc.acc)}. Bottom: the autocorrelation of x₁ over the whole run against the lag in target evaluations. After ${hmcL} evaluations it is ${f2(at10.rwm)} for the random walk, ${f2(at10.mala)} for MALA and ${f2(at10.hmc)} for HMC (one iteration). The effective sample size of x₁ over the whole budget is ${r0(samplers.rwm.essX1)}, ${r0(samplers.mala.essX1)} and ${r0(samplers.hmc.essX1)}; for HMC this estimator stops at the number of iterations and understates it (see the text).`}
>
  {layouts.map((L) => {
    const a = acfGeom(L);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{ru ? 'Траектории и автокорреляции трёх сэмплеров' : 'Paths and autocorrelations of three samplers'}</title>
        <desc id={`${id}-${L.sfx}-d`}>{ru
          ? 'Сверху три панели с одним и тем же диагональным эллипсом и путями цепей: ломаные блуждания и MALA и редкие точки HMC, разбросанные вдоль эллипса. Снизу три кривые автокорреляции: у HMC она уходит ниже нуля уже через одну итерацию, у блуждания спадает за полсотни вычислений, у MALA медленнее всего.'
          : 'Top: three panels with the same diagonal ellipse and the chain paths: zigzag lines for the random walk and MALA, and a few HMC states scattered along the ellipse. Bottom: three autocorrelation curves: HMC drops below zero after one iteration, the random walk decays within about fifty evaluations, MALA most slowly.'}</desc>
        <defs>
          {panels.map((_, i) => {
            const g = panelGeom(L, i);
            return <clipPath id={`${id}-${L.sfx}-clip-${i}`}><rect x={g.x0} y={g.y0} width={L.size} height={L.size} /></clipPath>;
          })}
        </defs>
        {panels.map((pn, i) => {
          const g = panelGeom(L, i);
          return (
            <g>
              <text class={`f-label f-t-${pn.tone}`} x={g.x0} y={g.y0 - 12}>{L.wide ? pn.title : pn.short}</text>
              <rect class="f-grid" x={g.x0} y={g.y0} width={L.size} height={L.size} style="fill: none" />
              <path class="f-grid" d={`M ${g.sx(-3)} ${g.sy(0)} H ${g.sx(3)} M ${g.sx(0)} ${g.sy(-3)} V ${g.sy(3)}`} />
              <path class="f-thin f-muted" d={g.P(ell(1))} />
              <path class="f-thin f-muted f-dash" d={g.P(ell(2))} />
              <g clip-path={`url(#${id}-${L.sfx}-clip-${i})`}>
                {pn.paths.map((q) => <path class={`f-thin f-${pn.tone}`} style="stroke-width: 0.9; opacity: 0.35" d={g.P(q)} />)}
                <path class={`f-thin f-${pn.tone}`} style="stroke-width: 1.1" d={g.P(pn.chain)} />
                {pn.dots && pn.chain.map(([u, v]) => <circle cx={g.sx(u)} cy={g.sy(v)} r="2.4" class={`f-solid-${pn.tone}`} />)}
              </g>
              <circle cx={g.sx(start[0])} cy={g.sy(start[1])} r="3.6" class="f-fill-ink" />
              <text class="f-small" x={g.x0} y={g.y0 + L.size + 20}>{`${t.acc} ${pct(pn.s.acc)}`}</text>
              <text class="f-small" x={g.x0} y={g.y0 + L.size + 38}>{`${t.ess}: ${r0(pn.s.essX1)}`}</text>
            </g>
          );
        })}
        {!L.wide && (
          <g>
            <text class="f-small f-t-muted" x={192} y={310}>{t.budget}</text>
            <text class="f-small f-t-muted" x={192} y={330}>{t.budget2}</text>
            <circle cx={198} cy={358} r="3.6" class="f-fill-ink" />
            <text class="f-small f-t-muted" x={208} y={363}>{t.startL}</text>
          </g>
        )}

        <text class="f-small" x={L.ax[0]} y={L.ay[0] - 14}>{t.acfTitle}</text>
        <path class="f-axis" d={`M ${L.ax[0]} ${L.ay[0]} V ${L.ay[1]} H ${L.ax[1]}`} />
        <path class="f-grid" d={`M ${L.ax[0]} ${a.sy(0)} H ${L.ax[1]}`} />
        {a.yTicks.map((tk) => <text class="f-note" x={L.ax[0] - 6} y={tk.y + 5} text-anchor="end">{tk.label}</text>)}
        {a.xTicks.map((tk) => <text class="f-note" x={tk.x} y={L.ay[1] + 18} text-anchor="middle">{tk.label}</text>)}
        <text class="f-small f-t-muted" x={L.ax[1]} y={L.ay[1] + 36} text-anchor="end">{t.lag}</text>
        {panels.map((pn) => <path class={`f-line f-${pn.tone}`} style="stroke-width: 1.6" d={a.P(pn.acf)} />)}
        {acfX1.hmc.map(([k, v]) => <circle cx={a.sx(k)} cy={a.sy(v)} r="2.8" class="f-solid-blue" />)}
        {a.legend.map((e) => (
          <g>
            <path class={`f-line f-${e.pn.tone}`} d={`M ${e.x} ${e.y - 4} h 22`} />
            <text class="f-small" x={e.x + 28} y={e.y}>{e.pn.legend}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
