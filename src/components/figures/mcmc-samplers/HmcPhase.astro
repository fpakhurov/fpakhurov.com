---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { iterations, eulerPath, energyLeapfrog, energyEuler, lfStep, lfL, hmcStart, H, type P2 } from './simulation';

const ru = pageLang(Astro.url) === 'ru';

// HMC on a standard normal, drawn in phase space (x, p), where H = x²/2 + p²/2 and exact trajectories are circles.
// Three iterations: fresh momentum (a vertical move), 7 leapfrog steps of size 0.3 (an arc), accept/reject.
// Euler's method with the same step, from the same start, spirals outwards; the right panel shows both energy errors.
const f2 = (v: number) => v.toFixed(2), f3 = (v: number) => v.toFixed(3);
const minus = (s: string) => s.replace('-', '−');
const [it1, it2, it3] = iterations;
const maxLf = Math.max(...energyLeapfrog.map(Math.abs));
const eulerEnd = energyEuler[energyEuler.length - 1];
// The numbers the note and the caption quote.
const checks: [string, string][] = [
  [f2(it1.p0), '0.73'], [f3(it1.dH), '-0.003'], [f2(it1.x1), '1.40'], [f2(it2.x1), '0.47'], [f2(it3.x1), '-1.09'],
  [f3(maxLf), '0.025'], [f2(eulerEnd), '1.15'], [f3(H(hmcStart, it1.p0)), '1.394'],
];
for (const [got, want] of checks) if (got !== want) throw new Error(`HmcPhase: computed ${got}, the note quotes ${want}`);
if (!iterations.every((it) => it.accepted)) throw new Error('HmcPhase: a proposal was rejected; the caption assumes three acceptances');
// Leapfrog conserves the shadow energy p²/2 + (1 − ε²/4) x²/2 exactly on this target; Euler multiplies H by 1 + ε² per step.
const shadow = ([x, p]: P2) => p * p / 2 + (1 - lfStep * lfStep / 4) * x * x / 2;
for (const it of iterations) for (const z of it.path) if (Math.abs(shadow(z) - shadow(it.path[0])) > 1e-12) throw new Error('HmcPhase: shadow energy not conserved');
if (Math.abs(eulerEnd - ((1 + lfStep ** 2) ** lfL - 1) * H(hmcStart, it1.p0)) > 1e-12) throw new Error('HmcPhase: Euler growth');

const t = ru
  ? { x: 'x (положение)', p: 'p (импульс)', refresh: 'p ~ N(0, 1)', lf: 'leapfrog', eu: 'Эйлер', dH: `ΔH = ${minus(f3(it1.dH))}`, accept: 'принято', keep: 'новое x',
      eTitle: 'ошибка энергии H − H₀ на 1-й траектории', step: 'шаг', euEnd: `Эйлер: +${f2(eulerEnd)}`, lfMax: `leapfrog: |ΔH| ≤ ${f3(maxLf)}`,
      steps: ['новый импульс p ~ N(0, 1): вертикальный сдвиг в фазовом пространстве, x не меняется',
        `${lfL} шагов leapfrog размера ${lfStep} идут по окружности постоянной H; Эйлер с тем же шагом раскручивается наружу`,
        `конец траектории принят с вероятностью min(1, e^(−ΔH)), здесь ΔH = ${minus(f3(it1.dH))}; x сохраняется, p отбрасывается`,
        'ещё две итерации: каждый новый импульс переводит цепь на другой уровень энергии'] }
  : { x: 'x (position)', p: 'p (momentum)', refresh: 'p ~ N(0, 1)', lf: 'leapfrog', eu: 'Euler', dH: `ΔH = ${minus(f3(it1.dH))}`, accept: 'accepted', keep: 'new x',
      eTitle: 'energy error H − H₀ on the first trajectory', step: 'step', euEnd: `Euler: +${f2(eulerEnd)}`, lfMax: `leapfrog: |ΔH| ≤ ${f3(maxLf)}`,
      steps: ['a fresh momentum p ~ N(0, 1): a vertical move in phase space, x unchanged',
        `${lfL} leapfrog steps of size ${lfStep} follow the circle of constant H; Euler with the same step spirals outwards`,
        `the end point is accepted with probability min(1, e^(−ΔH)), here ΔH = ${minus(f3(it1.dH))}; keep x, drop p`,
        'two more iterations: each fresh momentum moves the chain to another energy level'] };

const id = 'hmc-phase-space';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 352, px: 60, py: 36, ps: 280, ex: [452, 732], ey: [86, 286], wide: true },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 610, px: 52, py: 36, ps: 280, ex: [64, 332], ey: [418, 566], wide: false },
];
const R = 2.6;
const geom = (L: (typeof layouts)[number]) => {
  const sx = scale([-R, R], [L.px, L.px + L.ps]), sy = scale([-R, R], [L.py + L.ps, L.py]);
  const P = (q: P2[]) => polyline(q.map(([a, b]) => [sx(a), sy(b)]));
  const circle = (r: number) => P(Array.from({ length: 121 }, (_, i) => [r * Math.cos((2 * Math.PI * i) / 120), r * Math.sin((2 * Math.PI * i) / 120)] as P2));
  const ex = scale([0, lfL], L.ex as [number, number]), ey = scale([-0.15, 1.25], [L.ey[1], L.ey[0]]);
  const E = (vals: number[]) => polyline(vals.map((v, k) => [ex(k), ey(v)]));
  const end1 = it1.path[it1.path.length - 1], end2 = it2.path[it2.path.length - 1], end3 = it3.path[it3.path.length - 1];
  const top = it1.path.reduce((a, b) => (b[1] > a[1] ? b : a));
  const eTop = eulerPath.reduce((a, b) => (b[1] > a[1] ? b : a));
  return {
    sx, sy, P, ex, ey, E,
    radius: circle(Math.sqrt(2 * H(it1.x0, it1.p0))),
    refresh1: `M ${sx(hmcStart)} ${sy(0)} V ${sy(it1.p0) + 6}`,
    refresh2: `M ${sx(end1[0])} ${sy(end1[1])} V ${sy(it2.p0) + 6}`,
    refresh3: `M ${sx(end2[0])} ${sy(end2[1])} V ${sy(it3.p0) + 6}`,
    drops: [end1, end2, end3].map(([a, b]) => `M ${sx(a)} ${sy(b)} V ${sy(0)}`),
    ends: [end1, end2, end3].map(([a, b]) => [sx(a), sy(b)]),
    top: [sx(top[0]), sy(top[1])], eTop: [sx(eTop[0]), sy(eTop[1])],
    yTicks: [0, 0.5, 1].map((v) => ({ y: ey(v), label: v.toString() })),
    xTicks: Array.from({ length: lfL + 1 }, (_, k) => ({ x: ex(k), label: k.toString() })),
  };
};
---

<Figure
  id={id}
  title={ru ? 'Итерации HMC в фазовом пространстве: leapfrog против Эйлера' : 'HMC iterations in phase space: leapfrog against Euler'}
  caption={ru
    ? `Три итерации HMC на стандартном нормальном распределении на плоскости (x, p), где точные траектории — окружности. Каждая сэмплирует новый импульс (вертикальная стрелка), делает ${lfL} шагов leapfrog размера ε = ${lfStep} (синие точки) и принимается. Метод Эйлера из той же точки (красный пунктир) уходит по спирали наружу; справа — ошибка энергии вдоль первой траектории.`
    : `Three HMC iterations on a standard normal in the (x, p) plane, where exact trajectories are circles. Each draws a fresh momentum (vertical arrow), takes ${lfL} leapfrog steps of size ε = ${lfStep} (blue dots) and is accepted. Euler's method from the same point (red dashes) spirals outwards; right: energy error along the first trajectory.`}
>
  {layouts.map((L) => {
    const g = geom(L);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{ru ? 'Три итерации HMC и спираль Эйлера' : 'Three HMC iterations and the Euler spiral'}</title>
        <desc id={`${id}-${L.sfx}-d`}>{ru
          ? 'Слева: плоскость (x, p) с тремя дугами leapfrog на окружностях разного радиуса, соединёнными вертикальными стрелками обновления импульса, и красная спираль Эйлера. Справа: ошибка энергии по шагам, почти нулевая у leapfrog и растущая у Эйлера.'
          : 'Left: the (x, p) plane with three leapfrog arcs on circles of different radius, joined by vertical momentum-refresh arrows, and a red Euler spiral. Right: the energy error per step, almost zero for leapfrog and growing for Euler.'}</desc>
        <path class="f-grid" d={`M ${g.sx(-R)} ${g.sy(0)} H ${g.sx(R)} M ${g.sx(0)} ${g.sy(-R)} V ${g.sy(R)}`} />
        <rect class="f-grid" x={L.px} y={L.py} width={L.ps} height={L.ps} style="fill: none" />
        {[-2, 0, 2].map((v) => <text class="f-note" x={g.sx(v)} y={L.py + L.ps + 16} text-anchor="middle">{minus(v.toString())}</text>)}
        {[-2, 0, 2].map((v) => <text class="f-note" x={L.px - 6} y={g.sy(v) + 5} text-anchor="end">{minus(v.toString())}</text>)}
        <text class="f-small f-t-muted" x={L.px + L.ps} y={L.py + L.ps + 34} text-anchor="end">{t.x}</text>
        <text class="f-small f-t-muted" x={L.px + 6} y={L.py + 16}>{t.p}</text>

        <g data-s="1">
          <path class="f-thin f-muted f-dot" d={g.radius} />
          <circle cx={g.sx(hmcStart)} cy={g.sy(0)} r="4" class="f-solid-red" />
          <path class="f-line f-green" d={g.refresh1} marker-end="url(#f-arrow-green)" />
          <text class="f-small f-t-green f-halo" x={g.sx(hmcStart) - 8} y={g.sy(it1.p0 / 2) + 4} text-anchor="end">{t.refresh}</text>
        </g>
        <g data-s="2">
          <path class="f-line f-red f-dash" style="stroke-width: 1.4" d={g.P(eulerPath)} />
          {eulerPath.map(([a, b]) => <circle cx={g.sx(a)} cy={g.sy(b)} r="2.4" class="f-solid-red" />)}
          <path class="f-line f-blue" d={g.P(it1.path)} />
          {it1.path.map(([a, b]) => <circle cx={g.sx(a)} cy={g.sy(b)} r="3" class="f-solid-blue" />)}
          <text class="f-small f-t-blue f-halo" x={g.top[0]} y={g.top[1] + 18} text-anchor="middle">{t.lf}</text>
          <text class="f-small f-t-red f-halo" x={g.eTop[0]} y={g.eTop[1] - 10} text-anchor="middle">{t.eu}</text>
        </g>
        <g data-s="3">
          <circle cx={g.ends[0][0]} cy={g.ends[0][1]} r="7" class="f-thin f-blue" style="stroke-width: 2" />
          <path class="f-thin f-blue f-dot" d={g.drops[0]} />
          <circle cx={g.ends[0][0]} cy={g.sy(0)} r="3.6" class="f-solid-red" />
          <text class="f-small f-halo" x={g.ends[0][0] - 26} y={g.ends[0][1] + 26} text-anchor="end">{t.dH}</text>
          <text class="f-small f-halo" x={g.ends[0][0] - 26} y={g.ends[0][1] + 43} text-anchor="end">{t.accept}</text>
          <text class="f-small f-t-red f-halo" x={g.ends[0][0]} y={g.sy(0) + 34} text-anchor="middle">{t.keep}</text>
        </g>
        <g data-s="4">
          <path class="f-line f-green" d={g.refresh2} marker-end="url(#f-arrow-green)" />
          <path class="f-line f-green" d={g.refresh3} marker-end="url(#f-arrow-green)" />
          <path class="f-line f-blue" style="opacity: 0.75" d={g.P(it2.path)} />
          <path class="f-line f-blue" style="opacity: 0.75" d={g.P(it3.path)} />
          {[...it2.path, ...it3.path].map(([a, b]) => <circle cx={g.sx(a)} cy={g.sy(b)} r="2.4" class="f-solid-blue" />)}
          {g.drops.slice(1).map((d) => <path class="f-thin f-blue f-dot" d={d} />)}
          {g.ends.slice(1).map(([a]) => <circle cx={a} cy={g.sy(0)} r="3.6" class="f-solid-red" />)}
        </g>
        <Badge x={g.sx(hmcStart) - 16} y={g.sy(0) + 18} n={1} />
        <Badge x={g.top[0]} y={g.top[1] + 36} n={2} />
        <Badge x={g.ends[0][0] - 14} y={g.ends[0][1] + 20} n={3} />
        <Badge x={g.sx(2.25)} y={g.sy(-1.5)} n={4} />

        <g data-s="2">
          <text class="f-small" x={L.ex[0]} y={L.ey[0] - 24}>{t.eTitle}</text>
          <path class="f-axis" d={`M ${L.ex[0]} ${L.ey[0]} V ${L.ey[1]} H ${L.ex[1]}`} />
          <path class="f-grid" d={`M ${L.ex[0]} ${g.ey(0)} H ${L.ex[1]}`} />
          {g.yTicks.map((tk) => <text class="f-note" x={L.ex[0] - 6} y={tk.y + 5} text-anchor="end">{tk.label}</text>)}
          {g.xTicks.map((tk) => <text class="f-note" x={tk.x} y={L.ey[1] + 18} text-anchor="middle">{tk.label}</text>)}
          <text class="f-small f-t-muted" x={L.ex[1]} y={L.ey[1] + 36} text-anchor="end">{t.step}</text>
          <path class="f-line f-red f-dash" style="stroke-width: 1.4" d={g.E(energyEuler)} />
          {energyEuler.map((v, k) => <circle cx={g.ex(k)} cy={g.ey(v)} r="2.4" class="f-solid-red" />)}
          <path class="f-line f-blue" d={g.E(energyLeapfrog)} />
          {energyLeapfrog.map((v, k) => <circle cx={g.ex(k)} cy={g.ey(v)} r="2.6" class="f-solid-blue" />)}
          <text class="f-small f-t-red f-halo" x={g.ex(lfL) - 8} y={g.ey(eulerEnd) - 4} text-anchor="end">{t.euEnd}</text>
          <text class="f-small f-t-blue f-halo" x={L.ex[1]} y={g.ey(0) - 10} text-anchor="end">{t.lfMax}</text>
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
