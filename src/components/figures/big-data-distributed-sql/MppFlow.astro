---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? "Четыре чтения и один результат" : "Four scans and one result";
const caption = ru ? "Каждый сегмент читает 150 ГБ локально. Если все строки магазина на одном сегменте, для 500 магазинов собираем 500 строк." : "Each segment scans 150 GB locally. With all rows of a store on one segment, gathering 500 store totals needs only 500 rows.";
const desc = ru ? "Исполнители A–D читают по 150 ГБ и передают получателю локальные суммы. Вместе они дают 500 итогов." : "Workers A through D each scan 150 GB and send local store totals to a receiver. Together they produce 500 totals.";
const workers = ['A', 'B', 'C', 'D'];
---
<Figure id="bd-mpp-flow" title={title} caption={caption}>
  <svg viewBox="0 0 340 174" role="img" aria-labelledby="bd-mpp-flow-title bd-mpp-flow-desc" style="max-width: 550px; margin-inline: auto">
    <title id="bd-mpp-flow-title">{title}</title>
    <desc id="bd-mpp-flow-desc">{desc}</desc>
    {workers.map((worker, i) => (
      <g transform={`translate(${i * 83} 0)`}>
        <rect class="f-fill-blue" x="9" y="16" width="73" height="48" rx="5" />
        <text class="f-label" x="45" y="35" text-anchor="middle">{worker}</text>
        <text class="f-label" x="45" y="54" text-anchor="middle">{ru ? '150 ГБ' : '150 GB'}</text>
        <path class="f-line" d={`M 45 66 L ${115 - i * 46} 103`} fill="none" />
      </g>
    ))}
    <rect class="f-fill-green" x="56" y="106" width="228" height="41" rx="6" />
    <text class="f-label" x="170" y="132" text-anchor="middle">{ru ? 'Сбор · 500 итогов' : 'Gather · 500 totals'}</text>
  </svg>
</Figure>
