---
import BlockDiagram, { type DLayout } from '../BlockDiagram.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The two-stage recipe with the numbers of DALL·E: a 32×32 grid of codes from a vocabulary of 8192, up to 256 text tokens.
const t = ru
  ? { x: 'изображение', xs: '256×256×3', e: 'энкодер', es: 'один из 8192 кодов', g: 'сетка токенов', gs: '32×32 = 1024', d: 'декодер', ds: 'токены → пиксели', xr: 'изображение', xrs: '256×256×3', p: 'запрос', ps: 'подпись', tt: 'токены текста', tts: 'до 256, BPE', tr: 'трансформер', trs: 'следующий токен', it: 'токены картинки', its: '1024, по одному', tgt: 'цели', gen: 'генерация', s1: 'этап 1: токенизатор изображений', s2: 'этап 2: трансформер над токенами' }
  : { x: 'image', xs: '256×256×3', e: 'encoder', es: 'one of 8192 codes', g: 'token grid', gs: '32×32 = 1024', d: 'decoder', ds: 'tokens → pixels', xr: 'image', xrs: '256×256×3', p: 'prompt', ps: 'caption', tt: 'text tokens', tts: 'up to 256, BPE', tr: 'transformer', trs: 'next token', it: 'image tokens', its: '1024, one by one', tgt: 'targets', gen: 'generation', s1: 'stage 1: image tokenizer', s2: 'stage 2: transformer over tokens' };
const desc = ru
  ? 'Этап 1: энкодер переводит изображение 256×256 в сетку 32×32 из индексов 8192 кодов, декодер восстанавливает по ней пиксели. Этап 2: токены текста и токены изображения в порядке развёртки образуют одну последовательность, и трансформер учится предсказывать каждый токен по предыдущим. При генерации токены изображения сэмплируются по одному и передаются декодеру этапа 1.'
  : 'Stage 1: an encoder turns a 256×256 image into a 32×32 grid of indices into 8192 codes, and a decoder reconstructs pixels from it. Stage 2: text tokens and image tokens in raster order form one sequence, and a transformer learns to predict each token from the ones before it. At generation, image tokens are sampled one at a time and passed to the stage-1 decoder.';
const col = (i: number) => 12 + i * 152;
const wide: DLayout = {
  cls: 'fig-wide', w: 772, h: 250, desc,
  nodes: [
    { id: 'x', x: col(0), y: 34, w: 140, h: 50, label: t.x, sub: t.xs, tone: 'soft' },
    { id: 'e', x: col(1), y: 34, w: 140, h: 50, label: t.e, sub: t.es, tone: 'amber' },
    { id: 'g', x: col(2), y: 34, w: 140, h: 50, label: t.g, sub: t.gs, tone: 'soft' },
    { id: 'd', x: col(3), y: 34, w: 140, h: 50, label: t.d, sub: t.ds, tone: 'amber' },
    { id: 'xr', x: col(4), y: 34, w: 140, h: 50, label: t.xr, sub: t.xrs, tone: 'soft' },
    { id: 'p', x: col(0), y: 178, w: 140, h: 50, label: t.p, sub: t.ps, tone: 'soft' },
    { id: 'tt', x: col(1), y: 178, w: 140, h: 50, label: t.tt, sub: t.tts, tone: 'green' },
    { id: 'tr', x: col(2), y: 178, w: 140, h: 50, label: t.tr, sub: t.trs, tone: 'blue' },
    { id: 'it', x: col(3), y: 178, w: 140, h: 50, label: t.it, sub: t.its, tone: 'soft' },
  ],
  edges: [
    { from: 'x', to: 'e' }, { from: 'e', to: 'g' }, { from: 'g', to: 'd' }, { from: 'd', to: 'xr' },
    { from: 'p', to: 'tt' }, { from: 'tt', to: 'tr' }, { from: 'tr', to: 'it', tone: 'blue' },
    { from: 'g', to: 'tr', dashed: true, label: t.tgt, at: [col(2) + 76, 136], anchor: 'start' },
    { from: 'it', to: 'd', tone: 'blue', label: t.gen, at: [col(3) + 76, 136], anchor: 'start' },
  ],
  texts: [
    { x: 12, y: 22, text: t.s1, cls: 'f-small f-t-muted' },
    { x: 12, y: 166, text: t.s2, cls: 'f-small f-t-muted' },
  ],
};
const narrow: DLayout = {
  cls: 'fig-narrow', w: 360, h: 610, desc,
  nodes: [
    { id: 'x', x: 100, y: 30, w: 170, h: 44, label: t.x, sub: t.xs, tone: 'soft' },
    { id: 'e', x: 100, y: 90, w: 170, h: 44, label: t.e, sub: t.es, tone: 'amber' },
    { id: 'g', x: 100, y: 150, w: 170, h: 44, label: t.g, sub: t.gs, tone: 'soft' },
    { id: 'd', x: 100, y: 210, w: 170, h: 44, label: t.d, sub: t.ds, tone: 'amber' },
    { id: 'xr', x: 100, y: 270, w: 170, h: 44, label: t.xr, sub: t.xrs, tone: 'soft' },
    { id: 'p', x: 100, y: 370, w: 170, h: 44, label: t.p, sub: t.ps, tone: 'soft' },
    { id: 'tt', x: 100, y: 430, w: 170, h: 44, label: t.tt, sub: t.tts, tone: 'green' },
    { id: 'tr', x: 100, y: 490, w: 170, h: 44, label: t.tr, sub: t.trs, tone: 'blue' },
    { id: 'it', x: 100, y: 550, w: 170, h: 44, label: t.it, sub: t.its, tone: 'soft' },
  ],
  edges: [
    { from: 'x', to: 'e' }, { from: 'e', to: 'g' }, { from: 'g', to: 'd' }, { from: 'd', to: 'xr' },
    { from: 'p', to: 'tt' }, { from: 'tt', to: 'tr' }, { from: 'tr', to: 'it', tone: 'blue' },
    { from: 'g', to: 'tr', dashed: true, via: [[60, 172], [60, 512]], label: t.tgt, at: [54, 342], anchor: 'end' },
    { from: 'it', to: 'd', tone: 'blue', via: [[310, 572], [310, 232]], label: t.gen, at: [304, 346], anchor: 'end' },
  ],
  texts: [
    { x: 12, y: 20, text: t.s1, cls: 'f-small f-t-muted' },
    { x: 12, y: 358, text: t.s2, cls: 'f-small f-t-muted' },
  ],
};
---

<BlockDiagram
  id="autoregressive-transformers-two-stage"
  title={ru ? 'Два этапа: токенизатор изображений и трансформер над токенами' : 'Two stages: an image tokenizer and a transformer over its tokens'}
  svgTitle={ru ? 'Токенизатор и авторегрессионный трансформер' : 'Tokenizer and autoregressive transformer'}
  caption={ru
    ? 'Числа DALL·E. Сверху — первый этап: дискретный автоэнкодер сжимает изображение 256×256 в сетку 32×32, каждая клетка которой — индекс одного из 8192 кодов, то есть в 192 раза меньше значений, чем пикселей. Снизу — второй этап: подпись и токены изображения, развёрнутые построчно, образуют одну последовательность, и трансформер с причинной маской учится предсказывать каждый токен по предыдущим; сетка этапа 1 служит целями. При генерации трансформер вытягивает 1024 токена изображения по одному, и их переводит в пиксели декодер этапа 1. VQGAN использует сетку 16×16 из 1024 кодов, Parti — 32×32 из 8192 и трансформер «энкодер — декодер».'
    : 'The numbers of DALL·E. Top: stage 1. A discrete autoencoder compresses a 256×256 image into a 32×32 grid, each cell an index of one of 8192 codes: 192 times fewer values than pixels. Bottom: stage 2. The caption and the image tokens, unrolled row by row, form one sequence, and a transformer with a causal mask learns to predict each token from the ones before it; the stage-1 grid supplies the targets. At generation the transformer draws the 1024 image tokens one at a time, and the stage-1 decoder turns them into pixels. VQGAN uses a 16×16 grid of 1024 codes, Parti a 32×32 grid of 8192 codes and an encoder–decoder transformer.'}
  layouts={[wide, narrow]}
/>
