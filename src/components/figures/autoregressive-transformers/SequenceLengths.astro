---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Length of the sequence a transformer must model, and the pairs a causal attention layer compares, for one image.
const rows = [
  { en: 'pixels, 256×256×3', ru: 'пиксели, 256×256×3', n: 256 * 256 * 3, tone: 'red' },
  { en: 'pixels, 32×32×3', ru: 'пиксели, 32×32×3', n: 32 * 32 * 3, tone: 'amber' },
  { en: 'ImageGPT: 32×32, 512 colours', ru: 'ImageGPT: 32×32, 512 цветов', n: 32 * 32, tone: 'blue' },
  { en: 'DALL·E, Parti: 32×32 codes', ru: 'DALL·E, Parti: коды 32×32', n: 32 * 32, tone: 'blue' },
  { en: 'VQGAN: 16×16 codes', ru: 'VQGAN: коды 16×16', n: 16 * 16, tone: 'green' },
];
const pairs = (n: number) => (n * (n + 1)) / 2;
if (pairs(rows[0].n) !== 19327451136 || pairs(rows[3].n) !== 524800) throw new Error('SequenceLengths: numbers drifted from the note');
const fmt = (v: number) => (v >= 1e6 ? `${(v / 1e9 >= 1 ? (v / 1e9).toFixed(1) + (ru ? ' млрд' : ' bn') : (v / 1e6).toFixed(1) + (ru ? ' млн' : ' M'))}` : v.toLocaleString(ru ? 'ru-RU' : 'en-US').replace(/ /g, ' '));
const ratio = Math.round(pairs(rows[0].n) / pairs(rows[3].n) / 1000) * 1000;
if (ratio !== 37000) throw new Error('SequenceLengths: ratio drifted from the note');
const id = 'autoregressive-transformers-sequence-lengths';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 700, H: 250, labelW: 230, x0: 240, x1: 560, rowH: 38, top: 44 },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 400, labelW: 0, x0: 12, x1: 250, rowH: 70, top: 40 },
];
const lg = (v: number) => Math.log10(v);
---

<Figure
  id={id}
  title={ru ? 'Сколько токенов в одном изображении' : 'How many tokens one image takes'}
  caption={ru
    ? `Длина последовательности (полоса, логарифмическая шкала) и число пар, которые сравнивает один слой причинного внимания, n(n + 1)/2 (справа). Изображение 256×256 в пикселях — это ${fmt(rows[0].n)} значений и ${fmt(pairs(rows[0].n))} пар на слой; сетка кодов 32×32 — ${fmt(rows[3].n)} токена и ${fmt(pairs(rows[3].n))} пар, примерно в ${fmt(ratio)} раз меньше. ImageGPT сокращает последовательность иначе: уменьшает изображение до 32×32 и заменяет три канала пикселя одним из 512 цветов палитры.`
    : `Sequence length (bar, logarithmic scale) and the number of pairs one causal attention layer compares, n(n + 1)/2 (right). A 256×256 image in pixels is ${fmt(rows[0].n)} values and ${fmt(pairs(rows[0].n))} pairs per layer; a 32×32 grid of codes is ${fmt(rows[3].n)} tokens and ${fmt(pairs(rows[3].n))} pairs, about ${fmt(ratio)} times fewer. ImageGPT shortens the sequence differently: it downsamples the image to 32×32 and replaces the three channels of a pixel with one of 512 palette colours.`}
>
  {layouts.map((L) => {
    const sx = (v: number) => L.x0 + ((lg(v) - 2) / (6 - 2)) * (L.x1 - L.x0);
    const narrow = L.sfx === 'n';
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{ru ? 'Длина последовательности для разных токенизаций' : 'Sequence length for different tokenizations'}</title>
        <desc id={`${id}-${L.sfx}-d`}>{rows.map((r) => `${ru ? r.ru : r.en}: ${fmt(r.n)}`).join('; ')}.</desc>
        {[100, 1000, 10000, 100000, 1000000].map((v) => (
          <g>
            <path class="f-thin f-muted f-dash" d={`M ${sx(v)} ${L.top - 14} V ${L.top + rows.length * L.rowH - 10}`} />
            <text class="f-note" x={sx(v)} y={L.top - 20} text-anchor="middle">{v === 100 ? '10²' : v === 1000 ? '10³' : v === 10000 ? '10⁴' : v === 100000 ? '10⁵' : '10⁶'}</text>
          </g>
        ))}
        {rows.map((r, i) => {
          const y = L.top + i * L.rowH + (narrow ? 22 : 0);
          return (
            <g>
              <text class="f-small" x={narrow ? L.x0 : L.labelW} y={narrow ? y - 8 : y + 15} text-anchor={narrow ? 'start' : 'end'}>{ru ? r.ru : r.en}</text>
              <rect x={L.x0} y={y} width={sx(r.n) - L.x0} height="20" rx="3" style={`fill: var(--fig-${r.tone}); fill-opacity: 0.5`} />
              <text class="f-small" x={sx(r.n) + 6} y={y + 15}>{fmt(r.n)}</text>
              <text class="f-small f-t-muted" x={L.W - 8} y={y + 15} text-anchor="end">{fmt(pairs(r.n))}</text>
            </g>
          );
        })}
        <text class="f-small f-t-muted" x={L.W - 8} y={L.top - 20} text-anchor="end">{ru ? 'пар' : 'pairs'}</text>
      </svg>
    );
  })}
</Figure>
