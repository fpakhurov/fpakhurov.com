---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The length of a d-dimensional standard normal vector has the chi distribution with d degrees of freedom:
// f(r) = r^(d−1) e^(−r²/2) / (2^(d/2 − 1) Γ(d/2)). Its mean is close to √d and its spread stays near 0.7.
const ds = [2, 10, 100];
const logGammaHalfInt = (d: number) => { let s = 0; for (let k = 1; k < d / 2; k++) s += Math.log(k); return s; };
const chi = (d: number, r: number) => Math.exp((d - 1) * Math.log(r) - (r * r) / 2 - (d / 2 - 1) * Math.LN2 - logGammaHalfInt(d));
const rs = Array.from({ length: 241 }, (_, i) => 0.0001 + i * 0.05);
// The means integrate out to r = 20, past the plotted range, where the d = 100 curve still has 0.2% of its mass.
const grid = Array.from({ length: 401 }, (_, i) => 0.0001 + i * 0.05);
const mean = (d: number) => grid.reduce((s, r) => s + r * chi(d, r) * 0.05, 0);
const means = ds.map(mean);
if (means.map((m) => m.toFixed(2)).join() !== '1.25,3.08,9.98') throw new Error('GaussianShell: means drifted from the note');
const tones = ['blue', 'green', 'red'];
const id = 'gaussian-shell';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 260, x0: 30, x1: 580, y0: 30, y1: 210 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 260, x0: 16, x1: 344, y0: 40, y1: 210 },
];
---

<Figure
  id={id}
  title={ru ? 'Длина стандартного нормального вектора в d измерениях' : 'The length of a standard normal vector in d dimensions'}
  caption={ru
    ? `Плотность длины ‖Z‖ вектора Z ~ N(0, I) в размерности d = 2, 10, 100. Средние ${means.map((m) => m.toFixed(2)).join(', ')} близки к √d, а разброс около 0.7 почти не растёт: в высокой размерности почти вся вероятность лежит в тонкой оболочке радиуса √d, и центр, самая вероятная точка плотности, на практике не встречается.`
    : `The density of the length ‖Z‖ of Z ~ N(0, I) in dimension d = 2, 10, 100. The means ${means.map((m) => m.toFixed(2)).join(', ')} are close to √d, and the spread, about 0.7, barely grows: in high dimension almost all the probability lies in a thin shell of radius √d, and the centre, the point of highest density, practically never occurs.`}
>
  {layouts.map((L) => {
    const sx = scale([0, 12], [L.x0, L.x1]), sy = scale([0, 0.7], [L.y1, L.y0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Три плотности длины вектора' : 'Three densities of the vector length'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Три горба одинаковой ширины с центрами около 1.25, 3.08 и 9.98.' : 'Three bumps of similar width centred near 1.25, 3.08 and 9.98.'}</desc>
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {[0, 2, 4, 6, 8, 10, 12].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{v}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 42} text-anchor="middle">‖Z‖</text>
        {ds.map((d, i) => (
          <g>
            <path class={`f-line f-${tones[i]}`} d={polyline(rs.map((r) => [sx(r), sy(chi(d, r))]))} />
            <text class={`f-small f-t-${tones[i]}`} x={sx(means[i])} y={sy(0.66) - (i === 0 ? 0 : 0)} text-anchor="middle">{`d = ${d}`}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
