---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { mulberry32, normal } from '../random';
import { lambda, axes, ellipse, L as chol, S11, S12, S22 } from './gauss2';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// 600 draws of N(0, Σ) with Σ = [[2, 1.2], [1.2, 1]], made as L z from standard normal z. The ellipses of Mahalanobis
// distance 1 and 2 hold 1 − e^(−1/2) = 39.3% and 1 − e^(−2) = 86.5% of the probability in two dimensions.
if (lambda.map((v) => v.toFixed(2)).join() !== '2.80,0.20') throw new Error('CovarianceEllipses: eigenvalues drifted from the note');
const u = mulberry32(6), z = normal(u);
const pts = Array.from({ length: 600 }, () => { const a = z(), b = z(); return [chol[0][0] * a, chol[1][0] * a + chol[1][1] * b] as [number, number]; });
const det = S11 * S22 - S12 * S12;
const maha = ([x, y]: [number, number]) => (S22 * x * x - 2 * S12 * x * y + S11 * y * y) / det;
const share = [1, 4].map((k) => pts.filter((p) => maha(p) <= k).length / pts.length);
if (Math.abs(share[0] - 0.393) > 0.01 || Math.abs(share[1] - 0.865) > 0.01) throw new Error('CovarianceEllipses: sample shares drifted');
const id = 'covariance-ellipses';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 380, x0: 40, x1: 580, y0: 20, y1: 340 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 300, x0: 10, x1: 350, y0: 16, y1: 270 },
];
const sd = lambda.map(Math.sqrt);
const spanOf = (Lo: (typeof layouts)[number]) => 4.6 * ((Lo.x1 - Lo.x0) / (Lo.y1 - Lo.y0));
const visible = (Lo: (typeof layouts)[number]) => pts.filter(([x, y]) => Math.abs(x) <= spanOf(Lo) / 2 - 0.05 && Math.abs(y) <= 2.25);
---

<Figure
  id={id}
  title={ru ? 'Ковариационная матрица как эллипс' : 'A covariance matrix as an ellipse'}
  caption={ru
    ? `600 точек из N(0, Σ), Σ = [[2, 1.2], [1.2, 1]], корреляция 0.85. Собственные векторы Σ задают оси эллипсов, корни собственных значений — их полуоси: √2.8 ≈ ${sd[0].toFixed(2)} вдоль длинной оси и √0.2 ≈ ${sd[1].toFixed(2)} вдоль короткой. Внутренний эллипс (расстояние Махаланобиса 1) содержит ${(share[0] * 100).toFixed(0)}% точек при теоретических 39.3%, внешний (расстояние 2) — ${(share[1] * 100).toFixed(0)}% при 86.5%: в двух измерениях «одна сигма» охватывает не 68%.`
    : `600 points from N(0, Σ), Σ = [[2, 1.2], [1.2, 1]], correlation 0.85. The eigenvectors of Σ give the axes of the ellipses and the square roots of the eigenvalues their half-lengths: √2.8 ≈ ${sd[0].toFixed(2)} along the long axis and √0.2 ≈ ${sd[1].toFixed(2)} along the short one. The inner ellipse (Mahalanobis distance 1) holds ${(share[0] * 100).toFixed(0)}% of the points against 39.3% in theory, the outer one (distance 2) ${(share[1] * 100).toFixed(0)}% against 86.5%: in two dimensions "one sigma" does not cover 68%.`}
>
  {layouts.map((Lo) => {
    const span = spanOf(Lo);
    const sx = scale([-span / 2, span / 2], [Lo.x0, Lo.x1]), sy = scale([-2.3, 2.3], [Lo.y1, Lo.y0]);
    const P = (q: [number, number][]) => polyline(q.map(([x, y]) => [sx(x), sy(y)]));
    const tip = (k: number) => [axes[k][0] * sd[k], axes[k][1] * sd[k]] as [number, number];
    return (
      <svg class={Lo.cls} viewBox={`0 0 ${Lo.W} ${Lo.H}`} role="img" aria-labelledby={`${id}-${Lo.W}-t ${id}-${Lo.W}-d`}>
        <title id={`${id}-${Lo.W}-t`}>{ru ? 'Облако точек, два эллипса и главные оси' : 'A point cloud, two ellipses and the principal axes'}</title>
        <desc id={`${id}-${Lo.W}-d`}>{ru ? 'Вытянутое облако точек вдоль диагонали; эллипсы расстояния 1 и 2; стрелки главных осей длиной 1.67 и 0.45.' : 'An elongated cloud along the diagonal; ellipses of distance 1 and 2; principal-axis arrows of length 1.67 and 0.45.'}</desc>
        <path class="f-grid" d={`M ${sx(-span / 2)} ${sy(0)} H ${sx(span / 2)} M ${sx(0)} ${sy(-2.3)} V ${sy(2.3)}`} />
        {visible(Lo).map(([x, y]) => <circle cx={sx(x).toFixed(1)} cy={sy(y).toFixed(1)} r="1.7" style="fill: var(--fig-blue); fill-opacity: .4" />)}
        <path class="f-line f-amber" d={P(ellipse(1))} />
        <path class="f-line f-amber f-dash" d={P(ellipse(2))} />
        <path class="f-line f-red" d={`M ${sx(0)} ${sy(0)} L ${sx(tip(0)[0])} ${sy(tip(0)[1])}`} marker-end="url(#f-arrow-red)" />
        <path class="f-line f-red" d={`M ${sx(0)} ${sy(0)} L ${sx(tip(1)[0])} ${sy(tip(1)[1])}`} marker-end="url(#f-arrow-red)" />
        <text class="f-small f-t-red f-halo" x={sx(tip(0)[0]) + 8} y={sy(tip(0)[1]) - 4}>{`√2.8`}</text>
        <text class="f-small f-t-red f-halo" x={sx(tip(1)[0]) - 8} y={sy(tip(1)[1]) - 6} text-anchor="end">{`√0.2`}</text>
        <text class="f-small f-t-amber f-halo" x={sx(ellipse(1)[105][0]) + 6} y={sy(ellipse(1)[105][1]) + 14}>39%</text>
        <text class="f-small f-t-amber f-halo" x={sx(ellipse(2)[105][0]) + 6} y={sy(ellipse(2)[105][1]) + 14}>86%</text>
      </svg>
    );
  })}
</Figure>
