---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale, polyline } from '../geometry';
import { phi } from '../normal';
import { ellipse, S11, S12, S22 } from './gauss2';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Conditioning the same Gaussian on X1 = 2: the conditional mean lies on the regression line x2 = (Σ12/Σ11) x1
// and the conditional variance is Σ22 − Σ12²/Σ11, the same for every x1.
const slope = S12 / S11, cvar = S22 - (S12 * S12) / S11, a = 2, cmean = slope * a, csd = Math.sqrt(cvar);
if ([slope, cvar, cmean].map((v) => v.toFixed(2)).join() !== '0.60,0.28,1.20') throw new Error('GaussianConditioning: numbers drifted from the note');
const t = ru
  ? { line: 'E[X₂ | X₁] = 0.6 X₁', cond: `N(${cmean.toFixed(1)}, ${cvar.toFixed(2)})`, marg: 'N(0, 1)', x1: 'X₁ = 2',
      steps: ['совместное распределение: эллипсы расстояния 1 и 2', 'условное среднее X₂ при данном X₁ лежит на прямой 0.6 X₁', 'срез при X₁ = 2: X₂ ~ N(1.2, 0.28), уже маргинального N(0, 1)'] }
  : { line: 'E[X₂ | X₁] = 0.6 X₁', cond: `N(${cmean.toFixed(1)}, ${cvar.toFixed(2)})`, marg: 'N(0, 1)', x1: 'X₁ = 2',
      steps: ['the joint distribution: ellipses of distance 1 and 2', 'the conditional mean of X₂ given X₁ lies on the line 0.6 X₁', 'the slice at X₁ = 2: X₂ ~ N(1.2, 0.28), narrower than the marginal N(0, 1)'] };
const id = 'gaussian-conditioning';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 620, H: 360, x0: 30, x1: 470, y0: 20, y1: 340, mx: 520 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 330, x0: 8, x1: 262, y0: 16, y1: 314, mx: 300 },
];
const ys = Array.from({ length: 81 }, (_, i) => -3 + i * 0.075);
---

<Figure
  id={id}
  title={ru ? 'Условное распределение гауссовского вектора' : 'Conditioning a Gaussian vector'}
  caption={ru
    ? `То же распределение N(0, Σ), Σ = [[2, 1.2], [1.2, 1]] (1). При известном X₁ = x₁ величина X₂ снова нормальна; её среднее Σ₁₂/Σ₁₁ · x₁ = 0.6 x₁ лежит на прямой регрессии (2), а дисперсия Σ₂₂ − Σ₁₂²/Σ₁₁ = 0.28 не зависит от x₁. Срез при X₁ = 2 даёт N(1.2, 0.28) (3); справа для сравнения маргинальное распределение X₂, N(0, 1): знание X₁ сдвигает центр и сужает разброс.`
    : `The same distribution N(0, Σ), Σ = [[2, 1.2], [1.2, 1]] (1). Given X₁ = x₁, X₂ is again normal; its mean Σ₁₂/Σ₁₁ · x₁ = 0.6 x₁ lies on the regression line (2), and its variance Σ₂₂ − Σ₁₂²/Σ₁₁ = 0.28 does not depend on x₁. The slice at X₁ = 2 gives N(1.2, 0.28) (3); on the right, for comparison, the marginal distribution of X₂, N(0, 1): knowing X₁ moves the centre and narrows the spread.`}
>
  {layouts.map((L) => {
    const sx = scale([-4, 4], [L.x0, L.x1]), sy = scale([-3, 3], [L.y1, L.y0]);
    const P = (q: [number, number][]) => polyline(q.map(([x, y]) => [sx(x), sy(y)]));
    const bell = (cx: number, m: number, s: number, w: number) => polyline(ys.map((y) => [cx + (w * phi((y - m) / s)) / phi(0), sy(y)]));
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Эллипсы, прямая регрессии и срез' : 'Ellipses, the regression line and a slice'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Наклонные эллипсы гауссовского распределения, прямая x₂ = 0.6 x₁ и вертикальный срез при x₁ = 2 с узкой нормальной плотностью вокруг 1.2; справа широкая маргинальная плотность X₂.' : 'Tilted ellipses of the Gaussian, the line x₂ = 0.6 x₁ and a vertical slice at x₁ = 2 with a narrow normal density around 1.2; on the right the wide marginal density of X₂.'}</desc>
        <path class="f-grid" d={`M ${sx(-4)} ${sy(0)} H ${sx(4)} M ${sx(0)} ${sy(-3)} V ${sy(3)}`} />
        <g data-s="1">
          <path class="f-line f-blue" d={P(ellipse(1))} />
          <path class="f-line f-blue f-dash" d={P(ellipse(2))} />
          <Badge x={sx(-3.6)} y={sy(2.6)} n={1} />
        </g>
        <g data-s="2">
          <path class="f-line f-amber" d={`M ${sx(-4)} ${sy(-4 * slope)} L ${sx(4)} ${sy(4 * slope)}`} />
          <text class="f-small f-t-amber f-halo" x={sx(-3.8)} y={sy(-4 * slope) - 10}>{t.line}</text>
          <Badge x={sx(3.6)} y={sy(4 * slope) + 18} n={2} />
        </g>
        <g data-s="3">
          <path class="f-thin f-red f-dash" d={`M ${sx(a)} ${sy(-3)} V ${sy(3)}`} />
          <path class="f-line f-red" d={bell(sx(a), cmean, csd, (L.x1 - L.x0) * 0.16)} />
          <circle cx={sx(a)} cy={sy(cmean)} r="4" class="f-solid-red" />
          <text class="f-small f-t-red f-halo" x={sx(a) + 6} y={sy(cmean - 1.15)}>{t.cond}</text>
          <text class="f-note f-halo" x={sx(a) - 6} y={sy(-2.75)} text-anchor="end">{t.x1}</text>
          <path class="f-axis" d={`M ${L.mx} ${sy(-3)} V ${sy(3)}`} />
          <path class="f-line" d={bell(L.mx, 0, 1, (L.W - L.mx) * 0.7)} />
          <text class="f-note" x={L.mx + 4} y={sy(2.85)}>{t.marg}</text>
          <Badge x={sx(a) + 14} y={sy(2.6)} n={3} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
