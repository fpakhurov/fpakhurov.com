---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';
import { Phi } from '../normal';
import { pageLang } from '../../../utils/lang';
import { EPS, START_VAR, fixedPoint, longRun, varBuffer, varShort } from './cdToy';

const ru = pageLang(Astro.url) === 'ru';

// Panel A: the model variance v* at which contrastive divergence stops, against the number K of Langevin steps per
// update, for chains restarted from noise and for a replay buffer. Panel B: the densities at K = 10.
const vS = (K: number) => fixedPoint(varShort, K);
const vB = (K: number) => fixedPoint(varBuffer, K);
const s10 = vS(10), b10 = vB(10);
const checks: [string, string][] = [
  [s10.toFixed(3), '0.088'], [Math.sqrt(s10).toFixed(2), '0.30'], [b10.toFixed(2), '0.52'],
  [vS(100).toFixed(2), '0.58'], [vB(100).toFixed(2), '0.94'],
  [vS(1000).toFixed(3), '0.997'], [vB(1000).toFixed(3), '0.997'], [longRun.toFixed(4), '0.9975'],
];
for (const [got, want] of checks) if (got !== want) throw new Error(`ShortRunBias: computed ${got}, the note says ${want}`);

// Distribution of the 10-step chain under the fresh-noise model: a^10 · U(−3, 3) plus Gaussian noise of variance c(1 − a^20).
const a = 1 - EPS / (2 * s10);
const halfW = Math.sqrt(3 * START_VAR) * a ** 10;
const noiseSd = Math.sqrt((EPS / (1 - a * a)) * (1 - a ** 20));
const sampleVar = halfW * halfW / 3 + noiseSd * noiseSd;
if (Math.abs(sampleVar - 1) > 1e-9) throw new Error('ShortRunBias: the 10-step samples should have variance 1');
const gauss = (v: number) => (x: number) => Math.exp(-x * x / (2 * v)) / Math.sqrt(2 * Math.PI * v);
const samples = (x: number) => (Phi((x + halfW) / noiseSd) - Phi((x - halfW) / noiseSd)) / (2 * halfW);

const f2 = (v: number) => v.toFixed(2), f3 = (v: number) => v.toFixed(3);
const t = ru
  ? {
      aTitle: 'где останавливается CD', bTitle: 'плотности при K = 10', kAxis: 'шагов Ланжевена на обновление, K', vAxis: 'дисперсия модели v*',
      dens: 'плотность', dataVar: 'дисперсия данных', fresh: 'свежий шум', buffer: 'буфер 95% / 5%',
      legend: ['данные N(0, 1)', 'модель, шум', 'её сэмплы, K = 10', 'модель, буфер'],
    }
  : {
      aTitle: 'where CD stops', bTitle: 'densities at K = 10', kAxis: 'Langevin steps per update, K', vAxis: 'model variance v*',
      dens: 'density', dataVar: 'data variance', fresh: 'fresh noise', buffer: 'buffer 95% / 5%',
      legend: ['data N(0, 1)', 'model, fresh noise', 'its 10-step samples', 'model, buffer'],
    };

const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 312, A: { L: 70, R: 344, T: 44, B: 236 }, Bp: { L: 436, R: 748, T: 44, B: 236 }, legendRows: 2 },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 640, A: { L: 56, R: 340, T: 44, B: 222 }, Bp: { L: 56, R: 340, T: 330, B: 508 }, legendRows: 4 },
].map((L) => {
  const ax = scale([0, 3], [L.A.L, L.A.R]), ay = scale([0, 1.1], [L.A.B, L.A.T]);
  const bx = scale([-3.5, 3.5], [L.Bp.L, L.Bp.R]), by = scale([0, 1.45], [L.Bp.B, L.Bp.T]);
  const curveA = (f: (K: number) => number) => plot((u) => f(10 ** u), 0, 3, ax, ay, 150);
  const curves = [
    { d: plot(gauss(1), -3.5, 3.5, bx, by, 300), cls: 'f-line f-bold' },
    { d: plot(gauss(s10), -3.5, 3.5, bx, by, 600), cls: 'f-line f-red' },
    { d: plot(samples, -3.5, 3.5, bx, by, 300), cls: 'f-line f-red f-dash' },
    { d: plot(gauss(b10), -3.5, 3.5, bx, by, 300), cls: 'f-line f-blue' },
  ];
  // Wide: two columns of two entries under panel B; narrow: one column of four.
  const legend = t.legend.map((label, i) => {
    const twoCols = L.legendRows === 2;
    const x = twoCols ? L.Bp.L + (i % 2) * 168 : L.Bp.L;
    const y = L.Bp.B + 46 + (twoCols ? Math.floor(i / 2) : i) * 20;
    return { label, x, y, cls: curves[i].cls };
  });
  return {
    ...L,
    red: curveA(vS), blue: curveA(vB),
    kTicks: [0, 1, 2, 3].map((u) => ({ x: ax(u), label: String(10 ** u) })),
    vTicks: [0, 0.5, 1].map((v) => ({ y: ay(v), label: String(v) })),
    dataY: ay(1),
    dot10: { x: ax(1), ys: ay(s10), yb: ay(b10) },
    freshAt: { x: ax(1.75), y: ay(0.25) },
    bufferAt: { x: L.A.L + 8, y: ay(0.8) },
    xTicksB: [-2, 0, 2].map((x) => ({ x: bx(x), label: String(x) })),
    yTicksB: [0, 0.5, 1].map((v) => ({ y: by(v), label: String(v) })),
    curves, legend,
  };
});
const id = 'energy-based-models-short-run-bias';
const caption = ru
  ? `Игрушечная модель: данные N(0, 1), энергия E_v(x) = x²/(2v), так что модель — N(0, v). Негативные примеры дают K шагов Ланжевена x ← x − (ε/2)·x/v + √ε·z с ε = ${EPS}, начатые из U(−3, 3). Градиент CD по v пропорционален разности средних x² на данных и на сэмплах, поэтому обучение останавливается там, где дисперсия сэмплов равна 1, а не там, где v = 1. (A) Это значение v* при перезапуске цепочек из шума (красная) и с буфером, где старт — свежий шум с вероятностью 0.05 и продолжение старой цепочки иначе (синяя). При K = 10 модель с перезапуском сжимается до v* = ${f3(s10)} (стандартное отклонение ${f2(Math.sqrt(s10))} вместо 1), буфер даёт ${f2(b10)}; при K = 100 — ${f2(vS(100))} и ${f2(vB(100))}; при K = 1000 обе кривые достигают ${f3(vS(1000))}, почти предельного значения ${longRun.toFixed(4)} для нескорректированной динамики Ланжевена с этим шагом. (B) При K = 10: данные (толстая линия), выученная плотность N(0, ${f3(s10)}) (красная), распределение её 10-шаговых сэмплов (красный пунктир, дисперсия 1) и модель с буфером N(0, ${f2(b10)}) (синяя). Сэмплы похожи на данные, плотность модели — нет.`
  : `A toy model: data N(0, 1), energy E_v(x) = x²/(2v), so the model is N(0, v). Negative samples come from K Langevin steps x ← x − (ε/2)·x/v + √ε·z with ε = ${EPS}, started from U(−3, 3). The CD gradient in v is proportional to the difference between the mean of x² on the data and on the samples, so training stops where the samples have variance 1, not where v = 1. (A) That stopping point v* for chains restarted from noise (red) and for a replay buffer in which a start is fresh noise with probability 0.05 and continues an earlier chain otherwise (blue). At K = 10 the restarted model shrinks to v* = ${f3(s10)} (standard deviation ${f2(Math.sqrt(s10))} instead of 1) and the buffer gives ${f2(b10)}; at K = 100, ${f2(vS(100))} and ${f2(vB(100))}; at K = 1000 both reach ${f3(vS(1000))}, essentially the long-run value ${longRun.toFixed(4)} of unadjusted Langevin with this step. (B) At K = 10: the data (thick line), the learned density N(0, ${f3(s10)}) (red), the distribution of its 10-step samples (red dashed, variance 1) and the buffer model N(0, ${f2(b10)}) (blue). The samples look like the data; the model's density does not.`;
---

<Figure id={id} title={ru ? 'Короткие цепочки учат неправильную плотность' : 'Short chains learn the wrong density'} caption={caption}>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{ru ? 'Точка остановки CD в зависимости от длины цепочки' : 'Where CD stops as a function of chain length'}</title>
      <desc id={`${id}-${L.sfx}-d`}>{ru
        ? `Панель A: по горизонтали K от 1 до 1000 в логарифмическом масштабе, по вертикали дисперсия модели. Красная кривая (перезапуск из шума) растёт от ${f3(vS(1))} при K = 1 до ${f3(s10)} при K = 10 и ${f2(vS(100))} при K = 100 и подходит к единице к K = 1000; синяя кривая (буфер) идёт выше: ${f2(b10)} при K = 10. Пунктир — дисперсия данных 1. Панель B: узкий красный пик выученной плотности, широкая толстая кривая данных, плоский красный пунктир 10-шаговых сэмплов и синяя кривая модели с буфером.`
        : `Panel A: K from 1 to 1000 on a log axis against the model variance. The red curve (restarted from noise) rises from ${f3(vS(1))} at K = 1 to ${f3(s10)} at K = 10 and ${f2(vS(100))} at K = 100 and approaches 1 by K = 1000; the blue curve (buffer) lies above it, ${f2(b10)} at K = 10. A dashed line marks the data variance 1. Panel B: a narrow red peak for the learned density, the wide thick data curve, a flat-topped red dashed curve for the 10-step samples and a blue curve for the buffer model.`}</desc>

      <text class="f-label" x={L.A.L} y={L.A.T - 20}>A · {t.aTitle}</text>
      {L.vTicks.map((tk) => (
        <g>
          <path class="f-grid" d={`M ${L.A.L} ${tk.y} H ${L.A.R}`} />
          <text class="f-note" x={L.A.L - 8} y={tk.y + 4} text-anchor="end">{tk.label}</text>
        </g>
      ))}
      <path class="f-axis" d={`M ${L.A.L} ${L.A.B} H ${L.A.R}`} />
      {L.kTicks.map((tk) => <text class="f-note" x={tk.x} y={L.A.B + 18} text-anchor="middle">{tk.label}</text>)}
      <text class="f-small f-t-muted" x={(L.A.L + L.A.R) / 2} y={L.A.B + 38} text-anchor="middle">{t.kAxis}</text>
      <text class="f-small f-t-muted" transform={`rotate(-90 ${L.A.L - 40} ${(L.A.T + L.A.B) / 2})`} x={L.A.L - 40} y={(L.A.T + L.A.B) / 2} text-anchor="middle">{t.vAxis}</text>
      <path class="f-line f-muted f-dash" d={`M ${L.A.L} ${L.dataY} H ${L.A.R}`} />
      <text class="f-small f-t-muted" x={L.A.R} y={L.dataY - 6} text-anchor="end">{t.dataVar}</text>
      <path class="f-line f-red" d={L.red} />
      <path class="f-line f-blue" d={L.blue} />
      <circle cx={L.dot10.x} cy={L.dot10.ys} r="3.5" class="f-solid-red" />
      <circle cx={L.dot10.x} cy={L.dot10.yb} r="3.5" class="f-solid-blue" />
      <text class="f-small f-t-red" x={L.dot10.x - 7} y={L.dot10.ys - 6} text-anchor="end">{f3(s10)}</text>
      <text class="f-small f-t-blue" x={L.dot10.x - 7} y={L.dot10.yb - 6} text-anchor="end">{f2(b10)}</text>
      <text class="f-small f-t-red" x={L.freshAt.x} y={L.freshAt.y}>{t.fresh}</text>
      <text class="f-small f-t-blue" x={L.bufferAt.x} y={L.bufferAt.y}>{t.buffer}</text>

      <text class="f-label" x={L.Bp.L} y={L.Bp.T - 20}>B · {t.bTitle}</text>
      {L.yTicksB.map((tk) => (
        <g>
          <path class="f-grid" d={`M ${L.Bp.L} ${tk.y} H ${L.Bp.R}`} />
          <text class="f-note" x={L.Bp.L - 8} y={tk.y + 4} text-anchor="end">{tk.label}</text>
        </g>
      ))}
      <path class="f-axis" d={`M ${L.Bp.L} ${L.Bp.B} H ${L.Bp.R}`} />
      {L.xTicksB.map((tk) => <text class="f-note" x={tk.x} y={L.Bp.B + 18} text-anchor="middle">{tk.label}</text>)}
      <text class="f-small f-t-muted" transform={`rotate(-90 ${L.Bp.L - 40} ${(L.Bp.T + L.Bp.B) / 2})`} x={L.Bp.L - 40} y={(L.Bp.T + L.Bp.B) / 2} text-anchor="middle">{t.dens}</text>
      {L.curves.map((c) => <path class={c.cls} d={c.d} />)}
      {L.legend.map((g) => (
        <g>
          <path class={g.cls} d={`M ${g.x} ${g.y - 4} H ${g.x + 22}`} />
          <text class="f-small" x={g.x + 28} y={g.y}>{g.label}</text>
        </g>
      ))}
    </svg>
  ))}
</Figure>
