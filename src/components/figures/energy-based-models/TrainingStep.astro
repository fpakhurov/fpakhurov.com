---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One training step of an EBM with a replay buffer, in the colours of the sequence-model figures:
// data and fresh noise green, chain states blue, the energy network and its update amber, samples red.
const cfg = { batch: 128, buffer: 8192, fresh: 0.05, steps: 60, step: 10, clip: 0.03, noise: 0.005, alpha: 0.1 };
const pct = (p: number) => `${Math.round(p * 100)}%`;
const t = ru
  ? {
      buffer: 'буфер B', bufferSub: `${cfg.buffer} прошлых сэмпла`, noise: 'U(−1, 1)', noiseSub: 'свежий шум', starts: `${cfg.batch} стартов`,
      lang: 'Ланжевен', langSub: `${cfg.steps} шагов`, samples: 'сэмплы', data: `данные, ${cfg.batch}`, dataWide: `батч данных, ${cfg.batch}`,
      grad: '∇ₓE_θ, θ фиксированы', pos: 'позитивная фаза', neg: 'негативная фаза', energies: 'E(x⁺), E(x⁻)',
      lossWide: 'E(x⁺) − E(x⁻) + α(E(x⁺)² + E(x⁻)²), средние по батчу', lossNarrow: 'E(x⁺) − E(x⁻) + α(E(x⁺)² + E(x⁻)²)',
      adam: 'Adam, β₁ = 0', adamShort: 'Adam', back: 'записать обратно, старые удалить', backShort: 'обратно',
      steps: [
        `Старты: каждая из ${cfg.batch} цепочек с вероятностью ${1 - cfg.fresh} продолжает сэмпл из буфера, с вероятностью ${cfg.fresh} начинается с равномерного шума`,
        `${cfg.steps} шагов Ланжевена спускаются по E_θ при фиксированных θ: x ← x − ${cfg.step}·clip(∇ₓE_θ, ±${cfg.clip}) плюс шум со стандартным отклонением ${cfg.noise}`,
        'E_θ оценивает батч данных x⁺ (позитивная фаза) и сэмплы x⁻ (негативная фаза)',
        `Функция потерь: разрыв энергий плюс α = ${cfg.alpha}, умноженное на средние квадраты энергий; один шаг Adam по θ с β₁ = 0`,
        `Сэмплы записываются обратно в буфер; сверх ${cfg.buffer} самые старые выбрасываются`,
      ],
    }
  : {
      buffer: 'buffer B', bufferSub: `${cfg.buffer} past samples`, noise: 'U(−1, 1)', noiseSub: 'fresh noise', starts: `${cfg.batch} starts`,
      lang: 'Langevin', langSub: `${cfg.steps} steps`, samples: 'samples', data: `data, ${cfg.batch}`, dataWide: `data batch, ${cfg.batch}`,
      grad: '∇ₓE_θ, θ fixed', pos: 'positive phase', neg: 'negative phase', energies: 'E(x⁺), E(x⁻)',
      lossWide: 'mean E(x⁺) − mean E(x⁻) + α · mean(E(x⁺)² + E(x⁻)²)', lossNarrow: 'E(x⁺) − E(x⁻) + α(E(x⁺)² + E(x⁻)²)',
      adam: 'Adam, β₁ = 0', adamShort: 'Adam', back: 'write back, drop the oldest', backShort: 'write back',
      steps: [
        `Starts: each of the ${cfg.batch} chains continues a buffer sample with probability ${1 - cfg.fresh} or starts from uniform noise with probability ${cfg.fresh}`,
        `${cfg.steps} Langevin steps descend E_θ with θ held fixed: x ← x − ${cfg.step}·clip(∇ₓE_θ, ±${cfg.clip}), plus noise of standard deviation ${cfg.noise}`,
        'E_θ scores a data batch x⁺ (positive phase) and the samples x⁻ (negative phase)',
        `Loss: the energy gap plus α = ${cfg.alpha} times the mean squared energies; one Adam step on θ with β₁ = 0`,
        `The samples are written back to the buffer; beyond ${cfg.buffer} the oldest are dropped`,
      ],
    };
const id = 'energy-based-models-training-step';
const caption = ru
  ? `Один шаг обучения с буфером воспроизведения: цепочки начинаются из буфера или со свежего шума (1), делают ${cfg.steps} шагов Ланжевена при фиксированном θ (2), сеть вычисляет энергии данных и сэмплов (3), функция потерь обновляет θ (4), и сэмплы возвращаются в буфер (5). Входы — зелёные, состояния цепочек — синие, сеть — жёлтая, сэмплы — красные.`
  : `One training step with a replay buffer: chains start from the buffer or fresh noise (1), take ${cfg.steps} Langevin steps with θ fixed (2), the network scores data and samples (3), the loss updates θ (4), and the samples return to the buffer (5). Inputs are green, chain states blue, the network amber, samples red.`;
const desc = ru
  ? 'Буфер B и равномерный шум сходятся в 128 стартов x⁰ (95% и 5%); блок из 60 шагов Ланжевена превращает их в сэмплы x⁻, используя градиент сети E_θ. Сеть E_θ получает батч данных x⁺ и сэмплы x⁻; её выходы идут в потерю, от потери шаг Adam возвращается к E_θ. Пунктир от x⁻ ведёт обратно в буфер.'
  : 'The buffer B and uniform noise merge into 128 starts x⁰ (95% and 5%); a Langevin block of 60 steps turns them into samples x⁻ using the gradient of the network E_θ. The network E_θ receives the data batch x⁺ and the samples x⁻; its outputs go into the loss, and an Adam step goes from the loss back to E_θ. A dashed path leads from x⁻ back to the buffer.';
---

<Figure id={id} title={ru ? 'Шаг обучения EBM: буфер, цепочки Ланжевена, две фазы' : 'One EBM training step: buffer, Langevin chains, two phases'} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 340" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{ru ? 'Шаг обучения энергетической модели' : 'A training step of an energy-based model'}</title>
    <desc id={`${id}-w-d`}>{desc}</desc>
    <g data-s="1">
      <Box x={16} y={36} w={140} h={46} label={t.buffer} sub={t.bufferSub} tone="h" />
      <Box x={16} y={100} w={140} h={46} label={t.noise} sub={t.noiseSub} tone="x" />
      <Arrow pts={[[156, 59], [204, 78]]} tone="blue" label={pct(1 - cfg.fresh)} at={[176, 58]} anchor="middle" labelTone="h" />
      <Arrow pts={[[156, 123], [204, 94]]} tone="green" label={pct(cfg.fresh)} at={[174, 132]} anchor="middle" labelTone="x" />
      <Box x={206} y={62} w={100} h={46} label="x⁰" sub={t.starts} tone="h" />
    </g>
    <g data-s="2">
      <Arrow pts={[[306, 85], [343, 85]]} tone="blue" />
      <Box x={345} y={62} w={110} h={46} label={t.lang} sub={t.langSub} />
      <Arrow pts={[[455, 85], [488, 85]]} tone="red" />
      <Box x={490} y={62} w={100} h={46} label="x⁻" sub={t.samples} tone="y" />
      <Arrow pts={[[400, 196], [400, 110]]} tone="amber" dashed label={t.grad} at={[392, 156]} anchor="end" />
    </g>
    <g data-s="2 3 4">
      <Box x={345} y={196} w={110} h={48} label="E_θ" sub="CNN" tone="g" subGap={17} />
    </g>
    <g data-s="3">
      <Box x={16} y={196} w={140} h={46} label="x⁺" sub={t.dataWide} tone="x" />
      <Arrow pts={[[156, 219], [343, 219]]} tone="green" label={t.pos} at={[250, 210]} anchor="middle" labelTone="x" />
      <Arrow pts={[[540, 108], [540, 160], [440, 160], [440, 194]]} tone="red" label={t.neg} at={[548, 140]} labelTone="y" />
    </g>
    <g data-s="4">
      <Arrow pts={[[400, 244], [400, 272]]} label={t.energies} at={[408, 263]} labelTone="g" />
      <Box x={190} y={274} w={420} h={50} label="L(θ)" sub={t.lossWide} />
      <Arrow pts={[[610, 299], [650, 299], [650, 219], [457, 219]]} tone="amber" label={t.adam} at={[658, 262]} />
    </g>
    <g data-s="5">
      <Arrow pts={[[540, 62], [540, 20], [86, 20], [86, 34]]} tone="blue" dashed label={t.back} at={[313, 14]} anchor="middle" labelTone="h" />
    </g>
    <Badge x={188} y={33} n={1} />
    <Badge x={472} y={64} n={2} />
    <Badge x={176} y={240} n={3} />
    <Badge x={176} y={299} n={4} />
    <Badge x={558} y={40} n={5} />
  </svg>

  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 404" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{ru ? 'Шаг обучения энергетической модели' : 'A training step of an energy-based model'}</title>
    <desc id={`${id}-n-d`}>{desc}</desc>
    <g data-s="1">
      <Box x={8} y={30} w={160} h={48} label={t.buffer} sub={t.bufferSub} tone="h" subGap={19} />
      <Box x={184} y={30} w={160} h={48} label={t.noise} sub={t.noiseSub} tone="x" subGap={19} />
      <Arrow pts={[[88, 78], [110, 114]]} tone="blue" label={pct(1 - cfg.fresh)} at={[93, 106]} anchor="end" labelTone="h" />
      <Arrow pts={[[264, 78], [172, 114]]} tone="green" label={pct(cfg.fresh)} at={[212, 98]} labelTone="x" />
      <Box x={60} y={116} w={140} h={48} label="x⁰" sub={t.starts} tone="h" subGap={19} />
    </g>
    <g data-s="2">
      <Arrow pts={[[130, 164], [130, 178]]} tone="blue" />
      <Box x={70} y={180} w={120} h={48} label={t.lang} sub={t.langSub} subGap={19} />
      <Arrow pts={[[130, 228], [130, 240]]} tone="red" />
      <Box x={60} y={242} w={140} h={48} label="x⁻" sub={t.samples} tone="y" subGap={19} />
      <Arrow pts={[[236, 252], [192, 214]]} tone="amber" dashed />
    </g>
    <g data-s="2 3 4">
      <Box x={236} y={242} w={108} h={48} label="E_θ" sub="CNN" tone="g" subGap={19} />
    </g>
    <g data-s="3">
      <Box x={236} y={116} w={108} h={48} label="x⁺" sub={t.data} tone="x" subGap={19} />
      <Arrow pts={[[290, 164], [290, 240]]} tone="green" />
      <Arrow pts={[[200, 266], [234, 266]]} tone="red" />
    </g>
    <g data-s="4">
      <Arrow pts={[[262, 290], [262, 334]]} label={t.energies} at={[254, 318]} anchor="end" labelTone="g" />
      <Box x={8} y={336} w={344} h={52} label="L(θ)" sub={t.lossNarrow} subGap={19} />
      <Arrow pts={[[326, 336], [326, 292]]} tone="amber" label={t.adamShort} at={[320, 318]} anchor="end" />
    </g>
    <g data-s="5">
      <Arrow pts={[[60, 266], [24, 266], [24, 80]]} tone="blue" dashed />
      <text class="f-small f-t-blue" transform="rotate(-90 16 173)" x={16} y={173} text-anchor="middle">{t.backShort}</text>
    </g>
    <Badge x={44} y={140} n={1} />
    <Badge x={210} y={186} n={2} />
    <Badge x={310} y={202} n={3} />
    <Badge x={26} y={362} n={4} />
    <Badge x={44} y={282} n={5} />
  </svg>
  <Stepper steps={t.steps} />
</Figure>
