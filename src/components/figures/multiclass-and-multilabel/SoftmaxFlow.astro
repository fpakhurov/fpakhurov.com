---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Box from '../seqflow/Box.astro';
import Op from '../seqflow/Op.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import { fmt } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Multinomial logistic regression on one example, in the colours of the sequence-model figures: the input x is green,
// the weights W amber, the scores z blue, the probabilities p and the loss red. x = (2, 1) and the rows of W give the
// scores z = (2.0, 1.0, 0.1) of the worked example; the true class is 1.
const x = [2, 1];
const W = [[0.5, 1], [0.25, 0.5], [0.3, -0.5]];
const z = W.map((r) => r[0] * x[0] + r[1] * x[1]);
const e = z.map(Math.exp), s = e.reduce((a, b) => a + b, 0);
const p = e.map((v) => v / s);
const y = [1, 0, 0];
const loss = -Math.log(p[0]);
const g = p.map((v, k) => v - y[k]);
const zs = z.map((v) => v.toFixed(1)), ps = p.map((v) => fmt(v)), gs = g.map((v) => fmt(v).replace('-', '−'));
if (zs.join() !== '2.0,1.0,0.1' || ps.join() !== '0.659,0.242,0.099' || loss.toFixed(3) !== '0.417' || gs.join() !== '−0.341,0.242,0.099') throw new Error('SoftmaxFlow: worked example drifted');
const t = ru
  ? { loss: `L = ${loss.toFixed(3)}`, grad: '∂L/∂W = (p − y)xᵀ', steps: [`оценки: z = Wx = (${zs.join(', ')})`, `softmax: p_k = exp(z_k) / Σ exp(z_j) = (${ps.join(', ')})`, `потеря: верный класс 1, L = −log p₁ = ${loss.toFixed(3)}`, `градиент: ∂L/∂z = p − y = (${gs.join(', ')}); он возвращается к весам как (p − y)xᵀ`] }
  : { loss: `L = ${loss.toFixed(3)}`, grad: '∂L/∂W = (p − y)xᵀ', steps: [`scores: z = Wx = (${zs.join(', ')})`, `softmax: p_k = exp(z_k) / Σ exp(z_j) = (${ps.join(', ')})`, `loss: the true class is 1, L = −log p₁ = ${loss.toFixed(3)}`, `gradient: ∂L/∂z = p − y = (${gs.join(', ')}); it reaches the weights as (p − y)xᵀ`] };
const caption = ru
  ? `Мультиномиальная логистическая регрессия на одном примере (зелёным — вход, жёлтым — веса, синим — оценки, красным — вероятности и потеря). (1) Линейный слой даёт по оценке на класс, z = Wx. (2) Softmax превращает оценки в вероятности: экспонента делает их положительными, деление на сумму нормирует. (3) Потеря — минус логарифм вероятности верного класса, ${loss.toFixed(3)}. (4) Её градиент по оценкам — разность p − y между предсказанным распределением и one-hot-вектором метки: верный класс тянется вверх на 0.341, остальные вниз на свои вероятности. Прибавление одной константы ко всем оценкам не меняет p.`
  : `Multinomial logistic regression on one example (green: input, amber: weights, blue: scores, red: probabilities and loss). (1) A linear layer gives one score per class, z = Wx. (2) The softmax turns scores into probabilities: the exponential makes them positive, dividing by the sum normalizes them. (3) The loss is minus the log-probability of the true class, ${loss.toFixed(3)}. (4) Its gradient with respect to the scores is the difference p − y between the predicted distribution and the one-hot label: the true class is pushed up by 0.341, the others down by their probabilities. Adding one constant to all scores leaves p unchanged.`;
const id = 'multiclass-softmax-flow';
const xv = x.map(String), yv = y.map(String);
---

<Figure
  id={id}
  title={ru ? 'Softmax, кросс-энтропия и градиент p − y' : 'Softmax, cross-entropy and the gradient p − y'}
  caption={caption}
>
  <svg class="fig-wide" viewBox="0 56 760 274" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{ru ? 'Путь примера через мультиномиальную логистическую регрессию' : 'One example through multinomial logistic regression'}</title>
    <desc id={`${id}-w-d`}>{ru ? 'Слева направо: вход x, матрица весов W, вектор оценок z, блок softmax, вектор вероятностей p, блок минус логарифма и потеря L. Под p лежит one-hot-вектор метки y, левее — вектор градиента p − y, от которого пунктирная стрелка возвращается к W.' : 'Left to right: the input x, the weight matrix W, the score vector z, a softmax block, the probability vector p, a minus-log block and the loss L. Below p lies the one-hot label y, to its left the gradient vector p − y, from which a dashed arrow returns to W.'}</desc>
    <g data-s="1">
      <Vec x={24} y={110} values={xv} tone="x" label="x" />
      <Arrow pts={[[66, 134], [100, 134]]} />
      <Box x={102} y={104} w={70} h={60} label="W" sub="3 × 2" tone="g" />
      <Arrow pts={[[174, 134], [214, 134]]} />
      <Vec x={216} y={98} values={zs} tone="h" label="z" />
    </g>
    <g data-s="2">
      <Arrow pts={[[258, 134], [290, 134]]} />
      <Op x={330} y={134} sym="softmax" />
      <Arrow pts={[[370, 134], [400, 134]]} />
      <Vec x={402} y={98} values={ps} tone="y" cw={52} label="p" />
    </g>
    <g data-s="3">
      <Arrow pts={[[456, 134], [492, 134]]} />
      <Op x={538} y={134} sym="−log p₁" />
      <Arrow pts={[[584, 134], [612, 134]]} tone="red" />
      <Box x={614} y={114} w={120} h={40} label={t.loss} tone="y" />
      <Vec x={408} y={222} values={yv} tone="x" label="y" labelPos="right" />
      <Arrow pts={[[450, 236], [520, 150]]} />
    </g>
    <g data-s="4">
      <Arrow pts={[[406, 258], [272, 258]]} tone="red" dashed />
      <Vec x={216} y={222} values={gs} tone="y" cw={56} label="p − y" labelPos="below" />
      <Arrow pts={[[214, 258], [137, 258], [137, 168]]} tone="red" dashed label={t.grad} at={[146, 202]} anchor="start" labelTone="y" />
    </g>
    <Badge x={24} y={84} n={1} />
    <Badge x={330} y={100} n={2} />
    <Badge x={538} y={100} n={3} />
    <Badge x={300} y={238} n={4} />
    <Legend x={330} y={318} step={110} />
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 616" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{ru ? 'Путь примера через мультиномиальную логистическую регрессию' : 'One example through multinomial logistic regression'}</title>
    <desc id={`${id}-n-d`}>{ru ? 'Сверху вниз: вход x, веса W, оценки z, softmax, вероятности p, метка y, минус логарифм и потеря L; внизу вектор градиента p − y, от которого пунктирная стрелка поднимается к W.' : 'Top to bottom: the input x, the weights W, the scores z, a softmax block, the probabilities p, the label y, a minus-log block and the loss L; at the bottom the gradient vector p − y, from which a dashed arrow rises to W.'}</desc>
    <g data-s="1">
      <Vec x={136} y={30} values={xv} tone="x" label="x" labelPos="left" dir="row" cw={44} />
      <Arrow pts={[[180, 56], [180, 80]]} />
      <Box x={130} y={82} w={100} h={46} label="W" sub="3 × 2" tone="g" subGap={19} />
      <Arrow pts={[[180, 130], [180, 152]]} />
      <Vec x={102} y={154} values={zs} tone="h" label="z" labelPos="left" dir="row" cw={52} />
    </g>
    <g data-s="2">
      <Arrow pts={[[180, 180], [180, 200]]} />
      <Op x={180} y={216} sym="softmax" />
      <Arrow pts={[[180, 232], [180, 252]]} />
      <Vec x={96} y={254} values={ps} tone="y" label="p" labelPos="left" dir="row" cw={56} />
    </g>
    <g data-s="3">
      <Vec x={96} y={300} values={yv} tone="x" label="y" labelPos="left" dir="row" cw={56} />
      <Arrow pts={[[180, 326], [180, 350]]} />
      <Op x={180} y={366} sym="−log p₁" />
      <Arrow pts={[[180, 382], [180, 402]]} tone="red" />
      <Box x={110} y={404} w={140} h={38} label={t.loss} tone="y" />
    </g>
    <g data-s="4">
      <Vec x={90} y={484} values={gs} tone="y" label="p − y" labelPos="below" dir="row" cw={60} />
      <Arrow pts={[[274, 496], [330, 496], [330, 105], [234, 105]]} tone="red" dashed />
      <text class="f-small f-t-red" x={180} y={560} text-anchor="middle">{t.grad}</text>
    </g>
    <Badge x={260} y={42} n={1} />
    <Badge x={250} y={216} n={2} />
    <Badge x={260} y={366} n={3} />
    <Badge x={60} y={496} n={4} />
    <Legend x={40} y={584} step={160} rows={2} />
  </svg>
  <Stepper steps={t.steps} />
</Figure>
