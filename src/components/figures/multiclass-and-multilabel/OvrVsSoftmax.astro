---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { ovrProb, softProb, tOvr, accOvr, recallOvr, accBayes, recallBayes } from './lineClasses';

const ru = pageLang(Astro.url) === 'ru';

// Three Gaussian classes on a line (means −2, 0, 2, unit variance, equal shares). Left: one-vs-rest, three logistic
// regressions fitted separately; the middle one cannot separate a band from its two sides and is flat at 1/3. Right: the
// multinomial model, whose fit is the Bayes posterior. The strip under each panel shows where each class wins.
const XD: [number, number] = [-4, 4], YD: [number, number] = [0, 1];
const xsPlot = Array.from({ length: 321 }, (_, i) => -4 + i * 0.025);
const tones = ['blue', 'amber', 'red'];
const b1 = (-tOvr).toFixed(2);
const nums = { accO: accOvr.toFixed(3), recO: recallOvr.toFixed(2), accB: accBayes.toFixed(3), recB: recallBayes.toFixed(2) };
if (`${b1} ${nums.accO} ${nums.recO} ${nums.accB} ${nums.recB}` !== '0.70 0.774 0.51 0.788 0.68') throw new Error('OvrVsSoftmax: quoted numbers drifted');
const panels = [
  { prob: ovrProb, regions: [[-4, tOvr], [tOvr, -tOvr], [-tOvr, 4]], cuts: [`−${b1}`, b1], head: ru ? 'один против всех: три отдельные модели' : 'one-vs-rest: three separate models', foot: ru ? `доля верных ${nums.accO}, полнота класса 2 — ${nums.recO}` : `accuracy ${nums.accO}, recall of class 2 ${nums.recO}` },
  { prob: softProb, regions: [[-4, -1], [-1, 1], [1, 4]], cuts: ['−1', '1'], head: ru ? 'softmax: одна мультиномиальная модель' : 'softmax: one multinomial model', foot: ru ? `доля верных ${nums.accB}, полнота класса 2 — ${nums.recB}` : `accuracy ${nums.accB}, recall of class 2 ${nums.recB}` },
];
const legend = ru ? ['класс 1, μ = −2', 'класс 2, μ = 0', 'класс 3, μ = 2'] : ['class 1, μ = −2', 'class 2, μ = 0', 'class 3, μ = 2'];
const flat = ru ? 'класс 2 против остальных: 1/3 везде' : 'class 2 vs rest: 1/3 everywhere';
const caption = ru
  ? `Три класса на прямой: x распределён нормально со средним −2, 0 или 2 и дисперсией 1, классы равновероятны. Обе модели обучены на самом распределении, без шума выборки. Слева три логистические регрессии «класс k против остальных». Средний класс — полоса между двумя другими, и прямая в логитах не может отделить полосу от обеих сторон: лучшая такая модель постоянна и равна 1/3. Класс 2 побеждает только там, где обе крайние модели опустились ниже 1/3, при |x| < ${b1}. Справа мультиномиальная логистическая регрессия: её решение совпадает с байесовским, границы ±1, полнота класса 2 ${nums.recB} вместо ${nums.recO}, доля правильных ответов ${nums.accB} вместо ${nums.accO}. Вероятности слева в сумме не дают 1.`
  : `Three classes on a line: x is normal with mean −2, 0 or 2 and variance 1, and the classes are equally likely. Both models are fitted to the distribution itself, free of sampling noise. Left: three logistic regressions, each separating one class from the rest. The middle class is a band between the other two, and a line in the logits cannot separate a band from both of its sides: the best such model is constant at 1/3. Class 2 wins only where both outer models have dropped below 1/3, for |x| < ${b1}. Right: multinomial logistic regression, whose solution is the Bayes posterior, with boundaries at ±1; the recall of class 2 is ${nums.recB} instead of ${nums.recO} and the accuracy ${nums.accB} instead of ${nums.accO}. The probabilities on the left do not sum to 1.`;
const id = 'multiclass-ovr-vs-softmax';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, boxes: [[30, 62], [410, 62]], bw: 330, bh: 170, legY: 18, legX: [30, 250, 470] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 700, boxes: [[36, 112], [36, 422]], bw: 308, bh: 170, legY: 18, legX: [12, 12, 12] },
];
---

<Figure
  id={id}
  title={ru ? 'Один против всех и softmax на трёх классах' : 'One-vs-rest against softmax on three classes'}
  caption={caption}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{ru ? 'Вероятности классов двух моделей' : 'Class probabilities of two models'}</title>
      <desc id={`${id}-${L.sfx}-d`}>{ru
        ? 'Две панели с тремя кривыми вероятностей. Слева синяя кривая убывает, красная растёт, а жёлтая — горизонтальная прямая на уровне 1/3; полоса под панелью отдаёт классу 2 узкий участок. Справа жёлтая кривая — колокол с максимумом в нуле, и класс 2 побеждает на отрезке от −1 до 1.'
        : 'Two panels with three probability curves each. On the left the blue curve falls, the red one rises, and the amber one is a horizontal line at 1/3; the strip below gives class 2 a narrow interval. On the right the amber curve is a bump peaking at zero, and class 2 wins between −1 and 1.'}</desc>
      {legend.map((s, k) => (
        <g>
          <path class={`f-line f-${tones[k]} f-bold`} d={`M ${L.legX[k]} ${L.legY + (L.sfx === 'n' ? k * 22 : 0)} h 22`} />
          <text class="f-small" x={L.legX[k] + 30} y={L.legY + 4 + (L.sfx === 'n' ? k * 22 : 0)}>{s}</text>
        </g>
      ))}
      {panels.map((p, i) => {
        const [bx, by] = L.boxes[i];
        const sx = scale(XD, [bx, bx + L.bw]), sy = scale(YD, [by + L.bh, by]);
        const stripY = by + L.bh + 30;
        return (
          <g>
            <text class="f-small" x={bx} y={by - 10}>{p.head}</text>
            <rect x={bx} y={by} width={L.bw} height={L.bh} class="f-grid" style="fill: none" />
            {[0, 0.5, 1].map((v) => <text class="f-note" x={bx - 6} y={sy(v) + 4} text-anchor="end">{v}</text>)}
            <path class="f-grid" d={`M ${bx} ${sy(1 / 3)} H ${bx + L.bw}`} />
            {[0, 1, 2].map((k) => <path class={`f-line f-${tones[k]} f-bold`} d={polyline(xsPlot.map((x) => [sx(x), sy(p.prob(x)[k])]))} />)}
            {i === 0 && <text class="f-small f-t-amber f-halo" x={sx(0)} y={sy(1 / 3) - 8} text-anchor="middle">{flat}</text>}
            {p.regions.map((r, k) => <rect x={sx(r[0])} y={stripY - 16} width={sx(r[1]) - sx(r[0])} height="12" class={`f-fill-${tones[k]}`} style={`fill-opacity: .55; stroke: var(--fig-${tones[k]}); stroke-width: 1`} />)}
            {[p.regions[0][1], p.regions[1][1]].map((c, k) => <text class="f-small" x={sx(c)} y={stripY + 12} text-anchor="middle">{p.cuts[k]}</text>)}
            <text class="f-small f-t-muted" x={bx} y={stripY + 36}>{p.foot}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
