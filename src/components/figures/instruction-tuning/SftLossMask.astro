---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One SFT example in a chat template, one box per (schematic) token, with the loss mask under each box.
// Role boxes stand for the header tokens of the template; ‹eot› stands for the end-of-turn token.
type Tok = { t: string; loss: 0 | 1; special?: boolean };
const sp = (t: string, loss: 0 | 1 = 0): Tok => ({ t, loss, special: true });
const w = (t: string, loss: 0 | 1 = 0): Tok => ({ t, loss });
const turns: Tok[][] = [
  [sp('‹begin›'), sp('‹system›'), ...'You are a helpful assistant .'.split(' ').map((t) => w(t)), sp('‹eot›')],
  [sp('‹user›'), ...'What is 2 + 2 ?'.split(' ').map((t) => w(t)), sp('‹eot›')],
  [sp('‹assistant›'), ...'2 + 2 = 4 .'.split(' ').map((t) => w(t, 1)), sp('‹eot›', 1)],
];
const all = turns.flat();
const total = all.length;
const lossCount = all.filter((k) => k.loss === 1).length;
if (total !== 25 || lossCount !== 7) throw new Error(`SftLossMask: expected 25 positions and 7 with loss, got ${total} and ${lossCount}`);

const charW = 7.8;
const boxH = 26;
const gap = 5;
const boxW = (s: string) => [...s].length * charW + 12;

interface Layout { cls: string; wide: boolean; W: number; x0: number; y0: number; lineH: number; turnGap: number }
const layouts: Layout[] = [
  { cls: 'fig-wide fig-medium', wide: true, W: 620, x0: 20, y0: 44, lineH: 50, turnGap: 8 },
  { cls: 'fig-narrow', wide: false, W: 360, x0: 10, y0: 44, lineH: 50, turnGap: 8 },
];

type Placed = { k: Tok; x: number; y: number; bw: number };
const place = (L: Layout) => {
  const out: Placed[] = [];
  let y = L.y0;
  for (const turn of turns) {
    let x = L.x0;
    for (const k of turn) {
      const bw = boxW(k.t);
      if (x + bw - (L.W - L.x0) > 0) { x = L.x0; y += L.lineH; }
      out.push({ k, x, y, bw });
      x += bw + gap;
    }
    y += L.lineH + L.turnGap;
  }
  for (const p of out) {
    if (p.x + p.bw - (L.W - 4) > 0) throw new Error(`SftLossMask: box ${p.k.t} overflows the ${L.W}-wide layout`);
  }
  return { out, end: y };
};

const t = ru
  ? {
      head: `Потери на ${lossCount} из ${total} позиций`,
      noLoss: 'промпт и шаблон: метка −100, потерь нет',
      withLoss: 'ответ и ‹eot›: потери следующего токена',
    }
  : {
      head: `Loss on ${lossCount} of ${total} positions`,
      noLoss: 'prompt and template: label −100, no loss',
      withLoss: 'response and ‹eot›: next-token loss',
    };
const desc = ru
  ? `Пример для SFT в шаблоне чата, по одному прямоугольнику на токен, в три строки: системная реплика, вопрос пользователя «What is 2 + 2 ?» и ответ ассистента «2 + 2 = 4 .» с токеном конца реплики. Под каждым токеном стоит маска потерь: 0 у всех токенов системы, пользователя и заголовка ассистента, 1 у ${lossCount} токенов ответа, включая конец реплики. Всего ${total} позиций.`
  : `An SFT example in a chat template, one box per token, in three rows: the system turn, the user question "What is 2 + 2 ?", and the assistant answer "2 + 2 = 4 ." with its end-of-turn token. Under each token is its loss mask: 0 for every system, user and assistant-header token, 1 for the ${lossCount} response tokens including the end of turn. ${total} positions in all.`;
const id = 'sft-loss-mask';
---

<Figure
  id="sft-loss-mask"
  title={ru ? 'Один пример для SFT и его маска потерь' : 'One SFT example and its loss mask'}
  caption={ru
    ? `Диалог оформлен шаблоном чата и стал одной последовательностью из ${total} позиций. Прямоугольники схематичны: одно слово или знак на токен; ‹begin› обозначает токен начала текста, каждый прямоугольник роли — заголовочные токены своей реплики, ‹eot› — токен конца реплики. Модель читает всю последовательность, но функция потерь следующего токена считается только там, где маска равна 1: на ${lossCount} токенах ответа ассистента, включая завершающий ‹eot›, благодаря которому модель учится останавливаться. У системной реплики, вопроса и заголовка ассистента метка равна −100, и функция потерь их пропускает.`
    : `The dialogue rendered by the chat template is one sequence of ${total} positions. The boxes are schematic: one word or symbol per token; ‹begin› stands for the begin-of-text token, each role box for the header tokens of its turn, and ‹eot› for the end-of-turn token. The model reads the whole sequence, but the next-token loss is counted only where the mask is 1: on the ${lossCount} tokens of the assistant's response, including the final ‹eot›, which is how the model learns to stop. The system turn, the question and the assistant header get the label −100, which the loss skips.`}
>
  {layouts.map((L) => {
    const { out, end } = place(L);
    const legendY = end + 4;
    const H = legendY + (L.wide ? 34 : 64);
    const l2x = L.wide ? L.x0 + 300 : L.x0;
    const l2y = L.wide ? legendY : legendY + 30;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Маска потерь в примере для SFT' : 'The loss mask of an SFT example'}</title>
        <desc id={`${id}-${L.W}-d`}>{desc}</desc>
        <text class="f-title" x={L.x0} y={22}>{t.head}</text>
        {out.map((p) => (
          <g>
            <rect class={p.k.loss ? 'f-box f-fill-red' : 'f-box-soft'} x={p.x} y={p.y} width={p.bw} height={boxH} rx="4" />
            <text class={`f-small${p.k.loss ? '' : ' f-t-muted'}`} x={p.x + p.bw / 2} y={p.y + 17.5} text-anchor="middle" font-family="var(--mono)">{p.k.t}</text>
            <text class={`f-small${p.k.loss ? ' f-t-red' : ' f-t-muted'}`} x={p.x + p.bw / 2} y={p.y + boxH + 15} text-anchor="middle">{p.k.loss ? '1' : '0'}</text>
          </g>
        ))}
        <rect class="f-box-soft" x={L.x0} y={legendY} width="22" height="16" rx="3" />
        <text class="f-small" x={L.x0 + 30} y={legendY + 12.5}>{t.noLoss}</text>
        <rect class="f-box f-fill-red" x={l2x} y={l2y} width="22" height="16" rx="3" />
        <text class="f-small" x={l2x + 30} y={l2y + 12.5}>{t.withLoss}</text>
      </svg>
    );
  })}
</Figure>
