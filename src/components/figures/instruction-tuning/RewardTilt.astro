---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const ru = pageLang(Astro.url) === 'ru';
const bars = cases.reward.reference.flatMap((q, i) => [q, cases.reward.optimum[i]].map((v, j) => ({i, j, value: v, y: 58 + i * 74 + j * 23})));
const title = ru ? "Награда меняет распределение" : "Reward tilts a reference distribution";
const caption = ru ? "Синий: исходное q. Оранжевый: неограниченный оптимум при beta = 1. В каждом распределении сумма вероятностей равна единице." : "Blue: reference q. Orange: the unrestricted optimum with beta one. All three probabilities still sum to one.";
const description = ru ? "Исходные массы 0,5; 0,3; 0,2 после учёта награды и нормировки становятся 5/19, 6/19, 8/19." : "The reference masses 0.5, 0.3, 0.2 become 5/19, 6/19, 8/19 after reward tilting and normalization.";
---
<Figure id="instruction-reward-tilt" title={title} caption={caption}>
  <svg viewBox="0 0 320 295" role="img" aria-labelledby="instruction-reward-tilt-title instruction-reward-tilt-desc">
    <title id="instruction-reward-tilt-title">{title}</title>
    <desc id="instruction-reward-tilt-desc">{description}</desc>
    <text x="64" y="22">{ru ? 'Вероятность ответа' : 'Response probability'}</text>
    <line x1="64" y1="38" x2="64" y2="253" class="axis" />
    {cases.reward.reference.map((_, i) => <text x="12" y={79 + i * 74}>y{i + 1}</text>)}
    {bars.map(b => <g><rect data-case="reward" data-index={b.i} data-series={b.j} data-value={b.value} x="64" y={b.y} width={b.value * 360} height="15" class={b.j ? 'orange' : 'blue'} /><text x={70 + b.value * 360} y={b.y + 13} class="number">{b.value.toFixed(3)}</text></g>)}
    <text x="64" y="281">0</text><text x="244" y="281" text-anchor="middle">0.5</text>
  </svg>
</Figure>
<style>
  svg { display: block; width: 100%; max-width: 34rem; height: auto; margin-inline: auto; }
  text { font: 15px var(--sans, sans-serif); fill: var(--ink); }
  .axis { stroke: var(--line); stroke-width: 1; }
  .blue { fill: var(--fig-blue); }
  .orange { fill: var(--fig-amber); }
  .muted { fill: var(--muted); }
  .outline { fill: none; stroke: var(--fig-blue); stroke-width: 2; }
  .number { font-variant-numeric: tabular-nums; }
</style>
