---
import BlockDiagram, { type DLayout } from '../BlockDiagram.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// From a base model to an assistant: SFT, then preference optimization by RLHF or DPO.
const t = ru
  ? { base: 'базовая модель', baseSub: 'следующий токен', sft: 'модель после SFT', sftSub: 'отвечает и стоп', rm: 'модель вознагр.', rmSub: 'Брэдли–Терри', pol: 'выровненная модель', polSub: 'ответы, что нравятся', demo: 'демонстрации', ranked: 'ранжирование', ppo: 'PPO: r − β·KL', dpo: 'DPO: пары, без модели вознагр.', dpoN: 'DPO' }
  : { base: 'base model', baseSub: 'next token', sft: 'SFT model', sftSub: 'answers, stops', rm: 'reward model', rmSub: 'Bradley–Terry', pol: 'aligned model', polSub: 'answers people prefer', demo: 'demonstrations', ranked: 'ranked samples', ppo: 'PPO: r − β·KL', dpo: 'DPO: pairs, no reward model', dpoN: 'DPO' };
const desc = ru
  ? 'Базовая модель через обучение с учителем на демонстрациях становится моделью после SFT. Её ответы ранжируют люди, и по ранжированию обучается модель вознаграждения, а стратегия оптимизируется PPO по вознаграждению с KL-штрафом и становится выровненной моделью. Пунктирный путь DPO ведёт от модели после SFT прямо к выровненной модели по тем же парам предпочтений, без модели вознаграждения.'
  : 'The base model becomes the SFT model through supervised fine-tuning on demonstrations. Humans rank its samples, a reward model is trained on the rankings, and the policy is optimized with PPO against the reward with a KL penalty, giving the aligned model. A dashed DPO path leads from the SFT model straight to the aligned model on the same preference pairs, without a reward model.';

const wide: DLayout = {
  cls: 'fig-wide', w: 720, h: 236, desc,
  nodes: [
    { id: 'base', x: 8, y: 30, w: 150, h: 54, label: t.base, sub: t.baseSub, tone: 'soft' },
    { id: 'sft', x: 236, y: 30, w: 166, h: 54, label: t.sft, sub: t.sftSub, tone: 'blue' },
    { id: 'rm', x: 340, y: 140, w: 160, h: 54, label: t.rm, sub: t.rmSub, tone: 'amber' },
    { id: 'pol', x: 546, y: 30, w: 166, h: 54, label: t.pol, sub: t.polSub, tone: 'green' },
  ],
  edges: [
    { from: 'base', to: 'sft', label: t.demo, at: [197, 22] },
    { from: 'sft', to: 'rm', label: t.ranked, anchor: 'end', shift: [-8, 4] },
    { from: 'rm', to: 'pol', label: t.ppo, tone: 'amber', anchor: 'start', shift: [10, 4] },
    { from: 'sft', to: 'pol', via: [[300, 220], [629, 220]], label: t.dpo, tone: 'green', dashed: true, at: [462, 214] },
  ],
};
const narrow: DLayout = {
  cls: 'fig-narrow', w: 360, h: 420, desc,
  nodes: [
    { id: 'base', x: 90, y: 10, w: 180, h: 54, label: t.base, sub: t.baseSub, tone: 'soft' },
    { id: 'sft', x: 90, y: 116, w: 180, h: 54, label: t.sft, sub: t.sftSub, tone: 'blue' },
    { id: 'rm', x: 8, y: 228, w: 160, h: 54, label: t.rm, sub: t.rmSub, tone: 'amber' },
    { id: 'pol', x: 130, y: 346, w: 180, h: 54, label: t.pol, sub: t.polSub, tone: 'green' },
  ],
  edges: [
    { from: 'base', to: 'sft', label: t.demo, anchor: 'start', shift: [8, 10] },
    { from: 'sft', to: 'rm', label: t.ranked, anchor: 'end', shift: [-10, 4] },
    { from: 'rm', to: 'pol', label: t.ppo, tone: 'amber', anchor: 'end', shift: [-10, 8] },
    { from: 'sft', to: 'pol', via: [[330, 143], [330, 373]], label: t.dpoN, tone: 'green', dashed: true, at: [324, 260], anchor: 'end' },
  ],
};
---

<BlockDiagram
  id="alignment-stages"
  title={ru ? 'От базовой модели к ассистенту' : 'From a base model to an assistant'}
  svgTitle={ru ? 'Этапы SFT, RLHF и DPO' : 'The SFT, RLHF and DPO stages'}
  caption={ru
    ? 'Два этапа после предобучения. Обучение с учителем (SFT) обучает базовую модель на диалогах-демонстрациях обычной функцией потерь следующего токена и учит формату ответа. Затем оптимизация по предпочтениям использует сравнения: в RLHF люди ранжируют ответы модели после SFT, по ранжированию обучается модель вознаграждения, а стратегия оптимизируется PPO так, чтобы повышать вознаграждение, пока KL-штраф удерживает её возле модели после SFT; DPO (пунктир) приходит к оптимуму той же цели прямо по парам предпочтений, без модели вознаграждения. Архитектура при этом не меняется.'
    : 'The two stages after pretraining. Supervised fine-tuning (SFT) trains the base model on demonstration dialogues with the ordinary next-token loss, which teaches the format of an answer. Preference optimization then uses comparisons: in RLHF, humans rank samples of the SFT model, a reward model is fitted to the rankings, and the policy is optimized with PPO to raise the reward while a KL penalty keeps it near the SFT model; DPO (dashed) reaches the optimum of the same objective directly from the preference pairs, without a reward model. The architecture never changes.'}
  layouts={[wide, narrow]}
/>
