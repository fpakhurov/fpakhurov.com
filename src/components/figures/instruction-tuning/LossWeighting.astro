---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const ru = pageLang(Astro.url) === 'ru';
const weights = [[1 / 3, 2 / 3], [1 / 2, 1 / 2]];
const bars = weights.flatMap((row, i) => row.map((v, j) => ({i, j, value: v, x: 20 + (j ? row[0] * 280 : 0), width: v * 280, y: 65 + i * 100})));
const reductions = [cases.sft.token_mean_nll, cases.sft.conversation_mean_nll];
const title = ru ? "Усреднение меняет вес диалогов" : "Reduction changes each conversation’s weight";
const caption = ru ? "В A две оцениваемые цели, в B четыре. Вероятности в двух диалогах не меняются; меняется только способ усреднения." : "A has two scored tokens, B has four. Both reductions use the unchanged probabilities from the same two conversations.";
const description = ru ? "Среднее по токенам даёт A треть веса, B две трети. Среднее по диалогам даёт каждому половину." : "Token mean gives A one third and B two thirds of total weight. Conversation mean gives each one half.";
---
<Figure id="instruction-loss-weighting" title={title} caption={caption}>
  <svg viewBox="0 0 320 240" role="img" aria-labelledby="instruction-loss-weighting-title instruction-loss-weighting-desc">
    <title id="instruction-loss-weighting-title">{title}</title>
    <desc id="instruction-loss-weighting-desc">{description}</desc>
    <text x="20" y="24">{ru ? 'Синий: A · оранжевый: B' : 'Blue: A · orange: B'}</text>
    {weights.map((row, i) => <text x="20" y={52 + i * 100}>{i === 0 ? (ru ? 'По токенам' : 'Token mean') : (ru ? 'По диалогам' : 'Conversation mean')}</text>)}
    {bars.map(b => <g><rect data-case="weight" data-row={b.i} data-index={b.j} data-value={b.value} x={b.x} y={b.y} width={b.width} height="18" class={b.j ? 'orange' : 'blue'} /><text x={b.x + b.width / 2} y={b.y + 40} text-anchor="middle" class="number">{b.j ? 'B' : 'A'}: {b.value.toFixed(3)}</text></g>)}
    {reductions.map((v, i) => <text x="20" y={130 + i * 100} class="number">NLL = {v.toFixed(6)}</text>)}
  </svg>
</Figure>
<style>
  svg { display: block; width: 100%; max-width: 34rem; height: auto; margin-inline: auto; }
  text { font: 15px var(--sans, sans-serif); fill: var(--ink); }
  .axis { stroke: var(--line); stroke-width: 1; }
  .blue { fill: var(--fig-blue); }
  .orange { fill: var(--fig-amber); }
  .muted { fill: var(--muted); }
  .outline { fill: none; stroke: var(--fig-blue); stroke-width: 2; }
  .number { font-variant-numeric: tabular-nums; }
</style>
