---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const ru = pageLang(Astro.url) === 'ru';
const c = cases.sft.conversations[0];
const rows = c.tokens.slice(1).map((target, i) => ({ input: c.tokens[i], target, scored: c.scored_positions.includes(i + 1), y: 74 + i * 41 }));
const title = ru ? "Сдвинутые цели и маска потерь" : "A shifted target and its loss mask";
const caption = ru ? "Диалог A: вклад дают только a и EOS. Каждая строка предсказывает следующий токен по причинному префиксу." : "Conversation A: only a and EOS contribute. Every row predicts the next token from a causal prefix.";
const description = ru ? "Пять пар: конец входа и целевой токен. У двух последних целей маска равна единице, у первых трёх — нулю." : "Five input-ending to target pairs. The final two targets have mask one; the first three have mask zero.";
---
<Figure id="instruction-assistant-mask" title={title} caption={caption}>
  <svg viewBox="0 0 320 275" role="img" aria-labelledby="instruction-assistant-mask-title instruction-assistant-mask-desc">
    <title id="instruction-assistant-mask-title">{title}</title>
    <desc id="instruction-assistant-mask-desc">{description}</desc>
    <text x="14" y="22">{ru ? 'Конец входа' : 'Input ends'}</text>
    <text x="145" y="22">{ru ? 'Цель' : 'Target'}</text>
    <text x="255" y="22">{ru ? 'Маска' : 'Mask'}</text>
    {rows.map((r, i) => <g data-case="mask" data-index={i} data-value={Number(r.scored)}>
      <line x1="12" y1={r.y + 12} x2="308" y2={r.y + 12} class="axis" />
      <text x="14" y={r.y}>{r.input}</text><text x="145" y={r.y}>{r.target}</text>
      <text x="275" y={r.y} text-anchor="middle" class={r.scored ? 'blue number' : 'muted number'}>{Number(r.scored)}</text>
    </g>)}
  </svg>
</Figure>
<style>
  svg { display: block; width: 100%; max-width: 34rem; height: auto; margin-inline: auto; }
  text { font: 15px var(--sans, sans-serif); fill: var(--ink); }
  .axis { stroke: var(--line); stroke-width: 1; }
  .blue { fill: var(--fig-blue); }
  .orange { fill: var(--fig-amber); }
  .muted { fill: var(--muted); }
  .outline { fill: none; stroke: var(--fig-blue); stroke-width: 2; }
  .number { font-variant-numeric: tabular-nums; }
</style>
