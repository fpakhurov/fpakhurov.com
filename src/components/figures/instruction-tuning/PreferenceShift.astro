---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const ru = pageLang(Astro.url) === 'ru';
const bars = cases.dpo.flatMap((r, i) => [r.policy[1], r.pair_probability].map((v, j) => ({i, j, value: v, y: 70 + i * 85 + j * 24})));
const names = ru ? ['Исходная', 'Масса выше', 'Масса ниже'] : ['Reference', 'Mass increases', 'Mass decreases'];
const title = ru ? "Относительное предпочтение и масса" : "Relative preference and absolute mass";
const caption = ru ? "Третья политика уменьшает массу выбранного исхода относительно исходной, но улучшает его парную оценку." : "The third policy lowers the chosen outcome’s mass below the reference, while improving its pairwise score.";
const description = ru ? "Три политики. Вероятности выбранного ответа: 0,3; 0,5; 0,25. Вероятности парного предпочтения: 0,5; 25/31; 25/37." : "Three policies. Chosen response probabilities are 0.3, 0.5, 0.25; pair preference probabilities are 0.5, 25/31, 25/37.";
---
<Figure id="instruction-preference-shift" title={title} caption={caption}>
  <svg viewBox="0 0 320 330" role="img" aria-labelledby="instruction-preference-shift-title instruction-preference-shift-desc">
    <title id="instruction-preference-shift-title">{title}</title>
    <desc id="instruction-preference-shift-desc">{description}</desc>
    <text x="18" y="20">{ru ? 'Синий: масса ответа y2' : 'Blue: response y2 mass'}</text>
    <text x="18" y="42">{ru ? 'Оранжевый: предпочтение' : 'Orange: pair preference'}</text>
    {names.map((name, i) => <text x="18" y={65 + i * 85}>{name}</text>)}
    {bars.map(b => <g><rect data-case="dpo" data-index={b.i} data-series={b.j} data-value={b.value} x="18" y={b.y} width={b.value * 255} height="15" class={b.j ? 'orange' : 'blue'} /><text x={24 + b.value * 255} y={b.y + 13} class="number">{b.value.toFixed(3)}</text></g>)}
    <text x="18" y="323">0</text><text x="273" y="323" text-anchor="middle">1</text>
  </svg>
</Figure>
<style>
  svg { display: block; width: 100%; max-width: 34rem; height: auto; margin-inline: auto; }
  text { font: 15px var(--sans, sans-serif); fill: var(--ink); }
  .axis { stroke: var(--line); stroke-width: 1; }
  .blue { fill: var(--fig-blue); }
  .orange { fill: var(--fig-amber); }
  .muted { fill: var(--muted); }
  .outline { fill: none; stroke: var(--fig-blue); stroke-width: 2; }
  .number { font-variant-numeric: tabular-nums; }
</style>
