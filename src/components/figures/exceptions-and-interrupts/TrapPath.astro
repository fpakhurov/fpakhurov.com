---
import Figure from '../Figure.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The worked example of the note: a U-mode program executes ecall at 0x00010074; mtvec = 0x80000100 (direct mode).
// The hart model follows the privileged specification: trap entry, then mret after the handler adds 4 to mepc.
const hex = (v: number) => '0x' + (v >>> 0).toString(16).padStart(8, '0');
const hart = { priv: 0, MIE: 1, MPIE: 1, MPP: 0, mepc: 0, mcause: 0, mtval: 0, pc: 0x00010074, mtvec: 0x80000100 };
const trap = (cause: number, interrupt: boolean, tval: number) => {
  hart.mepc = hart.pc; hart.mcause = ((interrupt ? 1 : 0) << 31 | cause) >>> 0; hart.mtval = tval;
  hart.MPIE = hart.MIE; hart.MIE = 0; hart.MPP = hart.priv; hart.priv = 3;
  const base = hart.mtvec & ~3, mode = hart.mtvec & 3;
  hart.pc = mode === 1 && interrupt ? base + 4 * cause : base;
};
const mret = () => { hart.priv = hart.MPP; hart.MIE = hart.MPIE; hart.MPIE = 1; hart.MPP = 0; hart.pc = hart.mepc; };
trap(8, false, 0);
const atTrap = { ...hart };
hart.mepc += 4;
mret();
const after = { ...hart };
if (hex(atTrap.mepc) !== '0x00010074' || atTrap.mcause !== 8 || hex(atTrap.pc) !== '0x80000100' || atTrap.MIE !== 0 || atTrap.MPIE !== 1 || atTrap.MPP !== 0 || atTrap.priv !== 3)
  throw new Error(`trap entry ${JSON.stringify(atTrap)}`);
if (hex(after.pc) !== '0x00010078' || after.priv !== 0 || after.MIE !== 1) throw new Error(`mret ${JSON.stringify(after)}`);
const mode = (p: number) => ['U', 'S', '', 'M'][p];

const user = [['0x00010070', 'li a7, 64'], ['0x00010074', 'ecall'], ['0x00010078', 'mv s0, a0']];
const t = ru
  ? { user: 'программа, режим U', state: 'состояние харта', handler: 'обработчик, режим M', at: 'при входе в ловушку', ret: 'после mret',
      lines: [['csrrw sp, mscratch, sp', true], ['сохранить регистры', false], ['csrr t0, mcause', true], ['системный вызов a7', false], ['mepc ← mepc + 4', false], ['восстановить регистры', false], ['mret', true]] as [string, boolean][],
      steps: ['ecall в режиме U вызывает исключение с кодом 8: вызов окружения из режима U',
        'аппаратура сохраняет адрес ecall в mepc, причину в mcause, 0 в mtval',
        'аппаратура запоминает MIE в MPIE и режим U в MPP, обнуляет MIE и переходит в режим M',
        'pc ← mtvec: обработчик переключается на стек ядра, сохраняет регистры, читает mcause',
        'обработчик выполняет системный вызов номер a7, кладёт результат в a0 и прибавляет 4 к mepc',
        'mret: режим ← MPP = U, MIE ← MPIE = 1, pc ← mepc: программа продолжает со следующей команды'] }
  : { user: 'program, U-mode', state: 'hart state', handler: 'handler, M-mode', at: 'on trap entry', ret: 'after mret',
      lines: [['csrrw sp, mscratch, sp', true], ['save registers', false], ['csrr t0, mcause', true], ['do system call a7', false], ['mepc ← mepc + 4', false], ['restore registers', false], ['mret', true]] as [string, boolean][],
      steps: ['ecall in U-mode raises an exception: code 8, environment call from U-mode',
        'the hardware saves the address of the ecall in mepc, the cause in mcause, 0 in mtval',
        'the hardware copies MIE to MPIE and the mode U to MPP, clears MIE and switches to M-mode',
        'pc ← mtvec: the handler switches to the kernel stack, saves registers, reads mcause',
        'the handler performs system call a7, puts the result in a0 and adds 4 to mepc',
        'mret: mode ← MPP = U, MIE ← MPIE = 1, pc ← mepc: the program goes on with the next instruction'] };
const lineStep = ['4', '4', '4', '5', '5', '5', '6'];
const stateRows: [string, string, number][] = [
  ['mepc', hex(atTrap.mepc), 2], ['mcause', String(atTrap.mcause), 2], ['mtval', String(atTrap.mtval), 2],
  ['MPIE', String(atTrap.MPIE), 3], ['MIE', String(atTrap.MIE), 3], ['MPP', mode(atTrap.MPP), 3], ['mode', mode(atTrap.priv), 3], ['pc', hex(atTrap.pc), 4],
];
const retRows: [string, string][] = [['mode', mode(after.priv)], ['MIE', String(after.MIE)], ['pc', hex(after.pc)]];

interface Layout { cls: string; W: number; H: number; wide: boolean; ux: number; uy: number; uw: number; sx: number; sy: number; sw: number; hx: number; hy: number; hw: number; lh: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 392, wide: true, ux: 14, uy: 16, uw: 200, sx: 262, sy: 16, sw: 200, hx: 510, hy: 16, hw: 236, lh: 22 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 840, wide: false, ux: 40, uy: 20, uw: 280, sx: 40, sy: 176, sw: 280, hx: 40, hy: 574, hw: 280, lh: 24 },
];
const id = 'trap-path';
const mono = 'font-family: var(--mono)';
---

<Figure
  id={id}
  title={ru ? 'Путь ловушки: от ecall в режиме U к обработчику в режиме M и обратно' : 'The trap path: from an ecall in U-mode to the M-mode handler and back'}
  caption={ru
    ? `Разобранный пример из текста: программа в режиме U выполняет ecall по адресу ${hex(atTrap.mepc)}, mtvec = ${hex(hart.mtvec)} (прямой режим). Средний столбец — регистры CSR и режим харта сразу после входа в ловушку (шаги 2–4) и после mret (шаг 6). Синим — то, что делает аппаратура; жёлтым — то, что делает программный обработчик. Обработчик сам прибавляет 4 к mepc: после ecall mepc указывает на саму ecall, и без этого mret выполнила бы её снова.`
    : `The worked example of the text: a U-mode program executes ecall at ${hex(atTrap.mepc)}, with mtvec = ${hex(hart.mtvec)} (direct mode). The middle column shows the CSRs and the mode of the hart just after trap entry (steps 2–4) and after mret (step 6). Blue is what the hardware does; amber is what the handler software does. The handler itself adds 4 to mepc: after an ecall, mepc points at the ecall, and without the addition mret would execute it again.`}
>
  {layouts.map((L) => {
    const rowY = (k: number) => L.sy + (L.wide ? 54 : 58) + k * L.lh;
    const retY = (k: number) => rowY(stateRows.length) + 34 + k * L.lh;
    const sh = retY(retRows.length - 1) - L.sy + 14;
    const hh = 40 + t.lines.length * L.lh;
    const valX = L.sx + (L.wide ? 76 : 100);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Путь ловушки для системного вызова' : 'The trap path of a system call'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? `Три блока: программа в режиме U с командами li a7, 64, ecall и mv s0, a0; состояние харта: mepc = ${hex(atTrap.mepc)}, mcause = 8, mtval = 0, MPIE = 1, MIE = 0, MPP = U, режим M, pc = ${hex(atTrap.pc)}, а после mret режим U, MIE = 1, pc = ${hex(after.pc)}; обработчик в режиме M, который сохраняет регистры, читает mcause, выполняет системный вызов, прибавляет 4 к mepc и выполняет mret. Стрелки ведут от ecall к состоянию, от состояния к обработчику и от mret обратно к команде после ecall.`
          : `Three blocks: the U-mode program with the instructions li a7, 64, ecall and mv s0, a0; the hart state: mepc = ${hex(atTrap.mepc)}, mcause = 8, mtval = 0, MPIE = 1, MIE = 0, MPP = U, mode M, pc = ${hex(atTrap.pc)}, and after mret mode U, MIE = 1, pc = ${hex(after.pc)}; the M-mode handler, which saves registers, reads mcause, performs the call, adds 4 to mepc and executes mret. Arrows lead from the ecall to the state, from the state to the handler, and from mret back to the instruction after the ecall.`}</desc>

        {/* user program */}
        <g>
          <rect x={L.ux} y={L.uy} width={L.uw} height={40 + user.length * L.lh} rx="8" class="f-fill-green f-green" style="stroke-width: 1.3" />
          <text class="f-small f-t-green" x={L.ux + 10} y={L.uy + 20} style="font-weight: 650">{t.user}</text>
          {user.map(([a, ins], k) => (
            <g>
              {k === 1 && <rect x={L.ux + 4} y={L.uy + 32 + k * L.lh} width={L.uw - 8} height={L.lh - 2} rx="4" class="f-fill-red f-red" style="stroke-width: 1" data-s="1" />}
              <text class="f-small f-t-muted" x={L.ux + 10} y={L.uy + 47 + k * L.lh} style={mono}>{a}</text>
              <text class="f-small" x={L.ux + (L.wide ? 104 : 124)} y={L.uy + 47 + k * L.lh} style={mono}>{ins}</text>
            </g>
          ))}
        </g>

        {/* hart state */}
        <rect x={L.sx} y={L.sy} width={L.sw} height={sh} rx="8" class="f-fill-blue f-blue" style="stroke-width: 1.3" />
        <text class="f-small f-t-blue" x={L.sx + 10} y={L.sy + 20} style="font-weight: 650">{t.state}</text>
        <text class="f-small f-t-muted" x={L.sx + 10} y={L.sy + 38}>{t.at}</text>
        {stateRows.map(([name, v, s], k) => (
          <g data-s={String(s)}>
            <text class="f-small" x={L.sx + 10} y={rowY(k) + 4} style={mono}>{name}</text>
            <text class="f-small f-t-blue" x={valX} y={rowY(k) + 4} style={mono}>{v}</text>
          </g>
        ))}
        <g data-s="6">
          <path class="f-thin f-muted" d={`M ${L.sx + 10} ${retY(0) - 26} H ${L.sx + L.sw - 10}`} />
          <text class="f-small f-t-muted" x={L.sx + 10} y={retY(0) - 10}>{t.ret}</text>
          {retRows.map(([name, v], k) => (
            <g>
              <text class="f-small" x={L.sx + 10} y={retY(k) + 8} style={mono}>{name}</text>
              <text class="f-small f-t-green" x={valX} y={retY(k) + 8} style={mono}>{v}</text>
            </g>
          ))}
        </g>

        {/* handler */}
        <rect x={L.hx} y={L.hy} width={L.hw} height={hh} rx="8" class="f-fill-amber f-amber" style="stroke-width: 1.3" data-s="4 5" />
        <text class="f-small f-t-amber" x={L.hx + 10} y={L.hy + 20} style="font-weight: 650" data-s="4 5">{t.handler}</text>
        {t.lines.map(([line, code], k) => (
          <text class={code ? 'f-small' : 'f-small f-t-muted'} x={L.hx + 12} y={L.hy + 47 + k * L.lh} style={code ? mono : undefined} data-s={lineStep[k]}>{line}</text>
        ))}

        {/* arrows and badges */}
        {L.wide ? (
          <g>
            <g data-s="1"><Arrow pts={[[L.ux + L.uw - 4, L.uy + 43 + L.lh], [L.sx - 3, L.uy + 43 + L.lh]]} tone="red" bold /><Badge x={(L.ux + L.uw + L.sx) / 2} y={L.uy + 20 + L.lh} n={1} /></g>
            <g data-s="2"><Badge x={L.sx + L.sw - 18} y={rowY(1)} n={2} /></g>
            <g data-s="3"><Badge x={L.sx + L.sw - 18} y={rowY(5)} n={3} /></g>
            <g data-s="4"><Arrow pts={[[L.sx + L.sw + 2, rowY(7)], [L.hx - 20, rowY(7)], [L.hx - 20, L.hy + 43], [L.hx - 3, L.hy + 43]]} tone="blue" bold /><Badge x={L.hx - 20} y={rowY(4)} n={4} /></g>
            <g data-s="5"><Badge x={L.hx + L.hw - 18} y={L.hy + 43 + 3 * L.lh} n={5} /></g>
            <g data-s="6">
              <Arrow pts={[[L.hx + L.hw / 2, L.hy + hh + 2], [L.hx + L.hw / 2, L.H - 14], [L.ux + L.uw / 2, L.H - 14], [L.ux + L.uw / 2, L.uy + 42 + 3 * L.lh]]} tone="green" bold />
              <Badge x={(L.ux + L.uw + L.hx) / 2 + 60} y={L.H - 14} n={6} />
            </g>
          </g>
        ) : (
          <g>
            <g data-s="1"><Arrow pts={[[L.ux + L.uw / 2, L.uy + 40 + user.length * L.lh + 2], [L.ux + L.uw / 2, L.sy - 3]]} tone="red" bold /><Badge x={L.ux + L.uw / 2 + 24} y={(L.uy + 40 + user.length * L.lh + L.sy) / 2} n={1} /></g>
            <g data-s="2"><Badge x={L.sx + L.sw - 18} y={rowY(1)} n={2} /></g>
            <g data-s="3"><Badge x={L.sx + L.sw - 18} y={rowY(5)} n={3} /></g>
            <g data-s="4"><Arrow pts={[[L.sx + L.sw / 2, L.sy + sh + 2], [L.sx + L.sw / 2, L.hy - 3]]} tone="blue" bold /><Badge x={L.sx + L.sw / 2 + 24} y={(L.sy + sh + L.hy) / 2} n={4} /></g>
            <g data-s="5"><Badge x={L.hx + L.hw - 18} y={L.hy + 43 + 3 * L.lh} n={5} /></g>
            <g data-s="6">
              <Arrow pts={[[L.hx, L.hy + 43 + 6 * L.lh], [16, L.hy + 43 + 6 * L.lh], [16, L.uy + 42 + 2 * L.lh], [L.ux - 3, L.uy + 42 + 2 * L.lh]]} tone="green" bold />
              <Badge x={16} y={(L.uy + L.hy) / 2 + 40} n={6} />
            </g>
          </g>
        )}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
