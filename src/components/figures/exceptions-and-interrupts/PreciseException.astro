---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';
import { schedule, cells, type Instr } from '../pipelining/schedule';

const ru = pageLang(Astro.url) === 'ru';

// The worked example of the note: five independent instructions; the load faults in MEM (cycle 5), and the
// instruction after it, an illegal encoding, was already detected in ID one cycle earlier (cycle 4).
const prog: Instr[] = [
  { text: 'addi a0, a0, 4', dest: 'a0', srcs: ['a0'] },
  { text: 'lw t0, 0(a1)', dest: 't0', srcs: ['a1'], load: true },
  { text: '.word 0', srcs: [] },
  { text: 'add t2, t3, t4', dest: 't2', srcs: ['t3', 't4'] },
  { text: 'sw t2, 0(a2)', srcs: ['t2', 'a2'] },
];
const addr = (i: number) => '0x' + (0x00400100 + 4 * i).toString(16).padStart(8, '0');
const ex = schedule(prog, true);
if (ex.join() !== '3,4,5,6,7') throw new Error(`EX cycles ${ex}`);
const faultCycle = ex[1] + 1, illegalCycle = ex[2] - 1, handlerIF = faultCycle + 1;
if (faultCycle !== 5 || illegalCycle !== 4 || handlerIF !== 6) throw new Error('fault timing');
const mepc = addr(1), mtval = '0x10040000', mcause = 13;
const grid = cells(prog, true).map((row) => row.filter((c) => c.cycle <= faultCycle));
const handler = ['IF', 'ID', 'EX', 'MEM', 'WB'].map((stage, k) => ({ cycle: handlerIF + k, stage }));
const N = handlerIF + 4;

const t = ru
  ? { cycle: 'такт', handler: 'csrrw sp, mscratch, sp', hAddr: 'mtvec', flushed: 'сброшены', trap: 'ловушка',
      regs: `mepc = ${mepc} (lw), mcause = ${mcause}, mtval = ${mtval}`,
      steps: ['addi проходит все стадии и завершается в такте 5: всё, что раньше lw, выполнено полностью',
        'в такте 4 ID замечает недопустимую команду .word 0, но только помечает её в регистре конвейера',
        'в такте 5 lw обращается к неотображённой странице: это самая старая команда с исключением, и ловушка срабатывает сейчас',
        `lw и три команды за ней сбрасываются, ни одна ничего не записала; mepc = ${mepc}, mcause = ${mcause}`,
        'в такте 6 по адресу из mtvec выбирается первая команда обработчика'] }
  : { cycle: 'cycle', handler: 'csrrw sp, mscratch, sp', hAddr: 'mtvec', flushed: 'flushed', trap: 'trap',
      regs: `mepc = ${mepc} (the lw), mcause = ${mcause}, mtval = ${mtval}`,
      steps: ['addi goes through every stage and completes in cycle 5: everything before the lw is finished',
        'in cycle 4, ID finds that .word 0 is an illegal instruction, but only marks it in the pipeline register',
        'in cycle 5 the lw touches an unmapped page: it is the oldest instruction with an exception, so the trap is taken now',
        `the lw and the three instructions behind it are flushed, none has written anything; mepc = ${mepc}, mcause = ${mcause}`,
        'in cycle 6 the first instruction of the handler is fetched from the address in mtvec'] };

interface Layout { cls: string; W: number; H: number; wide: boolean; x0: number; cw: number; y0: number; rh: number; ch: number; labelDy: number; fs: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 376, wide: true, x0: 236, cw: 51, y0: 40, rh: 46, ch: 30, labelDy: 0, fs: 12.5 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 448, wide: false, x0: 14, cw: 34, y0: 66, rh: 44, ch: 28, labelDy: 0, fs: 11 },
];
const id = 'precise-exception';
const mono = 'font-family: var(--mono)';
const stepOf = (i: number, cycle: number) => (i === 1 && cycle === faultCycle ? 3 : i === 2 && cycle === illegalCycle ? 2 : 1);
---

<Figure
  id={id}
  title={ru ? 'Точное исключение в конвейере: ловушка относится к самой старой команде' : 'A precise exception in the pipeline: the trap belongs to the oldest instruction'}
  caption={ru
    ? `Пять команд по адресам с ${addr(0)}; клетки — стадии по тактам, как в заметке о конвейере. Команда .word 0 недопустима, и ID замечает это уже в такте ${illegalCycle}; lw обращается к неотображённой странице только в MEM, в такте ${faultCycle}. Если бы конвейер уходил в ловушку по первому замеченному исключению, mepc указал бы на .word 0, хотя раньше в программе стоит lw. Поэтому исключение лишь помечается и движется вместе с командой до точки, где команды завершаются по порядку; ловушка срабатывает для самой старой из них: ${t.regs}. addi завершается, четыре команды сбрасываются, а недопустимая команда снова вызовет своё исключение, когда её выберут после возврата из обработчика.`
    : `Five instructions starting at ${addr(0)}; cells are stages by cycle, as in the pipelining note. .word 0 is an illegal instruction, and ID notices it already in cycle ${illegalCycle}; the lw touches an unmapped page only in MEM, in cycle ${faultCycle}. A pipeline that took the first exception it noticed would set mepc to the .word 0, although the lw comes earlier in the program. So an exception is only marked and travels with its instruction to the point where instructions complete in order, and the trap is taken for the oldest one: ${t.regs}. The addi completes, four instructions are flushed, and the illegal instruction raises its exception again when it is fetched after the handler returns.`}
>
  {layouts.map((L) => {
    const cx = (c: number) => L.x0 + (c - 1) * L.cw;
    const ry = (i: number) => L.y0 + i * L.rh + (i === 5 && !L.wide ? 36 : 0);
    const cellW = L.cw - 4;
    const cellText = (x: number, y: number, s: string, cls = 'f-small') => (
      <text class={cls} x={x + cellW / 2} y={y + L.ch / 2 + L.fs * 0.36} text-anchor="middle" style={`font-size: ${L.fs}px`}>{s}</text>
    );
    const trapX = cx(faultCycle + 1) - 2;
    const flushTop = ry(1) - 4, flushBottom = ry(4) + L.ch + 4;
    const notesY = ry(5) + L.ch + (L.wide ? 30 : 34);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Точное исключение: сброс конвейера и переход к обработчику' : 'A precise exception: flushing the pipeline and entering the handler'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? `Сетка: шесть строк (addi, lw, .word 0, add, sw и первая команда обработчика) и ${N} тактов. В такте 4 клетка ID команды .word 0 жёлтая: исключение замечено и помечено. В такте 5 клетка MEM команды lw красная: страничный отказ. После такта 5 вертикальная линия «ловушка»; строки lw, .word 0, add и sw закрыты как сброшенные. Строка обработчика начинается с IF в такте 6.`
          : `A grid of six rows (addi, lw, .word 0, add, sw and the first handler instruction) and ${N} cycles. In cycle 4 the ID cell of .word 0 is amber: the exception is noticed and marked. In cycle 5 the MEM cell of the lw is red: a page fault. After cycle 5 a vertical line marked trap; the rows of lw, .word 0, add and sw are covered as flushed. The handler row starts with IF in cycle 6.`}</desc>

        <text class="f-small f-t-muted" x={L.wide ? 14 : L.x0} y={L.wide ? L.y0 - 16 : 18}>{t.cycle}</text>
        {Array.from({ length: N }, (_, k) => (
          <text class="f-small f-t-muted" x={cx(k + 1) + cellW / 2} y={L.wide ? L.y0 - 16 : 38} text-anchor="middle">{k + 1}</text>
        ))}

        {prog.map((ins, i) => (
          <g>
            {L.wide && <text class="f-small f-t-muted" x="14" y={ry(i) + L.ch / 2 + 4.5} style={mono}>{addr(i)}</text>}
            <text class="f-small" x={L.wide ? 108 : cx(faultCycle + 1) + 10} y={ry(i) + L.ch / 2 + 4.5} style={mono}>{ins.text}</text>
            {grid[i].map((c) => {
              const s = stepOf(i, c.cycle);
              const cls = s === 3 ? 'f-fill-red f-red' : s === 2 ? 'f-fill-amber f-amber' : 'f-fill-blue f-blue';
              return (
                <g data-s={String(s)}>
                  <rect x={cx(c.cycle)} y={ry(i)} width={cellW} height={L.ch} rx="5" class={cls} style={s === 2 ? 'stroke-width: 1.4; stroke-dasharray: 4 3' : `stroke-width: ${s === 3 ? 2 : 1.1}`} />
                  {cellText(cx(c.cycle), ry(i), c.stage)}
                </g>
              );
            })}
          </g>
        ))}
        <g data-s="4">
          <rect x={L.wide ? 10 : 8} y={flushTop} width={trapX - (L.wide ? 14 : 10)} height={flushBottom - flushTop} rx="6" style="fill: var(--paper); fill-opacity: 0.62; stroke: var(--muted); stroke-width: 1.2; stroke-dasharray: 5 4" />
          <text class="f-small f-t-muted f-halo" x={L.wide ? trapX + 8 : 14} y={L.wide ? (flushTop + flushBottom) / 2 + 4 : flushBottom + 16} style="font-weight: 650">{t.flushed}</text>
          <text class="f-small f-t-red" x="14" y={notesY} style={mono}>{L.wide ? t.regs : t.regs.split(', ').slice(0, 1)}</text>
          {!L.wide && <text class="f-small f-t-red" x="14" y={notesY + 20} style={mono}>{t.regs.split(', ').slice(1).join(', ')}</text>}
          <Badge x={L.wide ? trapX + 92 : 26} y={L.wide ? (flushTop + flushBottom) / 2 : ry(1) + L.ch / 2} n={4} />
        </g>
        <g data-s="2"><Badge x={cx(illegalCycle) - 10} y={ry(2) - 6} n={2} /></g>
        <g data-s="3">
          <path class="f-line f-red f-dash" d={`M ${trapX} ${L.y0 - 8} V ${L.wide ? ry(5) + L.ch + 6 : ry(4) + L.ch + 6}`} />
          <text class="f-small f-t-red f-halo" x={trapX + 6} y={L.wide ? ry(0) + L.ch / 2 + 4 : L.y0 - 8} style="font-weight: 650">{t.trap}</text>
          <Badge x={cx(faultCycle) - 10} y={ry(1) - 6} n={3} />
        </g>
        <g data-s="1"><Badge x={L.wide ? cx(faultCycle) + cellW + 14 : cx(faultCycle) + cellW / 2} y={L.wide ? ry(0) + L.ch / 2 + 20 : ry(0) - 10} n={1} /></g>
        <g data-s="5">
          <text class="f-small f-t-muted" x="14" y={L.wide ? ry(5) + L.ch / 2 + 4.5 : ry(5) - 8} style={mono}>{t.hAddr}</text>
          <text class="f-small" x={L.wide ? 108 : 80} y={L.wide ? ry(5) + L.ch / 2 + 4.5 : ry(5) - 8} style={mono}>{t.handler}</text>
          {handler.map((c) => (
            <g>
              <rect x={cx(c.cycle)} y={ry(5)} width={cellW} height={L.ch} rx="5" class="f-fill-amber f-amber" style="stroke-width: 1.1" />
              {cellText(cx(c.cycle), ry(5), c.stage)}
            </g>
          ))}
          <Badge x={cx(handlerIF) - 14} y={ry(5) + L.ch / 2} n={5} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
