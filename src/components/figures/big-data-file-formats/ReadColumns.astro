---
import Figure from '../Figure.astro';

const ru = Astro.props.lang === 'ru';
const title = ru ? 'Для суммы нужны два фрагмента в каждой группе' : 'The sum needs two chunks per row group';
const caption = ru
  ? 'В каждой группе читаем shop_id и amount_cents. Остальные столбцы показаны одним блоком.'
  : 'In each row group we read shop_id and amount_cents. The other columns are shown as one block.';
const columns = ['shop_id', 'amount_cents', ru ? 'Ещё 8 полей' : '8 other fields'];
---
<Figure id="big-data-read-columns" title={title} caption={caption}>
  <svg viewBox="0 0 340 160" role="img" aria-labelledby="read-columns-title read-columns-desc" style="max-width: 520px; margin-inline: auto">
    <title id="read-columns-title">{title}</title>
    <desc id="read-columns-desc">{caption}</desc>
    {[1, 2].map((group, i) => (
      <g transform={`translate(0 ${i * 73})`}>
        <text class="f-label" x="7" y="21">{ru ? 'Группа' : 'Row group'} {group}</text>
        {columns.map((label, j) => (
          <g transform={`translate(${7 + j * 110} 0)`}>
            <rect class={j < 2 ? 'f-fill-blue' : 'f-box-soft'} x="0" y="31" width="106" height="34" rx="5" />
            <text class="f-label" x="53" y="52" text-anchor="middle">{label}</text>
          </g>
        ))}
      </g>
    ))}
  </svg>
</Figure>
