---
// Original finite cost example and diagram, Fedor Pakhurov project, AI-assisted.
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
const ru = pageLang(Astro.url)==='ru';
const costs = [0,2,2,7];
const rows = [...new Set(costs)].map(x=>({x,p:costs.filter(v=>v===x).length/costs.length}));
const mean=costs.reduce((a,b)=>a+b,0)/costs.length;
const median=(costs[1]+costs[2])/2;
const mode=rows.reduce((a,b)=>a.p>b.p?a:b).x;
if(mean!==2.75||median!==2||mode!==2)throw new Error('Cost centres drift');
const sx=(x:number)=>35+x*290/7,sy=(p:number)=>180-p*200;
---
<Figure id="mean-median-mode"
 title={ru?'Центр зависит от вопроса':'The centre depends on the question'}
 caption={ru?'Четыре равновероятных плана стоят 0, 2, 2 и 7. Мода и медиана равны 2; вероятностное среднее — 2.75. Высоты стержней показывают массы, а не плотность непрерывной величины.':'Four equiprobable plans cost 0, 2, 2 and 7. Mode and median are 2; the probability-weighted mean is 2.75. Stem heights represent probability masses, not a continuous density.'}>
 <svg class="cost-centres" viewBox="0 0 360 240" role="img" aria-labelledby="cost-centres-title cost-centres-desc">
  <title id="cost-centres-title">{ru?'Три массы и отмеченное среднее':'Three probability masses and the mean'}</title>
  <desc id="cost-centres-desc">{ru?'Массы 1/4, 1/2, 1/4 в точках 0, 2, 7. Среднее 11/4 отмечено между 2 и 7.':'Masses 1/4, 1/2, 1/4 at 0, 2, 7. The mean 11/4 is marked between 2 and 7.'}</desc>
  <path d="M 24 180 H 338" stroke="var(--line)"/>
  {rows.map(r=><g data-cost={r.x}>
   <path d={`M ${sx(r.x)} 180 V ${sy(r.p)}`} stroke="var(--fig-blue)" stroke-width="4"/>
   <circle cx={sx(r.x)} cy={sy(r.p)} r="5" fill="var(--fig-blue)"/>
   <text x={sx(r.x)} y={sy(r.p)-12} text-anchor="middle">{r.p===.5?'1/2':'1/4'}</text>
   <text x={sx(r.x)} y="201" text-anchor="middle">{r.x}</text>
  </g>)}
  <path d={`M ${sx(mean)} 35 V 184`} stroke="var(--fig-amber)" stroke-width="2" stroke-dasharray="5 4"/>
  <text x={sx(mean)} y="23" text-anchor="middle">μ = {mean}</text>
  <text x="180" y="228" text-anchor="middle">{ru?'медиана = мода = 2':'median = mode = 2'}</text>
 </svg>
</Figure>
<style>
 .cost-centres{display:block;width:100%;max-width:520px;height:auto;margin:auto}
 .cost-centres text{fill:var(--ink);font-family:inherit;font-size:14px;font-variant-numeric:tabular-nums}
</style>
