---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { phi } from '../normal';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The log-normal Y = e^X, X ~ N(0, 1): the mode e^-1, the median e^0 and the mean e^(1/2) are three different centres.
// The mean is the balance point of the density, pulled right by the long tail.
const f = (y: number) => phi(Math.log(y)) / y;
const marks = [
  { v: Math.exp(-1), en: 'mode', ru: 'мода', tone: 'green' },
  { v: 1, en: 'median', ru: 'медиана', tone: 'blue' },
  { v: Math.exp(0.5), en: 'mean', ru: 'среднее', tone: 'red' },
];
if (marks.map((m) => m.v.toFixed(3)).join() !== '0.368,1.000,1.649') throw new Error('MeanMedianMode: values drifted from the note');
const ys = Array.from({ length: 200 }, (_, i) => 0.02 + i * 0.03);
const leftYs = ys.filter((y) => y <= 1.0001);
const halfPath = (sx: (v: number) => number, sy: (v: number) => number) =>
  `M ${sx(0)} ${sy(0)} ${leftYs.map((y) => `L ${sx(y).toFixed(1)} ${sy(f(y)).toFixed(1)}`).join(' ')} L ${sx(1)} ${sy(0)} Z`;
const id = 'mean-median-mode';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 620, H: 280, x0: 40, x1: 590, y0: 40, y1: 220, },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 300, x0: 24, x1: 344, y0: 64, y1: 240, },
];
---

<Figure
  id={id}
  title={ru ? 'Мода, медиана и среднее асимметричного распределения' : 'Mode, median and mean of a skewed distribution'}
  caption={ru
    ? 'Логнормальное распределение Y = eˣ, X ~ N(0, 1). Плотность выше всего в моде e⁻¹ ≈ 0.368; медиана e⁰ = 1 делит вероятность пополам; среднее e^(1/2) ≈ 1.649 — точка равновесия плотности (треугольник), и длинный правый хвост сдвигает её вправо от медианы.'
    : 'The log-normal distribution Y = eˣ, X ~ N(0, 1). The density is highest at the mode e⁻¹ ≈ 0.368; the median e⁰ = 1 splits the probability in half; the mean e^(1/2) ≈ 1.649 is the balance point of the density (the triangle), and the long right tail pulls it to the right of the median.'}
>
  {layouts.map((L) => {
    const sx = scale([0, 6], [L.x0, L.x1]), sy = scale([0, 0.7], [L.y1, L.y0]);
    const half = halfPath(sx, sy);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Логнормальная плотность с отмеченными модой, медианой и средним' : 'The log-normal density with mode, median and mean marked'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Асимметричная плотность с пиком около 0.37, медианой 1 и средним 1.65; левая половина вероятности закрашена.' : 'A skewed density peaking near 0.37, with median 1 and mean 1.65; the left half of the probability is shaded.'}</desc>
        <path d={half} class="f-fill-blue" />
        <path class="f-line" d={polyline(ys.map((y) => [sx(y), sy(f(y))]))} />
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {[0, 1, 2, 3, 4, 5, 6].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{v}</text>)}
        {marks.map((m, i) => (
          <g>
            <path class={`f-thin f-${m.tone} f-dash`} d={`M ${sx(m.v)} ${L.y1} V ${sy(0.68) + i * 18 - 4}`} />
            <text class={`f-small f-t-${m.tone}`} x={sx(m.v) + 6} y={sy(0.68) + i * 18}>{`${ru ? m.ru : m.en} ${m.v.toFixed(2)}`}</text>
          </g>
        ))}
        <path d={`M ${sx(marks[2].v)} ${L.y1 + 2} l -8 14 h 16 Z`} class="f-solid-red" />
        <text class="f-note" x={sx(0.5)} y={sy(0.1)} text-anchor="middle">{ru ? '50%' : '50%'}</text>
      </svg>
    );
  })}
</Figure>
