---
// Original staged-retry example. Filename/anchor retained for old incoming links.
// No coupon collection, old waterfall, Stepper, geometry or random code reused.
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
const ru=pageLang(Astro.url)==='ru';
const stages=[{num:3,den:4},{num:1,den:3},{num:2,den:5}];
const mean=stages.reduce((s,p)=>s+p.den/p.num,0);
if(Math.abs(mean-41/6)>1e-12)throw new Error('Retry expectation drift');
const ratio=(n:number,d:number)=>d===1?`${n}`:`${n}/${d}`;
---
<Figure id="coupon-collector"
 title={ru?'Последовательные этапы с повторением текущей попытки':'Sequential stages retry the current step'}
 caption={ru?'Неудача остаётся на текущем этапе; успех переводит дальше. Попытки независимы, вероятности постоянны. Средние числа попыток складываются, но их сумма не задаёт срок завершения отдельного задания.':'Failure stays at the current stage; success advances. Attempts are independent and probabilities are constant. Mean attempt counts add, but their sum does not specify an individual job’s completion deadline.'}>
 <ol class="retry-stages">{stages.map((p,i)=><li data-retry-stage={i+1}>
  <h4>{ru?'Этап':'Stage'} {i+1}</h4>
  <p>{ru?'Успех':'Success'}: <strong>{ratio(p.num,p.den)}</strong></p>
  <p>{ru?'Повтор':'Retry'}: {ratio(p.den-p.num,p.den)}</p>
  <p class="attempts">E[T<sub>{i+1}</sub>] = <strong>{ratio(p.den,p.num)}</strong></p>
  <p class="next">{i===2?(ru?'Успех → готово':'Success → done'):(ru?'Успех → следующий этап':'Success → next stage')}</p>
 </li>)}</ol>
 <p class="retry-total">E[T] = 4/3 + 3 + 5/2 = <strong>41/6 ≈ {mean.toFixed(3)}</strong></p>
</Figure>
<style>
 .retry-stages{display:grid;gap:.7rem;padding:0;margin:0;list-style:none;font-size:.875rem;font-variant-numeric:tabular-nums}
 .retry-stages li{border:1px solid var(--line);border-radius:.5rem;padding:.7rem;min-width:0}
 .retry-stages h4{font:inherit;font-weight:650;margin:0 0 .4rem}
 .retry-stages p{margin:.2rem 0;line-height:1.4}
 .retry-stages .attempts{margin-top:.6rem}
 .retry-stages .next{margin-top:.6rem;color:var(--text-muted)}
 .retry-total{font-size:.875rem;text-align:center;font-variant-numeric:tabular-nums;margin:.8rem 0 0}
 @media(min-width:45rem){.retry-stages{grid-template-columns:repeat(3,minmax(0,1fr))}}
</style>
