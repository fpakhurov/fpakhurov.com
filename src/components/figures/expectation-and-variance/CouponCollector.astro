---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Rolls of a die until all six faces have appeared. After k − 1 faces have been seen, each roll shows a new one with
// probability (7 − k)/6, so the wait for the k-th new face is geometric with mean 6/(7 − k). By linearity the total is the sum.
const waits = [1, 2, 3, 4, 5, 6].map((k) => ({ k, num: 7 - k, mean: 6 / (7 - k) }));
let acc = 0;
const rows = waits.map((w) => { const r = { ...w, start: acc }; acc += w.mean; return r; });
const total = acc;
if (total.toFixed(1) !== '14.7' || rows.map((r) => +r.mean.toFixed(2)).join() !== '1,1.2,1.5,2,3,6') throw new Error('CouponCollector: numbers drifted from the note');
const ord = ru ? ['1-я', '2-я', '3-я', '4-я', '5-я', '6-я'] : ['1st', '2nd', '3rd', '4th', '5th', '6th'];
const t = ru
  ? { face: 'новая грань', p: (n: number) => `p = ${n}/6 за бросок`, total: `все шесть граней: ${total.toFixed(1)} броска`,
      steps: rows.map((r, i) => (i === 0 ? 'первый бросок всегда даёт новую грань: 1 бросок' : i === 5 ? `последняя грань: p = 1/6, в среднем 6 бросков; всего ${total.toFixed(1)}` : `новая грань с вероятностью ${r.num}/6: в среднем 6/${r.num} = ${+r.mean.toFixed(2)} броска`)) }
  : { face: 'new face', p: (n: number) => `p = ${n}/6 per roll`, total: `all six faces: ${total.toFixed(1)} rolls`,
      steps: rows.map((r, i) => (i === 0 ? 'the first roll always shows a new face: 1 roll' : i === 5 ? `the last face: p = 1/6, 6 rolls on average; ${total.toFixed(1)} in total` : `a new face with probability ${r.num}/6: 6/${r.num} = ${+r.mean.toFixed(2)} rolls on average`)) };
const id = 'coupon-collector';
const layouts = [
  { cls: 'fig-wide', W: 720, H: 330, lx: 16, bx0: 190, bx1: 690, y0: 20, rh: 42 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 350, lx: 8, bx0: 140, bx1: 344, y0: 20, rh: 46 },
];
const place = (L: (typeof layouts)[number], r: (typeof rows)[number]) => {
  const sx = scale([0, 15], [L.bx0, L.bx1]);
  const end = sx(r.start + r.mean), room = L.bx1 - end;
  return { x: sx(r.start), w: sx(r.start + r.mean) - sx(r.start), tx: room > 36 ? end + 6 : end - 6, anchor: room > 36 ? 'start' : 'end', inside: room <= 36 };
};
---

<Figure
  id={id}
  title={ru ? 'Сколько бросков нужно, чтобы увидеть все грани кости' : 'How many rolls it takes to see every face of a die'}
  caption={ru
    ? `Среднее время ожидания каждой следующей новой грани. Пока видно k − 1 граней, новая выпадает с вероятностью (7 − k)/6, и ждать её в среднем 6/(7 − k) бросков (геометрическое распределение). По линейности ожидания всё складывается: 1 + 1.2 + 1.5 + 2 + 3 + 6 = ${total.toFixed(1)}. Последняя грань стоит 6 бросков — больше, чем первые четыре вместе.`
    : `The expected wait for each next new face. With k − 1 faces seen, a new one appears with probability (7 − k)/6, and the wait for it is 6/(7 − k) rolls on average (a geometric distribution). By linearity of expectation the waits add up: 1 + 1.2 + 1.5 + 2 + 3 + 6 = ${total.toFixed(1)}. The last face costs 6 rolls, more than the first four together.`}
>
  {layouts.map((L) => {
    const sx = scale([0, 15], [L.bx0, L.bx1]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Каскадная диаграмма шести средних ожиданий' : 'A waterfall of the six expected waits'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? `Шесть полос длиной 1, 1.2, 1.5, 2, 3 и 6, каждая начинается там, где кончилась предыдущая; всего ${total.toFixed(1)}.` : `Six bars of length 1, 1.2, 1.5, 2, 3 and 6, each starting where the previous one ended; ${total.toFixed(1)} in total.`}</desc>
        {[0, 5, 10, 15].map((v) => <g><path class="f-grid" d={`M ${sx(v)} ${L.y0} V ${L.y0 + 6 * L.rh + 30}`} /><text class="f-note" x={sx(v)} y={L.y0 + 6 * L.rh + 48} text-anchor="middle">{v}</text></g>)}
        {rows.map((r, i) => {
          const P = place(L, r), y = L.y0 + i * L.rh;
          return (
            <g data-s={i + 1}>
              <text class="f-small" x={L.lx + 24} y={y + 16}>{`${ord[i]} ${t.face}`}</text>
              <text class="f-note" x={L.lx + 24} y={y + 34}>{t.p(r.num)}</text>
              <rect x={P.x} y={y + 8} width={P.w} height={24} rx="3" style={`fill: var(--fig-${i === 5 ? 'red' : 'blue'}); fill-opacity: .45`} />
              <text class="f-small" x={P.tx} y={y + 25} text-anchor={P.anchor}>{`${+r.mean.toFixed(2)}`}</text>
              <Badge x={L.lx + 9} y={y + 20} n={i + 1} />
            </g>
          );
        })}
        <g data-s="6">
          <path class="f-line" d={`M ${sx(0)} ${L.y0 + 6 * L.rh + 14} H ${sx(total)}`} marker-end="url(#f-arrow)" />
          <text class="f-small" x={sx(0)} y={L.y0 + 6 * L.rh + 8}>{t.total}</text>
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
