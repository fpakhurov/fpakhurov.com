---
// Original executed four-parameter adaptation trace, no pretrained model.
import Figure from '../Figure.astro';
import {pageLang} from '../../../utils/lang';
import cases from './cases.json';
const ru=pageLang(Astro.url)==='ru';
const px=(step:number)=>48+step;
const py=(loss:number)=>218-loss*150;
const curve=cases.history.map(row=>`${px(row.step)},${py(row.target_nll)}`).join(' ');
const best=cases.frozen_optimal_target_nll;
---
<Figure id="adaptation-trajectory" title={ru?'Изменение представления снимает ограничение потерь':'Changing the representation removes the loss restriction'} caption={ru?'Четыре точки, шаг 0.2, одновременные обновления a₁,a₂,w,b. Линии соединяют сохранённые состояния; пунктир — оптимум головы над h=x₁. Все потери вычислены на этих же четырёх обучающих точках.':'Four points, step size 0.2, simultaneous updates of a₁,a₂,w,b. Lines join recorded checkpoints; the dashed line is the optimal head over h=x₁. All losses use these same four training points.'}>
 <div class="layout">
 <svg viewBox="0 0 340 270" role="img" aria-labelledby="adaptation-title adaptation-desc">
  <title id="adaptation-title">{ru?'Целевая потеря при изменении представления':'Target loss while changing the representation'}</title>
  <desc id="adaptation-desc">{ru?'NLL убывает от 1.126928 до 0.002325 за 240 обновлений. Оптимальная замороженная потеря равна 0.693147. На двадцатом обновлении целевая точность уже единица, а согласие с исходными метками падает до половины.':'NLL falls from 1.126928 to 0.002325 over 240 updates. The optimal frozen loss is 0.693147. By update twenty target accuracy is one while agreement with the original labels is one half.'}</desc>
  <path d="M48 24 V218 H300" class="f-axis" />
  {[0,.4,.8,1.2].map(v=><g><line x1="43" x2="48" y1={py(v)} y2={py(v)} class="f-axis" /><text x="37" y={py(v)+4} text-anchor="end">{v}</text></g>)}
  {[0,60,120,180,240].map(v=><g><line x1={px(v)} x2={px(v)} y1="218" y2="223" class="f-axis" /><text x={px(v)} y="244" text-anchor="middle">{v}</text></g>)}
  <text x="13" y="18">NLL</text><text x="170" y="265" text-anchor="middle">{ru?'Обновления':'Updates'}</text>
  <line data-series="frozen-optimum" x1="48" x2="288" y1={py(best)} y2={py(best)} stroke="var(--fig-amber)" stroke-width="2" stroke-dasharray="6 4" />
  <polyline data-series="adapted" points={curve} fill="none" stroke="var(--fig-blue)" stroke-width="2.5" />
  {cases.history.map(row=><circle cx={px(row.step)} cy={py(row.target_nll)} r="3.3" fill="var(--fig-blue)" />)}
 </svg>
 <div class="legend"><p><span class="line blue"></span>{ru?'Обучаем представление и голову':'Train representation and head'}</p><p><span class="line amber"></span>{ru?'Лучший результат при h=x₁':'Best loss with h=x₁'}</p><p class="limit">{ru?'Это проверка механизма на заданных точках. Отложенная выборка отсутствует.':'This is a mechanism check on specified points. There is no held-out set.'}</p></div>
 </div>
</Figure>
<style>
.layout{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:1.4rem;align-items:center;}svg{width:100%;height:auto;display:block;max-width:520px;margin:auto;}text{font:14px system-ui,sans-serif;fill:var(--ink);font-variant-numeric:tabular-nums;}.legend{font-size:.95rem;line-height:1.5;}.legend p{margin:.7rem 0;}.line{display:inline-block;width:1.6rem;margin-right:.5rem;vertical-align:middle;border-top:3px solid;}.blue{border-color:var(--fig-blue)}.amber{border-color:var(--fig-amber);border-top-style:dashed;}.limit{color:var(--muted)}@media(max-width:700px){.layout{grid-template-columns:1fr;gap:.5rem;}}
</style>
