---
// Original two-coordinate projection construction.
import Figure from '../Figure.astro';
import {pageLang} from '../../../utils/lang';
import cases from './cases.json';
const ru=pageLang(Astro.url)==='ru';
const groups=(a:number[])=>[-2,2].map(h=>({h,labels:cases.inputs.map((x,i)=>({h:x[0]*a[0]+x[1]*a[1],y:cases.target_labels[i]})).filter(x=>x.h===h).map(x=>x.y)}));
const panels=[{key:'frozen',formula:'h = x₁',groups:groups([1,0])},{key:'changed',formula:'h = 2x₂',groups:groups([0,2])}];
---
<Figure id="representation-bottleneck" title={ru?'Совпадающие представления скрывают различие меток':'Identical representations hide a label distinction'} caption={ru?'Те же четыре входа и целевые метки. При h=x₁ в каждой точке представлены оба класса; при h=2x₂ классы разделены. Полукруги обозначают метки, а не дополнительные координаты.':'The same four inputs and target labels. Under h=x₁ each location contains both classes; under h=2x₂ the classes separate. Half-circles encode labels, not additional coordinates.'}>
 <div class="panels">
 {panels.map(panel=><svg viewBox="0 0 320 190" role="img" aria-labelledby={`${panel.key}-title ${panel.key}-desc`}>
  <title id={`${panel.key}-title`}>{panel.formula}</title>
  <desc id={`${panel.key}-desc`}>{panel.key==='frozen'?(ru?'В точках минус два и два находятся по одной метке ноль и один.':'At both minus two and two there is one label zero and one label one.'):(ru?'В точке минус два две метки ноль; в точке два две метки один.':'At minus two there are two zero labels; at two there are two one labels.')}</desc>
  <text x="160" y="27" text-anchor="middle" class="heading">{panel.formula}</text><line x1="30" x2="290" y1="105" y2="105" class="f-axis" /><text x="293" y="110">h</text>
  {panel.groups.map((g,i)=><g><path data-projection={panel.key} data-location={g.h} d={`M${80+160*i} 88 A17 17 0 0 0 ${80+160*i} 122 Z`} fill={g.labels[0]===0?'var(--fig-blue)':'var(--fig-amber)'} /><path d={`M${80+160*i} 88 A17 17 0 0 1 ${80+160*i} 122 Z`} fill={g.labels[1]===0?'var(--fig-blue)':'var(--fig-amber)'} /><text x={80+160*i} y="70" text-anchor="middle">{g.labels.join(' + ')}</text><text x={80+160*i} y="151" text-anchor="middle">{g.h}</text></g>)}
 </svg>)}
 </div>
 <p class="legend"><span><i class="zero"></i>{ru?'Метка 0':'Label 0'}</span><span><i class="one"></i>{ru?'Метка 1':'Label 1'}</span></p>
</Figure>
<style>
.panels{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:1rem;}svg{width:100%;height:auto;display:block;max-width:450px;margin:auto;}text{font:14px system-ui,sans-serif;fill:var(--ink);font-variant-numeric:tabular-nums;}.heading{font-size:18px;}.legend{display:flex;justify-content:center;gap:1.5rem;font-size:.9rem;}.legend i{display:inline-block;width:.8rem;height:.8rem;margin-right:.4rem;}.zero{background:var(--fig-blue)}.one{background:var(--fig-amber)}
</style>
