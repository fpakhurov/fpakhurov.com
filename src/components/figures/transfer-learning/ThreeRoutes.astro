---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One pretrained encoder, three ways to use it on AG News; accuracies from the note.
type Box = { label: string; tone: 'soft' | 'blue' | 'amber' | 'plain' };
const routes: { title: string; boxes: [Box, Box, Box]; acc: number; grad: boolean }[] = [
  { title: ru ? 'zero-shot: заполнение пропуска' : 'zero-shot cloze', acc: 0.613, grad: false, boxes: [
    { label: ru ? 'статья +\nшаблон' : 'article +\ntemplate', tone: 'plain' },
    { label: ru ? 'BERT\nзаморожен' : 'BERT\nfrozen', tone: 'soft' },
    { label: ru ? 'выход MLM,\n4 слова-метки' : 'MLM head,\n4 label words', tone: 'soft' },
  ] },
  { title: ru ? 'замороженные признаки' : 'frozen features', acc: 0.902, grad: false, boxes: [
    { label: ru ? 'статья' : 'article', tone: 'plain' },
    { label: ru ? 'BERT\nзаморожен' : 'BERT\nfrozen', tone: 'soft' },
    { label: ru ? 'лог. регрессия\nпо [CLS]' : 'logistic reg.\non [CLS]', tone: 'amber' },
  ] },
  { title: ru ? 'полное дообучение' : 'full fine-tuning', acc: 0.949, grad: true, boxes: [
    { label: ru ? 'статья' : 'article', tone: 'plain' },
    { label: ru ? 'BERT\nобучается' : 'BERT\ntrained', tone: 'blue' },
    { label: ru ? 'линейный слой\nпо [CLS]' : 'linear head\non [CLS]', tone: 'amber' },
  ] },
];
const tfidf = 0.918;
const fillCls: Record<Box['tone'], string> = { soft: 'f-box-soft', blue: 'f-box f-fill-blue', amber: 'f-box f-fill-amber', plain: 'f-box' };
const t = ru
  ? { trained: 'обучается', frozen: 'заморожено', grad: 'градиент', base: 'TF-IDF 0.918' }
  : { trained: 'trained', frozen: 'frozen', grad: 'gradient', base: 'TF-IDF 0.918' };
const id = 'transfer-three-routes';
interface Layout { cls: string; W: number; H: number; narrow: boolean; xs: number[]; ws: number[]; rowH: number; top: number; bar: [number, number]; boxH: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 700, H: 300, narrow: false, xs: [10, 160, 310], ws: [120, 120, 140], rowH: 90, top: 28, bar: [490, 690], boxH: 44 },
  { cls: 'fig-narrow', W: 360, H: 440, narrow: true, xs: [8, 118, 228], ws: [96, 96, 124], rowH: 140, top: 26, bar: [8, 352], boxH: 44 },
];
const lo = 0.5, hi = 1.0;
---

<Figure
  id={id}
  title={ru ? 'Три способа использовать один предобученный энкодер' : 'Three ways to use one pretrained encoder'}
  caption={ru
    ? 'Одна и та же модель bert-base-uncased на AG News. Zero-shot ничего не обучает: к статье дописывается шаблон с [MASK], и ответом служит то из четырёх слов-меток, которое выходной слой MLM считает самым вероятным. Замороженные признаки обучают только логистическую регрессию поверх вектора [CLS]. Полное дообучение обучает и выходной слой, и весь энкодер (красная стрелка — градиент, проходящий в энкодер) с маленьким шагом обучения. Справа — доля правильных ответов; пунктир отмечает базовый уровень TF-IDF, 0.918, который превосходит только последний путь. Серые блоки заморожены, цветные обучаются.'
    : 'The same bert-base-uncased model on AG News. Zero-shot trains nothing: a template with [MASK] is appended to the article, and the answer is whichever of four label words the MLM head finds most probable. Frozen features train only a logistic regression on the [CLS] vector. Full fine-tuning trains the head and the whole encoder (the red arrow is the gradient flowing into the encoder) at a small learning rate. On the right, accuracy; the dashed line marks the TF-IDF baseline, 0.918, which only the last route beats. Grey boxes are frozen, coloured ones are trained.'}
>
  {layouts.map((L) => {
    const sx = (a: number) => L.bar[0] + ((a - lo) / (hi - lo)) * (L.bar[1] - L.bar[0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Zero-shot, замороженные признаки и полное дообучение' : 'Zero-shot, frozen features and full fine-tuning'}</title>
        <desc id={`${id}-${L.W}-d`}>{routes.map((r) => `${r.title}: ${r.boxes.map((b) => b.label.replace('\n', ' ')).join(' → ')}; ${r.acc.toFixed(3)}`).join('. ')}. {t.base}.</desc>
        {routes.map((r, ri) => {
          const y = L.top + ri * L.rowH;
          const by = y + 12;
          const barY = L.narrow ? by + L.boxH + 22 : by + 8;
          return (
            <g>
              <text class="f-small f-t-muted" x={L.xs[0]} y={y + 2} style="font-weight: 600">{r.title}</text>
              {r.boxes.map((b, bi) => {
                const lines = b.label.split('\n');
                return (
                  <g>
                    <rect class={fillCls[b.tone]} x={L.xs[bi]} y={by} width={L.ws[bi]} height={L.boxH} rx="6" />
                    {lines.map((line, li) => <text class="f-small" x={L.xs[bi] + L.ws[bi] / 2} y={by + L.boxH / 2 + 4 - ((lines.length - 1) * 15) / 2 + li * 15} text-anchor="middle">{line}</text>)}
                    {bi < 2 && <path class="f-thin f-muted" d={`M ${L.xs[bi] + L.ws[bi] + 2} ${by + L.boxH / 2} H ${L.xs[bi + 1] - 3}`} marker-end="url(#f-arrow-muted)" />}
                  </g>
                );
              })}
              {r.grad && <path class="f-thin f-red f-dash" d={`M ${L.xs[2] + L.ws[2] / 2} ${by + L.boxH + 2} V ${by + L.boxH + 12} H ${L.xs[1] + L.ws[1] / 2} V ${by + L.boxH + 3}`} marker-end="url(#f-arrow-red)" />}
              {r.grad && <text class="f-small f-t-red f-halo" x={(L.xs[1] + L.ws[1] / 2 + L.xs[2] + L.ws[2] / 2) / 2} y={by + L.boxH + 16} text-anchor="middle">{t.grad}</text>}
              <rect x={L.bar[0]} y={barY} width={sx(r.acc) - L.bar[0]} height="22" style={`fill: var(--fig-${r.acc > tfidf ? 'green' : 'blue'}); fill-opacity: .5`} />
              <text class="f-small" x={sx(r.acc) + 6} y={barY + 16}>{r.acc.toFixed(3)}</text>
              {L.narrow && <path class="f-thin f-red f-dash" d={`M ${sx(tfidf)} ${barY - 4} V ${barY + 26}`} />}
            </g>
          );
        })}
        {(() => {
          const x = sx(tfidf);
          const y0 = L.narrow ? L.top + 12 + L.boxH + 14 : L.top + 8;
          const y1 = L.narrow ? L.top + 2 * L.rowH + 12 + L.boxH + 48 : L.top + 2 * L.rowH + 50;
          return (
            <g>
              {!L.narrow && <path class="f-thin f-red f-dash" d={`M ${x} ${y0} V ${y1}`} />}
              <text class="f-small f-t-red" x={x} y={y1 + 16} text-anchor="middle">{t.base}</text>
            </g>
          );
        })()}
      </svg>
    );
  })}
</Figure>
