---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The likelihood of a coin's probability p after 7 heads in 10 flips and after 70 in 100, each divided by its maximum
// at p = 0.7. With ten times the data the curve is about √10 times narrower, and p = 0.5 falls from 0.44 to 0.0003.
const cases = [{ k: 7, n: 10, tone: 'blue' }, { k: 70, n: 100, tone: 'red' }];
const rel = (k: number, n: number, p: number) => Math.exp(k * Math.log(p / 0.7) + (n - k) * Math.log((1 - p) / 0.3));
const at05 = cases.map((c) => rel(c.k, c.n, 0.5));
if (at05.map((v) => v.toPrecision(2)).join() !== '0.44,0.00027') throw new Error('LikelihoodCurves: values drifted from the note');
const ps = Array.from({ length: 199 }, (_, i) => 0.005 + i * 0.005);
const t = ru
  ? { c: ['7 орлов из 10', '70 орлов из 100'], x: 'вероятность орла p', y: 'L(p) / L(0.7)', mle: 'p̂ = 0.7' }
  : { c: ['7 heads in 10', '70 heads in 100'], x: 'probability of heads p', y: 'L(p) / L(0.7)', mle: 'p̂ = 0.7' };
const id = 'likelihood-curves';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 300, x0: 50, x1: 580, y0: 30, y1: 240, leg: [70, 50] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 300, x0: 40, x1: 344, y0: 30, y1: 230, leg: [50, 46] },
];
---

<Figure
  id={id}
  title={ru ? 'Правдоподобие вероятности орла' : 'The likelihood of the probability of heads'}
  caption={ru
    ? `Правдоподобие L(p) = p^k (1 − p)^(n − k), делённое на максимум при p = 0.7. После 7 орлов из 10 значение p = 0.5 почти так же правдоподобно (отношение ${at05[0].toFixed(2)}); после 70 из 100 кривая втрое уже и отношение для p = 0.5 падает до ${at05[1].toPrecision(2)}. Кривизна логарифма правдоподобия в максимуме — информация Фишера: чем острее пик, тем точнее оценка.`
    : `The likelihood L(p) = p^k (1 − p)^(n − k), divided by its maximum at p = 0.7. After 7 heads in 10, p = 0.5 is nearly as likely (ratio ${at05[0].toFixed(2)}); after 70 in 100 the curve is three times narrower and the ratio for p = 0.5 drops to ${at05[1].toPrecision(2)}. The curvature of the log-likelihood at its maximum is the Fisher information: the sharper the peak, the more precise the estimate.`}
>
  {layouts.map((L) => {
    const sx = scale([0, 1], [L.x0, L.x1]), sy = scale([0, 1.05], [L.y1, L.y0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Две кривые правдоподобия' : 'Two likelihood curves'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Широкая кривая для 10 бросков и узкая для 100, обе с пиком в 0.7.' : 'A wide curve for 10 flips and a narrow one for 100, both peaking at 0.7.'}</desc>
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {[0, 0.25, 0.5, 0.75, 1].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{v}</text>)}
        {[0, 0.5, 1].map((v) => <g><path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} /><text class="f-note" x={L.x0 - 8} y={sy(v) + 5} text-anchor="end">{v}</text></g>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 42} text-anchor="middle">{t.x}</text>
        <path class="f-thin f-muted f-dash" d={`M ${sx(0.7)} ${L.y1} V ${sy(1.03)}`} />
        <text class="f-note" x={sx(0.7) + 6} y={sy(1.03) + 4}>{t.mle}</text>
        <path class="f-thin f-muted f-dash" d={`M ${sx(0.5)} ${L.y1} V ${sy(0.6)}`} />
        {cases.map((c) => <path class={`f-line f-${c.tone}`} d={polyline(ps.map((p) => [sx(p), sy(rel(c.k, c.n, p))]))} />)}
        <circle cx={sx(0.5)} cy={sy(at05[0])} r="4" class="f-solid-blue" />
        <text class="f-note f-t-blue" x={sx(0.5) - 8} y={sy(at05[0]) - 6} text-anchor="end">{at05[0].toFixed(2)}</text>
        {cases.map((c, i) => (
          <g>
            <path class={`f-line f-${c.tone}`} d={`M ${L.leg[0]} ${L.leg[1] + i * 22} h 24`} />
            <text class="f-note" x={L.leg[0] + 32} y={L.leg[1] + i * 22 + 5}>{t.c[i]}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
