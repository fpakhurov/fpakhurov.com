---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Three noise models (top) and their negative log-likelihoods (bottom), which are the familiar losses:
// Gaussian → squared error, Laplace → absolute error, Bernoulli → cross-entropy (log loss) of the true class.
const rs = Array.from({ length: 121 }, (_, i) => -3 + i * 0.05);
const ps = Array.from({ length: 99 }, (_, i) => 0.01 + i * 0.01);
const gauss = (r: number) => Math.exp(-r * r / 2) / Math.sqrt(2 * Math.PI);
const laplace = (r: number) => Math.exp(-Math.abs(r)) / 2;
const cols = ru
  ? [{ top: 'гауссовский шум', bot: '−log: r²/2 + const', name: 'квадратичная ошибка' }, { top: 'шум Лапласа', bot: '−log: |r| + const', name: 'абсолютная ошибка' }, { top: 'Бернулли: P(верный класс) = p', bot: '−log p', name: 'кросс-энтропия' }]
  : [{ top: 'Gaussian noise', bot: '−log: r²/2 + const', name: 'squared error' }, { top: 'Laplace noise', bot: '−log: |r| + const', name: 'absolute error' }, { top: 'Bernoulli: P(true class) = p', bot: '−log p', name: 'cross-entropy' }];
const id = 'losses-as-likelihoods';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 400, pos: (k: number) => [20 + k * 250, 40], pw: 220, ph: 110, gap: 190 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 1010, pos: (k: number) => [20, 40 + k * 335], pw: 320, ph: 100, gap: 175 },
];
---

<Figure
  id={id}
  title={ru ? 'Функции потерь — это минус логарифм правдоподобия' : 'Loss functions are negative log-likelihoods'}
  caption={ru
    ? 'Вверху — модель шума для остатка r = y − f(x) или для метки класса; внизу — минус логарифм её плотности, то есть потеря одного примера. Гауссовский шум даёт квадратичную ошибку, шум Лапласа — абсолютную, распределение Бернулли (или категориальное) — кросс-энтропию −log p верного класса. Минимизировать такую потерю по параметрам модели — значит максимизировать правдоподобие.'
    : 'Top: a noise model for the residual r = y − f(x), or for a class label; bottom: minus the log of its density, the loss of one example. Gaussian noise gives squared error, Laplace noise gives absolute error, the Bernoulli (or categorical) distribution gives the cross-entropy −log p of the true class. Minimizing such a loss over the parameters of a model is maximizing the likelihood.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Три модели шума и их потери' : 'Three noise models and their losses'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'Колокол над параболой, острый пик над буквой V, столбцы вероятностей над убывающей кривой −log p.' : 'A bell over a parabola, a sharp peak over a V, probability bars over the falling curve −log p.'}</desc>
      {cols.map((c, k) => {
        const [x0, y0] = L.pos(k), y1 = y0 + L.gap;
        const sxr = scale([-3, 3], [x0, x0 + L.pw]), sxp = scale([0, 1], [x0, x0 + L.pw]);
        const syd = scale([0, 0.55], [y0 + L.ph, y0]), syl = scale([0, 4.6], [y1 + L.ph, y1]);
        return (
          <g>
            <text class="f-small" x={x0} y={y0 - 12}>{c.top}</text>
            <path class="f-axis" d={`M ${x0} ${y0 + L.ph} H ${x0 + L.pw}`} />
            {k === 0 && <path class="f-line f-blue" d={polyline(rs.map((r) => [sxr(r), syd(gauss(r))]))} />}
            {k === 1 && <path class="f-line f-blue" d={polyline(rs.map((r) => [sxr(r), syd(laplace(r))]))} />}
            {k === 2 && <g>
              <rect x={sxp(0.15)} y={syd(0.3 * 0.75)} width={L.pw * 0.25} height={syd(0) - syd(0.3 * 0.75)} style="fill: var(--muted); fill-opacity: .35" />
              <rect x={sxp(0.6)} y={syd(0.7 * 0.75)} width={L.pw * 0.25} height={syd(0) - syd(0.7 * 0.75)} style="fill: var(--fig-blue); fill-opacity: .5" />
              <text class="f-note" x={sxp(0.275)} y={y0 + L.ph + 16} text-anchor="middle">1 − p</text>
              <text class="f-note" x={sxp(0.725)} y={y0 + L.ph + 16} text-anchor="middle">p</text>
            </g>}
            <text class="f-small f-t-red" x={x0} y={y1 - 28}>{c.name}</text>
            <text class="f-note" x={x0} y={y1 - 10}>{c.bot}</text>
            <path class="f-axis" d={`M ${x0} ${y1 + L.ph} H ${x0 + L.pw}`} />
            {k === 0 && <path class="f-line f-red" d={polyline(rs.map((r) => [sxr(r), syl(r * r / 2)]))} />}
            {k === 1 && <path class="f-line f-red" d={polyline(rs.map((r) => [sxr(r), syl(Math.abs(r))]))} />}
            {k === 2 && <path class="f-line f-red" d={polyline(ps.map((p) => [sxp(p), syl(-Math.log(p))]))} />}
            {(k === 2 ? [0, 0.5, 1] : [-2, 0, 2]).map((v) => <text class="f-note" x={k === 2 ? sxp(v) : sxr(v)} y={y1 + L.ph + 16} text-anchor="middle">{v}</text>)}
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
