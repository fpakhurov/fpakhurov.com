---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import data from './cases.json';
const ru=pageLang(Astro.url)==='ru',id='losses-as-likelihoods';
const title=ru?'Модель шума определяет подбираемый центр':'The noise model changes the fitted center';
const caption=ru?'Наблюдения −3,−1,0,2,5. Нормальная модель использует дисперсию 4, модель Лапласа — масштаб 2. Показано увеличение отрицательного логарифма правдоподобия относительно собственного минимума. Оптимумы находятся при среднем 0.6 и медиане 0.':'Observations −3,−1,0,2,5. The Gaussian model uses variance 4; the Laplace model uses scale 2. Curves show negative log-likelihood above each model’s own minimum. Optima occur at the mean 0.6 and median 0.';
const x=(m:number)=>60+230*(m+3)/7,y=(v:number)=>210-170*v/9;
const panels=[{key:'gaussian',label:ru?'Нормальная':'Gaussian',opt:.6,color:'var(--fig-blue)'},{key:'laplace',label:ru?'Лапласа':'Laplace',opt:0,color:'var(--fig-green)'}] as const;
---
<Figure id={id} title={title} caption={caption}>
 <div class="panels">
 {panels.map(({key,label,opt,color})=><svg viewBox="0 0 320 270" role="img" aria-labelledby={`${id}-${key}-title ${id}-${key}-desc`}>
  <title id={`${id}-${key}-title`}>{label}</title><desc id={`${id}-${key}-desc`}>{ru?'Нормальная цель квадратична и минимальна при 0.6. Цель Лапласа кусочно-линейна и минимальна при 0.':'The Gaussian objective is quadratic and minimizes at 0.6. The Laplace objective is piecewise linear and minimizes at 0.'}</desc>
  <text x="60" y="24">{label}</text>
  {[0,4.5,9].map(v=><g><path class="grid" d={`M60 ${y(v)}H290`}/><text x="53" y={y(v)+6} text-anchor="end">{v}</text></g>)}
  <path class="axis" d="M60 40V210H290"/>
  <polyline data-series={key} points={data.lossCurve.map(r=>`${x(r.shift)},${y(r[key])}`).join(' ')} fill="none" stroke={color} stroke-width="2.5"/>
  <circle data-optimum={key} cx={x(opt)} cy="210" r="4.5" fill={color}/>
  {[-3,0,4].map(v=><text x={x(v)} y="237" text-anchor="middle">{v}</text>)}<text x="175" y="262" text-anchor="middle">{ru?'Подбираемый центр':'Fitted location'}</text>
 </svg>)}
 </div>
</Figure>
<style>
.panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.panels svg{display:block;width:100%;height:auto;min-width:0}.panels text{font:18px var(--sans);fill:var(--ink);font-variant-numeric:tabular-nums}.axis{fill:none;stroke:var(--muted);stroke-width:1.3}.grid{fill:none;stroke:var(--line)}@media(max-width:700px){.panels{grid-template-columns:1fr}}
</style>
