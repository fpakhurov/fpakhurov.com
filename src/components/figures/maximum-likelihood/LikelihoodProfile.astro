---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import data from './cases.json';
const ru=pageLang(Astro.url)==='ru',id='likelihood-curves';
const title=ru?'Вероятность, лучше всего объясняющая наблюдения':'The best-fitting success probability';
const caption=ru?'Восемь единиц среди тринадцати независимых наблюдений Бернулли. Первая панель: L(p)/L(8/13); вторая: ℓ(p)−ℓ(8/13). Показаны p от 0.01 до 0.99. Обе кривые максимальны при 8/13; логарифм сохраняет положение максимума.':'Eight successes in thirteen independent Bernoulli observations. First panel: L(p)/L(8/13); second: ℓ(p)−ℓ(8/13). Plotted p values range from 0.01 to 0.99. Both curves maximize at 8/13; the logarithm preserves the maximizing parameter.';
const x=(p:number)=>60+230*p;
const panels=[{key:'relative',label:ru?'Относительное L':'Relative L',low:0,high:1,ticks:[0,.5,1]},{key:'relativeLog',label:ru?'Разность логарифмов':'Log difference',low:-32,high:0,ticks:[-32,-16,0]}] as const;
const y=(v:number,lo:number,hi:number)=>210-170*(v-lo)/(hi-lo);
---
<Figure id={id} title={title} caption={caption}>
 <div class="panels">
 {panels.map(({key,label,low,high,ticks})=><svg viewBox="0 0 320 270" role="img" aria-labelledby={`${id}-${key}-title ${id}-${key}-desc`}>
  <title id={`${id}-${key}-title`}>{label}</title><desc id={`${id}-${key}-desc`}>{ru?'Максимум при p около 0.6154. Значения ухудшаются по обе стороны от него.':'The maximum occurs near p=0.6154. Values worsen on either side.'}</desc>
  <text x="60" y="24">{label}</text>
  {ticks.map(v=><g><path class="grid" d={`M60 ${y(v,low,high)}H290`}/><text x="53" y={y(v,low,high)+6} text-anchor="end">{v}</text></g>)}
  <path class="axis" d="M60 40V210H290"/>
  <polyline data-series={key} points={data.likelihood.curve.map(r=>`${x(r.p)},${y(r[key],low,high)}`).join(' ')} class="profile"/>
  <circle data-mle={key} cx={x(data.likelihood.mle)} cy="40" r="4.5" fill="var(--fig-green)"/>
  {[0,.5,1].map(v=><text x={x(v)} y="237" text-anchor="middle">{v}</text>)}<text x="175" y="262" text-anchor="middle">p</text>
 </svg>)}
 </div>
</Figure>
<style>
.panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.panels svg{display:block;width:100%;height:auto;min-width:0}.panels text{font:18px var(--sans);fill:var(--ink);font-variant-numeric:tabular-nums}.axis{fill:none;stroke:var(--muted);stroke-width:1.3}.grid{fill:none;stroke:var(--line)}.profile{fill:none;stroke:var(--fig-blue);stroke-width:2.5}@media(max-width:700px){.panels{grid-template-columns:1fr}}
</style>
