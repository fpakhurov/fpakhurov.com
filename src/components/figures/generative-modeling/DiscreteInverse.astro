---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { mulberry32 } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Three outcomes with probabilities 0.2, 0.5, 0.3: the interval [0, 1) is cut at the running totals 0.2 and 0.7,
// and a uniform u returns the outcome whose piece contains it. The example u = 0.637 is the first number NumPy's
// default generator gives with seed 0.
const names = ['a', 'b', 'c'];
const p = [0.2, 0.5, 0.3];
const cuts = [0, 0.2, 0.7, 1];
const pick = (u: number) => (u < 0.2 ? 0 : u < 0.7 ? 1 : 2);
const uEx = 0.637;
if (pick(uEx) !== 1) throw new Error('DiscreteInverse: the example should give b');
const rand = mulberry32(5);
const counts = [0, 0, 0];
for (let i = 0; i < 10000; i += 1) counts[pick(rand())] += 1;
const shares = counts.map((c) => c / 10000);
if (shares.some((s, k) => Math.abs(s - p[k]) > 0.01)) throw new Error('DiscreteInverse: simulated shares far from p');
const colors = ['var(--fig-green)', 'var(--fig-blue)', 'var(--fig-amber)'];

const t = ru
  ? { u: 'u', F: 'F (накопленная вероятность)', hist: '10 000 сэмплов: доли', target: 'черта — нужная вероятность', out: 'исход' }
  : { u: 'u', F: 'F (running total)', hist: '10,000 draws: shares', target: 'tick: the required probability', out: 'outcome' };

type L = { cls: string; W: number; H: number; bar: [number, number, number, number]; plot: [number, number, number, number]; hist: [number, number, number, number] };
const layouts: L[] = [
  { cls: 'fig-wide', W: 760, H: 290, bar: [60, 40, 28, 200], plot: [170, 40, 260, 200], hist: [520, 40, 200, 200] },
  { cls: 'fig-narrow', W: 360, H: 560, bar: [44, 40, 26, 200], plot: [150, 40, 180, 200], hist: [70, 330, 240, 170] },
];
const geo = (L: L) => {
  const [bx, by, bw, bh] = L.bar;
  const [px, py, pw, ph] = L.plot;
  const [hx, hy, hw, hh] = L.hist;
  const vy = scale([0, 1], [by + bh, by]);
  const cx = (k: number) => px + (pw * (k + 0.5)) / 3;
  const hy0 = scale([0, 0.6], [hy + hh, hy]);
  const hcx = (k: number) => hx + (hw * (k + 0.5)) / 3;
  return { bx, by, bw, bh, px, py, pw, ph, hx, hy, hw, hh, vy, cx, hy0, hcx };
};
const fmt = (v: number) => v.toFixed(1);
const id = 'generative-modeling-discrete-inverse';
---

<Figure
  id={id}
  title={ru ? 'Сэмплирование дискретного распределения: разрезать отрезок [0, 1)' : 'Sampling a discrete distribution: cut the interval [0, 1)'}
  caption={ru
    ? `У исходов a, b и c вероятности 0.2, 0.5 и 0.3. Разрезы в точках 0.2 и 0.7 — накопленные суммы, то есть функция распределения F (ступеньки посередине). Равномерное число u = ${uEx} попадает во второй кусок, поэтому выдаётся b. Справа — доли исходов в 10 000 сэмплах: ${shares.map((s) => s.toFixed(3)).join(', ')}; чёрточки отмечают 0.2, 0.5 и 0.3.`
    : `Outcomes a, b and c have probabilities 0.2, 0.5 and 0.3. The cuts at 0.2 and 0.7 are the running totals, the CDF F (the staircase in the middle). The uniform number u = ${uEx} falls into the second piece, so the result is b. Right: the shares in 10,000 draws, ${shares.map((s) => s.toFixed(3)).join(', ')}; ticks mark 0.2, 0.5 and 0.3.`}
>
  {layouts.map((L) => {
    const g = geo(L);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Отрезок [0, 1), разрезанный на три куска, ступенчатая функция распределения и доли исходов' : 'The interval [0, 1) cut into three pieces, the staircase CDF and the shares of outcomes'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Вертикальная полоса от 0 до 1 разделена на куски длиной 0.2, 0.5 и 0.3 для исходов a, b и c. Ступенчатая функция распределения со ступеньками 0.2, 0.7 и 1. Пунктир от u = 0.637 идёт вправо до ступеньки b и вниз к исходу b. Столбцы долей в 10 000 сэмплах около 0.2, 0.5 и 0.3.'
          : 'A vertical strip from 0 to 1 split into pieces of length 0.2, 0.5 and 0.3 for outcomes a, b and c. A staircase CDF with steps at 0.2, 0.7 and 1. A dashed line from u = 0.637 runs right to the b step and down to outcome b. Bars of the shares in 10,000 draws, near 0.2, 0.5 and 0.3.'}</desc>
        {[0, 1, 2].map((k) => (
          <g>
            <rect x={g.bx} y={fmt(g.vy(cuts[k + 1]))} width={g.bw} height={fmt(g.vy(cuts[k]) - g.vy(cuts[k + 1]))} style={`fill: ${colors[k]}; fill-opacity: .35; stroke: ${colors[k]}`} />
            <text class="f-math" x={g.bx + g.bw / 2} y={fmt((g.vy(cuts[k]) + g.vy(cuts[k + 1])) / 2 + 5)} text-anchor="middle">{names[k]}</text>
          </g>
        ))}
        {cuts.map((c) => <text class="f-small f-t-muted" x={g.bx - 6} y={fmt(g.vy(c) + 4)} text-anchor="end">{c}</text>)}
        <text class="f-math f-t-amber" x={g.bx + g.bw / 2} y={g.by - 12} text-anchor="middle">{t.u}</text>
        <line class="f-axis" x1={g.px} x2={g.px} y1={g.py + g.ph} y2={g.py - 6} />
        <line class="f-axis" x1={g.px} x2={g.px + g.pw} y1={g.py + g.ph} y2={g.py + g.ph} />
        {[0, 1, 2].map((k) => (
          <g>
            <line class="f-line f-blue" x1={fmt(g.px + (g.pw * k) / 3)} x2={fmt(g.px + (g.pw * (k + 1)) / 3)} y1={fmt(g.vy(cuts[k + 1]))} y2={fmt(g.vy(cuts[k + 1]))} />
            <line class="f-thin f-blue f-dash" x1={fmt(g.px + (g.pw * k) / 3)} x2={fmt(g.px + (g.pw * k) / 3)} y1={fmt(g.vy(cuts[k]))} y2={fmt(g.vy(cuts[k + 1]))} />
            <text class="f-math" x={fmt(g.cx(k))} y={g.py + g.ph + 20} text-anchor="middle">{names[k]}</text>
          </g>
        ))}
        <text class="f-small f-t-blue" x={g.px + 6} y={g.py - 12}>{t.F}</text>
        <path class="f-thin f-amber f-dash" d={`M ${g.bx + g.bw} ${fmt(g.vy(uEx))} H ${fmt(g.cx(1))} V ${g.py + g.ph}`} />
        <circle cx={g.bx + g.bw} cy={fmt(g.vy(uEx))} r="4" fill="var(--fig-amber)" />
        <text class="f-small f-t-amber f-halo" x={g.bx + g.bw + 8} y={fmt(g.vy(uEx) - 7)}>{`u = ${uEx}`}</text>
        <circle cx={fmt(g.cx(1))} cy={g.py + g.ph} r="4" fill="var(--fig-amber)" />
        <text class="f-small" x={g.hx} y={g.hy - 12}>{t.hist}</text>
        <line class="f-axis" x1={g.hx} x2={g.hx + g.hw} y1={g.hy + g.hh} y2={g.hy + g.hh} />
        {[0, 1, 2].map((k) => (
          <g>
            <rect x={fmt(g.hcx(k) - 18)} y={fmt(g.hy0(shares[k]))} width="36" height={fmt(g.hy + g.hh - g.hy0(shares[k]))} style={`fill: ${colors[k]}; fill-opacity: .35; stroke: ${colors[k]}`} />
            <line x1={fmt(g.hcx(k) - 26)} x2={fmt(g.hcx(k) + 26)} y1={fmt(g.hy0(p[k]))} y2={fmt(g.hy0(p[k]))} style="stroke: var(--ink); stroke-width: 1.5" />
            <text class="f-small" x={fmt(g.hcx(k))} y={fmt(g.hy0(shares[k]) - 6)} text-anchor="middle">{shares[k].toFixed(3)}</text>
            <text class="f-math" x={fmt(g.hcx(k))} y={g.hy + g.hh + 20} text-anchor="middle">{names[k]}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
