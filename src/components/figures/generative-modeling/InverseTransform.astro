---
import Figure from '../Figure.astro';
import { plot, scale, gaussian, seeded } from '../geometry';
import { Phi, PhiInv } from './sampling';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Six example uniforms traced through x = Φ⁻¹(u), and a histogram of 4000 transformed draws.
const examples = [0.06, 0.24, 0.42, 0.58, 0.8, 0.95];
const random = seeded(7);
const draws = Array.from({ length: 4000 }, () => PhiInv(Math.min(Math.max(random(), 1e-9), 1 - 1e-9)));
const binW = 0.25;
const bins = new Map<number, number>();
for (const x of draws) {
  const b = Math.floor(x / binW);
  bins.set(b, (bins.get(b) ?? 0) + 1);
}
const fmt = (v: number) => v.toFixed(2);
const lab = (t: number) => (t < 0 ? `−${-t}` : `${t}`);

function layout(w: number, left: number, right: number, cdfTop: number, cdfBottom: number, histTop: number, histBottom: number, ticks: number[]) {
  const sx = scale([-3.5, 3.5], [left, right]);
  const sy = scale([0, 1], [cdfBottom, cdfTop]);
  const sh = scale([0, 0.45], [histBottom, histTop]);
  const bars = [...bins.entries()].filter(([b]) => b * binW >= -3.5 && (b + 1) * binW <= 3.5).map(([b, n]) => {
    const h = n / (draws.length * binW);
    return { x: sx(b * binW), w: sx((b + 1) * binW) - sx(b * binW), y: sh(h), h: histBottom - sh(h) };
  });
  return {
    w, left, right, cdfTop, cdfBottom, histTop, histBottom, sx, sy, sh, ticks, bars,
    cdf: plot(Phi, -3.5, 3.5, sx, sy, 200),
    pdf: plot((x) => gaussian(x), -3.5, 3.5, sx, sh, 200),
    traces: examples.map((u) => ({ u, x: PhiInv(u) })),
  };
}
const wide = layout(640, 70, 600, 30, 230, 270, 400, [-3, -2, -1, 0, 1, 2, 3]);
const narrow = layout(380, 52, 360, 30, 220, 262, 380, [-3, -2, -1, 0, 1, 2, 3]);
const id = 'generative-modeling-inverse-transform';
const t = ru
  ? { u: 'u ~ U(0, 1)', cdf: 'Φ(x)', hist: '4000 значений Φ⁻¹(u)', pdf: 'плотность N(0, 1)' }
  : { u: 'u ~ U(0, 1)', cdf: 'Φ(x)', hist: '4000 values of Φ⁻¹(u)', pdf: 'N(0, 1) density' };
---

<Figure
  id={id}
  title={ru ? 'Из равномерного распределения в нормальное через обратную функцию распределения' : 'From uniform to normal through the inverse CDF'}
  caption={ru
    ? 'Сверху — функция распределения Φ стандартного нормального закона. Шесть равномерных чисел u на вертикальной оси переходят по горизонтали к кривой и опускаются на ось x: x = Φ⁻¹(u). Равные отрезки по u отображаются в короткие отрезки x там, где Φ круто растёт (около нуля), и в длинные на хвостах. Поэтому значения x сгущаются в центре. Снизу — гистограмма 4000 таких значений (ширина столбца 0.25) и плотность N(0, 1): они совпадают.'
    : 'Top: the standard normal CDF Φ. Six uniform numbers u on the vertical axis go across to the curve and down to the x axis: x = Φ⁻¹(u). Equal stretches of u map to short stretches of x where Φ is steep (near zero) and to long ones in the tails, so the values of x pile up in the middle. Bottom: a histogram of 4000 such values (bin width 0.25) with the N(0, 1) density on top; they agree.'}
>
  {[{ v: wide, cls: 'fig-wide fig-medium', s: 'w' }, { v: narrow, cls: 'fig-narrow', s: 'n' }].map(({ v, cls, s }) => (
    <svg class={cls} viewBox={`0 0 ${v.w} 440`} role="img" aria-labelledby={`${id}-${s}-t ${id}-${s}-d`}>
      <title id={`${id}-${s}-t`}>{ru ? 'Обратное преобразование: u из U(0, 1) превращается в x = Φ⁻¹(u)' : 'Inverse transform sampling: u from U(0, 1) becomes x = Φ⁻¹(u)'}</title>
      <desc id={`${id}-${s}-d`}>{ru
        ? 'Верхний график: S-образная кривая Φ(x) от 0 до 1 на интервале x от −3.5 до 3.5. На вертикальной оси отмечены шесть значений u: 0.06, 0.24, 0.42, 0.58, 0.8 и 0.95. От каждого идёт горизонтальная пунктирная линия до кривой и затем вертикальная вниз до оси x. Нижний график: гистограмма 4000 значений Φ⁻¹(u) с наложенной колоколообразной плотностью N(0, 1).'
        : 'Top plot: the S-shaped curve Φ(x) rising from 0 to 1 over x from −3.5 to 3.5. Six values of u are marked on the vertical axis: 0.06, 0.24, 0.42, 0.58, 0.8 and 0.95. From each a dashed line runs right to the curve and then down to the x axis. Bottom plot: a histogram of 4000 values of Φ⁻¹(u) with the bell-shaped N(0, 1) density drawn over it.'}</desc>

      <line class="f-axis" x1={v.left} x2={v.left} y1={v.cdfBottom} y2={v.cdfTop - 8} marker-end="url(#f-arrow-muted)" />
      <line class="f-axis" x1={v.left} x2={v.right + 10} y1={v.cdfBottom} y2={v.cdfBottom} />
      {[0, 0.5, 1].map((y) => <text class="f-small f-t-muted" x={v.left - 8} y={v.sy(y) + 4} text-anchor="end">{y}</text>)}
      <text class="f-math f-t-blue" x={v.right - 4} y={v.sy(0.86)} text-anchor="end">{t.cdf}</text>
      <text class="f-small f-t-amber" x={v.left + 10} y={v.cdfTop - 10}>{t.u}</text>
      <path class="f-line f-blue" d={v.cdf} />
      {v.traces.map(({ u, x }) => (
        <g>
          <path class="f-thin f-amber f-dash" d={`M ${fmt(v.left)} ${fmt(v.sy(u))} H ${fmt(v.sx(x))} V ${fmt(v.histBottom)}`} />
          <circle cx={v.left} cy={v.sy(u)} r="4" fill="var(--fig-amber)" />
          <circle cx={v.sx(x)} cy={v.sy(u)} r="3" fill="var(--fig-blue)" />
          <circle cx={v.sx(x)} cy={v.histBottom} r="4" fill="var(--fig-amber)" />
        </g>
      ))}

      {v.bars.map((b) => <rect x={fmt(b.x + 0.5)} y={fmt(b.y)} width={fmt(Math.max(b.w - 1, 0.5))} height={fmt(b.h)} class="f-fill-blue" />)}
      <path class="f-line f-red" d={v.pdf} />
      <line class="f-axis" x1={v.left} x2={v.right + 10} y1={v.histBottom} y2={v.histBottom} marker-end="url(#f-arrow-muted)" />
      {v.ticks.map((k) => <text class="f-small f-t-muted" x={v.sx(k)} y={v.histBottom + 20} text-anchor="middle">{lab(k)}</text>)}
      <text class="f-math" x={v.right + 12} y={v.histBottom + 22} text-anchor="end">x</text>
      <text class="f-small f-t-blue" x={v.left} y={v.histTop - 4}>{t.hist}</text>
      <text class="f-small f-t-red" x={v.right} y={v.histTop - 4} text-anchor="end">{t.pdf}</text>
    </svg>
  ))}
</Figure>
