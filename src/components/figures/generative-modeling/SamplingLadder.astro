---
import Figure from '../Figure.astro';
import { uniformPairs, boxMuller, affineStep, bend, type Vec } from './sampling';
import { pageLang } from '../../../utils/lang';
import Sub from './Sub.astro';

const ru = pageLang(Astro.url) === 'ru';

// The same 320 uniform pairs pushed through every step; one pair is traced in amber.
const u = uniformPairs(320, 3);
const z = u.map(boxMuller);
const y = z.map(affineStep);
const x = y.map(bend);
const traced = 11;

type Stage = { key: string; pts: Vec[]; box: [number, number, number, number]; title: string; sub: string };
const stages: Stage[] = [
  { key: 'u', pts: u, box: [-0.1, 1.1, -0.1, 1.1], title: ru ? 'равномерный шум' : 'uniform noise', sub: 'u ~ U(0, 1)²' },
  { key: 'z', pts: z, box: [-3.4, 3.4, -3.4, 3.4], title: ru ? 'стандартная нормаль' : 'standard normal', sub: 'z ~ N(0, I)' },
  { key: 'y', pts: y, box: [-3.4, 3.4, -3.4, 3.4], title: ru ? 'любая гауссиана' : 'any Gaussian', sub: 'μ + Az ~ N(μ, AAᵀ)' },
  { key: 'x', pts: x, box: [-3.4, 3.4, -3.4, 3.4], title: ru ? 'сложная форма' : 'complex shape', sub: 'x = g(μ + Az)' },
];
// Step labels, one array entry per text line.
const steps = ru ? [['Бокс —', 'Мюллер'], ['μ + A z'], ['g(·)']] : [['Box–Muller'], ['μ + A z'], ['g(·)']];
const size = 120;
const fmt = (v: number) => v.toFixed(1);
const place = (s: Stage, ox: number, oy: number) => {
  const [x0, x1, y0, y1] = s.box;
  const px = (v: number) => ox + ((v - x0) / (x1 - x0)) * size;
  const py = (v: number) => oy + size - ((v - y0) / (y1 - y0)) * size;
  const inside = (p: Vec) => p[0] >= x0 && p[0] <= x1 && p[1] >= y0 && p[1] <= y1;
  return {
    ox, oy, s,
    dots: s.pts.map((p, i) => ({ p, i })).filter(({ p }) => inside(p)).map(({ p, i }) => ({ x: fmt(px(p[0])), y: fmt(py(p[1])), hot: i === traced })),
    zero: s.key === 'u' ? null : { x: px(0), y: py(0) },
  };
};
const wideAt: [number, number][] = [[12, 64], [204, 64], [396, 64], [588, 64]];
const narrowAt: [number, number][] = [[36, 64], [224, 64], [36, 300], [224, 300]];
const wide = stages.map((s, i) => place(s, ...wideAt[i]));
const narrow = stages.map((s, i) => place(s, ...narrowAt[i]));
const id = 'generative-modeling-sampling-ladder';
---

<Figure
  id={id}
  title={ru ? 'Сэмплирование как цепочка преобразований шума' : 'Sampling as a chain of transformations of noise'}
  caption={ru
    ? 'Одни и те же 320 пар равномерных чисел проходят все шаги; янтарная точка — одна пара, прослеженная до конца. Бокс — Мюллер даёт круглое нормальное облако, аффинное отображение μ + Az с A = diag(1.4, 0.45) — эллипс, а g(y) = (y₁, y₂ − 0.45 y₁² + 0.9) изгибает его в дугу. В модели последнее отображение — обученная сеть gθ.'
    : 'The same 320 uniform pairs pass through every step; the amber point is one pair followed to the end. Box–Muller makes a round normal cloud, the affine map μ + Az with A = diag(1.4, 0.45) an ellipse, and g(y) = (y₁, y₂ − 0.45 y₁² + 0.9) bends it into an arch. In a model the last map is a trained network gθ.'}
>
  {[{ v: wide, cls: 'fig-wide', s: 'w', vb: '0 0 720 240' }, { v: narrow, cls: 'fig-narrow', s: 'n', vb: '0 0 380 470' }].map(({ v, cls, s, vb }) => (
    <svg class={cls} viewBox={vb} role="img" aria-labelledby={`${id}-${s}-t ${id}-${s}-d`}>
      <title id={`${id}-${s}-t`}>{ru ? 'Четыре облака точек: равномерный шум, стандартная нормаль, гауссиана, изогнутое распределение' : 'Four point clouds: uniform noise, standard normal, a Gaussian, a bent distribution'}</title>
      <desc id={`${id}-${s}-d`}>{ru
        ? 'Четыре квадратных панели, соединённые стрелками. Первая: точки, равномерно заполняющие единичный квадрат. Стрелка «Бокс — Мюллер» ведёт ко второй: круглое облако с центром в нуле. Стрелка «μ + A z» ведёт к третьей: то же облако, растянутое по горизонтали и сжатое по вертикали. Стрелка «g» ведёт к четвёртой: облако, изогнутое в дугу. Одна выделенная точка отмечена во всех четырёх панелях.'
        : 'Four square panels joined by arrows. First: points filling the unit square evenly. An arrow labelled Box–Muller leads to the second: a round cloud centred at zero. An arrow labelled mu plus A z leads to the third: the same cloud stretched horizontally and squeezed vertically. An arrow labelled g leads to the fourth: the cloud bent into an arch. One highlighted point is marked in all four panels.'}</desc>
      {v.map((p, i) => (
        <g>
          <text class="f-title" x={p.ox + size / 2} y={p.oy - 30} text-anchor="middle">{p.s.title}</text>
          <text class="f-small f-t-muted" x={p.ox + size / 2} y={p.oy - 12} text-anchor="middle"><Sub label={p.s.sub} /></text>
          <rect class="f-grid" x={p.ox} y={p.oy} width={size} height={size} fill="none" />
          {p.zero && <line class="f-grid" x1={p.ox} x2={p.ox + size} y1={p.zero.y} y2={p.zero.y} />}
          {p.zero && <line class="f-grid" x1={p.zero.x} x2={p.zero.x} y1={p.oy} y2={p.oy + size} />}
          {p.dots.filter((d) => !d.hot).map((d) => <circle cx={d.x} cy={d.y} r="1.7" class={i === 3 ? 'f-solid-red' : i === 0 ? 'f-solid-muted' : 'f-solid-blue'} fill-opacity="0.55" />)}
          {p.dots.filter((d) => d.hot).map((d) => <circle cx={d.x} cy={d.y} r="5" fill="var(--fig-amber)" stroke="var(--paper)" stroke-width="1.5" />)}
        </g>
      ))}
      {[0, 1, 2].map((i) => {
        const a = v[i];
        const b = v[i + 1];
        const sameRow = a.oy === b.oy;
        if (sameRow) {
          const x1 = a.ox + size + 6;
          const x2 = b.ox - 6;
          const yy = a.oy + size / 2;
          return (
            <g>
              <path class="f-line f-muted" d={`M ${x1} ${yy} H ${x2}`} marker-end="url(#f-arrow-muted)" />
              {steps[i].map((line, k) => <text class="f-small" x={(x1 + x2) / 2} y={yy - 10 - 15 * (steps[i].length - 1 - k)} text-anchor="middle">{line}</text>)}
            </g>
          );
        }
        // Narrow layout: from the end of row one down to the start of row two.
        const xs = a.ox + size / 2;
        return (
          <g>
            <path class="f-line f-muted" d={`M ${xs} ${a.oy + size + 8} C ${xs} ${a.oy + size + 40}, ${b.ox + size / 2} ${b.oy - 80}, ${b.ox + size / 2} ${b.oy - 44}`} marker-end="url(#f-arrow-muted)" />
            <text class="f-small" x={(xs + b.ox + size / 2) / 2 + 10} y={a.oy + size + 46} text-anchor="middle">{steps[i].join(' ')}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
