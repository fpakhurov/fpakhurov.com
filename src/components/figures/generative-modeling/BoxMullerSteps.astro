---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale } from '../geometry';
import { mulberry32 } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Box–Muller step by step for the example of the text, u = (0.3, 0.8), plus 600 more uniform pairs to show the cloud.
const ex = { u1: 0.3, u2: 0.8 };
const R = Math.sqrt(-2 * Math.log(ex.u1));
const th = 2 * Math.PI * ex.u2;
const z = [R * Math.cos(th), R * Math.sin(th)];
const check = (v: number, s: string) => v.toFixed(3) === s;
if (!check(R * R, '2.408') || !check(R, '1.552') || !check(z[0], '0.480') || !check(z[1], '-1.476') || Math.round((th * 180) / Math.PI) !== 288) {
  throw new Error('BoxMullerSteps: the worked example drifted from the text');
}
const rand = mulberry32(21);
const pairs = Array.from({ length: 600 }, () => [1 - rand(), rand()] as const);
const cloud = pairs.map(([a, b]) => {
  const r = Math.sqrt(-2 * Math.log(a));
  return [r * Math.cos(2 * Math.PI * b), r * Math.sin(2 * Math.PI * b)] as const;
});
const inside1 = cloud.filter(([x, y]) => x * x + y * y <= 1).length / cloud.length;
// About 1 − e^{−1/2} ≈ 39% of standard normal pairs lie within distance 1 of the origin.
if (Math.abs(inside1 - (1 - Math.exp(-0.5))) > 0.05) throw new Error('BoxMullerSteps: cloud does not look standard normal');

const t = ru
  ? {
      p1: '1. два равномерных числа', p2: '2–3. угол и расстояние', p3: '4. точка на плоскости',
      ang: 'угол 2π·0.8 = 288°', rad: 'расстояние √(−2 ln 0.3) = 1.552', pt: 'z = (0.480, −1.476)', cloudL: '600 таких точек',
      steps: [
        'берём пару равномерных чисел u₁ = 0.3, u₂ = 0.8 (жёлтая точка среди 600 других пар)',
        'u₂ задаёт угол: Θ = 2π·u₂ = 288°, любое направление равновероятно',
        'u₁ задаёт расстояние: R² = −2 ln u₁ = 2.408 (экспоненциальное распределение по шагу 2), R = 1.552',
        'переходим к координатам: z = (R cos Θ, R sin Θ) = (0.480, −1.476); все пары вместе дают облако стандартного нормального распределения',
      ],
    }
  : {
      p1: '1. two uniform numbers', p2: '2–3. angle and distance', p3: '4. a point in the plane',
      ang: 'angle 2π·0.8 = 288°', rad: 'distance √(−2 ln 0.3) = 1.552', pt: 'z = (0.480, −1.476)', cloudL: '600 such points',
      steps: [
        'take a pair of uniform numbers u₁ = 0.3, u₂ = 0.8 (the amber point among 600 other pairs)',
        'u₂ sets the angle: Θ = 2π·u₂ = 288°; every direction is equally likely',
        'u₁ sets the distance: R² = −2 ln u₁ = 2.408 (exponential, by step 2), R = 1.552',
        'convert to coordinates: z = (R cos Θ, R sin Θ) = (0.480, −1.476); all pairs together form a standard normal cloud',
      ],
    };

type L = { cls: string; W: number; H: number; side: number; panels: [number, number][]; lim: number };
const layouts: L[] = [
  { cls: 'fig-wide', W: 760, H: 300, side: 200, panels: [[30, 60], [285, 60], [540, 60]], lim: 3.2 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 890, side: 230, panels: [[70, 60], [70, 340], [70, 620]], lim: 3.2 },
];
const geo = (L: L, j: number) => {
  const [x0, y0] = L.panels[j];
  const unit = { sx: scale([0, 1], [x0, x0 + L.side]), sy: scale([0, 1], [y0 + L.side, y0]) };
  const plane = { sx: scale([-L.lim, L.lim], [x0, x0 + L.side]), sy: scale([-L.lim, L.lim], [y0 + L.side, y0]) };
  return { x0, y0, unit, plane };
};
const f1 = (v: number) => v.toFixed(1);
// Arc from angle 0 to θ (counterclockwise in math coordinates, i.e. clockwise on screen because y is flipped).
const arc = (cx: number, cy: number, r: number, a: number) => {
  const ex2 = cx + r * Math.cos(a), ey2 = cy - r * Math.sin(a);
  return `M ${f1(cx + r)} ${f1(cy)} A ${r} ${r} 0 ${a > Math.PI ? 1 : 0} 0 ${f1(ex2)} ${f1(ey2)}`;
};
const id = 'generative-modeling-box-muller';
---

<Figure
  id={id}
  title={ru ? 'Бокс — Мюллер по шагам: два равномерных числа → точка нормального облака' : 'Box–Muller step by step: two uniform numbers → a point of the normal cloud'}
  caption={ru
    ? 'Слева — пары равномерных чисел (u₁, u₂), пример (0.3, 0.8) выделен. Посередине: u₂ задаёт угол 2πu₂, а u₁ — расстояние √(−2 ln u₁). Справа — получившиеся точки z, облако с центром в нуле, и круги радиусов 1 и 2. Малое u₁ даёт одну из редких далёких точек.'
    : 'Left: uniform pairs (u₁, u₂), with the example (0.3, 0.8) highlighted. Middle: u₂ sets the angle 2πu₂ and u₁ the distance √(−2 ln u₁). Right: the resulting points z, a cloud centred at zero, with circles of radius 1 and 2. A small u₁ gives one of the rare far points.'}
>
  {layouts.map((L) => {
    const a = geo(L, 0), b = geo(L, 1), c = geo(L, 2);
    const ocx = b.plane.sx(0), ocy = b.plane.sy(0);
    const rpx = b.plane.sx(R) - ocx;
    const end = [b.plane.sx(z[0]), b.plane.sy(z[1])];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Преобразование Бокса — Мюллера в три панели' : 'The Box–Muller transform in three panels'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Первая панель: 600 точек, равномерно заполняющих единичный квадрат, точка (0.3, 0.8) выделена. Вторая: из начала координат луч под углом 288° длиной 1.552 с дугой угла. Третья: облако 600 нормальных точек вокруг нуля с окружностями радиусов 1 и 2 и выделенной точкой (0.480, −1.476).'
          : 'Panel one: 600 points filling the unit square evenly, with the point (0.3, 0.8) highlighted. Panel two: a ray from the origin at angle 288° and length 1.552, with an arc marking the angle. Panel three: a cloud of 600 normal points around zero with circles of radius 1 and 2 and the point (0.480, −1.476) highlighted.'}</desc>

        <g data-s="1">
          <text class="f-small" x={a.x0} y={a.y0 - 14}>{t.p1}</text>
          <rect x={a.x0} y={a.y0} width={L.side} height={L.side} style="fill: none; stroke: var(--line)" />
          {pairs.map(([u1, u2]) => <circle cx={f1(a.unit.sx(u1))} cy={f1(a.unit.sy(u2))} r="1.5" style="fill: var(--fig-green); fill-opacity: .6" />)}
          <circle cx={f1(a.unit.sx(ex.u1))} cy={f1(a.unit.sy(ex.u2))} r="5" fill="var(--fig-amber)" />
          <text class="f-small f-t-amber f-halo" x={f1(a.unit.sx(ex.u1) + 8)} y={f1(a.unit.sy(ex.u2) - 8)}>(0.3, 0.8)</text>
          <text class="f-small f-t-muted" x={a.x0 + L.side / 2} y={a.y0 + L.side + 18} text-anchor="middle">u₁</text>
          <text class="f-small f-t-muted" x={a.x0 - 8} y={a.y0 + L.side / 2} text-anchor="end">u₂</text>
          <Badge x={a.x0 + L.side - 10} y={a.y0 - 18} n={1} />
        </g>

        <text class="f-small" x={b.x0} y={b.y0 - 14}>{t.p2}</text>
        <rect x={b.x0} y={b.y0} width={L.side} height={L.side} style="fill: none; stroke: var(--line)" />
        <line class="f-thin f-muted" x1={b.x0} x2={b.x0 + L.side} y1={ocy} y2={ocy} />
        <line class="f-thin f-muted" x1={ocx} x2={ocx} y1={b.y0} y2={b.y0 + L.side} />
        <g data-s="2">
          <path class="f-thin f-amber" d={arc(ocx, ocy, 22, th)} />
          <text class="f-small f-t-amber f-halo" x={f1(ocx + 8)} y={f1(ocy - 30)}>{t.ang}</text>
          <Badge x={b.x0 + L.side - 34} y={b.y0 - 18} n={2} />
        </g>
        <g data-s="3">
          <path class="f-line f-red" d={`M ${f1(ocx)} ${f1(ocy)} L ${f1(end[0])} ${f1(end[1])}`} />
          <circle cx={f1(ocx)} cy={f1(ocy)} r={f1(rpx)} class="f-thin f-red f-dash" style="fill: none" />
          <text class="f-small f-t-red f-halo" x={f1(b.x0 + 6)} y={f1(b.y0 + L.side - 8)}>{t.rad}</text>
          <Badge x={b.x0 + L.side - 10} y={b.y0 - 18} n={3} />
        </g>

        <g data-s="4">
          <text class="f-small" x={c.x0} y={c.y0 - 14}>{t.p3}</text>
          <rect x={c.x0} y={c.y0} width={L.side} height={L.side} style="fill: none; stroke: var(--line)" />
          {cloud.filter(([x, y]) => Math.abs(x) < L.lim && Math.abs(y) < L.lim).map(([x, y]) => <circle cx={f1(c.plane.sx(x))} cy={f1(c.plane.sy(y))} r="1.5" style="fill: var(--fig-blue); fill-opacity: .55" />)}
          {[1, 2].map((r) => <circle cx={f1(c.plane.sx(0))} cy={f1(c.plane.sy(0))} r={f1(c.plane.sx(r) - c.plane.sx(0))} class="f-thin f-muted f-dash" style="fill: none" />)}
          <circle cx={f1(c.plane.sx(z[0]))} cy={f1(c.plane.sy(z[1]))} r="5" fill="var(--fig-amber)" />
          <text class="f-small f-t-amber f-halo" x={f1(c.plane.sx(z[0]) - 8)} y={f1(c.plane.sy(z[1]) + 18)} text-anchor="end">{t.pt}</text>
          <text class="f-small f-t-muted" x={c.x0 + L.side / 2} y={c.y0 + L.side + 18} text-anchor="middle">{t.cloudL}</text>
          <Badge x={c.x0 + L.side - 10} y={c.y0 - 18} n={4} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
