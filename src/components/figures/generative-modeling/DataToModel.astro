---
import Figure from '../Figure.astro';
import { moons, mixtureMeans, mixtureSamples, type Vec } from './sampling';
import { pageLang } from '../../../utils/lang';
import Sub from './Sub.astro';

const ru = pageLang(Astro.url) === 'ru';

// Data: 300 points from two noisy half-circles. Model: an equal-weight mixture of 16 isotropic
// Gaussians (σ = 0.12) placed along the curves, standing in for a fitted model. New samples: 300 draws from it.
const data = moons(300, 5);
const means = mixtureMeans(8);
const sd = 0.12;
const fresh = mixtureSamples(means, sd, 300, 9);
const box: [number, number, number, number] = [-1.3, 2.3, -0.85, 1.35];
const fmt = (v: number) => v.toFixed(1);

function panel(ox: number, oy: number, w: number) {
  const h = (w * (box[3] - box[2])) / (box[1] - box[0]);
  const px = (v: number) => ox + ((v - box[0]) / (box[1] - box[0])) * w;
  const py = (v: number) => oy + h - ((v - box[2]) / (box[3] - box[2])) * h;
  const r = (v: number) => (v / (box[1] - box[0])) * w;
  const pts = (list: Vec[]) => list.filter((p) => p[0] > box[0] && p[0] < box[1] && p[1] > box[2] && p[1] < box[3]).map((p) => ({ x: fmt(px(p[0])), y: fmt(py(p[1])) }));
  return { ox, oy, w, h, px, py, r, pts };
}
function layout(at: [number, number][], w: number) {
  const [a, b, c] = at.map(([x, y]) => panel(x, y, w));
  return {
    data: { ...a, dots: a.pts(data) },
    model: { ...b, comps: means.map((m) => ({ x: b.px(m[0]), y: b.py(m[1]), r1: b.r(sd), r2: b.r(2 * sd) })) },
    fresh: { ...c, dots: c.pts(fresh) },
  };
}
const wide = layout([[12, 70], [263, 70], [514, 70]], 155);
const narrow = layout([[60, 64], [60, 304], [60, 544]], 260);
const id = 'generative-modeling-data-to-model';
const t = ru
  ? { data: 'данные', dataSub: 'x⁽¹⁾, …, x⁽ᴺ⁾ ~ p_{data}', model: 'модель', modelSub: 'p_θ(x) ≈ p_{data}(x)', fresh: 'новые сэмплы', freshSub: 'x ~ p_θ', fit: 'обучить θ', sample: 'сэмплировать', unknown: 'p_{data} неизвестно' }
  : { data: 'data', dataSub: 'x⁽¹⁾, …, x⁽ᴺ⁾ ~ p_{data}', model: 'model', modelSub: 'p_θ(x) ≈ p_{data}(x)', fresh: 'new samples', freshSub: 'x ~ p_θ', fit: 'fit θ', sample: 'sample', unknown: 'p_{data} is unknown' };
---

<Figure
  id={id}
  title={ru ? 'Генеративное моделирование: от примеров к модели и обратно к примерам' : 'Generative modeling: from examples to a model and back to examples'}
  caption={ru
    ? 'Слева — 300 точек из распределения, формулы которого мы не знаем (два зашумлённых полукруга). В центре — модель pθ: здесь равновзвешенная смесь 16 гауссиан с σ = 0.12, расставленных вдоль данных; кольца — линии уровня 1σ и 2σ каждой компоненты. Это иллюстрация того, что даёт обучение, а не результат реального обучения. Справа — 300 новых сэмплов из модели: они похожи на данные, но не совпадают ни с одной исходной точкой.'
    : 'Left: 300 points from a distribution whose formula we do not know (two noisy half-circles). Middle: a model pθ, here an equal-weight mixture of 16 Gaussians with σ = 0.12 placed along the data; the rings are the 1σ and 2σ contours of each component. It illustrates what fitting produces rather than the result of an actual fit. Right: 300 new samples from the model; they look like the data without repeating any original point.'}
>
  {[{ v: wide, cls: 'fig-wide', s: 'w', vb: '0 0 682 200', row: true }, { v: narrow, cls: 'fig-narrow', s: 'n', vb: '0 0 380 720', row: false }].map(({ v, cls, s, vb, row }) => (
    <svg class={cls} viewBox={vb} role="img" aria-labelledby={`${id}-${s}-t ${id}-${s}-d`}>
      <title id={`${id}-${s}-t`}>{ru ? 'Данные, модель-смесь и новые сэмплы' : 'Data, a mixture model and new samples'}</title>
      <desc id={`${id}-${s}-d`}>{ru
        ? 'Три панели. Первая: облако точек в форме двух переплетённых полумесяцев с подписью «p_data неизвестно». Стрелка «подобрать θ» ведёт ко второй: 16 пар концентрических колец вдоль тех же полумесяцев, компоненты смеси гауссиан. Стрелка «сэмплировать» ведёт к третьей: новое облако точек той же формы.'
        : 'Three panels. First: a cloud of points shaped as two interleaved half-moons, labelled p_data is unknown. An arrow labelled fit theta leads to the second: 16 pairs of concentric rings along the same half-moons, the components of a Gaussian mixture. An arrow labelled sample leads to the third: a new cloud of points with the same shape.'}</desc>
      {[[v.data, t.data, t.dataSub], [v.model, t.model, t.modelSub], [v.fresh, t.fresh, t.freshSub]].map(([p, title, sub]) => (
        <g>
          <text class="f-title" x={(p as typeof v.data).ox + (p as typeof v.data).w / 2} y={(p as typeof v.data).oy - 30} text-anchor="middle">{title}</text>
          <text class="f-small f-t-muted" x={(p as typeof v.data).ox + (p as typeof v.data).w / 2} y={(p as typeof v.data).oy - 12} text-anchor="middle"><Sub label={sub as string} /></text>
          <rect class="f-grid" x={(p as typeof v.data).ox} y={(p as typeof v.data).oy} width={(p as typeof v.data).w} height={fmt((p as typeof v.data).h)} fill="none" />
        </g>
      ))}
      {v.data.dots.map((d) => <circle cx={d.x} cy={d.y} r="1.9" class="f-solid-muted" fill-opacity="0.7" />)}
      <text class="f-small f-t-red" x={row ? v.data.ox + v.data.w / 2 : v.data.ox} y={v.data.oy + v.data.h + 18} text-anchor={row ? 'middle' : 'start'}><Sub label={t.unknown} /></text>
      {v.model.comps.map((c) => (
        <g>
          <circle cx={fmt(c.x)} cy={fmt(c.y)} r={fmt(c.r2)} class="f-fill-blue" />
          <circle cx={fmt(c.x)} cy={fmt(c.y)} r={fmt(c.r1)} class="f-thin f-blue" />
        </g>
      ))}
      {v.fresh.dots.map((d) => <circle cx={d.x} cy={d.y} r="1.9" class="f-solid-blue" fill-opacity="0.7" />)}
      {[[v.data, v.model, t.fit], [v.model, v.fresh, t.sample]].map(([a, b, label]) => {
        const A = a as typeof v.data;
        const B = b as typeof v.data;
        if (row) {
          const x1 = A.ox + A.w + 4;
          const x2 = B.ox - 4;
          const y = A.oy + A.h / 2;
          return (
            <g>
              <path class="f-line f-muted" d={`M ${x1} ${y} H ${x2}`} marker-end="url(#f-arrow-muted)" />
              <text class="f-small" x={(x1 + x2) / 2} y={y - 8} text-anchor="middle">{label}</text>
            </g>
          );
        }
        const x = A.ox + A.w / 2;
        return (
          <g>
            <path class="f-line f-muted" d={`M ${x} ${fmt(A.oy + A.h + 6)} V ${B.oy - 44}`} marker-end="url(#f-arrow-muted)" />
            <text class="f-small" x={x + 10} y={fmt((A.oy + A.h + B.oy - 40) / 2 + 4)}>{label}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
