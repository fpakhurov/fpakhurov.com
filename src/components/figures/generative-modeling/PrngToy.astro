---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { mulberry32 } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The toy linear congruential generator of the text: s ← (5s + 3) mod 16, u = s/16, seed 7.
const M = 16;
const next = (s: number) => (5 * s + 3) % M;
const cycle: number[] = [7];
while (cycle.length < M) cycle.push(next(cycle[cycle.length - 1]));
if (next(cycle[M - 1]) !== 7 || new Set(cycle).size !== M) throw new Error('PrngToy: the toy generator should visit all 16 states and return to 7');
if (cycle.slice(0, 8).join(',') !== '7,6,1,8,11,10,5,12') throw new Error('PrngToy: the sequence drifted from the text');
const toyPairs = cycle.map((s) => [s / M, next(s) / M] as const);
// Consecutive pairs of a modern generator for comparison.
const rand = mulberry32(11);
const goodPairs = (() => {
  const u = Array.from({ length: 401 }, () => rand());
  return u.slice(0, 400).map((v, i) => [v, u[i + 1]] as const);
})();

const t = ru
  ? { cycle: 'состояния игрушечного генератора', seed: 'начальное значение (seed) 7', toy: 'игрушечный: пары (uₙ, uₙ₊₁)', good: 'хороший генератор: 400 пар', toyN: 'игрушечный', goodN: 'хороший: 400 пар', axis: 'uₙ' }
  : { cycle: 'states of the toy generator', seed: 'seed 7', toy: 'toy: pairs (uₙ, uₙ₊₁)', good: 'a good generator: 400 pairs', toyN: 'toy generator', goodN: 'good: 400 pairs', axis: 'uₙ' };

type L = { cls: string; W: number; H: number; cx: number; cy: number; r: number; sq: [number, number][]; side: number; cycleLabel: [number, number]; wide: boolean };
const layouts: L[] = [
  { cls: 'fig-wide', W: 760, H: 300, cx: 150, cy: 150, r: 105, sq: [[350, 60], [560, 60]], side: 170, cycleLabel: [150, 22], wide: true },
  { cls: 'fig-narrow', W: 360, H: 640, cx: 180, cy: 170, r: 115, sq: [[30, 380], [200, 380]], side: 140, cycleLabel: [180, 24], wide: false },
];
const node = (L: L, k: number) => {
  const a = -Math.PI / 2 + (2 * Math.PI * k) / M;
  return [L.cx + L.r * Math.cos(a), L.cy + L.r * Math.sin(a)] as const;
};
// Arrows from each state to its successor, shortened so they start and end at the node circles.
const arrows = (L: L) => cycle.map((s, k) => {
  const [x1, y1] = node(L, k);
  const [x2, y2] = node(L, (k + 1) % M);
  const dx = x2 - x1, dy = y2 - y1, d = Math.hypot(dx, dy);
  const off = 14 / d;
  return `M ${(x1 + dx * off).toFixed(1)} ${(y1 + dy * off).toFixed(1)} L ${(x2 - dx * off).toFixed(1)} ${(y2 - dy * off).toFixed(1)}`;
});
const square = (L: L, j: number) => {
  const [x0, y0] = L.sq[j];
  return { x0, y0, sx: scale([0, 1], [x0, x0 + L.side]), sy: scale([0, 1], [y0 + L.side, y0]) };
};
const id = 'generative-modeling-prng';
---

<Figure
  id={id}
  title={ru ? 'Откуда берутся «случайные» числа' : 'Where the "random" numbers come from'}
  caption={ru
    ? 'Слева — игрушечный генератор s ← (5s + 3) mod 16 с начальным значением 7: он обходит все 16 состояний и возвращается к 7, поэтому за цикл каждое значение u = s/16 встречается один раз. Справа — пары соседних чисел (uₙ, uₙ₊₁): у игрушки они лежат на нескольких прямых, а 400 пар современного генератора заполняют квадрат.'
    : 'Left: the toy generator s ← (5s + 3) mod 16 from the seed 7 visits all 16 states and returns to 7, so each value u = s/16 occurs once per cycle. Right: consecutive pairs (uₙ, uₙ₊₁) lie on a few lines for the toy, while 400 pairs from a modern generator fill the square.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Цикл игрушечного генератора и пары соседних чисел' : 'The cycle of a toy generator and pairs of consecutive numbers'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Шестнадцать кружков по окружности с номерами состояний 7, 6, 1, 8, 11, 10, 5, 12, 15, 14, 9, 0, 3, 2, 13, 4, соединённые стрелками по кругу; кружок 7 выделен. Два квадрата: в первом 16 точек на параллельных наклонных прямых, во втором 400 равномерно разбросанных точек.'
        : 'Sixteen circles around a ring labelled with the states 7, 6, 1, 8, 11, 10, 5, 12, 15, 14, 9, 0, 3, 2, 13, 4, joined by arrows around the ring; circle 7 is highlighted. Two squares: the first holds 16 points on parallel slanted lines, the second 400 evenly scattered points.'}</desc>
      <text class="f-small f-t-muted" x={L.cycleLabel[0]} y={L.cycleLabel[1]} text-anchor="middle">{t.cycle}</text>
      {arrows(L).map((d) => <path class="f-thin f-muted" d={d} marker-end="url(#f-arrow-muted)" />)}
      {cycle.map((s, k) => {
        const [x, y] = node(L, k);
        return (
          <g>
            <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="12" class={k === 0 ? 'f-fill-amber' : 'f-box'} style={k === 0 ? 'stroke: var(--fig-amber); stroke-width: 1.5' : ''} />
            <text class="f-small" x={x.toFixed(1)} y={(y + 4).toFixed(1)} text-anchor="middle">{s}</text>
          </g>
        );
      })}
      <text class="f-small f-t-amber" x={L.cx} y={L.cy + 4} text-anchor="middle">{t.seed}</text>
      {[0, 1].map((j) => {
        const q = square(L, j);
        const pts = j === 0 ? toyPairs : goodPairs;
        return (
          <g>
            <text class="f-small" x={q.x0} y={q.y0 - 10}>{L.wide ? (j === 0 ? t.toy : t.good) : (j === 0 ? t.toyN : t.goodN)}</text>
            <rect x={q.x0} y={q.y0} width={L.side} height={L.side} style="fill: none; stroke: var(--line); stroke-width: 1" />
            {pts.map(([a, b]) => <circle cx={q.sx(a).toFixed(1)} cy={q.sy(b).toFixed(1)} r={j === 0 ? 3.2 : 1.6} style={j === 0 ? 'fill: var(--fig-red)' : 'fill: var(--fig-blue); fill-opacity: .7'} />)}
            <text class="f-small f-t-muted" x={q.x0 + L.side / 2} y={q.y0 + L.side + 18} text-anchor="middle">{t.axis}</text>
            <text class="f-small f-t-muted" x={q.x0 - 4} y={q.y0 + L.side + 4} text-anchor="end">0</text>
            <text class="f-small f-t-muted" x={q.x0 + L.side} y={q.y0 + L.side + 18} text-anchor="end">1</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
