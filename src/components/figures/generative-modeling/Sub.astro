---
/** Renders an SVG text label with `_x` / `_{xy}` as subscripts. Use inside <text>. */
import { subParts } from './sampling';

interface Props { label: string }
const { label } = Astro.props;
---
{subParts(label).map((p) => (p.sub ? <tspan baseline-shift="sub" font-size="0.72em">{p.t}</tspan> : p.t))}
