---
import Figure from '../Figure.astro';

const ru = Astro.props.lang === 'ru';
const title = ru ? 'Две позиции и один товар в каталоге' : 'Two lines and one catalog item';
const caption = ru
  ? 'Товар 7 совпадает с обеими позициями заказа 106. Проекция сохраняет две цены и номера позиций.'
  : 'Item 7 matches both lines of order 106. The projection keeps both prices and line numbers.';
const desc = ru
  ? 'Каталог присоединяет код TEA50 к позиции 1 на 350 копеек и позиции 2 на 300 копеек.'
  : 'The catalog attaches code TEA50 to line 1 at 350 cents and line 2 at 300 cents.';
---
<Figure id="db-order-relational-join" title={title} caption={caption}>
  <svg viewBox="0 0 340 173" role="img" aria-labelledby="db-order-join-title db-order-join-desc" style="max-width: 520px; margin-inline: auto">
    <title id="db-order-join-title">{title}</title>
    <desc id="db-order-join-desc">{desc}</desc>
    <rect class="f-fill-blue" x="91" y="9" width="158" height="35" rx="6" />
    <text class="f-label" x="170" y="31" text-anchor="middle">P: (7, TEA50)</text>
    <path class="f-line" d="M 170 44 V 58 H 86 V 75 M 170 58 H 254 V 75 M 82 71 L 86 75 L 90 71 M 250 71 L 254 75 L 258 71" />
    {[{line: 1, price: 350, x: 86}, {line: 2, price: 300, x: 254}].map(({line, price, x}) => (
      <g transform={`translate(${x} 0)`}>
        <text class="f-label" x="0" y="96" text-anchor="middle">L: 106/{line} · 7 · {price}</text>
        <path class="f-line" d="M 0 103 V 120 M -4 116 L 0 120 L 4 116" />
        <rect class="f-fill-green" x="-77" y="128" width="154" height="35" rx="6" />
        <text class="f-label" x="0" y="150" text-anchor="middle">{line} · TEA50 · {price}</text>
      </g>
    ))}
  </svg>
</Figure>
