---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Retrieval-augmented generation pipeline with the offline indexing path above
// the online query path.
interface Box { label: string; sub?: string; cls?: string }
const offline: Box[] = ru
  ? [
      { label: 'документы' },
      { label: 'нарезка', sub: 'по предложениям', cls: 'f-fill-amber' },
      { label: 'эмбеддинги', sub: 'биэнкодер', cls: 'f-fill-blue' },
      { label: 'индекс', sub: 'векторы + BM25', cls: 'f-fill-blue' },
    ]
  : [
      { label: 'documents' },
      { label: 'chunking', sub: 'sentences / tokens', cls: 'f-fill-amber' },
      { label: 'embedding', sub: 'bi-encoder', cls: 'f-fill-blue' },
      { label: 'vector index', sub: '+ BM25 index', cls: 'f-fill-blue' },
    ];
const online: Box[] = ru
  ? [
      { label: 'запрос' },
      { label: 'поиск топ-k', sub: 'плотный + BM25', cls: 'f-fill-blue' },
      { label: 'реранкер', sub: 'кросс-энкодер', cls: 'f-fill-blue' },
      { label: 'контекст', sub: 'бюджет, порядок', cls: 'f-fill-amber' },
      { label: 'генерация', sub: 'LLM + инструкция', cls: 'f-fill-green' },
      { label: 'ответ' },
    ]
  : [
      { label: 'query' },
      { label: 'retrieve top-k', sub: 'dense + lexical', cls: 'f-fill-blue' },
      { label: 'rerank', sub: 'cross-encoder', cls: 'f-fill-blue' },
      { label: 'build context', sub: 'budget, order, cite', cls: 'f-fill-amber' },
      { label: 'generate', sub: 'LLM + instruction', cls: 'f-fill-green' },
      { label: 'answer' },
    ];
const t = ru
  ? { off: 'заранее: индексация', on: 'на запрос: ответ', near: 'ближайшие фрагменты', svgTitle: 'Конвейер RAG',
      desc: 'Два ряда блоков, соединённых стрелками. Верхний ряд, заранее: документы, нарезка, эмбеддинги, векторный индекс. Нижний ряд, на запрос: запрос, поиск топ-k, реранкер, сборка контекста, генерация, ответ. Пунктирная стрелка ведёт от векторного индекса к шагу поиска.' }
  : { off: 'offline: indexing', on: 'online: answering', near: 'nearest chunks', svgTitle: 'RAG pipeline',
      desc: 'Two rows of boxes connected by arrows. Top row, offline: documents, chunking, embedding, vector index. Bottom row, online: query, retrieve top-k, rerank, build context, generate, answer. A dashed arrow connects the vector index to the retrieve step.' };
const boxH = 44;

// bw: box width; in the vertical layout the boxes stand in one column at x0.
interface Layout { cls: string; w: number; h: number; offY: number; onY: number; left: number; vertical: boolean; bw: number; gap: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', w: 846, h: 250, offY: 50, onY: 170, left: 16, vertical: false, bw: 124, gap: 14 },
  { cls: 'fig-narrow', w: 360, h: 640, offY: 40, onY: 300, left: 20, vertical: true, bw: 172, gap: 14 },
];
const boxX = (L: Layout, i: number) => (L.vertical ? L.left + 40 : L.left + i * (L.bw + L.gap));
const boxY = (L: Layout, rowY: number, i: number) => (L.vertical ? rowY + i * (boxH + L.gap) : rowY);
---

<Figure
  id="rag-pipeline"
  title={ru ? 'Генерация с извлечением: индекс, построенный заранее, и путь запроса' : 'Retrieval-augmented generation: an offline index and an online query path'}
  caption={ru
    ? 'Заранее документы режутся на фрагменты, кодируются и сохраняются в векторном индексе (и в лексическом индексе для гибридного поиска). Когда приходит запрос, он кодируется, извлекаются ближайшие фрагменты, кросс-энкодер переупорядочивает кандидатов, лучшие из них собираются в контекст в пределах бюджета токенов, и языковая модель порождает ответ по этому контексту с инструкцией опираться на него. Поисковую половину оценивают долей попаданий и MRR на эталонной выборке, порождающую — достоверностью и качеством ответа.'
    : 'Offline, documents are chunked, embedded and stored in a vector index (and a lexical index for hybrid search). Online, the query is embedded, the nearest chunks are retrieved, a cross-encoder reorders the candidates, the top ones are assembled into a context under a token budget, and a language model generates the answer from that context under an instruction to rely on it. The retrieval half is evaluated with hit rate and MRR on a golden set; the generation half with faithfulness and answer quality.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`rag-pipeline-${L.w}-t rag-pipeline-${L.w}-d`}>
      <title id={`rag-pipeline-${L.w}-t`}>{t.svgTitle}</title>
      <desc id={`rag-pipeline-${L.w}-d`}>{t.desc}</desc>
      {[{ boxes: offline, y: L.offY, title: t.off }, { boxes: online, y: L.onY, title: t.on }].map((row) => (
        <g>
          <text class="f-title" x={L.left} y={L.vertical ? row.y - 14 : row.y - 18}>{row.title}</text>
          {row.boxes.map((b, i) => {
            const x = boxX(L, i), y = boxY(L, row.y, i);
            return (
              <g>
                <rect class={b.cls ? `f-box ${b.cls}` : 'f-box-soft'} x={x} y={y} width={L.bw} height={boxH} rx="8" />
                <text class="f-label" x={x + L.bw / 2} y={y + (b.sub ? 19 : 27)} text-anchor="middle">{b.label}</text>
                {b.sub && <text class="f-small f-t-muted" x={x + L.bw / 2} y={y + 35} text-anchor="middle">{b.sub}</text>}
                {i < row.boxes.length - 1 && (L.vertical
                  ? <path class="f-line" d={`M ${x + L.bw / 2} ${y + boxH + 1} V ${y + boxH + L.gap - 3}`} marker-end="url(#f-arrow)" />
                  : <path class="f-line" d={`M ${x + L.bw + 1} ${y + boxH / 2} H ${x + L.bw + L.gap - 3}`} marker-end="url(#f-arrow)" />)}
              </g>
            );
          })}
        </g>
      ))}
      {(() => {
        // Dashed arrow from the index (offline box 3) to retrieval (online box 1).
        const ix = boxX(L, 3), iy = boxY(L, L.offY, 3), rx = boxX(L, 1), ry = boxY(L, L.onY, 1);
        if (L.vertical) {
          const side = ix + L.bw + 14, midY = (iy + ry + boxH) / 2;
          return (
            <g>
              <path class="f-line f-dash f-blue" d={`M ${ix + L.bw + 1} ${iy + boxH / 2} H ${side} V ${ry + boxH / 2} H ${rx + L.bw + 3}`} marker-end="url(#f-arrow-blue)" />
              <text class="f-small f-t-blue f-halo" x={side + 6} y={midY}>
                {t.near.split(' ').map((w, k) => <tspan x={side + 6} dy={k ? 15 : 0}>{w}</tspan>)}
              </text>
            </g>
          );
        }
        return (
          <g>
            <path class="f-line f-dash f-blue" d={`M ${ix + L.bw / 2} ${iy + boxH + 2} V ${L.onY - 30} H ${rx + L.bw / 2} V ${ry - 3}`} marker-end="url(#f-arrow-blue)" />
            <text class="f-small f-t-blue f-halo" x={boxX(L, 2) + L.bw / 2} y={L.onY - 36} text-anchor="middle">{t.near}</text>
          </g>
        );
      })()}
    </svg>
  ))}
</Figure>
