---
import Figure from '../Figure.astro';

// Retrieval-augmented generation pipeline with the offline indexing path above
// the online query path.
interface Box { label: string; sub?: string; cls?: string }
const offline: Box[] = [
  { label: 'documents' },
  { label: 'chunking', sub: 'sentences / tokens', cls: 'f-fill-amber' },
  { label: 'embedding', sub: 'bi-encoder', cls: 'f-fill-blue' },
  { label: 'vector index', sub: '+ BM25 index', cls: 'f-fill-blue' },
];
const online: Box[] = [
  { label: 'query' },
  { label: 'retrieve top-k', sub: 'dense + lexical', cls: 'f-fill-blue' },
  { label: 'rerank', sub: 'cross-encoder', cls: 'f-fill-blue' },
  { label: 'build context', sub: 'budget, order, cite', cls: 'f-fill-amber' },
  { label: 'generate', sub: 'LLM + instruction', cls: 'f-fill-green' },
  { label: 'answer' },
];
const boxW = 112;
const boxH = 44;
const gap = 16;

interface Layout { cls: string; w: number; h: number; offY: number; onY: number; left: number; vertical: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', w: 790, h: 250, offY: 50, onY: 170, left: 16, vertical: false },
  { cls: 'fig-narrow', w: 360, h: 640, offY: 40, onY: 300, left: 20, vertical: true },
];
---

<Figure
  id="rag-pipeline"
  title="Retrieval-augmented generation: an offline index and an online query path"
  caption="Offline, documents are chunked, embedded and stored in a vector index (and a lexical index for hybrid search). Online, the query is embedded, the nearest chunks are retrieved, a cross-encoder reorders the candidates, the top ones are assembled into a context under a token budget, and a language model generates the answer from that context under an instruction to rely on it. The retrieval half is evaluated with hit rate and MRR on a golden set; the generation half with faithfulness and answer quality."
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`rag-pipeline-${L.w}-t rag-pipeline-${L.w}-d`}>
      <title id={`rag-pipeline-${L.w}-t`}>RAG pipeline</title>
      <desc id={`rag-pipeline-${L.w}-d`}>Two rows of boxes connected by arrows. Top row, offline: documents, chunking, embedding, vector index. Bottom row, online: query, retrieve top-k, rerank, build context, generate, answer. A dashed arrow connects the vector index to the retrieve step.</desc>
      {[{ boxes: offline, y: L.offY, title: 'offline: indexing' }, { boxes: online, y: L.onY, title: 'online: answering' }].map((row) => (
        <g>
          <text class="f-title" x={L.left} y={L.vertical ? row.y - 14 : row.y - 18}>{row.title}</text>
          {row.boxes.map((b, i) => {
            const x = L.vertical ? L.left + 60 : L.left + i * (boxW + gap);
            const y = L.vertical ? row.y + i * (boxH + 14) : row.y;
            return (
              <g>
                <rect class={b.cls ? `f-box ${b.cls}` : 'f-box-soft'} x={x} y={y} width={boxW + (L.vertical ? 60 : 0)} height={boxH} rx="8" />
                <text class="f-label" x={x + (boxW + (L.vertical ? 60 : 0)) / 2} y={y + (b.sub ? 19 : 27)} text-anchor="middle">{b.label}</text>
                {b.sub && <text class="f-small f-t-muted" x={x + (boxW + (L.vertical ? 60 : 0)) / 2} y={y + 35} text-anchor="middle">{b.sub}</text>}
                {i < row.boxes.length - 1 && (L.vertical
                  ? <path class="f-line" d={`M ${x + (boxW + 60) / 2} ${y + boxH + 1} V ${y + boxH + 11}`} marker-end="url(#f-arrow)" />
                  : <path class="f-line" d={`M ${x + boxW + 1} ${y + boxH / 2} H ${x + boxW + gap - 3}`} marker-end="url(#f-arrow)" />)}
              </g>
            );
          })}
        </g>
      ))}
      {L.vertical
        ? <path class="f-line f-dash f-blue" d={`M ${L.left + 60 + (boxW + 60) / 2 + 60} ${L.offY + 3 * (boxH + 14) + boxH / 2} H ${L.left + 60 + boxW + 60 + 14} V ${L.onY + (boxH + 14) + boxH / 2} H ${L.left + 60 + boxW + 60 + 3}`} marker-end="url(#f-arrow-blue)" />
        : <path class="f-line f-dash f-blue" d={`M ${L.left + 3 * (boxW + gap) + boxW / 2} ${L.offY + boxH + 2} V ${L.onY - 30} H ${L.left + 1 * (boxW + gap) + boxW / 2} V ${L.onY - 3}`} marker-end="url(#f-arrow-blue)" />}
      <text class="f-small f-t-blue f-halo" x={L.vertical ? L.left + 60 + boxW + 60 + 18 : L.left + 2 * (boxW + gap) + boxW / 2} y={L.vertical ? (L.offY + 3 * (boxH + 14) + L.onY + boxH + 14) / 2 + 4 : L.onY - 36} text-anchor={L.vertical ? 'start' : 'middle'}>nearest chunks</text>
    </svg>
  ))}
</Figure>
