---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The token budget of the note's example and one way to order chunks so the best ones sit at the edges.
const ctx = 4096, instr = 200, question = 50, answer = 500;
const free = ctx - instr - question - answer;
if (free !== 3346) throw new Error('ContextBudget: budget drifted from the note');
// Ranks placed alternately at the start and the end: 1 3 5 … 6 4 2.
const edgeOrder = (n: number) => {
  const odd = Array.from({ length: n }, (_, i) => i + 1).filter((r) => r % 2 === 1);
  const even = Array.from({ length: n }, (_, i) => i + 1).filter((r) => r % 2 === 0).reverse();
  return [...odd, ...even];
};
// Better ranks are darker.
const shade = (rank: number, n: number) => (0.75 - (0.6 * (rank - 1)) / (n - 1)).toFixed(2);
const rows = [
  { size: 256, n: Math.floor(free / 256), label: '13 × 256' },
  { size: 600, n: Math.floor(free / 600), label: '5 × 600' },
];
const big = (v: number) => (ru ? String(v) : v.toLocaleString('en-US'));
const t = ru
  ? { instr: `инструкция ${instr}`, chunks: `фрагменты: ${big(free)} токенов`, qa: `вопрос ${question} · ответ ${answer}`, unused: (v: number) => `не занято ${v}`, good: 'используется лучше', bad: 'хуже всего', goodN: 'лучше', badN: 'хуже всего', instrS: 'инструкция', chunksS: 'фрагменты', qS: 'вопрос', aS: 'ответ' }
  : { instr: `instruction ${instr}`, chunks: `chunks: ${big(free)} tokens`, qa: `question ${question} · answer ${answer}`, unused: (v: number) => `unused ${v}`, good: 'used best', bad: 'used least', goodN: 'used best', badN: 'used least', instrS: 'instruction', chunksS: 'chunks', qS: 'question', aS: 'answer' };
const desc = ru
  ? `Окно ${big(ctx)} токенов: инструкция ${instr}, фрагменты ${big(free)}, вопрос ${question}, ответ ${answer}. Первая строка: 13 фрагментов по 256 токенов в порядке рангов ${edgeOrder(13).join(' ')}. Вторая: 5 фрагментов по 600 токенов в порядке ${edgeOrder(5).join(' ')}, 346 токенов не занято.`
  : `A ${big(ctx)}-token window: instruction ${instr}, chunks ${big(free)}, question ${question}, answer ${answer}. First row: 13 chunks of 256 tokens in rank order ${edgeOrder(13).join(' ')}. Second row: 5 chunks of 600 tokens in order ${edgeOrder(5).join(' ')}, 346 tokens unused.`;
const id = 'rag-context-budget';
interface Layout { cls: string; W: number; H: number; x0: number; x1: number; rowY: number[]; legend: boolean; bandY: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 720, H: 218, x0: 130, x1: 690, rowY: [64, 162], legend: false, bandY: 106 },
  { cls: 'fig-narrow', W: 360, H: 262, x0: 8, x1: 352, rowY: [40, 150], legend: true, bandY: 82 },
];
const barH = 32;
---

<Figure
  id={id}
  title={ru ? 'Контекст в пределах бюджета токенов' : 'A context under a token budget'}
  caption={ru
    ? `Бюджет из примера в тексте: окно в ${big(ctx)} токенов, инструкция в ${instr} токенов, вопрос в ${question} и ${answer} токенов, оставленных под ответ, дают ${big(free)} токенов на найденный текст. Туда помещаются тринадцать фрагментов по 256 токенов (18 остаются) или пять родительских фрагментов по 600 (346 остаются): больше кусков — выше шанс, что ответ среди них, длиннее куски — больше контекста у каждого. Числа в клетках — ранги после переранжирования, расставленные так, чтобы лучшие фрагменты стояли в начале и в конце контекста, а слабые — в середине, которую модели с длинным контекстом используют хуже всего (Liu et al., 2024; полоса под первой строкой схематична).`
    : `The budget of the example in the text: a ${big(ctx)}-token window, an instruction of ${instr} tokens, a question of ${question} and ${answer} tokens kept free for the answer leave ${big(free)} tokens for retrieved text. That holds thirteen 256-token chunks (18 tokens left over) or five 600-token parent chunks (346 left over): more pieces raise the chance that the answer is among them, longer ones give each more context. The numbers in the cells are reranker ranks, placed so that the best chunks sit at the beginning and the end of the context and the weakest in the middle, which long-context models use least (Liu et al., 2024; the band under the first row is schematic).`}
>
  {layouts.map((L) => {
    const s = (L.x1 - L.x0) / ctx;
    const xInstr = L.x0, xChunks = L.x0 + instr * s, xQ = L.x0 + (instr + free) * s, xA = xQ + question * s;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Бюджет токенов и порядок фрагментов' : 'Token budget and chunk order'}</title>
        <desc id={`${id}-${L.W}-d`}>{desc}</desc>
        {!L.legend && <text class="f-small" x={xInstr} y={L.rowY[0] - 10}>{t.instr}</text>}
        {!L.legend && <text class="f-small f-t-amber" x={(xChunks + xQ) / 2} y={L.rowY[0] - 10} text-anchor="middle">{t.chunks}</text>}
        {!L.legend && <text class="f-small" x={L.x1} y={L.rowY[0] - 10} text-anchor="end">{t.qa}</text>}
        {rows.map((row, ri) => {
          const y = L.rowY[ri], order = edgeOrder(row.n), cw = row.size * s;
          const used = row.n * row.size, left = free - used;
          return (
            <g>
              <text class="f-small f-t-muted" x={L.legend ? L.x0 : L.x0 - 12} y={L.legend ? y - 8 : y + barH / 2 + 4} text-anchor={L.legend ? 'start' : 'end'}>{L.legend ? `${row.label}${ru ? ' токенов' : ' tokens'}` : row.label}</text>
              <rect class="f-box f-fill-blue" x={xInstr} y={y} width={xChunks - xInstr} height={barH} />
              {order.map((rank, i) => (
                <g>
                  <rect x={xChunks + i * cw} y={y} width={cw} height={barH} style={`fill: var(--fig-amber); fill-opacity: ${shade(rank, row.n)}; stroke: var(--paper); stroke-width: 1`} />
                  <text class="f-small" x={xChunks + i * cw + cw / 2} y={y + barH / 2 + 4} text-anchor="middle">{rank}</text>
                </g>
              ))}
              {left > 40 && <text class="f-small f-t-muted" x={xChunks + used * s + (left * s) / 2} y={y + barH + 14} text-anchor="middle">{t.unused(left)}</text>}
              <rect class="f-thin f-muted" x={xChunks + used * s} y={y} width={left * s} height={barH} fill="none" />
              <rect class="f-box f-fill-blue" x={xQ} y={y} width={question * s} height={barH} />
              <rect class="f-thin f-green f-dash" x={xA} y={y} width={L.x1 - xA} height={barH} style="fill: var(--fig-green); fill-opacity: 0.12" />
            </g>
          );
        })}
        <defs>
          <linearGradient id={`${id}-${L.W}-g`} x1="0" x2="1" y1="0" y2="0">
            <stop offset="0" style="stop-color: var(--ink); stop-opacity: 0.55" />
            <stop offset="0.5" style="stop-color: var(--ink); stop-opacity: 0.06" />
            <stop offset="1" style="stop-color: var(--ink); stop-opacity: 0.55" />
          </linearGradient>
        </defs>
        <rect x={xChunks} y={L.bandY} width={xQ - xChunks} height="7" rx="3.5" fill={`url(#${id}-${L.W}-g)`} />
        <text class="f-small f-t-muted" x={xChunks} y={L.bandY + 22}>{L.legend ? t.goodN : t.good}</text>
        <text class="f-small f-t-muted" x={(xChunks + xQ) / 2} y={L.bandY + 22} text-anchor="middle">{L.legend ? t.badN : t.bad}</text>
        <text class="f-small f-t-muted" x={xQ} y={L.bandY + 22} text-anchor="end">{L.legend ? t.goodN : t.good}</text>
        {L.legend && [[t.instrS, 'blue'], [t.chunksS, 'amber'], [t.qS, 'blue'], [t.aS, 'green']].map(([label, c], i) => (
          <g>
            <rect x={L.x0 + (i % 2) * 170} y={L.H - 44 + Math.floor(i / 2) * 20} width="12" height="12" style={`fill: var(--fig-${c}); fill-opacity: ${c === 'green' ? 0.25 : 0.55}`} />
            <text class="f-small" x={L.x0 + (i % 2) * 170 + 18} y={L.H - 34 + Math.floor(i / 2) * 20}>{`${label}${i === 0 ? ` ${instr}` : i === 1 ? ` ${big(free)}` : i === 2 ? ` ${question}` : ` ${answer}`}`}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
