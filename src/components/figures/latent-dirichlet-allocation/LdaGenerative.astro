---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import Arrow from '../seqflow/Arrow.astro';
import Sub from '../generative-modeling/Sub.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Two topics over six words, one document with proportions (0.7, 0.3), and eight words generated from them.
const words = ru ? ['матч', 'гол', 'команда', 'цена', 'рынок', 'банк'] : ['match', 'goal', 'team', 'price', 'market', 'bank'];
const phi = [[0.30, 0.30, 0.34, 0.02, 0.02, 0.02], [0.02, 0.02, 0.02, 0.30, 0.34, 0.30]];
const theta = [0.7, 0.3];
phi.forEach((row) => { if (Math.abs(row.reduce((a, b) => a + b, 0) - 1) > 1e-12) throw new Error('LdaGenerative: a topic does not sum to 1'); });
const pGoal = theta[0] * phi[0][1] + theta[1] * phi[1][1];
if (pGoal.toFixed(3) !== '0.216') throw new Error('LdaGenerative: p(goal | d) drifted from the note');
const tokens: [number, number][] = [[2, 0], [1, 0], [4, 1], [0, 0], [1, 0], [5, 1], [2, 0], [0, 0]];   // (word, topic)
const tone = ['blue', 'amber'];
const showVal = phi.map((row) => row.map((v) => v > 0.1));   // narrow layout: label only the large bars

const t = ru
  ? { topics: ['тема 1: спорт', 'тема 2: экономика'], theta: 'доли тем', doc: 'документ d', formula: `p(гол | d) = 0.7 · 0.30 + 0.3 · 0.02 = ${pGoal.toFixed(3)}`, steps: ['темы φ_k ~ Dir(β): распределения на словаре, общие для всех документов', 'доли тем документа θ_d ~ Dir(α): здесь 0.7 и 0.3', 'тема для каждой позиции, z_dn ~ Cat(θ_d): шесть синих, две жёлтые', 'слово w_dn ~ Cat(φ_z) из выбранной темы'] }
  : { topics: ['topic 1: sports', 'topic 2: economics'], theta: 'proportions', doc: 'document d', formula: `p(goal | d) = 0.7 · 0.30 + 0.3 · 0.02 = ${pGoal.toFixed(3)}`, steps: ['topics φ_k ~ Dir(β): distributions over the vocabulary, shared by all documents', "the document's topic proportions θ_d ~ Dir(α): here 0.7 and 0.3", 'a topic for every position, z_dn ~ Cat(θ_d): six blue, two amber', 'a word w_dn ~ Cat(φ_z) from the chosen topic'] };
const id = 'lda-generative';
const W1 = { cls: 'fig-wide fig-bp-640', W: 760, H: 290 };
const W2 = { cls: 'fig-narrow seq-narrow fig-bp-640', W: 360, H: 560 };
---

<Figure
  id={id}
  title={ru ? 'Как LDA порождает документ' : 'How LDA generates a document'}
  caption={ru
    ? 'Две темы на словаре из шести слов (1) и документ с долями тем 0.7 и 0.3 (2). Для каждой из восьми позиций выбирается тема (3), затем слово из этой темы (4). Вероятность слова — смесь тем с долями документа: p(гол | d) = 0.7 · 0.30 + 0.3 · 0.02 = 0.216.'
    : 'Two topics over a vocabulary of six words (1) and one document with topic proportions 0.7 and 0.3 (2). For each of its eight positions a topic is drawn (3), then a word from that topic (4). A word’s probability mixes the topics with the document’s proportions: p(goal | d) = 0.7 · 0.30 + 0.3 · 0.02 = 0.216.'}
>
  <svg class={W1.cls} viewBox={`0 0 ${W1.W} ${W1.H}`} role="img" aria-labelledby={`${id}-760-t ${id}-760-d`}>
    <title id={`${id}-760-t`}>{ru ? 'Порождающий процесс LDA' : 'The generative process of LDA'}</title>
    <desc id={`${id}-760-d`}>{ru ? 'Слева две темы как столбцы вероятностей шести слов, в середине столбик долей тем документа, справа восемь слов документа, окрашенных по темам.' : 'Left, two topics as bars of probability over six words; middle, a bar of the document topic proportions; right, the eight words of the document, coloured by topic.'}</desc>
    <g data-s="1">
      <Badge x={28} y={30} n={1} />
      {t.topics.map((name, k) => <text class={`f-small f-t-${tone[k]}`} x={100 + k * 150} y={52}>{name}</text>)}
      {words.map((w, j) => (
        <g>
          <text class="f-small" x={92} y={78 + j * 26} text-anchor="end">{w}</text>
          {phi.map((row, k) => (
            <g>
              <rect class={`f-fill-${tone[k]}`} x={100 + k * 150} y={66 + j * 26} width={row[j] * 290} height="16" style={`stroke: var(--fig-${tone[k]}); stroke-width: 1`} />
              <text class="f-small f-t-muted" x={104 + k * 150 + row[j] * 290} y={78 + j * 26}>{row[j].toFixed(2)}</text>
            </g>
          ))}
        </g>
      ))}
    </g>
    <g data-s="2">
      <Badge x={388} y={30} n={2} />
      <text class="f-small" x={418} y={52} text-anchor="middle">{t.theta}</text>
      <rect class="f-fill-blue" x={400} y={66} width="36" height={theta[0] * 150} style="stroke: var(--fig-blue); stroke-width: 1.2" />
      <rect class="f-fill-amber" x={400} y={66 + theta[0] * 150} width="36" height={theta[1] * 150} style="stroke: var(--fig-amber); stroke-width: 1.2" />
      <text class="f-small f-t-blue" x={444} y={66 + theta[0] * 75 + 4}>0.7</text>
      <text class="f-small f-t-amber" x={444} y={66 + theta[0] * 150 + theta[1] * 75 + 4}>0.3</text>
      <text class="f-math" x={418} y={240} text-anchor="middle"><Sub label="θ_d" /></text>
    </g>
    <text class="f-small" x={617} y={52} text-anchor="middle">{t.doc}</text>
    {tokens.map(([w, k], i) => {
      const x = 488 + (i % 4) * 66, y = 70 + Math.floor(i / 4) * 56;
      return (
        <g>
          <g data-s="3"><rect x={x} y={y} width="60" height="32" rx="5" class={`f-fill-${tone[k]}`} style={`stroke: var(--fig-${tone[k]}); stroke-width: 1.4`} /></g>
          <g data-s="4"><text class="f-small" x={x + 30} y={y + 20} text-anchor="middle">{words[w]}</text></g>
        </g>
      );
    })}
    <g data-s="3">
      <Arrow pts={[[468, 114], [484, 114]]} tone="muted" />
      <Badge x={476} y={94} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[225, 222], [617, 222], [617, 166]]} tone="muted" />
      <Badge x={632} y={196} n={4} />
      <text class="f-small" x={270} y={272}>{t.formula}</text>
    </g>
  </svg>
  <svg class={W2.cls} viewBox={`0 0 ${W2.W} ${W2.H}`} role="img" aria-labelledby={`${id}-360-t ${id}-360-d`}>
    <title id={`${id}-360-t`}>{ru ? 'Порождающий процесс LDA' : 'The generative process of LDA'}</title>
    <desc id={`${id}-360-d`}>{ru ? 'Сверху две темы как столбцы вероятностей шести слов, ниже полоса долей тем документа и восемь слов документа, окрашенных по темам.' : 'At the top, two topics as bars of probability over six words; below, a bar of the document topic proportions and the eight words of the document, coloured by topic.'}</desc>
    <g data-s="1">
      <Badge x={14} y={22} n={1} />
      {t.topics.map((name, k) => <text class={`f-small f-t-${tone[k]}`} x={k ? 222 : 90} y={50}>{name}</text>)}
      {words.map((w, j) => (
        <g>
          <text class="f-small" x={82} y={80 + j * 28} text-anchor="end">{w}</text>
          {phi.map((row, k) => (
            <g>
              <rect class={`f-fill-${tone[k]}`} x={90 + k * 132} y={66 + j * 28} width={row[j] * 250} height="18" style={`stroke: var(--fig-${tone[k]}); stroke-width: 1`} />
              {showVal[k][j] && <text class="f-small f-t-muted" x={94 + k * 132 + row[j] * 250} y={80 + j * 28}>{row[j].toFixed(2)}</text>}
            </g>
          ))}
        </g>
      ))}
    </g>
    <g data-s="2">
      <Badge x={14} y={262} n={2} />
      <text class="f-small" x={32} y={267}>{t.theta} <tspan class="f-math">θ</tspan></text>
      <rect class="f-fill-blue" x={20} y={280} width={theta[0] * 320} height="28" style="stroke: var(--fig-blue); stroke-width: 1.2" />
      <rect class="f-fill-amber" x={20 + theta[0] * 320} y={280} width={theta[1] * 320} height="28" style="stroke: var(--fig-amber); stroke-width: 1.2" />
      <text class="f-small" x={20 + theta[0] * 160} y={299} text-anchor="middle">0.7</text>
      <text class="f-small" x={20 + theta[0] * 320 + theta[1] * 160} y={299} text-anchor="middle">0.3</text>
    </g>
    <g data-s="3"><Badge x={14} y={344} n={3} /></g>
    <text class="f-small" x={32} y={349}>{t.doc}</text>
    {tokens.map(([w, k], i) => {
      const x = 20 + (i % 4) * 82, y = 364 + Math.floor(i / 4) * 48;
      return (
        <g>
          <g data-s="3"><rect x={x} y={y} width="76" height="36" rx="5" class={`f-fill-${tone[k]}`} style={`stroke: var(--fig-${tone[k]}); stroke-width: 1.4`} /></g>
          <g data-s="4"><text class="f-small" x={x + 38} y={y + 23} text-anchor="middle">{words[w]}</text></g>
        </g>
      );
    })}
    <g data-s="4">
      <Badge x={14} y={486} n={4} />
      <text class="f-small" x={32} y={491}>{ru ? 'слово из выбранной темы' : 'a word from the chosen topic'}</text>
      <text class="f-small" x={20} y={530}>{t.formula}</text>
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
