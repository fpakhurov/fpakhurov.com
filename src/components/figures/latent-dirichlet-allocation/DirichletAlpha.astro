---
import Figure from '../Figure.astro';
import { dirichletDraws } from './dirichlet';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// 300 seeded draws of topic proportions from Dir(alpha, alpha, alpha) for alpha = 0.1, 1 and 10, plotted on the
// triangle whose corners are the three topics, with the share of draws in which one topic takes more than 90%.
const alphas = [0.1, 1, 10];
const draws = alphas.map((a) => dirichletDraws(a, 3, 300, 5 + a * 10));
const share = draws.map((d) => d.filter((t) => Math.max(...t) > 0.9).length / d.length);
if (share.map((v) => v.toFixed(3)).join() !== '0.703,0.027,0.000') throw new Error(`DirichletAlpha: shares drifted from the caption (${share.join()})`);
const pct = (v: number) => `${(100 * v).toFixed(1).replace(/\.0$/, '')}%`;

const t = ru
  ? { a: (a: number) => `α = ${a}`, s: (v: number) => `одна тема больше 0.9: ${pct(v)}` }
  : { a: (a: number) => `α = ${a}`, s: (v: number) => `one topic above 0.9: ${pct(v)}` };
const id = 'dirichlet-alpha';
const side = [200, 170];
const layouts = [
  { cls: 'fig-wide fig-bp-640', W: 760, H: 280, tri: alphas.map((_, j) => ({ x: 30 + j * 250, y: 34 })), lab: 'below' },
  { cls: 'fig-narrow seq-narrow fig-bp-640', W: 360, H: 690, tri: alphas.map((_, j) => ({ x: 95, y: 24 + j * 225 })), lab: 'below' },
];
---

<Figure
  id={id}
  title={ru ? 'Что делает параметр α' : 'What the parameter α does'}
  caption={ru
    ? 'По 300 случайных векторов долей трёх тем из Dir(α, α, α); вершины — документы на одну тему, центр — равная смесь. При α = 0.1 одна тема забирает больше 0.9 в 70.3% выборок (в самом распределении — 65.9%); при α = 1 распределение равномерно (3%, в выборке 2.7%); при α = 10 доли сосредоточены у центра.'
    : '300 random vectors of proportions over three topics from Dir(α, α, α); the corners are single-topic documents, the centre an even mix. With α = 0.1 one topic takes more than 0.9 in 70.3% of the draws (65.9% in the distribution); with α = 1 the distribution is uniform (3%, 2.7% in the sample); with α = 10 the proportions crowd the centre.'}
>
  {layouts.map((L) => {
    const s = side[L.W === 760 ? 0 : 1], h = (s * Math.sqrt(3)) / 2;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Выборки из распределения Дирихле при трёх значениях α' : 'Draws from the Dirichlet distribution for three values of α'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Три треугольника с точками: при α = 0.1 точки прижаты к вершинам и сторонам, при α = 1 рассыпаны равномерно, при α = 10 собраны в центре.' : 'Three triangles of points: with α = 0.1 the points hug the corners and edges, with α = 1 they are spread evenly, with α = 10 they gather in the centre.'}</desc>
        {alphas.map((a, j) => {
          const { x, y } = L.tri[j];
          const A = [x + s / 2, y], B = [x, y + h], C = [x + s, y + h];
          const pt = (th: number[]) => [th[0] * A[0] + th[1] * B[0] + th[2] * C[0], th[0] * A[1] + th[1] * B[1] + th[2] * C[1]];
          const below = L.lab === 'below';
          return (
            <g>
              <path class="f-thin f-muted" d={`M ${A[0]} ${A[1]} L ${B[0]} ${B[1]} L ${C[0]} ${C[1]} Z`} />
              {draws[j].map((th) => { const [px, py] = pt(th); return <circle class="f-solid-blue" cx={px.toFixed(1)} cy={py.toFixed(1)} r="1.9" style="fill-opacity: 0.55" />; })}
              <text class="f-small f-t-muted" x={A[0]} y={A[1] - 6} text-anchor="middle">1</text>
              <text class="f-small f-t-muted" x={B[0] - 6} y={B[1] + 4} text-anchor="end">2</text>
              <text class="f-small f-t-muted" x={C[0] + 6} y={C[1] + 4}>3</text>
              <text class="f-label" x={below ? x + s / 2 : x + s + 26} y={below ? y + h + 28 : y + h / 2} text-anchor={below ? 'middle' : 'start'}>{t.a(a)}</text>
              <text class="f-small f-t-muted" x={below ? x + s / 2 : x + s + 26} y={below ? y + h + 48 : y + h / 2 + 22} text-anchor={below ? 'middle' : 'start'}>{t.s(share[j])}</text>
            </g>
          );
        })}
      </svg>
    );
  })}
</Figure>
