---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const ru = pageLang(Astro.url) === 'ru';
const id = 'gan-scaling-self-attention';
const a = cases.attention;
const sx = (g: number) => 48 + (g + 1) * 78;
const sy = (y: number) => 192 - (y + 3) * 31;
const points = a.gate_curve.map(p => `${sx(p.gamma)},${sy(p.output)}`).join(' ');
const weightLabels = ['1/6', '1/3', '1/2'];
const weightedLabels = ['−1/2', '0', '2'];
---
<Figure id={id}
 title={ru ? 'Один запрос и остаточный гейт' : 'One query and a residual gate'}
 caption={ru ? 'Заданные оценки 0, log 2, log 3 дают агрегат 3/2. При γ = 0 ветвь не меняет выход −1, но градиент гейта равен −9/2 для цели 2. Линия показывает заданный скалярный расчёт, не обучение сети.' : 'The specified scores 0, log 2, log 3 give aggregate 3/2. At γ = 0 the branch leaves output −1 unchanged, but the gate gradient is −9/2 for target 2. The line shows the specified scalar calculation, not network training.'}>
 <div class="attention-panels">
  <section>
   <h4>{ru ? 'Взвешенные значения' : 'Weighted values'}</h4>
   <table aria-label={ru ? 'Три исходные позиции одного запроса' : 'Three source positions for one query'}>
    <thead><tr><th scope="col">i</th><th scope="col">βᵢ</th><th scope="col">hᵢ</th><th scope="col">βᵢhᵢ</th></tr></thead>
    <tbody>{a.values.map((v,i) => <tr data-position={i}><th scope="row">{i+1}</th><td data-weight={a.weights[i]}>{weightLabels[i]}</td><td data-value={v}>{v}</td><td>{weightedLabels[i]}</td></tr>)}</tbody>
   </table>
   <p class="sum" data-aggregate={a.attention_output}>o = −1/2 + 0 + 2 = 3/2</p>
  </section>
  <section>
   <h4>{ru ? 'Выход при разных γ' : 'Output at different γ'}</h4>
   <svg viewBox="0 0 320 238" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
    <title id={`${id}-title`}>{ru ? 'Остаточный выход как функция гейта' : 'Residual output as a function of the gate'}</title>
    <desc id={`${id}-desc`}>{ru ? 'Прямая y = −1 + 1.5γ. При γ = 0 выход −1, при γ = 2 выход достигает заданной цели 2. Градиент потерь по γ в нуле отрицателен.' : 'The line y = −1 + 1.5γ. At γ = 0 output is −1; at γ = 2 it reaches the specified target 2. The loss gradient with respect to γ at zero is negative.'}</desc>
    <path class="f-axis" d="M48 24V192H282" />
    {[-1,0,1,2].map(g => <g><path class="f-axis" d={`M${sx(g)} 192v5`} /><text class="f-label" x={sx(g)} y="216" text-anchor="middle">{g}</text></g>)}
    {[-3,-1,0,2].map(v => <g><path class="f-axis" d={`M43 ${sy(v)}h5`} /><text class="f-label" x="37" y={sy(v)+5} text-anchor="end">{v}</text></g>)}
    <path class="f-axis target" d={`M48 ${sy(a.target)}H282`} />
    <polyline class="f-line f-blue" data-series="gate" points={points} />
    <circle class="point" cx={sx(0)} cy={sy(a.input)} r="4" data-gamma="0" data-output={a.input} />
    <text class="f-label f-t-blue" x={sx(0)+8} y={sy(a.input)+22}>γ = 0</text>
    <text class="f-label" x="50" y="18">y</text><text class="f-label" x="300" y="197">γ</text>
    <text class="f-label" x="160" y={sy(a.target)-9}>{ru ? 'цель 2' : 'target 2'}</text>
   </svg>
  </section>
 </div>
</Figure>
<style>
 .attention-panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem;align-items:start}
 .attention-panels section{min-width:0}
 .attention-panels h4{font-size:1rem;margin:0 0 .75rem;text-align:center;color:var(--ink)}
 .attention-panels table{display:table;table-layout:auto;width:100%;border-collapse:collapse;font-variant-numeric:tabular-nums}
 .attention-panels th,.attention-panels td{padding:.6rem .3rem;text-align:center;color:var(--ink);border-bottom:1px solid var(--line)}
 .attention-panels th{white-space:normal;word-break:normal;font-weight:600}
 .attention-panels .sum{text-align:center;color:var(--ink);font-size:.95rem;font-variant-numeric:tabular-nums;margin:.8rem 0 0}
 .attention-panels svg{display:block;width:100%;max-width:400px;margin:0 auto}
 .target{stroke-dasharray:5 5}
 .point{fill:var(--fig-blue)}
 @media(max-width:700px){.attention-panels{grid-template-columns:1fr;gap:1.5rem}.attention-panels table{max-width:400px;margin:auto}}
</style>
