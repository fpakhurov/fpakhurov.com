---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { phi } from '../normal';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Truncation trick on one coordinate z ~ N(0, 1): values with |z| > τ are resampled, so the coordinate follows
// N(0, 1) conditioned on |z| ≤ τ. With m0(τ) = ∫_0^τ φ and m2(τ) = ∫_0^τ z² φ (Simpson's rule):
//   kept mass  P(|z| ≤ τ) = 2·m0(τ),   standard deviation  sd(τ) = sqrt(m2(τ) / m0(τ)),
//   probability that none of the d = 120 coordinates of z needs resampling = P(|z| ≤ τ)^120.
const D = 120;
const simpson = (f: (u: number) => number, a: number, b: number, n = 400) => {
  if (b === a) return 0;
  const h = (b - a) / n;
  let s = f(a) + f(b);
  for (let i = 1; i < n; i += 1) s += (i % 2 ? 4 : 2) * f(a + i * h);
  return (s * h) / 3;
};
const kept = (tau: number) => 2 * simpson(phi, 0, tau);
const sd = (tau: number) => (tau === 0 ? 0 : Math.sqrt(simpson((u) => u * u * phi(u), 0, tau) / simpson(phi, 0, tau)));
const whole = (tau: number) => kept(tau) ** D;

// Numbers quoted in the caption and in the note.
const check = (name: string, got: number, want: number, tol: number) => {
  if (Math.abs(got - want) > tol) throw new Error(`TruncationCurves: ${name} = ${got}, expected ${want}`);
};
check('kept(2)', kept(2), 0.9545, 5e-5);
check('kept(1)', kept(1), 0.6827, 5e-5);
check('kept(0.5)', kept(0.5), 0.3829, 5e-5);
check('sd(2)', sd(2), 0.880, 5e-4);
check('sd(1)', sd(1), 0.540, 5e-4);
check('sd(0.5)', sd(0.5), 0.284, 5e-4);
check('whole(2)', whole(2), 0.0037, 5e-5);
check('whole(3)', whole(3), 0.72, 5e-3);
check('rms norm at 1', Math.sqrt(D) * sd(1), 5.91, 5e-3);
check('rms norm at 0.5', Math.sqrt(D) * sd(0.5), 3.11, 5e-3);

const marks = [0.5, 1, 2];
const taus = Array.from({ length: 151 }, (_, i) => (3 * i) / 150);
const fmt2 = (v: number) => v.toFixed(2);
const fmt3 = (v: number) => v.toFixed(3);
const id = 'gan-scaling-truncation';

const layouts = [
  { cls: 'fig-wide fig-medium', sfx: 'w', W: 616, H: 340, L: 56, R: 420, T: 28, B: 288, legendX: 440, legendY: 60, legendStep: 44, narrow: false },
  { cls: 'fig-narrow', sfx: 'n', W: 360, H: 440, L: 44, R: 340, T: 24, B: 280, legendX: 44, legendY: 340, legendStep: 30, narrow: true },
].map((o) => {
  const sx = scale([0, 3], [o.L, o.R]);
  const sy = scale([0, 1], [o.B, o.T]);
  const path = (f: (t: number) => number) => polyline(taus.map((t) => [sx(t), sy(f(t))] as const));
  return {
    ...o, sx, sy,
    keptPath: path(kept), sdPath: path(sd), wholePath: path(whole),
    pts: marks.map((m) => ({ m, x: sx(m), yk: sy(kept(m)), ys: sy(sd(m)), k: kept(m).toFixed(4), s: fmt3(sd(m)) })),
  };
});

const t = ru
  ? {
      title: 'Усечение одной координаты: доля сохранённой массы и разброс',
      keptShort: ['P(|z| ≤ τ)', 'сохранённая масса'],
      sdShort: ['ст. отклонение', 'после усечения'],
      wholeShort: ['все 120 координат', 'не пересэмплированы'],
      axis: 'порог τ',
    }
  : {
      title: 'Truncating one coordinate: mass kept and spread',
      keptShort: ['P(|z| ≤ τ)', 'mass kept'],
      sdShort: ['standard deviation', 'after truncation'],
      wholeShort: ['all 120 coordinates', 'left untouched'],
      axis: 'threshold τ',
    };
const legend = [
  { a: t.keptShort[0], b: t.keptShort[1], cls: 'f-blue', tcls: 'f-t-blue' },
  { a: t.sdShort[0], b: t.sdShort[1], cls: 'f-red', tcls: 'f-t-red' },
  { a: t.wholeShort[0], b: t.wholeShort[1], cls: 'f-amber f-dash', tcls: 'f-t-amber' },
];
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? `Координата z ~ N(0, 1) усекается порогом τ (значения с |z| > τ пересэмплируются). Синяя кривая — вероятность, что значение сохранится, 2Φ(τ) − 1; красная — стандартное отклонение после усечения; жёлтая пунктирная — вероятность, что ни одну из 120 координат латентного вектора BigGAN не придётся пересэмплировать. При τ = 2 каждая координата сохраняет ${kept(2).toFixed(4)} своей массы, но нетронутой остаётся лишь доля ${whole(2).toFixed(4)} векторов.`
    : `One coordinate z ~ N(0, 1) truncated at τ (values with |z| > τ resampled). Blue: probability a value is kept, 2Φ(τ) − 1; red: standard deviation after truncation; amber, dashed: probability that none of the 120 coordinates of BigGAN's latent is resampled. At τ = 2 each coordinate keeps ${kept(2).toFixed(4)} of its mass, yet only ${whole(2).toFixed(4)} of the vectors stay untouched.`}
>
  {layouts.map((o) => (
    <svg class={o.cls} viewBox={`0 0 ${o.W} ${o.H}`} role="img" aria-labelledby={`${id}-${o.sfx}-t ${id}-${o.sfx}-d`}>
      <title id={`${id}-${o.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${o.sfx}-d`}>{ru
        ? 'График по порогу τ от 0 до 3. Синяя кривая — доля сохранённой массы — растёт от 0 до почти 1. Красная кривая — стандартное отклонение — растёт от 0 до почти 1, оставаясь ниже синей. Жёлтая пунктирная кривая — вероятность сохранить все 120 координат — почти равна нулю до τ около 2 и поднимается до 0.72 при τ = 3. Отмечены точки при τ = 0.5, 1 и 2.'
        : 'A plot against the threshold tau from 0 to 3. The blue curve, the mass kept, rises from 0 to nearly 1. The red curve, the standard deviation, rises from 0 to nearly 1 and stays below the blue one. The amber dashed curve, the probability that all 120 coordinates are kept, is almost zero until tau is about 2 and rises to 0.72 at tau = 3. Points at tau = 0.5, 1 and 2 are marked.'}</desc>
      {[0, 0.25, 0.5, 0.75, 1].map((v) => <line class="f-grid" x1={o.L} x2={o.R} y1={o.sy(v)} y2={o.sy(v)} />)}
      {[0, 0.25, 0.5, 0.75, 1].map((v) => <text class="f-note" x={o.L - 8} y={o.sy(v) + 4} text-anchor="end">{v}</text>)}
      {marks.map((m) => <line class="f-grid" x1={o.sx(m)} x2={o.sx(m)} y1={o.T} y2={o.B} />)}
      <path class="f-axis" d={`M ${o.L} ${o.B} H ${o.R + 12}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-axis" d={`M ${o.L} ${o.B} V ${o.T - 10}`} marker-end="url(#f-arrow-muted)" />
      {[0, 0.5, 1, 1.5, 2, 2.5, 3].map((v) => <text class="f-note" x={o.sx(v)} y={o.B + 18} text-anchor="middle">{v}</text>)}
      <text class="f-note" x={o.R} y={o.B + 36} text-anchor="end">{t.axis}</text>

      <path class="f-line f-blue f-bold" d={o.keptPath} />
      <path class="f-line f-red f-bold" d={o.sdPath} />
      <path class="f-line f-amber f-bold f-dash" d={o.wholePath} />

      {o.pts.map((p) => (
        <g>
          <circle class="f-solid-blue" cx={p.x} cy={p.yk} r="4" />
          <circle class="f-solid-red" cx={p.x} cy={p.ys} r="4" />
          <text class="f-small f-t-blue f-halo" x={p.x - 6} y={p.yk - 8} text-anchor="end">{p.k}</text>
          <text class="f-small f-t-red f-halo" x={p.x + 6} y={p.ys + 16}>{p.s}</text>
        </g>
      ))}
      <circle cx={o.sx(2)} cy={o.sy(whole(2))} r="4" style="fill: var(--fig-amber)" />
      <text class="f-small f-t-amber f-halo" x={o.sx(2) - 6} y={o.sy(whole(2)) - 8} text-anchor="end">{whole(2).toFixed(4)}</text>
      <circle cx={o.sx(3)} cy={o.sy(whole(3))} r="4" style="fill: var(--fig-amber)" />
      <text class="f-small f-t-amber f-halo" x={o.sx(3) - 8} y={o.sy(whole(3)) + 4} text-anchor="end">{fmt2(whole(3))}</text>

      {legend.map((g, i) => (
        <g>
          <line class={`f-line f-bold ${g.cls}`} x1={o.legendX} x2={o.legendX + 24} y1={o.legendY + i * o.legendStep - 4} y2={o.legendY + i * o.legendStep - 4} />
          {o.narrow
            ? <text class={`f-small ${g.tcls}`} x={o.legendX + 32} y={o.legendY + i * o.legendStep}>{`${g.a} · ${g.b}`}</text>
            : <text class={`f-small ${g.tcls}`} x={o.legendX + 30} y={o.legendY + i * o.legendStep}>{g.a}{' '}<tspan x={o.legendX + 30} dy="15">{g.b}</tspan></text>}
        </g>
      ))}
    </svg>
  ))}
</Figure>
