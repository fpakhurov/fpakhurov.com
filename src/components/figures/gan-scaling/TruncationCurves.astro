---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const ru = pageLang(Astro.url) === 'ru';
const id = 'gan-scaling-truncation';
const sx = (t: number) => 45 + t * 79;
const sy = (p: number) => 190 - p * 154;
const poly = (key: 'variance' | 'six_unchanged' | 'valid_centered' | 'valid_shifted') => cases.truncation.grid.map(p => `${sx(p.tau)},${sy(p[key])}`).join(' ');
const panels = [
 {key:'latent', title: ru ? 'Латентное распределение' : 'Latent distribution', a:'variance',b:'six_unchanged', first:ru ? 'Дисперсия координаты' : 'Coordinate variance', second:ru ? 'Вектор из 6 сохранён' : 'All 6 coordinates unchanged'},
 {key:'valid', title:ru ? 'Заданный тест: |выход| ≤ 1' : 'Specified test: |output| ≤ 1', a:'valid_centered',b:'valid_shifted', first:'G₀(z) = z', second:'G₂(z) = z + 2'},
] as const;
---
<Figure id={id}
 title={ru ? 'Меньший разброс латента не гарантирует лучший выход' : 'Less latent spread does not guarantee a better output'}
 caption={ru ? 'Стандартная нормальная координата перевыбирается до |z| ≤ τ. Слева: условная дисперсия и вероятность сохранить исходный шестимерный вектор. Справа: вероятность заданного допустимого выхода для двух фиксированных отображений. Сетка τ от 0.02 до 3; оценки качества изображений не измеряются.' : 'A standard-normal coordinate is redrawn until |z| ≤ τ. Left: conditional variance and the probability of retaining the initial six-dimensional draw. Right: probability of the specified valid output for two fixed maps. The τ grid runs from 0.02 to 3; image quality is not measured.'}>
 <div class="truncation-panels">
 {panels.map(panel => <section>
  <h4>{panel.title}</h4>
  <svg viewBox="0 0 320 238" role="img" aria-labelledby={`${id}-${panel.key}-title ${id}-${panel.key}-desc`}>
   <title id={`${id}-${panel.key}-title`}>{panel.title}</title>
   <desc id={`${id}-${panel.key}-desc`}>{panel.key === 'latent'
    ? (ru ? 'С ростом порога от нуля к трём дисперсия и вероятность сохранить вектор растут. При пороге 0.6 дисперсия примерно 0.114, а вероятность сохранить все шесть координат примерно 0.0085.' : 'As threshold grows from near zero to three, variance and vector-retention probability rise. At 0.6 variance is about 0.114 and all-six retention probability about 0.0085.')
    : (ru ? 'У тождественного отображения вероятность допустимого выхода равна единице до порога один, затем уменьшается. У сдвинутого отображения она нулевая до порога один, затем растёт. Один порог действует на эти отображения по-разному.' : 'For the identity map, valid-output probability is one up to threshold one, then decreases. For the shifted map it is zero up to threshold one, then increases. The same threshold affects these maps differently.')}</desc>
   <path class="f-axis" d="M45 25V190H282" />
   {[0,1,2,3].map(t => <g><path class="f-axis" d={`M${sx(t)} 190v5`} /><text class="f-label" x={sx(t)} y="215" text-anchor="middle">{t}</text></g>)}
   {[0,.5,1].map(p => <g><path class="f-axis" d={`M40 ${sy(p)}h5`} /><text class="f-label" x="34" y={sy(p)+5} text-anchor="end">{p}</text></g>)}
   <polyline class="f-line f-blue" data-series={panel.a} points={poly(panel.a)} />
   <polyline class="f-line f-amber alternate" data-series={panel.b} points={poly(panel.b)} />
   <text class="f-label" x="299" y="196">τ</text>
  </svg>
  <ul class="legend"><li><span class="key blue"></span>{panel.first}</li><li><span class="key amber"></span>{panel.second}</li></ul>
 </section>)}
 </div>
</Figure>
<style>
 .truncation-panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1.5rem;align-items:start}
 .truncation-panels section{min-width:0}
 .truncation-panels h4{font-size:1rem;margin:0 0 .4rem;text-align:center;color:var(--ink)}
 .truncation-panels svg{display:block;width:100%;max-width:400px;margin:0 auto}
 .alternate{stroke-dasharray:7 4}
 .truncation-panels .legend{list-style:none;padding:0;margin:.1rem 0 0;font-size:.9rem;color:var(--ink)}
 .legend li{display:flex;gap:.5rem;align-items:center;margin:.25rem 0}
 .key{display:inline-block;flex:0 0 1.4rem;border-top:2px solid var(--fig-blue)}
 .key.amber{border-top-color:var(--fig-amber);border-top-style:dashed}
 @media(max-width:700px){.truncation-panels{grid-template-columns:1fr;gap:1.5rem}}
</style>
