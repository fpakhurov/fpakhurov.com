---
import Figure from '../Figure.astro';
import { scale, plot } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { data, fit, wNorm, score, sigmoid, accuracy, logLoss, band } from './fit';

const ru = pageLang(Astro.url) === 'ru';

// Left: the data, the boundary p = 0.5 and the contours p = 0.1, 0.25, 0.75, 0.9 of the fitted model, all
// parallel lines w·x + b = logit(p). Right: the same model seen along w, p = σ(z) against the score z = w·x + b,
// with the labels of the points as rugs at p = 0 and p = 1. Equal scales on both axes of the left panel.
const X: [number, number] = [-3.2, 3.6];
const Y: [number, number] = [-2.8, 2.9];
const levels = [0.1, 0.25, 0.5, 0.75, 0.9];
const logit = (p: number) => Math.log(p / (1 - p));
const r2 = (v: number) => v.toFixed(2);
const q = { w1: r2(fit.w[0]), w2: r2(fit.w[1]), b: r2(fit.b), norm: r2(wNorm), band: r2(band), acc: accuracy.toFixed(3), loss: r2(logLoss), correct: Math.round(accuracy * data.length) };
if ([q.w1, q.w2, q.b, q.norm, q.band, q.acc, q.loss].join(' ') !== '1.61 1.70 0.22 2.34 1.88 0.875 0.30' || q.correct !== 105) throw new Error(`ProbabilityContours: quoted fit drifted: ${JSON.stringify(q)}`);
for (const o of data) if (o.x[0] <= X[0] || o.x[0] >= X[1] || o.x[1] <= Y[0] || o.x[1] >= Y[1]) throw new Error('ProbabilityContours: a point left the plot box');

// Where each contour leaves the box: through the bottom edge if it can, otherwise through the right edge.
const exits = levels.map((p) => {
  const c = logit(p) - fit.b;
  const xb = (c - fit.w[1] * Y[0]) / fit.w[0];
  const inside = xb >= X[0] && xb <= X[1];
  return { p, c, edge: inside ? 'bottom' : 'right', at: inside ? xb : (c - fit.w[0] * X[1]) / fit.w[1] };
});
// two far points on each contour line; the clip path cuts them to the box
const dir: [number, number] = [-fit.w[1] / wNorm, fit.w[0] / wNorm];
const lineOf = (c: number) => {
  const x0: [number, number] = [(c * fit.w[0]) / (wNorm * wNorm), (c * fit.w[1]) / (wNorm * wNorm)];
  return [[x0[0] - 12 * dir[0], x0[1] - 12 * dir[1]], [x0[0] + 12 * dir[0], x0[1] + 12 * dir[1]]] as [number, number][];
};
const tone = (p: number) => (p === 0.5 ? 'f-line f-bold' : p > 0.5 ? 'f-thin f-blue' : 'f-thin f-red');
const ttone = (p: number) => (p === 0.5 ? 'f-note' : p > 0.5 ? 'f-note f-t-blue' : 'f-note f-t-red');
const contours = exits.map((e) => ({ ...e, line: lineOf(e.c), cls: tone(e.p), tcls: ttone(e.p), label: String(e.p), bottom: e.edge === 'bottom' }));
const pts = data.map((o) => ({ ...o, z: score(o.x), pos: o.y === 1 }));
const t = ru
  ? { left: 'данные и линии уровня p', right: 'вдоль w: p = σ(z)', axis: 'z = w·x + b' }
  : { left: 'data and contours of p', right: 'along w: p = σ(z)', axis: 'z = w·x + b' };
const zTicks = [-6, -3, 0, 3, 6].map((v) => ({ v, label: String(v).replace('-', '−') }));
const id = 'logistic-regression-contours';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 350, u: 50, x0: 14, y0: 34, rx: [452, 742] as [number, number], ry: [64, 270] as [number, number], rt: 20 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 650, u: 46, x0: 14, y0: 34, rx: [44, 340] as [number, number], ry: [404, 580] as [number, number], rt: 370 },
];
---

<Figure
  id={id}
  title={ru ? 'Логистическая регрессия: граница и линии уровня вероятности' : 'Logistic regression: the boundary and the contours of probability'}
  caption={ru
    ? `Слева: 60 точек класса 1 (синие кружки) и 60 точек класса 0 (красные квадраты) из двух гауссовских облаков с одинаковой ковариацией, для которых истинные логарифмические шансы линейны: 2x₁ + 1.2x₂. Оценка максимального правдоподобия: w = (${q.w1}, ${q.w2}), b = ${q.b}. Граница p = 0.5 (чёрная) и линии уровня p = 0.1, 0.25, 0.75, 0.9 — параллельные прямые w·x + b = logit(p); полоса между 0.1 и 0.9 имеет ширину 2 ln 9 / ‖w‖ = ${q.band}. Справа та же модель вдоль направления w: вероятность зависит от x только через z = w·x + b, по сигмоиде; засечки сверху и снизу — метки точек. Доля верных ответов на обучающих данных ${q.acc} (${q.correct} из 120), средняя логистическая потеря ${q.loss}.`
    : `Left: 60 points of class 1 (blue circles) and 60 of class 0 (red squares) from two Gaussian clouds with equal covariance, for which the true log-odds are linear, 2x₁ + 1.2x₂. The maximum likelihood fit is w = (${q.w1}, ${q.w2}), b = ${q.b}. The boundary p = 0.5 (black) and the contours p = 0.1, 0.25, 0.75, 0.9 are parallel lines w·x + b = logit(p); the band between 0.1 and 0.9 is 2 ln 9 / ‖w‖ = ${q.band} wide. Right: the same model along the direction of w. The probability depends on x only through z = w·x + b, along a sigmoid; the ticks at the top and bottom are the labels of the points. Training accuracy ${q.acc} (${q.correct} of 120), mean log-loss ${q.loss}.`}
>
  {layouts.map((L) => {
    const sx = scale(X, [L.x0, L.x0 + (X[1] - X[0]) * L.u]);
    const sy = scale(Y, [L.y0 + (Y[1] - Y[0]) * L.u, L.y0]);
    const zx = scale([-6, 6], L.rx), py = scale([0, 1], [L.ry[1], L.ry[0]]);
    const clip = `${id}-${L.sfx}-clip`;
    const boxR = sx(X[1]), boxB = sy(Y[0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{ru ? 'Линии уровня вероятности логистической регрессии и сигмоида вдоль w' : 'Probability contours of logistic regression and the sigmoid along w'}</title>
        <desc id={`${id}-${L.sfx}-d`}>{ru
          ? 'Слева облака синих и красных точек и пять параллельных наклонных прямых, подписанных 0.1, 0.25, 0.5, 0.75, 0.9. Справа S-образная кривая вероятности от z, засечки точек класса 1 сверху, класса 0 снизу; они перекрываются около z = 0.'
          : 'Left: clouds of blue and red points and five parallel slanted lines labelled 0.1, 0.25, 0.5, 0.75, 0.9. Right: an S-shaped curve of probability against z, with ticks for class 1 at the top and class 0 at the bottom, overlapping near z = 0.'}</desc>
        <defs><clipPath id={clip}><rect x={sx(X[0])} y={sy(Y[1])} width={sx(X[1]) - sx(X[0])} height={sy(Y[0]) - sy(Y[1])} /></clipPath></defs>
        <text class="f-small f-t-muted" x={L.x0} y={L.y0 - 14}>{t.left}</text>
        <rect x={sx(X[0])} y={sy(Y[1])} width={sx(X[1]) - sx(X[0])} height={sy(Y[0]) - sy(Y[1])} class="f-grid" style="fill: none" />
        {pts.map((o) => o.pos
          ? <circle cx={sx(o.x[0]).toFixed(1)} cy={sy(o.x[1]).toFixed(1)} r="3.6" class="f-solid-blue" style="fill-opacity: .8" />
          : <rect x={(sx(o.x[0]) - 3.2).toFixed(1)} y={(sy(o.x[1]) - 3.2).toFixed(1)} width="6.4" height="6.4" class="f-solid-red" style="fill-opacity: .8" />)}
        <g clip-path={`url(#${clip})`}>
          {contours.map((c) => <path class={c.cls} d={`M ${sx(c.line[0][0]).toFixed(1)} ${sy(c.line[0][1]).toFixed(1)} L ${sx(c.line[1][0]).toFixed(1)} ${sy(c.line[1][1]).toFixed(1)}`} />)}
        </g>
        {contours.map((c) => c.bottom
          ? <text class={c.tcls} x={sx(c.at)} y={boxB + 15} text-anchor="middle">{c.label}</text>
          : <text class={c.tcls} x={boxR + 4} y={sy(c.at) + 4}>{c.label}</text>)}
        <text class="f-small f-t-muted" x={L.rx[0]} y={L.rt}>{t.right}</text>
        <path class="f-axis" d={`M ${L.rx[0]} ${py(0)} H ${L.rx[1]} M ${zx(0)} ${py(0)} V ${py(1)}`} />
        <path class="f-grid" d={`M ${L.rx[0]} ${py(1)} H ${L.rx[1]} M ${L.rx[0]} ${py(0.5)} H ${L.rx[1]}`} />
        {pts.map((o) => o.pos
          ? <path class="f-thin f-blue" style="stroke-opacity: .6" d={`M ${zx(Math.max(-6, Math.min(6, o.z))).toFixed(1)} ${py(1) - 4} v -10`} />
          : <path class="f-thin f-red" style="stroke-opacity: .6" d={`M ${zx(Math.max(-6, Math.min(6, o.z))).toFixed(1)} ${py(0) + 4} v 10`} />)}
        <path class="f-line f-bold" d={plot(sigmoid, -6, 6, zx, py, 200)} />
        {zTicks.map((k) => <text class="f-note" x={zx(k.v)} y={py(0) + 30} text-anchor="middle">{k.label}</text>)}
        {[0, 0.5, 1].map((v) => <text class="f-note" x={L.rx[0] - 6} y={py(v) + 5} text-anchor="end">{v}</text>)}
        <text class="f-small" x={(L.rx[0] + L.rx[1]) / 2} y={py(0) + 50} text-anchor="middle">{t.axis}</text>
      </svg>
    );
  })}
</Figure>
