---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Drift statistics between the reference N(0, 1) and a current N(delta, 1), computed exactly:
// PSI on the decile bins of the reference, and the Kolmogorov-Smirnov distance D = 2 Phi(delta / 2) - 1.
// Noise levels: E[PSI] ~ (k - 1)(1/n + 1/m) with no shift; KS critical value 1.358 sqrt((n + m) / (n m)).
const erf = (x: number) => {            // Abramowitz and Stegun 7.1.26, absolute error below 1.5e-7
  const s = Math.sign(x), a = Math.abs(x), t = 1 / (1 + 0.3275911 * a);
  const y = 1 - ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(-a * a);
  return s * y;
};
const Phi = (x: number) => 0.5 * (1 + erf(x / Math.SQRT2));
const DEC = [-Infinity, -1.2815515655, -0.8416212336, -0.5244005127, -0.2533471031, 0, 0.2533471031, 0.5244005127, 0.8416212336, 1.2815515655, Infinity];
const cdf = (x: number) => (x === Infinity ? 1 : x === -Infinity ? 0 : Phi(x));
const psi = (d: number) => {
  let s = 0;
  for (let i = 0; i < 10; i++) { const a = cdf(DEC[i + 1] - d) - cdf(DEC[i] - d); s += (a - 0.1) * Math.log(a / 0.1); }
  return s;
};
const ksD = (d: number) => 2 * Phi(d / 2) - 1;
const N = 5000, K = 10;
const noise = (m: number) => (K - 1) * (1 / N + 1 / m);
const crit = (m: number) => 1.358 * Math.sqrt((N + m) / (N * m));
if (Math.abs(psi(0.5) - 0.2377) > 5e-4 || Math.abs(psi(0.2) - 0.0383) > 5e-4 || Math.abs(psi(1) - 0.9261) > 5e-4) throw new Error('PSI values of the text');
if (Math.abs(ksD(0.5) - 0.1974) > 5e-4 || Math.abs(ksD(0.05) - 0.0199) > 5e-4) throw new Error('KS values of the text');
if (Math.abs(noise(1000) - 0.0108) > 1e-6 || Math.abs(crit(1000) - 0.04704) > 1e-4 || Math.abs(crit(20000) - 0.02147) > 1e-4) throw new Error('noise levels');
const cross = (f: (d: number) => number, level: number) => { let lo = 1e-3, hi = 2; for (let i = 0; i < 60; i++) { const mid = (lo + hi) / 2; if (f(mid) < level) lo = mid; else hi = mid; } return lo; };
const crossings = [
  { f: psi, level: noise(1000), d: cross(psi, noise(1000)), want: '0.11' },
  { f: psi, level: 0.1, d: cross(psi, 0.1), want: '0.32' },
  { f: ksD, level: crit(1000), d: cross(ksD, crit(1000)), want: '0.12' },
  { f: ksD, level: crit(20000), d: cross(ksD, crit(20000)), want: '0.054' },
];
for (const c of crossings) if (c.d.toPrecision(2) !== c.want) throw new Error(`crossing ${c.d} is not ${c.want}`);
// Panel A: the shift of the figure, delta = 0.5; mass of the current distribution in the two right-most bins.
const D0 = 0.5;
const right2 = 1 - Phi(DEC[8] - D0);
if (Math.round(right2 * 100) !== 37) throw new Error(`right-most bins hold ${right2}`);
const dens = (x: number, mu: number) => Math.exp(-0.5 * (x - mu) ** 2) / Math.sqrt(2 * Math.PI);

const f3 = (v: number) => v.toFixed(3);
const t = ru
  ? { title: 'Статистики дрейфа в зависимости от величины сдвига', a: `эталон и текущее, δ = ${D0}`, b: 'статистика в зависимости от сдвига δ', ref: 'эталон N(0, 1)', cur: `текущее N(${D0}, 1)`,
      ann: `PSI ${f3(psi(D0))}, D ${f3(ksD(D0))}`, mass: `20% → ${Math.round(right2 * 100)}%`, x: 'сдвиг δ, в стандартных отклонениях',
      l25: 'PSI 0.25', l10: 'PSI 0.1', lNoise: 'шум PSI, m=1000', lNoiseN: 'шум PSI', lK1: 'KS 5%, m=1000', lK2: 'KS 5%, m=20000', lK1N: 'KS, m=1000', lK2N: 'KS, m=20000', psi: 'PSI', ks: 'KS D',
      steps: [`эталон N(0, 1) с децильными интервалами и текущее распределение, сдвинутое на ${D0}: в двух правых интервалах — ${Math.round(right2 * 100)}% его массы против 20%`, 'PSI растёт как δ²: уровень шума для окон по 1000 он проходит при δ = 0.11, общепринятый порог 0.1 — только при δ = 0.32', 'KS D растёт как δ: 5%-й порог для окон по 1000 он проходит при δ = 0.12, для окон по 20 000 — при δ = 0.054'] }
  : { title: 'Drift statistics against the size of the shift', a: `reference and current, δ = ${D0}`, b: 'statistic against the shift δ', ref: 'reference N(0, 1)', cur: `current N(${D0}, 1)`,
      ann: `PSI ${f3(psi(D0))}, D ${f3(ksD(D0))}`, mass: `20% → ${Math.round(right2 * 100)}%`, x: 'shift δ, in standard deviations',
      l25: 'PSI 0.25', l10: 'PSI 0.1', lNoise: 'PSI noise, m=1000', lNoiseN: 'PSI noise', lK1: 'KS 5%, m=1000', lK2: 'KS 5%, m=20000', lK1N: 'KS, m=1000', lK2N: 'KS, m=20000', psi: 'PSI', ks: 'KS D',
      steps: [`the reference N(0, 1) with its decile bins, and a current distribution shifted by ${D0}: its two right-most bins hold ${Math.round(right2 * 100)}% of its mass instead of 20%`, 'PSI grows as δ²: it passes the noise of windows of 1,000 at δ = 0.11, and the conventional threshold of 0.1 only at δ = 0.32', 'KS D grows as δ: it passes the 5% critical value for windows of 1,000 at δ = 0.12, and for windows of 20,000 at δ = 0.054'] };

interface Layout { cls: string; W: number; H: number; A: [number, number, number, number]; B: [number, number, number, number]; sans: number; wide: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 318, A: [30, 44, 330, 262], B: [424, 44, 700, 262], sans: 6.5, wide: true },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 560, A: [14, 44, 346, 204], B: [58, 300, 310, 510], sans: 7.3, wide: false },
];
const XA: [number, number] = [-3.5, 4], YA = 0.45, DMIN = 0.01, DMAX = 1, VMIN = 1e-3, VMAX = 1;
const geo = layouts.map((L) => {
  const [ax0, ay0, ax1, ay1] = L.A, [bx0, by0, bx1, by1] = L.B;
  const sxA = (x: number) => ax0 + ((x - XA[0]) / (XA[1] - XA[0])) * (ax1 - ax0);
  const syA = (v: number) => ay1 - (v / YA) * (ay1 - ay0);
  const sxB = (d: number) => bx0 + (Math.log10(d / DMIN) / Math.log10(DMAX / DMIN)) * (bx1 - bx0);
  const syB = (v: number) => by1 - (Math.log10(v / VMIN) / Math.log10(VMAX / VMIN)) * (by1 - by0);
  const dAt = (x: number) => DMIN * Math.pow(DMAX / DMIN, (x - bx0) / (bx1 - bx0));
  const xs = [...Array(121)].map((_, i) => XA[0] + (i / 120) * (XA[1] - XA[0]));
  const refPath = `M ${sxA(XA[0])} ${ay1} ` + xs.map((x) => `L ${sxA(x).toFixed(1)} ${syA(dens(x, 0)).toFixed(1)}`).join(' ') + ` L ${sxA(XA[1])} ${ay1} Z`;
  const curPath = xs.map((x, i) => `${i ? 'L' : 'M'} ${sxA(x).toFixed(1)} ${syA(dens(x, D0)).toFixed(1)}`).join(' ');
  const ds = [...Array(81)].map((_, i) => DMIN * Math.pow(DMAX / DMIN, i / 80));
  const psiStart = cross(psi, VMIN);
  const psiPath = ds.filter((d) => d >= psiStart).map((d, i) => `${i ? 'L' : 'M'} ${sxB(d).toFixed(1)} ${syB(psi(d)).toFixed(1)}`).join(' ');
  const ksPath = ds.map((d, i) => `${i ? 'L' : 'M'} ${sxB(d).toFixed(1)} ${syB(ksD(d)).toFixed(1)}`).join(' ');
  // Threshold lines: labels on the side where both curves are clear of them.
  const lines = [
    { v: 0.25, txt: t.l25, side: 'left', cls: 'f-amber' },
    { v: 0.1, txt: t.l10, side: 'left', cls: 'f-amber' },
    { v: noise(1000), txt: L.wide ? t.lNoise : t.lNoiseN, side: 'right', cls: 'f-blue' },
    { v: crit(1000), txt: L.wide ? t.lK1 : t.lK1N, side: 'left', cls: 'f-red' },
    { v: crit(20000), txt: L.wide ? t.lK2 : t.lK2N, side: 'left', cls: 'f-red' },
  ].map((ln) => {
    const w = ln.txt.length * L.sans, y = syB(ln.v) - 4;
    const l = ln.side === 'left' ? bx0 + 4 : bx1 - 4 - w;
    for (let px = l; px <= l + w; px += 2) {
      const d = dAt(px);
      for (const f of [psi, ksD]) {
        const v = f(d);
        if (v < VMIN) continue;
        const cy = syB(v);
        if (cy > y - 14 && cy < y + 3) throw new Error(`label "${ln.txt}" meets a curve at ${L.W}`);
      }
    }
    return { ...ln, y, l, w };
  });
  for (let i = 0; i < lines.length; i++) for (let j = i + 1; j < lines.length; j++) {
    const p = lines[i], q = lines[j];
    if (p.l < q.l + q.w && q.l < p.l + p.w && Math.abs(p.y - q.y) < 14) throw new Error(`labels "${p.txt}" and "${q.txt}" overlap at ${L.W}`);
  }
  // Curve labels right of their end points.
  const ends = [{ txt: t.psi, y: syB(psi(DMAX)) + 4 }, { txt: t.ks, y: syB(ksD(DMAX)) + 4 }];
  for (const e of ends) if (bx1 + 6 + e.txt.length * L.sans > L.W - 2) throw new Error(`end label ${e.txt} at ${L.W}`);
  if (Math.abs(ends[0].y - ends[1].y) < 14) throw new Error('end labels overlap');
  // Panel A labels: legend top-left, annotation and mass label top-right.
  const legRight = ax0 + 26 + Math.max(t.ref.length, t.cur.length) * L.sans;
  const annLeft = ax1 - t.ann.length * L.sans;
  if (legRight > annLeft - 8) throw new Error(`panel A labels meet at ${L.W}`);
  for (const s of [t.a, t.b]) if (s.length * L.sans > (L.wide ? ax1 - ax0 + 20 : L.W - 20)) throw new Error('panel title');
  if (t.x.length * L.sans > bx1 - bx0 + 30) throw new Error('axis title');
  return { sxA, syA, sxB, syB, refPath, curPath, psiPath, ksPath, lines, ends };
});
const id = 'drift-detection';
const caption = ru
  ? `Слева: эталонное распределение признака N(0, 1), его децильные интервалы (пунктир) и текущее распределение, сдвинутое на ${D0} стандартного отклонения (1); в двух правых интервалах теперь ${Math.round(right2 * 100)}% массы вместо 20%, PSI равен ${f3(psi(D0))}, KS D — ${f3(ksD(D0))}. Справа: точные значения статистик для сдвига δ, обе оси логарифмические. PSI на децилях растёт как δ² (наклон 2), его средний шум без всякого сдвига для окон из 1000 точек при эталоне из 5000 равен 0.0108 (2). KS D растёт как δ (наклон 1); пунктиры — 5%-е критические значения для окон из 1000 и 20 000 (3). Одна и та же статистика значима или нет в зависимости от размера окна.`
  : `Left: the reference distribution of a feature, N(0, 1), its decile bins (dashed), and the current distribution, shifted by ${D0} standard deviations (1); the two right-most bins now hold ${Math.round(right2 * 100)}% of the mass instead of 20%, PSI is ${f3(psi(D0))} and the KS distance D is ${f3(ksD(D0))}. Right: the exact values of the statistics for a shift δ, both axes logarithmic. PSI on deciles grows as δ² (slope 2); its average noise with no shift at all, for windows of 1,000 against a reference of 5,000, is 0.0108 (2). KS D grows as δ (slope 1); the dotted lines are its 5% critical values for windows of 1,000 and 20,000 (3). The same statistic is significant or not depending on the window size.`;
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L, li) => {
    const g = geo[li];
    const [ax0, ay0, ax1, ay1] = L.A, [bx0, by0, bx1, by1] = L.B;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? `Две панели. Слева две колоколообразные кривые плотности, синяя с центром 0 и красная с центром ${D0}, и девять вертикальных пунктиров на децилях синей. Справа логарифмический график от δ = 0.01 до 1: синяя прямая PSI с наклоном 2 до ${f3(psi(1))} и красная прямая KS D с наклоном 1 до ${f3(ksD(1))}; горизонтали отмечают пороги PSI 0.1 и 0.25, шум PSI 0.0108 и критические значения KS 0.047 и 0.021.`
          : `Two panels. Left, two bell-shaped density curves, a blue one centred at 0 and a red one centred at ${D0}, with nine dashed vertical lines at the deciles of the blue one. Right, a log–log plot from δ = 0.01 to 1: a blue PSI line of slope 2 up to ${f3(psi(1))} and a red KS D line of slope 1 up to ${f3(ksD(1))}; horizontal lines mark the PSI thresholds 0.1 and 0.25, the PSI noise level 0.0108 and the KS critical values 0.047 and 0.021.`}</desc>
        <text class="f-small" x={ax0} y={ay0 - 22} style="font-weight: 650">{t.a}</text>
        <text class="f-small" x={L.wide ? bx0 : ax0} y={by0 - 22} style="font-weight: 650">{t.b}</text>
        <g data-s="1">
          <path d={g.refPath} style="fill: var(--fig-blue); fill-opacity: 0.18; stroke: var(--fig-blue); stroke-width: 1.6" />
          <path d={g.curPath} style="fill: none; stroke: var(--fig-red); stroke-width: 2.2" />
          {DEC.slice(1, 10).map((q) => <line class="f-line f-dash" x1={g.sxA(q)} x2={g.sxA(q)} y1={ay0 + 40} y2={ay1} style="stroke-opacity: 0.55" />)}
          <path class="f-axis" d={`M ${ax0} ${ay1} H ${ax1}`} />
          {[-2, 0, 2, 4].map((x) => <text class="f-small f-t-muted" x={g.sxA(x)} y={ay1 + 16} text-anchor="middle">{String(x)}</text>)}
          <rect x={ax0 + 2} y={ay0 + 2} width="16" height="10" style="fill: var(--fig-blue); fill-opacity: 0.3; stroke: var(--fig-blue)" />
          <text class="f-small f-t-muted" x={ax0 + 24} y={ay0 + 12}>{t.ref}</text>
          <line x1={ax0 + 2} x2={ax0 + 18} y1={ay0 + 26} y2={ay0 + 26} style="stroke: var(--fig-red); stroke-width: 2.2" />
          <text class="f-small f-t-muted" x={ax0 + 24} y={ay0 + 30}>{t.cur}</text>
          <text class="f-small" x={ax1} y={ay0 + 12} text-anchor="end" style="font-weight: 650">{t.ann}</text>
          <text class="f-small f-t-red f-halo" x={g.sxA(DEC[9])} y={g.syA(0.2)} text-anchor="middle">{t.mass}</text>
          <Badge x={g.sxA(-2.6)} y={g.syA(0.2)} n={1} />
        </g>
        {[1e-3, 1e-2, 1e-1, 1].map((v) => (
          <g>
            <line class="f-grid" x1={bx0} x2={bx1} y1={g.syB(v)} y2={g.syB(v)} />
            <text class="f-small f-t-muted" x={bx0 - 6} y={g.syB(v) + 4} text-anchor="end">{String(v)}</text>
          </g>
        ))}
        {[0.01, 0.03, 0.1, 0.3, 1].map((d, i) => (
          <g>
            <line class="f-grid" x1={g.sxB(d)} x2={g.sxB(d)} y1={by0} y2={by1} />
            <text class="f-small f-t-muted" x={g.sxB(d)} y={by1 + 16} text-anchor={i === 0 ? 'start' : 'middle'}>{String(d)}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${bx0} ${by0} V ${by1} H ${bx1}`} />
        <text class="f-small f-t-muted" x={bx1} y={by1 + 34} text-anchor="end">{t.x}</text>
        <g data-s="2">
          {g.lines.slice(0, 3).map((ln) => (
            <g>
              <line class={`f-line ${ln.cls} f-dash`} x1={bx0} x2={bx1} y1={g.syB(ln.v)} y2={g.syB(ln.v)} />
              <text class={`f-small ${ln.cls === 'f-blue' ? 'f-t-blue' : 'f-t-amber'}`} x={ln.l} y={ln.y}>{ln.txt}</text>
            </g>
          ))}
          <path d={g.psiPath} style="fill: none; stroke: var(--fig-blue); stroke-width: 2.4" />
          <text class="f-small f-t-blue" x={bx1 + 6} y={g.ends[0].y} style="font-weight: 650">{g.ends[0].txt}</text>
          {crossings.slice(0, 2).map((c) => <circle cx={g.sxB(c.d)} cy={g.syB(c.level)} r="4" style="fill: var(--fig-blue)" />)}
          <Badge x={g.sxB(crossings[1].d) - 16} y={g.syB(0.1) - 16} n={2} />
        </g>
        <g data-s="3">
          {g.lines.slice(3).map((ln) => (
            <g>
              <line class={`f-line ${ln.cls} f-dash`} x1={bx0} x2={bx1} y1={g.syB(ln.v)} y2={g.syB(ln.v)} />
              <text class="f-small f-t-red" x={ln.l} y={ln.y}>{ln.txt}</text>
            </g>
          ))}
          <path d={g.ksPath} style="fill: none; stroke: var(--fig-red); stroke-width: 2.4" />
          <text class="f-small f-t-red" x={bx1 + 6} y={g.ends[1].y} style="font-weight: 650">{g.ends[1].txt}</text>
          {crossings.slice(2).map((c) => <circle cx={g.sxB(c.d)} cy={g.syB(c.level)} r="4" style="fill: var(--fig-red)" />)}
          <Badge x={g.sxB(crossings[2].d) - 14} y={g.syB(crossings[2].level) - 14} n={3} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
