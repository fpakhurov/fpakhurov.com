---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// An embedding layer: token ids pick rows of the table E; the rows, stacked in order, are the output.
const tokens = [
  { t: 'the', id: 4, row: 1, tone: 'blue' },
  { t: 'cat', id: 812, row: 5, tone: 'green' },
  { t: 'sat', id: 1093, row: 9, tone: 'amber' },
] as const;
const rows = 12, cols = 6;
// Deterministic pseudo-random shading, so every row looks like a different vector.
const shade = (r: number, c: number) => 0.15 + 0.7 * ((Math.sin(r * 12.9898 + c * 78.233) * 43758.5453) % 1 + 1) % 1;

interface Layout { cls: string; W: number; H: number; tokX: number; tokW: number; tabX: number; outX: number; cell: number; rowH: number; top: number; arrowLab: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 680, H: 290, tokX: 20, tokW: 70, tabX: 250, outX: 500, cell: 22, rowH: 16, top: 52, arrowLab: 0 },
  { cls: 'fig-narrow', W: 360, H: 306, tokX: 6, tokW: 50, tabX: 120, outX: 258, cell: 14, rowH: 16, top: 56, arrowLab: 0 },
];
const id = 'word-embeddings-lookup';
const t = ru
  ? { table: 'таблица E', tableSub: '|V| строк, d столбцов', out: 'выход [T, d]', outSub: 'строка на токен', ids: 'id', formula: 'Eᵀeᵢ = Eᵢ: умножение на one-hot-вектор читает одну строку E', formulaN: ['Eᵀeᵢ = Eᵢ: умножение на one-hot-', 'вектор читает одну строку E'] }
  : { table: 'table E', tableSub: '|V| rows, d columns', out: 'output [T, d]', outSub: 'one row per token', ids: 'id', formula: 'Eᵀeᵢ = Eᵢ: multiplying by a one-hot vector reads out one row of E', formulaN: ['Eᵀeᵢ = Eᵢ: multiplying by a one-hot', 'vector reads out one row of E'] };
---

<Figure
  id={id}
  title={ru ? 'Слой эмбеддингов — это поиск строки в таблице' : 'An embedding layer is a row lookup'}
  caption={ru
    ? 'Что делает nn.Embedding. Каждый токен сначала становится идентификатором (здесь условным), идентификатор выбирает строку таблицы E размера |V| × d, и выбранные строки, собранные в порядке токенов, образуют выход формы [T, d] (для батча — [B, T, d]). То же самое получается, если умножить one-hot-вектор токена на E, поэтому первый линейный слой над one-hot-входами и есть таблица эмбеддингов; поиск по индексу лишь избавляет от умножения на нули. Таблица — обычный параметр: обучение сдвигает строки встреченных токенов, и похожие токены оказываются рядом. Оттенки клеток условны.'
    : 'What nn.Embedding does. Each token first becomes an id (illustrative here), the id selects a row of the |V| × d table E, and the selected rows, stacked in token order, form an output of shape [T, d] ([B, T, d] for a batch). Multiplying the one-hot vector of the token by E gives the same row, so the first linear layer over one-hot inputs is an embedding table; the lookup only skips the multiplications by zero. The table is an ordinary parameter: training moves the rows of the tokens it sees, and similar tokens end up close. Cell shades are illustrative.'}
>
  {layouts.map((L) => {
    const tabW = cols * L.cell, tabH = rows * L.rowH;
    const rowY = (r: number) => L.top + r * L.rowH;
    const outY = (i: number) => L.top + 3 * L.rowH + i * (L.rowH + 10);
    const tokY = (i: number) => L.top + 18 + i * 54;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Поиск строк в таблице эмбеддингов' : 'Looking up rows of an embedding table'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? `Токены ${tokens.map((k) => `${k.t} (id ${k.id})`).join(', ')} указывают на три строки таблицы E из ${rows} показанных строк; эти строки, собранные по порядку, образуют выходную матрицу из трёх строк. Внизу: Eᵀeᵢ = Eᵢ.`
          : `The tokens ${tokens.map((k) => `${k.t} (id ${k.id})`).join(', ')} point to three rows of the table E, of which ${rows} rows are shown; the three rows, stacked in order, form the output matrix of three rows. Below: Eᵀeᵢ = Eᵢ.`}</desc>
        <text class="f-title" x={L.tabX} y={L.top - 30}>{t.table}</text>
        <text class="f-small f-t-muted" x={L.tabX} y={L.top - 12}>{t.tableSub}</text>
        <text class="f-title" x={L.outX} y={L.top - 30}>{t.out}</text>
        <text class="f-small f-t-muted" x={L.outX} y={L.top - 12}>{t.outSub}</text>
        {Array.from({ length: rows }, (_, r) => {
          const hit = tokens.find((k) => k.row === r);
          return Array.from({ length: cols }, (_, c) => (
            <rect x={L.tabX + c * L.cell} y={rowY(r)} width={L.cell} height={L.rowH} class={hit ? undefined : 'f-solid-muted'} style={hit ? `fill: var(--fig-${hit.tone}); fill-opacity: ${(0.25 + 0.6 * shade(r, c)).toFixed(2)}` : `fill-opacity: ${(0.06 + 0.16 * shade(r, c)).toFixed(2)}`} />
          ));
        })}
        <rect class="f-thin f-muted" x={L.tabX} y={L.top} width={tabW} height={tabH} fill="none" />
        {tokens.map((k, i) => (
          <g>
            <rect class={`f-thin f-${k.tone}`} x={L.tabX} y={rowY(k.row)} width={tabW} height={L.rowH} fill="none" />
            <rect class={`f-fill-${k.tone}`} x={L.tokX} y={tokY(i) - 15} width={L.tokW} height="30" rx="5" />
            <rect class={`f-thin f-${k.tone}`} x={L.tokX} y={tokY(i) - 15} width={L.tokW} height="30" rx="5" fill="none" />
            <text class="f-label" x={L.tokX + L.tokW / 2} y={tokY(i) + 5} text-anchor="middle" font-family="var(--mono)">{k.t}</text>
            <path class={`f-line f-${k.tone}`} d={`M ${L.tokX + L.tokW + 2} ${tokY(i)} C ${(L.tokX + L.tokW + L.tabX) / 2} ${tokY(i)}, ${(L.tokX + L.tokW + L.tabX) / 2} ${rowY(k.row) + L.rowH / 2}, ${L.tabX - 4} ${rowY(k.row) + L.rowH / 2}`} marker-end={`url(#f-arrow-${k.tone})`} />
            <text class={`f-small f-halo f-t-${k.tone}`} x={(L.tokX + L.tokW + L.tabX) / 2} y={(tokY(i) + rowY(k.row) + L.rowH / 2) / 2 - 4} text-anchor="middle">{k.id}</text>
            <path class={`f-line f-${k.tone}`} d={`M ${L.tabX + tabW + 3} ${rowY(k.row) + L.rowH / 2} C ${(L.tabX + tabW + L.outX) / 2} ${rowY(k.row) + L.rowH / 2}, ${(L.tabX + tabW + L.outX) / 2} ${outY(i) + L.rowH / 2}, ${L.outX - 4} ${outY(i) + L.rowH / 2}`} marker-end={`url(#f-arrow-${k.tone})`} />
            {Array.from({ length: cols }, (_, c) => (
              <rect x={L.outX + c * L.cell} y={outY(i)} width={L.cell} height={L.rowH} style={`fill: var(--fig-${k.tone}); fill-opacity: ${(0.25 + 0.6 * shade(k.row, c)).toFixed(2)}`} />
            ))}
            <rect class={`f-thin f-${k.tone}`} x={L.outX} y={outY(i)} width={tabW} height={L.rowH} fill="none" />
          </g>
        ))}
        {(L.cls === 'fig-wide' ? [t.formula] : t.formulaN).map((line, li) => <text class="f-small" x={L.cls === 'fig-wide' ? L.tabX : L.tokX} y={L.top + tabH + 30 + li * 17}>{line}</text>)}
      </svg>
    );
  })}
</Figure>
