---
/**
 * Axes, grid, ticks and line series of one plot panel, for the learning-curve figures of the reinforcement-learning
 * notes. Coordinates are in the viewBox of the enclosing <svg>; `px` and `py` are the screen extents of the plot area
 * (py = [top, bottom]), `dx` and `dy` the data ranges. Labels of the series are placed by the caller with the same scales.
 */
import { scale, polyline } from '../geometry';

interface Series { xs: number[]; ys: number[]; cls: string; dots?: string }
interface Props {
  px: [number, number]; py: [number, number];
  dx: [number, number]; dy: [number, number];
  xTicks: number[]; yTicks: number[];
  xFmt?: (v: number) => string; yFmt?: (v: number) => string;
  xLabel?: string; yLabel?: string; yLabelAt?: [number, number];
  series: Series[];
}
const { px, py, dx, dy, xTicks, yTicks, xFmt = String, yFmt = String, xLabel, yLabel, yLabelAt, series } = Astro.props;
const sx = scale(dx, px), sy = scale(dy, [py[1], py[0]]);
const clampY = (v: number) => Math.min(dy[1], Math.max(dy[0], v));
---
<g>
  {yTicks.map((v) => <path class="f-grid" d={`M ${px[0]} ${sy(v)} H ${px[1]}`} />)}
  <path class="f-axis" d={`M ${px[0]} ${py[0] - 6} V ${py[1]} H ${px[1]}`} />
  {yTicks.map((v) => <text class="f-small" x={px[0] - 7} y={sy(v) + 4} text-anchor="end">{yFmt(v)}</text>)}
  {xTicks.map((v) => <text class="f-small" x={sx(v)} y={py[1] + 18} text-anchor="middle">{xFmt(v)}</text>)}
  {xLabel && <text class="f-small f-t-muted" x={(px[0] + px[1]) / 2} y={py[1] + 38} text-anchor="middle">{xLabel}</text>}
  {yLabel && <text class="f-small f-t-muted" x={yLabelAt ? yLabelAt[0] : px[0] - 40} y={yLabelAt ? yLabelAt[1] : py[0] - 20}>{yLabel}</text>}
  {series.map((s) => <path class={s.cls} d={polyline(s.xs.map((x, i) => [sx(x), sy(clampY(s.ys[i]))] as [number, number]))} />)}
  {series.filter((s) => s.dots).map((s) => s.xs.map((x, i) => <circle cx={sx(x)} cy={sy(clampY(s.ys[i]))} r="2.6" class={s.dots} />))}
</g>
