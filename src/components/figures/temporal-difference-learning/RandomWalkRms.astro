---
import Figure from '../Figure.astro';
import Curves from './Curves.astro';
import { scale } from '../geometry';
import { randomWalk, spread } from './td';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The random walk of the note: states A..E, start in C, a step left or right with probability 1/2 each, reward 1 on
// the right exit and 0 elsewhere, γ = 1. True values 1/6 .. 5/6, estimates start at 0.5. RMS error over the five
// states after each episode, averaged over 100 runs.
const runs = [
  { m: 'td' as const, a: 0.05 }, { m: 'td' as const, a: 0.1 },
  { m: 'mc' as const, a: 0.02 }, { m: 'mc' as const, a: 0.04 },
].map((r) => ({ ...r, rms: Array.from(randomWalk(r.m, r.a)) }));
const at = (i: number, e: number) => runs[i].rms[e];
const chk = [at(0, 0), at(0, 100), at(1, 100), at(2, 100), at(3, 100), at(1, 25), at(2, 25)].map((v) => v.toFixed(3)).join(' ');
if (chk !== '0.236 0.033 0.055 0.081 0.110 0.060 0.157') throw new Error(`RandomWalkRms: numbers drifted from the note (${chk})`);

const cls = ['f-line f-blue', 'f-line f-blue f-dash', 'f-line f-red', 'f-line f-red f-dash'];
const tcls = ['f-t-blue', 'f-t-blue', 'f-t-red', 'f-t-red'];
const names = ru ? ['TD(0), α = 0.05', 'TD(0), α = 0.1', 'MC, α = 0.02', 'MC, α = 0.04'] : ['TD(0), α = 0.05', 'TD(0), α = 0.1', 'MC, α = 0.02', 'MC, α = 0.04'];
const t = ru
  ? { title: 'Ошибка оценки ценностей: TD(0) против Монте-Карло', x: 'эпизоды', y: 'среднеквадратичная ошибка по состояниям',
      desc: `Четыре кривые ошибки за 100 эпизодов, все начинаются с ${at(0, 0).toFixed(3)}. Две синие (TD(0)) падают быстрее и заканчиваются на ${at(0, 100).toFixed(3)} при α = 0.05 и ${at(1, 100).toFixed(3)} при α = 0.1. Две красные (Монте-Карло с постоянным шагом) заканчиваются на ${at(2, 100).toFixed(3)} и ${at(3, 100).toFixed(3)}. Чем больше шаг, тем быстрее начальное падение и тем выше уровень, на котором ошибка колеблется.` }
  : { title: 'Error of the value estimates: TD(0) against Monte Carlo', x: 'episodes', y: 'RMS error over the states',
      desc: `Four error curves over 100 episodes, all starting at ${at(0, 0).toFixed(3)}. The two blue ones (TD(0)) fall faster and end at ${at(0, 100).toFixed(3)} with α = 0.05 and ${at(1, 100).toFixed(3)} with α = 0.1. The two red ones (constant-α Monte Carlo) end at ${at(2, 100).toFixed(3)} and ${at(3, 100).toFixed(3)}. A larger step size falls faster at first and then fluctuates at a higher level.` };
const id = 'td-random-walk-rms';
const caption = ru
  ? `Случайное блуждание A–E из текста: старт в C, шаг влево или вправо с вероятностью 1/2, награда 1 за выход справа, γ = 1, истинные ценности 1/6, …, 5/6, начальные оценки 0.5. Ошибка — корень из среднего квадрата отклонений по пяти состояниям после каждого эпизода, среднее по 100 запускам. После 25 эпизодов TD(0) с α = 0.1 уже на ${at(1, 25).toFixed(3)}, Монте-Карло с α = 0.02 — на ${at(2, 25).toFixed(3)}. При постоянном шаге ни один метод не сходится точно: ошибка выходит на уровень шума, который растёт с α.`
  : `The random walk A–E of the text: start in C, a step left or right with probability 1/2, reward 1 for the right exit, γ = 1, true values 1/6, …, 5/6, initial estimates 0.5. The error is the root mean square deviation over the five states after each episode, averaged over 100 runs. After 25 episodes TD(0) with α = 0.1 is already at ${at(1, 25).toFixed(3)} and Monte Carlo with α = 0.02 at ${at(2, 25).toFixed(3)}. With a constant step size neither method converges exactly: the error levels off at a noise floor that grows with α.`;

const xs = Array.from({ length: 101 }, (_, i) => i);
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [70, 600] as [number, number], py: [40, 270] as [number, number], legend: false },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 390, px: [52, 344] as [number, number], py: [44, 270] as [number, number], legend: true },
];
const dy: [number, number] = [0, 0.25];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sy = scale(dy, [L.py[1], L.py[0]]);
    const ends = spread(runs.map((r) => sy(r.rms[100])), 16);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        <Curves px={L.px} py={L.py} dx={[0, 100]} dy={dy} xTicks={[0, 25, 50, 75, 100]} yTicks={[0, 0.05, 0.1, 0.15, 0.2, 0.25]}
          yFmt={(v: number) => v.toFixed(2)} xLabel={t.x} yLabel={t.y} yLabelAt={[L.px[0] - 44, L.py[0] - 20]}
          series={runs.map((r, i) => ({ xs, ys: r.rms, cls: cls[i] }))} />
        {!L.legend && runs.map((_, i) => <text class={`f-small ${tcls[i]}`} x={L.px[1] + 8} y={ends[i] + 4}>{names[i]}</text>)}
        {L.legend && names.map((name, i) => (
          <g>
            <path class={cls[i]} d={`M ${16 + (i % 2) * 172} ${338 + Math.floor(i / 2) * 26 - 5} h 24`} />
            <text class={`f-small ${tcls[i]}`} x={48 + (i % 2) * 172} y={338 + Math.floor(i / 2) * 26}>{name}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
