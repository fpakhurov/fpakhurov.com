---
import Figure from '../Figure.astro';
import Curves from './Curves.astro';
import { scale } from '../geometry';
import { bandit, bins, mean, spread } from './td';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The 10-armed testbed: 2000 bandits with true values q*(a) ~ N(0, 1) and rewards ~ N(q*(a), 1); sample-average
// estimates starting at 0; 1000 steps. Greedy, ε-greedy with ε = 0.01 and 0.1, and UCB with c = 2.
const methods = [
  { key: 'greedy', eps: 0 },
  { key: 'e01', eps: 0.01 },
  { key: 'e1', eps: 0.1 },
  { key: 'ucb', eps: 0, ucb: 2 },
];
const res = bandit(methods);
const last = res.map((r) => mean(r.reward, 900, 1000));
const opt = res.map((r) => mean(r.optimal, 900, 1000));
const chk = [...last, ...opt].map((v) => v.toFixed(2)).join(' ');
if (chk !== '1.02 1.31 1.37 1.48 0.35 0.60 0.79 0.85') throw new Error(`BanditCurves: numbers drifted from the note (${chk})`);
// the order the text relies on: UCB above ε = 0.1 above ε = 0.01 above greedy over the last 100 steps
if (!(last[3] > last[2] && last[2] > last[1] && last[1] > last[0])) throw new Error('BanditCurves: order of the methods changed');

const cls = ['f-line f-muted f-dash', 'f-line f-green', 'f-line f-blue', 'f-line f-amber'];
const tcls = ['f-t-muted', 'f-t-green', 'f-t-blue', 'f-t-amber'];
const t = ru
  ? { title: 'Жадный выбор, ε-жадный выбор и UCB на десятируком бандите', x: 'шаг', y: 'средняя награда',
      names: ['жадный', 'ε = 0.01', 'ε = 0.1', 'UCB, c = 2'],
      desc: `Четыре кривые средней награды по 2000 бандитам за 1000 шагов. Жадный метод быстро выходит на плато около ${last[0].toFixed(2)}. ε-жадный с ε = 0.1 растёт быстрее всех в начале и выходит на ${last[2].toFixed(2)}; с ε = 0.01 растёт медленнее и к концу достигает ${last[1].toFixed(2)}. UCB с c = 2 после первых десяти шагов, где он пробует каждую руку по разу, идёт выше всех и заканчивает на ${last[3].toFixed(2)}.` }
  : { title: 'Greedy, ε-greedy and UCB on the 10-armed testbed', x: 'step', y: 'average reward',
      names: ['greedy', 'ε = 0.01', 'ε = 0.1', 'UCB, c = 2'],
      desc: `Four curves of the average reward over 2000 bandits for 1000 steps. Greedy levels off early at about ${last[0].toFixed(2)}. ε-greedy with ε = 0.1 rises fastest at first and levels off at ${last[2].toFixed(2)}; with ε = 0.01 it rises more slowly and reaches ${last[1].toFixed(2)} by the end. UCB with c = 2, after the first ten steps in which it tries every arm once, stays above the others and ends at ${last[3].toFixed(2)}.` };
const id = 'td-bandit-curves';
const caption = ru
  ? `Средняя награда на каждом шаге по 2000 случайным бандитам с десятью руками (истинные ценности q*(a) из N(0, 1), награды из N(q*(a), 1)), оценки — выборочные средние, начиная с 0; точки — средние по окнам из 5 шагов. За последние 100 шагов: жадный ${last[0].toFixed(2)}, ε = 0.01 ${last[1].toFixed(2)}, ε = 0.1 ${last[2].toFixed(2)}, UCB ${last[3].toFixed(2)}; доля шагов, на которых выбрана лучшая рука, — ${opt.map((v) => v.toFixed(2)).join(', ')}. Жадный метод застревает на первой руке, которая показалась хорошей. Ожидаемая награда лучшей руки в среднем около 1.54.`
  : `Average reward at each step over 2000 random 10-armed bandits (true values q*(a) drawn from N(0, 1), rewards from N(q*(a), 1)), with sample-average estimates starting at 0; points are means over windows of 5 steps. Over the last 100 steps: greedy ${last[0].toFixed(2)}, ε = 0.01 ${last[1].toFixed(2)}, ε = 0.1 ${last[2].toFixed(2)}, UCB ${last[3].toFixed(2)}; the fraction of steps on which the best arm is chosen is ${opt.map((v) => v.toFixed(2)).join(', ')}. Greedy gets stuck on the first arm that looked good. The best arm's expected reward is about 1.54 on average.`;

const curves = res.map((r) => bins(r.reward, 5));
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [70, 610] as [number, number], py: [40, 270] as [number, number], legend: false },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 390, px: [52, 344] as [number, number], py: [44, 270] as [number, number], legend: true },
];
const dy: [number, number] = [0, 1.6];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sy = scale(dy, [L.py[1], L.py[0]]);
    const ends = spread(curves.map((c) => sy(c.ys[c.ys.length - 1])), 16);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        <Curves px={L.px} py={L.py} dx={[0, 1000]} dy={dy} xTicks={[0, 250, 500, 750, 1000]} yTicks={[0, 0.4, 0.8, 1.2, 1.6]}
          yFmt={(v: number) => v.toFixed(1)} xLabel={t.x} yLabel={t.y}
          series={curves.map((c, i) => ({ xs: c.xs, ys: c.ys, cls: cls[i] }))} />
        {!L.legend && curves.map((_, i) => <text class={`f-small ${tcls[i]}`} x={L.px[1] + 8} y={ends[i] + 4}>{t.names[i]}</text>)}
        {L.legend && t.names.map((name, i) => (
          <g>
            <path class={cls[i]} d={`M ${16 + (i % 2) * 172} ${338 + Math.floor(i / 2) * 26 - 5} h 24`} />
            <text class={`f-small ${tcls[i]}`} x={48 + (i % 2) * 172} y={338 + Math.floor(i / 2) * 26}>{name}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
