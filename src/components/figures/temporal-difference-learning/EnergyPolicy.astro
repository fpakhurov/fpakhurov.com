---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { control } from './cases';
const ru = pageLang(Astro.url) === 'ru';
const id = 'td-energy-policy';
const title = ru ? 'Сравнивайте при одинаковом исследовании' : 'Compare under the same exploration';
const caption = ru
  ? 'Ценность из уровня ресурса 1 при γ=4/5. Две нижние строки имеют одинаковое ε=1/5: зарядка на уровне 1 увеличивает ценность. Верхняя строка отключает исследование и служит отдельным ориентиром. Значения получены решением трёх уравнений Беллмана для каждой стратегии.'
  : 'Value from resource level 1 with γ=4/5. The lower two rows share ε=1/5: charging at level 1 improves value. The top row turns exploration off and is a separate reference. Each value comes from solving three policy Bellman equations.';
const x = (v: number) => 30 + v / 6 * 286;
---
<span id="fig-td-cliff-walking"></span>
<Figure id={id} title={title} caption={caption}>
  <svg viewBox="0 0 350 277" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
    <title id={`${id}-title`}>{title}</title>
    <desc id={`${id}-desc`}>{caption}</desc>
    {control.map((item, i) => (
      <g>
        <text x="30" y={29 + 72 * i} class="f-label">ε={i ? '1/5' : '0'} · g=({item.skeleton.join(',')})</text>
        <path d={`M 30 ${52 + 72 * i} H 316`} class="f-grid" />
        <rect x="30" y={43 + 72 * i} width={x(item.values[1]) - 30} height="18" rx="2" fill={i === 0 ? 'var(--muted)' : 'var(--fig-blue)'} />
        <text x={x(item.values[1]) + 6} y={57 + 72 * i} class="f-small">{item.values[1].toFixed(3)}</text>
      </g>
    ))}
    {[0, 1, 2, 3, 4, 5, 6].map(v => <text x={x(v)} y="245" text-anchor="middle" class="f-small f-t-muted">{v}</text>)}
    <text x="316" y="270" text-anchor="end" class="f-small">{ru ? 'Ценность V(1)' : 'Value V(1)'}</text>
  </svg>
</Figure>
<style>svg { display: block; width: 100%; max-width: 520px; height: auto; margin-inline: auto; }</style>
