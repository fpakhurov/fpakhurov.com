---
import Figure from '../Figure.astro';
import Curves from './Curves.astro';
import { scale, polyline } from '../geometry';
import { cliff, cliffExact, greedyPath, bins, mean, CW } from './td';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Cliff walking: a 4 x 12 grid, start bottom left, goal bottom right, the ten cells between them are the cliff.
// Reward -1 per step; stepping into the cliff gives -100 and sends the agent back to the start. γ = 1, ε = 0.1, α = 0.5.
// Learning curves: sum of rewards per episode, averaged over 200 runs, then over windows of 10 episodes.
const runs = { sarsa: cliff('sarsa'), q: cliff('q') };
const ex = cliffExact(0.1);
const pathQ = greedyPath(ex.Qstar), pathS = greedyPath(ex.Qsoft);
const late = { sarsa: mean(runs.sarsa.ret, 400, 500), q: mean(runs.q.ret, 400, 500) };
const chk = [late.sarsa.toFixed(1), late.q.toFixed(1), ex.optimal.toFixed(0), ex.qGreedy.toFixed(1), ex.soft.toFixed(1), pathQ.length - 1, pathS.length - 1].join(' ');
if (chk !== '-26.9 -49.7 -13 -45.8 -20.7 13 15') throw new Error(`CliffWalking: numbers drifted from the note (${chk})`);
if (pathQ.slice(1, 13).some((s) => Math.floor(s / CW.cols) !== 2)) throw new Error('CliffWalking: the path of Q* no longer runs along the cliff edge');

const t = ru
  ? { title: 'Блуждание у обрыва: SARSA и Q-обучение', start: 'S', goal: 'G', cliff: 'обрыв: −100, назад в S',
      pq: 'Q*: по краю, 13 шагов', ps: 'лучшая ε-жадная: на ряд выше, 15 шагов',
      x: 'эпизоды', y: 'сумма наград за эпизод', sarsa: 'SARSA', q: 'Q-обучение',
      ref: [`−13: оптимальный путь`, `${ex.soft.toFixed(1)}: лучшая ε-жадная стратегия`, `${ex.qGreedy.toFixed(1)}: ε-жадная по Q*`],
      desc: `Слева сетка 4 на 12 с обрывом вдоль нижнего края между стартом S и целью G. Красный путь, путь стратегии, жадной по Q*, идёт прямо над обрывом, 13 шагов. Синий путь, путь лучшей ε-жадной стратегии, проходит на ряд выше, 15 шагов. Справа кривые обучения: SARSA выходит примерно на ${late.sarsa.toFixed(0)} за эпизод, Q-обучение — примерно на ${late.q.toFixed(0)}, хотя выучивает более короткий путь. Пунктирные линии: −13, ${ex.soft.toFixed(1)} и ${ex.qGreedy.toFixed(1)}.` }
  : { title: 'Cliff walking: SARSA and Q-learning', start: 'S', goal: 'G', cliff: 'cliff: −100, back to S',
      pq: 'Q*: along the edge, 13 steps', ps: 'best ε-greedy: one row up, 15 steps',
      x: 'episodes', y: 'sum of rewards per episode', sarsa: 'SARSA', q: 'Q-learning',
      ref: [`−13: optimal path`, `${ex.soft.toFixed(1)}: best ε-greedy policy`, `${ex.qGreedy.toFixed(1)}: ε-greedy on Q*`],
      desc: `Left: the 4 by 12 grid with the cliff along the bottom edge between the start S and the goal G. The red path, that of the policy greedy in Q*, runs right above the cliff, 13 steps. The blue path, that of the best ε-greedy policy, runs one row higher, 15 steps. Right: learning curves. SARSA levels off at about ${late.sarsa.toFixed(0)} per episode and Q-learning at about ${late.q.toFixed(0)}, although Q-learning learns the shorter path. Dashed lines: −13, ${ex.soft.toFixed(1)} and ${ex.qGreedy.toFixed(1)}.` };
const id = 'td-cliff-walking';
const caption = ru
  ? `Награда −1 за шаг, шаг в обрыв стоит −100 и возвращает в S; γ = 1, ε = 0.1, α = 0.5, начальные Q = 0. Кривые — суммы наград за эпизод при ε-жадном поведении, среднее по 200 запускам и по окнам из 10 эпизодов; первые окна обрезаны на −100. Пути — пределы двух методов, вычисленные точно: Q-обучение сходится к Q*, жадный путь которого идёт по краю, а ε-жадное поведение на этом пути время от времени падает с обрыва (точное ожидание ${ex.qGreedy.toFixed(1)}). SARSA оценивает ту стратегию, которой действует, и уходит на безопасный путь; лучшая ε-жадная стратегия набирает в среднем ${ex.soft.toFixed(1)}. При α = 0.5 оценки продолжают колебаться, поэтому за эпизоды 401–500 кривые стоят на ${late.sarsa.toFixed(1)} и ${late.q.toFixed(1)}, чуть ниже своих пределов.`
  : `Reward −1 per step; a step into the cliff costs −100 and returns to S; γ = 1, ε = 0.1, α = 0.5, Q initialized to 0. The curves are sums of rewards per episode under ε-greedy behaviour, averaged over 200 runs and over windows of 10 episodes; the first windows are clipped at −100. The paths are the limits of the two methods, computed exactly: Q-learning converges to Q*, whose greedy path runs along the edge, and ε-greedy behaviour on that path now and then falls off (an exact expectation of ${ex.qGreedy.toFixed(1)}). SARSA evaluates the policy it follows and moves to the safer path; the best ε-greedy policy averages ${ex.soft.toFixed(1)}. With α = 0.5 the estimates keep fluctuating, so over episodes 401–500 the curves sit at ${late.sarsa.toFixed(1)} and ${late.q.toFixed(1)}, a little below their limits.`;

const curves = { sarsa: bins(runs.sarsa.ret, 10), q: bins(runs.q.ret, 10) };
const refs = [-13, ex.soft, ex.qGreedy];
const minusFmt = (v: number) => (v < 0 ? `−${-v}` : String(v));
// every cell of the grid, with a flag for the ten cells of the cliff
const gridCells = Array.from({ length: CW.rows * CW.cols }, (_, s) => ({ s, cliff: Math.floor(s / CW.cols) === 3 && s % CW.cols >= 1 && s % CW.cols <= 10 }));
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, gx: 16, gy: 70, cell: 24, leg: [16, 206], legGap: 22,
    px: [396, 664] as [number, number], py: [40, 270] as [number, number], ends: true },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 600, gx: 24, gy: 30, cell: 26, leg: [24, 180], legGap: 24,
    px: [56, 344] as [number, number], py: [268, 498] as [number, number], ends: false },
];
const dy: [number, number] = [-100, 0];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const cx = (s: number) => L.gx + (s % CW.cols) * L.cell + L.cell / 2;
    const cy = (s: number) => L.gy + Math.floor(s / CW.cols) * L.cell + L.cell / 2;
    const off = (p: number[], d: number) => p.map((s) => [cx(s) + d, cy(s) - d] as [number, number]);   // red d = -4, blue d = +4: the paths do not cover each other
    const sy = scale(dy, [L.py[1], L.py[0]]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {gridCells.map((g) => <rect x={L.gx + (g.s % CW.cols) * L.cell} y={L.gy + Math.floor(g.s / CW.cols) * L.cell} width={L.cell} height={L.cell}
          class={g.cliff ? 'f-fill-red' : 'f-fill-paper'} style="stroke: var(--line); stroke-width: 1" />)}
        <text class="f-small f-t-red" x={L.gx + 6 * L.cell} y={cy(40) + 4.5} text-anchor="middle">{t.cliff}</text>
        <text class="f-label" x={cx(CW.start)} y={cy(CW.start) + 5} text-anchor="middle">{t.start}</text>
        <text class="f-label" x={cx(CW.goal)} y={cy(CW.goal) + 5} text-anchor="middle">{t.goal}</text>
        <path class="f-line f-red f-bold" d={polyline(off(pathQ.slice(0, -1), -4))} />
        <path class="f-line f-blue f-bold" d={polyline(off(pathS.slice(0, -1), 4))} />
        <path class="f-line f-red" d={polyline([[cx(35) - 4, cy(35) + 4], [cx(47) - 4, cy(47) - 9]])} marker-end="url(#f-arrow-red)" />
        <path class="f-line f-blue" d={polyline([[cx(35) + 4, cy(35) - 4], [cx(47) + 4, cy(47) - 9]])} marker-end="url(#f-arrow-blue)" />
        <path class="f-line f-red f-bold" d={`M ${L.leg[0]} ${L.leg[1] - 5} h 22`} />
        <text class="f-small f-t-red" x={L.leg[0] + 30} y={L.leg[1]}>{t.pq}</text>
        <path class="f-line f-blue f-bold" d={`M ${L.leg[0]} ${L.leg[1] + L.legGap - 5} h 22`} />
        <text class="f-small f-t-blue" x={L.leg[0] + 30} y={L.leg[1] + L.legGap}>{t.ps}</text>
        <Curves px={L.px} py={L.py} dx={[0, 500]} dy={dy} xTicks={[0, 100, 200, 300, 400, 500]} yTicks={[-100, -80, -60, -40, -20, 0]}
          yFmt={minusFmt} xLabel={t.x} yLabel={t.y} yLabelAt={[L.px[0] - 44, L.py[0] - 20]}
          series={[{ xs: curves.sarsa.xs, ys: curves.sarsa.ys, cls: 'f-line f-blue' }, { xs: curves.q.xs, ys: curves.q.ys, cls: 'f-line f-red' }]} />
        {refs.map((v, i) => (
          <g>
            <path class="f-line f-muted f-dash" d={`M ${L.px[0]} ${sy(v)} H ${L.px[1]}`} style="stroke-width: 1.1" />
            <text class="f-small f-t-muted f-halo" x={L.px[1] - 4} y={sy(v) - 4} text-anchor="end">{t.ref[i]}</text>
          </g>
        ))}
        {L.ends && <text class="f-small f-t-blue" x={L.px[1] + 8} y={sy(late.sarsa) + 4}>{t.sarsa}</text>}
        {L.ends && <text class="f-small f-t-red" x={L.px[1] + 8} y={sy(late.q) + 4}>{t.q}</text>}
        {!L.ends && (
          <g>
            <path class="f-line f-blue" d={`M 24 ${L.py[1] + 64} h 22`} />
            <text class="f-small f-t-blue" x={54} y={L.py[1] + 69}>{t.sarsa}</text>
            <path class="f-line f-red" d={`M 164 ${L.py[1] + 64} h 22`} />
            <text class="f-small f-t-red" x={194} y={L.py[1] + 69}>{t.q}</text>
          </g>
        )}
      </svg>
    );
  })}
</Figure>
