---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One TD(0) update and one Monte Carlo update on the random walk of the note, γ = 1, α = 0.1, with the estimates
// V(A..E) = 0.40, 0.45, 0.50, 0.60, 0.70 in the middle of learning. The walk steps from C to D with reward 0 and later
// leaves on the right, so the return from C is G = 1.
const V = [0.4, 0.45, 0.5, 0.6, 0.7], alpha = 0.1, R = 0, G = 1;
const target = R + V[3], delta = target - V[2], tdNew = V[2] + alpha * delta, mcNew = V[2] + alpha * (G - V[2]);
const f2 = (v: number) => v.toFixed(2);
if ([target, delta, tdNew, mcNew].map(f2).join(' ') !== '0.60 0.10 0.51 0.55') throw new Error('TdBackup: the worked example drifted');

const names = ['A', 'B', 'C', 'D', 'E'];
const t = ru
  ? {
      title: 'Одно обновление TD(0) и одно обновление Монте-Карло',
      walk: 'блуждание, γ = 1, α = 0.1', est: 'текущие оценки V(s)', r: `R = ${R}`,
      tLab: 'цель TD', tSub: `R + γ·V(D) = 0 + ${f2(V[3])} = ${f2(target)}`,
      dLab: 'ошибка TD δ', dSub: `${f2(target)} − V(C) = ${f2(target)} − ${f2(V[2])} = ${f2(delta)}`,
      uLab: 'обновление сразу', uSub: `V(C) ← ${f2(V[2])} + ${alpha} · ${f2(delta)} = ${f2(tdNew)}`,
      mc1: 'Монте-Карло ждёт конца эпизода: цель — отдача G', mc2: `C → D → E → выход справа, G = ${G}`, mc3: `V(C) ← ${f2(V[2])} + ${alpha} · (${G} − ${f2(V[2])}) = ${f2(mcNew)}`,
      steps: ['шаг: из C блуждание переходит в D, награда 0', `цель TD: награда плюс оценка следующего состояния, 0 + ${f2(V[3])}`, `ошибка TD: цель минус текущая оценка, ${f2(delta)}`, `обновление сразу: V(C) сдвигается на долю α = ${alpha} от ошибки, до ${f2(tdNew)}`, `Монте-Карло ждёт конца эпизода и сдвигает V(C) к отдаче G = ${G}, до ${f2(mcNew)}`],
      desc: `Сверху цепочка из пяти состояний A–E между двумя выходами с наградами 0 и 1, с текущими оценками ${V.map(f2).join(', ')}. Блуждание переходит из C в D с наградой 0. Цель TD равна 0 + ${f2(V[3])}, ошибка TD равна ${f2(delta)}, и оценка V(C) сразу становится ${f2(tdNew)}. Снизу метод Монте-Карло: он ждёт, пока эпизод закончится выходом справа с отдачей 1, и сдвигает V(C) до ${f2(mcNew)}.`,
    }
  : {
      title: 'One TD(0) update and one Monte Carlo update',
      walk: 'random walk, γ = 1, α = 0.1', est: 'current estimates V(s)', r: `R = ${R}`,
      tLab: 'TD target', tSub: `R + γ·V(D) = 0 + ${f2(V[3])} = ${f2(target)}`,
      dLab: 'TD error δ', dSub: `${f2(target)} − V(C) = ${f2(target)} − ${f2(V[2])} = ${f2(delta)}`,
      uLab: 'update at once', uSub: `V(C) ← ${f2(V[2])} + ${alpha} · ${f2(delta)} = ${f2(tdNew)}`,
      mc1: 'Monte Carlo waits for the end of the episode: its target is the return G', mc2: `C → D → E → right exit, G = ${G}`, mc3: `V(C) ← ${f2(V[2])} + ${alpha} · (${G} − ${f2(V[2])}) = ${f2(mcNew)}`,
      steps: ['act: from C the walk steps to D, reward 0', `TD target: the reward plus the estimate of the next state, 0 + ${f2(V[3])}`, `TD error: the target minus the current estimate, ${f2(delta)}`, `update at once: V(C) moves by α = ${alpha} times the error, to ${f2(tdNew)}`, `Monte Carlo waits for the end of the episode and moves V(C) toward the return G = ${G}, to ${f2(mcNew)}`],
      desc: `At the top, a chain of five states A–E between two exits with rewards 0 and 1, with current estimates ${V.map(f2).join(', ')}. The walk steps from C to D with reward 0. The TD target is 0 + ${f2(V[3])}, the TD error is ${f2(delta)}, and the estimate V(C) becomes ${f2(tdNew)} at once. At the bottom, Monte Carlo: it waits until the episode ends at the right exit with return 1 and moves V(C) to ${f2(mcNew)}.`,
    };
const id = 'td-backup';
const caption = ru
  ? `Числа — середина обучения на случайном блуждании из текста (истинные ценности 1/6, …, 5/6). TD(0) обновляет оценку после каждого шага, используя оценку следующего состояния вместо остатка эпизода: цель смещена, пока V(D) неверна, но зависит только от одного случайного шага. Монте-Карло использует настоящую отдачу, несмещённую, но более шумную цель, и может обновить V(C) только после конца эпизода.`
  : `The numbers are a snapshot in the middle of learning on the random walk of the text (true values 1/6, …, 5/6). TD(0) updates after every step and uses the estimate of the next state in place of the rest of the episode: its target is biased while V(D) is wrong, but it depends on a single random step. Monte Carlo uses the actual return, an unbiased but noisier target, and can update V(C) only after the episode has ended.`;

// chain geometry: [centre x] of the left exit, A..E, the right exit
const chainW = { y: 72, r: 20, xs: [57, 130, 210, 290, 370, 450, 523], box: 34 };
const chainN = { y: 44, r: 16, xs: [24, 74, 124, 174, 224, 274, 330], box: 28 };
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 360" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    {[0, 6].map((i) => <rect x={chainW.xs[i] - chainW.box / 2} y={chainW.y - chainW.box / 2} width={chainW.box} height={chainW.box} rx="4" class="f-box-soft" />)}
    <text class="f-label" x={chainW.xs[0]} y={chainW.y + 5} text-anchor="middle">0</text>
    <text class="f-label" x={chainW.xs[6]} y={chainW.y + 5} text-anchor="middle">1</text>
    {[0, 1, 2, 3, 4, 5].map((i) => <path class="f-thin" d={`M ${chainW.xs[i] + (i === 0 ? chainW.box / 2 : chainW.r)} ${chainW.y} H ${chainW.xs[i + 1] - (i === 5 ? chainW.box / 2 : chainW.r)}`} style="stroke: var(--line)" />)}
    {names.map((n, i) => (
      <g>
        <circle cx={chainW.xs[i + 1]} cy={chainW.y} r={chainW.r} style="fill: var(--fig-blue); fill-opacity: 0.14; stroke: var(--fig-blue); stroke-width: 1.3" />
        <text class="f-label" x={chainW.xs[i + 1]} y={chainW.y + 5} text-anchor="middle">{n}</text>
        <text class="f-small f-t-blue" x={chainW.xs[i + 1]} y={chainW.y + 40} text-anchor="middle">{f2(V[i])}</text>
      </g>
    ))}
    <text class="f-small f-t-muted" x="560" y="76">{t.walk}</text>
    <text class="f-small f-t-muted" x="560" y="116">{t.est}</text>
    <g data-s="1">
      <path class="f-line f-green" d={`M ${chainW.xs[3] + 8} ${chainW.y - 22} Q ${(chainW.xs[3] + chainW.xs[4]) / 2} ${chainW.y - 50} ${chainW.xs[4] - 8} ${chainW.y - 22}`} marker-end="url(#f-arrow-green)" />
      <text class="f-small f-t-green" x={(chainW.xs[3] + chainW.xs[4]) / 2} y={chainW.y - 42} text-anchor="middle">{t.r}</text>
      <Badge x={chainW.xs[3] - 22} y={chainW.y - 34} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[370, 122], [370, 158]]} tone="red" />
      <Box x={270} y={160} w={210} h={46} label={t.tLab} sub={t.tSub} tone="y" />
      <Badge x={392} y={140} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[480, 183], [518, 183]]} />
      <Box x={520} y={160} w={220} h={46} label={t.dLab} sub={t.dSub} tone="g" />
      <Badge x={740} y={160} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[630, 206], [630, 234]]} />
      <Box x={520} y={236} w={220} h={46} label={t.uLab} sub={t.uSub} tone="h" />
      <Arrow pts={[[520, 259], [250, 259], [250, 84], [268, 78]]} tone="blue" />
      <Badge x={740} y={236} n={4} />
    </g>
    <g data-s="5">
      <path class="f-line f-red f-dash" d={`M ${chainW.xs[4] + 8} ${chainW.y + 22} Q ${(chainW.xs[4] + chainW.xs[5]) / 2} ${chainW.y + 34} ${chainW.xs[5] - 8} ${chainW.y + 22} M ${chainW.xs[5] + 8} ${chainW.y + 22} Q ${(chainW.xs[5] + chainW.xs[6]) / 2} ${chainW.y + 34} ${chainW.xs[6] - 10} ${chainW.y + 18}`} marker-end="url(#f-arrow-red)" />
      <rect x="30" y="300" width="710" height="54" rx="7" class="f-box-soft" style="stroke-dasharray: 6 4" />
      <text class="f-label" x="44" y="322">{t.mc1}</text>
      <text class="f-small f-t-muted" x="44" y="343">{t.mc2}<tspan dx="18">{t.mc3}</tspan></text>
      <Badge x={30} y={300} n={5} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 530" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    {[0, 6].map((i) => <rect x={chainN.xs[i] - chainN.box / 2} y={chainN.y - chainN.box / 2} width={chainN.box} height={chainN.box} rx="4" class="f-box-soft" />)}
    <text class="f-label" x={chainN.xs[0]} y={chainN.y + 5} text-anchor="middle">0</text>
    <text class="f-label" x={chainN.xs[6]} y={chainN.y + 5} text-anchor="middle">1</text>
    {names.map((n, i) => (
      <g>
        <circle cx={chainN.xs[i + 1]} cy={chainN.y} r={chainN.r} style="fill: var(--fig-blue); fill-opacity: 0.14; stroke: var(--fig-blue); stroke-width: 1.3" />
        <text class="f-label" x={chainN.xs[i + 1]} y={chainN.y + 5} text-anchor="middle">{n}</text>
        <text class="f-small f-t-blue" x={chainN.xs[i + 1]} y={chainN.y + 36} text-anchor="middle">{f2(V[i])}</text>
      </g>
    ))}
    <g data-s="1">
      <path class="f-line f-green" d={`M ${chainN.xs[3] + 6} ${chainN.y - 18} Q ${(chainN.xs[3] + chainN.xs[4]) / 2} ${chainN.y - 40} ${chainN.xs[4] - 6} ${chainN.y - 18}`} marker-end="url(#f-arrow-green)" />
      <text class="f-small f-t-green f-halo" x={(chainN.xs[3] + chainN.xs[4]) / 2 + 34} y={chainN.y - 26} text-anchor="start">{t.r}</text>
      <Badge x={chainN.xs[3] - 22} y={chainN.y - 26} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[224, 90], [224, 126]]} tone="red" />
      <Box x={16} y={128} w={328} h={50} label={t.tLab} sub={t.tSub} tone="y" />
      <Badge x={16} y={128} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[180, 178], [180, 196]]} />
      <Box x={16} y={198} w={328} h={50} label={t.dLab} sub={t.dSub} tone="g" />
      <Badge x={16} y={198} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[180, 248], [180, 266]]} />
      <Box x={16} y={268} w={328} h={50} label={t.uLab} sub={t.uSub} tone="h" />
      <Badge x={16} y={268} n={4} />
      <text class="f-small f-t-blue" x="180" y="342" text-anchor="middle">{ru ? '↑ новая оценка C' : '↑ the new estimate of C'}</text>
    </g>
    <g data-s="5">
      <rect x="16" y="364" width="328" height="156" rx="7" class="f-box-soft" style="stroke-dasharray: 6 4" />
      <text class="f-label" x="30" y="392">{ru ? 'Монте-Карло ждёт' : 'Monte Carlo waits'}</text>
      <text class="f-label" x="30" y="414">{ru ? 'конца эпизода:' : 'for the end of the episode:'}</text>
      <text class="f-label" x="30" y="436">{ru ? 'его цель — отдача G' : 'its target is the return G'}</text>
      <text class="f-small f-t-muted" x="30" y="474">{t.mc2}</text>
      <text class="f-small f-t-muted" x="30" y="500">{t.mc3}</text>
      <Badge x={16} y={364} n={5} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
