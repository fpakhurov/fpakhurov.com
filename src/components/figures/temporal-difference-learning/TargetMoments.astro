---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { prediction } from './cases';
const ru = pageLang(Astro.url) === 'ru';
const id = 'td-target-moments';
const title = ru ? 'Дисперсия зависит от оценки продолжения' : 'Variance depends on the continuation estimate';
const names = ru ? ['Монте-Карло', 'TD: точные ценности', 'TD: ошибочные ценности'] : ['Monte Carlo', 'TD: exact values', 'TD: wrong values'];
const caption = ru
  ? 'Из приёма задачи: дисперсии целей 2.08, 0 и 30.72. В последней строке используются V(A)=10 и V(M)=−6 вместо истинных 2. Это точные моменты заданного распределения, а не кривая обучения; ошибочный бутстрэппинг здесь увеличивает и смещение, и дисперсию.'
  : 'From intake: target variances are 2.08, 0 and 30.72. The last row uses V(A)=10 and V(M)=−6 instead of the true 2. These are exact distribution moments, not a learning curve; wrong bootstrapping increases both bias and variance here.';
const x = (v: number) => 30 + v / 32 * 286;
---
<span id="fig-td-random-walk-rms"></span>
<Figure id={id} title={title} caption={caption}>
  <svg viewBox="0 0 350 307" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
    <title id={`${id}-title`}>{title}</title>
    <desc id={`${id}-desc`}>{caption}</desc>
    {prediction.map((item, i) => (
      <g>
        <text x="30" y={26 + i * 84} class="f-label">{names[i]}</text>
        <text x="30" y={45 + i * 84} class="f-small f-t-muted">{ru ? 'Среднее' : 'Mean'}: {item.mean.toFixed(1)}</text>
        <path d={`M 30 ${63 + i * 84} H 316`} class="f-grid" />
        <rect x="30" y={54 + i * 84} width={Math.max(0, x(item.variance) - 30)} height="18" rx="2" fill={i === 2 ? 'var(--fig-amber)' : 'var(--fig-blue)'} />
        {item.variance === 0 && <path d={`M 30 ${53 + i * 84} v 20`} class="f-line f-blue f-bold" />}
        <text x="316" y={45 + i * 84} text-anchor="end" class="f-small">{ru ? 'Дисперсия' : 'Variance'}: {item.variance.toFixed(2)}</text>
      </g>
    ))}
    {[0, 8, 16, 24, 32].map(v => <text x={x(v)} y="278" text-anchor="middle" class="f-small f-t-muted">{v}</text>)}
    <text x="316" y="301" text-anchor="end" class="f-small">{ru ? 'Дисперсия цели' : 'Target variance'}</text>
  </svg>
</Figure>
<style>svg { display: block; width: 100%; max-width: 520px; height: auto; margin-inline: auto; }</style>
