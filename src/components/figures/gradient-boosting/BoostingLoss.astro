---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { curves, rounds } from './data';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Training and validation MSE against the boosting round for learning rates 1 and 0.1 (depth-3 trees,
// 50 training and 50 validation points of y = sin 2πx + N(0, 0.3²)), with the validation minimum marked.
const nums = curves.map((c) => `${c.bestRound} ${c.bestLoss.toFixed(3)} ${c.validLoss[rounds - 1].toFixed(3)}`).join(' | ');
if (nums !== '3 0.177 0.238 | 15 0.111 0.236') throw new Error(`BoostingLoss: numbers drifted from the caption (${nums})`);
const t = ru
  ? { x: 'раунд бустинга (лог. шкала)', y: 'MSE', tr: 'обучение', va: 'валидация', noise: 'шум σ² = 0.09', best: (r: number, v: number) => `раунд ${r}: ${v.toFixed(3)}` }
  : { x: 'boosting round (log scale)', y: 'MSE', tr: 'train', va: 'validation', noise: 'noise σ² = 0.09', best: (r: number, v: number) => `round ${r}: ${v.toFixed(3)}` };
const id = 'boosting-loss';
const layouts = [
  { cls: 'fig-wide', W: 620, H: 290, x0: 50, x1: 440, y0: 20, y1: 240, lx: 452 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 400, x0: 44, x1: 340, y0: 20, y1: 240, lx: 44 },
];
const tones = ['blue', 'red'];
---

<Figure
  id={id}
  title={ru ? 'Ранняя остановка и шаг обучения' : 'Early stopping and the learning rate'}
  caption={ru
    ? 'Деревья глубины 3, 50 обучающих и 50 валидационных точек y = sin 2πx + шум (σ = 0.3). Ошибка на обучении (тонкие линии) падает к нулю при любом шаге обучения. Ошибка на валидации (толстые) сначала падает, потом растёт: с шагом обучения 1 минимум 0.177 достигается уже на 3-м раунде, с шагом 0.1 — 0.111 на 15-м. К 300-му раунду обе модели переобучены (0.238 и 0.236). Ранняя остановка берёт модель в точке минимума.'
    : 'Depth-3 trees, 50 training and 50 validation points of y = sin 2πx + noise (σ = 0.3). The training error (thin lines) falls to zero at either learning rate. The validation error (thick lines) falls and then rises: with learning rate 1 its minimum, 0.177, comes at round 3; with learning rate 0.1 it is 0.111, at round 15. By round 300 both models are overfitted (0.238 and 0.236). Early stopping keeps the model at the minimum.'}
>
  {layouts.map((L) => {
    const sx = (r: number) => L.x0 + (Math.log(r) / Math.log(rounds)) * (L.x1 - L.x0);
    const sy0 = scale([0, 0.6], [L.y1, L.y0]), sy = (v: number) => sy0(Math.min(v, 0.6));
    const below = L.lx === L.x0;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Кривые обучения бустинга' : 'Learning curves of boosting'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Две пары кривых: ошибка на обучении падает до нуля, ошибка на валидации имеет минимум и затем растёт; с меньшим шагом обучения минимум ниже и позже.' : 'Two pairs of curves: the training error falls to zero, the validation error has a minimum and then rises; with the smaller learning rate the minimum is lower and later.'}</desc>
        <path class="f-axis" d={`M ${L.x0} ${L.y0} V ${L.y1} H ${L.x1}`} />
        {[0, 0.2, 0.4, 0.6].map((v) => <g><path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} /><text class="f-note" x={L.x0 - 6} y={sy(v) + 4} text-anchor="end">{v.toFixed(1)}</text></g>)}
        {[1, 3, 10, 30, 100, 300].map((r) => <text class="f-note" x={sx(r)} y={L.y1 + 16} text-anchor="middle">{r}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 36} text-anchor="middle">{t.x}</text>
        <path class="f-thin f-muted f-dash" d={`M ${L.x0} ${sy(0.09)} H ${L.x1}`} />
        <text class="f-note" x={L.x1 - 2} y={sy(0.09) - 6} text-anchor="end">{t.noise}</text>
        {curves.map((c, k) => (
          <g>
            <path class={`f-thin f-${tones[k]}`} d={polyline(c.trainLoss.map((v, i) => [sx(i + 1), sy(v)]))} />
            <path class={`f-line f-bold f-${tones[k]}`} d={polyline(c.validLoss.map((v, i) => [sx(i + 1), sy(v)]))} />
            <circle cx={sx(c.bestRound)} cy={sy(c.bestLoss)} r="5" class={`f-solid-${tones[k]}`} />
            <text class={`f-small f-t-${tones[k]} f-halo`} x={sx(c.bestRound) + (k === 0 ? 0 : 8)} y={sy(c.bestLoss) + (k === 0 ? 24 : 20)} text-anchor={k === 0 ? 'middle' : 'start'}>{t.best(c.bestRound, c.bestLoss)}</text>
          </g>
        ))}
        {curves.map((c, k) => (
          <g>
            <path class={`f-line f-bold f-${tones[k]}`} d={`M ${below ? L.x0 : L.lx} ${below ? L.y1 + 64 + k * 44 : 60 + k * 70} h 20`} />
            <text class="f-small" x={(below ? L.x0 : L.lx) + 26} y={(below ? L.y1 + 64 + k * 44 : 60 + k * 70) + 4}>{`ν = ${c.nu}, ${t.va}`}</text>
            <path class={`f-thin f-${tones[k]}`} d={`M ${below ? L.x0 : L.lx} ${below ? L.y1 + 84 + k * 44 : 82 + k * 70} h 20`} />
            <text class="f-small" x={(below ? L.x0 : L.lx) + 26} y={(below ? L.y1 + 84 + k * 44 : 82 + k * 70) + 4}>{`ν = ${c.nu}, ${t.tr}`}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
