---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale } from '../geometry';
import { train, stages, stageNu, truth } from './data';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Squared-loss boosting with stumps and learning rate 0.5 on 50 points of y = sin 2πx + N(0, 0.3²).
// In the panels “residuals and stump b”: the residuals y − F_{m−1}(x) and the stump bₘ fitted to them; top row: F_m = F_{m−1} + 0.5 b_m.
const losses = stages.map((s) => s.loss.toFixed(3)).join(' ');
if (losses !== '0.331 0.223 0.152 0.055' || stageNu !== 0.5) throw new Error(`BoostingStages: losses drifted from the caption (${losses})`);
const t = ru
  ? { fit: 'модель F', res: 'остатки и пень b', mse: 'MSE',
      steps: ['m = 1: от константы F₀ = среднее; пень по остаткам делит ось в одной точке', 'm = 2: новые остатки, новый пень; модель — сумма двух сжатых ступенек', 'm = 5: остатки уже меньше; каждый пень исправляет то, что осталось', 'm = 40: модель следует синусоиде, остатки похожи на шум; дальше она начнёт подгоняться под шум'] }
  : { fit: 'model F', res: 'residuals and stump b', mse: 'MSE',
      steps: ['m = 1: start from the constant F₀ = mean; a stump fitted to the residuals splits the axis once', 'm = 2: new residuals, a new stump; the model is a sum of two shrunken steps', 'm = 5: the residuals are smaller; each stump corrects what is left', 'm = 40: the model follows the sine and the residuals look like noise; from here on it starts fitting the noise'] };
const id = 'boosting-stages';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 380, cell: (k: number) => [16 + k * 188, 46], cw: 170, top: 130, bot: 120, gap: 46 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 820, cell: (k: number) => [16, 52 + k * 196], cw: 156, top: 130, bot: 130, gap: 0, side: true },
];
const stepPath = (st: [number, number, number][], sx: (v: number) => number, sy: (v: number) => number) =>
  st.map(([a, b, v], i) => `${i === 0 ? `M ${sx(a).toFixed(1)}` : 'V'} ${sy(v).toFixed(1)} H ${sx(b).toFixed(1)}`).join(' ');
const grid = Array.from({ length: 121 }, (_, i) => i / 120);
---

<Figure
  id={id}
  title={ru ? 'Бустинг шаг за шагом' : 'Boosting stage by stage'}
  caption={ru
    ? 'Квадратичная функция потерь, 50 точек y = sin 2πx + шум (σ = 0.3), пни (деревья глубины 1), шаг обучения 0.5. На панелях «остатки и пень b»: остатки yᵢ − Fₘ₋₁(xᵢ) (зелёные) и пень bₘ, подогнанный к ним методом наименьших квадратов (янтарный). На панелях «модель F»: модель Fₘ = Fₘ₋₁ + 0.5·bₘ (синяя) поверх данных и истинной функции (пунктир). Ошибка на обучении (MSE) после 1, 2, 5 и 40 шагов: 0.331, 0.223, 0.152, 0.055; последнее значение ниже шума σ² = 0.09 — модель уже начала запоминать шум.'
    : 'Squared loss, 50 points of y = sin 2πx + noise (σ = 0.3), stumps (depth-1 trees), learning rate 0.5. In the panels “residuals and stump b”: the residuals yᵢ − Fₘ₋₁(xᵢ) (green) and the stump bₘ fitted to them by least squares (amber). In the panels “model F”: the model Fₘ = Fₘ₋₁ + 0.5·bₘ (blue) over the data and the true function (dotted). Training error (MSE) after 1, 2, 5 and 40 stages: 0.331, 0.223, 0.152, 0.055; the last value is below the noise σ² = 0.09, so the model has begun to memorize noise.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Четыре стадии бустинга' : 'Four stages of boosting'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'В каждой стадии вверху ступенчатая модель над точками, внизу остатки и одна ступенька, подогнанная к ним; со стадиями модель приближается к синусоиде, а остатки сжимаются к нулю.' : 'At each stage, a step model over the points on top and the residuals with one step fitted to them below; over the stages the model approaches the sine and the residuals shrink towards zero.'}</desc>
      {stages.map((s, k) => {
        const [x0, y0] = L.cell(k);
        const tx = scale([0, 1], [x0, x0 + L.cw]), ty = scale([-1.8, 1.8], [y0 + L.top, y0]);
        const bx0 = L.side ? x0 + L.cw + 16 : x0, by0 = L.side ? y0 : y0 + L.top + L.gap;
        const bx = scale([0, 1], [bx0, bx0 + L.cw]), by = scale([-1.8, 1.8], [by0 + L.bot, by0]);
        return (
          <g data-s={k + 1}>
            <Badge x={x0 + 9} y={y0 - 28} n={k + 1} />
            <text class="f-small" x={x0 + 24} y={y0 - 24}>{`m = ${s.m}`}</text>
            <text class="f-note" x={x0 + 84} y={y0 - 24}>{`${t.mse} ${s.loss.toFixed(3)}`}</text>
            <rect x={x0} y={y0} width={L.cw} height={L.top} style="fill: none; stroke: var(--line); stroke-width: 1" />
            <path class="f-thin f-dot" style="stroke: var(--ink)" d={grid.map((x, i) => `${i ? 'L' : 'M'} ${tx(x).toFixed(1)} ${ty(truth(x)).toFixed(1)}`).join(' ')} />
            {train.xs.map((x, i) => <circle cx={tx(x)} cy={ty(Math.max(-1.8, Math.min(1.8, train.ys[i])))} r="2.2" class="f-solid-muted" />)}
            <path class="f-line f-blue f-bold" d={stepPath(s.fit, tx, ty)} />
            <rect x={bx0} y={by0} width={L.cw} height={L.bot} style="fill: none; stroke: var(--line); stroke-width: 1" />
            <path class="f-grid" d={`M ${bx0} ${by(0)} H ${bx0 + L.cw}`} />
            {train.xs.map((x, i) => <circle cx={bx(x)} cy={by(Math.max(-1.8, Math.min(1.8, s.resid[i])))} r="2.2" class="f-solid-green" />)}
            <path class="f-line f-amber f-bold" d={stepPath(s.tree, bx, by)} />
            <text class="f-note" x={L.side ? bx0 : x0} y={(L.side ? by0 + L.bot : by0 + L.bot) + 16}>{L.side ? t.res : k === 0 ? t.res : ''}</text>
            {L.side ? <text class="f-note" x={x0} y={y0 + L.top + 16}>{t.fit}</text> : k === 0 ? <text class="f-note" x={x0} y={y0 + L.top + 16}>{t.fit}</text> : null}
          </g>
        );
      })}
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
