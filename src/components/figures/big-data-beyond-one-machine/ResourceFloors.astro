---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { compactGB, cpuSeconds, deadline, inputGB, readSeconds } from './example';

const ru = pageLang(Astro.url) === 'ru';
const id = 'big-data-resource-floors';
const gb = ru ? 'ГБ' : 'GB';
const sec = ru ? 'с' : 's';
const x = 100;
const span = 219;
const scale = span / readSeconds(inputGB);
const mark = x + deadline * scale;
const groups = [inputGB, compactGB].map((volume, index) => ({
  title: ru ? 'Объём чтения · ' + volume + ' ' + gb : 'Bytes read · ' + volume + ' ' + gb,
  y: 20 + index * 93,
  bars: [
    { label: ru ? 'Чтение' : 'Read', seconds: readSeconds(volume), color: 'blue' },
    { label: 'CPU', seconds: cpuSeconds, color: 'amber' },
  ],
}));
---

<Figure id={id}
  title={ru ? 'Чтение и обработка задают разные границы' : 'Reading and processing set different floors'}
  caption={ru
    ? 'Длина полосы показывает нижнюю границу времени для ресурса. Пунктир отмечает цель 180 с. Во втором варианте сокращается объём чтения, а производительность CPU в условии остаётся прежней.'
    : 'Each bar gives a lower bound for one resource. The dashed line marks the 180 s target. The second layout cuts the read volume and keeps the assumed CPU rate fixed.'}>
  <svg class="fig-compact" viewBox="0 0 380 222" role="img" aria-labelledby={id + '-title ' + id + '-desc'}>
    <title id={id + '-title'}>{ru ? 'Сравнение границ времени чтения и обработки' : 'Read and CPU time bounds'}</title>
    <desc id={id + '-desc'}>{ru
      ? 'В первом варианте чтение занимает не менее 600 секунд, а обработка не менее 200. Во втором нижняя граница чтения снижается до 150 секунд. Граница обработки остаётся выше цели 180 секунд.'
      : 'The original read requires at least 600 seconds and processing at least 200. The smaller read requires at least 150 seconds. The processing floor remains above the 180-second target.'}</desc>
    <path class="f-line f-dash f-red" d={'M ' + mark + ' 30 V 91 M ' + mark + ' 123 V 195'} />
    {groups.map((group) => <>
      <text class="f-title" x="8" y={group.y}>{group.title}</text>
      {group.bars.map((bar, index) => {
        const y = group.y + 16 + index * 28;
        return <>
          <text class="f-label" x="8" y={y + 14}>{bar.label}</text>
          <rect class={'f-fill-' + bar.color} x={x} y={y} width={bar.seconds * scale} height="19" rx="3" />
          <path class={'f-line f-bold f-' + bar.color} d={'M ' + x + ' ' + (y + 10) + ' h ' + (bar.seconds * scale)} />
          <text class="f-label" x="371" y={y + 14} text-anchor="end">{bar.seconds + ' ' + sec}</text>
        </>;
      })}
    </>)}
    <text class="f-label f-t-red" x={mark} y="216" text-anchor="middle">{ru ? 'Цель 180 с' : 'Target 180 s'}</text>
  </svg>
</Figure>
