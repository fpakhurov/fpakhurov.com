---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { inputGB, linkGbitPerSecond, partialsKB, stores, subtotalBytes, transferSeconds, workers } from './example';

const ru = pageLang(Astro.url) === 'ru';
const id = 'big-data-network-traffic';
const rows = [
  {
    title: ru ? 'Чтение по общему каналу' : 'Read through a shared link',
    from: ru ? 'Хранилище' : 'Storage',
    to: ru ? 'Исполнители' : 'Workers',
    data: inputGB + (ru ? ' ГБ' : ' GB'),
    note: ru ? 'Передача ≥ ' + transferSeconds + ' с при ' + linkGbitPerSecond + ' Гбит/с' : 'Transfer ≥ ' + transferSeconds + ' s at ' + linkGbitPerSecond + ' Gbit/s',
    color: 'red',
  },
  {
    title: ru ? 'Чтение и подсчёт на узлах' : 'Read and sum on each node',
    from: ru ? 'Исполнители' : 'Workers',
    to: ru ? 'Сбор итогов' : 'Merge totals',
    data: '≤ ' + partialsKB + (ru ? ' кБ' : ' kB'),
    note: ru
      ? workers + ' узла × ' + stores + ' магазинов × ' + subtotalBytes + ' байт'
      : workers + ' nodes × ' + stores + ' stores × ' + subtotalBytes + ' bytes',
    color: 'green',
  },
];
---

<Figure id={id}
  title={ru ? 'Место агрегации определяет объём передачи' : 'Where we aggregate changes what we send'}
  caption={ru
    ? 'Сверху все исходные байты проходят через одно сетевое узкое место. Снизу узлы читают свои части локально и отправляют только промежуточные итоги. Размер итогов учитывает полезную нагрузку без служебных данных.'
    : 'In the top plan all input bytes pass through one network bottleneck. In the bottom plan workers read locally and send partial totals. The size of those totals counts payload bytes before framing.'}>
  <svg class="fig-compact" viewBox="0 0 380 246" role="img" aria-labelledby={id + '-title ' + id + '-desc'}>
    <title id={id + '-title'}>{ru ? 'Пересылка исходных данных и промежуточных итогов' : 'Transfer of raw input or partial totals'}</title>
    <desc id={id + '-desc'}>{ru
      ? 'При удалённом чтении общий канал переносит 600 ГБ. При локальном чтении четыре исполнителя отправляют не более 32 кБ промежуточных итогов.'
      : 'Remote input puts 600 GB through a shared link. With local input, four workers send at most 32 kB of partial totals.'}</desc>
    {rows.map((row, index) => {
      const y = 20 + 125 * index;
      const stroke = 'f-line f-bold f-' + row.color;
      return <>
        <text class="f-title" x="8" y={y}>{row.title}</text>
        <rect class="f-box-soft" x="8" y={y + 25} width="116" height="38" rx="5" />
        <rect class="f-box-soft" x="256" y={y + 25} width="116" height="38" rx="5" />
        <text class="f-label" x="66" y={y + 49} text-anchor="middle">{row.from}</text>
        <text class="f-label" x="314" y={y + 49} text-anchor="middle">{row.to}</text>
        <text class={'f-label f-t-' + row.color} x="190" y={y + 35} text-anchor="middle">{row.data}</text>
        <path class={stroke} d={'M 133 ' + (y + 49) + ' H 244 m -7 -5 l 7 5 -7 5'} />
        <text class="f-label" x="8" y={y + 88}>{row.note}</text>
      </>;
    })}
  </svg>
</Figure>
