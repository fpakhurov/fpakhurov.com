---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { balancedGB, diskGBps, readSeconds, skewedGB } from './example';

const ru = pageLang(Astro.url) === 'ru';
const id = 'big-data-partition-floors';
const groups = [
  { title: ru ? 'Равные части' : 'Equal partitions', data: balancedGB },
  { title: ru ? 'Неравные части' : 'Unequal partitions', data: skewedGB },
];
const x = 89;
const scale = 189 / Math.max(...skewedGB);
const sec = ru ? 'с' : 's';
const gb = ru ? 'ГБ' : 'GB';
---

<Figure id={id}
  title={ru ? 'Чтение завершается по самой медленной части' : 'The last partition sets the scan floor'}
  caption={ru
    ? 'У каждого исполнителя свой источник чтения с пределом ' + diskGBps + ' ГБ/с. При тех же 600 ГБ общая нижняя граница вырастает со 150 до 240 с из-за одной более крупной части.'
    : 'Each worker has an independent input with a ' + diskGBps + ' GB/s ceiling. One larger partition raises the combined read floor from 150 s to 240 s for the same 600 GB.'}>
  <svg class="fig-compact" viewBox="0 0 380 282" role="img" aria-labelledby={id + '-title ' + id + '-desc'}>
    <title id={id + '-title'}>{ru ? 'Сравнение равномерного и неравномерного распределения данных' : 'Even and uneven distributions of input data'}</title>
    <desc id={id + '-desc'}>{ru
      ? 'При равномерном распределении каждый из четырёх исполнителей читает по 150 ГБ. При неравномерном один читает 240 ГБ, а остальные по 120 ГБ.'
      : 'Four workers read 150 GB each with equal partitions. In the uneven case one reads 240 GB and the others read 120 GB each.'}</desc>
    {groups.map((group, index) => {
      const y = 20 + 137 * index;
      const floor = Math.max(...group.data);
      return <>
        <text class="f-title" x="8" y={y}>{group.title}</text>
        <text class="f-label f-t-blue" x="371" y={y} text-anchor="end">{'≥ ' + readSeconds(floor) + ' ' + sec}</text>
        {group.data.map((part, worker) => {
          const row = y + 12 + 27 * worker;
          const longest = part === floor;
          return <>
            <text class="f-label" x="8" y={row + 15}>{(ru ? 'Узел ' : 'Node ') + (worker + 1)}</text>
            <rect class={longest ? 'f-fill-blue' : 'f-fill-green'} x={x} y={row} width={part * scale} height="20" rx="3" />
            <path class={longest ? 'f-line f-bold f-blue' : 'f-line f-bold f-green'} d={'M ' + x + ' ' + (row + 10) + ' h ' + (part * scale)} />
            <text class="f-label" x="371" y={row + 15} text-anchor="end">{part + ' ' + gb}</text>
          </>;
        })}
      </>;
    })}
  </svg>
</Figure>
