---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The Code section of the note: a Bayesian mixture of K = 8 unit-variance Gaussians in 2-D, N = 200,000 points,
// prior N(0, 10² I) on each mean, the same start for both methods. The gap is the batch optimum (the ELBO per point
// after 30 batch passes, −4.7142) minus the current ELBO per point, with every local parameter at its optimum.
// Batch coordinate ascent after passes 1–12 (later passes are below 10⁻⁶); SVI with B = 100, ρₜ = (t + 1)^(−0.7).
const batch: [number, number][] = [[1, 0.947], [2, 0.513], [3, 0.176], [4, 0.015], [5, 0.00189], [6, 0.000478], [7, 0.000169], [8, 6.8e-5], [9, 2.83e-5], [10, 1.19e-5], [11, 5.01e-6], [12, 2.11e-6]];
const svi: [number, number][] = [[0.01, 0.0123], [0.02, 0.00314], [0.03, 0.00282], [0.04, 0.00229], [0.05, 0.00127], [0.06, 0.0013], [0.07, 0.00102], [0.08, 0.000395], [0.09, 0.00102], [0.1, 0.00112], [0.15, 0.000721], [0.2, 0.000308], [0.25, 0.00011], [0.3, 0.000123], [0.35, 0.000256], [0.4, 0.000357], [0.45, 0.000189], [0.5, 0.000299], [0.55, 0.0004], [0.6, 0.000134], [0.65, 0.000154], [0.7, 5.68e-5], [0.75, 0.000216], [0.8, 0.000307], [0.85, 0.000149], [0.9, 0.000144], [0.95, 0.000227], [1.0, 0.00031], [1.05, 0.000382], [1.1, 0.000257], [1.15, 0.000224], [1.2, 0.000206], [1.25, 0.000197], [1.3, 0.000151], [1.35, 0.000121], [1.4, 0.00014], [1.45, 0.000182], [1.5, 7.56e-5], [1.55, 9.55e-5], [1.6, 0.000117], [1.65, 0.000108], [1.7, 0.000144], [1.75, 0.000256], [1.8, 0.000153], [1.85, 9.4e-5], [1.9, 6.44e-5], [1.95, 7.66e-5], [2.0, 0.000113]];
const first = (s: [number, number][], tol: number) => s.find(([, g]) => g <= tol)![0];
const chk = [first(batch, 0.01), first(batch, 0.001), first(svi, 0.01), first(svi, 0.001), Math.min(...svi.map((p) => p[1])).toExponential(1)].join(' ');
if (chk !== '5 6 0.02 0.08 5.7e-5') throw new Error(`ElboGap: the run drifted from the note (${chk})`);

const t = ru
  ? { title: 'Сколько проходов по данным нужно до заданного значения ELBO', x: 'проходы по данным (лог. шкала)', y: 'отставание ELBO, нат на точку',
      batch: 'пакетный координатный подъём', svi: 'SVI, B = 100, κ = 0.7',
      desc: 'Отставание ELBO на точку от пакетного оптимума в зависимости от числа проходов по данным, обе оси логарифмические. Пакетный координатный подъём: 0.95 после первого прохода, 0.015 после четвёртого, 0.0019 после пятого, 0.00048 после шестого и 2·10⁻⁶ после двенадцатого. SVI с мини-батчами по 100 точек: 0.012 через сотую часть прохода, ниже 0.001 через 0.08 прохода, затем колеблется между 6·10⁻⁵ и 4·10⁻⁴ и до 10⁻⁵ за два прохода не опускается.' }
  : { title: 'Passes over the data needed to reach a given ELBO', x: 'passes over the data (log scale)', y: 'ELBO gap, nats per point',
      batch: 'batch coordinate ascent', svi: 'SVI, B = 100, κ = 0.7',
      desc: 'The gap between the ELBO per point and the batch optimum against the number of passes over the data, both axes on a log scale. Batch coordinate ascent: 0.95 after the first pass, 0.015 after the fourth, 0.0019 after the fifth, 0.00048 after the sixth and 2·10⁻⁶ after the twelfth. SVI with mini-batches of 100 points: 0.012 after a hundredth of a pass, below 0.001 after 0.08 passes, then it fluctuates between 6·10⁻⁵ and 4·10⁻⁴ and does not reach 10⁻⁵ in two passes.' };
const id = 'svi-elbo-gap';
const caption = ru
  ? 'Байесовская смесь из 8 гауссиан с единичной дисперсией на плоскости, 200 000 точек, априорное распределение N(0, 10²I) на каждом среднем, одна и та же начальная точка для обоих методов. Проход — N точек, обработанных локальным шагом. Пунктиры — допуски 0.01 и 0.001; отмечены первые точки ниже них: пакетному методу нужно 5 и 6 проходов, SVI — 0.02 и 0.08 прохода, примерно в 75–250 раз меньше. Ниже 10⁻⁴ SVI не пускает шум шага: ρₜ убывает медленно, а пакетный метод, точный на каждом проходе, с девятого прохода опускается ниже всего, чего SVI достигает. Один запуск раздела «Код».'
  : 'A Bayesian mixture of 8 unit-variance Gaussians in the plane, 200,000 points, prior N(0, 10²I) on each mean, the same starting point for both. One pass is N points processed by the local step. The dashed lines are the tolerances 0.01 and 0.001; the first points below them are marked: the batch method needs 5 and 6 passes, SVI 0.02 and 0.08 passes, about 75 to 250 times fewer. Below 10⁻⁴ SVI is held up by the noise of its step: ρₜ decreases slowly, while the batch method, exact at every pass, drops below anything SVI reaches from its ninth pass on. One run of the Code section.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 340, x: [84, 728], y: [30, 250], leg: [[84, 322], [400, 322]] },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 430, x: [62, 340], y: [30, 300], leg: [[16, 392], [16, 416]] },
];
const lx = (v: number) => Math.log10(v), ly = (v: number) => Math.log10(v);
const yt = [1, -1, -3, -5], ys = ['10', '10⁻¹', '10⁻³', '10⁻⁵'];
const xt = [0.01, 0.1, 1, 10], xsLab = ['0.01', '0.1', '1', '10'];
const marks: { p: [number, number]; lab: string; tone: string; dx: number; dy: number }[] = [
  { p: [5, 0.00189], lab: '5', tone: 'blue', dx: 8, dy: -6 }, { p: [6, 0.000478], lab: '6', tone: 'blue', dx: -14, dy: 16 },
  { p: [0.02, 0.00314], lab: '0.02', tone: 'red', dx: -10, dy: 18 }, { p: [0.08, 0.000395], lab: '0.08', tone: 'red', dx: -4, dy: 18 },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sx = scale([lx(0.008), lx(30)], L.x as [number, number]), sy = scale([ly(1e-6), ly(10)], [L.y[1], L.y[0]]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {yt.map((v) => <path class="f-grid" d={`M ${L.x[0]} ${sy(v)} H ${L.x[1]}`} />)}
        {xt.map((v) => <path class="f-grid" d={`M ${sx(lx(v))} ${L.y[0]} V ${L.y[1]}`} />)}
        <path class="f-axis" d={`M ${L.x[0]} ${L.y[0]} V ${L.y[1]} H ${L.x[1]}`} />
        {yt.map((v, i) => <text class="f-note" x={L.x[0] - 7} y={sy(v) + 5} text-anchor="end">{ys[i]}</text>)}
        {xt.map((v, i) => <text class="f-note" x={sx(lx(v))} y={L.y[1] + 19} text-anchor="middle">{xsLab[i]}</text>)}
        <text class="f-small f-t-muted" x={(L.x[0] + L.x[1]) / 2} y={L.y[1] + 40} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.x[0] + 8} y={L.y[0] + 14}>{t.y}</text>
        {[0.01, 0.001].map((v) => (
          <g>
            <path class="f-line f-muted f-dash" d={`M ${L.x[0]} ${sy(ly(v))} H ${L.x[1]}`} />
            <text class="f-small f-t-muted f-halo" x={L.x[1] - 4} y={sy(ly(v)) - 5} text-anchor="end">{v === 0.01 ? '0.01' : '0.001'}</text>
          </g>
        ))}
        <path class="f-line f-red" d={polyline(svi.map(([p, g]) => [sx(lx(p)), sy(ly(g))]))} />
        <path class="f-line f-blue" d={polyline(batch.map(([p, g]) => [sx(lx(p)), sy(ly(g))]))} />
        {batch.map(([p, g]) => <circle cx={sx(lx(p))} cy={sy(ly(g))} r="3.2" class="f-solid-blue" />)}
        {marks.map((m) => (
          <g>
            <circle cx={sx(lx(m.p[0]))} cy={sy(ly(m.p[1]))} r="6" class={`f-line f-${m.tone}`} />
            <text class={`f-small f-t-${m.tone} f-halo`} x={sx(lx(m.p[0])) + m.dx} y={sy(ly(m.p[1])) + m.dy}>{m.lab}</text>
          </g>
        ))}
        <path class="f-line f-blue" d={`M ${L.leg[0][0]} ${L.leg[0][1] - 4} h 26`} />
        <text class="f-small" x={L.leg[0][0] + 34} y={L.leg[0][1]}>{t.batch}</text>
        <path class="f-line f-red" d={`M ${L.leg[1][0]} ${L.leg[1][1] - 4} h 26`} />
        <text class="f-small" x={L.leg[1][0] + 34} y={L.leg[1][1]}>{t.svi}</text>
      </svg>
    );
  })}
</Figure>
