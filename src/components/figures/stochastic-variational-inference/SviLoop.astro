---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Op from '../seqflow/Op.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The worked example of the note: N = 200,000 points, mini-batches of B = 100, prior precision 1/σ0² = 0.01.
// One component k of the Bayesian mixture; q(μ_k) is stored by its precision P and by h = P·m.
// The batch has Σ φ_ik = 12.5 and Σ φ_ik x_i = 40 (first coordinate); step t = 10 with τ = 1, κ = 0.7.
const N = 200000, B = 100, prior = 0.01, sumPhi = 12.5, sumPhiX = 40;
const P0 = 24000, h0 = 72000;
const Ph = prior + (N / B) * sumPhi, hh = (N / B) * sumPhiX;
const rho = (10 + 1) ** -0.7;
const P1 = (1 - rho) * P0 + rho * Ph, h1 = (1 - rho) * h0 + rho * hh;
const chk = [(h0 / P0).toFixed(2), Ph.toFixed(0), (hh / Ph).toFixed(2), rho.toFixed(4), P1.toFixed(0), (h1 / P1).toFixed(3)].join(' ');
if (chk !== '3.00 25000 3.20 0.1866 24187 3.039') throw new Error(`SviLoop: the worked example drifted (${chk})`);
const sp = (v: number) => v.toFixed(0).replace(/\B(?=(\d{3})+(?!\d))/g, ' ');

const t = ru
  ? {
      title: 'Один шаг стохастического вариационного вывода',
      data: 'данные, N = 200 000', dataN: 'данные', dataSub: 'N = 200 000 точек', batch: 'мини-батч S', batchSub: 'B = 100 точек', local: 'локальный шаг φᵢ', localSub: 'Σφ = 12.5, Σφx = 40',
      inter: 'промежуточное λ̂', interSub: `P̂ = ${sp(Ph)}, m̂ = ${(hh / Ph).toFixed(2)}`, old: 'текущее λ, шаг t = 10', oldSub: `P = ${sp(P0)}, m = ${(h0 / P0).toFixed(2)}`,
      blend: '(1 − ρ)λ + ρλ̂', neu: 'новое λ', neuSub: `P = ${sp(P1)}, m = ${(h1 / P1).toFixed(3)}`, loop: 't ← t + 1', scale: '× N/B = 2000',
      steps: ['равновероятно выбрать B из N точек', 'локальный шаг: φᵢ по текущему λ, только для точек батча', 'промежуточное λ̂: как если бы батч встретился N/B раз', 'шаг естественного градиента: смесь λ и λ̂ с весом ρₜ', 'следующий шаг с новым λ и меньшим ρ'],
      desc: 'Слева столбец данных из N = 200 000 точек; из него выбирается мини-батч из B = 100 точек. Локальный шаг вычисляет ответственности φ для точек батча по текущему глобальному параметру λ (обратная дисперсия P = 24 000, среднее m = 3.00): сумма ответственностей компоненты равна 12.5, взвешенная сумма точек — 40. Умножение на N/B = 2000 даёт промежуточный параметр λ̂ с обратной дисперсией 25 000 и средним 3.20. Новый параметр — смесь (1 − ρ)λ + ρλ̂ с ρ = 0.187: обратная дисперсия 24 187, среднее 3.039. Стрелка возвращается к локальному шагу для следующего мини-батча.',
    }
  : {
      title: 'One step of stochastic variational inference',
      data: 'data, N = 200 000', dataN: 'data', dataSub: 'N = 200 000 points', batch: 'mini-batch S', batchSub: 'B = 100 points', local: 'local step φᵢ', localSub: 'Σφ = 12.5, Σφx = 40',
      inter: 'intermediate λ̂', interSub: `P̂ = ${sp(Ph)}, m̂ = ${(hh / Ph).toFixed(2)}`, old: 'current λ, step t = 10', oldSub: `P = ${sp(P0)}, m = ${(h0 / P0).toFixed(2)}`,
      blend: '(1 − ρ)λ + ρλ̂', neu: 'new λ', neuSub: `P = ${sp(P1)}, m = ${(h1 / P1).toFixed(3)}`, loop: 't ← t + 1', scale: '× N/B = 2000',
      steps: ['sample B of the N points uniformly', 'local step: φᵢ from the current λ, for the batch only', 'intermediate λ̂: as if the batch were seen N/B times', 'natural-gradient step: blend λ and λ̂ with weight ρₜ', 'next step with the new λ and a smaller ρ'],
      desc: 'On the left, a column of N = 200,000 data points; a mini-batch of B = 100 points is drawn from it. The local step computes the responsibilities φ of the batch points from the current global parameter λ (precision P = 24,000, mean m = 3.00): the responsibilities of the component sum to 12.5 and the weighted sum of the points is 40. Multiplying by N/B = 2000 gives the intermediate parameter λ̂ with precision 25,000 and mean 3.20. The new parameter is the blend (1 − ρ)λ + ρλ̂ with ρ = 0.187: precision 24,187, mean 3.039. An arrow returns to the local step for the next mini-batch.',
    };
const id = 'svi-loop';
const caption = ru
  ? 'Один шаг SVI для одной компоненты смеси; q(μₖ) хранится обратной дисперсией P и произведением Pm. Статистики батча умножаются на N/B = 2000, к ним добавляется априорная обратная дисперсия 0.01. Шаг ρ₁₀ = 11^(−0.7) смешивает естественные параметры, и среднее сдвигается с 3.00 до 3.039.'
  : 'One SVI step for one component of the mixture; q(μₖ) is stored by its precision P and the product Pm. The batch statistics are multiplied by N/B = 2000, and the prior precision 0.01 is added. The step ρ₁₀ = 11^(−0.7) blends natural parameters, and the mean moves from 3.00 to 3.039.';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 350" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <text class="f-small f-t-muted" x="16" y="40">{t.data}</text>
    <Vec x={30} y={58} values={['x₁', 'x₂', '…', 'x_N']} tone="x" cw={50} />
    <g data-s="1">
      <Arrow pts={[[80, 102], [118, 102]]} />
      <Box x={120} y={80} w={140} h={44} label={t.batch} sub={t.batchSub} tone="x" />
      <Badge x={190} y={64} n={1} />
    </g>
    <g data-s="2 4">
      <Box x={290} y={220} w={180} h={44} label={t.old} sub={t.oldSub} tone="g" />
    </g>
    <g data-s="2">
      <Arrow pts={[[260, 102], [298, 102]]} />
      <Box x={300} y={80} w={160} h={44} label={t.local} sub={t.localSub} tone="h" />
      <Arrow pts={[[380, 220], [380, 127]]} tone="amber" />
      <Badge x={380} y={64} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[460, 102], [508, 102]]} />
      <text class="f-small f-t-muted" x="484" y="72" text-anchor="middle">{t.scale}</text>
      <Box x={510} y={80} w={180} h={44} label={t.inter} sub={t.interSub} tone="y" />
      <Badge x={706} y={102} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[600, 124], [600, 159]]} />
      <Arrow pts={[[470, 242], [510, 242], [510, 174], [534, 174]]} tone="amber" />
      <Op x={600} y={174} sym={t.blend} />
      <text class="f-small f-t-muted" x="670" y="178">{`ρ = ${rho.toFixed(3)}`}</text>
      <Arrow pts={[[600, 187], [600, 214]]} />
      <Box x={530} y={216} w={180} h={44} label={t.neu} sub={t.neuSub} tone="g" />
      <Badge x={726} y={238} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[620, 260], [620, 306], [380, 306], [380, 268]]} tone="amber" dashed />
      <text class="f-small f-t-muted" x="500" y="326" text-anchor="middle">{t.loop}</text>
      <Badge x={500} y={306} n={5} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 572" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <g data-s="2 4">
      <Box x={40} y={20} w={290} h={48} label={t.old} sub={t.oldSub} tone="g" />
    </g>
    <Box x={40} y={100} w={170} h={48} label={t.dataN} sub={t.dataSub} tone="x" />
    <g data-s="1">
      <Arrow pts={[[125, 148], [125, 174]]} />
      <Box x={40} y={176} w={170} h={48} label={t.batch} sub={t.batchSub} tone="x" />
      <Badge x={22} y={200} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[125, 224], [125, 250]]} />
      <Box x={40} y={250} w={210} h={52} label={t.local} sub={t.localSub} tone="h" subGap={20} />
      <Arrow pts={[[300, 68], [300, 276], [253, 276]]} tone="amber" />
      <Badge x={22} y={276} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[125, 300], [125, 334]]} />
      <text class="f-small f-t-muted" x="136" y="322">{t.scale}</text>
      <Box x={40} y={336} w={210} h={48} label={t.inter} sub={t.interSub} tone="y" />
      <Badge x={22} y={360} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[125, 384], [125, 413]]} />
      <Arrow pts={[[300, 276], [300, 426], [192, 426]]} tone="amber" />
      <Op x={125} y={426} sym={t.blend} />
      <text class="f-small f-t-muted" x="216" y="416">{`ρ = ${rho.toFixed(3)}`}</text>
      <Arrow pts={[[125, 439], [125, 466]]} />
      <Box x={40} y={468} w={210} h={48} label={t.neu} sub={t.neuSub} tone="g" />
      <Badge x={22} y={492} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[250, 504], [344, 504], [344, 44], [333, 44]]} tone="amber" dashed />
      <text class="f-small f-t-muted" x="258" y="534">{t.loop}</text>
      <Badge x={300} y={556} n={5} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
