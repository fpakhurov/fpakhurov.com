---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Four ways to arrange K = 4 parallel codebook streams of T frames into autoregressive steps. Each cell (t, k) shows
// the step s at which the code of codebook k at frame t is predicted; cells with the same number are predicted
// together, each without seeing the others. Step formulas follow Copet et al. (2023), §2.2 and Figure 1.
const K = 4, T = 4, T30 = 30 * 50;
type Pattern = { key: string; en: string; ru: string; step: (t: number, k: number) => number; total: (T: number) => number; formula: string };
const patterns: Pattern[] = [
  { key: 'flat', en: 'flattening', ru: 'развёртка', step: (t, k) => (t - 1) * K + k, total: (n) => K * n, formula: 'K·T' },
  { key: 'par', en: 'parallel', ru: 'параллельная', step: (t) => t, total: (n) => n, formula: 'T' },
  { key: 'coarse', en: 'coarse first', ru: 'сначала грубая', step: (t, k) => (k === 1 ? t : T + t), total: (n) => 2 * n, formula: '2T' },
  { key: 'delay', en: 'delay', ru: 'задержка', step: (t, k) => t + k - 1, total: (n) => n + K - 1, formula: 'T + K − 1' },
];
// every pattern must be a partition of the T×K cells into steps 1..S, with each codebook at most once per step
for (const p of patterns) {
  const S = p.total(T);
  const seen = new Map<number, number[]>();
  for (let t = 1; t <= T; t++) for (let k = 1; k <= K; k++) { const s = p.step(t, k); if (s < 1 || s > S) throw new Error(`CodebookPatterns: ${p.key} step out of range`); seen.set(s, [...(seen.get(s) ?? []), k]); }
  if (seen.size !== S) throw new Error(`CodebookPatterns: ${p.key} leaves an empty step`);
  for (const ks of seen.values()) if (new Set(ks).size !== ks.length) throw new Error(`CodebookPatterns: ${p.key} repeats a codebook in one step`);
}
const steps4 = patterns.map((p) => p.total(T)).join(' '), steps30 = patterns.map((p) => p.total(T30)).join(' ');
if (steps4 !== '16 4 8 7' || steps30 !== '6000 1500 3000 1503') throw new Error('CodebookPatterns: step counts drifted from the note');
// the highlighted cell: codebook 3 at frame 3; in the delay pattern codebooks 1 and 2 of the same frame come earlier
const HT = 3, HK = 3;
const delay = patterns[3], par = patterns[1];
if (!(delay.step(HT, 1) < delay.step(HT, HK) && delay.step(HT, 2) < delay.step(HT, HK)) || par.step(HT, 1) !== par.step(HT, HK)) throw new Error('CodebookPatterns: highlight logic');

// Russian plural of «шаг»
const ruSteps = (n: number) => (n % 10 === 1 && n % 100 !== 11 ? 'шаг' : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? 'шага' : 'шагов');
const line1 = (p: Pattern) => (ru ? `${p.total(T)} ${ruSteps(p.total(T))} · ${p.formula}` : `${p.total(T)} steps · ${p.formula}`);
const line2 = (p: Pattern) => (ru ? `30 с: ${p.total(T30)} ${ruSteps(p.total(T30))}` : `30 s: ${p.total(T30)} steps`);
const id = 'audio-generation-codebook-patterns';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 292, c: 32, lab: 26, gap: 38, x0: 15, rows: [[0, 1, 2, 3]], top: 40, rowH: 0, legendY: 258 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 516, c: 30, lab: 26, gap: 32, x0: 14, rows: [[0, 1], [2, 3]], top: 40, rowH: 214, legendY: 462 },
];
type L = (typeof layouts)[number];
const blockX = (L: L, i: number) => { const col = L.rows[0].length === 4 ? i : i % 2; return L.x0 + col * (L.lab + T * L.c + L.gap); };
const blockY = (L: L, i: number) => L.top + (L.rows[0].length === 4 ? 0 : Math.floor(i / 2) * L.rowH);
// the step counts under a grid start at the row labels in the narrow layout, where the grids are wider than their text room
const textX = (L: L, i: number) => blockX(L, i) + (L.sfx === 'w' ? L.lab : 0);
const cellX = (L: L, i: number, t: number) => blockX(L, i) + L.lab + (t - 1) * L.c;
const cellY = (L: L, i: number, k: number) => blockY(L, i) + (K - k) * L.c;
const shade = (p: Pattern, s: number) => 0.07 + (0.43 * (s - 1)) / (p.total(T) - 1);
const cells = (p: Pattern) => { const out: { t: number; k: number; s: number }[] = []; for (let t = 1; t <= T; t++) for (let k = 1; k <= K; k++) out.push({ t, k, s: p.step(t, k) }); return out; };
const isTarget = (i: number, t: number, k: number) => (i === 1 || i === 3) && t === HT && k === HK;
const isContext = (i: number, t: number, k: number) => (i === 1 || i === 3) && t === HT && k !== HK && k !== 4;
const legend = ru
  ? ['число в клетке — шаг генерации, на котором предсказывается этот код;', 'красная рамка — код 3 кадра 3, пунктир — коды того же кадра из словарей 1 и 2']
  : ['the number in a cell is the generation step at which that code is predicted;', 'red frame: codebook 3 of frame 3; dashed: the same frame in codebooks 1 and 2'];
const legendN = ru
  ? ['число — шаг генерации кода;', 'красная рамка: код 3 кадра 3;', 'пунктир: кадр 3, словари 1 и 2']
  : ['number: step at which a code is predicted;', 'red frame: codebook 3 of frame 3;', 'dashed: frame 3, codebooks 1 and 2'];
---

<Figure
  id={id}
  title={ru ? 'Четыре способа уложить четыре потока кодов в шаги генерации' : 'Four ways to lay four code streams out as generation steps'}
  caption={ru
    ? 'Столбцы — кадры кодека t = 1…4 (50 кадров в секунду), строки — словари k = 1…4 (словарь 1 снизу, он самый грубый). В клетке — номер шага, на котором предсказывается код; клетки с одинаковым номером предсказываются вместе, без взаимного учёта. Развёртка точна, но длиннее всех: K·T шагов. Параллельная схема короче всех, T шагов, но четыре кода кадра выбираются независимо. Схема «сначала грубая» генерирует весь словарь 1, затем остальные параллельно, 2T шагов. Задержка сдвигает словарь k на k − 1 шагов: T + K − 1 шагов, и код словаря 3 в кадре 3 (красная рамка, шаг 5) видит коды словарей 1 и 2 того же кадра (пунктир, шаги 3 и 4); в параллельной схеме те же коды выбираются на том же шаге. Строка под сеткой — число шагов для 4 кадров и для 30 секунд (1500 кадров).'
    : 'Columns are codec frames t = 1…4 (50 frames per second), rows are codebooks k = 1…4 (codebook 1, the coarsest, at the bottom). A cell holds the step at which its code is predicted; cells with the same number are predicted together, without seeing each other. Flattening is exact but the longest, K·T steps. The parallel layout is the shortest, T steps, but the four codes of a frame are chosen independently. Coarse first generates all of codebook 1, then the others in parallel, 2T steps. The delay pattern shifts codebook k by k − 1 steps: T + K − 1 steps, and the code of codebook 3 at frame 3 (red frame, step 5) sees codebooks 1 and 2 of the same frame (dashed, steps 3 and 4); in the parallel layout those codes are chosen in the same step. The lines under each grid give the number of steps for 4 frames and for 30 seconds (1500 frames).'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{ru ? 'Схемы укладки кодов' : 'Codebook interleaving patterns'}</title>
      <desc id={`${id}-${L.sfx}-d`}>{ru
        ? 'Четыре сетки 4 на 4: кадры по горизонтали, словари по вертикали, в клетках номера шагов. Развёртка: 1…16 по кадрам. Параллельная: номер шага равен номеру кадра. Сначала грубая: словарь 1 на шагах 1…4, остальные на шагах 5…8. Задержка: номер шага равен t + k − 1, от 1 до 7.'
        : 'Four 4 by 4 grids: frames across, codebooks up, step numbers in the cells. Flattening: 1 to 16, frame by frame. Parallel: the step equals the frame. Coarse first: codebook 1 at steps 1 to 4, the others at steps 5 to 8. Delay: the step equals t + k − 1, from 1 to 7.'}</desc>
      {patterns.map((p, i) => (
        <g>
          <text class="f-label" x={blockX(L, i) + L.lab} y={blockY(L, i) - 14}>{ru ? p.ru : p.en}</text>
          {cells(p).map((c) => (
            <g>
              <rect x={cellX(L, i, c.t)} y={cellY(L, i, c.k)} width={L.c} height={L.c} style={`fill: var(--fig-blue); fill-opacity: ${shade(p, c.s).toFixed(3)}; stroke: var(--line); stroke-width: 1`} />
              <text class="f-small" x={cellX(L, i, c.t) + L.c / 2} y={cellY(L, i, c.k) + L.c / 2 + 4.5} text-anchor="middle">{c.s}</text>
              {isTarget(i, c.t, c.k) && <rect x={cellX(L, i, c.t) + 1.5} y={cellY(L, i, c.k) + 1.5} width={L.c - 3} height={L.c - 3} style="fill: none; stroke: var(--fig-red); stroke-width: 2.2" />}
              {isContext(i, c.t, c.k) && <rect class={i === 3 ? 'f-red' : 'f-muted'} x={cellX(L, i, c.t) + 2.5} y={cellY(L, i, c.k) + 2.5} width={L.c - 5} height={L.c - 5} style="fill: none; stroke-width: 1.6; stroke-dasharray: 4 3" />}
            </g>
          ))}
          {[1, 2, 3, 4].map((k) => <text class="f-small f-t-muted" x={blockX(L, i) + L.lab - 5} y={cellY(L, i, k) + L.c / 2 + 4.5} text-anchor="end">{`k${k}`}</text>)}
          {[1, 2, 3, 4].map((t) => <text class="f-small f-t-muted" x={cellX(L, i, t) + L.c / 2} y={blockY(L, i) + K * L.c + 16} text-anchor="middle">{`t${t}`}</text>)}
          <text class="f-small" x={textX(L, i)} y={blockY(L, i) + K * L.c + 38}>{line1(p)}</text>
          <text class="f-small f-t-muted" x={textX(L, i)} y={blockY(L, i) + K * L.c + 57}>{line2(p)}</text>
        </g>
      ))}
      {(L.sfx === 'w' ? legend : legendN).map((s, j) => <text class="f-small f-t-muted" x={L.x0} y={L.legendY + j * 19}>{s}</text>)}
    </svg>
  ))}
</Figure>
