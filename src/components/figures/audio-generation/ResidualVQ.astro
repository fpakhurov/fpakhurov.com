---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { mulberry32, normal } from '../random';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Residual vector quantization of a 2-D toy cloud, computed at build time: 160 seeded points, three codebooks of
// four vectors each, every codebook fitted by k-means to the residuals the previous stages leave. Colour roles of the
// sequence-model figures: inputs green, residuals carried to the next stage blue, codebook vectors amber, the
// reconstruction red.
type P = [number, number];
const N = 160, SEED = 2, M = 4, STAGES = 3, TRACK = 97;
const rand = mulberry32(SEED);
const g = normal(rand);
const data: P[] = [];
for (let i = 0; i < N; i++) {
  const x = g();
  const y = g();
  const u = 1.6 * x, v = 0.8 * y;
  data.push([0.8 * u - 0.6 * v, 0.6 * u + 0.8 * v]);
}
const d2 = (p: P, q: P) => { const dx = p[0] - q[0], dy = p[1] - q[1]; return dx * dx + dy * dy; };
const nearest = (p: P, cb: P[]) => { let best = 0, bd = d2(p, cb[0]); for (let k = 1; k < cb.length; k++) { const d = d2(p, cb[k]); if (d < bd) { best = k; bd = d; } } return best; };
function kmeans(pts: P[], m: number, iters = 100): P[] {
  const n = pts.length;
  let mx = 0, my = 0;
  for (const p of pts) { mx += p[0]; my += p[1]; }
  const mean: P = [mx / n, my / n];
  let first = 0;
  for (let i = 1; i < n; i++) if (d2(pts[i], mean) > d2(pts[first], mean)) first = i;
  let cb: P[] = [pts[first]];
  while (cb.length < m) {
    let far = 0, fd = -1;
    for (let i = 0; i < n; i++) { const d = Math.min(...cb.map((c) => d2(pts[i], c))); if (d > fd) { far = i; fd = d; } }
    cb.push(pts[far]);
  }
  let assign: number[] = new Array(n).fill(-1);
  for (let it = 0; it < iters; it++) {
    const next = pts.map((p) => nearest(p, cb));
    if (next.every((a, i) => a === assign[i])) break;
    assign = next;
    cb = cb.map((old, k) => {
      let sx = 0, sy = 0, c = 0;
      for (let i = 0; i < n; i++) if (assign[i] === k) { sx += pts[i][0]; sy += pts[i][1]; c++; }
      return c ? [sx / c, sy / c] as P : old;
    });
  }
  return cb;
}
const mse = (pts: P[]) => { let t = 0; for (const p of pts) t += p[0] * p[0] + p[1] * p[1]; return t / pts.length / 2; };

const inputs: P[][] = [data];
const books: P[][] = [];
const errs = [mse(data)];
for (let s = 0; s < STAGES; s++) {
  const cb = kmeans(inputs[s], M);
  books.push(cb);
  const next = inputs[s].map((p) => { const e = cb[nearest(p, cb)]; return [p[0] - e[0], p[1] - e[1]] as P; });
  inputs.push(next);
  errs.push(mse(next));
}
// the tracked vector through the three stages
const track = inputs.slice(0, STAGES).map((pts, s) => {
  const p = pts[TRACK], k = nearest(p, books[s]), e = books[s][k];
  return { p, k, e, r: [p[0] - e[0], p[1] - e[1]] as P };
});
const zhat: P = [track.reduce((a, t) => a + t.e[0], 0), track.reduce((a, t) => a + t.e[1], 0)];
const f2 = (v: number) => (Math.abs(v) < 0.005 ? '0.00' : v.toFixed(2)).replace('-', '−');
const f3 = (v: number) => v.toFixed(3).replace('-', '−');
const pt = (p: P) => `(${f2(p[0])}, ${f2(p[1])})`;
const sq = (p: P) => (p[0] * p[0] + p[1] * p[1]).toFixed(2);
// numbers quoted in the caption and in the note
const quoted = { errs: errs.map((e) => e.toFixed(3)).join(' '), z: pt(data[TRACK]), codes: track.map((t) => t.k + 1).join(','), norms: [sq(data[TRACK]), ...track.map((t) => sq(t.r))].join(' '), zhat: pt(zhat) };
if (quoted.errs !== '1.396 0.394 0.137 0.051' || quoted.z !== '(2.67, 0.93)' || quoted.codes !== '2,1,4' || quoted.norms !== '8.01 1.66 0.51 0.11' || quoted.zhat !== '(2.39, 0.76)')
  throw new Error(`ResidualVQ: numbers drifted from the note: ${JSON.stringify(quoted)}`);
if (f3(books[0][1][0]) !== '1.423' || f3(books[1][0][1]) !== '−0.524' || f3(books[2][3][0]) !== '0.405') throw new Error('ResidualVQ: codebooks drifted from the note');

const sup = ['⁽¹⁾', '⁽²⁾', '⁽³⁾'];
const t = ru
  ? {
      title: 'Остаточное квантование: три словаря по четыре вектора',
      stage: (s: number) => `этап ${s + 1}: словарь ${s + 1}`, book: (s: number) => `словарь ${s + 1}`,
      input: (s: number) => `${s === 0 ? 'z' : `r${sup[s - 1]}`} = ${pt(track[s].p)} → код ${track[s].k + 1}`, code: (s: number) => `→ код ${track[s].k + 1}`,
      pick: (s: number) => `e${sup[s]} = ${pt(track[s].e)}`,
      rest: (s: number) => `‖r${sup[s]}‖² = ${sq(track[s].r)}`,
      sum: `ẑ = e⁽¹⁾ + e⁽²⁾ + e⁽³⁾ = ${pt(zhat)}`, zline: `z = ${pt(data[TRACK])}`, bits: '3 кода × 2 бита = 6 бит',
      err: 'ошибка на координату по 160 точкам', nbooks: (k: number) => `${k} ${k === 1 ? 'словарь' : k === 0 ? 'словарей' : 'словаря'}`,
      steps: [
        'словарь 1 (k-means по точкам) выбирает ближайший к z вектор e⁽¹⁾; остаток r⁽¹⁾ = z − e⁽¹⁾',
        'словарь 2 обучен на остатках r⁽¹⁾ и кодирует остаток вектора z, а не сам z',
        'словарь 3 кодирует то, что осталось после двух этапов; остаток снова меньше',
        'декодер складывает выбранные векторы: ẑ = e⁽¹⁾ + e⁽²⁾ + e⁽³⁾; ошибка падает с каждым словарём',
      ],
    }
  : {
      title: 'Residual quantization: three codebooks of four vectors',
      stage: (s: number) => `stage ${s + 1}: codebook ${s + 1}`, book: (s: number) => `codebook ${s + 1}`,
      input: (s: number) => `${s === 0 ? 'z' : `r${sup[s - 1]}`} = ${pt(track[s].p)} → code ${track[s].k + 1}`, code: (s: number) => `→ code ${track[s].k + 1}`,
      pick: (s: number) => `e${sup[s]} = ${pt(track[s].e)}`,
      rest: (s: number) => `‖r${sup[s]}‖² = ${sq(track[s].r)}`,
      sum: `ẑ = e⁽¹⁾ + e⁽²⁾ + e⁽³⁾ = ${pt(zhat)}`, zline: `z = ${pt(data[TRACK])}`, bits: '3 codes × 2 bits = 6 bits',
      err: 'error per coordinate over the 160 points', nbooks: (k: number) => `${k} book${k === 1 ? '' : 's'}`,
      steps: [
        'codebook 1 (k-means on the points) picks the vector e⁽¹⁾ nearest to z; the residual is r⁽¹⁾ = z − e⁽¹⁾',
        'codebook 2 was fitted to the residuals r⁽¹⁾ and encodes what is left of z, not z itself',
        'codebook 3 encodes what two stages left; the residual shrinks again',
        'the decoder adds the chosen vectors, ẑ = e⁽¹⁾ + e⁽²⁾ + e⁽³⁾; the error falls with every codebook',
      ],
    };
const id = 'audio-generation-residual-vq';
const ranges = [3.5, 2, 1.5];
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 470, size: 210, px: [20, 275, 530], py: [46, 46, 46], lines: 282, bars: { x: 470, y: 380, w: 200, h: 15 }, sumX: 20, sumY: 388, wide: true },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 560, size: 156, px: [16, 192, 16], py: [46, 46, 330], lines: 0, bars: { x: 222, y: 366, w: 84, h: 16 }, sumX: 198, sumY: 484, wide: false },
];
type L = (typeof layouts)[number];
const panel = (L: L, s: number) => {
  const x0 = L.px[s], y0 = L.py[s], R = ranges[s];
  return { x0, y0, R, sx: scale([-R, R], [x0, x0 + L.size]), sy: scale([-R, R], [y0 + L.size, y0]) };
};
const lineY = (L: L, s: number, k: number) => (L.wide ? L.lines : L.py[s] + L.size + 20) + k * (L.wide ? 19 : 20);
const barW = (L: L, k: number) => (errs[k] / errs[0]) * L.bars.w;
const ptTone = (s: number) => (s === 0 ? 'green' : 'blue');
// labels of the tracked point go to its left when it sits in the right half of a panel
// the index of the chosen codebook vector goes on the side away from the residual arrow
const idxAt = (L: L, s: number, k: number) => {
  const P0 = panel(L, s), e = books[s][k], chosen = k === track[s].k;
  const away = chosen && P0.sx(track[s].p[0]) > P0.sx(e[0]);
  return { x: P0.sx(e[0]) + (away ? -8 : 8), y: P0.sy(e[1]) - 6, anchor: away ? 'end' : 'start' };
};
const arrowEnd = (from: P, to: P, back: number): P => { const dx = to[0] - from[0], dy = to[1] - from[1], len = Math.hypot(dx, dy) || 1; return [to[0] - (dx / len) * back, to[1] - (dy / len) * back]; };
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? `Игрушечный пример: 160 точек двумерного облака (зелёные) и три словаря по M = 4 вектора (жёлтые), каждый подобран k-means к остаткам предыдущих этапов (синие; панели 2 и 3 увеличены до ±2 и ±1.5). Выделенная точка z = ${pt(data[TRACK])}: коды (${quoted.codes.replace(/,/g, ', ')}), восстановление ẑ = ${pt(zhat)} (красный крест), 2 бита на словарь.`
    : `A toy: 160 points of a 2-D cloud (green) and three codebooks of M = 4 vectors (amber), each fitted by k-means to the previous residuals (blue, panels 2 and 3 magnified to ±2 and ±1.5). Follow z = ${pt(data[TRACK])}: codes (${quoted.codes.replace(/,/g, ', ')}), reconstruction ẑ = ${pt(zhat)} (red cross), 2 bits per codebook.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${L.sfx}-d`}>{ru
        ? `Три панели. В первой облако из 160 точек и четыре вектора словаря 1; стрелка от ближайшего к z вектора словаря к самому z — остаток. Во второй и третьей — облака остатков в увеличенном масштабе и словари 2 и 3. Внизу сумма выбранных векторов ${pt(zhat)} против z = ${pt(data[TRACK])} и полосы ошибки ${errs.map((e) => e.toFixed(2)).join(', ')} после 0, 1, 2 и 3 словарей.`
        : `Three panels. The first shows a cloud of 160 points and the four vectors of codebook 1; an arrow from the codebook vector nearest to z to z itself is the residual. The second and third show the residual clouds, magnified, with codebooks 2 and 3. Below, the sum of the chosen vectors ${pt(zhat)} against z = ${pt(data[TRACK])}, and error bars ${errs.map((e) => e.toFixed(2)).join(', ')} after 0, 1, 2 and 3 codebooks.`}</desc>
      {[0, 1, 2].map((s) => {
        const P0 = panel(L, s);
        const tr = track[s];
        const cx = P0.sx(tr.p[0]), cy = P0.sy(tr.p[1]), ex = P0.sx(tr.e[0]), ey = P0.sy(tr.e[1]);
        const tip = arrowEnd([ex, ey], [cx, cy], 6);
        return (
          <g>
            <rect class="f-box-soft" x={P0.x0} y={P0.y0} width={L.size} height={L.size} />
            <path class="f-thin f-muted f-dot" d={`M ${P0.x0} ${P0.sy(0)} H ${P0.x0 + L.size} M ${P0.sx(0)} ${P0.y0} V ${P0.y0 + L.size}`} />
            <text class="f-small f-t-muted" x={P0.x0 + L.size - 4} y={P0.y0 + L.size - 6} text-anchor="end">{`±${P0.R}`}</text>
            <text class="f-small" x={P0.x0 + 24} y={P0.y0 - 12}>{L.wide ? t.stage(s) : t.book(s)}</text>
            <Badge x={P0.x0 + 9} y={P0.y0 - 16} n={s + 1} />
            <g data-s={s + 1}>
              {inputs[s].map((p) => <circle cx={P0.sx(p[0])} cy={P0.sy(p[1])} r={L.wide ? 2.3 : 2} style={`fill: var(--fig-${ptTone(s)}); opacity: 0.45`} />)}
              <path class="f-line f-blue" d={`M ${ex} ${ey} L ${tip[0]} ${tip[1]}`} marker-end="url(#f-arrow-blue)" />
              {books[s].map((e, k) => (
                <g>
                  <rect x={P0.sx(e[0]) - 5} y={P0.sy(e[1]) - 5} width="10" height="10" rx="1.5" style="fill: var(--fig-amber); stroke: var(--paper); stroke-width: 1" />
                  <text class="f-small f-t-amber f-halo" x={idxAt(L, s, k).x} y={idxAt(L, s, k).y} text-anchor={idxAt(L, s, k).anchor}>{`${k + 1}`}</text>
                </g>
              ))}
              <circle cx={cx} cy={cy} r="4.6" style={`fill: var(--fig-${ptTone(s)}); stroke: var(--paper); stroke-width: 1.4`} />
              <text class="f-small" x={P0.x0} y={lineY(L, s, 0)}>{L.wide ? t.input(s) : t.code(s)}</text>
              <text class="f-small" x={P0.x0} y={lineY(L, s, 1)}>{t.pick(s)}</text>
              <text class="f-small f-t-blue" x={P0.x0} y={lineY(L, s, 2)}>{t.rest(s)}</text>
            </g>
          </g>
        );
      })}
      <g data-s="4">
        {(() => {
          const P0 = panel(L, 0);
          const hx = P0.sx(zhat[0]), hy = P0.sy(zhat[1]);
          return <path class="f-line f-red" d={`M ${hx - 5} ${hy - 5} L ${hx + 5} ${hy + 5} M ${hx - 5} ${hy + 5} L ${hx + 5} ${hy - 5}`} style="stroke-width: 2.2" />;
        })()}
        {L.wide && (
          <g>
            <text class="f-small f-t-red" x={L.sumX + 24} y={L.sumY}>{t.sum}</text>
            <text class="f-small" x={L.sumX + 24} y={L.sumY + 20}>{t.zline}</text>
            <text class="f-small f-t-muted" x={L.sumX + 24} y={L.sumY + 40}>{t.bits}</text>
            <Badge x={L.sumX + 9} y={L.sumY - 4} n={4} />
          </g>
        )}
        {!L.wide && <Badge x={L.px[1] + 9} y={L.bars.y - 30} n={4} />}
        <text class="f-small f-t-muted" x={L.wide ? L.bars.x - 60 : L.px[1] + 24} y={L.bars.y - 22}>{L.wide ? t.err : (ru ? 'ошибка' : 'error')}</text>
        {errs.map((e, k) => (
          <g>
            <text class="f-small f-t-muted" x={L.bars.x - 6} y={L.bars.y + k * (L.bars.h + 7) + L.bars.h - 3} text-anchor="end">{L.wide ? t.nbooks(k) : `${k}`}</text>
            <rect x={L.bars.x} y={L.bars.y + k * (L.bars.h + 7)} width={Math.max(barW(L, k), 1.5)} height={L.bars.h} rx="2" style={`fill: var(--fig-${k === 0 ? 'green' : 'blue'}); fill-opacity: 0.5`} />
            <text class="f-small" x={L.bars.x + Math.max(barW(L, k), 1.5) + 6} y={L.bars.y + k * (L.bars.h + 7) + L.bars.h - 3}>{e.toFixed(2)}</text>
          </g>
        ))}
        {!L.wide && (
          <g>
            <text class="f-small f-t-red" x={L.sumX} y={L.sumY}>{`ẑ = ${pt(zhat)}`}</text>
            <text class="f-small" x={L.sumX} y={L.sumY + 21}>{t.zline}</text>
            <text class="f-small f-t-muted" x={L.sumX} y={L.sumY + 42}>{ru ? '3 × 2 = 6 бит' : '3 × 2 = 6 bits'}</text>
          </g>
        )}
      </g>
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
