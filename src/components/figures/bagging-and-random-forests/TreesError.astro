---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { bagging, forest, B, d, mForest, nTrain, nTest } from './data';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Test error against the number of trees for bagging (30 of 30 features per split) and a random forest
// (5 of 30), and the forest's out-of-bag error; two Gaussian classes in 30 dimensions (see data.ts).
const nums = [bagging.testErr[0], forest.testErr[0], bagging.testErr[B - 1], forest.testErr[B - 1], forest.oobErr[B - 1]].map((v) => v.toFixed(3)).join(' ');
if (nums !== '0.320 0.395 0.179 0.149 0.157' || mForest !== 5 || d !== 30 || nTest !== 2000) throw new Error(`TreesError: numbers drifted from the caption (${nums})`);
const t = ru
  ? { x: 'число деревьев B', y: 'доля ошибок', bag: 'бэггинг (30 признаков)', rf: 'лес (5 признаков)', oob: 'лес, out-of-bag' }
  : { x: 'number of trees B', y: 'error rate', bag: 'bagging (30 features)', rf: 'forest (5 features)', oob: 'forest, out-of-bag' };
const id = 'trees-error';
const layouts = [
  { cls: 'fig-wide', W: 640, H: 290, x0: 56, x1: 400, y0: 20, y1: 240, lx: 410 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 380, x0: 50, x1: 340, y0: 20, y1: 240, lx: 50 },
];
const series = [
  { v: bagging.testErr, cls: 'f-line f-blue', tone: 'f-t-blue', label: t.bag },
  { v: forest.testErr, cls: 'f-line f-red', tone: 'f-t-red', label: t.rf },
  { v: forest.oobErr, cls: 'f-thin f-red f-dash', tone: 'f-t-red', label: t.oob },
];
---

<Figure
  id={id}
  title={ru ? 'Ошибка ансамбля и число деревьев' : 'Ensemble error against the number of trees'}
  caption={ru
    ? `Два гауссовских класса в 30 измерениях, ${nTrain} обучающих точек, ошибка на 2000 новых точках. Одно дерево ошибается в 32% (бэггинг) и 39.5% (лес) случаев: дерево леса хуже, потому что в каждом узле видит только 5 случайных признаков из 30. Но деревья леса меньше коррелированы, и их среднее уходит ниже: после ${B} деревьев 17.9% у бэггинга и 14.9% у леса. Обе кривые выходят на полку, а не растут: добавление деревьев не переобучает. Ошибка out-of-bag (пунктир), посчитанная по одной обучающей выборке, — 15.7%.`
    : `Two Gaussian classes in 30 dimensions, ${nTrain} training points, error on 2,000 new points. A single tree errs on 32% (bagging) and 39.5% (forest) of the points: the forest's tree is worse, because at every node it sees only 5 random features of 30. But the forest's trees are less correlated, and their average goes lower: after ${B} trees, 17.9% for bagging and 14.9% for the forest. Both curves level off instead of rising: adding trees does not overfit. The out-of-bag error (dashed), computed from the training set alone, is 15.7%.`}
>
  {layouts.map((L) => {
    const sx = scale([1, B], [L.x0, L.x1]), sy = scale([0.1, 0.42], [L.y1, L.y0]);
    const ends = series.map((s) => sy(s.v[B - 1]));
    const labelY = L.lx === L.x0 ? [L.y1 + 62, L.y1 + 84, L.y1 + 106] : [ends[0] + 4, ends[0] + 34, ends[0] + 19];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Кривые ошибки бэггинга и леса' : 'Error curves of bagging and a forest'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Обе кривые быстро падают и выходят на полку; кривая леса начинается выше, но заканчивается ниже; пунктир out-of-bag идёт рядом с кривой леса.' : 'Both curves fall quickly and level off; the forest curve starts higher but ends lower; the dashed out-of-bag curve runs close to the forest curve.'}</desc>
        <path class="f-axis" d={`M ${L.x0} ${L.y0} V ${L.y1} H ${L.x1}`} />
        {[0.1, 0.2, 0.3, 0.4].map((v) => <g><path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} /><text class="f-note" x={L.x0 - 6} y={sy(v) + 4} text-anchor="end">{v.toFixed(1)}</text></g>)}
        {[1, 50, 100, 150].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 16} text-anchor="middle">{v}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 36} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.x0 + 6} y={L.y0 + 4}>{t.y}</text>
        {series.map((s) => <path class={s.cls} d={polyline(s.v.map((v, i) => [sx(i + 1), sy(v)]))} />)}
        {series.map((s, k) => (L.lx === L.x0
          ? <g><path class={s.cls} d={`M ${L.x0} ${labelY[k] - 4} h 22`} /><text class={`f-small ${s.tone}`} x={L.x0 + 30} y={labelY[k]}>{`${s.label}: ${(s.v[B - 1] * 100).toFixed(1)}%`}</text></g>
          : <text class={`f-small ${s.tone}`} x={L.lx} y={labelY[k]}>{`${s.label}: ${(s.v[B - 1] * 100).toFixed(1)}%`}</text>))}
      </svg>
    );
  })}
</Figure>
