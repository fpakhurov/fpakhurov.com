---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// (a) P(k | tea) / P(k | coffee) measured on the Quora questions with a 10-word window and 1/d weighting (see the Code
// section of the note); (b) the GloVe weighting function with x_max = 100 and alpha = 3/4.
const ratios = [
  { k: 'green', r: 12.15 }, { k: 'milk', r: 2.03 }, { k: 'india', r: 1.16 }, { k: 'drink', r: 1.0 }, { k: 'cup', r: 0.366 }, { k: 'starbucks', r: 0.129 },
];
const f = (x: number) => Math.min(1, (x / 100) ** 0.75);
const marks = [1, 10, 50, 100];
if (marks.map((x) => f(x).toFixed(3)).join() !== '0.032,0.178,0.595,1.000') throw new Error('RatiosAndWeights: weights drifted from the note');
const t = ru
  ? { a: '(а) P(k | tea) / P(k | coffee), Quora', b: '(б) вес пары f(X) при xₘₐₓ = 100, α = 3/4', tea: 'про чай', coffee: 'про кофе', both: 'общее или ни при чём' }
  : { a: '(a) P(k | tea) / P(k | coffee), Quora', b: '(b) pair weight f(X), xₘₐₓ = 100, α = 3/4', tea: 'tea-specific', coffee: 'coffee-specific', both: 'shared or unrelated' };
const id = 'glove-ratios-weights';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 300, pa: [0, 0], pb: [400, 0] },
  { cls: 'fig-narrow seq-narrow', W: 380, H: 620, pa: [0, 0], pb: [0, 320] },
];
const sx = scale([Math.log10(0.1), Math.log10(20)], [110, 360]);
const fx = scale([0, 3], [40, 330]), fy = scale([0, 1.05], [240, 40]);
---

<Figure
  id={id}
  title={ru ? 'Отношения вероятностей и вес пар в GloVe' : 'Probability ratios and pair weights in GloVe'}
  caption={ru
    ? '(а) Отношение вероятностей встретить контекстное слово k рядом с tea и рядом с coffee в вопросах Quora, логарифмическая шкала. Слова, связанные только с чаем, дают отношение много больше 1 (green, 12.2), только с кофе — много меньше 1 (starbucks, 0.129), а общие (drink) и посторонние (india) — около 1. По отдельности ни P(k | tea), ни P(k | coffee) так чётко не разделяют эти случаи. (б) Вес пары в функции потерь GloVe: редкие пары с маленьким X учитываются слабо (0.032 при X = 1, 0.178 при X = 10), а начиная с X = 100 вес равен 1, так что частые пары не доминируют.'
    : '(a) The ratio of the probabilities of finding context word k near tea and near coffee in the Quora questions, on a logarithmic scale. Words tied to tea alone give a ratio far above 1 (green, 12.2), words tied to coffee alone far below 1 (starbucks, 0.129), and shared (drink) or unrelated (india) words about 1. Neither P(k | tea) nor P(k | coffee) on its own separates these cases so cleanly. (b) The weight of a pair in the GloVe loss: rare pairs with a small X count little (0.032 at X = 1, 0.178 at X = 10), and from X = 100 on the weight is 1, so frequent pairs do not dominate.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Отношения для tea и coffee и функция веса' : 'Ratios for tea and coffee, and the weighting function'}</title>
      <desc id={`${id}-${L.W}-d`}>{ratios.map((r) => `${r.k}: ${r.r}`).join('; ')}. f(1) = 0.032, f(10) = 0.178, f(50) = 0.595, f(100) = 1.</desc>
      <g transform={`translate(${L.pa[0]} ${L.pa[1]})`}>
        <text class="f-small f-t-muted" x="8" y="18">{t.a}</text>
        <path class="f-thin f-muted" d={`M ${sx(0)} 34 V 262`} />
        {[0.1, 1, 10].map((v) => <text class="f-note" x={sx(Math.log10(v))} y="282" text-anchor="middle">{v}</text>)}
        {ratios.map((r, i) => {
          const y = 44 + i * 36, x1 = sx(Math.log10(r.r)), x0 = sx(0);
          const tone = r.r > 1.5 ? 'green' : r.r < 0.67 ? 'amber' : 'blue';
          return (
            <g>
              <text class="f-small" x="100" y={y + 15} text-anchor="end">{r.k}</text>
              <rect x={Math.min(x0, x1)} y={y} width={Math.max(2, Math.abs(x1 - x0))} height="20" rx="3" style={`fill: var(--fig-${tone}); fill-opacity: 0.45`} />
              <text class="f-small" x={r.r >= 1 ? Math.max(x0, x1) + 6 : x0 + 6} y={y + 15} text-anchor="start">{r.r.toFixed(r.r < 1 ? 3 : 2)}</text>
            </g>
          );
        })}
        <text class="f-small f-t-green" x={sx(Math.log10(20))} y="34" text-anchor="end">{t.tea} →</text>
        <text class="f-small f-t-amber" x="112" y="34">← {t.coffee}</text>
      </g>
      <g transform={`translate(${L.pb[0]} ${L.pb[1]})`}>
        <text class="f-small f-t-muted" x="8" y="18">{t.b}</text>
        <path class="f-axis" d={`M ${fx(0)} ${fy(0)} H ${fx(3) + 6}`} />
        <path class="f-axis" d={`M ${fx(0)} ${fy(0)} V ${fy(1.05)}`} />
        {[1, 10, 100, 1000].map((v) => <text class="f-note" x={fx(Math.log10(v))} y={fy(0) + 20} text-anchor="middle">{v}</text>)}
        {[0, 0.5, 1].map((v) => <text class="f-note" x={fx(0) - 8} y={fy(v) + 4} text-anchor="end">{v}</text>)}
        <text class="f-small f-t-muted" x={fx(3)} y={fy(0) + 38} text-anchor="end">X</text>
        <path class="f-thin f-muted f-dash" d={`M ${fx(2)} ${fy(0)} V ${fy(1)}`} />
        <path class="f-line f-blue f-bold" d={plot((u) => f(10 ** u), 0, 3, fx, fy, 200)} />
        {marks.slice(0, 3).map((x) => (
          <g>
            <circle cx={fx(Math.log10(x))} cy={fy(f(x))} r="4" class="f-solid-blue" />
            <text class="f-small" x={fx(Math.log10(x)) + 8} y={fy(f(x)) - 6}>{f(x).toFixed(3)}</text>
          </g>
        ))}
        <text class="f-small f-t-muted" x={fx(2) + 6} y={fy(1) + 18}>xₘₐₓ</text>
      </g>
    </svg>
  ))}
</Figure>
