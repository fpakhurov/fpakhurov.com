---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const id = 'sql-conflict-branch';
const ru = pageLang(Astro.url) === 'ru';
const title = ru ? 'Две строки одного INSERT' : 'Two rows of one INSERT';
const branches = [
  { x: 9, key: '(101, 1)', status: ru ? 'Ключ уже есть' : 'Key exists', action: 'DO UPDATE' },
  { x: 170, key: '(103, 1)', status: ru ? 'Новый ключ' : 'New key', action: 'INSERT' },
];
---
<Figure id={id} title={title} caption={ru
  ? 'Обе входные строки содержат количество. Для позиции 101/1 сохранённая строка получает 4. Позиция 103/1 появляется с количеством 2.'
  : 'Each input row contains a quantity. The stored row for 101/1 receives 4. Line 103/1 is inserted with quantity 2.'}>
  <svg class="fig-compact" viewBox="0 0 330 154" role="img" aria-labelledby={id + '-title ' + id + '-desc'}>
    <title id={id + '-title'}>{title}</title>
    <desc id={id + '-desc'}>{ru
      ? 'Конфликт по паре 101, 1 приводит к обновлению. Пара 103, 1 свободна, поэтому строка добавляется.'
      : 'A conflict on the pair 101, 1 leads to an update. The pair 103, 1 is available, so the row is inserted.'}</desc>
    {branches.map(({ x, key, status, action }) => (
      <g>
        <rect x={x} y="4" width="151" height="34" rx="5" class="f-box-soft" />
        <text x={x + 75.5} y="26" text-anchor="middle" class="f-title">{key}</text>
        <path d={'M ' + (x + 75.5) + ' 41 V 58'} class="f-axis" marker-end="url(#f-arrow-muted)" />
        <text x={x + 75.5} y="82" text-anchor="middle">{status}</text>
        <path d={'M ' + (x + 75.5) + ' 90 V 108'} class="f-axis" marker-end="url(#f-arrow-muted)" />
        <rect x={x} y="113" width="151" height="34" rx="5" class="f-box f-green" />
        <text x={x + 75.5} y="135" text-anchor="middle" class="f-title">{action}</text>
      </g>
    ))}
  </svg>
</Figure>
