---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Each family as (attention mask, pretraining objective). Rows are queries, columns are keys.
type Cell = 'self' | 'cross' | 'off';
const n = 5;
const full: Cell[][] = Array.from({ length: n }, () => Array(n).fill('self'));
const causal: Cell[][] = Array.from({ length: n }, (_, i) => Array.from({ length: n }, (_, j) => (j <= i ? 'self' : 'off')));
// Encoder–decoder: 3 source positions, 3 target positions.
const S = 3, T = 3;
const encdec: Cell[][] = Array.from({ length: S + T }, (_, i) => Array.from({ length: S + T }, (_, j) => {
  if (i < S) return j < S ? 'self' : 'off';
  if (j < S) return 'cross';
  return j - S <= i - S ? 'self' : 'off';
}));
const panels = [
  { title: ru ? 'только энкодер' : 'encoder-only', mask: ru ? 'полная маска' : 'full mask', grid: full, obj: ru ? 'MLM' : 'masked tokens', input: 'the [MASK] sat on the', target: 'cat' },
  { title: ru ? 'только декодер' : 'decoder-only', mask: ru ? 'каузальная маска' : 'causal mask', grid: causal, obj: ru ? 'следующий токен' : 'next token', input: 'the cat sat on', target: 'cat sat on the' },
  { title: ru ? 'энкодер–декодер' : 'encoder–decoder', mask: ru ? 'источник 3 + перевод 3' : 'source 3 + target 3', grid: encdec, obj: ru ? 'порча фрагментов' : 'span corruption', input: 'the ⟨X⟩ on the mat', target: '⟨X⟩ cat sat' },
];
const fill: Record<Cell, string> = { self: 'fill: var(--fig-blue); fill-opacity: .55', cross: 'fill: var(--fig-green); fill-opacity: .6', off: 'fill: var(--muted); fill-opacity: .08' };
const words = ru ? { input: 'вход', target: 'цель', self: 'self-attention', cross: 'cross-attention', off: 'закрыто маской', rows: 'строки — запросы, столбцы — ключи' } : { input: 'input', target: 'target', self: 'self-attention', cross: 'cross-attention', off: 'masked', rows: 'rows are queries, columns are keys' };
const id = 'model-families-masks';

interface Layout { cls: string; W: number; H: number; stacked: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 700, H: 300, stacked: false },
  { cls: 'fig-narrow', W: 360, H: 470, stacked: true },
];
const gridPx = 110;
---

<Figure
  id={id}
  title={ru ? 'Три семейства как пары «маска + цель обучения»' : 'Three families as pairs of mask and objective'}
  caption={ru
    ? 'Матрицы показывают, какие позиции (столбцы) может видеть каждая позиция (строка). Энкодер видит всё в обе стороны и предобучается восстанавливать скрытые токены. Декодер видит только себя и прошлое и предобучается предсказывать следующий токен в каждой позиции: целью служит тот же текст, сдвинутый на один. Энкодер–декодер читает источник полной маской, пишет перевод каузальной маской и смотрит из перевода на весь источник через cross-attention (зелёный блок); T5 предобучается восстанавливать фрагменты, заменённые сторожевыми токенами ⟨X⟩. Маска определяет, какой контекст доступен, цель обучения — чему модель учится по нему.'
    : 'Each matrix shows which positions (columns) each position (row) may attend to. The encoder sees everything in both directions and is pretrained to recover hidden tokens. The decoder sees itself and the past only and is pretrained to predict the next token at every position: the target is the same text shifted by one. The encoder–decoder reads the source with a full mask, writes the target with a causal mask, and looks from the target at the whole source through cross-attention (green block); T5 is pretrained to restore spans replaced by sentinel tokens ⟨X⟩. The mask fixes which context is available, the objective what the model learns from it.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Маски внимания и цели обучения трёх семейств' : 'Attention masks and objectives of the three families'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Три матрицы маски. Только энкодер: все клетки 5 на 5 открыты; цель — восстановить cat в «the [MASK] sat on the». Только декодер: открыта нижняя треугольная часть; вход «the cat sat on», цель «cat sat on the». Энкодер–декодер: 6 на 6, источник видит только источник, перевод видит весь источник через cross-attention и свои прошлые позиции; вход «the ⟨X⟩ on the mat», цель «⟨X⟩ cat sat».'
        : 'Three mask matrices. Encoder-only: all 5 by 5 cells open; the objective restores cat in "the [MASK] sat on the". Decoder-only: the lower triangle open; input "the cat sat on", target "cat sat on the". Encoder–decoder: 6 by 6, the source sees only the source, the target sees the whole source through cross-attention and its own past; input "the ⟨X⟩ on the mat", target "⟨X⟩ cat sat".'}</desc>
      {panels.map((p, pi) => {
        const px = L.stacked ? 8 : 12 + pi * 232;
        const py = L.stacked ? 10 + pi * 138 : 10;
        const gx = L.stacked ? px : px + 6, gy = L.stacked ? py + 22 : py + 42;
        const size = p.grid.length, cell = gridPx / size;
        const tx = L.stacked ? px + gridPx + 22 : px + 6;
        const ty = L.stacked ? py + 58 : gy + gridPx + 26;
        return (
          <g>
            <text class="f-title" x={px} y={py + 14}>{p.title}</text>
            {!L.stacked && <text class="f-small f-t-muted" x={px} y={py + 32}>{p.mask}</text>}
            {p.grid.map((row, i) => row.map((c, j) => <rect x={gx + j * cell + 1} y={gy + i * cell + 1} width={cell - 2} height={cell - 2} rx="2" style={fill[c]} />))}
            {pi === 2 && <path class="f-thin f-muted f-dash" d={`M ${gx + S * cell} ${gy - 3} V ${gy + gridPx + 3} M ${gx - 3} ${gy + S * cell} H ${gx + gridPx + 3}`} />}
            {L.stacked && <text class="f-small f-t-muted" x={tx} y={ty - 18}>{p.mask}</text>}
            <text class="f-small" x={tx} y={ty} style="font-weight: 650">{p.obj}</text>
            <text class="f-small f-t-muted" x={tx} y={ty + 20}>{words.input}:</text>
            <text class="f-small" x={tx + (ru ? 40 : 46)} y={ty + 20} font-family="var(--mono)">{p.input}</text>
            <text class="f-small f-t-muted" x={tx} y={ty + 40}>{words.target}:</text>
            <text class="f-small f-t-green" x={tx + (ru ? 40 : 46)} y={ty + 40} font-family="var(--mono)">{p.target}</text>
          </g>
        );
      })}
      {(['self', 'cross', 'off'] as Cell[]).map((c, i) => {
        const lx = L.stacked ? 8 + i * 116 : 12 + i * 150, ly = L.H - 14;
        return (
          <g>
            <rect x={lx} y={ly - 10} width="12" height="12" rx="2" style={fill[c]} />
            <text class="f-small" x={lx + 18} y={ly}>{words[c]}</text>
          </g>
        );
      })}
      {!L.stacked && <text class="f-small f-t-muted" x={L.W - 12} y={L.H - 14} text-anchor="end">{words.rows}</text>}
    </svg>
  ))}
</Figure>
