---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { density } from './simulation';

const ru = pageLang(Astro.url) === 'ru';

// The data p = 0.8 N(−4, 1) + 0.2 N(4, 1) and the same distribution after adding noise of scale σ.
const levels = [
  { sigma: 0, tone: 'blue', label: ru ? 'данные, σ = 0' : 'data, σ = 0' },
  { sigma: 1, tone: 'amber', label: 'σ = 1' },
  { sigma: 3, tone: 'red', label: 'σ = 3' },
];
const e = (v: number) => v.toFixed(5);
if (density(0, 0).toFixed(5) !== '0.00013' || density(0, 3).toFixed(3) !== '0.057') throw new Error('NoisedDensities: numbers drifted from the note');
const id = 'score-matching-noised-densities';
const layouts = [
  { sfx: 'w', cls: 'fig-wide fig-medium', W: 620, H: 300, left: 50, right: 590, top: 20, bottom: 250 },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 330, left: 40, right: 346, top: 20, bottom: 230 },
];
---

<Figure
  id={id}
  title={ru ? 'Шум заполняет пустоту между модами' : 'Noise fills the gap between the modes'}
  caption={ru
    ? `Данные — смесь 0.8 N(−4, 1) + 0.2 N(4, 1) — и та же смесь после добавления шума N(0, σ²). Между модами у данных почти нет массы: плотность в нуле ${e(density(0, 0))}, так что обучающих точек там нет и оценка score там ненадёжна. Шум σ = 3 поднимает её до ${density(0, 3).toFixed(3)} и делает распределение одномодальным на вид; модель score, обученная на этом уровне, знает, в какую сторону и с каким перевесом идти из любой точки. Отжиг проходит уровни от большого σ к малому.`
    : `The data, the mixture 0.8 N(−4, 1) + 0.2 N(4, 1), and the same mixture after adding N(0, σ²) noise. Between the modes the data have almost no mass: the density at 0 is ${e(density(0, 0))}, so there are no training points there and a score estimate there is unreliable. Noise of σ = 3 lifts it to ${density(0, 3).toFixed(3)} and makes the distribution look unimodal; a score model trained at that level knows which way to go, and how unevenly, from any point. Annealing goes through the levels from large σ to small.`}
>
  {layouts.map((L) => {
    const sx = scale([-10, 10], [L.left, L.right]);
    const sy = scale([0, 0.34], [L.bottom, L.top]);
    const narrow = L.sfx === 'n';
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{ru ? 'Плотность смеси при трёх уровнях шума' : 'The mixture density at three noise levels'}</title>
        <desc id={`${id}-${L.sfx}-d`}>{ru ? 'Три кривые плотности на отрезке от −10 до 10. Без шума — два пика у −4 и 4, левый в четыре раза выше, а между ними плотность почти ноль. При σ = 1 пики шире и ниже, при σ = 3 остаётся один широкий горб, смещённый влево.' : 'Three density curves over −10 to 10. Without noise: two peaks at −4 and 4, the left one four times higher, and almost zero density between them. At σ = 1 the peaks are wider and lower; at σ = 3 one broad hump remains, shifted to the left.'}</desc>
        {[-8, -4, 0, 4, 8].map((x) => <text class="f-note" x={sx(x)} y={L.bottom + 20} text-anchor="middle">{x}</text>)}
        <path class="f-axis" d={`M ${L.left} ${L.bottom} H ${L.right + 10}`} marker-end="url(#f-arrow-muted)" />
        <text class="f-math" x={L.right + 10} y={L.bottom + 40} text-anchor="end">x</text>
        {levels.map((lv) => <path class={`f-line f-${lv.tone}${lv.sigma === 0 ? ' f-bold' : ''}`} d={plot((x) => density(x, lv.sigma), -10, 10, sx, sy, 400)} />)}
        {levels.map((lv, i) => (
          <g>
            <line class={`f-line f-${lv.tone}`} x1={narrow ? L.left : L.right - 150} x2={narrow ? L.left + 22 : L.right - 128} y1={narrow ? L.bottom + 44 + i * 18 : L.top + 14 + i * 20} y2={narrow ? L.bottom + 44 + i * 18 : L.top + 14 + i * 20} />
            <text class="f-label" x={narrow ? L.left + 30 : L.right - 120} y={narrow ? L.bottom + 49 + i * 18 : L.top + 19 + i * 20}>{lv.label}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
