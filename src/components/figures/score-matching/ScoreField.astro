---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Exact score of noised data for a Swiss-roll-shaped mixture: K = 100 Gaussians with standard deviation s0 = 0.05
// centred on the curve (t cos t, t sin t) / 10, t = 1.5 pi (1 + 2u), u uniform on a grid. Noising with N(0, sigma^2 I)
// gives a mixture with variance v = s0^2 + sigma^2 per component, whose score is
//   s(x) = sum_k w_k(x) (mu_k - x) / v,  w_k(x) proportional to exp(-|x - mu_k|^2 / (2 v)).
// Arrows on a 13 x 13 grid over [-1.5, 2]^2; length proportional to log(1 + |s|), normalised per panel.
const K = 100;
const s0 = 0.05;
const mus: [number, number][] = Array.from({ length: K }, (_, k) => {
  const tt = 1.5 * Math.PI * (1 + 2 * ((k + 0.5) / K));
  return [(tt * Math.cos(tt)) / 10, (tt * Math.sin(tt)) / 10];
});
const sigmas = [1, 100 ** (-1 / 3), 100 ** (-2 / 3), 0.01];
const G = 13;
const lo = -1.5;
const hi = 2;
const gridVals = Array.from({ length: G }, (_, j) => lo + ((j + 0.5) * (hi - lo)) / G);

const score = (x: number, y: number, sig: number): [number, number] => {
  const v = s0 * s0 + sig * sig;
  const d2 = mus.map(([mx, my]) => (x - mx) ** 2 + (y - my) ** 2);
  const m = Math.min(...d2);
  const w = d2.map((d) => Math.exp(-(d - m) / (2 * v)));
  const z = w.reduce((a, b) => a + b, 0);
  let sx = 0;
  let sy = 0;
  w.forEach((wk, k) => {
    sx += (wk / z) * (mus[k][0] - x);
    sy += (wk / z) * (mus[k][1] - y);
  });
  return [sx / v, sy / v];
};

const fields = sigmas.map((sig) => {
  const pts = gridVals.flatMap((y) => gridVals.map((x) => {
    const [sx, sy] = score(x, y, sig);
    return { x, y, sx, sy, n: Math.hypot(sx, sy) };
  }));
  const maxN = Math.max(...pts.map((p) => p.n));
  return { sig, pts, maxN };
});
const fmtMax = (v: number) => (v < 10 ? v.toFixed(1) : String(Math.round(v)));
const fmtSig = (s: number) => (s === 1 ? '1' : s.toFixed(s < 0.02 ? 2 : 3));
const quoted = ['1.7', '30', '314', '562'];
fields.forEach((f, i) => {
  if (fmtMax(f.maxN) !== quoted[i]) throw new Error(`ScoreField: max |s| at sigma ${f.sig} is ${f.maxN}, caption says ${quoted[i]}`);
});
if (sigmas.map(fmtSig).join(',') !== '1,0.215,0.046,0.01') throw new Error(`ScoreField: levels ${sigmas.map(fmtSig).join(',')}`);

type L = { cls: string; vb: string; size: number; origin: (i: number) => [number, number] };
const layouts: Record<string, L> = {
  w: { cls: 'fig-wide', vb: '0 0 760 252', size: 172, origin: (i) => [14 + i * 188, 34] },
  n: { cls: 'fig-narrow', vb: '0 0 360 486', size: 160, origin: (i) => [12 + (i % 2) * 180, 34 + Math.floor(i / 2) * 236] },
};

// Arrow geometry for one panel: shaft from the grid point along the score, small filled head at the tip.
const arrowsFor = (f: (typeof fields)[number], x0: number, y0: number, size: number) => {
  const cell = size / G;
  const lMax = 0.9 * cell;
  const sx = (x: number) => x0 + ((x - lo) / (hi - lo)) * size;
  const sy = (y: number) => y0 + ((hi - y) / (hi - lo)) * size;
  const denom = Math.log1p(f.maxN);
  return f.pts.map((p) => {
    const len = (lMax * Math.log1p(p.n)) / denom;
    const ux = p.sx / p.n;
    const uy = -p.sy / p.n; // screen y points down
    const ax = sx(p.x);
    const ay = sy(p.y);
    const bx = ax + ux * len;
    const by = ay + uy * len;
    const hl = Math.min(4, 0.5 * len);
    const hw = 0.6 * hl;
    const cx = bx - ux * hl;
    const cy = by - uy * hl;
    const shaft = `M ${ax.toFixed(1)} ${ay.toFixed(1)} L ${cx.toFixed(1)} ${cy.toFixed(1)}`;
    const head = `${bx.toFixed(1)},${by.toFixed(1)} ${(cx - uy * hw).toFixed(1)},${(cy + ux * hw).toFixed(1)} ${(cx + uy * hw).toFixed(1)},${(cy - ux * hw).toFixed(1)}`;
    return { shaft, head };
  });
};
const dotsFor = (x0: number, y0: number, size: number) =>
  mus.map(([x, y]) => [x0 + ((x - lo) / (hi - lo)) * size, y0 + ((hi - y) / (hi - lo)) * size] as const);

const geo = Object.fromEntries(
  Object.entries(layouts).map(([k, l]) => [
    k,
    {
      ...l,
      panels: fields.map((f, i) => {
        const [x0, y0] = l.origin(i);
        return { x0, y0, arrows: arrowsFor(f, x0, y0, l.size), dots: dotsFor(x0, y0, l.size), sig: fmtSig(f.sig), max: fmtMax(f.maxN) };
      }),
    },
  ]),
);
const id = 'score-matching-score-field';
const caption = ru
  ? 'Точный score зашумлённых данных на уровнях 1, 0.215, 0.046 и 0.01. Данные — 100 гауссиан (стандартное отклонение 0.05) вдоль швейцарского рулета, точки — их центры. Длина стрелки растёт как log(1 + |s|) и нормируется в каждой панели отдельно; значение для самой длинной стрелки подписано под панелью. При σ = 1 поле одно и гладкое; при σ = 0.01 стрелки указывают на ближайший виток.'
  : 'The exact score of noised data at the levels 1, 0.215, 0.046 and 0.01. The data are 100 Gaussians (std 0.05) along a Swiss roll, dots at their centres. Arrow length grows like log(1 + |s|), scaled per panel; the longest arrow’s value is printed below. At σ = 1 one smooth field; at σ = 0.01 arrows point at the nearest arm.';
---

<Figure id={id} title={ru ? 'Поле score на четырёх уровнях шума' : 'The score field at four noise levels'} caption={caption}>
  {Object.entries(geo).map(([sfx, g]) => (
    <svg class={g.cls} viewBox={g.vb} role="img" aria-labelledby={`${id}-${sfx}-t ${id}-${sfx}-d`}>
      <title id={`${id}-${sfx}-t`}>{ru ? 'Векторные поля score для четырёх уровней шума' : 'Score vector fields for four noise levels'}</title>
      <desc id={`${id}-${sfx}-d`}>{ru
        ? 'Четыре квадратные панели со стрелками на сетке и точками вдоль спирали. При сигма, равной 1, стрелки плавно сходятся к центру спирали; при меньших сигма они всё сильнее указывают на ближайший виток, а наибольшая величина score растёт от 1.7 до 562.'
        : 'Four square panels with arrows on a grid and dots along a spiral. At sigma equal to 1 the arrows converge smoothly toward the middle of the spiral; at smaller sigma they point more and more sharply at the nearest arm, and the largest score magnitude grows from 1.7 to 562.'}</desc>
      {g.panels.map((p) => (
        <g>
          <rect class="f-grid" x={p.x0} y={p.y0} width={g.size} height={g.size} />
          <text class="f-label" x={p.x0 + g.size / 2} y={p.y0 - 10} text-anchor="middle">σ = {p.sig}</text>
          {p.dots.map(([x, y]) => <circle class="f-solid-muted" cx={x.toFixed(1)} cy={y.toFixed(1)} r="1.7" />)}
          {p.arrows.map((a) => (
            <g>
              <path class="f-thin f-blue" d={a.shaft} />
              <polygon class="f-solid-blue" points={a.head} />
            </g>
          ))}
          <text class="f-note" x={p.x0 + g.size / 2} y={p.y0 + g.size + 20} text-anchor="middle">max |s| ≈ {p.max}</text>
        </g>
      ))}
    </svg>
  ))}
</Figure>
