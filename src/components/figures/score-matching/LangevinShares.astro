---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { density, result, weight } from './simulation';

const ru = pageLang(Astro.url) === 'ru';

// Where 4000 Langevin chains end, as histograms against the true density.
const f2 = (v: number) => v.toFixed(2);
if (f2(result.plainLeft) !== '0.52' || f2(result.annealedLeft) !== '0.79') throw new Error('LangevinShares: numbers drifted from the note');
const binW = 0.5, lo = -9, hi = 9;
const hist = (xs: number[]) => Array.from({ length: (hi - lo) / binW }, (_, b) => xs.filter((x) => x >= lo + b * binW && x < lo + (b + 1) * binW).length / (xs.length * binW));
const panels = [
  { label: ru ? 'обычный Ланжевен, σ = 0' : 'plain Langevin, σ = 0', bars: hist(result.plain), share: result.plainLeft, tone: 'amber' },
  { label: ru ? 'отжиг по 10 уровням шума' : 'annealed over 10 noise levels', bars: hist(result.annealed), share: result.annealedLeft, tone: 'blue' },
];
const t = ru ? { left: 'доля в левой моде', truth: `истинная ${f2(weight)}` } : { left: 'share in the left mode', truth: `true ${f2(weight)}` };
const id = 'score-matching-langevin-shares';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 720, H: 270, pw: 330, ph: 190, gap: 40, top: 34, stack: false },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 520, pw: 340, ph: 190, gap: 70, top: 34, stack: true },
];
---

<Figure
  id={id}
  title={ru ? 'Без шума Ланжевен теряет веса мод' : 'Without noise, Langevin loses the mode weights'}
  caption={ru
    ? `Конечные положения ${result.chains} цепочек Ланжевена, стартовавших равномерно на [−8, 8], с точным score смеси 0.8 N(−4, 1) + 0.2 N(4, 1) (линия — истинная плотность). Слева: 2000 шагов размера 0.05 со score данных; в левой моде оказывается ${f2(result.plainLeft)}, а не ${f2(weight)}. Справа: по 100 шагов на каждом из 10 уровней от σ = 5 до 0.1; в левой моде ${f2(result.annealedLeft)}.`
    : `Final positions of ${result.chains} Langevin chains started uniformly on [−8, 8], with the exact score of 0.8 N(−4, 1) + 0.2 N(4, 1) (line: true density). Left: 2000 steps of size 0.05 on the data's score; ${f2(result.plainLeft)} end in the left mode instead of ${f2(weight)}. Right: 100 steps at each of 10 levels from σ = 5 to 0.1; ${f2(result.annealedLeft)}.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{ru ? 'Гистограммы конечных положений цепочек' : 'Histograms of the final chain positions'}</title>
      <desc id={`${id}-${L.sfx}-d`}>{panels.map((p) => `${p.label}: ${t.left} ${f2(p.share)}`).join('; ')}; {t.truth}.</desc>
      {panels.map((p, i) => {
        const x0 = L.stack ? 10 : 10 + i * (L.pw + L.gap);
        const y0 = L.stack ? L.top + i * (L.ph + L.gap) : L.top;
        const sx = scale([lo, hi], [x0, x0 + L.pw]);
        const sy = scale([0, 0.45], [y0 + L.ph, y0]);
        return (
          <g>
            <text class="f-label" x={x0} y={y0 - 12}>{p.label}</text>
            {p.bars.map((h, b) => h > 0 && <rect x={sx(lo + b * binW) + 0.5} y={sy(h)} width={sx(lo + binW) - sx(lo) - 1} height={y0 + L.ph - sy(h)} style={`fill: var(--fig-${p.tone}); fill-opacity: 0.45`} />)}
            <path class="f-line" d={plot((x) => density(x, 0), lo, hi, sx, sy, 300)} />
            <path class="f-axis" d={`M ${x0} ${y0 + L.ph} H ${x0 + L.pw}`} />
            {[-8, -4, 0, 4, 8].map((x) => <text class="f-note" x={sx(x)} y={y0 + L.ph + 18} text-anchor="middle">{x}</text>)}
            <text class="f-label" x={x0 + L.pw} y={y0 + 6} text-anchor="end">{`${t.left}: ${f2(p.share)}`}</text>
            <text class="f-note" x={x0 + L.pw} y={y0 + 24} text-anchor="end">{t.truth}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
