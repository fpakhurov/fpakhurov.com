---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const id = 'change-of-variables';
const ru = pageLang(Astro.url) === 'ru';
const title = ru ? 'Одна или две допустимые ветви' : 'One or two valid branches';
const caption = ru ? 'Вход равномерен на [−2, 4]. При y = 1 есть два корня, при y = 9 внутри носителя остаётся один. В точке y = 4 функция распределения непрерывна, хотя наклон меняется.' : 'The input is uniform on [−2, 4]. At y = 1 there are two roots; at y = 9 only one remains in the support. The CDF is continuous at y = 4 although its slope changes.';
const square = cases.square.map(([x,y]) => `${48+(x+2)*40},${224-y*11}`).join(' ');
const cdf = cases.cdf.map(([y,p]) => `${48+y*15},${224-p*176}`).join(' ');
---
<Figure id={id} title={title} caption={caption}>
 <div class="transform-panels">
  <svg viewBox="0 0 320 278" role="img" aria-labelledby={`${id}-map-title ${id}-map-desc`}>
   <title id={`${id}-map-title`}>{ru ? 'Квадрат на входном носителе' : 'Squaring on the input support'}</title>
   <desc id={`${id}-map-desc`}>{ru ? 'Парабола показана только от минус двух до четырёх. Уровень один пересекает её при минус одном и одном; уровень девять — только при трёх.' : 'The parabola is drawn only from minus two to four. Level one intersects at minus one and one; level nine intersects only at three.'}</desc>
   <path d="M48 36V224H292" class="axis" />
   {[0,4,9,16].map(y=><g><path d={`M44 ${224-y*11}H288`} class="grid"/><text x="38" y={229-y*11} text-anchor="end">{y}</text></g>)}
   {[-2,0,2,4].map(x=><text x={48+(x+2)*40} y="246" text-anchor="middle">{x}</text>)}
   <polyline data-series="square" points={square} class="curve" />
   {[1,9].map(y=><line x1="48" y1={224-y*11} x2="288" y2={224-y*11} class="level" />)}
   {[-1,1,3].map(x=><circle cx={48+(x+2)*40} cy={224-x*x*11} r="4" class="dot"/>)}
   <text x="48" y="22">y = x²</text><text x="296" y="247">x</text>
  </svg>
  <svg viewBox="0 0 320 278" role="img" aria-labelledby={`${id}-cdf-title ${id}-cdf-desc`}>
   <title id={`${id}-cdf-title`}>{ru ? 'Функция распределения квадрата' : 'The CDF of the square'}</title>
   <desc id={`${id}-cdf-desc`}>{ru ? 'Функция растёт от нуля до единицы на интервале от нуля до шестнадцати. При y = 4 она равна двум третям; далее действует одна ветвь.' : 'The CDF rises from zero to one between zero and sixteen. At y = 4 it equals two thirds; a single branch applies thereafter.'}</desc>
   <path d="M48 36V224H292" class="axis" />
   {[0,0.5,1].map(p=><g><path d={`M44 ${224-p*176}H288`} class="grid"/><text x="38" y={229-p*176} text-anchor="end">{p}</text></g>)}
   {[0,4,9,16].map(y=><text x={48+y*15} y="246" text-anchor="middle">{y}</text>)}
   <polyline data-series="cdf" points={cdf} class="curve" />
   <line x1="108" x2="108" y1={224-176*2/3} y2="224" class="level" />
   <circle cx="108" cy={224-176*2/3} r="4" class="dot" />
   <text x="48" y="22">F(y)</text><text x="296" y="247">y</text>
  </svg>
 </div>
</Figure>
<style>
.transform-panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.transform-panels svg{width:100%;height:auto;min-width:0}.transform-panels text{fill:var(--ink);font-size:15px;font-family:var(--sans);font-variant-numeric:tabular-nums}.transform-panels .axis{fill:none;stroke:var(--ink);stroke-width:1.2}.transform-panels .grid{fill:none;stroke:var(--muted);stroke-opacity:.2}.transform-panels .curve{fill:none;stroke:var(--fig-blue);stroke-width:2.6}.transform-panels .level{stroke:var(--fig-red);stroke-width:1.5;stroke-dasharray:5 4}.transform-panels .dot{fill:var(--fig-red)}@media(max-width:700px){.transform-panels{grid-template-columns:1fr}}
</style>
