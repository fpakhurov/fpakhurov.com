---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale, polyline } from '../geometry';
import { Phi, phi } from '../normal';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// X ~ N(0, 1) and Y = e^X. A band of x keeps its probability when mapped to y; where g squeezes the band the density
// of Y rises, where g stretches it the density falls: f_Y(y) = f_X(x) / g'(x) with g'(x) = e^x.
const g = Math.exp, fY = (y: number) => phi(Math.log(y)) / y;
const bands = [[-1.2, -0.7], [0.8, 1.3]].map(([a, b]) => ({ a, b, p: Phi(b) - Phi(a) }));
if (bands.map((B) => B.p.toFixed(3)).join() !== '0.127,0.115') throw new Error('ChangeOfVariables: band probabilities drifted from the note');
const X = [-2.5, 1.72] as [number, number], Ymax = 5.6;
const xs = Array.from({ length: 85 }, (_, i) => X[0] + (i * (X[1] - X[0])) / 84);
const ys = Array.from({ length: 112 }, (_, i) => 0.05 + i * 0.05);
const fmt = (v: number) => v.toFixed(3);
const t = ru
  ? { fx: 'плотность X', fy: 'плотность Y', curve: 'y = eˣ', law: 'f_Y(y) = f_X(x) / g′(x)',
      steps: ['X — стандартная нормальная; две полосы x несут вероятности 0.127 и 0.115', 'y = eˣ переводит полосы в интервалы y: левая сжимается, правая растягивается', 'та же вероятность на более коротком интервале — выше плотность: f_Y = f_X / g′'] }
  : { fx: 'density of X', fy: 'density of Y', curve: 'y = eˣ', law: 'f_Y(y) = f_X(x) / g′(x)',
      steps: ['X is standard normal; two bands of x carry probability 0.127 and 0.115', 'y = eˣ maps the bands to intervals of y: the left one is squeezed, the right one stretched', 'the same probability over a shorter interval means a higher density: f_Y = f_X / g′'] };
const id = 'change-of-variables';
const layouts = [
  { cls: 'fig-wide', W: 720, H: 480, px: [210, 680], py: [330, 30], fyw: 160, xb: 450, xh: 80 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 470, px: [112, 342], py: [300, 24], fyw: 92, xb: 430, xh: 72 },
];
const geom = (L: (typeof layouts)[number]) => {
  const sx = scale(X, L.px as [number, number]), sy = scale([0, Ymax], L.py as [number, number]);
  const fyx = (v: number) => L.px[0] - (v / 0.7) * L.fyw, fxy = (v: number) => L.xb - (v / 0.4) * L.xh;
  const xArea = (a: number, b: number) => {
    const pts = Array.from({ length: 21 }, (_, i) => a + (i * (b - a)) / 20);
    return `M ${sx(a)} ${L.xb} ${pts.map((x) => `L ${sx(x).toFixed(1)} ${fxy(phi(x)).toFixed(1)}`).join(' ')} L ${sx(b)} ${L.xb} Z`;
  };
  const yArea = (a: number, b: number) => {
    const pts = Array.from({ length: 21 }, (_, i) => a + (i * (b - a)) / 20);
    return `M ${L.px[0]} ${sy(a)} ${pts.map((y) => `L ${fyx(fY(y)).toFixed(1)} ${sy(y).toFixed(1)}`).join(' ')} L ${L.px[0]} ${sy(b)} Z`;
  };
  return { sx, sy, fyx, fxy, xArea, yArea };
};
---

<Figure
  id={id}
  title={ru ? 'Замена переменных: вероятность сохраняется, плотность меняется' : 'Change of variables: probability is kept, density changes'}
  caption={ru
    ? `X имеет стандартное нормальное распределение (плотность внизу), Y = eˣ (кривая), плотность Y слева. Полоса x от −1.2 до −0.7 несёт вероятность ${fmt(bands[0].p)}, полоса от 0.8 до 1.3 — ${fmt(bands[1].p)} (1). Экспонента сжимает первую в интервал y длиной ${(g(-0.7) - g(-1.2)).toFixed(3)} и растягивает вторую в интервал длиной ${(g(1.3) - g(0.8)).toFixed(3)} (2). Вероятность та же, поэтому плотность Y над первым интервалом высокая, а над вторым низкая: f_Y(y) = f_X(x) / g′(x) (3).`
    : `X is standard normal (density at the bottom), Y = eˣ (the curve), the density of Y on the left. The band of x from −1.2 to −0.7 carries probability ${fmt(bands[0].p)}, the band from 0.8 to 1.3 carries ${fmt(bands[1].p)} (1). The exponential squeezes the first into a y-interval of length ${(g(-0.7) - g(-1.2)).toFixed(3)} and stretches the second into one of length ${(g(1.3) - g(0.8)).toFixed(3)} (2). The probability is the same, so the density of Y is high over the first interval and low over the second: f_Y(y) = f_X(x) / g′(x) (3).`}
>
  {layouts.map((L) => {
    const { sx, sy, fyx, fxy, xArea, yArea } = geom(L);
    const tones = ['amber', 'green'];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Полосы x, их образы под eˣ и плотность Y' : 'Bands of x, their images under eˣ and the density of Y'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Кривая y = eˣ, нормальная плотность X под осью x и логнормальная плотность Y слева от оси y; две полосы близкой вероятности (0.127 и 0.115) переходят в узкий высокий и широкий низкий участки плотности Y.' : 'The curve y = eˣ, the normal density of X below the x-axis and the log-normal density of Y left of the y-axis; two bands of comparable probability (0.127 and 0.115) become a narrow tall and a wide low piece of the density of Y.'}</desc>
        <path class="f-axis" d={`M ${L.px[0]} ${sy(0)} H ${L.px[1]}`} />
        <path class="f-axis" d={`M ${L.px[0]} ${sy(0)} V ${sy(Ymax)}`} />
        {[-2, -1, 0, 1].map((v) => <text class="f-note" x={sx(v)} y={sy(0) + 18} text-anchor="middle">{v}</text>)}
        {[1, 3, 5].map((v) => <text class="f-note" x={L.px[0] + 6} y={sy(v) + 5}>{v}</text>)}
        <path class="f-line f-blue" d={polyline(xs.map((x) => [sx(x), sy(g(x))]))} />
        <text class="f-small f-t-blue" x={sx(0.3)} y={sy(1.55)} text-anchor="end">{t.curve}</text>
        <path class="f-axis" d={`M ${L.px[0]} ${L.xb} H ${L.px[1]}`} />
        <path class="f-line" d={polyline(xs.map((x) => [sx(x), fxy(phi(x))]))} />
        <text class="f-note" x={sx(-2.45)} y={L.xb - L.xh + 10}>{t.fx}</text>
        <path class="f-line" d={polyline(ys.map((y) => [fyx(fY(y)), sy(y)]))} />
        <text class="f-note" x={L.px[0] - 6} y={sy(Ymax) + 4} text-anchor="end">{t.fy}</text>
        <g data-s="1">
          {bands.map((B, i) => <path d={xArea(B.a, B.b)} class={`f-fill-${tones[i]}`} style="fill-opacity: .5" />)}
          {bands.map((B, i) => <text class={`f-small f-t-${tones[i]}`} x={sx((B.a + B.b) / 2)} y={L.xb + 18} text-anchor="middle">{fmt(B.p)}</text>)}
          <Badge x={L.px[1] - 12} y={L.xb - 40} n={1} />
        </g>
        <g data-s="2">
          {bands.flatMap((B, i) => [B.a, B.b].map((e) => <path class={`f-thin f-${tones[i]} f-dash`} d={`M ${sx(e)} ${fxy(phi(e))} V ${sy(g(e))} H ${L.px[0]}`} />))}
          {bands.map((B, i) => <path class={`f-${tones[i]}`} style="stroke-width: 5" d={`M ${L.px[0]} ${sy(g(B.a))} V ${sy(g(B.b))}`} />)}
          <Badge x={sx(1.55)} y={sy(4.4)} n={2} />
        </g>
        <g data-s="3">
          {bands.map((B, i) => <path d={yArea(g(B.a), g(B.b))} class={`f-fill-${tones[i]}`} style="fill-opacity: .55" />)}
          <text class="f-small f-t-amber" x={(fyx(fY(0.4)) + L.px[0]) / 2} y={sy(g(-0.7)) - 8} text-anchor="middle">{fmt(bands[0].p)}</text>
          <text class="f-small f-t-green" x={L.px[0] - 22} y={sy(2.95)} text-anchor="end">{fmt(bands[1].p)}</text>
          <text class="f-small" x={sx(-2.15)} y={sy(4.3)}>{t.law}</text>
          <Badge x={L.px[0] - 14} y={sy(1.3)} n={3} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
