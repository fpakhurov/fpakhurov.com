---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Inverse transform sampling for Exp(1): F(x) = 1 − e^(−x), x = F^(−1)(u) = −ln(1 − u).
// Equally spaced u become unequally spaced x: the tail of the distribution gets the wide gaps.
const us = [0.1, 0.3, 0.5, 0.7, 0.9];
const inv = (u: number) => -Math.log(1 - u);
const xsOut = us.map(inv);
if (xsOut.map((v) => v.toFixed(3)).join() !== '0.105,0.357,0.693,1.204,2.303') throw new Error('InverseTransform: values drifted from the note');
const curve = Array.from({ length: 81 }, (_, i) => [i * 0.05, 1 - Math.exp(-i * 0.05)] as [number, number]);
const id = 'inverse-transform';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 300, x0: 70, x1: 570, y0: 24, y1: 240 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 300, x0: 54, x1: 344, y0: 24, y1: 230 },
];
---

<Figure
  id={id}
  title={ru ? 'Метод обратной функции: от равномерного u к показательному x' : 'Inverse transform sampling: from a uniform u to an exponential x'}
  caption={ru
    ? `Кривая — функция распределения F(x) = 1 − e^(−x) показательного распределения. Равномерное u на вертикальной оси переводится в x = F⁻¹(u) = −ln(1 − u). Равноотстоящие u = 0.1, 0.3, 0.5, 0.7, 0.9 дают x = ${xsOut.map((v) => v.toFixed(3)).join(', ')}: где F растёт медленно (в хвосте), промежутки между x широкие, и туда попадает мало точек.`
    : `The curve is the distribution function F(x) = 1 − e^(−x) of the exponential distribution. A uniform u on the vertical axis is mapped to x = F⁻¹(u) = −ln(1 − u). The equally spaced u = 0.1, 0.3, 0.5, 0.7, 0.9 give x = ${xsOut.map((v) => v.toFixed(3)).join(', ')}: where F rises slowly, in the tail, the gaps between the x are wide and few points land there.`}
>
  {layouts.map((L) => {
    const sx = scale([0, 4], [L.x0, L.x1]), sy = scale([0, 1], [L.y1, L.y0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Функция распределения и пять пар (u, x)' : 'The distribution function and five pairs (u, x)'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? `Пять значений u на вертикальной оси отражаются кривой в значения x: ${xsOut.map((v) => v.toFixed(3)).join(', ')}.` : `Five values of u on the vertical axis are mapped by the curve to x: ${xsOut.map((v) => v.toFixed(3)).join(', ')}.`}</desc>
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        <path class="f-axis" d={`M ${L.x0} ${L.y1} V ${L.y0}`} />
        {[0, 1, 2, 3, 4].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{v}</text>)}
        <text class="f-note" x={L.x0 - 8} y={sy(1) + 5} text-anchor="end">1</text>
        <text class="f-note" x={L.x0 - 8} y={sy(0) + 5} text-anchor="end">0</text>
        <path class="f-line f-blue" d={polyline(curve.map(([x, y]) => [sx(x), sy(y)]))} />
        {us.map((u, i) => (
          <g>
            <path class="f-thin f-amber" d={`M ${L.x0} ${sy(u)} H ${sx(xsOut[i])} V ${L.y1 - 2}`} marker-end="url(#f-arrow-amber)" />
            <circle cx={L.x0} cy={sy(u)} r="3.5" class="f-solid-green" />
            <circle cx={sx(xsOut[i])} cy={L.y1} r="3.5" class="f-solid-red" />
            <text class="f-note" x={L.x0 - 8} y={sy(u) + 5} text-anchor="end">{u}</text>
          </g>
        ))}
        <text class="f-small f-t-green" x={L.x0 + 6} y={L.y0 + 4}>u</text>
        <text class="f-small f-t-red" x={L.x1} y={L.y1 + 40} text-anchor="end">x = −ln(1 − u)</text>
      </svg>
    );
  })}
</Figure>
