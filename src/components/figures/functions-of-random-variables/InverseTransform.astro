---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const id = 'inverse-transform';
const ru = pageLang(Astro.url) === 'ru';
const title = ru ? 'От уровня вероятности к квадрату входа' : 'From a probability level to the squared input';
const caption = ru ? 'Пять фиксированных уровней проверяют обе ветви квантильной функции. Это не случайная выборка. Излом при u = 2/3 соответствует окончанию отрицательной ветви исходного преобразования.' : 'Five fixed levels check both pieces of the quantile function. These are not random samples. The change of slope at u = 2/3 corresponds to the end of the negative branch of the original transformation.';
const curve = cases.quantileCurve.map(([u,y])=>`${48+240*u},${224-11*y}`).join(' ');
const labels=['1/6','1/3','1/2','2/3','5/6'];
---
<Figure id={id} title={title} caption={caption}>
 <div class="quantile-panels">
  <svg viewBox="0 0 320 278" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
   <title id={`${id}-title`}>{ru ? 'Квантильная функция квадрата' : 'Quantile function of the square'}</title>
   <desc id={`${id}-desc`}>{ru ? 'Кривая возрастает от нуля до шестнадцати. Отмечены уровни 1/6, 1/3, 1/2, 2/3, 5/6; их значения перечислены в таблице.' : 'The curve rises from zero to sixteen. Markers show levels 1/6, 1/3, 1/2, 2/3 and 5/6, with their values in the table.'}</desc>
   <path d="M48 36V224H292" class="axis" />
   {[0,4,9,16].map(y=><g><path d={`M44 ${224-11*y}H288`} class="grid"/><text x="38" y={229-11*y} text-anchor="end">{y}</text></g>)}
   {[0,0.5,1].map(u=><text x={48+240*u} y="246" text-anchor="middle">{u}</text>)}
   <polyline data-series="quantile" points={curve} class="curve" />
   {cases.quantiles.map(([u,y])=><circle cx={48+240*u} cy={224-11*y} r="4" class="dot"/>)}
   <text x="48" y="22">Q(u)</text><text x="296" y="247">u</text>
  </svg>
  <table><caption>{ru ? 'Точные контрольные уровни' : 'Fixed check levels'}</caption><thead><tr><th scope="col">u</th><th scope="col">Q(u)</th></tr></thead><tbody>{cases.quantiles.map(([,y],i)=><tr><th scope="row">{labels[i]}</th><td>{y}</td></tr>)}</tbody></table>
 </div>
</Figure>
<style>
.quantile-panels{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:1rem;align-items:center}.quantile-panels svg{width:100%;height:auto;min-width:0}.quantile-panels text{fill:var(--ink);font-size:15px;font-family:var(--sans);font-variant-numeric:tabular-nums}.quantile-panels .axis{fill:none;stroke:var(--ink);stroke-width:1.2}.quantile-panels .grid{fill:none;stroke:var(--muted);stroke-opacity:.2}.quantile-panels .curve{fill:none;stroke:var(--fig-blue);stroke-width:2.6}.quantile-panels .dot{fill:var(--fig-red)}.quantile-panels table{display:table;width:100%;font-size:1rem;font-variant-numeric:tabular-nums;margin:0}.quantile-panels caption{text-align:left;color:var(--muted);padding-bottom:.5rem}.quantile-panels th,.quantile-panels td{text-align:left;padding:.45rem .6rem}@media(max-width:700px){.quantile-panels{grid-template-columns:1fr}}
</style>
