---
import Figure from '../Figure.astro';

const ru = Astro.props.lang === 'ru';
const title = ru ? 'Две рамки для продажи 202' : 'Two frames for sale 202';
const caption = ru
  ? 'Контур отмечает текущую продажу 202, заливка показывает строки рамки. В рамку по дате попадает и продажа 203 с той же датой.'
  : 'The outline marks the current sale 202 and the fill marks frame membership. The date-based frame includes sale 203 on the same date.';
const desc = ru
  ? 'По дате рамка содержит продажи 201, 202 и 203. По позициям она содержит 201 и 202.'
  : 'The date frame contains sales 201, 202 and 203. The position frame contains sales 201 and 202.';
const frames = [
  { label: ru ? 'По дате' : 'By date', count: 3, total: 600 },
  { label: ru ? 'По позиции' : 'By position', count: 2, total: 300 },
];
---
<Figure id="sql-prefix-frames" title={title} caption={caption}>
  <svg viewBox="0 0 340 147" role="img" aria-labelledby="prefix-frames-title prefix-frames-desc" style="max-width: 520px; margin-inline: auto">
    <title id="prefix-frames-title">{title}</title>
    <desc id="prefix-frames-desc">{desc}</desc>
    {frames.map(({label, count, total}, i) => (
      <g transform={`translate(0 ${i * 70})`}>
        <text class="f-label" x="12" y="23">{label}</text>
        <text class="f-label" x="328" y="23" text-anchor="end">{ru ? 'Сумма' : 'Total'} {total}</text>
        {[201, 202, 203, 204, 205].map((sale, j) => (
          <g transform={`translate(${12 + j * 64} 0)`}>
            <rect class:list={[j < count ? 'f-fill-blue' : 'f-fill-paper f-muted', { 'f-amber f-bold': sale === 202 }]} x="0" y="34" width="60" height="29" rx="5" />
            <text class="f-label" x="30" y="54" text-anchor="middle">{sale}</text>
          </g>
        ))}
      </g>
    ))}
  </svg>
</Figure>
