---
import Figure from '../Figure.astro';

// Three generated images, each classified confidently as a different class.
const perImage = [
  [0.9, 0.05, 0.05],
  [0.05, 0.9, 0.05],
  [0.05, 0.05, 0.9],
];
const marginal = [0, 1, 2].map((k) => perImage.reduce((sum, p) => sum + p[k], 0) / perImage.length);

/** Bars of a small class-probability chart whose box starts at (x, top). */
function bars(p: number[], x: number, top: number, w: number, h: number) {
  const bw = 22;
  const gap = 9;
  const offset = (w - (p.length * bw + (p.length - 1) * gap)) / 2;
  return p.map((value, k) => ({
    x: x + offset + k * (bw + gap),
    y: top + h - value * h,
    w: bw,
    h: value * h,
  }));
}

const chartW = 96;
const chartH = 44;

// Wide layout.
const wideCharts = [
  { top: 40, label: 'x₁' },
  { top: 120, label: 'x₂' },
  { top: 216, label: 'x_N' },
].map((c, i) => ({ ...c, x: 330, p: perImage[i] }));
const wideMarginal = { x: 548, top: 120 };

// Narrow layout.
const narrowCharts = [
  { x: 14, label: 'x₁' },
  { x: 122, label: 'x₂' },
  { x: 256, label: 'x_N' },
].map((c, i) => ({ ...c, top: 316, p: perImage[i] }));
const narrowMarginal = { x: 132, top: 470 };
---

<Figure
  id="is-pipeline"
  title="Computing the Inception Score"
  caption="Each generated image goes through a frozen ImageNet classifier; its softmax output p(y | x) should be peaked (confident). Averaging these outputs over all images gives the marginal p(y), which should be flat (diverse). The score compares every p(y | x) with p(y) by KL divergence."
  origin="illustrative"
  pages="15–17"
>
  <svg class="fig-wide" viewBox="0 0 680 400" role="img" aria-labelledby="is-pipeline-t is-pipeline-d">
    <title id="is-pipeline-t">Inception Score pipeline</title>
    <desc id="is-pipeline-d">Generated images x1 to xN enter an Inception v3 network pretrained on ImageNet, built from Inception modules and ending in a softmax. For each image the network outputs a class distribution p of y given x; the three examples are each peaked on a different class, meaning low conditional entropy and confident predictions. Averaging them gives the marginal p of y, which is flat, meaning high entropy and diverse images. The expected KL divergence between each p of y given x and p of y is exponentiated to give the Inception Score.</desc>

    <!-- generated images -->
    <rect class="f-box-soft" x="20" y="96" width="60" height="60" rx="4" />
    <rect class="f-box-soft" x="28" y="104" width="60" height="60" rx="4" />
    <rect class="f-box" x="36" y="112" width="60" height="60" rx="4" />
    <circle class="f-thin" cx="80" cy="126" r="6" />
    <path class="f-thin" d="M 40 166 L 58 140 L 70 154 L 78 146 L 92 166" />
    <text class="f-label" x="62" y="198" text-anchor="middle">generated</text>
    <text class="f-label" x="62" y="216" text-anchor="middle">images</text>
    <text class="f-math" x="62" y="242" text-anchor="middle">x₁, …, x<tspan dy="5" font-size="13">N</tspan></text>

    <path class="f-line" d="M 102 142 H 148" marker-end="url(#f-arrow)" />

    <!-- Inception v3 -->
    <rect class="f-box" x="152" y="92" width="120" height="104" rx="6" />
    <text class="f-title" x="212" y="114" text-anchor="middle">Inception v3</text>
    {[0, 1, 2, 3].map((k) => <rect class="f-box-soft" x={163 + k * 25} y="126" width="20" height="26" rx="3" />)}
    <rect class="f-fill-blue f-blue f-thin" x="163" y="162" width="95" height="22" rx="3" />
    <text class="f-small" x="210.5" y="177" text-anchor="middle">softmax</text>
    <text class="f-note" x="150" y="62" text-anchor="middle">Inception modules</text>
    <path class="f-thin f-muted" d="M 124 70 Q 132 112 160 124" marker-end="url(#f-arrow-muted)" />
    <text class="f-note" x="212" y="218" text-anchor="middle">pretrained on</text>
    <text class="f-note" x="212" y="236" text-anchor="middle">ImageNet, frozen</text>

    <!-- fan out to per-image outputs -->
    {wideCharts.map((c) => (
      <path class="f-thin" d={`M 274 144 L ${c.x - 6} ${c.top + chartH / 2}`} marker-end="url(#f-arrow)" />
    ))}
    <text class="f-note" x="380" y="24" text-anchor="middle">one output per image</text>
    {wideCharts.map((c) => (
      <g>
        <line class="f-axis" x1={c.x} x2={c.x + chartW} y1={c.top + chartH} y2={c.top + chartH} />
        {bars(c.p, c.x, c.top, chartW, chartH).map((b) => <rect class="f-solid-blue" x={b.x} y={b.y} width={b.w} height={b.h} />)}
        <text class="f-math" x={c.x + chartW / 2} y={c.top + chartH + 20} text-anchor="middle" font-size="16">
          {c.label === 'x_N' ? <>p(y | x<tspan dy="5" font-size="12">N</tspan><tspan dy="-5">)</tspan></> : `p(y | ${c.label})`}
        </text>
      </g>
    ))}
    <text class="f-label" x="378" y="204" text-anchor="middle">⋮</text>

    <!-- average to the marginal -->
    {wideCharts.map((c) => (
      <path class="f-thin f-green" d={`M ${c.x + chartW + 6} ${c.top + chartH / 2} L ${wideMarginal.x - 8} ${wideMarginal.top + chartH / 2}`} marker-end="url(#f-arrow-green)" />
    ))}
    <text class="f-label f-t-green f-halo" x="482" y="112" text-anchor="middle">average</text>
    <text class="f-note f-halo" x="482" y="208" text-anchor="middle">over images</text>
    <line class="f-axis" x1={wideMarginal.x} x2={wideMarginal.x + chartW} y1={wideMarginal.top + chartH} y2={wideMarginal.top + chartH} />
    {bars(marginal, wideMarginal.x, wideMarginal.top, chartW, chartH).map((b) => <rect class="f-solid-green" x={b.x} y={b.y} width={b.w} height={b.h} />)}
    <text class="f-math" x={wideMarginal.x + chartW / 2} y={wideMarginal.top + chartH + 20} text-anchor="middle" font-size="16">p(y)</text>
    <text class="f-note" x={wideMarginal.x + chartW / 2} y={wideMarginal.top - 12} text-anchor="middle">marginal</text>

    <!-- what each should look like -->
    <text class="f-label f-t-blue" x="378" y="306" text-anchor="middle">peaked: low H(p(y | x))</text>
    <text class="f-note" x="378" y="324" text-anchor="middle">“confident”</text>
    <text class="f-label f-t-green" x="596" y="210" text-anchor="middle">flat: high H(p(y))</text>
    <text class="f-note" x="596" y="228" text-anchor="middle">“diverse”</text>

    <!-- KL and exp -->
    <path class="f-thin" d="M 420 312 Q 440 330 450 344" marker-end="url(#f-arrow)" />
    <path class="f-thin" d="M 596 236 Q 592 300 556 346" marker-end="url(#f-arrow)" />
    <rect class="f-box" x="404" y="350" width="178" height="40" rx="6" />
    <text class="f-math" x="493" y="376" text-anchor="middle" font-size="16">𝔼<tspan dy="5" font-size="12">x</tspan><tspan dy="-5"> D</tspan><tspan dy="5" font-size="12" font-style="normal">KL</tspan><tspan dy="-5">(p(y | x) <tspan font-style="normal">‖</tspan> p(y))</tspan></text>
    <path class="f-line" d="M 584 370 H 614" marker-end="url(#f-arrow)" />
    <text class="f-note" x="600" y="392" text-anchor="middle">exp</text>
    <rect class="f-fill-amber" style="stroke: var(--fig-amber); stroke-width: 1.7" x="618" y="352" width="56" height="36" rx="6" />
    <text class="f-title" x="646" y="376" text-anchor="middle">IS</text>
  </svg>

  <svg class="fig-narrow" viewBox="0 0 360 720" role="img" aria-labelledby="is-pipeline-nt is-pipeline-nd">
    <title id="is-pipeline-nt">Inception Score pipeline</title>
    <desc id="is-pipeline-nd">Generated images x1 to xN enter an Inception v3 network pretrained on ImageNet, built from Inception modules and ending in a softmax. For each image the network outputs a class distribution p of y given x; the three examples are each peaked on a different class, meaning low conditional entropy and confident predictions. Averaging them gives the marginal p of y, which is flat, meaning high entropy and diverse images. The expected KL divergence between each p of y given x and p of y is exponentiated to give the Inception Score.</desc>

    <rect class="f-box-soft" x="104" y="14" width="60" height="60" rx="4" />
    <rect class="f-box-soft" x="112" y="22" width="60" height="60" rx="4" />
    <rect class="f-box" x="120" y="30" width="60" height="60" rx="4" />
    <circle class="f-thin" cx="164" cy="44" r="6" />
    <path class="f-thin" d="M 124 84 L 142 58 L 154 72 L 162 64 L 176 84" />
    <text class="f-label" x="194" y="50">generated images</text>
    <text class="f-math" x="194" y="76">x₁, …, x<tspan dy="5" font-size="13">N</tspan></text>

    <path class="f-line" d="M 150 96 V 126" marker-end="url(#f-arrow)" />

    <rect class="f-box" x="80" y="130" width="140" height="110" rx="6" />
    <text class="f-title" x="150" y="152" text-anchor="middle">Inception v3</text>
    {[0, 1, 2, 3].map((k) => <rect class="f-box-soft" x={98 + k * 27} y="164" width="22" height="28" rx="3" />)}
    <rect class="f-fill-blue f-blue f-thin" x="98" y="204" width="103" height="22" rx="3" />
    <text class="f-small" x="149.5" y="219" text-anchor="middle">softmax</text>
    <text class="f-note" x="232" y="160">Inception</text>
    <text class="f-note" x="232" y="177">modules</text>
    <path class="f-thin f-muted" d="M 230 184 Q 220 196 206 186" marker-end="url(#f-arrow-muted)" />
    <text class="f-note" x="150" y="260" text-anchor="middle">pretrained on ImageNet, frozen</text>

    {narrowCharts.map((c) => (
      <path class="f-thin" d={`M 150 268 L ${c.x + chartW / 2 - 4} ${c.top - 8}`} marker-end="url(#f-arrow)" />
    ))}
    {narrowCharts.map((c) => (
      <g>
        <line class="f-axis" x1={c.x} x2={c.x + chartW - 6} y1={c.top + chartH} y2={c.top + chartH} />
        {bars(c.p, c.x - 3, c.top, chartW, chartH).map((b) => <rect class="f-solid-blue" x={b.x} y={b.y} width={b.w} height={b.h} />)}
        <text class="f-math" x={c.x + chartW / 2 - 3} y={c.top + chartH + 20} text-anchor="middle" font-size="16">
          {c.label === 'x_N' ? <>p(y | x<tspan dy="5" font-size="12">N</tspan><tspan dy="-5">)</tspan></> : `p(y | ${c.label})`}
        </text>
      </g>
    ))}
    <text class="f-label" x="236" y="344" text-anchor="middle">…</text>
    <text class="f-label f-t-blue" x="180" y="408" text-anchor="middle">peaked: low H(p(y | x)), “confident”</text>

    {narrowCharts.map((c) => (
      <path class="f-thin f-green" d={`M ${c.x + chartW / 2 - 3} 420 L ${narrowMarginal.x + chartW / 2 - 3 + (c.x - 122) * 0.25} ${narrowMarginal.top + chartH * (1 - marginal[0]) - 8}`} marker-end="url(#f-arrow-green)" />
    ))}
    <text class="f-label f-t-green" x="270" y="466">average</text>
    <line class="f-axis" x1={narrowMarginal.x} x2={narrowMarginal.x + chartW - 6} y1={narrowMarginal.top + chartH} y2={narrowMarginal.top + chartH} />
    {bars(marginal, narrowMarginal.x - 3, narrowMarginal.top, chartW, chartH).map((b) => <rect class="f-solid-green" x={b.x} y={b.y} width={b.w} height={b.h} />)}
    <text class="f-math" x={narrowMarginal.x + chartW / 2 - 3} y={narrowMarginal.top + chartH + 20} text-anchor="middle" font-size="16">p(y)</text>
    <text class="f-label f-t-green" x="180" y="562" text-anchor="middle">flat: high H(p(y)), “diverse”</text>

    <path class="f-line" d="M 180 572 V 596" marker-end="url(#f-arrow)" />
    <rect class="f-box" x="86" y="600" width="188" height="40" rx="6" />
    <text class="f-math" x="180" y="626" text-anchor="middle" font-size="16">𝔼<tspan dy="5" font-size="12">x</tspan><tspan dy="-5"> D</tspan><tspan dy="5" font-size="12" font-style="normal">KL</tspan><tspan dy="-5">(p(y | x) <tspan font-style="normal">‖</tspan> p(y))</tspan></text>
    <path class="f-line" d="M 180 642 V 670" marker-end="url(#f-arrow)" />
    <text class="f-note" x="190" y="660">exp</text>
    <rect class="f-fill-amber" style="stroke: var(--fig-amber); stroke-width: 1.7" x="152" y="674" width="56" height="36" rx="6" />
    <text class="f-title" x="180" y="698" text-anchor="middle">IS</text>
  </svg>
</Figure>
