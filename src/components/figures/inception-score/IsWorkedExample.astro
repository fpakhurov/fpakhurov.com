---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Three classes (beagle, corgi, husky), three generated images per generator.
const H = (p: number[]) => -p.reduce((s, q) => (q > 0 ? s + q * Math.log(q) : s), 0);
const KL = (p: number[], q: number[]) => p.reduce((s, a, k) => (a > 0 ? s + a * Math.log(a / q[k]) : s), 0);
const third = 1 / 3;

const generators = [
  {
    key: 'A',
    title: ru ? 'A · уверенный и разнообразный' : 'A · confident and diverse',
    images: [
      [0.9, 0.05, 0.05],
      [0.05, 0.9, 0.05],
      [0.05, 0.05, 0.9],
    ],
  },
  {
    key: 'B',
    title: ru ? 'B · уверенный, коллапс мод' : 'B · confident, mode collapse',
    images: [
      [0.9, 0.05, 0.05],
      [0.9, 0.05, 0.05],
      [0.9, 0.05, 0.05],
    ],
  },
  {
    key: 'C',
    title: ru ? 'C · неуверенный, разнообразный в среднем' : 'C · diverse on average, not confident',
    images: [
      [third, third, third],
      [third, third, third],
      [third, third, third],
    ],
  },
  {
    key: 'D',
    title: ru ? 'D · частичный коллапс (без хаски)' : 'D · partial collapse (never a husky)',
    images: [
      [0.9, 0.05, 0.05],
      [0.9, 0.05, 0.05],
      [0.05, 0.9, 0.05],
    ],
  },
].map((g) => {
  const marginal = [0, 1, 2].map((k) => g.images.reduce((s, p) => s + p[k], 0) / g.images.length);
  const meanKL = g.images.reduce((s, p) => s + KL(p, marginal), 0) / g.images.length;
  return {
    ...g,
    marginal,
    imageH: g.images.map(H),
    marginalH: H(marginal),
    meanKL: Math.max(0, meanKL),
    score: Math.exp(Math.max(0, meanKL)),
  };
});

const f2 = (v: number) => v.toFixed(2);
const classLetters = ru ? ['б', 'к', 'х'] : ['b', 'c', 'h'];
const chartW = 96;
const chartH = 60;

function bars(p: number[], x: number, top: number) {
  const bw = 22;
  const gap = 9;
  const offset = (chartW - (3 * bw + 2 * gap)) / 2;
  return p.map((value, k) => ({
    x: x + offset + k * (bw + gap),
    cx: x + offset + k * (bw + gap) + bw / 2,
    y: top + chartH - value * chartH,
    h: value * chartH,
    w: bw,
    letter: classLetters[k],
  }));
}

// Wide layout: one row per generator.
const wideRow = 150;
const wideTop0 = 52;
const imageX = [20, 132, 244];
const margX = 418;
const wide = generators.map((g, i) => ({ ...g, r: wideTop0 + i * wideRow }));
const wideHeight = wideTop0 + generators.length * wideRow + 4;

// Narrow layout: images in a row, marginal underneath.
const narrowRow = 280;
const narrowTop0 = 36;
const nImageX = [14, 132, 250];
const nMargX = 40;
const narrow = generators.map((g, i) => ({ ...g, r: narrowTop0 + i * narrowRow }));
const narrowHeight = narrowTop0 + generators.length * narrowRow - 10;
---

<Figure
  id="is-worked-example"
  title={ru ? "Три класса, четыре генератора" : "Three classes, four generators"}
  caption={ru ? "Синие столбцы — выходы классификатора p(y | x) для трёх сгенерированных изображений; зелёные столбцы — их среднее p(y). У генератора A выходы для отдельных изображений имеют острый пик, а маргинальное распределение плоское, и значение метрики у него самое высокое; B (коллапс мод) и C (нераспознаваемые изображения) оба получают минимальное значение 1; D, который никогда не рисует хаски, оказывается посередине. Энтропии H измеряются в натах; б, к, х — бигль, корги, хаски." : "Blue bars are the classifier outputs p(y | x) for three generated images; green bars are their average p(y). Generator A has peaked per-image outputs and a flat marginal and scores highest; B (mode collapse) and C (unrecognizable images) both score the minimum 1; D, which never draws a husky, lands in between. Entropies H are in nats; b, c, h = beagle, corgi, husky."}
>
  <svg class="fig-wide" viewBox={`0 0 680 ${wideHeight}`} role="img" aria-labelledby="is-worked-example-t is-worked-example-d">
    <title id="is-worked-example-t">{ru ? "Inception Score для четырёх игрушечных генераторов" : "Inception Score for four toy generators"}</title>
    <desc id="is-worked-example-d">{ru ? `Генератор A выдаёт три изображения, каждое из которых с вероятностью 0.9 отнесено к своему классу; маргинальное распределение равномерно, средняя KL-дивергенция равна ${f2(generators[0].meanKL)} ната, а IS равен ${f2(generators[0].score)}. Генератор B выдаёт три изображения, и все они с вероятностью 0.9 отнесены к биглю; маргинальное распределение совпадает с распределением для каждого изображения, KL равна 0, а IS равен 1. Генератор C выдаёт изображения с равномерными вероятностями классов; маргинальное распределение тоже равномерно, KL равна 0, а IS равен 1. Генератор D выдаёт двух биглей и одного корги, каждого с вероятностью 0.9, и никогда не выдаёт хаски; маргинальное распределение равно ${generators[3].marginal.map(f2).join(', ')}, средняя KL равна ${f2(generators[3].meanKL)}, а IS равен ${f2(generators[3].score)}.` : `Generator A produces three images, each classified with probability 0.9 as a different class; the marginal is uniform, the mean KL divergence is ${f2(generators[0].meanKL)} nats and IS is ${f2(generators[0].score)}. Generator B produces three images all classified as beagle with probability 0.9; the marginal equals each per-image distribution, KL is 0 and IS is 1. Generator C produces images with uniform class probabilities; the marginal is also uniform, KL is 0 and IS is 1. Generator D produces two beagles and one corgi with probability 0.9 each and never a husky; the marginal is ${generators[3].marginal.map(f2).join(', ')}, the mean KL is ${f2(generators[3].meanKL)} and IS is ${f2(generators[3].score)}.`}</desc>

    {['p(y | x₁)', 'p(y | x₂)', 'p(y | x₃)'].map((label, k) => (
      <text class="f-math" x={imageX[k] + chartW / 2} y="20" text-anchor="middle" font-size="16">{label}</text>
    ))}
    <text class="f-math" x={margX + chartW / 2} y="20" text-anchor="middle" font-size="16">p(y)</text>
    <text class="f-note" x="600" y="20" text-anchor="middle">{ru ? "метрика" : "score"}</text>
    <line class="f-grid" x1="10" x2="670" y1="32" y2="32" />

    {wide.map((g) => (
      <g>
        <text class="f-title" x="20" y={g.r + 6}>{g.title}</text>
        {g.images.map((p, k) => (
          <g>
            <line class="f-grid" x1={imageX[k]} x2={imageX[k] + chartW} y1={g.r + 18} y2={g.r + 18} />
            <line class="f-axis" x1={imageX[k]} x2={imageX[k] + chartW} y1={g.r + 18 + chartH} y2={g.r + 18 + chartH} />
            {bars(p, imageX[k], g.r + 18).map((b) => (
              <g>
                <rect class="f-solid-blue" x={b.x} y={b.y} width={b.w} height={b.h} />
                <text class="f-small f-t-muted" x={b.cx} y={g.r + 18 + chartH + 15} text-anchor="middle">{b.letter}</text>
              </g>
            ))}
            <text class="f-small f-t-blue" x={imageX[k] + chartW / 2} y={g.r + 18 + chartH + 34} text-anchor="middle">H = {f2(g.imageH[k])}</text>
          </g>
        ))}
        <path class="f-line f-green" d={`M ${imageX[2] + chartW + 10} ${g.r + 18 + chartH / 2} H ${margX - 10}`} marker-end="url(#f-arrow-green)" />
        <text class="f-small f-t-green" x={(imageX[2] + chartW + margX) / 2} y={g.r + 18 + chartH / 2 - 8} text-anchor="middle">{ru ? "среднее" : "average"}</text>
        <line class="f-grid" x1={margX} x2={margX + chartW} y1={g.r + 18} y2={g.r + 18} />
        <line class="f-axis" x1={margX} x2={margX + chartW} y1={g.r + 18 + chartH} y2={g.r + 18 + chartH} />
        {bars(g.marginal, margX, g.r + 18).map((b) => (
          <g>
            <rect class="f-solid-green" x={b.x} y={b.y} width={b.w} height={b.h} />
            <text class="f-small f-t-muted" x={b.cx} y={g.r + 18 + chartH + 15} text-anchor="middle">{b.letter}</text>
          </g>
        ))}
        <text class="f-small f-t-green" x={margX + chartW / 2} y={g.r + 18 + chartH + 34} text-anchor="middle">H = {f2(g.marginalH)}</text>
        <text class="f-note" x="600" y={g.r + 40} text-anchor="middle">{ru ? "средняя" : "mean"} D<tspan dy="4" font-size="10">KL</tspan><tspan dy="-4"> = {f2(g.meanKL)}</tspan></text>
        <text class={g.key === 'A' ? 'f-title f-t-amber' : 'f-title'} x="600" y={g.r + 66} text-anchor="middle" font-size="18">IS = {f2(g.score)}</text>
      </g>
    ))}
  </svg>

  <svg class="fig-narrow" viewBox={`0 0 360 ${narrowHeight}`} role="img" aria-labelledby="is-worked-example-nt is-worked-example-nd">
    <title id="is-worked-example-nt">{ru ? "Inception Score для четырёх игрушечных генераторов" : "Inception Score for four toy generators"}</title>
    <desc id="is-worked-example-nd">{ru ? `Генератор A выдаёт три изображения, каждое из которых с вероятностью 0.9 отнесено к своему классу; маргинальное распределение равномерно, средняя KL-дивергенция равна ${f2(generators[0].meanKL)} ната, а IS равен ${f2(generators[0].score)}. Генератор B выдаёт три изображения, и все они с вероятностью 0.9 отнесены к биглю; маргинальное распределение совпадает с распределением для каждого изображения, KL равна 0, а IS равен 1. Генератор C выдаёт изображения с равномерными вероятностями классов; маргинальное распределение тоже равномерно, KL равна 0, а IS равен 1. Генератор D выдаёт двух биглей и одного корги, каждого с вероятностью 0.9, и никогда не выдаёт хаски; маргинальное распределение равно ${generators[3].marginal.map(f2).join(', ')}, средняя KL равна ${f2(generators[3].meanKL)}, а IS равен ${f2(generators[3].score)}.` : `Generator A produces three images, each classified with probability 0.9 as a different class; the marginal is uniform, the mean KL divergence is ${f2(generators[0].meanKL)} nats and IS is ${f2(generators[0].score)}. Generator B produces three images all classified as beagle with probability 0.9; the marginal equals each per-image distribution, KL is 0 and IS is 1. Generator C produces images with uniform class probabilities; the marginal is also uniform, KL is 0 and IS is 1. Generator D produces two beagles and one corgi with probability 0.9 each and never a husky; the marginal is ${generators[3].marginal.map(f2).join(', ')}, the mean KL is ${f2(generators[3].meanKL)} and IS is ${f2(generators[3].score)}.`}</desc>

    {narrow.map((g) => (
      <g>
        <text class="f-title" x="14" y={g.r}>{g.title}</text>
        {g.images.map((p, k) => (
          <g>
            <text class="f-math" x={nImageX[k] + chartW / 2} y={g.r + 26} text-anchor="middle" font-size="15">{`p(y | x${['₁', '₂', '₃'][k]})`}</text>
            <line class="f-grid" x1={nImageX[k]} x2={nImageX[k] + chartW} y1={g.r + 36} y2={g.r + 36} />
            <line class="f-axis" x1={nImageX[k]} x2={nImageX[k] + chartW} y1={g.r + 36 + chartH} y2={g.r + 36 + chartH} />
            {bars(p, nImageX[k], g.r + 36).map((b) => (
              <g>
                <rect class="f-solid-blue" x={b.x} y={b.y} width={b.w} height={b.h} />
                <text class="f-small f-t-muted" x={b.cx} y={g.r + 36 + chartH + 15} text-anchor="middle">{b.letter}</text>
              </g>
            ))}
            <text class="f-small f-t-blue" x={nImageX[k] + chartW / 2} y={g.r + 36 + chartH + 33} text-anchor="middle">H = {f2(g.imageH[k])}</text>
          </g>
        ))}
        {nImageX.map((x0) => (
          <path class="f-line f-green" d={`M ${x0 + chartW / 2} ${g.r + 137} L ${nMargX + chartW / 2} ${g.r + 147}`} />
        ))}
        <path class="f-line f-green" d={`M ${nMargX + chartW / 2} ${g.r + 147} V ${g.r + 161}`} marker-end="url(#f-arrow-green)" />
        <text class="f-small f-t-green" x={nMargX + chartW / 2 + 10} y={g.r + 160}>{ru ? "среднее" : "average"}</text>
        <line class="f-grid" x1={nMargX} x2={nMargX + chartW} y1={g.r + 166} y2={g.r + 166} />
        <line class="f-axis" x1={nMargX} x2={nMargX + chartW} y1={g.r + 166 + chartH} y2={g.r + 166 + chartH} />
        {bars(g.marginal, nMargX, g.r + 166).map((b) => (
          <g>
            <rect class="f-solid-green" x={b.x} y={b.y} width={b.w} height={b.h} />
            <text class="f-small f-t-muted" x={b.cx} y={g.r + 166 + chartH + 15} text-anchor="middle">{b.letter}</text>
          </g>
        ))}
        <text class="f-math" x={nMargX + chartW + 14} y={g.r + 186} font-size="15">p(y)</text>
        <text class="f-small f-t-green" x={nMargX + chartW + 14} y={g.r + 206}>H = {f2(g.marginalH)}</text>
        <text class="f-note" x="300" y={g.r + 186} text-anchor="middle">{ru ? "средняя" : "mean"} D<tspan dy="4" font-size="10">KL</tspan><tspan dy="-4"> = {f2(g.meanKL)}</tspan></text>
        <text class={g.key === 'A' ? 'f-title f-t-amber' : 'f-title'} x="300" y={g.r + 212} text-anchor="middle" font-size="18">IS = {f2(g.score)}</text>
        <line class="f-grid" x1="10" x2="350" y1={g.r + 250} y2={g.r + 250} />
      </g>
    ))}
  </svg>
</Figure>
