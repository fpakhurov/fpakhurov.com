---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
const ru = pageLang(Astro.url) === 'ru';
let alive = new Map<number,bigint>([[0,1n]]);
const rows: {n:number,critical:number,single:number,ever:number}[]=[];
for(let n=1;n<=60;n++) {
  const next = new Map<number,bigint>();
  for(const [k,count] of alive) { next.set(k,(next.get(k)||0n)+count); next.set(k+1,(next.get(k+1)||0n)+count); }
  alive=next;
  if(n%10===0) {
    const mass: bigint[]=[1n];
    for(let k=1;k<=n;k++) mass.push(mass[k-1]*BigInt(n-k+1)/BigInt(k));
    const total=2n**BigInt(n);
    let critical=0,tail=total;
    while(tail*20n>total) {tail-=mass[critical];critical++;}
    for(const k of alive.keys()) if(k>=critical) alive.delete(k);
    const survivors=[...alive.values()].reduce((a,b)=>a+b,0n);
    rows.push({n,critical,single:Number(tail)/Number(total),ever:Number(total-survivors)/Number(total)});
  }
}
const x=(n:number)=>58+(n-10)*238/50;
const y=(p:number)=>240-p*180/.1;
const points=(key:'single'|'ever')=>rows.map(row=>`${x(row.n)},${y(row[key])}`).join(' ');
const title=ru ? 'Ошибка накапливается при повторных просмотрах' : 'False rejections accumulate across repeated looks';
const caption=ru ? 'Нулевая модель p=0.5, проверки через каждые 10 наблюдений. Синяя линия — точная ошибка отдельного теста; оранжевая — вероятность хотя бы одного отвержения к этому моменту. Пунктир отмечает 0.05. Итоговая ошибка достигает 0.09649.' : 'Null p=0.5, with a look every 10 observations. Blue shows the exact error of a single test; amber shows the probability of any rejection so far. The dashed line marks 0.05. Cumulative error reaches 0.09649.';
---
<Figure id="peeking" title={title} caption={caption}>
  <svg class="fig-compact" viewBox="0 0 320 300" role="img" aria-labelledby={`peeking-title-${ru ? 'ru' : 'en'}`}>
    <title id={`peeking-title-${ru ? 'ru' : 'en'}`}>{title}</title>
    <desc>{ru ? 'Шесть точных расчётов. Ошибка каждого отдельного теста меньше 0.05, но накопленная ошибка превышает 0.05 на третьем просмотре.' : 'Six exact calculations. Each individual test has error below 0.05, but cumulative error exceeds 0.05 at the third look.'}</desc>
    <text x="58" y="26">{ru ? 'Вероятность' : 'Probability'}</text>
    {[0,.025,.05,.075,.1].map(p=><g><line x1="58" x2="296" y1={y(p)} y2={y(p)} class={p===.05 ? 'f-axis f-dash' : 'f-grid'}/><text x="47" y={y(p)+5} text-anchor="end">{p}</text></g>)}
    <polyline points={points('single')} class="f-line f-blue" />
    <polyline points={points('ever')} class="f-line f-amber" />
    {rows.map(row=><g data-n={row.n} data-critical={row.critical} data-single={row.single} data-ever={row.ever}><circle cx={x(row.n)} cy={y(row.single)} r="3.5" class="f-solid-blue"/><circle cx={x(row.n)} cy={y(row.ever)} r="3.5" class="ever"/><text x={x(row.n)} y="264" text-anchor="middle">{row.n}</text></g>)}
    <text x="178" y="293" text-anchor="middle">{ru ? 'Число наблюдений' : 'Observations'}</text>
  </svg>
  <div class="legend"><span><i class="single"></i>{ru ? 'Один просмотр' : 'One look'}</span><span><i class="cumulative"></i>{ru ? 'Хотя бы один' : 'Any look so far'}</span></div>
</Figure>
<style>
svg :global(text) { font-size: 16px; font-variant-numeric: tabular-nums; }
.ever { fill: var(--fig-amber); }
.legend { display: flex; flex-wrap: wrap; justify-content: center; gap: .5rem 1rem; font-size: .82rem; margin-top: .6rem; }
.legend span { display: inline-flex; gap: .4rem; align-items: center; }
.legend i { display: inline-block; flex: 0 0 1.1rem; width: 1.1rem; height: .2rem; }
.single { background: var(--fig-blue); }
.cumulative { background: var(--fig-amber); }
</style>
