---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { mulberry32 } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// 40 A/A tests: both groups convert at 2%, 1,000 new users per group between checks, 20 checks. The z statistic after each
// check; red paths cross ±1.96 at some check and would be declared significant by someone who stops at the first crossing.
const runs = 40, checks = 20, step = 1000, u = mulberry32(19);
const paths = Array.from({ length: runs }, () => {
  let a = 0, b = 0;
  return Array.from({ length: checks }, (_, c) => {
    for (let i = 0; i < step; i++) { if (u() < 0.02) a++; if (u() < 0.02) b++; }
    const n = step * (c + 1), pa = a / n, pb = b / n, p = (a + b) / (2 * n);
    return (pb - pa) / Math.sqrt((2 * p * (1 - p)) / n);
  });
});
const crossed = paths.map((p) => p.some((z) => Math.abs(z) > 1.96));
const nCross = crossed.filter(Boolean).length, nFinal = paths.filter((p) => Math.abs(p[checks - 1]) > 1.96).length;
if (nCross < 5 || nCross > 18 || nFinal > 6) throw new Error('Peeking: the seeded runs no longer illustrate the effect');
const id = 'peeking';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 620, H: 300, x0: 40, x1: 600, y0: 20, y1: 250 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 300, x0: 50, x1: 344, y0: 20, y1: 250 },
];
---

<Figure
  id={id}
  title={ru ? 'Подглядывание в A/A-тесте' : 'Peeking at an A/A test'}
  caption={ru
    ? `${runs} A/A-тестов: в обеих группах конверсия 2%, между проверками добавляется по 1000 пользователей в группу, всего 20 проверок. Линии — статистика z после каждой проверки, пунктир — ±1.96. Разницы нет, и в конце значимы только ${nFinal} из ${runs}; но ${nCross} траекторий (красные) хотя бы раз выходят за ±1.96, и аналитик, останавливающий тест при первом таком выходе, объявил бы их значимыми. По 20 000 повторений это 25% ложных срабатываний вместо 5%.`
    : `${runs} A/A tests: both groups convert at 2%, 1,000 users join each group between checks, 20 checks in all. Lines are the z statistic after each check, dashed lines ±1.96. There is no difference, and at the end only ${nFinal} of ${runs} are significant; but ${nCross} paths (red) cross ±1.96 at some check, and an analyst who stops at the first crossing would declare them significant. Over 20,000 repetitions that is 25% false positives instead of 5%.`}
>
  {layouts.map((L) => {
    const sx = scale([1, checks], [L.x0, L.x1]), sy = scale([-3.5, 3.5], [L.y1, L.y0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Траектории статистики z' : 'Paths of the z statistic'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? `${nCross} из ${runs} траекторий хотя бы раз пересекают границы ±1.96.` : `${nCross} of ${runs} paths cross the ±1.96 bounds at least once.`}</desc>
        {[-1.96, 1.96].map((v) => <path class="f-thin f-amber f-dash" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} />)}
        <path class="f-grid" d={`M ${L.x0} ${sy(0)} H ${L.x1}`} />
        {paths.map((p, i) => <path class={crossed[i] ? 'f-thin f-red' : 'f-thin f-muted'} style={crossed[i] ? 'stroke-width: 1.4' : 'stroke-opacity: .45'} d={polyline(p.map((z, c) => [sx(c + 1), sy(Math.max(-3.5, Math.min(3.5, z)))]))} />)}
        {[-1.96, 0, 1.96].map((v) => <text class="f-note" x={L.x0 - 6} y={sy(v) + 5} text-anchor="end">{v}</text>)}
        {[1, 5, 10, 15, 20].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{v}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 42} text-anchor="middle">{ru ? 'номер проверки' : 'check'}</text>
      </svg>
    );
  })}
</Figure>
