---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale, polyline } from '../geometry';
import { Phi, phi } from '../normal';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The A/B test of the note: click rates 2.0% and 2.3%, 20,000 users per group, z = 2.07. Under no difference z ~ N(0, 1);
// if the true difference is 0.3 points, z ~ N(2.07, 1). Rejection region |z| > 1.96, p-value P(|Z| ≥ 2.07), power P(reject | H1).
const se = Math.sqrt((0.02 * 0.98) / 20000 + (0.023 * 0.977) / 20000), zObs = 0.003 / se, crit = 1.96;
const pval = 2 * (1 - Phi(zObs)), power = 1 - Phi(crit - zObs) + Phi(-crit - zObs);
if ([zObs, pval, power].map((v) => v.toFixed(2)).join() !== '2.07,0.04,0.54') throw new Error('TestLogic: numbers drifted from the note');
const zs = (a: number, b: number) => Array.from({ length: 81 }, (_, i) => a + ((b - a) * i) / 80);
const area = (f: (z: number) => number, a: number, b: number, sx: (v: number) => number, sy: (v: number) => number) =>
  `M ${sx(a)} ${sy(0)} ${zs(a, b).map((z) => `L ${sx(z).toFixed(1)} ${sy(f(z)).toFixed(1)}`).join(' ')} L ${sx(b)} ${sy(0)} Z`;
const h0 = (z: number) => phi(z), h1 = (z: number) => phi(z - zObs);
const t = ru
  ? { h0: 'нет разницы: z ~ N(0, 1)', h1: 'разница 0.3 п. п.: z ~ N(2.07, 1)', obs: 'z = 2.07', a: 'α = 0.05', p: 'p = 0.039', pow: 'мощность 0.54',
      steps: ['если разницы нет, z ~ N(0, 1), и |z| > 1.96 случается в 5% экспериментов: область отклонения', 'наблюдаемое z = 2.07; p-значение — вероятность при отсутствии разницы получить |z| ≥ 2.07: 0.039', 'если истинная разница 0.3 п. п., z ~ N(2.07, 1), и тест отвергает нулевую гипотезу с вероятностью 0.54 — это его мощность'] }
  : { h0: 'no difference: z ~ N(0, 1)', h1: 'difference of 0.3 points: z ~ N(2.07, 1)', obs: 'z = 2.07', a: 'α = 0.05', p: 'p = 0.039', pow: 'power 0.54',
      steps: ['if there is no difference, z ~ N(0, 1), and |z| > 1.96 happens in 5% of experiments: the rejection region', 'the observed z = 2.07; the p-value is the probability of |z| ≥ 2.07 when there is no difference: 0.039', 'if the true difference is 0.3 points, z ~ N(2.07, 1), and the test rejects the null with probability 0.54, its power'] };
const id = 'test-logic';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 640, H: 300, x0: 20, x1: 620, y0: 50, y1: 240 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 330, x0: 10, x1: 350, y0: 92, y1: 270 },
];
---

<Figure
  id={id}
  title={ru ? 'Нулевое распределение, p-значение и мощность' : 'The null distribution, the p-value and the power'}
  caption={ru
    ? `A/B-тест из заметки: доли кликов 2.0% и 2.3%, по 20 000 пользователей в группе. Синяя кривая — распределение статистики z, если разницы нет; красные хвосты |z| > 1.96 — область отклонения, 5% (1). Наблюдаемое z = ${zObs.toFixed(2)} попадает в неё; p-значение, жёлтая площадь за ±${zObs.toFixed(2)}, равно ${pval.toFixed(3)} (2). Зелёная кривая — распределение z, если разница действительно 0.3 п. п.; доля её площади в области отклонения, ${power.toFixed(2)}, — мощность теста (3).`
    : `The A/B test of the note: click rates 2.0% and 2.3%, 20,000 users per group. The blue curve is the distribution of the statistic z if there is no difference; the red tails |z| > 1.96 are the rejection region, 5% (1). The observed z = ${zObs.toFixed(2)} falls in it; the p-value, the amber area beyond ±${zObs.toFixed(2)}, is ${pval.toFixed(3)} (2). The green curve is the distribution of z if the difference really is 0.3 points; the share of its area in the rejection region, ${power.toFixed(2)}, is the power of the test (3).`}
>
  {layouts.map((L) => {
    const sx = scale([-4, 6], [L.x0, L.x1]), sy = scale([0, 0.45], [L.y1, L.y0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Две нормальные кривые с закрашенными областями' : 'Two normal curves with shaded regions'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Нулевая кривая с центром 0 и хвостами за ±1.96; отметка z = 2.07; альтернативная кривая с центром 2.07, правее 1.96 лежит 54% её площади.' : 'The null curve centred at 0 with tails beyond ±1.96; a mark at z = 2.07; the alternative curve centred at 2.07, with 54% of its area right of 1.96.'}</desc>
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {[-4, -2, 0, 2, 4, 6].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{v}</text>)}
        <g data-s="1">
          <path d={area(h0, crit, 4, sx, sy)} class="f-fill-red" style="fill-opacity: .55" />
          <path d={area(h0, -4, -crit, sx, sy)} class="f-fill-red" style="fill-opacity: .55" />
          <path class="f-line f-blue" d={polyline(zs(-4, 6).map((z) => [sx(z), sy(h0(z))]))} />
          <text class="f-small f-t-blue" x={sx(-3.9)} y={L.y0 - 30}>{t.h0}</text>
          <text class="f-note f-t-red" x={sx(-2.4)} y={sy(0.06)} text-anchor="end">{t.a}</text>
          <Badge x={sx(-3.6)} y={sy(0.3)} n={1} />
        </g>
        <g data-s="2">
          <path d={area(h0, zObs, 4, sx, sy)} class="f-fill-amber" style="fill-opacity: .9" />
          <path d={area(h0, -4, -zObs, sx, sy)} class="f-fill-amber" style="fill-opacity: .9" />
          <path class="f-line f-amber" d={`M ${sx(zObs)} ${L.y1} V ${sy(0.44)}`} />
          <text class="f-small f-t-amber" x={sx(zObs) + 6} y={sy(0.44) + 4}>{t.obs}</text>
          <text class="f-note f-t-amber" x={sx(zObs) + 6} y={sy(0.44) + 22}>{t.p}</text>
          <Badge x={sx(zObs) - 12} y={sy(0.44) - 2} n={2} />
        </g>
        <g data-s="3">
          <path d={area(h1, crit, 6, sx, sy)} class="f-fill-green" />
          <path class="f-line f-green" d={polyline(zs(-4, 6).map((z) => [sx(z), sy(h1(z))]))} />
          <text class="f-small f-t-green" x={sx(-3.9)} y={L.y0 - 12}>{t.h1}</text>
          <text class="f-note f-t-green" x={L.x1} y={sy(0.3)} text-anchor="end">{t.pow}</text>
          <Badge x={L.x1 - 10} y={sy(0.38)} n={3} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
