---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
const ru = pageLang(Astro.url) === 'ru';
function choose(n: number, k: number) { let v = 1; for (let j = 1; j <= k; j++) v = v * (n - j + 1) / j; return v; }
const panels = [{p:.5, key:'null', label:ru ? 'Нулевая гипотеза' : 'Null hypothesis'}, {p:.75,key:'alternative',label:ru ? 'Альтернатива' : 'Alternative'}];
const x = (k: number) => 58 + k * 19.5;
const y = (p: number) => 226 - p * 166 / .3;
const title = ru ? 'Одна область отвержения, разные вероятности' : 'One rejection region, different probabilities';
const caption = ru ? 'Биномиальные распределения для 12 независимых испытаний. Оранжевая область k≥10 задаёт одно правило решения. При p=0.5 оно ошибается с вероятностью 0.019287; при p=0.75 обнаруживает отклонение с вероятностью 0.390675.' : 'Binomial distributions for 12 independent trials. The amber region k≥10 defines one decision rule. At p=0.5 its false-rejection probability is 0.019287; at p=0.75 its power is 0.390675.';
---
<Figure id="test-logic" title={title} caption={caption}>
  <div class="panels">
    {panels.map(panel => {
      const rows=Array.from({length:13},(_,k)=>({k,p:choose(12,k)*panel.p**k*(1-panel.p)**(12-k)}));
      const tail=rows.filter(row=>row.k>=10).reduce((sum,row)=>sum+row.p,0);
      return <svg viewBox="0 0 320 315" role="img" aria-labelledby={`test-${panel.key}-${ru ? 'ru' : 'en'}`}>
        <title id={`test-${panel.key}-${ru ? 'ru' : 'en'}`}>{panel.label}, p={panel.p}</title>
        <desc>{ru ? 'Столбики вероятностей числа успехов; последние три составляют область отвержения.' : 'Success-count probability bars; the final three form the rejection region.'}</desc>
        <text x="160" y="22" text-anchor="middle" class="f-title">{panel.label}: p={panel.p}</text>
        <rect x={x(9.5)} y="60" width={x(12.5)-x(9.5)} height="166" class="f-fill-amber" />
        {[0,.1,.2,.3].map(p=><g><line x1="58" x2="302" y1={y(p)} y2={y(p)} class="f-grid"/><text x="47" y={y(p)+5} text-anchor="end">{p}</text></g>)}
        <text x="58" y="46">{ru ? 'Вероятность' : 'Probability'}</text>
        {rows.map(row=><rect data-distribution={panel.key} data-k={row.k} data-p={row.p} x={x(row.k)-5} y={y(row.p)} width="10" height={226-y(row.p)} class={row.k>=10 ? 'tail' : 'f-solid-blue'}/>)}
        <line x1="58" x2="302" y1="226" y2="226" class="f-axis" />
        {[0,2,4,6,8,10,12].map(k=><text x={x(k)} y="250" text-anchor="middle">{k}</text>)}
        <text x="160" y="276" text-anchor="middle">{ru ? 'Число успехов' : 'Success count'}</text>
        <text x="160" y="305" text-anchor="middle">{ru ? 'Отвержение: ' : 'Rejection: '}{tail.toFixed(6)}</text>
      </svg>;
    })}
  </div>
</Figure>
<style>
.panels { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 1rem; max-width: 760px; margin: auto; }
.panels svg { max-width: 360px; }
svg :global(text) { font-size: 16px; font-variant-numeric: tabular-nums; }
.tail { fill: var(--fig-amber); }
</style>
