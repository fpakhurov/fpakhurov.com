---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One trial of Reflexion: act, evaluate with an external signal, reflect in words, store the lesson, retry.
const omega = 3;
if (omega !== 3) throw new Error('ReflexionLoop: the memory bound should match the note (1 to 3 lessons)');
const t = ru
  ? {
      title: 'Одна попытка в Reflexion',
      task: 'задача', actor: 'актор', actorSub: 'модель в цикле ReAct', env: 'среда, тесты', envSub: 'выполняет попытку',
      evalr: 'оценщик', evalSub: 'оценка: успех или провал', refl: 'саморефлексия', reflSub: 'модель пишет урок',
      mem: 'память', memSub: `до ${omega} уроков`, done: 'готово', doneSub: 'если успех', next: 'следующая попытка',
      steps: ['действие: актор пытается решить задачу и порождает траекторию', 'оценка: внешний сигнал — среда, точное совпадение ответа, модульные тесты — даёт оценку; при успехе цикл заканчивается', 'рефлексия: модель читает траекторию и оценку и пишет короткий урок словами', 'память: урок добавляется к последним Ω урокам', 'повтор: в следующей попытке актор читает уроки вместе с задачей'],
      desc: 'Задача поступает к актору — языковой модели в цикле ReAct. Его траектория уходит в среду или тесты, оценщик выдаёт оценку r_t; при успехе цикл заканчивается. Иначе модель саморефлексии читает траекторию и оценку и пишет урок sr_t, который попадает в память из последних уроков. Стрелка из памяти ведёт обратно к актору: в следующей попытке он читает уроки.',
    }
  : {
      title: 'One trial of Reflexion',
      task: 'task', actor: 'actor', actorSub: 'the model in a ReAct loop', env: 'environment, tests', envSub: 'run the attempt',
      evalr: 'evaluator', evalSub: 'score: pass or fail', refl: 'self-reflection', reflSub: 'the model writes a lesson',
      mem: 'memory', memSub: `at most ${omega} lessons`, done: 'done', doneSub: 'if it passed', next: 'next trial',
      steps: ['act: the actor attempts the task and produces a trajectory', 'evaluate: an external signal (the environment, exact match, unit tests) scores it; on success the loop ends', 'reflect: the model reads the trajectory and the score and writes a short lesson in words', 'remember: the lesson joins the last Ω lessons in memory', 'retry: in the next trial the actor reads the lessons with the task'],
      desc: 'The task goes to the actor, a language model in a ReAct loop. Its trajectory goes to the environment or the tests, and the evaluator returns a score r_t; on success the loop ends. Otherwise a self-reflection model reads the trajectory and the score and writes a lesson, which goes into a memory of the last few lessons. An arrow from the memory leads back to the actor: in the next trial it reads the lessons.',
    };
const id = 'reflexion-loop';
const caption = ru
  ? 'Веса модели не меняются: «обучение» происходит в тексте, который актор читает в следующей попытке. Красное — то, что выдаёт модель; янтарное — внешний сигнал, от которого зависит всё остальное; синее — память между попытками. Если оценщик ошибается — например, самописные тесты проходят на неверной программе, — цикл заканчивается с ложным успехом, и рефлексия не наступает вовсе.'
  : 'The model\'s weights never change: the "learning" is text that the actor reads in the next trial. Red: what the model emits. Amber: the external signal on which everything else depends. Blue: memory carried between trials. If the evaluator is wrong, for instance self-written tests that pass on a wrong program, the loop ends with a false success and no reflection happens at all.';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 300" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <Box x={16} y={40} w={120} h={44} label={t.task} tone="x" />
    <g data-s="1">
      <Arrow pts={[[136, 62], [178, 62]]} />
      <Box x={180} y={30} w={170} h={64} label={t.actor} sub={t.actorSub} />
      <Arrow pts={[[350, 62], [418, 62]]} tone="red" label="τ_t" at={[384, 52]} anchor="middle" labelTone="y" />
      <Box x={420} y={30} w={170} h={64} label={t.env} sub={t.envSub} />
      <Badge x={265} y={16} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[505, 94], [505, 148]]} tone="amber" />
      <Box x={420} y={150} w={170} h={56} label={t.evalr} sub={t.evalSub} tone="g" />
      <Arrow pts={[[590, 178], [622, 178]]} tone="amber" />
      <Box x={624} y={150} w={120} h={56} label={t.done} sub={t.doneSub} tone="y" />
      <Badge x={505} y={226} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[420, 178], [352, 178]]} tone="amber" />
      <Box x={180} y={150} w={170} h={56} label={t.refl} sub={t.reflSub} />
      <Badge x={265} y={226} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[180, 178], [138, 178]]} tone="red" />
      <Box x={16} y={150} w={120} h={56} label={t.mem} sub={t.memSub} tone="h" />
      <Badge x={76} y={226} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[136, 162], [150, 162], [150, 80], [178, 80]]} tone="blue" />
      <text class="f-small f-t-blue" x="16" y="112">{t.next}</text>
      <Badge x={165} y={122} n={5} />
    </g>
    <Legend x={180} y={276} />
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 590" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <Box x={50} y={8} w={190} h={40} label={t.task} tone="x" />
    <g data-s="1">
      <Arrow pts={[[145, 48], [145, 68]]} />
      <Box x={50} y={70} w={190} h={56} label={t.actor} sub={ru ? 'модель в цикле ReAct' : 'a model in a ReAct loop'} />
      <Arrow pts={[[145, 126], [145, 166]]} tone="red" label="τ_t" at={[154, 152]} labelTone="y" />
      <Box x={50} y={168} w={190} h={56} label={t.env} sub={t.envSub} />
      <Badge x={262} y={98} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[145, 224], [145, 254]]} tone="amber" />
      <Box x={50} y={256} w={190} h={56} label={t.evalr} sub={t.evalSub} tone="g" />
      <Arrow pts={[[240, 284], [262, 284]]} tone="amber" />
      <Box x={264} y={260} w={88} h={48} label={t.done} tone="y" />
      <Badge x={308} y={238} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[145, 312], [145, 342]]} tone="amber" />
      <Box x={50} y={344} w={190} h={56} label={t.refl} sub={t.reflSub} />
      <Badge x={262} y={372} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[145, 400], [145, 430]]} tone="red" />
      <Box x={50} y={432} w={190} h={56} label={t.mem} sub={t.memSub} tone="h" />
      <Badge x={262} y={460} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[50, 460], [22, 460], [22, 98], [48, 98]]} tone="blue" />
      <Badge x={36} y={280} n={5} />
    </g>
    <Legend x={24} y={530} step={170} rows={2} />
  </svg>
  <Stepper steps={t.steps} />
</Figure>
