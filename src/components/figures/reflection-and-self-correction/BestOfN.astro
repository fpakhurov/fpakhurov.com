---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Best-of-n with an imperfect verifier (the formula of the note and the Code section): attempts are correct with
// probability p; the verifier accepts a correct one with probability a and a wrong one with probability b; the agent
// returns the first accepted attempt, or the first attempt if none is accepted.
const p = 0.3;
const P = (a: number, b: number, n: number) => {
  const q1 = p * a, q0 = (1 - p) * b, r = 1 - q1 - q0;
  return (q1 * (1 - r ** n)) / (1 - r) + r ** (n - 1) * p * (1 - a);
};
const ceiling = (a: number, b: number) => (p * a) / (p * a + (1 - p) * b);
const got = [P(1, 0, 4), P(0.9, 0.1, 4), P(0.9, 0.3, 4), P(0.7, 0.7, 64), ceiling(0.9, 0.1), ceiling(0.9, 0.3), P(0.9, 0.1, 16)].map((v) => v.toFixed(3)).join(' ');
if (got !== '0.760 0.652 0.526 0.300 0.794 0.563 0.793') throw new Error(`BestOfN: numbers drifted from the Code section (${got})`);

const verifiers = [
  { a: 1, b: 0, cls: 'green', en: 'a = 1, b = 0: sound', ru: 'a = 1, b = 0: надёжный' },
  { a: 0.9, b: 0.1, cls: 'blue', en: 'a = 0.9, b = 0.1', ru: 'a = 0.9, b = 0.1' },
  { a: 0.9, b: 0.3, cls: 'amber', en: 'a = 0.9, b = 0.3', ru: 'a = 0.9, b = 0.3' },
  { a: 0.7, b: 0.7, cls: 'red', en: 'a = b = 0.7: a coin', ru: 'a = b = 0.7: монетка' },
];
const ns = Array.from({ length: 64 }, (_, i) => i + 1);
const t = ru
  ? { title: 'Лучшая из n попыток при неидеальном верификаторе', x: 'число попыток n', y: 'вероятность верного ответа', ceil: 'потолок: точность верификатора',
      desc: 'Четыре кривые вероятности того, что возвращённая попытка верна, в зависимости от числа попыток n от 1 до 64 по логарифмической оси, при p = 0.3. Надёжный верификатор (a = 1, b = 0): 0.3, 0.76 при n = 4, почти 1 при n = 16. Верификатор с a = 0.9, b = 0.1 выходит на 0.794, с a = 0.9, b = 0.3 — на 0.563; пунктир отмечает эти потолки. Верификатор с a = b = 0.7 оставляет 0.3 при любом n.' }
  : { title: 'Best of n attempts with an imperfect verifier', x: 'number of attempts n', y: 'probability the answer is correct', ceil: "ceiling: the verifier's precision",
      desc: 'Four curves of the probability that the returned attempt is correct against the number of attempts n from 1 to 64 on a logarithmic axis, with p = 0.3. A sound verifier (a = 1, b = 0): 0.3, then 0.76 at n = 4 and nearly 1 at n = 16. A verifier with a = 0.9, b = 0.1 levels off at 0.794, one with a = 0.9, b = 0.3 at 0.563; dashed lines mark these ceilings. A verifier with a = b = 0.7 leaves the agent at 0.3 for every n.' };
const id = 'best-of-n';
const caption = ru
  ? 'Каждая попытка верна с вероятностью p = 0.3. Верификатор принимает верную попытку с вероятностью a и неверную — с вероятностью b; агент возвращает первую принятую. Кривая растёт как 1 − (1 − p)^n только для надёжного верификатора; при b больше нуля она упирается в точность верификатора pa / (pa + (1 − p)b) при любом числе попыток, а при a = b не растёт вовсе. Большая часть выигрыша приходит в первые несколько попыток.'
  : 'Each attempt is correct with probability p = 0.3. The verifier accepts a correct attempt with probability a and a wrong one with probability b, and the agent returns the first accepted attempt. Only for a sound verifier does the curve rise like 1 − (1 − p)^n; with b above zero it levels off at the verifier\'s precision pa / (pa + (1 − p)b) however many attempts are made, and with a = b it does not rise at all. Most of the gain comes in the first few attempts.';

const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 310, px: [70, 520] as [number, number], py: [40, 250] as [number, number], inline: true },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 420, px: [52, 340] as [number, number], py: [150, 350] as [number, number], inline: false },
];
const xTicks = [1, 2, 4, 8, 16, 32, 64], yTicks = [0, 0.2, 0.4, 0.6, 0.8, 1];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sx = scale([0, 6], L.px), sy = scale([0, 1], [L.py[1], L.py[0]]);
    const X = (n: number) => sx(Math.log2(n));
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {yTicks.map((v) => <path class="f-grid" d={`M ${L.px[0]} ${sy(v)} H ${L.px[1]}`} />)}
        <path class="f-axis" d={`M ${L.px[0]} ${L.py[0] - 6} V ${L.py[1]} H ${L.px[1]}`} />
        {yTicks.map((v) => <text class="f-small" x={L.px[0] - 7} y={sy(v) + 4} text-anchor="end">{v.toFixed(1)}</text>)}
        {xTicks.map((v) => <text class="f-small" x={X(v)} y={L.py[1] + 18} text-anchor="middle">{String(v)}</text>)}
        <text class="f-small f-t-muted" x={(L.px[0] + L.px[1]) / 2} y={L.py[1] + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.px[0] - 40} y={L.py[0] - 20}>{t.y}</text>
        {verifiers.filter((V) => V.b !== 0 && V.a !== V.b).map((V) => <path class={`f-line f-${V.cls} f-dash`} d={`M ${L.px[0]} ${sy(ceiling(V.a, V.b))} H ${L.px[1]}`} />)}
        {verifiers.map((V) => (
          <g>
            <path class={`f-line f-${V.cls}`} d={polyline(ns.map((n) => [X(n), sy(P(V.a, V.b, n))] as [number, number]))} />
            {[1, 4, 16, 64].map((n) => <circle cx={X(n)} cy={sy(P(V.a, V.b, n))} r="3" style={`fill: var(--fig-${V.cls})`} />)}
            {L.inline && <text class={`f-small f-t-${V.cls}`} x={L.px[1] + 10} y={sy(P(V.a, V.b, 64)) + 4}>{ru ? V.ru : V.en}</text>}
          </g>
        ))}
        {L.inline && <text class="f-small f-t-muted" x={L.px[1] + 10} y={sy(ceiling(0.9, 0.1)) + 22}>{t.ceil}</text>}
        {!L.inline && verifiers.map((V, i) => (
          <g>
            <path class={`f-line f-${V.cls}`} d={`M 16 ${22 + i * 22 - 4} h 22`} />
            <text class={`f-small f-t-${V.cls}`} x="46" y={22 + i * 22}>{ru ? V.ru : V.en}</text>
          </g>
        ))}
        {!L.inline && <path class="f-line f-muted f-dash" d={`M 16 ${22 + 4 * 22 - 4} h 22`} />}
        {!L.inline && <text class="f-small f-t-muted" x="46" y={22 + 4 * 22}>{t.ceil}</text>}
      </svg>
    );
  })}
</Figure>
