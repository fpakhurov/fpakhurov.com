---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Op from '../seqflow/Op.astro';
import Arrow from '../seqflow/Arrow.astro';
import Box from '../seqflow/Box.astro';
import Legend from '../seqflow/Legend.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Cost for n = 10,000 sentences, as in Reimers and Gurevych (2019): every pair through the cross-encoder, or every sentence once.
const n = 10000, pairs = (n * (n - 1)) / 2;
if (pairs !== 49995000) throw new Error('PairEncoders: the pair count drifted from the note');
const t = ru
  ? { a: '(а) кросс-энкодер: пара читается вместе', b: '(б) би-энкодер: каждое предложение отдельно', enc: 'энкодер', shared: 'общие веса', head: 'голова на [CLS]', score: 'оценка', mean: 'mean', costA: `${pairs.toLocaleString('ru-RU').replace(/ /g, ' ')} проходов на 10 000 предложений`, costA2: 'около 65 часов', costB: '10 000 проходов, затем косинусы', costB2: 'около 5 секунд', train: 'обучение на NLI: softmax(W [u; v; |u − v|])' }
  : { a: '(a) cross-encoder: the pair is read together', b: '(b) bi-encoder: each sentence on its own', enc: 'encoder', shared: 'shared weights', head: 'head on [CLS]', score: 'score', mean: 'mean', costA: `${pairs.toLocaleString('en-US')} passes for 10,000 sentences`, costA2: 'about 65 hours', costB: '10,000 passes, then cosines', costB2: 'about 5 seconds', train: 'NLI training: softmax(W [u; v; |u − v|])' };
const id = 'sentence-pair-encoders';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 380, pa: [0, 0], pb: [400, 0], legend: [8, 370] },
  { cls: 'fig-narrow seq-narrow', W: 370, H: 780, pa: [0, 0], pb: [0, 360], legend: [8, 746] },
];
const chips = [['[CLS]', 'n', 50], ['a', 'x', 62], ['[SEP]', 'n', 50], ['b', 'x', 62], ['[SEP]', 'n', 50]] as const;
---

<Figure
  id={id}
  title={ru ? 'Две архитектуры для пары предложений' : 'Two architectures for a sentence pair'}
  caption={ru
    ? '(а) Кросс-энкодер получает оба предложения в одном входе, и в каждом слое каждый токен одного предложения может смотреть на каждый токен другого; голова на позиции [CLS] выдаёт класс или оценку. Это точнее, но каждая пара требует отдельного прохода: для 10 000 предложений — 49 995 000 проходов, около 65 часов в измерении Reimers и Gurevych (2019). (б) Би-энкодер (Sentence-BERT) прогоняет каждое предложение отдельно через один и тот же энкодер и усредняет векторы токенов в u и v; при обучении на NLI классификатор смотрит на (u, v, |u − v|), а при использовании пары сравниваются косинусом. 10 000 предложений — это 10 000 проходов, около 5 секунд, а дальше только скалярные произведения.'
    : '(a) A cross-encoder gets both sentences in one input, and in every layer every token of one sentence can look at every token of the other; a head on the [CLS] position outputs a class or a score. It is more accurate, but every pair needs its own pass: 49,995,000 passes for 10,000 sentences, about 65 hours in the measurement of Reimers and Gurevych (2019). (b) A bi-encoder (Sentence-BERT) runs each sentence through the same encoder separately and averages its token vectors into u and v; in NLI training a classifier looks at (u, v, |u − v|), and at use time pairs are compared by cosine. 10,000 sentences are 10,000 passes, about 5 seconds, followed by dot products only.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Кросс-энкодер и би-энкодер' : 'Cross-encoder and bi-encoder'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Слева один энкодер читает [CLS] a [SEP] b [SEP], линии внимания соединяют токены двух предложений, голова на [CLS] выдаёт оценку. Справа два одинаковых энкодера читают a и b отдельно, усреднение даёт векторы u и v, которые сравниваются косинусом.'
        : 'Left, one encoder reads [CLS] a [SEP] b [SEP], attention lines connect the tokens of the two sentences, and a head on [CLS] outputs a score. Right, two copies of one encoder read a and b separately, averaging gives the vectors u and v, and they are compared by cosine.'}</desc>
      <g transform={`translate(${L.pa[0]} ${L.pa[1]})`}>
        <text class="f-small f-t-muted" x="8" y="16">{t.a}</text>
        {(() => {
          let x = 22;
          const pos = chips.map(([, , w]) => { const p = x; x += w + 6; return p; });
          return (
            <g>
              {chips.map(([lab, tone, w], i) => <Vec x={pos[i]} y={270} values={[lab]} tone={tone} cw={w} />)}
              {chips.map(([, , w], i) => <Arrow pts={[[pos[i] + w / 2, 270], [pos[i] + w / 2, 226]]} />)}
              <rect x="16" y="150" width="300" height="74" rx="9" style="fill: var(--fig-blue); fill-opacity: 0.08; stroke: var(--fig-blue); stroke-width: 1.3" />
              <text class="f-small f-t-blue f-halo" x="26" y="168">{t.enc}</text>
              {[1, 3].map((i) => [1, 3].map((j) => <path class="f-thin f-amber" d={`M ${pos[i] + 31} 220 C ${pos[i] + 31} 186, ${pos[j] + 31} 186, ${pos[j] + 31} 158`} />))}
              <path class="f-thin f-amber" d={`M ${pos[1] + 31} 220 C ${pos[1] + 60} 190, ${pos[3]} 190, ${pos[3] + 31} 158`} />
              <path class="f-thin f-amber" d={`M ${pos[3] + 31} 220 C ${pos[3]} 190, ${pos[1] + 60} 190, ${pos[1] + 31} 158`} />
              <Arrow pts={[[pos[0] + 25, 150], [pos[0] + 25, 112]]} />
              <Box x={pos[0] - 6} y={78} w={120} h={32} label={t.head} tone="g" />
              <Arrow pts={[[pos[0] + 25, 78], [pos[0] + 25, 54]]} />
              <Vec x={pos[0]} y={30} values={[t.score]} tone="y" cw={80} />
              <text class="f-small" x="8" y="320">{t.costA}</text>
              <text class="f-small f-t-red" x="8" y="340">{t.costA2}</text>
            </g>
          );
        })()}
      </g>
      <g transform={`translate(${L.pb[0]} ${L.pb[1]})`}>
        <text class="f-small f-t-muted" x="8" y="16">{t.b}</text>
        {[{ x: 40, s: 'a', v: 'u' }, { x: 220, s: 'b', v: 'v' }].map((c) => (
          <g>
            <Vec x={c.x} y={270} values={[c.s]} tone="x" cw={80} />
            <Arrow pts={[[c.x + 40, 270], [c.x + 40, 226]]} />
            <Box x={c.x - 10} y={170} w={100} h={54} label={t.enc} tone="h" />
            <Arrow pts={[[c.x + 40, 170], [c.x + 40, 145]]} />
            <Op x={c.x + 40} y={132} sym={t.mean} />
            <Arrow pts={[[c.x + 40, 119], [c.x + 40, 104]]} />
            <Vec x={c.x + 18} y={60} values={['', '']} tone="h" cw={22} dir="row" label={c.v} labelPos="left" />
          </g>
        ))}
        <text class="f-small f-t-muted" x="170" y="202" text-anchor="middle">{t.shared}</text>
        <path class="f-thin f-muted f-dash" d="M 92 196 H 128 M 212 196 H 248" />
        <Arrow pts={[[80, 60], [80, 40], [146, 40]]} />
        <Arrow pts={[[260, 60], [260, 40], [194, 40]]} />
        <Op x={170} y={40} sym="cos" />
        <text class="f-small f-t-amber" x="8" y="316">{t.train}</text>
        <text class="f-small" x="8" y="336">{t.costB}</text>
        <text class="f-small f-t-green" x="8" y="356">{t.costB2}</text>
      </g>
      <Legend x={L.legend[0]} y={L.legend[1]} step={L.cls === 'fig-wide' ? 130 : 180} rows={L.cls === 'fig-wide' ? 1 : 2} />
    </svg>
  ))}
</Figure>
