---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
const base = ru ? '/ru/notes/nlp/' : '/notes/nlp/';

// The line of the course: each method, the failure that motivates the next one, and the note it links to.
type Step = { name: string; fails?: string; slug: string };
const steps: Step[] = ru
  ? [
      { name: 'Мешок слов, TF-IDF', fails: 'теряется порядок слов', slug: 'bag-of-words-and-tf-idf' },
      { name: 'N-граммные модели', fails: 'похожие слова не делят статистику', slug: 'n-gram-language-models' },
      { name: 'Эмбеддинги Word2Vec', fails: 'один вектор на слово при любом контексте', slug: 'word2vec' },
      { name: 'RNN, LSTM, GRU', fails: 'по одному токену; далёкое забывается', slug: 'recurrent-networks' },
      { name: 'Sequence-to-sequence', fails: 'весь вход сжат в один вектор', slug: 'seq2seq' },
      { name: 'Внимание поверх RNN', fails: 'энкодер всё ещё читает по одному токену', slug: 'attention-before-transformers' },
      { name: 'Трансформер', fails: 'обучается с нуля под каждую задачу', slug: 'transformers' },
      { name: 'Предобучение: BERT, GPT', fails: 'качество задают цель, данные и масштаб', slug: 'bert' },
      { name: 'Масштаб, данные, FlashAttention, MoE', fails: 'продолжает текст, а не решает задачу', slug: 'scaling-laws' },
      { name: 'Дообучение, PEFT', fails: 'модель на задачу; не следует инструкциям', slug: 'fine-tuning' },
      { name: 'Инструкции, RLHF, DPO', fails: 'большая и медленная в работе', slug: 'instruction-tuning' },
      { name: 'Квантизация', fails: 'знает только данные обучения, не действует', slug: 'quantization' },
      { name: 'RAG, инструменты, агенты', fails: 'модель внутри всё ещё пишет слева направо', slug: 'rag' },
      { name: 'Текстовая диффузия', slug: 'text-diffusion' },
    ]
  : [
      { name: 'Bag of words, TF-IDF', fails: 'word order is lost', slug: 'bag-of-words-and-tf-idf' },
      { name: 'N-gram language models', fails: 'similar words share no statistics', slug: 'n-gram-language-models' },
      { name: 'Word2Vec embeddings', fails: 'one vector per word, whatever the context', slug: 'word2vec' },
      { name: 'RNN, LSTM, GRU', fails: 'one token at a time; distant words fade', slug: 'recurrent-networks' },
      { name: 'Sequence-to-sequence', fails: 'the whole source squeezed into one vector', slug: 'seq2seq' },
      { name: 'Attention over RNN states', fails: 'the encoder still reads one token at a time', slug: 'attention-before-transformers' },
      { name: 'Transformer', fails: 'trained from scratch for every task', slug: 'transformers' },
      { name: 'Pretrained: BERT, GPT', fails: 'quality set by objective, data and scale', slug: 'bert' },
      { name: 'Scaling, data, FlashAttention, MoE', fails: 'a base model continues text, not a task', slug: 'scaling-laws' },
      { name: 'Fine-tuning, PEFT', fails: 'one model per task; ignores instructions', slug: 'fine-tuning' },
      { name: 'Instruction tuning, RLHF, DPO', fails: 'large and slow to run', slug: 'instruction-tuning' },
      { name: 'Quantization', fails: 'knows only its training data, cannot act', slug: 'quantization' },
      { name: 'RAG, tools, agents', fails: 'the model inside still writes left to right', slug: 'rag' },
      { name: 'Text diffusion', slug: 'text-diffusion' },
    ];

// Wide: method boxes in a column, the failure in red to the right of each box.
// Narrow: full-width boxes with the failure underneath.
interface Layout { cls: string; w: number; boxX: number; boxW: number; boxH: number; step: number; failX: number; failDy: number; failCls: string; top: number; arrowX?: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', w: 720, boxX: 20, boxW: 300, boxH: 30, step: 46, failX: 336, failDy: 20, failCls: 'f-note', top: 14 },
  { cls: 'fig-narrow', w: 360, boxX: 12, boxW: 336, boxH: 30, step: 68, failX: 42, failDy: 50, failCls: 'f-small', top: 14, arrowX: 26 },
];
const id = 'nlp-course-chain';
---

<Figure
  id={id}
  title={ru ? 'Линия курса: большинство методов отвечает на провал предыдущего' : 'The line of the course: most methods answer a failure of the previous one'}
  caption={ru
    ? 'Курс идёт сверху вниз. Синим — метод, красным — то, в чём он проваливается; эта проблема и вводит следующий метод. Подсчёт слов теряет порядок, n-граммы видят порядок, но не сходство слов, векторы слов дают сходство, но не контекст, и так далее: предобучение и его масштаб, адаптация, постобучение, дешёвый запуск и системы вокруг языковой модели. Последняя стрелка — ответвление, а не исправление: текстовая диффузия меняет порядок порождения самой модели и не связана с тем, что делают поиск или инструменты. Каждый блок ведёт на свою заметку.'
    : 'The course runs from top to bottom. Each method is in blue and the way it fails is in red; that failure introduces the next method. Counting words loses order, n-grams keep order but not word similarity, word vectors give similarity but not context, and so on through pretraining and its scale, adaptation, post-training and cheap inference to systems built around a language model. The last arrow is a branch, not a repair: text diffusion changes the order in which the model itself generates, which has nothing to do with what retrieval or tools add. Each box links to its note.'}
>
  {layouts.map((L) => {
    const h = L.top + steps.length * L.step + 4;
    const cx = L.boxX + L.boxW / 2;
    const ax = L.arrowX ?? cx;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.w} ${h}`} role="img" aria-labelledby={`${id}-${L.w}-t ${id}-${L.w}-d`}>
        <title id={`${id}-${L.w}-t`}>{ru ? 'Цепочка методов курса NLP' : 'Chain of methods in the NLP course'}</title>
        <desc id={`${id}-${L.w}-d`}>{ru
          ? 'Одиннадцать блоков сверху вниз: мешок слов, n-граммные модели, Word2Vec, рекуррентные сети, sequence-to-sequence, внимание поверх RNN, трансформер, предобученные модели, дообучение и квантизация, RAG и агенты, текстовая диффузия. Рядом с каждым блоком, кроме последнего, красным написано, в чём метод проваливается; стрелка ведёт к следующему методу.'
          : 'Eleven boxes from top to bottom: bag of words, n-gram models, Word2Vec, recurrent networks, sequence-to-sequence, attention over RNN states, the Transformer, pretrained models, fine-tuning and quantization, RAG and agents, text diffusion. Next to every box except the last, red text says how the method fails; an arrow leads to the next method.'}</desc>
        {steps.map((s, i) => {
          const y = L.top + i * L.step;
          const last = i === steps.length - 1;
          return (
            <g>
              <a href={`${base}${s.slug}`}>
                <rect class={last ? 'f-fill-green' : 'f-fill-blue'} x={L.boxX} y={y} width={L.boxW} height={L.boxH} rx="6" />
                <rect class={`f-thin ${last ? 'f-green' : 'f-blue'}`} x={L.boxX} y={y} width={L.boxW} height={L.boxH} rx="6" fill="none" />
                <text class={`f-label ${last ? 'f-t-green' : 'f-t-blue'}`} x={cx} y={y + L.boxH / 2 + 5} text-anchor="middle">{s.name}</text>
              </a>
              {s.fails && <text class={`${L.failCls} f-t-red`} x={L.failX} y={y + L.failDy}>{s.fails}</text>}
              {!last && <path class="f-line f-muted" d={`M ${ax} ${y + L.boxH + 2} V ${y + L.step - 3}`} marker-end="url(#f-arrow-muted)" />}
            </g>
          );
        })}
      </svg>
    );
  })}
</Figure>
