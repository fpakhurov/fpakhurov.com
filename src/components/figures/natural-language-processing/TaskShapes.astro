---
import Figure from '../Figure.astro';
import Sub from '../generative-modeling/Sub.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The four shapes of NLP tasks: one example per shape. `out` is drawn after an arrow
// (a label, a translation, a next token); `tags` is drawn under the tokens, one per token.
type Row = { title: string; formula: string; tokens: string[]; out?: string[]; tags?: string[]; outNote?: string };
const rows: Row[] = ru
  ? [
      { title: '1. Текст → метка', formula: 'p(y | x)', tokens: ['акции', 'растут', 'после', 'снижения', 'ставки'], out: ['Бизнес'] },
      { title: '2. Метка на каждый токен', formula: 'p(y_1 … y_T | x)', tokens: ['Обама', 'посетил', 'Париж', '.'], tags: ['B-PER', 'O', 'B-LOC', 'O'] },
      { title: '3. Текст → текст', formula: 'p(y_1 … y_m | x)', tokens: ['Ein', 'Mann', 'liest', '.'], out: ['Мужчина', 'читает', '.'] },
      { title: '4. Продолжение текста', formula: 'p(w_t | w_{<t})', tokens: ['кот', 'сел', 'на'], out: ['коврик'], outNote: 'следующий токен' },
    ]
  : [
      { title: '1. Text → label', formula: 'p(y | x)', tokens: ['stocks', 'rally', 'after', 'rate', 'cut'], out: ['Business'] },
      { title: '2. Label per token', formula: 'p(y_1 … y_T | x)', tokens: ['Obama', 'visited', 'Paris', '.'], tags: ['B-PER', 'O', 'B-LOC', 'O'] },
      { title: '3. Text → text', formula: 'p(y_1 … y_m | x)', tokens: ['Ein', 'Mann', 'liest', '.'], out: ['A', 'man', 'reads', '.'] },
      { title: '4. Text continued', formula: 'p(w_t | w_{<t})', tokens: ['the', 'cat', 'sat', 'on', 'the'], out: ['mat'], outNote: 'next token' },
    ];

interface Layout { cls: string; w: number; charW: number; pad: number; gap: number; boxH: number; tokCls: string; stack: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', w: 720, charW: 8.4, pad: 16, gap: 6, boxH: 30, tokCls: 'f-label', stack: false },
  { cls: 'fig-narrow', w: 360, charW: 7.8, pad: 12, gap: 4, boxH: 26, tokCls: 'f-small', stack: true },
];
const width = (L: Layout, s: string) => Math.round(Math.max(22, s.length * L.charW + L.pad));
const place = (L: Layout, words: string[], x0: number) => {
  let x = x0;
  return words.map((t) => { const w = width(L, t); const box = { t, x, w }; x += w + L.gap; return box; });
};
const end = (boxes: { x: number; w: number }[]) => boxes[boxes.length - 1].x + boxes[boxes.length - 1].w;

// Vertical plan: each row has a title line, the token line, and an optional second line
// (tags under the tokens, or, in the narrow layout, the output under the input).
const plan = (L: Layout) => {
  let y = 34;
  return rows.map((r) => {
    const titleY = y;
    const tokY = y + 14;
    const tokens = place(L, r.tokens, 12);
    let outBoxes: { t: string; x: number; w: number }[] = [];
    let outY = tokY;
    let arrow = '';
    let second = false;
    if (r.tags) {
      outBoxes = tokens.map((b, i) => ({ t: r.tags![i], x: b.x, w: b.w }));
      outY = tokY + L.boxH + 30;
      second = true;
    } else if (r.out) {
      const inline = !L.stack || end(tokens) + 40 + r.out.reduce((s, t) => s + width(L, t) + L.gap, 0) < L.w - 12;
      if (inline) {
        const ax = end(tokens) + 8;
        outBoxes = place(L, r.out, ax + 38);
        arrow = `M ${ax} ${tokY + L.boxH / 2} H ${ax + 32}`;
      } else {
        outY = tokY + L.boxH + 30;
        outBoxes = place(L, r.out, 12);
        arrow = `M 30 ${tokY + L.boxH + 4} V ${outY - 4}`;
        second = true;
      }
    }
    const bottom = (second ? outY : tokY) + L.boxH + (r.outNote ? 18 : 0);
    y = bottom + 34;
    return { r, titleY, tokY, tokens, outBoxes, outY, arrow, bottom };
  });
};
const plans = layouts.map((L) => ({ L, rowsPlan: plan(L) }));
const id = 'nlp-task-shapes';
---

<Figure
  id={id}
  title={ru ? 'Четыре формы задач NLP' : 'The four shapes of NLP tasks'}
  caption={ru
    ? 'Каждая задача курса принимает одну из четырёх форм. Классификация даёт одну метку на весь текст (тема новости из AG News). Разметка даёт метку каждому токену: B-PER и B-LOC открывают имя человека и название места. Перевод и суммаризация порождают новую последовательность по входной. Языковая модель предсказывает следующий токен по предыдущим, и через неё можно записать три остальные формы, если задачу оформить как продолжение подсказки. Справа — вероятность, которую моделирует каждая форма; синим — вход, зелёным — то, что предсказывает модель.'
    : 'Every task in the course takes one of four shapes. Classification gives one label for the whole text (the topic of an AG News item). Tagging gives a label to every token: B-PER and B-LOC begin a person and a location. Translation and summarization produce a new sequence from the input. A language model predicts the next token from the previous ones, and the other three shapes can be written through it by phrasing the task as the continuation of a prompt. On the right is the probability each shape models; the input is blue and what the model predicts is green.'}
>
  {plans.map(({ L, rowsPlan }) => {
    const h = rowsPlan[rowsPlan.length - 1].bottom + 14;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.w} ${h}`} role="img" aria-labelledby={`${id}-${L.w}-t ${id}-${L.w}-d`}>
        <title id={`${id}-${L.w}-t`}>{ru ? 'Четыре формы задач NLP с примерами' : 'Four shapes of NLP tasks with examples'}</title>
        <desc id={`${id}-${L.w}-d`}>{ru
          ? 'Четыре строки. Первая: слова новостного заголовка в синих прямоугольниках, стрелка к одной зелёной метке «Бизнес». Вторая: слова «Обама посетил Париж», под каждым словом зелёная метка B-PER, O, B-LOC, O. Третья: немецкое предложение и стрелка к его переводу. Четвёртая: начало фразы и стрелка к следующему токену. Рядом с каждой строкой — формула вероятности, которую моделирует задача.'
          : 'Four rows. First: the words of a news headline in blue boxes and an arrow to one green label, Business. Second: the words Obama visited Paris with a green tag under each word, B-PER, O, B-LOC, O. Third: a German sentence and an arrow to its translation. Fourth: the start of a phrase and an arrow to the next token. Next to each row is the formula of the probability the task models.'}</desc>
        {rowsPlan.map((p) => (
          <g>
            <text class="f-title" x="12" y={p.titleY}>{p.r.title}</text>
            <text class="f-math" x={L.w - 12} y={p.titleY} text-anchor="end"><Sub label={p.r.formula} /></text>
            {p.tokens.map((b) => (
              <g>
                <rect class="f-fill-blue" x={b.x} y={p.tokY} width={b.w} height={L.boxH} rx="5" />
                <rect class="f-thin f-blue" x={b.x} y={p.tokY} width={b.w} height={L.boxH} rx="5" fill="none" />
                <text class={L.tokCls} x={b.x + b.w / 2} y={p.tokY + L.boxH / 2 + 5} text-anchor="middle">{b.t}</text>
              </g>
            ))}
            {p.r.tags && p.tokens.map((b) => <path class="f-thin f-muted" d={`M ${b.x + b.w / 2} ${p.tokY + L.boxH + 2} V ${p.outY - 4}`} marker-end="url(#f-arrow-muted)" />)}
            {p.arrow && <path class="f-line f-muted" d={p.arrow} marker-end="url(#f-arrow-muted)" />}
            {p.outBoxes.map((b) => (
              <g>
                <rect class="f-fill-green" x={b.x} y={p.outY} width={b.w} height={L.boxH} rx="5" />
                <rect class="f-thin f-green" x={b.x} y={p.outY} width={b.w} height={L.boxH} rx="5" fill="none" />
                <text class={`${L.tokCls} f-t-green`} x={b.x + b.w / 2} y={p.outY + L.boxH / 2 + 5} text-anchor="middle">{b.t}</text>
              </g>
            ))}
            {p.r.outNote && p.outBoxes.length > 0 && (
              <text class="f-small f-t-muted" x={p.outBoxes[0].x} y={p.outY + L.boxH + 15}>{p.r.outNote}</text>
            )}
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
