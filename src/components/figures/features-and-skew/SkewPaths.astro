---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One feature, two paths: a batch job computes it over history for training, a service computes it per request for
// serving. Skew enters in three places: the two implementations (code), the two sources (data), and a training row
// that sees a value that was not yet known at prediction time (time). Logging the served values closes all three.
const t = ru
  ? {
      title: 'Один признак, два пути: где возникает расхождение обучения и инференса',
      train: 'обучение', serve: 'инференс',
      wh: 'хранилище', whSub: 'история, дозагрузки',
      batch: 'пакетный расчёт', batchSub: 'SQL, раз в сутки',
      table: 'обучающая таблица', tableSub: 'признаки + метки',
      fit: 'обучение', fitSub: 'модель v3',
      req: 'живой запрос', reqSub: 'user 7, сейчас',
      online: 'онлайн-расчёт', onlineSub: 'код в сервисе',
      vec: 'вектор признаков', vecSub: 'уходит в модель',
      pred: 'инференс', predSub: 'предсказание',
      code: 'код: две реализации', data: 'данные: разные источники',
      time: 'время: значения, известные позже', log: 'логировать то, что получила модель',
      steps: [
        'обучение: пакетная задача считает признаки по истории хранилища и соединяет их с метками',
        'инференс: сервис считает те же признаки для одного живого запроса',
        'расхождение кода: две реализации по-разному обрабатывают пропуск, единицы или крайний случай',
        'расхождение данных: источники различаются — дозаполненная история, выборка логов, неудачные обращения к справочникам',
        'расхождение во времени: обучающая строка получает значение, которого в момент прогноза ещё не было',
        'общее лекарство: логировать признаки в том виде, в каком их получила модель, и обучаться на логах',
      ],
      desc: 'Сверху путь обучения: хранилище, пакетный расчёт, обучающая таблица, обучение. Снизу путь инференса: живой запрос, онлайн-расчёт, вектор признаков, предсказание. Между путями отмечены три вида расхождения: разные источники данных, две реализации кода и значения из будущего в обучающей таблице. Зелёная стрелка от вектора признаков к обучающей таблице — логирование поданных значений.',
    }
  : {
      title: 'One feature, two paths: where training–serving skew enters',
      train: 'training', serve: 'serving',
      wh: 'warehouse', whSub: 'history, backfills',
      batch: 'batch features', batchSub: 'SQL job, nightly',
      table: 'training table', tableSub: 'features + labels',
      fit: 'training', fitSub: 'model v3',
      req: 'live request', reqSub: 'user 7, now',
      online: 'online features', onlineSub: 'code in the service',
      vec: 'feature vector', vecSub: 'sent to the model',
      pred: 'serving', predSub: 'prediction',
      code: 'code: two implementations', data: 'data: different sources',
      time: 'time: values known only later', log: 'log what was served',
      steps: [
        'training: a batch job computes the features over the warehouse history and joins them with labels',
        'serving: a service computes the same features for one live request',
        'code skew: the two implementations treat a missing value, a unit or an edge case differently',
        'data skew: the sources differ: backfilled history, sampled logs, failed lookups',
        'time skew: a training row picks up a value that was not yet known at prediction time',
        'the cure for all three: log the features as the model received them and train on the logs',
      ],
      desc: 'Top: the training path, from the warehouse through batch features and the training table to training. Bottom: the serving path, from a live request through online features and the feature vector to a prediction. Between the paths, three kinds of skew are marked: different data sources, two implementations of the code, and values from the future in the training table. A green arrow from the feature vector to the training table is the logging of served values.',
    };
const id = 'skew-paths';
const caption = ru
  ? 'Модель видит признак дважды: при обучении он посчитан пакетной задачей по истории (1), при инференсе — сервисом по одному запросу (2). Если пути расходятся, модель обучена на одних значениях, а получает другие. Код расходится, когда признак написан дважды (3); данные — когда история и живой поток приходят из разных мест (4); время — когда обучающей строке достаётся значение, появившееся после момента прогноза (5). Логирование признаков в момент инференса (6) по построению делает значения при обучении равными тем, что получила модель.'
  : 'The model meets a feature twice: in training, computed by a batch job over history (1); in serving, computed by a service for one request (2). Where the paths differ, the model is trained on one set of values and served another. Code differs when the feature is written twice (3); data, when history and the live stream come from different places (4); time, when a training row gets a value that appeared after the moment of prediction (5). Logging the features at serving time (6) makes the training values equal to the served ones by construction.';

// Label widths: f-label about 7.5 px per character (8.0 narrow), f-small 6.5 (7.3 narrow).
const fits = (s: string, room: number, px: number) => {
  if (s.length * px > room) throw new Error(`"${s}" needs ${Math.round(s.length * px)} px, has ${room}`);
};
// Wide: columns of boxes and the gaps the marker labels run in.
const cols = [{ x: 16, w: 150 }, { x: 206, w: 176 }, { x: 422, w: 150 }, { x: 612, w: 132 }];
cols.forEach((c, i) => { if (i && c.x - (cols[i - 1].x + cols[i - 1].w) < 36) throw new Error('arrow gap'); });
const top = [[t.wh, t.whSub], [t.batch, t.batchSub], [t.table, t.tableSub], [t.fit, t.fitSub]];
const bot = [[t.req, t.reqSub], [t.online, t.onlineSub], [t.vec, t.vecSub], [t.pred, t.predSub]];
[top, bot].forEach((row) => row.forEach(([l, s], i) => { fits(l, cols[i].w - 12, 7.5); fits(s, cols[i].w - 12, 6.5); fits(l, 150 - 10, 8.0); fits(s, 150 - 10, 7.3); }));
const mid = (i: number) => cols[i].x + cols[i].w / 2;
// Marker labels in the wide layout start 8 px right of their line and must end before the next marker.
fits(t.data, mid(1) - 8 - (mid(0) + 8), 6.5);
fits(t.code, mid(2) - 8 - (mid(1) + 8), 6.5);
fits(t.log, 760 - 8 - (mid(2) + 8), 6.5);
fits(t.time, 760 - 24 - cols[2].x, ru ? 7.6 : 6.5);
// Narrow: every marker label is centred and may use the full width.
for (const s of [t.data, t.code, t.time, t.log]) fits(s, 340, 7.3);
const yA = 52, yB = 222, h = 50;
// Narrow layout rows.
const nx = [10, 200], nw = 150, ny = [56, 166, 276, 386];
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 296" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <g data-s="1">
      {top.map(([l, s], i) => <Box x={cols[i].x} y={yA} w={cols[i].w} h={h} label={l} sub={s} tone={i === 3 ? 'y' : i === 0 ? 'x' : 'h'} />)}
      {cols.slice(1).map((c, i) => <Arrow pts={[[cols[i].x + cols[i].w + 2, yA + h / 2], [c.x - 2, yA + h / 2]]} />)}
      <text class="f-small f-t-muted" x={cols[0].x} y={yA - 26} style="font-weight: 650">{t.train}</text>
      <Badge x={cols[0].x + cols[0].w} y={yA} n={1} />
    </g>
    <g data-s="2">
      {bot.map(([l, s], i) => <Box x={cols[i].x} y={yB} w={cols[i].w} h={h} label={l} sub={s} tone={i === 3 ? 'y' : i === 0 ? 'x' : 'h'} />)}
      {cols.slice(1).map((c, i) => <Arrow pts={[[cols[i].x + cols[i].w + 2, yB + h / 2], [c.x - 2, yB + h / 2]]} />)}
      <text class="f-small f-t-muted" x={cols[0].x} y={yB + h + 22} style="font-weight: 650">{t.serve}</text>
      <Badge x={cols[0].x + cols[0].w} y={yB} n={2} />
    </g>
    <g data-s="3">
      <path class="f-line f-amber f-dash" d={`M ${mid(1)} ${yA + h + 4} L ${mid(1)} ${yB - 4}`} />
      <text class="f-small f-t-amber f-halo" x={mid(1) + 8} y={(yA + h + yB) / 2 + 4} style="font-weight: 650">{t.code}</text>
      <Badge x={mid(1)} y={(yA + h + yB) / 2 - 22} n={3} />
    </g>
    <g data-s="4">
      <path class="f-line f-amber f-dash" d={`M ${mid(0)} ${yA + h + 4} L ${mid(0)} ${yB - 4}`} />
      <text class="f-small f-t-amber f-halo" x={mid(0) + 8} y={(yA + h + yB) / 2 + 4} style="font-weight: 650">{t.data}</text>
      <Badge x={mid(0)} y={(yA + h + yB) / 2 - 22} n={4} />
    </g>
    <g data-s="5">
      <rect x={cols[2].x - 5} y={yA - 5} width={cols[2].w + 10} height={h + 10} rx="10" style="fill: none; stroke: var(--fig-amber); stroke-width: 1.5; stroke-dasharray: 6 4" />
      <text class="f-small f-t-amber" x={cols[2].x - 5} y={yA - 13} style="font-weight: 650">{t.time}</text>
      <Badge x={cols[2].x - 5 + t.time.length * (ru ? 7.6 : 6.5) + 14} y={yA - 17} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[mid(2), yB - 2], [mid(2), yA + h + 7]]} tone="green" bold />
      <text class="f-small f-t-green f-halo" x={mid(2) + 8} y={(yA + h + yB) / 2 + 4} style="font-weight: 650">{t.log}</text>
      <Badge x={mid(2)} y={(yA + h + yB) / 2 - 22} n={6} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 452" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <g data-s="1">
      <text class="f-small f-t-muted" x={nx[0] + nw / 2} y="22" text-anchor="middle" style="font-weight: 650">{t.train}</text>
      {top.map(([l, s], i) => <Box x={nx[0]} y={ny[i]} w={nw} h={h} label={l} sub={s} tone={i === 3 ? 'y' : i === 0 ? 'x' : 'h'} />)}
      {ny.slice(1).map((y, i) => <Arrow pts={[[nx[0] + 30, ny[i] + h + 2], [nx[0] + 30, y - 2]]} />)}
      <Badge x={nx[0] + nw} y={ny[0]} n={1} />
    </g>
    <g data-s="2">
      <text class="f-small f-t-muted" x={nx[1] + nw / 2} y="22" text-anchor="middle" style="font-weight: 650">{t.serve}</text>
      {bot.map(([l, s], i) => <Box x={nx[1]} y={ny[i]} w={nw} h={h} label={l} sub={s} tone={i === 3 ? 'y' : i === 0 ? 'x' : 'h'} />)}
      {ny.slice(1).map((y, i) => <Arrow pts={[[nx[1] + nw - 30, ny[i] + h + 2], [nx[1] + nw - 30, y - 2]]} />)}
      <Badge x={nx[1] + nw} y={ny[0]} n={2} />
    </g>
    <g data-s="4">
      <path class="f-line f-amber f-dash" d={`M ${nx[0] + nw + 3} ${ny[0] + h / 2} L ${nx[1] - 3} ${ny[0] + h / 2}`} />
      <text class="f-small f-t-amber f-halo" x="180" y={ny[0] + h + 34} text-anchor="middle" style="font-weight: 650">{t.data}</text>
      <Badge x={180} y={ny[0] + h / 2 - 14} n={4} />
    </g>
    <g data-s="3">
      <path class="f-line f-amber f-dash" d={`M ${nx[0] + nw + 3} ${ny[1] + h / 2} L ${nx[1] - 3} ${ny[1] + h / 2}`} />
      <text class="f-small f-t-amber f-halo" x="180" y={ny[1] + h + 34} text-anchor="middle" style="font-weight: 650">{t.code}</text>
      <Badge x={180} y={ny[1] + h / 2 - 14} n={3} />
    </g>
    <g data-s="5">
      <rect x={nx[0] - 4} y={ny[2] - 4} width={nw + 8} height={h + 8} rx="10" style="fill: none; stroke: var(--fig-amber); stroke-width: 1.5; stroke-dasharray: 6 4" />
      <text class="f-small f-t-amber f-halo" x="180" y={ny[2] + h + 26} text-anchor="middle" style="font-weight: 650">{t.time}</text>
      <Badge x={nx[0]} y={ny[2] - 4} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[nx[1] - 2, ny[2] + h / 2], [nx[0] + nw + 6, ny[2] + h / 2]]} tone="green" bold />
      <text class="f-small f-t-green f-halo" x="180" y={ny[2] + h + 46} text-anchor="middle" style="font-weight: 650">{t.log}</text>
      <Badge x={180} y={ny[2] + h / 2 - 14} n={6} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
