---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One user's feature "open support cases" over time, each value stamped with the day it became known, and three
// prediction times. The point-in-time join takes the last value known at or before each prediction time; the naive
// join takes the latest value in the table, which includes the cases opened just before the user left.
// Days are counted from 1 January 2026.
const updates = [{ day: 3, v: 1 }, { day: 20, v: 2 }, { day: 45, v: 1 }, { day: 64, v: 2 }, { day: 83, v: 6 }];
const leaves = 88;                                  // 30 March
const predictions = [14, 31, 59];                   // 15 January, 1 February, 1 March
const horizon = 30;
const label = predictions.map((t) => (leaves > t && leaves <= t + horizon ? 1 : 0));
const pit = predictions.map((t) => {
  const known = updates.filter((u) => u.day <= t);
  if (!known.length) throw new Error('no value known');
  return known[known.length - 1].v;
});
const naive = predictions.map(() => updates[updates.length - 1].v);
// The values quoted in the text and in the Example section.
if (pit.join() !== '1,2,1' || naive.join() !== '6,6,6' || label.join() !== '0,0,1') throw new Error(`pit ${pit} naive ${naive} label ${label}`);
const D = 95, vMax = 7;
const months = [{ day: 0, en: 'Jan', ru: 'янв' }, { day: 31, en: 'Feb', ru: 'фев' }, { day: 59, en: 'Mar', ru: 'мар' }, { day: 90, en: 'Apr', ru: 'апр' }];

const t = ru
  ? {
      title: 'Соединение на момент прогноза против наивного: какое значение получает каждая обучающая строка',
      y: 'открытые обращения', leaves: 'ушёл 30 мар', leavesN: 'ушёл', burst: 'заявки на отмену',
      rows: ['ушёл за 30 дней', 'на момент прогноза', 'наивное соединение'], rowsN: ['метка', 'на момент', 'наивное'],
      naive: 'наивно: сегодняшнее значение', naiveN: 'сегодняшнее',
      tl: ['t₁ = 15 янв', 't₂ = 1 фев', 't₃ = 1 мар'],
      steps: [
        'признак во времени: каждое значение помечено моментом, когда оно стало известно; 30 марта пользователь уходит',
        'три момента прогноза и их метки: ушёл ли пользователь в следующие 30 дней',
        'соединение на момент прогноза: последнее значение, известное к этому моменту, — 1, 2 и 1',
        'наивное соединение: сегодняшнее значение 6, включающее обращения перед уходом, достаётся каждой строке',
      ],
      desc: 'Ступенчатый график числа открытых обращений одного пользователя с января по март: 1, 2, 1, 2 и скачок до 6 за пять дней до ухода 30 марта. Три вертикальные линии — моменты прогноза 15 января, 1 февраля и 1 марта. Под графиком таблица: метки 0, 0, 1; соединение на момент прогноза даёт 1, 2, 1; наивное соединение даёт 6 во всех трёх строках.',
    }
  : {
      title: 'Point-in-time join against a naive join: the value each training row receives',
      y: 'open cases', leaves: 'leaves 30 Mar', leavesN: 'leaves', burst: 'cancellation requests',
      rows: ['churned in 30 days', 'point-in-time join', 'naive join'], rowsN: ['label', 'point-in-time', 'naive'],
      naive: 'naive: today’s value', naiveN: 'today’s value',
      tl: ['t₁ = 15 Jan', 't₂ = 1 Feb', 't₃ = 1 Mar'],
      steps: [
        'the feature over time: each value is stamped with the moment it became known; the user leaves on 30 March',
        'three prediction times and their labels: did the user leave within the next 30 days',
        'point-in-time join: the last value known at each prediction time, 1, 2 and 1',
        'naive join: today’s value, 6, which includes the cases opened before leaving, goes to every row',
      ],
      desc: 'A step plot of the number of open support cases of one user from January to March: 1, 2, 1, 2, and a jump to 6 five days before the user leaves on 30 March. Three vertical lines mark prediction times on 15 January, 1 February and 1 March. Below the plot, a table: the labels are 0, 0, 1; the point-in-time join gives 1, 2, 1; the naive join gives 6 in all three rows.',
    };
const id = 'point-in-time';
const caption = ru
  ? `Значения признака помечены моментом, когда они стали известны (1). Для каждой строки обучающей выборки, то есть пары «пользователь, момент прогноза» с меткой (2), соединение на момент прогноза берёт последнее значение, известное не позже этого момента: ${pit.join(', ')} (3). Наивное соединение по ключу пользователя берёт значение из сегодняшней таблицы, ${naive[0]}, во все строки (4): обучающие данные видят всплеск обращений перед уходом, которого в момент прогноза ещё не было, и модель учится на будущем. При инференсе модель получит значения из строки 3.`
  : `Feature values are stamped with the moment they became known (1). For every row of the training set, a pair of a user and a prediction time with its label (2), the point-in-time join takes the last value known at or before that time: ${pit.join(', ')} (3). A naive join on the user key takes the value from today’s table, ${naive[0]}, for every row (4): the training data see the burst of cases before leaving, which did not exist yet at prediction time, and the model learns from the future. At serving time the model will receive the values of row 3.`;

interface L { cls: string; W: number; H: number; x0: number; x1: number; yT: number; yB: number; rowY: number[]; sans: number; wide: boolean }
const layouts: L[] = [
  { cls: 'fig-wide', W: 760, H: 300, x0: 160, x1: 740, yT: 62, yB: 172, rowY: [218, 246, 274], sans: 6.5, wide: true },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 330, x0: 120, x1: 348, yT: 66, yB: 182, rowY: [234, 266, 298], sans: 7.3, wide: false },
];
const fits = (s: string, room: number, px: number) => {
  if (s.length * px > room) throw new Error(`"${s}" needs ${Math.round(s.length * px)} px, has ${room}`);
};
const geo = layouts.map((L) => {
  const x = (d: number) => L.x0 + (d / D) * (L.x1 - L.x0);
  const y = (v: number) => L.yB - (v / vMax) * (L.yB - L.yT);
  const rows = L.wide ? t.rows : t.rowsN;
  rows.forEach((r) => fits(r, L.x0 - 12 - 8, L.sans));
  fits(t.y, L.wide ? L.x0 - 6 - 8 : L.x0 + 20, L.sans);
  // prediction labels above the plot must not overlap one another
  const tl = L.wide ? t.tl : ['t₁', 't₂', 't₃'];
  for (let i = 1; i < tl.length; i++) {
    if (x(predictions[i - 1]) + (tl[i - 1].length * L.sans) / 2 + 6 > x(predictions[i]) - (tl[i].length * L.sans) / 2) throw new Error(`prediction labels at ${L.W}`);
  }
  // the leave label ends left of the leave line and right of the last prediction label
  const leaveText = L.wide ? t.leaves : t.leavesN;
  const leaveW = leaveText.length * L.sans;
  if (x(leaves) - 4 - leaveW < x(predictions[2]) + (tl[2].length * L.sans) / 2 + 4) throw new Error(`leave label at ${L.W}`);
  const naiveText = L.wide ? t.naive : t.naiveN;
  if (x(predictions[1]) + 6 + naiveText.length * L.sans > x(updates[4].day) - 4) throw new Error(`naive label at ${L.W}`);
  // a step path through the known values, from the first update until the user leaves
  let d = `M ${x(updates[0].day)} ${y(updates[0].v)}`;
  for (let i = 1; i < updates.length; i++) d += ` L ${x(updates[i].day)} ${y(updates[i - 1].v)} L ${x(updates[i].day)} ${y(updates[i].v)}`;
  d += ` L ${x(leaves)} ${y(updates[updates.length - 1].v)}`;
  return { x, y, rows, tl, d, naiveText, leaveText };
});
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L, li) => {
    const g = geo[li];
    const yLast = g.y(updates[updates.length - 1].v);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        {[0, 2, 4, 6].map((v) => (
          <g>
            <line class="f-grid" x1={L.x0} x2={L.x1} y1={g.y(v)} y2={g.y(v)} />
            <text class="f-small f-t-muted" x={L.x0 - 6} y={g.y(v) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        <line class="f-axis" x1={L.x0} x2={L.x1} y1={L.yB} y2={L.yB} />
        {months.map((m) => <text class="f-small f-t-muted" x={g.x(m.day)} y={L.yB + 16} text-anchor={m.day === 0 ? 'start' : 'middle'}>{ru ? m.ru : m.en}</text>)}
        <g data-s="1">
          <text class="f-small f-t-muted" x={L.wide ? L.x0 - 6 : 8} y={L.wide ? L.yT - 30 : L.yT - 48} text-anchor={L.wide ? 'end' : 'start'} style="font-weight: 650">{t.y}</text>
          <path class="f-line f-blue" d={g.d} />
          {updates.map((u) => <circle cx={g.x(u.day)} cy={g.y(u.v)} r="3.5" style="fill: var(--fig-blue)" />)}
          <path class="f-line f-red f-dash" d={`M ${g.x(leaves)} ${L.yT - 4} L ${g.x(leaves)} ${L.yB}`} />
          <text class="f-small f-t-red" x={g.x(leaves) - 4} y={L.yT - 8} text-anchor="end">{g.leaveText}</text>
          <text class="f-small f-t-muted f-halo" x={g.x(updates[4].day) - 6} y={g.y(4) + 4} text-anchor="end">{L.wide ? t.burst : ''}</text>
          <Badge x={g.x(updates[0].day)} y={g.y(updates[0].v) - 22} n={1} />
        </g>
        <g data-s="2">
          {predictions.map((p, i) => (
            <g>
              <path class="f-line f-muted f-dash" d={`M ${g.x(p)} ${L.yT - 22} L ${g.x(p)} ${L.rowY[2] + 8}`} />
              <text class="f-small f-halo" x={g.x(p)} y={L.yT - 28} text-anchor="middle" style="font-weight: 650">{g.tl[i]}</text>
              <text class="f-small f-halo" x={g.x(p)} y={L.rowY[0]} text-anchor="middle">{label[i]}</text>
            </g>
          ))}
          <text class="f-small f-t-muted" x={8} y={L.rowY[0]}>{g.rows[0]}</text>
          <Badge x={g.x(predictions[0]) - (L.wide ? 52 : 22)} y={L.yT - 32} n={2} />
        </g>
        <g data-s="3">
          {predictions.map((p, i) => (
            <g>
              <circle cx={g.x(p)} cy={g.y(pit[i])} r="6" style="fill: none; stroke: var(--fig-green); stroke-width: 2.2" />
              <text class="f-small f-t-green f-halo" x={g.x(p)} y={L.rowY[1]} text-anchor="middle" style="font-weight: 650">{pit[i]}</text>
            </g>
          ))}
          <text class="f-small f-t-green" x={8} y={L.rowY[1]} style="font-weight: 650">{g.rows[1]}</text>
          <Badge x={L.x0 - 2} y={L.rowY[1] - 4} n={3} />
        </g>
        <g data-s="4">
          <path class="f-line f-red f-dash" d={`M ${g.x(updates[4].day) - 4} ${yLast} L ${g.x(predictions[0]) + 2} ${yLast}`} marker-end="url(#f-arrow-red)" />
          <text class="f-small f-t-red f-halo" x={g.x(predictions[1]) + 6} y={yLast - 7} style="font-weight: 650">{g.naiveText}</text>
          {predictions.map((p) => (
            <text class="f-small f-t-red f-halo" x={g.x(p)} y={L.rowY[2]} text-anchor="middle" style="font-weight: 650">{naive[0]}</text>
          ))}
          <text class="f-small f-t-red" x={8} y={L.rowY[2]} style="font-weight: 650">{g.rows[2]}</text>
          <Badge x={L.x0 - 2} y={L.rowY[2] - 4} n={4} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
