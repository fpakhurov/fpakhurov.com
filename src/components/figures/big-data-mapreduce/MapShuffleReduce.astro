---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? "Ключ определяет получателя" : "The key determines the reducer";
const caption = ru ? "Map выдаёт пары продаж. Shuffle группирует их по магазину. Каждый reducer выдаёт сумму своего магазина." : "Map emits the sale pairs. The shuffle groups them by store. Each reducer outputs the sum for its store.";
const desc = ru ? "Двенадцать пар map распределяются по магазину. Получатель 0 даёт 800 копеек для магазина 1, получатель 1 — 550 для магазина 2." : "Twelve mapped pairs are shuffled by store. Reducer 0 gives 800 cents for store 1. Reducer 1 gives 550 for store 2.";
const phases = ru ? ['Map · 12 пар', 'Shuffle · по магазину'] : ['Map · 12 pairs', 'Shuffle · by store'];
---
<Figure id="bd-map-shuffle-reduce" title={title} caption={caption}>
  <svg viewBox="0 0 340 223" role="img" aria-labelledby="bd-map-shuffle-reduce-title bd-map-shuffle-reduce-desc" style="max-width: 550px; margin-inline: auto">
    <title id="bd-map-shuffle-reduce-title">{title}</title>
    <desc id="bd-map-shuffle-reduce-desc">{desc}</desc>
    {phases.map((label, i) => (
      <g transform={`translate(0 ${i * 59})`}>
        <rect class={i === 0 ? 'f-fill-blue' : 'f-fill-amber'} x="64" y="13" width="212" height="37" rx="5" />
        <text class="f-label" x="170" y="37" text-anchor="middle">{label}</text>
      </g>
    ))}
    <path class="f-line" d="M 170 52 V 69 M 166 65 L 170 69 L 174 65 M 117 111 L 85 147 M 223 111 L 255 147" fill="none" />
    {[800, 550].map((amount, i) => (
      <g transform={`translate(${i * 170} 0)`}>
        <rect class="f-fill-green" x="12" y="152" width="146" height="55" rx="5" />
        <text class="f-label" x="85" y="174" text-anchor="middle">Reduce {i}</text>
        <text class="f-label" x="85" y="195" text-anchor="middle">({i + 1}, {amount})</text>
      </g>
    ))}
  </svg>
</Figure>
