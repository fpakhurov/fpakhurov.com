---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
const copy = ru
  ? {
      title: 'У каждой фазы свой контракт',
      caption: 'Сумму заказа 101 меняет старый клиент. До переключения запись идёт через amount_cents, а триггер поддерживает total_cents.',
      desc: 'Сначала есть amount_cents. Во время перехода существуют оба столбца. После проверки и переключения остаётся total_cents.',
      stages: ['До изменения', 'Окно совместимости', 'После переключения'],
    }
  : {
      title: 'Each phase has a contract',
      caption: 'An old client changes the amount for order 101. Until cutover, writes go through amount_cents and the trigger maintains total_cents.',
      desc: 'The old column exists first. Both columns exist during the transition. After validation and cutover only total_cents remains.',
      stages: ['Before the change', 'Compatibility window', 'After cutover'],
    };
const values = ['amount_cents = 1300', 'amount_cents = total_cents = 1400', 'total_cents = 1400'];
---
<Figure id="db-migration-states" title={copy.title} caption={copy.caption}>
  <svg viewBox="0 0 352 236" role="img" aria-labelledby="db-migration-title db-migration-desc" style="max-width: 520px; margin-inline: auto">
    <title id="db-migration-title">{copy.title}</title>
    <desc id="db-migration-desc">{copy.desc}</desc>
    {values.map((value, i) => (
      <g transform={`translate(0 ${i * 76})`}>
        <text class="f-label" x="176" y="20" text-anchor="middle">{copy.stages[i]}</text>
        <rect class={i === 1 ? 'f-fill-amber' : 'f-fill-blue'} x="16" y="29" width="320" height="38" rx="8" />
        <text class="f-label" x="176" y="53" text-anchor="middle">{value}</text>
      </g>
    ))}
  </svg>
</Figure>
