---
import Figure from '../Figure.astro';

const ru = Astro.props.lang === 'ru';
const title = ru ? 'Два пути от имени к байтам' : 'Two paths from a name to bytes';
const caption = ru
  ? 'В HDFS клиент получает карту блоков и читает с DataNode. В S3 запрос ключа и диапазона возвращает байты через API.'
  : 'In HDFS the client obtains block locations and reads from DataNodes. In S3 the key and range request returns bytes through the API.';
const lanes = [
  {label: 'HDFS', steps: [ru ? 'Путь файла' : 'File path', 'NameNode', 'DataNodes']},
  {label: 'S3', steps: [ru ? 'Ключ' : 'Object key', 'GetObject', ru ? 'Диапазон' : 'Byte range']},
];
---
<Figure id="big-data-storage-paths" title={title} caption={caption}>
  <svg viewBox="0 0 340 145" role="img" aria-labelledby="storage-paths-title storage-paths-desc" style="max-width: 510px; margin-inline: auto">
    <title id="storage-paths-title">{title}</title>
    <desc id="storage-paths-desc">{caption}</desc>
    {lanes.map(({label, steps}, i) => (
      <g transform={`translate(0 ${i * 69})`}>
        <text class="f-label" x="7" y="20">{label}</text>
        {steps.map((step, j) => (
          <g transform={`translate(${6 + j * 114} 0)`}>
            <rect class={j === 2 ? 'f-fill-green' : 'f-fill-blue'} x="0" y="30" width="100" height="31" rx="5" />
            <text class="f-label" x="50" y="50" text-anchor="middle">{step}</text>
            {j < 2 && <path class="f-line" d="M 102 45 H 111 M 108 42 L 111 45 L 108 48" />}
          </g>
        ))}
      </g>
    ))}
  </svg>
</Figure>
