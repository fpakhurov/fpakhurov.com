---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The traced request of the note's Example: one agent span and four children, with the token counts and prices of the Example.
const PRICE: Record<string, [number, number]> = { 'small-2026-06': [0.2, 0.8], 'large-2026-08': [3.0, 15.0] }; // $ per 1M tokens
const CACHED = 0.1;
interface Span { name: string; child: boolean; start: number; dur: number; model?: string; tin?: number; cached?: number; tout?: number; ttft?: number; tone: string }
const spans: Span[] = [
  { name: 'invoke_agent support-triage', child: false, start: 0, dur: 2930, tone: 'muted' },
  { name: 'chat small-2026-06', child: true, start: 5, dur: 410, model: 'small-2026-06', tin: 1450, cached: 1200, tout: 22, tone: 'blue' },
  { name: 'execute_tool lookup_order', child: true, start: 420, dur: 180, tone: 'green' },
  { name: 'chat large-2026-08', child: true, start: 605, dur: 2240, model: 'large-2026-08', tin: 2600, cached: 1800, tout: 180, ttft: 450, tone: 'blue' },
  { name: 'guardrail output_policy', child: true, start: 2850, dur: 75, tone: 'amber' },
];
const cost = (s: Span) => {
  if (!s.model) return 0;
  const [pin, pout] = PRICE[s.model];
  return ((s.tin! - s.cached!) * pin + s.cached! * pin * CACHED + s.tout! * pout) / 1e6;
};
const costs = spans.map(cost);
const total = costs.reduce((a, b) => a + b, 0);
// Checks against the Example's printed trace.
if (Math.abs(costs[1] - 0.0000916) > 1e-9 || Math.abs(costs[3] - 0.00564) > 1e-9 || Math.abs(total - 0.0057316) > 1e-9) throw new Error(`LlmTrace: costs ${costs}`);
for (const s of spans.slice(1)) if (s.start < spans[0].start || s.start + s.dur > spans[0].start + spans[0].dur) throw new Error(`LlmTrace: ${s.name} outside its parent`);
for (let i = 2; i < spans.length; i++) if (spans[i].start < spans[i - 1].start + spans[i - 1].dur) throw new Error('LlmTrace: children overlap');
const big = spans[3];
if (big.ttft! + (big.tout! - 1) * 10 !== big.dur) throw new Error('LlmTrace: TTFT + 179 x 10 ms must be the 2240 ms of the call');
const shareCost = (100 * costs[3]) / total, shareTime = (100 * big.dur) / spans[0].dur;
if (Math.round(shareCost) !== 98 || Math.round(shareTime) !== 76) throw new Error(`LlmTrace: shares ${shareCost} ${shareTime}`);

const money = (v: number) => (v === 0 ? '' : `$${v.toFixed(6)}`);
const info = (s: Span, c: number, wide: boolean) => {
  const ms = ru ? `${s.dur} мс` : `${s.dur} ms`;
  if (!s.model) return ms;
  if (!wide) return s.ttft ? (ru ? `${ms}, первый токен ${s.ttft} мс · ${money(c)}` : `${ms}, first token ${s.ttft} ms · ${money(c)}`) : `${ms} · ${money(c)}`;
  const tok = ru ? `${s.tin} вх. (${s.cached} из кэша), ${s.tout} вых.` : `${s.tin} in (${s.cached} cached), ${s.tout} out`;
  return `${ms} · ${tok} · ${money(c)}`;
};
const t = ru
  ? { title: 'Трасса одного запроса к LLM-приложению', axis: 'мс от начала запроса', ttft: 'первый токен через 450 мс',
      total: `итого ${spans[0].dur} мс и $${total.toFixed(6)}: большая модель — ${Math.round(shareCost)}% стоимости и ${Math.round(shareTime)}% времени`,
      totalN: [`итого ${spans[0].dur} мс, $${total.toFixed(6)}`, `большая модель: ${Math.round(shareCost)}% стоимости, ${Math.round(shareTime)}% времени`],
      steps: ['спан агента: корень трассы, общий идентификатор у всех дочерних спанов', 'классификация малой моделью: 1200 из 1450 входных токенов прочитаны из кэша', 'вызов инструмента: поиск заказа, 180 мс, без токенов', 'ответ большой модели: 450 мс до первого токена, затем 179 токенов по 10 мс', 'проверка ответа правилами политики перед отправкой пользователю'],
      desc: 'Диаграмма-водопад из пяти полос на шкале от 0 до 3000 мс. Верхняя полоса — спан агента от 0 до 2930 мс. Под ним по очереди: вызов малой модели 410 мс, вызов инструмента 180 мс, вызов большой модели 2240 мс, в котором первые 450 мс до первого токена выделены светлее, и проверка ответа 75 мс. Большая модель даёт 98% стоимости запроса и 76% его времени.' }
  : { title: 'The trace of one request to an LLM application', axis: 'ms since the request arrived', ttft: 'first token after 450 ms',
      total: `total ${spans[0].dur} ms and $${total.toFixed(6)}: the large model is ${Math.round(shareCost)} % of the cost and ${Math.round(shareTime)} % of the time`,
      totalN: [`total ${spans[0].dur} ms, $${total.toFixed(6)}`, `large model: ${Math.round(shareCost)} % of cost, ${Math.round(shareTime)} % of time`],
      steps: ['the agent span: the root of the trace, whose trace id every child carries', 'classification by the small model: 1,200 of its 1,450 input tokens are read from the cache', 'a tool call: the order lookup, 180 ms and no tokens', 'the answer of the large model: 450 ms to the first token, then 179 more tokens at 10 ms each', 'the policy check of the answer before it reaches the user'],
      desc: 'A waterfall of five bars on a scale from 0 to 3,000 ms. The top bar is the agent span from 0 to 2,930 ms. Below it, one after another: the small-model call of 410 ms, the tool call of 180 ms, the large-model call of 2,240 ms whose first 450 ms before the first token are drawn lighter, and the answer check of 75 ms. The large model is 98 % of the cost of the request and 76 % of its time.' };

const CH = 6.5, CHN = 7.3, MONO = 7.6, MONON = 8.4;
interface Layout { cls: string; W: number; H: number; x0: number; x1: number; top: number; row: number; wide: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 330, x0: 256, x1: 744, top: 44, row: 50, wide: true },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 470, x0: 12, x1: 348, top: 44, row: 72, wide: false },
];
const geo = layouts.map((L) => {
  const sx = scale([0, 3000], [L.x0, L.x1]);
  const rows = spans.map((s, i) => {
    const y = L.top + i * L.row;
    const barY = L.wide ? y : y + 10;
    const text = info(s, costs[i], L.wide);
    const tw = text.length * (L.wide ? CH : CHN);
    let tx = sx(s.start);
    if (tx + tw > L.W - 4) tx = L.W - 4 - tw;
    if (tx < 4) throw new Error(`LlmTrace: "${text}" does not fit at ${L.W}`);
    const nameX = L.wide ? 12 + (s.child ? 14 : 0) : 12;
    const nameW = s.name.length * (L.wide ? MONO : MONON);
    if (L.wide && nameX + nameW > L.x0 - 26) throw new Error(`LlmTrace: name "${s.name}" runs into the bars`);
    if (!L.wide && nameX + nameW > L.W - 4) throw new Error(`LlmTrace: name "${s.name}" too wide at ${L.W}`);
    return { s, i, y, barY, text, tx, nameX };
  });
  const tw = (L.wide ? t.total.length * CH : Math.max(...t.totalN.map((x) => x.length)) * CHN);
  if (12 + tw > L.W - 4) throw new Error(`LlmTrace: total line too wide at ${L.W}`);
  return { sx, rows };
});
const id = 'llm-trace';
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? 'Трасса из раздела «Пример»: корневой спан агента и четыре дочерних, названные по семантическим соглашениям OpenTelemetry для генеративного ИИ («chat модель», «execute_tool инструмент», «invoke_agent агент»; проверка ответа — спан самого приложения). Подписи — длительность, токены и стоимость по иллюстративным ценам: малая модель $0.20 и $0.80, большая $3 и $15 за миллион входных и выходных токенов, токены из кэша — десятая часть цены входа. Последовательные вызовы складываются: сокращать время и деньги надо в самом длинном и самом дорогом спане.'
    : 'The trace of the Example: a root agent span and four children, named by the OpenTelemetry semantic conventions for generative AI ("chat model", "execute_tool tool", "invoke_agent agent"; the answer check is a span of the application itself). Labels give the duration, the tokens and the cost at illustrative prices: $0.20 and $0.80 per million input and output tokens for the small model, $3 and $15 for the large one, cached input at a tenth of the input price. Sequential calls add up: time and money are saved in the longest and most expensive span.'}
>
  {layouts.map((L, li) => {
    const { sx, rows } = geo[li];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        {[0, 500, 1000, 1500, 2000, 2500, 3000].map((v) => (
          <g>
            <path class="f-grid" d={`M ${sx(v)} ${L.top - 8} V ${L.top + 5 * L.row - 14}`} />
            {(L.wide || v % 1000 === 0) && <text class="f-small f-t-muted" x={sx(v)} y={L.top - 14} text-anchor={v === 3000 ? 'end' : 'middle'}>{String(v)}</text>}
          </g>
        ))}
        <text class="f-small f-t-muted" x={L.x1} y={L.top - 30} text-anchor="end">{t.axis}</text>
        {rows.map(({ s, i, y, barY, text, tx, nameX }) => (
          <g data-s={String(i + 1)}>
            <text class="f-small" x={nameX} y={L.wide ? y + 13 : y + 2} style="font-family: var(--mono, monospace)">{s.name}</text>
            {s.ttft
              ? <g>
                  <rect x={sx(s.start)} y={barY} width={sx(s.start + s.ttft) - sx(s.start)} height="16" rx="3" style="fill: var(--fig-blue); fill-opacity: 0.3" />
                  <rect x={sx(s.start + s.ttft)} y={barY} width={sx(s.start + s.dur) - sx(s.start + s.ttft)} height="16" rx="3" style="fill: var(--fig-blue); fill-opacity: 0.75" />
                </g>
              : <rect x={sx(s.start)} y={barY} width={Math.max(2, sx(s.start + s.dur) - sx(s.start))} height="16" rx="3" style={`fill: var(--fig-${s.tone}); fill-opacity: ${s.child ? 0.75 : 0.35}`} />}
            <text class="f-small f-t-muted" x={tx} y={barY + 32}>{text}</text>
            {L.wide && <Badge x={L.x0 - 16} y={barY + 8} n={i + 1} />}
            {!L.wide && <Badge x={L.W - 14} y={y - 2} n={i + 1} />}
          </g>
        ))}
        {L.wide && (() => {
          const r = rows[3];
          const xt = sx(r.s.start + (r.s.ttft ?? 0));
          return (
            <g data-s="4">
              <path class="f-thin" d={`M ${xt} ${r.barY - 4} V ${r.barY + 20}`} />
              <text class="f-small f-t-blue" x={xt + 6} y={r.barY - 7}>{t.ttft}</text>
            </g>
          );
        })()}
        {L.wide
          ? <text class="f-small" x="12" y={L.H - 12} style="font-weight: 650">{t.total}</text>
          : t.totalN.map((line, k) => <text class="f-small" x="12" y={L.H - 34 + k * 20} style="font-weight: 650">{line}</text>)}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
