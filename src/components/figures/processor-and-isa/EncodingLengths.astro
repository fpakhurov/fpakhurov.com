---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// void add_to(int *a, int i, int x) { a[i] += x; } compiled by clang 17.0.4 with -O2 and disassembled with llvm-objdump.
// Bytes are listed in memory order. mem marks the instructions that read or write memory.
interface Ins { m: string; bytes: string; mem?: boolean }
const rows: { name: string; ins: Ins[] }[] = [
  { name: 'x86-64', ins: [{ m: 'movsxd', bytes: '48 63 c6' }, { m: 'add', bytes: '01 14 87', mem: true }, { m: 'ret', bytes: 'c3' }] },
  { name: 'AArch64', ins: [{ m: 'sbfiz', bytes: '28 7c 7e 93' }, { m: 'ldr', bytes: '09 68 68 b8', mem: true }, { m: 'add', bytes: '29 01 02 0b' }, { m: 'str', bytes: '09 68 28 b8', mem: true }, { m: 'ret', bytes: 'c0 03 5f d6' }] },
  { name: 'RV32IM', ins: [{ m: 'slli', bytes: '93 95 25 00' }, { m: 'add', bytes: '33 05 b5 00' }, { m: 'lw', bytes: '83 25 05 00', mem: true }, { m: 'add', bytes: 'b3 85 c5 00' }, { m: 'sw', bytes: '23 20 b5 00', mem: true }, { m: 'ret', bytes: '67 80 00 00' }] },
  { name: 'RV32IMC', ins: [{ m: 'slli', bytes: '8a 05' }, { m: 'add', bytes: '2e 95' }, { m: 'lw', bytes: '0c 41', mem: true }, { m: 'add', bytes: 'b2 95' }, { m: 'sw', bytes: '0c c1', mem: true }, { m: 'ret', bytes: '82 80' }] },
];
const sizes = rows.map((r) => r.ins.reduce((s, i) => s + i.bytes.split(' ').length, 0));
if (sizes.join(' ') !== '7 20 24 12') throw new Error(`EncodingLengths: sizes ${sizes}`);
const counts = rows.map((r) => r.ins.length);
if (counts.join(' ') !== '3 5 6 6') throw new Error(`EncodingLengths: counts ${counts}`);
const bytesWord = (n: number) => (ru ? (n % 10 === 1 && n % 100 !== 11 ? 'байт' : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? 'байта' : 'байт') : 'bytes');
const insWord = (n: number) => (ru ? (n % 10 === 1 && n % 100 !== 11 ? 'команда' : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? 'команды' : 'команд') : n === 1 ? 'instruction' : 'instructions');
const summary = rows.map((r, k) => `${sizes[k]} ${bytesWord(sizes[k])}, ${counts[k]} ${insWord(counts[k])}`);
const legend = ru ? ['обращается к памяти', 'только регистры'] : ['reads or writes memory', 'registers only'];

const layouts = [
  { cls: 'fig-wide', W: 760, H: 296, wide: true, x0: 190, bw: 22, top: 40, rowH: 60, bh: 24 },
  { cls: 'fig-narrow', W: 360, H: 356, wide: false, x0: 40, bw: 12.8, top: 36, rowH: 74, bh: 22 },
];
// groups: start offset of each instruction in bytes
const starts = rows.map((r) => r.ins.reduce<number[]>((acc, i, k) => [...acc, k ? acc[k - 1] + r.ins[k - 1].bytes.split(' ').length : 0], []));
const id = 'processor-and-isa-encoding-lengths';
---

<Figure
  id={id}
  title={ru ? 'Одна функция на C в четырёх кодировках' : 'One C function in four encodings'}
  caption={ru
    ? 'Функция void add_to(int *a, int i, int x) { a[i] += x; }, скомпилированная clang 17.0.4 с -O2 для четырёх целей; клетка — байт машинного кода в порядке хранения в памяти, группа клеток — одна команда. x86-64 (CISC) обходится тремя командами разной длины, и одна из них сама читает a[i] из памяти, прибавляет x и записывает результат обратно. AArch64 и RISC-V (RISC) читают память только командой загрузки (ldr, lw) и пишут только командой сохранения (str, sw), а все команды у них одной длины, 4 байта. Расширение C архитектуры RISC-V кодирует те же шесть команд по 2 байта. На x86-64 и AArch64 индекс i сначала расширяется до 64 бит (movsxd, sbfiz), потому что указатели там 64-битные.'
    : 'The function void add_to(int *a, int i, int x) { a[i] += x; } compiled by clang 17.0.4 with -O2 for four targets; each cell is one byte of machine code in memory order, and each group of cells is one instruction. x86-64 (CISC) needs three instructions of different lengths, and one of them reads a[i] from memory, adds x and writes the result back by itself. AArch64 and RISC-V (RISC) read memory only with a load (ldr, lw) and write it only with a store (str, sw), and all their instructions have one length, 4 bytes. The C extension of RISC-V encodes the same six instructions in 2 bytes each. On x86-64 and AArch64 the index i is first widened to 64 bits (movsxd, sbfiz), because pointers there are 64 bits wide.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Длина машинного кода одной функции для x86-64, AArch64, RV32IM и RV32IMC' : 'Machine-code length of one function for x86-64, AArch64, RV32IM and RV32IMC'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? `Четыре полосы байтов. ${rows.map((r, k) => `${r.name}: ${summary[k]}`).join('; ')}. Команды, обращающиеся к памяти, выделены: одна у x86-64, две у остальных.`
        : `Four strips of bytes. ${rows.map((r, k) => `${r.name}: ${summary[k]}`).join('; ')}. Instructions that access memory are highlighted: one on x86-64, two on the others.`}</desc>
      {rows.map((r, k) => {
        const y = L.top + k * L.rowH;
        return (
          <g>
            {L.wide
              ? <g>
                  <text class="f-label" x="12" y={y + 10} style="font-weight: 650">{r.name}</text>
                  <text class="f-small f-t-muted" x="12" y={y + 28}>{summary[k]}</text>
                </g>
              : <text class="f-small" x={12} y={y - 8}><tspan style="font-weight: 650">{r.name}</tspan><tspan class="f-t-muted">{` · ${summary[k]}`}</tspan></text>}
            {r.ins.map((ins, j) => {
              const bs = ins.bytes.split(' ');
              const gx = L.x0 + starts[k][j] * L.bw, gw = bs.length * L.bw;
              const tone = ins.mem ? 'amber' : 'blue';
              return (
                <g>
                  <rect class={`f-fill-${tone}`} x={gx + 1} y={y} width={gw - 2} height={L.bh} rx="3" />
                  <rect class={`f-thin f-${tone}`} x={gx + 1} y={y} width={gw - 2} height={L.bh} rx="3" />
                  {L.wide && bs.map((b, i) => <text class="f-small" x={gx + i * L.bw + L.bw / 2} y={y + L.bh / 2 + 4} text-anchor="middle" style="font-family: var(--mono); font-size: 11px">{b}</text>)}
                  {L.wide && <text class="f-small f-t-muted" x={gx + gw / 2} y={y + L.bh + 15} text-anchor="middle" style="font-size: 11.5px">{ins.m}</text>}
                </g>
              );
            })}
          </g>
        );
      })}
      {/* byte ruler */}
      {[0, 4, 8, 12, 16, 20, 24].map((b) => (
        <g>
          <path class="f-grid" d={`M ${L.x0 + b * L.bw} ${L.top - 14} V ${L.top + 3 * L.rowH + L.bh + (L.wide ? 2 : 6)}`} style="stroke-dasharray: 2 3" />
          <text class="f-small f-t-muted" x={L.x0 + b * L.bw} y={L.wide ? L.top - 18 : L.top + 3 * L.rowH + L.bh + 20} text-anchor="middle">{b}</text>
        </g>
      ))}
      {L.wide && <text class="f-small f-t-muted" x={L.x0 - 8} y={L.top - 18} text-anchor="end">{ru ? 'байт' : 'byte'}</text>}
      {!L.wide && <text class="f-small f-t-muted" x={L.x0 - 8} y={L.top + 3 * L.rowH + L.bh + 20} text-anchor="end">{ru ? 'байт' : 'byte'}</text>}
      {legend.map((txt, i) => {
        const lx = L.wide ? 190 + i * 210 : 12, ly = L.wide ? L.H - 16 : L.H - 38 + i * 22;
        return (
          <g>
            <rect class={`f-fill-${i ? 'blue' : 'amber'}`} x={lx} y={ly - 10} width="14" height="12" />
            <rect class={`f-thin f-${i ? 'blue' : 'amber'}`} x={lx} y={ly - 10} width="14" height="12" />
            <text class="f-small f-t-muted" x={lx + 20} y={ly}>{txt}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
