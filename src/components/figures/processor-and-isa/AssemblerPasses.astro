---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Arrow from '../seqflow/Arrow.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The hello-world program of the note, assembled as RARS does it: .text from 0x00400000, .data from 0x10010000.
// Every word is computed here with the I- and U-type layouts of the next note and checked against an assembler.
const TEXT = 0x00400000, DATA = 0x10010000;
const reg: Record<string, number> = { zero: 0, a0: 10, a7: 17 };
const iType = (imm: number, rs1: string, rd: string) => (((imm & 0xfff) << 20) | (reg[rs1] << 15) | (reg[rd] << 7) | 0x13) >>> 0;
const uType = (imm20: number, rd: string, op: number) => (((imm20 & 0xfffff) << 12) | (reg[rd] << 7) | op) >>> 0;
const hex = (v: number, n = 8) => '0x' + (v >>> 0).toString(16).padStart(n, '0');
const greeting = DATA;
const laAt = TEXT + 4;
const off = (greeting - laAt) >>> 0;
const lo = ((off & 0xfff) ^ 0x800) - 0x800;
const hi = ((off - lo) >>> 12) & 0xfffff;
if (hex(off) !== '0x0fc0fffc' || lo !== -4 || hi !== 0x0fc10) throw new Error(`AssemblerPasses: la split ${hex(off)} ${hi} ${lo}`);
if (((laAt + (hi << 12) + lo) >>> 0) !== greeting) throw new Error('AssemblerPasses: auipc + addi does not reach greeting');
const text = [
  { w: iType(4, 'zero', 'a7'), asm: 'addi  a7, zero, 4' },
  { w: uType(hi, 'a0', 0x17), asm: `auipc a0, ${hex(hi, 5)}` },
  { w: iType(lo, 'a0', 'a0'), asm: `addi  a0, a0, ${lo}` },
  { w: 0x73, asm: 'ecall' },
  { w: iType(10, 'zero', 'a7'), asm: 'addi  a7, zero, 10' },
  { w: 0x73, asm: 'ecall' },
];
if (text.map((t) => hex(t.w)).join(' ') !== '0x00400893 0x0fc10517 0xffc50513 0x00000073 0x00a00893 0x00000073') throw new Error('AssemblerPasses: encodings drifted');
const str = 'Hello, RISC-V!\n';
const bytes = [...str].map((c) => c.charCodeAt(0)).concat([0]);
if (bytes.length !== 16) throw new Error('AssemblerPasses: string length');
const show = (b: number) => (b === 10 ? '\\n' : b === 0 ? '\\0' : String.fromCharCode(b));
const dataRows = [0, 1, 2, 3].map((k) => {
  const bs = bytes.slice(4 * k, 4 * k + 4);
  return `${hex(DATA + 4 * k)}  ${bs.map((b) => b.toString(16).padStart(2, '0')).join(' ')}  ${bs.map(show).join('')}`;
});
const source = ['.data', 'greeting:', '  .asciz "Hello, RISC-V!\\n"', '.text', '.globl main', 'main:', '  li   a7, 4', '  la   a0, greeting', '  ecall', '  li   a7, 10', '  ecall'];
const LA = 7, ASCIZ = 2;
const symRows = ['greeting  .data    ' + hex(greeting), 'main      .text    ' + hex(TEXT)];
const expRows = ['li a7, 4         →  addi  a7, zero, 4', `la a0, greeting  →  auipc a0, ${hex(hi, 5)}`, `                    addi  a0, a0, ${lo}`, `${hex(greeting)} − ${hex(laAt)} = ${hex(hi, 5)}·4096 − 4`];
const nb = (s: string) => s.replace(/ /g, '\u00a0'); // keep runs of spaces in monospaced rows
const mono = (size: number) => `font-family: var(--mono); font-size: ${size}px`;

const t = ru
  ? { src: 'исходный текст', sym: 'проход 1: адреса меток', exp: 'псевдокоманды раскрываются', mem: 'память после загрузки', pc: '← pc',
      head: 'метка     сегмент  адрес',
      steps: ['проход 1: два счётчика адресов, .text с 0x00400000 и .data с 0x10010000; метки попадают в таблицу символов', 'директива .asciz кладёт 16 байт строки в сегмент данных', 'псевдокоманды раскрываются: li в одну команду, la в две (auipc и addi)', 'проход 2: каждая команда кодируется в 32-битное слово, метки заменяются адресами и смещениями', 'RARS загружает слова и байты в память и начинает с main: pc = 0x00400000'] }
  : { src: 'source text', sym: 'pass 1: addresses of labels', exp: 'pseudo-instructions expand', mem: 'memory after loading', pc: '← pc',
      head: 'label     segment  address',
      steps: ['pass 1: two location counters, .text from 0x00400000 and .data from 0x10010000; labels go into the symbol table', 'the .asciz directive puts the 16 bytes of the string into the data segment', 'pseudo-instructions expand: li into one instruction, la into two (auipc and addi)', 'pass 2: every instruction is encoded as a 32-bit word, with labels replaced by addresses and offsets', 'RARS loads the words and bytes into memory and starts at main: pc = 0x00400000'] };

type Box = [number, number, number, number];
interface Layout {
  cls: string; W: number; H: number; wide: boolean; fs: number; lh: number;
  src: Box; sym: Box; exp: Box; data: Box; text: Box;
  a1: [number, number][]; a2: [number, number][]; a3: [number, number][]; a4: [number, number][];
  badges: [number, number][];
}
const layouts: Layout[] = [
  {
    cls: 'fig-wide', W: 760, H: 438, wide: true, fs: 12, lh: 17,
    src: [12, 28, 290, 216], sym: [360, 28, 388, 92], exp: [360, 140, 388, 104], data: [12, 276, 320, 150], text: [348, 276, 400, 150],
    a1: [[302, 64], [357, 64]], a2: [[110, 244], [110, 273]], a3: [[302, 169], [357, 169]], a4: [[560, 244], [560, 273]],
    badges: [[330, 50], [126, 259], [330, 155], [576, 259], [714, 316]],
  },
  {
    cls: 'fig-narrow seq-narrow', W: 360, H: 824, wide: false, fs: 11.5, lh: 16,
    src: [10, 28, 340, 204], sym: [10, 268, 340, 88], exp: [10, 392, 340, 108], data: [10, 536, 340, 100], text: [10, 672, 340, 140],
    a1: [[180, 232], [180, 265]], a2: [[60, 500], [60, 533]], a3: [[180, 356], [180, 389]], a4: [[180, 636], [180, 669]],
    badges: [[200, 248], [80, 517], [200, 372], [200, 653], [286, 712]],
  },
];
const id = 'processor-and-isa-assembler-passes';
---

<Figure
  id={id}
  title={ru ? 'Как ассемблер превращает hello.s в содержимое памяти' : 'How the assembler turns hello.s into memory contents'}
  caption={ru
    ? `Программа hello world из этой заметки. Первый проход идёт по строкам с двумя счётчиками адресов и записывает каждую метку в таблицу символов: greeting = ${hex(greeting)}, main = ${hex(TEXT)} (1). Директива .asciz выдаёт 16 байт: 15 символов и завершающий ноль (2). Псевдокоманда la раскрывается в две команды, auipc и addi, поэтому всё, что идёт после неё, сдвигается на 4 байта (3). Второй проход кодирует каждую команду: для la смещение ${hex(greeting)} − ${hex(laAt)} = ${hex(off)} делится на старшую часть ${hex(hi, 5)} для auipc и младшую ${lo} для addi (4). RARS кладёт слова в сегмент кода, байты в сегмент данных и начинает выполнение с main (5). Байты строки видны в памяти по порядку; слово по адресу 0x10010004, прочитанное целиком, равно 0x52202c6f, потому что RISC-V хранит младший байт первым.`
    : `The hello-world program of this note. The first pass walks the lines with two location counters and records every label in the symbol table: greeting = ${hex(greeting)}, main = ${hex(TEXT)} (1). The .asciz directive emits 16 bytes: 15 characters and a terminating zero (2). The pseudo-instruction la expands into two instructions, auipc and addi, so everything after it moves by 4 bytes (3). The second pass encodes every instruction; for la the offset ${hex(greeting)} − ${hex(laAt)} = ${hex(off)} is split into an upper part ${hex(hi, 5)} for auipc and a lower part ${lo} for addi (4). RARS places the words in the text segment and the bytes in the data segment and starts at main (5). The bytes of the string appear in memory in order; the word at 0x10010004 read as a whole is 0x52202c6f, because RISC-V stores the least significant byte first.`}
>
  {layouts.map((L) => {
    const title = (b: Box, s: string, n?: number) => <text class="f-small" x={b[0] + 10} y={b[1] + 18} style="font-weight: 650">{s}</text>;
    const rows = (b: Box, lines: string[], y0: number, cls = 'f-small') => lines.map((line, k) => <text class={cls} x={b[0] + 10} y={b[1] + y0 + k * L.lh} style={mono(L.fs)}>{nb(line)}</text>);
    const srcY = (i: number) => L.src[1] + 40 + i * L.lh;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Два прохода ассемблера для программы hello world' : 'The two passes of the assembler for the hello-world program'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? `Слева исходный текст программы из 11 строк. Таблица символов: greeting по адресу ${hex(greeting)}, main по адресу ${hex(TEXT)}. Раскрытие псевдокоманд: li a7, 4 становится addi a7, zero, 4; la a0, greeting становится auipc a0, ${hex(hi, 5)} и addi a0, a0, ${lo}. Внизу память: четыре слова данных с байтами строки Hello, RISC-V! и шесть слов кода от ${hex(TEXT)} до 0x00400014; pc указывает на первое.`
          : `On the left, the 11-line source text. The symbol table: greeting at ${hex(greeting)}, main at ${hex(TEXT)}. Pseudo-instruction expansion: li a7, 4 becomes addi a7, zero, 4; la a0, greeting becomes auipc a0, ${hex(hi, 5)} and addi a0, a0, ${lo}. At the bottom, memory: four data words holding the bytes of Hello, RISC-V! and six code words from ${hex(TEXT)} to 0x00400014; pc points at the first.`}</desc>

        {/* the source text, always shown */}
        <rect class="f-box-soft" x={L.src[0]} y={L.src[1]} width={L.src[2]} height={L.src[3]} rx="8" />
        {title(L.src, t.src)}
        <rect class="f-fill-green" data-s="2" x={L.src[0] + 4} y={srcY(ASCIZ) - L.lh + 4} width={L.src[2] - 8} height={L.lh} rx="3" />
        <rect class="f-fill-amber" data-s="3" x={L.src[0] + 4} y={srcY(LA) - L.lh + 4} width={L.src[2] - 8} height={L.lh} rx="3" />
        {source.map((line, i) => <text class="f-small" x={L.src[0] + 10} y={srcY(i)} style={mono(L.fs)}>{nb(line)}</text>)}

        {/* 1: pass 1, the symbol table */}
        <g data-s="1">
          <Arrow pts={L.a1} />
          <rect class="f-fill-paper f-thin" x={L.sym[0]} y={L.sym[1]} width={L.sym[2]} height={L.sym[3]} rx="8" />
          {title(L.sym, t.sym)}
          {rows(L.sym, [t.head], 42, 'f-small f-t-muted')}
          {rows(L.sym, symRows, 42 + L.lh)}
          <Badge x={L.badges[0][0]} y={L.badges[0][1]} n={1} />
        </g>
        {/* 3: pseudo-instructions */}
        <g data-s="3">
          <Arrow pts={L.a3} tone="amber" />
          <rect class="f-fill-paper f-thin" x={L.exp[0]} y={L.exp[1]} width={L.exp[2]} height={L.exp[3]} rx="8" />
          {title(L.exp, t.exp)}
          {rows(L.exp, expRows.slice(0, 3), 40)}
          {rows(L.exp, expRows.slice(3), 40 + 3 * L.lh + 4, 'f-small f-t-muted')}
          <Badge x={L.badges[2][0]} y={L.badges[2][1]} n={3} />
        </g>
        {/* 2: the data segment */}
        <g data-s="2">
          <Arrow pts={L.a2} tone="green" />
          <rect class="f-fill-paper f-thin" x={L.data[0]} y={L.data[1]} width={L.data[2]} height={L.data[3]} rx="8" />
          {title(L.data, `${t.mem}: .data`)}
          {rows(L.data, dataRows, 44)}
          <Badge x={L.badges[1][0]} y={L.badges[1][1]} n={2} />
        </g>
        {/* 4: pass 2, the text segment */}
        <g data-s="4">
          <Arrow pts={L.a4} tone="blue" />
          <rect class="f-fill-paper f-thin" x={L.text[0]} y={L.text[1]} width={L.text[2]} height={L.text[3]} rx="8" />
          {title(L.text, `${t.mem}: .text`)}
          {L.wide
            ? rows(L.text, text.map((w, k) => `${hex(TEXT + 4 * k)}  ${hex(w.w)}  ${w.asm}`), 44)
            : rows(L.text, text.map((w, k) => `${hex(TEXT + 4 * k)}  ${hex(w.w)}  ${w.asm.split(' ')[0]}`), 44)}
          <Badge x={L.badges[3][0]} y={L.badges[3][1]} n={4} />
        </g>
        {/* 5: execution starts at main */}
        <g data-s="5">
          <text class="f-small f-t-red" x={L.wide ? L.text[0] + 10 + 41 * 7.2 + 10 : L.text[0] + 10 + 30 * 6.9 + 8} y={L.text[1] + 44} style="font-weight: 650">{t.pc}</text>
          <Badge x={L.badges[4][0]} y={L.badges[4][1]} n={5} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
