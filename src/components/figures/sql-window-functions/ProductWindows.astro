---
import Figure from '../Figure.astro';

const ru = Astro.props.lang === 'ru';
const title = ru ? 'Раздел даёт контекст каждой продаже' : 'A partition gives each sale its context';
const caption = ru
  ? 'Сумма раздела появляется рядом с каждой продажей. Продажи чая и кофе учитываются в разных разделах.'
  : 'The partition total appears next to each sale. Tea and coffee sales belong to separate partitions.';
const desc = ru
  ? 'Пять продаж чая используют итог 1400, две продажи кофе используют итог 600.'
  : 'Five tea sales use the total of 1400, and two coffee sales use the total of 600.';
const rows = [
  { product: 'tea', sales: [201, 202, 203, 204, 205], total: 1400, color: 'f-fill-blue' },
  { product: 'coffee', sales: [206, 207], total: 600, color: 'f-fill-green' },
];
---
<Figure id="sql-product-windows" title={title} caption={caption}>
  <svg viewBox="0 0 340 151" role="img" aria-labelledby="product-windows-title product-windows-desc" style="max-width: 520px; margin-inline: auto">
    <title id="product-windows-title">{title}</title>
    <desc id="product-windows-desc">{desc}</desc>
    {rows.map(({product, sales, total, color}, i) => (
      <g transform={`translate(0 ${i * 72})`}>
        <rect class={color} x="8" y="5" width="324" height="64" rx="7" />
        <text class="f-label" x="20" y="29">{product}</text>
        <text class="f-label" x="320" y="29" text-anchor="end">{ru ? 'Итог' : 'Total'} {total}</text>
        {sales.map((sale, j) => (
          <text class="f-label" x={20 + j * 50} y="54">{sale}</text>
        ))}
      </g>
    ))}
  </svg>
</Figure>
