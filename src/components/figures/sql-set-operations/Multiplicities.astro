---
import Figure from '../Figure.astro';

const ru = Astro.props.lang === 'ru';
const title = ru ? 'Как меняется число копий tea' : 'How many tea rows remain';
const caption = ru
  ? 'Три строки с сайта и две из зала дают пять копий при объединении, две при пересечении и одну при вычитании.'
  : 'Three website copies and two counter copies give five by union, two by intersection and one by subtraction.';
const desc = ru
  ? 'В каждом ряду цветные кружки показывают сохранённые копии. Не заполненные кружки отмечают копии, которых нет в результате.'
  : 'In each row filled circles show retained copies. Empty circles mark copies absent from the result.';
const rows = [
  { label: 'UNION ALL', count: 5 },
  { label: 'INTERSECT ALL', count: 2 },
  { label: 'EXCEPT ALL', count: 1 },
];
---
<Figure id="sql-set-multiplicities" title={title} caption={caption}>
  <svg viewBox="0 0 340 158" role="img" aria-labelledby="set-multiplicities-title set-multiplicities-desc" style="max-width: 500px; margin-inline: auto">
    <title id="set-multiplicities-title">{title}</title>
    <desc id="set-multiplicities-desc">{desc}</desc>
    {rows.map(({label, count}, i) => (
      <g transform={`translate(0 ${i * 50})`}>
        <text class="f-label" x="12" y="31">{label}</text>
        {Array.from({length: 5}, (_, j) => (
          <circle class={j < count ? 'f-fill-blue f-blue' : 'f-muted'} fill="none" cx={165 + j * 29} cy="26" r="8" />
        ))}
        <text class="f-label" x="327" y="31" text-anchor="end">{count}</text>
      </g>
    ))}
  </svg>
</Figure>
