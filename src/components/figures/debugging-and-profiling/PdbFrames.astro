---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar, type Tone } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The pdb session of the note on grades.py (CPython 3.14.7): breakpoint() inside weighted_mean, called from report,
// called from the module. Replay the arithmetic that pdb printed: zip stops at the shorter list.
const scores = [80, 90, 70];
const weights = [0.5, 0.5];
const total = weights.reduce((t, w, i) => t + scores[i] * w, 0);
if (total !== 85) throw new Error('total');
if (total / weights.reduce((a, b) => a + b) !== 85) throw new Error('returned value');

interface Frame { name: string; line: number; lines: string[]; tone: Tone }
const frames: Frame[] = [
  { name: '<module>', line: 13, lines: ['print(report({...}))'], tone: 'n' },
  { name: 'report', line: 10, lines: ["student = {'scores': [...], ...}"], tone: 'h' },
  { name: 'weighted_mean', line: 5, lines: [`scores = [${scores.join(', ')}]`, `weights = [${weights.join(', ')}]`, `total = ${total.toFixed(1)}`], tone: 'h' },
];
// The current frame of pdb at each step: 2 is weighted_mean, 1 is report.
const current = [2, 2, 2, 1, 2];
// The transcript: commands as typed, then what pdb printed (paths shortened, one long line wrapped).
const transcript: string[][] = [
  ['> grades.py(5)weighted_mean()', '-> breakpoint()'],
  ['(Pdb) p total', `${total.toFixed(1)}`, '(Pdb) p scores, weights', `([${scores.join(', ')}], [${weights.join(', ')}])`],
  ['(Pdb) w', '  grades.py(13)<module>()', '  grades.py(10)report()', '> grades.py(5)weighted_mean()'],
  ['(Pdb) up', '> grades.py(10)report()', '(Pdb) p student', "{'scores': [80, 90, 70],", " 'weights': [0.5, 0.5]}"],
  ['(Pdb) down', '(Pdb) n          → line 6', '(Pdb) n          → --Return-- 85.0', '(Pdb) c          → prints 85.0'],
];
const t = ru
  ? { stack: 'стек кадров (старые сверху)', here: 'pdb', line: 'строка', calls: 'вызывает', out: 'сеанс pdb',
      steps: ['breakpoint() останавливает программу в weighted_mean', 'p печатает переменные: 3 оценки, но 2 веса', 'w показывает стек; > отмечает текущий кадр', 'up переходит в кадр вызывающей функции report', 'down, n, n, c: назад, шаги, продолжение'] }
  : { stack: 'frame stack (oldest at the top)', here: 'pdb', line: 'line', calls: 'calls', out: 'pdb session',
      steps: ['breakpoint() stops the program inside weighted_mean', 'p prints variables: 3 scores but 2 weights', 'w prints the stack; > marks the current frame', 'up moves to the caller, report', 'down, n, n, c: back, step over, continue'] };

interface Layout { cls: string; W: number; H: number; fx: number; fw: number; fy0: number; fgap: number; head: number; lh: number; tx: number; ty0: number; tlh: number; tgap: number; mono: number; sans: number; tw: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 0, fx: 70, fw: 290, fy0: 40, fgap: 34, head: 22, lh: 18, tx: 420, ty0: 40, tlh: 17, tgap: 12, mono: 7.5, sans: 6.5, tw: 336 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 0, fx: 44, fw: 300, fy0: 34, fgap: 30, head: 22, lh: 20, tx: 44, ty0: 0, tlh: 19, tgap: 12, mono: 8.4, sans: 7.3, tw: 312 },
];
const geom = layouts.map((L) => {
  let y = L.fy0;
  const fy = frames.map((f) => {
    const h = L.head + 10 + f.lines.length * L.lh;
    const top = y;
    y += h + L.fgap;
    return { top, h };
  });
  const framesEnd = y - L.fgap;
  let ty = L.ty0 || framesEnd + 40;
  const outHead = ty - 16;
  const tys = transcript.map((block) => {
    const top = ty;
    ty += block.length * L.tlh + L.tgap;
    return top;
  });
  const H = Math.max(framesEnd + 16, ty) + 4;
  for (const f of frames) {
    for (const s of f.lines) if (12 + s.length * L.mono > L.fw - 4) throw new Error(`frame line "${s}" overflows at ${L.W}`);
    if (12 + (f.name.length + t.line.length + 4) * L.mono > L.fw - 4) throw new Error('frame title');
  }
  for (const b of transcript) for (const s of b) if (L.tx + s.length * L.mono > L.W - 4) throw new Error(`transcript "${s}" overflows at ${L.W}`);
  if (L.tx + t.stack.length * L.sans > L.W && L.W === 360) throw new Error('stack label');
  return { fy, tys, H, outHead };
});
const id = 'pdb-frames';
---

<Figure
  id={id}
  title={ru ? 'Отладчик ходит по стеку кадров' : 'The debugger walks the frame stack'}
  caption={ru
    ? 'Сеанс pdb из заметки на CPython 3.14.7, по шагам. Слева — стек кадров: каждый вызов функции получает кадр со своими локальными переменными и текущей строкой; старый кадр сверху, как в трассировке. Метка pdb показывает текущий кадр, в контексте которого выполняются команды. breakpoint() останавливает программу в weighted_mean (1); p печатает переменные, и видно, что весов на один меньше, чем оценок (2); w печатает стек (3); up переходит в кадр report (4); down возвращает, n выполняет строку, c продолжает выполнение (5). Справа — команды и то, что напечатал pdb (пути сокращены, одна длинная строка перенесена).'
    : 'The pdb session of the note on CPython 3.14.7, step by step. On the left, the frame stack: each function call gets a frame holding its local variables and its current line; the oldest frame is at the top, as in a traceback. The pdb marker shows the current frame, in which commands are evaluated. breakpoint() stops the program inside weighted_mean (1); p prints variables, and there is one weight fewer than scores (2); w prints the stack (3); up moves to the frame of report (4); down moves back, n runs one line, c continues (5). On the right, the commands and what pdb printed (paths shortened, one long line wrapped).'}
>
  {layouts.map((L, li) => {
    const { fy, tys, H, outHead } = geom[li];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Стек из трёх кадров и сеанс pdb' : 'A stack of three frames and a pdb session'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Три кадра сверху вниз: модуль на строке 13, report на строке 10 с переменной student, weighted_mean на строке 5 с переменными scores, weights и total. Метка pdb стоит у weighted_mean, на шаге 4 — у report. Рядом — пять блоков сеанса pdb с командами p, w, up, down, n и c.'
          : 'Three frames from top to bottom: the module at line 13, report at line 10 with the variable student, weighted_mean at line 5 with the variables scores, weights and total. The pdb marker is next to weighted_mean, and next to report at step 4. Beside them, five blocks of the pdb session with the commands p, w, up, down, n and c.'}</desc>
        <text class="f-small f-t-muted" x={L.fx} y={L.fy0 - 14} style="font-weight: 650">{t.stack}</text>
        {frames.map((f, k) => {
          const { top, h } = fy[k];
          return (
            <g>
              <rect x={L.fx} y={top} width={L.fw} height={h} rx="7" style={`fill: ${f.tone === 'n' ? 'var(--paper-strong)' : toneVar[f.tone]}; fill-opacity: ${f.tone === 'n' ? 1 : 0.12}; stroke: ${f.tone === 'n' ? 'var(--line)' : toneVar[f.tone]}; stroke-width: 1.3`} />
              <text class="f-small" x={L.fx + 12} y={top + L.head - 4} style="font-family: var(--mono); font-weight: 650">{f.name}<tspan style="fill: var(--muted); font-weight: 400">{`  ${t.line} ${f.line}`}</tspan></text>
              {f.lines.map((s, i) => (
                <text class="f-small" x={L.fx + 12} y={top + L.head + 4 + (i + 1) * L.lh - 4} style="font-family: var(--mono)">{s}</text>
              ))}
              {k !== frames.length - 1 && <path class="f-line f-muted" d={`M ${L.fx + 40} ${top + h + 2} V ${fy[k + 1].top - 3}`} marker-end="url(#f-arrow-muted)" />}
              {k !== frames.length - 1 && <text class="f-small f-t-muted" x={L.fx + 48} y={top + h + L.fgap / 2 + 4}>{t.calls}</text>}
            </g>
          );
        })}
        {[2, 1].map((fi) => {
          const at = current.map((c, s) => (c === fi ? s + 1 : 0)).filter(Boolean);
          const y = fy[fi].top + 16;
          return (
            <g data-s={at.join(' ')}>
              <path class="f-line f-red f-bold" d={`M ${L.fx - 26} ${y} H ${L.fx - 4}`} marker-end="url(#f-arrow-red)" />
              <text class="f-small f-t-red" x={L.fx - 28} y={y - 7} text-anchor="middle" style="font-weight: 700">{t.here}</text>
            </g>
          );
        })}
        <text class="f-small f-t-muted" x={L.tx} y={outHead} style="font-weight: 650">{t.out}</text>
        {transcript.map((block, s) => (
          <g data-s={String(s + 1)}>
            <Badge x={L.tx - 16} y={tys[s] + 8} n={s + 1} />
            {block.map((line, i) => (
              <text class={`f-small${line.startsWith('(Pdb)') ? '' : ' f-t-blue'}`} x={L.tx} y={tys[s] + 12 + i * L.tlh} style="font-family: var(--mono)">{line}</text>
            ))}
          </g>
        ))}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
