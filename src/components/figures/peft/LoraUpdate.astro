---
import Figure from '../Figure.astro';

// LoRA: h = W x + B A x. The frozen d×d matrix W on the left, the two thin
// trained matrices A (r×d) and B (d×r) on the right, summed into h.
interface Layout { cls: string; w: number; h: number; wX: number; aX: number; bX: number; top: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', w: 560, h: 330, wX: 60, aX: 320, bX: 320, top: 110 },
  { cls: 'fig-narrow', w: 360, h: 330, wX: 20, aX: 220, bX: 220, top: 110 },
];
const side = 150;  // W is drawn as a square of side d
const r = 24;      // thin dimension
---

<Figure
  id="lora-update"
  title="LoRA: a frozen weight matrix plus a trained low-rank correction"
  caption="The pretrained matrix W (d × d, blue) is never updated. Two small matrices are trained instead: A, which maps the d-dimensional input down to r numbers, and B, which maps them back up to d. Their product B A is a d × d matrix of rank at most r, and the layer computes h = W x + B A x. A starts random and B starts at zero, so at the first step the correction is zero and the layer behaves exactly like the pretrained one. The two thin matrices hold 2dr parameters against d² for W; with d = 768 and r = 8 that is 12,288 against 589,824."
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`lora-update-${L.w}-t lora-update-${L.w}-d`}>
      <title id={`lora-update-${L.w}-t`}>LoRA reparameterization</title>
      <desc id={`lora-update-${L.w}-d`}>A large blue square labelled W, frozen, and to its right a short wide orange rectangle labelled A above a tall narrow orange rectangle labelled B. The input x enters both from below; the outputs of W and of B A are added into h at the top.</desc>
      {/* input */}
      <text class="f-math" x={L.wX + side / 2 + (L.aX - L.wX) / 2} y={L.top + side + 46} text-anchor="middle">x</text>
      <text class="f-note" x={L.wX + side / 2 + (L.aX - L.wX) / 2} y={L.top + side + 64} text-anchor="middle">d numbers</text>
      <path class="f-line" d={`M ${L.wX + side / 2 + (L.aX - L.wX) / 2 - 14} ${L.top + side + 40} H ${L.wX + side / 2} V ${L.top + side + 4}`} marker-end="url(#f-arrow)" />
      <path class="f-line" d={`M ${L.wX + side / 2 + (L.aX - L.wX) / 2 + 14} ${L.top + side + 40} H ${L.aX + side / 2 - 40} V ${L.top + side + 4}`} marker-end="url(#f-arrow)" />
      {/* W */}
      <rect class="f-box f-fill-blue" x={L.wX} y={L.top} width={side} height={side} rx="6" />
      <text class="f-math f-t-blue" x={L.wX + side / 2} y={L.top + side / 2 - 6} text-anchor="middle">W</text>
      <text class="f-small f-t-blue" x={L.wX + side / 2} y={L.top + side / 2 + 16} text-anchor="middle">frozen, d × d</text>
      {/* A (r × d), drawn wide and short at the bottom of the right column */}
      <rect class="f-box f-fill-amber" x={L.aX - 40} y={L.top + side - r} width={side} height={r} rx="4" />
      <text class="f-small f-t-amber" x={L.aX + side / 2 - 40} y={L.top + side - r / 2 + 4} text-anchor="middle">A: r × d</text>
      {/* B (d × r), tall and narrow above A */}
      <rect class="f-box f-fill-amber" x={L.aX + side / 2 - 40 - r / 2} y={L.top} width={r} height={side - r - 12} rx="4" />
      <text class="f-small f-t-amber" x={L.aX + side / 2 - 40 + r / 2 + 6} y={L.top + (side - r - 12) / 2 + 4}>B: d × r</text>
      <path class="f-line" d={`M ${L.aX + side / 2 - 40} ${L.top + side - r - 2} V ${L.top + side - r - 9}`} marker-end="url(#f-arrow)" />
      <text class="f-note" x={L.aX + side / 2 - 40 + r / 2 + 6} y={L.top + 20}>trained</text>
      <text class="f-note" x={L.aX + side / 2 - 40 + r / 2 + 6} y={L.top + 36}>B = 0 at start</text>
      {/* sum */}
      <path class="f-line f-blue" d={`M ${L.wX + side / 2} ${L.top - 2} V ${L.top - 30} H ${L.wX + side / 2 + (L.aX - L.wX) / 2 - 16}`} marker-end="url(#f-arrow-blue)" />
      <path class="f-line f-amber" d={`M ${L.aX + side / 2 - 40} ${L.top - 2} V ${L.top - 30} H ${L.wX + side / 2 + (L.aX - L.wX) / 2 + 16}`} marker-end="url(#f-arrow-amber)" />
      <circle class="f-box" cx={L.wX + side / 2 + (L.aX - L.wX) / 2} cy={L.top - 30} r="12" />
      <text class="f-label" x={L.wX + side / 2 + (L.aX - L.wX) / 2} y={L.top - 25} text-anchor="middle">+</text>
      <path class="f-line" d={`M ${L.wX + side / 2 + (L.aX - L.wX) / 2} ${L.top - 44} V ${L.top - 62}`} marker-end="url(#f-arrow)" />
      <text class="f-math" x={L.wX + side / 2 + (L.aX - L.wX) / 2} y={L.top - 70} text-anchor="middle">h = W x + B A x</text>
    </svg>
  ))}
</Figure>
