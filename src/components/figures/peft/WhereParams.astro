---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One Transformer block with the three PEFT methods placed where they add trained parameters.
const t = ru
  ? { ffn: 'полносвязный блок', attn: 'внимание', attnSub: 'проекции Q, K, V, O', adapter: 'адаптер', emb: 'эмбеддинги', tokens: 'токены входа', out: 'к следующему блоку', prompt: 'настройка промпта', lora: 'LoRA', frozen: 'заморожено', trained: 'обучается', virtual: 'p₁ … pₖ' }
  : { ffn: 'feed-forward', attn: 'attention', attnSub: 'Q, K, V, O projections', adapter: 'adapter', emb: 'embeddings', tokens: 'input tokens', out: 'to the next block', prompt: 'prompt tuning', lora: 'LoRA', frozen: 'frozen', trained: 'trained', virtual: 'p₁ … pₖ' };
interface Layout { cls: string; W: number; H: number; cx: number; cw: number; left: number; lw: number; right: number; rw: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 640, H: 318, cx: 230, cw: 190, left: 40, lw: 140, right: 470, rw: 120 },
  { cls: 'fig-narrow', W: 360, H: 318, cx: 110, cw: 140, left: 6, lw: 88, right: 266, rw: 88 },
];
const rows = { out: 16, ad2: 30, ffn: 74, ad1: 124, attn: 164, emb: 230, tok: 296 };
const id = 'peft-where';
---

<Figure
  id={id}
  title={ru ? 'Где каждый метод PEFT добавляет обучаемые параметры' : 'Where each PEFT method adds trained parameters'}
  caption={ru
    ? 'Один блок трансформера (остаточные связи и нормализация опущены). Серые части — предобученные и замороженные, оранжевые — единственное, что обучается. Настройка промпта приписывает к эмбеддингам входа k выученных векторов и не трогает ничего внутри. LoRA добавляет параллельно матрицам проекций внимания низкоранговую ветвь B A, которую после обучения можно влить в W. Адаптеры вставляют после подслоёв небольшие слои с узким местом, которые остаются в модели и при инференсе. Во всех трёх случаях копия на задачу — только оранжевые части.'
    : 'One Transformer block (residual connections and normalization omitted). Grey parts are pretrained and frozen, orange parts are the only ones trained. Prompt tuning prepends k learned vectors to the input embeddings and touches nothing inside. LoRA adds a low-rank branch B A alongside the attention projection matrices, which can be merged into W after training. Adapters insert small bottleneck layers after the sub-layers, which stay in the model at inference. In all three, the per-task copy is only the orange parts.'}
>
  {layouts.map((L) => {
    const mid = L.cx + L.cw / 2;
    const box = (y: number, h: number, label: string, trained: boolean, sub?: string, x = L.cx, w = L.cw) => (
      <g>
        <rect class={trained ? 'f-box f-fill-amber' : 'f-box-soft'} x={x} y={y} width={w} height={h} rx="6" />
        <text class={`f-small${trained ? '' : ''}`} x={x + w / 2} y={y + h / 2 + (sub ? -2 : 4)} text-anchor="middle">{label}</text>
        {sub && <text class="f-small f-t-muted" x={x + w / 2} y={y + h / 2 + 13} text-anchor="middle">{sub}</text>}
      </g>
    );
    const adW = L.cw * 0.6, adX = L.cx + (L.cw - adW) / 2;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Места параметров адаптеров, LoRA и настройки промпта' : 'Where adapters, LoRA and prompt tuning put their parameters'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Снизу вверх: токены входа, эмбеддинги с приписанными слева виртуальными токенами настройки промпта, внимание с ветвью LoRA справа, адаптер, полносвязный блок, второй адаптер, выход к следующему блоку. Эмбеддинги, внимание и полносвязный блок заморожены; виртуальные токены, ветвь LoRA и адаптеры обучаются.'
          : 'From bottom to top: input tokens, embeddings with the virtual tokens of prompt tuning prepended on the left, attention with the LoRA branch on the right, an adapter, the feed-forward network, a second adapter, and the output to the next block. Embeddings, attention and feed-forward are frozen; the virtual tokens, the LoRA branch and the adapters are trained.'}</desc>
        <text class="f-small f-t-muted" x={mid} y={rows.tok} text-anchor="middle">{t.tokens}</text>
        <path class="f-thin f-muted" d={`M ${mid} ${rows.tok - 14} V ${rows.emb + 36}`} marker-end="url(#f-arrow-muted)" />
        {box(rows.emb, 32, t.emb, false)}
        {/* prompt tuning: virtual tokens prepended to the embeddings */}
        {box(rows.emb, 32, t.virtual, true, undefined, L.left, L.lw)}
        <path class="f-thin f-amber" d={`M ${L.left + L.lw + 2} ${rows.emb + 16} H ${L.cx - 4}`} marker-end="url(#f-arrow-amber)" />
        <text class="f-small f-t-amber" x={L.left} y={rows.emb + 50}>{t.prompt}</text>
        <path class="f-thin f-muted" d={`M ${mid} ${rows.emb - 2} V ${rows.attn + 44}`} marker-end="url(#f-arrow-muted)" />
        {box(rows.attn, 40, t.attn, false, t.attnSub)}
        {/* LoRA branch beside the projections */}
        {box(rows.attn + 4, 32, 'B A', true, undefined, L.right, L.rw)}
        <path class="f-thin f-amber" d={`M ${L.cx + L.cw + 2} ${rows.attn + 30} H ${L.right - 4}`} marker-end="url(#f-arrow-amber)" />
        <path class="f-thin f-amber" d={`M ${L.right - 2} ${rows.attn + 12} H ${L.cx + L.cw + 4}`} marker-end="url(#f-arrow-amber)" />
        <text class="f-small f-t-amber" x={L.right + L.rw / 2} y={rows.attn + 52} text-anchor="middle">{t.lora}</text>
        <path class="f-thin f-muted" d={`M ${mid} ${rows.attn - 2} V ${rows.ad1 + 30}`} marker-end="url(#f-arrow-muted)" />
        {box(rows.ad1, 26, t.adapter, true, undefined, adX, adW)}
        <path class="f-thin f-muted" d={`M ${mid} ${rows.ad1 - 2} V ${rows.ffn + 38}`} marker-end="url(#f-arrow-muted)" />
        {box(rows.ffn, 34, t.ffn, false)}
        <path class="f-thin f-muted" d={`M ${mid} ${rows.ffn - 2} V ${rows.ad2 + 30}`} marker-end="url(#f-arrow-muted)" />
        {box(rows.ad2, 26, t.adapter, true, undefined, adX, adW)}
        <path class="f-thin f-muted" d={`M ${mid} ${rows.ad2 - 2} V ${rows.out - 2}`} marker-end="url(#f-arrow-muted)" />
        <text class="f-small f-t-muted" x={mid + 10} y={rows.out + 2}>{t.out}</text>
        {[[false, t.frozen], [true, t.trained]].map(([on, label], i) => (
          <g>
            <rect class={on ? 'f-box f-fill-amber' : 'f-box-soft'} x={L.W - (L.cls === 'fig-wide' ? 150 : 96)} y={L.H - 46 + i * 20} width="14" height="12" rx="2" />
            <text class="f-small" x={L.W - (L.cls === 'fig-wide' ? 130 : 76)} y={L.H - 36 + i * 20}>{label}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
