---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import Sub from '../generative-modeling/Sub.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The ReAct loop: the model reads the context, writes a thought (appended, no environment call) and an action;
// the runtime parses the action and applies the stopping rules; the tool's observation is appended. Five steps.
const t = ru
  ? {
      title: 'Цикл ReAct: мысль, действие, наблюдение',
      ctx: 'контекст c_t', r1: 'инструкции, примеры', r2: 'вопрос', r3: 'шаги 1 … t−1',
      model: 'модель', modelSub: 'мысль или действие', thought: 'мысль: в контекст, без наблюдения', thoughtN: 'мысль, в контекст',
      action: 'действие', run: 'среда выполнения', runSub: 'разбор, остановка', call: 'вызов', tools: 'инструменты', toolsSub: 'search, lookup',
      stop: 'finish, бюджет, повтор', stopN: 'finish', ans: 'ответ', obs: 'наблюдение в контекст', obsN: 'наблюдение в контекст',
      steps: ['модель читает контекст: инструкции, примеры, вопрос и все прошлые шаги', 'она пишет мысль, которая добавляется в контекст; среда не вызывается', 'она пишет действие, например search[Dunmore]', 'среда выполнения разбирает действие и проверяет правила остановки: finish, бюджет шагов, повтор', 'инструмент выполняется, и его наблюдение добавляется в контекст'],
      desc: 'Слева контекст из трёх строк: инструкции и примеры, вопрос, прошлые шаги. Стрелка ведёт к модели, которая пишет мысль или действие. Мысль по стрелке сверху возвращается в контекст без вызова среды. Действие идёт в среду выполнения, которая разбирает его и проверяет правила остановки; при finish, исчерпанном бюджете или повторе цикл заканчивается ответом. Иначе вызывается инструмент (search, lookup), и стрелка снизу возвращает наблюдение в контекст.',
    }
  : {
      title: 'The ReAct loop: thought, action, observation',
      ctx: 'context c_t', r1: 'instructions, examples', r2: 'question', r3: 'steps 1 … t−1',
      model: 'model', modelSub: 'thought or action', thought: 'thought: appended, no observation', thoughtN: 'thought, appended',
      action: 'action', run: 'runtime', runSub: 'parse, check stops', call: 'call', tools: 'tools', toolsSub: 'search, lookup',
      stop: 'finish, budget, repeat', stopN: 'finish', ans: 'answer', obs: 'observation, appended', obsN: 'observation, appended',
      steps: ['the model reads the context: instructions, examples, the question and every earlier step', 'it writes a thought, which is appended to the context; the environment is not called', 'it writes an action, such as search[Dunmore]', 'the runtime parses the action and applies the stopping rules: finish, the step budget, a repeat', 'the tool runs, and its observation is appended to the context'],
      desc: 'On the left a context of three rows: instructions and examples, the question, the earlier steps. An arrow leads to the model, which writes a thought or an action. A thought returns along the top arrow to the context without calling the environment. An action goes to the runtime, which parses it and applies the stopping rules; on finish, an exhausted budget or a repeat, the loop ends with an answer. Otherwise the tool (search, lookup) is called, and the bottom arrow returns the observation to the context.',
    };
if (t.steps.length !== 5) throw new Error('ReActLoop: the note lists five steps');
const id = 'react-loop';
const caption = ru
  ? 'Мысль — действие, которое меняет только контекст агента: среда её не видит, но каждый следующий шаг её читает. Правила остановки находятся в среде выполнения, а не в модели: она проверяет действие finish, бюджет шагов и повтор одного и того же вызова с тем же результатом. Контекст растёт на каждом шаге на мысль, действие и наблюдение.'
  : 'A thought is an action that changes only the agent\'s context: the environment never sees it, but every later step reads it. The stopping rules live in the runtime, not in the model: it checks for a finish action, the step budget and a call repeated with the same result. The context grows at every step by a thought, an action and an observation.';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 262" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <g data-s="1">
      <Box x={20} y={50} w={200} h={30} label={t.r1} tone="x" />
      <Box x={20} y={84} w={200} h={30} label={t.r2} tone="x" />
      <Box x={20} y={118} w={200} h={30} label={t.r3} tone="x" />
      <text class="f-small" x="120" y="168" text-anchor="middle"><Sub label={t.ctx} /></text>
      <Arrow pts={[[220, 99], [248, 99]]} />
      <Box x={250} y={71} w={140} h={56} label={t.model} sub={t.modelSub} tone="g" />
      <Badge x={235} y={78} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[320, 71], [320, 30], [120, 30], [120, 48]]} tone="amber" />
      <text class="f-small f-t-amber" x="220" y="22" text-anchor="middle">{t.thought}</text>
      <Badge x={340} y={50} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[390, 99], [448, 99]]} tone="red" />
      <text class="f-small f-t-red" x="419" y="91" text-anchor="middle">{t.action}</text>
      <Badge x={419} y={121} n={3} />
    </g>
    <g data-s="4">
      <Box x={450} y={71} w={140} h={56} label={t.run} sub={t.runSub} />
      <Arrow pts={[[520, 127], [520, 180]]} tone="red" />
      <text class="f-small f-t-red" x="528" y="160">{t.stop}</text>
      <Box x={470} y={182} w={100} h={34} label={t.ans} tone="y" />
      <Badge x={500} y={160} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[590, 99], [628, 99]]} />
      <text class="f-small f-t-muted" x="609" y="91" text-anchor="middle">{t.call}</text>
      <Box x={630} y={71} w={114} h={56} label={t.tools} sub={t.toolsSub} tone="h" />
      <Arrow pts={[[687, 127], [687, 246], [200, 246], [200, 150]]} tone="green" />
      <text class="f-small f-t-green" x="440" y="238" text-anchor="middle">{t.obs}</text>
      <Badge x={706} y={190} n={5} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 424" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <g data-s="1">
      <text class="f-small" x="180" y="24" text-anchor="middle"><Sub label={t.ctx} /></text>
      <Box x={40} y={32} w={280} h={28} label={t.r1} tone="x" />
      <Box x={40} y={64} w={280} h={28} label={t.r2} tone="x" />
      <Box x={40} y={96} w={280} h={28} label={t.r3} tone="x" />
      <Arrow pts={[[180, 124], [180, 150]]} />
      <Box x={100} y={152} w={160} h={52} label={t.model} sub={t.modelSub} tone="g" />
      <Badge x={204} y={137} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[100, 178], [20, 178], [20, 46], [38, 46]]} tone="amber" />
      <text class="f-small f-t-amber" x="26" y="142">{t.thoughtN}</text>
      <Badge x={20} y={198} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[180, 204], [180, 232]]} tone="red" />
      <text class="f-small f-t-red" x="190" y="222">{t.action}</text>
      <Badge x={76} y={218} n={3} />
    </g>
    <g data-s="4">
      <Box x={100} y={234} w={160} h={52} label={t.run} sub={t.runSub} />
      <Arrow pts={[[100, 260], [56, 260], [56, 314]]} tone="red" />
      <text class="f-small f-t-red" x="58" y="252" text-anchor="middle">{t.stopN}</text>
      <Box x={14} y={316} w={84} h={36} label={t.ans} tone="y" />
      <Badge x={272} y={260} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[180, 286], [180, 314]]} />
      <text class="f-small f-t-muted" x="190" y="304">{t.call}</text>
      <Box x={100} y={316} w={160} h={52} label={t.tools} sub={t.toolsSub} tone="h" />
      <Arrow pts={[[180, 368], [180, 392], [346, 392], [346, 110], [322, 110]]} tone="green" />
      <text class="f-small f-t-green" x="263" y="410" text-anchor="middle">{t.obsN}</text>
      <Badge x={90} y={392} n={5} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
