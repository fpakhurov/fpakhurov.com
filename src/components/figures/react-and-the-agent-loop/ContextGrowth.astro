---
import Figure from '../Figure.astro';
import Sub from '../generative-modeling/Sub.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The cost model of the note: s = 2,000 tokens before the first step, u = 80 tokens written and o = 220 tokens
// observed per step, d = u + o. L_t = s + (t - 1) d; the total read over T steps is the sum of L_1 ... L_T. With prompt
// caching at a tenth of the price, only L_T tokens are read at full price; the rest counts a tenth.
const C0 = 2000, STEP = 80 + 220, CACHED = 0.1;
const C = (t: number) => C0 + (t - 1) * STEP;
const total = (T: number) => T * C0 + (STEP * T * (T - 1)) / 2;
const equiv = (T: number) => C(T) + CACHED * (total(T) - C(T));
const quoted = [C(10), C(40), total(10), total(40), Math.round(equiv(40))].join(' ');
if (quoted !== '4700 13700 33500 314000 43730') throw new Error(`ContextGrowth: numbers drifted from the note (${quoted})`);
const cross = 1 + (2 * C0) / STEP;
if (Math.abs(cross - 14.33) > 0.01) throw new Error('ContextGrowth: the crossover drifted');

const Ts = Array.from({ length: 40 }, (_, i) => i + 1);
const k = (v: number) => v / 1000;
// Russian: four-digit numbers unseparated, larger ones with a no-break space; English: a comma.
const fmt = (v: number) => (ru ? (v >= 10000 ? String(v).replace(/\B(?=(\d{3})+(?!\d))/g, '\u00a0') : String(v)) : v.toLocaleString('en-US'));
const t = ru
  ? { title: 'Как растёт контекст цикла ReAct', a: 'длина контекста L_t, тыс. токенов', b: 'прочитано к шагу T, тыс. токенов', xa: 'шаг t', xb: 'число шагов T',
      total: 'прочитано без кэша', lin: 'линейная часть T·s', cache: 'с кэшем, 1/10 цены',
      desc: 'Две панели. Слева длина контекста на шаге t растёт линейно от 2 тысяч токенов при t = 1 до 4.7 тысячи при t = 10 и 13.7 тысячи при t = 40. Справа суммарное число прочитанных токенов к шагу T растёт квадратично до 314 тысяч при T = 40; пунктиром показана линейная часть T·s, 80 тысяч при T = 40; зелёная кривая — та же сумма с кэшированием префикса по десятой части цены, 43.7 тысячи при T = 40.' }
  : { title: 'How the context of a ReAct loop grows', a: 'context length L_t, thousand tokens', b: 'tokens read up to step T, thousands', xa: 'step t', xb: 'number of steps T',
      total: 'read, no caching', lin: 'linear part T·s', cache: 'cached, 1/10 price',
      desc: 'Two panels. On the left, the context length at step t grows linearly from 2 thousand tokens at t = 1 to 4.7 thousand at t = 10 and 13.7 thousand at t = 40. On the right, the total number of tokens read up to step T grows quadratically to 314 thousand at T = 40; a dashed line shows the linear part T·s, 80 thousand at T = 40; a green curve shows the same total with the prefix cached at a tenth of the price, 43.7 thousand at T = 40.' };
const id = 'context-growth';
const caption = ru
  ? `Модель затрат из текста: s = 2000 токенов до первого шага (инструкции, определения инструментов, задача), u = 80 токенов, которые модель пишет, и o = 220 токенов наблюдения на каждом шаге. Каждый шаг читает весь контекст заново, поэтому сумма растёт как T². Квадратичная часть обгоняет линейную после ${cross.toFixed(1)} шага. Кэширование префикса не уменьшает длину контекста, но берёт за повторно прочитанные токены десятую часть цены: при T = 40 это ${k(equiv(40)).toFixed(1)} тысячи токенов по полной цене вместо ${k(total(40))}.`
  : `The cost model of the text: s = 2,000 tokens before the first step (instructions, tool definitions, task), u = 80 tokens written by the model and o = 220 tokens of observation per step. Every step reads the whole context again, so the total grows like T². The quadratic part overtakes the linear part after ${cross.toFixed(1)} steps. Prefix caching does not shorten the context, but bills the re-read tokens at a tenth of the price: at T = 40 that is the equivalent of ${k(equiv(40)).toFixed(1)} thousand full-price tokens instead of ${k(total(40))}.`;
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 320, A: { px: [60, 340], py: [44, 258] }, B: { px: [440, 730], py: [44, 258] } },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 560, A: { px: [56, 340], py: [44, 222] }, B: { px: [56, 340], py: [314, 492] } },
];
const legend: [string, string, string][] = [['f-line f-blue', 'f-t-blue', t.total], ['f-line f-muted f-dash', 'f-t-muted', t.lin], ['f-line f-green', 'f-t-green', t.cache]];
const ticksA = [0, 4, 8, 12, 16], ticksB = [0, 80, 160, 240, 320], ticksX = [1, 10, 20, 30, 40];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const ax = scale([0, 40], L.A.px as [number, number]), ay = scale([0, 16], [L.A.py[1], L.A.py[0]]);
    const bx = scale([0, 40], L.B.px as [number, number]), by = scale([0, 320], [L.B.py[1], L.B.py[0]]);
    const curve = (sx: (v: number) => number, sy: (v: number) => number, f: (T: number) => number) => polyline(Ts.map((T) => [sx(T), sy(k(f(T)))] as [number, number]));
    const panels = [
      { P: L.A, sx: ax, sy: ay, ticks: ticksA, title: t.a, xl: t.xa },
      { P: L.B, sx: bx, sy: by, ticks: ticksB, title: t.b, xl: t.xb },
    ];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {panels.map((p) => (
          <g>
            {p.ticks.map((v) => <path class="f-grid" d={`M ${p.P.px[0]} ${p.sy(v)} H ${p.P.px[1]}`} />)}
            <path class="f-axis" d={`M ${p.P.px[0]} ${p.P.py[0] - 6} V ${p.P.py[1]} H ${p.P.px[1]}`} />
            {p.ticks.map((v) => <text class="f-small" x={p.P.px[0] - 7} y={p.sy(v) + 4} text-anchor="end">{String(v)}</text>)}
            {ticksX.map((v) => <text class="f-small" x={p.sx(v)} y={p.P.py[1] + 18} text-anchor="middle">{String(v)}</text>)}
            <text class="f-small f-t-muted" x={(p.P.px[0] + p.P.px[1]) / 2} y={p.P.py[1] + 38} text-anchor="middle">{p.xl}</text>
            <text class="f-small f-t-muted" x={p.P.px[0] - 36} y={p.P.py[0] - 20}><Sub label={p.title} /></text>
          </g>
        ))}
        <path class="f-line f-blue" d={curve(ax, ay, C)} />
        {[10, 40].map((T) => <circle cx={ax(T)} cy={ay(k(C(T)))} r="3.2" class="f-solid-blue" />)}
        <text class="f-small f-t-blue f-halo" x={ax(10) + 6} y={ay(k(C(10))) - 9}>{fmt(C(10))}</text>
        <text class="f-small f-t-blue f-halo" x={ax(40) - 6} y={ay(k(C(40))) - 10} text-anchor="end">{fmt(C(40))}</text>
        <path class="f-line f-muted f-dash" d={curve(bx, by, (T) => T * C0)} />
        <path class="f-line f-blue" d={curve(bx, by, total)} />
        <path class="f-line f-green" d={curve(bx, by, equiv)} />
        {legend.map(([cls, tc, label], i) => (
          <g>
            <path class={cls} d={`M ${L.B.px[0] + 12} ${L.B.py[0] + 16 + i * 19} h 22`} />
            <text class={`f-small ${tc}`} x={L.B.px[0] + 42} y={L.B.py[0] + 20 + i * 19}><Sub label={label} /></text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
