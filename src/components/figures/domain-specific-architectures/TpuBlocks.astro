---
import BlockDiagram, { type DLayout } from '../BlockDiagram.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The main blocks of the first TPU and the path of one layer through them (Jouppi et al., 2017, §2 and Figure 1).
// Sizes checked against the paper: 256 x 256 = 65,536 MACs; a weight tile is 256 x 256 bytes = 64 KiB;
// 4 MiB of accumulators = 4096 x 256 x 4 bytes.
const macs = 256 * 256, tile = 256 * 256, acc = 4096 * 256 * 4;
if (macs !== 65536 || tile !== 64 * 1024 || acc !== 4 * 1024 * 1024) throw new Error('TPU sizes');
const peak = (2 * macs * 700e6) / 1e12;
if (Math.round(peak) !== 92) throw new Error(`peak ${peak}`);

const t = ru
  ? { host: 'интерфейс хоста', hostSub: 'PCIe Gen3 ×16', ub: 'Unified Buffer', ubSub: '24 МиБ, активации', setup: 'подготовка', setupSub: 'сдвиг строк',
      mmu: 'Matrix Multiply\nUnit', mmuSub: '256 × 256 MAC, 8 бит', fifo: 'Weight FIFO', fifoSub: '4 плитки по 64 КиБ', dram: 'Weight Memory', dramSub: '8 ГиБ DDR3, 34 ГБ/с',
      acc: 'аккумуляторы', accSub: '4 МиБ, 32 бита', act: 'активация, пулинг', actSub: 'ReLU, сигмоида, …' }
  : { host: 'host interface', hostSub: 'PCIe Gen3 ×16', ub: 'Unified Buffer', ubSub: '24 MiB, activations', setup: 'data setup', setupSub: 'skews the rows',
      mmu: 'Matrix Multiply\nUnit', mmuSub: '256 × 256 MACs, 8-bit', fifo: 'Weight FIFO', fifoSub: '4 tiles of 64 KiB', dram: 'Weight Memory', dramSub: '8 GiB DDR3, 34 GB/s',
      acc: 'accumulators', accSub: '4 MiB, 32-bit', act: 'activation, pooling', actSub: 'ReLU, sigmoid, …' };
const desc = ru
  ? 'Блок-схема TPU. Слева интерфейс хоста, от него стрелка 1 к Unified Buffer на 24 мебибайта. От буфера через блок подготовки данных стрелка 3 к матричному блоку 256 на 256. Сверху память весов на 8 гибибайт DDR3 передаёт веса стрелкой 2 в Weight FIFO и дальше в матричный блок. Под матричным блоком аккумуляторы на 4 мебибайта, от них стрелка 4 к блоку активации и обратно в буфер. Стрелка 5 возвращает результаты из буфера к хосту.'
  : 'Block diagram of the TPU. At the left the host interface, with arrow 1 to the 24 MiB Unified Buffer. From the buffer, through a data-setup block, arrow 3 leads to the 256 by 256 matrix unit. At the top the 8 GiB DDR3 weight memory sends weights along arrow 2 into the weight FIFO and on into the matrix unit. Below the matrix unit are the 4 MiB accumulators, with arrow 4 to the activation block and back into the buffer. Arrow 5 returns results from the buffer to the host.';

const wide: DLayout = {
  cls: 'fig-wide', w: 760, h: 316, desc,
  nodes: [
    { id: 'host', x: 10, y: 132, w: 124, h: 56, label: t.host, sub: t.hostSub, tone: 'soft' },
    { id: 'ub', x: 176, y: 116, w: 160, h: 88, label: t.ub, sub: t.ubSub, tone: 'green' },
    { id: 'setup', x: 370, y: 132, w: 110, h: 56, label: t.setup, sub: t.setupSub },
    { id: 'mmu', x: 516, y: 104, w: 210, h: 112, label: t.mmu, sub: t.mmuSub, tone: 'blue' },
    { id: 'fifo', x: 516, y: 10, w: 210, h: 56, label: t.fifo, sub: t.fifoSub, tone: 'amber' },
    { id: 'dram', x: 250, y: 10, w: 210, h: 56, label: t.dram, sub: t.dramSub, tone: 'amber' },
    { id: 'acc', x: 516, y: 250, w: 210, h: 56, label: t.acc, sub: t.accSub, tone: 'red' },
    { id: 'act', x: 250, y: 250, w: 210, h: 56, label: t.act, sub: t.actSub, tone: 'red' },
  ],
  edges: [
    { from: 'host', to: 'ub', label: '1' },
    { from: 'dram', to: 'fifo', label: '2', tone: 'amber' },
    { from: 'fifo', to: 'mmu', tone: 'amber' },
    { from: 'ub', to: 'setup', label: '3', tone: 'green' },
    { from: 'setup', to: 'mmu', tone: 'green' },
    { from: 'mmu', to: 'acc', tone: 'red' },
    { from: 'acc', to: 'act', label: '4', tone: 'red' },
    { from: 'act', to: 'ub', via: [[226, 278]], tone: 'red' },
    { from: 'ub', to: 'host', via: [[256, 96], [72, 96]], label: '5', at: [164, 90] },
  ],
};
const narrow: DLayout = {
  cls: 'fig-narrow', w: 360, h: 620, desc,
  nodes: [
    { id: 'dram', x: 10, y: 10, w: 210, h: 54, label: t.dram, sub: t.dramSub, tone: 'amber' },
    { id: 'fifo', x: 10, y: 94, w: 210, h: 54, label: t.fifo, sub: t.fifoSub, tone: 'amber' },
    { id: 'mmu', x: 10, y: 178, w: 210, h: 84, label: t.mmu, sub: t.mmuSub, tone: 'blue' },
    { id: 'setup', x: 248, y: 196, w: 104, h: 50, label: t.setup },
    { id: 'acc', x: 10, y: 292, w: 210, h: 54, label: t.acc, sub: t.accSub, tone: 'red' },
    { id: 'act', x: 10, y: 376, w: 210, h: 54, label: t.act, sub: t.actSub, tone: 'red' },
    { id: 'ub', x: 10, y: 460, w: 210, h: 62, label: t.ub, sub: t.ubSub, tone: 'green' },
    { id: 'host', x: 10, y: 556, w: 210, h: 54, label: t.host, sub: t.hostSub, tone: 'soft' },
  ],
  edges: [
    { from: 'dram', to: 'fifo', label: '2', tone: 'amber', at: [128, 83] },
    { from: 'fifo', to: 'mmu', tone: 'amber' },
    { from: 'ub', to: 'setup', via: [[300, 491]], label: '3', tone: 'green', at: [308, 380] },
    { from: 'setup', to: 'mmu', tone: 'green' },
    { from: 'mmu', to: 'acc', tone: 'red' },
    { from: 'acc', to: 'act', label: '4', tone: 'red', at: [128, 365] },
    { from: 'act', to: 'ub', tone: 'red' },
    { from: 'host', to: 'ub', via: [[80, 540]], label: '1', at: [70, 546] },
    { from: 'ub', to: 'host', via: [[150, 540]], label: '5', at: [160, 546] },
  ],
};
---

<BlockDiagram
  id="tpu-blocks"
  title={ru ? 'Основные блоки первого TPU и путь одного слоя' : 'The main blocks of the first TPU and the path of one layer'}
  svgTitle={ru ? 'Блок-схема TPU v1' : 'Block diagram of TPU v1'}
  caption={ru
    ? 'Первый TPU — сопроцессор на шине PCIe; хост присылает ему команды. Числа на стрелках — пять главных команд: (1) Read_Host_Memory копирует входы в Unified Buffer; (2) Read_Weights подаёт плитку весов 256 × 256 из внешней памяти DDR3 через Weight FIFO; (3) MatrixMultiply прогоняет строки активаций через массив из 65 536 восьмибитных блоков умножения с накоплением, по 256 значений за такт; (4) Activate применяет нелинейность к 32-битным суммам из аккумуляторов и пишет результат обратно в буфер, где он становится входом следующего слоя; (5) Write_Host_Memory возвращает результат хосту. На кристалле 28 МиБ памяти: 24 МиБ буфера и 4 МиБ аккумуляторов. Пик: 65 536 · 2 операции · 700 МГц ≈ 92 трлн операций в секунду.'
    : 'The first TPU is a coprocessor on the PCIe bus; the host sends it instructions. The numbers on the arrows are its five main instructions: (1) Read_Host_Memory copies inputs into the Unified Buffer; (2) Read_Weights brings a 256 × 256 tile of weights from the off-chip DDR3 memory through the weight FIFO; (3) MatrixMultiply streams rows of activations through the array of 65,536 8-bit multiply-accumulate units, 256 values per cycle; (4) Activate applies the nonlinearity to the 32-bit sums in the accumulators and writes the result back to the buffer, where it becomes the input of the next layer; (5) Write_Host_Memory returns the result to the host. The chip has 28 MiB of on-chip memory: the 24 MiB buffer and 4 MiB of accumulators. Peak: 65,536 · 2 operations · 700 MHz ≈ 92 trillion operations per second.'}
  layouts={[wide, narrow]}
/>
