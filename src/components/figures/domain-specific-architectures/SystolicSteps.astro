---
import Figure from '../Figure.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Y = X W on a 3 x 3 weight-stationary systolic array, the worked example of the note and of its Code section.
// Cell (k, n) holds W[k][n]. X[m][k] enters row k from the left at cycle m + k + 1 and moves one cell right per
// cycle, so cell (k, n) sees X[m][k] at cycle t = m + k + n + 1. The partial sum of Y[m][n] moves one cell down per
// cycle and leaves the bottom of column n at cycle m + n + K.
const X = [[1, 2, 3], [4, 5, 6], [7, 8, 9]];
const W = [[1, 0, 2], [1, 1, 0], [0, 2, 1]];
const M = 3, K = 3, N = 3;
const T = M + K + N - 2;
const idx = (k: number) => Array.from({ length: k }, (_, i) => i);
const Y = idx(M).map((m) => idx(N).map((n) => idx(K).reduce((a, k) => a + X[m][k] * W[k][n], 0)));
if (JSON.stringify(Y) !== '[[3,8,5],[9,17,14],[15,26,23]]') throw new Error(`Y = ${JSON.stringify(Y)}`);
const partial = (m: number, n: number, k: number) => idx(k + 1).reduce((a, j) => a + X[m][j] * W[j][n], 0);
interface CellState { x: number; s: number }
const state = (t: number, k: number, n: number): CellState | null => {
  const m = t - 1 - k - n;
  const ok = m >= 0 && m < M;
  return ok ? { x: X[m][k], s: partial(m, n, k) } : null;
};
const cycles = idx(T).map((i) => i + 1);
const macs = cycles.map((t) => idx(K).reduce((a, k) => a + idx(N).filter((n) => state(t, k, n) !== null).length, 0));
if (macs.join(',') !== '1,3,6,7,6,3,1' || T !== 7) throw new Error(`MACs per cycle ${macs}`);
// what waits at the left of row k after cycle t: X[m][k] enters at cycle m + k + 1, so it sits m + k - t slots from the
// array (the skew of the rows shows as a staircase); and what has left the bottom of column n
const waiting = (t: number, k: number) => idx(M).filter((m) => m + k + 1 > t).map((m) => ({ v: X[m][k], slot: m + k - t }));
const done = (t: number, n: number) => idx(M).filter((m) => m + n + K <= t).map((m) => Y[m][n]);
interface Panel { t: number; title: string; cells: { k: number; n: number; st: CellState | null }[]; wait: { v: number; slot: number }[][]; out: number[][] }
const panels: Panel[] = [0, ...cycles].map((t) => ({
  t,
  title: t === 0
    ? (ru ? 'веса загружены' : 'weights loaded')
    : (ru ? `такт ${t} · MAC: ${macs[t - 1]}` : `cycle ${t} · ${macs[t - 1]} MAC${macs[t - 1] === 1 ? '' : 's'}`),
  cells: idx(K).flatMap((k) => idx(N).map((n) => ({ k, n, st: t === 0 ? null : state(t, k, n) }))),
  wait: idx(K).map((k) => waiting(t, k)),
  out: idx(N).map((n) => done(t, n)),
}));

const t = ru
  ? {
      steps: ['веса W загружены: в каждой ячейке одно w; входы X ждут слева, со сдвигом на такт для каждой строки', ...cycles.map((c) => `такт ${c}: ${macs[c - 1]} MAC; ${c === 3 ? 'y00 = 3 выходит снизу столбца 0' : c === 7 ? 'выходит последний результат, y22 = 23' : 'x сдвигаются вправо, частичные суммы — вниз'}`)],
      legend: ['зелёный: x, идёт вправо', 'синий: частичная сумма, идёт вниз', 'красный: готовые y', 'янтарный: веса w'],
    }
  : {
      steps: ['weights W loaded: one w per cell; the inputs X wait at the left, each row one cycle later than the row above', ...cycles.map((c) => `cycle ${c}: ${macs[c - 1]} multiply-accumulates; ${c === 3 ? 'y00 = 3 leaves the bottom of column 0' : c === 7 ? 'the last output, y22 = 23, leaves' : 'x values move right, partial sums move down'}`)],
      legend: ['green: x, moving right', 'blue: partial sum, moving down', 'red: finished outputs y', 'amber: weights w'],
    };

interface Layout { cls: string; W: number; H: number; cols: number; pw: number; ph: number; cell: number; ax: number; ay: number; legend: [number, number][]; lineH: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 420, cols: 4, pw: 190, ph: 194, cell: 36, ax: 70, ay: 28, legend: [[12, 410], [180, 410], [430, 410], [600, 410]], lineH: 14 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 870, cols: 2, pw: 180, ph: 196, cell: 34, ax: 68, ay: 30, legend: [[12, 806], [12, 826], [12, 846], [12, 866]], lineH: 16 },
];
const id = 'systolic-steps';
---

<Figure
  id={id}
  title={ru ? 'Систолический массив 3 × 3 перемножает матрицы такт за тактом' : 'A 3 × 3 systolic array multiplies two matrices, cycle by cycle'}
  caption={ru
    ? `Y = XW для X = [[1, 2, 3], [4, 5, 6], [7, 8, 9]] и W = [[1, 0, 2], [1, 1, 0], [0, 2, 1]] на массиве с неподвижными весами (weight-stationary), как в TPU. Ячейка (k, n) хранит w_kn (первая панель). Строка k матрицы X входит слева со сдвигом на k тактов (лесенка зелёных чисел слева); каждый такт x переходит на ячейку вправо (зелёное число вверху ячейки), а ячейка прибавляет w · x к частичной сумме, пришедшей сверху, и передаёт её вниз (синее число внизу). Снизу выходят готовые y_mn (красные). Первый результат, y00 = 1·1 + 2·1 + 3·0 = 3, выходит на такте 3, последний, y22 = 23, — на такте ${T} = M + K + N − 2; всего 27 умножений с накоплением на 9 ячейках за ${T} тактов.`
    : `Y = XW for X = [[1, 2, 3], [4, 5, 6], [7, 8, 9]] and W = [[1, 0, 2], [1, 1, 0], [0, 2, 1]] on a weight-stationary array, as in the TPU. Cell (k, n) holds w_kn (first panel). Row k of X enters from the left k cycles late (the staircase of green numbers waiting at the left); every cycle each x moves one cell right (the green number at the top of a cell), and each cell adds w · x to the partial sum from the cell above and passes it down (the blue number at the bottom). Finished outputs y_mn leave at the bottom (red). The first output, y00 = 1·1 + 2·1 + 3·0 = 3, leaves at cycle 3, the last, y22 = 23, at cycle ${T} = M + K + N − 2: 27 multiply-accumulates on 9 cells in ${T} cycles.`}
>
  {layouts.map((L) => {
    const grid = K * L.cell;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Восемь состояний систолического массива 3 на 3' : 'Eight states of a 3 by 3 systolic array'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Восемь панелей. Первая показывает веса в девяти ячейках. Следующие семь показывают такты с 1 по 7: в каждой ячейке значение x, которое через неё проходит, и частичная сумма; слева ждут ещё не вошедшие x, снизу собираются готовые выходы. На такте 4 работают 7 ячеек; выходы появляются с такта 3 по такт 7.'
          : 'Eight panels. The first shows the weights in the nine cells. The next seven show cycles 1 to 7: each cell shows the x passing through it and the partial sum; the x values not yet entered wait at the left, and finished outputs collect below. At cycle 4 seven cells are busy; outputs appear from cycle 3 to cycle 7.'}</desc>
        {panels.map((P, p) => {
          const px = (p % L.cols) * L.pw, py = Math.floor(p / L.cols) * L.ph;
          const gx = px + L.ax, gy = py + L.ay;
          return (
            <g data-s={String(p + 1)}>
              <rect x={px + 3} y={py + 3} width={L.pw - 6} height={L.ph - 6} rx="8" style="fill: none; stroke: var(--line); stroke-width: 1" />
              <text class="f-small" x={px + 12} y={py + 20} style="font-weight: 650">{P.title}</text>
              {P.cells.map(({ k, n, st }) => {
                const cx = gx + n * L.cell, cy = gy + k * L.cell;
                return (
                  <g>
                    <rect x={cx} y={cy} width={L.cell} height={L.cell} style={`fill: ${st ? 'var(--fig-blue)' : 'var(--paper-strong)'}; fill-opacity: ${st ? 0.1 : 1}; stroke: var(--muted); stroke-width: 1`} />
                    {P.t === 0 && <text class="f-small f-t-amber" x={cx + L.cell / 2} y={cy + L.cell / 2 + 5} text-anchor="middle" style="font-weight: 650">{W[k][n]}</text>}
                    {st && <text class="f-small f-t-green" x={cx + 10} y={cy + 15} text-anchor="middle">{st.x}</text>}
                    {st && <text class="f-small f-t-blue" x={cx + L.cell - 11} y={cy + L.cell - 5} text-anchor="middle" style="font-weight: 650">{st.s}</text>}
                  </g>
                );
              })}
              {P.wait.map((vals, k) => vals.map(({ v, slot }) => (
                <text class="f-small f-t-green" x={gx - 9 - slot * 12} y={gy + k * L.cell + L.cell / 2 + 5} text-anchor="middle">{v}</text>
              )))}
              {P.out.map((vals, n) => vals.map((v, j) => (
                <text class="f-small f-t-red" x={gx + n * L.cell + L.cell / 2} y={gy + grid + 17 + j * L.lineH} text-anchor="middle" style="font-weight: 650">{v}</text>
              )))}
            </g>
          );
        })}
        {t.legend.map((s, i) => (
          <text class={`f-small ${['f-t-green', 'f-t-blue', 'f-t-red', 'f-t-amber'][i]}`} x={L.legend[i][0]} y={L.legend[i][1]}>{s}</text>
        ))}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
