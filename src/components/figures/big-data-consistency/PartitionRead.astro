---
import Figure from '../Figure.astro';

const ru = Astro.props.lang === 'ru';
const title = ru ? 'На A обе истории выглядят одинаково' : 'Both histories look the same on A';
const caption = ru
  ? 'В первой истории B и C подтвердили оплату. Во второй записи не было. A изолирован и в обеих историях хранит unpaid.'
  : 'In the first history B and C acknowledged payment. In the second no write occurred. A is isolated and holds unpaid in both.';
const histories = [
  { label: ru ? 'Оплата записана' : 'Payment written', remote: 'paid', color: 'f-fill-green' },
  { label: ru ? 'Записи не было' : 'No payment write', remote: 'unpaid', color: 'f-fill-blue' },
];
---
<Figure id="big-data-partition-read" title={title} caption={caption}>
  <svg viewBox="0 0 340 165" role="img" aria-labelledby="partition-read-title partition-read-desc" style="max-width: 510px; margin-inline: auto">
    <title id="partition-read-title">{title}</title>
    <desc id="partition-read-desc">{caption}</desc>
    {histories.map(({label, remote, color}, i) => (
      <g transform={`translate(0 ${i * 80})`}>
        <text class="f-label" x="10" y="23">{label}</text>
        <rect class="f-fill-blue" x="10" y="34" width="145" height="34" rx="5" />
        <rect class={color} x="185" y="34" width="145" height="34" rx="5" />
        <path class="f-line f-red f-dash" d="M 170 32 V 70" />
        <text class="f-label" x="82" y="56" text-anchor="middle">A · unpaid</text>
        <text class="f-label" x="257" y="56" text-anchor="middle">B, C · {remote}</text>
      </g>
    ))}
  </svg>
</Figure>
