---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale } from '../geometry';
import { mulberry32 } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The bootstrap for the median of 20 skewed values (exponential with mean 1): resample with replacement,
// recompute the median, repeat 2,000 times, read the 2.5% and 97.5% percentiles.
const u = mulberry32(18), n = 20;
const sample = Array.from({ length: n }, () => -Math.log(1 - u())).map((v) => Math.round(v * 100) / 100);
const median = (xs: number[]) => { const s = [...xs].sort((a, b) => a - b); return (s[n / 2 - 1] + s[n / 2]) / 2; };
const resample = () => Array.from({ length: n }, () => sample[Math.floor(u() * n)]);
const shown = [resample(), resample(), resample()];
const boots = Array.from({ length: 2000 }, () => median(resample())).sort((a, b) => a - b);
const lo = boots[49], hi = boots[1949], med = median(sample);
if (!(lo < med && med < hi && hi - lo > 0.1)) throw new Error('BootstrapSteps: the bootstrap interval is degenerate');
const top = Math.max(2.6, Math.ceil(Math.max(...sample) * 2) / 2), B = Math.round(top / 0.087), bw = top / B;
const hist = new Array(B).fill(0);
for (const b of boots) hist[Math.min(B - 1, Math.floor(b / bw))]++;
const hmax = Math.max(...hist);
const stack = (xs: number[]) => { const seen = new Map<number, number>(); return xs.map((v) => { const k = seen.get(v) ?? 0; seen.set(v, k + 1); return [v, k] as [number, number]; }); };
const t = ru
  ? { s: 'выборка: 20 значений', r: (i: number) => `повторная выборка ${i + 1}`, h: '2000 бутстрэп-медиан', med: 'медиана',
      steps: ['исходная выборка из 20 значений и её медиана', 'повторные выборки того же размера с возвращением: значения повторяются или выпадают; у каждой своя медиана', `2000 таких медиан; их 2.5% и 97.5% перцентили дают интервал [${lo.toFixed(2)}, ${hi.toFixed(2)}]`] }
  : { s: 'the sample: 20 values', r: (i: number) => `resample ${i + 1}`, h: '2,000 bootstrap medians', med: 'median',
      steps: ['the original sample of 20 values and its median', 'resamples of the same size, drawn with replacement: values repeat or drop out, and each has its own median', `2,000 such medians; their 2.5% and 97.5% percentiles give the interval [${lo.toFixed(2)}, ${hi.toFixed(2)}]`] };
const id = 'bootstrap-steps';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 640, H: 420, x0: 190, x1: 620, lx: 34 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 470, x0: 16, x1: 344, lx: 16 },
];
---

<Figure
  id={id}
  title={ru ? 'Бутстрэп для медианы по шагам' : 'The bootstrap for a median, step by step'}
  caption={ru
    ? `Медиана 20 значений из асимметричного распределения равна ${med.toFixed(2)}; формулы для её стандартной ошибки нет. Бутстрэп подменяет неизвестное распределение выборкой: из неё берутся повторные выборки с возвращением (1, 2), для каждой считается медиана, и разброс этих медиан заменяет выборочное распределение (3). Перцентильный 95-процентный интервал: [${lo.toFixed(2)}, ${hi.toFixed(2)}].`
    : `The median of 20 values from a skewed distribution is ${med.toFixed(2)}; there is no formula for its standard error. The bootstrap lets the sample stand in for the unknown distribution: resamples are drawn from it with replacement (1, 2), the median is recomputed for each, and the spread of these medians replaces the sampling distribution (3). The 95% percentile interval is [${lo.toFixed(2)}, ${hi.toFixed(2)}].`}
>
  {layouts.map((L) => {
    const sx = scale([0, top], [L.x0, L.x1]);
    const wide = L.cls.includes('wide');
    const rowY = (k: number) => (wide ? 40 + k * 64 : 50 + k * 70);
    const hy0 = wide ? 300 : 340, hy1 = wide ? 380 : 430;
    const hsy = scale([0, hmax], [hy1, hy0]);
    const label = (k: number, text: string) => wide
      ? <text class="f-small" x={L.lx} y={rowY(k) + 4}>{text}</text>
      : <text class="f-small" x={L.lx} y={rowY(k) - 26}>{text}</text>;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Выборка, повторные выборки и гистограмма медиан' : 'A sample, resamples and a histogram of medians'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? `Точки исходной выборки, три повторные выборки со стопками повторов и гистограмма 2000 медиан с интервалом от ${lo.toFixed(2)} до ${hi.toFixed(2)}.` : `Dots of the original sample, three resamples with stacks of repeats, and a histogram of 2,000 medians with an interval from ${lo.toFixed(2)} to ${hi.toFixed(2)}.`}</desc>
        <g data-s="1">
          {label(0, t.s)}
          <path class="f-axis" d={`M ${L.x0} ${rowY(0) + 8} H ${L.x1}`} />
          {sample.map((v) => <circle cx={sx(v).toFixed(1)} cy={rowY(0)} r="3.6" style="fill: var(--fig-blue); fill-opacity: .7" />)}
          <path class="f-line f-red" d={`M ${sx(med)} ${rowY(0) - 14} V ${rowY(0) + 12}`} />
          <Badge x={wide ? 16 : L.x1 - 10} y={wide ? rowY(0) : rowY(0) - 30} n={1} />
        </g>
        <g data-s="2">
          {shown.map((rs, k) => (
            <g>
              {label(k + 1, t.r(k))}
              <path class="f-axis" d={`M ${L.x0} ${rowY(k + 1) + 8} H ${L.x1}`} />
              {stack(rs).map(([v, j]) => <circle cx={sx(v).toFixed(1)} cy={rowY(k + 1) - j * 7} r="3.2" style="fill: var(--fig-green); fill-opacity: .7" />)}
              <path class="f-line f-red" d={`M ${sx(median(rs))} ${rowY(k + 1) - 18} V ${rowY(k + 1) + 12}`} />
            </g>
          ))}
          <Badge x={wide ? 16 : L.x1 - 10} y={wide ? rowY(1) : rowY(1) - 30} n={2} />
        </g>
        <g data-s="3">
          <text class="f-small" x={L.lx} y={wide ? hy0 + 30 : hy0 - 12}>{t.h}</text>
          {hist.map((c, b) => <rect x={sx(b * bw)} y={hsy(c)} width={sx(bw) - sx(0) - 1} height={hy1 - hsy(c)} style="fill: var(--fig-red); fill-opacity: .45" />)}
          <path class="f-axis" d={`M ${L.x0} ${hy1} H ${L.x1}`} />
          <path class="f-line f-amber" d={`M ${sx(lo)} ${hy1 + 6} V ${hy0} M ${sx(hi)} ${hy1 + 6} V ${hy0}`} />
          {[0, 1, 2].map((v) => <text class="f-note" x={sx(v)} y={hy1 + 20} text-anchor="middle">{v}</text>)}
          <Badge x={wide ? 16 : L.x1 - 10} y={wide ? hy0 + 26 : hy0 - 18} n={3} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
