---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
const ru = pageLang(Astro.url) === 'ru';
const values = [1, 2, 4, 8];
const counts = new Map<number, number>();
for (const a of values) for (const b of values) for (const c of values) for (const d of values) {
  const mean = (a + b + c + d) / 4;
  counts.set(mean, (counts.get(mean) || 0) + 1);
}
const mass = [...counts].sort((a,b) => a[0]-b[0]).map(([mean,count]) => ({mean,count,p:count/256}));
const x = (mean: number) => 58 + (mean - 1) * 238 / 7;
const y = (p: number) => 226 - p * 166 / .15;
const title = ru ? '256 выборок дают конечное распределение среднего' : '256 resamples give a finite mean distribution';
const caption = ru ? 'Четыре независимых выбора с возвращением из [1,2,4,8]. Каждый столбик объединяет выборки с одинаковым средним. Синие столбики лежат в процентильном интервале [1.5,6.5], оранжевые — снаружи. Это условное бутстрэп-распределение при фиксированных исходных данных.' : 'Four independent draws with replacement from [1,2,4,8]. Each bar combines resamples with the same mean. Blue bars lie in the percentile interval [1.5,6.5]; amber bars lie outside. This bootstrap distribution conditions on the fixed original data.';
---
<Figure id="bootstrap-steps" title={title} caption={caption}>
  <svg class="fig-compact" viewBox="0 0 320 280" role="img" aria-labelledby={`bootstrap-title-${ru ? 'ru' : 'en'}`}>
    <title id={`bootstrap-title-${ru ? 'ru' : 'en'}`}>{title}</title>
    <desc>{ru ? 'Вероятности бутстрэп-средних от 1 до 8. Синие столбики соответствуют интервалу от 1.5 до 6.5; пунктирная вертикальная линия отмечает среднее 3.75.' : 'Probabilities of bootstrap means from 1 to 8. Blue bars indicate the interval from 1.5 to 6.5; a dashed vertical line marks the mean 3.75.'}</desc>
    <text x="58" y="25">{ru ? 'Вероятность' : 'Probability'}</text>
    {[0,.05,.1,.15].map(p => <g><line x1="58" x2="300" y1={y(p)} y2={y(p)} class="f-grid" /><text x="47" y={y(p)+5} text-anchor="end">{p}</text></g>)}
    <line x1="58" x2="58" y1="60" y2="226" class="f-axis" />
    {mass.map(row => <line data-mean={row.mean} data-count={row.count} x1={x(row.mean)} x2={x(row.mean)} y1="226" y2={y(row.p)} class={row.mean >= 1.5 && row.mean <= 6.5 ? 'f-line f-blue' : 'f-line f-amber'} style="stroke-width:3px" />)}
    <line x1={x(3.75)} x2={x(3.75)} y1="60" y2="226" class="f-axis f-dash" />
    {[1,2,4,6,8].map(mean => <text x={x(mean)} y="249" text-anchor="middle">{mean}</text>)}
    <text x="178" y="274" text-anchor="middle">{ru ? 'Среднее выборки' : 'Resample mean'}</text>
  </svg>
  <p class="summary">{ru ? 'Среднее: 3.75 · Стандартная ошибка: 1.340476' : 'Mean: 3.75 · Standard error: 1.340476'}</p>
</Figure>
<style>
svg :global(text) { font-size: 16px; font-variant-numeric: tabular-nums; }
.summary { text-align: center; font-size: .85rem; margin: .75rem 0 0; }
</style>
