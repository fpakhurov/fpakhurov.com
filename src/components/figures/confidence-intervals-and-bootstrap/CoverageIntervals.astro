---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { mulberry32, normal } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// 100 repetitions of the same experiment: 10 draws from N(5, 2²) and the 95% t-interval x̄ ± 2.262 s/√10.
// Each interval either contains the true mean 5 or not; over many repetitions 95% do.
const t9 = 2.262, z = normal(mulberry32(9));
const ivs = Array.from({ length: 100 }, () => {
  const x = Array.from({ length: 10 }, () => 5 + 2 * z());
  const m = x.reduce((a, b) => a + b, 0) / 10, s = Math.sqrt(x.reduce((a, b) => a + (b - m) ** 2, 0) / 9), h = (t9 * s) / Math.sqrt(10);
  return { m, lo: m - h, hi: m + h, miss: m - h > 5 || m + h < 5 };
});
const misses = ivs.filter((v) => v.miss).length;
if (misses !== 5) throw new Error('CoverageIntervals: the seeded run no longer has 5 misses');
const id = 'coverage-intervals';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 280, x0: 40, x1: 750, y0: 20, y1: 240 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 300, x0: 30, x1: 350, y0: 20, y1: 250 },
];
---

<Figure
  id={id}
  title={ru ? 'Сто доверительных интервалов для одного и того же среднего' : 'A hundred confidence intervals for the same mean'}
  caption={ru
    ? `Сто повторений одного эксперимента: 10 наблюдений из N(5, 2²) и 95-процентный t-интервал x̄ ± 2.262 s/√10. Интервалы разной длины и с разными центрами; ${100 - misses} из 100 содержат истинное среднее 5 (пунктир), ${misses} не содержат (красные). «95%» — свойство процедуры: доля накрывающих интервалов при повторении, а не вероятность того, что конкретный интервал накрывает 5.`
    : `A hundred repetitions of one experiment: 10 observations from N(5, 2²) and the 95% t-interval x̄ ± 2.262 s/√10. The intervals differ in length and centre; ${100 - misses} of 100 contain the true mean 5 (dashed), ${misses} do not (red). "95%" is a property of the procedure, the share of intervals that cover under repetition, not the probability that one particular interval covers 5.`}
>
  {layouts.map((L) => {
    const sx = (i: number) => L.x0 + ((i + 0.5) * (L.x1 - L.x0)) / 100, sy = scale([1, 9], [L.y1, L.y0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Сто вертикальных интервалов' : 'A hundred vertical intervals'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? `Из 100 интервалов ${misses} не пересекают линию истинного среднего 5.` : `Of 100 intervals, ${misses} miss the line of the true mean 5.`}</desc>
        {[2, 5, 8].map((v) => <text class="f-note" x={L.x0 - 8} y={sy(v) + 5} text-anchor="end">{v}</text>)}
        {ivs.map((v, i) => <path class={v.miss ? 'f-line f-red' : 'f-thin f-blue'} style={v.miss ? 'stroke-width: 2.2' : 'stroke-opacity: .7'} d={`M ${sx(i).toFixed(1)} ${sy(v.lo).toFixed(1)} V ${sy(v.hi).toFixed(1)}`} />)}
        {ivs.map((v, i) => <circle cx={sx(i).toFixed(1)} cy={sy(v.m).toFixed(1)} r="1.6" class={v.miss ? 'f-solid-red' : 'f-solid-blue'} />)}
        <path class="f-line f-amber f-dash" d={`M ${L.x0} ${sy(5)} H ${L.x1}`} />
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 26} text-anchor="middle">{ru ? 'повторения эксперимента' : 'repetitions of the experiment'}</text>
      </svg>
    );
  })}
</Figure>
