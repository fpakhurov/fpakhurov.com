---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
const ru = pageLang(Astro.url) === 'ru';
const n = 16, truth = .1, z = 1.9599639845400536;
function choose(n: number, k: number) { let v = 1; for (let j = 1; j <= k; j++) v = v * (n - j + 1) / j; return v; }
const rows = Array.from({length: 17}, (_, k) => {
  const p = k / n, a = z * z / n;
  const centre = (p + a / 2) / (1 + a);
  const half = z * Math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / (1 + a);
  const w = z * Math.sqrt(p * (1 - p) / n);
  return {k, mass: choose(n, k) * truth ** k * (1 - truth) ** (n - k), wald: [p - w, p + w], wilson: [centre - half, centre + half]};
});
const panels = [{key: 'wald' as const, name: ru ? 'Вальд' : 'Wald'}, {key: 'wilson' as const, name: ru ? 'Уилсон' : 'Wilson'}];
const x = (p: number) => 54 + (p + .1) * 230 / 1.2;
const title = ru ? 'Покрытие складывается из вероятностей исходов' : 'Coverage adds the probabilities of covered outcomes';
const caption = ru ? 'Все возможные счёты при n=16. Пунктир — истинное p=0.1; толщина линии отражает биномиальную вероятность счёта. Синие интервалы содержат p, оранжевые пропускают. Номинальные 95% дают фактическое покрытие 81.14% и 93.16%.' : 'Every count for n=16. The dashed line marks true p=0.1; line width reflects its binomial probability. Blue intervals cover p; amber intervals miss. Nominal 95% produces actual coverage of 81.14% and 93.16%.';
---
<Figure id="coverage-intervals" title={title} caption={caption}>
  <div class="panels">
    {panels.map(panel => {
      const coverage = rows.filter(row => row[panel.key][0] <= truth && truth <= row[panel.key][1]).reduce((sum, row) => sum + row.mass, 0);
      return <svg viewBox="0 0 320 440" role="img" aria-labelledby={`coverage-${panel.key}-${ru ? 'ru' : 'en'}`}>
        <title id={`coverage-${panel.key}-${ru ? 'ru' : 'en'}`}>{panel.name}: {(coverage * 100).toFixed(2)}%</title>
        <desc>{ru ? 'Горизонтальные интервалы для каждого числа успехов от нуля до шестнадцати. Истинная вероятность отмечена вертикально.' : 'Horizontal intervals for each success count from zero to sixteen. The true probability is marked vertically.'}</desc>
        <text x="160" y="22" text-anchor="middle" class="f-title">{panel.name}: {(coverage * 100).toFixed(2)}%</text>
        <text x="36" y="43" text-anchor="end">k</text>
        <line x1={x(truth)} x2={x(truth)} y1="48" y2="386" class="f-axis f-dash" />
        {rows.map(row => {
          const [lo, hi] = row[panel.key]; const covered = lo <= truth && truth <= hi; const y = 56 + row.k * 20;
          return <g data-k={row.k} data-method={panel.key} data-lo={lo} data-hi={hi} data-mass={row.mass}>
            <text x="36" y={y + 5} text-anchor="end">{row.k}</text>
            <line x1={x(lo)} x2={x(hi)} y1={y} y2={y} class={covered ? 'f-line f-blue' : 'f-line f-amber'} style={`stroke-width:${2 + 10 * row.mass}px`} />
          </g>;
        })}
        <line x1="54" x2="284" y1="393" y2="393" class="f-axis" />
        {[0,.25,.5,.75,1].map(p => <g><line x1={x(p)} x2={x(p)} y1="393" y2="398" class="f-axis" /><text x={x(p)} y="418" text-anchor="middle">{p}</text></g>)}
        <text x="300" y="418" text-anchor="middle">p</text>
      </svg>;
    })}
  </div>
</Figure>
<style>
.panels { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: 1rem; max-width: 760px; margin: auto; }
.panels svg { max-width: 360px; }
.panels :global(text) { font-size: 16px; font-variant-numeric: tabular-nums; }
</style>
