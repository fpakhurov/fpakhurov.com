---
import Figure from '../Figure.astro';
import { scale, plot } from '../geometry';

// Parameters updated by one (centre, context) training pair, as a function of |V|, for d = 300.
// Full softmax: all |V| output rows plus the centre row, (|V| + 1)d.
// Hierarchical softmax: about log2|V| inner-node vectors plus the centre row, d(log2|V| + 1).
// Negative sampling: k + 1 output rows plus the centre row, (k + 2)d.
const d = 300;
const k = 5;
const Vmark = 200_000;
const full = (V: number) => (V + 1) * d;
const hs = (V: number) => d * (Math.log2(V) + 1);
const ns = (k + 2) * d;
const ratio = full(Vmark) / ns;
const fmt = (x: number) => Math.round(x).toLocaleString('en-US');

const sup: Record<number, string> = { 2: '10²', 3: '10³', 4: '10⁴', 5: '10⁵', 6: '10⁶', 7: '10⁷', 8: '10⁸', 10: '10¹⁰' };
interface Layout {
  cls: string; W: number; H: number; x0: number; x1: number; y0: number; y1: number;
  fullLbl: [number, number, string]; hsLbl: [number, number, string]; nsLbl: [number, number, string];
  markLbl: [number, number]; yTitle: string;
}
const layouts: Layout[] = [
  {
    cls: 'fig-wide fig-bp-640', W: 640, H: 330, x0: 84, x1: 604, y0: 272, y1: 30,
    fullLbl: [5.65, 7.15, `full softmax: (|V| + 1)d`],
    hsLbl: [7, 4.25, 'hierarchical softmax: ≈ d(log₂|V| + 1)'],
    nsLbl: [3.08, 2.75, `negative sampling, k = ${k}: (k + 2)d = ${fmt(ns)}`],
    markLbl: [5.36, 5.9], yTitle: 'parameters updated per pair',
  },
  {
    cls: 'fig-narrow fig-bp-640', W: 380, H: 360, x0: 58, x1: 366, y0: 300, y1: 30,
    fullLbl: [5.9, 7.2, 'full softmax'],
    hsLbl: [7, 4.3, 'hierarchical softmax'],
    nsLbl: [3.08, 2.7, `negative sampling, k = ${k}`],
    markLbl: [5.36, 5.9], yTitle: 'parameters per pair',
  },
];
const id = 'word2vec-cost-scaling';
---

<Figure
  id="cost-scaling"
  title="Parameters touched by one training pair as the vocabulary grows"
  caption={`Both axes are logarithmic; d = ${d}. The full softmax reads and updates every output row, so its cost grows in proportion to |V|. Hierarchical softmax replaces the |V|-way normalization by about log₂|V| binary decisions along a tree. Negative sampling with k = ${k} updates the centre vector, the observed context vector and ${k} sampled vectors, (k + 2)d = ${fmt(ns)} parameters, whatever the vocabulary size. At |V| = 200,000 (vertical line) the full softmax touches ${fmt(full(Vmark))} parameters per pair, about ${fmt(Math.round(ratio / 100) * 100)} times more.`}
>
  {layouts.map((L, li) => {
    const sx = scale([3, 7], [L.x0, L.x1]);
    const sy = scale([2, 10], [L.y0, L.y1]);
    const mx = sx(Math.log10(Vmark));
    const fullPath = plot((lx) => Math.log10(full(10 ** lx)), 3, 7, sx, sy, 40);
    const hsPath = plot((lx) => Math.log10(hs(10 ** lx)), 3, 7, sx, sy, 80);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${li}-t ${id}-${li}-d`}>
        <title id={`${id}-${li}-t`}>Cost per training pair against vocabulary size</title>
        <desc id={`${id}-${li}-d`}>Log-log plot with vocabulary size from one thousand to ten million on the horizontal axis and parameters updated per pair from one hundred to ten billion on the vertical axis. The full-softmax line rises with slope one from about three hundred thousand to three billion. The hierarchical-softmax curve rises slowly from about three thousand to seven thousand. The negative-sampling line is flat at {fmt(ns)}. A vertical line at two hundred thousand words marks a gap of about {fmt(Math.round(ratio / 100) * 100)} times between the full softmax and negative sampling.</desc>

        {[2, 4, 6, 8, 10].map((e) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(e)} H ${L.x1}`} />
            <text class="f-small f-t-muted" x={L.x0 - 8} y={sy(e) + 4} text-anchor="end">{sup[e]}</text>
          </g>
        ))}
        {[3, 4, 5, 6, 7].map((e) => (
          <text class="f-small f-t-muted" x={sx(e)} y={L.y0 + 20} text-anchor="middle">{sup[e]}</text>
        ))}
        <path class="f-axis" d={`M ${L.x0} ${L.y1} V ${L.y0} H ${L.x1}`} />
        <text class="f-note" x={(L.x0 + L.x1) / 2} y={L.y0 + 44} text-anchor="middle">vocabulary size |V|</text>
        <text class="f-note" transform={`translate(${L.x0 - 44} ${(L.y0 + L.y1) / 2}) rotate(-90)`} text-anchor="middle">{L.yTitle}</text>

        <path class="f-line f-red f-bold" d={fullPath} />
        <path class="f-line f-amber f-dash" d={hsPath} />
        <path class="f-line f-blue f-bold" d={`M ${sx(3)} ${sy(Math.log10(ns))} H ${sx(7)}`} />

        <text class="f-small f-t-red" x={sx(L.fullLbl[0])} y={sy(L.fullLbl[1])}>{L.fullLbl[2]}</text>
        <text class="f-small f-t-amber" x={sx(L.hsLbl[0])} y={sy(L.hsLbl[1])} text-anchor="end">{L.hsLbl[2]}</text>
        <text class="f-small f-t-blue" x={sx(L.nsLbl[0])} y={sy(L.nsLbl[1])}>{L.nsLbl[2]}</text>

        <path class="f-thin f-muted f-dash" d={`M ${mx} ${sy(Math.log10(full(Vmark)))} V ${sy(Math.log10(ns))}`} />
        <circle class="f-solid-red" cx={mx} cy={sy(Math.log10(full(Vmark)))} r="4" />
        <circle class="f-solid-blue" cx={mx} cy={sy(Math.log10(ns))} r="4" />
        <text class="f-small f-halo" x={sx(L.markLbl[0])} y={sy(L.markLbl[1])}>|V| = 200,000:</text>
        <text class="f-small f-halo" x={sx(L.markLbl[0])} y={sy(L.markLbl[1]) + 16}>≈ {fmt(Math.round(ratio / 100) * 100)}× fewer</text>
      </svg>
    );
  })}
</Figure>
