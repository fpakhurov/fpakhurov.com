---
import Figure from '../Figure.astro';

// Softmax versus negative sampling, drawn on the output side of skip-gram:
// centre vector v_c (d = 3) against |V| = 8 output rows. The softmax touches every
// output row per training pair; negative sampling touches k + 1 of them.
// Same words as the worked example: centre coffee, context drink, negatives car and tax.
const V = 8;
const N = 3;
const observed = 1;
const negatives = [3, 5];
const K = negatives.length;
const cell = 20;
const words = ['we', 'drink', 'hot', 'car', 'morning', 'tax', 'cup', 'coffee'];

interface Panel { title: string; note: string; x: number; y: number }
interface Layout { cls: string; w: number; h: number; panels: [Panel, Panel] }
const layouts: Layout[] = [
  { cls: 'fig-wide fig-bp-640', w: 700, h: 280, panels: [
    { title: 'full softmax', note: 'all |V| output rows read and updated', x: 30, y: 60 },
    { title: `negative sampling, k = ${K}`, note: `k + 1 = ${K + 1} output rows read and updated`, x: 360, y: 60 },
  ] },
  { cls: 'fig-narrow fig-bp-640', w: 360, h: 520, panels: [
    { title: 'full softmax', note: 'all |V| output rows read and updated', x: 30, y: 50 },
    { title: `negative sampling, k = ${K}`, note: `k + 1 = ${K + 1} output rows read and updated`, x: 30, y: 300 },
  ] },
];
const hX = 0, outX = 130; // offsets inside a panel
---

<Figure
  id="negative-sampling"
  title="Softmax versus negative sampling on the output side of skip-gram"
  caption={`Toy sizes |V| = ${V} and d = ${N}; the words are those of the worked example below: centre coffee, observed context drink, negatives car and tax. With the full softmax (first panel) the probability of drink is normalized over all |V| words, so one training pair reads and updates every row of W_out. With negative sampling (second panel) the pair (coffee, drink) is a positive example with target 1 and k = ${K} sampled words, car and tax, are negatives with target 0 (targets in brackets); each is an independent logistic classifier on its score, and only these k + 1 output rows and v_coffee are read and updated. The rest of the vocabulary is not visited. At |V| = 200,000, d = 300 and k = 5 this is 2,100 parameters per pair instead of 60,000,300.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`negative-sampling-${L.w}-t negative-sampling-${L.w}-d`}>
      <title id={`negative-sampling-${L.w}-t`}>Softmax versus negative sampling</title>
      <desc id={`negative-sampling-${L.w}-d`}>Two panels. In each, a column of three cells on the left is the centre vector of coffee and a column of eight word boxes on the right is the vocabulary. In the full-softmax panel every word is connected to the centre vector by a solid line. In the negative-sampling panel only the observed word drink (green, target 1) and the two sampled negatives car and tax (red, target 0) are connected; the other words are drawn faintly.</desc>
      {L.panels.map((P, pi) => {
        const hTop = P.y + (V * cell - N * cell) / 2;
        const hx = P.x + hX;
        const ox = P.x + outX;
        return (
          <g>
            <text class="f-title" x={P.x} y={P.y - 26}>{P.title}</text>
            <text class="f-small f-t-muted" x={P.x} y={P.y - 8}>{P.note}</text>
            {/* hidden vector */}
            {Array.from({ length: N }).map((_, j) => (
              <rect class="f-box f-fill-blue" x={hx} y={hTop + j * cell} width={cell} height={cell} />
            ))}
            <text class="f-math" x={hx + cell / 2} y={hTop + N * cell + 22} text-anchor="middle">v<tspan dy="5" font-size="12">c</tspan></text>
            <text class="f-small f-t-muted" x={hx + cell / 2} y={hTop - 10} text-anchor="middle">coffee</text>
            {/* output words */}
            {words.map((w, i) => {
              const y = P.y + i * cell;
              const isObs = i === observed;
              const isNeg = negatives.includes(i);
              const touched = pi === 0 || isObs || isNeg;
              const lineCls = pi === 0 ? 'f-thin' : isObs ? 'f-line f-green' : isNeg ? 'f-line f-red' : 'f-thin f-muted f-dot';
              const boxCls = pi === 1 && isObs ? ' f-fill-green' : pi === 1 && isNeg ? ' f-fill-red' : '';
              return (
                <g>
                  <path class={lineCls} d={`M ${hx + cell} ${hTop + N * cell / 2} L ${ox - 3} ${y + cell / 2}`} />
                  <rect class={`f-box${boxCls}`} x={ox} y={y} width={cell * 2.4} height={cell} opacity={touched ? 1 : 0.45} />
                  <text class={`f-small${isObs && pi === 1 ? ' f-t-green' : isNeg && pi === 1 ? ' f-t-red' : ''}`} x={ox + cell * 2.4 + 8} y={y + cell / 2 + 4} opacity={touched ? 1 : 0.55}>{w}{pi === 1 && isObs ? '  ← observed (1)' : pi === 1 && isNeg ? '  ← negative (0)' : ''}</text>
                </g>
              );
            })}
            <text class="f-small f-t-muted" x={ox} y={P.y + V * cell + 20}>{pi === 0 ? 'one softmax over |V| scores' : 'k + 1 logistic classifiers'}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
