---
import Figure from '../Figure.astro';

// Softmax versus negative sampling, drawn on the output side of skip-gram:
// hidden vector h (N = 3) against V = 8 output words. Softmax touches every
// output vector per training pair; negative sampling touches K + 1 of them.
const V = 8;
const N = 3;
const observed = 2;
const negatives = [5, 7];
const K = negatives.length;
const cell = 20;
const words = ['the', 'river', 'bank', 'is', 'steep', 'cat', 'water', 'blue'];

interface Panel { title: string; note: string; x: number; y: number }
interface Layout { cls: string; w: number; h: number; panels: [Panel, Panel] }
const layouts: Layout[] = [
  { cls: 'fig-wide', w: 700, h: 280, panels: [
    { title: 'softmax', note: 'all |V| output vectors updated', x: 30, y: 60 },
    { title: `negative sampling, K = ${K}`, note: `${K + 1} output vectors updated`, x: 372, y: 60 },
  ] },
  { cls: 'fig-narrow', w: 360, h: 520, panels: [
    { title: 'softmax', note: 'all |V| output vectors updated', x: 30, y: 50 },
    { title: `negative sampling, K = ${K}`, note: `${K + 1} output vectors updated`, x: 30, y: 300 },
  ] },
];
const hX = 0, outX = 160; // offsets inside a panel
---

<Figure
  id="negative-sampling"
  title="Softmax versus negative sampling on the output side of skip-gram"
  caption={`Toy vocabulary of V = 8 and N = 3, centre word river, observed context word bank. With the softmax (left), the probability of bank is normalized over all V words, so the gradient of one training pair touches every column of W′: 3 × 10⁸ weights per pair at web scale. With negative sampling (right), the pair (river, bank) is a positive example and K = ${K} random words are negatives; only those K + 1 output vectors and the centre vector are read and updated, 300 weights per pair for N = 100, and the rest of the vocabulary is not visited.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`negative-sampling-${L.w}-t negative-sampling-${L.w}-d`}>
      <title id={`negative-sampling-${L.w}-t`}>Softmax versus negative sampling</title>
      <desc id={`negative-sampling-${L.w}-d`}>Two panels. In each, a column of three cells on the left is the hidden vector and a column of eight word boxes on the right is the vocabulary. In the softmax panel every word is connected to the hidden vector by a solid line. In the negative-sampling panel only the observed word (green) and two sampled negatives (red) are connected; the other words are drawn faintly.</desc>
      {L.panels.map((P, pi) => {
        const hTop = P.y + (V * cell - N * cell) / 2;
        const hx = P.x + hX;
        const ox = P.x + outX;
        return (
          <g>
            <text class="f-title" x={P.x} y={P.y - 26}>{P.title}</text>
            <text class="f-small f-t-muted" x={P.x} y={P.y - 8}>{P.note}</text>
            {/* hidden vector */}
            {Array.from({ length: N }).map((_, j) => (
              <rect class="f-box f-fill-blue" x={hx} y={hTop + j * cell} width={cell} height={cell} />
            ))}
            <text class="f-math" x={hx + cell / 2} y={hTop + N * cell + 22} text-anchor="middle">v<tspan dy="5" font-size="12">c</tspan></text>
            <text class="f-small f-t-muted" x={hx + cell / 2} y={hTop - 10} text-anchor="middle">river</text>
            {/* output words */}
            {words.map((w, i) => {
              const y = P.y + i * cell;
              const isObs = i === observed;
              const isNeg = negatives.includes(i);
              const touched = pi === 0 || isObs || isNeg;
              const lineCls = pi === 0 ? 'f-thin' : isObs ? 'f-line f-green' : isNeg ? 'f-line f-red' : 'f-thin f-muted f-dot';
              const boxCls = pi === 1 && isObs ? ' f-fill-green' : pi === 1 && isNeg ? ' f-fill-red' : '';
              return (
                <g>
                  <path class={lineCls} d={`M ${hx + cell} ${hTop + N * cell / 2} L ${ox - 3} ${y + cell / 2}`} />
                  <rect class={`f-box${boxCls}`} x={ox} y={y} width={cell * 2.4} height={cell} opacity={touched ? 1 : 0.45} />
                  <text class={`f-small${isObs && pi === 1 ? ' f-t-green' : isNeg && pi === 1 ? ' f-t-red' : ''}`} x={ox + cell * 2.4 + 8} y={y + cell / 2 + 4} opacity={touched ? 1 : 0.55}>{w}{pi === 1 && isObs ? '  ← observed' : pi === 1 && isNeg ? '  ← negative' : ''}</text>
                </g>
              );
            })}
            <text class="f-small f-t-muted" x={ox} y={P.y + V * cell + 20}>{pi === 0 ? 'softmax over V scores' : 'K + 1 logistic classifiers'}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
