---
import Figure from '../Figure.astro';

// Skip-gram network: one-hot input (V) → embedding matrix W (V×N) → hidden h (N)
// → context matrix W' (N×V) → softmax over V. Drawn for V = 8, N = 3.
const V = 8;
const N = 3;
const inputIndex = 4; // the centre word
const outputIndex = 1; // the context word being predicted
const cell = 22;

interface Layout { cls: string; w: number; h: number; vecX: number; wX: number; hX: number; wpX: number; outX: number; top: number; labels: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', w: 680, h: 310, vecX: 34, wX: 112, hX: 300, wpX: 392, outX: 596, top: 54, labels: true },
  { cls: 'fig-narrow', w: 360, h: 270, vecX: 14, wX: 66, hX: 176, wpX: 230, outX: 316, top: 54, labels: false },
];
const vecH = V * cell;
const hH = N * cell;
---

<Figure
  id="skip-gram"
  title="Skip-gram: one-hot centre word in, distribution over context words out"
  caption="A toy vocabulary of V = 8 and embedding size N = 3. The one-hot input selects one row of the V × N matrix W: that row is the embedding of the centre word and becomes the hidden vector h with no non-linearity. Multiplying h by the N × V context matrix W′ gives one score per vocabulary word, and a softmax over the V scores is the predicted distribution of a context word. Training pushes the probability of the observed context word (highlighted) up. After training, the rows of W are the word vectors."
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`skip-gram-${L.w}-t skip-gram-${L.w}-d`}>
      <title id={`skip-gram-${L.w}-t`}>Skip-gram network</title>
      <desc id={`skip-gram-${L.w}-d`}>From left to right: a column of eight boxes with a single 1 (the one-hot centre word), the embedding matrix W drawn as a tall rectangle with one highlighted row, a short column of three boxes (the hidden vector h), the context matrix W prime drawn as a wide rectangle with one highlighted column, and a column of eight output probabilities with one highlighted entry. Arrows connect the stages.</desc>

      {/* input one-hot */}
      <text class="f-title" x={L.vecX + cell / 2} y={L.top - 20} text-anchor="middle">x</text>
      {Array.from({ length: V }, (_, i) => (
        <g>
          <rect class={i === inputIndex ? 'f-box f-fill-blue' : 'f-box-soft'} x={L.vecX} y={L.top + i * cell} width={cell} height={cell} />
          <text class={i === inputIndex ? 'f-small f-t-blue' : 'f-small f-t-muted'} x={L.vecX + cell / 2} y={L.top + i * cell + 15} text-anchor="middle">{i === inputIndex ? 1 : 0}</text>
        </g>
      ))}
      <text class="f-note" x={L.vecX + cell / 2} y={L.top + vecH + 18} text-anchor="middle">V = {V}</text>

      {/* W */}
      <path class="f-line" d={`M ${L.vecX + cell + 4} ${L.top + vecH / 2} H ${L.wX - 6}`} marker-end="url(#f-arrow)" />
      <rect class="f-box-soft" x={L.wX} y={L.top} width={N * cell + 36} height={vecH} rx="3" />
      <rect class="f-box f-fill-blue" x={L.wX} y={L.top + inputIndex * cell} width={N * cell + 36} height={cell} />
      <text class="f-math" x={L.wX + (N * cell + 36) / 2} y={L.top - 14} text-anchor="middle">W</text>
      <text class="f-note" x={L.wX + (N * cell + 36) / 2} y={L.top + vecH + 18} text-anchor="middle">V × N</text>
      {L.labels && <text class="f-small f-t-blue" x={L.wX + (N * cell + 36) / 2} y={L.top + vecH + 36} text-anchor="middle">row of the centre word</text>}

      {/* h */}
      <path class="f-line" d={`M ${L.wX + N * cell + 40} ${L.top + vecH / 2} H ${L.hX - 6}`} marker-end="url(#f-arrow)" />
      {Array.from({ length: N }, (_, i) => (
        <rect class="f-box f-fill-blue" x={L.hX} y={L.top + vecH / 2 - hH / 2 + i * cell} width={cell} height={cell} />
      ))}
      <text class="f-math" x={L.hX + cell / 2} y={L.top - 14} text-anchor="middle">h</text>
      <text class="f-note" x={L.hX + cell / 2} y={L.top + vecH + 18} text-anchor="middle">N = {N}</text>

      {/* W' */}
      <path class="f-line" d={`M ${L.hX + cell + 4} ${L.top + vecH / 2} H ${L.wpX - 6}`} marker-end="url(#f-arrow)" />
      <rect class="f-box-soft" x={L.wpX} y={L.top + vecH / 2 - hH / 2} width={L.cls === 'fig-wide' ? 160 : 60} height={hH} rx="3" />
      <rect class="f-box f-fill-green" x={L.wpX + (L.cls === 'fig-wide' ? 160 : 60) * (outputIndex + 0.5) / V - 6} y={L.top + vecH / 2 - hH / 2} width="12" height={hH} />
      <text class="f-math" x={L.wpX + (L.cls === 'fig-wide' ? 80 : 30)} y={L.top - 14} text-anchor="middle">W′</text>
      <text class="f-note" x={L.wpX + (L.cls === 'fig-wide' ? 80 : 30)} y={L.top + vecH + 18} text-anchor="middle">N × V</text>
      {L.labels && <text class="f-small f-t-green" x={L.wpX + 80} y={L.top + vecH + 36} text-anchor="middle">column of the context word</text>}

      {/* output softmax */}
      <path class="f-line" d={`M ${L.wpX + (L.cls === 'fig-wide' ? 160 : 60) + 4} ${L.top + vecH / 2} H ${L.outX - 6}`} marker-end="url(#f-arrow)" />
      {Array.from({ length: V }, (_, i) => (
        <g>
          <rect class={i === outputIndex ? 'f-box f-fill-green' : 'f-box-soft'} x={L.outX} y={L.top + i * cell} width={cell + 8} height={cell} />
          <text class={i === outputIndex ? 'f-small f-t-green' : 'f-small f-t-muted'} x={L.outX + (cell + 8) / 2} y={L.top + i * cell + 15} text-anchor="middle">{i === outputIndex ? '.6' : '.0'}</text>
        </g>
      ))}
      <text class="f-title" x={L.outX + (cell + 8) / 2} y={L.top - 20} text-anchor="middle">softmax</text>
      <text class="f-note" x={L.outX + (cell + 8) / 2} y={L.top + vecH + 18} text-anchor="middle">V = {V}</text>
    </svg>
  ))}
</Figure>
