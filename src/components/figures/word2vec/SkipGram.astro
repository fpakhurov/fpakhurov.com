---
import Figure from '../Figure.astro';

// The Word2Vec network with shapes, drawn for a toy vocabulary of |V| = 8 and d = 3.
// one-hot e_c [|V|] → W_in [|V|, d] (row lookup) → h = v_c [d] → W_out [|V|, d] → scores s [|V|] → softmax.
// The scores and probabilities are computed from the toy vectors below.
const words = ['we', 'drink', 'hot', 'coffee', 'every', 'morning', 'car', 'tax'];
const V = words.length;
const d = 3;
const c = 3; // centre word: coffee
const o = 1; // observed context word: drink
const vc = [1.0, 0.5, -0.3];
const U = [
  [0.2, 0.1, 0.3], [0.8, 0.6, -0.2], [0.7, 0.1, 0.0], [0.1, -0.2, 0.4],
  [0.3, 0.2, 0.1], [0.4, 0.5, -0.1], [-0.2, 0.9, 0.5], [0.6, -0.4, 0.6],
];
const s = U.map((u) => u.reduce((acc, x, j) => acc + x * vc[j], 0));
const Z = s.reduce((acc, x) => acc + Math.exp(x), 0);
const p = s.map((x) => Math.exp(x) / Z);
const pMax = Math.max(...p);

interface Layout {
  cls: string; W: number; H: number; cw: number; ch: number; top: number;
  eX: number; winX: number; hX: number; woutX: number; sX: number | null; pX: number; barLen: number;
}
const layouts: Layout[] = [
  { cls: 'fig-wide fig-bp-640', W: 680, H: 312, cw: 22, ch: 22, top: 62, eX: 30, winX: 98, hX: 222, woutX: 300, sX: 422, pX: 498, barLen: 96 },
  { cls: 'fig-narrow fig-bp-640', W: 380, H: 312, cw: 16, ch: 22, top: 62, eX: 8, winX: 52, hX: 136, woutX: 182, sX: null, pX: 262, barLen: 52 },
];
const id = 'word2vec-network';
---

<Figure
  id="skip-gram"
  title="The Word2Vec network: a row lookup, a dot product with every output vector, a softmax"
  caption={`Toy sizes |V| = ${V} and d = ${d}, centre word coffee, observed context word drink. The one-hot vector of coffee times W_in reads out one row, v_coffee; there is no bias and no non-linearity, so the hidden vector h is that row. Each row u_w of W_out is dotted with h to give one score per vocabulary word, and the softmax turns the ${V} scores into a distribution over the context word (scores and bars are computed from toy vectors). Training raises the probability of drink. After training only W_in is kept, as the embedding table; W_out and the softmax exist only to provide the training signal. For CBOW the input is the 2m context words and h is the mean of their rows.`}
>
  {layouts.map((L, li) => {
    const colH = V * L.ch;
    const mid = L.top + colH / 2;
    const matW = d * L.cw;
    const hTop = mid - (d * L.ch) / 2;
    const below = L.top + colH + 18;
    const arrow = (x1: number, x2: number) => <path class="f-line" d={`M ${x1 + 4} ${mid} H ${x2 - 6}`} marker-end="url(#f-arrow)" />;
    const lastX = L.pX + L.barLen + 6;
    const sX = L.sX ?? 0;
    const sEnd = L.sX !== null ? L.sX + 44 : L.woutX + matW;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${li}-t ${id}-${li}-d`}>
        <title id={`${id}-${li}-t`}>Word2Vec network with shapes</title>
        <desc id={`${id}-${li}-d`}>From left to right: a column of eight cells with a single 1 at the position of coffee; the input matrix W in, eight rows by three columns, with the row of coffee highlighted and marked as the embedding table that is kept; the hidden vector h of three cells, equal to that row; the output matrix W out, eight rows by three columns, with the row of drink highlighted; {L.sX !== null ? 'a column of eight scores; ' : ''}and horizontal bars for the softmax probabilities of the eight words, with drink the longest. The output part is marked as used only during training.</desc>

        {/* one-hot input */}
        <text class="f-math" x={L.eX + L.cw / 2} y={L.top - 14} text-anchor="middle">e<tspan dy="5" font-size="12">c</tspan></text>
        {words.map((_, i) => (
          <g>
            <rect class={i === c ? 'f-box f-fill-amber' : 'f-box-soft'} x={L.eX} y={L.top + i * L.ch} width={L.cw} height={L.ch} />
            <text class={`f-small${i === c ? ' f-t-amber' : ' f-t-muted'}`} x={L.eX + L.cw / 2} y={L.top + i * L.ch + 15} text-anchor="middle">{i === c ? 1 : 0}</text>
          </g>
        ))}
        <text class="f-small f-t-muted" x={L.eX + L.cw / 2} y={below} text-anchor="middle">[|V|]</text>

        {/* W_in */}
        {arrow(L.eX + L.cw, L.winX)}
        <text class="f-math" x={L.winX + matW / 2} y={L.top - 14} text-anchor="middle">W<tspan dy="5" font-size="12">in</tspan></text>
        <rect class="f-box-soft" x={L.winX} y={L.top} width={matW} height={colH} />
        {words.map((_, i) => i > 0 && <path class="f-grid" d={`M ${L.winX} ${L.top + i * L.ch} H ${L.winX + matW}`} />)}
        <rect class="f-box f-fill-blue" x={L.winX} y={L.top + c * L.ch} width={matW} height={L.ch} />
        <text class="f-small f-t-muted" x={L.winX + matW / 2} y={below} text-anchor="middle">[|V|, d]</text>

        {/* h = v_c */}
        {arrow(L.winX + matW, L.hX)}
        <text class="f-math" x={L.hX + L.cw / 2} y={L.top - 14} text-anchor="middle">h</text>
        {Array.from({ length: d }, (_, j) => (
          <rect class="f-box f-fill-blue" x={L.hX} y={hTop + j * L.ch} width={L.cw} height={L.ch} />
        ))}
        <text class="f-small f-t-blue" x={L.hX + L.cw / 2} y={hTop - 10} text-anchor="middle">= v<tspan dy="4" font-size="10">c</tspan></text>
        <text class="f-small f-t-muted" x={L.hX + L.cw / 2} y={below} text-anchor="middle">[d]</text>

        {/* W_out */}
        {arrow(L.hX + L.cw, L.woutX)}
        <text class="f-math" x={L.woutX + matW / 2} y={L.top - 14} text-anchor="middle">W<tspan dy="5" font-size="12">out</tspan></text>
        <rect class="f-box-soft" x={L.woutX} y={L.top} width={matW} height={colH} />
        {words.map((_, i) => i > 0 && <path class="f-grid" d={`M ${L.woutX} ${L.top + i * L.ch} H ${L.woutX + matW}`} />)}
        <rect class="f-box f-fill-green" x={L.woutX} y={L.top + o * L.ch} width={matW} height={L.ch} />
        <text class="f-small f-t-muted" x={L.woutX + matW / 2} y={below} text-anchor="middle">[|V|, d]</text>

        {/* scores */}
        {L.sX !== null && (
          <g>
            {arrow(L.woutX + matW, sX)}
            <text class="f-math" x={sX + 22} y={L.top - 14} text-anchor="middle">s</text>
            {s.map((x, i) => (
              <g>
                <rect class={i === o ? 'f-box f-fill-green' : 'f-box-soft'} x={sX} y={L.top + i * L.ch} width="44" height={L.ch} />
                <text class={`f-small${i === o ? ' f-t-green' : ''}`} x={sX + 22} y={L.top + i * L.ch + 15} text-anchor="middle">{x < 0 ? `−${(-x).toFixed(2)}` : x.toFixed(2)}</text>
              </g>
            ))}
            <text class="f-small f-t-muted" x={sX + 22} y={below} text-anchor="middle">[|V|]</text>
          </g>
        )}

        {/* softmax bars */}
        {arrow(sEnd, L.pX)}
        <text class="f-title" x={L.pX} y={L.top - 18}>softmax</text>
        {p.map((x, i) => (
          <g>
            <rect class={i === o ? 'f-fill-green' : 'f-fill-blue'} x={L.pX} y={L.top + i * L.ch + 4} width={(x / pMax) * L.barLen} height={L.ch - 8} stroke={i === o ? 'var(--fig-green)' : 'var(--muted)'} stroke-width="1" />
            <text class={`f-small${i === o ? ' f-t-green' : ' f-t-muted'}`} x={lastX} y={L.top + i * L.ch + 15}>{words[i]}</text>
          </g>
        ))}

        {/* brackets: what is kept, what is only used for training */}
        <path class="f-thin f-blue" d={`M ${L.winX} ${below + 12} v 6 H ${L.winX + matW} v -6`} />
        <text class="f-small f-t-blue" x={L.winX + matW / 2} y={below + 36} text-anchor="middle">kept: embedding table</text>
        <path class="f-thin f-muted" d={`M ${L.woutX} ${below + 12} v 6 H ${L.W - 6} v -6`} />
        <text class="f-small f-t-muted" x={(L.woutX + L.W - 6) / 2} y={below + 36} text-anchor="middle">{L.sX !== null ? 'used only to train the table' : 'used only in training'}</text>
      </svg>
    );
  })}
</Figure>
