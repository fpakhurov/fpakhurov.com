---
import Figure from '../Figure.astro';
import { scale, plot, sigmoid } from '../geometry';

// The per-pair SGNS objective as a function of the score x = u_o · v_c:
// ℓ(x) = A (−log σ(x)) + B (−log σ(−x)), A = #(c, o) positive occurrences,
// B = k #(c) P_n(o) expected negative draws. Its minimum is x* = log(A / B) = PMI − log k.
// Toy counts: #(c) = 1000, P_n(o) = 0.01, k = 5, so B = 50 for every pair.
const k = 5;
const nc = 1000;
const pn = 0.01;
const B = k * nc * pn;
const nll = (x: number) => -Math.log(sigmoid(x));
const settings = [
  { name: 'associated', A: 200, col: 'blue' },
  { name: 'unrelated', A: 10, col: 'amber' },
].map((S) => {
  const pmi = Math.log(S.A / (nc * pn));
  const xs = Math.log(S.A / B);
  const f = (x: number) => (S.A * nll(x) + B * nll(-x)) / (S.A + B);
  return { ...S, pmi, xs, f };
});
const never = (x: number) => nll(-x); // A = 0: only the negative term, no minimum
const f2 = (x: number) => (x < 0 ? '−' : '') + Math.abs(x).toFixed(2);
const logk = Math.log(k);

interface Layout { cls: string; W: number; H: number; x0: number; x1: number; y0: number; y1: number; long: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide fig-bp-640', W: 640, H: 384, x0: 64, x1: 616, y0: 250, y1: 24, long: true },
  { cls: 'fig-narrow fig-bp-640', W: 380, H: 384, x0: 44, x1: 368, y0: 250, y1: 24, long: false },
];
const id = 'word2vec-sgns-optimum';
---

<Figure
  id="sgns-optimum"
  title="The per-pair negative-sampling objective and its minimum"
  caption={`The objective of one pair (c, o) as a function of its score x = u_o · v_c, divided by the number of terms so that the curves share an axis. Toy counts: the centre word c occurs in #(c) = ${nc} pairs, P_n(o) = ${pn} and k = ${k}, so o is drawn as a negative of c ${B} times in expectation. Blue: o occurs with c ${settings[0].A} times, PMI = log ${settings[0].A / (nc * pn)} = ${f2(settings[0].pmi)}. Amber: ${settings[1].A} times, PMI = ${f2(settings[1].pmi)}, as often as chance predicts. Each curve has its minimum (filled point) at PMI − log k, ${f2(settings[0].xs)} and ${f2(settings[1].xs)}; the arrows below the axis show the shift by log ${k} = ${f2(logk)} from the PMI (open marker). Dotted: a pair that never co-occurs keeps only the negative term, which decreases without bound as x falls, so its optimal score is −∞.`}
>
  {layouts.map((L, li) => {
    const sx = scale([-4, 4], [L.x0, L.x1]);
    const sy = scale([0, 3.5], [L.y0, L.y1]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${li}-t ${id}-${li}-d`}>
        <title id={`${id}-${li}-t`}>Per-pair SGNS objective against the score</title>
        <desc id={`${id}-${li}-d`}>Three curves over the score from minus four to four. The blue curve, for a strongly associated pair with PMI {f2(settings[0].pmi)}, is U-shaped with its minimum at {f2(settings[0].xs)}. The amber curve, for a pair that co-occurs as often as chance predicts, PMI zero, has its minimum at {f2(settings[1].xs)}. Below the axis two arrows run from each PMI to the corresponding minimum, both of length log 5. A dotted grey curve for a pair that never co-occurs falls monotonically towards zero on the left and has no minimum.</desc>

        {[1, 2, 3].map((y) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(y)} H ${L.x1}`} />
            <text class="f-small f-t-muted" x={L.x0 - 8} y={sy(y) + 4} text-anchor="end">{y}</text>
          </g>
        ))}
        {[-4, -2, 0, 2, 4].map((x) => (
          <text class="f-small f-t-muted" x={sx(x)} y={L.y0 + 20} text-anchor="middle">{x < 0 ? `−${-x}` : x}</text>
        ))}
        <text class="f-small f-t-muted" x={L.x0 - 8} y={L.y0 + 4} text-anchor="end">0</text>
        <path class="f-axis" d={`M ${L.x0} ${L.y1} V ${L.y0} H ${L.x1}`} />
        <text class="f-note" x={(L.x0 + L.x1) / 2} y={L.y0 + 42} text-anchor="middle">score x = u<tspan dy="4" font-size="10">o</tspan><tspan dy="-4"> · v</tspan><tspan dy="4" font-size="10">c</tspan></text>

        <path class="f-line f-muted f-dot" d={plot(never, -4, 3.45, sx, sy)} />

        {settings.map((S, i) => {
          const ya = L.y0 + 64 + i * 26;
          return (
            <g>
              <path class={`f-line f-${S.col} f-bold`} d={plot(S.f, -4, 4, sx, sy)} />
              <path class={`f-thin f-${S.col} f-dash`} d={`M ${sx(S.xs)} ${sy(S.f(S.xs)) + 5} V ${ya}`} />
              <circle cx={sx(S.xs)} cy={sy(S.f(S.xs))} r="4.5" fill={`var(--fig-${S.col})`} />
              {/* shift from the PMI to the optimum */}
              <circle cx={sx(S.pmi)} cy={ya} r="4" fill="var(--paper)" stroke={`var(--fig-${S.col})`} stroke-width="1.6" />
              <path class={`f-line f-${S.col}`} d={`M ${sx(S.pmi) - 6} ${ya} H ${sx(S.xs) + 5}`} marker-end={`url(#f-arrow-${S.col})`} />
              <text class={`f-small f-t-${S.col}`} x={sx(S.xs) - 10} y={ya + 4} text-anchor="end">{L.long ? `PMI ${f2(S.pmi)} → minimum ${f2(S.xs)}` : `${f2(S.pmi)} → ${f2(S.xs)}`}</text>
            </g>
          );
        })}
        <text class="f-small f-t-muted" x={L.x0} y={L.y0 + 64 + 2 * 26 + 2}>{L.long ? `arrows: from the PMI (open) to the minimum (filled), a shift of −log k = −${logk.toFixed(2)}` : `arrows: PMI → minimum, −log k = −${logk.toFixed(2)}`}</text>

        {/* legend in the empty top centre */}
        {[
          { cls: 'f-line f-blue f-bold', t: 'f-t-blue', label: L.long ? `associated: #(c, o) = ${settings[0].A}, PMI ${f2(settings[0].pmi)}` : `#(c, o) = ${settings[0].A}, PMI ${f2(settings[0].pmi)}` },
          { cls: 'f-line f-amber f-bold', t: 'f-t-amber', label: L.long ? `unrelated: #(c, o) = ${settings[1].A}, PMI ${f2(settings[1].pmi)}` : `#(c, o) = ${settings[1].A}, PMI ${f2(settings[1].pmi)}` },
          { cls: 'f-line f-muted f-dot', t: 'f-t-muted', label: L.long ? 'never co-occur: #(c, o) = 0, no minimum' : '#(c, o) = 0, no minimum' },
        ].map((E, i) => {
          const lx = sx(-3.1);
          const ly = sy(3.35) + i * 20;
          return (
            <g>
              <path class={E.cls} d={`M ${lx} ${ly - 4} h 24`} />
              <text class={`f-small ${E.t} f-halo`} x={lx + 32} y={ly}>{E.label}</text>
            </g>
          );
        })}
      </svg>
    );
  })}
</Figure>
