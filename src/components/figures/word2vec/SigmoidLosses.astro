---
import Figure from '../Figure.astro';
import { scale, plot, sigmoid } from '../geometry';

// The two terms of the negative-sampling loss as functions of the score s = u · v_c:
// -log σ(s) for the observed pair, -log σ(-s) for each negative pair.
// Points: the worked example before and after one step (d = 2, k = 2, η = 0.5).
const lossPos = (s: number) => -Math.log(sigmoid(s));
const lossNeg = (s: number) => -Math.log(sigmoid(-s));

const vc = [1.0, 0.5];
const uo = [0.8, 0.6];
const un = [[-0.2, 0.9], [0.6, -0.4]];
const eta = 0.5;
const dot = (a: number[], b: number[]) => a[0] * b[0] + a[1] * b[1];
const so = dot(uo, vc);
const sn = un.map((u) => dot(u, vc));
const gv = [0, 1].map((j) => (sigmoid(so) - 1) * uo[j] + sn.reduce((acc, s, i) => acc + sigmoid(s) * un[i][j], 0));
const vc2 = vc.map((x, j) => x - eta * gv[j]);
const uo2 = uo.map((x, j) => x - eta * (sigmoid(so) - 1) * vc[j]);
const un2 = un.map((u, i) => u.map((x, j) => x - eta * sigmoid(sn[i]) * vc[j]));
const so2 = dot(uo2, vc2);
const sn2 = un2.map((u) => dot(u, vc2));
const loss1 = lossPos(so) + sn.reduce((a, s) => a + lossNeg(s), 0);
const loss2 = lossPos(so2) + sn2.reduce((a, s) => a + lossNeg(s), 0);

const pts = [
  { name: 'drink', s1: so, s2: so2, f: lossPos, col: 'green' },
  { name: 'car', s1: sn[0], s2: sn2[0], f: lossNeg, col: 'red' },
  { name: 'tax', s1: sn[1], s2: sn2[1], f: lossNeg, col: 'red' },
];
const f2 = (x: number) => (x < 0 ? '−' : '') + Math.abs(x).toFixed(2);

interface Label { x: number; y: number; end: boolean }
interface Layout { cls: string; W: number; H: number; x0: number; x1: number; y0: number; y1: number; lbl: Label[]; long: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide fig-bp-640', W: 640, H: 320, x0: 70, x1: 610, y0: 262, y1: 24, lbl: [{ x: 1.55, y: 0.5, end: false }, { x: 1.55, y: 1.45, end: false }, { x: 1.55, y: 1.15, end: false }], long: true },
  { cls: 'fig-narrow fig-bp-640', W: 380, H: 320, x0: 46, x1: 366, y0: 262, y1: 24, lbl: [{ x: 1.25, y: 0.5, end: false }, { x: -0.25, y: 1.75, end: true }, { x: 1.25, y: 1.15, end: false }], long: false },
];
const id = 'word2vec-sigmoid-losses';
---

<Figure
  id="sigmoid-losses"
  title="The two loss terms of negative sampling as functions of the score"
  caption={`Green: −log σ(s), the loss of the observed pair; its slope σ(s) − 1 vanishes once the score is large, so a pair that is already recognized stops moving. Red: −log σ(−s), the loss of each negative pair; its slope σ(s) grows with the score, so a negative that the model wrongly finds plausible gets the largest push. Points are the worked example (d = 2, k = 2, learning rate 0.5): hollow before the step, filled after it. The observed pair (coffee, drink) moves from score ${f2(so)} to ${f2(so2)}, the negatives car and tax from ${f2(sn[0])} and ${f2(sn[1])} to ${f2(sn2[0])} and ${f2(sn2[1])}; the total loss falls from ${loss1.toFixed(3)} to ${loss2.toFixed(3)}.`}
>
  {layouts.map((L, li) => {
    const sx = scale([-4, 4], [L.x0, L.x1]);
    const sy = scale([0, 4.2], [L.y0, L.y1]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${li}-t ${id}-${li}-d`}>
        <title id={`${id}-${li}-t`}>Negative-sampling loss terms against the score</title>
        <desc id={`${id}-${li}-d`}>Two curves over the score from minus four to four. The green curve, minus log sigma of s, falls from about four at the left to almost zero at the right. The red curve, minus log sigma of minus s, is its mirror image and rises to about four at the right. They cross at score zero, at log 2. Three pairs of points mark the worked example: the observed pair drink on the green curve moves right from {f2(so)} to {f2(so2)}; the negatives car and tax on the red curve move left from {f2(sn[0])} to {f2(sn2[0])} and from {f2(sn[1])} to {f2(sn2[1])}.</desc>

        {[1, 2, 3, 4].map((y) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(y)} H ${L.x1}`} />
            <text class="f-small f-t-muted" x={L.x0 - 8} y={sy(y) + 4} text-anchor="end">{y}</text>
          </g>
        ))}
        {[-4, -2, 0, 2, 4].map((x) => (
          <text class="f-small f-t-muted" x={sx(x)} y={L.y0 + 20} text-anchor="middle">{x < 0 ? `−${-x}` : x}</text>
        ))}
        <path class="f-axis" d={`M ${L.x0} ${L.y1} V ${L.y0} H ${L.x1}`} />
        <path class="f-thin f-muted f-dot" d={`M ${sx(0)} ${L.y0} V ${L.y1}`} />
        <text class="f-note" x={(L.x0 + L.x1) / 2} y={L.y0 + 42} text-anchor="middle">score s = u · v<tspan dy="4" font-size="10">c</tspan></text>
        <text class="f-small f-t-muted" x={L.x0 - 8} y={L.y0 + 4} text-anchor="end">0</text>

        <path class="f-line f-green f-bold" d={plot(lossPos, -4, 4, sx, sy)} />
        <path class="f-line f-red f-bold" d={plot(lossNeg, -4, 4, sx, sy)} />
        <text class="f-small f-t-green" x={sx(-2.9)} y={sy(3.55)}>{L.long ? '−log σ(s): observed pair' : '−log σ(s)'}</text>
        <text class="f-small f-t-red" x={sx(2.9)} y={sy(3.55)} text-anchor="end">{L.long ? '−log σ(−s): negative pair' : '−log σ(−s)'}</text>

        {pts.map((P, i) => {
          const lb = L.lbl[i];
          const tx = sx(lb.x);
          const ty = sy(lb.y);
          const lx = lb.end ? tx + 4 : tx - 4;
          const px = sx(P.s1) + (lb.end ? -3 : 5);
          return (
            <g>
              <path class="f-thin f-muted" d={`M ${lx} ${ty - 4} L ${px} ${sy(P.f(P.s1)) - 4}`} />
              <circle cx={sx(P.s1)} cy={sy(P.f(P.s1))} r="4.5" fill="var(--paper)" stroke={`var(--fig-${P.col})`} stroke-width="1.8" />
              <circle class={`f-solid-${P.col}`} cx={sx(P.s2)} cy={sy(P.f(P.s2))} r="4" />
              <text class={`f-small f-t-${P.col} f-halo`} x={tx} y={ty} text-anchor={lb.end ? 'end' : 'start'}>{L.long ? `${P.name}: score ${f2(P.s1)} → ${f2(P.s2)}` : P.name}</text>
            </g>
          );
        })}
      </svg>
    );
  })}
</Figure>
