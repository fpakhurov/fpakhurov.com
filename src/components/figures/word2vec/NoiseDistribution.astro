---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Noise distribution P_n(w) ∝ count(w)^α for a toy Zipf vocabulary of 10 words, count ∝ 1/rank.
const R = 10;
const counts = Array.from({ length: R }, (_, i) => 1 / (i + 1));
const dist = (a: number) => {
  const w = counts.map((c) => c ** a);
  const z = w.reduce((s, x) => s + x, 0);
  return w.map((x) => x / z);
};
const p1 = dist(1);
const p34 = dist(0.75);
const ratio = (p: number[]) => p[0] / p[R - 1];

interface Layout { cls: string; W: number; H: number; x0: number; x1: number; y0: number; y1: number; bar: number; legendX: number; long: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide fig-bp-640', W: 600, H: 300, x0: 64, x1: 584, y0: 246, y1: 24, bar: 18, legendX: 330, long: true },
  { cls: 'fig-narrow fig-bp-640', W: 380, H: 340, x0: 48, x1: 370, y0: 246, y1: 24, bar: 12, legendX: 150, long: false },
];
const id = 'word2vec-noise-distribution';
---

<Figure
  id="noise-distribution"
  title={ru ? "Униграммное распределение в степени 3/4" : "Raising the unigram distribution to the power 3/4"}
  caption={ru ? `Игрушечный словарь из ${R} слов, частоты которых подчиняются закону Ципфа: частота пропорциональна 1/ранг. Серые столбики: негативные примеры выбираются пропорционально частоте (α = 1). Синие: выбор Word2Vec, α = 3/4. Штриховая линия: равномерное сэмплирование (α = 0). Степень 3/4 забирает вероятность у самых частых слов и отдаёт её редким: при α = 1 самое частое слово выбирается в ${ratio(p1).toFixed(0)} раз чаще самого редкого, при α = 3/4 — в ${ratio(p34).toFixed(1)} раза чаще. Значение 3/4 подобрано эмпирически.` : `A toy vocabulary of ${R} words whose counts follow Zipf's law: count proportional to 1/rank. Grey: negatives drawn in proportion to frequency (α = 1). Blue: the Word2Vec choice α = 3/4. Dashed: uniform sampling (α = 0). The power 3/4 takes probability from the most frequent words and gives it to the rare ones: the most frequent word is drawn ${ratio(p1).toFixed(0)} times as often as the rarest with α = 1, ${ratio(p34).toFixed(1)} times as often with α = 3/4. The value 3/4 was chosen empirically.`}
>
  {layouts.map((L, li) => {
    const sy = scale([0, 0.36], [L.y0, L.y1]);
    const gw = (L.x1 - L.x0) / R;
    const gx = (i: number) => L.x0 + i * gw + gw / 2;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${li}-t ${id}-${li}-d`}>
        <title id={`${id}-${li}-t`}>{ru ? "Шумовое распределение для трёх степеней частот" : "Noise distribution for three powers of the counts"}</title>
        <desc id={`${id}-${li}-d`}>{ru ? `Сгруппированная столбчатая диаграмма по рангам слов от одного до десяти. Серые столбики, пропорциональные частоте, убывают от ${p1[0].toFixed(2)} на первом ранге до ${p1[R - 1].toFixed(3)} на десятом. Синие столбики, частота в степени три четверти, убывают медленнее, от ${p34[0].toFixed(2)} до ${p34[R - 1].toFixed(3)}. Штриховая горизонтальная линия на уровне 0.1 отмечает равномерное сэмплирование.` : `Grouped bar chart over word ranks one to ten. Grey bars, proportional to frequency, fall from ${p1[0].toFixed(2)} at rank one to ${p1[R - 1].toFixed(3)} at rank ten. Blue bars, frequency to the power three quarters, fall less steeply, from ${p34[0].toFixed(2)} to ${p34[R - 1].toFixed(3)}. A dashed horizontal line at 0.1 marks uniform sampling.`}</desc>

        {[0.1, 0.2, 0.3].map((y) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(y)} H ${L.x1}`} />
            <text class="f-small f-t-muted" x={L.x0 - 8} y={sy(y) + 4} text-anchor="end">{y.toFixed(1)}</text>
          </g>
        ))}
        <text class="f-small f-t-muted" x={L.x0 - 8} y={L.y0 + 4} text-anchor="end">0</text>
        {p1.map((p, i) => (
          <g>
            <rect class="f-box-soft" x={gx(i) - L.bar - 1} y={sy(p)} width={L.bar} height={L.y0 - sy(p)} stroke="var(--muted)" />
            <rect class="f-fill-blue" x={gx(i) + 1} y={sy(p34[i])} width={L.bar} height={L.y0 - sy(p34[i])} stroke="var(--fig-blue)" stroke-width="1.4" />
            <text class="f-small f-t-muted" x={gx(i)} y={L.y0 + 20} text-anchor="middle">{i + 1}</text>
          </g>
        ))}
        <path class="f-line f-amber f-dash" d={`M ${L.x0} ${sy(0.1)} H ${L.x1}`} />
        <path class="f-axis" d={`M ${L.x0} ${L.y1} V ${L.y0} H ${L.x1}`} />
        <text class="f-note" x={(L.x0 + L.x1) / 2} y={L.y0 + 44} text-anchor="middle">{ru ? 'ранг слова (1 — самое частое)' : 'word rank (1 = most frequent)'}</text>
        <text class="f-note" transform={`translate(${L.x0 - 40} ${(L.y0 + L.y1) / 2}) rotate(-90)`} text-anchor="middle">P(w)</text>

        {/* legend */}
        <g>
          <rect class="f-box-soft" x={L.legendX} y={L.y1 + 4} width="14" height="12" stroke="var(--muted)" />
          <text class="f-small" x={L.legendX + 20} y={L.y1 + 14}>α = 1: {ru ? 'отношение' : 'ratio'} {ratio(p1).toFixed(0)}</text>
          <rect class="f-fill-blue" x={L.legendX} y={L.y1 + 24} width="14" height="12" stroke="var(--fig-blue)" stroke-width="1.4" />
          <text class="f-small f-t-blue" x={L.legendX + 20} y={L.y1 + 34}>α = 3/4: {ru ? 'отношение' : 'ratio'} {ratio(p34).toFixed(1)}</text>
          <path class="f-line f-amber f-dash" d={`M ${L.legendX} ${L.y1 + 50} h 14`} />
          <text class="f-small f-t-amber" x={L.legendX + 20} y={L.y1 + 54}>α = 0: {ru ? 'равномерное' : 'uniform'}</text>
          {L.long && <text class="f-note" x={L.legendX} y={L.y1 + 78}>{ru ? 'отношение = P(ранг 1) / P(ранг 10)' : 'ratio = P(rank 1) / P(rank 10)'}</text>}
        </g>
        {!L.long && <text class="f-note" x={(L.x0 + L.x1) / 2} y={L.y0 + 66} text-anchor="middle">{ru ? 'отношение = P(ранг 1) / P(ранг 10)' : 'ratio = P(rank 1) / P(rank 10)'}</text>}
      </svg>
    );
  })}
</Figure>
