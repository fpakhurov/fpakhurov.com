---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The synthetic example of the note: scores calibrated within each group, s ~ Beta(2, 4) in group A (base rate 1/3)
// and s ~ Beta(3, 3) in group B (base rate 1/2), with P(y = 1 | s) = s. Group A is approved above 0.5; the figure
// moves the threshold of group B and plots the gaps B - A of four quantities, computed by Simpson integration.
const pdfA = (s: number) => 20 * s * (1 - s) ** 3;
const pdfB = (s: number) => 30 * s * s * (1 - s) ** 2;
function integrate(f: (s: number) => number, a: number, b: number, n = 2000) {
  const h = (b - a) / n;
  let sum = f(a) + f(b);
  for (let i = 1; i < n; i++) sum += (i % 2 ? 4 : 2) * f(a + i * h);
  return (sum * h) / 3;
}
function metrics(pdf: (s: number) => number, base: number, t: number) {
  const sel = integrate(pdf, t, 1), tp = integrate((s) => s * pdf(s), t, 1);
  return { sel, tpr: tp / base, fpr: (sel - tp) / (1 - base), ppv: tp / sel };
}
type Key = 'sel' | 'tpr' | 'fpr' | 'ppv';
const keys: Key[] = ['sel', 'tpr', 'fpr', 'ppv'];
const A = metrics(pdfA, 1 / 3, 0.5);
const gap = (k: Key, t: number) => metrics(pdfB, 0.5, t)[k] - A[k];
function root(k: Key, lo: number, hi: number) {
  for (let i = 0; i < 60; i++) { const mid = (lo + hi) / 2; if (Math.sign(gap(k, mid)) === Math.sign(gap(k, lo))) lo = mid; else hi = mid; }
  return (lo + hi) / 2;
}
const cross = Object.fromEntries(keys.map((k) => [k, root(k, 0.3, 0.8)])) as Record<Key, number>;
// The numbers quoted in the note (scipy, in its own script).
const quoted: Record<Key, number> = { sel: 0.6821, tpr: 0.6546, fpr: 0.6576, ppv: 0.4190 };
for (const k of keys) if (Math.abs(cross[k] - quoted[k]) > 5e-4) throw new Error(`FairnessTradeoff: ${k} crosses at ${cross[k]}`);
if (Math.abs(A.ppv - 0.6111) > 5e-4 || Math.abs(A.tpr - 0.34375) > 5e-4 || Math.abs(A.fpr - 0.109375) > 5e-4) throw new Error('FairnessTradeoff: group A');

const T0 = 0.3, T1 = 0.8, Y0 = -0.3, Y1 = 0.7;
const ts = Array.from({ length: 101 }, (_, i) => T0 + ((T1 - T0) * i) / 100);
const series = Object.fromEntries(keys.map((k) => [k, ts.map((t) => gap(k, t))])) as Record<Key, number[]>;
for (const k of keys) if (Math.min(...series[k]) < Y0 || Math.max(...series[k]) > Y1) throw new Error(`FairnessTradeoff: ${k} leaves the plot`);

const style: Record<Key, { tone: string; dash: boolean }> = {
  sel: { tone: 'blue', dash: false }, tpr: { tone: 'green', dash: false }, fpr: { tone: 'amber', dash: true }, ppv: { tone: 'red', dash: false } };
const t = ru
  ? { title: 'Порог для группы B и четыре критерия справедливости',
      names: { sel: 'доля одобренных', tpr: 'TPR', fpr: 'FPR', ppv: 'PPV' } as Record<Key, string>,
      x: 'порог для группы B (для A — 0.5)', y: 'разница B − A',
      wide: [`равный PPV: ${cross.ppv.toFixed(2)}`, `равные TPR и FPR: ≈ ${cross.tpr.toFixed(2)}`, `равное одобрение: ${cross.sel.toFixed(2)}`],
      narrow: ['PPV', 'TPR, FPR', 'одобрение'],
      desc: 'Четыре кривые разницы между группами B и A в зависимости от порога для группы B от 0.3 до 0.8: доля одобренных, TPR и FPR убывают и пересекают ноль около 0.66–0.68, разница PPV растёт и пересекает ноль около 0.42. Ни при каком пороге все четыре разницы не равны нулю одновременно.' }
  : { title: 'The threshold for group B against four fairness criteria',
      names: { sel: 'approval rate', tpr: 'TPR', fpr: 'FPR', ppv: 'PPV' } as Record<Key, string>,
      x: 'threshold for group B (group A at 0.5)', y: 'gap, B minus A',
      wide: [`equal PPV: ${cross.ppv.toFixed(2)}`, `equal TPR and FPR: ≈ ${cross.tpr.toFixed(2)}`, `equal approval: ${cross.sel.toFixed(2)}`],
      narrow: ['PPV', 'TPR, FPR', 'approval'],
      desc: 'Four curves of the gap between groups B and A against the threshold for group B from 0.3 to 0.8: the gaps in approval rate, TPR and FPR fall and cross zero near 0.66 to 0.68; the PPV gap rises and crosses zero near 0.42. No threshold makes all four gaps zero at once.' };

interface Layout { cls: string; W: number; H: number; box: [number, number, number, number]; wide: boolean; legend: [number, number][] }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 350, box: [70, 64, 740, 304], wide: true, legend: [[70, 20], [250, 20], [350, 20], [450, 20]] },
  { cls: 'fig-narrow', W: 360, H: 380, box: [48, 76, 344, 300], wide: false, legend: [[12, 18], [190, 18], [12, 40], [190, 40]] },
];
const CH = 6.5;
const plots = layouts.map((L) => {
  const [x0, y0, x1, y1] = L.box;
  const sx = scale([T0, T1], [x0, x1]);
  const sy = scale([Y0, Y1], [y1, y0]);
  const lines = keys.map((k) => ({ k, d: polyline(ts.map((tt, i) => [sx(tt), sy(series[k][i])] as [number, number])) }));
  const texts = L.wide ? t.wide : t.narrow;
  const marks = [
    { x: sx(cross.ppv), text: texts[0], anchor: 'start' as const, y: y0 + 18 },
    { x: sx(cross.tpr), text: texts[1], anchor: 'end' as const, y: y0 + 18 },
    { x: sx(cross.sel), text: texts[2], anchor: 'start' as const, y: y0 + 38 },
  ];
  for (const m of marks) {
    const w = m.text.length * CH, l = m.anchor === 'start' ? m.x + 6 : m.x - 6 - w;
    if (l < x0 + 2 || l + w > L.W - 4) throw new Error(`FairnessTradeoff: "${m.text}" outside at ${L.W}`);
    // the label must sit above every curve over its width
    for (let xx = l; xx <= l + w; xx += 2) {
      const tt = T0 + ((xx - x0) / (x1 - x0)) * (T1 - T0);
      for (const k of keys) if (sy(gap(k, tt)) < m.y + 6) throw new Error(`FairnessTradeoff: "${m.text}" meets the ${k} curve`);
    }
  }
  L.legend.forEach(([lx], i) => {
    const end = lx + 30 + t.names[keys[i]].length * CH;
    const next = L.legend.find(([nx, ny], j) => j > i && ny === L.legend[i][1]);
    if (end > (next ? next[0] - 8 : L.W - 4)) throw new Error(`FairnessTradeoff: legend ${i} at ${L.W}`);
  });
  if (t.x.length * CH > x1 - x0) throw new Error('FairnessTradeoff: axis title');
  return { L, sx, sy, lines, marks };
});
const id = 'fairness-tradeoff';
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? `Синтетический пример из заметки: оценки откалиброваны внутри каждой группы, s ~ Beta(2, 4) в группе A (базовая частота 1/3) и s ~ Beta(3, 3) в группе B (1/2), вероятность положительного исхода при оценке (score) s равна s. Группу A одобряют при s > 0.5; ось x — порог для группы B, ось y — разница B − A. Равные TPR и FPR (уравненные шансы, equalized odds) почти достигаются при пороге ${cross.tpr.toFixed(3)}–${cross.fpr.toFixed(3)}, равная доля одобренных — при ${cross.sel.toFixed(3)}, равная точность одобрений (PPV) — только при ${cross.ppv.toFixed(3)}. При разных базовых частотах общей точки нет.`
    : `The synthetic example of the note: scores are calibrated within each group, s ~ Beta(2, 4) in group A (base rate 1/3) and s ~ Beta(3, 3) in group B (1/2), and the probability of a positive outcome at score s is s. Group A is approved above 0.5; the x axis is the threshold for group B, the y axis the gap B − A. Equal TPR and FPR (equalized odds) are nearly reached at thresholds ${cross.tpr.toFixed(3)} and ${cross.fpr.toFixed(3)}, equal approval rates at ${cross.sel.toFixed(3)}, equal precision of approvals (PPV) only at ${cross.ppv.toFixed(3)}. With different base rates there is no common point.`}
>
  {plots.map(({ L, sx, sy, lines, marks }) => {
    const [x0, y0, x1, y1] = L.box;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        {[-0.2, 0, 0.2, 0.4, 0.6].map((v) => (
          <g>
            <path class={v === 0 ? 'f-axis' : 'f-grid'} d={`M ${x0} ${sy(v)} H ${x1}`} />
            <text class="f-note" x={x0 - 8} y={sy(v) + 5} text-anchor="end">{v.toFixed(1)}</text>
          </g>
        ))}
        {[0.3, 0.4, 0.5, 0.6, 0.7, 0.8].map((v) => (
          <g>
            <path class="f-axis" d={`M ${sx(v)} ${y1} v 5`} />
            <text class="f-note" x={sx(v)} y={y1 + 20} text-anchor="middle">{v.toFixed(1)}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${x0} ${y0} V ${y1} H ${x1}`} />
        <text class="f-note" x={x1} y={y1 + 40} text-anchor="end">{t.x}</text>
        <text class="f-note" x={x0} y={y0 - 10}>{t.y}</text>
        {marks.map((m) => <path class="f-thin f-muted f-dot" d={`M ${m.x} ${y0 + 4} V ${y1}`} />)}
        {lines.map(({ k, d }) => <path class={`f-line f-bold f-${style[k].tone}${style[k].dash ? ' f-dash' : ''}`} d={d} />)}
        {marks.map((m) => <text class="f-small" x={m.anchor === 'start' ? m.x + 6 : m.x - 6} y={m.y} text-anchor={m.anchor}>{m.text}</text>)}
        {keys.map((k, i) => (
          <g>
            <path class={`f-line f-bold f-${style[k].tone}${style[k].dash ? ' f-dash' : ''}`} d={`M ${L.legend[i][0]} ${L.legend[i][1] - 4} h 22`} />
            <text class={`f-small f-t-${style[k].tone}`} x={L.legend[i][0] + 30} y={L.legend[i][1]}>{t.names[k]}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
