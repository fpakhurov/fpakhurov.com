---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { line, lineY, lifted, liftFit, roots, liftSv } from './krrData';

const ru = pageLang(Astro.url) === 'ru';

// Left: twelve points on a line, class +1 in the middle; no single threshold separates them. Right: the same points
// after φ(x) = (x, x²) lie on a parabola, and the maximum-margin line in that plane separates them. The line crosses
// the parabola at two points, which are the two thresholds of the resulting rule in the original feature.
const [w1, w2] = liftFit.w, b = liftFit.b;
const yOn = (x: number, v: number) => (v - b - w1 * x) / w2; // the lifted coordinate on the line w₁x + w₂s + b = v
const XD: [number, number] = [-3, 3], SD: [number, number] = [-0.4, 7.4];
const rStr = roots.map((r) => (r < 0 ? '−' : '') + Math.abs(r).toFixed(2));
if (rStr.join() !== '−1.47,1.37') throw new Error('FeatureMap: thresholds drifted');
const tick = (v: number) => ({ v, label: v < 0 ? `−${-v}` : String(v) });
const ticks5 = [-2, -1, 0, 1, 2].map(tick), ticks3 = [-2, 0, 2].map(tick);
const parab = Array.from({ length: 121 }, (_, i) => -2.7 + (5.4 * i) / 120);
const t = ru
  ? { orig: 'исходный признак x', lift: 'после φ(x) = (x, x²)', none: 'один порог не разделит классы', map: 'φ', kern: 'k(x, z) = xz + x²z²', s: 'x²', x: 'x', rule: 'правило: +1 при −1.47 < x < 1.37' }
  : { orig: 'original feature x', lift: 'after φ(x) = (x, x²)', none: 'no single threshold separates the classes', map: 'φ', kern: 'k(x, z) = xz + x²z²', s: 'x²', x: 'x', rule: 'rule: +1 for −1.47 < x < 1.37' };
const caption = ru
  ? `Двенадцать точек на прямой: класс +1 в середине, класс −1 по краям, и ни один порог по x их не разделяет. Отображение φ(x) = (x, x²) поднимает точки на параболу, и там их разделяет прямая; сплошная линия — решение SVM с жёстким зазором в плоскости (x, x²), пунктир — края полосы, в кружках три опорных вектора. Прямая пересекает параболу при x = ${rStr[0]} и x = ${rStr[1]}: линейное правило в новых признаках — это два порога в исходном. Скалярное произведение после отображения равно k(x, z) = xz + x²z², и SVM можно обучить, зная только его.`
  : `Twelve points on a line: class +1 in the middle, class −1 on both sides, and no threshold on x separates them. The map φ(x) = (x, x²) lifts the points onto a parabola, where a line separates them; the solid line is the hard-margin SVM in the (x, x²) plane, the dashed lines are the edges of its band, and the three support vectors are ringed. The line crosses the parabola at x = ${rStr[0]} and x = ${rStr[1]}: a linear rule in the new features is two thresholds in the old one. The inner product after the map is k(x, z) = xz + x²z², and the SVM can be trained knowing only that.`;
const id = 'kernels-feature-map';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 300, lx: [24, 320] as [number, number], ly: 196, px: [446, 740] as [number, number], py: [262, 28] as [number, number], arrow: [[338, 150], [402, 150]], tTitle: [172, 140], tNone: [172, 246], narrow: false },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 556, lx: [24, 336] as [number, number], ly: 78, px: [40, 344] as [number, number], py: [520, 196] as [number, number], arrow: [[180, 126], [180, 172]], tTitle: [180, 30], tNone: [180, 118], narrow: true },
];
---

<Figure
  id={id}
  title={ru ? 'Отображение признаков делает классы линейно разделимыми' : 'A feature map makes the classes linearly separable'}
  caption={caption}
>
  {layouts.map((L) => {
    const lx = scale(XD, L.lx);
    const px = scale(XD, L.px), py = scale(SD, L.py);
    const seg = (v: number) => `M ${px(XD[0]).toFixed(1)} ${py(yOn(XD[0], v)).toFixed(1)} L ${px(XD[1]).toFixed(1)} ${py(yOn(XD[1], v)).toFixed(1)}`;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{ru ? 'Точки на прямой и они же на параболе' : 'Points on a line and the same points on a parabola'}</title>
        <desc id={`${id}-${L.sfx}-d`}>{ru
          ? 'Слева на числовой прямой синие кружки в середине и красные квадраты по краям. Стрелка φ ведёт к плоскости, где те же точки лежат на параболе: синие внизу, красные выше. Почти горизонтальная прямая отделяет синие точки от красных и пересекает параболу в двух местах.'
          : 'On the left, a number line with blue circles in the middle and red squares on both ends. An arrow φ leads to a plane where the same points lie on a parabola, blue near the bottom and red higher up. A nearly horizontal line separates the blue points from the red ones and crosses the parabola twice.'}</desc>
        <text class="f-small f-t-muted" x={L.tTitle[0]} y={L.tTitle[1]} text-anchor="middle">{t.orig}</text>
        <path class="f-axis" d={`M ${L.lx[0]} ${L.ly} H ${L.lx[1]}`} />
        {ticks5.map((k) => <g><path class="f-axis" d={`M ${lx(k.v)} ${L.ly - 4} V ${L.ly + 4}`} /><text class="f-note" x={lx(k.v)} y={L.ly + 20} text-anchor="middle">{k.label}</text></g>)}
        {roots.map((r) => <path class="f-thin f-amber f-dash" style="stroke-width: 1.6" d={`M ${lx(r).toFixed(1)} ${L.ly - 22} V ${L.ly + 6}`} />)}
        {roots.map((r, i) => <text class="f-small f-t-amber" x={lx(r).toFixed(1)} y={L.ly - 27} text-anchor="middle">{rStr[i]}</text>)}
        {line.map((x, k) => lineY[k] === 1
          ? <circle cx={lx(x).toFixed(1)} cy={L.ly} r="4.5" class="f-solid-blue" style="fill-opacity: .85" />
          : <rect x={(lx(x) - 4).toFixed(1)} y={L.ly - 4} width="8" height="8" class="f-solid-red" style="fill-opacity: .85" />)}
        <text class="f-small f-t-muted" x={L.tNone[0]} y={L.tNone[1]} text-anchor="middle">{L.narrow ? t.rule : t.none}</text>
        {!L.narrow && <text class="f-small f-t-amber" x={L.tNone[0]} y={L.tNone[1] + 22} text-anchor="middle">{t.rule}</text>}
        <path class="f-line f-muted" d={`M ${L.arrow[0][0]} ${L.arrow[0][1]} L ${L.arrow[1][0]} ${L.arrow[1][1]}`} marker-end="url(#f-arrow-muted)" />
        <text class="f-math" x={(L.arrow[0][0] + L.arrow[1][0]) / 2 + (L.narrow ? 14 : 0)} y={(L.arrow[0][1] + L.arrow[1][1]) / 2 + (L.narrow ? 6 : -10)} text-anchor={L.narrow ? 'start' : 'middle'}>{t.map}</text>
        <rect x={L.px[0]} y={L.py[1]} width={L.px[1] - L.px[0]} height={L.py[0] - L.py[1]} class="f-grid" style="fill: none" />
        <text class="f-small f-t-muted" x={(L.px[0] + L.px[1]) / 2} y={L.py[1] - 10} text-anchor="middle">{t.lift}</text>
        {[0, 2, 4, 6].map((v) => <text class="f-note" x={L.px[0] - 6} y={py(v) + 4} text-anchor="end">{v}</text>)}
        {ticks3.map((k) => <text class="f-note" x={px(k.v)} y={L.py[0] + 18} text-anchor="middle">{k.label}</text>)}
        <text class="f-small f-t-muted" x={L.px[1] - 4} y={L.py[0] - 6} text-anchor="end">{t.x}</text>
        <text class="f-small f-t-muted" x={L.px[0] + 6} y={L.py[1] + 16}>{t.s}</text>
        <path class="f-thin f-muted" d={polyline(parab.map((x) => [px(x), py(x * x)]))} />
        <path class="f-line f-dash" d={seg(-1)} />
        <path class="f-line f-dash" d={seg(1)} />
        <path class="f-line f-bold" d={seg(0)} />
        {roots.map((r) => <path class="f-thin f-amber f-dash" style="stroke-width: 1.6" d={`M ${px(r).toFixed(1)} ${py(r * r).toFixed(1)} V ${L.py[0]}`} />)}
        {lifted.map((p, k) => lineY[k] === 1
          ? <circle cx={px(p[0]).toFixed(1)} cy={py(p[1]).toFixed(1)} r="4.5" class="f-solid-blue" style="fill-opacity: .85" />
          : <rect x={(px(p[0]) - 4).toFixed(1)} y={(py(p[1]) - 4).toFixed(1)} width="8" height="8" class="f-solid-red" style="fill-opacity: .85" />)}
        {liftSv.map((k) => <circle cx={px(lifted[k][0]).toFixed(1)} cy={py(lifted[k][1]).toFixed(1)} r="8.5" class="f-line" style="stroke-width: 1.5" />)}
        <text class="f-small f-halo" x={px(0)} y={py(6.4)} text-anchor="middle">{t.kern}</text>
      </svg>
    );
  })}
</Figure>
