---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { xs, ys, grid, truth, lambda, panels } from './krrData';

const ru = pageLang(Astro.url) === 'ru';

// Kernel ridge regression with the RBF kernel on 30 noisy points of sin(2πx), λ = 0.1, at three bandwidths.
// df is the effective number of parameters tr(K(K + λI)⁻¹); "error" is the mean squared distance to the true curve.
const XD: [number, number] = [0, 1], YD: [number, number] = [-1.9, 1.7];
const stats = panels.map((p) => ({ s: String(p.sigma), df: p.df.toFixed(1), train: p.train.toFixed(3), err: p.test.toFixed(3) }));
if (stats.map((s) => `${s.s} ${s.df} ${s.train} ${s.err}`).join(' | ') !== '1 2.4 0.231 0.181 | 0.3 4.4 0.039 0.007 | 0.01 24.3 0.004 0.197') throw new Error('KernelRidgeFits: quoted numbers drifted');
const names = ru ? ['слишком широкое ядро', 'в самый раз', 'слишком узкое ядро'] : ['too wide', 'about right', 'too narrow'];
const lines = panels.map((p, i) => ({
  head: `σ = ${stats[i].s}: ${names[i]}`,
  sub: ru ? `df ${stats[i].df} · обучение ${stats[i].train} · ошибка ${stats[i].err}` : `df ${stats[i].df} · train ${stats[i].train} · error ${stats[i].err}`,
  path: grid.map((x) => [x, Math.max(YD[0], Math.min(YD[1], p.f(x)))] as [number, number]),
}));
const caption = ru
  ? `Гребневая регрессия с RBF-ядром k(x, z) = exp(−(x − z)²/(2σ²)) по 30 зашумлённым точкам кривой sin(2πx) (пунктир), λ = ${lambda}. Широкое ядро (σ = 1) почти не гнётся: эффективное число параметров df = tr(K(K + λI)⁻¹) = ${stats[0].df}, кривая недообучена, средний квадрат отклонения от истинной кривой ${stats[0].err}. При σ = 0.3 (df = ${stats[1].df}) отклонение падает до ${stats[1].err}. Узкое ядро (σ = 0.01, df = ${stats[2].df} из 30) проходит почти через каждую точку (ошибка на обучении ${stats[2].train}) и между точками падает к нулю: отклонение снова растёт, до ${stats[2].err}. Ширина ядра играет роль сложности модели.`
  : `Kernel ridge regression with the RBF kernel k(x, z) = exp(−(x − z)²/(2σ²)) on 30 noisy points of sin(2πx) (dashed), λ = ${lambda}. The wide kernel (σ = 1) hardly bends: its effective number of parameters df = tr(K(K + λI)⁻¹) is ${stats[0].df}, the fit underfits, and its mean squared distance from the true curve is ${stats[0].err}. At σ = 0.3 (df = ${stats[1].df}) the distance drops to ${stats[1].err}. The narrow kernel (σ = 0.01, df = ${stats[2].df} of 30) passes almost through every point (training error ${stats[2].train}) and falls back towards zero between them, and the distance rises again to ${stats[2].err}. The bandwidth plays the role of model complexity.`;
const id = 'kernels-ridge-bandwidths';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 238, boxes: [[14, 44], [266, 44], [518, 44]], bw: 228, bh: 178, narrow: false },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 690, boxes: [[16, 46], [16, 276], [16, 506]], bw: 328, bh: 150, narrow: true },
];
---

<Figure
  id={id}
  title={ru ? 'Ширина RBF-ядра как сложность модели' : 'The RBF bandwidth as model complexity'}
  caption={caption}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{ru ? 'Три подгонки гребневой регрессии с ядром' : 'Three kernel ridge regression fits'}</title>
      <desc id={`${id}-${L.sfx}-d`}>{ru
        ? 'Три панели с одними и теми же точками вокруг синусоиды. Слева гладкая пологая кривая проходит мимо пиков, в середине кривая повторяет синусоиду, справа кривая скачет к каждой точке и между ними падает к нулю.'
        : 'Three panels with the same points around a sine curve. On the left a smooth, flat curve misses the peaks; in the middle the curve follows the sine; on the right the curve spikes to every point and drops to zero between them.'}</desc>
      {lines.map((ln, i) => {
        const [bx, by] = L.boxes[i];
        const sx = scale(XD, [bx, bx + L.bw]), sy = scale(YD, [by + L.bh, by]);
        return (
          <g>
            <text class="f-small" x={bx} y={by - 24}>{ln.head}</text>
            <text class="f-small f-t-muted" x={bx} y={by - 8}>{ln.sub}</text>
            <rect x={bx} y={by} width={L.bw} height={L.bh} class="f-grid" style="fill: none" />
            <path class="f-grid" d={`M ${bx} ${sy(0)} H ${bx + L.bw}`} />
            <path class="f-thin f-muted f-dash" d={polyline(grid.map((x) => [sx(x), sy(truth(x))]))} />
            {xs.map((x, k) => <circle cx={sx(x).toFixed(1)} cy={sy(ys[k]).toFixed(1)} r="2.8" class="f-solid-muted" />)}
            <path class="f-line f-blue f-bold" d={polyline(ln.path.map(([x, y]) => [sx(x), sy(y)]))} />
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
