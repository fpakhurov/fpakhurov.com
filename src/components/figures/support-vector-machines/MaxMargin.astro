---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { hard, hardFit, hardSv, others, band, chord, type P2 } from './svmData';

const ru = pageLang(Astro.url) === 'ru';

// Twenty seeded separable points, the maximum-margin line of the hard-margin SVM, its margin band and the three
// support vectors, against two other lines that also separate the data. Equal scales keep right angles right.
const X: P2 = [-3, 3.2], Y: P2 = [-2.3, 2.5];
const { w, b } = hardFit;
const nw = Math.hypot(w[0], w[1]);
const u: P2 = [w[0] / nw, w[1] / nw];
const strip = band(w, -1 - b, 1 - b, X, Y);
const lines = [-1, 0, 1].map((v) => ({ v, seg: chord(w, v - b, X, Y) }));
// every line leaves the box through its bottom edge; label it there
const atBottom = lines.map((l) => l.seg.find((p) => Math.abs(p[1] - Y[0]) < 1e-9));
if (atBottom.some((p) => !p)) throw new Error('MaxMargin: a line misses the bottom edge');
const labelX = atBottom.map((p) => (p as P2)[0]);
const otherSegs = others.map((o) => chord(o.u, o.c, X, Y));
// the width arrow across the band, centred on the decision line near (0.6, −1.05)
const mid: P2 = [0.6, -(b / w[1]) - 0.6 * (w[0] / w[1])];
const half = 1 / nw;
const arrow: [P2, P2] = [[mid[0] - half * u[0], mid[1] - half * u[1]], [mid[0] + half * u[0], mid[1] + half * u[1]]];
const svAlpha = hardSv.map((k) => hardFit.alpha[k].toFixed(2));
const width = hardFit.width.toFixed(2), gamma = (hardFit.width / 2).toFixed(2);
const otherM = others.map((o) => o.margin.toFixed(2));
if (width !== '1.63' || gamma !== '0.81' || svAlpha.join() !== '0.63,0.13,0.76' || otherM.join() !== '0.35,0.27') throw new Error('MaxMargin: quoted numbers drifted');
const lineLabel = (v: number) => (v > 0 ? '+1' : v < 0 ? '−1' : '0');
const t = ru
  ? {
      plus: '● класс +1', minus: '■ класс −1', key: '⟨w, x⟩ + b =',
      panel: [
        'сплошная: прямая с максимальным зазором',
        'пунктир: ⟨w, x⟩ + b = ±1, края полосы',
        'точечные: ещё две разделяющие прямые,',
        `   зазоры ${otherM[0]} и ${otherM[1]}`,
        `w = (${w[0].toFixed(2)}, ${w[1].toFixed(2)}), b = ${b.toFixed(2)}`,
        `зазор 1/‖w‖ = ${gamma} с каждой стороны`,
        'в кружках: 3 опорных вектора,',
        `   α = ${svAlpha.join(', ')}`,
        'у остальных 17 точек α = 0',
      ],
    }
  : {
      plus: '● class +1', minus: '■ class −1', key: '⟨w, x⟩ + b =',
      panel: [
        'solid: the maximum-margin line',
        'dashed: ⟨w, x⟩ + b = ±1, the band edges',
        'dotted: two other separating lines,',
        `   margins ${otherM[0]} and ${otherM[1]}`,
        `w = (${w[0].toFixed(2)}, ${w[1].toFixed(2)}), b = ${b.toFixed(2)}`,
        `margin 1/‖w‖ = ${gamma} on each side`,
        'ringed: the 3 support vectors,',
        `   α = ${svAlpha.join(', ')}`,
        'the other 17 points have α = 0',
      ],
    };
const caption = ru
    ? `Двадцать линейно разделимых точек, по 10 в каждом классе. Все три прямые разделяют классы без ошибок, но точечные проходят на расстоянии всего ${otherM[0]} и ${otherM[1]} от ближайшей точки. SVM с жёстким зазором выбирает прямую, ближайшая точка которой максимально далека: ${gamma} с каждой стороны, ширина полосы 2/‖w‖ = ${width}. Решение определяют три точки на краях полосы, опорные векторы с α > 0; если сдвинуть или убрать любую другую точку, не заходя в полосу, прямая не изменится. Масштабы осей одинаковы.`
    : `Twenty linearly separable points, 10 per class. All three lines separate the classes without error, but the dotted ones come within ${otherM[0]} and ${otherM[1]} of the nearest point. The hard-margin SVM picks the line whose nearest point is as far as possible: ${gamma} on each side, a band of width 2/‖w‖ = ${width}. Three points on the edges of the band, the support vectors with α > 0, determine the solution; moving or deleting any other point without entering the band leaves the line unchanged. Both axes have the same scale.`;
// continuation lines of the panel start with spaces; they are drawn indented
const panel = t.panel.map((line) => ({ text: line.trim(), dx: line.startsWith(' ') ? 14 : 0 }));
const id = 'svm-max-margin';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, u: 58, x0: 16, y0: 14, lx: 410, ly: 44, dy: 27 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 560, u: 54, x0: 12, y0: 12, lx: 12, ly: 316, dy: 26 },
];
---

<Figure
  id={id}
  title={ru ? 'Прямая с максимальным зазором и опорные векторы' : 'The maximum-margin line and its support vectors'}
  caption={caption}
>
  {layouts.map((L) => {
    const sx = scale(X, [L.x0, L.x0 + (X[1] - X[0]) * L.u]);
    const sy = scale(Y, [L.y0 + (Y[1] - Y[0]) * L.u, L.y0]);
    const P = (p: P2) => `${sx(p[0]).toFixed(1)} ${sy(p[1]).toFixed(1)}`;
    const bottom = sy(Y[0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{ru ? 'Полоса максимального зазора между двумя классами' : 'The maximum-margin band between two classes'}</title>
        <desc id={`${id}-${L.sfx}-d`}>{ru
          ? 'Синие кружки класса +1 справа сверху, красные квадраты класса −1 слева снизу. Между ними по диагонали идёт закрашенная полоса с пунктирными краями и сплошной средней линией. На краях полосы лежат три обведённые точки. Две пунктирные точками прямые тоже разделяют классы, но проходят вплотную к точкам.'
          : 'Blue circles of class +1 at the top right, red squares of class −1 at the bottom left. A shaded diagonal band with dashed edges and a solid centre line runs between them. Three ringed points lie on the edges of the band. Two dotted lines also separate the classes but pass close to the points.'}</desc>
        <path d={`M ${strip.map(P).join(' L ')} Z`} class="f-fill-amber" style="fill-opacity: .14" />
        <rect x={sx(X[0])} y={sy(Y[1])} width={sx(X[1]) - sx(X[0])} height={sy(Y[0]) - sy(Y[1])} class="f-grid" style="fill: none" />
        {otherSegs.map((s) => <path class="f-thin f-muted f-dot" style="stroke-width: 1.6" d={`M ${P(s[0])} L ${P(s[1])}`} />)}
        {lines.map((l) => <path class={l.v === 0 ? 'f-line f-bold' : 'f-line f-dash'} d={`M ${P(l.seg[0])} L ${P(l.seg[1])}`} />)}
        {lines.map((l, i) => <text class="f-small" x={sx(labelX[i])} y={bottom + 17} text-anchor="middle">{lineLabel(l.v)}</text>)}
        <text class="f-small f-t-muted" x={sx(labelX[0]) - 16} y={bottom + 17} text-anchor="end">{t.key}</text>
        {hard.X.map((x, k) => hard.y[k] === 1
          ? <circle cx={sx(x[0]).toFixed(1)} cy={sy(x[1]).toFixed(1)} r="4" class="f-solid-blue" style="fill-opacity: .85" />
          : <rect x={(sx(x[0]) - 3.6).toFixed(1)} y={(sy(x[1]) - 3.6).toFixed(1)} width="7.2" height="7.2" class="f-solid-red" style="fill-opacity: .85" />)}
        {hardSv.map((k) => <circle cx={sx(hard.X[k][0]).toFixed(1)} cy={sy(hard.X[k][1]).toFixed(1)} r="8" class="f-line" style="stroke-width: 1.5" />)}
        <path class="f-line f-amber" d={`M ${P(arrow[0])} L ${P(arrow[1])}`} marker-start="url(#f-arrow-amber)" marker-end="url(#f-arrow-amber)" />
        <text class="f-small f-t-amber f-halo" x={sx(mid[0]) + 12} y={sy(mid[1]) + 22}>2/‖w‖ = {width}</text>
        <text class="f-small f-t-blue" x={L.lx} y={L.ly}>{t.plus}</text>
        <text class="f-small f-t-red" x={L.lx + 120} y={L.ly}>{t.minus}</text>
        {panel.map((line, i) => <text class="f-small f-t-muted" x={L.lx + line.dx} y={L.ly + (i + 1) * L.dy}>{line.text}</text>)}
      </svg>
    );
  })}
</Figure>
