---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { soft, softC, softFit, onMargin, atC, slack, band, chord, type P2 } from './svmData';

const ru = pageLang(Astro.url) === 'ru';

// Twenty overlapping points and the soft-margin SVM with C = 1. The dual variables sort the points into three groups:
// α = 0 (outside the band), 0 < α < C (exactly on its edge) and α = C (inside the band or on the wrong side, with
// slack ξ > 0, drawn as the amber segment to the edge where the point would have no slack).
const X: P2 = [-2.6, 2.7], Y: P2 = [-1.8, 2.2];
const { w, b } = softFit;
const nw2 = w[0] * w[0] + w[1] * w[1];
const strip = band(w, -1 - b, 1 - b, X, Y);
const lines = [-1, 0, 1].map((v) => ({ v, seg: chord(w, v - b, X, Y) }));
const atBottom = lines.map((l) => l.seg.find((p) => Math.abs(p[1] - Y[0]) < 1e-9));
if (atBottom.some((p) => !p)) throw new Error('SoftMargin: a line misses the bottom edge');
const labelX = atBottom.map((p) => (p as P2)[0]);
const lineLabel = (v: number) => (v > 0 ? '+1' : v < 0 ? '−1' : '0');
// slack segments: from x to x + y ξ w / ‖w‖², which lands on the line ⟨w, x⟩ + b = y
const segs = atC.map((k) => {
  const x = soft.X[k], xi = slack(k), s = soft.y[k] * xi / nw2;
  return { k, x, end: [x[0] + s * w[0], x[1] + s * w[1]] as P2, xi: xi.toFixed(2) };
});
// label positions of the slacks (data coordinates), chosen to avoid the points
const labelAt: Record<number, { p: P2; anchor: string }> = {
  8: { p: [-0.52, 0.2], anchor: 'end' },
  9: { p: [0.28, -1.5], anchor: 'start' },
  12: { p: [0.74, 0.95], anchor: 'start' },
};
const alphas = onMargin.map((k) => softFit.alpha[k].toFixed(2));
const xis = segs.map((s) => s.xi);
const half = (1 / Math.sqrt(nw2)).toFixed(2);
const reg = (nw2 / 2).toFixed(2), pen = (softC * atC.reduce((s, k) => s + slack(k), 0)).toFixed(2);
const total = (nw2 / 2 + softC * atC.reduce((s, k) => s + slack(k), 0)).toFixed(2);
const rest = soft.X.length - onMargin.length - atC.length;
if (alphas.join() !== '0.64,0.68,0.96' || xis.join() !== '1.54,0.92,0.66' || half !== '0.68' || `${reg} ${pen} ${total}` !== '1.08 3.13 4.20' || rest !== 14) throw new Error('SoftMargin: quoted numbers drifted');
const t = ru
  ? {
      plus: '● класс +1', minus: '■ класс −1', key: '⟨w, x⟩ + b =',
      panel: [
        `C = 1: w = (${w[0].toFixed(2)}, ${w[1].toFixed(2)}), b = ${b.toFixed(2).replace('-', '−')}`,
        `зазор 1/‖w‖ = ${half} с каждой стороны`,
        'простые кружки: на краю полосы, ξ = 0,',
        `   0 < α < C: α = ${alphas.join(', ')}`,
        'жёлтые кружки: α = C = 1, штраф ξ > 0',
        `   (отрезки): ${xis[2]} и ${xis[1]} внутри полосы,`,
        `   ${xis[0]} на чужой стороне`,
        `остальные ${rest} точек: α = 0, ξ = 0`,
        `½‖w‖² + CΣξ = ${reg} + ${pen} = ${total}`,
      ],
    }
  : {
      plus: '● class +1', minus: '■ class −1', key: '⟨w, x⟩ + b =',
      panel: [
        `C = 1: w = (${w[0].toFixed(2)}, ${w[1].toFixed(2)}), b = ${b.toFixed(2).replace('-', '−')}`,
        `margin 1/‖w‖ = ${half} on each side`,
        'plain rings: on the edge, ξ = 0,',
        `   0 < α < C: α = ${alphas.join(', ')}`,
        'amber rings: α = C = 1, slack ξ > 0',
        `   (segments): ${xis[2]} and ${xis[1]} inside the band,`,
        `   ${xis[0]} on the wrong side`,
        `the other ${rest} points: α = 0, ξ = 0`,
        `½‖w‖² + CΣξ = ${reg} + ${pen} = ${total}`,
      ],
    };
const caption = ru
  ? `Двадцать точек, которые нельзя разделить прямой, и SVM с мягким зазором при C = 1. Двойственные переменные делят точки на три группы. У ${rest} точек за пределами полосы α = 0: они не влияют на решение. Три точки лежат ровно на краях полосы (0 < α < C), по ним находят b. Ещё три имеют α = C и штраф ξ = 1 − y(⟨w, x⟩ + b) > 0, длину жёлтого отрезка до своего края полосы в единицах 1/‖w‖: две точки внутри полосы классифицированы верно (ξ = ${xis[2]} и ${xis[1]}), одна, с ξ = ${xis[0]} > 1, на чужой стороне. Значение целевой функции ${total} совпадает с двойственным.`
  : `Twenty points that no line separates, and the soft-margin SVM with C = 1. The dual variables split the points into three groups. The ${rest} points outside the band have α = 0 and do not affect the solution. Three points lie exactly on the edges of the band (0 < α < C), and b is computed from them. Three more have α = C and slack ξ = 1 − y(⟨w, x⟩ + b) > 0, the length of the amber segment to their own edge of the band in units of 1/‖w‖: two inside the band are still classified correctly (ξ = ${xis[2]} and ${xis[1]}), one, with ξ = ${xis[0]} > 1, is on the wrong side. The objective value ${total} equals the dual one.`;
const panel = t.panel.map((line) => ({ text: line.trim(), dx: line.startsWith(' ') ? 14 : 0 }));
const id = 'svm-soft-margin';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, u: 66, x0: 16, y0: 14, lx: 400, ly: 44, dy: 27 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 560, u: 63, x0: 12, y0: 12, lx: 12, ly: 316, dy: 26 },
];
---

<Figure
  id={id}
  title={ru ? 'Мягкий зазор: что говорят двойственные переменные' : 'The soft margin: what the dual variables say'}
  caption={caption}
>
  {layouts.map((L) => {
    const sx = scale(X, [L.x0, L.x0 + (X[1] - X[0]) * L.u]);
    const sy = scale(Y, [L.y0 + (Y[1] - Y[0]) * L.u, L.y0]);
    const P = (p: P2) => `${sx(p[0]).toFixed(1)} ${sy(p[1]).toFixed(1)}`;
    const bottom = sy(Y[0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{ru ? 'Опорные векторы SVM с мягким зазором' : 'Support vectors of a soft-margin SVM'}</title>
        <desc id={`${id}-${L.sfx}-d`}>{ru
          ? 'Синие кружки и красные квадраты частично перемешаны. Через них проходит закрашенная полоса со сплошной средней линией. Три точки на краях полосы обведены, три точки внутри полосы или за ней обведены жёлтым, и от каждой к её краю полосы идёт жёлтый пунктирный отрезок.'
          : 'Blue circles and red squares partly overlap. A shaded band with a solid centre line runs through them. Three points on the edges of the band are ringed; three points inside the band or beyond it are ringed in amber, each with a dashed amber segment to its own edge of the band.'}</desc>
        <path d={`M ${strip.map(P).join(' L ')} Z`} class="f-fill-amber" style="fill-opacity: .14" />
        <rect x={sx(X[0])} y={sy(Y[1])} width={sx(X[1]) - sx(X[0])} height={sy(Y[0]) - sy(Y[1])} class="f-grid" style="fill: none" />
        {lines.map((l) => <path class={l.v === 0 ? 'f-line f-bold' : 'f-line f-dash'} d={`M ${P(l.seg[0])} L ${P(l.seg[1])}`} />)}
        {lines.map((l, i) => <text class="f-small" x={sx(labelX[i])} y={bottom + 17} text-anchor="middle">{lineLabel(l.v)}</text>)}
        <text class="f-small f-t-muted" x={sx(labelX[0]) - 16} y={bottom + 17} text-anchor="end">{t.key}</text>
        {segs.map((s) => <path class="f-line f-amber f-dash" style="stroke-width: 2" d={`M ${P(s.x)} L ${P(s.end)}`} />)}
        {soft.X.map((x, k) => soft.y[k] === 1
          ? <circle cx={sx(x[0]).toFixed(1)} cy={sy(x[1]).toFixed(1)} r="4" class="f-solid-blue" style="fill-opacity: .85" />
          : <rect x={(sx(x[0]) - 3.6).toFixed(1)} y={(sy(x[1]) - 3.6).toFixed(1)} width="7.2" height="7.2" class="f-solid-red" style="fill-opacity: .85" />)}
        {onMargin.map((k) => <circle cx={sx(soft.X[k][0]).toFixed(1)} cy={sy(soft.X[k][1]).toFixed(1)} r="8" class="f-line" style="stroke-width: 1.5" />)}
        {atC.map((k) => <circle cx={sx(soft.X[k][0]).toFixed(1)} cy={sy(soft.X[k][1]).toFixed(1)} r="8" class="f-line f-amber" style="stroke-width: 1.8" />)}
        {segs.map((s) => <text class="f-small f-t-amber f-halo" x={sx(labelAt[s.k].p[0])} y={sy(labelAt[s.k].p[1])} text-anchor={labelAt[s.k].anchor}>ξ = {s.xi}</text>)}
        <text class="f-small f-t-blue" x={L.lx} y={L.ly}>{t.plus}</text>
        <text class="f-small f-t-red" x={L.lx + 120} y={L.ly}>{t.minus}</text>
        {panel.map((line, i) => <text class="f-small f-t-muted" x={L.lx + line.dx} y={L.ly + (i + 1) * L.dy}>{line.text}</text>)}
      </svg>
    );
  })}
</Figure>
