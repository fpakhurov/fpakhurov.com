---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar, type Tone } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// orders.groupby("category")["amount"].sum() on the six orders of the note (pandas 3.0.6):
// books 20.5, games 65.0, music 15.0. NaN marks the missing amount of order 4.
const rows: [string, number][] = [['books', 12.5], ['games', 40.0], ['games', 25.0], ['books', NaN], ['books', 8.0], ['music', 15.0]];
const keys = ['books', 'games', 'music'];
const groups = keys.map((k) => rows.map((r, i) => ({ i, v: r[1] })).filter(({ i }) => rows[i][0] === k));
const sums = groups.map((g) => g.reduce((s, { v }) => (Number.isNaN(v) ? s : s + v), 0));
if (sums.map((s) => s.toFixed(1)).join() !== '20.5,65.0,15.0') throw new Error('group sums');
const show = (v: number) => (Number.isNaN(v) ? 'NaN' : v.toFixed(1));
const tone: Record<string, Tone> = { books: 'x', games: 'h', music: 'g' };

const t = ru
  ? { heads: ['orders', 'разделить по category', 'применить sum', 'объединить'], short: ['orders', 'разделить', 'sum', 'объединить'], skip: 'NaN пропущен',
      steps: ['Разделение: строки распределяются по группам по значению ключа category', 'Применение: sum считается внутри каждой группы; пропущенное значение не учитывается', 'Объединение: по одному числу на группу, в Series с индексом из ключей'] }
  : { heads: ['orders', 'split by category', 'apply sum', 'combine'], short: ['orders', 'split', 'sum', 'combine'], skip: 'NaN skipped',
      steps: ['Split: the rows go into groups by the value of the key, category', 'Apply: sum runs inside each group; the missing value is skipped', 'Combine: one number per group, in a Series indexed by the keys'] };

interface Layout { cls: string; W: number; H: number; sans: number; rh: number; kw: number; vw: number;
  tx: number; ty: number; gx: number; gy: number[]; ax: number; cx: number; cy: number; heads: [number, number][]; badges: [number, number][]; skipAt: [number, number] }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 290, sans: 6.5, rh: 30, kw: 80, vw: 64, tx: 24, ty: 64,
    gx: 280, gy: [50, 158, 236], ax: 470, cx: 610, cy: 118,
    heads: [[24, 50], [280, 26], [470, 26], [610, 26]], badges: [[280, 26], [470, 26], [610, 26]], skipAt: [470, 128] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 430, sans: 7.3, rh: 26, kw: 64, vw: 52, tx: 8, ty: 56,
    gx: 182, gy: [56, 146, 210], ax: 182, cx: 110, cy: 330,
    heads: [[8, 42], [182, 21], [300, 21], [110, 303]], badges: [[182, 21], [300, 21], [110, 303]], skipAt: [182, 258] },
];
for (const L of layouts) {
  if (L.tx + L.kw + L.vw > L.gx - 24) throw new Error('table runs into the groups');
  if (L.gx + L.kw + L.vw > L.W - 4 || L.cx + L.kw + L.vw > L.W - 4) throw new Error('off canvas');
  for (const [k, g] of groups.entries()) if (k + 1 < groups.length && L.gy[k] + g.length * L.rh + 6 > L.gy[k + 1]) throw new Error('groups overlap');
  const heads = L.W === 760 ? t.heads : t.short;
  for (const [k, [x]] of L.heads.entries()) if (x + (k === 0 ? 0 : 14) + heads[k].length * L.sans > L.W - 4) throw new Error(`head "${heads[k]}" overflows at ${L.W}`);
  if (L.W !== 760 && L.heads[1][0] + 14 + heads[1].length * L.sans > L.heads[2][0] - 12) throw new Error('narrow heads collide');
  if (L.W === 760) {
    if (L.heads[1][0] + 14 + t.heads[1].length * L.sans > L.heads[2][0] - 12) throw new Error('heads 1 and 2 collide');
    if (L.heads[2][0] + 14 + t.heads[2].length * L.sans > L.heads[3][0] - 12) throw new Error('heads 2 and 3 collide');
  }
  // apply results sit right of each group (wide) or right of each group too (narrow): they must fit
  const resultW = ('= ' + '65.0').length * (L.W === 760 ? 8.5 : L.sans);
  const ax = L.W === 760 ? L.ax : L.gx + L.kw + L.vw + 8;
  if (ax + resultW > L.W - 4) throw new Error('apply result overflows');
  if (L.skipAt[0] + t.skip.length * L.sans > L.W - 4) throw new Error('skip note overflows');
  if (L.W !== 760 && L.skipAt[1] - 12 < L.gy[2] + L.rh) throw new Error('skip note meets the music group');
}
const id = 'split-apply-combine';
const cellStyle = (tn: Tone, a = 0.14) => `fill: ${toneVar[tn]}; fill-opacity: ${a}; stroke: ${toneVar[tn]}; stroke-width: 1.2`;
---

<Figure
  id={id}
  title={ru ? 'groupby: разделение, применение, объединение' : 'groupby: split, apply, combine'}
  caption={ru
    ? 'orders.groupby("category")["amount"].sum() на шести заказах из заметки. Строки разделяются на группы по значению ключа (цвет — категория), функция применяется к каждой группе отдельно, и результаты объединяются в Series с ключами в индексе. sum пропускает отсутствующее значение amount у заказа 4, поэтому для books получается 12.5 + 8.0 = 20.5.'
    : 'orders.groupby("category")["amount"].sum() on the six orders of the note. The rows are split into groups by the value of the key (colour is category), the function is applied to each group separately, and the results are combined into a Series with the keys as its index. sum skips the missing amount of order 4, so books gives 12.5 + 8.0 = 20.5.'}
>
  {layouts.map((L) => {
    const wide = L.W === 760;
    const ax = wide ? L.ax : L.gx + L.kw + L.vw + 8;
    const groupMid = (k: number) => L.gy[k] + (groups[k].length * L.rh) / 2;
    const cellRow = (x: number, y: number, key: string, v: string, s: string) => (
      <g data-s={s}>
        <rect x={x} y={y} width={L.kw} height={L.rh} style={cellStyle(tone[key])} />
        <text class="f-small" x={x + L.kw / 2} y={y + L.rh / 2 + 4.5} text-anchor="middle">{key}</text>
        <rect x={x + L.kw} y={y} width={L.vw} height={L.rh} style={cellStyle(tone[key], 0.05)} />
        <text class={`f-small${v === 'NaN' ? ' f-t-muted' : ''}`} x={x + L.kw + L.vw / 2} y={y + L.rh / 2 + 4.5} text-anchor="middle">{v}</text>
      </g>
    );
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Разделение шести заказов по категориям, сумма в группах и итоговая Series' : 'Six orders split by category, summed per group, and combined into a Series'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Таблица из шести строк category и amount. Линии ведут к трём группам: books (12.5, NaN, 8.0), games (40.0, 25.0), music (15.0). Справа от групп их суммы 20.5, 65.0 и 15.0, которые объединяются в Series с индексом books, games, music.'
          : 'A table of six rows of category and amount. Lines lead to three groups: books (12.5, NaN, 8.0), games (40.0, 25.0), music (15.0). Next to the groups their sums 20.5, 65.0 and 15.0, which are combined into a Series indexed by books, games, music.'}</desc>
        {(wide ? t.heads : t.short).map((h, k) => (
          <text class="f-small f-t-muted" x={L.heads[k][0] + (k === 0 ? 0 : 14)} y={L.heads[k][1] + 4.5} style="font-weight: 650" data-s={k === 0 ? '1' : String(k)}>{h}</text>
        ))}
        {L.badges.map(([x, y], k) => <g data-s={String(k + 1)}><Badge x={x} y={y} n={k + 1} /></g>)}
        {rows.map(([key, v], i) => cellRow(L.tx, L.ty + i * L.rh, key, show(v), '1'))}
        {groups.map((g, k) => g.map(({ i, v }, r) => (
          <g>
            <path data-s="1" class={`f-thin`} style={`stroke: ${toneVar[tone[keys[k]]]}; stroke-opacity: 0.7`} d={`M ${L.tx + L.kw + L.vw + 3} ${L.ty + i * L.rh + L.rh / 2} L ${L.gx - 3} ${L.gy[k] + r * L.rh + L.rh / 2}`} />
            {cellRow(L.gx, L.gy[k] + r * L.rh, keys[k], show(v), '1')}
          </g>
        )))}
        {sums.map((s, k) => (
          <text class={wide ? 'f-label' : 'f-small'} x={ax} y={groupMid(k) + 5} data-s="2">{`= ${s.toFixed(1)}`}</text>
        ))}
        <text class="f-small f-t-muted" x={L.skipAt[0]} y={L.skipAt[1]} data-s="2">{t.skip}</text>
        {keys.map((k, j) => (
          <g data-s="3">
            <rect x={L.cx} y={L.cy + j * L.rh} width={L.kw} height={L.rh} style={cellStyle(tone[k], 0.2)} />
            <text class="f-small" x={L.cx + L.kw / 2} y={L.cy + j * L.rh + L.rh / 2 + 4.5} text-anchor="middle" style="font-family: var(--mono)">{k}</text>
            <rect x={L.cx + L.kw} y={L.cy + j * L.rh} width={L.vw} height={L.rh} style={cellStyle('y', 0.1)} />
            <text class="f-small" x={L.cx + L.kw + L.vw / 2} y={L.cy + j * L.rh + L.rh / 2 + 4.5} text-anchor="middle">{sums[j].toFixed(1)}</text>
            {wide && <path class="f-thin f-muted" d={`M ${ax + 52} ${groupMid(j)} L ${L.cx - 4} ${L.cy + j * L.rh + L.rh / 2}`} marker-end="url(#f-arrow-muted)" />}
          </g>
        ))}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
