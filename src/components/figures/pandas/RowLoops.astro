---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// price * qty for every row of a two-column DataFrame, total milliseconds, best of 3 runs (the vectorized form: best of 5 x 20).
// Measured once with timeit on CPython 3.14.7, pandas 3.0.6, NumPy 2.5.4, Apple M1, macOS, and embedded here.
const rows = [100, 1_000, 10_000, 100_000];
const series = [
  { label: 'df.iterrows()', tone: 'red', ms: [0.956, 9.637, 102.824, 1048.063] },
  { label: 'df.apply(f, axis=1)', tone: 'amber', ms: [0.426, 3.100, 30.446, 310.267] },
  { label: 'df.itertuples()', tone: 'muted', ms: [0.190, 0.418, 3.234, 33.916] },
  { label: 'zip(df.price, df.qty)', tone: 'blue', ms: [0.027, 0.124, 1.336, 12.618] },
  { label: 'df.price * df.qty', tone: 'green', ms: [0.027, 0.033, 0.034, 0.090] },
] as const;
// The numbers quoted in the note's table and text.
const at = (k: number, j: number) => series[k].ms[j];
if (Math.round(at(0, 3) / at(4, 3) / 1000) !== 12) throw new Error('iterrows against vectorized at 100 000 rows: about 12 000 times');
if (Math.round((at(0, 3) / rows[3]) * 1000) !== 10) throw new Error('iterrows about 10 us per row');
if (Math.round((at(3, 3) / rows[3]) * 1000 * 100) !== 13) throw new Error('zip about 0.13 us per row');
if (Math.round(at(0, 3) / at(2, 3)) < 25 || Math.round(at(2, 3) / at(3, 3)) < 2) throw new Error('ordering of the loops');

const t = ru ? { x: 'число строк', y: 'мс' } : { x: 'number of rows', y: 'ms' };
interface Layout { cls: string; W: number; H: number; x0: number; x1: number; y0: number; y1: number; legend: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 290, x0: 70, x1: 520, y0: 240, y1: 30, legend: false },
  { cls: 'fig-narrow', W: 360, H: 360, x0: 50, x1: 340, y0: 210, y1: 30, legend: true },
];
const yticks = [0.01, 0.1, 1, 10, 100, 1000];
const mono = 7.5;
const id = 'row-loops';
const plots = layouts.map((L) => {
  const sx = scale([2, 5], [L.x0, L.x1]);
  const sy = scale([-2, Math.log10(2000)], [L.y0, L.y1]);
  const ends = series.map((s) => sy(Math.log10(s.ms[3])));
  if (!L.legend) {
    for (const s of series) if (L.x1 + 10 + s.label.length * mono > L.W - 4) throw new Error(`label ${s.label} overflows`);
    for (let k = 0; k + 1 < ends.length; k += 1) if (ends[k + 1] - ends[k] < 15) throw new Error(`end labels ${k} and ${k + 1} collide`);
  } else {
    if (L.y0 + 48 + series.length * 18 > L.H - 4) throw new Error('legend does not fit');
    for (const s of series) if (L.x0 + 28 + s.label.length * mono > L.W - 4) throw new Error(`legend ${s.label} overflows`);
  }
  return { sx, sy, ends, paths: series.map((s) => polyline(s.ms.map((v, j) => [sx(Math.log10(rows[j])), sy(Math.log10(v))]))) };
});
const fmtRows = (n: number) => (ru ? n.toLocaleString('ru-RU') : n.toLocaleString('en-US'));
---

<Figure
  id={id}
  title={ru ? 'Циклы по строкам против операции над столбцами' : 'Row loops against a column operation'}
  caption={ru
    ? 'Произведение price × qty для каждой строки таблицы из двух столбцов пятью способами, полное время в миллисекундах, обе оси логарифмические. Измерено один раз (лучшее из трёх запусков timeit) на CPython 3.14.7, pandas 3.0.6 и NumPy 2.5.4, Apple M1. Время циклов растёт пропорционально числу строк; векторизованное выражение почти не зависит от него вплоть до 100 000 строк, где оно в 12 000 раз быстрее iterrows.'
    : 'The product price × qty for every row of a two-column table, five ways, total time in milliseconds, both axes logarithmic. Measured once (best of three timeit runs) on CPython 3.14.7, pandas 3.0.6 and NumPy 2.5.4, Apple M1. The loops grow in proportion to the number of rows; the vectorized expression barely changes up to 100 000 rows, where it is 12 000 times faster than iterrows.'}
>
  {layouts.map((L, li) => {
    const { sx, sy, ends, paths } = plots[li];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Время пяти способов в зависимости от числа строк' : 'Time of five methods against the number of rows'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Четыре линии растут параллельно, в порядке сверху вниз: iterrows, apply, itertuples, zip. Пятая, векторизованное умножение, почти горизонтальна около 0.03 мс.'
          : 'Four lines rise in parallel, from top to bottom: iterrows, apply, itertuples, zip. The fifth, the vectorized product, is almost flat near 0.03 ms.'}</desc>
        {yticks.map((v) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(Math.log10(v))} H ${L.x1}`} />
            <text class="f-small f-t-muted" x={L.x0 - 8} y={sy(Math.log10(v)) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        {rows.map((n, i) => <text class="f-small f-t-muted" x={sx(Math.log10(n))} y={L.y0 + 18} text-anchor={i === rows.length - 1 ? 'end' : 'middle'}>{fmtRows(n)}</text>)}
        <path class="f-axis" d={`M ${L.x0} ${L.y1 - 6} V ${L.y0} H ${L.x1 + 6}`} />
        {series.map((s, k) => (
          <g>
            <path class={`f-line f-${s.tone}`} d={paths[k]} />
            {s.ms.map((v, j) => <circle cx={sx(Math.log10(rows[j]))} cy={sy(Math.log10(v))} r="3.2" style={`fill: var(${s.tone === 'muted' ? '--muted' : `--fig-${s.tone}`})`} />)}
            {!L.legend && <text class={`f-small f-t-${s.tone}`} x={L.x1 + 10} y={ends[k] + 4} style="font-family: var(--mono)">{s.label}</text>}
            {L.legend && (
              <g>
                <path class={`f-line f-${s.tone}`} d={`M ${L.x0} ${L.y0 + 44 + k * 18} h 20`} />
                <text class={`f-small f-t-${s.tone}`} x={L.x0 + 28} y={L.y0 + 48 + k * 18} style="font-family: var(--mono)">{s.label}</text>
              </g>
            )}
          </g>
        ))}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.legend ? L.y0 + 34 : L.H - 6} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.x0 - 8} y={L.y1 - 12}>{t.y}</text>
      </svg>
    );
  })}
</Figure>
