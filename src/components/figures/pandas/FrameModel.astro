---
import Figure from '../Figure.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The DataFrame of the note: pd.DataFrame({"city": [...], "temp": [...], "rain": [...]}), pandas 3.0.6 without PyArrow.
// df.dtypes printed str, float64, int64; df.index printed RangeIndex(start=0, stop=3, step=1).
const index = ['0', '1', '2'];
const columns = [
  { name: 'city', dtype: 'str', values: ['Oslo', 'Lima', 'Pune'] },
  { name: 'temp', dtype: 'float64', values: ['4.0', '19.5', '31.0'] },
  { name: 'rain', dtype: 'int64', values: ['3', '0', '1'] },
];
if (columns.some((c) => c.values.length !== index.length)) throw new Error('every column has one value per index label');
const t = ru
  ? { index: 'индекс', cols: 'имена столбцов: тоже Index', kinds: ['объекты str', 'float по 8 байт', 'int по 8 байт'],
      range: 'RangeIndex', range2: 'хранит start, stop, step', series: 'df["temp"]: Series = этот массив + общий индекс' }
  : { index: 'index', cols: 'column names: also an Index', kinds: ['Python strings', '8-byte floats', '8-byte integers'],
      range: 'RangeIndex', range2: 'stores start, stop, step', series: 'df["temp"]: a Series = this array + the shared index' };

interface Layout { cls: string; W: number; H: number; ix: number; iw: number; cx: number[]; cw: number; hy: number; ry: number; rh: number;
  dy: [number, number]; rangeAt: [number, number, number, string]; seriesY: number; colsAt: [number, number] }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 290, ix: 60, iw: 60, cx: [190, 360, 530], cw: 130, hy: 52, ry: 92, rh: 30,
    dy: [204, 222], rangeAt: [90, 204, 222, 'middle'], seriesY: 268, colsAt: [190, 36] },
  { cls: 'fig-narrow', W: 360, H: 312, ix: 10, iw: 40, cx: [64, 162, 260], cw: 90, hy: 52, ry: 92, rh: 30,
    dy: [204, 222], rangeAt: [10, 246, 262, 'start'], seriesY: 294, colsAt: [64, 36] },
];
const sans = 6.5, mono = 7.5;
for (const L of layouts) {
  if (L.cx[2] + L.cw > L.W - 4) throw new Error(`columns overflow at ${L.W}`);
  for (let k = 0; k < 3; k += 1) {
    const mid = L.cx[k] + L.cw / 2, half = (t.kinds[k].length * sans) / 2;
    if (mid - half < (k === 0 ? 2 : L.cx[k - 1] + L.cw / 2 + (t.kinds[k - 1].length * sans) / 2 + 6)) throw new Error(`"${t.kinds[k]}" collides at ${L.W}`);
    if (mid + half > L.W - 2) throw new Error(`"${t.kinds[k]}" overflows at ${L.W}`);
    for (const v of columns[k].values) if (v.length * sans > L.cw - 8) throw new Error('value wider than its cell');
  }
  if (L.colsAt[0] + t.cols.length * sans > L.W - 4) throw new Error('column-name note overflows');
  if (12 + t.series.length * sans > L.W - 4) throw new Error(`series note overflows at ${L.W}`);
  // the RangeIndex note: centred under the index in the wide layout, on its own lines below the dtypes in the narrow one
  const [rx, ry1, ry2, anchor] = L.rangeAt;
  const w2 = t.range2.length * sans;
  if (anchor === 'middle' && (rx - w2 / 2 < 2 || rx + w2 / 2 > L.cx[0] - 6)) throw new Error('range note runs into the city column');
  if (anchor === 'start' && (ry1 <= L.dy[1] + 10 || rx + w2 > L.W - 4 || ry2 >= L.seriesY - 14)) throw new Error('range note placement');
}
const id = 'frame-model';
const lab = toneVar.g, dat = toneVar.h, ser = 'var(--fig-red)';
---

<Figure
  id={id}
  title={ru ? 'DataFrame: столбцы-массивы с общим индексом' : 'A DataFrame: columns of arrays sharing one index'}
  caption={ru
    ? 'Таблица из примера заметки. Каждый столбец — отдельный одномерный массив со своим dtype (синий): числа лежат подряд как в NumPy, а столбец str без PyArrow хранит ссылки на строки Python. Метки строк (индекс) и имена столбцов — объекты Index (янтарный). Индекс общий для всех столбцов; RangeIndex хранит лишь начало, конец и шаг. Столбец, взятый как df["temp"], — это Series: его массив вместе с тем же индексом (красная рамка).'
    : 'The table of the note\'s example. Each column is a separate one-dimensional array with its own dtype (blue): numbers lie in a row as in NumPy, and a str column without PyArrow holds references to Python strings. The row labels (the index) and the column names are Index objects (amber). One index is shared by all columns; a RangeIndex stores only its start, stop and step. A column taken as df["temp"] is a Series: its array together with the same index (red outline).'}
>
  {layouts.map((L) => {
    const bottom = L.ry + 3 * L.rh;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Индекс, имена столбцов и три столбца-массива' : 'The index, the column names and three column arrays'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Слева индекс 0, 1, 2. Сверху имена столбцов city, temp, rain. Под каждым именем — массив из трёх значений с подписью dtype: str, float64, int64. Столбец temp вместе с индексом обведён как Series.'
          : 'On the left the index 0, 1, 2. At the top the column names city, temp, rain. Under each name an array of three values labelled with its dtype: str, float64, int64. The temp column together with the index is outlined as a Series.'}</desc>
        <text class="f-small f-t-muted" x={L.colsAt[0]} y={L.colsAt[1]}>{t.cols}</text>
        <text class="f-small f-t-muted" x={L.ix + L.iw / 2} y={L.hy + 20} text-anchor="middle">{t.index}</text>
        {index.map((v, i) => (
          <g>
            <rect x={L.ix} y={L.ry + i * L.rh} width={L.iw} height={L.rh} style={`fill: ${lab}; fill-opacity: 0.16; stroke: ${lab}; stroke-width: 1.2`} />
            <text class="f-small" x={L.ix + L.iw / 2} y={L.ry + i * L.rh + L.rh / 2 + 4.5} text-anchor="middle">{v}</text>
          </g>
        ))}
        {columns.map((c, k) => (
          <g>
            <rect x={L.cx[k]} y={L.hy} width={L.cw} height={30} style={`fill: ${lab}; fill-opacity: 0.16; stroke: ${lab}; stroke-width: 1.2`} />
            <text class="f-small" x={L.cx[k] + L.cw / 2} y={L.hy + 19.5} text-anchor="middle" style="font-family: var(--mono)">{c.name}</text>
            {c.values.map((v, i) => (
              <g>
                <rect x={L.cx[k]} y={L.ry + i * L.rh} width={L.cw} height={L.rh} style={`fill: ${dat}; fill-opacity: 0.12; stroke: ${dat}; stroke-width: 1.2`} />
                <text class="f-small" x={L.cx[k] + L.cw / 2} y={L.ry + i * L.rh + L.rh / 2 + 4.5} text-anchor="middle">{v}</text>
              </g>
            ))}
            <text class="f-small f-t-blue" x={L.cx[k] + L.cw / 2} y={L.dy[0]} text-anchor="middle" style="font-family: var(--mono)">{c.dtype}</text>
            <text class="f-small f-t-muted" x={L.cx[k] + L.cw / 2} y={L.dy[1]} text-anchor="middle">{t.kinds[k]}</text>
          </g>
        ))}
        <path class="f-grid" d={`M ${L.ix + L.iw} ${L.ry} H ${L.cx[0]} M ${L.ix + L.iw} ${bottom} H ${L.cx[0]}`} style="stroke-dasharray: 3 4" />
        <text class="f-small f-t-amber" x={L.rangeAt[0]} y={L.rangeAt[1]} text-anchor={L.rangeAt[3]} style="font-family: var(--mono)">{t.range}</text>
        <text class="f-small f-t-muted" x={L.rangeAt[0]} y={L.rangeAt[2]} text-anchor={L.rangeAt[3]}>{t.range2}</text>
        <rect x={L.ix - 4} y={L.ry - 4} width={L.iw + 8} height={3 * L.rh + 8} rx="6" class="f-line f-red f-dash" />
        <rect x={L.cx[1] - 4} y={L.ry - 4} width={L.cw + 8} height={3 * L.rh + 8} rx="6" class="f-line f-red f-dash" />
        <text class="f-small" x={12} y={L.seriesY} style={`fill: ${ser}`}>{t.series}</text>
      </svg>
    );
  })}
</Figure>
