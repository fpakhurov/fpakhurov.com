---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

type Text = readonly [string, string];
type Trace = {
  title: Text;
  caption: Text;
  rows: readonly { label: Text; value: string; tone: 'blue' | 'green' | 'amber' }[];
};

const traces = {
  load: {
    title: ['The next load has two bounds', 'У следующей загрузки две границы'],
    caption: ['The previous cursor is excluded. Both updates in the interval are included, even when one shares the lower timestamp.', 'Предыдущий курсор исключён. Обе записи внутри интервала входят в загрузку, даже если у одной то же время, что у нижней границы.'],
    rows: [
      { label: ['Saved cursor', 'Сохранённый курсор'], value: '(10:00, 101)', tone: 'amber' },
      { label: ['Next row', 'Следующая строка'], value: '(10:00, 102)', tone: 'blue' },
      { label: ['Upper bound', 'Верхняя граница'], value: '(10:02, 103)', tone: 'green' },
    ],
  },
  cdc: {
    title: ['A snapshot and its matching log boundary', 'Снимок и согласованная с ним граница'],
    caption: ['The initial copy supplies the old value. Later log positions advance it. Positions are illustrative.', 'Начальная копия даёт старое значение. Поздние позиции журнала продвигают состояние. Позиции условные.'],
    rows: [
      { label: ['Snapshot at 20', 'Снимок в 20'], value: '101 → 700', tone: 'blue' },
      { label: ['Update at 21', 'Обновление в 21'], value: '101 → 900', tone: 'green' },
      { label: ['Delete at 22', 'Удаление в 22'], value: '101 → ∅', tone: 'amber' },
    ],
  },
  logs: {
    title: ['Progress is local to a partition', 'Позиция относится к одной партиции'],
    caption: ['The group has committed offset 6 as its next position in P0. Three contiguous records remain in the example.', 'Группа сохранила 6 как следующую позицию в P0. В примере остаются три записи без пропусков в номерах.'],
    rows: [
      { label: ['Next position in P0', 'Следующая позиция P0'], value: '6', tone: 'blue' },
      { label: ['Offsets to read', 'Смещения для чтения'], value: '6 · 7 · 8', tone: 'amber' },
      { label: ['End position in P0', 'Конечная позиция P0'], value: '9', tone: 'green' },
    ],
  },
  delivery: {
    title: ['One event, two processing attempts', 'Одно событие, две попытки обработки'],
    caption: ['The sink records the event identity with its effect. After a crash, replay finds the same identity and leaves the total unchanged.', 'Приёмник сохраняет идентификатор события вместе с эффектом. При повторе тот же идентификатор найден, и итог не меняется.'],
    rows: [
      { label: ['Before event e7', 'До события e7'], value: '2500', tone: 'blue' },
      { label: ['Commit e7', 'Фиксация e7'], value: '2500 + 700 = 3200', tone: 'green' },
      { label: ['Replay e7', 'Повтор e7'], value: '3200', tone: 'amber' },
    ],
  },
  batch: {
    title: ['Two releases of the same daily total', 'Два выпуска одного дневного итога'],
    caption: ['At 60 seconds the total accounts for two events. The third arrives later and is included at the next trigger.', 'На 60-й секунде итог учитывает два события. Третье приходит позже и учитывается на следующем запуске.'],
    rows: [
      { label: ['First release at 60 s', 'Первый выпуск в 60 с'], value: '100 + 50 = 150', tone: 'blue' },
      { label: ['Arrival at 110 s', 'Поступление в 110 с'], value: '+70', tone: 'amber' },
      { label: ['Release at 120 s', 'Выпуск в 120 с'], value: '220', tone: 'green' },
    ],
  },
  time: {
    title: ['One event can revise an earlier window', 'Событие может изменить прежнее окно'],
    caption: ['The early result is based on two events. The late event belongs to the same event-time interval and revises it.', 'Ранний результат учитывает два события. Опоздавшее событие относится к тому же интервалу времени события и меняет итог.'],
    rows: [
      { label: ['First release', 'Первый выпуск'], value: '150', tone: 'blue' },
      { label: ['Late event at 10:04', 'Опоздание из 10:04'], value: '+70', tone: 'amber' },
      { label: ['Revised result', 'Исправленный итог'], value: '220', tone: 'green' },
    ],
  },
  state: {
    title: ['Restore the total and the position together', 'Итог и позиция восстанавливаются вместе'],
    caption: ['Checkpoint C covers events through offset 41. Restoring it discards the lost in-memory effect of offset 42, so replay can apply 42 once to the restored state.', 'Контрольная точка C покрывает события до смещения 41 включительно. После восстановления эффект 42 из потерянной памяти отсутствует, и его можно один раз применить к восстановленному состоянию.'],
    rows: [
      { label: ['Checkpoint C', 'Контрольная точка C'], value: '150 · next 42', tone: 'blue' },
      { label: ['Replay offset 42', 'Повтор смещения 42'], value: '+70', tone: 'amber' },
      { label: ['New state', 'Новое состояние'], value: '220 · next 43', tone: 'green' },
    ],
  },
  recovery: {
    title: ['A restart can repeat an external write', 'Перезапуск может повторить внешнюю запись'],
    caption: ['The append survives. Restoring the earlier checkpoint reprocesses offset 42. A sink without a stable output identity appends the same revision again.', 'Добавленная строка сохраняется. Старая контрольная точка запускает повтор смещения 42. Без устойчивого идентификатора приёмник добавляет ту же версию ещё раз.'],
    rows: [
      { label: ['First append', 'Первая запись'], value: '220', tone: 'blue' },
      { label: ['Crash, restore C', 'Сбой, возврат к C'], value: 'next 42', tone: 'amber' },
      { label: ['Second append', 'Вторая запись'], value: '220 · 220', tone: 'green' },
    ],
  },
} satisfies Record<string, Trace>;

interface Props {
  example: keyof typeof traces;
}

const { example } = Astro.props;
const trace = traces[example];
const id = 'big-data-delivery-' + example;
const locale = pageLang(Astro.url) === 'ru' ? 1 : 0;
const translateValue = (value: string) => locale === 1 ? value.replace('next', 'далее') : value;
const title = trace.title[locale];
---
<Figure id={id} title={title} caption={trace.caption[locale]}>
  <svg class="fig-compact" viewBox="0 0 330 148" role="img" aria-labelledby={id + '-title ' + id + '-desc'}>
    <title id={id + '-title'}>{title}</title>
    <desc id={id + '-desc'}>{trace.rows.map(({ label, value }) => label[locale] + ' · ' + translateValue(value)).join('. ')}</desc>
    {trace.rows.map(({ label, value, tone }, i) => (
      <g transform={'translate(0 ' + i * 47 + ')'}>
        <rect x="7" y="8" width="316" height="38" rx="5" class={'f-fill-' + tone} />
        <text x="17" y="33">{label[locale]}</text>
        <text x="313" y="33" class="f-title" text-anchor="end">{translateValue(value)}</text>
      </g>
    ))}
  </svg>
</Figure>
