---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Op from '../seqflow/Op.astro';
import Badge from '../seqflow/Badge.astro';
import Arrow from '../seqflow/Arrow.astro';
import NewMark from '../seqflow/NewMark.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import Sub from '../generative-modeling/Sub.astro';
import { fmt } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The worked example of the note: c_{t-1} = 2, h_{t-1} = 1, x_t = 1, and toy weights (on x, on h, bias) for each block.
const sig = (z: number) => 1 / (1 + Math.exp(-z));
const blocks = [
  { key: 'f', w: [1.63, 2.7, 1.62], act: 'σ', fn: sig },
  { key: 'i', w: [1.65, 2.0, 0.62], act: 'σ', fn: sig },
  { key: 'c', w: [0.94, 1.41, -0.32], act: 'tanh', fn: Math.tanh },
  { key: 'o', w: [-0.19, 4.38, 0.59], act: 'σ', fn: sig },
].map((b) => { const pre = b.w[0] * 1 + b.w[1] * 1 + b.w[2]; return { ...b, pre, val: b.fn(pre) }; });
const [F, I, C, O] = blocks;
const cPrev = 2, keep = F.val * cPrev, write = I.val * C.val, cNew = keep + write, tc = Math.tanh(cNew), hNew = O.val * tc;
const check = [F.val, I.val, C.val, O.val, keep, write, cNew, hNew].map((v) => fmt(v)).join();
if (check !== '0.997,0.986,0.966,0.992,1.995,0.953,2.948,0.986' || tc.toFixed(4) !== '0.9945')
  throw new Error(`LstmFlow: the worked example drifted from the note (${check})`);
const t = ru
  ? { names: ['забывание f', 'вход i', 'кандидат c̃', 'выход o'], memory: 'новое по сравнению с RNN: линия памяти c', inputs: 'вход шага: hₜ₋₁ = 1, xₜ = 1',
      steps: ['гейт забывания f = 0.997', 'входной гейт i и кандидат c̃', 'сохранить: f · cₜ₋₁ = 1.995', 'записать: + i · c̃ → cₜ = 2.948', 'выходной гейт o = 0.992', 'прочитать: hₜ = o · tanh(cₜ) = 0.986'] }
  : { names: ['forget f', 'input i', 'candidate c̃', 'output o'], memory: 'new compared with the RNN: the memory line c', inputs: 'step input: hₜ₋₁ = 1, xₜ = 1',
      steps: ['forget gate f = 0.997', 'input gate i and candidate c̃', 'keep: f · cₜ₋₁ = 1.995', 'write: + i · c̃ gives cₜ = 2.948', 'output gate o = 0.992', 'read: hₜ = o · tanh(cₜ) = 0.986'] };
const num = (v: number) => (v < 0 ? `−${Math.abs(v).toFixed(2)}` : v.toFixed(2));
const id = 'lstm-flow';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 430, x0: 150, dx: 150, cw: 116, cPrevX: 20, legend: [8, 420], legendStep: 130, rows: 1 },
  { cls: 'fig-narrow seq-narrow', W: 396, H: 460, x0: 66, dx: 90, cw: 80, cPrevX: 2, legend: [8, 428], legendStep: 180, rows: 2 },
];
const laneY = 82, midY = 162, cardTop = 196, cardBot = 330, busY = 362;
---

<Figure
  id={id}
  title={ru ? 'Шаг LSTM: что куда идёт' : 'One LSTM step: what goes where'}
  caption={ru
    ? `Числа разобранного примера. Каждый из четырёх блоков берёт один и тот же вход шага (hₜ₋₁ = 1, xₜ = 1), умножает его на свои веса, прибавляет смещение и пропускает сумму через σ или tanh. Гейт забывания (1) решает, какая доля старой памяти cₜ₋₁ = 2 сохранится (3); входной гейт и кандидат (2) решают, что записать (4): cₜ = 1.995 + 0.953 = 2.948. Выходной гейт (5) решает, какую долю tanh(cₜ) выдать наружу как hₜ (6). Кандидат c̃ — это та же формула, что у обычной RNN; новое по сравнению с ней — линия памяти сверху, по которой состояние только умножается на гейт и складывается.`
    : `The numbers of the worked example. Each of the four blocks takes the same step input (hₜ₋₁ = 1, xₜ = 1), multiplies it by its own weights, adds a bias and passes the sum through σ or tanh. The forget gate (1) decides how much of the old memory cₜ₋₁ = 2 survives (3); the input gate and the candidate (2) decide what to write (4): cₜ = 1.995 + 0.953 = 2.948. The output gate (5) decides how much of tanh(cₜ) to expose as hₜ (6). The candidate c̃ is the plain RNN update; what is new compared with the RNN is the memory line at the top, along which the state is only multiplied by a gate and added to.`}
>
  {layouts.map((L) => {
    const gx = [0, 1, 2, 3].map((k) => L.x0 + k * L.dx);
    const plusX = (gx[1] + gx[2]) / 2, cX = gx[2] + L.dx / 2, oX = gx[3];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Шаг LSTM с числами' : 'An LSTM step with numbers'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? `Сверху линия памяти: cₜ₋₁ = 2 умножается на гейт забывания ${fmt(F.val)}, к результату ${fmt(keep)} прибавляется ${fmt(write)}, получается cₜ = ${fmt(cNew)}. Снизу четыре блока: забывание ${fmt(F.val)}, вход ${fmt(I.val)}, кандидат ${fmt(C.val)}, выход ${fmt(O.val)}. Справа hₜ = ${fmt(O.val)} · tanh(${fmt(cNew)}) = ${fmt(hNew)}.`
          : `Top, the memory line: cₜ₋₁ = 2 is multiplied by the forget gate ${fmt(F.val)}, and ${fmt(write)} is added to the result ${fmt(keep)}, giving cₜ = ${fmt(cNew)}. Bottom, four blocks: forget ${fmt(F.val)}, input ${fmt(I.val)}, candidate ${fmt(C.val)}, output ${fmt(O.val)}. Right, hₜ = ${fmt(O.val)} · tanh(${fmt(cNew)}) = ${fmt(hNew)}.`}</desc>
        <NewMark x={L.cPrevX - 2} y={laneY - 46} w={L.W - L.cPrevX - 2} h={64} label={t.memory} />
        <g data-s="3">
          <Vec x={L.cPrevX} y={laneY - 11} values={[String(cPrev)]} tone="h" cw={40} bold label="c_{t−1}" labelPos="above" />
          <Arrow pts={[[L.cPrevX + 40, laneY], [gx[0] - 15, laneY]]} tone="blue" bold />
          <Op x={gx[0]} y={laneY} sym="×" />
          <text class="f-small" x={(gx[0] + plusX) / 2} y={laneY - 8} text-anchor="middle">{fmt(keep)}</text>
          <Arrow pts={[[gx[0] + 13, laneY], [plusX - 15, laneY]]} tone="blue" bold />
          <Badge x={gx[0] - 22} y={laneY + 22} n={3} />
        </g>
        <g data-s="4">
          <Op x={plusX} y={laneY} sym="+" />
          <Op x={plusX} y={midY} sym="×" />
          <Arrow pts={[[plusX, midY - 13], [plusX, laneY + 15]]} />
          <text class="f-small" x={plusX + 8} y={(laneY + midY) / 2 + 4}>{fmt(write)}</text>
          <Arrow pts={[[plusX + 13, laneY], [cX - 24, laneY]]} tone="blue" bold />
          <Vec x={cX - 24} y={laneY - 11} values={[fmt(cNew)]} tone="h" cw={48} bold label="c_t" labelPos="above" />
          <Arrow pts={[[cX + 24, laneY], [L.W - 6, laneY]]} tone="blue" bold />
          <Badge x={plusX + 22} y={laneY - 20} n={4} />
        </g>
        <g data-s="6">
          <Arrow pts={[[cX, laneY + 11], [cX, midY - 15]]} />
          <Op x={cX} y={midY} sym="tanh" />
          <Arrow pts={[[cX + 23, midY], [oX - 15, midY]]} />
          <Op x={oX} y={midY} sym="×" />
          <Arrow pts={[[oX, midY - 13], [oX, midY - 34]]} tone="blue" />
          <Vec x={oX - 22} y={midY - 58} values={[fmt(hNew)]} tone="h" cw={44} label="h_t" labelPos="left" />
          <Arrow pts={[[oX + 22, midY - 47], [L.W - 6, midY - 47]]} tone="blue" />
          <Badge x={oX + 20} y={midY + 22} n={6} />
        </g>
        {blocks.map((b, k) => {
          const x = gx[k], step = k === 0 ? 1 : k === 3 ? 5 : 2;
          const target = k === 0 ? [[x, cardTop], [x, laneY + 15]] : k === 1 ? [[x, cardTop], [x, midY], [plusX - 15, midY]] : k === 2 ? [[x, cardTop], [x, midY], [plusX + 15, midY]] : [[x, cardTop], [x, midY + 15]];
          return (
            <g data-s={String(step)}>
              <rect x={x - L.cw / 2} y={cardTop} width={L.cw} height={cardBot - cardTop} rx="8" class="f-box-soft" />
              <Arrow pts={target as [number, number][]} tone={b.key === 'c' ? 'blue' : 'amber'} />
              <Vec x={x - 24} y={cardTop + 10} values={[fmt(b.val)]} tone={b.key === 'c' ? 'h' : 'g'} cw={48} />
              <text class="f-small" x={x} y={cardTop + 56} text-anchor="middle">{`${b.act}(${b.pre.toFixed(2)})`}</text>
              <text class="f-small f-t-amber" x={x} y={cardTop + 78} text-anchor="middle">{`${num(b.w[0])} · x`}</text>
              <text class="f-small f-t-amber" x={x} y={cardTop + 94} text-anchor="middle">{`${num(b.w[1])} · h`}</text>
              <text class="f-small f-t-amber" x={x} y={cardTop + 110} text-anchor="middle">{`${b.w[2] < 0 ? '−' : '+'} ${Math.abs(b.w[2]).toFixed(2)}`}</text>
              <text class="f-small f-t-muted" x={x} y={cardBot - 6} text-anchor="middle">{t.names[k]}</text>
              <Arrow pts={[[x, busY], [x, cardBot + 2]]} />
              <Badge x={x - L.cw / 2 + 2} y={cardTop + 4} n={step} />
            </g>
          );
        })}
        <g data-s="1 2 5">
          <path class="f-line f-muted" d={`M ${L.cPrevX + 4} ${busY} H ${gx[3]}`} />
          <text class="f-small f-t-muted" x={L.cPrevX + 4} y={busY + 20}>{t.inputs}</text>
        </g>
        <Legend x={L.legend[0]} y={L.legend[1]} step={L.legendStep} rows={L.rows} />
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
