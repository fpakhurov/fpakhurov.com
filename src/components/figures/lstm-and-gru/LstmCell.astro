---
import Figure from '../Figure.astro';

// One LSTM step. The memory line c runs along the top; the three gates and the
// candidate are computed from (h_{t-1}, x_t) and act on it per coordinate.
// The numbers are the worked example of the note: c_{t-1} = 2, h_{t-1} = 1, x_t = 1.
const num = { f: '0.997', i: '0.986', c: '0.966', o: '0.992', cPrev: '2', cNew: '2.95', add: '0.95', h: '0.99' };
const boxW = 84;
const boxH = 38;
const r = 13; // radius of the × and + nodes

interface Node { x: number; y: number; sign: '×' | '+'; cls: string }
interface Gate { cx: number; top: number; label: string; cls: string; value: string; vx: number; vy: number; anchor?: string }
interface Region { x: number; y: number; w: number; h: number; label: string }

// Wide layout: everything in one row.
const wide = {
  regions: [
    { x: 150, y: 40, w: 100, h: 200, label: 'forget gate' },
    { x: 310, y: 40, w: 195, h: 200, label: 'input gate' },
    { x: 515, y: 40, w: 170, h: 200, label: 'output gate' },
  ] as Region[],
  nodes: [
    { x: 200, y: 70, sign: '×', cls: 'f-fill-green' },
    { x: 407, y: 70, sign: '+', cls: 'f-fill-green' },
    { x: 407, y: 128, sign: '×', cls: 'f-fill-blue' },
    { x: 630, y: 126, sign: '×', cls: 'f-fill-amber' },
  ] as Node[],
  gates: [
    { cx: 200, top: 180, label: 'f = σ(·)', cls: 'f-fill-amber', value: num.f, vx: 208, vy: 138 },
    { cx: 360, top: 180, label: 'i = σ(·)', cls: 'f-fill-amber', value: num.i, vx: 352, vy: 162, anchor: 'end' },
    { cx: 454, top: 180, label: 'c̃ = tanh(·)', cls: 'f-fill-blue', value: num.c, vx: 462, vy: 162 },
    { cx: 630, top: 180, label: 'o = σ(·)', cls: 'f-fill-amber', value: num.o, vx: 638, vy: 162 },
  ] as Gate[],
};

// Narrow layout: memory line (forget + input) above, output gate below.
const narrow = {
  regions: [
    { x: 52, y: 36, w: 78, h: 160, label: 'forget gate' },
    { x: 150, y: 36, w: 180, h: 160, label: 'input gate' },
    { x: 100, y: 300, w: 185, h: 160, label: 'output gate' },
  ] as Region[],
  nodes: [
    { x: 90, y: 64, sign: '×', cls: 'f-fill-green' },
    { x: 235, y: 64, sign: '+', cls: 'f-fill-green' },
    { x: 235, y: 112, sign: '×', cls: 'f-fill-blue' },
    { x: 235, y: 334, sign: '×', cls: 'f-fill-amber' },
  ] as Node[],
  gates: [
    { cx: 90, top: 150, label: 'f = σ(·)', cls: 'f-fill-amber', value: num.f, vx: 98, vy: 122 },
    { cx: 200, top: 150, label: 'i = σ(·)', cls: 'f-fill-amber', value: num.i, vx: 192, vy: 138, anchor: 'end' },
    { cx: 282, top: 150, label: 'c̃ = tanh(·)', cls: 'f-fill-blue', value: num.c, vx: 292, vy: 138 },
    { cx: 235, top: 400, label: 'o = σ(·)', cls: 'f-fill-amber', value: num.o, vx: 243, vy: 378 },
  ] as Gate[],
};
---

<Figure
  id="lstm-cell"
  title="One LSTM step: three gates around a memory line"
  caption="The memory c runs along the top and is touched only by a multiplication and an addition. The forget gate f (a sigmoid, here 0.997) scales the old memory; the input gate i (0.986) scales the candidate value c̃ (a tanh, 0.966) that is added; the output gate o (0.992) scales tanh of the new memory to produce the working state h. All four are computed from the same pair (h_{t−1}, x_t) with their own weights, and every operation is per coordinate. With the numbers of the worked example the memory goes from 2 to 2.95 and the exposed state is 0.99."
>
  <svg class="fig-wide" viewBox="0 0 720 320" role="img" aria-labelledby="lstm-cell-720-t lstm-cell-720-d">
    <title id="lstm-cell-720-t">LSTM cell with forget, input and output gates</title>
    <desc id="lstm-cell-720-d">A horizontal memory line from c at time t minus one on the left to c at time t on the right passes through a multiplication node and an addition node. Below, four boxes compute the forget gate, the input gate, the candidate and the output gate from the previous state and the input. The forget gate feeds the multiplication, the input gate times the candidate feeds the addition, and the output gate multiplies the tanh of the new memory to give h at time t. Dashed regions group the three gates.</desc>
    {wide.regions.map((R) => (
      <g>
        <rect class="f-thin f-dash f-muted" x={R.x} y={R.y} width={R.w} height={R.h} rx="10" fill="none" />
        <text class="f-small f-t-muted" x={R.x + R.w / 2} y={R.y - 8} text-anchor="middle">{R.label}</text>
      </g>
    ))}
    <path class="f-line f-green f-bold" d="M 24 70 H 184" />
    <path class="f-line f-green f-bold" d="M 213 70 H 394" />
    <path class="f-line f-green f-bold" d="M 420 70 H 693" marker-end="url(#f-arrow-green)" />
    <text class="f-math" x="24" y="56">c<tspan dy="5" font-size="12">t−1</tspan></text>
    <text class="f-math" x="696" y="56" text-anchor="end">c<tspan dy="5" font-size="12">t</tspan></text>
    <text class="f-small f-t-muted" x="100" y="92" text-anchor="middle">{num.cPrev}</text>
    <text class="f-small f-t-muted" x="470" y="92" text-anchor="middle">{num.cNew}</text>
    {wide.gates.map((G) => (
      <g>
        <rect class={`f-box ${G.cls}`} x={G.cx - boxW / 2} y={G.top} width={boxW} height={boxH} rx="6" />
        <text class="f-small" x={G.cx} y={G.top + boxH / 2 + 4} text-anchor="middle">{G.label}</text>
        <text class="f-small f-t-muted" x={G.vx} y={G.vy} text-anchor={G.anchor ?? 'start'}>{G.value}</text>
      </g>
    ))}
    <path class="f-line" d={`M 200 180 V ${70 + r + 3}`} marker-end="url(#f-arrow)" />
    <path class="f-line" d={`M 360 180 L ${407 - 9} ${128 + 10}`} marker-end="url(#f-arrow)" />
    <path class="f-line" d={`M 454 180 L ${407 + 9} ${128 + 10}`} marker-end="url(#f-arrow)" />
    <path class="f-line" d={`M 407 ${128 - r} V ${70 + r + 3}`} marker-end="url(#f-arrow)" />
    <text class="f-small f-t-muted" x="416" y="104">+ {num.add}</text>
    <path class="f-line f-green" d="M 555 70 V 108" marker-end="url(#f-arrow-green)" />
    <rect class="f-box f-fill-blue" x="525" y="111" width="60" height="30" rx="6" />
    <text class="f-small" x="555" y="131" text-anchor="middle">tanh</text>
    <path class="f-line" d={`M 585 126 H ${630 - r - 3}`} marker-end="url(#f-arrow)" />
    <path class="f-line" d={`M 630 180 V ${126 + r + 3}`} marker-end="url(#f-arrow)" />
    <path class="f-line f-blue" d={`M ${630 + r} 126 H 690`} marker-end="url(#f-arrow-blue)" />
    <text class="f-math f-t-blue" x="696" y="112" text-anchor="end">h<tspan dy="5" font-size="12">t</tspan></text>
    <text class="f-small f-t-muted" x="690" y="146" text-anchor="end">{num.h}</text>
    {wide.nodes.map((Nn) => (
      <g>
        <circle class={`f-box ${Nn.cls}`} cx={Nn.x} cy={Nn.y} r={r} />
        <text class="f-label" x={Nn.x} y={Nn.y + 5} text-anchor="middle">{Nn.sign}</text>
      </g>
    ))}
    <path class="f-line" d="M 24 262 H 660" />
    {wide.gates.map((G) => <path class="f-line" d={`M ${G.cx} 262 V ${G.top + boxH + 3}`} marker-end="url(#f-arrow)" />)}
    <text class="f-math" x="24" y="292">h<tspan dy="5" font-size="12">t−1</tspan><tspan dy="-5">, x</tspan><tspan dy="5" font-size="12">t</tspan></text>
    <text class="f-note" x="130" y="292">each box has its own W, U, b</text>
  </svg>

  <svg class="fig-narrow" viewBox="0 0 360 500" role="img" aria-labelledby="lstm-cell-360-t lstm-cell-360-d">
    <title id="lstm-cell-360-t">LSTM cell with forget, input and output gates</title>
    <desc id="lstm-cell-360-d">Two panels. The upper panel shows the memory line with the forget gate multiplying the old memory and the input gate times the candidate being added. The lower panel shows the output gate multiplying the tanh of the new memory to give the new state h.</desc>
    {narrow.regions.map((R) => (
      <g>
        <rect class="f-thin f-dash f-muted" x={R.x} y={R.y} width={R.w} height={R.h} rx="10" fill="none" />
        <text class="f-small f-t-muted" x={R.x + R.w / 2} y={R.y - 8} text-anchor="middle">{R.label}</text>
      </g>
    ))}
    <path class="f-line f-green f-bold" d="M 12 64 H 76" />
    <path class="f-line f-green f-bold" d="M 104 64 H 222" />
    <path class="f-line f-green f-bold" d="M 248 64 H 345" marker-end="url(#f-arrow-green)" />
    <text class="f-math" x="12" y="50">c<tspan dy="5" font-size="12">t−1</tspan></text>
    <text class="f-math" x="348" y="50" text-anchor="end">c<tspan dy="5" font-size="12">t</tspan></text>
    <text class="f-small f-t-muted" x="40" y="84" text-anchor="middle">{num.cPrev}</text>
    <text class="f-small f-t-muted" x="300" y="84" text-anchor="middle">{num.cNew}</text>
    {narrow.gates.map((G) => (
      <g>
        <rect class={`f-box ${G.cls}`} x={G.cx - boxW / 2} y={G.top} width={boxW} height={boxH} rx="6" />
        <text class="f-small" x={G.cx} y={G.top + boxH / 2 + 4} text-anchor="middle">{G.label}</text>
        <text class="f-small f-t-muted" x={G.vx} y={G.vy} text-anchor={G.anchor ?? 'start'}>{G.value}</text>
      </g>
    ))}
    <path class="f-line" d={`M 90 150 V ${64 + r + 3}`} marker-end="url(#f-arrow)" />
    <path class="f-line" d={`M 200 150 L ${235 - 9} ${112 + 10}`} marker-end="url(#f-arrow)" />
    <path class="f-line" d={`M 282 150 L ${235 + 9} ${112 + 10}`} marker-end="url(#f-arrow)" />
    <path class="f-line" d={`M 235 ${112 - r} V ${64 + r + 3}`} marker-end="url(#f-arrow)" />
    <path class="f-line" d="M 12 222 H 330" />
    {narrow.gates.slice(0, 3).map((G) => <path class="f-line" d={`M ${G.cx} 222 V ${G.top + boxH + 3}`} marker-end="url(#f-arrow)" />)}
    <text class="f-math" x="12" y="250">h<tspan dy="5" font-size="12">t−1</tspan><tspan dy="-5">, x</tspan><tspan dy="5" font-size="12">t</tspan></text>
    <text class="f-math" x="12" y="318">c<tspan dy="5" font-size="12">t</tspan></text>
    <path class="f-line f-green" d="M 12 334 H 118" marker-end="url(#f-arrow-green)" />
    <rect class="f-box f-fill-blue" x="121" y="319" width="60" height="30" rx="6" />
    <text class="f-small" x="151" y="339" text-anchor="middle">tanh</text>
    <path class="f-line" d={`M 181 334 H ${235 - r - 3}`} marker-end="url(#f-arrow)" />
    <path class="f-line f-blue" d={`M ${235 + r} 334 H 300`} marker-end="url(#f-arrow-blue)" />
    <text class="f-math f-t-blue" x="306" y="339">h<tspan dy="5" font-size="12">t</tspan></text>
    <text class="f-small f-t-muted" x="306" y="358">{num.h}</text>
    <path class="f-line" d={`M 235 400 V ${334 + r + 3}`} marker-end="url(#f-arrow)" />
    <path class="f-line" d="M 12 470 H 330" />
    <path class="f-line" d={`M 235 470 V ${400 + boxH + 3}`} marker-end="url(#f-arrow)" />
    <text class="f-math" x="12" y="496">h<tspan dy="5" font-size="12">t−1</tspan><tspan dy="-5">, x</tspan><tspan dy="5" font-size="12">t</tspan></text>
    {narrow.nodes.map((Nn) => (
      <g>
        <circle class={`f-box ${Nn.cls}`} cx={Nn.x} cy={Nn.y} r={r} />
        <text class="f-label" x={Nn.x} y={Nn.y + 5} text-anchor="middle">{Nn.sign}</text>
      </g>
    ))}
  </svg>
</Figure>
