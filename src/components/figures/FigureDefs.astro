---
/**
 * Shared SVG markers for every figure on a note page. Rendered once by NoteLayout.
 * Use them as marker-end="url(#f-arrow)" (or -blue, -red, -green, -amber, -muted).
 */
const markers = ['', '-blue', '-red', '-green', '-amber', '-muted'];
---

<svg class="fig-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    {markers.map((suffix) => (
      <marker id={`f-arrow${suffix}`} viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
        <path class={`f-head${suffix}`} d="M 0 0.8 L 9.5 5 L 0 9.2 L 2.6 5 Z" />
      </marker>
    ))}
  </defs>
</svg>
