---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Test BLEU on Multi30k for the four models of the note, each one change away from the previous.
const rows = [
  { label: ru ? 'LSTM энкодер–декодер' : 'LSTM encoder–decoder', bleu: 0.152, tone: 'muted', why: '' },
  { label: ru ? 'трансформер, один вектор источника' : 'Transformer, one source vector', bleu: 0.19, tone: 'amber', why: ru ? 'остальная архитектура' : 'rest of the architecture' },
  { label: ru ? 'трансформер 1 + 1, все позиции' : 'Transformer 1 + 1, all positions', bleu: 0.32, tone: 'blue', why: ru ? 'cross-attention ко всем позициям' : 'cross-attention to all positions' },
  { label: ru ? 'трансформер 4 + 4' : 'Transformer 4 + 4', bleu: 0.342, tone: 'green', why: ru ? 'глубина' : 'depth' },
];
const f = (x: number) => x.toFixed(3);
const id = 'mt-bleu-steps';
interface Layout { cls: string; W: number; H: number; x0: number; unit: number; rowH: number; top: number; stacked: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 720, H: 210, x0: 296, unit: 580, rowH: 44, top: 22, stacked: false },
  { cls: 'fig-narrow', W: 360, H: 332, x0: 8, unit: 560, rowH: 80, top: 14, stacked: true },
];
---

<Figure
  id={id}
  title={ru ? 'Откуда берётся прирост BLEU' : 'Where the BLEU gain comes from'}
  caption={ru
    ? 'BLEU на тесте Multi30k для четырёх моделей заметки при одних и тех же данных, токенизаторах и 10 эпохах; каждая следующая отличается от предыдущей одним изменением, и прирост подписан тем, что изменилось. Трансформер, декодер которого видит только первый вектор энкодера, лишь немного лучше LSTM (+0.038); доступ ко всем позициям источника даёт +0.130, бо́льшую часть разрыва; четыре блока вместо одного добавляют ещё +0.022.'
    : 'Test BLEU on Multi30k for the four models of the note, with the same data, tokenizers and 10 epochs; each model differs from the one above it by one change, and the gain is labelled with what changed. A Transformer whose decoder sees only the first encoder vector is only slightly better than the LSTM (+0.038); access to all source positions adds +0.130, most of the gap; four blocks instead of one add another +0.022.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'BLEU четырёх моделей перевода' : 'BLEU of four translation models'}</title>
      <desc id={`${id}-${L.W}-d`}>{rows.map((r) => `${r.label}: ${f(r.bleu)}`).join('; ')}.</desc>
      {rows.map((r, i) => {
        const y = L.top + i * L.rowH;
        const by = L.stacked ? y + 26 : y;
        const w = r.bleu * L.unit;
        const prev = i ? rows[i - 1].bleu : 0;
        return (
          <g>
            <text class="f-label" x={L.stacked ? L.x0 : L.x0 - 12} y={L.stacked ? y + 14 : y + 19} text-anchor={L.stacked ? 'start' : 'end'}>{r.label}</text>
            {i > 0 && <rect x={L.x0} y={by} width={prev * L.unit} height="26" class="f-solid-muted" style="fill-opacity: .14" />}
            <rect x={L.x0 + (i ? prev * L.unit : 0)} y={by} width={w - (i ? prev * L.unit : 0)} height="26" style={`fill: var(--${r.tone === 'muted' ? 'muted' : `fig-${r.tone}`}); fill-opacity: .55`} />
            <text class="f-small" x={L.x0 + w + 6} y={by + 18}>{f(r.bleu)}{i > 0 && <tspan class={`f-t-${r.tone}`}> (+{f(r.bleu - prev)})</tspan>}</text>
            {i > 0 && !L.stacked && <text class={`f-small f-t-${r.tone}`} x={L.x0 + w + 6} y={by + 34}>{r.why}</text>}
            {i > 0 && L.stacked && <text class={`f-small f-t-${r.tone}`} x={L.x0} y={by + 42}>{r.why}</text>}
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
