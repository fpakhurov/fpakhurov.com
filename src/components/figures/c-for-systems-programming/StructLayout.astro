---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The layout rule of C structures on LP64 machines (and on RV32 and RV64, for these types): each member starts at
// the next multiple of its alignment, the structure's alignment is the largest member alignment, and the size is
// rounded up to a multiple of it. The offsets are computed here and checked against offsetof on an Apple M1.
interface Field { name: string; type: 'char' | 'short' | 'int' | 'double' }
const size = { char: 1, short: 2, int: 4, double: 8 } as const;
function layout(fields: Field[]) {
  let off = 0, align = 1;
  const placed = fields.map((f) => {
    const a = size[f.type];
    off = Math.ceil(off / a) * a;
    const p = { ...f, off, len: a };
    off += a;
    align = Math.max(align, a);
    return p;
  });
  return { placed, size: Math.ceil(off / align) * align, payload: fields.reduce((s, f) => s + size[f.type], 0) };
}
const rec = layout([{ name: 'tag', type: 'char' }, { name: 'count', type: 'int' }, { name: 'flag', type: 'char' }, { name: 'value', type: 'double' }, { name: 'id', type: 'short' }]);
const sorted = layout([{ name: 'value', type: 'double' }, { name: 'count', type: 'int' }, { name: 'id', type: 'short' }, { name: 'tag', type: 'char' }, { name: 'flag', type: 'char' }]);
// offsetof and sizeof printed by the Code section of the note (clang, arm64 macOS).
if (rec.placed.map((f) => f.off).join() !== '0,4,8,16,24' || rec.size !== 32) throw new Error('struct rec layout');
if (sorted.placed.map((f) => f.off).join() !== '0,8,12,14,15' || sorted.size !== 16) throw new Error('sorted layout');
if (rec.payload !== 16 || sorted.payload !== 16) throw new Error('payload');

const tone = { char: 'var(--fig-green)', short: 'var(--fig-red)', int: 'var(--fig-blue)', double: 'var(--fig-amber)' };
const t = ru
  ? { rec: `struct rec: ${rec.size} байта, из них ${rec.size - rec.payload} — заполнение`, sorted: `поля по убыванию выравнивания: ${sorted.size} байт`, pad: 'заполнение' }
  : { rec: `struct rec: ${rec.size} bytes, ${rec.size - rec.payload} of them padding`, sorted: `fields sorted by alignment: ${sorted.size} bytes`, pad: 'padding' };

// Cells of one row: fields and padding runs, never crossing a row of 8 bytes (true for these layouts).
interface Run { start: number; len: number; field?: { name: string; type: Field['type'] } }
function runs(l: ReturnType<typeof layout>): Run[] {
  const out: Run[] = [];
  let pos = 0;
  for (const f of l.placed) {
    if (f.off > pos) out.push({ start: pos, len: f.off - pos });
    out.push({ start: f.off, len: f.len, field: { name: f.name, type: f.type } });
    pos = f.off + f.len;
  }
  if (l.size > pos) out.push({ start: pos, len: l.size - pos });
  // split runs at row boundaries
  const split: Run[] = [];
  for (const r of out) {
    let s = r.start, left = r.len;
    while (left > 0) {
      const room = 8 - (s % 8), n = Math.min(room, left);
      if (r.field && n !== left) throw new Error('a field crosses a row');
      split.push({ ...r, start: s, len: n });
      s += n; left -= n;
    }
  }
  return split;
}
interface Dump { runs: Run[]; rows: number; x: number; y: number; title: string; tx: number }
interface Layout { cls: string; W: number; H: number; cw: number; rh: number; dumps: Dump[] }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 214, cw: 38, rh: 40, dumps: [
    { runs: runs(rec), rows: rec.size / 8, x: 40, y: 34, title: t.rec, tx: 40 },
    { runs: runs(sorted), rows: sorted.size / 8, x: 432, y: 34, title: t.sorted, tx: 432 },
  ] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 352, cw: 38, rh: 40, dumps: [
    { runs: runs(rec), rows: rec.size / 8, x: 44, y: 30, title: t.rec, tx: 8 },
    { runs: runs(sorted), rows: sorted.size / 8, x: 44, y: 242, title: t.sorted, tx: 8 },
  ] },
];
const id = 'struct-layout';
---

<Figure
  id={id}
  title={ru ? 'Структура в памяти: поля и заполнение' : 'A structure in memory: fields and padding'}
  caption={ru
    ? `Байты двух структур с одинаковыми полями, по 8 байт в строке; число слева — смещение первого байта строки. Каждое поле начинается со смещения, кратного его выравниванию (char 1, short 2, int 4, double 8), а размер структуры округляется до кратного наибольшему выравниванию, 8. В порядке объявления tag, count, flag, value, id компилятор вставляет ${rec.size - rec.payload} байт заполнения (серые), и структура занимает ${rec.size} байта при ${rec.payload} байтах данных. Те же поля по убыванию выравнивания помещаются в ${sorted.size} байт без пропусков. Смещения совпадают с тем, что печатает offsetof на arm64 и x86-64 (модель LP64).`
    : `The bytes of two structures with the same fields, 8 bytes per row; the number on the left is the offset of the row's first byte. Each field starts at an offset that is a multiple of its alignment (char 1, short 2, int 4, double 8), and the size of the structure is rounded up to a multiple of the largest alignment, 8. In the declared order tag, count, flag, value, id, the compiler inserts ${rec.size - rec.payload} bytes of padding (grey), and the structure takes ${rec.size} bytes for ${rec.payload} bytes of data. The same fields sorted by decreasing alignment fit in ${sorted.size} bytes with no gaps. The offsets are those printed by offsetof on arm64 and x86-64 (the LP64 model).`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Байты структуры: поля и заполнение' : 'The bytes of a structure with fields and padding'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? `Первая структура занимает четыре строки по 8 байт: tag в байте 0, заполнение в байтах 1–3, count в байтах 4–7, flag в байте 8, заполнение в байтах 9–15, value в байтах 16–23, id в байтах 24–25, заполнение в байтах 26–31. Вторая занимает две строки: value 0–7, count 8–11, id 12–13, tag 14, flag 15.`
        : `The first structure takes four rows of 8 bytes: tag at byte 0, padding at 1–3, count at 4–7, flag at 8, padding at 9–15, value at 16–23, id at 24–25, padding at 26–31. The second takes two rows: value at 0–7, count at 8–11, id at 12–13, tag at 14, flag at 15.`}</desc>
      {L.dumps.map((d) => (
        <g>
          <text class="f-small" x={d.tx} y={d.y - 10} style="font-weight: 600">{d.title}</text>
          {Array.from({ length: d.rows }, (_, r) => (
            <text class="f-small f-t-muted" x={d.x - 6} y={d.y + r * L.rh + L.rh / 2 + 4.5} text-anchor="end">{r * 8}</text>
          ))}
          {d.runs.map((r) => {
            const x = d.x + (r.start % 8) * L.cw, y = d.y + Math.floor(r.start / 8) * L.rh, w = r.len * L.cw;
            return r.field ? (
              <g>
                <rect x={x + 1} y={y + 1} width={w - 2} height={L.rh - 2} rx="4" style={`fill: ${tone[r.field.type]}; fill-opacity: 0.16; stroke: ${tone[r.field.type]}; stroke-width: 1.3`} />
                <text class="f-small" x={x + w / 2} y={y + 17} text-anchor="middle">{r.field.name}</text>
                <text class="f-small f-t-muted" x={x + w / 2} y={y + 33} text-anchor="middle">{r.field.type}</text>
              </g>
            ) : (
              <g>
                <rect class="f-box-soft f-dash" x={x + 1} y={y + 1} width={w - 2} height={L.rh - 2} rx="4" />
                {r.len >= 3 && <text class="f-small f-t-muted" x={x + w / 2} y={y + L.rh / 2 + 4.5} text-anchor="middle">{t.pad}</text>}
              </g>
            );
          })}
        </g>
      ))}
    </svg>
  ))}
</Figure>
