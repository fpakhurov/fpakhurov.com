---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The address space of a C program on Linux x86-64 (4-level paging), drawn not to scale, low addresses at the
// bottom. The addresses are those the kernel uses when randomization is off (as under gdb): a position-independent
// executable is loaded at two thirds of the user address space, the stack ends at its top, and the kernel occupies
// the upper canonical half.
const page = 0x1000;
const window = 2 ** 47 - page;                                   // DEFAULT_MAP_WINDOW
const imageBase = Math.floor(window / 3 * 2 / page) * page;      // ELF_ET_DYN_BASE, page-aligned
const stackTop = window;                                          // STACK_TOP
const hex = (v: number) => '0x' + v.toString(16);
if (hex(imageBase) !== '0x555555554000' || hex(stackTop) !== '0x7ffffffff000') throw new Error('x86-64 layout');
const kernelStart = '0xffff800000000000';                          // first canonical address of the upper half

type Kind = 'code' | 'const' | 'data' | 'zero' | 'heap' | 'lib' | 'stack' | 'none' | 'gap';
interface Region { kind: Kind; name: string; sub: string; h: number; addr?: string; note?: string }
const t = ru
  ? {
      regions: [
        { kind: 'none', name: 'ядро', sub: 'недоступно в режиме U', h: 44, addr: kernelStart },
        { kind: 'stack', name: 'стек ↓', sub: 'local, указатель dynamic', h: 50, addr: hex(stackTop), note: ' (верх)' },
        { kind: 'gap', name: '', sub: '', h: 20 },
        { kind: 'lib', name: 'разделяемые библиотеки', sub: 'библиотека C (mmap)', h: 48 },
        { kind: 'gap', name: '', sub: '', h: 20 },
        { kind: 'heap', name: 'куча ↑', sub: 'блок malloc: *dynamic', h: 48 },
        { kind: 'zero', name: '.bss', sub: 'zeroed', h: 44 },
        { kind: 'data', name: '.data', sub: 'initialized, greeting', h: 44 },
        { kind: 'const', name: '.rodata', sub: 'символы "hello"', h: 44 },
        { kind: 'code', name: '.text', sub: 'машинный код main', h: 44, addr: hex(imageBase), note: ' (образ)' },
        { kind: 'none', name: 'не отображено', sub: 'адрес 0 и рядом с ним', h: 42, addr: '0x0' },
      ] as Region[],
      code: ['int initialized = 42;', 'int zeroed;', 'const char *greeting = "hello";', 'int main(void) {', '    int local = 1;', '    int *dynamic = malloc(4);'],
      where: ['.data', '.bss', '.data и .rodata', '.text', 'стек', 'стек и куча'],
      high: 'старшие адреса', low: 'младшие адреса', scale: 'не в масштабе',
    }
  : {
      regions: [
        { kind: 'none', name: 'kernel', sub: 'no access from U-mode', h: 44, addr: kernelStart },
        { kind: 'stack', name: 'stack ↓', sub: 'local, the pointer dynamic', h: 50, addr: hex(stackTop), note: ' (top)' },
        { kind: 'gap', name: '', sub: '', h: 20 },
        { kind: 'lib', name: 'shared libraries', sub: 'the C library (mmap)', h: 48 },
        { kind: 'gap', name: '', sub: '', h: 20 },
        { kind: 'heap', name: 'heap ↑', sub: 'the malloc block *dynamic', h: 48 },
        { kind: 'zero', name: '.bss', sub: 'zeroed', h: 44 },
        { kind: 'data', name: '.data', sub: 'initialized, greeting', h: 44 },
        { kind: 'const', name: '.rodata', sub: 'the characters "hello"', h: 44 },
        { kind: 'code', name: '.text', sub: 'the machine code of main', h: 44, addr: hex(imageBase), note: ' (image)' },
        { kind: 'none', name: 'unmapped', sub: 'address 0 and nearby', h: 42, addr: '0x0' },
      ] as Region[],
      code: ['int initialized = 42;', 'int zeroed;', 'const char *greeting = "hello";', 'int main(void) {', '    int local = 1;', '    int *dynamic = malloc(4);'],
      where: ['.data', '.bss', '.data and .rodata', '.text', 'stack', 'stack and heap'],
      high: 'high addresses', low: 'low addresses', scale: 'not to scale',
    };
const fill: Record<Kind, string> = {
  code: 'var(--fig-blue)', const: 'var(--fig-blue)', data: 'var(--fig-green)', zero: 'var(--fig-green)',
  heap: 'var(--fig-amber)', lib: 'var(--muted)', stack: 'var(--fig-red)', none: 'var(--muted)', gap: 'none',
};
const opacity: Record<Kind, number> = { code: 0.2, const: 0.1, data: 0.2, zero: 0.1, heap: 0.18, lib: 0.12, stack: 0.18, none: 0.06, gap: 0 };
const whereKind: Kind[] = ['data', 'zero', 'data', 'code', 'stack', 'heap'];

interface Layout { cls: string; W: number; H: number; colX: number; colW: number; top: number; addrX: number; code: boolean }
const total = t.regions.reduce((s, r) => s + r.h, 0);
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: total + 60, colX: 330, colW: 230, top: 28, addrX: 572, code: true },
  { cls: 'fig-narrow seq-narrow', W: 360, H: total + 60, colX: 8, colW: 206, top: 28, addrX: 220, code: false },
];
const id = 'program-layout';
---

<Figure
  id={id}
  title={ru ? 'Где в адресном пространстве живут части программы на C' : 'Where the parts of a C program live in its address space'}
  caption={ru
    ? `Адресное пространство процесса в Linux на x86-64, младшие адреса внизу, не в масштабе. Исполняемый файл даёт код (.text), константы (.rodata), инициализированные глобальные переменные (.data) и место для глобальных, инициализированных нулём (.bss). Над ними растёт вверх куча, откуда берёт память malloc; ниже вершины пользовательской половины растёт вниз стек с кадрами функций; между ними отображаются разделяемые библиотеки. Адреса — те, что выбирает ядро при выключенной рандомизации (как под gdb): позиционно-независимый образ по адресу ${hex(imageBase)}, на двух третях от 2⁴⁷, и стек под ${hex(stackTop)}; при включённой рандомизации, обычной настройке, каждая база сдвигается при каждом запуске.`
    : `The address space of a process on Linux x86-64, low addresses at the bottom, not to scale. The executable supplies the code (.text), the constants (.rodata), the initialized globals (.data) and room for the zero-initialized globals (.bss). Above them the heap, where malloc gets its memory, grows upward; below the top of the user half, the stack of function frames grows downward; the shared libraries are mapped in between. The addresses are those the kernel picks with randomization off (as under gdb): a position-independent image at ${hex(imageBase)}, two thirds of 2⁴⁷, and the stack below ${hex(stackTop)}; with randomization, the usual setting, every base moves on each run.`}
>
  {layouts.map((L) => {
    let y = L.top;
    const placed = t.regions.map((r) => { const p = { ...r, y }; y += r.h; return p; });
    const yOf = (k: Kind) => { const p = placed.find((r) => r.kind === k)!; return p.y + p.h / 2; };
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Сегменты адресного пространства процесса' : 'The segments of a process address space'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Столбец областей снизу вверх: не отображённая область у нуля, .text, .rodata, .data, .bss, куча, растущая вверх, разделяемые библиотеки, стек, растущий вниз, и ядро. Каждая строка программы связана с областью, где лежит её объект.'
          : 'A column of regions from bottom to top: the unmapped area near zero, .text, .rodata, .data, .bss, the heap growing upward, the shared libraries, the stack growing downward, and the kernel. Each line of the program is tied to the region that holds its object.'}</desc>
        <text class="f-small f-t-muted" x={L.colX} y={L.top - 10}>{t.high}</text>
        <text class="f-small f-t-muted" x={L.colX} y={y + 18}>{t.low} · {t.scale}</text>
        {placed.map((r) => r.kind === 'gap' ? (
          <path class="f-thin f-muted f-dot" d={`M ${L.colX + L.colW / 2} ${r.y + 3} V ${r.y + r.h - 3}`} />
        ) : (
          <g>
            <rect x={L.colX} y={r.y + 1} width={L.colW} height={r.h - 2} rx="4" style={`fill: ${fill[r.kind]}; fill-opacity: ${opacity[r.kind]}; stroke: ${fill[r.kind]}; stroke-width: 1.1`} />
            <text class="f-small" x={L.colX + 8} y={r.y + r.h / 2 - 1} style="font-weight: 600">{r.name}</text>
            <text class="f-small f-t-muted" x={L.colX + 8} y={r.y + r.h / 2 + 13}>{r.sub}</text>
            {r.addr && <text class="f-small f-t-muted" x={L.addrX} y={r.y + r.h / 2 + 4.5}>{r.addr}{L.code ? r.note ?? '' : ''}</text>}
          </g>
        ))}
        {L.code && t.code.map((line, i) => {
          const ly = L.top + 40 + i * 44;
          const ty = yOf(whereKind[i]);
          return (
            <g>
              <text class="f-small" x={8} y={ly} style="font-family: var(--mono, ui-monospace, monospace)">{line}</text>
              <text class="f-small f-t-muted" x={8} y={ly + 16}>→ {t.where[i]}</text>
              <path class="f-thin f-muted" d={`M ${256} ${ly - 4} C ${296} ${ly - 4}, ${296} ${ty}, ${L.colX - 3} ${ty}`} marker-end="url(#f-arrow-muted)" />
            </g>
          );
        })}
      </svg>
    );
  })}
</Figure>
