---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
const id = 'db-wal-durable-prefix';
const title = ru ? 'Что успело попасть на накопитель' : 'What reached durable storage';
const records = [
  { x: 55, lsn: 10, label: 'Redo' },
  { x: 165, lsn: 20, label: ru ? 'Правка' : 'Change' },
  { x: 275, lsn: 30, label: 'Commit' },
];
---
<Figure id={id} title={title} caption={ru
  ? 'Позиции условны. После сбоя по сценарию A журнал сохранился до записи правки. В сценарии B сохранена и запись о фиксации.'
  : 'The positions are illustrative. In case A the change record survives the crash. In case B the commit record survives as well.'}>
  <svg viewBox="0 0 330 142" class="fig-compact" role="img" aria-labelledby={id + '-title ' + id + '-desc'}>
    <title id={id + '-title'}>{title}</title>
    <desc id={id + '-desc'}>{ru ? 'A сохраняет журнал до позиции 20. B сохраняет журнал до позиции 30, включая фиксацию.' : 'A preserves WAL through position 20. B preserves WAL through position 30, including the commit.'}</desc>
    {records.map(({ x, lsn, label }) => (
      <g>
        <rect x={x - 46} y="9" width="92" height="32" rx="5" class="f-box-soft" />
        <text x={x} y="30" text-anchor="middle">{label} {lsn}</text>
      </g>
    ))}
    <text x="11" y="76" class="f-title">A</text>
    <path d="M 35 71 H 199" class="f-line f-amber f-bold" />
    <text x="11" y="105" class="f-title">B</text>
    <path d="M 35 100 H 307" class="f-line f-green f-bold" />
    <text x="165" y="130" text-anchor="middle">{ru ? 'Сохранённая часть WAL' : 'Durable WAL prefix'}</text>
  </svg>
</Figure>
