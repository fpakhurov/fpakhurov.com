---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// ROUGE-1 and ROUGE-2 F1 of two candidates against one reference, computed here.
const ref = 'the cat sat on the mat'.split(' ');
const cands = [
  { name: ru ? 'почти копия' : 'near-copy', toks: 'the cat lay on a mat'.split(' ') },
  { name: ru ? 'верный пересказ' : 'correct paraphrase', toks: 'a feline rested on the rug'.split(' ') },
];
const grams = (ts: string[], n: number) => ts.slice(0, ts.length - n + 1).map((_, i) => ts.slice(i, i + n).join(' '));
const overlap = (a: string[], b: string[]) => {
  const count = new Map<string, number>();
  b.forEach((g) => count.set(g, (count.get(g) ?? 0) + 1));
  let m = 0;
  a.forEach((g) => { const c = count.get(g) ?? 0; if (c > 0) { m++; count.set(g, c - 1); } });
  return m;
};
const f1 = (s: string[], r: string[], n: number) => {
  const gs = grams(s, n), gr = grams(r, n), m = overlap(gs, gr);
  return m === 0 ? 0 : (2 * (m / gs.length) * (m / gr.length)) / (m / gs.length + m / gr.length);
};
// Which candidate tokens take part in a unigram match (respecting multiplicity), and which bigram starts match.
const unigramHits = (s: string[]) => {
  const pool = new Map<string, number>();
  ref.forEach((w) => pool.set(w, (pool.get(w) ?? 0) + 1));
  return s.map((w) => { const c = pool.get(w) ?? 0; if (c > 0) { pool.set(w, c - 1); return true; } return false; });
};
const bigramHits = (s: string[]) => { const rb = new Set(grams(ref, 2)); return grams(s, 2).map((g) => rb.has(g)); };
const rows = cands.map((c) => ({ ...c, r1: 100 * f1(c.toks, ref, 1), r2: 100 * f1(c.toks, ref, 2), uni: unigramHits(c.toks), bi: bigramHits(c.toks) }));
if (rows[0].r1.toFixed(1) !== '66.7' || rows[1].r1.toFixed(1) !== '33.3' || rows[1].r2.toFixed(1) !== '20.0') throw new Error('RougeOverlap: numbers drifted from the note');
const t = ru
  ? { ref: 'эталон', r: 'ROUGE-1 / ROUGE-2' }
  : { ref: 'reference', r: 'ROUGE-1 / ROUGE-2' };
const id = 'rouge-overlap';
interface Layout { cls: string; W: number; H: number; x0: number; cw: number; rowH: number; scoreX: number; stacked: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 700, H: 196, x0: 150, cw: 62, rowH: 58, scoreX: 600, stacked: false },
  { cls: 'fig-narrow', W: 360, H: 250, x0: 8, cw: 54, rowH: 84, scoreX: 352, stacked: true },
];
---

<Figure
  id={id}
  title={ru ? 'Что считает ROUGE' : 'What ROUGE counts'}
  caption={ru
    ? 'Два кандидата против одного эталона. Зелёные клетки — униграммы, совпавшие с эталоном (каждое слово эталона засчитывается не больше раз, чем встречается); зелёная черта под парой слов — совпавшая биграмма. Почти копия с одной заменой слова получает 66.7 по ROUGE-1. Верный пересказ другими словами получает 33.3 — и только за счёт on the, а по ROUGE-2 столько же, сколько почти копия, 20.0: единственная совпавшая биграмма у каждого своя. ROUGE измеряет пересечение слов с эталоном, а не смысл.'
    : 'Two candidates against one reference. Green cells are unigrams that match the reference (each reference word counts at most as often as it occurs); a green bar under a pair of words is a matching bigram. The near-copy with one word replaced scores 66.7 on ROUGE-1. The correct paraphrase in other words scores 33.3, and only through on the, and on ROUGE-2 it ties with the near-copy at 20.0: each has its single matching bigram. ROUGE measures word overlap with the reference, not meaning.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Совпадения униграмм и биграмм с эталоном' : 'Unigram and bigram matches with the reference'}</title>
      <desc id={`${id}-${L.W}-d`}>{`${t.ref}: ${ref.join(' ')}. ${rows.map((r) => `${r.name}: ${r.toks.join(' ')}, ROUGE-1 ${r.r1.toFixed(1)}, ROUGE-2 ${r.r2.toFixed(1)}`).join('. ')}.`}</desc>
      {[{ name: t.ref, toks: ref, uni: ref.map(() => false), bi: [] as boolean[], score: '' }, ...rows.map((r) => ({ name: r.name, toks: r.toks, uni: r.uni, bi: r.bi, score: `${r.r1.toFixed(1)} / ${r.r2.toFixed(1)}` }))].map((row, ri) => {
        const y = (L.stacked ? 24 : 12) + ri * L.rowH;
        const by = L.stacked ? y + 8 : y;
        return (
          <g>
            <text class="f-small f-t-muted" x={L.stacked ? L.x0 : L.x0 - 12} y={L.stacked ? y : y + 19} text-anchor={L.stacked ? 'start' : 'end'}>{row.name}</text>
            {row.score && <text class="f-small" x={L.scoreX} y={L.stacked ? y : by + 19} text-anchor={L.stacked ? 'end' : 'start'} style="font-weight: 650">{row.score}</text>}
            {row.toks.map((w, i) => (
              <g>
                <rect class={ri === 0 ? 'f-box-soft' : row.uni[i] ? 'f-box f-fill-green' : 'f-box'} x={L.x0 + i * (L.cw + 4)} y={by} width={L.cw} height="28" rx="4" />
                <text class="f-small" x={L.x0 + i * (L.cw + 4) + L.cw / 2} y={by + 19} text-anchor="middle" font-family="var(--mono)">{w}</text>
              </g>
            ))}
            {row.bi.map((hit, i) => hit && <path class="f-line f-green f-bold" d={`M ${L.x0 + i * (L.cw + 4) + L.cw / 2} ${by + 34} H ${L.x0 + (i + 1) * (L.cw + 4) + L.cw / 2}`} />)}
          </g>
        );
      })}
      {!L.stacked && <text class="f-small f-t-muted" x={L.W - 4} y={L.H - 6} text-anchor="end">{t.r}</text>}
      {L.stacked && <text class="f-small f-t-muted" x={L.scoreX} y={12} text-anchor="end">{t.r}</text>}
    </svg>
  ))}
</Figure>
