---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Box from '../seqflow/Box.astro';
import Stepper from '../seqflow/Stepper.astro';
import type { Tone } from '../seqflow/tones';

const ru = pageLang(Astro.url) === 'ru';
const id = 'sql-query-scope';
const stages: { label: string; sub: string; tone: Tone }[] = [
  { label: 'FROM', sub: 'order_lines', tone: 'x' },
  { label: 'WHERE', sub: ru ? 'Отбор по стоимости' : 'Filter by amount', tone: 'g' },
  { label: 'SELECT', sub: 'line_total_cents', tone: 'h' },
  { label: 'ORDER BY', sub: ru ? 'Имя из SELECT' : 'Name from SELECT', tone: 'y' },
];
const steps = ru
  ? ['Берём столбцы из order_lines', 'Отбираем строки по выражению над входными столбцами', 'Имя line_total_cents появляется в схеме результата', 'ORDER BY использует имя выходного столбца']
  : ['Take the input columns from order_lines', 'Keep rows by a condition on the input columns', 'Name the output expression line_total_cents', 'Use the output name in ORDER BY'];
const layouts = [
  { cls: 'fig-wide fig-bp-640', width: 760, height: 106, boxW: 160, boxH: 64, vertical: false },
  { cls: 'fig-narrow fig-bp-640 seq-narrow', width: 360, height: 367, boxW: 296, boxH: 64, vertical: true },
];
---

<Figure id={id}
  title={ru ? 'Где появляется имя выходного столбца' : 'Where the output column name appears'}
  caption={ru
    ? 'Условие WHERE использует входные имена и выражение стоимости. Имя line_total_cents задаётся в SELECT, после чего им можно обозначить ключ сортировки.'
    : 'The WHERE condition uses input names and the amount expression. SELECT assigns line_total_cents, which can then name the sort key.'}>
  {layouts.map(({ cls, width, height, boxW, boxH, vertical }) => {
    const coords = stages.map((_, i) => ({ x: vertical ? 32 : 15 + i * 190, y: vertical ? 12 + i * 93 : 25 }));
    return <svg class={cls} viewBox={`0 0 ${width} ${height}`} role="img" aria-labelledby={`${id}-${width}-title ${id}-${width}-desc`}>
      <title id={`${id}-${width}-title`}>{ru ? 'Области видимости имён в запросе' : 'Name scopes in the query'}</title>
      <desc id={`${id}-${width}-desc`}>{ru ? 'FROM задаёт вход, WHERE отбирает строки, SELECT создаёт имя выходного поля, ORDER BY может использовать это имя.' : 'FROM supplies input, WHERE filters rows, SELECT names the output, and ORDER BY can use that name.'}</desc>
      {stages.map((stage, i) => {
        const { x, y } = coords[i];
        const next = coords[i + 1];
        return <g data-s={i + 1}>
          <Box x={x} y={y} w={boxW} h={boxH} label={stage.label} sub={stage.sub} tone={stage.tone} />
          <Badge x={x + 15} y={y + 15} n={i + 1} />
          {next && <Arrow pts={vertical
            ? [[x + boxW / 2, y + boxH + 3], [x + boxW / 2, next.y - 4]]
            : [[x + boxW + 3, y + boxH / 2], [next.x - 4, y + boxH / 2]]} />}
        </g>;
      })}
    </svg>;
  })}
  <Stepper steps={steps} />
</Figure>
