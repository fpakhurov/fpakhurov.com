---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { keyOf, lines } from '../sql-tables-and-queries/example';

const ru = pageLang(Astro.url) === 'ru';
const id = 'sql-predicate-grouping';
const checks = lines.map((line) => {
  const enough = line.quantity >= 2;
  const tea = line.product === 'tea';
  const coffee = line.product === 'coffee';
  return { ...line, grouped: enough && (tea || coffee), ungrouped: tea || (coffee && enough) };
});
const keptKeys = (kind: 'grouped' | 'ungrouped') => checks.filter((line) => line[kind]).map(keyOf).join(',');
if (keptKeys('grouped') !== '101/1,103/1' || keptKeys('ungrouped') !== '101/1,102/1,103/1,103/2') {
  throw new Error('Expected the missing parentheses to admit both single-unit tea lines');
}

const layouts = [
  { cls: 'fig-wide fig-bp-640', width: 720, columns: [38, 162, 285, 480, 625], left: 22 },
  { cls: 'fig-narrow fig-bp-640', width: 360, columns: [29, 91, 156, 224, 310], left: 12 },
];
const headings = ru ? ['Позиция', 'Товар', 'Штук', 'Со скобками', 'Без скобок'] : ['Line', 'Product', 'Units', 'Grouped', 'Ungrouped'];
---

<Figure id={id}
  title={ru ? 'Скобки распространяют ограничение на оба товара' : 'Parentheses apply the quantity limit to both products'}
  caption={ru
    ? 'Фильтр ищет чай или кофе в количестве хотя бы двух единиц. Без скобок порог применяется только к кофе. В результат добавляются позиции 102/1 и 103/2 с одной единицей чая.'
    : 'The filter asks for tea or coffee in quantities of at least two. Without parentheses the threshold applies only to coffee. Lines 102/1 and 103/2, each with one unit of tea, enter the result.'}>
  {layouts.map(({ cls, width, columns, left }) => <svg class={cls} viewBox={`0 0 ${width} 270`} role="img" aria-labelledby={`${id}-${width}-title ${id}-${width}-desc`}>
    <title id={`${id}-${width}-title`}>{ru ? 'Сравнение двух группировок условий' : 'Comparison of two groupings of the conditions'}</title>
    <desc id={`${id}-${width}-desc`}>{ru
      ? 'Со скобками отбираются позиции 101/1 и 103/1. Без скобок дополнительно отбираются 102/1 и 103/2.'
      : 'The grouped condition keeps 101/1 and 103/1. The ungrouped condition also keeps 102/1 and 103/2.'}</desc>
    {headings.map((heading, i) => <text class="f-small f-t-muted" x={columns[i]} y="27" text-anchor={i >= 2 ? 'middle' : 'start'}>{heading}</text>)}
    <path class="f-line f-muted" d={`M ${left} 39 H ${width - left}`} opacity="0.5" />
    {checks.map((line, i) => {
      const y = 62 + i * 32;
      return <>
        {line.grouped !== line.ungrouped && <rect class="f-fill-amber" x={left} y={y - 20} width={width - 2 * left} height="29" rx="5" />}
        <text class="f-small" x={columns[0]} y={y} style="font-family: var(--mono)">{keyOf(line)}</text>
        <text class="f-small" x={columns[1]} y={y} style="font-family: var(--mono)">{line.product}</text>
        <text class="f-small" x={columns[2]} y={y} text-anchor="middle">{line.quantity}</text>
        {[line.grouped, line.ungrouped].map((kept, j) => <text class={`f-small ${kept ? 'f-t-green' : 'f-t-muted'}`} x={columns[j + 3]} y={y} text-anchor="middle">
          {kept ? (ru ? 'Да' : 'Yes') : (ru ? 'Нет' : 'No')}
        </text>)}
      </>;
    })}
    <path class="f-line f-muted" d={`M ${left} 235 H ${width - left}`} opacity="0.5" />
    <text class="f-small" x={columns[3]} y="257" text-anchor="middle">{ru ? '2 строки' : '2 rows'}</text>
    <text class="f-small" x={columns[4]} y="257" text-anchor="middle">{ru ? '4 строки' : '4 rows'}</text>
  </svg>)}
</Figure>
