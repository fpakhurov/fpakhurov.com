---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { keyOf, lines } from '../sql-tables-and-queries/example';

const ru = pageLang(Astro.url) === 'ru';
const id = 'sql-amount-bounds';
const lower = 700;
const upper = 1200;
const amount = (line: typeof lines[number]) => line.quantity * line.unitPriceCents;
const inRange = lines.filter((line) => lower <= amount(line) && amount(line) < upper);
const upperLines = lines.filter((line) => amount(line) === upper);
if (inRange.map(keyOf).join(',') !== '101/1' || upperLines.map(keyOf).join(',') !== '103/1,104/1') {
  throw new Error('Unexpected line identities at the amount boundaries');
}

const layouts = [{ cls: 'fig-wide fig-bp-640', width: 700 }, { cls: 'fig-narrow fig-bp-640', width: 360 }];
---

<Figure id={id}
  title={ru ? 'Нижняя граница входит в интервал' : 'The interval includes the lower boundary'}
  caption={ru
    ? 'Полуоткрытый интервал [700, 1200) оставляет позицию 101/1. Позиции 103/1 и 104/1 стоят ровно 1200 копеек и лежат на исключённой границе.'
    : 'The interval from 700 inclusive to 1200 exclusive keeps line 101/1. Lines 103/1 and 104/1 cost exactly 1200 cents and lie on the excluded boundary.'}>
  {layouts.map(({ cls, width }) => {
    const x = (cents: number) => 34 + (cents - 470) * (width - 68) / (1430 - 470);
    return <svg class={cls} viewBox={`0 0 ${width} 174`} role="img" aria-labelledby={`${id}-${width}-title ${id}-${width}-desc`}>
      <title id={`${id}-${width}-title`}>{ru ? 'Полуоткрытый интервал стоимости' : 'A half-open amount interval'}</title>
      <desc id={`${id}-${width}-desc`}>{ru ? 'Закрашенная точка отмечает включённую границу 700, пустая точка отмечает исключённую границу 1200.' : 'A filled dot marks the included boundary at 700 and an open dot marks the excluded boundary at 1200.'}</desc>
      <text class="f-small f-t-muted" x={width / 2} y="26" text-anchor="middle">{ru ? 'Стоимость позиции в копейках' : 'Line amount in cents'}</text>
      <path class="f-axis" d={`M 24 70 H ${width - 24}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-line f-green f-bold" d={`M ${x(lower)} 70 H ${x(upper)}`} />
      <circle class="f-solid-green" cx={x(lower)} cy="70" r="6" />
      <circle class="f-fill-paper f-line f-red" cx={x(upper)} cy="70" r="6" />
      <text class="f-label" x={x(lower)} y="103" text-anchor="middle">{lower}</text>
      <text class="f-label" x={x(upper)} y="103" text-anchor="middle">{upper}</text>
      <text class="f-small f-t-green" x={x(lower)} y="126" text-anchor="middle">{ru ? 'Входит' : 'Included'}</text>
      <text class="f-small f-t-red" x={x(upper)} y="126" text-anchor="middle">{ru ? 'Не входит' : 'Excluded'}</text>
      <text class="f-small" x={x(lower)} y="151" text-anchor="middle" style="font-family: var(--mono)">{inRange.map(keyOf).join(', ')}</text>
      <text class="f-small" x={x(upper)} y="151" text-anchor="middle" style="font-family: var(--mono)">{upperLines.map(keyOf).join(', ')}</text>
    </svg>;
  })}
</Figure>
