---
import Figure from '../Figure.astro';
import { mulberry32 } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One seeded stick-breaking draw for alpha = 1 and alpha = 5: v_k ~ Beta(1, alpha) by the inverse CDF
// v = 1 - (1 - u)^(1/alpha), pi_k = v_k times what is left of the stick. 30 sticks are drawn.
const rows = [1, 5].map((alpha) => {
  const u = mulberry32(10 + alpha);
  let rest = 1;
  const pi: number[] = [];
  for (let k = 0; k < 30; k++) { const v = 1 - Math.pow(1 - u(), 1 / alpha); pi.push(rest * v); rest *= 1 - v; }
  return { alpha, pi, used: 1 - rest, first3: pi[0] + pi[1] + pi[2], expected3: 1 - (alpha / (1 + alpha)) ** 3 };
});
const chk = rows.map((r) => [...r.pi.slice(0, 3), r.first3].map((v) => v.toFixed(3)).join()).join('|');
if (chk !== '0.512,0.259,0.140,0.910|0.053,0.093,0.084,0.230') throw new Error(`StickBreaking: draw drifted from the caption (${chk})`);
const tones = ['blue', 'amber', 'green', 'red'];

const t = ru
  ? { row: (a: number) => `α = ${a}`, sum: (r: (typeof rows)[0]) => `первые три: ${r.first3.toFixed(2)} (в среднем ${r.expected3.toFixed(3)})` }
  : { row: (a: number) => `α = ${a}`, sum: (r: (typeof rows)[0]) => `first three: ${r.first3.toFixed(2)} (expected ${r.expected3.toFixed(3)})` };
const id = 'stick-breaking';
const layouts = [
  { cls: 'fig-wide fig-bp-640', W: 760, H: 210, x0: 90, x1: 740, ys: [56, 146], lx: 20 },
  { cls: 'fig-narrow seq-narrow fig-bp-640', W: 360, H: 270, x0: 20, x1: 340, ys: [64, 184], lx: 20 },
];
---

<Figure
  id={id}
  title={ru ? 'Разламывание палки при двух значениях α' : 'Stick-breaking for two values of α'}
  caption={ru
    ? 'Одна случайная реализация весов π_k = v_k ∏(1 − v_j), v_k ~ Beta(1, α), 30 отрезков. При α = 1 первые три веса равны 0.512, 0.259 и 0.140 и забирают 0.91 палки (в среднем 0.875): мало крупных кластеров. При α = 5 первые три — 0.053, 0.093 и 0.084, вместе 0.23 (в среднем 0.421): много мелких.'
    : 'One random draw of the weights π_k = v_k ∏(1 − v_j), v_k ~ Beta(1, α), 30 pieces. With α = 1 the first three weights are 0.512, 0.259 and 0.140 and take 0.91 of the stick (0.875 on average): a few large clusters. With α = 5 the first three are 0.053, 0.093 and 0.084, together 0.23 (0.421 on average): many small ones.'}
>
  {layouts.map((L) => {
    const w = L.x1 - L.x0;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Две сломанные палки' : 'Two broken sticks'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Верхняя палка при α = 1 разбита на несколько крупных кусков, нижняя при α = 5 — на много мелких.' : 'The upper stick, α = 1, is broken into a few large pieces; the lower one, α = 5, into many small ones.'}</desc>
        {rows.map((r, j) => {
          const y = L.ys[j];
          const starts = r.pi.map((_, k) => r.pi.slice(0, k).reduce((a, b) => a + b, 0));
          return (
            <g>
              {L.W === 760
                ? <text class="f-label" x={L.lx} y={y + 18}>{t.row(r.alpha)}</text>
                : <text class="f-label" x={L.lx} y={y - 46}>{t.row(r.alpha)}</text>}
              {r.pi.map((p, k) => (
                <rect x={L.x0 + starts[k] * w} y={y} width={p * w} height="28" style={`fill: var(--fig-${tones[k % 4]}); fill-opacity: 0.22; stroke: var(--fig-${tones[k % 4]}); stroke-width: 0.8`} />
              ))}
              <rect x={L.x0 + r.used * w} y={y} width={(1 - r.used) * w} height="28" class="f-box-soft" />
              {r.pi.slice(0, 3).map((p, k) => (
                <text class="f-small" x={L.x0 + (starts[k] + p / 2) * w} y={L.W === 360 && j === 1 && k === 1 ? y - 24 : y - 7} text-anchor="middle">{p.toFixed(2)}</text>
              ))}
              <text class="f-small f-t-muted" x={L.x0} y={y + 48}>{t.sum(r)}</text>
            </g>
          );
        })}
      </svg>
    );
  })}
</Figure>
