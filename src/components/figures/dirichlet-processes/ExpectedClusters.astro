---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The expected number of occupied tables of a CRP after n customers, E K_n = sum over i = 0..n-1 of alpha / (alpha + i),
// against the approximation alpha log(1 + n / alpha), for n = 1 .. 10^4 on a log axis.
const N = 10000;
const alphas = [0.5, 1, 5];
const exact = alphas.map((a) => { let s = 0; return Array.from({ length: N }, (_, i) => (s += a / (a + i))); });
const ns = Array.from({ length: 161 }, (_, i) => Math.round(10 ** ((4 * i) / 160)));
const chk = [exact[1][99], exact[1][999], exact[2][999], exact[2][9999]].map((v) => v.toFixed(3)).join();
if (chk !== '5.187,7.485,27.031,38.523') throw new Error(`ExpectedClusters: values drifted from the note (${chk})`);
const tones = ['green', 'blue', 'amber'];

const t = ru
  ? { x: 'число точек n (логарифмическая шкала)', y: 'E K_n', exact: 'точное значение', approx: 'α log(1 + n/α)' }
  : { x: 'number of points n (log scale)', y: 'E K_n', exact: 'exact', approx: 'α log(1 + n/α)' };
const id = 'expected-clusters';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 620, H: 320, x0: 56, x1: 540, y0: 24, y1: 260 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 360, x0: 44, x1: 290, y0: 60, y1: 290 },
];
---

<Figure
  id={id}
  title={ru ? 'Сколько кластеров открывает китайский ресторан' : 'How many clusters the Chinese restaurant opens'}
  caption={ru
    ? 'Ожидаемое число занятых столов после n посетителей (сплошные линии) и приближение α log(1 + n/α) (пунктир) при α = 0.5, 1 и 5. По логарифмической оси кривые становятся прямыми с наклоном α: при α = 1 занято 5.19 стола при n = 100 и 7.49 при n = 1000, при α = 5 — 27.0 при n = 1000 и 38.5 при n = 10 000.'
    : 'The expected number of occupied tables after n customers (solid) and the approximation α log(1 + n/α) (dashed), for α = 0.5, 1 and 5. On a log axis the curves become lines of slope α: with α = 1, 5.19 tables at n = 100 and 7.49 at n = 1000; with α = 5, 27.0 at n = 1000 and 38.5 at n = 10,000.'}
>
  {layouts.map((L) => {
    const sx = scale([0, 4], [L.x0, L.x1]), sy = scale([0, 40], [L.y1, L.y0]);
    const lx = (n: number) => sx(Math.log10(n));
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Ожидаемое число кластеров' : 'The expected number of clusters'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Три кривые, растущие как логарифм n; чем больше α, тем круче. Пунктирные приближения идут чуть ниже сплошных кривых.' : 'Three curves growing like the logarithm of n, steeper for larger α. The dashed approximations run slightly below the solid curves.'}</desc>
        {[0, 10, 20, 30, 40].map((v) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} />
            <text class="f-small f-t-muted" x={L.x0 - 6} y={sy(v) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {[1, 10, 100, 1000, 10000].map((v) => <text class="f-small f-t-muted" x={lx(v)} y={L.y1 + 18} text-anchor="middle">{v === 10000 ? '10⁴' : v}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 40} text-anchor="middle">{t.x}</text>
        {alphas.map((a, j) => (
          <g>
            <path class={`f-line f-${tones[j]}`} d={polyline(ns.map((n) => [lx(n), sy(exact[j][n - 1])]))} />
            <path class={`f-thin f-${tones[j]} f-dash`} d={polyline(ns.map((n) => [lx(n), sy(a * Math.log(1 + n / a))]))} />
            <text class={`f-small f-t-${tones[j]}`} x={L.x1 + 8} y={sy(exact[j][N - 1]) + 4}>{`α = ${a}`}</text>
          </g>
        ))}
        {[[1, 100], [1, 1000], [2, 1000]].map(([j, n]) => <circle class={`f-solid-${tones[j]}`} cx={lx(n)} cy={sy(exact[j][n - 1])} r="3.8" />)}
        <path class="f-line" d={`M ${L.x0 + 12} ${L.W === 620 ? L.y0 + 14 : 22} h 24`} />
        <text class="f-small" x={L.x0 + 44} y={(L.W === 620 ? L.y0 + 14 : 22) + 4}>{t.exact}</text>
        <path class="f-thin f-dash" d={`M ${L.x0 + 12} ${L.W === 620 ? L.y0 + 34 : 42} h 24`} />
        <text class="f-small" x={L.x0 + 44} y={(L.W === 620 ? L.y0 + 34 : 42) + 4}>{t.approx}</text>
      </svg>
    );
  })}
</Figure>
