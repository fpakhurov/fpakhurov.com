---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import Arrow from '../seqflow/Arrow.astro';
import Sub from '../generative-modeling/Sub.astro';
import { curve } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The Chinese restaurant process with alpha = 1: seven customers at three tables with 4, 2 and 1 customers,
// and the probabilities for the eighth: n_k / (n + alpha) for an occupied table, alpha / (n + alpha) for a new one.
const alpha = 1, counts = [4, 2, 1];
const n = counts.reduce((a, b) => a + b, 0);
const probs = [...counts, alpha].map((c) => c / (n + alpha));
if (probs.map((p) => p.toFixed(3)).join() !== '0.500,0.250,0.125,0.125') throw new Error('CrpTables: probabilities drifted from the note');
const frac = [...counts.map((c) => `${c}/${n + alpha}`), `α/${n + alpha}`];
// narrow layout: arrows to the top row go straight, arrows to the bottom row go down the middle first
const narrowPts = (k: number, x: number, y: number, c: number[]): [number, number][] =>
  k === 2 ? [[c[0], c[1] + 18], [c[0], 270], [x + 30, y - 27]]
  : k === 3 ? [[c[0], c[1] + 18], [c[0], 270], [x - 30, y - 27]]
  : [[c[0] + (k ? 12 : -12), c[1] + 14], [x + (k ? -8 : 8), y - 44]];
// customers inside a table: up to 4, on a 2 x 2 grid
const seats = (k: number) => [[-11, -11], [11, -11], [-11, 11], [11, 11]].slice(0, k);

const t = ru
  ? { cust: 'посетитель 8', fresh: 'новый', steps: ['семь посетителей за тремя столами: 4, 2 и 1 человек', 'восьмой садится за занятый стол с вероятностью n_k/(n + α): 4/8, 2/8 и 1/8', 'или садится за новый стол с вероятностью α/(n + α) = 1/8'] }
  : { cust: 'customer 8', fresh: 'new', steps: ['seven customers at three tables, with 4, 2 and 1 people', 'the eighth joins an occupied table with probability n_k/(n + α): 4/8, 2/8 and 1/8', 'or opens a new table with probability α/(n + α) = 1/8'] };
const id = 'crp-tables';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 250, r: 38, cust: [70, 130], label: [70, 172, 'middle'], tables: [[250, 130], [400, 130], [545, 130], [685, 130]] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 450, r: 36, cust: [180, 40], label: [204, 45, 'start'], tables: [[95, 160], [265, 160], [95, 336], [265, 336]] },
];
---

<Figure
  id={id}
  title={ru ? 'Процесс китайского ресторана' : 'The Chinese restaurant process'}
  caption={ru
    ? 'Параметр концентрации α = 1. Семь посетителей уже сидят за тремя столами (1). Восьмой выбирает занятый стол k с вероятностью, пропорциональной числу n_k сидящих за ним, — 0.50, 0.25 и 0.125 (2), — или новый стол с вероятностью, пропорциональной α, — 0.125 (3). Знаменатель n + α = 8 нормирует все четыре варианта.'
    : 'Concentration α = 1. Seven customers already sit at three tables (1). The eighth picks an occupied table k with probability proportional to the number n_k already there, 0.50, 0.25 and 0.125 (2), or a new table with probability proportional to α, 0.125 (3). The denominator n + α = 8 normalizes the four choices.'}
>
  {layouts.map((L) => {
    const [cx0, cy0] = L.cust;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Столы китайского ресторана' : 'The tables of the Chinese restaurant'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Три стола с четырьмя, двумя и одним посетителем и пустой новый стол; стрелки от восьмого посетителя ко всем четырём, под каждым столом вероятность.' : 'Three tables with four, two and one customer and an empty new table; arrows from the eighth customer to all four, with a probability under each table.'}</desc>
        {L.tables.map(([x, y], k) => {
          const isNew = k === 3;
          const wide = L.W === 760;
          return (
            <g>
              <g data-s={isNew ? '3' : '1'}>
                <circle cx={x} cy={y} r={L.r} class={isNew ? 'f-thin f-dash' : 'f-box-soft'} />
                {isNew
                  ? <text class="f-small f-t-muted" x={x} y={y + 5} text-anchor="middle">{t.fresh}</text>
                  : seats(counts[k]).map(([dx, dy]) => <circle class="f-solid-blue" cx={x + dx} cy={y + dy} r="6" />)}
                {!isNew && <text class="f-small" x={x} y={y + L.r + 20} text-anchor="middle"><Sub label={`n_${k + 1} = ${counts[k]}`} /></text>}
              </g>
              <g data-s={isNew ? '3' : '2'}>
                {wide
                  ? <path class={`f-line ${isNew ? 'f-amber f-dash' : 'f-muted'}`} d={curve(cx0 + 12, cy0 - 12, x - 6, y - L.r - 8, -(30 + k * 12))} marker-end={`url(#f-arrow${isNew ? '-amber' : '-muted'})`} />
                  : <Arrow pts={narrowPts(k, x, y, L.cust)} tone={isNew ? 'amber' : 'muted'} dashed={isNew} />}
                <text class={`f-small ${isNew ? 'f-t-amber' : ''}`} x={x} y={y + L.r + 40} text-anchor="middle">{`${frac[k]} = ${probs[k].toFixed(k === 0 || k === 1 ? 2 : 3)}`}</text>
              </g>
            </g>
          );
        })}
        <g data-s="1">
          <circle class="f-fill-amber" cx={cx0} cy={cy0} r="14" style="stroke: var(--fig-amber); stroke-width: 1.4" />
          <text class="f-small" x={L.label[0] as number} y={L.label[1] as number} text-anchor={L.label[2] as 'start' | 'middle' | 'end'}>{t.cust}</text>
        </g>
        {L.W === 760
          ? <g><Badge x={200} y={166} n={1} /><Badge x={330} y={44} n={2} /><Badge x={685 + 52} y={84} n={3} /></g>
          : <g><Badge x={40} y={110} n={1} /><Badge x={150} y={100} n={2} /><Badge x={320} y={290} n={3} /></g>}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
