---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The weather chain of the probability course: P = [[.7, .2, .1], [.3, .4, .3], [.2, .3, .5]], stationary π = (21, 13, 12)/46,
// eigenvalues 1, 0.3 ± √0.03. The total absolute difference ‖π_t − π‖₁ from each pure starting state, for t = 0 … 20.
const P = [[0.7, 0.2, 0.1], [0.3, 0.4, 0.3], [0.2, 0.3, 0.5]];
const pi = [21 / 46, 13 / 46, 12 / 46];
const step = (p: number[]) => [0, 1, 2].map((j) => p[0] * P[0][j] + p[1] * P[1][j] + p[2] * P[2][j]);
const T = 20;
const dist = [0, 1, 2].map((s) => {
  let p: number[] = [0, 1, 2].map((j) => (j === s ? 1 : 0));
  const d: number[] = [];
  for (let t = 0; t <= T; t += 1) { d.push(p.reduce((a, v, j) => a + Math.abs(v - pi[j]), 0)); p = step(p); }
  return d;
});
const lam2 = 0.3 + Math.sqrt(0.03);
const stat = step(pi).map((v, j) => Math.abs(v - pi[j])).reduce((a, b) => a + b, 0);
if (stat > 1e-15 || lam2.toFixed(3) !== '0.473') throw new Error('MarkovConvergence: the chain drifted from the note');
const sunny = dist[0];
if ([sunny[0].toFixed(3), sunny[1].toFixed(3), sunny[10].toExponential(1)].join() !== '1.087,0.487,5.7e-4') throw new Error('MarkovConvergence: distances drifted from the note');
if (dist.some((d) => Math.abs(d[T] / d[T - 1] - lam2) > 1e-6)) throw new Error('MarkovConvergence: the late ratio is not λ₂');
const ref = (t: number) => sunny[10] * lam2 ** (t - 10); // the reference line through the sunny curve at t = 10

const t = ru
  ? {
      title: 'Расстояние до стационарного распределения убывает как |λ₂|ᵗ',
      desc: 'Логарифмическая шкала по вертикали, шаг t от 0 до 20 по горизонтали. Три почти параллельные прямые — от солнечного, облачного и дождливого начального дня — падают от значений около 1 до примерно 3·10⁻⁷. Пунктир с наклоном 0.473 за шаг идёт вдоль них.',
      caption: 'Цепь погоды из курса теории вероятностей. По вертикали — сумма модулей разностей между распределением после t шагов и стационарным, в логарифмической шкале, для трёх начальных состояний. На логарифмической шкале все три кривые становятся прямыми с одним наклоном: за шаг расстояние умножается на |λ₂| = 0.3 + √0.03 ≈ 0.473, второе по величине собственное значение P (пунктир). Начальное состояние меняет только сдвиг прямой. Третье собственное значение, 0.127, влияет лишь на первые шаги.',
      x: 'шаг t', y: '‖πₜ − π‖₁ (лог. шкала)', s: ['из солнечного', 'из облачного', 'из дождливого'], ref: '× 0.473 за шаг',
    }
  : {
      title: 'The distance to the stationary distribution shrinks like |λ₂|ᵗ',
      desc: 'Log scale vertically, step t from 0 to 20 horizontally. Three nearly parallel lines, from a sunny, a cloudy and a rainy first day, fall from about 1 to about 3·10⁻⁷. A dashed line with slope 0.473 per step runs along them.',
      caption: 'The weather chain of the probability course. Vertically: the total absolute difference between the distribution after t steps and the stationary one, on a log scale, from three starting states. On a log scale all three curves become straight lines with one slope: each step multiplies the distance by |λ₂| = 0.3 + √0.03 ≈ 0.473, the second-largest eigenvalue of P (dashed). The starting state only shifts the line. The third eigenvalue, 0.127, matters for the first few steps only.',
      x: 'step t', y: '‖πₜ − π‖₁ (log scale)', s: ['from sunny', 'from cloudy', 'from rainy'], ref: '× 0.473 per step',
    };
const tone = ['f-amber', 'f-muted', 'f-blue'];
const dot = ['var(--fig-amber)', 'var(--muted)', 'var(--fig-blue)'];
const id = 'markov-convergence';
const layouts = [
  { cls: 'fig-wide', sfx: 'w', W: 760, H: 300, x: [80, 560], y: [34, 240], leg: [[600, 70], [600, 96], [600, 122]], refAt: 15 },
  { cls: 'fig-narrow', sfx: 'n', W: 360, H: 360, x: [62, 340], y: [40, 250], leg: [[62, 306], [62, 330], [200, 306]], refAt: 13 },
];
const ticks = [0, -2, -4, -6];
const tickText = ['1', '10⁻²', '10⁻⁴', '10⁻⁶'];
---

<Figure id={id} title={t.title} caption={t.caption}>
  {layouts.map((L) => {
    const sx = scale([0, T], L.x as [number, number]), sy = scale([-7, 0.4], [L.y[1], L.y[0]]);
    const ts = Array.from({ length: T + 1 }, (_, i) => i);
    const R = [sx(L.refAt), sy(Math.log10(ref(L.refAt)))];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {ticks.map((v) => <path class="f-grid" d={`M ${L.x[0]} ${sy(v)} H ${L.x[1]}`} />)}
        <path class="f-axis" d={`M ${L.x[0]} ${L.y[0]} V ${L.y[1]} H ${L.x[1]}`} />
        {ticks.map((v, i) => <text class="f-note" x={L.x[0] - 8} y={sy(v) + 5} text-anchor="end">{tickText[i]}</text>)}
        {[0, 5, 10, 15, 20].map((v) => <text class="f-note" x={sx(v)} y={L.y[1] + 19} text-anchor="middle">{v}</text>)}
        <text class="f-small f-t-muted" x={(L.x[0] + L.x[1]) / 2} y={L.y[1] + 40} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.x[0] - 50} y={L.y[0] - 16}>{t.y}</text>
        <path class="f-line f-red f-dash" d={polyline([[sx(0), sy(Math.log10(ref(0)))], [sx(T), sy(Math.log10(ref(T)))]])} />
        {dist.map((d, k) => (
          <g>
            <path class={`f-line ${tone[k]}`} d={polyline(ts.map((i) => [sx(i), sy(Math.log10(d[i]))]))} />
            {ts.map((i) => <circle cx={sx(i).toFixed(1)} cy={sy(Math.log10(d[i])).toFixed(1)} r="2.6" style={`fill: ${dot[k]}`} />)}
          </g>
        ))}
        <text class="f-small f-t-red f-halo" x={R[0] + 10} y={R[1] - 14}>{t.ref}</text>
        {dist.map((_, k) => (
          <g>
            <path class={`f-line ${tone[k]}`} d={`M ${L.leg[k][0]} ${L.leg[k][1] - 4} h 24`} />
            <text class="f-small" x={L.leg[k][0] + 32} y={L.leg[k][1]}>{t.s[k]}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
