---
import Figure from '../Figure.astro';
import { polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The unit square and its image under three 2 × 2 matrices of the note: A = [[4, 1], [2, 3]] (det 10),
// C = [[1, 2], [2, 1]] (det −3, the turn from the first column to the second is clockwise) and D = [[2, 1], [4, 2]] (det 0).
type V2 = [number, number];
type M2 = [[number, number], [number, number]];
const det = (m: M2) => m[0][0] * m[1][1] - m[0][1] * m[1][0];
const col = (m: M2, j: number): V2 => [m[0][j], m[1][j]];
const shoelace = (p: V2[]) => p.reduce((s, q, i) => { const r = p[(i + 1) % p.length]; return s + q[0] * r[1] - r[0] * q[1]; }, 0) / 2;
const mats: { key: string; m: M2 }[] = [
  { key: 'A', m: [[4, 1], [2, 3]] },
  { key: 'C', m: [[1, 2], [2, 1]] },
  { key: 'D', m: [[2, 1], [4, 2]] },
];
const info = mats.map(({ key, m }) => {
  const a1 = col(m, 0), a2 = col(m, 1);
  const quad: V2[] = [[0, 0], a1, [a1[0] + a2[0], a1[1] + a2[1]], a2];
  return { key, m, a1, a2, quad, d: det(m), area: shoelace(quad) };
});
if (info.map((i) => i.d).join() !== '10,-3,0') throw new Error('DeterminantArea: determinants drifted from the note');
if (info.some((i) => Math.abs(i.area - i.d) > 1e-12)) throw new Error('DeterminantArea: signed area differs from the determinant');

const s = 34; // pixels per unit, the same in every panel so the areas can be compared
const name = (k: string, j: number) => `${k}e${j === 1 ? '₁' : '₂'}`;
const vec = (v: V2) => `(${v[0]}, ${v[1]})`;
const minus = (x: number) => String(x).replace('-', '−');
type Lab = { dx: number; dy: number; anchor: 'start' | 'end' | 'middle'; short?: boolean };
type Panel = { o: V2; xr: V2; yr: V2; l1: Lab; l2: Lab; area: V2; title: V2 };
const layouts: { cls: string; W: number; H: number; sfx: string; P: Panel[] }[] = [
  {
    cls: 'fig-wide', W: 760, H: 292, sfx: 'w',
    P: [
      { o: [44, 232], xr: [-0.4, 5.4], yr: [-0.6, 5.6], l1: { dx: 8, dy: 5, anchor: 'start' }, l2: { dx: 8, dy: 5, anchor: 'start' }, area: [2.4, 1.9], title: [2.5, -1.3] },
      { o: [336, 232], xr: [-0.4, 3.4], yr: [-0.6, 3.6], l1: { dx: -8, dy: -4, anchor: 'end' }, l2: { dx: 8, dy: 5, anchor: 'start' }, area: [1.5, 1.5], title: [1.5, -1.3] },
      { o: [560, 232], xr: [-0.4, 3.4], yr: [-0.6, 6.4], l1: { dx: 9, dy: 5, anchor: 'start' }, l2: { dx: 9, dy: 8, anchor: 'start' }, area: [3, 6], title: [1.5, -1.3] },
    ],
  },
  {
    cls: 'fig-narrow', W: 360, H: 548, sfx: 'n',
    P: [
      { o: [52, 210], xr: [-0.4, 5.4], yr: [-0.6, 5.6], l1: { dx: 8, dy: 5, anchor: 'start' }, l2: { dx: 8, dy: 5, anchor: 'start' }, area: [2.4, 1.9], title: [2.5, -1.3] },
      { o: [36, 490], xr: [-0.4, 3.4], yr: [-0.6, 3.6], l1: { dx: -8, dy: -4, anchor: 'end', short: true }, l2: { dx: 8, dy: 5, anchor: 'start', short: true }, area: [1.5, 1.5], title: [1.5, -1.3] },
      { o: [214, 490], xr: [-0.4, 3.4], yr: [-0.6, 6.4], l1: { dx: 9, dy: 5, anchor: 'start', short: true }, l2: { dx: 9, dy: 8, anchor: 'start', short: true }, area: [3, 6], title: [1.5, -1.3] },
    ],
  },
];
// Orientation arcs from the direction of the first column to the second, radius 1.35 units.
const arc = (a1: V2, a2: V2, X: (v: V2) => V2) => {
  const t1 = Math.atan2(a1[1], a1[0]), t2 = Math.atan2(a2[1], a2[0]);
  const pts: V2[] = Array.from({ length: 25 }, (_, i) => { const t = t1 + ((t2 - t1) * i) / 24; return X([1.35 * Math.cos(t), 1.35 * Math.sin(t)]); });
  return polyline(pts);
};
const areaText = (d: number) => (ru ? `площадь ${Math.abs(d)}` : `area ${Math.abs(d)}`);
const titleText = (k: string, d: number) => `det ${k} = ${minus(d)}`;
const t = ru
  ? {
      title: 'Определитель — множитель, на который отображение меняет площадь',
      desc: 'Три панели. В каждой синий единичный квадрат и жёлтый параллелограмм, натянутый на столбцы матрицы. Слева: A со столбцами (4, 2) и (1, 3), площадь 10, поворот от первого столбца ко второму против часовой стрелки, det A = 10. В центре: C со столбцами (1, 2) и (2, 1), площадь 3, поворот по часовой стрелке, det C = −3. Справа: D со столбцами (2, 4) и (1, 2), лежащими на одной прямой; квадрат сплющен в отрезок, det D = 0.',
      caption: 'Единичный квадрат (синий, площадь 1) и его образ (жёлтый): параллелограмм, натянутый на столбцы матрицы, то есть на образы e₁ и e₂. Масштаб во всех панелях одинаковый. A = [[4, 1], [2, 3]] увеличивает каждую площадь в 10 раз и сохраняет ориентацию: дуга от первого столбца ко второму идёт против часовой стрелки, как от e₁ к e₂. C = [[1, 2], [2, 1]] увеличивает площадь в 3 раза и переворачивает ориентацию, как зеркало: det C = −3. Столбцы D = [[2, 1], [4, 2]] параллельны, квадрат сплющивается в отрезок, det D = 0, и обратного отображения нет.',
    }
  : {
      title: 'The determinant is the factor by which a map scales area',
      desc: 'Three panels, each with a blue unit square and an amber parallelogram spanned by the columns of a matrix. Left: A with columns (4, 2) and (1, 3), area 10, the turn from the first column to the second counterclockwise, det A = 10. Middle: C with columns (1, 2) and (2, 1), area 3, the turn clockwise, det C = −3. Right: D with columns (2, 4) and (1, 2) on one line; the square is flattened onto a segment, det D = 0.',
      caption: 'The unit square (blue, area 1) and its image (amber): the parallelogram spanned by the columns of the matrix, which are the images of e₁ and e₂. All panels use the same scale. A = [[4, 1], [2, 3]] multiplies every area by 10 and keeps the orientation: the arc from the first column to the second runs counterclockwise, like the turn from e₁ to e₂. C = [[1, 2], [2, 1]] multiplies areas by 3 and reverses the orientation, as a mirror does: det C = −3. The columns of D = [[2, 1], [4, 2]] are parallel, the square is flattened onto a segment, det D = 0, and there is no inverse.',
    };
const id = 'det-area';
---

<Figure id={id} title={t.title} caption={t.caption}>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
      {info.map((I, k) => {
        const p = L.P[k];
        const X = (v: V2): V2 => [p.o[0] + s * v[0], p.o[1] - s * v[1]];
        const gx = Array.from({ length: Math.floor(p.xr[1]) + 1 }, (_, i) => i);
        const gy = Array.from({ length: Math.floor(p.yr[1]) + 1 }, (_, i) => i);
        const T1 = X(I.a1), T2 = X(I.a2), A = X(p.area), Ti = X(p.title);
        const flat = I.d === 0;
        return (
          <g>
            {gx.map((i) => <path class="f-grid" d={`M ${X([i, p.yr[0]])[0]} ${X([i, p.yr[0]])[1]} V ${X([i, p.yr[1]])[1]}`} />)}
            {gy.map((i) => <path class="f-grid" d={`M ${X([p.xr[0], i])[0]} ${X([p.xr[0], i])[1]} H ${X([p.xr[1], i])[0]}`} />)}
            <path class="f-axis" d={`M ${X([p.xr[0], 0])[0]} ${X([0, 0])[1]} H ${X([p.xr[1], 0])[0]} M ${X([0, 0])[0]} ${X([0, p.yr[0]])[1]} V ${X([0, p.yr[1]])[1]}`} />
            <path class="f-fill-blue" d={polyline([[0, 0], [1, 0], [1, 1], [0, 1]].map((v) => X(v as V2))) + ' Z'} style="stroke: var(--fig-blue); stroke-width: 1.2" />
            {flat
              ? <path class="f-line f-amber f-bold" d={polyline([X(I.quad[0]), X(I.quad[2])])} />
              : <path class="f-fill-amber" d={polyline(I.quad.map(X)) + ' Z'} style="stroke: var(--fig-amber); stroke-width: 1.4" />}
            <path class="f-line f-red" d={polyline([X([0, 0]), T1])} marker-end="url(#f-arrow-red)" />
            <path class="f-line f-green" d={polyline([X([0, 0]), T2])} marker-end="url(#f-arrow-green)" />
            {!flat && <path class="f-thin f-muted" d={arc(I.a1, I.a2, X)} marker-end="url(#f-arrow-muted)" />}
            <text class="f-small f-t-red f-halo" x={T1[0] + p.l1.dx} y={T1[1] + p.l1.dy} text-anchor={p.l1.anchor}>{p.l1.short ? vec(I.a1) : `${name(I.key, 1)} = ${vec(I.a1)}`}</text>
            <text class="f-small f-t-green f-halo" x={T2[0] + p.l2.dx} y={T2[1] + p.l2.dy} text-anchor={p.l2.anchor}>{p.l2.short ? vec(I.a2) : `${name(I.key, 2)} = ${vec(I.a2)}`}</text>
            <text class="f-small f-t-amber f-halo" x={flat ? A[0] - 8 : A[0]} y={A[1] + 4} text-anchor={flat ? 'end' : 'middle'}>{areaText(I.d)}</text>
            <text class="f-label" x={Ti[0]} y={Ti[1] + 5} text-anchor="middle">{titleText(I.key, I.d)}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
