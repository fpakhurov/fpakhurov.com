---
import Figure from '../Figure.astro';
import { polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A = [[4, 1], [2, 3]]: characteristic polynomial λ² − 7λ + 10, eigenvalues 5 and 2, eigenvectors (1, 1) and (1, −2).
// The unit circle is mapped to an ellipse; unit vectors on the two eigen-lines stay on their lines, e₁ is turned.
type V2 = [number, number];
const A = [[4, 1], [2, 3]];
const ap = (v: V2): V2 => [A[0][0] * v[0] + A[0][1] * v[1], A[1][0] * v[0] + A[1][1] * v[1]];
const tr = A[0][0] + A[1][1], dt = A[0][0] * A[1][1] - A[0][1] * A[1][0];
const disc = Math.sqrt(tr * tr - 4 * dt);
const lam = [(tr + disc) / 2, (tr - disc) / 2];
const unit = (v: V2): V2 => { const n = Math.hypot(v[0], v[1]); return [v[0] / n, v[1] / n]; };
const v1 = unit([1, 1]), v2 = unit([1, -2]);
const Av1 = ap(v1), Av2 = ap(v2), e1: V2 = [1, 0], Ae1 = ap(e1);
const off = (v: V2, w: V2, l: number) => Math.hypot(w[0] - l * v[0], w[1] - l * v[1]);
if (lam.join() !== '5,2' || off(v1, Av1, 5) + off(v2, Av2, 2) > 1e-12) throw new Error('EigenDirections: eigenpairs drifted from the note');
if (Ae1.join() !== '4,2') throw new Error('EigenDirections: A e1 drifted from the note');
const turn = (Math.atan2(Ae1[1], Ae1[0]) * 180) / Math.PI;
if (turn.toFixed(1) !== '26.6') throw new Error('EigenDirections: the turn of e1 drifted from the caption');
const circle: V2[] = Array.from({ length: 181 }, (_, i) => { const t = (2 * Math.PI * i) / 180; return [Math.cos(t), Math.sin(t)]; });
const ellipse = circle.map(ap);

const t = ru
  ? {
      title: 'Собственные векторы: направления, которые отображение только растягивает',
      desc: 'Единичная окружность (пунктир) и её образ под действием A = [[4, 1], [2, 3]] — эллипс. Синяя прямая вдоль (1, 1): единичный вектор v₁ переходит в 5v₁ на той же прямой. Зелёная прямая вдоль (1, −2): v₂ переходит в 2v₂. Красный вектор e₁ переходит в (4, 2) и поворачивается на 26.6 градуса.',
      caption: 'A = [[4, 1], [2, 3]] переводит единичную окружность (пунктир) в эллипс. e₁ переходит в (4, 2), повернувшись на 26.6°. Прямые вдоль (1, 1) и (1, −2) не поворачиваются: v₁ переходит в 5v₁, а v₂ — в 2v₂. Два собственных вектора не ортогональны.',
      v1: 'Av₁ = 5v₁', v2: 'Av₂ = 2v₂', x: 'x = e₁', ax: 'Ax = (4, 2)',
    }
  : {
      title: 'Eigenvectors: the directions a map only stretches',
      desc: 'The unit circle (dashed) and its image under A = [[4, 1], [2, 3]], an ellipse. Blue line along (1, 1): the unit vector v₁ goes to 5v₁ on the same line. Green line along (1, −2): v₂ goes to 2v₂. The red vector e₁ goes to (4, 2) and is turned by 26.6 degrees.',
      caption: 'A = [[4, 1], [2, 3]] maps the unit circle (dashed) onto an ellipse. e₁ goes to (4, 2), turned by 26.6°. The lines along (1, 1) and (1, −2) are not turned: v₁ goes to 5v₁ and v₂ to 2v₂. The two eigenvectors are not orthogonal.',
      v1: 'Av₁ = 5v₁', v2: 'Av₂ = 2v₂', x: 'x = e₁', ax: 'Ax = (4, 2)',
    };
const short = { v1: '5v₁', v2: '2v₂', x: 'x', ax: 'Ax' };
const id = 'eigen-directions';
const layouts = [
  { cls: 'fig-wide fig-medium', sfx: 'w', W: 600, H: 420, o: [300, 215] as V2, s: 46, full: true },
  { cls: 'fig-narrow', sfx: 'n', W: 360, H: 320, o: [180, 160] as V2, s: 36, full: false },
];
const xr = 4.4, yr = 3.9;
---

<Figure id={id} title={t.title} caption={t.caption}>
  {layouts.map((L) => {
    const X = (v: V2): V2 => [L.o[0] + L.s * v[0], L.o[1] - L.s * v[1]];
    const line = (d: V2, a: number, b: number) => polyline([X([a * d[0], a * d[1]]), X([b * d[0], b * d[1]])]);
    const gx = [-4, -3, -2, -1, 1, 2, 3, 4], gy = [-3, -2, -1, 1, 2, 3];
    const P = (v: V2) => X(v);
    const turnArc = polyline(Array.from({ length: 21 }, (_, i) => { const a = (turn * Math.PI / 180) * (i / 20); return X([1.7 * Math.cos(a), 1.7 * Math.sin(a)]); }));
    const lb = (v: V2) => X(v);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {gx.map((g) => <path class="f-grid" d={`M ${X([g, -yr])[0]} ${X([g, -yr])[1]} V ${X([g, yr])[1]}`} />)}
        {gy.map((g) => <path class="f-grid" d={`M ${X([-xr, g])[0]} ${X([-xr, g])[1]} H ${X([xr, g])[0]}`} />)}
        <path class="f-axis" d={`M ${X([-xr, 0])[0]} ${X([0, 0])[1]} H ${X([xr, 0])[0]} M ${X([0, 0])[0]} ${X([0, -yr])[1]} V ${X([0, yr])[1]}`} />
        <path class="f-thin f-blue f-dash" d={line(v1, -5.4, 5.4)} />
        <path class="f-thin f-green f-dash" d={line(v2, -4.3, 4.3)} />
        <path class="f-line f-muted f-dash" d={polyline(circle.map(P))} />
        <path class="f-line f-amber" d={polyline(ellipse.map(P))} />
        <path class="f-thin f-muted" d={turnArc} marker-end="url(#f-arrow-muted)" />
        <path class="f-line f-blue f-bold" d={polyline([X([0, 0]), X(Av1)])} marker-end="url(#f-arrow-blue)" />
        <path class="f-line f-green f-bold" d={polyline([X([0, 0]), X(Av2)])} marker-end="url(#f-arrow-green)" />
        <path class="f-line f-red" d={polyline([X([0, 0]), X(Ae1)])} marker-end="url(#f-arrow-red)" />
        <path class="f-line" d={polyline([X([0, 0]), X(v1)])} marker-end="url(#f-arrow)" />
        <path class="f-line" d={polyline([X([0, 0]), X(v2)])} marker-end="url(#f-arrow)" />
        <path class="f-line" d={polyline([X([0, 0]), X(e1)])} marker-end="url(#f-arrow)" />
        <text class="f-small f-halo" x={lb(v1)[0] - 8} y={lb(v1)[1] - 2} text-anchor="end">v₁</text>
        <text class="f-small f-halo" x={lb(v2)[0] - 8} y={lb(v2)[1] + 8} text-anchor="end">v₂</text>
        <text class="f-small f-halo" x={lb(e1)[0]} y={lb(e1)[1] + 18} text-anchor="middle">{L.full ? t.x : short.x}</text>
        <text class="f-small f-t-blue f-halo" x={lb(Av1)[0] + 8} y={lb(Av1)[1] + 2}>{L.full ? t.v1 : short.v1}</text>
        <text class="f-small f-t-green f-halo" x={lb(Av2)[0] + 8} y={lb(Av2)[1] + 14}>{L.full ? t.v2 : short.v2}</text>
        <text class="f-small f-t-red f-halo" x={lb(Ae1)[0] + 8} y={lb(Ae1)[1] + 5}>{L.full ? t.ax : short.ax}</text>
        <text class="f-small f-t-blue f-halo" x={X([-3.2, -3.2])[0] + 8} y={X([-3.2, -3.2])[1] + 4}>λ₁ = 5</text>
        <text class="f-small f-t-green f-halo" x={X([-1.85, 3.7])[0] + 8} y={X([-1.85, 3.7])[1] + 4}>λ₂ = 2</text>
      </svg>
    );
  })}
</Figure>
