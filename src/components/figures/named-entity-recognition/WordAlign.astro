---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// "Jimi Hendrix moved to London" as tokenized by bert-base-cased: Jimi splits into Jim ##i.
const words = [{ w: 'Jimi', tag: 'B-PER' }, { w: 'Hendrix', tag: 'I-PER' }, { w: 'moved', tag: 'O' }, { w: 'to', tag: 'O' }, { w: 'London', tag: 'B-LOC' }];
const tokens: { t: string; word: number | null }[] = [
  { t: '[CLS]', word: null }, { t: 'Jim', word: 0 }, { t: '##i', word: 0 }, { t: 'Hendrix', word: 1 },
  { t: 'moved', word: 2 }, { t: 'to', word: 3 }, { t: 'London', word: 4 }, { t: '[SEP]', word: null },
];
const first = (i: number) => tokens[i].word !== null && (i === 0 || tokens[i - 1].word !== tokens[i].word);
// Copying a tag onto a continuation piece turns B-X into I-X, so that one word stays one entity.
const allTok = tokens.map((k, i) => (k.word === null ? '−100' : first(i) ? words[k.word].tag : words[k.word].tag.replace(/^B-/, 'I-')));
const firstOnly = tokens.map((k, i) => (k.word === null || !first(i) ? '−100' : words[k.word!].tag));
const tone = (lab: string) => (lab === '−100' ? 'f-t-muted' : lab === 'O' ? '' : lab.endsWith('PER') ? 'f-t-blue' : 'f-t-green');
const t = ru
  ? { words: 'слова', tokens: 'токены', wid: 'word_ids', all: 'все части', firstR: 'только первая' }
  : { words: 'words', tokens: 'tokens', wid: 'word_ids', all: 'all pieces', firstR: 'first only' };
const id = 'ner-word-align';
// Wide geometry: one column per token.
const x0 = 120, cw = 70, gap = 4;
const cx = (i: number) => x0 + i * (cw + gap) + cw / 2;
---

<Figure
  id={id}
  title={ru ? 'Метки слов и токены-подслова' : 'Word labels and subword tokens'}
  caption={ru
    ? 'Набор данных размечает слова, а модель читает токены WordPiece. bert-base-cased разбивает Jimi на Jim и ##i, а [CLS] и [SEP] не принадлежат никакому слову. word_ids() токенизатора даёт для каждого токена номер его слова, и по нему метки переносятся на токены: специальные токены получают −100 (функция потерь их игнорирует), первая часть слова — его метку, а продолжение — либо копию метки (label_all_tokens=True; скопированная B- заменяется на I-, иначе ##i начал бы второго человека), либо −100, чтобы обучалась только первая часть. При оценке маска первых токенов оставляет один тег на слово и в предсказаниях, и в эталоне.'
    : 'The dataset labels words; the model reads WordPiece tokens. bert-base-cased splits Jimi into Jim and ##i, and [CLS] and [SEP] belong to no word. The tokenizer\'s word_ids() gives each token the index of its word, and labels are carried over by it: special tokens get −100 (the loss ignores them), the first piece of a word gets the word\'s tag, and a continuation piece gets either a copy of the tag (label_all_tokens=True; a copied B- becomes I-, or ##i would start a second person) or −100, so that only first pieces are trained. At evaluation, a first-token mask keeps one tag per word in both the predictions and the references.'}
>
  <svg class="fig-wide" viewBox="0 0 720 240" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{ru ? 'Выравнивание меток слов по токенам' : 'Aligning word labels to tokens'}</title>
    <desc id={`${id}-w-d`}>{tokens.map((k, i) => `${k.t}: ${allTok[i]} / ${firstOnly[i]}`).join('; ')}</desc>
    <text class="f-small f-t-muted" x={x0 - 14} y={32} text-anchor="end">{t.words}</text>
    <text class="f-small f-t-muted" x={x0 - 14} y={108} text-anchor="end">{t.tokens}</text>
    <text class="f-small f-t-muted" x={x0 - 14} y={170} text-anchor="end">{t.all}</text>
    <text class="f-small f-t-muted" x={x0 - 14} y={206} text-anchor="end">{t.firstR}</text>
    {words.map((w, wi) => {
      const idx = tokens.map((k, i) => (k.word === wi ? i : -1)).filter((i) => i >= 0);
      const l = cx(idx[0]) - cw / 2, r = cx(idx[idx.length - 1]) + cw / 2;
      return (
        <g>
          <rect class={w.tag === 'O' ? 'f-box' : w.tag.endsWith('PER') ? 'f-box f-fill-blue' : 'f-box f-fill-green'} x={l} y={14} width={r - l} height="26" rx="5" />
          <text class="f-small" x={(l + r) / 2} y={31} text-anchor="middle" font-family="var(--mono)">{w.w}</text>
          <text class={`f-small ${tone(w.tag)}`} x={(l + r) / 2} y={56} text-anchor="middle">{w.tag}</text>
          {idx.map((i) => <path class="f-thin f-muted" d={`M ${(l + r) / 2} ${62} L ${cx(i)} ${90}`} />)}
        </g>
      );
    })}
    {tokens.map((k, i) => (
      <g>
        <rect class={k.word === null ? 'f-box-soft' : 'f-box'} x={cx(i) - cw / 2} y={92} width={cw} height="26" rx="5" />
        <text class={`f-small${k.word === null ? ' f-t-muted' : ''}`} x={cx(i)} y={109} text-anchor="middle" font-family="var(--mono)">{k.t}</text>
        <text class="f-small f-t-muted" x={cx(i)} y={136} text-anchor="middle">{k.word === null ? 'None' : k.word}</text>
        <text class={`f-small ${tone(allTok[i])}`} x={cx(i)} y={170} text-anchor="middle">{allTok[i]}</text>
        <text class={`f-small ${tone(firstOnly[i])}`} x={cx(i)} y={206} text-anchor="middle">{firstOnly[i]}</text>
      </g>
    ))}
    <text class="f-small f-t-muted" x={x0 - 14} y={136} text-anchor="end">{t.wid}</text>
  </svg>
  <svg class="fig-narrow" viewBox="0 0 360 300" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{ru ? 'Выравнивание меток слов по токенам' : 'Aligning word labels to tokens'}</title>
    <desc id={`${id}-n-d`}>{tokens.map((k, i) => `${k.t}: ${allTok[i]} / ${firstOnly[i]}`).join('; ')}</desc>
    {[[8, t.tokens], [96, t.wid], [186, t.all], [268, t.firstR]].map(([x, label]) => <text class="f-small f-t-muted" x={x as number} y={18}>{label}</text>)}
    {tokens.map((k, i) => {
      const y = 30 + i * 32;
      const w = k.word === null ? null : words[k.word];
      return (
        <g>
          <rect class={k.word === null ? 'f-box-soft' : !w || w.tag === 'O' ? 'f-box' : w.tag.endsWith('PER') ? 'f-box f-fill-blue' : 'f-box f-fill-green'} x={8} y={y} width={78} height="24" rx="5" />
          <text class={`f-small${k.word === null ? ' f-t-muted' : ''}`} x={47} y={y + 16} text-anchor="middle" font-family="var(--mono)">{k.t}</text>
          <text class="f-small f-t-muted" x={116} y={y + 16} text-anchor="middle">{k.word === null ? 'None' : `${k.word} ${w!.w}`.slice(0, 9)}</text>
          <text class={`f-small ${tone(allTok[i])}`} x={186} y={y + 16}>{allTok[i]}</text>
          <text class={`f-small ${tone(firstOnly[i])}`} x={268} y={y + 16}>{firstOnly[i]}</text>
        </g>
      );
    })}
  </svg>
</Figure>
