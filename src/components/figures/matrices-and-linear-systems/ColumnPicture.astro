---
import Figure from '../Figure.astro';
import { polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The 2 × 2 system of the note: 2x − y = 1, x + y = 5, solution (2, 3).
// Row picture: two lines meeting at (2, 3). Column picture: 2 a1 + 3 a2 = b with a1 = (2, 1), a2 = (−1, 1), b = (1, 5).
type P2 = [number, number];
const a1: P2 = [2, 1], a2: P2 = [-1, 1], b: P2 = [1, 5];
const det = a1[0] * a2[1] - a2[0] * a1[1];
const sol: P2 = [(b[0] * a2[1] - a2[0] * b[1]) / det, (a1[0] * b[1] - b[0] * a1[1]) / det];
const mid: P2 = [2 * a1[0], 2 * a1[1]];
if (det !== 3 || sol.join() !== '2,3' || mid.join() !== '4,2' || mid[0] + 3 * a2[0] !== 1 || mid[1] + 3 * a2[1] !== 5)
  throw new Error('ColumnPicture: the system drifted from the note');

const t = ru
  ? { rows: 'строки: две прямые', cols: 'столбцы: 2a₁ + 3a₂ = b', l1: '2x − y = 1', l2: 'x + y = 5', pt: '(2, 3)', a1: 'a₁', a2: 'a₂', m: '2a₁', s: '3a₂', b: 'b = (1, 5)',
      title: 'Система 2 × 2: картина строк и картина столбцов',
      tt: 'Две картины одной системы линейных уравнений',
      desc: 'Слева: прямые 2x − y = 1 и x + y = 5 пересекаются в точке (2, 3). Справа: столбцы a₁ = (2, 1) и a₂ = (−1, 1); путь из начала координат вдоль 2a₁ в точку (4, 2), затем вдоль 3a₂ приводит в b = (1, 5).' }
  : { rows: 'rows: two lines', cols: 'columns: 2a₁ + 3a₂ = b', l1: '2x − y = 1', l2: 'x + y = 5', pt: '(2, 3)', a1: 'a₁', a2: 'a₂', m: '2a₁', s: '3a₂', b: 'b = (1, 5)',
      title: 'A 2 × 2 system: the row picture and the column picture',
      tt: 'Two pictures of one system of linear equations',
      desc: 'Left: the lines 2x − y = 1 and x + y = 5 meet at the point (2, 3). Right: the columns a₁ = (2, 1) and a₂ = (−1, 1); a path from the origin along 2a₁ to (4, 2) and then along 3a₂ arrives at b = (1, 5).' };
const caption = ru
  ? 'Система 2x − y = 1, x + y = 5. Слева: два уравнения как прямые на плоскости (x, y), которые пересекаются в точке (2, 3). Справа: столбцы a₁ = (2, 1) и a₂ = (−1, 1); путь 2a₁, а затем 3a₂ приводит в b = (1, 5).'
  : 'The system 2x − y = 1, x + y = 5. Left: the two equations as lines in the (x, y) plane, meeting at (2, 3). Right: the columns a₁ = (2, 1) and a₂ = (−1, 1); going 2a₁ and then 3a₂ reaches b = (1, 5).';

const id = 'column-picture';
type Label = { x: number; y: number; text: string; cls: string; anchor?: 'start' | 'middle' | 'end' };
// Each layout: scale s, the screen position of the origin of the row panel (o1) and of the column panel (o2), title rows.
const layouts = [
  { cls: 'fig-wide fig-bp-640', W: 760, H: 334, s: 46, o1: [92, 290] as P2, o2: [508, 290] as P2, ty: [22, 22] },
  { cls: 'fig-narrow fig-bp-640 seq-narrow', W: 360, H: 590, s: 40, o1: [108, 262] as P2, o2: [122, 556] as P2, ty: [22, 316] },
];
const draw = (L: (typeof layouts)[number]) => {
  const S1 = (p: P2): P2 => [L.o1[0] + L.s * p[0], L.o1[1] - L.s * p[1]];
  const S2 = (p: P2): P2 => [L.o2[0] + L.s * p[0], L.o2[1] - L.s * p[1]];
  const gridFor = (S: (p: P2) => P2, x0: number, x1: number) => [
    ...Array.from({ length: x1 - x0 + 1 }, (_, i) => polyline([S([x0 + i, -0.5]), S([x0 + i, 5.5])])),
    ...Array.from({ length: 6 }, (_, j) => polyline([S([x0 - 0.5, j]), S([x1 + 0.5, j])])),
  ];
  const axes1 = [polyline([S1([-0.6, 0]), S1([4.4, 0])]), polyline([S1([0, -0.6]), S1([0, 5.6])])];
  const axes2 = [polyline([S2([-1.6, 0]), S2([4.6, 0])]), polyline([S2([0, -0.6]), S2([0, 5.6])])];
  // Row picture: y = 2x − 1 for x in [0.2, 3.2] and y = 5 − x for x in [−0.4, 4.4].
  const line1 = polyline([S1([0.2, -0.6]), S1([3.2, 5.4])]);
  const line2 = polyline([S1([-0.4, 5.4]), S1([4.4, 0.6])]);
  const P = S1(sol);
  const O = S2([0, 0]), A1 = S2(a1), A2 = S2(a2), M = S2(mid), B = S2(b);
  const centre1 = S1([1.9, 0])[0], centre2 = S2([1.5, 0])[0];
  const labels: Label[] = [
    { x: centre1, y: L.ty[0], text: t.rows, cls: 'f-small', anchor: 'middle' },
    { x: centre2, y: L.ty[1], text: t.cols, cls: 'f-small', anchor: 'middle' },
    { x: S1([3.05, 5.1])[0] + 8, y: S1([3.05, 5.1])[1] + 4, text: t.l1, cls: 'f-small f-t-green' },
    { x: S1([4.0, 1.0])[0] - 6, y: S1([4.0, 1.0])[1] + 20, text: t.l2, cls: 'f-small f-t-amber', anchor: 'middle' },
    { x: P[0] + 13, y: P[1] + 5, text: t.pt, cls: 'f-small f-t-red' },
    { x: A1[0] + 2, y: A1[1] + 19, text: t.a1, cls: 'f-small f-t-green' },
    { x: A2[0] - 8, y: A2[1] + 4, text: t.a2, cls: 'f-small f-t-amber', anchor: 'end' },
    { x: M[0] + 6, y: M[1] + 18, text: t.m, cls: 'f-small f-t-green' },
    { x: S2([2.5, 3.5])[0] + 10, y: S2([2.5, 3.5])[1] + 4, text: t.s, cls: 'f-small f-t-amber' },
    { x: B[0] - 10, y: B[1] + 4, text: t.b, cls: 'f-small f-t-red', anchor: 'end' },
  ];
  return { grid1: gridFor(S1, 0, 4), grid2: gridFor(S2, -1, 4), axes1, axes2, line1, line2, P, O, A1, A2, M, B, labels };
};
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const D = draw(L);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.tt}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        {[...D.grid1, ...D.grid2].map((d) => <path class="f-grid" d={d} />)}
        {[...D.axes1, ...D.axes2].map((d) => <path class="f-axis" d={d} />)}
        <path class="f-line f-green" d={D.line1} />
        <path class="f-line f-amber" d={D.line2} />
        <circle cx={D.P[0]} cy={D.P[1]} r="4.5" class="f-solid-red" />
        <path class="f-line f-green f-dash" d={`M ${D.O[0]} ${D.O[1]} L ${D.M[0]} ${D.M[1]}`} marker-end="url(#f-arrow-green)" />
        <path class="f-line f-amber f-dash" d={`M ${D.M[0]} ${D.M[1]} L ${D.B[0]} ${D.B[1]}`} marker-end="url(#f-arrow-amber)" />
        <path class="f-line f-green f-bold" d={`M ${D.O[0]} ${D.O[1]} L ${D.A1[0]} ${D.A1[1]}`} marker-end="url(#f-arrow-green)" />
        <path class="f-line f-amber f-bold" d={`M ${D.O[0]} ${D.O[1]} L ${D.A2[0]} ${D.A2[1]}`} marker-end="url(#f-arrow-amber)" />
        <path class="f-line f-red f-bold" d={`M ${D.O[0]} ${D.O[1]} L ${D.B[0]} ${D.B[1]}`} marker-end="url(#f-arrow-red)" />
        {D.labels.map((l) => <text class={`${l.cls} f-halo`} x={l.x} y={l.y} text-anchor={l.anchor ?? 'start'}>{l.text}</text>)}
      </svg>
    );
  })}
</Figure>
