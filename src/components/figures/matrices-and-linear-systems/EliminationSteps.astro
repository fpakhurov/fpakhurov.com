---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The worked example of the note: A = [[2, 1, −1], [4, 5, −3], [−2, 5, −2]], b = (1, 5, 2), solution (1, 2, 3).
// Elimination without row exchanges is run here and checked against the numbers quoted in the text.
const A0 = [[2, 1, -1, 1], [4, 5, -3, 5], [-2, 5, -2, 2]];
const snap: number[][][] = [A0.map((r) => [...r])];
const Lm = [[1, 0, 0], [0, 1, 0], [0, 0, 1]];
const W = A0.map((r) => [...r]);
for (let k = 0; k < 2; k++) {
  for (let i = k + 1; i < 3; i++) {
    const l = W[i][k] / W[k][k];
    Lm[i][k] = l;
    for (let j = k; j < 4; j++) W[i][j] -= l * W[k][j];
  }
  snap.push(W.map((r) => [...r]));
}
const x3 = W[2][3] / W[2][2], x2 = (W[1][3] - W[1][2] * x3) / W[1][1], x1 = (W[0][3] - W[0][1] * x2 - W[0][2] * x3) / W[0][0];
const quoted = [snap[1].flat().join(), snap[2].flat().join(), Lm.flat().join(), [x1, x2, x3].join()].join(' | ');
if (quoted !== '2,1,-1,1,0,3,-1,3,0,6,-3,3 | 2,1,-1,1,0,3,-1,3,0,0,-1,-3 | 1,0,0,2,1,0,-1,2,1 | 1,2,3')
  throw new Error(`EliminationSteps: the elimination drifted from the note (${quoted})`);
const U = snap[2].map((r) => r.slice(0, 3));
const num = (v: number) => (v < 0 ? `−${-v}` : `${v}`);

const t = ru
  ? { aug: '[A | b]', op1a: 'r₂ − 2r₁', op1b: 'r₃ + r₁', op2: 'r₃ − 2r₂', piv: 'ведущие 2, 3, −1',
      back: ['−x₃ = −3, x₃ = 3', '3x₂ − 3 = 3, x₂ = 2', '2x₁ + 2 − 3 = 1, x₁ = 1'], eq: 'A =', L: 'L', U: 'U',
      steps: ['расширенная матрица [A | b]', 'столбец 1: из строки 2 вычесть 2 × строку 1, к строке 3 прибавить строку 1', 'столбец 2: из строки 3 вычесть 2 × строку 2; ведущие элементы 2, 3, −1', 'обратная подстановка с последней строки: x = (1, 2, 3)', 'множители 2, −1, 2 заполняют L, и A = LU'],
      title: 'Метод Гаусса для системы 3 × 3 и LU-разложение, которое он даёт',
      tt: 'Шаги исключения для системы 3 × 3',
      desc: 'Три расширенные матрицы: исходная, после исключения в первом столбце и после исключения во втором. Затем три строки обратной подстановки и разложение A = LU, где L содержит множители 2, −1 и 2 под единичной диагональю, а U — верхняя треугольная матрица с ведущими элементами 2, 3 и −1.' }
  : { aug: '[A | b]', op1a: 'r₂ − 2r₁', op1b: 'r₃ + r₁', op2: 'r₃ − 2r₂', piv: 'pivots 2, 3, −1',
      back: ['−x₃ = −3, x₃ = 3', '3x₂ − 3 = 3, x₂ = 2', '2x₁ + 2 − 3 = 1, x₁ = 1'], eq: 'A =', L: 'L', U: 'U',
      steps: ['the augmented matrix [A | b]', 'column 1: row 2 minus 2 × row 1, row 3 plus row 1', 'column 2: row 3 minus 2 × row 2; the pivots are 2, 3, −1', 'back substitution from the last row: x = (1, 2, 3)', 'the multipliers 2, −1, 2 fill L, and A = LU'],
      title: 'Gaussian elimination on a 3 × 3 system, and the LU factorization it produces',
      tt: 'Elimination steps for a 3 × 3 system',
      desc: 'Three augmented matrices: the original, after elimination in column 1, and after elimination in column 2. Then three lines of back substitution and the factorization A = LU, where L holds the multipliers 2, −1 and 2 below a unit diagonal and U is upper triangular with pivots 2, 3 and −1.' };
const caption = ru
  ? 'Система из текста; rᵢ — i-я строка расширенной матрицы. Каждый шаг вычитает кратные строки с ведущим элементом из строк ниже, и под ним появляются нули (зелёные). Множители 2, −1 и 2 заполняют L под диагональю; U — итоговая треугольная матрица. Нажмите ▶, чтобы пройти шаги по одному.'
  : 'The system of the text; rᵢ is row i of the augmented matrix. Each step subtracts multiples of the pivot row from the rows below it, creating the zeros in green. The multipliers 2, −1 and 2 fill L below its diagonal; U is the final triangular matrix. Press ▶ to step through.';

const id = 'elimination-steps';
type Label = { x: number; y: number; text: string; cls: string; anchor?: 'start' | 'middle' | 'end' };
type Cell = { x: number; y: number; text: string; tone: '' | 'green' | 'blue' | 'amber' };
const cw = 36, ch = 26;
// Positions (top-left corners) of the three augmented matrices, the back-substitution lines, and L, U.
const layouts = [
  { cls: 'fig-wide fig-bp-640', W: 760, H: 300, M: [[24, 52], [304, 52], [584, 52]], ops: 'side' as const, back: [24, 200], eq: [400, 222], Lx: 440, Ux: 566, LUy: 184, LUc: 34, badge: [[96, 26], [240, 26], [520, 26], [200, 212], [692, 223]] },
  { cls: 'fig-narrow fig-bp-640 seq-narrow', W: 360, H: 576, M: [[24, 40], [24, 160], [24, 280]], ops: 'below' as const, back: [24, 396], eq: [24, 496], Lx: 66, Ux: 184, LUy: 462, LUc: 34, badge: [[320, 79], [320, 199], [320, 319], [320, 410], [320, 500]] },
];
const draw = (L: (typeof layouts)[number]) => {
  const cells: Cell[] = [];
  const brackets: string[] = [];
  const bars: string[] = [];
  const mat = (vals: number[][], x: number, y: number, c: number, tone: (i: number, j: number) => Cell['tone'], aug: boolean) => {
    vals.forEach((row, i) => row.forEach((v, j) => cells.push({ x: x + j * c + c / 2, y: y + i * ch + ch / 2 + 5, text: num(v), tone: tone(i, j) })));
    const w = vals[0].length * c, h = vals.length * ch;
    brackets.push(`M ${x + 5} ${y} L ${x} ${y} L ${x} ${y + h} L ${x + 5} ${y + h}`, `M ${x + w - 5} ${y} L ${x + w} ${y} L ${x + w} ${y + h} L ${x + w - 5} ${y + h}`);
    if (aug) bars.push(`M ${x + 3 * c} ${y + 2} L ${x + 3 * c} ${y + h - 2}`);
    return { x, y, w, h };
  };
  const groups = snap.map((m, k) => {
    const [x, y] = L.M[k];
    const start = cells.length, b0 = brackets.length, r0 = bars.length;
    const box = mat(m, x, y, cw, (i, j) => (k === 1 && j === 0 && i > 0) || (k === 2 && j === 1 && i === 2) ? 'green' : k === 2 && i === j && j < 3 ? 'blue' : '', true);
    return { box, cells: [start, cells.length], brackets: [b0, brackets.length], bars: [r0, bars.length] };
  });
  const luStart = cells.length, luB = brackets.length;
  mat(Lm, L.Lx, L.LUy, L.LUc, (i, j) => (i > j ? 'amber' : ''), false);
  mat(U, L.Ux, L.LUy, L.LUc, (i, j) => (i === j ? 'blue' : ''), false);
  const lu = { cells: [luStart, cells.length], brackets: [luB, brackets.length] };
  // Arrows and the row operations: beside the arrows (wide), or beside the arrow between stacked matrices (narrow).
  const arrows: string[] = [];
  const opLabels: Label[][] = [[], []];
  for (let k = 0; k < 2; k++) {
    const a = groups[k].box, b = groups[k + 1].box;
    if (L.ops === 'side') {
      const yMid = a.y + a.h / 2;
      arrows.push(`M ${a.x + a.w + 14} ${yMid} L ${b.x - 14} ${yMid}`);
      const xm = (a.x + a.w + b.x) / 2;
      if (k === 0) opLabels[k].push({ x: xm, y: yMid - 26, text: t.op1a, cls: 'f-small f-t-amber', anchor: 'middle' }, { x: xm, y: yMid - 10, text: t.op1b, cls: 'f-small f-t-amber', anchor: 'middle' });
      else opLabels[k].push({ x: xm, y: yMid - 10, text: t.op2, cls: 'f-small f-t-amber', anchor: 'middle' });
    } else {
      const xm = a.x + a.w / 2;
      arrows.push(`M ${xm} ${a.y + a.h + 6} L ${xm} ${b.y - 8}`);
      const yMid = (a.y + a.h + b.y) / 2 + 5;
      if (k === 0) opLabels[k].push({ x: xm + 14, y: yMid - 1, text: `${t.op1a}, ${t.op1b}`, cls: 'f-small f-t-amber' });
      else opLabels[k].push({ x: xm + 14, y: yMid - 1, text: t.op2, cls: 'f-small f-t-amber' });
    }
  }
  const m3 = groups[2].box;
  const pivLabel: Label = L.ops === 'side'
    ? { x: m3.x + m3.w / 2, y: m3.y + m3.h + 22, text: t.piv, cls: 'f-small f-t-blue', anchor: 'middle' }
    : { x: m3.x + m3.w + 16, y: m3.y + m3.h / 2 + 5, text: t.piv, cls: 'f-small f-t-blue' };
  const augLabel: Label = L.ops === 'side'
    ? { x: groups[0].box.x + groups[0].box.w / 2, y: groups[0].box.y + groups[0].box.h + 22, text: t.aug, cls: 'f-small', anchor: 'middle' }
    : { x: groups[0].box.x + groups[0].box.w + 16, y: groups[0].box.y + groups[0].box.h / 2 + 5, text: t.aug, cls: 'f-small' };
  const backLabels: Label[] = t.back.map((s, i) => ({ x: L.back[0], y: L.back[1] + i * 24, text: s, cls: 'f-small' }));
  const luLabels: Label[] = [
    { x: L.eq[0], y: L.LUy + 3 * ch / 2 + 5, text: t.eq, cls: 'f-label' },
    { x: L.Lx + 1.5 * L.LUc, y: L.LUy + 3 * ch + 20, text: t.L, cls: 'f-small f-t-amber', anchor: 'middle' },
    { x: L.Ux + 1.5 * L.LUc, y: L.LUy + 3 * ch + 20, text: t.U, cls: 'f-small f-t-blue', anchor: 'middle' },
  ];
  const labels: Label[] = [augLabel, ...opLabels.flat(), pivLabel, ...backLabels, ...luLabels,
    ...cells.map((c) => ({ x: c.x, y: c.y, text: c.text, cls: 'f-small', anchor: 'middle' as const }))];
  const boxes = L.badge.map(([bx, by], i) => ({ t: `badge ${i + 1}`, x0: bx - 9.5, x1: bx + 9.5, y0: by - 9.5, y1: by + 9.5 }));
  return { cells, brackets, bars, groups, lu, arrows, opLabels, pivLabel, augLabel, backLabels, luLabels, labels, boxes };
};
const toneCls = { '': '', green: 'f-t-green', blue: 'f-t-blue', amber: 'f-t-amber' };
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const D = draw(L);
    const part = (r: number[], arr: string[]) => arr.slice(r[0], r[1]);
    const cellsOf = (r: number[]) => D.cells.slice(r[0], r[1]);
    const cellEls = (r: number[]) => cellsOf(r).map((c) => <text class={`f-small ${toneCls[c.tone]}`} style={c.tone ? 'font-weight: 650' : ''} x={c.x} y={c.y} text-anchor="middle">{c.text}</text>);
    const lbl = (l: { x: number; y: number; text: string; cls: string; anchor?: string }) => <text class={`${l.cls} f-halo`} x={l.x} y={l.y} text-anchor={l.anchor ?? 'start'}>{l.text}</text>;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.tt}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        {D.groups.map((g, k) => (
          <g data-s={String(k + 1)}>
            {part(g.brackets, D.brackets).map((d) => <path class="f-thin" d={d} />)}
            {part(g.bars, D.bars).map((d) => <path class="f-thin f-muted f-dash" d={d} />)}
            {cellEls(g.cells)}
            {k === 0 && lbl(D.augLabel)}
            {k !== 0 && <path class="f-line f-muted" d={D.arrows[k - 1]} marker-end="url(#f-arrow-muted)" />}
            {k !== 0 && D.opLabels[k - 1].map(lbl)}
            {k === 2 && lbl(D.pivLabel)}
            <Badge x={L.badge[k][0]} y={L.badge[k][1]} n={k + 1} />
          </g>
        ))}
        <g data-s="4">
          {D.backLabels.map(lbl)}
          <Badge x={L.badge[3][0]} y={L.badge[3][1]} n={4} />
        </g>
        <g data-s="5">
          {part(D.lu.brackets, D.brackets).map((d) => <path class="f-thin" d={d} />)}
          {cellEls(D.lu.cells)}
          {D.luLabels.map(lbl)}
          <Badge x={L.badge[4][0]} y={L.badge[4][1]} n={5} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
