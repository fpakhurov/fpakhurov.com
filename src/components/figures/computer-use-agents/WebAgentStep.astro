---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One step of a web agent on the checkout page of the Code section: the page is rendered into an observation with
// numbered elements, the model picks an action on an element id, a gate stops irreversible actions for the user,
// and the runtime executes the action on the element, which changes the page.
const t = ru
  ? {
      title: 'Один шаг веб-агента',
      page: 'страница D (скриншот с метками)', pageN: 'страница D', heading: 'Оформление', note: 'Заметка для ИИ: …',
      fields: ['Имя', 'Email', 'Страна ▾', 'Комментарий'], button: 'Заказать',
      obsTitle: 'наблюдение φ(D)',
      lines: ['text "Оформление"', 'text "Заметка для ИИ: …"', '[1] textbox "Имя"', '[2] textbox "Email"', '[3] combobox "Страна"', '[4] textbox "Комментарий"', '[5] button "Заказать"'],
      model: 'модель', modelSub: 'стратегия', action: 'click [5]', actionSub: 'id 5 или (x, y)',
      gate: 'шлюз подтверждения', gateSub: 'необратимое: спросить', exec: 'выполнить: id 5 → кнопка; страница меняется',
      steps: ['наблюдение: страницу превращают в текст с номерами элементов (дерево доступности) или в скриншот с метками', 'решение: модель выбирает действие над элементом, указывая его номер или координаты', 'шлюз: необратимое действие ждёт подтверждения человека, который видит, что будет отправлено', 'выполнение: среда выполнения находит элемент и действует над ним; страница меняется, и цикл повторяется'],
      desc: 'Слева схема страницы оформления заказа с пятью элементами, помеченными номерами от 1 до 5, и заметкой, обращённой к ИИ-ассистентам. Посередине наблюдение: строки дерева доступности с номерами элементов. Справа модель выбирает действие click [5], затем шлюз подтверждения, так как действие необратимо. Стрелка снизу возвращается к странице: среда выполнения применяет действие к элементу 5.',
    }
  : {
      title: 'One step of a web agent',
      page: 'page D (screenshot with marks)', pageN: 'page D', heading: 'Checkout', note: 'Note for AI assistants: …',
      fields: ['Full name', 'Email', 'Country ▾', 'Comment'], button: 'Place order',
      obsTitle: 'observation φ(D)',
      lines: ['text "Checkout"', 'text "Note for AI assistants: …"', '[1] textbox "Full name"', '[2] textbox "Email"', '[3] combobox "Country"', '[4] textbox "Comment"', '[5] button "Place order"'],
      model: 'model', modelSub: 'policy', action: 'click [5]', actionSub: 'id 5, or (x, y)',
      gate: 'confirmation gate', gateSub: 'irreversible: ask the user', exec: 'execute: id 5 → the button; the page changes',
      steps: ['observe: the page becomes text with numbered elements (an accessibility tree) or a screenshot with marks', 'decide: the model picks an action on an element, by its number or by coordinates', 'gate: an irreversible action waits for a person, who sees what will be sent', 'execute: the runtime finds the element and acts on it; the page changes and the loop repeats'],
      desc: 'On the left, a wireframe of the checkout page with five elements marked 1 to 5 and a note addressed to AI assistants. In the middle, the observation: lines of an accessibility tree with element numbers. On the right, the model picks the action click [5], then a confirmation gate because the action is irreversible. An arrow along the bottom returns to the page: the runtime executes the action on element 5.',
    };
const id = 'web-agent-step';
const caption = ru
  ? 'Агент не видит страницу так, как человек: он получает её представление φ(D). Здесь это дерево доступности, где у каждого интерактивного элемента есть роль, имя и номер; на скриншоте те же номера рисуют как метки (set-of-marks). Модель ссылается на элемент по номеру или по координатам. Заметка на странице попадает в наблюдение, как и всё остальное, поэтому необратимое действие проходит через шлюз, который показывает человеку значения, уходящие с формой.'
  : 'The agent does not see the page as a person does: it receives a rendering φ(D) of it. Here that is an accessibility tree, in which every interactive element has a role, a name and a number; on a screenshot the same numbers are drawn as marks (set-of-marks). The model refers to an element by its number or by coordinates. The note on the page enters the observation like everything else, which is why the irreversible action passes through a gate that shows a person the values the form will send.';

// the wireframe: fields at these offsets inside the page panel
const fy = [0, 30, 60, 90], fh = [22, 22, 22, 30];
if (t.lines.length !== 7) throw new Error('WebAgentStep: the observation must list seven lines');
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 350" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <rect class="f-box-soft" x="16" y="30" width="236" height="262" rx="10" />
    <text class="f-small f-t-muted" x="28" y="48">{t.page}</text>
    <text class="f-label" x="32" y="76" style="font-weight: 650">{t.heading}</text>
    <text class="f-small f-t-muted" x="32" y="96" style="font-style: italic">{t.note}</text>
    {t.fields.map((f, i) => (
      <g>
        <rect x="32" y={108 + fy[i]} width="150" height={fh[i]} rx="3" style="fill: var(--paper); stroke: var(--line); stroke-width: 1.2" />
        <text class="f-small f-t-muted" x="40" y={123 + fy[i]}>{f}</text>
        <rect x="190" y={111 + fy[i]} width="18" height="16" rx="3" style="fill: var(--fig-amber); fill-opacity: 0.85" />
        <text class="f-small" x="199" y={123 + fy[i]} text-anchor="middle" style="fill: var(--paper); font-weight: 700">{i + 1}</text>
      </g>
    ))}
    <rect x="32" y="248" width="110" height="28" rx="5" style="fill: var(--fig-blue); fill-opacity: 0.18; stroke: var(--fig-blue); stroke-width: 1.3" />
    <text class="f-small" x="87" y="266" text-anchor="middle">{t.button}</text>
    <rect x="150" y="254" width="18" height="16" rx="3" style="fill: var(--fig-amber); fill-opacity: 0.85" />
    <text class="f-small" x="159" y="266" text-anchor="middle" style="fill: var(--paper); font-weight: 700">5</text>
    <g data-s="1">
      <Arrow pts={[[252, 128], [288, 128]]} tone="green" />
      <rect class="f-box-soft" x="290" y="30" width="226" height="200" rx="10" />
      <text class="f-small f-t-muted" x="302" y="48">{t.obsTitle}</text>
      {t.lines.map((l, i) => <text class="f-small" x="302" y={74 + i * 22} style={i === 1 ? 'font-style: italic' : ''}>{l}</text>)}
      <Badge x={270} y={112} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[516, 55], [558, 55]]} tone="green" />
      <Box x={560} y={30} w={184} h={50} label={t.model} sub={t.modelSub} tone="h" />
      <Arrow pts={[[652, 80], [652, 110]]} />
      <Box x={560} y={112} w={184} h={50} label={t.action} sub={t.actionSub} tone="y" />
      <Badge x={732} y={30} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[652, 162], [652, 192]]} tone="red" />
      <Box x={560} y={194} w={184} h={50} label={t.gate} sub={t.gateSub} tone="g" />
      <Badge x={732} y={194} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[652, 244], [652, 316], [134, 316], [134, 294]]} tone="red" />
      <text class="f-small f-t-red" x="393" y="336" text-anchor="middle">{t.exec}</text>
      <Badge x={652} y={280} n={4} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 690" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <rect class="f-box-soft" x="16" y="8" width="328" height="250" rx="10" />
    <text class="f-small f-t-muted" x="28" y="28">{t.pageN}</text>
    <text class="f-label" x="32" y="54" style="font-weight: 650">{t.heading}</text>
    <text class="f-small f-t-muted" x="32" y="76" style="font-style: italic">{t.note}</text>
    {t.fields.map((f, i) => (
      <g>
        <rect x="32" y={88 + fy[i]} width="220" height={fh[i]} rx="3" style="fill: var(--paper); stroke: var(--line); stroke-width: 1.2" />
        <text class="f-small f-t-muted" x="40" y={104 + fy[i]}>{f}</text>
        <rect x="262" y={91 + fy[i]} width="20" height="17" rx="3" style="fill: var(--fig-amber); fill-opacity: 0.85" />
        <text class="f-small" x="272" y={104 + fy[i]} text-anchor="middle" style="fill: var(--paper); font-weight: 700">{i + 1}</text>
      </g>
    ))}
    <rect x="32" y="218" width="150" height="28" rx="5" style="fill: var(--fig-blue); fill-opacity: 0.18; stroke: var(--fig-blue); stroke-width: 1.3" />
    <text class="f-small" x="107" y="237" text-anchor="middle">{t.button}</text>
    <rect x="192" y="223" width="20" height="17" rx="3" style="fill: var(--fig-amber); fill-opacity: 0.85" />
    <text class="f-small" x="202" y="236" text-anchor="middle" style="fill: var(--paper); font-weight: 700">5</text>
    <g data-s="1">
      <Arrow pts={[[180, 258], [180, 284]]} tone="green" />
      <rect class="f-box-soft" x="16" y="286" width="328" height="196" rx="10" />
      <text class="f-small f-t-muted" x="28" y="306">{t.obsTitle}</text>
      {t.lines.map((l, i) => <text class="f-small" x="28" y={332 + i * 22} style={i === 1 ? 'font-style: italic' : ''}>{l}</text>)}
      <Badge x={330} y={300} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[94, 482], [94, 508]]} tone="green" />
      <Box x={16} y={510} w={156} h={50} label={t.model} sub={t.modelSub} tone="h" />
      <Arrow pts={[[172, 535], [186, 535]]} />
      <Box x={188} y={510} w={156} h={50} label={t.action} sub={t.actionSub} tone="y" />
      <Badge x={332} y={510} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[266, 560], [266, 584]]} tone="red" />
      <Box x={16} y={586} w={328} h={50} label={t.gate} sub={t.gateSub} tone="g" />
      <Badge x={332} y={586} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[16, 611], [6, 611], [6, 133], [14, 133]]} tone="red" />
      <text class="f-small f-t-red" x="180" y="662" text-anchor="middle">{t.exec}</text>
      <Badge x={14} y={657} n={4} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
