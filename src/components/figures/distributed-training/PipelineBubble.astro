---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A GPipe schedule on p = 4 pipeline stages: all m micro-batches go forward through the stages, then all go
// backward, then the optimizer step. A forward pass of one micro-batch on one stage takes 1 time unit, a backward
// pass 2. Each stage works in order and waits for its input from the neighbouring stage. The idle slots are the
// bubble; the simulation checks that its share of the time is (p - 1) / (m + p - 1).
const p = 4, tf = 1, tb = 2;
interface Op { stage: number; mb: number; kind: 'F' | 'B'; start: number; end: number }
function schedule(m: number) {
  const ops: Op[] = [];
  const done = new Map<string, number>();
  const free = Array(p).fill(0);
  // forward: micro-batch j on stage i needs stage i - 1 to have finished it
  for (let j = 0; j < m; j++) for (let i = 0; i < p; i++) {
    const ready = i === 0 ? 0 : done.get(`F${i - 1}.${j}`)!;
    const start = Math.max(ready, free[i]);
    free[i] = start + tf; done.set(`F${i}.${j}`, start + tf);
    ops.push({ stage: i, mb: j, kind: 'F', start, end: start + tf });
  }
  // backward, last micro-batch first: stage i needs stage i + 1 to have finished it (the last stage, its own forward)
  for (let j = m - 1; j >= 0; j--) for (let i = p - 1; i >= 0; i--) {
    const ready = i === p - 1 ? done.get(`F${i}.${j}`)! : done.get(`B${i + 1}.${j}`)!;
    const start = Math.max(ready, free[i]);
    free[i] = start + tb; done.set(`B${i}.${j}`, start + tb);
    ops.push({ stage: i, mb: j, kind: 'B', start, end: start + tb });
  }
  const span = Math.max(...free);
  const busy = m * (tf + tb);
  const bubble = 1 - busy / span;
  if (span !== (m + p - 1) * (tf + tb)) throw new Error(`span ${span} for m = ${m}`);
  if (Math.abs(bubble - (p - 1) / (m + p - 1)) > 1e-12) throw new Error(`bubble ${bubble} for m = ${m}`);
  return { m, ops, span, bubble };
}
const runs = [schedule(4), schedule(8)];
const pct = (x: number) => `${Math.round(100 * x)}%`;
if (pct(runs[0].bubble) !== '43%' || pct(runs[1].bubble) !== '27%') throw new Error('rounded bubbles');
const T = runs[1].span;   // the common time axis

const t = ru
  ? {
      title: 'Пузырь конвейерного параллелизма: расписание GPipe на четырёх стадиях',
      stage: (i: number) => `стадия ${i + 1}`, stageN: (i: number) => `с${i + 1}`,
      head: (m: number, b: number) => `m = ${m} микробатчей: простой ${pct(b)} = (p − 1)/(m + p − 1)`,
      headN: (m: number, b: number) => `m = ${m}: простой ${pct(b)}`,
      legend: ['прямой проход', 'обратный', 'простой'], time: 'время →',
      steps: [
        'прямые проходы: микробатч проходит стадии по очереди, стадии вступают одна за другой',
        'обратные проходы идут в обратном порядке и вдвое дольше',
        'серые клетки — простой: каждая стадия ждёт p − 1 слотов в начале и в конце',
        'вдвое больше микробатчей — тот же простой по краям, но доля его меньше: 27% вместо 43%',
      ],
      desc: 'Две диаграммы Ганта по четыре строки — стадии конвейера. Сверху четыре микробатча: прямые проходы лесенкой спускаются по стадиям, затем обратные поднимаются; серые промежутки в начале и в конце — простой, 43% времени. Снизу восемь микробатчей: те же промежутки, но 27% времени.',
    }
  : {
      title: 'The pipeline bubble: a GPipe schedule on four stages',
      stage: (i: number) => `stage ${i + 1}`, stageN: (i: number) => `s${i + 1}`,
      head: (m: number, b: number) => `m = ${m} micro-batches: idle ${pct(b)} = (p − 1)/(m + p − 1)`,
      headN: (m: number, b: number) => `m = ${m}: idle ${pct(b)}`,
      legend: ['forward', 'backward', 'idle'], time: 'time →',
      steps: [
        'forward passes: a micro-batch goes through the stages in turn, so the stages start one after another',
        'backward passes run in the opposite order and take twice as long',
        'grey slots are the bubble: every stage waits p − 1 slots at the start and at the end',
        'twice as many micro-batches: the same idle slots at the edges, but a smaller share, 27% instead of 43%',
      ],
      desc: 'Two Gantt charts of four rows, the pipeline stages. Top, four micro-batches: forward passes step down the stages like a staircase, then backward passes step back up; grey gaps at the start and the end are idle, 43% of the time. Bottom, eight micro-batches: the same gaps, now 27% of the time.',
    };
const id = 'pipeline-bubble';
const caption = ru
  ? `Модель разрезана на p = ${p} стадии по слоям, каждая на своей видеокарте; батч разбит на m микробатчей. Прямой проход микробатча на стадии занимает 1 единицу времени, обратный — 2. Каждая стадия занята m(t_f + t_b), а весь шаг длится (m + p − 1)(t_f + t_b), так что доля простоя равна (p − 1)/(m + p − 1): ${pct(runs[0].bubble)} при m = 4 и ${pct(runs[1].bubble)} при m = 8. В широкой версии числа в клетках — номера микробатчей.`
  : `The model is cut by layers into p = ${p} stages, each on its own GPU, and the batch into m micro-batches. A forward pass of one micro-batch on one stage takes 1 time unit, a backward pass 2. Each stage is busy for m(t_f + t_b), while the whole step takes (m + p − 1)(t_f + t_b), so the idle share is (p − 1)/(m + p − 1): ${pct(runs[0].bubble)} with m = 4 and ${pct(runs[1].bubble)} with m = 8. In the wide layout, numbers in the cells are micro-batch indices.`;

interface L { cls: string; W: number; H: number; x0: number; x1: number; top: number[]; row: number; sans: number; wide: boolean }
const layouts: L[] = [
  { cls: 'fig-wide', W: 760, H: 312, x0: 70, x1: 750, top: [62, 196], row: 22, sans: 6.5, wide: true },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 380, x0: 34, x1: 352, top: [70, 232], row: 24, sans: 7.3, wide: false },
];
const fits = (s: string, room: number, px: number) => {
  if (s.length * px > room) throw new Error(`"${s}" needs ${Math.round(s.length * px)} px, has ${room}`);
};
const geo = layouts.map((L) => {
  const unit = (L.x1 - L.x0) / T;
  // a digit needs about 7 px wide; narrow layouts drop the digits of the 8-micro-batch chart
  const digits = runs.map(() => unit * tf >= (L.wide ? 14 : 16));
  runs.forEach((r) => fits(L.wide ? t.head(r.m, r.bubble) : t.headN(r.m, r.bubble), L.x0 + r.span * unit - 30 - L.x0, L.sans));
  for (let i = 0; i < p; i++) fits(L.wide ? t.stage(i) : t.stageN(i), L.x0 - 8, L.sans);
  return { unit, digits };
});
const legendX = (L: L) => {
  const xs: number[] = [];
  let x = L.wide ? 420 : 12;
  for (const s of t.legend) { xs.push(x); x += 20 + s.length * L.sans + 16; }
  if (x - 16 > L.W - 4) throw new Error(`legend at ${L.W}`);
  return xs;
};
const fillOf = { F: 'var(--fig-blue)', B: 'var(--fig-red)' } as const;
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L, li) => {
    const g = geo[li];
    const lx = legendX(L);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        {t.legend.map((s, k) => (
          <g>
            <rect x={lx[k]} y={(L.wide ? 18 : 18) - 10} width="14" height="12" style={k === 2 ? 'fill: var(--muted); fill-opacity: 0.14; stroke: var(--line)' : `fill: ${k === 0 ? fillOf.F : fillOf.B}; fill-opacity: 0.45; stroke: ${k === 0 ? fillOf.F : fillOf.B}`} />
            <text class="f-small f-t-muted" x={lx[k] + 20} y={18}>{s}</text>
          </g>
        ))}
        {runs.map((r, ri) => {
          const y0 = L.top[ri];
          const x = (tt: number) => L.x0 + tt * g.unit;
          return (
            <g data-s={ri === 0 ? undefined : '4'}>
              <text class="f-small" x={L.x0} y={y0 - 10} style="font-weight: 650">{L.wide ? t.head(r.m, r.bubble) : t.headN(r.m, r.bubble)}</text>
              {Array.from({ length: p }, (_, i) => (
                <g>
                  <rect x={x(0)} y={y0 + i * L.row} width={x(r.span) - x(0)} height={L.row - 3} data-s={ri === 0 ? '3' : undefined} style="fill: var(--muted); fill-opacity: 0.14; stroke: var(--line); stroke-width: 0.8" />
                  <text class="f-small f-t-muted" x={L.x0 - 6} y={y0 + i * L.row + L.row / 2 + 3} text-anchor="end">{L.wide ? t.stage(i) : t.stageN(i)}</text>
                </g>
              ))}
              {r.ops.map((o) => (
                <g data-s={ri === 0 ? (o.kind === 'F' ? '1' : '2') : undefined}>
                  <rect x={x(o.start) + 0.6} y={y0 + o.stage * L.row} width={x(o.end) - x(o.start) - 1.2} height={L.row - 3} style={`fill: ${fillOf[o.kind]}; fill-opacity: 0.45; stroke: ${fillOf[o.kind]}; stroke-width: 1`} />
                  {g.digits[ri] && <text class="f-small" x={(x(o.start) + x(o.end)) / 2} y={y0 + o.stage * L.row + L.row / 2 + 3} text-anchor="middle">{o.mb + 1}</text>}
                </g>
              ))}
              {ri === 0 && <g data-s="1"><Badge x={L.x0 - 14} y={y0 - 14} n={1} /></g>}
              {ri === 0 && <g data-s="2"><Badge x={x(r.m * tf + (p - 1) * tf) + 10} y={y0 + p * L.row + 12} n={2} /></g>}
              {ri === 0 && <g data-s="3"><Badge x={x(r.span) - 12} y={y0 + p * L.row + 12} n={3} /></g>}
              {ri === 1 && <Badge x={x(r.span) - 12} y={y0 - 14} n={4} />}
            </g>
          );
        })}
        <text class="f-small f-t-muted" x={L.x1} y={L.H - 6} text-anchor="end">{t.time}</text>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
