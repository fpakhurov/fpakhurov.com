---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Memory per GPU for the model states of mixed-precision Adam (Rajbhandari et al., 2020): 2 bytes per parameter of
// fp16/bf16 weights, 2 of gradients, 12 of optimizer states (fp32 master weights, momentum and variance).
// Psi = 7e9 parameters, N = 8 GPUs; activations and buffers are not included. GB = 1e9 bytes.
const Psi = 7e9, N = 8, GB = 1e9, gpu = 80;
const stages = [
  { en: 'DDP', ru: 'DDP', p: 2, g: 2, o: 12 },
  { en: 'ZeRO-1', ru: 'ZeRO-1', p: 2, g: 2, o: 12 / N },
  { en: 'ZeRO-2', ru: 'ZeRO-2', p: 2, g: 2 / N, o: 12 / N },
  { en: 'ZeRO-3 / FSDP', ru: 'ZeRO-3 / FSDP', p: 2 / N, g: 2 / N, o: 12 / N },
];
const bars = stages.map((s) => {
  const parts = [s.p, s.g, s.o].map((b) => (b * Psi) / GB);
  const total = parts.reduce((a, b) => a + b, 0);
  const perParam = s.p + s.g + s.o;                      // bytes per parameter per GPU
  return { ...s, parts, total, maxModel: gpu / perParam };   // billions of parameters that fit in 80 GB
});
// The numbers of the text: 112, 38.5, 26.25 and 14 GB; 5.0, 14.5, 21.3 and 40 billion parameters.
const want = [112, 38.5, 26.25, 14];
bars.forEach((b, i) => { if (Math.abs(b.total - want[i]) > 1e-9) throw new Error(`${b.en}: ${b.total}`); });
const fitsWant = ['5.0', '14.5', '21.3', '40.0'];
bars.forEach((b, i) => { if (b.maxModel.toFixed(1) !== fitsWant[i]) throw new Error(`${b.en} max ${b.maxModel}`); });
const gbText = (v: number) => (Number.isInteger(v) ? String(v) : v.toFixed(v * 100 % 10 === 0 ? 1 : 2));

const t = ru
  ? {
      title: 'Память на одну видеокарту: модель на 7 млрд параметров, 8 видеокарт, Adam со смешанной точностью',
      parts: ['веса fp16/bf16', 'градиенты', 'состояния оптимизатора'], gpu: '80 ГБ видеокарты', y: 'ГБ на видеокарту',
      fits: (v: string) => `до ${v} млрд`, fitsNote: 'наибольшая модель, которая помещается, млрд',
      desc: 'Столбчатая диаграмма с накоплением. DDP: 14 ГБ весов, 14 ГБ градиентов, 84 ГБ состояний оптимизатора, всего 112 ГБ, выше линии 80 ГБ. ZeRO-1: 38.5 ГБ. ZeRO-2: 26.25 ГБ. ZeRO-3: 14 ГБ. Под столбцами — наибольшая модель, которая поместилась бы в 80 ГБ без учёта активаций: 5, 14.5, 21.3 и 40 млрд параметров.',
    }
  : {
      title: 'Memory per GPU: a 7-billion-parameter model on 8 GPUs, mixed-precision Adam',
      parts: ['fp16/bf16 weights', 'gradients', 'optimizer states'], gpu: '80 GB GPU', y: 'GB per GPU',
      fits: (v: string) => `fits ≤ ${v}B`, fitsNote: 'largest model that fits, billions',
      desc: 'A stacked bar chart. DDP: 14 GB of weights, 14 GB of gradients, 84 GB of optimizer states, 112 GB in all, above an 80 GB line. ZeRO-1: 38.5 GB. ZeRO-2: 26.25 GB. ZeRO-3: 14 GB. Under the bars, the largest model that would fit in 80 GB without activations: 5, 14.5, 21.3 and 40 billion parameters.',
    };
const id = 'zero-memory';
const caption = ru
  ? `Состояния модели при обучении Adam со смешанной точностью — 16 байт на параметр: 2 на веса, 2 на градиенты и 12 на fp32-копию весов, первый и второй моменты. Обычный параллелизм по данным (DDP) хранит все 16 на каждой из ${N} видеокарт: ${bars[0].total} ГБ, больше 80 ГБ. ZeRO-1 делит между видеокартами состояния оптимизатора, ZeRO-2 — ещё и градиенты, ZeRO-3 (и FSDP) — ещё и веса, и память падает до 16Ψ/N = ${bars[3].total} ГБ. Под столбцами — наибольшая модель, состояния которой поместились бы в 80 ГБ. Активации, буферы связи и фрагментация не учтены; ГБ = 10⁹ байт.`
  : `The model states of mixed-precision Adam take 16 bytes per parameter: 2 for the weights, 2 for the gradients and 12 for the fp32 master weights, first and second moments. Plain data parallelism (DDP) keeps all 16 on each of the ${N} GPUs: ${bars[0].total} GB, more than 80 GB. ZeRO-1 partitions the optimizer states across the GPUs, ZeRO-2 the gradients as well, ZeRO-3 (and FSDP) the weights too, and memory falls to 16Ψ/N = ${bars[3].total} GB. Under the bars, the largest model whose states would fit in 80 GB. Activations, communication buffers and fragmentation are not included; GB = 10⁹ bytes.`;

const fill = ['var(--fig-blue)', 'var(--fig-amber)', 'var(--fig-red)'];
interface L { cls: string; W: number; H: number; x0: number; x1: number; yT: number; yB: number; sans: number; legend: [number, number][]; bw: number }
const layouts: L[] = [
  { cls: 'fig-wide', W: 760, H: 330, x0: 64, x1: 560, yT: 30, yB: 268, sans: 6.5, legend: [[580, 60], [580, 84], [580, 108]], bw: 70 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 450, x0: 48, x1: 352, yT: 92, yB: 368, sans: 7.3, legend: [[12, 18], [190, 18], [12, 42]], bw: 52 },
];
const yMax = 120;
const fitsText = (s: string, room: number, px: number) => {
  if (s.length * px > room) throw new Error(`"${s}" needs ${Math.round(s.length * px)} px, has ${room}`);
};
const name = (b: (typeof bars)[number], wide: boolean) => (wide ? (ru ? b.ru : b.en) : b.en.split(' ')[0]);
const fitsLabel = (b: (typeof bars)[number], wide: boolean) => (wide ? t.fits(b.maxModel.toFixed(1)) : `≤ ${b.maxModel.toFixed(1)}`);
const geo = layouts.map((L) => {
  const slot = (L.x1 - L.x0) / bars.length;
  const xc = (i: number) => L.x0 + slot * (i + 0.5);
  const y = (v: number) => L.yB - (v / yMax) * (L.yB - L.yT);
  const wide = L.W === 760;
  bars.forEach((b) => {
    fitsText(name(b, wide), slot - 4, L.sans);
    fitsText(fitsLabel(b, wide), slot - 4, L.sans);
  });
  if (!wide) fitsText(t.fitsNote, L.W - 8 - 12, L.sans);
  t.parts.forEach((p, i) => fitsText(p, (i === 0 && L.W === 360 ? 178 : L.W - 8) - L.legend[i][0] - 20, L.sans));
  fitsText(t.gpu, (L.x1 - L.x0) / 2, L.sans);
  return { slot, xc, y };
});
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L, li) => {
    const g = geo[li];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        {[0, 20, 40, 60, 80, 100, 120].map((v) => (
          <g>
            <line class="f-grid" x1={L.x0} x2={L.x1} y1={g.y(v)} y2={g.y(v)} />
            <text class="f-small f-t-muted" x={L.x0 - 6} y={g.y(v) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        <text class="f-small f-t-muted" x={L.x0 - 6} y={L.yT - 12} text-anchor={L.W === 760 ? 'start' : 'start'}>{t.y}</text>
        <line class="f-axis" x1={L.x0} x2={L.x1} y1={L.yB} y2={L.yB} />
        {bars.map((b, i) => {
          let acc = 0;
          return (
            <g>
              {b.parts.map((v, k) => {
                const yTop = g.y(acc + v), yBot = g.y(acc);
                acc += v;
                return <rect x={g.xc(i) - L.bw / 2} y={yTop} width={L.bw} height={yBot - yTop} style={`fill: ${fill[k]}; fill-opacity: 0.55; stroke: ${fill[k]}; stroke-width: 1`} />;
              })}
              <text class="f-small" x={g.xc(i)} y={g.y(b.total) - 6} text-anchor="middle" style="font-weight: 650">{`${gbText(b.total)}`}</text>
              <text class="f-small" x={g.xc(i)} y={L.yB + 18} text-anchor="middle" style="font-weight: 650">{name(b, L.W === 760)}</text>
              <text class="f-small f-t-muted" x={g.xc(i)} y={L.yB + 38} text-anchor="middle">{fitsLabel(b, L.W === 760)}</text>
            </g>
          );
        })}
        {L.W !== 760 && <text class="f-small f-t-muted" x={12} y={L.yB + 62}>{t.fitsNote}</text>}
        <path class="f-line f-green f-dash" d={`M ${L.x0} ${g.y(gpu)} L ${L.x1} ${g.y(gpu)}`} />
        <text class="f-small f-t-green f-halo" x={L.x1 - 4} y={g.y(gpu) - 7} text-anchor="end" style="font-weight: 650">{t.gpu}</text>
        {t.parts.map((p, k) => (
          <g>
            <rect x={L.legend[k][0]} y={L.legend[k][1] - 10} width="14" height="12" style={`fill: ${fill[k]}; fill-opacity: 0.55; stroke: ${fill[k]}; stroke-width: 1`} />
            <text class="f-small f-t-muted" x={L.legend[k][0] + 20} y={L.legend[k][1]}>{p}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
