---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { mulberry32 } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Three estimators of θ = 1 from n = 10 draws of U(0, θ): twice the mean, the maximum, and the maximum times (n+1)/n.
// Histograms of 20,000 simulated values each; the exact bias, variance and MSE are in the note.
const n = 10, reps = 20000, u = mulberry32(15);
const est = [[] as number[], [] as number[], [] as number[]];
for (let r = 0; r < reps; r++) {
  let s = 0, m = 0;
  for (let i = 0; i < n; i++) { const x = u(); s += x; if (x > m) m = x; }
  est[0].push((2 * s) / n); est[1].push(m); est[2].push((m * (n + 1)) / n);
}
const exact = [{ bias: 0, v: 1 / (3 * n) }, { bias: -1 / (n + 1), v: n / ((n + 1) ** 2 * (n + 2)) }, { bias: 0, v: 1 / (n * (n + 2)) }];
const stats = est.map((e) => { const m = e.reduce((a, b) => a + b, 0) / e.length; return { mean: m, v: e.reduce((a, b) => a + (b - m) ** 2, 0) / e.length }; });
if (stats.some((s, k) => Math.abs(s.v / exact[k].v - 1) > 0.05 || Math.abs(s.mean - 1 - exact[k].bias) > 0.005)) throw new Error('UniformEstimators: the simulation disagrees with the exact values');
const lo = 0.3, hi = 1.5, B = 48, bw = (hi - lo) / B;
const hist = est.map((e) => { const h = new Array(B).fill(0); for (const v of e) { const b = Math.floor((v - lo) / bw); if (b >= 0 && b < B) h[b]++; } return h.map((c) => c / (reps * bw)); });
const names = ru ? ['2 · среднее', 'максимум', 'максимум · 11/10'] : ['2 × mean', 'maximum', 'maximum × 11/10'];
const tones = ['blue', 'red', 'green'];
const mse = exact.map((e) => e.bias ** 2 + e.v);
const id = 'uniform-estimators';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 250, pos: (k: number) => [20 + k * 250, 60], pw: 220, ph: 140 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 640, pos: (k: number) => [20, 60 + k * 205], pw: 320, ph: 120 },
];
---

<Figure
  id={id}
  title={ru ? 'Три оценки правого конца равномерного распределения' : 'Three estimators of the end point of a uniform distribution'}
  caption={ru
    ? `Выборка из 10 значений U(0, θ) с θ = 1 (пунктир); гистограммы 20 000 повторений каждой оценки. Удвоенное среднее несмещено, но разбросано (MSE ${mse[0].toFixed(4)}). Максимум всегда меньше θ, смещение −1/11, зато разброс мал (MSE ${mse[1].toFixed(4)}): смещённая оценка лучше несмещённой. Максимум, умноженный на 11/10, несмещён и точнее обеих (MSE ${mse[2].toFixed(4)}).`
    : `A sample of 10 values from U(0, θ) with θ = 1 (dashed); histograms of 20,000 repetitions of each estimator. Twice the mean is unbiased but spread out (MSE ${mse[0].toFixed(4)}). The maximum is always below θ, with bias −1/11, but its spread is small (MSE ${mse[1].toFixed(4)}): a biased estimator beats an unbiased one. The maximum times 11/10 is unbiased and better than both (MSE ${mse[2].toFixed(4)}).`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Гистограммы трёх оценок' : 'Histograms of three estimators'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'Широкий колокол вокруг 1, узкий горб у левого края 1, узкий горб вокруг 1.' : 'A wide bell around 1, a narrow hump just below 1, a narrow hump around 1.'}</desc>
      {hist.map((h, k) => {
        const [x0, y0] = L.pos(k);
        const sx = scale([lo, hi], [x0, x0 + L.pw]), sy = scale([0, 12], [y0 + L.ph, y0]);
        return (
          <g>
            <text class={`f-small f-t-${tones[k]}`} x={x0} y={y0 - 30}>{names[k]}</text>
            <text class="f-note" x={x0} y={y0 - 12}>{`${ru ? 'смещение' : 'bias'} ${exact[k].bias === 0 ? '0' : exact[k].bias.toFixed(3)}, MSE ${mse[k].toFixed(4)}`}</text>
            {h.map((d, b) => <rect x={sx(lo + b * bw)} y={sy(Math.min(d, 12))} width={(L.pw / B) - 0.6} height={sy(0) - sy(Math.min(d, 12))} style={`fill: var(--fig-${tones[k]}); fill-opacity: .5`} />)}
            <path class="f-thin f-muted f-dash" d={`M ${sx(1)} ${y0} V ${y0 + L.ph}`} />
            <path class="f-axis" d={`M ${x0} ${y0 + L.ph} H ${x0 + L.pw}`} />
            {[0.5, 1, 1.5].map((v) => <text class="f-note" x={sx(v)} y={y0 + L.ph + 16} text-anchor="middle">{v}</text>)}
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
