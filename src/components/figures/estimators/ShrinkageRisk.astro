---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import data from './cases.json';
const ru=pageLang(Astro.url)==='ru',id='bias-variance-polys';
const title=ru?'MSE зависит от истинной вероятности':'MSE depends on the true probability';
const caption=ru?'Точные MSE выборочной доли A и стянутой доли B=(K+2)/(n+5). По горизонтали — истинное p. Стягивание полезно в части диапазона и вредно около границ. Вертикальные масштабы панелей различаются; увеличение n снижает обе ошибки.':'Exact MSE for the sample fraction A and shrunk fraction B=(K+2)/(n+5). The horizontal axis is the true p. Shrinkage helps over part of the range and hurts near the endpoints. Panels use different vertical scales; increasing n reduces both errors.';
const x=(p:number)=>60+230*p,y=(v:number,max:number)=>210-170*v/max;
const points=(rows:typeof data.risks[0]['points'],key:'mean'|'shrink',max:number)=>rows.map(r=>`${x(r.p)},${y(r[key],max)}`).join(' ');
---
<Figure id={id} title={title} caption={caption}>
 <div class="panels">
 {data.risks.map(({n,points:rows},i)=>{const max=i===0?.07:.01;return <svg viewBox="0 0 320 270" role="img" aria-labelledby={`${id}-${n}-title ${id}-${n}-desc`}>
  <title id={`${id}-${n}-title`}>{`n = ${n}`}</title><desc id={`${id}-${n}-desc`}>{ru?'Кривая A равна нулю на границах p=0 и p=1. Кривая B там положительна, но ниже A в средней части диапазона.':'The A curve is zero at p=0 and p=1. B is positive at these boundaries but below A through the middle of the range.'}</desc>
  <text x="60" y="24">{`n = ${n}; MSE`}</text>
  {[0,max/2,max].map(v=><g><path class="grid" d={`M60 ${y(v,max)}H290`}/><text x="53" y={y(v,max)+6} text-anchor="end">{v}</text></g>)}
  <path class="axis" d="M60 40V210H290"/>
  <polyline data-series={`mean-${n}`} points={points(rows,'mean',max)} class="mean"/>
  <polyline data-series={`shrink-${n}`} points={points(rows,'shrink',max)} class="shrink"/>
  {[0,.5,1].map(v=><text x={x(v)} y="237" text-anchor="middle">{v}</text>)}
  <text x="175" y="262" text-anchor="middle">{ru?'Истинное p':'True p'}</text>
 </svg>})}
 </div>
 <p class="legend"><span class="key mean"></span>A <span class="key shrink"></span>B</p>
</Figure>
<style>
.panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.panels svg{display:block;width:100%;height:auto;min-width:0}.panels text{font:18px var(--sans);fill:var(--ink);font-variant-numeric:tabular-nums}.axis{fill:none;stroke:var(--muted);stroke-width:1.3}.grid{fill:none;stroke:var(--line)}.mean,.shrink{fill:none;stroke-width:2.5}.mean{stroke:var(--fig-blue)}.shrink{stroke:var(--fig-green);stroke-dasharray:7 4}.legend{text-align:center;margin:.5rem 0 0}.key{display:inline-block;width:1.5rem;border-top:3px solid var(--fig-blue);margin:0 .4rem 0 1rem;vertical-align:middle}.key.shrink{border-color:var(--fig-green);border-top-style:dashed}@media(max-width:700px){.panels{grid-template-columns:1fr}}
</style>
