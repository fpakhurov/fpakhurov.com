---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import data from './cases.json';
const ru=pageLang(Astro.url)==='ru',id='uniform-estimators';
const title=ru?'Распределение двух правил при одной вероятности':'Two rules under the same probability';
const caption=ru?'Семь независимых испытаний Бернулли, p=2/7. Каждый столбец соответствует одному числу единиц. Высоты — точные вероятности; горизонтальные положения — полученные оценки. Пунктир отмечает истинное p. Стягивание сжимает разброс и сдвигает центр.':'Seven independent Bernoulli trials, p=2/7. Each stem corresponds to a success count. Heights are exact probabilities; horizontal positions are estimates. The dashed line marks the true p. Shrinkage compresses the spread and moves the center.';
const x=(t:number)=>60+230*t,y=(p:number)=>210-145*p/.4;
const panels=[{key:'mean',label:'A₇ = K/7',color:'var(--fig-blue)'},{key:'shrink',label:'B₇ = (K+2)/12',color:'var(--fig-green)'}] as const;
---
<Figure id={id} title={title} caption={caption}>
 <div class="panels">
 {panels.map(({key,label,color})=><svg viewBox="0 0 320 270" role="img" aria-labelledby={`${id}-${key}-title ${id}-${key}-desc`}>
  <title id={`${id}-${key}-title`}>{label}</title><desc id={`${id}-${key}-desc`}>{ru?'Восемь возможных оценок с биномиальными вероятностями. Среднее первой оценки равно 2/7, второй — 1/3.':'Eight possible estimates with binomial probabilities. The first estimator has mean 2/7; the second has mean 1/3.'}</desc>
  <text x="60" y="24">{label}</text><text x="60" y="47">{ru?'Вероятность':'Probability'}</text>
  {[0,.2,.4].map(v=><g><path class="grid" d={`M60 ${y(v)}H290`}/><text x="53" y={y(v)+6} text-anchor="end">{v}</text></g>)}
  <path class="axis" d="M60 65V210H290"/><path class="truth" d={`M${x(2/7)} 65V210`}/>
  {data.pmf.map(r=><g data-k={r.k} data-rule={key}><line x1={x(r[key])} x2={x(r[key])} y1="210" y2={y(r.mass)} stroke={color} stroke-width="3"/><circle cx={x(r[key])} cy={y(r.mass)} r="4" fill={color}/></g>)}
  {[0,.5,1].map(v=><text x={x(v)} y="237" text-anchor="middle">{v}</text>)}
  <text x="175" y="262" text-anchor="middle">{ru?'Оценка p':'Estimate of p'}</text>
 </svg>)}
 </div>
</Figure>
<style>
.panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.panels svg{display:block;width:100%;height:auto;min-width:0}.panels text{font:18px var(--sans);fill:var(--ink);font-variant-numeric:tabular-nums}.axis{fill:none;stroke:var(--muted);stroke-width:1.3}.grid{fill:none;stroke:var(--line)}.truth{fill:none;stroke:var(--muted);stroke-width:1.6;stroke-dasharray:5 4}@media(max-width:700px){.panels{grid-template-columns:1fr}}
</style>
