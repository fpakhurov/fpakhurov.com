---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { mulberry32, normal } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Polynomials of degree 1, 3 and 9 fitted by least squares to 20 datasets of 12 equally spaced points,
// y = sin(2πx) + N(0, 0.3²). Least squares by modified Gram–Schmidt QR on x scaled to [−1, 1].
const f = (x: number) => Math.sin(2 * Math.PI * x);
const xs = Array.from({ length: 12 }, (_, i) => i / 11);
const fit = (ys: number[], deg: number) => {
  const A = xs.map((x) => Array.from({ length: deg + 1 }, (_, j) => (2 * x - 1) ** j));
  const m = A.length, k = deg + 1, Q = A.map((r) => [...r]), R = Array.from({ length: k }, () => new Array(k).fill(0));
  for (let j = 0; j < k; j++) {
    for (let i = 0; i < j; i++) { let d = 0; for (let r = 0; r < m; r++) d += Q[r][i] * Q[r][j]; R[i][j] = d; for (let r = 0; r < m; r++) Q[r][j] -= d * Q[r][i]; }
    let nn = 0; for (let r = 0; r < m; r++) nn += Q[r][j] ** 2; nn = Math.sqrt(nn); R[j][j] = nn; for (let r = 0; r < m; r++) Q[r][j] /= nn;
  }
  const qty = Array.from({ length: k }, (_, j) => ys.reduce((s, y, r) => s + Q[r][j] * y, 0));
  const c = new Array(k).fill(0);
  for (let j = k - 1; j >= 0; j--) { let s = qty[j]; for (let i = j + 1; i < k; i++) s -= R[j][i] * c[i]; c[j] = s / R[j][j]; }
  return (x: number) => c.reduce((s, cj, j) => s + cj * (2 * x - 1) ** j, 0);
};
const degs = [1, 3, 9], u = mulberry32(9), z = normal(u);
const sets = Array.from({ length: 20 }, () => xs.map((x) => f(x) + 0.3 * z()));
const fits = degs.map((d) => sets.map((ys) => fit(ys, d)));
// The degree-9 fit has 10 coefficients for 12 points: its residuals must be small but not zero.
const res9 = sets[0].reduce((s, y, i) => s + (y - fits[2][0](xs[i])) ** 2, 0);
if (!(res9 > 0 && res9 < 0.3)) throw new Error('BiasVariancePolys: the least-squares fit misbehaves');
const grid = Array.from({ length: 101 }, (_, i) => i / 100);
const clip = (v: number) => Math.max(-2.2, Math.min(2.2, v));
const t = ru
  ? { names: ['степень 1: большое смещение', 'степень 3: баланс', 'степень 9: большая дисперсия'], nums: ['смещение² 0.218, дисперсия 0.014', 'смещение² 0.006, дисперсия 0.026', 'смещение² 0.000, дисперсия 0.116'] }
  : { names: ['degree 1: high bias', 'degree 3: balanced', 'degree 9: high variance'], nums: ['bias² 0.218, variance 0.014', 'bias² 0.006, variance 0.026', 'bias² 0.000, variance 0.116'] };
const id = 'bias-variance-polys';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 260, pos: (k: number) => [16 + k * 250, 60], pw: 226, ph: 170 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 690, pos: (k: number) => [16, 62 + k * 222], pw: 328, ph: 150 },
];
---

<Figure
  id={id}
  title={ru ? 'Смещение и дисперсия полиномиальной регрессии' : 'Bias and variance of polynomial regression'}
  caption={ru
    ? 'Каждая серая кривая — многочлен, подогнанный методом наименьших квадратов к своему набору из 12 точек y = sin 2πx + шум (σ = 0.3); красная — истинная функция. Прямая (степень 1) у всех наборов почти одинакова и одинаково неверна: большое смещение, малая дисперсия. Степень 9 в среднем совпадает с истинной функцией, но каждая подгонка гоняется за шумом своего набора: малое смещение, большая дисперсия. По 2000 наборам квадрат смещения и дисперсия, усреднённые по x, равны 0.218 и 0.014, 0.006 и 0.026, 0.000 и 0.116; к ним добавляется шум 0.09.'
    : 'Each grey curve is a polynomial fitted by least squares to its own set of 12 points y = sin 2πx + noise (σ = 0.3); red is the true function. The straight line (degree 1) is nearly the same for every dataset and equally wrong: high bias, low variance. Degree 9 matches the true function on average, but every fit chases the noise of its own dataset: low bias, high variance. Over 2,000 datasets the squared bias and the variance, averaged over x, are 0.218 and 0.014, 0.006 and 0.026, 0.000 and 0.116; the noise adds 0.09 to each.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Пучки подгонок трёх степеней' : 'Bundles of fits of three degrees'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'Слева пучок почти одинаковых прямых, в центре кривые близко к синусоиде, справа сильно разбросанные кривые.' : 'Left, a bundle of nearly identical lines; centre, curves close to the sine; right, widely scattered curves.'}</desc>
      {fits.map((group, k) => {
        const [x0, y0] = L.pos(k);
        const sx = scale([0, 1], [x0, x0 + L.pw]), sy = scale([-2.2, 2.2], [y0 + L.ph, y0]);
        return (
          <g>
            <text class="f-small" x={x0} y={y0 - 30}>{t.names[k]}</text>
            <text class="f-note" x={x0} y={y0 - 12}>{t.nums[k]}</text>
            <rect x={x0} y={y0} width={L.pw} height={L.ph} style="fill: none; stroke: var(--line); stroke-width: 1" />
            {group.map((g) => <path class="f-thin f-muted" style="stroke-opacity: .55" d={polyline(grid.map((x) => [sx(x), sy(clip(g(x)))]))} />)}
            <path class="f-line f-red" d={polyline(grid.map((x) => [sx(x), sy(f(x))]))} />
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
