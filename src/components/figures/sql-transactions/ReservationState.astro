---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
const copy = ru
  ? {
      title: 'Что останется после ошибки во второй команде',
      caption: 'Оба варианта начинают с пяти свободных пачек. Повторный номер мешает создать бронь. Явная транзакция позволяет вернуть и остаток.',
      desc: 'С отдельными транзакциями уменьшение остатка с пяти до трёх сохраняется. В общей транзакции откат восстанавливает пять.',
      labels: ['Отдельные транзакции', 'Одна транзакция'],
      left: ['До списания', 'После ошибки'],
    }
  : {
      title: 'What survives an error in the second command',
      caption: 'Both paths start with five available packs. A duplicate ID prevents the reservation. An explicit transaction lets the client undo the stock change as well.',
      desc: 'With separate transactions the change from five to three survives. In one transaction rollback restores five.',
      labels: ['Separate transactions', 'One transaction'],
      left: ['Before the update', 'After the error'],
    };
const paths = [{ y: 20, after: 3 }, { y: 121, after: 5 }];
---
<Figure id="sql-reservation-state" title={copy.title} caption={copy.caption}>
  <svg viewBox="0 0 360 220" role="img" aria-labelledby="sql-reservation-state-title sql-reservation-state-desc" style="max-width: 560px; margin-inline: auto">
    <title id="sql-reservation-state-title">{copy.title}</title>
    <desc id="sql-reservation-state-desc">{copy.desc}</desc>
    {paths.map(({ y, after }, i) => (
      <g transform={`translate(0 ${y})`}>
        <text class="f-label" x="180" y="4" text-anchor="middle">{copy.labels[i]}</text>
        <text class="f-label f-t-muted" x="88" y="25" text-anchor="middle">{copy.left[0]}</text>
        <text class="f-label f-t-muted" x="272" y="25" text-anchor="middle">{copy.left[1]}</text>
        <rect class="f-fill-blue" x="24" y="35" width="128" height="44" rx="8" />
        <text class="f-label" x="88" y="62" text-anchor="middle">5</text>
        <path class="f-line" d="M 158 57 H 202 M 198 53 L 202 57 L 198 61" />
        <rect class={i === 0 ? 'f-fill-red' : 'f-fill-green'} x="208" y="35" width="128" height="44" rx="8" />
        <text class="f-label" x="272" y="62" text-anchor="middle">{after}</text>
      </g>
    ))}
  </svg>
</Figure>
