---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The scrape of the note: cumulative bucket counts of http_request_duration_seconds, 1,000 observations.
const les = [0.05, 0.1, 0.25, 0.5, 1];
const counts = [520, 800, 940, 980, 1000];
const total = 1000;
// What histogram_quantile does: find the first bucket whose cumulative count reaches the rank, interpolate linearly.
function quantile(q: number) {
  const rank = q * total;
  const i = counts.findIndex((c) => c >= rank);
  const lo = i === 0 ? 0 : les[i - 1];
  const below = i === 0 ? 0 : counts[i - 1];
  return lo + ((les[i] - lo) * (rank - below)) / (counts[i] - below);
}
const p50 = quantile(0.5), p90 = quantile(0.9), p99 = quantile(0.99);
if (Math.abs(p99 - 0.75) > 1e-12) throw new Error(`p99 ${p99}`);
if (Math.abs(p90 - 0.207142857) > 1e-6) throw new Error(`p90 ${p90}`);
if (Math.abs(p50 - 0.048077) > 1e-5) throw new Error(`p50 ${p50}`);

const t = ru
  ? { y: 'наблюдений ≤ le', x: 'задержка, с', p99: 'p99 ≈ 0.75 с', p90: 'p90 ≈ 0.207 с', r99: 'ранг 990 = 0.99 × 1000', r90: 'ранг 900',
      band: ['корзина от 0.5 до 1 с:', 'ранги 981–1000, где-то', 'между 0.5 и 1 с'], bandN: ['от 0.5 до 1 с:', 'ранги', '981–1000'], below: 'le=0.05: 520, ниже графика' }
  : { y: 'observations ≤ le', x: 'latency, s', p99: 'p99 ≈ 0.75 s', p90: 'p90 ≈ 0.207 s', r99: 'rank 990 = 0.99 × 1000', r90: 'rank 900',
      band: ['the bucket from 0.5 to 1 s:', 'ranks 981–1000, somewhere', 'between 0.5 and 1 s'], bandN: ['0.5 to 1 s:', 'ranks', '981–1000'], below: 'le=0.05: 520, below the plot' };

interface Layout { cls: string; W: number; H: number; box: [number, number, number, number]; wide: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 340, box: [80, 30, 720, 280], wide: true },
  { cls: 'fig-narrow', W: 360, H: 340, box: [50, 30, 344, 280], wide: false },
];
const plots = layouts.map((L) => {
  const [x0, y0, x1, y1] = L.box;
  const sx = scale([0, 1], [x0, x1]);
  const sy = scale([800, 1000], [y1, y0]);
  const curve = polyline(les.slice(1).map((le, k) => [sx(le), sy(counts[k + 1])] as [number, number]));
  // Label extents (6.5 px per character of f-small). Wide: the rank labels sit just above their dashed lines, left-aligned
  // at x0 + 6, and must end before the line reaches the curve; both quantile labels sit right of their lines on one row.
  // Narrow: the p99 label goes left of its line, on the axis row, and the p90 label one row higher.
  const band = L.wide ? t.band : t.bandN;
  const r99 = L.wide ? t.r99 : '990', r90 = L.wide ? t.r90 : '900';
  if (x0 + 6 + r99.length * 6.5 > sx(p99) - 4) throw new Error('rank 990 label reaches the curve');
  if (x0 + 6 + r90.length * 6.5 > sx(p90) - 4) throw new Error('rank 900 label reaches the curve');
  for (const s of band) if (s.length * 6.5 > sx(1) - sx(0.5) - 12) throw new Error(`band text "${s}" wider than the band at ${L.W}`);
  const p99x = L.wide ? sx(p99) + 8 : sx(p99) - 8, p99anchor = L.wide ? 'start' : 'end', p99y = y1 - 10;
  const p90x = sx(p90) + 8, p90y = L.wide ? y1 - 10 : y1 - 30;
  if (L.wide && p99x + t.p99.length * 6.5 > L.W - 4) throw new Error('p99 label');
  if (!L.wide && p99x - t.p99.length * 6.5 < sx(p90) + 4) throw new Error('p99 label crosses the p90 line');
  if (p90x + t.p90.length * 6.5 > (L.wide ? sx(0.5) - 4 : L.W - 4)) throw new Error('p90 label');
  if (x0 + t.below.length * 6.5 > x1 - t.x.length * 6.8 - 12) throw new Error('below note meets the axis title');
  return { L, sx, sy, curve, band, r99, r90, p99x, p99anchor, p99y, p90x, p90y };
});
const id = 'histogram-quantile';
---

<Figure
  id={id}
  title={ru ? 'Как histogram_quantile находит p99' : 'How histogram_quantile finds the p99'}
  caption={ru
    ? 'Накопленные счётчики корзин из заметки: 520 наблюдений не больше 0.05 с, 800 — не больше 0.1 с, 940, 980 и 1000 — не больше 0.25, 0.5 и 1 с. Ось ординат начинается с 800, чтобы был виден хвост. Квантиль 0.99 — наблюдение ранга 990; оно лежит в корзине от 0.5 до 1 с (жёлтая полоса), и функция проводит прямую между её границами: 0.5 + 0.5 × 10/20 = 0.75 с. Так же p90 = 0.1 + 0.15 × 100/140 ≈ 0.207 с. Настоящий p99 может быть где угодно внутри корзины; точность определяется границами корзин.'
    : 'The cumulative bucket counts of the note: 520 observations at or below 0.05 s, 800 at or below 0.1 s, and 940, 980 and 1,000 at or below 0.25, 0.5 and 1 s. The vertical axis starts at 800 so that the tail is visible. The 0.99 quantile is the observation of rank 990; it lies in the bucket from 0.5 to 1 s (the amber band), and the function draws a straight line between the bounds of that bucket: 0.5 + 0.5 × 10/20 = 0.75 s. In the same way, p90 = 0.1 + 0.15 × 100/140 ≈ 0.207 s. The true p99 can be anywhere inside the bucket; the bucket bounds decide the precision.'}
>
  {plots.map(({ L, sx, sy, curve, band, r99, r90, p99x, p99anchor, p99y, p90x, p90y }) => {
    const [x0, y0, x1, y1] = L.box;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Накопленные счётчики корзин и линейная интерполяция' : 'Cumulative bucket counts and linear interpolation'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'График накопленного числа наблюдений от задержки, от 0 до 1 секунды, по оси ординат от 800 до 1000. Ломаная проходит через точки 0.1 с — 800, 0.25 с — 940, 0.5 с — 980, 1 с — 1000. Корзина от 0.5 до 1 секунды закрашена. Пунктир от ранга 990 встречает ломаную при 0.75 секунды, пунктир от ранга 900 — при 0.207 секунды.'
          : 'A plot of the cumulative number of observations against latency from 0 to 1 second, with the vertical axis from 800 to 1000. A broken line passes through 0.1 s at 800, 0.25 s at 940, 0.5 s at 980 and 1 s at 1000. The bucket from 0.5 to 1 second is shaded. A dashed line from rank 990 meets the broken line at 0.75 seconds, and one from rank 900 at 0.207 seconds.'}</desc>
        <rect x={sx(0.5)} y={y0} width={sx(1) - sx(0.5)} height={y1 - y0} class="f-fill-amber" />
        {band.map((s, k) => <text class="f-small f-t-amber" x={sx(0.5) + 8} y={sy(870) + k * 17}>{s}</text>)}
        {[800, 850, 900, 950, 1000].map((v) => (
          <g>
            <path class="f-grid" d={`M ${x0} ${sy(v)} H ${x1}`} />
            <text class="f-note" x={x0 - 8} y={sy(v) + 5} text-anchor="end">{String(v)}</text>
          </g>
        ))}
        {[0, 0.1, 0.25, 0.5, 1].map((v) => (
          <g>
            <path class="f-axis" d={`M ${sx(v)} ${y1} v 5`} />
            <text class="f-note" x={sx(v)} y={y1 + 20} text-anchor="middle">{String(v)}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${x0} ${y0} V ${y1} H ${x1}`} />
        <text class="f-note" x={x0} y={y0 - 12}>{t.y}</text>
        <text class="f-note" x={x1} y={y1 + 40} text-anchor="end">{t.x}</text>
        <path class="f-line f-blue f-bold" d={curve} />
        {les.slice(1).map((le, k) => <circle cx={sx(le)} cy={sy(counts[k + 1])} r="4" class="f-solid-blue" />)}
        <path class="f-thin f-red f-dash" d={`M ${x0} ${sy(990)} H ${sx(p99)} V ${y1}`} />
        <path class="f-thin f-muted f-dash" d={`M ${x0} ${sy(900)} H ${sx(p90)} V ${y1}`} />
        <circle cx={sx(p99)} cy={sy(990)} r="4.5" class="f-solid-red" />
        <circle cx={sx(p90)} cy={sy(900)} r="4" class="f-solid-muted" />
        <text class="f-small f-t-red f-halo" x={x0 + 6} y={sy(990) - 6}>{r99}</text>
        <text class="f-small f-t-muted f-halo" x={x0 + 6} y={sy(900) - 6}>{r90}</text>
        <text class="f-small f-t-red f-halo" x={p99x} y={p99y} text-anchor={p99anchor}>{t.p99}</text>
        <text class="f-small f-halo" x={p90x} y={p90y}>{t.p90}</text>
        <text class="f-note" x={x0} y={y1 + 40}>{t.below}</text>
      </svg>
    );
  })}
</Figure>
