---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One checkout request of the note: the gateway span lasts 0–240 ms, the checkout span 6–232 ms,
// the database query 20–210 ms and the payment call 212–228 ms. Every signal carries trace ID 4bf9…4736.
const spans = [
  { svc: 'gateway', name: 'POST /checkout', t0: 0, t1: 240 },
  { svc: 'checkout', name: 'POST /checkout', t0: 6, t1: 232 },
  { svc: 'database', name: 'SELECT stock', t0: 20, t1: 210 },
  { svc: 'payments', name: 'POST /charge', t0: 212, t1: 228 },
];
const dur = spans.map((s) => s.t1 - s.t0);
if (dur.join(',') !== '240,226,190,16') throw new Error(`span durations ${dur}`);
// Children lie inside their parents: checkout inside gateway; database and payments inside checkout, one after the other.
if (!(spans[1].t0 >= spans[0].t0 && spans[1].t1 <= spans[0].t1)) throw new Error('checkout outside gateway');
for (const c of [spans[2], spans[3]]) if (!(c.t0 >= spans[1].t0 && c.t1 <= spans[1].t1)) throw new Error('child outside checkout');
if (spans[3].t0 < spans[2].t1) throw new Error('payment starts before the query ends');
// A span shorter than 60 ms gets its label outside the bar, to the left.
const spanRows = spans.map((s) => ({ ...s, long: s.t1 - s.t0 > 60 }));
const checkoutSeconds = (spans[1].t1 - spans[1].t0) / 1000;
if (checkoutSeconds !== 0.226) throw new Error('checkout duration');
// 0.226 s falls in the buckets le=0.25, 0.5, 1 and +Inf of the note, not in le=0.05 or le=0.1.
const bounds = [0.05, 0.1, 0.25, 0.5, 1];
const hit = bounds.filter((b) => checkoutSeconds <= b);
if (hit.join(',') !== '0.25,0.5,1') throw new Error('buckets hit');

const ms = ru ? 'мс' : 'ms';
const t = ru
  ? { head: 'один запрос, POST /checkout, трасса 4bf9…4736', headN: 'один запрос: POST /checkout', client: 'клиент',
      logs: 'логи · каждая подробность одного события', metrics: 'метрики · счётчики по всем событиям', trace: 'трасса · путь запроса по сервисам',
      logsN: 'логи', metricsN: 'метрики', traceN: 'трасса', plusOne: '+1 в каждой' }
  : { head: 'one request, POST /checkout, trace 4bf9…4736', headN: 'one request: POST /checkout', client: 'client',
      logs: 'logs · every detail of one event', metrics: 'metrics · counts over all events', trace: 'trace · the path through the services',
      logsN: 'logs', metricsN: 'metrics', traceN: 'trace', plusOne: '+1 each' };

interface Row { tag?: string; text: string; mono: boolean }
const logRowsW: Row[] = [
  { tag: 'gateway', text: '{"level":"info","msg":"POST /checkout 200","duration_ms":240,"trace_id":"4bf9…"}', mono: true },
  { tag: 'checkout', text: '{"level":"warning","msg":"slow query","duration_ms":190,"trace_id":"4bf9…"}', mono: true },
];
const metricRowsW: Row[] = [
  { tag: 'checkout', text: 'http_requests_total{route="/checkout",code="200"}  41499 → 41500', mono: true },
  { tag: 'checkout', text: `http_request_duration_seconds  0.226 s → le 0.25, 0.5, 1, +Inf: ${t.plusOne}`, mono: true },
];
const logRowsN: Row[] = [
  { tag: 'gateway', text: '{"level":"info",', mono: true },
  { text: '"msg":"POST /checkout 200",', mono: true },
  { text: '"duration_ms":240,"trace_id":"4bf9…"}', mono: true },
  { tag: 'checkout', text: '{"level":"warning","msg":"slow query",', mono: true },
  { text: '"duration_ms":190,"trace_id":"4bf9…"}', mono: true },
];
const metricRowsN: Row[] = [
  { tag: 'checkout', text: 'http_requests_total{route="/checkout",', mono: true },
  { text: '  code="200"}  41499 → 41500', mono: true },
  { text: 'http_request_duration_seconds 0.226 s', mono: true },
  { text: `  → le 0.25, 0.5, 1, +Inf: ${t.plusOne}`, mono: true },
];

interface Layout {
  cls: string; W: number; wide: boolean; mono: number; sans: number;
  tagX: number; textX: number; rowH: number; barX0: number; barX1: number;
  boxes: { label: string; x: number; y: number; w: number; h: number }[];
  arrows: [number, number][][]; clientAt?: [number, number];
}
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, wide: true, mono: 7.5, sans: 6.5, tagX: 22, textX: 110, rowH: 20, barX0: 110, barX1: 740,
    boxes: [
      { label: 'gateway', x: 84, y: 30, w: 130, h: 40 }, { label: 'checkout', x: 262, y: 30, w: 140, h: 40 },
      { label: 'database', x: 470, y: 12, w: 120, h: 32 }, { label: 'payments', x: 470, y: 56, w: 120, h: 32 },
    ],
    arrows: [[[64, 50], [82, 50]], [[214, 50], [260, 50]], [[402, 42], [468, 30]], [[402, 58], [468, 70]]], clientAt: [14, 55] },
  { cls: 'fig-narrow', W: 360, wide: false, mono: 8.4, sans: 6.5, tagX: 14, textX: 14, rowH: 18, barX0: 84, barX1: 346,
    boxes: [
      { label: 'gateway', x: 14, y: 30, w: 96, h: 34 }, { label: 'checkout', x: 134, y: 30, w: 100, h: 34 },
      { label: 'database', x: 258, y: 12, w: 90, h: 28 }, { label: 'payments', x: 258, y: 50, w: 90, h: 28 },
    ],
    arrows: [[[110, 47], [132, 47]], [[234, 40], [256, 28]], [[234, 54], [256, 64]]] },
];

// Vertical layout of the three bands, computed per layout.
const bandsOf = (L: Layout) => {
  const logRows = L.wide ? logRowsW : logRowsN;
  const metricRows = L.wide ? metricRowsW : metricRowsN;
  // In the narrow layout a tag takes a line of its own above its text.
  const lines = (rows: Row[]) => (L.wide ? rows.length : rows.length + rows.filter((r) => r.tag).length);
  const top0 = L.wide ? 108 : 98;
  const head = 30;
  const hLogs = head + lines(logRows) * L.rowH + 8;
  const hMetrics = head + lines(metricRows) * L.rowH + 8;
  const traceRowH = L.wide ? 22 : 24;
  const hTrace = head + spans.length * traceRowH + 40;
  const gap = 10;
  const logsTop = top0, metricsTop = logsTop + hLogs + gap, traceTop = metricsTop + hMetrics + gap;
  return { logRows, metricRows, logsTop, hLogs, metricsTop, hMetrics, traceTop, hTrace, traceRowH, H: traceTop + hTrace + 8 };
};
// Place rows: returns [x, y, text, isTag, mono] items.
const placeRows = (L: Layout, rows: Row[], top: number) => {
  const out: { x: number; y: number; text: string; tag: boolean; mono: boolean }[] = [];
  let y = top + 30 + 13;
  for (const r of rows) {
    if (L.wide) {
      if (r.tag) out.push({ x: L.tagX, y, text: r.tag, tag: true, mono: false });
      out.push({ x: L.textX, y, text: r.text, tag: false, mono: r.mono });
      y += L.rowH;
    } else {
      if (r.tag) { out.push({ x: L.tagX, y, text: r.tag, tag: true, mono: false }); y += L.rowH; }
      out.push({ x: L.textX, y, text: r.text, tag: false, mono: r.mono });
      y += L.rowH;
    }
  }
  return out;
};
for (const L of layouts) {
  const b = bandsOf(L);
  for (const item of [...placeRows(L, b.logRows, b.logsTop), ...placeRows(L, b.metricRows, b.metricsTop)]) {
    const w = item.text.length * (item.mono ? L.mono : L.sans);
    if (item.x + w > L.W - 8) throw new Error(`"${item.text}" overflows at ${L.W}: ${item.x + w}`);
    if (L.wide && item.tag && item.x + w > L.textX - 8) throw new Error(`tag "${item.text}" meets its text`);
  }
  for (const s of L.wide ? [t.logs, t.metrics, t.trace] : [t.logsN, t.metricsN, t.traceN]) if (22 + s.length * L.sans > L.W - 8) throw new Error(`band title "${s}"`);
  const headText = L.wide ? t.head : t.headN;
  if (14 + headText.length * L.sans > L.boxes[2].x - 8) throw new Error('head meets the database box');
  for (const bx of L.boxes) if (bx.label.length * 7.5 > bx.w - 12) throw new Error(`box label ${bx.label}`);
  // Trace tags sit left of the bars.
  for (const s of spans) if (L.tagX + s.svc.length * L.sans > L.barX0 - 6) throw new Error(`trace tag ${s.svc}`);
}
const id = 'three-signals';
---

<Figure
  id={id}
  title={ru ? 'Три сигнала вокруг одного запроса' : 'Three signals around one request'}
  caption={ru
    ? 'Один запрос POST /checkout проходит через шлюз и сервис checkout, который обращается к базе данных и к платёжному сервису. Каждый сервис пишет строку лога со всеми подробностями события; checkout прибавляет 1 к счётчику запросов и записывает 0.226 с в гистограмму задержек, где сам запрос растворяется в суммах; каждый сервис записывает спан, и спаны образуют дерево: шлюз 240 мс, checkout 226 мс, запрос к базе 190 мс, платёж 16 мс. Логи и спаны несут один идентификатор трассы 4bf9…4736, который и связывает сигналы. Числа — пример из заметки.'
    : 'One request, POST /checkout, passes through the gateway to the checkout service, which calls the database and the payment service. Each service writes a log line with every detail of its event; checkout adds 1 to a request counter and records 0.226 s in a latency histogram, where the request itself dissolves into totals; each service records a span, and the spans form a tree: gateway 240 ms, checkout 226 ms, the database query 190 ms, the payment 16 ms. Logs and spans carry the same trace ID, 4bf9…4736, which is what links the signals. The numbers are the example of the note.'}
>
  {layouts.map((L) => {
    const b = bandsOf(L);
    const sx = (v: number) => L.barX0 + ((L.barX1 - L.barX0) * v) / 240;
    const bands = [
      { top: b.logsTop, h: b.hLogs, tone: 'green', title: L.wide ? t.logs : t.logsN, rows: placeRows(L, b.logRows, b.logsTop) },
      { top: b.metricsTop, h: b.hMetrics, tone: 'amber', title: L.wide ? t.metrics : t.metricsN, rows: placeRows(L, b.metricRows, b.metricsTop) },
    ];
    const axisY = b.traceTop + 30 + spans.length * b.traceRowH + 6;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${b.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Логи, метрики и трасса одного запроса' : 'Logs, metrics and a trace of one request'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Сверху путь запроса: клиент, шлюз, сервис checkout, от него стрелки к базе данных и платёжному сервису. Ниже три полосы. Логи: две строки JSON от шлюза и от checkout с длительностями 240 и 190 мс и общим trace_id. Метрики: счётчик запросов растёт с 41499 до 41500, гистограмма получает наблюдение 0.226 с. Трасса: четыре вложенные полосы на оси от 0 до 240 мс — шлюз, checkout, база данных 20–210 мс и платёж 212–228 мс.'
          : 'At the top, the path of the request: client, gateway, the checkout service, and from it arrows to the database and the payment service. Below, three bands. Logs: two JSON lines from the gateway and from checkout with durations of 240 and 190 ms and a shared trace_id. Metrics: the request counter goes from 41499 to 41500 and the histogram receives an observation of 0.226 s. Trace: four nested bars on an axis from 0 to 240 ms: gateway, checkout, the database from 20 to 210 ms and the payment from 212 to 228 ms.'}</desc>
        <text class="f-small f-t-muted" x="14" y="20">{L.wide ? t.head : t.headN}</text>
        {L.clientAt && <text class="f-small f-t-muted" x={L.clientAt[0]} y={L.clientAt[1]}>{t.client}</text>}
        {L.boxes.map((bx) => <Box x={bx.x} y={bx.y} w={bx.w} h={bx.h} label={bx.label} />)}
        {L.arrows.map((pts) => <Arrow pts={pts} tone="muted" />)}
        {bands.map((band) => (
          <g>
            <rect x="8" y={band.top} width={L.W - 16} height={band.h} rx="8" style={`fill: var(--fig-${band.tone}); fill-opacity: 0.07; stroke: var(--fig-${band.tone}); stroke-width: 1.1`} />
            <text class={`f-small f-t-${band.tone}`} x={L.tagX} y={band.top + 20} style="font-weight: 650">{band.title}</text>
            {band.rows.map((r) => (
              <text class={r.tag ? 'f-small f-t-muted' : 'f-small'} x={r.x} y={r.y} style={r.mono ? 'font-family: var(--mono)' : ''}>{r.text}</text>
            ))}
          </g>
        ))}
        <rect x="8" y={b.traceTop} width={L.W - 16} height={b.hTrace} rx="8" style="fill: var(--fig-blue); fill-opacity: 0.07; stroke: var(--fig-blue); stroke-width: 1.1" />
        <text class="f-small f-t-blue" x={L.tagX} y={b.traceTop + 20} style="font-weight: 650">{L.wide ? t.trace : t.traceN}</text>
        {spanRows.map((s, i) => {
          const y = b.traceTop + 30 + i * b.traceRowH;
          const long = s.long;
          const label = L.wide ? `${s.name} · ${s.t1 - s.t0} ${ms}` : `${s.t1 - s.t0} ${ms}`;
          return (
            <g>
              <text class="f-small f-t-muted" x={L.tagX} y={y + 12}>{s.svc}</text>
              <rect x={sx(s.t0)} y={y + 1} width={sx(s.t1) - sx(s.t0)} height="15" rx="3" class="f-fill-blue" style="stroke: var(--fig-blue); stroke-width: 1.1" />
              {long && <text class="f-small" x={sx(s.t0) + 6} y={y + 13}>{label}</text>}
              {!long && <text class="f-small" x={sx(s.t0) - 6} y={y + 13} text-anchor="end">{label}</text>}
            </g>
          );
        })}
        <path class="f-axis" d={`M ${sx(0)} ${axisY} H ${sx(240)}`} />
        {[0, 60, 120, 180, 240].map((v, k) => (
          <g>
            <path class="f-axis" d={`M ${sx(v)} ${axisY} v 4`} />
            <text class="f-note" x={sx(v)} y={axisY + 19} text-anchor={k === 0 ? 'start' : k === 4 ? 'end' : 'middle'}>{k === 4 ? `${v} ${ms}` : String(v)}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
