---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import data from './cases.json';

// Original finite-permutation illustration. Inputs and results come from the
// exhaustive standard-library cyclegan-cases.py; no paper diagram or image is imported.
const ru = pageLang(Astro.url) === 'ru';
const id = 'cyclegan-toy';
const panels = [data.permutations.find(p => p.reference_mae === '0')!, data.permutations[0]];
const layouts = [
  { cls: 'fig-wide', width: 760, height: 335, panel: (i: number) => [30 + 385*i, 66], row: 48, target: 270 },
  { cls: 'fig-narrow', width: 360, height: 650, panel: (i: number) => [26, 68 + 315*i], row: 48, target: 278 },
];
---
<Figure id={id}
  title={ru ? 'Две обратимые связи с одинаковыми маргиналами' : 'Two reversible maps with identical marginals'}
  caption={ru
    ? 'Все четыре кода равновероятны. У обоих отображений точные маргиналы и нулевые циклы с их обратными. Отклонение от заданного опорного соответствия различается: 0 и 13. Числа — явно заданный синтетический пример.'
    : 'All four codes are equally likely. Both maps have exact marginals and zero cycles with their inverses. Deviation from the specified reference correspondence differs: 0 versus 13. The numbers form an explicit synthetic example.'}>
  {layouts.map(L => <svg class={L.cls} viewBox={`0 0 ${L.width} ${L.height}`} role="img" aria-labelledby={`${id}-${L.width}-title ${id}-${L.width}-desc`}>
    <title id={`${id}-${L.width}-title`}>{ru ? 'Опорная и возрастающая перестановки четырёх кодов' : 'Reference and increasing permutations of four codes'}</title>
    <desc id={`${id}-${L.width}-desc`}>{ru ? 'Входы −3, −1, 2, 5. Опорные выходы 21, 8, 34, 13. Возрастающие выходы 8, 13, 21, 34. Оба перевода обратимы.' : 'Inputs −3, −1, 2, 5. Reference outputs 21, 8, 34, 13. Increasing outputs 8, 13, 21, 34. Both translations are invertible.'}</desc>
    {panels.map((p, k) => {
      const [left,top] = L.panel(k);
      return <g>
        <text class="f-label" x={left} y={top-36}>{k === 0 ? (ru ? 'Опорное' : 'Reference') : (ru ? 'Возрастающее' : 'Increasing')}</text>
        <text class="f-note" x={left} y={top-16}>{ru ? `Ошибка по парам: ${p.reference_mae}` : `Paired error: ${p.reference_mae}`}</text>
        {data.x.map((x,i) => <g>
          <line class="f-line f-blue" x1={left+38} y1={top+i*L.row+15} x2={left+L.target-38} y2={top+p.permutation[i]*L.row+15}/>
          <rect x={left} y={top+i*L.row} width="36" height="30" rx="4" style="fill:var(--bg);stroke:var(--fig-green)"/>
          <text class="f-label" x={left+18} y={top+i*L.row+21} text-anchor="middle">{x}</text>
        </g>)}
        {data.y.map((y,i) => <g>
          <rect x={left+L.target-36} y={top+i*L.row} width="36" height="30" rx="4" style="fill:var(--bg);stroke:var(--fig-red)"/>
          <text class="f-label" x={left+L.target-18} y={top+i*L.row+21} text-anchor="middle">{y}</text>
        </g>)}
        <text class="f-note" x={left} y={top+218}>{ru ? 'Распределения совпадают' : 'Marginals match'}</text>
        <text class="f-note" x={left} y={top+238}>{ru ? 'Оба цикла: 0' : 'Both cycles: 0'}</text>
      </g>;
    })}
  </svg>)}
</Figure>
