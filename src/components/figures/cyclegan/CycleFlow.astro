---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Op from '../seqflow/Op.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// CycleGAN's two cycles and four kinds of loss, in the colours of the sequence-model figures: real images green,
// generated images red, discriminators amber. Row 1: x → G → G(x) → F → F(G(x)); row 2: y → F → F(y) → G → G(F(y)).
const t = ru
  ? { horse: 'лошадь', zebra: 'зебра', adv: 'состязательная', cyc: 'цикл', real: 'настоящая', idG: 'G(y) ≈ y', idF: 'F(x) ≈ x', id: 'без изменений',
      steps: ['G переводит лошадь x в зебру G(x); дискриминатор D_Y сравнивает её с настоящими зебрами', 'F возвращает G(x) обратно; цикловая функция потерь ‖F(G(x)) − x‖₁ требует получить исходную лошадь', 'то же в обратную сторону: D_X оценивает F(y), а G(F(y)) должно совпасть с y', 'функция потерь тождественного отображения: зебра на входе G и лошадь на входе F не должны меняться'] }
  : { horse: 'horse', zebra: 'zebra', adv: 'adversarial', cyc: 'cycle', real: 'real', idG: 'G(y) ≈ y', idF: 'F(x) ≈ x', id: 'identity',
      steps: ['G turns a horse x into a zebra G(x); the discriminator D_Y compares it with real zebras', 'F maps G(x) back; the cycle loss ‖F(G(x)) − x‖₁ asks for the original horse', 'the same in the other direction: D_X judges F(y), and G(F(y)) must match y', 'identity loss: a zebra fed to G and a horse fed to F should come out unchanged'] };
const id = 'cyclegan-flow';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 400, wide: true, rows: [60, 260], bx: [16, 170, 260, 430, 520], bw: [118, 0, 136, 0, 160], bh: 50, op: [214, 474] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 470, wide: false, rows: [56, 272], bx: [6, 82, 116, 196, 230], bw: [64, 0, 76, 0, 124], bh: 50, op: [94, 210] },
];
type L = (typeof layouts)[number];
const rowsOf = (L: L) => [
  { y: L.rows[0], a: 'x', aSub: t.horse, b: 'G(x)', bSub: t.zebra, c: 'F(G(x))', cSub: t.horse, f1: 'G', f2: 'F', D: 'D_Y', s: 1, sc: 2 },
  { y: L.rows[1], a: 'y', aSub: t.zebra, b: 'F(y)', bSub: t.horse, c: 'G(F(y))', cSub: t.zebra, f1: 'F', f2: 'G', D: 'D_X', s: 3, sc: 3 },
];
---

<Figure
  id={id}
  title={ru ? 'CycleGAN: два генератора, два дискриминатора и два цикла' : 'CycleGAN: two generators, two discriminators and two cycles'}
  caption={ru
    ? 'Зелёные — настоящие изображения, красные — сгенерированные, жёлтые — дискриминаторы. G переводит лошадей в зебр, F — зебр в лошадей. (1) состязательная функция потерь на G(x); (2) прямой цикл; (3) те же две функции потерь для F, начиная с y; (4) функция потерь тождественного отображения.'
    : 'Green: real images; red: generated ones; amber: discriminators. G turns horses into zebras, F zebras into horses. (1) the adversarial loss on G(x); (2) the forward cycle; (3) the same two losses for F, starting from y; (4) the identity loss.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Два цикла CycleGAN' : 'The two cycles of CycleGAN'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'Верхний ряд: x, G, G(x), F, F(G(x)) с дискриминатором D_Y под G(x) и пунктирной стрелкой цикловой функции потерь от F(G(x)) к x. Нижний ряд: то же для y с F, G и D_X.' : 'Top row: x, G, G(x), F, F(G(x)) with the discriminator D_Y below G(x) and a dashed cycle loss from F(G(x)) back to x. Bottom row: the same for y with F, G and D_X.'}</desc>
      {rowsOf(L).map((r) => {
        const midY = r.y + L.bh / 2;
        const [ax, , bx, , cx] = L.bx, [aw, , bw, , cw] = L.bw;
        return (
          <g>
            <g data-s={r.s}>
              <Box x={ax} y={r.y} w={aw} h={L.bh} label={r.a} sub={r.aSub} tone="x" subGap={L.wide ? 15 : 19} />
              <Arrow pts={[[ax + aw, midY], [L.op[0] - 18, midY]]} />
              <Op x={L.op[0]} y={midY} sym={r.f1} />
              <Arrow pts={[[L.op[0] + 14, midY], [bx - 2, midY]]} />
              <Box x={bx} y={r.y} w={bw} h={L.bh} label={r.b} sub={r.bSub} tone="y" subGap={L.wide ? 15 : 19} />
              <Arrow pts={[[bx + bw / 2, r.y + L.bh], [bx + bw / 2, r.y + L.bh + 28]]} tone="amber" />
              <Box x={bx + bw / 2 - 44} y={r.y + L.bh + 30} w={88} h={34} label={r.D} tone="g" />
              <text class="f-small f-t-amber" x={bx + bw / 2 + 50} y={r.y + L.bh + 52}>{L.wide ? `${t.adv}: ${t.real} ${r.D === 'D_Y' ? t.zebra : t.horse}?` : t.adv}</text>
            </g>
            <g data-s={r.sc}>
              <Arrow pts={[[bx + bw, midY], [L.op[1] - 14, midY]]} />
              <Op x={L.op[1]} y={midY} sym={r.f2} />
              <Arrow pts={[[L.op[1] + 14, midY], [cx - 2, midY]]} />
              <Box x={cx} y={r.y} w={cw} h={L.bh} label={r.c} sub={r.cSub} tone="y" subGap={L.wide ? 15 : 19} />
              <path class="f-line f-red f-dash" d={`M ${cx + cw / 2} ${r.y} C ${cx + cw / 2} ${r.y - 34}, ${ax + aw / 2} ${r.y - 34}, ${ax + aw / 2} ${r.y - 2}`} marker-end="url(#f-arrow-red)" />
              <text class="f-small f-t-red f-halo" x={(ax + aw / 2 + cx + cw / 2) / 2} y={r.y - 30} text-anchor="middle">{`${t.cyc}: ‖${r.c} − ${r.a}‖₁`}</text>
            </g>
          </g>
        );
      })}
      <Badge x={L.bx[0] + 6} y={L.rows[0] + L.bh + 18} n={1} />
      <Badge x={L.bx[4] + L.bw[4] - 8} y={L.rows[0] + L.bh + 18} n={2} />
      <Badge x={L.bx[0] + 6} y={L.rows[1] + L.bh + 18} n={3} />
      <g data-s="4">
        {L.rows.map((ry, k) => <text class="f-small f-t-amber" x={L.wide ? L.op[0] : 36} y={ry + L.bh + (L.wide ? 26 : 92)} text-anchor={L.wide ? 'middle' : 'start'}>{`${t.id}: ${k === 0 ? t.idG : t.idF}`}</text>)}
        <Badge x={L.wide ? L.op[0] - 82 : 20} y={L.rows[0] + L.bh + (L.wide ? 22 : 88)} n={4} />
      </g>
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
