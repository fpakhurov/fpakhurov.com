---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import data from './cases.json';

// New count diagram from exhaustive finite enumeration, not a redraw of the
// source paper's two-generator training diagram.
const ru = pageLang(Astro.url) === 'ru';
const id = 'cyclegan-flow';
const layouts = [
  {cls:'fig-wide',width:760,height:285,barStart:230,barWidth:430,left:24,top:65,row:46},
  {cls:'fig-narrow',width:360,height:330,barStart:138,barWidth:158,left:12,top:85,row:48},
];
---
<Figure id={id}
  title={ru ? 'Сколько соответствий остаётся после опор' : 'How many correspondences remain after anchors'}
  caption={ru
    ? 'Все 24 перестановки уже удовлетворяют маргиналам, циклам и заданным тождественным продолжениям. Опора — одна известная пара вход–выход. Последовательные опоры оставляют 24, 6, 2 и 1 соответствие; четвёртая уже определена первыми тремя.'
    : 'All 24 permutations already satisfy marginals, cycles and the specified identity extensions. An anchor is one known input–output pair. Successive anchors leave 24, 6, 2 and 1 correspondences; the first three already determine the fourth.'}>
  {layouts.map(L => <svg class={L.cls} viewBox={`0 0 ${L.width} ${L.height}`} role="img" aria-labelledby={`${id}-${L.width}-title ${id}-${L.width}-desc`}>
    <title id={`${id}-${L.width}-title`}>{ru ? 'Число допустимых перестановок после известных пар' : 'Number of admissible permutations after known pairs'}</title>
    <desc id={`${id}-${L.width}-desc`}>{ru ? 'Ноль опор: 24. Одна: 6. Две: 2. Три: 1. Высота полос одинакова; длина пропорциональна числу.' : 'Zero anchors: 24. One: 6. Two: 2. Three: 1. Bars have equal height and length proportional to the count.'}</desc>
    <text class="f-note" x={L.left} y="26">{ru ? 'Известные пары' : 'Known pairs'}</text>
    <text class="f-note" x={L.barStart} y="46">{ru ? 'Соответствия' : 'Admissible maps'}</text>
    {data.anchor_counts.slice(0,4).map((count,k) => <g>
      <text class="f-label" x={L.left} y={L.top+k*L.row+20}>{ru ? `${k} из 4` : `${k} of 4`}</text>
      <rect x={L.barStart} y={L.top+k*L.row} width={L.barWidth*count/24} height="28" rx="2" style="fill:var(--fig-blue)"/>
      <text class="f-label" x={L.barStart+L.barWidth*count/24+9} y={L.top+k*L.row+20}>{count}</text>
    </g>)}
  </svg>)}
</Figure>
