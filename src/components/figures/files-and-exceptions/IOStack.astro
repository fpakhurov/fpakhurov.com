---
import Figure from '../Figure.astro';
import { toneVar, type Tone } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// open('notes.txt', encoding='utf-8') in CPython 3.14.7 on macOS: type(f) is TextIOWrapper, f.buffer a BufferedReader,
// f.buffer.raw a FileIO, f.fileno() 3; io.DEFAULT_BUFFER_SIZE is 131072 bytes on this build.
const bufBytes = 131072;
if (bufBytes / 1024 !== 128) throw new Error('IOStack: buffer size');

interface Layer { tone: Tone; name: string; lines: string[] }
const layers: Layer[] = ru
  ? [
      { tone: 'x', name: 'код программы', lines: ['for line in f: …    f.read()', 'получает str'] },
      { tone: 'g', name: 'io.TextIOWrapper (это f)', lines: ['декодирует байты в str по encoding', "превращает '\\r\\n' в '\\n'"] },
      { tone: 'h', name: 'io.BufferedReader (f.buffer)', lines: ['буфер 128 КиБ: одно большое чтение', 'обслуживает много маленьких'] },
      { tone: 'h', name: 'io.FileIO (f.buffer.raw)', lines: ['дескриптор файла 3;', 'каждый read — системный вызов'] },
      { tone: 'y', name: 'ядро ОС', lines: ['read(2): страничный кеш, затем диск', ''] },
    ]
  : [
      { tone: 'x', name: 'your code', lines: ['for line in f: …    f.read()', 'receives str'] },
      { tone: 'g', name: 'io.TextIOWrapper (this is f)', lines: ['decodes bytes to str with the encoding', "turns '\\r\\n' into '\\n'"] },
      { tone: 'h', name: 'io.BufferedReader (f.buffer)', lines: ['a 128 KiB buffer: one large read', 'serves many small requests'] },
      { tone: 'h', name: 'io.FileIO (f.buffer.raw)', lines: ['file descriptor 3;', 'every read is a system call'] },
      { tone: 'y', name: 'the kernel', lines: ['read(2): page cache, then disk', ''] },
    ];
const up = ru ? ['str', 'байты', 'байты', 'байты'] : ['str', 'bytes', 'bytes', 'bytes'];

interface Layout { cls: string; W: number; bx: number; bw: number; bh: number; gap: number; noteX: number | null; sans: number; mono: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, bx: 40, bw: 300, bh: 40, gap: 30, noteX: 400, sans: 6.5, mono: 7.5 },
  { cls: 'fig-narrow seq-narrow', W: 360, bx: 10, bw: 300, bh: 66, gap: 26, noteX: null, sans: 7.3, mono: 8.4 },
];
for (const L of layouts) for (const ly of layers) {
  if (L.bx + 10 + ly.name.length * L.mono > L.bx + L.bw) throw new Error(`"${ly.name}" overflows its box at ${L.W}`);
  for (const s of ly.lines) {
    const x0 = L.noteX ?? L.bx + 10, x1 = L.noteX === null ? L.bx + L.bw : L.W - 4;
    if (x0 + s.length * L.sans > x1) throw new Error(`"${s}" overflows at ${L.W}`);
  }
}
const id = 'io-stack';
---

<Figure
  id={id}
  title={ru ? 'Слои открытого текстового файла' : 'The layers of an open text file'}
  caption={ru
    ? "Что возвращает open('notes.txt', encoding='utf-8') в CPython 3.14.7: три объекта друг над другом. Текстовый слой TextIOWrapper — это и есть f; он декодирует байты в строки и переводит концы строк. Под ним BufferedReader с буфером io.DEFAULT_BUFFER_SIZE = 131072 байт на этой сборке, затем FileIO, который держит дескриптор файла и делает системные вызовы read. В двоичном режиме, open(p, 'rb'), текстового слоя нет, и f — сам BufferedReader. Что ядро делает дальше, разбирает заметка о файлах в курсе по архитектуре и ОС."
    : "What open('notes.txt', encoding='utf-8') returns in CPython 3.14.7: three objects stacked. The text layer, TextIOWrapper, is f itself; it decodes bytes into strings and translates line endings. Below it a BufferedReader with a buffer of io.DEFAULT_BUFFER_SIZE = 131072 bytes on this build, then a FileIO, which holds the file descriptor and makes the read system calls. In binary mode, open(p, 'rb'), there is no text layer, and f is the BufferedReader itself. What the kernel does next is the subject of the files note in the architecture and operating systems course."}
>
  {layouts.map((L) => {
    const H = layers.length * (L.bh + L.gap) - L.gap + 20;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Стек объектов ввода-вывода от кода до ядра' : 'The stack of I/O objects from your code to the kernel'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Пять блоков сверху вниз: код программы, TextIOWrapper, BufferedReader, FileIO, ядро. Между соседними блоками стрелка вверх: строки от TextIOWrapper к коду, байты между остальными слоями.'
          : 'Five boxes from top to bottom: your code, TextIOWrapper, BufferedReader, FileIO, the kernel. Between neighbouring boxes an arrow points up: strings from TextIOWrapper to the code, bytes between the other layers.'}</desc>
        {layers.map((ly, k) => {
          const y = 10 + k * (L.bh + L.gap);
          return (
            <g>
              <rect x={L.bx} y={y} width={L.bw} height={L.bh} rx="7" style={`fill: ${toneVar[ly.tone]}; fill-opacity: 0.12; stroke: ${toneVar[ly.tone]}; stroke-width: 1.3`} />
              <text class="f-small" x={L.bx + 10} y={y + (L.noteX === null ? 20 : L.bh / 2 + 4.5)} style="font-family: var(--mono); font-weight: 650">{ly.name}</text>
              {ly.lines.map((s, i) => (
                <text class="f-small f-t-muted" x={L.noteX ?? L.bx + 10} y={L.noteX === null ? y + 40 + i * 18 : y + 14 + i * 18}>{s}</text>
              ))}
              {k !== 0 && (
                <g>
                  <path class="f-line f-muted" d={`M ${L.bx + 60} ${y - 3} V ${y - L.gap + 4}`} marker-end="url(#f-arrow-muted)" />
                  <text class="f-small f-t-muted" x={L.bx + 70} y={y - L.gap / 2 + 4}>{up[k - 1]}</text>
                </g>
              )}
            </g>
          );
        })}
      </svg>
    );
  })}
</Figure>
