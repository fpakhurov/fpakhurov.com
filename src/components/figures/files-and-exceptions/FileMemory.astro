---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Measured once with tracemalloc (peak bytes), CPython 3.14.7, macOS (arm64): an ASCII text file of 100-byte lines,
// opened with encoding='utf-8', read with f.read() against iterated line by line with `for line in f`.
const data: [number, number, number][] = [[1, 2132434, 149056], [2, 4132354, 149024], [4, 8132322, 149000], [8, 16132298, 148976], [16, 32132266, 148944]];
for (const [mb, whole, lines] of data) {
  const ratio = whole / (mb * 1e6);
  if (!(ratio > 2 && ratio < 2.15)) throw new Error(`FileMemory: read() ratio ${ratio}`);
  if (lines > 150000) throw new Error('FileMemory: line iteration should stay under 150 KB');
}

const t = ru
  ? { x: 'размер файла, МБ', y: 'пик памяти, МБ', whole: 'f.read(): ≈ 2 × размер файла', lines: 'for line in f: ≈ 0.15 МБ при любом размере', wholeN: 'f.read(): ≈ 2 × файл', linesN: 'for line in f: ≈ 0.15 МБ' }
  : { x: 'file size, MB', y: 'peak memory, MB', whole: 'f.read(): about 2 × the file size', lines: 'for line in f: about 0.15 MB at any size', wholeN: 'f.read(): ≈ 2 × file size', linesN: 'for line in f: ≈ 0.15 MB' };
interface Layout { cls: string; W: number; H: number; x0: number; x1: number; y0: number; y1: number; sans: number; lw: [number, number]; ll: [number, number]; short: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 300, x0: 70, x1: 560, y0: 250, y1: 30, sans: 6.5, lw: [130, 80], ll: [300, 236], short: false },
  { cls: 'fig-narrow', W: 360, H: 300, x0: 50, x1: 340, y0: 250, y1: 30, sans: 6.5, lw: [60, 52], ll: [60, 74], short: true },
];
for (const L of layouts) for (const [s, at] of [[L.short ? t.wholeN : t.whole, L.lw], [L.short ? t.linesN : t.lines, L.ll]] as [string, [number, number]][]) if (at[0] + s.length * L.sans > L.W - 4) throw new Error(`"${s}" overflows at ${L.W}`);
const id = 'file-memory';
---

<Figure
  id={id}
  title={ru ? 'Прочитать файл целиком или по строкам' : 'Reading a file whole or line by line'}
  caption={ru
    ? 'Пик памяти при чтении текстового файла из строк по 100 байт; tracemalloc, CPython 3.14.7 на macOS (arm64), измерено один раз. f.read() держит в памяти одновременно прочитанные байты и декодированную строку, поэтому пик около двух размеров файла: 32 МБ для файла в 16 МБ. Цикл for line in f держит буфер и одну строку, около 0.15 МБ при любом размере файла, и обрабатывает файл больше оперативной памяти.'
    : 'The peak memory while reading a text file of 100-byte lines; tracemalloc, CPython 3.14.7 on macOS (arm64), measured once. f.read() holds the bytes it read and the decoded string at the same time, so its peak is about twice the file size: 32 MB for a 16 MB file. The loop for line in f holds the buffer and one line, about 0.15 MB at any file size, and can process a file larger than memory.'}
>
  {layouts.map((L) => {
    const sx = scale([0, 16], [L.x0, L.x1]), sy = scale([0, 34], [L.y0, L.y1]);
    const line = (k: number) => polyline([[sx(0), sy(0)], ...data.map((d) => [sx(d[0]), sy(d[k] / 1e6)] as [number, number])]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Пик памяти в зависимости от размера файла' : 'Peak memory against file size'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Красная линия f.read() поднимается прямо от 2 МБ при файле в 1 МБ до 32 МБ при 16 МБ. Синяя линия построчного чтения лежит у нуля, около 0.15 МБ.'
          : 'The red line for f.read() rises straight from 2 MB for a 1 MB file to 32 MB for 16 MB. The blue line for reading line by line lies near zero, about 0.15 MB.'}</desc>
        {[0, 8, 16, 24, 32].map((v) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} />
            <text class="f-small f-t-muted" x={L.x0 - 8} y={sy(v) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        {[0, 4, 8, 12, 16].map((v) => <text class="f-small f-t-muted" x={sx(v)} y={L.y0 + 18} text-anchor="middle">{v}</text>)}
        <path class="f-axis" d={`M ${L.x0} ${L.y1 - 6} V ${L.y0} H ${L.x1 + 6}`} />
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y0 + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.x0 - 40} y={L.y1 - 14}>{t.y}</text>
        <path class="f-line f-red" d={line(1)} />
        <path class="f-line f-blue" d={line(2)} />
        {data.map((d) => <circle cx={sx(d[0])} cy={sy(d[1] / 1e6)} r="3.2" class="f-solid-red" />)}
        {data.map((d) => <circle cx={sx(d[0])} cy={sy(d[2] / 1e6)} r="3.2" class="f-solid-blue" />)}
        <text class="f-small f-t-red f-halo" x={L.lw[0]} y={L.lw[1]}>{L.short ? t.wholeN : t.whole}</text>
        <text class="f-small f-t-blue f-halo" x={L.ll[0]} y={L.ll[1]}>{L.short ? t.linesN : t.lines}</text>
      </svg>
    );
  })}
</Figure>
