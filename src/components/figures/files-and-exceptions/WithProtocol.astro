---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// with Timer() as t: 1 / 0 — the Timer class of the note, CPython 3.14.7. The REPL printed 'enter', then
// "exit, exception: <class 'ZeroDivisionError'>", then the traceback: __exit__ ran before the exception left the block.
interface Msg { s: number; toMgr: boolean; y: number; label: string; kind: 'call' | 'ret' }
interface Note { s: number; side: 'w' | 'm'; y: number; text: string; tone: string }
const msgs: Msg[] = [
  { s: 1, toMgr: true, y: 70, label: 'Timer()', kind: 'call' },
  { s: 1, toMgr: false, y: 116, label: ru ? 'менеджер m' : 'manager m', kind: 'ret' },
  { s: 2, toMgr: true, y: 160, label: 'm.__enter__()', kind: 'call' },
  { s: 2, toMgr: false, y: 206, label: ru ? 'self, связан с t' : 'self, bound to t', kind: 'ret' },
  { s: 4, toMgr: true, y: 308, label: 'm.__exit__(type, exc, tb)', kind: 'call' },
  { s: 5, toMgr: false, y: 356, label: 'False', kind: 'ret' },
];
const notes: Note[] = ru
  ? [
      { s: 1, side: 'm', y: 94, text: 'ищет __enter__ и __exit__', tone: 'f-t-muted' },
      { s: 2, side: 'm', y: 184, text: "print('enter'); return self", tone: 'f-t-blue' },
      { s: 3, side: 'w', y: 246, text: 'тело: 1 / 0 возбуждает', tone: 'f-t-red' },
      { s: 3, side: 'w', y: 266, text: 'ZeroDivisionError', tone: 'f-t-red' },
      { s: 4, side: 'm', y: 330, text: 'type = ZeroDivisionError', tone: 'f-t-blue' },
      { s: 5, side: 'w', y: 380, text: 'False: исключение летит дальше', tone: 'f-t-red' },
      { s: 5, side: 'w', y: 400, text: 'True подавило бы его', tone: 'f-t-muted' },
    ]
  : [
      { s: 1, side: 'm', y: 94, text: 'finds __enter__ and __exit__', tone: 'f-t-muted' },
      { s: 2, side: 'm', y: 184, text: "print('enter'); return self", tone: 'f-t-blue' },
      { s: 3, side: 'w', y: 246, text: 'body: 1 / 0 raises', tone: 'f-t-red' },
      { s: 3, side: 'w', y: 266, text: 'ZeroDivisionError', tone: 'f-t-red' },
      { s: 4, side: 'm', y: 330, text: 'type = ZeroDivisionError', tone: 'f-t-blue' },
      { s: 5, side: 'w', y: 380, text: 'False: the exception goes on', tone: 'f-t-red' },
      { s: 5, side: 'w', y: 400, text: 'True would suppress it', tone: 'f-t-muted' },
    ];
const heads = ru ? ['инструкция with', 'контекстный менеджер'] : ['with statement', 'context manager'];
const steps = ru
  ? ['вычислить выражение после with: получить менеджер', 'вызвать __enter__; его результат связывается с именем после as', 'выполнить тело; здесь оно возбуждает исключение', 'при любом выходе из тела вызвать __exit__ с исключением или с тремя None', '__exit__ вернул ложь: исключение распространяется дальше']
  : ['evaluate the expression after with: the manager', 'call __enter__; its result is bound to the name after as', 'run the body; here it raises an exception', 'on any exit from the body, call __exit__ with the exception, or with three Nones', '__exit__ returned false: the exception propagates'];

interface Layout { cls: string; W: number; H: number; lanes: [number, number]; mono: number; sans: number; wX: number; mX: number; headX: [number, number]; headAnchor: ['middle' | 'start' | 'end', 'middle' | 'start' | 'end']; badgeX: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 420, lanes: [190, 600], mono: 7.5, sans: 6.5, wX: 202, mX: 588, headX: [190, 600], headAnchor: ['middle', 'middle'], badgeX: 40 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 420, lanes: [36, 330], mono: 8.4, sans: 7.3, wX: 46, mX: 320, headX: [8, 352], headAnchor: ['start', 'end'], badgeX: 14 },
];
for (const L of layouts) {
  const span = L.lanes[1] - L.lanes[0];
  for (const m of msgs) if (m.label.length * L.mono > span - 12) throw new Error(`label "${m.label}" wider than its arrow at ${L.W}`);
  for (const n of notes) {
    const w = n.text.length * L.mono;
    if (n.side === 'w' && L.wX + w > L.lanes[1] - 6) throw new Error(`note "${n.text}" crosses the manager lane at ${L.W}`);
    if (n.side === 'm' && L.mX - w < L.lanes[0] + 6) throw new Error(`note "${n.text}" crosses the with lane at ${L.W}`);
  }
  const hw = heads.map((h) => h.length * L.sans);
  if (L.headAnchor[1] === 'end' && L.headX[1] - hw[1] < L.headX[0] + hw[0] + 10) throw new Error(`heads collide at ${L.W}`);
  if (L.headAnchor[1] === 'middle' && L.headX[1] + hw[1] / 2 > L.W - 2) throw new Error('head overflows');
}
const id = 'with-protocol';
---

<Figure
  id={id}
  title={ru ? 'Что делает инструкция with' : 'What a with statement does'}
  caption={ru
    ? 'Блок with Timer() as t: 1 / 0 с классом Timer из текста, CPython 3.14.7; время идёт сверху вниз. Инструкция with вычисляет выражение и получает контекстный менеджер (1), вызывает его __enter__ и связывает результат с t (2), выполняет тело (3). Как бы тело ни завершилось — нормально, через return или break, или исключением, — вызывается __exit__ с типом, значением и трассировкой исключения или с тремя None (4). Если __exit__ возвращает истину, исключение подавляется; здесь он вернул False, и ZeroDivisionError распространяется дальше (5). REPL напечатал enter, затем строку из __exit__, затем трассировку.'
    : 'The block with Timer() as t: 1 / 0 with the Timer class of the text, CPython 3.14.7; time runs downwards. The with statement evaluates its expression to get a context manager (1), calls its __enter__ and binds the result to t (2), and runs the body (3). However the body ends, normally, through return or break, or with an exception, __exit__ is called with the type, value and traceback of the exception, or with three Nones (4). If __exit__ returns a true value the exception is suppressed; here it returned False, and the ZeroDivisionError propagates (5). The REPL printed enter, then the line from __exit__, then the traceback.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Вызовы __enter__ и __exit__ в блоке with' : 'The __enter__ and __exit__ calls of a with block'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Две вертикальные линии: инструкция with и контекстный менеджер. with вызывает Timer() и получает менеджер, вызывает __enter__ и связывает self с t. Тело возбуждает ZeroDivisionError. Затем with вызывает __exit__ с типом исключения; __exit__ возвращает False, и исключение летит дальше.'
        : 'Two vertical lines: the with statement and the context manager. The with statement calls Timer() and gets the manager, calls __enter__ and binds self to t. The body raises ZeroDivisionError. Then with calls __exit__ with the exception type; __exit__ returns False, and the exception goes on.'}</desc>
      {heads.map((h, i) => (
        <g>
          <text class="f-small" x={L.headX[i]} y={34} text-anchor={L.headAnchor[i]} style="font-weight: 650">{h}</text>
          <path class="f-thin f-dash" style={`stroke: ${[toneVar.x, toneVar.g][i]}`} d={`M ${L.lanes[i]} ${44} V ${L.H - 6}`} />
        </g>
      ))}
      {msgs.map((m) => {
        const [x1, x2] = m.toMgr ? [L.lanes[0], L.lanes[1]] : [L.lanes[1], L.lanes[0]];
        const dir = m.toMgr ? 1 : -1;
        return (
          <g data-s={String(m.s)}>
            <path class={`f-line ${m.kind === 'ret' ? 'f-muted f-dash' : ''}`} d={`M ${x1 + dir * 4} ${m.y} H ${x2 - dir * 6}`} marker-end={m.kind === 'ret' ? 'url(#f-arrow-muted)' : 'url(#f-arrow)'} />
            <text class={`f-small f-halo ${m.kind === 'ret' ? 'f-t-muted' : ''}`} x={(x1 + x2) / 2} y={m.y - 7} text-anchor="middle" style="font-family: var(--mono)">{m.label}</text>
          </g>
        );
      })}
      {notes.map((n) => (
        <text data-s={String(n.s)} class={`f-small ${n.tone}`} x={n.side === 'w' ? L.wX : L.mX} y={n.y} text-anchor={n.side === 'w' ? 'start' : 'end'} style="font-family: var(--mono)">{n.text}</text>
      ))}
      <g data-s="3"><path class="f-line f-red f-bold" d={`M ${L.lanes[0]} ${232} V ${272}`} /></g>
      {[1, 2, 3, 4, 5].map((s) => (
        <g data-s={String(s)}><Badge x={L.badgeX} y={[66, 156, 244, 304, 352][s - 1]} n={s} /></g>
      ))}
    </svg>
  ))}
  <Stepper steps={steps} />
</Figure>
