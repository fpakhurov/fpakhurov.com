---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Vec from '../seqflow/Vec.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One DragGAN iteration in the colours of the sequence-model figures: the latent and the features it produces are
// states (blue), the frozen generator and the search windows are amber, what the user gives is green, and the image,
// the handle positions and the gradient are red. The feature map is a schematic 10 × 10 grid with a blob; the handle
// p = (5, 4) moves toward the goal (9, 7) along d = (0.8, 0.6); Ω₁ is the disc of radius 2 (a 3 × 3 block), Ω₂ the
// square with r₂ = 3 (5 × 5), and tracking finds p′ = (6, 5), the cell nearest to p + d = (5.8, 4.6).
const N = 10, CS = 19.6;
const blob = { cx: 4, cy: 5, s: 2 };
const P: [number, number] = [5, 4], G: [number, number] = [9, 7], P2: [number, number] = [6, 5];
const len = Math.hypot(G[0] - P[0], G[1] - P[1]);
const D: [number, number] = [(G[0] - P[0]) / len, (G[1] - P[1]) / len];
const near = [Math.round(P[0] + D[0]), Math.round(P[1] + D[1])];
if (len !== 5 || near[0] !== P2[0] || near[1] !== P2[1]) throw new Error('DragGanIteration: the schematic handle step drifted');
const omega1: [number, number][] = [];
for (let i = 0; i < N; i++) for (let j = 0; j < N; j++) if ((i - P[0]) ** 2 + (j - P[1]) ** 2 < 4) omega1.push([i, j]);
if (omega1.length !== 9) throw new Error('DragGanIteration: Ω₁ should be a 3 × 3 block');
const heat: { i: number; j: number; o: string }[] = [];
for (let i = 0; i < N; i++)
  for (let j = 0; j < N; j++) {
    const g = Math.exp(-((i - blob.cx) ** 2 + (j - blob.cy) ** 2) / (2 * blob.s * blob.s));
    if (g > 0.04) heat.push({ i, j, o: (0.7 * g).toFixed(2) });
  }

const t = ru
  ? {
      latent: 'латент w ∈ W+', trained: 'w₁…w₆ обучаются', fixed: 'w₇…wₗ заморожены', trainedN: 'обучаются', fixedN: 'заморожены',
      gsub: 'StyleGAN2', frozen: 'заморожен', gsubN: 'StyleGAN2, заморожен', image: 'изображение', block: 'блок 6', rerun: 'w′ → F′',
      fcap1: 'признаки F после блока 6', fcap2: '128 × 128, к размеру изображения', fN: ['признаки F', 'после блока 6,', '128 × 128'],
      ms: 'motion supervision', ms1: 'Σ по точкам i, q ∈ Ω₁(pᵢ):', ms2: '‖F(q + dᵢ) − sg[F(q)]‖₁', ms3: '+ λ ‖(F − F₀)·(1 − M)‖₁', user: 'от пользователя: pᵢ, gᵢ, маска M',
      grad: '∂L/∂(w₁…w₆): один шаг Adam', gradN: '→ ∂L/∂(w₁…w₆): шаг Adam',
      tr: 'отслеживание точек', tr1: 'pᵢ ← argmin по q ∈ Ω₂(pᵢ):', tr2: '‖F′(q) − F₀(pᵢ⁰)‖₁', repeat: 'снова', stop: 'стоп, когда все ‖pᵢ − gᵢ‖ ≤ 1 пикс.',
      steps: [
        'G переводит латент w в изображение и, после блока 6, в карту признаков F (приведённую к размеру изображения)',
        'Motion supervision: признаки в Ω₁ вокруг каждой точки pᵢ сравниваются с тем же участком, сдвинутым на шаг dᵢ к цели gᵢ; эталон заморожен (sg)',
        'Градиент доходит только до первых шести кодов w₁ … w₆; Adam делает один шаг',
        'G запускается снова с новым w′: содержимое рядом с pᵢ сдвинулось в F′ примерно на пиксель',
        'Отслеживание: новая pᵢ — позиция в Ω₂, чей признак ближе всего к исходному признаку точки; шаги 2–5 повторяются, пока все точки не окажутся в пределах 1 пикселя от целей',
      ],
    }
  : {
      latent: 'latent w ∈ W+', trained: 'w₁…w₆ trained', fixed: 'w₇…wₗ fixed', trainedN: 'trained', fixedN: 'fixed',
      gsub: 'StyleGAN2', frozen: 'frozen', gsubN: 'StyleGAN2, frozen', image: 'image', block: 'block 6', rerun: 'w′ → F′',
      fcap1: 'features F after block 6', fcap2: '128 × 128, resized to the image', fN: ['features F', 'after block 6,', '128 × 128'],
      ms: 'motion supervision', ms1: 'Σ over handles i, q ∈ Ω₁(pᵢ):', ms2: '‖F(q + dᵢ) − sg[F(q)]‖₁', ms3: '+ λ ‖(F − F₀)·(1 − M)‖₁', user: 'user: pᵢ, gᵢ, mask M',
      grad: '∂L/∂(w₁…w₆): one Adam step', gradN: '→ ∂L/∂(w₁…w₆): one Adam step',
      tr: 'point tracking', tr1: 'pᵢ ← argmin over q ∈ Ω₂(pᵢ):', tr2: '‖F′(q) − F₀(pᵢ⁰)‖₁', repeat: 'repeat', stop: 'stop when every ‖pᵢ − gᵢ‖ ≤ 1 px',
      steps: [
        'G maps the latent w to the image and, after block 6, to the feature map F (resized to the image)',
        'Motion supervision: the features in Ω₁ around each handle pᵢ are compared with the same patch moved one step dᵢ toward the goal gᵢ; the reference is frozen (sg)',
        'The gradient reaches only the first six codes w₁ … w₆; Adam takes one step',
        'G runs again with the new w′: in F′ the content near pᵢ has moved by about one pixel',
        'Point tracking: the new pᵢ is the position in Ω₂ whose feature is closest to the handle’s original feature; repeat from step 2 until every handle is within 1 px of its goal',
      ],
    };

const id = 'drag-editing-iteration';
const layouts = [
  {
    cls: 'fig-wide', W: 760, H: 348, wide: true,
    fx: 300, fy: 48,
    vec: { x: 28, y: 48, cw: 64, ch: 22, dir: 'col' as const }, vecFixed: { x: 28, y: 180 },
    vecArrows: [[[92, 114], [128, 114]], [[92, 213], [128, 213]]] as [number, number][][],
    gBox: { x: 130, y: 48, w: 110, h: 198 }, gFrozen: [185, 236],
    gToF: [[240, 146], [298, 146]] as [number, number][], blockAt: [269, 138], rerunAt: [269, 166],
    gToI: [[185, 246], [185, 288]] as [number, number][], iBox: { x: 130, y: 290, w: 110, h: 44 },
    latentText: [[60, 262, 'latent'], [60, 280, 'trained'], [60, 296, 'fixed']] as [number, number, string][],
    fcap: [[398, 262, 'fcap1'], [398, 278, 'fcap2']] as [number, number, string][], fcapAnchor: 'middle',
    loss: { x: 528, y: 48, w: 222, h: 114 }, fToLoss: [[496, 104], [526, 104]] as [number, number][],
    grad: [[600, 48], [600, 14], [60, 14], [60, 46]] as [number, number][], gradAt: [330, 31],
    track: { x: 528, y: 202, w: 222, h: 80 }, fToTrack: [[496, 242], [526, 242]] as [number, number][], fPrimeAt: [511, 234],
    up: [[700, 200], [700, 164]] as [number, number][], upAt: [708, 187], stopAt: [639, 304],
    legend: { x: 290, y: 334, step: 120, rows: 1 },
    badges: [[185, 72], [544, 66], [460, 14], [269, 190], [544, 220]] as [number, number][],
  },
  {
    cls: 'fig-narrow seq-narrow', W: 360, H: 758, wide: false,
    fx: 20, fy: 188,
    vec: { x: 18, y: 50, cw: 36, ch: 24, dir: 'row' as const }, vecFixed: { x: 234, y: 50 },
    vecArrows: [[[126, 74], [126, 108]], [[288, 74], [288, 108]]] as [number, number][][],
    gBox: { x: 40, y: 110, w: 280, h: 46 }, gFrozen: [0, 0],
    gToF: [[118, 156], [118, 186]] as [number, number][], blockAt: [126, 176], rerunAt: [110, 176],
    gToI: [[288, 156], [288, 186]] as [number, number][], iBox: { x: 232, y: 188, w: 112, h: 46 },
    latentText: [[180, 22, 'latent'], [126, 42, 'trainedN'], [288, 42, 'fixedN']] as [number, number, string][],
    fcap: [[232, 262, 'fN0'], [232, 280, 'fN1'], [232, 298, 'fN2']] as [number, number, string][], fcapAnchor: 'start',
    loss: { x: 20, y: 420, w: 310, h: 128 }, fToLoss: [[118, 384], [118, 418]] as [number, number][],
    grad: [[330, 524], [352, 524], [352, 62], [344, 62]] as [number, number][], gradAt: [0, 0],
    track: { x: 20, y: 582, w: 310, h: 84 }, fToTrack: [[20, 360], [8, 360], [8, 624], [18, 624]] as [number, number][], fPrimeAt: [30, 376],
    up: [[250, 580], [250, 550]] as [number, number][], upAt: [258, 570], stopAt: [175, 692],
    legend: { x: 20, y: 724, step: 160, rows: 2 },
    badges: [[60, 133], [36, 440], [352, 300], [44, 172], [36, 602]] as [number, number][],
  },
];
type L = (typeof layouts)[number];
const textOf = (k: string) => (k.startsWith('fN') ? t.fN[Number(k.slice(2))] : (t as Record<string, unknown>)[k] as string);
const toneOf = (k: string) => (k === 'fixed' || k === 'fixedN' ? 'f-t-muted' : 'f-t-blue');
const cell = (L: L, i: number, j: number) => [L.fx + i * CS, L.fy + j * CS];
const ctr = (L: L, q: readonly number[]) => [L.fx + (q[0] + 0.5) * CS, L.fy + (q[1] + 0.5) * CS];
const tip = (L: L) => { const [x, y] = ctr(L, P); return [x + D[0] * CS, y + D[1] * CS]; };
const lineY = (L: L, k: number) => L.loss.y + 20 + k * 19;
---

<Figure
  id={id}
  title={ru ? 'Одна итерация DragGAN: motion supervision и отслеживание точки' : 'One DragGAN iteration: motion supervision and point tracking'}
  caption={ru
    ? 'Синие — латент и признаки, которые он порождает; жёлтые — замороженный генератор и окна Ω₁ и Ω₂; зелёные — то, что задаёт пользователь (цели gᵢ, маска M); красные — изображение, положения точек и градиент. Оптимизируются только w₁ … w₆, коды грубых слоёв. Карта признаков нарисована схематично: 10 × 10 клеток, участок Ω₁ 3 × 3 и окно Ω₂ 5 × 5; при 512 × 512 DragGAN берёт круг радиуса r₁ = 3 и квадрат с r₂ = 12, λ = 20 и Adam с шагом 2·10⁻³.'
    : 'Blue: the latent and the features it produces; amber: the frozen generator and the windows Ω₁ and Ω₂; green: what the user gives (goals gᵢ, mask M); red: the image, the handle positions and the gradient. Only w₁ … w₆, the codes of the coarse layers, are optimized. The feature map is drawn schematically, 10 × 10 cells with a 3 × 3 patch Ω₁ and a 5 × 5 window Ω₂; at 512 × 512 DragGAN uses a disc of radius r₁ = 3, a square with r₂ = 12, λ = 20 and Adam with learning rate 2·10⁻³.'}
>
  {layouts.map((L) => {
    const [px, py] = ctr(L, P), [gx, gy] = ctr(L, G), [qx, qy] = ctr(L, P2), [tx, ty] = tip(L);
    const [s1x, s1y] = [L.fx + (P[0] - 1 + D[0]) * CS, L.fy + (P[1] - 1 + D[1]) * CS];
    const [o2x, o2y] = cell(L, P[0] - 2, P[1] - 2);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Итерация DragGAN' : 'A DragGAN iteration'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Латент w из l кодов, из которых обучаются первые шесть, идёт в замороженный StyleGAN2; тот выдаёт изображение и карту признаков F. На карте точка p, цель g, участок Ω₁ вокруг p и тот же участок, сдвинутый на шаг d. Потеря motion supervision даёт градиент по w₁…w₆; после шага Adam генератор запускается снова, и поиск ближайшего соседа в окне Ω₂ находит новое положение точки p′.'
          : 'A latent w of l codes, of which the first six are trained, enters a frozen StyleGAN2, which outputs the image and the feature map F. On the map: the handle p, the goal g, the patch Ω₁ around p and the same patch moved one step d. The motion-supervision loss sends a gradient to w₁…w₆; after the Adam step the generator runs again, and nearest-neighbour search in the window Ω₂ finds the new handle position p′.'}</desc>
        <Vec x={L.vec.x} y={L.vec.y} cw={L.vec.cw} ch={L.vec.ch} dir={L.vec.dir} values={['w₁', 'w₂', 'w₃', 'w₄', 'w₅', 'w₆']} tone="h" bold />
        <Vec x={L.vecFixed.x} y={L.vecFixed.y} cw={L.vec.cw} ch={L.vec.ch} dir={L.vec.dir} values={['w₇', '⋮', 'wₗ']} tone="n" />
        {L.latentText.map(([x, y, k]) => <text class={`f-small ${toneOf(k)}`} x={x} y={y} text-anchor="middle">{textOf(k)}</text>)}
        <Box x={L.gBox.x} y={L.gBox.y} w={L.gBox.w} h={L.gBox.h} label="G" sub={L.wide ? t.gsub : t.gsubN} tone="g" subGap={L.wide ? 15 : 19} />
        {L.wide && <text class="f-small f-t-muted" x={L.gFrozen[0]} y={L.gFrozen[1]} text-anchor="middle">{t.frozen}</text>}
        <rect x={L.fx} y={L.fy} width={N * CS} height={N * CS} style="fill: var(--paper); stroke: var(--line); stroke-width: 1" />
        {heat.map((c) => { const [x, y] = cell(L, c.i, c.j); return <rect x={x} y={y} width={CS} height={CS} style={`fill: var(--fig-blue); fill-opacity: ${c.o}`} />; })}
        <path d={`M ${px} ${py} L ${gx} ${gy}`} class="f-line f-muted f-dot" style="stroke-width: 1.4" />
        <circle cx={gx} cy={gy} r="6" style="fill: var(--paper); stroke: var(--fig-green); stroke-width: 2.2" />
        <text class="f-small f-t-green f-halo" x={gx} y={gy + 22} text-anchor="middle">g</text>
        <circle cx={px} cy={py} r="5" class="f-solid-red" />
        <text class="f-small f-t-red f-halo" x={px - 9} y={py - 8} text-anchor="end">p</text>
        {L.fcap.map(([x, y, k]) => <text class={`f-small ${k === 'fcap2' || k === 'fN1' || k === 'fN2' ? 'f-t-muted' : 'f-t-blue'}`} x={x} y={y} text-anchor={L.fcapAnchor}>{textOf(k)}</text>)}
        <g data-s="1 4">
          {L.vecArrows.map((a) => <Arrow pts={a} tone="blue" />)}
          <Arrow pts={L.gToF} tone="blue" />
          <text class="f-small f-t-amber" x={L.blockAt[0]} y={L.blockAt[1]} text-anchor={L.wide ? 'middle' : 'start'}>{t.block}</text>
          <Arrow pts={L.gToI} tone="red" />
          <Box x={L.iBox.x} y={L.iBox.y} w={L.iBox.w} h={L.iBox.h} label={t.image} sub="512 × 512" tone="y" subGap={L.wide ? 15 : 19} />
        </g>
        <g data-s="2">
          {omega1.map(([i, j]) => { const [x, y] = cell(L, i, j); return <rect x={x} y={y} width={CS} height={CS} style="fill: var(--fig-amber); fill-opacity: .3; stroke: var(--fig-amber); stroke-width: .6" />; })}
          <rect x={s1x} y={s1y} width={3 * CS} height={3 * CS} class="f-line f-amber f-dash" style="stroke-width: 1.4" />
          <Arrow pts={[[px, py], [tx, ty]]} tone="red" bold />
          <text class="f-small f-t-red f-halo" x={tx + 7} y={ty - 6}>d</text>
          <text class="f-small f-t-amber f-halo" x={L.fx + (P[0] - 1) * CS - 3} y={L.fy + (P[1] - 1) * CS - 4} text-anchor="end">Ω₁</text>
          <Arrow pts={L.fToLoss} tone="blue" />
          <rect x={L.loss.x} y={L.loss.y} width={L.loss.w} height={L.loss.h} rx="7" style="fill: var(--paper-strong); stroke: var(--line); stroke-width: 1.3" />
          <text class="f-small" x={L.loss.x + L.loss.w / 2} y={lineY(L, 0)} text-anchor="middle" style="font-weight: 650">{t.ms}</text>
          <text class="f-small" x={L.loss.x + 14} y={lineY(L, 1) + 3}>{t.ms1}</text>
          <text class="f-small" x={L.loss.x + 26} y={lineY(L, 2) + 3}>{t.ms2}</text>
          <text class="f-small" x={L.loss.x + 26} y={lineY(L, 3) + 3}>{t.ms3}</text>
          <text class="f-small f-t-green" x={L.loss.x + 14} y={lineY(L, 4) + 6}>{t.user}</text>
        </g>
        <g data-s="3">
          <Arrow pts={L.grad} tone="red" dashed />
          {L.wide
            ? <text class="f-small f-t-red f-halo" x={L.gradAt[0]} y={L.gradAt[1]} text-anchor="middle">{t.grad}</text>
            : <text class="f-small f-t-red" x={L.loss.x + 14} y={lineY(L, 5) + 6}>{t.gradN}</text>}
        </g>
        <g data-s="4">
          <text class="f-small f-t-amber f-halo" x={L.rerunAt[0]} y={L.rerunAt[1]} text-anchor={L.wide ? 'middle' : 'end'}>{t.rerun}</text>
        </g>
        <g data-s="5">
          <rect x={o2x} y={o2y} width={5 * CS} height={5 * CS} class="f-line f-amber f-dash" style="stroke-width: 1.3" />
          <text class="f-small f-t-amber f-halo" x={o2x + 2} y={o2y - 5}>Ω₂</text>
          <circle cx={qx} cy={qy} r="5" class="f-solid-red" />
          <text class="f-small f-t-red f-halo" x={qx + 8} y={qy + 16}>p′</text>
          <Arrow pts={L.fToTrack} tone="blue" />
          <text class="f-small f-t-blue f-halo" x={L.fPrimeAt[0]} y={L.fPrimeAt[1]} text-anchor="middle">F′</text>
          <rect x={L.track.x} y={L.track.y} width={L.track.w} height={L.track.h} rx="7" style="fill: var(--paper-strong); stroke: var(--line); stroke-width: 1.3" />
          <text class="f-small" x={L.track.x + L.track.w / 2} y={L.track.y + 20} text-anchor="middle" style="font-weight: 650">{t.tr}</text>
          <text class="f-small" x={L.track.x + 14} y={L.track.y + 42}>{t.tr1}</text>
          <text class="f-small" x={L.track.x + 26} y={L.track.y + 62}>{t.tr2}</text>
          <Arrow pts={L.up} tone="red" />
          <text class="f-small f-t-red" x={L.upAt[0]} y={L.upAt[1]}>{t.repeat}</text>
          <text class="f-small f-t-muted" x={L.stopAt[0]} y={L.stopAt[1]} text-anchor="middle">{t.stop}</text>
        </g>
        {L.badges.map(([x, y], k) => <Badge x={x} y={y} n={k + 1} />)}
        <Legend x={L.legend.x} y={L.legend.y} step={L.legend.step} rows={L.legend.rows} />
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
