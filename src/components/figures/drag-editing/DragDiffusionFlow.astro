---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// DragDiffusion on a 512 × 512 photo with Stable Diffusion 1.5, in the colours of the sequence-model figures:
// the photo is an input (green), latents are states (blue), the fine-tuned U-Net is amber, the edited image is red.
// 50 DDIM steps, inversion to t = 35, at most 80 optimization steps, LoRA rank 16 trained for 80 steps.
const T_INV = 35, T_ALL = 50, OPT = 80, LORA = 80;
const latent = [4, 512 / 8, 512 / 8];
if (latent[0] * latent[1] * latent[2] !== 16384) throw new Error('DragDiffusionFlow: latent size drifted');

const t = ru
  ? {
      x: 'фото x', xs: '512 × 512', z0s: '4 × 64 × 64', zts: `t = ${T_INV}`, zhs: 'изменён', xh: 'результат', xhs: 'изменено',
      E: 'E', inv: 'обращение', invS: `${T_INV} из ${T_ALL}`, opt: 'оптимизация', optS: `≤ ${OPT} шагов`, den: 'денойзинг', denN: 'денойзинг + D',
      lora: 'U-Net с LoRA Δθ', loraS: `ранг 16, ${LORA} шагов обучения на одном z₀`, loraN: ['LoRA Δθ', `${LORA} шагов на z₀`, 'нужна в 2–4'],
      det1: 'признаки декодера U-Net', det2: 'r₁ = 1, r₂ = 3, λ = 0.1', detN: ['признаки U-Net', 'r₁ = 1, r₂ = 3', 'λ = 0.1'],
      ref: 'опорный проход', refS: `денойзинг исходного z₃₅`, refN: ['опорный', 'проход по z₃₅'], kv: 'K, V',
      steps: [
        `Дообучение с сохранением идентичности: веса LoRA Δθ в слоях внимания U-Net учатся убирать шум с зашумлённых копий одного латента z₀ (${LORA} шагов)`,
        `Обращение DDIM: детерминированный сэмплер идёт в обратную сторону ${T_INV} из ${T_ALL} шагов, от z₀ до зашумлённого латента z₃₅`,
        `Оптимизация латента: motion supervision и отслеживание точек на признаках декодера U-Net меняют только z₃₅, не больше ${OPT} шагов Adam`,
        'Денойзинг с reference-latent-control: параллельный проход по исходному z₃₅ даёт ключи и значения self-attention в блоках повышения разрешения; декодер D возвращает изменённое изображение',
      ],
    }
  : {
      x: 'photo x', xs: '512 × 512', z0s: '4 × 64 × 64', zts: `t = ${T_INV}`, zhs: 'edited', xh: 'result', xhs: 'edited',
      E: 'E', inv: 'invert', invS: `${T_INV} of ${T_ALL}`, opt: 'optimize', optS: `≤ ${OPT} steps`, den: 'denoise', denN: 'denoise + D',
      lora: 'U-Net with LoRA Δθ', loraS: `rank 16, trained for ${LORA} steps on this z₀ alone`, loraN: ['LoRA Δθ', `${LORA} steps on z₀`, 'used in 2–4'],
      det1: 'U-Net decoder features', det2: 'r₁ = 1, r₂ = 3, λ = 0.1', detN: ['U-Net features', 'r₁ = 1, r₂ = 3', 'λ = 0.1'],
      ref: 'reference pass', refS: 'denoise the original z₃₅', refN: ['reference', 'pass on z₃₅'], kv: 'K, V',
      steps: [
        `Identity-preserving fine-tuning: LoRA weights Δθ in the attention layers of the U-Net learn to denoise noisy copies of this one latent z₀ (${LORA} steps)`,
        `DDIM inversion: the deterministic sampler runs backwards for ${T_INV} of its ${T_ALL} steps, from z₀ to the noisy latent z₃₅`,
        `Latent optimization: motion supervision and point tracking on the U-Net decoder’s features change only z₃₅, for at most ${OPT} Adam steps`,
        'Denoising with reference-latent-control: a parallel pass on the original z₃₅ supplies the keys and values of self-attention in the up-blocks; the decoder D returns the edited image',
      ],
    };

const id = 'drag-editing-dragdiffusion';
---

<Figure
  id={id}
  title={ru ? 'DragDiffusion: четыре этапа' : 'DragDiffusion in four stages'}
  caption={ru
    ? `Зелёное — исходное фото, синие — латенты Stable Diffusion 1.5 (4 × 64 × 64 для фото 512 × 512), жёлтое — U-Net с весами LoRA, красное — результат. Оптимизируется один латент z₃₅ на шаге ${T_INV} из ${T_ALL} шагов DDIM; всё остальное заморожено после этапа 1. Classifier-free guidance для реальных фото выключен и в инверсии, и в денойзинге.`
    : `Green: the input photo; blue: latents of Stable Diffusion 1.5 (4 × 64 × 64 for a 512 × 512 photo); amber: the U-Net with its LoRA weights; red: the result. The only variable of the drag is one latent, z₃₅, at step ${T_INV} of ${T_ALL} DDIM steps; everything else is frozen after stage 1. For real photos, classifier-free guidance is switched off in both inversion and denoising.`}
>
  <svg class="fig-wide" viewBox="0 0 760 336" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{ru ? 'Конвейер DragDiffusion' : 'The DragDiffusion pipeline'}</title>
    <desc id={`${id}-w-d`}>{ru
      ? 'Ряд блоков: фото x, латент z₀, z₃₅ после обращения, изменённый ẑ₃₅ и результат. Над ними U-Net с LoRA, обученная на z₀ и используемая на всех следующих этапах. Под ними опорный проход по исходному z₃₅, который передаёт ключи и значения в денойзинг изменённого латента.'
      : 'A row of blocks: the photo x, the latent z₀, z₃₅ after inversion, the edited ẑ₃₅ and the result. Above them, the U-Net with LoRA, trained on z₀ and used in all later stages. Below them, a reference pass on the original z₃₅ that hands keys and values to the denoising of the edited latent.'}</desc>
    <Box x={32} y={122} w={80} h={50} label="x" sub={t.xs} tone="x" />
    <text class="f-small f-t-green" x={72} y={190} text-anchor="middle">{t.x}</text>
    <Arrow pts={[[112, 147], [184, 147]]} />
    <text class="f-small f-t-amber" x={149} y={139} text-anchor="middle">{t.E}</text>
    <Box x={186} y={122} w={80} h={50} label="z₀" sub={t.z0s} tone="h" />
    <g data-s="1">
      <rect x={186} y={24} width={464} height={44} rx="7" style="fill: var(--fig-amber); fill-opacity: .14; stroke: var(--fig-amber); stroke-width: 1.3" />
      <text class="f-label" x={418} y={42} text-anchor="middle">{t.lora}</text>
      <text class="f-small f-t-muted" x={418} y={60} text-anchor="middle">{t.loraS}</text>
      <Arrow pts={[[226, 122], [226, 70]]} tone="blue" />
    </g>
    <g data-s="2">
      <Arrow pts={[[266, 147], [338, 147]]} tone="blue" />
      <text class="f-small f-t-amber" x={303} y={139} text-anchor="middle">{t.inv}</text>
      <text class="f-small f-t-muted" x={303} y={166} text-anchor="middle">{t.invS}</text>
      <Arrow pts={[[303, 68], [303, 120]]} tone="amber" dashed />
      <Box x={340} y={122} w={80} h={50} label="z₃₅" sub={t.zts} tone="h" />
    </g>
    <g data-s="3">
      <Arrow pts={[[420, 147], [492, 147]]} tone="blue" />
      <text class="f-small f-t-amber" x={457} y={139} text-anchor="middle">{t.opt}</text>
      <text class="f-small f-t-muted" x={457} y={166} text-anchor="middle">{t.optS}</text>
      <Arrow pts={[[457, 68], [457, 120]]} tone="amber" dashed />
      <Box x={494} y={122} w={80} h={50} label="ẑ₃₅" sub={t.zhs} tone="h" />
      <text class="f-small f-t-muted" x={457} y={198} text-anchor="middle">{t.det1}</text>
      <text class="f-small f-t-muted" x={457} y={214} text-anchor="middle">{t.det2}</text>
    </g>
    <g data-s="4">
      <Arrow pts={[[574, 147], [646, 147]]} tone="red" />
      <text class="f-small f-t-amber" x={611} y={139} text-anchor="middle">{t.den}</text>
      <Arrow pts={[[611, 68], [611, 120]]} tone="amber" dashed />
      <Box x={648} y={122} w={80} h={50} label="D(ẑ₀)" sub={t.xhs} tone="y" />
      <text class="f-small f-t-red" x={688} y={190} text-anchor="middle">{t.xh}</text>
      <path class="f-line f-blue" d="M 366 172 L 366 267 L 516 267" marker-end="url(#f-arrow-blue)" />
      <rect x={520} y={244} width={220} height={46} rx="7" style="fill: var(--paper-strong); stroke: var(--line); stroke-width: 1.3" />
      <text class="f-small" x={630} y={263} text-anchor="middle" style="font-weight: 650">{t.ref}</text>
      <text class="f-small f-t-muted" x={630} y={281} text-anchor="middle">{t.refS}</text>
      <Arrow pts={[[611, 244], [611, 152]]} tone="amber" />
      <text class="f-small f-t-amber f-halo" x={618} y={226}>{t.kv}</text>
    </g>
    <Badge x={204} y={46} n={1} />
    <Badge x={303} y={192} n={2} />
    <Badge x={457} y={238} n={3} />
    <Badge x={594} y={205} n={4} />
    <Legend x={24} y={324} step={130} />
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 486" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{ru ? 'Конвейер DragDiffusion' : 'The DragDiffusion pipeline'}</title>
    <desc id={`${id}-n-d`}>{ru
      ? 'Столбец блоков: фото x, латент z₀, z₃₅ после обращения, изменённый ẑ₃₅ и результат. Слева LoRA, справа опорный проход, передающий ключи и значения в денойзинг.'
      : 'A column of blocks: the photo x, the latent z₀, z₃₅ after inversion, the edited ẑ₃₅ and the result. LoRA on the left, the reference pass on the right, handing keys and values to the denoising.'}</desc>
    <Box x={120} y={20} w={120} h={44} label="x" sub={t.xs} tone="x" subGap={19} />
    <Arrow pts={[[180, 64], [180, 96]]} />
    <text class="f-small f-t-amber" x={190} y={86}>{t.E}</text>
    <Box x={120} y={98} w={120} h={44} label="z₀" sub={t.z0s} tone="h" subGap={19} />
    <g data-s="1">
      <rect x={6} y={90} width={104} height={64} rx="7" style="fill: var(--fig-amber); fill-opacity: .14; stroke: var(--fig-amber); stroke-width: 1.3" />
      {t.loraN.map((s, k) => <text class={k ? 'f-small f-t-muted' : 'f-small'} x={58} y={108 + k * 18} text-anchor="middle" style={k ? '' : 'font-weight: 650'}>{s}</text>)}
      <Arrow pts={[[120, 128], [112, 128]]} tone="blue" />
    </g>
    <g data-s="2">
      <Arrow pts={[[180, 142], [180, 186]]} tone="blue" />
      <text class="f-small f-t-amber" x={190} y={162}>{t.inv}</text>
      <text class="f-small f-t-muted" x={190} y={180}>{t.invS}</text>
      <Box x={120} y={188} w={120} h={44} label="z₃₅" sub={t.zts} tone="h" subGap={19} />
    </g>
    <g data-s="3">
      <Arrow pts={[[180, 232], [180, 276]]} tone="blue" />
      <text class="f-small f-t-amber" x={190} y={252}>{t.opt}</text>
      <text class="f-small f-t-muted" x={190} y={270}>{t.optS}</text>
      <Box x={120} y={278} w={120} h={44} label="ẑ₃₅" sub={t.zhs} tone="h" subGap={19} />
      {t.detN.map((s, k) => <text class="f-small f-t-muted" x={8} y={244 + k * 18}>{s}</text>)}
    </g>
    <g data-s="4">
      <Arrow pts={[[180, 322], [180, 366]]} tone="red" />
      <text class="f-small f-t-amber" x={110} y={348} text-anchor="end">{t.denN}</text>
      <Box x={120} y={368} w={120} h={44} label="D(ẑ₀)" sub={t.xhs} tone="y" subGap={19} />
      <path class="f-line f-blue" d="M 240 210 L 330 210 L 330 290" marker-end="url(#f-arrow-blue)" />
      <rect x={252} y={292} width={102} height={46} rx="7" style="fill: var(--paper-strong); stroke: var(--line); stroke-width: 1.3" />
      {t.refN.map((s, k) => <text class={k ? 'f-small f-t-muted' : 'f-small'} x={303} y={310 + k * 18} text-anchor="middle">{s}</text>)}
      <Arrow pts={[[252, 330], [186, 344]]} tone="amber" />
      <text class="f-small f-t-amber f-halo" x={224} y={360} text-anchor="middle">{t.kv}</text>
    </g>
    <Badge x={18} y={82} n={1} />
    <Badge x={166} y={164} n={2} />
    <Badge x={166} y={254} n={3} />
    <Badge x={166} y={344} n={4} />
    <Legend x={20} y={450} step={160} rows={2} />
  </svg>
  <Stepper steps={t.steps} />
</Figure>
