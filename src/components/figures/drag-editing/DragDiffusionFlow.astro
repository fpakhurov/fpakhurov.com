---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
const ru = pageLang(Astro.url) === 'ru';
// Original two-token scalar fixture. No paper image, feature tensor, checkpoint or photograph.
const keys = [[1, 0], [0, 1]];
const values = [[2, -1], [-2, 3]];
const queries = [[Math.SQRT2 * Math.log(3), 0], [0, Math.SQRT2 * Math.log(3)]];
const rows = queries.map((q, i) => {
  const logits = keys.map(k => (q[0] * k[0] + q[1] * k[1]) / Math.SQRT2);
  const e = logits.map(Math.exp), sum = e[0] + e[1];
  const weights = e.map(x => x / sum);
  const output = [0, 1].map(j => weights[0] * values[0][j] + weights[1] * values[1][j]);
  const expected = i === 0 ? [1, 0] : [-1, 2];
  if (output.some((x,j) => Math.abs(x - expected[j]) > 1e-12)) throw new Error('Attention fixture drift');
  return { label: i === 0 ? 'A' : 'B', logits: i === 0 ? '(log 3, 0)' : '(0, log 3)', weights, output };
});
const id = 'drag-editing-dragdiffusion';
const pair = (xs: number[]) => `(${xs.map(x => Number(x.toFixed(2))).join(', ')})`;
---
<Figure id={id}
  title={ru ? 'Общие значения, разные смеси' : 'Shared values, different mixtures'}
  caption={ru ? 'Ключи и значения фиксированы. Перестановка координат запроса меняет веса с (¾, ¼) на (¼, ¾) и выход с (1, 0) на (−1, 2). Исходное содержимое участвует в обоих выходах, но само по себе не фиксирует результат. Числа заданы для этого примера.' : 'Keys and values stay fixed. Swapping query coordinates changes weights from (¾, ¼) to (¼, ¾) and output from (1, 0) to (−1, 2). The reference contributes to both outputs but does not fix the result. Numbers are specified for this example.'}>
  <svg viewBox="0 0 360 354" style="max-width: 520px; margin-inline: auto" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>{ru ? 'Две смеси одних опорных значений' : 'Two mixtures of the same reference values'}</title>
    <desc id={`${id}-d`}>{ru ? 'K1=(1,0), K2=(0,1), V1=(2,-1), V2=(-2,3). Запрос A даёт веса 0.75 и 0.25, выход (1,0). Запрос B меняет веса местами, выход (-1,2).' : 'K1=(1,0), K2=(0,1), V1=(2,-1), V2=(-2,3). Query A gives weights 0.75 and 0.25, output (1,0). Query B swaps the weights, output (-1,2).'}</desc>
    <text x="180" y="23" text-anchor="middle" class="f-small f-t-muted">{ru ? 'Опорные токены: фиксированы' : 'Reference tokens: fixed'}</text>
    {keys.map((key, i) => <g>
      <rect x={16+i*172} y="36" width="156" height="62" rx="6" style="fill:var(--paper-strong);stroke:var(--line)" />
      <text x={94+i*172} y="60" text-anchor="middle" class="f-small">K{i+1} = {pair(key)}</text>
      <text x={94+i*172} y="82" text-anchor="middle" class="f-small f-t-blue">V{i+1} = {pair(values[i])}</text>
    </g>)}
    {rows.map((r,i) => <g>
      <rect x="16" y={114+i*116} width="328" height="102" rx="6" style="fill:var(--paper-strong);stroke:var(--line)" />
      <text x="30" y={136+i*116} class="f-small">{ru ? 'Запрос' : 'Query'} {r.label}: QKᵀ/√2 = {r.logits}</text>
      <text x="30" y={161+i*116} class="f-small f-t-muted">softmax → {pair(r.weights)}</text>
      <text x="30" y={192+i*116} class="f-small f-t-blue">{Number(r.weights[0].toFixed(2))} V₁ + {Number(r.weights[1].toFixed(2))} V₂ = {pair(r.output)}</text>
    </g>)}
  </svg>
</Figure>
