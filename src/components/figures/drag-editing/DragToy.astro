---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { C0, P0, GOAL, GRID, SIG, R1, R2, LR, phi, disk, runDrag, msGrad, distToGoal } from './toy';

const ru = pageLang(Astro.url) === 'ru';

// Run the toy (see toy.ts) and check every number the caption and the note quote.
const withSg = runDrag(true);
const steps = withSg.length - 1;
const last = withSg[steps];
const noSg = runDrag(false, steps);
const lastNo = noSg[steps];
const gSg = msGrad(P0, [0, 0], true), gNo = msGrad(P0, [0, 0], false);
const norm = (g: number[]) => Math.hypot(g[0], g[1]);
const angle = (r: typeof gSg) => (Math.acos(-(r.g[0] * r.d[0] + r.g[1] * r.d[1]) / norm(r.g)) * 180) / Math.PI;
// The loss of each iteration, evaluated before its step: it does not decrease, the note quotes its range.
const losses = withSg.slice(0, -1).map((h) => msGrad(h.p, h.s, true).loss);
const trackErr = Math.hypot(last.p[0] - (P0[0] + last.s[0]), last.p[1] - (P0[1] + last.s[1]));
const checks: [string, string][] = [
  [String(steps), '13'],
  [last.p.join(','), '20,13'],
  [last.s.map((v) => v.toFixed(2)).join(','), '9.11,4.01'],
  [trackErr.toFixed(2), '0.11'],
  [distToGoal(P0).toFixed(2), '10.77'],
  [lastNo.p.join(','), '10,10'],
  [distToGoal(lastNo.p).toFixed(2), '11.40'],
  [norm(gSg.g).toFixed(2), '7.84'],
  [norm(gNo.g).toFixed(2), '0.80'],
  [angle(gSg).toFixed(0), '4'],
  [angle(gNo).toFixed(0), '111'],
  [String(disk(P0, R1).length), '25'],
  [Math.min(...losses).toFixed(1), '7.4'],
  [Math.max(...losses).toFixed(1), '8.5'],
];
for (const [got, want] of checks) if (got !== want) throw new Error(`DragToy: computed ${got}, the caption says ${want}`);

const t = ru
  ? { map: `карта признаков (канал 1) после ${steps} шагов`, plot: 'расстояние ‖p − g‖ до цели, пиксели', iter: 'итерация k', p0: 'p₀', pEnd: `p₁₃`, goal: 'цель g', start: 'пятно в начале', handle: 'отслеженная точка p', goalL: 'цель g', o1: `Ω₁, r₁ = ${R1}`, o2: `Ω₂, r₂ = ${R2}`, sg: 'со stop-gradient', nosg: 'без него', nosgM: 'без sg', stop: 'стоп: 1 пиксель' }
  : { map: `feature map (channel 1) after ${steps} steps`, plot: 'distance ‖p − g‖ to the goal, pixels', iter: 'iteration k', p0: 'p₀', pEnd: 'p₁₃', goal: 'goal g', start: 'blob at the start', handle: 'tracked handle p', goalL: 'goal g', o1: `Ω₁, r₁ = ${R1}`, o2: `Ω₂, r₂ = ${R2}`, sg: 'with stop-gradient', nosg: 'without', nosgM: 'no sg', stop: 'stop at 1 px' };

const id = 'drag-editing-toy';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 322, c: 11, gx: 24, gy: 46, leg: [[24, 286], [204, 286], [24, 306], [204, 306], [384, 306]], px: [452, 736], py: [250, 60], head: 30, legY: 44, xl: 282, legStep: 150 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 640, c: 10, gx: 20, gy: 46, leg: [[20, 274], [190, 274], [20, 298], [190, 298], [20, 322]], px: [56, 336], py: [570, 396], head: 362, legY: 382, xl: 604, legStep: 170 },
];
type L = (typeof layouts)[number];
const cells = (L: L) => {
  const out: { x: number; y: number; o: string }[] = [];
  for (let x = 0; x < GRID.w; x++)
    for (let y = 0; y < GRID.h; y++) {
      const g = phi(x - C0[0] - last.s[0], y - C0[1] - last.s[1])[0];
      if (g > 0.03) out.push({ x: L.gx + x * L.c, y: L.gy + y * L.c, o: (0.75 * g).toFixed(2) });
    }
  return out;
};
const cc = (L: L, q: readonly number[]) => [L.gx + (q[0] + 0.5) * L.c, L.gy + (q[1] + 0.5) * L.c];
const trail = (L: L) => polyline(withSg.map((h) => cc(L, h.p) as [number, number]));
const omega1 = (L: L) => disk(P0, R1).map((q) => ({ x: L.gx + q[0] * L.c, y: L.gy + q[1] * L.c }));
const sx = (L: L) => scale([0, steps], L.px as [number, number]);
const sy = (L: L) => scale([0, 12], L.py as [number, number]);
const curve = (L: L, hist: typeof withSg) => polyline(hist.map((h) => [sx(L)(h.k), sy(L)(distToGoal(h.p))] as [number, number]));
const xticks = [0, 5, 10, steps];
const yticks = [0, 4, 8, 12];
---

<Figure
  id={id}
  title={ru ? 'Игрушечный DragGAN: одна точка, сдвиг пятна как латент' : 'A toy DragGAN: one handle, the position of a blob as the latent'}
  caption={ru
    ? `Игрушечный «генератор» рисует одно пятно (σ = ${SIG}), положение которого и есть латент s; три канала дают каждой точке рядом с ним свой признак. Точка p₀ = (${P0.join(', ')}), цель g = (${GOAL.join(', ')}), r₁ = ${R1}, r₂ = ${R2}, шаг ${LR}. Со stop-gradient точка доходит до цели за ${steps} итераций; без него уходит на 11.40 пикселя от цели. Числа игрушечные.`
    : `A toy "generator" draws one blob (σ = ${SIG}) whose position is the latent s; three channels give each point near it its own feature. Handle p₀ = (${P0.join(', ')}), goal g = (${GOAL.join(', ')}), r₁ = ${R1}, r₂ = ${R2}, step size ${LR}. With the stop-gradient the handle reaches the goal in ${steps} iterations; without it, it drifts to 11.40 px away. Toy numbers.`}
>
  {layouts.map((L) => {
    const [p0x, p0y] = cc(L, P0), [gx, gy] = cc(L, GOAL), [ex, ey] = cc(L, last.p), [nx, ny] = cc(L, lastNo.p), [c0x, c0y] = cc(L, C0);
    const X = sx(L), Y = sy(L);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Перетаскивание точки в игрушечной модели' : 'Dragging a handle in a toy model'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? `Слева: карта 32 на 20 с пятном после ${steps} шагов, путь отслеженной точки от (11, 9) до (20, 13) рядом с целью (21, 13), окна Ω₁ и Ω₂ в начале. Справа: расстояние до цели по итерациям; со stop-gradient оно падает с 10.77 до 1, без него растёт до 11.40.`
          : `Left: the 32 by 20 map with the blob after ${steps} steps, the path of the tracked handle from (11, 9) to (20, 13) next to the goal (21, 13), and the windows Ω₁ and Ω₂ at the start. Right: the distance to the goal per iteration; with the stop-gradient it falls from 10.77 to 1, without it grows to 11.40.`}</desc>
        <text class="f-small f-t-muted" x={L.gx} y={L.gy - 14}>{t.map}</text>
        {cells(L).map((q) => <rect x={q.x} y={q.y} width={L.c} height={L.c} style={`fill: var(--fig-blue); fill-opacity: ${q.o}`} />)}
        {omega1(L).map((q) => <rect x={q.x} y={q.y} width={L.c} height={L.c} style="fill: var(--fig-amber); fill-opacity: .3" />)}
        <rect x={L.gx} y={L.gy} width={GRID.w * L.c} height={GRID.h * L.c} style="fill: none; stroke: var(--line); stroke-width: 1" />
        <rect x={L.gx + (P0[0] - R2 + 1) * L.c} y={L.gy + (P0[1] - R2 + 1) * L.c} width={(2 * R2 - 1) * L.c} height={(2 * R2 - 1) * L.c} class="f-line f-amber f-dash" style="stroke-width: 1.3" />
        <circle cx={c0x} cy={c0y} r={SIG * L.c} class="f-line f-muted f-dash" style="stroke-width: 1.2" />
        <path d={trail(L)} class="f-line f-red" style="stroke-width: 1.6" />
        {withSg.slice(1, -1).map((h) => { const [x, y] = cc(L, h.p); return <circle cx={x} cy={y} r="2.2" class="f-solid-red" />; })}
        <circle cx={p0x} cy={p0y} r="4.2" style="fill: var(--paper); stroke: var(--fig-red); stroke-width: 1.8" />
        <circle cx={ex} cy={ey} r="4.2" class="f-solid-red" />
        <circle cx={gx} cy={gy} r="5.5" style="fill: none; stroke: var(--fig-green); stroke-width: 2" />
        <path d={`M ${gx - 3} ${gy} L ${gx + 3} ${gy} M ${gx} ${gy - 3} L ${gx} ${gy + 3}`} class="f-line f-green" style="stroke-width: 1.4" />
        <path d={`M ${nx - 3.5} ${ny - 3.5} L ${nx + 3.5} ${ny + 3.5} M ${nx - 3.5} ${ny + 3.5} L ${nx + 3.5} ${ny - 3.5}`} class="f-line f-muted" style="stroke-width: 1.8" />
        <text class="f-small f-t-red f-halo" x={p0x + 2} y={p0y - 9}>{t.p0}</text>
        <text class="f-small f-t-red f-halo" x={ex - 2} y={ey + 19} text-anchor="middle">{t.pEnd}</text>
        <text class="f-small f-t-green f-halo" x={gx + 9} y={gy - 7}>{t.goal}</text>
        <text class="f-small f-t-muted f-halo" x={nx - 7} y={ny + 17} text-anchor="end">{t.nosgM}</text>
        <g>
          <circle cx={L.leg[0][0] + 6} cy={L.leg[0][1] - 4} r="3.5" class="f-solid-red" />
          <text class="f-small f-t-muted" x={L.leg[0][0] + 16} y={L.leg[0][1]}>{t.handle}</text>
          <circle cx={L.leg[1][0] + 6} cy={L.leg[1][1] - 4} r="5" style="fill: none; stroke: var(--fig-green); stroke-width: 2" />
          <text class="f-small f-t-muted" x={L.leg[1][0] + 16} y={L.leg[1][1]}>{t.goalL}</text>
          <rect x={L.leg[2][0]} y={L.leg[2][1] - 10} width="12" height="12" style="fill: var(--fig-amber); fill-opacity: .3" />
          <text class="f-small f-t-muted" x={L.leg[2][0] + 16} y={L.leg[2][1]}>{t.o1}</text>
          <rect x={L.leg[3][0]} y={L.leg[3][1] - 10} width="12" height="12" class="f-line f-amber f-dash" style="stroke-width: 1.3" />
          <text class="f-small f-t-muted" x={L.leg[3][0] + 16} y={L.leg[3][1]}>{t.o2}</text>
          <circle cx={L.leg[4][0] + 6} cy={L.leg[4][1] - 4} r="6" class="f-line f-muted f-dash" style="stroke-width: 1.2" />
          <text class="f-small f-t-muted" x={L.leg[4][0] + 16} y={L.leg[4][1]}>{t.start}</text>
        </g>
        <text class="f-small f-t-muted" x={L.px[0] - 30} y={L.head}>{t.plot}</text>
        <path d={`M ${L.px[0]} ${L.py[1] - 6} L ${L.px[0]} ${L.py[0]} L ${L.px[1]} ${L.py[0]}`} class="f-axis" />
        {xticks.map((k) => <text class="f-small f-t-muted" x={X(k)} y={L.py[0] + 16} text-anchor="middle">{k}</text>)}
        {yticks.map((v) => <text class="f-small f-t-muted" x={L.px[0] - 7} y={Y(v) + 4} text-anchor="end">{v}</text>)}
        <text class="f-small f-t-muted" x={(L.px[0] + L.px[1]) / 2} y={L.xl} text-anchor="middle">{t.iter}</text>
        <path d={`M ${L.px[0]} ${Y(1)} L ${L.px[1]} ${Y(1)}`} class="f-line f-muted f-dot" style="stroke-width: 1.2" />
        <text class="f-small f-t-muted f-halo" x={X(7)} y={Y(1) - 6} text-anchor="middle">{t.stop}</text>
        <path d={curve(L, noSg)} class="f-line f-muted f-dash" />
        <path d={curve(L, withSg)} class="f-line f-red" />
        {withSg.map((h) => <circle cx={X(h.k)} cy={Y(distToGoal(h.p))} r="2.6" class="f-solid-red" />)}
        <text class="f-small f-t-muted f-halo" x={X(steps)} y={Y(distToGoal(lastNo.p)) + 16} text-anchor="end">11.40</text>
        <path d={`M ${L.px[0] + 8} ${L.legY - 4} L ${L.px[0] + 30} ${L.legY - 4}`} class="f-line f-red" />
        <text class="f-small f-t-muted" x={L.px[0] + 36} y={L.legY}>{t.sg}</text>
        <path d={`M ${L.px[0] + L.legStep + 8} ${L.legY - 4} L ${L.px[0] + L.legStep + 30} ${L.legY - 4}`} class="f-line f-muted f-dash" />
        <text class="f-small f-t-muted" x={L.px[0] + L.legStep + 36} y={L.legY}>{t.nosg}</text>
      </svg>
    );
  })}
</Figure>
