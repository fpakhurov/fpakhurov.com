---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The diamond of the note: class A; class B(A); class C(A); class D(B, C); d = D().
// A and C define kind, every class defines hello. The lookup of d.kind walks d.__dict__, then D.__mro__.
// C3 by hand, checked here: L[D] = D + merge([B, A, object], [C, A, object], [B, C]).
const bases: Record<string, string[]> = { object: [], A: ['object'], B: ['A'], C: ['A'], D: ['B', 'C'] };
function c3(k: string): string[] {
  let seqs = [...bases[k].map(c3), [...bases[k]]];
  const out = [k];
  while (seqs.some((s) => s.length)) {
    seqs = seqs.filter((s) => s.length);
    const head = seqs.map((s) => s[0]).find((h) => !seqs.some((t) => t.slice(1).includes(h)));
    if (!head) throw new Error('no consistent MRO');
    out.push(head);
    seqs = seqs.map((t) => (t[0] === head ? t.slice(1) : t));
  }
  return out;
}
const mro = c3('D');
if (mro.join() !== 'D,B,C,A,object') throw new Error(`MRO ${mro.join()}`);
const own: Record<string, string[]> = { D: ['hello'], B: ['hello'], C: ['hello', 'kind'], A: ['hello', 'kind'], object: ['__repr__', '__eq__', '…'] };
const found = mro.find((k) => own[k].includes('kind'));
if (found !== 'C') throw new Error('kind is found in C');

const t = ru
  ? { graph: 'классы (базы сверху)', chain: 'поиск d.kind: d.__dict__, затем D.__mro__', inst: 'd = D()', empty: '{}  пусто',
      result: "d.kind → 'from C'", skipped: 'не просматривается', hit: 'найдено',
      steps: ['словарь экземпляра d.__dict__ пуст: kind там нет', 'класс D: только hello', 'класс B: только hello', "класс C: найден kind = 'from C', поиск останавливается", 'A стоит после C, поэтому его kind не виден'] }
  : { graph: 'classes (bases above)', chain: 'looking up d.kind: d.__dict__, then D.__mro__', inst: 'd = D()', empty: '{}  empty',
      result: "d.kind → 'from C'", skipped: 'not reached', hit: 'found',
      steps: ['the instance dict d.__dict__ is empty: no kind there', 'class D: only hello', 'class B: only hello', "class C: kind = 'from C' is found, and the search stops", 'A comes after C, so its kind stays hidden'] };

// Rows of the right-hand chain: the instance dict, then each class of the MRO.
const rows = [{ key: 'd', label: 'd.__dict__', body: t.empty, step: 1 }, ...mro.map((k, i) => ({ key: k, label: `${k}.__dict__`, body: own[k].join(', '), step: i < 3 ? i + 2 : 5 }))]
  .map((r) => ({ ...r, reached: r.step < 5, badge: r.key === 'A' ? 5 : r.step < 5 ? r.step : 0 }));
// Step of each node in the class graph: D 2, B 3, C 4, A and object 5.
const nodeStep: Record<string, number> = Object.fromEntries(mro.map((k, i) => [k, i < 3 ? i + 2 : 5]));

interface Layout {
  cls: string; W: number; H: number;
  node: Record<string, [number, number]>; nw: number; nh: number; inst: [number, number] | null; graphHead: [number, number];
  rowX: number; rowW: number; rowY0: number; rowH: number; rowGap: number; bodyX: number; chainHead: [number, number];
  noteY: number; mono: number; sans: number;
}
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 356,
    node: { object: [175, 52], A: [175, 112], B: [95, 182], C: [255, 182], D: [175, 252] }, nw: 74, nh: 32, inst: [175, 318], graphHead: [20, 20],
    rowX: 392, rowW: 356, rowY0: 38, rowH: 34, rowGap: 9, bodyX: 136, chainHead: [372, 20],
    noteY: 318, mono: 7.5, sans: 6.5 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 560,
    node: { object: [180, 50], A: [180, 102], B: [100, 160], C: [260, 160], D: [180, 218] }, nw: 74, nh: 32, inst: null, graphHead: [8, 20],
    rowX: 36, rowW: 316, rowY0: 290, rowH: 34, rowGap: 7, bodyX: 140, chainHead: [8, 270],
    noteY: 545, mono: 8.4, sans: 7.3 },
];
for (const L of layouts) {
  const last = L.rowY0 + (rows.length - 1) * (L.rowH + L.rowGap) + L.rowH;
  if (last > L.noteY - 16) throw new Error(`rows run into the note at ${L.W}`);
  for (const r of rows) {
    if (8 + r.label.length * L.mono > L.bodyX - 6) throw new Error(`label ${r.label} at ${L.W}`);
    if (L.bodyX + r.body.length * L.mono > L.rowW - 6) throw new Error(`body ${r.body} at ${L.W}`);
  }
  if (L.chainHead[0] + t.chain.length * L.sans > L.W - 4) throw new Error(`chain head at ${L.W}`);
  if (L.W === 760 && L.rowX + L.rowW - 8 - t.skipped.length * L.sans < L.rowX + L.bodyX + 'hello, kind'.length * L.mono + 8) throw new Error('skipped note collides');
}
const id = 'attribute-lookup';
const tone = (k: string) => (k === 'd' ? toneVar.x : k === found ? toneVar.y : toneVar.h);
---

<Figure
  id={id}
  title={ru ? 'Поиск атрибута: экземпляр, затем классы по MRO' : 'Attribute lookup: the instance, then the classes in MRO order'}
  caption={ru
    ? "Ромб из заметки: class B(A), class C(A), class D(B, C) и экземпляр d = D(). Слева — граф наследования, стрелки ведут от подкласса к базе. Справа — порядок, в котором Python ищет d.kind: сначала словарь экземпляра (1), затем классы в порядке D.__mro__ = (D, B, C, A, object), вычисленном алгоритмом C3. В D и B атрибута нет (2, 3); в C он есть (4), и поиск останавливается. A тоже определяет kind, но стоит после C (5): C3 ставит каждый класс раньше всех его баз, поэтому общая база A проверяется только после обоих подклассов."
    : "The diamond of the note: class B(A), class C(A), class D(B, C) and an instance d = D(). Left, the inheritance graph, arrows from a subclass to its base. Right, the order in which Python looks up d.kind: the instance dictionary first (1), then the classes in the order of D.__mro__ = (D, B, C, A, object), computed by the C3 algorithm. D and B do not have the attribute (2, 3); C does (4), and the search stops. A defines kind as well but comes after C (5): C3 puts every class before all of its bases, so the shared base A is checked only after both of its subclasses."}
>
  {layouts.map((L) => {
    const edge = (from: string, to: string) => {
      const [x1, y1] = L.node[from], [x2, y2] = L.node[to];
      const sy = y1 - L.nh / 2, ey = y2 + L.nh / 2;
      const sx = x1 + (x2 - x1) * 0.18, ex = x2 - (x2 - x1) * 0.18;
      return `M ${sx} ${sy - 1} L ${ex} ${ey + 3}`;
    };
    const rowY = (i: number) => L.rowY0 + i * (L.rowH + L.rowGap);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Ромбовидное наследование и порядок поиска атрибута' : 'Diamond inheritance and the order of attribute lookup'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Граф классов: object наверху, под ним A, под ним B и C, внизу D, наследующий B и C. Рядом столбец из шести строк: словарь экземпляра d, затем словари D, B, C, A и object. Строки d, D и B не содержат kind; строка C содержит kind и отмечена как найденная; строки A и object не просматриваются.'
          : 'A class graph: object at the top, A below it, B and C below A, and D at the bottom inheriting from B and C. Beside it a column of six rows: the instance dictionary of d, then the dictionaries of D, B, C, A and object. The rows for d, D and B have no kind; the row for C has kind and is marked as found; the rows for A and object are not reached.'}</desc>
        <text class="f-small f-t-muted" x={L.graphHead[0]} y={L.graphHead[1]} style="font-weight: 650">{t.graph}</text>
        {Object.entries(bases).flatMap(([k, bs]) => bs.map((b) => (
          <path class="f-line f-muted" d={edge(k, b)} marker-end="url(#f-arrow-muted)" />
        )))}
        {Object.keys(bases).map((k) => {
          const [x, y] = L.node[k];
          const step = nodeStep[k];
          return (
            <g data-s={String(step)}>
              <rect x={x - L.nw / 2} y={y - L.nh / 2} width={L.nw} height={L.nh} rx="6" style={`fill: ${tone(k)}; fill-opacity: 0.14; stroke: ${tone(k)}; stroke-width: ${k === found ? 2.2 : 1.3}`} />
              <text class="f-label" x={x} y={y + 5} text-anchor="middle" style="font-family: var(--mono)">{k}</text>
            </g>
          );
        })}
        {L.inst && (
          <g data-s="1">
            <rect x={L.inst[0] - 50} y={L.inst[1] - 15} width="100" height="30" rx="6" style={`fill: ${toneVar.x}; fill-opacity: 0.14; stroke: ${toneVar.x}; stroke-width: 1.3`} />
            <text class="f-small" x={L.inst[0]} y={L.inst[1] + 4.5} text-anchor="middle" style="font-family: var(--mono)">{t.inst}</text>
            <path class="f-line f-green f-dash" d={`M ${L.inst[0]} ${L.inst[1] - 16} V ${L.node.D[1] + L.nh / 2 + 3}`} marker-end="url(#f-arrow-green)" />
          </g>
        )}
        <text class="f-small f-t-muted" x={L.chainHead[0]} y={L.chainHead[1]} style="font-weight: 650">{t.chain}</text>
        {rows.map((r, i) => {
          const y = rowY(i);
          const reached = r.reached;
          return (
            <g data-s={String(r.step)}>
              <rect x={L.rowX} y={y} width={L.rowW} height={L.rowH} rx="5" style={`fill: ${tone(r.key)}; fill-opacity: ${reached ? 0.14 : 0.05}; stroke: ${tone(r.key)}; stroke-width: ${r.key === found ? 2.2 : 1.1}; ${reached ? '' : 'stroke-dasharray: 5 4'}`} />
              <text class="f-small" x={L.rowX + 8} y={y + L.rowH / 2 + 4.5} style="font-family: var(--mono)">{r.label}</text>
              <text class={`f-small ${reached ? '' : 'f-t-muted'}`} x={L.rowX + L.bodyX} y={y + L.rowH / 2 + 4.5} style="font-family: var(--mono)">{r.body}</text>
              {r.key === found && L.W === 760 && <text class="f-small f-t-red" x={L.rowX + L.rowW - 8} y={y + L.rowH / 2 + 4.5} text-anchor="end" style="font-weight: 650">{t.hit}</text>}
              {!reached && r.key === 'A' && L.W === 760 && <text class="f-small f-t-muted" x={L.rowX + L.rowW - 8} y={y + L.rowH / 2 + 4.5} text-anchor="end">{t.skipped}</text>}
              {r.badge ? <Badge x={L.rowX - 16} y={y + L.rowH / 2} n={r.badge} /> : null}
            </g>
          );
        })}
        <text class="f-small f-t-red" x={L.rowX} y={L.noteY} style="font-family: var(--mono); font-weight: 650">{t.result}</text>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
