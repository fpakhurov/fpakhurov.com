---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Top: the graph of tasks of the fraud pipeline. Bottom: the partitions each run of the Example rebuilt,
// with their row counts (the printed output of the program in the note).
const nodes = ru
  ? [['сырые события', 'по дате прихода'], ['партиции', 'по дате события'], ['проверка', ''], ['признаки', ''], ['выборка', 'зрелые метки'], ['обучение', '']]
  : [['raw events', 'by arrival date'], ['clean', 'by event date'], ['validate', ''], ['features', ''], ['training set', 'mature labels'], ['train', '']];
const cb = ru ? ['чарджбэки', 'через недели'] : ['chargebacks', 'weeks later'];
const t = ru
  ? { graph: 'граф задач', grid: 'партиции, пересобранные каждым запуском (строки), по дате события (столбцы)', join: 'метки созрели',
      legend: ['пересобрана', 'окончательная', 'те же байты', 'дозаполнение'],
      cols: ['1 окт.', '2 окт.', '3 окт.', '4 окт.'],
      rows: ['запуск 2 окт.', 'запуск 3 окт.', 'запуск 4 окт.', 'запуск 5 окт.', 'повтор 5 окт.', 'дозаполнение 9 окт.'],
      rowsN: ['2 окт.', '3 окт.', '4 окт.', '5 окт.', 'повтор', 'дозаполнение'],
      steps: ['граф: сырые события → партиции по дате события → проверка → признаки → выборка → обучение; чарджбэки присоединяются, когда метки созрели', 'каждый запуск пересобирает партиции трёх последних дат: 1 октября растёт с 270 до 294 и 299 строк', 'после двух дней ожидания опоздавших событий партиция становится окончательной: 299 из 300 строк', 'повторный запуск с теми же входами пишет те же байты: хеши совпадают', 'дозаполнение 9 октября пересобирает 1–4 октября из всего пришедшего: по 300 строк'] }
  : { graph: 'the graph of tasks', grid: 'partitions rebuilt by each run (rows), by event date (columns)', join: 'labels mature',
      legend: ['rebuilt', 'final', 'same bytes', 'backfill'],
      cols: ['1 Oct', '2 Oct', '3 Oct', '4 Oct'],
      rows: ['run of 2 Oct', 'run of 3 Oct', 'run of 4 Oct', 'run of 5 Oct', 're-run of 5 Oct', 'backfill on 9 Oct'],
      rowsN: ['2 Oct', '3 Oct', '4 Oct', '5 Oct', 're-run', 'backfill'],
      steps: ['the graph: raw events → clean partitions by event date → validate → features → training set → train; chargebacks join once labels mature', 'each run rebuilds the partitions of the last three dates: 1 October grows from 270 to 294 to 299 rows', 'after two days of lateness a partition is final: 299 of 300 rows', 'a re-run with the same inputs writes the same bytes: the hashes match', 'a backfill on 9 October rebuilds 1–4 October from everything that has arrived: 300 rows each'] };

// The output of the Example: row counts per (run, event date); F final, S same bytes as the previous run.
type Cell = { n: number; final?: boolean; same?: boolean } | null;
const grid: Cell[][] = [
  [{ n: 270 }, null, null, null],
  [{ n: 294 }, { n: 270 }, null, null],
  [{ n: 299, final: true }, { n: 296 }, { n: 272 }, null],
  [null, { n: 299, final: true }, { n: 296 }, { n: 272 }],
  [null, { n: 299, final: true, same: true }, { n: 296, same: true }, { n: 272, same: true }],
  [{ n: 300 }, { n: 300 }, { n: 300 }, { n: 300 }],
];
const rowStep = [2, 2, 2, 2, 4, 5];
const cellStep = (r: number, c: Cell) => (c && c.final && r < 4 ? 3 : rowStep[r]);
// Delays of 0-3 days with weights 90, 8, 1.5, 0.5: the first build holds 90%, a final one (two days late) 99.5%.
const weights = [90, 8, 1.5, 0.5];
const complete = weights.map((_, k) => weights.slice(0, k + 1).reduce((a, b) => a + b, 0));
if (complete.join(',') !== '90,98,99.5,100') throw new Error(`completeness ${complete}`);
if (Math.round(3 * complete[0]) !== 270 || Math.round(3 * complete[2]) !== 299) throw new Error('counts vs completeness');
if (grid[5].some((c) => !c || c.n !== 300)) throw new Error('backfill rows');

const green = toneVar.x, blue = toneVar.h, amber = toneVar.g, red = toneVar.y;
const cellStyle = (r: number, c: NonNullable<Cell>) =>
  r === 5 ? `fill: ${amber}; fill-opacity: 0.2; stroke: ${amber}; stroke-width: 1.2`
  : `fill: ${blue}; fill-opacity: ${c.same ? 0.05 : 0.14}; stroke: ${c.final ? green : blue}; stroke-width: ${c.final ? 2.6 : 1}${c.same ? '; stroke-dasharray: 4 3' : ''}`;

// Node widths from their labels.
const nodeW = (n: string[], label: number, small: number) => Math.max(n[0].length * label, n[1].length * small) + 16;

// Wide layout.
const W = 760, X0 = 20, NGAP = 28, NY = 48, NH = 50;
const wW = nodes.map((n) => Math.max(60, nodeW(n, 7.5, 6.5)));
const wX: number[] = [];
{ let x = X0 + 12; for (const w of wW) { wX.push(x); x += w + NGAP; } }
if (wX[5] + wW[5] > W - 10) throw new Error(`graph too wide ${wX[5] + wW[5]}`);
const cbW = nodeW(cb, 7.5, 6.5), cbX = wX[4], cbY = NY + NH + 26;
if (cbX - 8 - t.join.length * 6.5 < wX[2]) throw new Error('join label');
const GY = 216, GH = 22, GP = 28, GX0 = 210, GW = 86, GG = 8;
const gx = (c: number) => GX0 + c * (GW + GG);
if (gx(3) + GW > 596) throw new Error('grid too wide');
for (const r of t.rows) if (196 - r.length * 6.5 < 32) throw new Error(`row label ${r}`);
if (X0 + t.grid.length * 6.5 > W - 10) throw new Error('grid title');
const LX = 610;
for (const l of t.legend) if (LX + 20 + l.length * 6.5 > W - 6) throw new Error(`legend ${l}`);
const H = GY + 6 * GP + 18;

// Narrow layout.
const NW = 360, NX = 20, NBW = 176, NBH = 44, NP = 58, NTOP = 34;
const nY = nodes.map((_, i) => NTOP + i * NP);
for (const n of nodes) if (n[0].length * 8.0 > NBW - 12 || n[1].length * 7.3 > NBW - 12) throw new Error(`narrow node ${n[0]}`);
const ncbX = 222, ncbW = 120;
if (cb[0].length * 8.0 > ncbW - 10 || cb[1].length * 7.3 > ncbW - 10) throw new Error('narrow chargebacks');
const nGridTop = nY[5] + NBH + 46;
const NGX0 = 120, NGW = 54, NGG = 4, NGH = 22, NGP = 30;
const ngx = (c: number) => NGX0 + c * (NGW + NGG);
if (ngx(3) + NGW > NW - 6) throw new Error('narrow grid too wide');
for (const r of t.rowsN) if (NGX0 - 8 - r.length * 7.3 < 24) throw new Error(`narrow row ${r}`);
for (const c of t.cols) if (c.length * 7.3 > NGW - 4) throw new Error(`narrow col ${c}`);
const nLegendY = nGridTop + 6 * NGP + 20;
const NHt = nLegendY + 40;
const id = 'pipeline-dag';
---

<Figure
  id={id}
  title={ru ? 'Конвейер как граф задач и его запуски по датам' : 'A pipeline as a graph of tasks, and its runs by date'}
  caption={ru
    ? 'Сверху — граф задач конвейера мошенничества (1). Снизу — какие партиции пересобрал каждый запуск программы из примера и сколько в них строк. Каждый ночной запуск пересобирает три последние даты события, потому что события опаздывают (2); после двух дней ожидания опоздавших событий партиция становится окончательной, с 299 из 300 строк (зелёная рамка, 3). Повторный запуск с теми же входами пишет те же байты (пунктир, 4). Дозаполнение 9 октября пересобирает 1–4 октября из всего пришедшего и подбирает события, опоздавшие на три дня (5).'
    : 'Top: the graph of tasks of the fraud pipeline (1). Bottom: which partitions each run of the Example rebuilt, and how many rows they held. Each nightly run rebuilds the last three event dates, because events arrive late (2); after two days of lateness a partition is final, with 299 of its 300 rows (green frame, 3). A re-run with the same inputs writes the same bytes (dashed, 4). A backfill on 9 October rebuilds 1–4 October from everything that has arrived, picking up the events that were three days late (5).'}
>
  <svg class="fig-wide fig-bp-640" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`${id}-760-t ${id}-760-d`}>
    <title id={`${id}-760-t`}>{ru ? 'Граф задач и таблица запусков по датам' : 'The task graph and a table of runs by date'}</title>
    <desc id={`${id}-760-d`}>{ru
      ? 'Сверху цепочка задач: сырые события, партиции по дате события, проверка, признаки, выборка, обучение; снизу в выборку входят чарджбэки. Ниже таблица: строки — запуски 2, 3, 4 и 5 октября, повтор 5 октября и дозаполнение 9 октября; столбцы — даты событий 1–4 октября; в клетках число строк: 270, затем 294, 299; 296, 299; 272, 296; повтор с теми же числами; дозаполнение по 300.'
      : 'At the top a chain of tasks: raw events, clean partitions by event date, validate, features, training set, train; chargebacks enter the training set from below. Below, a table: rows are the runs of 2, 3, 4 and 5 October, the re-run of 5 October and the backfill on 9 October; columns are event dates 1–4 October; cells hold row counts: 270, then 294, 299; 296, 299; 272, 296; the re-run with the same counts; the backfill with 300 each.'}</desc>
    <g data-s="1">
      <text class="f-small f-t-muted" x={X0} y={28} style="font-weight: 650">{t.graph}</text>
      {nodes.map((n, i) => (
        <g>
          {i > 0 && <path class="f-line f-muted" d={`M ${wX[i - 1] + wW[i - 1] + 1} ${NY + NH / 2} H ${wX[i] - 3}`} marker-end="url(#f-arrow-muted)" />}
          <rect x={wX[i]} y={NY} width={wW[i]} height={NH} rx="7" style={`fill: ${i === 0 ? green : blue}; fill-opacity: 0.12; stroke: ${i === 0 ? green : blue}; stroke-width: 1.2`} />
          <text class="f-label" x={wX[i] + wW[i] / 2} y={n[1] ? NY + 22 : NY + NH / 2 + 5} text-anchor="middle">{n[0]}</text>
          {n[1] && <text class="f-small f-t-muted" x={wX[i] + wW[i] / 2} y={NY + 39} text-anchor="middle">{n[1]}</text>}
        </g>
      ))}
      <rect x={cbX} y={cbY} width={cbW} height={NH - 6} rx="7" style={`fill: ${green}; fill-opacity: 0.12; stroke: ${green}; stroke-width: 1.2`} />
      <text class="f-label" x={cbX + cbW / 2} y={cbY + 19} text-anchor="middle">{cb[0]}</text>
      <text class="f-small f-t-muted" x={cbX + cbW / 2} y={cbY + 36} text-anchor="middle">{cb[1]}</text>
      <path class="f-line f-muted" d={`M ${cbX + 24} ${cbY - 1} V ${NY + NH + 3}`} marker-end="url(#f-arrow-muted)" />
      <text class="f-small f-t-muted" x={cbX - 8} y={cbY + 24} text-anchor="end">{t.join}</text>
      <Badge x={wX[0]} y={NY} n={1} />
    </g>
    <text class="f-small f-t-muted" x={X0} y={GY - 26} style="font-weight: 650">{t.grid}</text>
    {t.cols.map((c, j) => <text class="f-small f-t-muted" x={gx(j) + GW / 2} y={GY - 8} text-anchor="middle">{c}</text>)}
    {grid.map((row, r) => (
      <g>
        <text class="f-small" x={196} y={GY + r * GP + GH / 2 + 4.5} text-anchor="end" data-s={String(rowStep[r])}>{t.rows[r]}</text>
        {row.map((c, j) => c && (
          <g data-s={String(cellStep(r, c))}>
            <rect x={gx(j)} y={GY + r * GP} width={GW} height={GH} rx="4" style={cellStyle(r, c)} />
            <text class="f-small" x={gx(j) + GW / 2} y={GY + r * GP + GH / 2 + 4.5} text-anchor="middle" style={c.final ? 'font-weight: 650' : ''}>{c.n}</text>
          </g>
        ))}
      </g>
    ))}
    {[[0, 2], [2, 3], [4, 4], [5, 5]].map(([r, n]) => (
      <g data-s={String(n)}><Badge x={X0 + 4} y={GY + r * GP + GH / 2} n={n} /></g>
    ))}
    {t.legend.map((l, k) => {
      const y = GY + 8 + k * 26;
      const style = k === 0 ? cellStyle(0, { n: 0 }) : k === 1 ? cellStyle(2, { n: 0, final: true }) : k === 2 ? cellStyle(4, { n: 0, same: true }) : cellStyle(5, { n: 0 });
      return (
        <g>
          <rect x={LX} y={y} width="14" height="12" rx="2" style={style} />
          <text class="f-small f-t-muted" x={LX + 20} y={y + 10.5}>{l}</text>
        </g>
      );
    })}
  </svg>

  <svg class="fig-narrow seq-narrow fig-bp-640" viewBox={`0 0 ${NW} ${NHt}`} role="img" aria-labelledby={`${id}-360-t ${id}-360-d`}>
    <title id={`${id}-360-t`}>{ru ? 'Граф задач и таблица запусков по датам' : 'The task graph and a table of runs by date'}</title>
    <desc id={`${id}-360-d`}>{ru
      ? 'Сверху вниз цепочка задач: сырые события, партиции, проверка, признаки, выборка, обучение; справа в выборку входят чарджбэки. Ниже таблица запусков по датам события 1–4 октября с числом строк в каждой пересобранной партиции.'
      : 'Top to bottom, a chain of tasks: raw events, clean partitions, validate, features, training set, train; chargebacks enter the training set from the right. Below, a table of runs by event dates 1–4 October with the row count of each rebuilt partition.'}</desc>
    <g data-s="1">
      {nodes.map((n, i) => (
        <g>
          {i > 0 && <path class="f-line f-muted" d={`M ${NX + NBW / 2} ${nY[i - 1] + NBH + 1} V ${nY[i] - 3}`} marker-end="url(#f-arrow-muted)" />}
          <rect x={NX} y={nY[i]} width={NBW} height={NBH} rx="7" style={`fill: ${i === 0 ? green : blue}; fill-opacity: 0.12; stroke: ${i === 0 ? green : blue}; stroke-width: 1.2`} />
          <text class="f-label" x={NX + NBW / 2} y={n[1] ? nY[i] + 19 : nY[i] + NBH / 2 + 5} text-anchor="middle">{n[0]}</text>
          {n[1] && <text class="f-small f-t-muted" x={NX + NBW / 2} y={nY[i] + 37} text-anchor="middle">{n[1]}</text>}
        </g>
      ))}
      <rect x={ncbX} y={nY[4]} width={ncbW} height={NBH} rx="7" style={`fill: ${green}; fill-opacity: 0.12; stroke: ${green}; stroke-width: 1.2`} />
      <text class="f-label" x={ncbX + ncbW / 2} y={nY[4] + 19} text-anchor="middle">{cb[0]}</text>
      <text class="f-small f-t-muted" x={ncbX + ncbW / 2} y={nY[4] + 37} text-anchor="middle">{cb[1]}</text>
      <path class="f-line f-muted" d={`M ${ncbX - 1} ${nY[4] + NBH / 2} H ${NX + NBW + 3}`} marker-end="url(#f-arrow-muted)" />
      <Badge x={NX} y={nY[0]} n={1} />
    </g>
    {t.cols.map((c, j) => <text class="f-small f-t-muted" x={ngx(j) + NGW / 2} y={nGridTop - 10} text-anchor="middle">{c}</text>)}
    {grid.map((row, r) => (
      <g>
        <text class="f-small" x={NGX0 - 8} y={nGridTop + r * NGP + NGH / 2 + 5} text-anchor="end" data-s={String(rowStep[r])}>{t.rowsN[r]}</text>
        {row.map((c, j) => c && (
          <g data-s={String(cellStep(r, c))}>
            <rect x={ngx(j)} y={nGridTop + r * NGP} width={NGW} height={NGH} rx="4" style={cellStyle(r, c)} />
            <text class="f-small" x={ngx(j) + NGW / 2} y={nGridTop + r * NGP + NGH / 2 + 5} text-anchor="middle" style={c.final ? 'font-weight: 650' : ''}>{c.n}</text>
          </g>
        ))}
      </g>
    ))}
    {[[0, 2], [2, 3], [4, 4], [5, 5]].map(([r, n]) => (
      <g data-s={String(n)}><Badge x={12} y={nGridTop + r * NGP + NGH / 2} n={n} /></g>
    ))}
    {t.legend.map((l, k) => {
      const x = 20 + (k % 2) * 170, y = nLegendY + Math.floor(k / 2) * 22;
      const style = k === 0 ? cellStyle(0, { n: 0 }) : k === 1 ? cellStyle(2, { n: 0, final: true }) : k === 2 ? cellStyle(4, { n: 0, same: true }) : cellStyle(5, { n: 0 });
      return (
        <g>
          <rect x={x} y={y} width="14" height="12" rx="2" style={style} />
          <text class="f-small f-t-muted" x={x + 20} y={y + 11}>{l}</text>
        </g>
      );
    })}
  </svg>
  <Stepper steps={t.steps} />
</Figure>
