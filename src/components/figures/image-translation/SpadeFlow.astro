---
import Figure from '../Figure.astro';
import {pageLang} from '../../../utils/lang';
import data from './cases.json';
// Original six-site modulation table; no source architecture or example image.
const ru=pageLang(Astro.url)==='ru';
const id='image-translation-spade-flow';
const d=data.modulation;
const rows=[
 {label:'h',values:d.h},
 {label:'h + 7',values:d.shifted_h},
 {label:ru?'Норм. h':'Norm. h',values:d.normalized},
 {label:'γ(m)',values:d.gamma},
 {label:'β(m)',values:d.beta},
 {label:ru?'Выход':'Output',values:d.output},
];
const layouts=[{cls:'fig-wide',w:760,h:316,left:140,cell:96},{cls:'fig-narrow',w:360,h:316,left:92,cell:42}];
const fmt=(x:number)=>Number.isInteger(x)?String(x):x.toFixed(2).replace('-','−');
---
<Figure id={id}
 title={ru?'Нормализация теряет сдвиг; маска возвращает управление':'Normalization loses an offset; the mask restores control'}
 caption={ru?'Два разных входа дают одинаковые нормализованные значения. Затем метки A/B/C задают разные γ и β. Это явная таблица коэффициентов, а не обученная сеть SPADE. Числа округлены; ε = 1/4, дисперсия нормализованного h равна 4/5.':'Two different inputs give the same normalized values. Labels A/B/C then select different γ and β. This is an explicit coefficient lookup, not a trained SPADE network. Values are rounded; ε = 1/4, and normalized h has variance 4/5.'}>
 {layouts.map(l=><svg class={l.cls} viewBox={`0 0 ${l.w} ${l.h}`} role="img" aria-labelledby={`${id}-${l.w}-title ${id}-${l.w}-desc`}>
  <title id={`${id}-${l.w}-title`}>{ru?'Шесть позиций с тремя метками':'Six sites with three labels'}</title>
  <desc id={`${id}-${l.w}-desc`}>{ru?'Вход чередует 1 и 3, второй вход 8 и 10. Нормализованные значения чередуют −0.8944 и 0.8944. Метки A,A,B,B,C,C выбирают масштабы 1,1,2,2,0.5,0.5 и сдвиги −1,−1,0,0,2,2.':'Input alternates 1 and 3, and a second input 8 and 10. Normalized values alternate −0.8944 and 0.8944. Labels A,A,B,B,C,C select scales 1,1,2,2,0.5,0.5 and shifts −1,−1,0,0,2,2.'}</desc>
  <text class="f-small f-t-muted" x={12} y={30}>{ru?'Метка m':'Label m'}</text>
  {d.labels.map((label,j)=><text class="f-label f-t-blue" x={l.left+(j+.5)*l.cell} y={30} text-anchor="middle">{label}</text>)}
  {rows.map((row,i)=>{
   const y=44+40*i;
   return <g>
    <line class="f-grid" x1={12} x2={l.w-12} y1={y} y2={y}/>
    <text class={i===5?'f-label f-t-amber':'f-small f-t-muted'} x={12} y={y+26}>{row.label}</text>
    {row.values.map((value,j)=><text class={i===5?'f-small f-t-amber':'f-small'} x={l.left+(j+.5)*l.cell} y={y+26} text-anchor="middle">{fmt(value)}</text>)}
   </g>;
  })}
  <text class="f-small f-t-muted" x={l.w/2} y={307} text-anchor="middle">{ru?'Выход = γ(m) · норм. h + β(m)':'Output = γ(m) · normalized h + β(m)'}</text>
 </svg>)}
</Figure>
