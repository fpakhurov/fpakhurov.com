---
import Figure from '../Figure.astro';
import {pageLang} from '../../../utils/lang';
import data from './cases.json';
// Original four-entry signals and an explicitly specified conditional law.
const ru=pageLang(Astro.url)==='ru';
const id='image-translation-mean-vs-sample';
const d=data.super_resolution;
const panels=[
 ...d.candidates.map((values,i)=>({label:`${['a','b','c'][i]}: p = ${d.probabilities[i]}`,values})),
 {label:ru?'Условное среднее':'Conditional mean',values:d.mean_float},
];
const risks=[
 {label:ru?'Среднее':'Mean',mse:d.mean_mse},
 {label:ru?'Независимый образец':'Independent sample',mse:d.sample_mse},
 {label:ru?'Всегда вариант b':'Always candidate b',mse:d.deterministic_b_mse},
];
const layouts=[{cls:'fig-wide',w:760,h:322,cols:4,cell:28,panelWidth:178,gap:8,left:14,riskTop:152},
 {cls:'fig-narrow',w:360,h:420,cols:2,cell:28,panelWidth:164,gap:8,left:12,riskTop:250}];
---
<Figure id={id}
 title={ru?'Один уменьшенный сигнал допускает разные детали':'One reduced signal admits different details'}
 caption={ru?'Все три сигнала после усреднения соседних пар дают (2, 2). Среднее минимизирует условную MSE. Независимый образец из указанного распределения удваивает ожидаемую MSE; фиксированный вариант b подчиняется другой формуле. Это конечная задача, не измерение качества генератора.':'All three signals become (2, 2) after averaging adjacent pairs. The mean minimizes conditional MSE. An independent sample from the stated distribution doubles expected MSE; a fixed candidate b follows a different formula. This is a finite problem, not a generator quality measurement.'}>
 {layouts.map(l=><svg class={l.cls} viewBox={`0 0 ${l.w} ${l.h}`} role="img" aria-labelledby={`${id}-${l.w}-title ${id}-${l.w}-desc`}>
  <title id={`${id}-${l.w}-title`}>{ru?'Три возможных сигнала, среднее и риски':'Three possible signals, their mean and risks'}</title>
  <desc id={`${id}-${l.w}-desc`}>{ru?'Сигналы a=(0,4,1,3), b=(2,2,3,1), c=(3,1,0,4), вероятности 1/5, 1/2, 3/10. Среднее (1.9,2.1,1.7,2.3). MSE среднего 29/20, независимого образца 29/10, фиксированного b 23/10.':'Signals a=(0,4,1,3), b=(2,2,3,1), c=(3,1,0,4), probabilities 1/5, 1/2, 3/10. Mean (1.9,2.1,1.7,2.3). MSE: mean 29/20, independent sample 29/10, fixed b 23/10.'}</desc>
  {panels.map((panel,i)=>{
   const x=l.left+(i%l.cols)*(l.panelWidth+l.gap),y=20+Math.floor(i/l.cols)*98;
   const stripX=x+(l.panelWidth-4*l.cell)/2;
   return <g>
    <text class="f-small" x={x+l.panelWidth/2} y={y} text-anchor="middle">{panel.label}</text>
    {panel.values.map((value,j)=><g>
     <rect x={stripX+j*l.cell} y={y+14} width={l.cell} height={32} fill={`rgb(${255*value/4}, ${255*value/4}, ${255*value/4})`} stroke="var(--line)" stroke-width="1"/>
     <text class="f-small f-t-muted" x={stripX+(j+.5)*l.cell} y={y+64} text-anchor="middle">{value}</text>
    </g>)}
   </g>;
  })}
  <text class="f-small f-t-muted" x={16} y={l.riskTop}>{ru?'Правило восстановления':'Reconstruction rule'}</text>
  <text class="f-small f-t-muted" x={l.w-24} y={l.riskTop} text-anchor="end">{ru?'Ожид. MSE':'Expected MSE'}</text>
  {risks.map((row,i)=><g>
   <line class="f-grid" x1={16} x2={l.w-16} y1={l.riskTop+12+i*35} y2={l.riskTop+12+i*35}/>
   <text class={i===0?'f-small f-t-blue':'f-small'} x={16} y={l.riskTop+36+i*35}>{row.label}</text>
   <text class={i===0?'f-label f-t-blue':'f-label'} x={l.w-24} y={l.riskTop+36+i*35} text-anchor="end">{row.mse}</text>
  </g>)}
  <text class="f-small f-t-muted" x={l.w/2} y={l.h-14} text-anchor="middle">{ru?'MSE усредняется по четырём координатам':'MSE is averaged over four entries'}</text>
 </svg>)}
</Figure>
