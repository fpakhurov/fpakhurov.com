---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Super-resolution of a texture whose phase the low-resolution image does not record. The high-resolution patch is
// 8 × 8 with vertical stripes of period 4 (rows 0 0 1 1 0 0 1 1), shifted by 0, 1, 2 or 3 pixels with equal
// probability. Averaging 4 × 4 blocks gives the same 2 × 2 low-resolution image, all 0.5, for every shift.
// The MSE-optimal output is the mean of the four candidates, flat 0.5: MSE 0.25, PSNR 6.02 dB (peak 1).
// A sample (one of the candidates, drawn independently of the truth) has expected MSE 0.5, twice as much: PSNR 3.01 dB.
const base = [0, 0, 1, 1, 0, 0, 1, 1];
const shift = (k: number) => base.map((_, i) => base[(i - k + 8) % 8]);
const cands = [0, 1, 2, 3].map(shift);
const lr = cands.map((row) => [0, 1].map((b) => row.slice(4 * b, 4 * b + 4).reduce((a, v) => a + v, 0) / 4));
const mean = base.map((_, i) => cands.reduce((a, c) => a + c[i], 0) / 4);
const mse = (a: number[], b: number[]) => a.reduce((s, v, i) => s + (v - b[i]) ** 2, 0) / a.length;
const mseMean = cands.reduce((s, c) => s + mse(c, mean), 0) / 4;
const mseSample = cands.reduce((s, c) => s + cands.reduce((t, d) => t + mse(c, d), 0) / 4, 0) / 4;
const psnr = (m: number) => 10 * Math.log10(1 / m);
if (!lr.every((r) => r[0] === 0.5 && r[1] === 0.5)) throw new Error('MeanVsSample: the low-resolution images differ');
if (!mean.every((v) => v === 0.5) || mseMean !== 0.25 || mseSample !== 0.5) throw new Error('MeanVsSample: the MSE values drifted from the note');
if (psnr(mseMean).toFixed(1) !== '6.0' || psnr(mseSample).toFixed(1) !== '3.0') throw new Error('MeanVsSample: the PSNR values drifted from the note');

const t = ru
  ? {
      cand: (k: number) => `сдвиг ${k}`, hr: 'возможные оригиналы', lr: 'вход: 2 × 2', lrSub: 'одинаков для всех',
      mean: 'оптимум MSE: среднее', sample: 'сэмпл', mseM: `MSE ${mseMean.toFixed(2)} · ${psnr(mseMean).toFixed(1)} дБ`,
      mseS: `MSE ${mseSample.toFixed(2)} · ${psnr(mseSample).toFixed(1)} дБ`, sharp: 'резкий', flat: 'плоский серый',
    }
  : {
      cand: (k: number) => `shift ${k}`, hr: 'possible originals', lr: 'input: 2 × 2', lrSub: 'same for all four',
      mean: 'MSE optimum: the mean', sample: 'a sample', mseM: `MSE ${mseMean.toFixed(2)} · ${psnr(mseMean).toFixed(1)} dB`,
      mseS: `MSE ${mseSample.toFixed(2)} · ${psnr(mseSample).toFixed(1)} dB`, sharp: 'sharp', flat: 'flat grey',
    };

// An 8 × 8 patch whose every row is `row`; ink density = pixel value, so it reads the same in both themes.
const patch = (row: number[], x: number, y: number, c: number) =>
  row.flatMap((v, j) => Array.from({ length: 8 }, (_, i) => ({ x: x + j * c, y: y + i * c, c, v })));
const lrPatch = (x: number, y: number, c: number) => [0, 1].flatMap((i) => [0, 1].map((j) => ({ x: x + j * c, y: y + i * c, c, v: 0.5 })));
const id = 'image-translation-mean-vs-sample';
const layouts = [
  {
    cls: 'fig-wide', W: 760, H: 290, c: 8,
    cand: (k: number) => [24 + (k % 2) * 92, 46 + Math.floor(k / 2) * 112], hrLabel: [100, 26],
    lr: [262, 116, 20], lrLabel: [282, 102], lrAnchor: 'middle', lrSub: [282, 176], lrSubAnchor: 'middle',
    out: [[440, 34], [440, 178]], outAnchor: 'start',
    outLabel: (k: number) => [[524, 52], [524, 196]][k], outNote: (k: number) => [[524, 74], [524, 218]][k],
    arrows: [[200, 136, 256, 136], [306, 128, 434, 70], [306, 144, 434, 210]],
  },
  {
    cls: 'fig-narrow seq-narrow', W: 360, H: 420, c: 8,
    cand: (k: number) => [12 + k * 86, 50], hrLabel: [180, 30],
    lr: [160, 166, 20], lrLabel: [150, 190], lrAnchor: 'end', lrSub: [210, 190], lrSubAnchor: 'start',
    out: [[56, 280], [240, 280]], outAnchor: 'middle',
    outLabel: (k: number) => [[88, 366], [272, 366]][k], outNote: (k: number) => [[88, 388], [272, 388]][k],
    arrows: [[180, 136, 180, 162], [168, 210, 104, 274], [192, 210, 256, 274]],
  },
];
---

<Figure
  id={id}
  title={ru ? 'Почему оптимум MSE размыт, а сэмпл резок' : 'Why the MSE optimum is blurry and a sample is sharp'}
  caption={ru
    ? `Игрушечная задача сверхразрешения. Оригинал — фрагмент 8 × 8 с вертикальными полосами периода 4, сдвинутыми на 0, 1, 2 или 3 пикселя с равной вероятностью. Усреднение блоков 4 × 4 даёт один и тот же вход 2 × 2 (все значения 0.5) при любом сдвиге, так что вход не говорит, где лежат полосы. Выход с наименьшей ожидаемой MSE — среднее четырёх кандидатов, ровный серый: MSE ${mseMean.toFixed(2)}, PSNR ${psnr(mseMean).toFixed(2)} дБ (пик 1). Образец — один из кандидатов, выбранный независимо от истинного: ожидаемая MSE ${mseSample.toFixed(2)}, вдвое больше, PSNR ${psnr(mseSample).toFixed(2)} дБ, но это настоящая текстура, а среднее не совпадает ни с одним возможным оригиналом.`
    : `A toy super-resolution problem. The original is an 8 × 8 patch of vertical stripes with period 4, shifted by 0, 1, 2 or 3 pixels with equal probability. Averaging 4 × 4 blocks gives the same 2 × 2 input (all values 0.5) for every shift, so the input does not say where the stripes are. The output with the lowest expected MSE is the mean of the four candidates, a flat grey: MSE ${mseMean.toFixed(2)}, PSNR ${psnr(mseMean).toFixed(2)} dB (peak 1). A sample, one candidate drawn independently of the true one, has expected MSE ${mseSample.toFixed(2)}, twice as much, and PSNR ${psnr(mseSample).toFixed(2)} dB, but it is a real texture, while the mean matches none of the possible originals.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Среднее и сэмпл в задаче сверхразрешения' : 'The mean and a sample in super-resolution'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'Четыре фрагмента с полосами, сдвинутыми на 0–3 пикселя, ведут к одному серому входу 2 × 2. Из него две стрелки: к ровному серому фрагменту (оптимум MSE, MSE 0.25, 6.0 дБ) и к фрагменту с полосами (сэмпл, MSE 0.50, 3.0 дБ).' : 'Four striped patches, shifted by 0 to 3 pixels, lead to one grey 2 × 2 input. From it, two arrows: to a flat grey patch (the MSE optimum, MSE 0.25, 6.0 dB) and to a striped patch (a sample, MSE 0.50, 3.0 dB).'}</desc>
      <text class="f-small f-t-green" x={L.hrLabel[0]} y={L.hrLabel[1]} text-anchor="middle">{t.hr}</text>
      {cands.map((row, k) => {
        const [x, y] = L.cand(k);
        return (
          <g>
            {patch(row, x, y, L.c).map((p) => <rect x={p.x} y={p.y} width={p.c} height={p.c} style={`fill: var(--ink); fill-opacity: ${p.v * 0.85}`} />)}
            <rect x={x} y={y} width={8 * L.c} height={8 * L.c} style="fill: none; stroke: var(--fig-green); stroke-width: 1.2" />
            <text class="f-note" x={x + 4 * L.c} y={y + 8 * L.c + 16} text-anchor="middle">{t.cand(k)}</text>
          </g>
        );
      })}
      {lrPatch(L.lr[0], L.lr[1], L.lr[2]).map((p) => <rect x={p.x} y={p.y} width={p.c} height={p.c} style={`fill: var(--ink); fill-opacity: ${p.v * 0.85}; stroke: var(--fig-green); stroke-width: 1`} />)}
      <text class="f-small" x={L.lrLabel[0]} y={L.lrLabel[1]} text-anchor={L.lrAnchor}>{t.lr}</text>
      <text class="f-note" x={L.lrSub[0]} y={L.lrSub[1]} text-anchor={L.lrSubAnchor}>{t.lrSub}</text>
      {L.arrows.map((a) => <path class="f-line f-muted" d={`M ${a[0]} ${a[1]} L ${a[2]} ${a[3]}`} marker-end="url(#f-arrow-muted)" />)}
      {[mean, cands[1]].map((row, k) => {
        const [x, y] = L.out[k];
        const [lx, ly] = L.outLabel(k);
        const [nx, ny] = L.outNote(k);
        return (
          <g>
            {patch(row, x, y, L.c).map((p) => <rect x={p.x} y={p.y} width={p.c} height={p.c} style={`fill: var(--ink); fill-opacity: ${p.v * 0.85}`} />)}
            <rect x={x} y={y} width={8 * L.c} height={8 * L.c} style="fill: none; stroke: var(--fig-red); stroke-width: 1.4" />
            <text class="f-small f-t-red" x={lx} y={ly} text-anchor={L.outAnchor}>{k === 0 ? t.mean : t.sample}</text>
            <text class="f-note" x={nx} y={ny} text-anchor={L.outAnchor}>{k === 0 ? t.mseM : t.mseS}</text>
            <text class="f-note" x={nx} y={ny + 18} text-anchor={L.outAnchor}>{k === 0 ? t.flat : t.sharp}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
