---
import Figure from '../Figure.astro';
import { polyline } from '../geometry';
import { matrixBrackets } from './flow-math';

const id = 'nf-jacobian-squares';

type Mat = [[number, number], [number, number]];
const cases: { J: Mat; detLabel: string; notes: string[] }[] = [
  { J: [[2, 0], [0, 2]], detLabel: 'det J = 2·2 − 0·0 = 4', notes: ['|det J| = 4', 'stretch 2 times:', 'area × 4,', 'density ÷ 4'] },
  { J: [[2, 0], [0, -2]], detLabel: 'det J = −4', notes: ['|det J| = 4', 'orientation flipped,', 'same area × 4,', 'density ÷ 4'] },
];
const det = (J: Mat) => J[0][0] * J[1][1] - J[0][1] * J[1][0];
const apply = (J: Mat, [a, b]: [number, number]): [number, number] => [J[0][0] * a + J[0][1] * b, J[1][0] * a + J[1][1] * b];

type RowLayout = {
  zo: [number, number]; xo: [number, number]; u: number;
  matrix: [number, number]; arrowY: number; arrowX: [number, number];
  detXY: [number, number]; notesXY: [number, number]; notesInline?: boolean;
  area1XY?: [number, number]; xNameXY?: [number, number];
};

function row(J: Mat, l: RowLayout) {
  const toZ = ([a, b]: [number, number]): [number, number] => [l.zo[0] + a * l.u, l.zo[1] - b * l.u];
  const toX = ([a, b]: [number, number]): [number, number] => [l.xo[0] + a * l.u, l.xo[1] - b * l.u];
  const square: [number, number][] = [[0, 0], [1, 0], [1, 1], [0, 1]];
  const zSquare = `${polyline(square.map(toZ))} Z`;
  const xSquare = `${polyline(square.map((p) => toX(apply(J, p))))} Z`;
  // Orientation marker: a quarter arc from the e1 side towards the e2 side, mapped through J.
  const arc: [number, number][] = [];
  for (let i = 0; i <= 24; i += 1) {
    const t = (12 + (66 * i) / 24) * (Math.PI / 180);
    arc.push([0.55 * Math.cos(t), 0.55 * Math.sin(t)]);
  }
  const zArc = polyline(arc.map(toZ));
  const xArc = polyline(arc.map((p) => toX(apply(J, p))));
  const xImg = square.map((p) => apply(J, p));
  const yMin = Math.min(...xImg.map((p) => p[1]));
  const yMax = Math.max(...xImg.map((p) => p[1]));
  const br = matrixBrackets(l.matrix[0], l.matrix[1], 30, 22);
  return {
    ...l, J, zSquare, xSquare, zArc, xArc, br,
    zAxisH: `M ${l.zo[0] - 22} ${l.zo[1]} H ${l.zo[0] + 1.6 * l.u}`,
    zAxisV: `M ${l.zo[0]} ${l.zo[1] + 22} V ${l.zo[1] - 1.6 * l.u}`,
    xAxisH: `M ${l.xo[0] - 22} ${l.xo[1]} H ${l.xo[0] + 2.7 * l.u}`,
    xAxisV: `M ${l.xo[0]} ${l.xo[1] - Math.min(yMin, 0) * l.u + 22} V ${l.xo[1] - Math.max(yMax, 0.6) * l.u - 16}`,
    // Label position in the corner of the image square opposite the orientation arc.
    areaXY: toX([1, yMax > 0.5 ? 1.55 : -1.6]),
    area1: l.area1XY ?? [l.zo[0] + l.u + 6, l.zo[1] - l.u - 6],
    xName: l.xNameXY ?? [l.xo[0] - 22, yMax > 0.5 ? l.xo[1] + 38 : l.xo[1] - 14],
  };
}

const wide = {
  cls: 'fig-wide', w: 680, h: 352, top: 50,
  rows: [
    row(cases[0].J, { zo: [70, 172], xo: [404, 172], u: 42, matrix: [262, 104], arrowY: 148, arrowX: [162, 352], detXY: [257, 176], notesXY: [534, 98] }),
    row(cases[1].J, { zo: [70, 336], xo: [404, 282], u: 42, matrix: [262, 270], arrowY: 314, arrowX: [162, 352], detXY: [257, 342], notesXY: [534, 296] }),
  ],
  noteGap: 22,
};
const narrow = {
  cls: 'fig-narrow', w: 360, h: 506, top: 0,
  rows: [
    row(cases[0].J, { zo: [40, 150], xo: [236, 150], u: 30, matrix: [162, 46], arrowY: 100, arrowX: [84, 206], detXY: [146, 122], notesXY: [20, 220], notesInline: true, area1XY: [76, 139], xNameXY: [214, 188] }),
    row(cases[1].J, { zo: [40, 400], xo: [236, 350], u: 30, matrix: [162, 296], arrowY: 350, arrowX: [84, 206], detXY: [146, 372], notesXY: [20, 474], notesInline: true, area1XY: [76, 389], xNameXY: [252, 322] }),
  ],
  noteGap: 22,
};
const variants = [wide, narrow];
const fmtEntry = (v: number) => (v < 0 ? `−${-v}` : `${v}`);
---

<Figure
  id={id}
  title="A Jacobian that stretches each direction by a factor of 2"
  caption="Top: J = diag(2, 2) sends the unit square of Z to a 2 × 2 square in X. The area grows from 1 to det J = 4, so the same probability is spread over four times the area and the density drops to a quarter: p_θ(x) = p_Z(z) / |det J|. Bottom: J = diag(2, −2) also flips the second axis. The amber quarter-turn marker now runs clockwise, det J = −4, but the area and the density factor depend only on |det J| = 4."
  origin="redrawn"
>
  {variants.map((v) => (
    <svg class={v.cls} viewBox={`0 ${v.top} ${v.w} ${v.h}`} role="img" aria-labelledby={`${id}-${v.cls}-t ${id}-${v.cls}-d`}>
      <title id={`${id}-${v.cls}-t`}>Unit square mapped by two diagonal Jacobians</title>
      <desc id={`${id}-${v.cls}-d`}>Two rows. In each row a unit square in latent space Z, with an amber quarter-turn arrow running counterclockwise inside it, is mapped by a matrix J to data space X. In the first row J has diagonal entries 2 and 2; the image is a 2 by 2 square above the axis, det J equals 4, the area is multiplied by 4 and the density divided by 4. In the second row J has diagonal entries 2 and minus 2; the image is a 2 by 2 square below the horizontal axis, the quarter-turn arrow now runs clockwise, det J equals minus 4, but the absolute determinant is still 4 and the area is the same.</desc>

      <defs>
        <marker id={`${id}-${v.cls}-ah`} viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
          <path d="M 0 0.8 L 9.5 5 L 0 9.2 L 2.6 5 Z" style="fill: var(--fig-amber)" />
        </marker>
      </defs>

      {v.rows.map((r, k) => (
        <g>
          <!-- Z -->
          <path class="f-axis" d={r.zAxisH} marker-end="url(#f-arrow-muted)" />
          <path class="f-axis" d={r.zAxisV} marker-end="url(#f-arrow-muted)" />
          <path class="f-fill-blue" d={r.zSquare} />
          <path class="f-line f-blue" d={r.zSquare} />
          <path class="f-thin f-amber" d={r.zArc} marker-end={`url(#${id}-${v.cls}-ah)`} />
          <text class="f-math" x={r.zo[0] - 18} y={r.zo[1] + 38}>Z</text>
          <text class="f-small f-t-muted" x={r.area1[0]} y={r.area1[1]}>area 1</text>

          <!-- J -->
          <text class="f-math" x={r.matrix[0] - 36} y={r.matrix[1] + 6} text-anchor="end">J =</text>
          <path class="f-thin" d={r.br.left} />
          <path class="f-thin" d={r.br.right} />
          <text class="f-label" x={r.matrix[0] - 13} y={r.matrix[1] - 5} text-anchor="middle">{fmtEntry(r.J[0][0])}</text>
          <text class="f-label" x={r.matrix[0] + 13} y={r.matrix[1] - 5} text-anchor="middle">{fmtEntry(r.J[0][1])}</text>
          <text class="f-label" x={r.matrix[0] - 13} y={r.matrix[1] + 16} text-anchor="middle">{fmtEntry(r.J[1][0])}</text>
          <text class="f-label" x={r.matrix[0] + 13} y={r.matrix[1] + 16} text-anchor="middle">{fmtEntry(r.J[1][1])}</text>
          <path class="f-line" d={`M ${r.arrowX[0]} ${r.arrowY} H ${r.arrowX[1]}`} marker-end="url(#f-arrow)" />
          <text class="f-small" x={r.detXY[0]} y={r.detXY[1]} text-anchor="middle">{cases[k].detLabel}</text>

          <!-- X -->
          <path class="f-axis" d={r.xAxisH} marker-end="url(#f-arrow-muted)" />
          <path class="f-axis" d={r.xAxisV} marker-end="url(#f-arrow-muted)" />
          <path class="f-fill-blue" d={r.xSquare} />
          <path class="f-line f-blue" d={r.xSquare} />
          <path class="f-thin f-amber" d={r.xArc} marker-end={`url(#${id}-${v.cls}-ah)`} />
          <text class="f-small f-t-muted" x={r.areaXY[0]} y={r.areaXY[1] + 4} text-anchor="middle">area 4</text>
          <text class="f-math" x={r.xName[0]} y={r.xName[1]}>X</text>

          {r.notesInline ? (
            <g>
              <text class="f-label" x={r.notesXY[0]} y={r.notesXY[1]}><tspan style="fill: var(--fig-red)">{cases[k].notes[0]}</tspan>: {cases[k].notes[1].replace(/:$/, '')}</text>
              <text class="f-label" x={r.notesXY[0]} y={r.notesXY[1] + v.noteGap}>{cases[k].notes.slice(2).join(' ')}</text>
            </g>
          ) : (
            cases[k].notes.map((line, i) => (
              <text class={i === 0 ? 'f-label f-t-red' : 'f-label'} x={r.notesXY[0]} y={r.notesXY[1] + i * v.noteGap}>{line}</text>
            ))
          )}
        </g>
      ))}
    </svg>
  ))}
</Figure>
