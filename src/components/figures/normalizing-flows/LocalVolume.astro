---
import Figure from '../Figure.astro';
import { polyline } from '../geometry';
import { flow2d, flow2dDet, polygonArea } from './flow-math';

const id = 'nf-local-volume';

// Grid on Z = [-1.5, 1.5]^2 with spacing 0.5, pushed through the invertible map f (see flow-math.ts).
const ticks = [-1.5, -1, -0.5, 0, 0.5, 1, 1.5];
const samples = 40;
const line = (fixed: number, vertical: boolean) => {
  const pts: [number, number][] = [];
  for (let i = 0; i <= samples; i += 1) {
    const t = -1.5 + (3 * i) / samples;
    pts.push(vertical ? [fixed, t] : [t, fixed]);
  }
  return pts;
};
const gridLines = ticks.flatMap((v) => [line(v, true), line(v, false)]);

function cellBoundary(a0: number, a1: number, b0: number, b1: number, n = 16) {
  const pts: [number, number][] = [];
  for (let i = 0; i < n; i += 1) pts.push([a0 + ((a1 - a0) * i) / n, b0]);
  for (let i = 0; i < n; i += 1) pts.push([a1, b0 + ((b1 - b0) * i) / n]);
  for (let i = 0; i < n; i += 1) pts.push([a1 - ((a1 - a0) * i) / n, b1]);
  for (let i = 0; i < n; i += 1) pts.push([a0, b1 - ((b1 - b0) * i) / n]);
  return pts;
}

const cells = [
  { box: [-1.5, -1, 0.5, 1] as const, cls: 'amber', word: 'squashed' },
  { box: [1, 1.5, -1, -0.5] as const, cls: 'red', word: 'stretched' },
].map((c) => {
  const zPts = cellBoundary(c.box[0], c.box[1], c.box[2], c.box[3]);
  const xPts = zPts.map((p) => flow2d(p));
  const zc = (c.box[0] + c.box[1]) / 2;
  return { ...c, zPts, xPts, det: flow2dDet(zc), ratio: polygonArea(xPts) / polygonArea(zPts) };
});

type Layout = {
  cls: string; w: number; h: number; u: number;
  zo: [number, number]; xo: [number, number];
  arrow: string; fLabel: [number, number];
  labels: { xy: [number, number]; arrow: string }[];
  zName: [number, number]; xName: [number, number];
};

function build(l: Layout) {
  const toZ = ([a, b]: readonly [number, number]): [number, number] => [l.zo[0] + a * l.u, l.zo[1] - b * l.u];
  const toX = ([a, b]: readonly [number, number]): [number, number] => [l.xo[0] + a * l.u, l.xo[1] - b * l.u];
  return {
    ...l,
    zGrid: gridLines.map((pts) => polyline(pts.map(toZ))),
    xGrid: gridLines.map((pts) => polyline(pts.map((p) => toX(flow2d(p))))),
    cells: cells.map((c) => ({ ...c, zPath: `${polyline(c.zPts.map(toZ))} Z`, xPath: `${polyline(c.xPts.map(toX))} Z` })),
  };
}

const wide = build({
  cls: 'fig-wide', w: 640, h: 344, u: 50,
  zo: [122, 176], xo: [478, 170],
  arrow: 'M 226 176 H 362', fLabel: [294, 164],
  labels: [
    { xy: [236, 78], arrow: 'M 346 84 Q 400 92 414 146' },
    { xy: [380, 312], arrow: 'M 496 298 Q 520 280 526 234' },
  ],
  zName: [34, 268], xName: [590, 44],
});
const narrow = build({
  cls: 'fig-narrow', w: 360, h: 520, u: 44,
  zo: [180, 96], xo: [180, 362],
  arrow: 'M 180 172 V 216', fLabel: [194, 200],
  labels: [
    { xy: [12, 262], arrow: 'M 60 290 Q 82 320 118 342' },
    { xy: [230, 482], arrow: 'M 250 466 Q 236 440 226 414' },
  ],
  zName: [96, 34], xName: [300, 250],
});
const variants = [wide, narrow];
const fmt = (v: number) => v.toFixed(2);
---

<Figure
  id={id}
  title="The Jacobian is local geometry"
  caption={`A square grid in Z pushed through an invertible nonlinear map f. Here f(z) = (z₁ + 0.35·sin(1.2·b), b) with b = z₂·e^(0.35·z₁) + 0.2·z₁, so det J_f(z) = e^(0.35·z₁). Each small cell becomes an almost-parallelogram. Its area is multiplied by |det J_f| at that point: the amber cell (z₁ ≈ −1.25) shrinks to ${fmt(cells[0].ratio)} of its area (det ≈ ${fmt(cells[0].det)}), and the red cell (z₁ ≈ 1.25) grows to ${fmt(cells[1].ratio)} times its area (det ≈ ${fmt(cells[1].det)}).`}
  origin="illustrative"
>
  {variants.map((v) => (
    <svg class={v.cls} viewBox={`0 0 ${v.w} ${v.h}`} role="img" aria-labelledby={`${id}-${v.cls}-t ${id}-${v.cls}-d`}>
      <title id={`${id}-${v.cls}-t`}>A grid warped by a nonlinear flow</title>
      <desc id={`${id}-${v.cls}-d`}>{`Left or top: a regular square grid in Z with two highlighted cells. Right or bottom: the same grid after the map f, now curved and fanned out to the right. The amber cell on the left side is squashed to ${fmt(cells[0].ratio)} times its area, matching the absolute Jacobian determinant ${fmt(cells[0].det)} at its centre. The red cell on the right side is stretched to ${fmt(cells[1].ratio)} times its area, matching the determinant ${fmt(cells[1].det)}.`}</desc>

      <defs>
        <marker id={`${id}-${v.cls}-ah`} viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
          <path d="M 0 0.8 L 9.5 5 L 0 9.2 L 2.6 5 Z" style="fill: var(--fig-amber)" />
        </marker>
      </defs>
      {v.zGrid.map((d) => <path class="f-thin f-muted" d={d} />)}
      {v.xGrid.map((d) => <path class="f-thin f-muted" d={d} />)}
      {v.cells.map((c) => (
        <g>
          <path class={`f-fill-${c.cls}`} d={c.zPath} />
          <path class={`f-line f-${c.cls}`} d={c.zPath} />
          <path class={`f-fill-${c.cls}`} d={c.xPath} />
          <path class={`f-line f-${c.cls}`} d={c.xPath} />
        </g>
      ))}
      <text class="f-math" x={v.zName[0]} y={v.zName[1]}>Z</text>
      <text class="f-math" x={v.xName[0]} y={v.xName[1]}>X</text>

      <path class="f-line f-blue" d={v.arrow} marker-end="url(#f-arrow-blue)" />
      <text class="f-math f-t-blue" x={v.fLabel[0]} y={v.fLabel[1]} text-anchor={v.cls === 'fig-wide' ? 'middle' : 'start'}>f</text>

      {v.cells.map((c, i) => (
        <g>
          <text class={`f-label f-t-${c.cls}`} x={v.labels[i].xy[0]} y={v.labels[i].xy[1]}>{c.word}:</text>
          <text class={`f-math f-t-${c.cls}`} x={v.labels[i].xy[0]} y={v.labels[i].xy[1] + 22}>|<tspan font-style="normal">det</tspan> J| ≈ {fmt(c.det)}</text>
          <path class={`f-thin f-${c.cls}`} d={v.labels[i].arrow} marker-end={c.cls === 'red' ? 'url(#f-arrow-red)' : `url(#${id}-${v.cls}-ah)`} />
        </g>
      ))}
    </svg>
  ))}
</Figure>
