---
import Figure from '../Figure.astro';

const id = 'nf-triangular';

const n = 5;
// Operation counts for d = 1000, drawn on a log10 scale.
const d = 1000;
const general = d ** 3;
const triangular = d;

type Layout = {
  cls: string; w: number; h: number;
  cell: number; x0: number; y0: number;
  textX: number; textY: number; perDecade: number;
};

function build(l: Layout) {
  const cells = Array.from({ length: n * n }, (_, k) => {
    const i = Math.floor(k / n);
    const j = k % n;
    const kind = i === j ? 'diag' : i > j ? 'lower' : 'upper';
    return { i, j, kind, x: l.x0 + j * l.cell, y: l.y0 + i * l.cell, label: `${i + 1}${j + 1}` };
  });
  const right = l.x0 + n * l.cell;
  const bottom = l.y0 + n * l.cell;
  const bars = [
    { label: 'general d × d: O(d³)', value: general, exp: '10⁹', cls: 'f-fill-red', stroke: 'f-red', dy: 128 },
    { label: 'triangular: O(d)', value: triangular, exp: '10³', cls: 'f-fill-green', stroke: 'f-green', dy: 192 },
  ].map((b) => ({ ...b, y: l.textY + b.dy, w: Math.log10(b.value) * l.perDecade }));
  return { ...l, cells, right, bottom, bars };
}

const variants = [
  build({ cls: 'fig-wide', w: 580, h: 290, cell: 40, x0: 64, y0: 34, textX: 300, textY: 34, perDecade: 25 }),
  build({ cls: 'fig-narrow', w: 360, h: 520, cell: 44, x0: 76, y0: 16, textX: 24, textY: 270, perDecade: 30 }),
];
---

<Figure
  id={id}
  title="Why a triangular Jacobian is the trick"
  caption={`If every entry above the diagonal is zero, the determinant is the product of the diagonal entries, so log|det A| = Σ log|aᵢᵢ|. For d = ${d}, a general determinant (LU decomposition) costs on the order of d³ = 10⁹ operations, for every example and every layer, whereas the triangular one needs d = 10³ multiplications. Bars are on a log₁₀ scale.`}
  origin="expanded"
>
  {variants.map((v) => (
    <svg class={v.cls} viewBox={`0 0 ${v.w} ${v.h}`} role="img" aria-labelledby={`${id}-${v.cls}-t ${id}-${v.cls}-d`}>
      <title id={`${id}-${v.cls}-t`}>Lower-triangular matrix and the cost of its determinant</title>
      <desc id={`${id}-${v.cls}-d`}>A 5 by 5 lower-triangular matrix A: the diagonal entries a11 to a55 are highlighted in amber, the entries below the diagonal are arbitrary, and every entry above the diagonal is 0. Next to it: det A equals the product of the diagonal entries. Two bars on a log scale compare the cost of a determinant for d equal to 1000: about 10 to the 9 operations for a general matrix versus 10 to the 3 for a triangular one.</desc>

      <text class="f-math" x={v.x0 - 14} y={(v.y0 + v.bottom) / 2 + 6} text-anchor="end">A =</text>
      {v.cells.map((c) => (
        <g>
          {c.kind === 'diag' && <rect class="f-fill-amber" x={c.x + 2} y={c.y + 2} width={v.cell - 4} height={v.cell - 4} rx="3" />}
          {c.kind === 'lower' && <rect class="f-box-soft" x={c.x + 2} y={c.y + 2} width={v.cell - 4} height={v.cell - 4} rx="3" />}
          <text
            class={c.kind === 'diag' ? 'f-math f-t-amber' : c.kind === 'upper' ? 'f-small f-t-muted' : 'f-math'}
            x={c.x + v.cell / 2 - (c.kind === 'upper' ? 0 : 3)}
            y={c.y + v.cell / 2 + 5}
            text-anchor="middle"
          >{c.kind === 'upper' ? '0' : <Fragment>a<tspan dy="4" font-size="11">{c.label}</tspan></Fragment>}</text>
        </g>
      ))}
      <path class="f-thin" d={`M ${v.x0 + 4} ${v.y0 - 4} H ${v.x0 - 4} V ${v.bottom + 4} H ${v.x0 + 4}`} />
      <path class="f-thin" d={`M ${v.right - 4} ${v.y0 - 4} H ${v.right + 4} V ${v.bottom + 4} H ${v.right - 4}`} />

      <text class="f-math f-t-amber" x={v.textX} y={v.textY + 24}><tspan font-style="normal">det</tspan> A = a<tspan dy="4" font-size="12">11</tspan><tspan dy="-4"> · a</tspan><tspan dy="4" font-size="12">22</tspan><tspan dy="-4"> ⋯ a</tspan><tspan dy="4" font-size="12">55</tspan></text>
      <text class="f-note" x={v.textX} y={v.textY + 50}>product of the diagonal</text>

      <text class="f-label" x={v.textX} y={v.textY + 94}>cost of det for d = {d}:</text>
      {v.bars.map((b) => (
        <g>
          <text class="f-small" x={v.textX} y={b.y - 10}>{b.label}</text>
          <rect class={b.cls} x={v.textX} y={b.y} width={b.w} height="20" />
          <rect class={`f-thin ${b.stroke}`} x={v.textX} y={b.y} width={b.w} height="20" />
          <text class="f-label" x={v.textX + b.w + 8} y={b.y + 15}>{b.exp}</text>
        </g>
      ))}
    </svg>
  ))}
</Figure>
