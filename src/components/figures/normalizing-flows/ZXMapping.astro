---
import Figure from '../Figure.astro';
import { flow2d } from './flow-math';

const id = 'nf-zx-mapping';

// Two coordinate systems with the same scale; the points in X are computed as x = f(z).
const unit = 50;
const zo = { x: 150, y: 158 };
const xo = { x: 440, y: 158 };
// Three representative latent points, as in the sketch: one above the horizontal axis, two below.
const zPts: [number, number][] = [
  [0.6, 0.9],
  [1.0, -0.5],
  [0.7, -1.35],
];
const pairs = zPts.map((z) => {
  const x = flow2d(z);
  const zs = { x: zo.x + z[0] * unit, y: zo.y - z[1] * unit };
  const xs = { x: xo.x + x[0] * unit, y: xo.y - x[1] * unit };
  // Unit direction and normal for the two parallel arrows (forward above, inverse below).
  const dx = xs.x - zs.x;
  const dy = xs.y - zs.y;
  const len = Math.hypot(dx, dy);
  const ux = dx / len;
  const uy = dy / len;
  const nx = uy;
  const ny = -ux;
  const off = 5;
  const gap = 10;
  const fwd = `M ${zs.x + ux * gap + nx * off} ${zs.y + uy * gap + ny * off} L ${xs.x - ux * gap + nx * off} ${xs.y - uy * gap + ny * off}`;
  const inv = `M ${xs.x - ux * gap - nx * off} ${xs.y - uy * gap - ny * off} L ${zs.x + ux * gap - nx * off} ${zs.y + uy * gap - ny * off}`;
  return { zs, xs, fwd, inv };
});
const ext = 2.1 * unit;
const first = pairs[0];
---

<Figure
  id={id}
  title="Every point of Z has exactly one partner in X"
  caption="The flow f carries each latent point z to a data point x = f(z) (blue, left to right), and the inverse f⁻¹ carries it back (green, right to left). Because every fᵢ in the chain is a bijection, no two points of Z land on the same x and no x is left without a preimage. The X positions are computed from the same invertible 2-D map that is used later to show the Jacobian as local geometry."
  origin="redrawn"
  pages="31"
>
  <svg class="fig-medium" viewBox="0 0 600 316" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>Points mapped between latent space Z and data space X</title>
    <desc id={`${id}-d`}>Two coordinate systems side by side, Z on the left and X on the right. Three points in Z are each joined to one point in X by a pair of parallel arrows: a blue arrow labelled f pointing from Z to X and a green arrow labelled f inverse pointing back from X to Z. The three points in Z are representative latent points (z is distributed as a standard Gaussian), and each x equals f of z.</desc>

    <!-- Z axes -->
    <path class="f-axis" d={`M ${zo.x - ext} ${zo.y} H ${zo.x + ext}`} marker-end="url(#f-arrow-muted)" />
    <path class="f-axis" d={`M ${zo.x} ${zo.y + ext} V ${zo.y - ext}`} marker-end="url(#f-arrow-muted)" />
    <text class="f-math" x={zo.x - ext} y={zo.y + ext + 28}>Z</text>
    <text class="f-math" x={zo.x + 14} y={zo.y + ext + 28}>z ~ N(0, I)</text>

    <!-- X axes -->
    <path class="f-axis" d={`M ${xo.x - ext} ${xo.y} H ${xo.x + ext}`} marker-end="url(#f-arrow-muted)" />
    <path class="f-axis" d={`M ${xo.x} ${xo.y + ext} V ${xo.y - ext}`} marker-end="url(#f-arrow-muted)" />
    <text class="f-math" x={xo.x + ext - 14} y={xo.y + ext + 28}>X</text>
    <text class="f-math" x={xo.x - 88} y={xo.y + ext + 28}>x = f(z)</text>

    {pairs.map((p) => (
      <g>
        <path class="f-thin f-blue" d={p.fwd} marker-end="url(#f-arrow-blue)" />
        <path class="f-thin f-green" d={p.inv} marker-end="url(#f-arrow-green)" />
        <circle class="f-fill-ink" cx={p.zs.x} cy={p.zs.y} r="4.5" />
        <circle class="f-fill-ink" cx={p.xs.x} cy={p.xs.y} r="4.5" />
      </g>
    ))}

    <!-- Direction labels, as in the scan: f on top, f⁻¹ at the bottom -->
    <text class="f-math f-t-blue" x="298" y="26" text-anchor="middle">f</text>
    <path class="f-line f-blue" d="M 274 36 H 322" marker-end="url(#f-arrow-blue)" />
    <path class="f-line f-green" d="M 326 292 H 278" marker-end="url(#f-arrow-green)" />
    <text class="f-math f-t-green" x="301" y="284" text-anchor="middle">f<tspan dy="-8" font-size="13">−1</tspan></text>

    <!-- Name one pair, as a reading key -->
    <text class="f-math" x={first.zs.x} y={first.zs.y - 12} text-anchor="middle">z</text>
    <text class="f-math" x={first.xs.x + 12} y={first.xs.y - 4}>x</text>
  </svg>
</Figure>
