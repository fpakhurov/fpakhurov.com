---
import Figure from '../Figure.astro';
import { flow2d } from './flow-math';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

const id = 'nf-zx-mapping';

// Three representative latent points: one above the horizontal axis, two below.
const zPts: [number, number][] = [
  [0.6, 0.9],
  [1.0, -0.5],
  [0.7, -1.35],
];

type Layout = {
  key: string; cls: string; w: number; h: number;
  unit: number; zo: { x: number; y: number }; xo: { x: number; y: number };
  sup: number; // font size of the −1 superscript
  fTop: { x: number; y: number; arrow: string };
  fBottom: { x: number; y: number; arrow: string };
  zName: [number, number]; zDist: [number, number];
  xName: [number, number]; xDef: [number, number];
};

// Two coordinate systems with the same scale; the points in X are computed as x = f(z).
function build(l: Layout) {
  const pairs = zPts.map((z) => {
    const x = flow2d(z);
    const zs = { x: l.zo.x + z[0] * l.unit, y: l.zo.y - z[1] * l.unit };
    const xs = { x: l.xo.x + x[0] * l.unit, y: l.xo.y - x[1] * l.unit };
    // Unit direction and normal for the two parallel arrows (forward above, inverse below).
    const dx = xs.x - zs.x;
    const dy = xs.y - zs.y;
    const len = Math.hypot(dx, dy);
    const ux = dx / len;
    const uy = dy / len;
    const nx = uy;
    const ny = -ux;
    const off = 5;
    const gap = 10;
    const fwd = `M ${zs.x + ux * gap + nx * off} ${zs.y + uy * gap + ny * off} L ${xs.x - ux * gap + nx * off} ${xs.y - uy * gap + ny * off}`;
    const inv = `M ${xs.x - ux * gap - nx * off} ${xs.y - uy * gap - ny * off} L ${zs.x + ux * gap - nx * off} ${zs.y + uy * gap - ny * off}`;
    return { zs, xs, fwd, inv };
  });
  return { ...l, pairs, ext: 2.1 * l.unit, first: pairs[0] };
}

const wide = build({
  key: 'w', cls: 'fig-wide fig-medium', w: 600, h: 316,
  unit: 50, zo: { x: 150, y: 158 }, xo: { x: 440, y: 158 },
  sup: 14,
  fTop: { x: 298, y: 26, arrow: 'M 274 36 H 322' },
  fBottom: { x: 301, y: 280, arrow: 'M 326 292 H 278' },
  zName: [45, 291], zDist: [164, 291],
  xName: [531, 291], xDef: [352, 291],
});
// Narrow: the same two panels at a smaller scale, so the labels stay near full size on a phone.
const narrow = build({
  key: 'n', cls: 'fig-narrow', w: 380, h: 250,
  unit: 36, zo: { x: 94, y: 124 }, xo: { x: 288, y: 124 },
  sup: 14,
  fTop: { x: 193, y: 22, arrow: 'M 169 32 H 217' },
  fBottom: { x: 196, y: 222, arrow: 'M 220 234 H 172' },
  zName: [16, 236], zDist: [46, 236],
  xName: [350, 236], xDef: [262, 236],
});
const variants = [wide, narrow];
---

<Figure
  id={id}
  title={ru ? "У каждой точки Z ровно одна парная точка в X" : "Every point of Z has exactly one partner in X"}
  caption={ru ? "Поток f переводит каждую латентную точку z в точку данных x = f(z) (синие стрелки, слева направо), а обратное отображение f⁻¹ возвращает её назад (зелёные стрелки, справа налево). Поскольку каждое fᵢ в цепочке — биекция, никакие две точки Z не попадают в один и тот же x и ни один x не остаётся без прообраза. Положения точек в X вычислены по тому же обратимому двумерному отображению, которое дальше используется, чтобы показать матрицу Якоби как локальную геометрию." : "The flow f carries each latent point z to a data point x = f(z) (blue, left to right), and the inverse f⁻¹ carries it back (green, right to left). Because every fᵢ in the chain is a bijection, no two points of Z land on the same x and no x is left without a preimage. The X positions are computed from the same invertible 2-D map that is used later to show the Jacobian as local geometry."}
>
  {variants.map((v) => (
    <svg class={v.cls} viewBox={`0 0 ${v.w} ${v.h}`} role="img" aria-labelledby={`${id}-${v.key}-t ${id}-${v.key}-d`}>
      <title id={`${id}-${v.key}-t`}>{ru ? "Точки, отображаемые между латентным пространством Z и пространством данных X" : "Points mapped between latent space Z and data space X"}</title>
      <desc id={`${id}-${v.key}-d`}>{ru ? "Две системы координат рядом: Z слева, X справа. Каждая из трёх точек в Z соединена с одной точкой в X парой параллельных стрелок: синяя стрелка с подписью f ведёт из Z в X, а зелёная стрелка с подписью «f обратное» ведёт обратно из X в Z. Три точки в Z — типичные латентные точки (z имеет стандартное нормальное распределение), и каждый x равен f от z." : "Two coordinate systems side by side, Z on the left and X on the right. Three points in Z are each joined to one point in X by a pair of parallel arrows: a blue arrow labelled f pointing from Z to X and a green arrow labelled f inverse pointing back from X to Z. The three points in Z are representative latent points (z is distributed as a standard Gaussian), and each x equals f of z."}</desc>

      <!-- Z axes -->
      <path class="f-axis" d={`M ${v.zo.x - v.ext} ${v.zo.y} H ${v.zo.x + v.ext}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-axis" d={`M ${v.zo.x} ${v.zo.y + v.ext} V ${v.zo.y - v.ext}`} marker-end="url(#f-arrow-muted)" />
      <text class="f-math" x={v.zName[0]} y={v.zName[1]}>Z</text>
      <text class="f-math" x={v.zDist[0]} y={v.zDist[1]}>z ~ N(0, I)</text>

      <!-- X axes -->
      <path class="f-axis" d={`M ${v.xo.x - v.ext} ${v.xo.y} H ${v.xo.x + v.ext}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-axis" d={`M ${v.xo.x} ${v.xo.y + v.ext} V ${v.xo.y - v.ext}`} marker-end="url(#f-arrow-muted)" />
      <text class="f-math" x={v.xName[0]} y={v.xName[1]}>X</text>
      <text class="f-math" x={v.xDef[0]} y={v.xDef[1]}>x = f(z)</text>

      {v.pairs.map((p) => (
        <g>
          <path class="f-thin f-blue" d={p.fwd} marker-end="url(#f-arrow-blue)" />
          <path class="f-thin f-green" d={p.inv} marker-end="url(#f-arrow-green)" />
          <circle class="f-fill-ink" cx={p.zs.x} cy={p.zs.y} r="4.5" />
          <circle class="f-fill-ink" cx={p.xs.x} cy={p.xs.y} r="4.5" />
        </g>
      ))}

      <!-- Direction labels: f on top, f⁻¹ at the bottom, each clear of its arrow -->
      <text class="f-math f-t-blue" x={v.fTop.x} y={v.fTop.y} text-anchor="middle">f</text>
      <path class="f-line f-blue" d={v.fTop.arrow} marker-end="url(#f-arrow-blue)" />
      <path class="f-line f-green" d={v.fBottom.arrow} marker-end="url(#f-arrow-green)" />
      <text class="f-math f-t-green" x={v.fBottom.x} y={v.fBottom.y} text-anchor="middle">f<tspan dy="-8" font-size={v.sup}>−1</tspan></text>

      <!-- Name one pair, as a reading key -->
      <text class="f-math" x={v.first.zs.x} y={v.first.zs.y - 12} text-anchor="middle">z</text>
      <text class="f-math" x={v.first.xs.x + 12} y={v.first.xs.y - 4}>x</text>
    </svg>
  ))}
</Figure>
