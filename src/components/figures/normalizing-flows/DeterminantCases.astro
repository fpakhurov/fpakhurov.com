---
import Figure from '../Figure.astro';
import { polyline } from '../geometry';
import { matrixBrackets } from './flow-math';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

const id = 'nf-det-cases';

type Mat = [[number, number], [number, number]];
const cases: { J: Mat; word: string; cls: string }[] = [
  { J: [[2, 0], [0, 1]], word: (ru ? "удвоена" : "doubled"), cls: 'blue' },
  { J: [[1, 0.4], [0, 0.5]], word: (ru ? "сжата вдвое" : "halved"), cls: 'blue' },
  { J: [[1, 0.8], [0, 1]], word: (ru ? "сохранена" : "preserved"), cls: 'blue' },
  { J: [[1, 0.5], [0.6, 0.3]], word: (ru ? "схлопнута" : "crushed"), cls: 'red' },
];
const det = (J: Mat) => J[0][0] * J[1][1] - J[0][1] * J[1][0];
const apply = (J: Mat, [a, b]: [number, number]): [number, number] => [J[0][0] * a + J[0][1] * b, J[1][0] * a + J[1][1] * b];
const fmtNum = (v: number) => {
  const r = Math.round(v * 100) / 100;
  if (Math.abs(r) < 1e-9) return '0';
  return r < 0 ? `−${-r}` : `${r}`;
};

const panelW = 240;
const panelH = 200;
const u = 54;
const panels = cases.map((c, i) => {
  const px = (i % 2) * panelW;
  const py = Math.floor(i / 2) * panelH;
  const o: [number, number] = [px + 34, py + 166];
  const to = ([a, b]: [number, number]): [number, number] => [o[0] + a * u, o[1] - b * u];
  const square: [number, number][] = [[0, 0], [1, 0], [1, 1], [0, 1]];
  const image = square.map((p) => apply(c.J, p));
  const d = det(c.J);
  return {
    ...c, px, py, o, d,
    unit: `${polyline(square.map(to))} Z`,
    image: `${polyline(image.map(to))} Z`,
    br: matrixBrackets(px + 192, py + 120, 34, 22),
  };
});
---

<Figure
  id={id}
  title={ru ? "Что |det J| делает с маленьким квадратом" : "What |det J| does to a small square"}
  caption={ru ? "Штриховой единичный квадрат и его образ (с заливкой) при четырёх линейных отображениях; |det J| — множитель, на который меняется площадь. Сдвиг меняет форму и сохраняет det = 1. При det = 0 квадрат схлопывается в отрезок, и отображение нельзя обратить." : "The dashed unit square and its image (filled) under four linear maps; |det J| is the factor by which the area changes. The shear changes the shape and keeps det = 1. With det = 0 the square collapses onto a segment, and the map cannot be inverted."}
>
  <svg class="fig-compact" viewBox="0 0 480 404" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>{ru ? "Изменение площади при определителях 2, 0.5, 1 и 0" : "Area scaling for determinants 2, 0.5, 1 and 0"}</title>
    <desc id={`${id}-d`}>{ru ? "Четыре панели в сетке два на два, на каждой штриховой единичный квадрат и его образ при матрице 2 на 2. Слева вверху: матрица со строками 2 0 и 0 1, определитель 2, площадь удваивается. Справа вверху: строки 1 0.4 и 0 0.5, определитель 0.5, площадь уменьшается вдвое. Слева внизу: сдвиг со строками 1 0.8 и 0 1, определитель 1, площадь сохраняется, хотя форма меняется. Справа внизу: строки 1 0.5 и 0.6 0.3, определитель 0, квадрат схлопывается в отрезок, и отображение необратимо." : "Four panels in a two by two grid, each with a dashed unit square and its image under a 2 by 2 matrix. Top left: matrix with rows 2 0 and 0 1, determinant 2, the area is doubled. Top right: rows 1 0.4 and 0 0.5, determinant 0.5, the area is halved. Bottom left: a shear with rows 1 0.8 and 0 1, determinant 1, the area is preserved although the shape changes. Bottom right: rows 1 0.5 and 0.6 0.3, determinant 0, the square is crushed onto a line segment and the map is not invertible."}</desc>

    {panels.map((p) => (
      <g>
        <path class="f-axis" d={`M ${p.o[0] - 12} ${p.o[1]} H ${p.o[0] + 2.35 * u}`} marker-end="url(#f-arrow-muted)" />
        <path class="f-axis" d={`M ${p.o[0]} ${p.o[1] + 12} V ${p.o[1] - 1.75 * u}`} marker-end="url(#f-arrow-muted)" />
        <path class="f-thin f-muted f-dash" d={p.unit} />
        {Math.abs(p.d) > 1e-12 && <path class={`f-fill-${p.cls}`} d={p.image} />}
        <path class={`f-line f-${p.cls} ${Math.abs(p.d) < 1e-12 ? 'f-bold' : ''}`} d={p.image} />
        <text class="f-label" x={p.px + 14} y={p.py + 30}>
          <tspan style="font-family: var(--serif); font-style: italic; font-size: 18px"><tspan font-style="normal">det</tspan> J = {fmtNum(p.d)}</tspan><tspan style={p.cls === 'red' ? 'fill: var(--fig-red)' : undefined}> ⇒ {p.word}</tspan>
        </text>
        <path class="f-thin" d={p.br.left} />
        <path class="f-thin" d={p.br.right} />
        <text class="f-label" x={p.px + 176} y={p.py + 115} text-anchor="middle">{fmtNum(p.J[0][0])}</text>
        <text class="f-label" x={p.px + 208} y={p.py + 115} text-anchor="middle">{fmtNum(p.J[0][1])}</text>
        <text class="f-label" x={p.px + 176} y={p.py + 136} text-anchor="middle">{fmtNum(p.J[1][0])}</text>
        <text class="f-label" x={p.px + 208} y={p.py + 136} text-anchor="middle">{fmtNum(p.J[1][1])}</text>
      </g>
    ))}
    <text class="f-label f-t-red" x="474" y="396" text-anchor="end">{ru ? "необратимо ⇒ не годится для потоков" : "not invertible ⇒ unusable for flows"}</text>
  </svg>
</Figure>
