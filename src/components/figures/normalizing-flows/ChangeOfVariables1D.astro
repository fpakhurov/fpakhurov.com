---
import Figure from '../Figure.astro';
import { plot, area, scale } from '../geometry';
import { flow1d, flow1dPrime, pz, px, normalCdf } from './flow-math';

const id = 'nf-cov-1d';

// The slab [za, zb] in latent space and its image [xa, xb] in data space.
const za = 0.1;
const zb = 0.5;
const xa = flow1d(za);
const xb = flow1d(zb);
const mass = normalCdf(zb) - normalCdf(za);
const fmt = (v: number, d = 2) => v.toFixed(d);

type Layout = {
  cls: string; w: number; h: number;
  L: number; R: number; T: number; B: number; // main panel: z horizontal, x vertical
  yb: number; pzScale: number;                 // bottom panel: p_z(z), baseline yb
  xl: number; pxScale: number;                 // right panel: p_x(x), axis at xl
  note: { x: number; y: number; lines: string[] };
  arrowPz: string; arrowPx: string;
  curveLabel: { x: number; y: number; lines: string[] };
};

function build(l: Layout) {
  const sx = scale([-3, 3], [l.L, l.R]);
  const sy = scale([-3.8, 3.8], [l.B, l.T]);
  const syz = (p: number) => l.yb - p * l.pzScale;
  const sxx = (p: number) => l.xl + p * l.pxScale;
  const curve = plot(flow1d, -3, 3, sx, sy, 240);
  const slabCurve = plot(flow1d, za, zb, sx, sy, 40);
  const pzPath = plot(pz, -3, 3, sx, syz, 200);
  // Rotated density: points (p_x(x), x) for x in [-3.8, 3.8].
  const n = 240;
  const pxPts: string[] = [];
  for (let i = 0; i <= n; i += 1) {
    const x = -3.8 + (7.6 * i) / n;
    pxPts.push(`${i === 0 ? 'M' : 'L'} ${sxx(px(x)).toFixed(2)} ${sy(x).toFixed(2)}`);
  }
  const slabPts: string[] = [];
  const m = 40;
  for (let i = 0; i <= m; i += 1) {
    const x = xa + ((xb - xa) * i) / m;
    slabPts.push(`${i === 0 ? 'M' : 'L'} ${sxx(px(x)).toFixed(2)} ${sy(x).toFixed(2)}`);
  }
  const pxSlab = `${slabPts.join(' ')} L ${l.xl} ${sy(xb).toFixed(2)} L ${l.xl} ${sy(xa).toFixed(2)} Z`;
  // Pale bands that carry the slab from the p_z panel up to the curve and across to the p_x panel.
  const vBand = `${plot(flow1d, za, zb, sx, sy, 40)} L ${sx(zb)} ${l.yb} L ${sx(za)} ${l.yb} Z`;
  const hBand = `M ${sx(za)} ${sy(xa)} L ${l.xl} ${sy(xa)} L ${l.xl} ${sy(xb)} L ${sx(zb)} ${sy(xb)} Z`;
  const zTicks = [-2, -1, 0, 1, 2].map((t) => ({ t, x: sx(t) }));
  const xTicks = [-3, -2, -1, 0, 1, 2, 3].map((t) => ({ t, y: sy(t) }));
  return {
    ...l, sx, sy, syz, sxx, curve, slabCurve, pzPath, pzSlab: area(pz, za, zb, sx, syz, 40), pxPath: pxPts.join(' '), pxSlab,
    vBand, hBand, zTicks, xTicks,
    zaX: sx(za), zbX: sx(zb), xaY: sy(xa), xbY: sy(xb),
  };
}

const wide = build({
  cls: 'fig-wide', w: 640, h: 520,
  L: 78, R: 378, T: 22, B: 318,
  yb: 478, pzScale: 255,
  xl: 420, pxScale: 690,
  note: { x: 430, y: 404, lines: ['same probability mass,', 'different width'] },
  arrowPz: 'M 424 420 Q 330 470 256 442',
  arrowPx: 'M 520 384 Q 558 260 508 152',
  curveLabel: { x: 92, y: 52, lines: ['x = f(z)'] },
});
const narrow = build({
  cls: 'fig-narrow', w: 380, h: 496,
  L: 46, R: 232, T: 22, B: 300,
  yb: 456, pzScale: 230,
  xl: 258, pxScale: 470,
  // The note sits in the empty corner under the sideways p_θ panel, so both callouts stay short.
  note: { x: 258, y: 344, lines: ['same probability', 'mass, different', 'width'] },
  arrowPz: 'M 252 360 Q 196 368 149 408',
  arrowPx: 'M 302 326 Q 318 232 288 146',
  curveLabel: { x: 54, y: 50, lines: ['x = f(z)'] },
});
const variants = [wide, narrow];
const massText = `mass ≈ ${fmt(mass, 3)}`;
---

<Figure
  id={id}
  title="Change of variables in one dimension"
  caption={`Base density p_Z = N(0, 1) (bottom), the monotone flow x = f(z) = z + 0.8·tanh(2z) (centre) and the resulting model density p_θ(x) = p_Z(f⁻¹(x)) / f′(f⁻¹(x)) (right, drawn sideways). The slab z ∈ [${za}, ${zb}] holds probability ${fmt(mass, 3)}; f stretches it to x ∈ [${fmt(xa)}, ${fmt(xb)}], about ${fmt((xb - xa) / (zb - za), 1)} times wider, so the density there must be lower by the same factor. Near the origin f′(0) = ${fmt(flow1dPrime(0), 1)}, which turns the single Gaussian bump into two bumps.`}
  origin="illustrative"
>
  {variants.map((v) => (
    <svg class={v.cls} viewBox={`0 0 ${v.w} ${v.h}`} role="img" aria-labelledby={`${id}-${v.cls}-t ${id}-${v.cls}-d`}>
      <title id={`${id}-${v.cls}-t`}>A slab of probability mass carried through a one-dimensional flow</title>
      <desc id={`${id}-${v.cls}-d`}>{`Centre: the increasing curve x = f(z) = z + 0.8 tanh(2z), steep near the origin and close to slope 1 in the tails. Below it, the standard normal density p_Z(z), with the slab z from ${za} to ${zb} shaded; its probability mass is about ${fmt(mass, 3)}. Pale bands carry the slab up to the curve and across to the right panel, where the model density p_theta(x) is drawn sideways. The image of the slab, x from ${fmt(xa)} to ${fmt(xb)}, is wider and the shaded area there has the same mass but lower height. p_theta has two bumps because f stretches the region around zero.`}</desc>

      <defs>
        <marker id={`${id}-${v.cls}-ah`} viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
          <path d="M 0 0.8 L 9.5 5 L 0 9.2 L 2.6 5 Z" style="fill: var(--fig-amber)" />
        </marker>
      </defs>
      <path d={v.vBand} style="fill: var(--fig-amber); fill-opacity: .09; stroke: none" />
      <path d={v.hBand} style="fill: var(--fig-amber); fill-opacity: .09; stroke: none" />

      <!-- Main panel axes -->
      <path class="f-axis" d={`M ${v.L} ${v.B} H ${v.R + 14}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-axis" d={`M ${v.L} ${v.B} V ${v.T - 6}`} marker-end="url(#f-arrow-muted)" />
      {v.zTicks.map((t) => (
        <g>
          <line class="f-axis" x1={t.x} x2={t.x} y1={v.B} y2={v.B + 5} />
          <text class="f-small f-t-muted" x={t.x} y={v.B + 20} text-anchor="middle">{t.t}</text>
        </g>
      ))}
      {v.xTicks.map((t) => (
        <g>
          <line class="f-axis" x1={v.L - 5} x2={v.L} y1={t.y} y2={t.y} />
          <text class="f-small f-t-muted" x={v.L - 9} y={t.y + 4} text-anchor="end">{t.t}</text>
        </g>
      ))}
      <text class="f-math" x={v.R + 14} y={v.B + 22} text-anchor="end">z</text>
      <text class="f-math" x={v.L + 10} y={v.T + 4}>x</text>

      <path class="f-line f-blue f-bold" d={v.curve} />
      <path class="f-line f-amber f-bold" d={v.slabCurve} />
      <text class="f-math f-t-blue" x={v.curveLabel.x} y={v.curveLabel.y + 26}>{v.curveLabel.lines[0]}</text>

      <!-- Guides from the slab to the curve and across -->
      <!-- Broken around the z tick labels of the main panel so the guides do not cross them -->
      <path class="f-thin f-amber f-dash" d={`M ${v.zaX} ${v.yb} V ${v.B + 28} M ${v.zaX} ${v.B} V ${v.xaY} H ${v.xl}`} />
      <path class="f-thin f-amber f-dash" d={`M ${v.zbX} ${v.yb} V ${v.B + 28} M ${v.zbX} ${v.B} V ${v.xbY} H ${v.xl}`} />

      <!-- Bottom panel: p_z -->
      <path class="f-axis" d={`M ${v.L} ${v.yb} H ${v.R + 14}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-fill-amber" d={v.pzSlab} />
      <path class="f-line" d={v.pzPath} />
      <text class="f-math" x={v.R + 14} y={v.yb + 22} text-anchor="end">z</text>
      <text class="f-math" x={v.L} y={v.yb - 0.3 * v.pzScale}>p<tspan dy="5" font-size="13">Z</tspan><tspan dy="-5">(z)</tspan></text>
      <text class="f-small f-t-amber" x={(v.zaX + v.zbX) / 2} y={v.yb + 18} text-anchor="middle">Δz = {zb - za}</text>

      <!-- Right panel: p_x drawn sideways -->
      <path class="f-axis" d={`M ${v.xl} ${v.B} V ${v.T - 6}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-fill-amber" d={v.pxSlab} />
      <path class="f-line f-blue" d={v.pxPath} />
      <text class="f-math f-t-blue" x={v.xl + 24} y={v.T + 8}>p<tspan dy="5" font-size="13">θ</tspan><tspan dy="-5">(x)</tspan></text>
      <text class="f-small f-t-amber f-halo" x={v.xl - 6} y={(v.xaY + v.xbY) / 2 + 4} text-anchor="end">Δx ≈ {fmt(xb - xa)}</text>

      <!-- Annotation -->
      {v.note.lines.map((line, i) => (
        <text class="f-label f-t-amber" x={v.note.x} y={v.note.y + i * 20}>{line}</text>
      ))}
      <text class="f-note" x={v.note.x} y={v.note.y + v.note.lines.length * 20}>{massText}</text>
      <path class="f-thin f-amber" d={v.arrowPz} marker-end={`url(#${id}-${v.cls}-ah)`} />
      <path class="f-thin f-amber" d={v.arrowPx} marker-end={`url(#${id}-${v.cls}-ah)`} />
    </svg>
  ))}
</Figure>
