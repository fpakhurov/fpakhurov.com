---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const id='modes-of-convergence',ru=pageLang(Astro.url)==='ru';
const title=ru?'Одинаковые распределения не сближают реализации':'Equal distributions do not align realizations';
const caption=ru?'Z равномерна на {−3,3}, а Xₙ=(−1)ⁿZ. Оба столбца исходов имеют вероятность 1/2. При каждом n распределение Xₙ совпадает с распределением Z; вероятность расстояния больше 1 чередуется между 1 и 0. Сходимости по вероятности к Z нет.':'Z is uniform on {−3,3}, with Xₙ=(−1)ⁿZ. Each outcome column has probability 1/2. At every n the distribution of Xₙ equals that of Z; the probability of distance above 1 alternates between 1 and 0. There is no convergence in probability to Z.';
const rows=[cases.modes[0],cases.modes[1]];
---
<Figure id={id} title={title} caption={caption}>
 <ol class="mode-chain" aria-label={ru?'Следствия между видами сходимости':'Implications between convergence modes'}>
  <li>{ru?'Почти наверное':'Almost surely'}<span aria-hidden="true">⇒</span></li>
  <li>{ru?'По вероятности':'In probability'}<span aria-hidden="true">⇒</span></li>
  <li>{ru?'По распределению':'In distribution'}</li>
 </ol>
 <div class="mode-table"><table><thead><tr><th scope="col">n</th><th scope="col">Z = −3</th><th scope="col">Z = 3</th><th scope="col">P(|Xₙ−Z|&gt;1)</th></tr></thead><tbody>{rows.map(r=><tr><th scope="row">{r.n===1?(ru?'Нечётное':'Odd'):(ru?'Чётное':'Even')}</th><td data-n={r.n} data-z="-3">{r.atZminus3}</td><td data-n={r.n} data-z="3">{r.atZplus3}</td><td>{r.probabilityDistanceFromZAbove1}</td></tr>)}</tbody></table></div>
</Figure>
<style>
.mode-chain{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem;list-style:none;padding:0!important;margin:0 0 1.3rem!important}.mode-chain li{display:flex;align-items:center;justify-content:space-between;gap:.5rem;margin:0!important;font-size:.95rem}.mode-chain span{color:var(--accent);font-size:1.4rem}.mode-table{max-width:100%;overflow-x:auto}.mode-table table{display:table;width:100%;max-width:none;margin:0;font-size:.85rem;font-variant-numeric:tabular-nums}.mode-table th,.mode-table td{padding:.55rem .35rem;text-align:center}.mode-table th:first-child{text-align:left}.mode-table th{white-space:nowrap;font-size:.75rem}@media(max-width:700px){.mode-chain{grid-template-columns:1fr}.mode-chain li{display:block}.mode-chain span{display:block;transform:rotate(90deg);width:max-content;margin:.25rem auto}.mode-chain li{text-align:center}}
</style>
