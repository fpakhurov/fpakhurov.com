---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { Phi, phi } from '../normal';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The sum S of n independent Exp(1) variables has the Erlang (gamma) density s^(n−1) e^(−s) / (n−1)!. Standardized,
// Z = (S − n)/√n has density √n f(n + √n z). Its largest CDF gap to the standard normal shrinks like 1/√n.
const ns = [1, 2, 5, 30];
const lfact = (k: number) => { let s = 0; for (let i = 2; i <= k; i++) s += Math.log(i); return s; };
const dens = (n: number, z: number) => { const s = n + Math.sqrt(n) * z; return s <= 0 ? 0 : Math.sqrt(n) * Math.exp((n - 1) * Math.log(s) - s - lfact(n - 1)); };
const cdf = (n: number, z: number) => { const s = n + Math.sqrt(n) * z; if (s <= 0) return 0; let term = 1, sum = 1; for (let k = 1; k < n; k++) { term *= s / k; sum += term; } return 1 - Math.exp(-s) * sum; };
const zs = Array.from({ length: 701 }, (_, i) => -3 + i * 0.01);
const gaps = ns.map((n) => Array.from({ length: 1401 }, (_, i) => -6 + i * 0.01).reduce((m, z) => Math.max(m, Math.abs(cdf(n, z) - Phi(z))), 0));
if (gaps.map((g) => g.toFixed(2)).join() !== '0.16,0.09,0.06,0.02') throw new Error('SumsBecomeNormal: gaps drifted from the note');
const id = 'sums-become-normal';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 230, pos: (k: number) => [16 + k * 188, 44], pw: 170, ph: 140 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 420, pos: (k: number) => [10 + (k % 2) * 178, 50 + Math.floor(k / 2) * 196], pw: 164, ph: 120 },
];
const line = (f: (z: number) => number, sx: (v: number) => number, sy: (v: number) => number) => polyline(zs.map((z) => [sx(z), sy(Math.min(f(z), 1.05))]));
---

<Figure
  id={id}
  title={ru ? 'Сумма экспоненциальных величин становится нормальной' : 'A sum of exponential variables becomes normal'}
  caption={ru
    ? `Красная кривая — плотность стандартизованной суммы (S − n)/√n для n независимых показательных величин Exp(1), синяя — стандартная нормальная плотность. Одна показательная величина сильно асимметрична; при n = 2 и 5 асимметрия уменьшается, при n = 30 кривые почти совпадают. Наибольшая разница функций распределения: ${gaps.map((g) => g.toFixed(3)).join(', ')} — она убывает примерно как 1/√n.`
    : `Red: the density of the standardized sum (S − n)/√n of n independent Exp(1) variables; blue: the standard normal density. One exponential variable is strongly skewed; at n = 2 and 5 the skew shrinks, and at n = 30 the curves nearly coincide. The largest difference between the distribution functions: ${gaps.map((g) => g.toFixed(3)).join(', ')}, falling roughly like 1/√n.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Четыре плотности стандартизованных сумм' : 'Four densities of standardized sums'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'Для n = 1, 2, 5, 30 асимметричная кривая всё ближе к нормальному колоколу.' : 'For n = 1, 2, 5, 30 the skewed curve comes ever closer to the normal bell.'}</desc>
      {ns.map((n, k) => {
        const [x0, y0] = L.pos(k);
        const sx = scale([-3, 4], [x0, x0 + L.pw]), sy = scale([0, 1.05], [y0 + L.ph, y0]);
        return (
          <g>
            <text class="f-small" x={x0} y={y0 - 24}>{`n = ${n}`}</text>
            <text class="f-note f-t-amber" x={x0} y={y0 - 8}>{`${ru ? 'разрыв' : 'gap'} ${gaps[k].toFixed(3)}`}</text>
            <path class="f-axis" d={`M ${x0} ${y0 + L.ph} H ${x0 + L.pw}`} />
            <path class="f-line f-blue" d={line(phi, sx, sy)} />
            <path class="f-line f-red" d={line((z) => dens(n, z), sx, sy)} />
            {[-2, 0, 2].map((v) => <text class="f-note" x={sx(v)} y={y0 + L.ph + 16} text-anchor="middle">{v}</text>)}
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
