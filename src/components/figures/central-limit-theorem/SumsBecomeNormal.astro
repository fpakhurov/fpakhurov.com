---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const id='sums-become-normal',ru=pageLang(Astro.url)==='ru';
const title=ru?'Дискретная функция распределения приближается к нормальной':'A discrete CDF approaches the normal CDF';
const caption=ru?'Заданный закон принимает −1,2,4 с вероятностями 1/2, 1/3, 1/6. После центрирования суммы и деления на её стандартное отклонение сравниваем точные ступенчатые CDF с Φ. Все панели используют одинаковые оси. Хвосты за пределами [−4,4] не показаны; на границах сохранены их фактические вероятности.':'The stipulated law takes −1, 2, 4 with probabilities 1/2, 1/3, 1/6. After centering the sum and dividing by its standard deviation, compare exact step CDFs with Φ. All panels use the same axes. Tails beyond [−4,4] are not shown; boundary probabilities retain their actual values.';
const x=(z:number)=>48+30*(z+4),y=(p:number)=>210-160*p;
const points=(ps:number[][])=>ps.map(([z,p])=>`${x(z)},${y(p)}`).join(' ');
---
<Figure id={id} title={title} caption={caption}>
 <div class="cdf-panels">
 {cases.cdfs.map(r=><svg viewBox="0 0 320 263" role="img" aria-labelledby={`${id}-${r.n}-title ${id}-${r.n}-desc`}>
  <title id={`${id}-${r.n}-title`}>{`${ru?'Число слагаемых':'Number of summands'}: ${r.n}`}</title>
  <desc id={`${id}-${r.n}-desc`}>{`${ru?'Точная CDF — синяя ступенчатая линия. Нормальная CDF — пунктир. Наибольшее расхождение':'The exact CDF is a blue step curve; the normal CDF is dashed. Largest discrepancy'}: ${r.kolmogorov.toFixed(6)}.`}</desc>
  <text x="48" y="24">n = {r.n}</text><text x="288" y="24" text-anchor="end">CDF</text>
  {[0,.5,1].map(v=><g><path d={`M48 ${y(v)}H288`} class="grid"/><text x="39" y={y(v)+6} text-anchor="end">{v}</text></g>)}
  <path d="M48 48V210H288" class="axis"/>
  {[-4,0,4].map(z=><text x={x(z)} y="236" text-anchor="middle">{z}</text>)}<text x="288" y="258" text-anchor="end">z</text>
  <polyline data-series="normal" data-n={r.n} points={points(cases.normalCdf)} class="normal"/>
  <polyline data-series="exact" data-n={r.n} points={points(r.plotPoints)} class="exact"/>
 </svg>)}
 </div>
 <p class="legend"><span class="legend-item"><span class="key exact" aria-hidden="true"></span>{ru?'Точная CDF':'Exact CDF'}</span><span class="legend-item"><span class="key normal" aria-hidden="true"></span>{ru?'Нормальная CDF':'Normal CDF'}</span></p>
</Figure>
<style>
.cdf-panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.cdf-panels svg{min-width:0;width:100%;height:auto}.cdf-panels text{font:18px var(--sans);fill:var(--ink);font-variant-numeric:tabular-nums}.axis{fill:none;stroke:var(--muted);stroke-width:1.2}.grid{fill:none;stroke:var(--line)}.exact,.normal{fill:none;stroke-width:2.2}.exact{stroke:var(--fig-blue)}.normal{stroke:var(--fig-amber);stroke-dasharray:7 4}.legend{display:flex;align-items:center;flex-wrap:wrap;gap:.35rem 1rem;margin:.5rem 0}.legend-item{display:inline-flex;align-items:center;gap:.35rem;white-space:nowrap}.key{display:inline-block;flex:none;width:1.3rem;border-top:3px solid var(--fig-blue)}.key.normal{border-color:var(--fig-amber);border-top-style:dashed}@media(max-width:700px){.cdf-panels{grid-template-columns:1fr}}
</style>
