---
import BlockDiagram, { type DLayout } from '../BlockDiagram.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Splits on top, what each one is used for below; red dashed arrows are the leaks.
const t = ru
  ? { train: 'обучение', val: 'валидация', test: 'тест', model: 'модель', weights: 'веса', settings: 'настройки', settingsSub: 'шаг, эпохи, словарь', settingsSubN: 'шаг, эпохи', report: 'итоговое число', reportN: 'итоговое\nчисло', once: 'считается один раз', fit: 'обучить', choose: 'выбрать', evalOnce: 'один раз', set: 'задать', final: 'итоговая модель', leakTop: 'утечка: дубликаты, предобработка по всем частям', leakTopN: 'утечка: дубликаты, общая предобработка', leakTune: 'подбор по тесту', leakTuneN: 'по тесту' }
  : { train: 'train', val: 'validation', test: 'test', model: 'model', weights: 'weights', settings: 'settings', settingsSub: 'learning rate, epochs, vocabulary', settingsSubN: 'lr, epochs', report: 'reported number', reportN: 'reported\nnumber', once: 'computed once', fit: 'fit', choose: 'choose', evalOnce: 'evaluate once', set: 'set', final: 'final model', leakTop: 'leak: duplicates, preprocessing fitted on all splits', leakTopN: 'leak: duplicates, shared preprocessing', leakTune: 'tuning on test', leakTuneN: 'tuning' };

const desc = ru
  ? 'Три части одного корпуса в верхнем ряду: обучение, валидация, тест. Обучающая часть обучает веса модели, валидационная выбирает настройки, которые задаются модели, тестовая один раз даёт итоговое число для итоговой модели. Красные пунктирные стрелки — утечки: от теста к обучающей части (дубликаты и общая предобработка) и от теста к настройкам (подбор по тесту).'
  : 'Three splits of one corpus in the top row: train, validation, test. The training split fits the weights of the model, the validation split chooses the settings that are given to the model, and the test split is used once by the final model to give the reported number. Red dashed arrows are leaks: from test to train (duplicates and shared preprocessing) and from test to the settings (tuning on test).';

const wide: DLayout = {
  cls: 'fig-wide', w: 680, h: 250, desc,
  nodes: [
    { id: 'train', x: 20, y: 46, w: 180, h: 46, label: t.train, tone: 'blue' },
    { id: 'val', x: 250, y: 46, w: 180, h: 46, label: t.val, tone: 'amber' },
    { id: 'test', x: 480, y: 46, w: 180, h: 46, label: t.test, tone: 'green' },
    { id: 'model', x: 20, y: 156, w: 180, h: 50, label: t.model, sub: t.weights },
    { id: 'settings', x: 250, y: 156, w: 180, h: 50, label: t.settings, sub: t.settingsSub },
    { id: 'report', x: 480, y: 156, w: 180, h: 50, label: t.report, sub: t.once },
  ],
  edges: [
    { from: 'train', to: 'model', label: t.fit, at: [118, 128], anchor: 'start', tone: 'blue' },
    { from: 'val', to: 'settings', label: t.choose, at: [348, 128], anchor: 'start', tone: 'amber' },
    { from: 'test', to: 'report', label: t.evalOnce, at: [578, 128], anchor: 'start', tone: 'green' },
    { from: 'settings', to: 'model', label: t.set, at: [225, 174] },
    { from: 'model', to: 'report', via: [[110, 232], [570, 232]], label: t.final, at: [340, 226] },
    { from: 'test', to: 'train', via: [[570, 16], [110, 16]], label: t.leakTop, at: [340, 11], tone: 'red', dashed: true },
    { from: 'test', to: 'settings', label: t.leakTune, at: [470, 140], tone: 'red', dashed: true },
  ],
};
const narrow: DLayout = {
  cls: 'fig-narrow', w: 360, h: 250, desc,
  nodes: [
    { id: 'train', x: 8, y: 46, w: 104, h: 46, label: t.train, tone: 'blue' },
    { id: 'val', x: 128, y: 46, w: 104, h: 46, label: t.val, tone: 'amber' },
    { id: 'test', x: 248, y: 46, w: 104, h: 46, label: t.test, tone: 'green' },
    { id: 'model', x: 8, y: 156, w: 104, h: 50, label: t.model, sub: t.weights },
    { id: 'settings', x: 128, y: 156, w: 104, h: 50, label: t.settings, sub: t.settingsSubN },
    { id: 'report', x: 248, y: 156, w: 104, h: 50, label: t.reportN },
  ],
  edges: [
    { from: 'train', to: 'model', label: t.fit, at: [66, 128], anchor: 'start', tone: 'blue' },
    { from: 'val', to: 'settings', label: t.choose, at: [186, 128], anchor: 'start', tone: 'amber' },
    { from: 'test', to: 'report', label: ru ? t.evalOnce : 'once', at: [306, 128], anchor: 'start', tone: 'green' },
    { from: 'settings', to: 'model' },
    { from: 'model', to: 'report', via: [[60, 232], [300, 232]], label: t.final, at: [180, 226] },
    { from: 'test', to: 'train', via: [[300, 16], [60, 16]], label: t.leakTopN, at: [180, 11], tone: 'red', dashed: true },
    { from: 'test', to: 'settings', label: t.leakTuneN, at: [262, 146], tone: 'red', dashed: true },
  ],
};
---

<BlockDiagram
  id="corpora-and-evaluation-protocol"
  title={ru ? 'Протокол оценки и пути утечки' : 'The evaluation protocol and the ways it leaks'}
  svgTitle={ru ? 'Части корпуса и их назначение' : 'Splits of a corpus and what each is for'}
  caption={ru
    ? 'Протокол этой заметки. У каждой части одного корпуса одна задача: обучающая часть обучает веса, валидационная выбирает всё, что не обучается (шаг обучения, число эпох, словарь, момент остановки), а тестовая используется один раз — итоговой моделью, чтобы получить число для отчёта. Красные пунктирные стрелки — утечки, из-за которых это число выходит оптимистичным: одни и те же примеры или общий шаг предобработки (токенизатор, словарь TF-IDF, векторы слов) у тестовых и обучающих данных и решения, принятые по результатам на тесте. Ещё одна утечка — бенчмарк внутри корпуса для предобучения — разобрана в заметке об оценке LLM.'
    : 'The protocol of this note. Each split of one corpus has one job: the training set fits the weights, the validation set chooses everything that is not fitted (learning rate, number of epochs, vocabulary, when to stop), and the test set is used once, by the final model, to produce the reported number. The red dashed arrows are the leaks that make that number optimistic: the same examples, or a preprocessing step (a tokenizer, a TF-IDF vocabulary, word vectors), shared between test and training data, and choices made by looking at test results. One more leak, a benchmark contained in a pretraining corpus, is covered in the LLM evaluation note.'}
  layouts={[wide, narrow]}
/>
