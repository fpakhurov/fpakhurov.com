---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Three retrying layers (api, orders, inventory) in front of a database that is down; each layer makes up to 3 attempts.
// Every attempt fails, so each call at one layer becomes 3 calls at the next: 1, 3, 9, 27.
const a = 3;
const names = ['api', 'orders', 'inventory', ru ? 'база данных' : 'database'];
const counts = names.map((_, k) => a ** k);
if (counts.join(',') !== '1,3,9,27') throw new Error('counts');
if (4 ** 3 !== 64) throw new Error('four attempts');
// Positions along the spread axis (0..26): leaves at 0..26, each parent at the mean of its children.
const levels: number[][] = [Array.from({ length: 27 }, (_, i) => i)];
for (let k = 0; k < 3; k++) {
  const below = levels[0];
  levels.unshift(Array.from({ length: below.length / a }, (_, i) => (below[a * i] + below[a * i + a - 1]) / 2));
}
if (levels.map((l) => l.length).join(',') !== '1,3,9,27' || levels[0][0] !== 13) throw new Error('tree');

const callWord = (n: number) => (ru ? (n === 1 ? 'вызов' : n === 3 ? 'вызова' : 'вызовов') : n === 1 ? 'call' : 'calls');
const t = ru
  ? { times: '×3 попытки', head: 'база данных недоступна; каждый слой делает до 3 попыток', headN: 'база недоступна, до 3 попыток на слое' }
  : { times: '×3 attempts', head: 'the database is down; every layer makes up to 3 attempts', headN: 'database down, up to 3 attempts per layer' };

// Both layouts draw the levels left to right and spread the calls vertically; the narrow one puts each level label on two lines.
interface Layout { cls: string; W: number; H: number; wide: boolean; level: (k: number) => number; spread: (s: number) => number; r: number[]; colW: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 326, wide: true, level: (k) => 90 + k * 190, spread: (s) => 74 + s * 9.3, r: [7, 6, 5, 4], colW: 180 },
  { cls: 'fig-narrow', W: 360, H: 330, wide: false, level: (k) => 34 + k * 92, spread: (s) => 80 + s * 9.2, r: [7, 6, 5, 4], colW: 88 },
];
const labelLines = (L: Layout, k: number) => {
  const n = `${counts[k]} ${callWord(counts[k])}`;
  return L.wide ? [`${names[k]} · ${n}`] : [names[k], n];
};
for (const L of layouts) {
  if (L.spread(26) + 4 > L.H - 6) throw new Error(`tree too tall at ${L.W}`);
  const head = L.wide ? t.head : t.headN;
  if (14 + head.length * 6.5 > L.W - 8) throw new Error(`head at ${L.W}`);
  for (let k = 0; k < 4; k++) for (const s of labelLines(L, k)) {
    const half = (s.length * 6.5) / 2;
    if (s.length * 6.5 > L.colW) throw new Error(`label ${s} wider than its column at ${L.W}`);
    if (L.level(k) - half < 4 || L.level(k) + half > L.W - 4) throw new Error(`label ${s} leaves the figure at ${L.W}`);
  }
  // The wide "×3" labels sit between the columns on the line under the level labels.
  if (L.wide) for (let k = 0; k < 3; k++) {
    const mid = (L.level(k) + L.level(k + 1)) / 2, half = (t.times.length * 6.5) / 2;
    if (mid - half < L.level(k) + 10 || mid + half > L.level(k + 1) - 10) throw new Error('×3 label between columns');
    // The first nodes start at y = 70 (leaves) and lower; the label line at y = 62 must clear the edges there.
    if (L.spread(0) - L.r[3] < 62 + 4) throw new Error('×3 label meets the top leaf');
  }
}
const at = (L: Layout, k: number, s: number): [number, number] => [L.level(k), L.spread(s)];
const edges = (L: Layout) => {
  const out: string[] = [];
  for (let k = 0; k < 3; k++) levels[k].forEach((s, i) => {
    for (let j = 0; j < a; j++) {
      const [x1, y1] = at(L, k, s), [x2, y2] = at(L, k + 1, levels[k + 1][a * i + j]);
      out.push(`M ${x1.toFixed(1)} ${y1.toFixed(1)} L ${x2.toFixed(1)} ${y2.toFixed(1)}`);
    }
  });
  return out.join(' ');
};
const tones = ['var(--fig-green)', 'var(--fig-blue)', 'var(--fig-blue)', 'var(--fig-red)'];
const id = 'retry-amplification';
---

<Figure
  id={id}
  title={ru ? 'Повторы умножаются на каждом слое' : 'Retries multiply at every layer'}
  caption={ru
    ? 'Один запрос пользователя проходит через три слоя, которые повторяют вызовы, — api, orders и inventory — к базе данных, которая не отвечает. Каждый слой делает до трёх попыток, и каждая неудачна, поэтому каждый вызов превращается в три вызова на следующем слое: 1, 3, 9 и 27. В общем случае a попыток на каждом из L слоёв дают a в степени L вызовов внизу; при четырёх попытках на слое (пример из книги SRE) это 64. Умножение происходит именно тогда, когда база слабее всего.'
    : 'One user request passes through three layers that retry, api, orders and inventory, on its way to a database that is down. Each layer makes up to three attempts, and every attempt fails, so each call becomes three calls at the next layer: 1, 3, 9 and 27. In general, a attempts at each of L layers give a to the power L calls at the bottom; with four attempts per layer, the example in the SRE book, that is 64. The multiplication happens exactly when the database is weakest.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Дерево вызовов при повторах на трёх слоях' : 'The call tree with retries at three layers'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Дерево из четырёх уровней: один узел api, от него три узла orders, от каждого три узла inventory, всего девять, и от каждого три вызова к базе данных, всего 27 красных точек.'
        : 'A tree of four levels: one api node, three orders nodes below it, three inventory nodes below each of those, nine in all, and three database calls below each inventory node, 27 red dots in all.'}</desc>
      <text class="f-small f-t-muted" x="14" y="20">{L.wide ? t.head : t.headN}</text>
      <path class="f-thin f-muted" d={edges(L)} style="stroke-width: 0.9" />
      {levels.map((lv, k) => lv.map((s) => {
        const [x, y] = at(L, k, s);
        return <circle cx={x} cy={y} r={L.r[k]} style={`fill: ${tones[k]}; fill-opacity: 0.85; stroke: var(--paper); stroke-width: 1`} />;
      }))}
      {names.map((_, k) => labelLines(L, k).map((s, j) => (
        <text class="f-small" x={L.level(k)} y={44 + j * 16} text-anchor="middle" style={j === 0 ? 'font-weight: 650' : ''}>{s}</text>
      )))}
      {L.wide && [0, 1, 2].map((k) => (
        <text class="f-small f-t-muted" x={(L.level(k) + L.level(k + 1)) / 2} y="62" text-anchor="middle">{t.times}</text>
      ))}
    </svg>
  ))}
</Figure>
