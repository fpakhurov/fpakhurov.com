---
import Figure from '../Figure.astro';
import { scale, plot } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// M/M/1: mean time in the system W = S / (1 - rho); the time is exponential, so p99 = ln(100) W.
// Plotted in units of the service time S. Dots: the simulation of the note, 2 million requests per row, S = 10 ms.
const mean = (r: number) => 1 / (1 - r);
const p99 = (r: number) => Math.log(100) / (1 - r);
const YMAX = 25;
const simMean: [number, number][] = [[0.5, 20.0], [0.7, 33.2], [0.8, 49.7], [0.9, 99.7], [0.95, 200.1]];
const simP99: [number, number][] = [[0.5, 91.8], [0.7, 152.0], [0.8, 226.4]];
for (const [r, ms] of simMean) if (Math.abs(ms / 10 - mean(r)) / mean(r) > 0.01) throw new Error(`simulated mean at ${r}`);
for (const [r, ms] of simP99) if (Math.abs(ms / 10 - p99(r)) / p99(r) > 0.02) throw new Error(`simulated p99 at ${r}`);
const marks = [0.5, 0.8, 0.9, 0.95];
if (marks.map((r) => Math.round(mean(r))).join(',') !== '2,5,10,20') throw new Error('marks');
const meanEnd = 1 - 1 / YMAX, p99End = 1 - Math.log(100) / YMAX;
if (Math.abs(p99End - 0.8158) > 1e-3) throw new Error('p99 leaves the plot');

const t = ru
  ? { x: 'загрузка ρ', y: 'время в системе / время обслуживания', mean: 'среднее W/S = 1/(1−ρ)', p99: 'p99/S = 4.6/(1−ρ)', band: 'цель: 70–80%', sim: 'точки: моделирование',
      mark: (r: number) => `×${Math.round(mean(r))} при ${Math.round(r * 100)}%` }
  : { x: 'utilization ρ', y: 'time in system / service time', mean: 'mean W/S = 1/(1−ρ)', p99: 'p99/S = 4.6/(1−ρ)', band: 'plan for 70–80 %', sim: 'dots: simulation',
      mark: (r: number) => `×${Math.round(mean(r))} at ${Math.round(r * 100)} %` };

interface Layout { cls: string; W: number; H: number; box: [number, number, number, number]; wide: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 340, box: [70, 30, 730, 286], wide: true },
  { cls: 'fig-narrow', W: 360, H: 360, box: [44, 30, 336, 300], wide: false },
];
const plots = layouts.map((L) => {
  const [x0, y0, x1, y1] = L.box;
  const sx = scale([0, 1], [x0, x1]);
  const sy = scale([0, YMAX], [y1, y0]);
  // Mark labels: at 50 %, where the curve is still flat, above and left of the point; at 80 %, below and right of it,
  // in the empty region under the convex curve; at 90 % and 95 %, to the left. Each label box is checked against both curves.
  const place: Record<string, [number, number, 'start' | 'end']> = { '0.5': [-4, -12, 'end'], '0.8': [8, 17, 'start'], '0.9': [-14, 4, 'end'], '0.95': [-10, 4, 'end'] };
  const markLabels = marks.map((r) => {
    const s = L.wide ? t.mark(r) : `×${Math.round(mean(r))}`;
    const w = s.length * 6.5;
    const [dx, dy, anchor] = place[String(r)];
    const x = sx(r) + dx, y = sy(mean(r)) + dy;
    const l = anchor === 'end' ? x - w : x;
    return { r, s, x, y, w, anchor, l, rgt: l + w };
  });
  for (const m of markLabels) {
    if (m.l < x0 + 4 || m.rgt > L.W - 4) throw new Error(`mark ${m.s} leaves the figure at ${L.W}`);
    for (let x = m.l; x <= m.rgt; x += 2) {
      const r = (x - x0) / (x1 - x0);
      if (r < p99End) {
        const yc = sy(p99(r));
        if (yc > m.y - 13 && yc < m.y + 4) throw new Error(`mark ${m.s} meets the p99 curve at ${L.W}`);
      }
      if (r < meanEnd) {
        const ym = sy(mean(r));
        if (ym > m.y - 13 && ym < m.y + 4) throw new Error(`mark ${m.s} meets the mean curve at ${L.W}`);
      }
    }
  }
  for (let i = 0; i < markLabels.length; i++) for (let j = i + 1; j < markLabels.length; j++) {
    const a = markLabels[i], b = markLabels[j];
    if (a.l < b.rgt && b.l < a.rgt && Math.abs(a.y - b.y) < 15) throw new Error(`marks ${a.s} and ${b.s} overlap at ${L.W}`);
  }
  // The legend (top left) must stay above both curves across its width, and the band label clear of the legend.
  const legendR = x0 + 38 + Math.max(t.mean.length, t.p99.length, t.sim.length) * 6.5, legendB = y0 + 62;
  for (let x = x0; x <= legendR; x += 2) {
    const r = (x - x0) / (x1 - x0);
    if (sy(Math.min(p99(r), YMAX)) < legendB + 4 || sy(Math.min(mean(r), YMAX)) < legendB + 4) throw new Error(`legend meets a curve at ${L.W}`);
  }
  const bandY = L.wide ? y0 + 16 : y0 + 82;
  const bandL = sx(0.7) - 6 - t.band.length * 6.5;
  if (bandL < legendR + 6 && bandY - 11 < legendB) throw new Error(`band label meets the legend at ${L.W}`);
  for (let x = bandL; x <= sx(0.7) - 6; x += 2) {
    const r = (x - x0) / (x1 - x0);
    const yc = sy(Math.min(p99(r), YMAX));
    if (r < p99End && yc > bandY - 13 && yc < bandY + 4) throw new Error(`band label meets the p99 curve at ${L.W}`);
  }
  return {
    L, sx, sy, markLabels, bandY,
    meanPath: plot(mean, 0, meanEnd, sx, sy, 200),
    p99Path: plot(p99, 0, p99End, sx, sy, 200),
  };
});
const id = 'latency-utilization';
---

<Figure
  id={id}
  title={ru ? 'Задержка растёт как 1/(1−ρ)' : 'Latency grows like 1/(1−ρ)'}
  caption={ru
    ? 'Модель M/M/1: пуассоновский поток запросов, экспоненциальное время обслуживания со средним S, один сервер. Синяя кривая — среднее время в системе W = S/(1−ρ), красная — его 99-й перцентиль, в ln(100) ≈ 4.6 раза больше; обе в единицах S. При загрузке 50% запрос занимает 2S, при 80% — 5S, при 90% — 10S, при 95% — 20S; p99 уходит за край графика уже около 82%. Точки — моделирование 2 млн запросов на каждую загрузку при S = 10 мс. Зелёная полоса — обычная целевая загрузка для сервисов, чувствительных к задержке.'
    : 'The M/M/1 model: Poisson arrivals, exponential service times with mean S, one server. The blue curve is the mean time in the system, W = S/(1−ρ); the red one is its 99th percentile, ln(100) ≈ 4.6 times larger; both in units of S. At 50 % utilization a request takes 2S, at 80 % 5S, at 90 % 10S and at 95 % 20S; the p99 leaves the plot already near 82 %. The dots are a simulation of 2 million requests per utilization with S = 10 ms. The green band is the usual target for latency-sensitive services.'}
>
  {plots.map(({ L, sx, sy, markLabels, bandY, meanPath, p99Path }) => {
    const [x0, y0, x1, y1] = L.box;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Время в системе в зависимости от загрузки' : 'Time in the system against utilization'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'График от загрузки 0 до 1 по горизонтали и от 0 до 25 единиц времени обслуживания по вертикали. Синяя кривая начинается с 1 и почти горизонтальна до половины, затем круто уходит вверх: 2 при 50%, 5 при 80%, 10 при 90%, 20 при 95%. Красная кривая p99 в 4.6 раза выше и выходит за верх около 82%. Точки моделирования лежат на кривых. Полоса от 70 до 80% закрашена.'
          : 'A plot of utilization from 0 to 1 horizontally and from 0 to 25 service times vertically. The blue curve starts at 1, stays almost flat to one half, then rises steeply: 2 at 50 %, 5 at 80 %, 10 at 90 %, 20 at 95 %. The red p99 curve is 4.6 times higher and leaves the top near 82 %. The simulation dots lie on the curves. A band from 70 to 80 % is shaded.'}</desc>
        <rect x={sx(0.7)} y={y0} width={sx(0.8) - sx(0.7)} height={y1 - y0} class="f-fill-green" />
        <text class="f-small f-t-green f-halo" x={sx(0.7) - 6} y={bandY} text-anchor="end">{t.band}</text>
        {[0, 5, 10, 15, 20, 25].map((v) => (
          <g>
            <path class="f-grid" d={`M ${x0} ${sy(v)} H ${x1}`} />
            <text class="f-note" x={x0 - 8} y={sy(v) + 5} text-anchor="end">{String(v)}</text>
          </g>
        ))}
        {[0, 0.2, 0.4, 0.6, 0.8, 1].map((v) => (
          <g>
            <path class="f-axis" d={`M ${sx(v)} ${y1} v 5`} />
            <text class="f-note" x={sx(v)} y={y1 + 20} text-anchor="middle">{`${Math.round(v * 100)} %`}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${x0} ${y0} V ${y1} H ${x1}`} />
        <text class="f-note" x={x1} y={y1 + 42} text-anchor="end">{t.x}</text>
        <text class="f-note" x={x0} y={y1 + 42}>{L.wide ? t.y : ''}</text>
        <path class="f-line f-red" d={p99Path} />
        <path class="f-line f-blue f-bold" d={meanPath} />
        {simP99.map(([r, ms]) => <circle cx={sx(r)} cy={sy(ms / 10)} r="3.5" class="f-solid-red" />)}
        {simMean.map(([r, ms]) => <circle cx={sx(r)} cy={sy(ms / 10)} r="3.5" class="f-solid-blue" />)}
        {markLabels.map((m) => <text class="f-small f-halo" x={m.x} y={m.y} text-anchor={m.anchor}>{m.s}</text>)}
        <g>
          <path class="f-line f-blue f-bold" d={`M ${x0 + 8} ${y0 + 12} h 22`} />
          <text class="f-small f-halo" x={x0 + 38} y={y0 + 16}>{t.mean}</text>
          <path class="f-line f-red" d={`M ${x0 + 8} ${y0 + 32} h 22`} />
          <text class="f-small f-halo" x={x0 + 38} y={y0 + 36}>{t.p99}</text>
          <circle cx={x0 + 19} cy={y0 + 52} r="3.5" class="f-solid-muted" />
          <text class="f-small f-t-muted f-halo" x={x0 + 38} y={y0 + 56}>{t.sim}</text>
        </g>
      </svg>
    );
  })}
</Figure>
