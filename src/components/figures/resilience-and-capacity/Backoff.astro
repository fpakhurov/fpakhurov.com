---
import Figure from '../Figure.astro';
import { scale, seeded } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// 1,000 clients fail at t = 0 and each makes 5 retries with exponential backoff, base 100 ms (delays 0.1, 0.2, 0.4, 0.8, 1.6 s).
// Without jitter every client retries at 0.1, 0.3, 0.7, 1.5 and 3.1 s. With full jitter each delay is uniform on [0, 0.1 * 2^k].
// Retries are counted in bins of 20 ms over the first 3.5 s.
const N = 1000, base = 0.1, retries = 5, bin = 0.02, T = 3.5;
const nb = Math.round(T / bin);
const plain = new Array(nb).fill(0), jit = new Array(nb).fill(0);
const rnd = seeded(42);
let lastJit = 0;
for (let c = 0; c < N; c++) {
  let tp = 0, tj = 0;
  for (let k = 0; k < retries; k++) {
    tp += base * 2 ** k;
    tj += rnd() * base * 2 ** k;
    const bp = Math.floor(tp / bin + 1e-9), bj = Math.floor(tj / bin);
    if (bp < nb) plain[bp]++;
    if (bj < nb) jit[bj]++;
    lastJit = Math.max(lastJit, tj);
  }
}
const spikes = plain.map((v, i) => [i, v]).filter(([, v]) => v > 0);
if (spikes.map(([i]) => (i * bin).toFixed(2)).join(' ') !== '0.10 0.30 0.70 1.50 3.10' || spikes.some(([, v]) => v !== N)) throw new Error('plain spikes');
const peak = Math.max(...jit);
if (peak !== 313) throw new Error(`jitter peak ${peak}`);
if (jit.reduce((x, y) => x + y, 0) !== N * retries) throw new Error('every jittered retry falls inside the plot');
if (Math.abs(lastJit - 2.862) > 0.001) throw new Error(`last jittered retry ${lastJit}`);

const fmtN = (n: number) => (ru ? String(n) : n.toLocaleString('en-US'));
const t = ru
  ? { plain: 'без джиттера: пять всплесков по 1000 повторов за 20 мс', jit: 'полный джиттер: те же 5000 повторов, пик 313 за 20 мс', plainN: 'без джиттера: 5 × 1000 за 20 мс', jitN: 'полный джиттер: пик 313', x: 'время после сбоя, с', y: 'повторов за 20 мс' }
  : { plain: 'no jitter: five spikes of 1,000 retries in 20 ms', jit: 'full jitter: the same 5,000 retries, peak 313 per 20 ms', plainN: 'no jitter: 5 × 1,000 in 20 ms', jitN: 'full jitter: peak 313', x: 'time since the failure, s', y: 'retries per 20 ms' };

interface Layout { cls: string; W: number; x0: number; x1: number; panelH: number; gap: number; top: number; wide: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, x0: 70, x1: 734, panelH: 110, gap: 44, top: 34, wide: true },
  { cls: 'fig-narrow', W: 360, x0: 46, x1: 346, panelH: 110, gap: 44, top: 34, wide: false },
];
const H = (L: Layout) => L.top + 2 * L.panelH + L.gap + 50;
for (const L of layouts) {
  for (const s of L.wide ? [t.plain, t.jit] : [t.plainN, t.jitN]) if (L.x0 + s.length * 6.5 > L.W - 4) throw new Error(`"${s}" at ${L.W}`);
  if (L.x0 + t.y.length * 7 > L.x1 - 20 && L.wide) throw new Error('y label');
}
const id = 'backoff-jitter';
---

<Figure
  id={id}
  title={ru ? 'Экспоненциальная задержка без джиттера и с полным джиттером' : 'Exponential backoff without and with full jitter'}
  caption={ru
    ? 'Тысяча клиентов получает ошибку в момент 0, и каждый делает пять повторов с экспоненциальной задержкой от 100 мс: 0.1, 0.2, 0.4, 0.8 и 1.6 с. Столбцы — число повторов в каждом интервале 20 мс. Без джиттера все клиенты повторяют одновременно, в 0.1, 0.3, 0.7, 1.5 и 3.1 с: пять волн по 1000 запросов, каждая из которых может снова уронить восстанавливающийся сервис. С полным джиттером каждая задержка случайна от нуля до своего экспоненциального значения; те же 5000 повторов растягиваются на 2.9 с, и самый загруженный интервал содержит 313. Случайные задержки взяты из генератора с фиксированным начальным значением (seed).'
    : 'A thousand clients get an error at time 0, and each makes five retries with exponential backoff from 100 ms: 0.1, 0.2, 0.4, 0.8 and 1.6 s. The bars count retries in each 20 ms interval. Without jitter all clients retry at the same moments, 0.1, 0.3, 0.7, 1.5 and 3.1 s: five waves of 1,000 requests, any of which can knock the recovering service over again. With full jitter each delay is random between zero and its exponential value; the same 5,000 retries spread over 2.9 s, and the busiest interval holds 313. The random delays come from a generator with a fixed seed.'}
>
  {layouts.map((L) => {
    const sx = scale([0, T], [L.x0, L.x1]);
    const bw = (L.x1 - L.x0) / nb;
    const panels = [
      { top: L.top, data: plain, tone: 'red', title: L.wide ? t.plain : t.plainN },
      { top: L.top + L.panelH + L.gap, data: jit, tone: 'blue', title: L.wide ? t.jit : t.jitN },
    ];
    const axisY = panels[1].top + L.panelH;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${H(L)}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Повторы во времени без джиттера и с джиттером' : 'Retries over time without and with jitter'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Две гистограммы на общей оси времени от 0 до 3.5 секунды, по вертикали от 0 до 1000 повторов за 20 мс. Верхняя: пять узких столбцов высотой 1000 в 0.1, 0.3, 0.7, 1.5 и 3.1 секунды. Нижняя: невысокие столбцы, самый высокий около 313 в первые 0.1 секунды, дальше всё ниже до 2.9 секунды.'
          : 'Two histograms on a shared time axis from 0 to 3.5 seconds, vertically from 0 to 1,000 retries per 20 ms. Top: five narrow bars of height 1,000 at 0.1, 0.3, 0.7, 1.5 and 3.1 seconds. Bottom: low bars, the highest about 313 within the first 0.1 seconds, then lower and lower until 2.9 seconds.'}</desc>
        {panels.map((p) => {
          const sy = scale([0, N], [p.top + L.panelH, p.top]);
          return (
            <g>
              {[0, 500, 1000].map((v) => (
                <g>
                  <path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} />
                  <text class="f-note" x={L.x0 - 8} y={sy(v) + 5} text-anchor="end">{fmtN(v)}</text>
                </g>
              ))}
              <text class={`f-small f-t-${p.tone}`} x={L.x0} y={p.top - 12} style="font-weight: 650">{p.title}</text>
              {p.data.map((v, i) => v === 0 ? null : (
                <rect x={L.x0 + i * bw + 0.3} y={sy(v)} width={Math.max(bw - 0.6, 1.2)} height={sy(0) - sy(v)} style={`fill: var(--fig-${p.tone}); fill-opacity: 0.75`} />
              ))}
              <path class="f-axis" d={`M ${L.x0} ${p.top} V ${p.top + L.panelH} H ${L.x1}`} />
            </g>
          );
        })}
        {[0, 0.5, 1, 1.5, 2, 2.5, 3, 3.5].map((v) => (
          <g>
            <path class="f-axis" d={`M ${sx(v)} ${axisY} v 5`} />
            <text class="f-note" x={sx(v)} y={axisY + 20} text-anchor="middle">{ru ? String(v).replace('.', ',') : String(v)}</text>
          </g>
        ))}
        <text class="f-note" x={L.x1} y={axisY + 42} text-anchor="end">{t.x}</text>
        {L.wide && <text class="f-note" x={L.x0} y={axisY + 42}>{t.y}</text>}
      </svg>
    );
  })}
</Figure>
