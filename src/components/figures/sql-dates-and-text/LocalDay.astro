---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const id = 'sql-local-day';
const ru = pageLang(Astro.url) === 'ru';
const title = ru ? 'Границы дня в Нью-Йорке' : 'The boundaries of a day in New York';
const startHour = 5;
const nextDayHour = 4;
const duration = 24 + nextDayHour - startHour;
const month = ru ? 'мар' : 'Mar';
---
<Figure id={id} title={title} caption={ru
  ? '9 марта 2025 года начинается при смещении −05:00. К началу следующего дня смещение меняется на −04:00. В правой точке начинается новый интервал.'
  : 'March 9, 2025 starts with offset −05:00. By the next midnight, the offset is −04:00. The right endpoint begins the next interval.'}>
  <svg class="fig-compact" viewBox="0 0 330 137" role="img" aria-labelledby={id + '-title ' + id + '-desc'}>
    <title id={id + '-title'}>{title}</title>
    <desc id={id + '-desc'}>{ru
      ? 'Две полуночи в Нью-Йорке соответствуют 05:00 и 04:00 UTC в соседние дни. Первая входит в интервал, вторая исключается.'
      : 'Two New York midnights correspond to 05:00 and 04:00 UTC on consecutive dates. The first belongs to the interval and the second is excluded.'}</desc>
    <text x="165" y="17" text-anchor="middle" class="f-title">America/New_York</text>
    <text x="79" y="39" text-anchor="middle">09 {month} · 00:00</text>
    <text x="251" y="39" text-anchor="middle">10 {month} · 00:00</text>
    <path d="M 79 47 V 66 M 251 47 V 66" class="f-axis" />
    <path d="M 79 73 H 251" class="f-axis f-green" />
    <circle cx="79" cy="73" r="4" class="f-solid-green" />
    <circle cx="251" cy="73" r="4" class="f-box f-green" />
    <text x="165" y="66" text-anchor="middle" class="f-title">{duration} {ru ? 'ч' : 'h'}</text>
    <text x="79" y="99" text-anchor="middle">09 {month} · 0{startHour}:00</text>
    <text x="251" y="99" text-anchor="middle">10 {month} · 0{nextDayHour}:00</text>
    <text x="165" y="124" text-anchor="middle" class="f-title">UTC</text>
  </svg>
</Figure>
