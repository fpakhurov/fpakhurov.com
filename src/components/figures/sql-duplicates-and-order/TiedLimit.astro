---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const copy = ru
  ? {
      title: 'Граница выборки проходит внутри группы с одинаковой суммой',
      caption: 'Обе позиции стоят 1200 копеек. При LIMIT 1 сортировка только по сумме допускает обе. Дополнительные ключи оставляют первой позицию 103/1.',
      desc: 'Две позиции с суммой 1200. При сортировке только по сумме первой может быть любая. При равной сумме меньший номер заказа ставит 103/1 первой.',
      headings: ['Только сумма', 'Сумма, заказ, позиция'],
      results: ['103/1 или 104/1', '103/1'],
    }
  : {
      title: 'The limit cuts through a tie',
      caption: 'Both lines cost 1200 cents. With LIMIT 1 and amount as the only sort key, either line can be returned. The additional keys put line 103/1 first.',
      desc: 'Two lines cost 1200. With amount as the only key either may come first. For tied amounts the smaller order number puts 103/1 first.',
      headings: ['Amount alone', 'Amount, order, line'],
      results: ['103/1 or 104/1', '103/1'],
    };
---
<Figure id="sql-tied-limit" title={copy.title} caption={copy.caption}>
  <svg viewBox="0 0 340 166" role="img" aria-labelledby="tied-limit-title tied-limit-desc" style="max-width: 520px; margin-inline: auto">
    <title id="tied-limit-title">{copy.title}</title>
    <desc id="tied-limit-desc">{copy.desc}</desc>
    <rect class="f-fill-blue" x="9" y="10" width="154" height="34" rx="7" />
    <rect class="f-fill-blue" x="177" y="10" width="154" height="34" rx="7" />
    <text class="f-label" x="86" y="32" text-anchor="middle">103/1 · 1200</text>
    <text class="f-label" x="254" y="32" text-anchor="middle">104/1 · 1200</text>
    {copy.headings.map((heading, i) => (
      <g transform={`translate(${i * 168} 0)`}>
        <text class="f-label" x="86" y="76" text-anchor="middle">{heading}</text>
        <text class="f-small f-t-muted" x="86" y="98" text-anchor="middle">LIMIT 1</text>
        <path class="f-line" d="M 86 105 V 119 M 82 115 L 86 119 L 90 115" fill="none" />
        <rect class={i === 0 ? 'f-fill-amber' : 'f-fill-green'} x="9" y="124" width="154" height="34" rx="7" />
        <text class="f-label" x="86" y="146" text-anchor="middle">{copy.results[i]}</text>
      </g>
    ))}
  </svg>
</Figure>
