---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A Beta(2, 2) prior for a coin's probability of heads, updated as flips arrive: 3 heads in the first 3 flips,
// 7 in the first 10, 70 in the first 100. With integer parameters the Beta density uses factorials.
const lf = (k: number) => { let s = 0; for (let i = 2; i <= k; i++) s += Math.log(i); return s; };
const beta = (a: number, b: number, p: number) => Math.exp((a - 1) * Math.log(p) + (b - 1) * Math.log(1 - p) + lf(a + b - 1) - lf(a - 1) - lf(b - 1));
const states = [
  { a: 2, b: 2, en: 'prior Beta(2, 2)', ru: 'априорное Beta(2, 2)', tone: 'green' },
  { a: 5, b: 2, en: '3 heads of 3: Beta(5, 2)', ru: '3 орла из 3: Beta(5, 2)', tone: 'amber' },
  { a: 9, b: 5, en: '7 of 10: Beta(9, 5)', ru: '7 из 10: Beta(9, 5)', tone: 'blue' },
  { a: 72, b: 32, en: '70 of 100: Beta(72, 32)', ru: '70 из 100: Beta(72, 32)', tone: 'red' },
];
const means = states.map((s) => s.a / (s.a + s.b));
if (means.map((m) => m.toFixed(3)).join() !== '0.500,0.714,0.643,0.692') throw new Error('BetaUpdates: means drifted from the note');
const ps = Array.from({ length: 199 }, (_, i) => 0.005 + i * 0.005);
const peak = states.map((s) => Math.max(...ps.map((p) => beta(s.a, s.b, p))));
const t = ru
  ? { x: 'вероятность орла p', steps: ['априорное распределение Beta(2, 2): «вероятно, около 0.5»', '3 орла из 3: Beta(5, 2), среднее 0.714, а не 1', '7 орлов из 10: Beta(9, 5), среднее 0.643', '70 из 100: Beta(72, 32), среднее 0.692, данные перевешивают априорное'] }
  : { x: 'probability of heads p', steps: ['the prior Beta(2, 2): "probably near 0.5"', '3 heads in 3: Beta(5, 2), mean 0.714, not 1', '7 heads in 10: Beta(9, 5), mean 0.643', '70 in 100: Beta(72, 32), mean 0.692; the data outweigh the prior'] };
const id = 'beta-updates';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 620, H: 320, x0: 40, x1: 600, y0: 24, y1: 250, lx: 50, ly: 40 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 400, x0: 20, x1: 344, y0: 110, y1: 330, lx: 20, ly: 22 },
];
---

<Figure
  id={id}
  title={ru ? 'Апостериорное распределение по мере поступления данных' : 'The posterior as the data arrive'}
  caption={ru
    ? 'Плотность вероятности орла p. Априорное Beta(2, 2) (1) после 3 орлов в 3 бросках становится Beta(5, 2) со средним 0.714, а не единицей, как у оценки максимального правдоподобия (2); после 7 орлов из 10 — Beta(9, 5) (3), после 70 из 100 — узкое Beta(72, 32) со средним 0.692 (4). Каждое апостериорное распределение — априорное для следующей порции данных.'
    : 'The density of the probability of heads p. The prior Beta(2, 2) (1) becomes Beta(5, 2) after 3 heads in 3 flips, with mean 0.714 rather than the maximum likelihood estimate of 1 (2); after 7 heads in 10 it is Beta(9, 5) (3), after 70 in 100 the narrow Beta(72, 32) with mean 0.692 (4). Each posterior is the prior for the next batch of data.'}
>
  {layouts.map((L) => {
    const sx = scale([0, 1], [L.x0, L.x1]), sy = scale([0, 9.5], [L.y1, L.y0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Четыре бета-плотности' : 'Four beta densities'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Пологая горка у 0.5, сдвинутая вправо плотность, более узкая около 0.64 и острый пик около 0.69.' : 'A low hump at 0.5, a density shifted right, a narrower one near 0.64 and a sharp peak near 0.69.'}</desc>
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {[0, 0.25, 0.5, 0.75, 1].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{v}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 42} text-anchor="middle">{t.x}</text>
        {states.map((s, k) => (
          <g data-s={k + 1}>
            <path class={`f-line f-${s.tone}`} d={polyline(ps.map((p) => [sx(p), sy(beta(s.a, s.b, p))]))} />
            <path class={`f-thin f-${s.tone} f-dash`} d={`M ${sx(means[k])} ${L.y1} V ${sy(Math.min(peak[k], 9.3))}`} />
            <path class={`f-line f-${s.tone}`} d={`M ${L.lx} ${L.ly + k * 22} h 22`} />
            <text class="f-note" x={L.lx + 46} y={L.ly + k * 22 + 5}>{ru ? s.ru : s.en}</text>
            <Badge x={L.lx + 34} y={L.ly + k * 22} n={k + 1} />
          </g>
        ))}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
