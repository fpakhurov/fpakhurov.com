---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { phi } from '../normal';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A normal mean μ with prior N(0, 1) and n = 4 observations of N(μ, 1) with average 2. The likelihood of μ is
// proportional to N(2, 1/4); the posterior is N(1.6, 0.2): precisions add (1 + 4 = 5) and the mean is their weighted average.
const prior = { m: 0, v: 1 }, lik = { m: 2, v: 0.25 };
const pv = 1 / (1 / prior.v + 1 / lik.v), pm = pv * (prior.m / prior.v + lik.m / lik.v);
if ([pm, pv].map((v) => v.toFixed(2)).join() !== '1.60,0.20') throw new Error('NormalShrinkage: posterior drifted from the note');
const dens = (m: number, v: number) => (x: number) => phi((x - m) / Math.sqrt(v)) / Math.sqrt(v);
const curves = [
  { f: dens(prior.m, prior.v), m: prior.m, tone: 'green', en: 'prior N(0, 1)', ru: 'априорное N(0, 1)' },
  { f: dens(lik.m, lik.v), m: lik.m, tone: 'blue', en: 'likelihood, x̄ = 2, n = 4', ru: 'правдоподобие, x̄ = 2, n = 4' },
  { f: dens(pm, pv), m: pm, tone: 'red', en: 'posterior N(1.6, 0.2)', ru: 'апостериорное N(1.6, 0.2)' },
];
const xs = Array.from({ length: 141 }, (_, i) => -3 + i * 0.05);
const id = 'normal-shrinkage';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 300, x0: 30, x1: 580, y0: 30, y1: 240, lx: 40, ly: 44 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 340, x0: 16, x1: 344, y0: 96, y1: 280, lx: 16, ly: 22 },
];
---

<Figure
  id={id}
  title={ru ? 'Апостериорное среднее — компромисс между априорным и данными' : 'The posterior mean is a compromise between the prior and the data'}
  caption={ru
    ? `Априорное N(0, 1) для среднего μ и четыре наблюдения со средним 2 и дисперсией шума 1. Точности складываются: 1 + 4 = 5, так что апостериорная дисперсия 1/5 = 0.2, а среднее — взвешенное среднее 0 и 2 с весами 1 и 4: ${pm.toFixed(1)}. Апостериорное распределение уже обоих исходных и сдвинуто от данных к априорному: это и есть сжатие (shrinkage), которое регуляризация делает с весами модели.`
    : `A prior N(0, 1) for the mean μ and four observations with average 2 and noise variance 1. Precisions add, 1 + 4 = 5, so the posterior variance is 1/5 = 0.2, and its mean is the average of 0 and 2 weighted 1 to 4: ${pm.toFixed(1)}. The posterior is narrower than both inputs and pulled from the data toward the prior: the shrinkage that regularization applies to a model's weights.`}
>
  {layouts.map((L) => {
    const sx = scale([-3, 4], [L.x0, L.x1]), sy = scale([0, 0.95], [L.y1, L.y0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Априорное, правдоподобие и апостериорное' : 'Prior, likelihood and posterior'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Широкий колокол у 0, более узкий у 2 и самый узкий у 1.6.' : 'A wide bell at 0, a narrower one at 2 and the narrowest at 1.6.'}</desc>
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {[-2, -1, 0, 1, 2, 3, 4].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{v}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 42} text-anchor="middle">μ</text>
        {curves.map((c, k) => (
          <g>
            <path class={`f-line f-${c.tone}`} d={polyline(xs.map((x) => [sx(x), sy(c.f(x))]))} />
            <path class={`f-thin f-${c.tone} f-dash`} d={`M ${sx(c.m)} ${L.y1} V ${sy(c.f(c.m))}`} />
            <path class={`f-line f-${c.tone}`} d={`M ${L.lx} ${L.ly + k * 22} h 22`} />
            <text class="f-note" x={L.lx + 30} y={L.ly + k * 22 + 5}>{ru ? c.ru : c.en}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
