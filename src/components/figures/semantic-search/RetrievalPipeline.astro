---
import BlockDiagram, { type DLayout } from '../BlockDiagram.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The retriever the note builds up to, at query time: dense and lexical search in parallel, fused, reranked.
const t = ru
  ? { q: 'запрос', enc: 'энкодер', encSub: 'вектор запроса', dense: 'плотный поиск', denseSub: 'ближайшие векторы', bm25: 'поиск BM25', bm25Sub: 'общие термины', fuse: 'слияние', fuseSub: 'взвешенный RRF', rr: 'кросс-энкодер', rrSub: 'переранжирует', out: 'топ-k', outSub: 'фрагментов' }
  : { q: 'query', enc: 'encoder', encSub: 'query vector', dense: 'dense search', denseSub: 'nearest vectors', bm25: 'BM25 search', bm25Sub: 'shared terms', fuse: 'fusion', fuseSub: 'weighted RRF', rr: 'cross-encoder', rrSub: 'reranks', out: 'top k', outSub: 'chunks' };
const desc = ru
  ? 'Запрос идёт двумя путями: через энкодер в плотный поиск по ближайшим векторам и напрямую в поиск BM25 по общим терминам. Два списка сливаются по рангам (взвешенный RRF), кросс-энкодер переранжирует лучших кандидатов, и на выходе остаются k лучших фрагментов.'
  : 'The query takes two paths: through the encoder into dense search over the nearest vectors, and directly into BM25 search over shared terms. The two lists are fused by rank (weighted RRF), a cross-encoder reranks the top candidates, and the best k chunks come out.';
const wide: DLayout = {
  cls: 'fig-wide', w: 760, h: 200, desc,
  nodes: [
    { id: 'q', x: 6, y: 78, w: 66, h: 44, label: t.q, tone: 'soft' },
    { id: 'enc', x: 92, y: 30, w: 110, h: 50, label: t.enc, sub: t.encSub, tone: 'blue' },
    { id: 'dense', x: 222, y: 30, w: 140, h: 50, label: t.dense, sub: t.denseSub, tone: 'blue' },
    { id: 'bm25', x: 222, y: 124, w: 140, h: 50, label: t.bm25, sub: t.bm25Sub, tone: 'amber' },
    { id: 'fuse', x: 384, y: 76, w: 116, h: 50, label: t.fuse, sub: t.fuseSub },
    { id: 'rr', x: 520, y: 76, w: 124, h: 50, label: t.rr, sub: t.rrSub, tone: 'green' },
    { id: 'out', x: 664, y: 76, w: 90, h: 50, label: t.out, sub: t.outSub, tone: 'soft' },
  ],
  edges: [
    { from: 'q', to: 'enc' }, { from: 'enc', to: 'dense' }, { from: 'q', to: 'bm25' },
    { from: 'dense', to: 'fuse' }, { from: 'bm25', to: 'fuse' }, { from: 'fuse', to: 'rr' }, { from: 'rr', to: 'out' },
  ],
};
const narrow: DLayout = {
  cls: 'fig-narrow', w: 360, h: 382, desc,
  nodes: [
    { id: 'q', x: 120, y: 8, w: 120, h: 40, label: t.q, tone: 'soft' },
    { id: 'enc', x: 8, y: 76, w: 160, h: 48, label: t.enc, sub: t.encSub, tone: 'blue' },
    { id: 'dense', x: 8, y: 146, w: 160, h: 48, label: t.dense, sub: t.denseSub, tone: 'blue' },
    { id: 'bm25', x: 192, y: 112, w: 160, h: 48, label: t.bm25, sub: t.bm25Sub, tone: 'amber' },
    { id: 'fuse', x: 100, y: 220, w: 160, h: 46, label: t.fuse, sub: t.fuseSub },
    { id: 'rr', x: 100, y: 286, w: 160, h: 46, label: t.rr, sub: t.rrSub, tone: 'green' },
    { id: 'out', x: 90, y: 346, w: 180, h: 30, label: `${t.out} ${t.outSub}`, tone: 'soft' },
  ],
  edges: [
    { from: 'q', to: 'enc' }, { from: 'enc', to: 'dense' }, { from: 'q', to: 'bm25' },
    { from: 'dense', to: 'fuse' }, { from: 'bm25', to: 'fuse' }, { from: 'fuse', to: 'rr' }, { from: 'rr', to: 'out' },
  ],
};
---

<BlockDiagram
  id="retrieval-pipeline"
  title={ru ? 'Поисковая модель во время запроса' : 'The retriever at query time'}
  svgTitle={ru ? 'Гибридный поиск с переранжированием' : 'Hybrid retrieval with reranking'}
  caption={ru
    ? 'Поисковая модель, к которой ведёт эта заметка, во время запроса. Заранее, один раз, посты режутся на фрагменты, каждый фрагмент кодируется энкодером, а векторы и обратный индекс терминов сохраняются. На запрос энкодер даёт его вектор для плотного поиска по ближайшим векторам, а BM25 параллельно ищет фрагменты с общими терминами: плотный поиск ловит пересказ, BM25 — точные имена и коды. Два списка сливаются по рангам, кросс-энкодер, читающий запрос и фрагмент вместе, переранжирует лучших кандидатов, и дальше передаются k лучших. Части пробуются по отдельности — гибрид и переранжирование поверх поиска по родительским документам, — и каждый вариант измеряется на эталонной выборке до того, как подключается генерация.'
    : 'The retriever this note builds up to, at query time. Ahead of time, once, posts are cut into chunks, each chunk is encoded, and the vectors and an inverted index of terms are stored. At query time the encoder turns the query into a vector for dense search over the nearest vectors, while BM25 searches in parallel for chunks that share its terms: dense search catches paraphrase, BM25 exact names and codes. The two lists are fused by rank, a cross-encoder that reads the query and the chunk together reranks the top candidates, and the best k are handed on. The pieces are tried separately, the hybrid and the reranker on top of parent-document retrieval, and each variant is measured on the golden set before generation is attached.'}
  layouts={[wide, narrow]}
/>
