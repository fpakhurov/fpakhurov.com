---
import Figure from '../Figure.astro';
import { scale, polyline, seeded } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Adam (β1 = 0.9, β2 = 0.999, bias correction) on gradients that are pure standard normal noise, 4000 coordinates,
// 2000 steps. Plotted: the mean |Δw| / η over the coordinates, without warm-up and with a linear warm-up over 200 steps
// (step t multiplied by min(1, t/200)). The ratio m̂/√v̂ does not depend on η, so the warm-up curve is that ratio times t/200.
const N = 4000, T = 2000, W = 200, b1 = 0.9, b2 = 0.999, eps = 1e-8;
const rnd = seeded(7);
const gauss = () => {
  const u = Math.max(rnd(), 1e-12), v = rnd();
  return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
};
const m = new Float64Array(N), v = new Float64Array(N);
const ratio: number[] = [0];
for (let t = 1; t <= T; t += 1) {
  let s = 0;
  const c1 = 1 - b1 ** t, c2 = 1 - b2 ** t;
  for (let i = 0; i < N; i += 1) {
    const g = gauss();
    m[i] = b1 * m[i] + (1 - b1) * g;
    v[i] = b2 * v[i] + (1 - b2) * g * g;
    s += Math.abs(m[i] / c1 / (Math.sqrt(v[i] / c2) + eps));
  }
  ratio.push(s / N);
}
const steady = Math.sqrt((1 - b1) / (1 + b1)) * Math.sqrt(2 / Math.PI);
const warm = (t: number) => Math.min(1, t / W) * ratio[t];
const tail = ratio.slice(500).reduce((a, b) => a + b, 0) / (T - 499);
if (ratio[1].toFixed(3) !== '1.000' || Math.abs(ratio[10] - 0.271) > 0.015 || Math.abs(tail - steady) > 0.006 || steady.toFixed(3) !== '0.183')
  throw new Error(`AdamEarlySteps: simulation drifted (${ratio[1]}, ${ratio[10]}, ${tail}, ${steady})`);
const peakWarmEarly = Math.max(...ratio.slice(1, W).map((r, i) => (Math.min(1, (i + 1) / W) * r)));
if (peakWarmEarly > steady + 0.02) throw new Error(`AdamEarlySteps: warm-up curve exceeds the steady state (${peakWarmEarly})`);

const ts = [...new Set(Array.from({ length: 161 }, (_, i) => Math.round(10 ** ((i / 160) * Math.log10(T)))))].filter((t) => t >= 1 && t <= T);
const t = ru
  ? { title: 'Первые шаги Adam на чистом шуме', x: 'шаг t (лог. шкала)', y: 'средний |Δw| / η', no: 'Adam без разогрева', wu: 'линейный разогрев на 200 шагов', st: `установившийся шаг ${steady.toFixed(3)}η`, first: 'шаг 1: η в каждой координате',
      desc: 'Средний размер шага Adam в единицах η, когда градиенты — чистый шум, против номера шага в логарифмической шкале. Без разогрева первый шаг равен η, к 10-му шагу около 0.27η, затем устанавливается на 0.183η. С линейным разогревом на 200 шагов шаг растёт от почти нуля и выходит на 0.183η к 200-му шагу, ни разу не превышая его.' }
  : { title: 'Adam’s first steps on pure noise', x: 'step t (log scale)', y: 'mean |Δw| / η', no: 'Adam without warm-up', wu: 'linear warm-up over 200 steps', st: `steady state ${steady.toFixed(3)}η`, first: 'step 1: η in every coordinate',
      desc: 'The mean size of an Adam step in units of η when the gradients are pure noise, against the step number on a log scale. Without warm-up the first step is η, about 0.27η by step 10, then it settles at 0.183η. With a linear warm-up over 200 steps the step grows from almost zero and reaches 0.183η at step 200, never exceeding it.' };
const id = 'opt-adam-early-steps';
const caption = ru
  ? `Adam с β₁ = 0.9 и β₂ = 0.999 на градиентах из стандартного нормального шума, ${N} координат; средний модуль шага в единицах шага обучения η. Из-за поправки на смещение первый шаг равен ±η в каждой координате, хотя в градиенте нет сигнала. Когда скользящие средние накопятся, m̂ усредняет около 19 градиентов, и шаг устанавливается на √(0.1/1.9) · √(2/π) = ${steady.toFixed(3)} η: первые шаги примерно в 5.5 раза больше. Линейный разогрев умножает шаг t на t/200 и убирает этот избыток.`
  : `Adam with β₁ = 0.9 and β₂ = 0.999 on gradients of standard normal noise, ${N} coordinates; the mean absolute step in units of the learning rate. Because of the bias correction the first step is ±η in every coordinate, although the gradient carries no signal. Once the moving averages have filled, m̂ averages about 19 gradients and the step settles at √(0.1/1.9) · √(2/π) = ${steady.toFixed(3)} η: the first steps are about 5.5 times larger. A linear warm-up multiplies step t by t/200 and removes the excess.`;
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [70, 720] as [number, number], py: [30, 250] as [number, number], leg: [430, 60], first: [86, 46] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 430, px: [56, 340] as [number, number], py: [30, 250] as [number, number], leg: [16, 330], first: [70, 48] },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => {
    const sx = scale([0, Math.log10(T)], Ly.px), sy = scale([0, 1.05], [Ly.py[1], Ly.py[0]]);
    const X = (tt: number) => sx(Math.log10(tt));
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
        {[0.25, 0.5, 0.75, 1].map((y) => <path class="f-grid" d={`M ${Ly.px[0]} ${sy(y)} H ${Ly.px[1]}`} />)}
        <path class="f-axis" d={`M ${Ly.px[0]} ${Ly.py[0]} V ${Ly.py[1]} H ${Ly.px[1]}`} />
        {[1, 10, 100, 1000].map((tt) => <text class="f-note" x={X(tt)} y={Ly.py[1] + 18} text-anchor="middle">{tt}</text>)}
        {[0, 0.5, 1].map((y) => <text class="f-note" x={Ly.px[0] - 7} y={sy(y) + 5} text-anchor="end">{y.toFixed(1)}</text>)}
        <text class="f-small f-t-muted" x={(Ly.px[0] + Ly.px[1]) / 2} y={Ly.py[1] + 40} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={Ly.px[0] - 40} y={Ly.py[0] - 12}>{t.y}</text>
        <path class="f-thin f-muted f-dash" d={`M ${Ly.px[0]} ${sy(steady)} H ${Ly.px[1]}`} />
        <path class="f-line f-red" d={polyline(ts.map((tt) => [X(tt), sy(ratio[tt])]))} />
        <path class="f-line f-blue" style="stroke-width: 2.4" d={polyline(ts.map((tt) => [X(tt), sy(warm(tt))]))} />
        <circle cx={X(1)} cy={sy(ratio[1])} r="4.5" class="f-solid-red" />
        <text class="f-small f-halo" x={Ly.first[0]} y={Ly.first[1]}>{t.first}</text>
        <text class="f-small f-t-muted f-halo" x={Ly.px[1]} y={sy(steady) - 12} text-anchor="end">{t.st}</text>
        <path class="f-line f-red" d={`M ${Ly.leg[0]} ${Ly.leg[1] - 4} h 26`} />
        <text class="f-small" x={Ly.leg[0] + 34} y={Ly.leg[1]}>{t.no}</text>
        <path class="f-line f-blue" style="stroke-width: 2.4" d={`M ${Ly.leg[0]} ${Ly.leg[1] + 20} h 26`} />
        <text class="f-small" x={Ly.leg[0] + 34} y={Ly.leg[1] + 24}>{t.wu}</text>
      </svg>
    );
  })}
</Figure>
