---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A one-dimensional loss with two minima of equal depth: a sharp well 20(w + 1)² and a flat well (w − 1.2)²,
// joined by a smooth minimum with temperature 0.1. SAM's objective is the worst loss within ρ = 0.3 of w.
const tau = 0.1, rho = 0.3, a = 40, sharpAt = -1, flatAt = 1.2;
const q1 = (w: number) => (a / 2) * (w - sharpAt) ** 2, q2 = (w: number) => (w - flatAt) ** 2;
const loss = (w: number) => {
  const m = Math.min(q1(w), q2(w));
  return m - tau * Math.log(Math.exp(-(q1(w) - m) / tau) + Math.exp(-(q2(w) - m) / tau));
};
const sam = (w: number) => {
  let best = -Infinity;
  for (let k = 0; k <= 120; k += 1) best = Math.max(best, loss(w - rho + (2 * rho * k) / 120));
  return best;
};
const chk = [loss(sharpAt), loss(flatAt), sam(sharpAt), sam(flatAt)].map((v) => v.toFixed(3)).join(' ');
if (chk !== '0.000 0.000 1.800 0.090') throw new Error(`SharpFlatSam: values drifted (${chk})`);

const W0 = -1.7, W1 = 2.7, YMAX = 2.6;
const ws = Array.from({ length: 441 }, (_, i) => W0 + ((W1 - W0) * i) / 440);
const t = ru
  ? { title: 'Целевая функция SAM отличает острый минимум от плоского', x: 'параметр w', l: 'функция потерь L(w)', s: 'целевая функция SAM: max L(w + ε), |ε| ≤ 0.3', sharp: 'острый: SAM 1.8', flat: 'плоский: SAM 0.09',
      desc: 'Функция потерь с двумя минимумами одинаковой глубины: узкий при w = −1 и широкий при w = 1.2. Целевая функция SAM — наибольшие потери в окрестности радиуса 0.3 — равна 1.8 в узком минимуме и 0.09 в широком.' }
  : { title: 'SAM’s objective tells a sharp minimum from a flat one', x: 'parameter w', l: 'loss L(w)', s: 'SAM objective: max L(w + ε), |ε| ≤ 0.3', sharp: 'sharp: SAM 1.8', flat: 'flat: SAM 0.09',
      desc: 'A loss with two minima of equal depth: a narrow one at w = −1 and a wide one at w = 1.2. SAM’s objective, the largest loss within radius 0.3, is 1.8 at the narrow minimum and 0.09 at the wide one.' };
const id = 'opt-sharp-flat-sam';
const caption = ru
  ? 'Одномерная функция потерь: узкая яма 20(w + 1)² и широкая (w − 1.2)², объединённые гладким минимумом (soft-min). Обе ямы достигают нуля, и обычный градиентный спуск останавливается в той, к которой ближе старт. Целевая функция SAM заменяет потери в точке наибольшими потерями на отрезке [w − ρ, w + ρ] (жёлтые отрезки, ρ = 0.3): у дна квадратичной ямы с кривизной a это aρ²/2, то есть 1.8 для a = 40 и 0.09 для a = 2. Минимум целевой функции SAM лежит в широкой яме.'
  : 'A one-dimensional loss: a narrow well 20(w + 1)² and a wide well (w − 1.2)², joined by a smooth minimum. Both wells reach zero, and plain gradient descent stops in whichever one it starts closer to. SAM’s objective replaces the loss at a point by the largest loss on [w − ρ, w + ρ] (amber segments, ρ = 0.3): at the bottom of a quadratic well with curvature a this is aρ²/2, so 1.8 for a = 40 and 0.09 for a = 2. The minimum of SAM’s objective lies in the wide well.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [64, 720] as [number, number], py: [36, 250] as [number, number], leg: [[64, 314], [330, 314]] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 380, px: [44, 344] as [number, number], py: [36, 250] as [number, number], leg: [[16, 330], [16, 354]] },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => {
    const sx = scale([W0, W1], Ly.px), sy = scale([0, YMAX], [Ly.py[1], Ly.py[0]]);
    const clip = `${id}-${Ly.sfx}-clip`;
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
        <defs><clipPath id={clip}><rect x={Ly.px[0]} y={Ly.py[0] - 4} width={Ly.px[1] - Ly.px[0]} height={Ly.py[1] - Ly.py[0] + 4} /></clipPath></defs>
        {[0.5, 1, 1.5, 2, 2.5].map((v) => <path class="f-grid" d={`M ${Ly.px[0]} ${sy(v)} H ${Ly.px[1]}`} />)}
        <path class="f-axis" d={`M ${Ly.px[0]} ${Ly.py[0]} V ${Ly.py[1]} H ${Ly.px[1]}`} />
        {[-1, 0, 1, 2].map((v) => <text class="f-note" x={sx(v)} y={Ly.py[1] + 18} text-anchor="middle">{v}</text>)}
        {[0, 1, 2].map((v) => <text class="f-note" x={Ly.px[0] - 7} y={sy(v) + 5} text-anchor="end">{v}</text>)}
        <text class="f-small f-t-muted" x={(Ly.px[0] + Ly.px[1]) / 2} y={Ly.py[1] + 40} text-anchor="middle">{t.x}</text>
        <g clip-path={`url(#${clip})`}>
          <path class="f-line f-blue" d={polyline(ws.map((w) => [sx(w), sy(Math.min(loss(w), YMAX + 1))]))} />
          <path class="f-line f-red f-dash" d={polyline(ws.map((w) => [sx(w), sy(Math.min(sam(w), YMAX + 1))]))} />
        </g>
        {[sharpAt, flatAt].map((w) => (
          <g>
            <path class="f-line f-amber f-bold" d={`M ${sx(w - rho)} ${sy(sam(w))} H ${sx(w + rho)}`} />
            <circle cx={sx(w)} cy={sy(0)} r="4.5" class="f-solid-blue" />
            <circle cx={sx(w)} cy={sy(sam(w))} r="4.5" class="f-solid-red" />
          </g>
        ))}
        {[[sharpAt, t.sharp], [flatAt, t.flat]].map(([w, label]) => (
          <g>
            <path class="f-thin f-muted f-dot" d={`M ${sx(w as number)} 22 V ${sy(sam(w as number)) - 7}`} />
            <text class="f-small f-halo" x={sx(w as number)} y="16" text-anchor="middle">{label}</text>
          </g>
        ))}
        <path class="f-line f-blue" d={`M ${Ly.leg[0][0]} ${Ly.leg[0][1] - 4} h 26`} />
        <text class="f-small" x={Ly.leg[0][0] + 34} y={Ly.leg[0][1]}>{t.l}</text>
        <path class="f-line f-red f-dash" d={`M ${Ly.leg[1][0]} ${Ly.leg[1][1] - 4} h 26`} />
        <text class="f-small" x={Ly.leg[1][0] + 34} y={Ly.leg[1][1]}>{t.s}</text>
      </svg>
    );
  })}
</Figure>
