---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
const id = 'db-order-model';
const entities = [
  { y: 12, name: ru ? 'Заказ' : 'Order', key: 'order_id' },
  { y: 110, name: ru ? 'Позиция заказа' : 'Order line', key: 'order_id, line_no' },
  { y: 208, name: ru ? 'Товар каталога' : 'Catalog item', key: 'product_id' },
];
---

<Figure id={id}
  title={ru ? 'Кратность связей заказа и товара с позицией' : 'Cardinality at both ends of each relationship'}
  caption={ru
    ? 'Число у конца линии задаёт, сколько объектов с этой стороны может приходиться на один объект с противоположной. Под каждым типом сущности указан его ключ.'
    : 'The label at an end counts how many objects at that end can be linked to one object at the other end. Each entity type shows its key.'}>
  <svg class="fig-compact seq-narrow" viewBox="0 0 324 270" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
    <title id={`${id}-title`}>{ru ? 'Заказ, позиция и товар каталога' : 'Order, order line and catalog item'}</title>
    <desc id={`${id}-desc`}>{ru
      ? 'У заказа и товара может быть от нуля до многих позиций. Каждая позиция относится ровно к одному заказу и ровно к одному товару.'
      : 'An order and a catalog item may each have zero or more order lines. Each line belongs to exactly one order and refers to exactly one catalog item.'}</desc>
    <path class="f-line f-blue" d="M 162 62 V 110 M 162 160 V 208" />
    <text class="f-label f-t-blue" x="174" y="81">1</text>
    <text class="f-label f-t-blue" x="174" y="103">0..*</text>
    <text class="f-label f-t-blue" x="174" y="180">0..*</text>
    <text class="f-label f-t-blue" x="174" y="202">1</text>
    {entities.map(({ y, name, key }) => <>
      <rect x="44" y={y} width="236" height="50" rx="6" style="fill: var(--fig-blue); fill-opacity: 0.10; stroke: var(--fig-blue)" />
      <text class="f-label" x="162" y={y + 20} text-anchor="middle">{name}</text>
      <text class="f-small f-t-muted" x="162" y={y + 39} text-anchor="middle" style="font-family: var(--mono)">{key}</text>
    </>)}
  </svg>
</Figure>
