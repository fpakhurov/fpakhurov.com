---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
const id = 'db-catalog-code';
const lines = ['106 / 1', '106 / 2'];
---

<Figure id={id}
  title={ru ? 'Исправление кода сохраняет ссылки на товар' : 'Correcting the code preserves the item references'}
  caption={ru
    ? 'Обе позиции заказа 106 ссылаются на товар 7. Исправление кода меняет одно значение в каталоге. Ссылки из позиций по-прежнему ведут к той же записи.'
    : 'Both lines of order 106 reference item 7. The correction changes one catalog value. The references from the order lines still reach the same row.'}>
  <svg class="fig-compact seq-narrow" viewBox="0 0 344 184" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
    <title id={`${id}-title`}>{ru ? 'Код меняется, product_id остаётся прежним' : 'The code changes and product_id stays the same'}</title>
    <desc id={`${id}-desc`}>{ru
      ? 'Позиции 106/1 и 106/2 содержат product_id 7. Запись товара 7 меняет catalog_code с TEA50 на TEA-50.'
      : 'Order lines 106/1 and 106/2 contain product_id 7. Catalog item 7 changes its catalog_code from TEA50 to TEA-50.'}</desc>
    <text class="f-label" x="68" y="30" text-anchor="middle">{ru ? 'Позиции' : 'Order lines'}</text>
    <text class="f-label" x="256" y="30" text-anchor="middle">{ru ? 'Каталог' : 'Catalog'}</text>
    {lines.map((line, i) => {
      const y = 45 + i * 69;
      return <>
        <rect x="10" y={y} width="116" height="54" rx="6" style="fill: var(--fig-green); fill-opacity: 0.12" />
        <text class="f-small" x="68" y={y + 20} text-anchor="middle" style="font-family: var(--mono)">{line}</text>
        <text class="f-small f-t-green" x="68" y={y + 41} text-anchor="middle" style="font-family: var(--mono)">product_id 7</text>
        <path class="f-line f-green" d={`M 126 ${y + 27} L 177 ${87 + i * 22}`} marker-end="url(#f-arrow-green)" />
      </>;
    })}
    <rect x="184" y="45" width="146" height="123" rx="6" style="fill: var(--fig-blue); fill-opacity: 0.10" />
    <text class="f-small f-t-green" x="257" y="72" text-anchor="middle" style="font-family: var(--mono)">product_id 7</text>
    <text class="f-small f-t-muted" x="257" y="103" text-anchor="middle" style="font-family: var(--mono)">catalog_code</text>
    <text class="f-small f-t-blue" x="257" y="133" text-anchor="middle" style="font-family: var(--mono)">TEA50 → TEA-50</text>
  </svg>
</Figure>
