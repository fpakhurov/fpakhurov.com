---
import Figure from '../Figure.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Plan and apply as a three-way comparison. The configuration (in Git) says what should exist; the state maps each
// address of the configuration to the ID of a real object; refresh reads those objects through the provider API.
// In this commit the log expiry changes from 30 to 90 days and a queue is added; someone has repointed the DNS record
// by hand (drift); a VM was deleted from the file. The plan: 1 to add, 2 to change, 1 to destroy.
type Tone = 'n' | 'drift' | 'new';
interface Row { text: string; tone: Tone }
const t = ru
  ? {
      title: 'План как сравнение трёх картин: конфигурация, состояние, реальность',
      cfg: 'конфигурация', cfgSub: 'файлы в Git', st: 'состояние', stSub: 'адрес → ID', real: 'реальность', realSub: 'чтение через API',
      cfgRows: ['bucket.logs: expire 90', 'record.www: lb-1', 'queue.jobs (новый)'],
      stRows: ['bucket.logs → 101', 'record.www → 102', 'vm.old → 103'],
      realRows: ['101: expire 30', '102: lb-2 (дрейф)', '103: vm'],
      plan: 'план',
      planRows: ['~ bucket.logs   expire 30 → 90', '~ record.www    lb-2 → lb-1', '+ queue.jobs', '- vm.old'],
      summary: 'добавить 1, изменить 2, удалить 1',
      refresh: 'обновление', apply: 'apply', write: 'новое состояние, serial + 1',
      steps: [
        'чтение конфигурации: что должно существовать',
        'чтение состояния: какой реальный объект стоит за каждым адресом',
        'обновление: каждый объект читается через API провайдера; запись www изменили вручную',
        'сравнение даёт план: + создать, ~ изменить на месте, - удалить',
        'применение (apply) выполняет план вызовами API в порядке зависимостей',
        'новое состояние записывается со следующим номером serial',
      ],
      desc: 'Три колонки: конфигурация, состояние и реальность, по три строки в каждой. В конфигурации срок хранения журналов 90 дней, запись www указывает на lb-1, добавлена очередь jobs. Состояние связывает адреса с ID 101, 102 и 103. В реальности у объекта 101 срок 30 дней, у записи 102 цель lb-2 (дрейф), объект 103 — виртуальная машина, которой нет в конфигурации. Внизу план: изменить bucket.logs и record.www, создать queue.jobs, удалить vm.old; итог: добавить 1, изменить 2, удалить 1. Стрелки показывают обновление, apply и запись нового состояния.',
    }
  : {
      title: 'A plan as a comparison of three pictures: configuration, state, reality',
      cfg: 'configuration', cfgSub: 'files in Git', st: 'state', stSub: 'address → ID', real: 'reality', realSub: 'read through the API',
      cfgRows: ['bucket.logs: expire 90', 'record.www: lb-1', 'queue.jobs (new)'],
      stRows: ['bucket.logs → 101', 'record.www → 102', 'vm.old → 103'],
      realRows: ['101: expire 30', '102: lb-2 (drift)', '103: vm'],
      plan: 'plan',
      planRows: ['~ bucket.logs   expire 30 → 90', '~ record.www    lb-2 → lb-1', '+ queue.jobs', '- vm.old'],
      summary: '1 to add, 2 to change, 1 to destroy',
      refresh: 'refresh', apply: 'apply', write: 'write state, serial + 1',
      steps: [
        'read the configuration: what should exist',
        'read the state: which real object stands behind each address',
        'refresh: read every object through the provider API; the www record was changed by hand',
        'the comparison gives the plan: + create, ~ update in place, - destroy',
        'apply carries out the plan as API calls, in dependency order',
        'the new state is written with the next serial number',
      ],
      desc: 'Three columns, configuration, state and reality, with three rows each. The configuration keeps logs for 90 days, points the www record at lb-1 and adds a jobs queue. The state maps the addresses to IDs 101, 102 and 103. In reality object 101 keeps logs for 30 days, record 102 points at lb-2 (drift), and object 103 is a VM that is no longer in the configuration. Below, the plan: update bucket.logs and record.www, create queue.jobs, destroy vm.old; in total 1 to add, 2 to change, 1 to destroy. Arrows show the refresh, the apply and the writing of the new state.',
    };
// The counts in the summary follow from the plan rows.
const ops = t.planRows.map((r) => r[0]);
const count = (c: string) => ops.filter((o) => o === c).length;
if (count('+') !== 1 || count('~') !== 2 || count('-') !== 1) throw new Error('plan rows and summary disagree');
const tones: Tone[][] = [['n', 'n', 'new'], ['n', 'n', 'n'], ['n', 'drift', 'n']];
const cols: Row[][] = [t.cfgRows, t.stRows, t.realRows].map((rows, c) => rows.map((text, r) => ({ text, tone: tones[c][r] })));
const heads = [[t.cfg, t.cfgSub], [t.st, t.stSub], [t.real, t.realSub]];
const stroke: Record<Tone, string> = { n: 'var(--line)', drift: 'var(--fig-red)', new: 'var(--fig-green)' };
// Label widths: f-small about 6.5 px per character (7.3 in the narrow layout), f-label 7.5 (8.0).
const fits = (s: string, room: number, px: number) => {
  if (s.length * px > room) throw new Error(`"${s}" needs ${Math.round(s.length * px)} px, has ${room}`);
};
// Row and plan texts are monospace: about 7.5 px per character wide, 8.4 narrow.
for (const col of cols) for (const r of col) { fits(r.text, 220 - 16, 7.5); fits(r.text, 312 - 16, 8.4); }
for (const [h, sub] of heads) { fits(h, 220, 7.5); fits(sub, 220, 6.5); fits(h, 312, 8.0); fits(sub, 312, 7.3); }
for (const s of t.planRows) { fits(s, 400 - 32, 7.5); fits(s, 312 - 24, 8.4); }
fits(t.summary, 400 - 32, 6.5); fits(t.summary, 312 - 24, 7.3);
fits(t.write, 372 - 140, 6.5);
fits(t.refresh, 350 - 190, 7.3);
const id = 'plan-diff';
const caption = ru
  ? 'Инструмент держит три картины. Конфигурация говорит, что должно быть (1); состояние помнит, какой реальный объект соответствует каждому адресу (2); обновление читает эти объекты через API (3) и замечает, что запись www изменили вручную. Сравнение даёт план (4): срок хранения меняется на месте, ручная правка откатывается, очередь создаётся, а машина, которую убрали из файла, удаляется: узнать о ней можно только из состояния. Применение (apply) выполняет план (5) и записывает новое состояние (6). Повторный план после этого пуст.'
  : 'The tool keeps three pictures. The configuration says what should exist (1); the state remembers which real object belongs to each address (2); the refresh reads those objects through the API (3) and notices that the www record was changed by hand. The comparison gives the plan (4): the expiry changes in place, the manual edit is reverted, the queue is created, and the machine that was removed from the file is destroyed, which only the state can reveal. Apply carries out the plan (5) and writes the new state (6). A second plan afterwards is empty.';
interface Layout { cls: string; W: number; H: number; colX: number[]; colW: number; headY: number[]; rowY: number[][]; rowH: number; plan: [number, number, number, number] }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 396, colX: [16, 270, 524], colW: 220, headY: [24, 24, 24], rowY: [[56, 100, 144], [56, 100, 144], [56, 100, 144]], rowH: 34, plan: [180, 230, 400, 150] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 742, colX: [24, 24, 24], colW: 312, headY: [22, 196, 400], rowY: [[50, 90, 130], [224, 264, 304], [428, 468, 508]], rowH: 32, plan: [24, 570, 312, 160] },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const wide = L.W === 760;
    const [px, py, pw, ph] = L.plan;
    const rowMid = (c: number, r: number) => L.rowY[c][r] + L.rowH / 2;
    const colBottom = (c: number) => L.rowY[c][2] + L.rowH;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        {cols.map((rows, c) => (
          <g data-s={String(c + 1)}>
            <text class="f-label" x={L.colX[c]} y={L.headY[c]} style="font-weight: 650">{heads[c][0]}</text>
            <text class="f-small f-t-muted" x={L.colX[c]} y={L.headY[c] + 18}>{heads[c][1]}</text>
            {rows.map((r, i) => (
              <g>
                <rect x={L.colX[c]} y={L.rowY[c][i]} width={L.colW} height={L.rowH} rx="6" style={`fill: var(--paper-strong); stroke: ${stroke[r.tone]}; stroke-width: ${r.tone === 'n' ? 1.2 : 2}`} />
                <text class="f-small" x={L.colX[c] + 10} y={L.rowY[c][i] + L.rowH / 2 + 4.5} font-family="var(--mono)">{r.text}</text>
              </g>
            ))}
            {c !== 2 && <Badge x={L.colX[c] + L.colW} y={L.headY[c] - 6} n={c + 1} />}
          </g>
        ))}
        <g data-s="3">
          {wide
            ? [0, 1, 2].map((r) => <Arrow pts={[[492, rowMid(1, r)], [522, rowMid(2, r)]]} tone="amber" dashed />)
            : <Arrow pts={[[180, colBottom(1) + 2], [180, L.headY[2] - 18]]} tone="amber" dashed />}
          {!wide && <text class="f-small f-t-amber f-halo" x="190" y={(colBottom(1) + L.headY[2]) / 2 - 2}>{t.refresh}</text>}
          {wide && <text class="f-small f-t-amber f-halo" x="507" y="212" text-anchor="middle">{t.refresh}</text>}
          <Badge x={L.colX[2] + L.colW} y={L.headY[2] - 6} n={3} />
        </g>
        <g data-s="4">
          <rect x={px} y={py} width={pw} height={ph} rx="8" style="fill: var(--fig-blue); fill-opacity: 0.08; stroke: var(--fig-blue); stroke-width: 1.4" />
          <text class="f-label" x={px + 16} y={py + 24} style="font-weight: 650">{t.plan}</text>
          {t.planRows.map((row, i) => (
            <text class={`f-small ${row[0] === '+' ? 'f-t-green' : row[0] === '-' ? 'f-t-red' : 'f-t-amber'}`} x={px + 16} y={py + 48 + i * 22} font-family="var(--mono)">{row}</text>
          ))}
          <text class="f-small" x={px + 16} y={py + 48 + 4 * 22 + 4} style="font-weight: 650">{t.summary}</text>
          {wide
            ? <>
                <Arrow pts={[[126, colBottom(0) + 2], [126, 250], [px - 2, 250]]} />
                <Arrow pts={[[634, colBottom(2) + 2], [634, 250], [px + pw + 2, 250]]} />
              </>
            : <>
                <Arrow pts={[[338, 106], [348, 106], [348, 650], [338, 650]]} />
                <Arrow pts={[[100, colBottom(2) + 2], [100, py - 2]]} />
              </>}
          <Badge x={px + pw} y={py} n={4} />
        </g>
        <g data-s="5">
          {wide
            ? <>
                <Arrow pts={[[px + pw + 2, 330], [700, 330], [700, colBottom(2) + 2]]} tone="green" bold />
                <text class="f-small f-t-green f-halo" x="694" y="352" text-anchor="end">{t.apply}</text>
                <Badge x={712} y={352} n={5} />
              </>
            : <>
                <Arrow pts={[[260, py - 2], [260, colBottom(2) + 2]]} tone="green" bold />
                <text class="f-small f-t-green f-halo" x="252" y={py - 10} text-anchor="end">{t.apply}</text>
                <Badge x={284} y={py - 14} n={5} />
              </>}
        </g>
        <g data-s="6">
          {wide
            ? <>
                <Arrow pts={[[380, py - 2], [380, colBottom(1) + 2]]} tone="blue" />
                <text class="f-small f-t-blue f-halo" x="372" y="210" text-anchor="end">{t.write}</text>
                <Badge x={394} y={205} n={6} />
              </>
            : <>
                <Arrow pts={[[22, 690], [10, 690], [10, rowMid(1, 1)], [22, rowMid(1, 1)]]} tone="blue" />
                <Badge x={10} y={712} n={6} />
              </>}
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
