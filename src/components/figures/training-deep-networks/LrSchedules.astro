---
import Figure from '../Figure.astro';
import { scale, plot } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Three learning-rate schedules over T = 100 epochs, as fractions of the peak rate η_max:
// step decay (×0.1 at epochs 50 and 75); linear warm-up for 5 epochs followed by cosine decay to zero;
// the Transformer's inverse square root with warm-up w = 10, η ∝ min(t / w, √(w / t)).
const T = 100, warm = 5, w = 10;
const step = (t: number) => (t < 50 ? 1 : t < 75 ? 0.1 : 0.01);
const cosine = (t: number) => (t < warm ? t / warm : 0.5 * (1 + Math.cos((Math.PI * (t - warm)) / (T - warm))));
const invsqrt = (t: number) => Math.min(t / w, Math.sqrt(w / Math.max(t, 1e-9)));
const quoted = [cosine(2.5), cosine(52.5), cosine(100), invsqrt(40), invsqrt(100)].map((v) => v.toFixed(3)).join();
if (quoted !== '0.500,0.500,0.000,0.500,0.316') throw new Error(`LrSchedules: values drifted from the note (${quoted})`);
const curves = [
  { f: step, tone: 'red', dash: false, label: ru ? 'ступенчатое: ×0.1 на 50 и 75' : 'step decay: ×0.1 at 50 and 75' },
  { f: cosine, tone: 'blue', dash: false, label: ru ? 'разогрев 5 эпох + косинус' : 'warm-up for 5 epochs + cosine' },
  { f: invsqrt, tone: 'green', dash: true, label: ru ? 'разогрев 10 + 1/√t' : 'warm-up for 10 + 1/√t' },
];
const id = 'lr-schedules';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 300, x0: 50, x1: 350, y0: 20, y1: 240, lx: 372, ly: [60, 100, 140], ldy: 0 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 380, x0: 44, x1: 340, y0: 20, y1: 240, lx: 16, ly: [300, 324, 348], ldy: 0 },
];
---

<Figure
  id={id}
  title={ru ? 'Три расписания шага обучения' : 'Three learning-rate schedules'}
  caption={ru
    ? 'Доля от максимального шага ηₘₐₓ за 100 эпох. Ступенчатое расписание делит шаг на 10 на 50-й и 75-й эпохах. Косинусное после линейного разогрева за 5 эпох плавно спускается до нуля и проходит половину пути на 52.5-й эпохе. Расписание Transformer растёт линейно 10 эпох, затем убывает как 1/√t: 0.5 на 40-й эпохе и 0.316 на 100-й.'
    : 'Fraction of the peak rate ηₘₐₓ over 100 epochs. Step decay divides the rate by 10 at epochs 50 and 75. The cosine schedule, after a linear warm-up of 5 epochs, glides to zero and is halfway down at epoch 52.5. The Transformer schedule grows linearly for 10 epochs and then decays like 1/√t: 0.5 at epoch 40 and 0.316 at epoch 100.'}
>
  {layouts.map((L) => {
    const sx = scale([0, T], [L.x0, L.x1]), sy = scale([0, 1.05], [L.y1, L.y0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Расписания шага обучения' : 'Learning-rate schedules'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Красная ступенчатая линия, синяя косинусная кривая с коротким линейным подъёмом и зелёная пунктирная кривая с подъёмом и медленным спадом.' : 'A red staircase, a blue cosine curve with a short linear ramp, and a green dashed curve with a ramp and a slow decay.'}</desc>
        {[0, 0.5, 1].map((v) => <g><path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} /><text class="f-note" x={L.x0 - 8} y={sy(v) + 5} text-anchor="end">{v}</text></g>)}
        {[0, 25, 50, 75, 100].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{v}</text>)}
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 38} text-anchor="middle">{ru ? 'эпоха t' : 'epoch t'}</text>
        <text class="f-small f-t-muted" x={L.x0} y={L.y0 - 6}>η / ηₘₐₓ</text>
        {curves.map((c) => <path class={`f-line f-${c.tone}${c.dash ? ' f-dash' : ''}`} d={plot(c.f, 0, T, sx, sy, 400)} />)}
        {curves.map((c, i) => (
          <g>
            <path class={`f-line f-${c.tone}${c.dash ? ' f-dash' : ''}`} d={`M ${L.lx} ${L.ly[i]} h 22`} />
            <text class="f-small" x={L.lx + 30} y={L.ly[i] + 5}>{c.label}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
