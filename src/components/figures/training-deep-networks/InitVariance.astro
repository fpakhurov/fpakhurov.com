---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { mulberry32, normal } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A plain stack of 30 layers of width 128 without biases, z_l = W_l h_{l−1}, applied to 32 standard normal inputs.
// The weights are N(0, v) with v = 1/n, 2/n or 4/n before a ReLU, and v = 1/n before a tanh; the same random
// matrices (up to the scale √v) are used in every configuration. The plot shows the mean square of the
// pre-activations z_l, layer by layer, against the theory Var z_l = n v · (n v / 2)^(l−1) for the ReLU stacks.
const n = 128, B = 32, depth = 30;
const z = normal(mulberry32(11));
const X = Array.from({ length: B }, () => Float64Array.from({ length: n }, () => z()));
const Ws = Array.from({ length: depth }, () => Float64Array.from({ length: n * n }, () => z()));
const run = (v: number, act: (t: number) => number) => {
  const s = Math.sqrt(v);
  let H = X.map((r) => Float64Array.from(r));
  const q: number[] = [];
  for (let l = 0; l < depth; l += 1) {
    const W = Ws[l];
    let sq = 0;
    const next = H.map((h) => {
      const out = new Float64Array(n);
      for (let i = 0; i < n; i += 1) {
        let acc = 0;
        const row = i * n;
        for (let j = 0; j < n; j += 1) acc += W[row + j] * h[j];
        acc *= s;
        sq += acc * acc;
        out[i] = act(acc);
      }
      return out;
    });
    q.push(sq / (B * n));
    H = next;
  }
  return q;
};
const relu = (t: number) => (t > 0 ? t : 0);
const configs = [
  { key: 'he', v: 2 / n, act: relu, tone: 'blue' },
  { key: 'glorot', v: 1 / n, act: relu, tone: 'red' },
  { key: 'big', v: 4 / n, act: relu, tone: 'amber' },
  { key: 'tanh', v: 1 / n, act: Math.tanh, tone: 'green' },
].map((c) => ({ ...c, q: run(c.v, c.act) }));
const last = configs.map((c) => c.q[depth - 1].toPrecision(2));
if (last.join() !== '4.0,3.7e-9,4.3e+9,0.014') throw new Error(`InitVariance: simulated values drifted from the note (${last.join()})`);
const theory = (v: number, l: number) => n * v * (n * v / 2) ** (l - 1);
const th = [theory(2 / n, 30), theory(1 / n, 30), theory(4 / n, 30)].map((v) => v.toPrecision(2));
if (th.join() !== '2.0,1.9e-9,2.1e+9') throw new Error('InitVariance: theory values drifted from the note');
const sci = (s: string) => s.replace(/e\+?(-?)(\d+)/, (_, m, d) => `·10${m ? '⁻' : ''}${d.replace(/\d/g, (c: string) => '⁰¹²³⁴⁵⁶⁷⁸⁹'[+c])}`);
const t = ru
  ? { x: 'слой l', y: 'средний квадрат z_l', lab: { he: 'ReLU, 2/n (He)', glorot: 'ReLU, 1/n (Glorot)', big: 'ReLU, 4/n', tanh: 'tanh, 1/n' } as Record<string, string>, theory: 'теория' }
  : { x: 'layer l', y: 'mean square of z_l', lab: { he: 'ReLU, 2/n (He)', glorot: 'ReLU, 1/n (Glorot)', big: 'ReLU, 4/n', tanh: 'tanh, 1/n' } as Record<string, string>, theory: 'theory' };
const id = 'init-variance';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 620, H: 330, x0: 64, x1: 450, y0: 16, y1: 280, lx: 458 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 400, x0: 52, x1: 340, y0: 16, y1: 280, lx: 0 },
];
const ticks: [number, string][] = [[-10, '10⁻¹⁰'], [-5, '10⁻⁵'], [0, '1'], [5, '10⁵'], [10, '10¹⁰']];
const labelY: Record<string, number> = { he: 0.3, glorot: -9.2, big: 9.3, tanh: -1.6 };
---

<Figure
  id={id}
  title={ru ? 'Масштаб сигнала в глубокой сети при разной инициализации' : 'The scale of the signal in a deep network under different initializations'}
  caption={ru
    ? `30 слоёв ширины n = 128 без смещений, 32 входа из N(0, 1); веса из N(0, v). Точки — средний квадрат предактиваций zₗ в симуляции, пунктир — теория Var zₗ = nv·(nv/2)^(l−1) для ReLU (логарифмическая шкала). С дисперсией He v = 2/n сигнал сохраняет масштаб (${sci(last[0])} на 30-м слое, теория ${th[0]}); с v = 1/n каждый слой ReLU делит его на 2 (${sci(last[1])}, теория ${sci(th[1])}); с v = 4/n удваивает (${sci(last[2])}, теория ${sci(th[2])}). Симуляция отличается от теории примерно вдвое: случайные веса каждого слоя чуть меняют его коэффициент усиления, и за 30 слоёв эти отклонения перемножаются. Для tanh дисперсия Глоро v = 1/n не даёт геометрического затухания: средний квадрат падает медленно, до ${last[3]}.`
    : `30 layers of width n = 128 without biases, 32 inputs from N(0, 1); weights from N(0, v). Dots: the mean square of the pre-activations zₗ in the simulation; dashed: the theory Var zₗ = nv·(nv/2)^(l−1) for ReLU (log scale). With the He variance v = 2/n the signal keeps its scale (${sci(last[0])} at layer 30, theory ${th[0]}); with v = 1/n every ReLU layer halves it (${sci(last[1])}, theory ${sci(th[1])}); with v = 4/n every layer doubles it (${sci(last[2])}, theory ${sci(th[2])}). The simulation is off the theory by about a factor of 2: the random weights of each layer change its gain slightly, and over 30 layers these deviations multiply. For tanh the Glorot variance v = 1/n avoids the geometric decay: the mean square falls only slowly, to ${last[3]}.`}
>
  {layouts.map((L) => {
    const sx = scale([1, 30], [L.x0, L.x1]), sy = scale([-11, 11], [L.y1, L.y0]);
    const wide = L.cls.startsWith('fig-wide');
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Средний квадрат предактиваций по слоям' : 'Mean square of the pre-activations by layer'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Логарифмическая шкала: синяя линия He горизонтальна, красная (1/n) падает прямой вниз, жёлтая (4/n) растёт прямой вверх, зелёная tanh медленно опускается.' : 'Log scale: the blue He line is flat, the red one (1/n) falls along a straight line, the amber one (4/n) rises along a straight line, the green tanh curve sinks slowly.'}</desc>
        {ticks.map(([v, label]) => <g><path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} /><text class="f-note" x={L.x0 - 8} y={sy(v) + 5} text-anchor="end">{label}</text></g>)}
        {[1, 10, 20, 30].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{v}</text>)}
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 38} text-anchor="middle">{t.x}</text>
        {configs.filter((c) => c.key !== 'tanh').map((c) => <path class={`f-thin f-${c.tone} f-dash`} d={`M ${sx(1)} ${sy(Math.log10(theory(c.v, 1)))} L ${sx(30)} ${sy(Math.log10(theory(c.v, 30)))}`} />)}
        {configs.map((c) => (
          <g>
            <path class={`f-line f-${c.tone}`} d={polyline(c.q.map((q, l) => [sx(l + 1), sy(Math.log10(q))]))} />
            {c.q.map((q, l) => <circle cx={sx(l + 1).toFixed(1)} cy={sy(Math.log10(q)).toFixed(1)} r="2.2" class={`f-solid-${c.tone === 'amber' ? 'muted' : c.tone}`} style={c.tone === 'amber' ? 'fill: var(--fig-amber)' : undefined} />)}
          </g>
        ))}
        {wide
          ? configs.map((c) => <text class={`f-small f-t-${c.tone}`} x={L.lx} y={sy(labelY[c.key]) + 4}>{t.lab[c.key]}</text>)
          : configs.map((c, i) => (
              <g>
                <path class={`f-line f-${c.tone}`} d={`M ${16 + (i % 2) * 172} ${L.y1 + 62 + Math.floor(i / 2) * 24} h 20`} />
                <text class="f-small" x={42 + (i % 2) * 172} y={L.y1 + 67 + Math.floor(i / 2) * 24}>{t.lab[c.key]}</text>
              </g>
            ))}
        <path class="f-thin f-muted f-dash" d={`M ${wide ? L.lx : 16} ${wide ? L.y1 + 30 : L.y1 + 110} h 20`} />
        <text class="f-small f-t-muted" x={(wide ? L.lx : 16) + 26} y={(wide ? L.y1 + 34 : L.y1 + 114)}>{t.theory}</text>
      </svg>
    );
  })}
</Figure>
