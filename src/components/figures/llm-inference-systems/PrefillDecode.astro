---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A prompt of four tokens p1..p4 and three generated tokens y1..y3. Prefill runs one pass over p1..p4 and writes
// their keys and values into the cache; it yields y1. Each decode step takes the newest token, reads every cached
// column, appends its own, and yields the next token. Colours follow the seqflow kit: inputs green, state (the cache)
// blue, the model amber, outputs red.
const PROMPT = 4, GEN = 3, COLS = PROMPT + GEN;
const tokens = [...Array(PROMPT)].map((_, i) => `p${i + 1}`).concat([...Array(GEN)].map((_, i) => `y${i + 1}`));
// Decode steps: the step under column c reads columns 0..c-1 and writes column c.
const decodeCols = [PROMPT, PROMPT + 1];
if (decodeCols.length !== GEN - 1) throw new Error('one decode step per generated token after the first');
// Cache columns after each phase: prefill writes PROMPT, each decode step one more.
const cacheAfter = [PROMPT, PROMPT + 1, PROMPT + 2];
if (cacheAfter[cacheAfter.length - 1] !== COLS - 1) throw new Error('the last token has no cache column yet');
// The three outputs: y1 from prefill, y2 and y3 from the decode steps under y1 and y2; the fan of cache reads is drawn for the first step.
const outputs = [0, 1, 2].map((k) => ({ k, out: PROMPT + k, decode: k !== 0, fan: k === 1 }));
if (outputs.filter((o) => o.decode).map((o) => o.out - 1).join() !== decodeCols.join()) throw new Error('decode steps');

const t = ru
  ? { title: 'Префилл и декодирование с KV-кэшем', tok: 'токены', model: 'модель', cache: 'KV-кэш', pre: 'префилл', preSub: 'один проход по 4 токенам, ограничен вычислениями', preSubN: 'один проход, 4 токена', step: (k: number) => `шаг ${k}`, stepN: 'шаг', kv: 'k, v',
      grow: 'кэш растёт на один столбец за каждый токен', growN: 'KV-кэш: столбец на токен', read: 'читает весь кэш',
      steps: ['промпт из 4 токенов поступает целиком', 'префилл: один проход по всем токенам промпта; их ключи и значения записываются в кэш', 'выход последней позиции даёт первый токен ответа y1', 'шаг декодирования: только y1; его запрос читает весь кэш, его k, v дописываются, выход — y2', 'то же для y2: ещё один столбец кэша и токен y3; и так до конца ответа'],
      desc: 'Сверху ряд из семи токенов: четыре зелёных токена промпта p1–p4 и три красных порождённых y1–y3. Под токенами промпта — один широкий блок префилла, под y1 и y2 — узкие блоки шагов декодирования. Внизу ряд столбцов KV-кэша: префилл записывает четыре столбца, каждый шаг — ещё один. От блока префилла стрелка ведёт к y1, от шагов — к y2 и y3; к первому шагу сходятся пунктирные линии от всех столбцов кэша.' }
  : { title: 'Prefill and decode with the KV cache', tok: 'tokens', model: 'model', cache: 'KV cache', pre: 'prefill', preSub: 'one pass over 4 tokens, compute-bound', preSubN: 'one pass, 4 tokens', step: (k: number) => `step ${k}`, stepN: 'step', kv: 'k, v',
      grow: 'the cache grows by one column per token', growN: 'KV cache: one column per token', read: 'reads the whole cache',
      steps: ['the prompt of 4 tokens arrives all at once', 'prefill: one pass over every prompt token; their keys and values are written to the cache', 'the output at the last position gives the first generated token, y1', 'a decode step: only y1; its query reads the whole cache, its k, v are appended, and out comes y2', 'the same for y2: one more cache column and the token y3; and so on to the end of the answer'],
      desc: 'At the top a row of seven tokens: four green prompt tokens p1 to p4 and three red generated tokens y1 to y3. Under the prompt tokens one wide prefill block; under y1 and y2 narrow decode-step blocks. At the bottom a row of KV-cache columns: prefill writes four of them, each step one more. An arrow leads from the prefill block to y1 and from the steps to y2 and y3; dashed lines from every cache column converge on the first step.' };

interface Layout { cls: string; W: number; H: number; x0: number; pitch: number; colW: number; tokY: number; tokH: number; modY: number; modH: number; cacheY: number; cacheH: number; sans: number; label: number; wide: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 296, x0: 96, pitch: 94, colW: 72, tokY: 48, tokH: 30, modY: 120, modH: 50, cacheY: 222, cacheH: 30, sans: 6.5, label: 7.5, wide: true },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 300, x0: 14, pitch: 48, colW: 42, tokY: 34, tokH: 30, modY: 104, modH: 48, cacheY: 214, cacheH: 30, sans: 7.3, label: 8.0, wide: false },
];
const fits = (s: string, room: number, px: number, what: string) => {
  if (s.length * px > room) throw new Error(`${what}: "${s}" needs ${(s.length * px).toFixed(0)} px, has ${room.toFixed(0)}`);
};
for (const L of layouts) {
  const colX = (i: number) => L.x0 + i * L.pitch;
  if (colX(COLS - 1) + L.colW > L.W - 4) throw new Error(`columns leave the figure at ${L.W}`);
  const preW = colX(PROMPT - 1) + L.colW - colX(0);
  fits(t.pre, preW - 8, L.label, 'prefill label');
  fits(L.wide ? t.preSub : t.preSubN, preW - 8, L.sans, 'prefill sub');
  fits(L.wide ? t.step(GEN - 1) : t.stepN, L.colW - 6, L.label, 'step label');
  fits(t.kv, L.colW - 4, L.sans, 'cache cell');
  if (L.wide) {
    for (const s of [t.tok, t.model, t.cache]) fits(s, L.x0 - 14, L.sans, 'row label');
    fits(t.grow, L.W - L.x0 - 4, L.sans, 'wide note');
    fits(t.read, colX(PROMPT) - colX(1), L.sans, 'read label');
  } else fits(t.growN, L.W - 2 * L.x0, L.sans, 'narrow note');
}
const id = 'prefill-decode';
const caption = ru
  ? 'Промпт из четырёх токенов (1) проходит через модель одним проходом префилла (2): все позиции обрабатываются параллельно, поэтому арифметики на байт прочитанных весов много, и фаза ограничена вычислениями; ключи и значения всех позиций записываются в KV-кэш. Выход последней позиции даёт первый токен ответа (3). Дальше каждый шаг декодирования обрабатывает один новый токен (4, 5): его запрос читает весь кэш, его собственные ключ и значение дописываются в конец. Шаг читает все веса ради одного токена последовательности, поэтому декодирование ограничено пропускной способностью памяти.'
  : 'A prompt of four tokens (1) passes through the model in one prefill pass (2): every position is processed in parallel, so there is much arithmetic per byte of weights read, and the phase is limited by compute; the keys and values of every position are written to the KV cache. The output at the last position gives the first generated token (3). From then on, each decode step processes one new token (4, 5): its query reads the whole cache, and its own key and value are appended. A step reads every weight for one token of the sequence, so decode is limited by memory bandwidth.';
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const colX = (i: number) => L.x0 + i * L.pitch;
    const cx = (i: number) => colX(i) + L.colW / 2;
    const preR = colX(PROMPT - 1) + L.colW;
    const tokB = L.tokY + L.tokH, modB = L.modY + L.modH;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        {L.wide && <g>
          <text class="f-small f-t-muted" x={8} y={L.tokY + L.tokH / 2 + 4}>{t.tok}</text>
          <text class="f-small f-t-muted" x={8} y={L.modY + L.modH / 2 + 4}>{t.model}</text>
          <text class="f-small f-t-muted" x={8} y={L.cacheY + L.cacheH / 2 + 4}>{t.cache}</text>
          <text class="f-small f-t-muted" x={L.x0} y={L.cacheY + L.cacheH + 26}>{t.grow}</text>
        </g>}
        {!L.wide && <text class="f-small f-t-muted" x={L.x0} y={L.cacheY + L.cacheH + 24}>{t.growN}</text>}
        <g data-s="1">
          {tokens.slice(0, PROMPT).map((s, i) => (
            <g>
              <rect x={colX(i)} y={L.tokY} width={L.colW} height={L.tokH} rx="5" style={`fill: ${toneVar.x}; fill-opacity: 0.16; stroke: ${toneVar.x}; stroke-width: 1.3`} />
              <text class="f-small" x={cx(i)} y={L.tokY + L.tokH / 2 + 5} text-anchor="middle">{s}</text>
            </g>
          ))}
          <Badge x={colX(0) + 8} y={L.tokY - 12} n={1} />
        </g>
        <g data-s="2">
          {tokens.slice(0, PROMPT).map((_, i) => <path class="f-line" d={`M ${cx(i)} ${tokB + 2} V ${L.modY - 2}`} marker-end="url(#f-arrow)" />)}
          <rect x={colX(0)} y={L.modY} width={preR - colX(0)} height={L.modH} rx="7" style={`fill: ${toneVar.g}; fill-opacity: 0.14; stroke: ${toneVar.g}; stroke-width: 1.3`} />
          <text class="f-label" x={(colX(0) + preR) / 2} y={L.modY + L.modH / 2 - 2} text-anchor="middle">{t.pre}</text>
          <text class="f-small f-t-muted" x={(colX(0) + preR) / 2} y={L.modY + L.modH / 2 + 15} text-anchor="middle">{L.wide ? t.preSub : t.preSubN}</text>
          {tokens.slice(0, PROMPT).map((_, i) => <path class="f-line f-blue" d={`M ${cx(i)} ${modB + 2} V ${L.cacheY - 2}`} marker-end="url(#f-arrow-blue)" />)}
          {[...Array(cacheAfter[0])].map((_, i) => (
            <g>
              <rect x={colX(i)} y={L.cacheY} width={L.colW} height={L.cacheH} rx="3" style={`fill: ${toneVar.h}; fill-opacity: 0.16; stroke: ${toneVar.h}; stroke-width: 1.2`} />
              <text class="f-small f-t-blue" x={cx(i)} y={L.cacheY + L.cacheH / 2 + 5} text-anchor="middle">{t.kv}</text>
            </g>
          ))}
          <Badge x={colX(0) + 2} y={L.modY + 2} n={2} />
        </g>
        {outputs.map(({ k, out, decode, fan }) => {
          const fromX = decode ? colX(out - 1) + L.colW - 6 : preR - 6;
          return (
            <g data-s={String(3 + k)}>
              {decode && <g>
                <path class="f-line" d={`M ${cx(out - 1) + 8} ${tokB + 2} V ${L.modY - 2}`} marker-end="url(#f-arrow)" />
                <rect x={colX(out - 1)} y={L.modY} width={L.colW} height={L.modH} rx="7" style={`fill: ${toneVar.g}; fill-opacity: 0.14; stroke: ${toneVar.g}; stroke-width: 1.3`} />
                <text class="f-label" x={cx(out - 1)} y={L.modY + L.modH / 2 + 5} text-anchor="middle">{L.wide ? t.step(k) : t.stepN}</text>
                <path class="f-line f-blue" d={`M ${cx(out - 1)} ${modB + 2} V ${L.cacheY - 2}`} marker-end="url(#f-arrow-blue)" />
                <rect x={colX(out - 1)} y={L.cacheY} width={L.colW} height={L.cacheH} rx="3" style={`fill: ${toneVar.h}; fill-opacity: 0.16; stroke: ${toneVar.g}; stroke-width: 1.8`} />
                <text class="f-small f-t-blue" x={cx(out - 1)} y={L.cacheY + L.cacheH / 2 + 5} text-anchor="middle">{t.kv}</text>
              </g>}
              {fan && <g>
                {[...Array(PROMPT)].map((_, i) => <path class="f-line f-amber f-dash" d={`M ${cx(i) + 12} ${L.cacheY - 1} L ${cx(out - 1) - 10} ${modB + 3}`} />)}
                {L.wide && <text class="f-small f-t-amber f-halo" x={colX(1) + 4} y={L.cacheY - 8}>{t.read}</text>}
              </g>}
              <path class="f-line f-red" d={`M ${fromX} ${L.modY - 1} L ${colX(out) + 10} ${tokB + 3}`} marker-end="url(#f-arrow-red)" />
              <rect x={colX(out)} y={L.tokY} width={L.colW} height={L.tokH} rx="5" style={`fill: ${toneVar.y}; fill-opacity: 0.16; stroke: ${toneVar.y}; stroke-width: 1.3`} />
              <text class="f-small" x={cx(out)} y={L.tokY + L.tokH / 2 + 5} text-anchor="middle">{tokens[out]}</text>
              <Badge x={colX(out) + 8} y={L.tokY - 12} n={3 + k} />
            </g>
          );
        })}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
