---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Six requests, all waiting at step 0, that need these numbers of decode steps; three slots.
// Static: batches of three in queue order, each running until its longest request ends.
// Continuous: a request takes the first slot that frees (lowest slot on ties) at the step it frees.
const LEN = [2, 9, 3, 4, 2, 5];
const SLOTS = 3;
interface Run { r: number; slot: number; start: number; end: number }
const staticRuns: Run[] = [];
const idle: { slot: number; start: number; end: number }[] = [];
let t0 = 0;
for (let b = 0; b < LEN.length; b += SLOTS) {
  const group = LEN.slice(b, b + SLOTS);
  const dur = Math.max(...group);
  group.forEach((len, j) => {
    staticRuns.push({ r: b + j, slot: j, start: t0, end: t0 + len });
    if (len !== dur) idle.push({ slot: j, start: t0 + len, end: t0 + dur });
  });
  t0 += dur;
}
const staticEnd = t0;
const free = Array(SLOTS).fill(0);
const contRuns: Run[] = LEN.map((len, r) => {
  let slot = 0;
  for (let j = 1; j < SLOTS; j++) if (free[j] < free[slot]) slot = j;
  const run = { r, slot, start: free[slot], end: free[slot] + len };
  free[slot] = run.end;
  return run;
});
const contEnd = Math.max(...contRuns.map((x) => x.end));
const tokens = LEN.reduce((a, b) => a + b, 0);
const meanEnd = (runs: Run[]) => runs.reduce((a, x) => a + x.end, 0) / runs.length;
const busy = (end: number) => Math.round((100 * tokens) / (SLOTS * end));
if (staticEnd !== 14 || contEnd !== 10 || tokens !== 25) throw new Error(`steps ${staticEnd}, ${contEnd}, tokens ${tokens}`);
if (meanEnd(staticRuns).toFixed(1) !== '8.7' || meanEnd(contRuns).toFixed(1) !== '5.8') throw new Error('mean finishing step');
if (busy(staticEnd) !== 60 || busy(contEnd) !== 83) throw new Error('slot occupancy');
const T = staticEnd;
// The first three requests are drawn lighter than the three that waited in the queue.
const shade = (r: number) => (r < SLOTS ? 0.22 : 0.4);

const t = ru
  ? { title: 'Статическое и непрерывное батчирование: три слота, шесть запросов', s: 'статическое батчирование', c: 'непрерывное батчирование', slot: (j: number) => `слот ${j + 1}`, idle: 'простой', axis: 'шаг декодирования',
      sum: (n: number, b: number, m: number) => `${n} шагов; слоты заняты на ${b}%; в среднем запрос готов к шагу ${m.toFixed(1)}`, sumN: (n: number, b: number) => `${n} шагов · ${b}%`,
      steps: [`статическое: батч работает, пока не закончится самый длинный запрос (${Math.max(...LEN.slice(0, 3))} шагов); слоты коротких простаивают, второй батч ждёт`, 'непрерывное: закончившийся запрос уходит сразу, следующий из очереди занимает его слот на следующем шаге', `те же ${tokens} токенов: ${staticEnd} шагов против ${contEnd}, в среднем запрос готов к шагу ${meanEnd(staticRuns).toFixed(1)} против ${meanEnd(contRuns).toFixed(1)}`],
      desc: `Две временные диаграммы по три строки-слота на общей оси шагов от 0 до ${T}. Шесть запросов требуют ${LEN.join(', ')} шагов. При статическом батчировании первый батч занимает шаги 0–9, с простоями после r1 и r3, второй — шаги 9–14. При непрерывном r4 начинается на шаге 2 в слоте r1, r5 — на шаге 3 в слоте r3, r6 — на шаге 5, и всё заканчивается к шагу ${contEnd}.` }
  : { title: 'Static and continuous batching: three slots, six requests', s: 'static batching', c: 'continuous batching', slot: (j: number) => `slot ${j + 1}`, idle: 'idle', axis: 'decode step',
      sum: (n: number, b: number, m: number) => `${n} steps; slots busy ${b}%; mean finishing step ${m.toFixed(1)}`, sumN: (n: number, b: number) => `${n} steps · ${b}%`,
      steps: [`static: a batch runs until its longest request is done (${Math.max(...LEN.slice(0, 3))} steps); the slots of the short ones sit idle, and the second batch waits`, 'continuous: a finished request leaves at once, and the next one in the queue takes its slot at the following step', `the same ${tokens} tokens: ${staticEnd} steps against ${contEnd}, and the mean finishing step ${meanEnd(staticRuns).toFixed(1)} against ${meanEnd(contRuns).toFixed(1)}`],
      desc: `Two timelines of three slot rows each on a shared axis of steps from 0 to ${T}. Six requests need ${LEN.join(', ')} steps. With static batching, the first batch occupies steps 0 to 9, with idle time after r1 and r3, and the second steps 9 to 14. With continuous batching, r4 starts at step 2 in the slot of r1, r5 at step 3 in the slot of r3, r6 at step 5, and everything ends by step ${contEnd}.` };

interface Layout { cls: string; W: number; H: number; x0: number; x1: number; p1: number; p2: number; pitch: number; barH: number; axisY: number; sans: number; wide: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 300, x0: 150, x1: 740, p1: 30, p2: 146, pitch: 26, barH: 20, axisY: 252, sans: 6.5, wide: true },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 316, x0: 62, x1: 350, p1: 30, p2: 154, pitch: 28, barH: 22, axisY: 268, sans: 7.3, wide: false },
];
const geo = layouts.map((L) => {
  const sx = (v: number) => L.x0 + (v / T) * (L.x1 - L.x0);
  const room = (a: number, b: number) => sx(b) - sx(a) - 6;
  for (const run of [...staticRuns, ...contRuns]) if (`r${run.r + 1}`.length * L.sans > room(run.start, run.end)) throw new Error(`bar label r${run.r + 1} at ${L.W}`);
  const idleLabels = idle.map((g) => t.idle.length * L.sans <= room(g.start, g.end));
  for (let j = 0; j < SLOTS; j++) if (t.slot(j).length * L.sans > L.x0 - 14) throw new Error(`slot label at ${L.W}`);
  const sums = [[staticEnd, meanEnd(staticRuns)], [contEnd, meanEnd(contRuns)]].map(([n, m]) => (L.wide ? t.sum(n, busy(n), m) : t.sumN(n, busy(n))));
  [t.s, t.c].forEach((title, i) => {
    const titleEnd = 12 + 22 + title.length * L.sans, sumStart = L.x1 - sums[i].length * L.sans;
    if (titleEnd > sumStart - 10) throw new Error(`panel ${i} title meets its summary at ${L.W}`);
  });
  return { sx, idleLabels, sums };
});
const id = 'continuous-batching';
const caption = ru
  ? `Три слота батча и шесть запросов, которым нужно ${LEN.join(', ')} шагов декодирования; все ждут в очереди с шага 0. Статическое батчирование (1) запускает батч из трёх запросов и держит его, пока не закончится самый длинный: слоты r1 и r3 простаивают, а r4–r6 ждут до шага 9. Непрерывное батчирование (2) решает после каждого шага: закончившийся запрос освобождает слот, и следующий в очереди занимает его. Те же ${tokens} токенов занимают ${staticEnd} шагов в первом случае и ${contEnd} во втором (3); префилл для простоты не показан.`
  : `Three batch slots and six requests that need ${LEN.join(', ')} decode steps, all waiting in the queue from step 0. Static batching (1) starts a batch of three and keeps it until the longest request ends: the slots of r1 and r3 sit idle, and r4 to r6 wait until step 9. Continuous batching (2) decides after every step: a finished request frees its slot, and the next one in the queue takes it. The same ${tokens} tokens take ${staticEnd} steps in the first case and ${contEnd} in the second (3); prefill is left out for simplicity.`;
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L, li) => {
    const g = geo[li];
    const panels = [
      { title: t.s, y: L.p1, runs: staticRuns, end: staticEnd, s: '1', showIdle: true },
      { title: t.c, y: L.p2, runs: contRuns, end: contEnd, s: '2', showIdle: false },
    ];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        {[0, 2, 4, 6, 8, 10, 12, 14].map((v) => (
          <g>
            <line class="f-grid" x1={g.sx(v)} x2={g.sx(v)} y1={L.p1 + 10} y2={L.axisY} />
            <text class="f-small f-t-muted" x={g.sx(v)} y={L.axisY + 16} text-anchor="middle">{String(v)}</text>
          </g>
        ))}
        <line class="f-axis" x1={L.x0} x2={L.x1} y1={L.axisY} y2={L.axisY} />
        <text class="f-small f-t-muted" x={L.x1} y={L.axisY + 34} text-anchor="end">{t.axis}</text>
        {panels.map((p, pi) => (
          <g data-s={p.s}>
            <Badge x={20} y={p.y - 4} n={pi + 1} />
            <text class="f-small" x={34} y={p.y} style="font-weight: 650">{p.title}</text>
            {[0, 1, 2].map((j) => <text class="f-small f-t-muted" x={L.x0 - 8} y={p.y + 14 + j * L.pitch + L.barH / 2 + 4} text-anchor="end">{t.slot(j)}</text>)}
            {p.runs.map((run) => {
              const y = p.y + 14 + run.slot * L.pitch;
              return (
                <g>
                  <rect x={g.sx(run.start) + 1} y={y} width={g.sx(run.end) - g.sx(run.start) - 2} height={L.barH} rx="4" style={`fill: var(--fig-blue); fill-opacity: ${shade(run.r)}; stroke: var(--fig-blue); stroke-width: 1.2`} />
                  <text class="f-small" x={(g.sx(run.start) + g.sx(run.end)) / 2} y={y + L.barH / 2 + 4.5} text-anchor="middle">{`r${run.r + 1}`}</text>
                </g>
              );
            })}
            {p.showIdle && idle.map((gap, k) => {
              const y = p.y + 14 + gap.slot * L.pitch;
              return (
                <g>
                  <rect x={g.sx(gap.start) + 1} y={y} width={g.sx(gap.end) - g.sx(gap.start) - 2} height={L.barH} rx="4" style="fill: none; stroke: var(--muted); stroke-width: 1.2; stroke-dasharray: 4 3" />
                  {g.idleLabels[k] && <text class="f-small f-t-muted" x={(g.sx(gap.start) + g.sx(gap.end)) / 2} y={y + L.barH / 2 + 4.5} text-anchor="middle">{t.idle}</text>}
                </g>
              );
            })}
          </g>
        ))}
        <g data-s="3">
          {panels.map((p, pi) => (
            <g>
              <line x1={g.sx(p.end)} x2={g.sx(p.end)} y1={p.y + 8} y2={p.y + 14 + 2 * L.pitch + L.barH + 4} style="stroke: var(--fig-red); stroke-width: 2" />
              <text class="f-small f-t-red" x={L.x1} y={p.y} text-anchor="end" style="font-weight: 650">{g.sums[pi]}</text>
            </g>
          ))}
          <Badge x={g.sx(contEnd) + 14} y={L.p2 + 14 + L.pitch + L.barH / 2} n={3} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
