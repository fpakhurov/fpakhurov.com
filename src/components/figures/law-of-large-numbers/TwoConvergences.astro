---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const id='two-convergences',ru=pageLang(Astro.url)==='ru';
const title=ru?'Редкое событие в момент и событие в растущем окне':'A rare time point and an event in a growing window';
const caption=ru?'Независимые события с вероятностями 1/(n+2). Синяя линия показывает вероятность в момент N; пунктир — хотя бы одно событие от N до 4N включительно. Соединены четыре точных значения. По горизонтали логарифмическая шкала; это вероятности, не случайная траектория.':'Independent events with probabilities 1/(n+2). Blue shows probability at N; dashes show at least one event from N through 4N inclusive. Lines join four exact values. The horizontal axis is logarithmic; these are probabilities, not a random trajectory.';
const x=(n:number)=>48+40*Math.log2(n/4),y=(p:number)=>212-160*p;
const curve=(key:'atN'|'through4N')=>cases.events.map(r=>`${x(r.n)},${y(r[key])}`).join(' ');
---
<Figure id={id} title={title} caption={caption}>
 <div class="event-panels">
  <svg viewBox="0 0 320 260" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
   <title id={`${id}-title`}>{title}</title>
   <desc id={`${id}-desc`}>{ru?'Вероятность в момент падает от 1/6 примерно до 0.00388; вероятность события в окне растёт от 0.72222 до 0.74951.':'The point probability falls from 1/6 to about 0.00388; the window probability rises from 0.72222 to 0.74951.'}</desc>
   <text x="48" y="26">{ru?'Вероятность':'Probability'}</text>
   {[0,.5,1].map(v=><g><path d={`M48 ${y(v)}H288`} class="grid"/><text x="39" y={y(v)+6} text-anchor="end">{v}</text></g>)}
   <path d="M48 50V212H288" class="axis"/>
   {cases.events.map(r=><text x={x(r.n)} y="238" text-anchor="middle">{r.n}</text>)}
   <text x="288" y="258" text-anchor="end">N</text>
   <polyline data-series="point" points={curve('atN')} class="point"/>
   <polyline data-series="window" points={curve('through4N')} class="window"/>
   {cases.events.map(r=><><circle data-series="point" data-n={r.n} cx={x(r.n)} cy={y(r.atN)} r="3.5" fill="var(--fig-blue)"/><circle data-series="window" data-n={r.n} cx={x(r.n)} cy={y(r.through4N)} r="3.5" fill="var(--fig-amber)"/></>)}
  </svg>
  <div class="legend"><p><span class="key point"></span>{ru?'В момент N':'At time N'}</p><p><span class="key window"></span>{ru?'Хотя бы одно: N…4N':'At least one: N…4N'}</p><p>{ru?'Вероятность в отдельный момент стремится к нулю; вероятность события в окне стремится к 3/4.':'The point probability tends to zero; the window probability tends to 3/4.'}</p></div>
 </div>
</Figure>
<style>
.event-panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;align-items:center}.event-panels svg{min-width:0;width:100%;height:auto}.event-panels text{font:18px var(--sans);fill:var(--ink);font-variant-numeric:tabular-nums}.axis{fill:none;stroke:var(--muted);stroke-width:1.2}.grid{fill:none;stroke:var(--line)}.point,.window{fill:none;stroke-width:2.5}.point{stroke:var(--fig-blue)}.window{stroke:var(--fig-amber);stroke-dasharray:7 4}.legend p{margin:.7rem 0}.key{display:inline-block;width:1.3rem;margin-right:.45rem;border-top:3px solid var(--fig-blue);vertical-align:middle}.key.window{border-color:var(--fig-amber);border-top-style:dashed}@media(max-width:700px){.event-panels{grid-template-columns:1fr}}
</style>
