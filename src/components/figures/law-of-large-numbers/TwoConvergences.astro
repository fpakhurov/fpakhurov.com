---
import Figure from '../Figure.astro';
import { mulberry32 } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Independent events A_n with P(A_n) = 1/n (top) and 1/n² (bottom), n = 1 … 100,000; a tick marks every n at which
// A_n happens, for six runs each, on a logarithmic axis. In both cases X_n = 1{A_n} → 0 in probability; only the bottom
// sequence converges almost surely (Borel–Cantelli).
const N = 100000, runs = 6;
const hits = (p: (n: number) => number, seed: number) => Array.from({ length: runs }, (_, r) => {
  const u = mulberry32(seed + r), out: number[] = [];
  for (let n = 1; n <= N; n++) if (u() < p(n)) out.push(n);
  return out;
});
const panels = [
  { p: (n: number) => 1 / n, hits: hits((n) => 1 / n, 100), en: ['P(Aₙ) = 1/n:', 'the sum diverges, events keep happening'], ru: ['P(Aₙ) = 1/n:', 'сумма расходится, события продолжаются'] },
  { p: (n: number) => 1 / (n * n), hits: hits((n) => 1 / (n * n), 200), en: ['P(Aₙ) = 1/n²:', 'the sum converges, events stop'], ru: ['P(Aₙ) = 1/n²:', 'сумма сходится, события прекращаются'] },
];
const late = panels.map((P) => P.hits.filter((h) => h.some((n) => n > 1000)).length);
if (late[0] < 4 || late[1] > 0) throw new Error('TwoConvergences: the seeded runs no longer show the contrast');
const id = 'two-convergences';
const layouts = [
  { cls: 'fig-wide', W: 720, H: 300, x0: 30, x1: 700, top: [40, 170], rowH: 16, wide: true },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 380, x0: 14, x1: 346, top: [60, 228], rowH: 16, wide: false },
];
const lg = (n: number) => Math.log10(n) / 5;
---

<Figure
  id={id}
  title={ru ? 'Сходимость по вероятности и почти наверное' : 'Convergence in probability and almost surely'}
  caption={ru
    ? 'Независимые события Aₙ, n от 1 до 100 000, по шесть прогонов; штрих отмечает каждое n, при котором Aₙ произошло (ось логарифмическая). В обоих случаях P(Aₙ) → 0, так что индикатор Aₙ сходится к нулю по вероятности. Сверху P(Aₙ) = 1/n: сумма вероятностей расходится, и в каждом прогоне события продолжают случаться сколь угодно поздно (между 10⁴ и 10⁵ хотя бы одно — с вероятностью 0.9). Снизу P(Aₙ) = 1/n²: сумма конечна, и после нескольких первых шагов событий нет; это сходимость почти наверное.'
    : 'Independent events Aₙ for n from 1 to 100,000, six runs each; a tick marks every n at which Aₙ happened (log axis). In both cases P(Aₙ) → 0, so the indicator of Aₙ converges to 0 in probability. Top, P(Aₙ) = 1/n: the probabilities sum to infinity, and in every run events keep happening arbitrarily late (at least one between 10⁴ and 10⁵ with probability 0.9). Bottom, P(Aₙ) = 1/n²: the sum is finite, and after the first few steps no events occur; this is almost sure convergence.'}
>
  {layouts.map((L) => {
    const sx = (n: number) => L.x0 + lg(n) * (L.x1 - L.x0);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Моменты событий в двух последовательностях' : 'Event times in two sequences'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Верхние шесть строк: штрихи разбросаны до конца оси. Нижние шесть строк: штрихи только в самом начале.' : 'Top six rows: ticks scattered to the end of the axis. Bottom six rows: ticks only at the very start.'}</desc>
        {panels.map((P, k) => (
          <g>
            {L.wide
              ? <text class="f-small" x={L.x0} y={L.top[k] - 12}>{(ru ? P.ru : P.en).join(' ')}</text>
              : (ru ? P.ru : P.en).map((line, j) => <text class="f-small" x={L.x0} y={L.top[k] - 30 + j * 18}>{line}</text>)}
            {P.hits.map((h, r) => (
              <g>
                <path class="f-grid" d={`M ${L.x0} ${L.top[k] + r * L.rowH + 8} H ${L.x1}`} />
                {h.map((n) => <path class={`f-line f-${k === 0 ? 'red' : 'blue'}`} d={`M ${sx(n).toFixed(1)} ${L.top[k] + r * L.rowH + 2} v 12`} />)}
              </g>
            ))}
          </g>
        ))}
        {[1, 10, 100, 1000, 10000, 100000].map((n, i) => <text class="f-note" x={sx(n)} y={L.H - 12} text-anchor={i === 0 ? 'start' : i === 5 ? 'end' : 'middle'}>{['1', '10', '10²', '10³', '10⁴', '10⁵'][i]}</text>)}
      </svg>
    );
  })}
</Figure>
