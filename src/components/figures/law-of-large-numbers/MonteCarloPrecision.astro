---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const id='monte-carlo-precision',ru=pageLang(Astro.url)==='ru';
const title=ru?'Одинаковое число вычислений, разная RMS-ошибка':'Equal evaluations, different RMS error';
const caption=ru?'Интегрируем 1+u² на [0,1]. Обычная схема использует независимые точки; парная усредняет g(u) и g(1−u). Обе шкалы логарифмические. Показаны теоретические корни из MSE, не ошибки отдельных запусков. При одинаковом числе вычислений дисперсия парной оценки в 8 раз меньше.':'Integrating 1+u² over [0,1]. Plain sampling uses independent points; paired sampling averages g(u) and g(1−u). Both axes are logarithmic. These are theoretical roots of MSE, not individual-run errors. At equal evaluation count the paired variance is eight times smaller.';
const x=(n:number)=>60+30*Math.log2(n/4),y=(r:number)=>52+80*Math.log10(.2/r);
const points=(key:'plainRms'|'pairedRms')=>cases.monteCarlo.budget.map(r=>`${x(r.evaluations)},${y(r[key])}`).join(' ');
---
<Figure id={id} title={title} caption={caption}>
 <div class="mc-panels">
  <svg viewBox="0 0 330 270" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
   <title id={`${id}-title`}>{title}</title>
   <desc id={`${id}-desc`}>{ru?'При 4 вычислениях RMS равна 0.14907 и 0.05270; при 1024 — 0.00932 и 0.00329. Обе кривые убывают как обратный квадратный корень бюджета.':'At 4 evaluations RMS values are 0.14907 and 0.05270; at 1024 they are 0.00932 and 0.00329. Both curves fall as the inverse square root of the budget.'}</desc>
   <text x="60" y="26">RMS</text>
   {[.2,.02,.002].map(v=><g><path d={`M60 ${y(v)}H300`} class="grid"/><text x="53" y={y(v)+6} text-anchor="end">{v}</text></g>)}
   <path d="M60 50V212H300" class="axis"/>
   {[4,64,1024].map(n=><text x={x(n)} y="238" text-anchor="middle">{n}</text>)}
   <text x="180" y="263" text-anchor="middle">{ru?'Вычислений':'Evaluations'}</text>
   <polyline data-series="plain" points={points('plainRms')} class="plain"/>
   <polyline data-series="paired" points={points('pairedRms')} class="paired"/>
   {cases.monteCarlo.budget.map(r=><><circle data-series="plain" data-calls={r.evaluations} cx={x(r.evaluations)} cy={y(r.plainRms)} r="3.5" fill="var(--fig-blue)"/><circle data-series="paired" data-calls={r.evaluations} cx={x(r.evaluations)} cy={y(r.pairedRms)} r="3.5" fill="var(--fig-green)"/></>)}
  </svg>
  <div><p><span class="key plain"></span>{ru?'Независимые точки':'Independent points'}</p><p><span class="key paired"></span>{ru?'Антитетические пары':'Antithetic pairs'}</p><p>{ru?'Одна пара требует двух вычислений. В обоих случаях 4-кратный бюджет уменьшает RMS вдвое.':'A pair needs two evaluations. For either design, four times the budget halves RMS.'}</p></div>
 </div>
</Figure>
<style>
.mc-panels{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;align-items:center}.mc-panels svg{min-width:0;width:100%;height:auto}.mc-panels text{font:18px var(--sans);fill:var(--ink);font-variant-numeric:tabular-nums}.axis{fill:none;stroke:var(--muted);stroke-width:1.2}.grid{fill:none;stroke:var(--line)}.plain,.paired{fill:none;stroke-width:2.5}.plain{stroke:var(--fig-blue)}.paired{stroke:var(--fig-green);stroke-dasharray:7 4}.mc-panels p{margin:.7rem 0}.key{display:inline-block;width:1.3rem;margin-right:.45rem;border-top:3px solid var(--fig-blue);vertical-align:middle}.key.paired{border-color:var(--fig-green);border-top-style:dashed}@media(max-width:700px){.mc-panels{grid-template-columns:1fr}}
</style>
