---
import Figure from '../Figure.astro';
import { mulberry32 } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Monte Carlo: 2,000 uniform points in the unit square; the share inside the quarter disk estimates π/4.
const n = 2000, u = mulberry32(31);
const pts = Array.from({ length: n }, () => [u(), u()] as [number, number]);
const inside = pts.map(([x, y]) => x * x + y * y <= 1);
const k = inside.filter(Boolean).length, est = (4 * k) / n, se = 4 * Math.sqrt((Math.PI / 4) * (1 - Math.PI / 4) / n);
if (Math.abs(est - Math.PI) > 2.5 * se) throw new Error('MonteCarloPi: the seeded estimate is unusually far from π');
// Russian style leaves four-digit numbers unseparated.
const fmtN = (v: number) => (ru ? String(v) : v.toLocaleString('en-US'));
const id = 'monte-carlo-pi';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 560, H: 300, x0: 20, y0: 20, s: 260, tx: 310 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 400, x0: 50, y0: 16, s: 260, tx: 20 },
];
const arc = (x0: number, y0: number, s: number) => `M ${x0} ${y0} A ${s} ${s} 0 0 1 ${x0 + s} ${y0 + s}`;
---

<Figure
  id={id}
  title={ru ? 'Число π методом Монте-Карло' : 'π by Monte Carlo'}
  caption={ru
    ? `${fmtN(n)} равномерных точек в единичном квадрате; синие попали в четверть круга x² + y² ≤ 1, площадь которой π/4. Доля попаданий ${k}/${fmtN(n)} даёт оценку 4 · ${k}/${fmtN(n)} = ${est.toFixed(3)} со стандартной ошибкой около ${se.toFixed(3)}; фактическая ошибка этой оценки, |оценка − π|, равна ${Math.abs(est - Math.PI).toFixed(3)}. Закон больших чисел гарантирует, что оценка сходится к π, а ошибка убывает как 1/√n.`
    : `${fmtN(n)} uniform points in the unit square; the blue ones fall in the quarter disk x² + y² ≤ 1, whose area is π/4. The share of hits ${k}/${fmtN(n)} gives the estimate 4 · ${k}/${fmtN(n)} = ${est.toFixed(3)}, with a standard error of about ${se.toFixed(3)}; the realized error of this estimate, |estimate − π|, is ${Math.abs(est - Math.PI).toFixed(3)}. The law of large numbers guarantees that the estimate converges to π; the error falls like 1/√n.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Точки в квадрате и четверть круга' : 'Points in a square and a quarter disk'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? `Из ${n} точек ${k} внутри четверти круга; оценка π равна ${est.toFixed(3)}.` : `Of ${n} points, ${k} lie inside the quarter disk; the estimate of π is ${est.toFixed(3)}.`}</desc>
      <rect x={L.x0} y={L.y0} width={L.s} height={L.s} style="fill: none; stroke: var(--line); stroke-width: 1.2" />
      {pts.map(([x, y], i) => <circle cx={(L.x0 + x * L.s).toFixed(1)} cy={(L.y0 + L.s - y * L.s).toFixed(1)} r="1.5" style={`fill: var(${inside[i] ? '--fig-blue' : '--fig-red'}); fill-opacity: .55`} />)}
      <path class="f-line" d={arc(L.x0, L.y0, L.s)} />
      <text class="f-label" x={L.tx} y={L.cls.includes('wide') ? 120 : L.y0 + L.s + 40}>{`4 · ${k} / ${fmtN(n)} = ${est.toFixed(3)}`}</text>
      <text class="f-small f-t-muted" x={L.tx} y={L.cls.includes('wide') ? 146 : L.y0 + L.s + 66}>{`π = 3.142, ${ru ? 'стандартная ошибка' : 'standard error'} ≈ ${se.toFixed(3)}`}</text>
    </svg>
  ))}
</Figure>
