---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

type V = [number, number];
// min ‖x − c‖² over the triangle g1 = x1 + x2 − 2 ≤ 0, g2 = −x1 ≤ 0, g3 = −x2 ≤ 0.
// The projection onto the half-plane x1 + x2 ≤ 2 is the answer whenever it lands inside the triangle.
const solve = (c: V) => {
  const excess = c[0] + c[1] - 2;
  const x: V = excess > 0 ? [c[0] - excess / 2, c[1] - excess / 2] : [c[0], c[1]];
  const grad: V = [2 * (x[0] - c[0]), 2 * (x[1] - c[1])];
  const lam1 = excess > 0 ? -grad[0] : 0; // stationarity: grad + lam1 (1, 1) = 0
  return { x, grad, lam1, g1: x[0] + x[1] - 2 };
};
const inside = solve([0.8, 0.6]), outside = solve([2, 1]);
const got = [inside.x.join(','), inside.lam1, outside.x.join(','), outside.grad.join(','), outside.lam1, outside.g1, outside.lam1 * outside.g1].join(' ');
if (got !== '0.8,0.6 0 1.5,0.5 -1,-1 1 0 0') throw new Error(`KktActiveInactive: numbers drifted: ${got}`);
const tri: V[] = [[0, 0], [2, 0], [0, 2]];
const circle = (c: V, r: number) => Array.from({ length: 97 }, (_, k) => { const a = (2 * Math.PI * k) / 96; return [c[0] + r * Math.cos(a), c[1] + r * Math.sin(a)] as V; });

const panels = [
  { key: 'in', c: [0.8, 0.6] as V, sol: inside, radii: [0.25, 0.5, 0.8],
    en: ['c inside: no constraint active', 'x* = c, ∇f(x*) = 0, all λᵢ = 0'], ru: ['c внутри: активных ограничений нет', 'x* = c, ∇f(x*) = 0, все λᵢ = 0'] },
  { key: 'out', c: [2, 1] as V, sol: outside, radii: [Math.SQRT1_2, 1.0, 1.35],
    en: ['c outside: g₁ active, g₂, g₃ inactive', '−∇f = λ₁∇g₁ with λ₁ = 1; λ₂ = λ₃ = 0'], ru: ['c снаружи: g₁ активно, g₂, g₃ неактивны', '−∇f = λ₁∇g₁, λ₁ = 1; λ₂ = λ₃ = 0'] },
];
const id = 'kkt-active-inactive';
const dom = { x: [-0.3, 2.5] as V, y: [-0.3, 2.25] as V };
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 400, unit: 118, boxes: [[18, 34], [400, 34]] as V[], capY: 352 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 820, unit: 112, boxes: [[23, 34], [23, 436]] as V[], capY: 338 },
];
---

<Figure
  id={id}
  title={ru ? 'Ограничение-неравенство: активное или нет' : 'An inequality constraint: active or inactive'}
  caption={ru
    ? 'Минимизация ‖x − c‖² по треугольнику x₁ + x₂ ≤ 2, x₁ ≥ 0, x₂ ≥ 0; линии уровня — окружности вокруг c. Слева c = (0.8, 0.6) внутри: x* = c, и все множители равны нулю. Справа c = (2, 1) снаружи: x* = (1.5, 0.5) на стороне x₁ + x₂ = 2, −∇f направлен по внешней нормали, λ₁ = 1.'
    : 'Minimizing ‖x − c‖² over the triangle x₁ + x₂ ≤ 2, x₁ ≥ 0, x₂ ≥ 0; level sets are circles around c. Left, c = (0.8, 0.6) inside: x* = c and every multiplier is zero. Right, c = (2, 1) outside: x* = (1.5, 0.5) on the side x₁ + x₂ = 2, where −∇f points along the outward normal and λ₁ = 1.'}
>
  {layouts.map((Ly) => (
    <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
      <title id={`${id}-${Ly.sfx}-t`}>{ru ? 'Проекция точки на треугольник в двух случаях' : 'Projecting a point onto a triangle in two cases'}</title>
      <desc id={`${id}-${Ly.sfx}-d`}>{ru
        ? 'Две панели с закрашенным треугольником и концентрическими окружностями. Слева центр окружностей внутри треугольника и совпадает с решением. Справа центр снаружи, наименьшая окружность, достающая до треугольника, касается его наклонной стороны; из точки касания наружу выходят две совпадающие по направлению стрелки, градиент ограничения и направление спуска.'
        : 'Two panels with a shaded triangle and concentric circles. Left, the centre of the circles lies inside the triangle and is the solution. Right, the centre lies outside; the smallest circle that reaches the triangle touches its slanted side, and from the point of contact two arrows in the same direction point outward: the constraint gradient and the descent direction.'}</desc>
      {panels.map((p, j) => {
        const [bx, by] = Ly.boxes[j];
        const w = Ly.unit * (dom.x[1] - dom.x[0]), h = Ly.unit * (dom.y[1] - dom.y[0]);
        const sx = scale(dom.x, [bx, bx + w]), sy = scale(dom.y, [by + h, by]);
        const S = (v: V): V => [sx(v[0]), sy(v[1])];
        const clip = `${id}-${Ly.sfx}-${p.key}`;
        const xs = p.sol.x;
        const lines = ru ? p.ru : p.en;
        return (
          <g>
            <defs><clipPath id={clip}><rect x={bx} y={by} width={w} height={h} /></clipPath></defs>
            <rect x={bx} y={by} width={w} height={h} class="f-box-soft" style="fill: none" />
            <path class="f-fill-green" d={polyline(tri.map(S)) + ' Z'} />
            <path class="f-line f-green" d={polyline(tri.map(S)) + ' Z'} />
            <g clip-path={`url(#${clip})`}>
              {p.radii.map((r) => <path class="f-thin f-muted" style="stroke-opacity: .65" d={polyline(circle(p.c, r).map(S)) + ' Z'} />)}
            </g>
            <text class="f-small f-t-green f-halo" x={S([0.38, 1.62])[0] + 8} y={S([0.38, 1.62])[1] - 4}>g₁ = 0</text>
            <text class="f-small f-t-green f-halo" x={S([0, 1.0])[0] - 8} y={S([0, 1.0])[1]} text-anchor="middle" transform={`rotate(-90 ${S([0, 1.0])[0] - 8} ${S([0, 1.0])[1]})`}>g₂ = 0</text>
            <text class="f-small f-t-green f-halo" x={S([1.5, 0])[0]} y={S([1.5, 0])[1] + 18}>g₃ = 0</text>
            {j === 1 && <path class="f-line f-amber f-bold" d={polyline([S(xs), S([xs[0] + 0.42, xs[1] + 0.42])])} marker-end="url(#f-arrow-amber)" />}
            {j === 1 && <path class="f-line f-blue" d={polyline([S([xs[0] + 0.05, xs[1] - 0.05]), S([xs[0] + 0.05 + 0.3, xs[1] - 0.05 + 0.3])])} marker-end="url(#f-arrow-blue)" />}
            {j === 1 && <text class="f-small f-t-amber f-halo" x={S([xs[0] + 0.42, xs[1] + 0.42])[0] - 4} y={S([xs[0] + 0.42, xs[1] + 0.42])[1] - 8} text-anchor="end">∇g₁</text>}
            {j === 1 && <text class="f-small f-t-blue f-halo" x={S([xs[0] + 0.38, xs[1] + 0.22])[0] + 4} y={S([xs[0] + 0.38, xs[1] + 0.22])[1] + 14}>−∇f</text>}
            <circle cx={S(p.c)[0]} cy={S(p.c)[1]} r="3.5" class="f-solid-muted" />
            <text class="f-small f-halo" x={S(p.c)[0] + 8} y={S(p.c)[1] + (j === 0 ? -8 : 16)}>c</text>
            <circle cx={S(xs)[0]} cy={S(xs)[1]} r="5" class="f-solid-blue" style="fill: var(--ink)" />
            <text class="f-small f-halo" x={S(xs)[0] - 9} y={S(xs)[1] + (j === 0 ? 18 : 4)} text-anchor="end">x*</text>
            <text class="f-small" x={bx} y={by + h + 24}>{lines[0]}</text>
            <text class="f-small" x={bx} y={by + h + 44}>{lines[1]}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
