---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

type V = [number, number];
// min f = x1² + 2 x2² subject to h = x1 + x2 − 1 = 0. Stationarity: 2x1 + ν = 0, 4x2 + ν = 0, x1 + x2 = 1,
// so x1 = −ν/2, x2 = −ν/4 and −3ν/4 = 1.
const nu = -4 / 3, xs: V = [-nu / 2, -nu / 4];
const f = (x: V) => x[0] ** 2 + 2 * x[1] ** 2;
const gradF = (x: V): V => [2 * x[0], 4 * x[1]];
const fs = f(xs);
const q: V = [0, 1], gq = gradF(q);
const tang = (gq[0] - gq[1]) / Math.SQRT2; // component of ∇f(q) along (1, −1)/√2
const got = [xs[0].toFixed(4), xs[1].toFixed(4), fs.toFixed(4), nu.toFixed(4), gradF(xs).map((v) => v.toFixed(4)).join(','), f(q), tang.toFixed(2)].join(' ');
if (got !== '0.6667 0.3333 0.6667 -1.3333 1.3333,1.3333 2 -2.83') throw new Error(`LagrangeGeometry: numbers drifted: ${got}`);
const ellipse = (c: number) => Array.from({ length: 145 }, (_, k) => { const a = (2 * Math.PI * k) / 144; return [Math.sqrt(c) * Math.cos(a), Math.sqrt(c / 2) * Math.sin(a)] as V; });
const levels = [0.2, fs, 1.3, f(q)];

const id = 'lagrange-geometry';
const dom = { x: [-1.05, 1.85] as V, y: [-0.75, 1.45] as V };
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 340, unit: 128, box: [36, 26] as V, lg: [430, 70], lgStep: 26 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 430, unit: 108, box: [23, 26] as V, lg: [20, 296], lgStep: 27 },
];
const T = ru
  ? { lev: 'f = 2/3', l: ['чёрная прямая: x₁ + x₂ = 1', 'эллипсы: линии уровня f = x₁² + 2x₂²', 'в x* = (2/3, 1/3): ∇f = −ν ∇h, ν = −4/3', 'в (0, 1): у ∇f есть составляющая −2.83', 'вдоль прямой (зелёная), это не минимум'] }
  : { lev: 'f = 2/3', l: ['black line: x₁ + x₂ = 1', 'ellipses: level sets of f = x₁² + 2x₂²', 'at x* = (2/3, 1/3): ∇f = −ν ∇h, ν = −4/3', 'at (0, 1): ∇f has the component −2.83', 'along the line (green): not a minimum'] };
---

<Figure
  id={id}
  title={ru ? 'Условный минимум: линия уровня касается ограничения' : 'A constrained minimum: the level set touches the constraint'}
  caption={ru
    ? 'Линии уровня f = x₁² + 2x₂² и прямая x₁ + x₂ = 1. Самый маленький эллипс, достающий до прямой, касается её в точке x* = (2/3, 1/3); там ∇f (синий) и ∇h (оранжевый) оба перпендикулярны прямой, ν = −4/3. В точке (0, 1) эллипс f = 2 прямую пересекает.'
    : 'Level sets of f = x₁² + 2x₂² and the line x₁ + x₂ = 1. The smallest ellipse that reaches the line touches it at x* = (2/3, 1/3), where ∇f (blue) and ∇h (amber) are both perpendicular to the line, with ν = −4/3. At (0, 1) the ellipse f = 2 crosses the line instead.'}
>
  {layouts.map((Ly) => {
    const [bx, by] = Ly.box;
    const w = Ly.unit * (dom.x[1] - dom.x[0]), h = Ly.unit * (dom.y[1] - dom.y[0]);
    const sx = scale(dom.x, [bx, bx + w]), sy = scale(dom.y, [by + h, by]);
    const S = (v: V): V => [sx(v[0]), sy(v[1])];
    const clip = `${id}-${Ly.sfx}-clip`;
    const off = (v: V, d: number): V => [S(v)[0] + d / Math.SQRT2, S(v)[1] + d / Math.SQRT2]; // shift perpendicular to (1, 1) on screen
    const [lgx, lgy] = Ly.lg;
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{ru ? 'Линии уровня функции и прямая ограничения' : 'Level sets of the objective and the constraint line'}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{ru
          ? 'Вложенные эллипсы с центром в начале координат и наклонная прямая. Один эллипс касается прямой; в точке касания две параллельные стрелки градиентов перпендикулярны прямой. Выше по прямой более крупный эллипс пересекает её, там вертикальная стрелка градиента и зелёная стрелка вдоль прямой к точке касания.'
          : 'Nested ellipses centred at the origin and a slanted line. One ellipse touches the line; at the point of contact two parallel gradient arrows are perpendicular to the line. Higher up the line a larger ellipse crosses it; there a vertical gradient arrow and a green arrow along the line point towards the point of contact.'}</desc>
        <defs><clipPath id={clip}><rect x={bx} y={by} width={w} height={h} /></clipPath></defs>
        <rect x={bx} y={by} width={w} height={h} class="f-box-soft" style="fill: none" />
        <g clip-path={`url(#${clip})`}>
          <path class="f-axis" style="stroke-opacity: .5" d={`M ${bx} ${sy(0)} H ${bx + w} M ${sx(0)} ${by} V ${by + h}`} />
          {levels.map((c) => <path class={Math.abs(c - fs) === 0 ? 'f-line f-blue' : 'f-thin f-muted'} style={Math.abs(c - fs) === 0 ? '' : 'stroke-opacity: .6'} d={polyline(ellipse(c).map(S)) + ' Z'} />)}
          <path class="f-line" d={polyline([S([dom.x[0], 1 - dom.x[0]]), S([dom.x[1], 1 - dom.x[1]])])} />
        </g>
        <path class="f-line f-blue f-bold" d={polyline([off(xs, -5), [off(xs, -5)[0] + 0.3 * 4 / 3 * Ly.unit, off(xs, -5)[1] - 0.3 * 4 / 3 * Ly.unit]])} marker-end="url(#f-arrow-blue)" />
        <path class="f-line f-amber f-bold" d={polyline([off(xs, 5), [off(xs, 5)[0] + 0.3 * Ly.unit, off(xs, 5)[1] - 0.3 * Ly.unit]])} marker-end="url(#f-arrow-amber)" />
        <circle cx={S(xs)[0]} cy={S(xs)[1]} r="5" class="f-solid-blue" style="fill: var(--ink)" />
        <text class="f-small f-t-blue f-halo" x={off(xs, -5)[0] + 0.4 * Ly.unit + 4} y={off(xs, -5)[1] - 0.4 * Ly.unit - 4}>∇f</text>
        <text class="f-small f-t-amber f-halo" x={off(xs, 5)[0] + 0.3 * Ly.unit + 8} y={off(xs, 5)[1] - 0.3 * Ly.unit + 12}>∇h</text>
        <text class="f-small f-halo" x={S(xs)[0] - 10} y={S(xs)[1] + 18} text-anchor="end">x*</text>

        <path class="f-line f-blue" d={polyline([S(q), [S(q)[0], S(q)[1] - 0.1 * gq[1] * Ly.unit]])} marker-end="url(#f-arrow-blue)" />
        <path class="f-line f-green f-bold" d={polyline([S(q), S([0.32, 0.68])])} marker-end="url(#f-arrow-green)" />
        <circle cx={S(q)[0]} cy={S(q)[1]} r="4.5" class="f-solid-muted" style="fill: var(--ink)" />
        <text class="f-small f-t-blue f-halo" x={S(q)[0] + 8} y={S(q)[1] - 0.4 * Ly.unit + 4}>∇f</text>

        <text class="f-small f-t-blue f-halo" x={S([0, -Math.sqrt(fs / 2)])[0]} y={S([0, -Math.sqrt(fs / 2)])[1] + 16} text-anchor="middle">{T.lev}</text>

        {T.l.map((line, i) => <text class="f-small" x={lgx} y={lgy + i * Ly.lgStep}>{line}</text>)}
      </svg>
    );
  })}
</Figure>
