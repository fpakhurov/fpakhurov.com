---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Masked language modelling on one sentence: three selected positions, one per case of the 80/10/10 rule.
type Case = 'mask' | 'random' | 'same' | undefined;
const sentence: { t: string; input?: string; kind?: Case }[] = [
  { t: 'the' }, { t: 'cat', input: '[MASK]', kind: 'mask' }, { t: 'sat' }, { t: 'on' }, { t: 'the' },
  { t: 'warm', input: 'blue', kind: 'random' }, { t: 'mat', input: 'mat', kind: 'same' },
];
const tone: Record<string, string> = { mask: 'blue', random: 'amber', same: 'green' };
const t = ru
  ? { rows: ['текст', 'вход', 'энкодер', 'цель'], legend: [['mask', '[MASK] (80%)'], ['random', 'случайный токен (10%)'], ['same', 'без изменений (10%)']], band: 'двунаправленный энкодер: каждая позиция видит все остальные', bandN: 'двунаправленный энкодер', loss: 'потери: −log P(cat) − log P(warm) − log P(mat) — только по выбранным позициям', lossN: ['потери: −log P(cat) − log P(warm) − log P(mat),', 'только по выбранным позициям'], select: 'выбор 15% позиций', selectW: 'выбор 15%' }
  : { rows: ['text', 'input', 'encoder', 'target'], legend: [['mask', '[MASK] (80%)'], ['random', 'random token (10%)'], ['same', 'unchanged (10%)']], band: 'bidirectional encoder: every position sees all the others', bandN: 'bidirectional encoder', loss: 'loss: −log P(cat) − log P(warm) − log P(mat), at the selected positions only', lossN: ['loss: −log P(cat) − log P(warm) − log P(mat),', 'at the selected positions only'], select: 'select 15% of positions', selectW: 'select 15%' };
interface Layout { cls: string; W: number; H: number; x0: number; cw: number; gap: number; y: number[]; narrow: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 690, H: 292, x0: 120, cw: 64, gap: 6, y: [26, 70, 128, 200, 252], narrow: false },
  { cls: 'fig-narrow', W: 360, H: 380, x0: 8, cw: 44, gap: 4, y: [38, 96, 160, 240, 296], narrow: true },
];
const id = 'bert-masked-lm';
---

<Figure
  id={id}
  title={ru ? 'Маскированное языковое моделирование на одном предложении' : 'Masked language modelling on one sentence'}
  caption={ru
    ? 'Из каждой обучающей последовательности случайно выбирается 15% позиций (здесь три из семи, чтобы показать все три случая). Выбранный токен на входе заменяется на [MASK] с вероятностью 0.8, на случайный токен словаря с вероятностью 0.1 и остаётся прежним с вероятностью 0.1. Энкодер видит всё предложение в обе стороны и в каждой выбранной позиции предсказывает исходный токен; функция потерь — кросс-энтропия только по этим позициям, остальные позиции её не дают. Случайная замена и оставленный токен заставляют модель строить полезное представление каждой позиции, ведь при дообучении [MASK] не встречается.'
    : 'In every training sequence 15% of the positions are selected at random (three of seven here, to show all three cases). A selected input token is replaced by [MASK] with probability 0.8, by a random vocabulary token with probability 0.1, and left as it is with probability 0.1. The encoder sees the whole sentence in both directions and predicts the original token at every selected position; the loss is the cross-entropy at those positions only, and the other positions contribute nothing. The random and unchanged cases force the model to build a useful representation of every position, because [MASK] never appears at fine-tuning time.'}
>
  {layouts.map((L) => {
    const x = (i: number) => L.x0 + i * (L.cw + L.gap);
    const right = x(sentence.length - 1) + L.cw;
    const [yText, yIn, yEnc, yOut, yLoss] = L.y;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Схема маскированного языкового моделирования' : 'Masked language modelling'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? `Предложение ${sentence.map((s) => s.t).join(' ')}. На входе cat заменён на [MASK], warm — на случайный токен blue, mat оставлен как есть. Двунаправленный энкодер предсказывает в этих трёх позициях cat, warm и mat; функция потерь считается только по ним.`
          : `The sentence ${sentence.map((s) => s.t).join(' ')}. In the input, cat is replaced by [MASK], warm by the random token blue, and mat is left as it is. The bidirectional encoder predicts cat, warm and mat at these three positions, and the loss is computed at them only.`}</desc>
        {L.y.slice(0, 4).map((yy, r) => (
          L.narrow
            ? (r === 2 ? null : <text class="f-small f-t-muted f-halo" x={L.x0} y={yy - (r === 0 ? 22 : 12)}>{t.rows[r]}{r === 1 ? ` · ${t.select}` : ''}</text>)
            : <text class="f-small f-t-muted" x={L.x0 - 14} y={yy + (r === 2 ? 26 : 18)} text-anchor="end">{t.rows[r]}</text>
        ))}
        {!L.narrow && <text class="f-small f-t-muted" x={right + 10} y={yIn + 18}>{t.selectW}</text>}
        {sentence.map((s, i) => {
          const cx = x(i) + L.cw / 2;
          const k = s.kind;
          return (
            <g>
              <text class={`f-small${k ? ' f-bold' : ''}`} x={cx} y={yText + 18} text-anchor="middle" font-family="var(--mono)">{s.t}</text>
              <path class={`f-thin ${k ? `f-${tone[k]}` : 'f-muted'}`} d={`M ${cx} ${yText + 24} V ${yIn - 3}`} marker-end={`url(#f-arrow-${k ? tone[k] : 'muted'})`} />
              <rect class={k ? `f-fill-${tone[k]}` : 'f-fill-paper'} x={x(i)} y={yIn} width={L.cw} height="28" rx="5" />
              <rect class={`f-thin ${k ? `f-${tone[k]}` : 'f-muted'}`} x={x(i)} y={yIn} width={L.cw} height="28" rx="5" fill="none" />
              <text class="f-small" x={cx} y={yIn + 19} text-anchor="middle" font-family="var(--mono)">{s.input ?? s.t}</text>
              <path class="f-thin f-muted" d={`M ${cx} ${yIn + 30} V ${yEnc - 3}`} marker-end="url(#f-arrow-muted)" />
              <path class={`f-thin ${k ? `f-${tone[k]}` : 'f-muted f-dot'}`} d={`M ${cx} ${yEnc + 44} V ${yOut - 3}`} marker-end={k ? `url(#f-arrow-${tone[k]})` : undefined} />
              {k
                ? (<g>
                    <rect class={`f-fill-${tone[k]}`} x={x(i)} y={yOut} width={L.cw} height="28" rx="5" />
                    <rect class={`f-thin f-${tone[k]}`} x={x(i)} y={yOut} width={L.cw} height="28" rx="5" fill="none" />
                    <text class={`f-small f-t-${tone[k]}`} x={cx} y={yOut + 19} text-anchor="middle" font-family="var(--mono)">{s.t}</text>
                  </g>)
                : <text class="f-small f-t-muted" x={cx} y={yOut + 19} text-anchor="middle">—</text>}
            </g>
          );
        })}
        <rect class="f-fill-paper" x={L.x0} y={yEnc} width={right - L.x0} height="44" rx="7" />
        <rect class="f-thin" x={L.x0} y={yEnc} width={right - L.x0} height="44" rx="7" fill="none" />
        <text class="f-small" x={(L.x0 + right) / 2} y={yEnc + 27} text-anchor="middle">{L.narrow ? t.bandN : t.band}</text>
        {t.legend.map(([k, label], li) => {
          const lx = L.narrow ? L.x0 : L.x0 + li * 170;
          const ly = L.narrow ? yLoss + 48 + li * 16 : yLoss + 28;
          return (
            <g>
              <rect class={`f-fill-${tone[k]}`} x={lx} y={ly - 9} width="10" height="10" rx="2" />
              <rect class={`f-thin f-${tone[k]}`} x={lx} y={ly - 9} width="10" height="10" rx="2" fill="none" />
              <text class="f-small" x={lx + 16} y={ly}>{label}</text>
            </g>
          );
        })}
        {(L.narrow ? t.lossN : [t.loss]).map((line, li) => <text class="f-small" x={L.narrow ? L.x0 : L.x0} y={yLoss + li * 16}>{line}</text>)}
      </svg>
    );
  })}
</Figure>
