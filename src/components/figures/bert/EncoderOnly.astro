---
import Figure from '../Figure.astro';

// Encoder-only model: tokens → embeddings → L encoder blocks → one contextual
// vector per token, read by a sentence-level head ([CLS]) and per-token heads.
const tokens = ['[CLS]', 'river', 'bank', '[SEP]'];
const cellW = 64;
const cellH = 34;

interface Layout { cls: string; w: number; h: number; colX: number[]; outY: number; encY: number; encH: number; embY: number; tokY: number; head: { x: number; y: number; w: number }; routeY: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', w: 700, h: 330, colX: [78, 168, 258, 348], outY: 86, encY: 160, encH: 62, embY: 250, tokY: 318, head: { x: 500, y: 86, w: 170 }, routeY: 48 },
  { cls: 'fig-narrow', w: 360, h: 420, colX: [32, 110, 188, 266], outY: 118, encY: 192, encH: 62, embY: 282, tokY: 352, head: { x: 110, y: 20, w: 220 }, routeY: 37 },
];
---

<Figure
  id="encoder-only"
  title="Encoder-only model: one contextual vector per token, two kinds of head"
  caption="The input tokens, with [CLS] in front and [SEP] at the end, are turned into token-plus-position embeddings and pass through L encoder blocks in which every position attends to every other. The output is a vector per token that depends on the whole sentence: the vector of bank here is not the one it gets in bank account. The vector of [CLS] (or the mean of all vectors) is read by a linear layer and a softmax for a sentence-level label; the individual vectors are read by a linear layer each for token-level labels such as entity tags or answer-span boundaries."
>
  {layouts.map((L) => {
    const encX = L.colX[0] - 20;
    const encW = L.colX[3] + cellW + 20 - encX;
    const cx = (i: number) => L.colX[i] + cellW / 2;
    const headCx = L.head.x + L.head.w / 2;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`encoder-only-${L.w}-t encoder-only-${L.w}-d`}>
        <title id={`encoder-only-${L.w}-t`}>Encoder-only Transformer with a sentence head and token heads</title>
        <desc id={`encoder-only-${L.w}-d`}>Four tokens at the bottom feed an embedding band, then a band of encoder blocks, then four output vectors. The first output vector is routed to a box labelled linear plus softmax that gives a sentence label. Small arrows above the middle output vectors indicate per-token labels.</desc>
        {/* tokens */}
        {tokens.map((tok, i) => (
          <g>
            <text class="f-label" x={cx(i)} y={L.tokY} text-anchor="middle">{tok}</text>
            <path class="f-thin" d={`M ${cx(i)} ${L.tokY - 16} V ${L.embY + cellH + 3}`} marker-end="url(#f-arrow)" />
          </g>
        ))}
        {/* embeddings band */}
        <rect class="f-box f-fill-amber" x={encX} y={L.embY} width={encW} height={cellH} rx="6" />
        <text class="f-small" x={encX + encW / 2} y={L.embY + cellH / 2 + 4} text-anchor="middle">token + position embeddings</text>
        {tokens.map((_, i) => <path class="f-thin" d={`M ${cx(i)} ${L.embY} V ${L.encY + L.encH + 3}`} marker-end="url(#f-arrow)" />)}
        {/* encoder band */}
        <rect class="f-box f-fill-blue" x={encX} y={L.encY} width={encW} height={L.encH} rx="6" />
        <text class="f-small" x={encX + encW / 2} y={L.encY + 24} text-anchor="middle">L × encoder block</text>
        <text class="f-small f-t-muted" x={encX + encW / 2} y={L.encY + 44} text-anchor="middle">self-attention over all tokens, feed-forward</text>
        {tokens.map((_, i) => <path class="f-thin" d={`M ${cx(i)} ${L.encY} V ${L.outY + cellH + 3}`} marker-end="url(#f-arrow)" />)}
        {/* output vectors */}
        {tokens.map((_, i) => (
          <g>
            <rect class={`f-box${i === 0 ? ' f-fill-green' : ''}`} x={L.colX[i]} y={L.outY} width={cellW} height={cellH} rx="6" />
            <text class="f-math" x={cx(i)} y={L.outY + 23} text-anchor="middle">h<tspan dy="5" font-size="12">{i + 1}</tspan></text>
          </g>
        ))}
        {/* per-token heads */}
        {[1, 2].map((i) => <path class="f-thin f-blue" d={`M ${cx(i)} ${L.outY - 2} V ${L.outY - 14}`} marker-end="url(#f-arrow-blue)" />)}
        <text class="f-small f-t-blue" x={(cx(1) + cx(2)) / 2} y={L.outY - 20} text-anchor="middle">per-token labels</text>
        {/* sentence head from [CLS] */}
        <path class="f-line f-green" d={`M ${cx(0)} ${L.outY - 2} V ${L.routeY} H ${L.w > 400 ? headCx : L.head.x - 3}${L.w > 400 ? ` V ${L.head.y - 3}` : ''}`} marker-end="url(#f-arrow-green)" />
        <rect class="f-box f-fill-green" x={L.head.x} y={L.head.y} width={L.head.w} height={cellH} rx="6" />
        <text class="f-small" x={headCx} y={L.head.y + cellH / 2 + 4} text-anchor="middle">linear + softmax</text>
        <text class="f-small f-t-green" x={headCx} y={L.head.y + cellH + 18} text-anchor="middle">sentence label</text>
      </svg>
    );
  })}
</Figure>
