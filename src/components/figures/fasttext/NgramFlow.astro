---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Op from '../seqflow/Op.astro';
import Badge from '../seqflow/Badge.astro';
import Arrow from '../seqflow/Arrow.astro';
import Box from '../seqflow/Box.astro';
import NewMark from '../seqflow/NewMark.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The n-grams of "where" (n = 3..6, with boundary symbols) plus the whole word, as in Bojanowski et al. (2017).
const word = 'where', b = `<${word}>`;
const rows = [3, 4, 5, 6].map((n) => Array.from({ length: b.length - n + 1 }, (_, i) => b.slice(i, i + n)));
const total = rows.flat().length + 1;
if (total !== 15) throw new Error('NgramFlow: the n-gram count drifted from the note');
// Overlaps measured on the n-gram sets (n = 3..6) and nearest neighbours from the Quora run of the note.
const pairs = [
  { a: 'coffeee', b: 'coffee', shared: 15, of: 22, res: ru ? '→ coffee, косинус 0.988' : '→ coffee, cosine 0.988', good: true },
  { a: 'pyhton', b: 'python', shared: 2, of: 18, res: ru ? '→ von, ton, peyton; python не в списке' : '→ von, ton, peyton; python not among them', good: false },
];
const t = ru
  ? { table: 'векторы n-грамм', tableSub: '2 000 000 корзин', vec: 'вектор слова', unseen: 'Невиданные слова: общие n-граммы', steps: ['добавить границы: <where>', 'нарезать n-граммы, n = 3…6, и само слово', 'найти вектор каждой n-граммы (хеш → корзина)', 'сложить: вектор слова'] }
  : { table: 'n-gram vectors', tableSub: '2,000,000 buckets', vec: 'word vector', unseen: 'Unseen words: shared n-grams', steps: ['add boundaries: <where>', 'cut into n-grams, n = 3…6, plus the word', 'look up each n-gram vector (hash → bucket)', 'sum: the word vector'] };
const id = 'fasttext-ngram-flow';
const chipW = 56, chipH = 20;
const layouts = [
  { cls: 'fig-wide', W: 760, H: 330, wordX: 10, wordY: 40, bX: 10, bY: 110, gX: 150, gY: 22, tX: 520, tY: 64, sX: 690, sY: 98, vX: 722, vY: 54, barY: 228, legend: [8, 318], step: 130, rows: 1 },
  { cls: 'fig-narrow seq-narrow', W: 380, H: 640, wordX: 20, wordY: 20, bX: 140, bY: 20, gX: 30, gY: 88, tX: 30, tY: 236, sX: 250, sY: 254, vX: 290, vY: 210, barY: 336, legend: [8, 604], step: 180, rows: 2 },
];
---

<Figure
  id={id}
  title={ru ? 'Слово как сумма векторов n-грамм' : 'A word as a sum of n-gram vectors'}
  caption={ru
    ? `К слову where добавляются границы (1), и оно режется на все n-граммы длины от 3 до 6; вместе с самим словом это ${total} частей (2). Каждая часть хешируется в одну из двух миллионов корзин таблицы, где хранится её вектор (3), и вектор слова — сумма этих векторов (4). Снизу: слово с опечаткой, сохранившее большую часть n-грамм, получает вектор рядом с правильным словом; перестановка двух букв ломает почти все n-граммы, и вектор оказывается далеко.`
    : `The word where gets boundary symbols (1) and is cut into all n-grams of length 3 to 6; with the word itself that is ${total} pieces (2). Each piece is hashed into one of two million buckets of a table that holds its vector (3), and the word vector is the sum of these vectors (4). Bottom: a misspelling that keeps most of the n-grams gets a vector next to the correct word; swapping two letters breaks almost all n-grams, and the vector lands far away.`}
>
  {layouts.map((L) => {
    const narrow = L.cls.includes('narrow');
    const gridH = rows.length * (chipH + 8) + chipH;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'N-граммы слова where и их сумма' : 'The n-grams of where and their sum'}</title>
        <desc id={`${id}-${L.W}-d`}>{`${rows.map((r) => r.join(' ')).join('; ')}; ${b}. ${pairs.map((p) => `${p.a} / ${p.b}: ${p.shared} / ${p.of}`).join('; ')}.`}</desc>
        <Vec x={L.wordX} y={L.wordY} values={[word]} tone="x" cw={70} />
        <g data-s="1">
          <Arrow pts={narrow ? [[L.wordX + 70, L.wordY + 11], [L.bX - 2, L.bY + 11]] : [[L.wordX + 35, L.wordY + 22], [L.wordX + 35, L.bY - 2]]} />
          <Vec x={L.bX} y={L.bY} values={[b]} tone="x" cw={80} />
          <Badge x={L.bX + 8} y={L.bY + 36} n={1} />
        </g>
        <g data-s="2">
          <NewMark x={L.gX - 8} y={L.gY - 10} w={narrow ? 356 : 5 * (chipW + 6) + 50} h={gridH + 20} label={ru ? 'новое' : 'new'} at="br" />
          {!narrow && <Arrow pts={[[L.bX + 80, L.bY + 11], [L.gX - 12, L.bY + 11]]} />}
          {narrow && <Arrow pts={[[L.bX + 40, L.bY + 22], [L.bX + 40, L.gY - 12]]} />}
          {rows.map((r, k) => (
            <g>
              <text class="f-small f-t-muted" x={L.gX} y={L.gY + k * (chipH + 8) + 15}>{`n=${r[0].length}`}</text>
              {r.map((g, i) => <Vec x={L.gX + 40 + i * (chipW + 6)} y={L.gY + k * (chipH + 8)} values={[g]} tone="x" cw={chipW} ch={chipH} />)}
            </g>
          ))}
          <text class="f-small f-t-muted" x={L.gX} y={L.gY + rows.length * (chipH + 8) + 15}>{ru ? 'слово' : 'word'}</text>
          <Vec x={L.gX + 40} y={L.gY + rows.length * (chipH + 8)} values={[b]} tone="x" cw={chipW + 14} ch={chipH} />
          <Badge x={narrow ? L.gX + 2 : L.gX + 5 * (chipW + 6) + 52} y={narrow ? L.gY - 24 : L.gY + 4} n={2} />
        </g>
        <g data-s="3">
          {narrow
            ? <Arrow pts={[[L.gX + 140, L.gY + gridH + 2], [L.gX + 140, L.tY - 2]]} />
            : <Arrow pts={[[L.gX + 5 * (chipW + 6) + 44, L.tY + 34], [L.tX - 2, L.tY + 34]]} />}
          <Box x={L.tX} y={L.tY} w={narrow ? 180 : 140} h={68} label={t.table} sub={t.tableSub} tone="g" subGap={narrow ? 21 : 15} />
          <Badge x={L.tX + (narrow ? 180 : 140) - 4} y={L.tY} n={3} />
        </g>
        <g data-s="4">
          <Arrow pts={[[L.tX + (narrow ? 180 : 140), L.sY], [L.sX - 15, L.sY]]} />
          <Op x={L.sX} y={L.sY} sym="Σ" />
          <Arrow pts={[[L.sX + 13, L.sY], [L.vX - 2, L.sY]]} tone="blue" bold />
          <Vec x={L.vX} y={L.vY} values={['', '', '', '']} tone="h" cw={34} bold />
          <text class="f-small f-t-blue" x={narrow ? L.vX + 17 : L.W - 4} y={L.vY + 106} text-anchor={narrow ? 'middle' : 'end'}>{t.vec}</text>
          <Badge x={L.sX} y={L.sY - 24} n={4} />
        </g>
        <text class="f-small f-t-muted" x="8" y={L.barY - 14}>{t.unseen}</text>
        {pairs.map((p, i) => {
          const y = L.barY + i * (narrow ? 112 : 48), x0 = narrow ? 8 : 190, w = narrow ? 260 : 200;
          return (
            <g>
              <text class="f-small" x={narrow ? 8 : 180} y={narrow ? y + 2 : y + 15} text-anchor={narrow ? 'start' : 'end'}>{`${p.a} ↔ ${p.b}`}</text>
              <rect x={x0} y={narrow ? y + 12 : y} width={w} height="20" rx="4" class="f-box-soft" />
              <rect x={x0} y={narrow ? y + 12 : y} width={(w * p.shared) / p.of} height="20" rx="4" style={`fill: var(--fig-${p.good ? 'blue' : 'red'}); fill-opacity: 0.45`} />
              <text class="f-small" x={x0 + w + 8} y={narrow ? y + 27 : y + 15}>{`${p.shared} / ${p.of}`}</text>
              <text class={`f-small ${p.good ? 'f-t-blue' : 'f-t-red'}`} x={narrow ? 8 : x0 + w + 60} y={narrow ? y + 56 : y + 15}>{p.res}</text>
            </g>
          );
        })}
        <Legend x={L.legend[0]} y={L.legend[1]} step={L.step} rows={L.rows} />
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
