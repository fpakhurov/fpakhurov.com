---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
const copy = ru
  ? {
      title: 'Форма запроса и значение передаются отдельно',
      caption: 'Драйвер преобразует плейсхолдер %s в параметр $1. Апостроф и SQL-подобные слова внутри значения остаются частью текста для сравнения.',
      desc: 'PostgreSQL разбирает текст с параметром $1 и связывает с ним одно строковое значение целиком.',
      labels: ['Разобрать запрос', 'Связать значение', 'Выполнить сравнение'],
      result: 'Результат · 0 строк',
    }
  : {
      title: 'The statement and the value travel separately',
      caption: 'The driver translates the %s placeholder to parameter $1. The quote and SQL-like words in the value remain part of the text being compared.',
      desc: 'PostgreSQL parses a statement with parameter $1, then binds the entire string as one value.',
      labels: ['Parse the statement', 'Bind the value', 'Execute the comparison'],
      result: 'Result · 0 rows',
    };
const rows = ['WHERE product = $1', "tea' OR TRUE --", copy.result];
---
<Figure id="sql-bind-value" title={copy.title} caption={copy.caption}>
  <svg viewBox="0 0 350 238" role="img" aria-labelledby="sql-bind-title sql-bind-desc" style="max-width: 520px; margin-inline: auto">
    <title id="sql-bind-title">{copy.title}</title>
    <desc id="sql-bind-desc">{copy.desc}</desc>
    {rows.map((row, i) => (
      <g transform={`translate(0 ${i * 77})`}>
        <text class="f-label" x="175" y="18" text-anchor="middle">{copy.labels[i]}</text>
        <rect class={i === 1 ? 'f-fill-amber' : 'f-fill-blue'} x="24" y="27" width="302" height="35" rx="8" />
        <text class="f-label" x="175" y="49" text-anchor="middle">{row}</text>
        {i < 2 && <path class="f-line" d="M 175 65 V 79 M 171 75 L 175 79 L 179 75" />}
      </g>
    ))}
  </svg>
</Figure>
