---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Memory that one attention head needs for one sequence, in 16-bit numbers (2 bytes), head width d = 64.
// Standard attention keeps the T x T matrix of scores (and then of probabilities) next to Q, K, V and O:
// T^2 + 4Td numbers. FlashAttention keeps Q, K, V, O and one 32-bit statistic per row (the logsumexp):
// 4Td numbers plus 4T bytes. Both axes are logarithmic.
const d = 64;
const std = (T: number) => (T * T + 4 * T * d) * 2;
const flash = (T: number) => 4 * T * d * 2 + 4 * T;
const lx: [number, number] = [7, 17]; // log2 T
const ly: [number, number] = [4, 11]; // log10 bytes
const hbm = 80e9; // one A100 80 GB
const ratio = std(32768) / flash(32768);
if (Math.round(ratio) !== 128) throw new Error(`ratio at T = 32768 is ${ratio}`);
if (Math.abs(std(32768) / 1e9 - 2.164) > 0.001) throw new Error(`standard at T = 32768 is ${std(32768)}`);
if (Math.abs(flash(32768) / 1e6 - 16.9) > 0.05) throw new Error(`flash at T = 32768 is ${flash(32768)}`);
if (256 * 256 !== 4 * 256 * d) throw new Error('crossover: T^2 should equal 4Td at T = 4d = 256');

interface Layout { cls: string; W: number; H: number; box: [number, number, number, number]; xt: number[]; legend: [number, number] }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 330, box: [96, 24, 724, 270], xt: [7, 10, 13, 15, 17], legend: [112, 58] },
  { cls: 'fig-narrow', W: 360, H: 360, box: [70, 24, 330, 290], xt: [7, 10, 13, 16], legend: [82, 58] },
];
const yTicks = ru
  ? ['10 кБ', '100 кБ', '1 МБ', '10 МБ', '100 МБ', '1 ГБ', '10 ГБ', '100 ГБ']
  : ['10 kB', '100 kB', '1 MB', '10 MB', '100 MB', '1 GB', '10 GB', '100 GB'];
const t = ru
  ? { std: 'стандартное: T² + 4Td', flash: 'FlashAttention: 4Td + 2T', gpu: 'одна A100: 80 ГБ', x: 'длина последовательности T' }
  : { std: 'standard attention: T² + 4Td', flash: 'FlashAttention: 4Td + 2T', gpu: 'one A100: 80 GB', x: 'sequence length T' };
const plots = layouts.map((L) => {
  const [x0, y0, x1, y1] = L.box;
  const sx = scale(lx, [x0, x1]);
  const sy = scale(ly, [y1, y0]);
  const path = (f: (T: number) => number) =>
    Array.from({ length: 81 }, (_, k) => lx[0] + ((lx[1] - lx[0]) * k) / 80)
      .map((l, k) => `${k ? 'L' : 'M'} ${sx(l).toFixed(1)} ${sy(Math.log10(f(2 ** l))).toFixed(1)}`)
      .join(' ');
  return { L, sx, sy, stdPath: path(std), flashPath: path(flash) };
});
const id = 'attention-memory';
const fmtT = (l: number) => (ru ? String(2 ** l) : (2 ** l).toLocaleString('en-US'));
---

<Figure
  id={id}
  title={ru ? 'Память внимания одной головы при росте T' : 'Memory of one attention head as T grows'}
  caption={ru
    ? `Память, которую одна голова внимания занимает на одну последовательность, в 16-битных числах, при ширине головы d = ${d}. Стандартная реализация хранит матрицу оценок T × T рядом с Q, K, V и O, всего T² + 4Td чисел; FlashAttention хранит только Q, K, V, O и одну 32-битную статистику на строку. Кривые совпадают при T = 4d = 256, а дальше квадратичный член доминирует: при T = 32 768 это 2.16 ГБ против 16.9 МБ, в ${Math.round(ratio)} раз больше. Для модели с 32 головами матрица оценок одного слоя при этой длине занимает уже 68.7 ГБ. Обе оси логарифмические.`
    : `Memory that one attention head takes for one sequence, in 16-bit numbers, with head width d = ${d}. The standard implementation keeps the T × T matrix of scores next to Q, K, V and O, T² + 4Td numbers in all; FlashAttention keeps only Q, K, V, O and one 32-bit statistic per row. The curves meet at T = 4d = 256, and beyond that the quadratic term dominates: at T = 32,768 it is 2.16 GB against 16.9 MB, ${Math.round(ratio)} times more. For a model with 32 heads, the score matrix of one layer at that length takes 68.7 GB. Both axes are logarithmic.`}
>
  {plots.map(({ L, sx, sy, stdPath, flashPath }) => {
    const [x0, y0, x1, y1] = L.box;
    const xs = sx(15), ys = sy(Math.log10(std(32768))), yf = sy(Math.log10(flash(32768)));
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Память стандартного внимания и FlashAttention в зависимости от длины последовательности' : 'Memory of standard attention and of FlashAttention against sequence length'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'График в логарифмических осях: по горизонтали длина последовательности от 128 до 131 072, по вертикали байты от 10 килобайт до 100 гигабайт. Кривая стандартного внимания растёт квадратично и при длине 131 072 подходит к 34 гигабайтам; кривая FlashAttention растёт линейно и остаётся ниже 100 мегабайт. При длине 32 768 между ними множитель 128. Пунктир отмечает 80 гигабайт памяти одной A100.'
          : 'A log-log plot: sequence length from 128 to 131,072 on the horizontal axis, bytes from 10 kilobytes to 100 gigabytes on the vertical axis. The standard-attention curve grows quadratically and approaches 34 gigabytes at length 131,072; the FlashAttention curve grows linearly and stays below 100 megabytes. At length 32,768 the two differ by a factor of 128. A dashed line marks the 80 gigabytes of one A100.'}</desc>
        <path class="f-axis" d={`M ${x0} ${y0} V ${y1} H ${x1}`} />
        {yTicks.map((label, k) => (
          <g>
            <path class="f-grid" d={`M ${x0} ${sy(ly[0] + k)} H ${x1}`} />
            <text class="f-note" x={x0 - 8} y={sy(ly[0] + k) + 5} text-anchor="end">{label}</text>
          </g>
        ))}
        {L.xt.map((l) => (
          <g>
            <path class="f-axis" d={`M ${sx(l)} ${y1} v 5`} />
            <text class="f-note" x={sx(l)} y={y1 + 20} text-anchor="middle">{fmtT(l)}</text>
          </g>
        ))}
        <text class="f-note" x={x1} y={y1 + 38} text-anchor="end">{t.x}</text>
        <path class="f-line f-muted f-dash" d={`M ${x0} ${sy(Math.log10(hbm))} H ${x1}`} />
        <text class="f-small f-t-muted f-halo" x={x0 + 8} y={sy(Math.log10(hbm)) + 16}>{t.gpu}</text>
        <path class="f-line f-red f-bold" d={stdPath} />
        <path class="f-line f-blue f-bold" d={flashPath} />
        <path class="f-line f-muted" d={`M ${xs} ${ys + 4} V ${yf - 4}`} marker-end="url(#f-arrow-muted)" />
        <circle cx={xs} cy={ys} r="4" class="f-solid-red" />
        <circle cx={xs} cy={yf} r="4" class="f-solid-blue" />
        <text class="f-small f-halo" x={xs + 8} y={(ys + yf) / 2 + 5}>× {Math.round(ratio)}</text>
        <g>
          <path class="f-line f-red f-bold" d={`M ${L.legend[0]} ${L.legend[1]} h 22`} />
          <text class="f-small f-halo" x={L.legend[0] + 30} y={L.legend[1] + 4.5}>{t.std}</text>
          <path class="f-line f-blue f-bold" d={`M ${L.legend[0]} ${L.legend[1] + 22} h 22`} />
          <text class="f-small f-halo" x={L.legend[0] + 30} y={L.legend[1] + 26.5}>{t.flash}</text>
        </g>
      </svg>
    );
  })}
</Figure>
