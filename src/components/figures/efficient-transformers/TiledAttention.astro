---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import Sub from '../generative-modeling/Sub.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// FlashAttention for one block of queries, in the loop order of FlashAttention-2: Q, K, V and O live in HBM,
// split into 4 blocks of rows; the query block Q_2 is loaded into SRAM once, then each key-value block in turn.
// Each step computes one tile S_2j of the T x T score matrix in SRAM, updates the running statistics m, l and the
// unnormalized output, and discards the tile. Only O_2 and the logsumexp L_2 go back to HBM.
const nb = 4;
const row = 2; // the query block followed in the figure
const t = ru
  ? {
      hbm: 'HBM: большая, медленная', hbmSub: '40–80 ГБ, 1.5–2.0 ТБ/с (A100)',
      sram: 'SRAM: малая, быстрая', sramSub: '192 КБ на SM, около 19 ТБ/с',
      grid: 'оценки S = QKᵀ/√d, T × T', gridSub: 'считаются по плиткам, не хранятся',
      blocks: 'блоки по B строк',
      load: 'загрузить Q₂ один раз, затем K_j, V_j', write: `записать O₂ = Õ/ℓ и L₂ = m + log ℓ`,
      others: ['остальные блоки запросов', 'обрабатываются так же, параллельно'],
      f1: "m′ = max(m, rowmax S)", f2: "ℓ ← e^(m−m′)·ℓ + Σ e^(S−m′)", f3: "Õ ← e^(m−m′)·Õ + e^(S−m′)·V",
      steps: [
        'Q, K, V лежат в HBM, разбитые на блоки строк',
        'загрузить блок запросов Q₂ в SRAM; m = −∞, ℓ = 0, Õ = 0',
        'загрузить K₁, V₁ и вычислить одну плитку S₂₁ в SRAM',
        'обновить m, ℓ и Õ; плитка больше не нужна',
        'то же для K₂, V₂ … K₄, V₄: плитки строки проходят по одной',
        'разделить Õ на ℓ и записать O₂ и L₂ в HBM',
      ],
    }
  : {
      hbm: 'HBM: large, slow', hbmSub: '40–80 GB, 1.5–2.0 TB/s (A100)',
      sram: 'SRAM: small, fast', sramSub: '192 KB per SM, about 19 TB/s',
      grid: 'scores S = QKᵀ/√d, T × T', gridSub: 'computed tile by tile, never stored',
      blocks: 'blocks of B rows',
      load: 'load Q₂ once, then K_j, V_j', write: 'write O₂ = Õ/ℓ and L₂ = m + log ℓ',
      others: ['the other query blocks do the same,', 'in parallel'],
      f1: "m′ = max(m, rowmax S)", f2: "ℓ ← e^(m−m′)·ℓ + Σ e^(S−m′)", f3: "Õ ← e^(m−m′)·Õ + e^(S−m′)·V",
      steps: [
        'Q, K, V sit in HBM, split into blocks of rows',
        'load the query block Q₂ into SRAM; m = −∞, ℓ = 0, Õ = 0',
        'load K₁, V₁ and compute one tile S₂₁ in SRAM',
        'update m, ℓ and Õ; the tile is no longer needed',
        'the same for K₂, V₂ … K₄, V₄: the tiles of the row one at a time',
        'divide Õ by ℓ and write O₂ and L₂ to HBM',
      ],
    };
if (t.steps.length !== 6) throw new Error('six steps expected');

interface Layout {
  cls: string; W: number; H: number;
  hbm: [number, number, number, number]; cols: number[]; bw: number; bh: number; colTop: number;
  grid: [number, number]; tile: number; gridTitle: [number, number];
  sram: [number, number, number, number]; sx: number[]; sTop: number; statTop: number; fTop: number; fStep: number;
  load: string; loadAt: [number, number, 'start' | 'middle' | 'end'];
  write: string; writeAt: [number, number, 'start' | 'middle' | 'end'];
  othersAt: [number, number, number]; legend: [number, number]; lstep: number; lrows: number;
  badges: [number, number][];
}
const layouts: Layout[] = [
  {
    cls: 'fig-wide', W: 760, H: 450,
    hbm: [10, 34, 238, 262], cols: [24, 74, 124, 174, 220], bw: 34, bh: 34, colTop: 116,
    grid: [300, 116], tile: 40, gridTitle: [380, 58],
    sram: [512, 34, 240, 262], sx: [526, 574, 622, 672], sTop: 116, statTop: 196, fTop: 248, fStep: 18,
    load: 'M 92 296 V 330 H 590 V 298', loadAt: [380, 320, 'middle'],
    write: 'M 690 296 V 372 H 210 V 298', writeAt: [450, 362, 'middle'],
    othersAt: [380, 400, 0], legend: [8, 436], lstep: 130, lrows: 1,
    badges: [[22, 56], [520, 106], [300, 156], [680, 244], [474, 176], [706, 350]],
  },
  {
    cls: 'fig-narrow seq-narrow', W: 360, H: 900,
    hbm: [26, 18, 308, 232], cols: [44, 98, 152, 206, 260], bw: 34, bh: 26, colTop: 104,
    grid: [108, 344], tile: 36, gridTitle: [180, 300],
    sram: [26, 548, 308, 272], sx: [44, 94, 144, 198], sTop: 634, statTop: 706, fTop: 764, fStep: 20,
    load: 'M 26 150 H 12 V 680 H 24', loadAt: [30, 272, 'start'],
    write: 'M 334 720 H 348 V 140 H 336', writeAt: [334, 842, 'end'],
    othersAt: [180, 510, 20], legend: [8, 866], lstep: 180, lrows: 2,
    badges: [[38, 40], [34, 622], [108, 380], [220, 760], [266, 398], [64, 838]],
  },
];
const id = 'flash-attention-tiles';
const blockLabel = (name: string, k: number) => `${name}_${k}`;
---

<Figure
  id={id}
  title={ru ? 'FlashAttention: блоки Q, K, V проходят через SRAM' : 'FlashAttention: blocks of Q, K and V pass through SRAM'}
  caption={ru
    ? 'Один блок запросов, в порядке циклов FlashAttention-2. Q, K, V и выход O лежат в большой медленной памяти HBM, разбитые на четыре блока строк (1). Блок запросов Q₂ один раз загружается в маленькую быструю SRAM, а вместе с ним заводятся три статистики для каждой строки: текущий максимум m, текущая сумма экспонент ℓ и ненормированный выход Õ (2). Затем по очереди приходят блоки K_j, V_j: каждый даёт одну плитку S₂ⱼ матрицы оценок (3), по ней обновляются m, ℓ и Õ, после чего плитка выбрасывается (4, 5). Пунктирная сетка T × T существует только как порядок обхода и никогда не записывается в HBM. В конце Õ делится на ℓ, и в HBM записываются только O₂ и одно число на строку, L₂ = m + log ℓ, нужное обратному проходу (6). Цифры пропускной способности и объёма относятся к A100.'
    : 'One query block, in the loop order of FlashAttention-2. Q, K, V and the output O sit in the large, slow HBM, split into four blocks of rows (1). The query block Q₂ is loaded once into the small, fast SRAM, together with three per-row statistics: the running maximum m, the running sum of exponentials ℓ and the unnormalized output Õ (2). The blocks K_j, V_j then arrive one at a time: each gives one tile S₂ⱼ of the score matrix (3), which updates m, ℓ and Õ and is then discarded (4, 5). The dashed T × T grid exists only as an order of work and is never written to HBM. At the end Õ is divided by ℓ, and only O₂ and one number per row, L₂ = m + log ℓ, which the backward pass needs, are written to HBM (6). The bandwidths and sizes are those of an A100.'}
>
  {layouts.map((L) => {
    const [hx, hy, hw, hh] = L.hbm;
    const [gx, gy] = L.grid;
    const [sx0, sy0, sw, sh] = L.sram;
    const names = ['Q', 'K', 'V', 'O'];
    const tone = (k: number) => (k === 3 ? toneVar.y : toneVar.x);
    const tileX = (j: number) => gx + (j - 1) * L.tile;
    const tileY = (i: number) => gy + (i - 1) * L.tile;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Вычисление внимания по плиткам между HBM и SRAM' : 'Tiled attention between HBM and SRAM'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Слева или сверху панель HBM со столбцами блоков Q, K, V, O и L. В середине пунктирная сетка четыре на четыре плитки матрицы оценок; вторая строка плиток выделена, её первая плитка S₂₁ закрашена. Справа или снизу панель SRAM с блоками Q₂, K_j, V_j, плиткой S₂ⱼ, статистиками m, ℓ, Õ и тремя формулами обновления. Стрелка загрузки идёт из HBM в SRAM, стрелка записи O₂ и L₂ — обратно.'
          : 'An HBM panel with columns of blocks for Q, K, V, O and L. In the middle a dashed four-by-four grid of tiles of the score matrix; the second row of tiles is highlighted and its first tile, S₂₁, filled. An SRAM panel with the blocks Q₂, K_j, V_j, the tile S₂ⱼ, the statistics m, ℓ, Õ and three update formulas. A load arrow runs from HBM to SRAM, and a write arrow carries O₂ and L₂ back.'}</desc>

        {/* 1: HBM with the blocks */}
        <g data-s="1">
          <rect x={hx} y={hy} width={hw} height={hh} rx="10" class="f-box-soft" />
          <text class="f-title" x={hx + 28} y={hy + 26}>{t.hbm}</text>
          <text class="f-small f-t-muted" x={hx + 14} y={hy + 46}>{t.hbmSub}</text>
          {names.map((n, k) => (
            <g>
              <text class="f-label" x={L.cols[k] + L.bw / 2} y={L.colTop - 8} text-anchor="middle">{n}</text>
              {Array.from({ length: nb }, (_, b) => (
                <g>
                  <rect x={L.cols[k]} y={L.colTop + b * L.bh} width={L.bw} height={L.bh} style={`fill: ${tone(k)}; fill-opacity: ${k === 3 ? 0.06 : 0.14}; stroke: ${tone(k)}; stroke-width: 1.2`} />
                  <text class="f-small" x={L.cols[k] + L.bw / 2} y={L.colTop + b * L.bh + L.bh / 2 + 4.5} text-anchor="middle">{b + 1}</text>
                </g>
              ))}
            </g>
          ))}
          <text class="f-label" x={L.cols[4] + 6} y={L.colTop - 8} text-anchor="middle">L</text>
          {Array.from({ length: nb }, (_, b) => (
            <rect x={L.cols[4]} y={L.colTop + b * L.bh} width="12" height={L.bh} style={`fill: ${toneVar.y}; fill-opacity: 0.06; stroke: ${toneVar.y}; stroke-width: 1.2`} />
          ))}
          <text class="f-small f-t-muted" x={hx + 14} y={L.colTop + nb * L.bh + 22}>{t.blocks}</text>
          <Badge x={L.badges[0][0]} y={L.badges[0][1]} n={1} />
        </g>

        {/* the T x T grid: never stored */}
        <g>
          <text class="f-small" x={L.gridTitle[0]} y={L.gridTitle[1]} text-anchor="middle">{t.grid}</text>
          <text class="f-small f-t-muted" x={L.gridTitle[0]} y={L.gridTitle[1] + 18} text-anchor="middle">{t.gridSub}</text>
          {Array.from({ length: nb }, (_, j) => (
            <text class="f-small f-t-muted" x={tileX(j + 1) + L.tile / 2} y={gy - 8} text-anchor="middle">{`j=${j + 1}`}</text>
          ))}
          {Array.from({ length: nb }, (_, i) => (
            <text class="f-small f-t-muted" x={gx - 8} y={tileY(i + 1) + L.tile / 2 + 4.5} text-anchor="end">{`i=${i + 1}`}</text>
          ))}
          {Array.from({ length: nb * nb }, (_, k) => (
            <rect x={tileX((k % nb) + 1)} y={tileY(Math.floor(k / nb) + 1)} width={L.tile} height={L.tile} class="f-grid f-dash" style="fill: none" />
          ))}
        </g>
        <g data-s="3">
          <rect x={tileX(1) + 1.5} y={tileY(row) + 1.5} width={L.tile - 3} height={L.tile - 3} style={`fill: ${toneVar.g}; fill-opacity: 0.35; stroke: ${toneVar.g}; stroke-width: 1.6`} />
          <text class="f-small" x={tileX(1) + L.tile / 2} y={tileY(row) + L.tile / 2 + 4.5} text-anchor="middle"><Sub label="S_{21}" /></text>
          <Badge x={L.badges[2][0]} y={L.badges[2][1]} n={3} />
        </g>
        <g data-s="5">
          {[2, 3, 4].map((j) => (
            <rect x={tileX(j) + 1.5} y={tileY(row) + 1.5} width={L.tile - 3} height={L.tile - 3} style={`fill: ${toneVar.g}; fill-opacity: 0.14; stroke: ${toneVar.g}; stroke-width: 1.2; stroke-dasharray: 4 3`} />
          ))}
          <path class="f-line f-amber" d={`M ${tileX(1) + L.tile - 4} ${tileY(row) + L.tile / 2} H ${tileX(nb) + L.tile - 8}`} marker-end="url(#f-arrow-amber)" />
          <Badge x={L.badges[4][0]} y={L.badges[4][1]} n={5} />
        </g>

        {/* SRAM */}
        <g>
          <rect x={sx0} y={sy0} width={sw} height={sh} rx="10" style={`fill: ${toneVar.h}; fill-opacity: 0.04; stroke: ${toneVar.h}; stroke-width: 1.3`} />
          <text class="f-title" x={sx0 + 14} y={sy0 + 26}>{t.sram}</text>
          <text class="f-small f-t-muted" x={sx0 + 14} y={sy0 + 46}>{t.sramSub}</text>
        </g>
        <g data-s="2">
          <rect x={L.cols[0]} y={L.colTop + (row - 1) * L.bh} width={L.bw} height={L.bh} style={`fill: none; stroke: ${toneVar.x}; stroke-width: 2.8`} />
          <text class="f-label" x={L.sx[0] + L.bw / 2} y={L.sTop - 8} text-anchor="middle"><Sub label={blockLabel('Q', row)} /></text>
          <rect x={L.sx[0]} y={L.sTop} width={L.bw} height={L.bw} style={`fill: ${toneVar.x}; fill-opacity: 0.14; stroke: ${toneVar.x}; stroke-width: 1.2`} />
          {['m', 'ℓ', 'Õ'].map((s, k) => (
            <g>
              <text class="f-label" x={L.sx[k] + (k === 2 ? 30 : L.bw / 2)} y={L.statTop - 8} text-anchor="middle">{s}</text>
              <rect x={L.sx[k]} y={L.statTop} width={k === 2 ? 60 : L.bw} height="22" style={`fill: ${toneVar.h}; fill-opacity: 0.14; stroke: ${toneVar.h}; stroke-width: 1.2`} />
            </g>
          ))}
          <Badge x={L.badges[1][0]} y={L.badges[1][1]} n={2} />
        </g>
        <g data-s="3 5">
          {['K', 'V'].map((n, k) => (
            <g>
              <text class="f-label" x={L.sx[k + 1] + L.bw / 2} y={L.sTop - 8} text-anchor="middle"><Sub label={`${n}_j`} /></text>
              <rect x={L.sx[k + 1]} y={L.sTop} width={L.bw} height={L.bw} style={`fill: ${toneVar.x}; fill-opacity: 0.14; stroke: ${toneVar.x}; stroke-width: 1.2`} />
            </g>
          ))}
          <text class="f-label" x={L.sx[3] + 20} y={L.sTop - 8} text-anchor="middle"><Sub label={`S_{${row}j}`} /></text>
          <rect x={L.sx[3]} y={L.sTop} width="40" height={L.bw} style={`fill: ${toneVar.g}; fill-opacity: 0.3; stroke: ${toneVar.g}; stroke-width: 1.4`} />
        </g>
        <g data-s="4 5">
          <text class="f-small" x={sx0 + 24} y={L.fTop}>{t.f1}</text>
          <text class="f-small" x={sx0 + 24} y={L.fTop + L.fStep}>{t.f2}</text>
          <text class="f-small" x={sx0 + 24} y={L.fTop + 2 * L.fStep}>{t.f3}</text>
          <Badge x={sx0 + 12} y={L.fTop - 4} n={4} />
        </g>

        {/* loads and the write-back */}
        <g data-s="2 3">
          <path class="f-line f-green" d={L.load} marker-end="url(#f-arrow-green)" />
          <text class="f-small f-t-green f-halo" x={L.loadAt[0]} y={L.loadAt[1]} text-anchor={L.loadAt[2]}><Sub label={t.load} /></text>
        </g>
        <g data-s="6">
          <path class="f-line f-red" d={L.write} marker-end="url(#f-arrow-red)" />
          <text class="f-small f-t-red f-halo" x={L.writeAt[0]} y={L.writeAt[1]} text-anchor={L.writeAt[2]}>{t.write}</text>
          <rect x={L.cols[3] + 1.5} y={L.colTop + (row - 1) * L.bh + 1.5} width={L.bw - 3} height={L.bh - 3} style={`fill: ${toneVar.y}; fill-opacity: 0.35; stroke: none`} />
          <rect x={L.cols[4] + 1.5} y={L.colTop + (row - 1) * L.bh + 1.5} width="9" height={L.bh - 3} style={`fill: ${toneVar.y}; fill-opacity: 0.35; stroke: none`} />
          {L.othersAt[2]
            ? t.others.map((line, k) => <text class="f-small f-t-muted" x={L.othersAt[0]} y={L.othersAt[1] + k * L.othersAt[2]} text-anchor="middle">{line}</text>)
            : <text class="f-small f-t-muted" x={L.othersAt[0]} y={L.othersAt[1]} text-anchor="middle">{t.others.join(' ')}</text>}
          <Badge x={L.badges[5][0]} y={L.badges[5][1]} n={6} />
        </g>
        <Legend x={L.legend[0]} y={L.legend[1]} step={L.lstep} rows={L.lrows} />
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
