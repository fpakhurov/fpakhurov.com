---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Op from '../seqflow/Op.astro';
import Badge from '../seqflow/Badge.astro';
import Arrow from '../seqflow/Arrow.astro';
import Box from '../seqflow/Box.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import Sub from '../generative-modeling/Sub.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One MoE layer with 8 experts and top-2 routing, for three tokens. The router scores of the first token are the
// worked example of the note; its two gates are the softmax over its two largest scores. The other two tokens go
// to other pairs, so every expert is stored but each token runs only two of them.
const E = 8;
const logits = [1.2, -0.3, 2.0, 0.1, 0.5, 1.9, -1.0, 0.0];
const z = logits.reduce((a, v) => a + Math.exp(v), 0);
const probs = logits.map((v) => Math.exp(v) / z);
const order = logits.map((_, i) => i).sort((a, b) => logits[b] - logits[a]);
const top = [order[0] + 1, order[1] + 1];
if (top[0] !== 3 || top[1] !== 6) throw new Error(`top-2 experts are ${top}`);
const g1 = 1 / (1 + Math.exp(logits[5] - logits[2]));
const gates = [g1, 1 - g1];
if (gates[0].toFixed(3) !== '0.525' || gates[1].toFixed(3) !== '0.475') throw new Error(`gates ${gates}`);
if (probs[2].toFixed(2) !== '0.33' || probs[5].toFixed(2) !== '0.30') throw new Error(`probabilities ${probs}`);
const routes = [top, [1, 3], [6, 8]];
const used = new Set(routes.flat());
const words = ['dogs', 'chase', 'cats'];
const t = ru
  ? { probs: 'вероятности роутера для «dogs»', experts: '8 экспертов (SwiGLU FFN)', router: 'роутер',
      note: ['хранятся все 8 экспертов;', 'каждый токен использует только 2'],
      steps: ['нормализованное скрытое состояние каждого токена', 'роутер: 8 оценок u·W_r и softmax по ним', 'top-2: каждый токен идёт к двум экспертам с наибольшими оценками', 'работают только выбранные эксперты; остальные 6 для этого токена пропускаются', 'выход: сумма двух выходов экспертов, взвешенных гейтами'] }
  : { probs: 'router probabilities of “dogs”', experts: '8 experts (SwiGLU FFNs)', router: 'router',
      note: ['all 8 experts are stored;', 'each token runs only 2 of them'],
      steps: ['the normalized hidden state of each token', 'router: 8 scores u·W_r and a softmax over them', 'top 2: each token goes to the 2 experts with the highest scores', 'only the chosen experts run; the other 6 are skipped for that token', 'output: the sum of the 2 expert outputs, weighted by the gates'] };

interface Layout {
  cls: string; W: number; H: number; wide: boolean;
  tok: [number, number][]; cw: number; router: [number, number][]; rw: number;
  ex: [number, number][]; ew: number; eh: number;
  sum: [number, number][]; out: [number, number][];
  gateAt: [number, number, 'start' | 'end'][];
  noteAt: [number, number, number]; legend: [number, number]; lstep: number; lrows: number;
  badges: [number, number][];
  prob: { x0: number; step: number; w: number; y: number; h: number; head: [number, number] };
}
const wideEx = Array.from({ length: E }, (_, i) => [410, 36 + i * 44] as [number, number]);
const narrowEx = Array.from({ length: E }, (_, i) => [20 + i * 41, 286] as [number, number]);
const layouts: Layout[] = [
  {
    cls: 'fig-wide', W: 760, H: 446, wide: true,
    tok: [[24, 104], [24, 222], [24, 330]], cw: 16, router: [[152, 104], [152, 222], [152, 330]], rw: 60,
    ex: wideEx, ew: 100, eh: 36,
    sum: [[606, 104], [606, 222], [606, 330]], out: [[640, 104], [640, 222], [640, 330]],
    gateAt: [[396, 130, 'end'], [404, 302, 'end']],
    noteAt: [455, 404, 0], legend: [8, 432], lstep: 130, lrows: 1,
    badges: [[12, 104], [84, 45], [196, 86], [398, 20], [606, 80]],
    prob: { x0: 96, step: 24, w: 24, y: 36, h: 18, head: [96, 26] },
  },
  {
    cls: 'fig-narrow seq-narrow', W: 360, H: 624, wide: false,
    tok: [[32, 101], [152, 101], [272, 101]], cw: 14, router: [[60, 148], [180, 148], [300, 148]], rw: 60,
    ex: narrowEx, ew: 36, eh: 40,
    sum: [[60, 396], [180, 396], [300, 396]], out: [[32, 447], [152, 447], [272, 447]],
    gateAt: [[80, 228, 'end'], [160, 222, 'start']],
    noteAt: [180, 534, 20], legend: [8, 588], lstep: 180, lrows: 2,
    badges: [[18, 101], [18, 148], [40, 206], [10, 278], [36, 396]],
    prob: { x0: 20, step: 41, w: 36, y: 30, h: 22, head: [20, 20] },
  },
];
const empty4 = ['', '', '', ''];
const id = 'moe-routing';
---

<Figure
  id={id}
  title={ru ? 'Слой смеси экспертов: роутер отправляет каждый токен к 2 из 8 экспертов' : 'A mixture-of-experts layer: the router sends each token to 2 of 8 experts'}
  caption={ru
    ? `Слой MoE на месте FFN одного блока, для трёх токенов. Нормализованное скрытое состояние u каждого токена (1) умножается на матрицу роутера W_r, что даёт 8 оценок, по одной на эксперта (2); для «dogs» softmax по всем восьми даёт вероятности в ячейках вверху, по порядку экспертов от 1 до 8, и две наибольшие у экспертов 3 и 6. Токен идёт к двум экспертам с наибольшими оценками (3), и гейты — это softmax по их двум оценкам, ${gates[0].toFixed(3)} и ${gates[1].toFixed(3)}, как в Mixtral. Работают только выбранные эксперты: эксперты 2, 4, 5 и 7 не нужны ни одному из трёх токенов (4). Выход токена — сумма двух выходов экспертов с весами гейтов (5); дальше он, как и выход FFN, прибавляется к остаточному пути.`
    : `An MoE layer in place of the FFN of one block, for three tokens. The normalized hidden state u of each token (1) is multiplied by the router matrix W_r, which gives 8 scores, one per expert (2); for “dogs”, a softmax over all eight gives the probabilities in the cells at the top, in the order of the experts 1 to 8, and the two largest belong to experts 3 and 6. The token goes to its two best experts (3), and the gates are the softmax over their two scores, ${gates[0].toFixed(3)} and ${gates[1].toFixed(3)}, as in Mixtral. Only the chosen experts run: experts 2, 4, 5 and 7 are needed by none of the three tokens (4). The token's output is the sum of the two expert outputs weighted by the gates (5); like the output of an FFN, it is then added to the residual stream.`}
>
  {layouts.map((L) => {
    const vw = 4 * L.cw;
    const exIn = (i: number) => (L.wide ? [L.ex[i - 1][0] - 2, L.ex[i - 1][1] + L.eh / 2] : [L.ex[i - 1][0] + L.ew / 2, L.ex[i - 1][1] - 2]) as [number, number];
    const exOut = (i: number) => (L.wide ? [L.ex[i - 1][0] + L.ew, L.ex[i - 1][1] + L.eh / 2] : [L.ex[i - 1][0] + L.ew / 2, L.ex[i - 1][1] + L.eh]) as [number, number];
    const rOut = (k: number) => (L.wide ? [L.router[k][0] + L.rw / 2, L.router[k][1]] : [L.router[k][0], L.router[k][1] + 13]) as [number, number];
    const sIn = (k: number) => (L.wide ? [L.sum[k][0] - 15, L.sum[k][1]] : [L.sum[k][0], L.sum[k][1] - 15]) as [number, number];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Маршрутизация трёх токенов к двум из восьми экспертов' : 'Routing three tokens to two of eight experts'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Три токена, dogs, chase и cats, каждый проходит через роутер. Линии ведут от каждого роутера к двум из восьми блоков-экспертов: dogs к экспертам 3 и 6 с весами 0.525 и 0.475, chase к 1 и 3, cats к 6 и 8. Эксперты 2, 4, 5 и 7 серые. От выбранных экспертов линии идут к сумме для каждого токена и к его выходному вектору.'
          : 'Three tokens, dogs, chase and cats, each pass through a router. Lines lead from each router to two of eight expert boxes: dogs to experts 3 and 6 with weights 0.525 and 0.475, chase to 1 and 3, cats to 6 and 8. Experts 2, 4, 5 and 7 are grey. From the chosen experts, lines lead to a sum for each token and to its output vector.'}</desc>

        {/* 3: routing lines, drawn first so that boxes sit on top */}
        <g data-s="3">
          {routes.map((r, k) => r.map((i) => (
            <path class={k === 0 ? 'f-line f-blue f-bold' : 'f-thin f-muted'} d={`M ${rOut(k)[0]} ${rOut(k)[1]} L ${exIn(i)[0]} ${exIn(i)[1]}`} marker-end={k === 0 ? 'url(#f-arrow-blue)' : 'url(#f-arrow-muted)'} />
          )))}
          {gates.map((g, n) => (
            <text class="f-small f-t-blue f-halo" x={L.gateAt[n][0]} y={L.gateAt[n][1]} text-anchor={L.gateAt[n][2]}>{g.toFixed(3)}</text>
          ))}
          <Badge x={L.badges[2][0]} y={L.badges[2][1]} n={3} />
        </g>
        {/* 5: expert outputs to the weighted sums */}
        <g data-s="5">
          {routes.map((r, k) => r.map((i) => (
            <path class={k === 0 ? 'f-line f-blue f-bold' : 'f-thin f-muted'} d={`M ${exOut(i)[0]} ${exOut(i)[1]} L ${sIn(k)[0]} ${sIn(k)[1]}`} />
          )))}
          {L.sum.map(([x, y], k) => (
            <g>
              <Op x={x} y={y} sym="Σ" />
              {L.wide
                ? <Arrow pts={[[x + 13, y], [L.out[k][0] - 2, y]]} tone="red" />
                : <Arrow pts={[[x, y + 13], [x, L.out[k][1] - 2]]} tone="red" />}
              <Vec x={L.out[k][0]} y={L.out[k][1] - (L.wide ? 11 : 0)} values={empty4} tone="y" dir="row" cw={L.cw} />
              <text class="f-math" x={L.out[k][0] + vw / 2} y={L.wide ? L.out[k][1] - 20 : L.out[k][1] + 44} text-anchor="middle"><Sub label={`y_${k + 1}`} /></text>
            </g>
          ))}
          <Badge x={L.badges[4][0]} y={L.badges[4][1]} n={5} />
        </g>

        {/* 1: tokens */}
        <g data-s="1">
          {L.tok.map(([x, y], k) => (
            <g>
              <text class="f-small f-t-muted" x={x + vw / 2} y={L.wide ? y - 18 : y - 21} text-anchor="middle">{words[k]}</text>
              <Vec x={x} y={y - 11} values={empty4} tone="h" dir="row" cw={L.cw} />
            </g>
          ))}
          <Badge x={L.badges[0][0]} y={L.badges[0][1]} n={1} />
        </g>
        {/* 2: routers and the probabilities of the first token */}
        <g data-s="2">
          {L.router.map(([x, y], k) => (
            <g>
              {L.wide
                ? <Arrow pts={[[L.tok[k][0] + vw, y], [x - L.rw / 2 - 2, y]]} />
                : <Arrow pts={[[x, L.tok[k][1] + 11], [x, y - 15]]} />}
              <Op x={x} y={y} sym={t.router} tone="amber" />
            </g>
          ))}
          <text class="f-small" x={L.prob.head[0]} y={L.prob.head[1]}>{t.probs}</text>
          {L.wide && <path class="f-thin f-amber" d={`M ${L.router[0][0]} ${L.router[0][1] - 14} V ${L.prob.y + L.prob.h + 3}`} marker-end="url(#f-arrow-amber)" />}
          {probs.map((p, i) => (
            <g>
              <rect x={L.prob.x0 + i * L.prob.step} y={L.prob.y} width={L.prob.w} height={L.prob.h} style={`fill: ${toneVar.g}; fill-opacity: ${top.includes(i + 1) ? 0.4 : 0.1}; stroke: ${toneVar.g}; stroke-width: ${top.includes(i + 1) ? 2 : 1}`} />
              <text class="f-small" x={L.prob.x0 + i * L.prob.step + L.prob.w / 2} y={L.prob.y + L.prob.h / 2 + 4.5} text-anchor="middle">{p.toFixed(2).slice(1)}</text>
            </g>
          ))}
          <Badge x={L.badges[1][0]} y={L.badges[1][1]} n={2} />
        </g>
        {/* 4: experts; the unused ones stay grey */}
        <g data-s="4">
          {L.wide && <text class="f-small" x={L.ex[0][0]} y="24">{t.experts}</text>}
          {L.ex.map(([x, y], i) => (
            <Box x={x} y={y} w={L.ew} h={L.eh} label={`E_${i + 1}`} tone={used.has(i + 1) ? 'g' : 'n'} math />
          ))}
          {L.wide
            ? <text class="f-small f-t-muted" x={L.noteAt[0]} y={L.noteAt[1]} text-anchor="middle">{t.note.join(' ')}</text>
            : t.note.map((line, k) => <text class="f-small f-t-muted" x={L.noteAt[0]} y={L.noteAt[1] + k * L.noteAt[2]} text-anchor="middle">{line}</text>)}
          <Badge x={L.badges[3][0]} y={L.badges[3][1]} n={4} />
        </g>
        <Legend x={L.legend[0]} y={L.legend[1]} step={L.lstep} rows={L.lrows} />
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
