---
// Original constructed routing counts. No model or source figure is used.
import Figure from '../Figure.astro';
import {pageLang} from '../../../utils/lang';
import cases from './cases.json';
const ru=pageLang(Astro.url)==='ru';
const count=cases.moe.counts;
---
<Figure id="expert-capacity" title={ru?'Свободные места не устраняют перегрузку другого эксперта':'Empty slots do not resolve another expert’s overload'} caption={ru?'15 назначений top-1: (6,4,3,2,0). На графике ёмкость каждого эксперта равна 3: приняты 11, пропущены 4. В таблице ёмкость растёт при тех же назначениях; перенаправление не применяется.':'15 top-1 assignments: (6,4,3,2,0). Plot capacity is 3 per expert: 11 accepted, 4 skipped. The table raises capacity while keeping assignments fixed; there is no rerouting.'}>
 <div class="layout">
 <div>
 <svg viewBox="0 0 320 230" role="img" aria-labelledby="capacity-title capacity-desc">
  <title id="capacity-title">{ru?'Ёмкость три назначения':'Capacity of three assignments'}</title>
  <desc id="capacity-desc">{ru?'Синие части показывают принятые назначения, оранжевые — превышение ёмкости. У первого эксперта превышение три, у второго одно; пятый пуст.':'Blue segments show accepted assignments; amber segments exceed capacity. Expert one overflows by three, expert two by one; expert five is empty.'}</desc>
  <path d="M30 25 V184 H305" class="f-axis" />
  {[0,3,6].map(v=><text x="22" y={188-v*24} text-anchor="end">{v}</text>)}
  <line x1="30" x2="305" y1="112" y2="112" stroke="var(--muted)" stroke-dasharray="4 3" />
  {count.map((n,i)=><g><rect data-expert={i+1} data-kind="accepted" x={48+i*52} y={184-Math.min(n,3)*24} width="25" height={Math.min(n,3)*24} fill="var(--fig-blue)" /><rect data-expert={i+1} data-kind="overflow" x={48+i*52} y={184-n*24} width="25" height={Math.max(n-3,0)*24} fill="var(--fig-amber)" /><text x={60.5+i*52} y={176-n*24} text-anchor="middle">{n}</text><text x={60.5+i*52} y="211" text-anchor="middle">E{i+1}</text></g>)}
 </svg>
 <div class="legend"><span><i class="accepted"></i>{ru?'Приняты':'Accepted'}</span><span><i class="overflow"></i>{ru?'Пропущены':'Skipped'}</span></div>
 </div>
 <table><thead><tr><th>{ru?'Ёмкость':'Capacity'}</th><th>{ru?'Пропуски':'Skipped'}</th><th>{ru?'Пусто':'Empty slots'}</th></tr></thead><tbody>{cases.moe.capacities.map(row=><tr><td>{row.capacity}</td><td>{row.dropped}</td><td>{row.empty_slots}</td></tr>)}</tbody></table>
 </div>
</Figure>
<style>
.layout{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,1fr);gap:1.25rem;align-items:center;}svg{width:100%;height:auto;display:block;max-width:500px;margin:auto;}text{font:14px system-ui,sans-serif;fill:var(--ink);font-variant-numeric:tabular-nums;}.legend{display:flex;justify-content:center;gap:1rem;flex-wrap:wrap;font-size:.9rem;}.legend i{display:inline-block;width:.8rem;height:.8rem;margin-right:.4rem;}.accepted{background:var(--fig-blue)}.overflow{background:var(--fig-amber)}table{display:table;border-collapse:collapse;width:100%;font-size:.9rem;font-variant-numeric:tabular-nums;}th,td{padding:.5rem .3rem;border-bottom:1px solid var(--line);text-align:right;}th:first-child,td:first-child{text-align:left;}th{font-weight:600;}@media(max-width:700px){.layout{grid-template-columns:1fr;}}
</style>
