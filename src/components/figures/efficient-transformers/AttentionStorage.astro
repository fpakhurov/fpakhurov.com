---
// Original storage inventory, computed from the explicitly stated array sizes.
import Figure from '../Figure.astro';
import {pageLang} from '../../../utils/lang';
import cases from './cases.json';
const ru=pageLang(Astro.url)==='ru';
const fmt=(x:number)=>Number.isInteger(x)?String(x):x.toFixed(1);
---
<Figure id="attention-storage" title={ru?'Какие массивы остаются в памяти':'Which arrays remain in memory'} caption={ru?'Одна голова, d=48. Q,K,V,O,S,P: два байта на элемент; m и ℓ: четыре. Каждая пара полос имеет собственный масштаб. Это заданный набор массивов без плиток, градиентов и аллокатора.':'One head, d=48. Q,K,V,O,S,P: two bytes per entry; m and ℓ: four. Each bar pair has its own scale. This is a specified array inventory, excluding tiles, gradients and allocator overhead.'}>
 <div class="cards">
 {cases.memory.map(row=><svg viewBox="0 0 300 170" role="img" aria-labelledby={`storage-${row.n}-title storage-${row.n}-desc`}>
  <title id={`storage-${row.n}-title`}>n = {row.n}</title>
  <desc id={`storage-${row.n}-desc`}>{ru?`Полная схема: ${row.dense_kib} КиБ; по блокам: ${row.streamed_kib} КиБ. Длина второй полосы пропорциональна отношению этих объёмов.`:`Materialized: ${row.dense_kib} KiB; streamed: ${row.streamed_kib} KiB. The second bar length is proportional to their storage ratio.`}</desc>
  <text x="20" y="24" class="heading">n = {row.n}</text>
  <text x="20" y="53">{ru?'Полная схема':'Materialized'}</text><text x="280" y="53" text-anchor="end">{fmt(row.dense_kib)} {ru?'КиБ':'KiB'}</text>
  <rect data-series="materialized" data-n={row.n} x="20" y="64" width="260" height="23" rx="3" fill="var(--fig-amber)" />
  <text x="20" y="115">{ru?'По блокам':'Streamed'}</text><text x="280" y="115" text-anchor="end">{fmt(row.streamed_kib)} {ru?'КиБ':'KiB'}</text>
  <rect data-series="streamed" data-n={row.n} x="20" y="126" width={260*row.streamed_bytes/row.dense_bytes} height="23" rx="3" fill="var(--fig-blue)" />
 </svg>)}
 </div>
</Figure>
<style>
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:1rem;}
svg{display:block;width:100%;height:auto;max-width:420px;margin:auto;}text{font:14px system-ui,sans-serif;fill:var(--ink);font-variant-numeric:tabular-nums;}.heading{font-size:17px;font-weight:600;}
</style>
