---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? "Один интервал внутри магазина 1" : "One interval inside shop 1";
const caption = ru ? "Фильтр даты выбирает два соседних ключа внутри магазина 1. Заказ 201 имеет ту же дату в магазине 2." : "The date filter selects two adjacent keys within shop 1. Order 201 is on the same date in shop 2.";
const desc = ru ? "Шесть ключей идут по магазину, дате и номеру заказа. Второй и третий входят в выбранный интервал." : "The six keys are ordered by shop, date and order ID. The second and third keys belong to the selected interval.";
const keys = [
  [1, '01-01', 101], [1, '01-02', 102], [1, '01-02', 103],
  [1, '01-03', 104], [2, '01-02', 201], [2, '01-03', 202],
] as const;
const headings = ru ? ['Магазин', 'Дата', 'Заказ'] : ['Shop', 'Date', 'Order'];
---
<Figure id="db-shop-day-keys" title={title} caption={caption}>
  <svg viewBox="0 0 340 228" role="img" aria-labelledby="db-shop-day-keys-title db-shop-day-keys-desc" style="max-width: 550px; margin-inline: auto">
    <title id="db-shop-day-keys-title">{title}</title>
    <desc id="db-shop-day-keys-desc">{desc}</desc>
    {headings.map((heading, index) => (
      <text class="f-label" x={69 + index * 101} y="26" text-anchor="middle">{heading}</text>
    ))}
    {keys.map(([shop, date, order], index) => (
      <g transform={`translate(0 ${index * 31})`}>
        <rect class={index === 1 || index === 2 ? 'f-fill-green' : 'f-fill-blue'} x="22" y="34" width="296" height="26" rx="4" />
        <text class="f-label" x="69" y="52" text-anchor="middle">{shop}</text>
        <text class="f-label" x="170" y="52" text-anchor="middle">{date}</text>
        <text class="f-label" x="271" y="52" text-anchor="middle">{order}</text>
      </g>
    ))}
  </svg>
</Figure>
