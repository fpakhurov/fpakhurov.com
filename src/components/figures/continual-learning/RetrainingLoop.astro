---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The retraining loop: serve, log, join delayed labels, monitor, trigger, retrain, gate, register and roll out.
const t = ru
  ? {
      title: 'Цикл переобучения и его триггеры',
      b: [['инференс', 'эталонная модель v7'], ['журнал', 'входы и предсказания'], ['метки', 'приходят с задержкой'], ['мониторинг', 'дрейф, качество, цена'],
          ['триггер', 'таймер, алерт, запрос'], ['переобучение', 'окно или дообучение'], ['гейт', 'новая против эталонной'], ['выкатка', 'реестр, тень, канарейка']],
      loop: 'решения модели определяют, какие метки появятся', block: 'отказ: v7 остаётся',
      steps: ['эталонная модель (champion) отвечает на запросы', 'каждый вход и предсказание записываются с идентификатором запроса', 'метки приходят позже и присоединяются к записям по идентификатору', 'мониторинг считает дрейф входов, долю правильных ответов на пришедших метках и стоимость', 'триггер: расписание, алерт мониторинга или ручной запрос запускает обучение', 'конвейер обучает новую модель (challenger): заново на окне данных или дообучением текущей', 'гейт сравнивает новую модель с эталонной на одних и тех же отложенных данных; при отказе остаётся v7', 'прошедшая гейт модель регистрируется и выкатывается через теневой запуск и канареечный выпуск'],
      desc: 'Восемь блоков по кругу. Верхний ряд слева направо: инференс, журнал, метки с задержкой, мониторинг. Нижний ряд справа налево: триггер, переобучение, гейт, выкатка; от выкатки стрелка вверх к инференсу. Пунктирная дуга от инференса к меткам: решения модели определяют, какие метки появятся. От гейта пунктир назад: при отказе эталонная модель остаётся.',
    }
  : {
      title: 'The retraining loop and its triggers',
      b: [['serve', 'model v7 (champion)'], ['log', 'inputs, predictions'], ['join labels', 'after a delay'], ['monitor', 'drift, accuracy, cost'],
          ['trigger', 'timer, alert, request'], ['retrain', 'window or warm start'], ['gate', 'challenger vs champion'], ['roll out', 'shadow, then canary']],
      loop: 'the decisions of the model decide which labels exist', block: 'rejected: v7 stays',
      steps: ['the champion model answers requests', 'every input and prediction is logged with a request id', 'labels arrive later and are joined to the log by request id', 'monitoring computes input drift, accuracy on the labels that arrived, and cost', 'a trigger, a schedule, an alert from monitoring or a manual request, starts training', 'the pipeline trains a challenger: from scratch on a window of data, or by fine-tuning the current model', 'the gate compares challenger and champion on the same held-out data; on a rejection v7 stays', 'a model that passes is registered and rolled out through shadow and canary'],
      desc: 'Eight boxes in a loop. Top row, left to right: serve, log, join delayed labels, monitor. Bottom row, right to left: trigger, retrain, gate, roll out; from roll out an arrow goes up to serve. A dashed arc from serve to the labels: the decisions of the model decide which labels exist. A dashed arrow from the gate back: on a rejection the champion stays.',
    };
// role colours: data in green, the model in blue, decisions (trigger, gate) in amber, what ships in red
const tones = ['h', 'x', 'x', 'n', 'g', 'h', 'g', 'y'] as const;
const W = { w: 160, h: 54, xs: [16, 204, 392, 580], yTop: 70, yBot: 224 };
const CHS = 6.5, CHL = 7.5;
t.b.forEach(([l, s]) => {
  if (l.length * CHL > W.w - 16 || s.length * CHS > W.w - 10) throw new Error(`RetrainingLoop: "${l}" / "${s}" too wide`);
});
// narrow: one column, return arrow on the right
const N = { x: 40, w: 250, h: 46, y0: 40, gap: 16 };
const ny = (i: number) => N.y0 + i * (N.h + N.gap);
const NH = ny(7) + N.h + 20;
const CHSN = 7.3, CHLN = 8;
t.b.forEach(([l, s]) => {
  if (l.length * CHLN > N.w - 40 || s.length * CHSN > N.w - 12) throw new Error(`RetrainingLoop narrow: "${l}" / "${s}" too wide`);
});
if (t.loop.length * CHS > 700) throw new Error('RetrainingLoop: loop label');
const id = 'retraining-loop';
const caption = ru
  ? 'Верхний ряд — то, что происходит с каждым запросом; нижний — то, что происходит при каждом переобучении. Триггер решает, когда переобучать, конвейер — как (заново или дообучением), гейт — выпускать ли результат. Задержка меток (шаг 3) задаёт минимальное время, за которое цикл может заметить изменение мира; пунктирная дуга — петля обратной связи: метки есть только у тех решений, которые модель приняла.'
  : 'The top row happens on every request; the bottom row on every retraining. The trigger decides when to retrain, the pipeline how (from scratch or by fine-tuning), the gate whether the result ships. The label delay of step 3 sets the shortest time in which the loop can notice that the world changed; the dashed arc is the feedback loop: labels exist only for the decisions the model made.';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 320" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <path class="f-line f-amber f-dash" d={`M ${W.xs[0] + 110} ${W.yTop} C ${W.xs[0] + 150} 24, ${W.xs[2] + 40} 24, ${W.xs[2] + 70} ${W.yTop - 2}`} marker-end="url(#f-arrow-amber)" />
    <text class="f-small f-t-amber f-halo" x={(W.xs[1] + W.w / 2)} y="22" text-anchor="middle">{t.loop}</text>
    {[0, 1, 2, 3].map((i) => (
      <g data-s={String(i + 1)}>
        {i > 0 && <Arrow pts={[[W.xs[i] - 26, W.yTop + W.h / 2], [W.xs[i] - 2, W.yTop + W.h / 2]]} tone={i === 2 ? 'green' : 'muted'} />}
        <Box x={W.xs[i]} y={W.yTop} w={W.w} h={W.h} label={t.b[i][0]} sub={t.b[i][1]} tone={tones[i]} />
        <Badge x={W.xs[i] + W.w - 12} y={W.yTop} n={i + 1} />
      </g>
    ))}
    {[4, 5, 6, 7].map((i) => {
      const x = W.xs[7 - i];
      return (
        <g data-s={String(i + 1)}>
          {i === 4
            ? <Arrow pts={[[x + W.w / 2, W.yTop + W.h], [x + W.w / 2, W.yBot - 2]]} />
            : <Arrow pts={[[x + W.w + 26, W.yBot + W.h / 2], [x + W.w + 2, W.yBot + W.h / 2]]} />}
          <Box x={x} y={W.yBot} w={W.w} h={W.h} label={t.b[i][0]} sub={t.b[i][1]} tone={tones[i]} />
          <Badge x={x + W.w - 12} y={W.yBot} n={i + 1} />
          {i === 6 && (
            <g>
              <Arrow pts={[[x + 40, W.yBot + W.h], [x + 40, W.yBot + W.h + 26]]} tone="amber" dashed />
              <text class="f-small f-t-amber" x={x + 50} y={W.yBot + W.h + 26}>{t.block}</text>
            </g>
          )}
          {i === 7 && <Arrow pts={[[x + W.w / 2 + 30, W.yBot], [x + W.w / 2 + 30, W.yTop + W.h + 2]]} tone="red" />}
        </g>
      );
    })}
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox={`0 0 360 ${NH}`} role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    {t.b.map(([l, s], i) => (
      <g data-s={String(i + 1)}>
        {i > 0 && <Arrow pts={[[N.x + N.w / 2, ny(i) - N.gap], [N.x + N.w / 2, ny(i) - 2]]} tone={i === 2 ? 'green' : 'muted'} />}
        <Box x={N.x} y={ny(i)} w={N.w} h={N.h} label={l} sub={s} tone={tones[i]} />
        <Badge x={N.x + N.w - 12} y={ny(i)} n={i + 1} />
        {i === 7 && <Arrow pts={[[N.x + N.w, ny(7) + N.h / 2], [340, ny(7) + N.h / 2], [340, ny(0) + 34], [N.x + N.w + 2, ny(0) + 34]]} tone="red" />}
        {i === 6 && <Arrow pts={[[N.x, ny(6) + N.h / 2], [22, ny(6) + N.h / 2], [22, ny(0) + N.h / 2 + 8], [N.x - 2, ny(0) + N.h / 2 + 8]]} tone="amber" dashed />}
      </g>
    ))}
    <Arrow pts={[[N.x + N.w, ny(0) + 12], [312, ny(0) + 12], [312, ny(2) + 23], [N.x + N.w + 2, ny(2) + 23]]} tone="amber" dashed />
    <text class="f-small f-t-amber" x={N.x + N.w + 22} y="24" text-anchor="end">{ru ? 'решения задают метки ↴' : 'decisions decide labels ↴'}</text>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
