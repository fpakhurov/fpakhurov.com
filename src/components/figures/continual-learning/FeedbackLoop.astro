---
import Figure from '../Figure.astro';
import { scale, polyline, seeded } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The feedback-loop simulation of the note, recomputed here with the same generator (mulberry32) as its Python program.
// 100 items with click probabilities 0.01 + 0.09 u^2; a launch shows every item 10 times; then 60 days of 500 sessions,
// each shown a slate of 5 items. Policies: rank by clicks so far (popularity), rank by the estimated click rate
// (clicks + 0.4) / (shows + 10) (greedy), and the same with one slot in a fifth of the sessions given to a random item (explore).
// Plotted: the true click probability of the ranked slate as a share of the best possible slate, averaged over seeds 1-20.
const M = 100, K = 5, DAYS = 60, USERS = 500, LAUNCH = 10, EPS = 0.2, SEEDS = 20;
type Policy = 'popularity' | 'ctr' | 'explore';
function simulate(policy: Policy, seed: number): number[] {
  const rnd = seeded(seed);
  const q: number[] = [];
  for (let i = 0; i < M; i++) { const r = rnd(); q.push(0.01 + 0.09 * r * r); }
  const oracle = [...q].sort((a, b) => b - a).slice(0, K).reduce((s, v) => s + v, 0);
  const clicks = new Array(M).fill(0), shows = new Array(M).fill(0);
  for (let i = 0; i < M; i++) for (let j = 0; j < LAUNCH; j++) { shows[i]++; if (rnd() < q[i]) clicks[i]++; }
  const idx = [...Array(M).keys()];
  const quality: number[] = [];
  for (let day = 0; day < DAYS; day++) {
    const ranked = policy === 'popularity'
      ? [...idx].sort((a, b) => clicks[b] - clicks[a] || a - b).slice(0, K)
      : [...idx].sort((a, b) => (clicks[b] + 0.4) / (shows[b] + 10) - (clicks[a] + 0.4) / (shows[a] + 10) || a - b).slice(0, K);
    const rest = idx.filter((i) => !ranked.includes(i));
    for (let u = 0; u < USERS; u++) {
      let slate = ranked;
      if (policy === 'explore' && rnd() < EPS) slate = [...ranked.slice(0, K - 1), rest[Math.floor(rnd() * (M - K))]];
      for (const i of slate) { shows[i]++; if (rnd() < q[i]) clicks[i]++; }
    }
    quality.push(ranked.reduce((s, i) => s + q[i], 0) / oracle);
  }
  return quality;
}
const policies: Policy[] = ['popularity', 'ctr', 'explore'];
const mean = Object.fromEntries(policies.map((p) => {
  const acc = new Array(DAYS).fill(0);
  for (let s = 1; s <= SEEDS; s++) simulate(p, s).forEach((v, d) => { acc[d] += v / SEEDS; });
  return [p, acc.map((v) => 100 * v)];
})) as Record<Policy, number[]>;
// The numbers quoted in the note (printed by its Python program).
const quoted: Record<Policy, [number, number, number, number]> = {
  popularity: [75.1, 75.1, 75.1, 75.1], ctr: [75.1, 90.4, 92.5, 92.6], explore: [75.1, 92.7, 97.4, 98.4] };
for (const p of policies) [0, 10, 30, 59].forEach((d, j) => {
  if (Math.abs(mean[p][d] - quoted[p][j]) > 0.051) throw new Error(`FeedbackLoop: ${p} day ${d} is ${mean[p][d]}`);
});

const t = ru
  ? { title: 'Петля обратной связи в рекомендациях', y: 'качество выдачи, % от лучшей', x: 'день после запуска',
      names: { popularity: 'по популярности', ctr: 'по оценке CTR', explore: 'CTR + исследование' } as Record<Policy, string>,
      desc: 'Три линии качества выдачи по дням от 0 до 59. Ранжирование по числу кликов остаётся ровно на 75.1% все 60 дней. Жадное ранжирование по оценке доли кликов поднимается до 92.6% и замирает. С исследованием, когда одно место из пяти в каждой пятой сессии отдаётся случайному товару, выдача доходит до 98.4%.' }
  : { title: 'A feedback loop in recommendations', y: 'ranked slate, % of the best', x: 'day after launch',
      names: { popularity: 'by popularity', ctr: 'by estimated CTR', explore: 'CTR + exploration' } as Record<Policy, string>,
      desc: 'Three lines of slate quality against the day, from 0 to 59. Ranking by click counts stays flat at 75.1 % for all 60 days. Greedy ranking by the estimated click rate rises to 92.6 % and stops there. With exploration, one slot in a fifth of the sessions given to a random item, the ranked slate reaches 98.4 %.' };
const tone: Record<Policy, string> = { popularity: 'red', ctr: 'amber', explore: 'blue' };
const fmt = (v: number) => (ru ? `${v.toFixed(1)}%` : `${v.toFixed(1)} %`);

interface Layout { cls: string; W: number; H: number; box: [number, number, number, number]; wide: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 330, box: [64, 30, 560, 280], wide: true },
  { cls: 'fig-narrow', W: 360, H: 420, box: [44, 30, 340, 280], wide: false },
];
const CH = 6.5;
const plots = layouts.map((L) => {
  const [x0, y0, x1, y1] = L.box;
  const sx = scale([0, DAYS - 1], [x0, x1]);
  const sy = scale([70, 100], [y1, y0]);
  const lines = policies.map((p) => ({ p, d: polyline(mean[p].map((v, i) => [sx(i), sy(v)] as [number, number])) }));
  // Labels: at the right end of each line in the wide layout, in a legend below the plot in the narrow one.
  const labels = policies.map((p, i) => {
    const text = `${t.names[p]}: ${fmt(mean[p][DAYS - 1])}`;
    return L.wide
      ? { p, x: x1 + 10, y: sy(mean[p][DAYS - 1]) + 4, text }
      : { p, x: x0 + 28, y: y1 + 58 + i * 22, text };
  });
  for (const lb of labels) {
    const right = lb.x + lb.text.length * CH;
    if (right > L.W - 4) throw new Error(`FeedbackLoop: label "${lb.text}" runs past ${L.W}`);
    if (lb.y > L.H - 4) throw new Error('FeedbackLoop: legend below the figure');
  }
  if (L.wide) {
    const ys = labels.map((l) => l.y).sort((a, b) => a - b);
    for (let i = 1; i < ys.length; i++) if (ys[i] - ys[i - 1] < 15) throw new Error('FeedbackLoop: end labels overlap');
  }
  return { L, sx, sy, lines, labels };
});
const id = 'feedback-loop';
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? 'Расчёт из раздела «Пример»: 100 товаров с вероятностью клика 0.01 + 0.09u², u равномерно на [0, 1]; при запуске каждый товар показан 10 раз; затем 60 дней по 500 сессий, в каждой выдача из 5 товаров. По оси y — сумма истинных вероятностей клика пяти товаров, стоящих первыми, в процентах от лучших пяти; среднее по 20 начальным значениям генератора. Ранжирование по накопленным кликам навсегда закрепляет лидеров запуска: им достаётся 99.7% всех кликов. Жадная оценка доли кликов исправляет переоценённые товары, но не находит недооценённые, которые больше не показывает. Исследование платит местом в выдаче и находит их.'
    : 'The computation of the Example: 100 items with click probability 0.01 + 0.09u², u uniform on [0, 1]; a launch shows every item 10 times; then 60 days of 500 sessions, each shown a slate of 5. The y axis is the sum of the true click probabilities of the five top-ranked items as a percentage of the best five, averaged over 20 random seeds. Ranking by accumulated clicks freezes the launch leaders for good: they collect 99.7 % of all clicks. A greedy estimate of the click rate corrects items it overrates but never finds the ones it underrates, because it stops showing them. Exploration pays with a slot and finds them.'}
>
  {plots.map(({ L, sx, sy, lines, labels }) => {
    const [x0, y0, x1, y1] = L.box;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        {[70, 80, 90, 100].map((v) => (
          <g>
            <path class="f-grid" d={`M ${x0} ${sy(v)} H ${x1}`} />
            <text class="f-note" x={x0 - 8} y={sy(v) + 5} text-anchor="end">{String(v)}</text>
          </g>
        ))}
        {[0, 10, 20, 30, 40, 50].map((d) => (
          <g>
            <path class="f-axis" d={`M ${sx(d)} ${y1} v 5`} />
            <text class="f-note" x={sx(d)} y={y1 + 20} text-anchor="middle">{String(d)}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${x0} ${y0} V ${y1} H ${x1}`} />
        <text class="f-note" x={x1} y={y1 + 40} text-anchor="end">{t.x}</text>
        <text class="f-note" x={x0} y={y0 - 12}>{t.y}</text>
        {lines.map(({ p, d }) => <path class={`f-line f-bold f-${tone[p]}`} d={d} />)}
        {labels.map((lb) => (
          <g>
            {!L.wide && <path class={`f-line f-bold f-${tone[lb.p]}`} d={`M ${x0} ${lb.y - 4} h 20`} />}
            <text class={`f-small f-t-${tone[lb.p]}`} x={lb.x} y={lb.y}>{lb.text}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
