---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Arrow from '../seqflow/Arrow.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// fact(3) from the note's program, in RARS's memory layout: sp starts at 0x7fffeffc, every call of fact builds a
// 16-byte frame with ra at sp + 12 and the caller's s0 at sp + 8. main's jal is at 0x00400004, fact's own jal at
// 0x0040006c, so the return addresses are 0x00400008 (into main) and 0x00400070 (into fact, at the mul).
const SP0 = 0x7fffeffc, FRAME = 16, RET_MAIN = 0x00400008, RET_FACT = 0x00400070;
const hex = (v: number) => '0x' + v.toString(16).padStart(8, '0');
const depth = 3;
const frames = Array.from({ length: depth }, (_, k) => {
  const n = depth - k;                               // fact(3), fact(2), fact(1)
  const sp = SP0 - FRAME * (k + 1);
  return { n, sp, ra: k === 0 ? RET_MAIN : RET_FACT, s0: k === 0 ? 0 : n + 1 };
});
if (frames.map((f) => hex(f.sp)).join(' ') !== '0x7fffefec 0x7fffefdc 0x7fffefcc') throw new Error('FactorialFrames: sp values');
const results = [1, 2, 6];                           // fact(1), fact(2), fact(3)
if (results[2] !== 3 * 2 * 1) throw new Error('FactorialFrames: result');
// the 12 words below the initial sp, highest address first
const words = frames.flatMap((f, k) => [
  { addr: f.sp + 12, text: `ra = ${hex(f.ra)}`, kind: 'ra', s: k + 2 },
  { addr: f.sp + 8, text: k === 0 ? (ru ? 's0 = 0 (из main)' : 's0 = 0 (main’s)') : `s0 = ${f.s0}`, kind: 's0', s: k + 2 },
  { addr: f.sp + 4, text: ru ? 'не используется' : 'unused', kind: 'pad', s: k + 2 },
  { addr: f.sp, text: ru ? 'не используется' : 'unused', kind: 'pad', s: k + 2 },
]);
if (hex(words[0].addr) !== '0x7fffeff8' || hex(words[11].addr) !== '0x7fffefcc') throw new Error('FactorialFrames: addresses');
const names = ['main', 'fact(3)', 'fact(2)', 'fact(1)'];
const boxStep = [1, 1, 3, 4], callStep = [1, 3, 4];
const t = ru
  ? { start: 'sp в начале: 0x7fffeffc', frame: (n: number) => `кадр fact(${n})`,
      steps: ['main вызывает fact(3): jal записывает ra = 0x00400008', 'пролог fact(3): sp −= 16, ra и s0 из main сохраняются в кадре', 'fact(3) вызывает fact(2): новый кадр ниже, в нём ra = 0x00400070 и s0 = 3', 'fact(2) вызывает fact(1): третий кадр; база рекурсии возвращает 1', 'fact(2) восстанавливает s0 = 2 и ra, освобождает кадр и возвращает 2 · 1 = 2', 'fact(3) возвращает 3 · 2 = 6 по адресу 0x00400008 в main'] }
  : { start: 'sp at start: 0x7fffeffc', frame: (n: number) => `fact(${n}) frame`,
      steps: ['main calls fact(3): jal writes ra = 0x00400008', 'fact(3) prologue: sp −= 16; ra and main’s s0 are saved in the frame', 'fact(3) calls fact(2): a new frame below, holding ra = 0x00400070 and s0 = 3', 'fact(2) calls fact(1): a third frame; the base case returns 1', 'fact(2) restores s0 = 2 and ra, frees its frame and returns 2 · 1 = 2', 'fact(3) returns 3 · 2 = 6 to 0x00400008 in main'] };

const fillOf: Record<string, string> = { ra: 'f-fill-red', s0: 'f-fill-blue', pad: 'f-fill-paper' };
const strokeOf: Record<string, string> = { ra: 'f-red', s0: 'f-blue', pad: 'f-muted' };
const layouts = [
  { cls: 'fig-wide', W: 760, H: 340, wide: true, ax: 410, cx: 420, cw: 180, top: 52, rh: 22, fx: 612, mono: 11.5 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 418, wide: false, ax: 76, cx: 82, cw: 168, top: 128, rh: 22, fx: 258, mono: 10.5 },
];
const id = 'procedures-and-the-stack-factorial-frames';
---

<Figure
  id={id}
  title={ru ? 'Кадры стека при вычислении fact(3)' : 'Stack frames while computing fact(3)'}
  caption={ru
    ? 'Слева цепочка вызовов, справа 12 слов стека под начальным sp = 0x7fffeffc, адреса убывают вниз. Каждый вызов fact уменьшает sp на 16 и сохраняет в своём кадре адрес возврата ra (красный) и s0 вызывающего кода (синий); два слова кадра не используются и нужны только для кратности 16. В кадре fact(3) лежит адрес возврата в main, в двух других — адрес команды mul внутри fact, 0x00400070, и значения n вызвавших их вызовов, 3 и 2. На самом глубоком месте sp = 0x7fffefcc. Возвраты идут в обратном порядке: 1, затем 2 · 1 = 2, затем 3 · 2 = 6. Освобождённый кадр не стирается: его байты остаются в памяти, пока следующий вызов их не перезапишет.'
    : 'On the left the chain of calls, on the right the 12 stack words below the initial sp = 0x7fffeffc, with addresses decreasing downwards. Each call of fact lowers sp by 16 and saves in its frame the return address ra (red) and its caller’s s0 (blue); the other two words of the frame are unused and only keep the frame a multiple of 16 bytes. The frame of fact(3) holds the return address into main; the other two hold the address of the mul inside fact, 0x00400070, and their callers’ n, 3 and 2. At the deepest point sp = 0x7fffefcc. The returns come in reverse order: 1, then 2 · 1 = 2, then 3 · 2 = 6. A freed frame is not erased: its bytes stay in memory until the next call overwrites them.'}
>
  {layouts.map((L) => {
    const wy = (i: number) => L.top + i * L.rh;
    const ms = `font-family: var(--mono); font-size: ${L.mono}px`;
    // the call chain
    const box = (k: number) => (L.wide ? { x: 40, y: 50 + k * 70, w: 150, h: 34 } : { x: 8 + k * 88, y: 34, w: 66, h: 30 });
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Три кадра fact на стеке' : 'Three frames of fact on the stack'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Цепочка main, fact(3), fact(2), fact(1) с вызовами вниз и возвратами 1, 2 и 6 вверх. Стек: кадр fact(3) по адресам 0x7fffefec–0x7fffeffb с ra = 0x00400008 и s0 = 0, кадр fact(2) с ra = 0x00400070 и s0 = 3, кадр fact(1) с ra = 0x00400070 и s0 = 2, sp на самом глубоком месте 0x7fffefcc.'
          : 'The chain main, fact(3), fact(2), fact(1) with calls going down and returns 1, 2 and 6 going back up. The stack: the frame of fact(3) at 0x7fffefec–0x7fffeffb with ra = 0x00400008 and s0 = 0, the frame of fact(2) with ra = 0x00400070 and s0 = 3, the frame of fact(1) with ra = 0x00400070 and s0 = 2; sp at the deepest point is 0x7fffefcc.'}</desc>

        {/* the call chain: boxes, calls and returns */}
        {names.map((nm, k) => {
          const b = box(k);
          return (
            <g data-s={String(boxStep[k])}>
              <rect class={k ? 'f-fill-paper f-thin' : 'f-box-soft'} x={b.x} y={b.y} width={b.w} height={b.h} rx="6" />
              <text class="f-small" x={b.x + b.w / 2} y={b.y + b.h / 2 + 5} text-anchor="middle" style="font-weight: 650">{nm}</text>
            </g>
          );
        })}
        {[0, 1, 2].map((k) => {
          const a = box(k), b = box(k + 1);
          const call = L.wide ? [[a.x + 40, a.y + a.h + 2], [b.x + 40, b.y - 3]] : [[a.x + a.w + 1, a.y + 10], [b.x - 3, b.y + 10]];
          const back = L.wide ? [[b.x + 110, b.y - 2], [a.x + 110, a.y + a.h + 3]] : [[b.x - 1, b.y + 22], [a.x + a.w + 3, a.y + 22]];
          const callLabel = L.wide ? `a0 = ${3 - k}` : String(3 - k);
          const backLabel = L.wide ? `a0 = ${results[2 - k]}` : String(results[2 - k]);
          return (
            <g>
              <g data-s={String(callStep[k])}>
                <Arrow pts={call as [number, number][]} tone="blue" />
                <text class="f-small f-t-blue" x={L.wide ? a.x + 48 : (a.x + a.w + b.x) / 2} y={L.wide ? a.y + a.h + 23 : a.y - 6} text-anchor={L.wide ? 'start' : 'middle'}>{callLabel}</text>
              </g>
              <g data-s={String([4, 5, 6][2 - k])}>
                <Arrow pts={back as [number, number][]} tone="red" />
                <text class="f-small f-t-red" x={L.wide ? a.x + 118 : (a.x + a.w + b.x) / 2} y={L.wide ? a.y + a.h + 23 : a.y + a.h + 18} text-anchor={L.wide ? 'start' : 'middle'}>{backLabel}</text>
              </g>
            </g>
          );
        })}

        {/* the stack */}
        <text class="f-small f-t-muted" x={L.cx} y={L.top - 12}>{t.start}</text>
        {words.map((w, i) => (
          <g data-s={String(w.s)}>
            <text class="f-small f-t-muted" x={L.ax} y={wy(i) + L.rh / 2 + 4} text-anchor="end" style={ms}>{hex(w.addr)}</text>
            <rect class={fillOf[w.kind]} x={L.cx} y={wy(i)} width={L.cw} height={L.rh} />
            <rect class={`f-thin ${strokeOf[w.kind]}`} x={L.cx} y={wy(i)} width={L.cw} height={L.rh} />
            <text class={`f-small ${w.kind === 'pad' ? 'f-t-muted' : ''}`} x={L.cx + 8} y={wy(i) + L.rh / 2 + 4} style={ms}>{w.text}</text>
          </g>
        ))}
        {frames.map((f, k) => {
          const y0 = wy(4 * k) + 2, y1 = wy(4 * k + 4) - 2;
          return (
            <g data-s={String(k + 2)}>
              <path class="f-thin" d={`M ${L.cx + L.cw + 4} ${y0} H ${L.cx + L.cw + 9} V ${y1} H ${L.cx + L.cw + 4}`} />
              <text class="f-small" x={L.fx} y={y0 + 30} style="font-weight: 650">{L.wide ? t.frame(f.n) : `fact(${f.n})`}</text>
              <text class="f-small f-t-muted" x={L.fx} y={y0 + 48} style={ms}>{L.wide ? `sp = ${hex(f.sp)}` : hex(f.sp)}</text>
            </g>
          );
        })}
        {(L.wide
          ? [[24, 92], [312, 74], [312, 164], [24, 232], [222, 180], [222, 110]]
          : [[20, 112], [340, 130], [340, 218], [340, 306], [140, 90], [52, 90]]
        ).map(([x, y], i) => <g data-s={String(i + 1)}><Badge x={x} y={y} n={i + 1} /></g>)}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
