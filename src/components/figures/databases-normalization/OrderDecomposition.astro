---
import Figure from '../Figure.astro';

const ru = Astro.props.lang === 'ru';
const title = ru ? 'Три отношения для трёх видов фактов' : 'Three relations for three kinds of fact';
const caption = ru
  ? 'После разбиения по o состояние находится в O. После разбиения по p текущий код находится в P. L сохраняет согласованную цену.'
  : 'Splitting on o puts state in O. Splitting on p puts the current code in P. L keeps the agreed price.';
const desc = ru
  ? 'Объединённая схема разделяется на заказ и позиции с кодом. Позиции с кодом разделяются на позиции и товары каталога.'
  : 'The flattened schema splits into orders and lines with code. Lines with code split into lines and catalog items.';
---
<Figure id="db-order-decomposition" title={title} caption={caption}>
  <svg viewBox="0 0 340 185" role="img" aria-labelledby="db-order-decomp-title db-order-decomp-desc" style="max-width: 520px; margin-inline: auto">
    <title id="db-order-decomp-title">{title}</title>
    <desc id="db-order-decomp-desc">{desc}</desc>
    <rect class="f-fill-blue" x="70" y="8" width="200" height="35" rx="6" />
    <text class="f-label" x="170" y="30" text-anchor="middle">R(o, n, p, q, c, k, s)</text>
    <path class="f-line" d="M 170 43 V 59 H 61 V 73 M 170 59 H 230 V 73 M 57 69 L 61 73 L 65 69 M 226 69 L 230 73 L 234 69" />
    <text class="f-small f-t-muted" x="169" y="76" text-anchor="middle">o</text>
    <rect class="f-fill-green" x="7" y="79" width="108" height="34" rx="6" />
    <text class="f-label" x="61" y="101" text-anchor="middle">O(o, s)</text>
    <rect class="f-fill-blue" x="130" y="79" width="203" height="34" rx="6" />
    <text class="f-label" x="230" y="101" text-anchor="middle">R′(o, n, p, q, c, k)</text>
    <path class="f-line" d="M 230 113 V 130 H 174 V 144 M 230 130 H 295 V 144 M 170 140 L 174 144 L 178 140 M 291 140 L 295 144 L 299 140" />
    <text class="f-small f-t-muted" x="230" y="145" text-anchor="middle">p</text>
    <rect class="f-fill-green" x="94" y="150" width="160" height="34" rx="6" />
    <text class="f-label" x="174" y="172" text-anchor="middle">L(o, n, p, q, c)</text>
    <rect class="f-fill-green" x="261" y="150" width="72" height="34" rx="6" />
    <text class="f-label" x="297" y="172" text-anchor="middle">P(p, k)</text>
  </svg>
</Figure>
