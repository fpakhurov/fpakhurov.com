---
import Figure from '../Figure.astro';

const ru = Astro.props.lang === 'ru';
const title = ru ? 'Два фильтра оставляют одного кандидата' : 'Two filters leave one candidate file';
const caption = ru
  ? 'После отбора дня остаются четыре файла. Только диапазон второго допускает идентификатор магазина 150.'
  : 'Filtering the day leaves four files. Only the second range can contain shop ID 150.';
const steps = [
  {label: ru ? 'Вся неделя' : 'Whole week', count: ru ? '28 файлов' : '28 files', size: '3584'},
  {label: ru ? 'Один день' : 'One day', count: ru ? '4 файла' : '4 files', size: '512'},
  {label: 'shop_id = 150', count: ru ? '1 файл' : '1 file', size: '128'},
];
---
<Figure id="big-data-file-pruning" title={title} caption={caption}>
  <svg viewBox="0 0 340 156" role="img" aria-labelledby="file-pruning-title file-pruning-desc" style="max-width: 510px; margin-inline: auto">
    <title id="file-pruning-title">{title}</title>
    <desc id="file-pruning-desc">{caption}</desc>
    {steps.map(({label, count, size}, i) => (
      <g transform={`translate(0 ${i * 50})`}>
        <rect class={i === 2 ? 'f-fill-green' : 'f-fill-blue'} x="7" y="8" width="326" height="37" rx="6" />
        <text class="f-label" x="18" y="31">{label}</text>
        <text class="f-label" x="172" y="31">{count}</text>
        <text class="f-label" x="323" y="31" text-anchor="end">{size} {ru ? 'МиБ' : 'MiB'}</text>
      </g>
    ))}
  </svg>
</Figure>
