---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale } from '../geometry';
import { toy, toyTree, gini } from './data';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Greedy Gini splitting of an 18-point toy set: the root splits on x₁, then each half splits on x₂ at a different
// threshold, so the effect of x₂ reverses with x₁. data.ts checks the thresholds 0.44, 0.315, 0.485 and pure leaves.
const L = toyTree.left!, R = toyTree.right!;
const after = (L.n * gini(L) + R.n * gini(R)) / toyTree.n;
if (gini(toyTree).toFixed(2) !== '0.50' || after.toFixed(2) !== '0.40' || gini(L).toFixed(3) !== '0.375' || gini(R).toFixed(2) !== '0.42') throw new Error('TreePartition: Gini values drifted from the caption');
const fmt = (v: number) => (Math.round(v * 1000) / 1000).toString();
const t = ru
  ? { x1: 'x₁', x2: 'x₂', yes: 'да', no: 'нет', cls: 'класс', gini: 'Джини',
      steps: [
        `корень: из всех разбиений по x₁ и x₂ правило x₁ ≤ 0.44 сильнее всего снижает взвешенный индекс Джини, с 0.50 до ${after.toFixed(2)}`,
        'левый узел (8 точек): x₂ ≤ 0.315 отделяет две точки класса 1, оба потомка чистые',
        'правый узел (10 точек): x₂ ≤ 0.485 отделяет 3 точки класса 0 от 7 точек класса 1',
        'четыре чистых листа: влияние x₂ меняет знак в зависимости от x₁ — взаимодействие, которое одна прямая не выражает',
      ] }
  : { x1: 'x₁', x2: 'x₂', yes: 'yes', no: 'no', cls: 'class', gini: 'Gini',
      steps: [
        `root: of all splits on x₁ and x₂, x₁ ≤ 0.44 lowers the weighted Gini index most, from 0.50 to ${after.toFixed(2)}`,
        'left node (8 points): x₂ ≤ 0.315 separates its two class-1 points; both children are pure',
        'right node (10 points): x₂ ≤ 0.485 separates 3 class-0 points from 7 class-1 points',
        'four pure leaves: the effect of x₂ reverses with x₁, an interaction that no single line expresses',
      ] };
const id = 'tree-partition';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 330, px: 52, py: 22, ps: 270, root: [560, 30], kids: [[455, 128], [665, 128]], leafY: 232, leafX: [395, 500, 608, 712], bw: 150, lw: 92, b4: [335, 254] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 660, px: 46, py: 20, ps: 290, root: [180, 380], kids: [[96, 476], [264, 476]], leafY: 576, leafX: [48, 136, 224, 312], bw: 150, lw: 82, b4: [20, 644] },
];
const nodes = [toyTree, L, R];
const leafNodes = [L.left!, L.right!, R.left!, R.right!];
---

<Figure
  id={id}
  title={ru ? 'Решающее дерево и разбиение плоскости' : 'A decision tree and its partition of the plane'}
  caption={ru
    ? 'Закрашенные точки — класс 1, пустые — класс 0. Каждое внутреннее правило дерева — линия на графике, параллельная оси: корень режет по x₁, а затем каждая половина режет по x₂ со своим порогом. Ниже порога слева и выше порога справа лежит класс 1: дерево выражает взаимодействие признаков ветвлением. В каждом узле указаны число точек и индекс Джини 2p(1 − p).'
    : 'Filled points are class 1, hollow points class 0. Every internal rule of the tree is a line on the plot parallel to an axis: the root cuts on x₁, then each half cuts on x₂ with its own threshold. Class 1 lies below the threshold on the left and above it on the right: the tree expresses the interaction of the features by branching. Each node shows its number of points and its Gini index 2p(1 − p).'}
>
  {layouts.map((Ly) => {
    const sx = scale([0, 1], [Ly.px, Ly.px + Ly.ps]), sy = scale([0, 1], [Ly.py + Ly.ps, Ly.py]);
    const boxes = [Ly.root, ...Ly.kids];
    const lines = [
      { d: `M ${sx(0.44)} ${sy(0)} V ${sy(1)}`, s: 1, b: [sx(0.44), sy(1) + 12] },
      { d: `M ${sx(0)} ${sy(0.315)} H ${sx(0.44)}`, s: 2, b: [sx(0) + 12, sy(0.315) - 12] },
      { d: `M ${sx(0.44)} ${sy(0.485)} H ${sx(1)}`, s: 3, b: [sx(1) - 12, sy(0.485) - 12] },
    ];
    const regions = [[0, 0.44, 0, 0.315], [0.44, 1, 0.485, 1]];
    const edges = [[0, 1, 0], [0, 2, 1], [1, -1, 0], [1, -1, 1], [2, -1, 0], [2, -1, 1]].map(([from, to, side], k) => {
      const [x0, y0] = boxes[from];
      const target = to !== -1 ? [boxes[to][0], boxes[to][1]] : [Ly.leafX[(from - 1) * 2 + side], Ly.leafY];
      return { x0, y0: y0 + 44, x1: target[0], y1: target[1], right: side === 1, label: side === 0 ? t.yes : t.no, s: k === 0 ? 1 : k === 1 ? 1 : from === 1 ? 2 : 3 };
    });
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.W}-t ${id}-${Ly.W}-d`}>
        <title id={`${id}-${Ly.W}-t`}>{ru ? 'Три правила дерева и четыре прямоугольника' : 'Three rules of a tree and four rectangles'}</title>
        <desc id={`${id}-${Ly.W}-d`}>{ru ? 'Квадрат с 18 точками двух классов разрезан вертикальной линией и двумя горизонтальными на разной высоте; рядом дерево с корнем, двумя внутренними узлами и четырьмя листьями.' : 'A square with 18 points of two classes cut by one vertical line and two horizontal lines at different heights; beside it a tree with a root, two internal nodes and four leaves.'}</desc>
        {regions.map(([a, b, c, e]) => <rect data-s="4" x={sx(a)} y={sy(e)} width={sx(b) - sx(a)} height={sy(c) - sy(e)} class="f-fill-red" />)}
        <rect x={sx(0)} y={sy(1)} width={Ly.ps} height={Ly.ps} style="fill: none; stroke: var(--line); stroke-width: 1" />
        <text class="f-small f-t-muted" x={sx(0.5)} y={sy(0) + 30} text-anchor="middle">{t.x1}</text>
        <text class="f-small f-t-muted" x={sx(0) - 16} y={sy(0.75) + 4} text-anchor="middle">{t.x2}</text>
        {[0, 0.5, 1].map((v) => <text class="f-note" x={sx(v)} y={sy(0) + 15} text-anchor="middle">{v}</text>)}
        {[0, 0.5, 1].map((v) => <text class="f-note" x={sx(0) - 6} y={sy(v) + 4} text-anchor="end">{v}</text>)}
        {lines.map((l) => <g data-s={l.s}><path class="f-line f-amber f-bold" d={l.d} /><Badge x={l.b[0]} y={l.b[1]} n={l.s} /></g>)}
        {toy.map(([a, b, c]) => <circle cx={sx(a)} cy={sy(b)} r="5" style={c === 1 ? 'fill: var(--ink)' : 'fill: var(--paper); stroke: var(--ink); stroke-width: 1.4'} />)}
        {edges.map((e) => (
          <g data-s={e.s}>
            <path class="f-thin f-muted" d={`M ${e.x0} ${e.y0} L ${e.x1} ${e.y1}`} />
            <text class="f-note f-halo" x={(e.x0 + e.x1) / 2 + (e.right ? 8 : -8)} y={(e.y0 + e.y1) / 2} text-anchor={e.right ? 'start' : 'end'}>{e.label}</text>
          </g>
        ))}
        {nodes.map((node, k) => {
          const [cx, cy] = boxes[k];
          const ft = node.feature === 0 ? t.x1 : t.x2;
          return (
            <g data-s={k + 1}>
              <rect x={cx - Ly.bw / 2} y={cy} width={Ly.bw} height="44" rx="7" style="fill: var(--fig-amber); fill-opacity: .14; stroke: var(--fig-amber); stroke-width: 1.3" />
              <text class="f-small" x={cx} y={cy + 18} text-anchor="middle">{`${ft} ≤ ${fmt(node.threshold!)}`}</text>
              <text class="f-note" x={cx} y={cy + 36} text-anchor="middle">{`n = ${node.n} · ${t.gini} ${fmt(gini(node))}`}</text>
            </g>
          );
        })}
        {leafNodes.map((leaf, k) => (
          <g data-s="4">
            <rect x={Ly.leafX[k] - Ly.lw / 2} y={Ly.leafY} width={Ly.lw} height="44" rx="7" style={`fill: var(--fig-red); fill-opacity: ${leaf.value === 1 ? 0.2 : 0.05}; stroke: var(--fig-red); stroke-width: 1.3`} />
            <text class="f-small" x={Ly.leafX[k]} y={Ly.leafY + 18} text-anchor="middle">{`${t.cls} ${leaf.value}`}</text>
            <text class="f-note" x={Ly.leafX[k]} y={Ly.leafY + 36} text-anchor="middle">{`n = ${leaf.n}`}</text>
          </g>
        ))}
        {nodes.map((_, k) => <g data-s={k + 1}><Badge x={boxes[k][0] - Ly.bw / 2} y={boxes[k][1]} n={k + 1} /></g>)}
        <g data-s="4"><Badge x={Ly.b4[0]} y={Ly.b4[1]} n={4} /></g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
