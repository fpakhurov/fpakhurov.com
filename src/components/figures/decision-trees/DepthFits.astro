---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { depthFits, samples, f } from './data';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Regression trees of depth 1, 3 and unlimited, each fitted to two independent samples of 40 points of
// y = sin 2πx + N(0, 0.3²). Train error on sample A, test error σ² + ∫(fit − f)², and the squared gap ∫(fit_A − fit_B)².
const nums = depthFits.map((d) => [d.leaves, d.train.toFixed(3), d.test.toFixed(3), d.gap.toFixed(3)].join(' '));
if (nums.join(' | ') !== '2 0.214 0.202 0.067 | 8 0.073 0.179 0.187 | 40 0.000 0.231 0.251') throw new Error('DepthFits: numbers drifted from the caption');
const t = ru
  ? { names: ['глубина 1 · 2 листа', 'глубина 3 · 8 листьев', 'без ограничения · 40 листьев'], tr: 'обуч.', te: 'тест', a: 'дерево по выборке A', b: 'по выборке B', truth: 'sin 2πx' }
  : { names: ['depth 1 · 2 leaves', 'depth 3 · 8 leaves', 'full depth · 40 leaves'], tr: 'train', te: 'test', a: 'tree on sample A', b: 'on sample B', truth: 'sin 2πx' };
const id = 'depth-fits';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 300, pos: (k: number) => [16 + k * 250, 92], pw: 226, ph: 180, leg: [16, 20] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 820, pos: (k: number) => [16, 100 + k * 240], pw: 328, ph: 170, leg: [16, 20] },
];
const stepPath = (st: [number, number, number][], sx: (v: number) => number, sy: (v: number) => number) =>
  st.map(([a, b, v], i) => `${i === 0 ? 'M' : 'V'} ${i === 0 ? `${sx(a).toFixed(1)} ${sy(v).toFixed(1)}` : sy(v).toFixed(1)} H ${sx(b).toFixed(1)}`).join(' ');
const grid = Array.from({ length: 121 }, (_, i) => i / 120);
---

<Figure
  id={id}
  title={ru ? 'Деревья растущей глубины на двух выборках' : 'Trees of growing depth on two samples'}
  caption={ru
    ? 'Две независимые выборки по 40 точек y = sin 2πx + шум (σ = 0.3); точки выборки A показаны. Пень (глубина 1) одинаково груб на обеих выборках: ошибка на обучении 0.214, на тесте 0.202. Дерево глубины 3 следует синусоиде: 0.073 и 0.179. Полностью выращенное дерево запоминает каждую точку: ошибка на обучении 0, на тесте 0.231 — больше, чем у дерева глубины 3, а среднее квадратичное расхождение двух деревьев растёт с 0.067 до 0.187 и 0.251. Тестовая ошибка — σ² плюс средний квадрат отклонения от sin 2πx.'
    : 'Two independent samples of 40 points of y = sin 2πx + noise (σ = 0.3); the points of sample A are shown. A stump (depth 1) is equally crude on both samples: train error 0.214, test error 0.202. The depth-3 tree follows the sine: 0.073 and 0.179. The fully grown tree memorizes every point: train error 0, test error 0.231, worse than depth 3, and the mean squared gap between the two trees grows from 0.067 to 0.187 and 0.251. Test error is σ² plus the mean squared deviation from sin 2πx.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Ступенчатые подгонки трёх глубин' : 'Step fits of three depths'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'Три панели: одна ступенька, восемь ступенек вдоль синусоиды и зубчатая линия через каждую точку; вторая линия того же дерева на другой выборке всё сильнее расходится с первой.' : 'Three panels: one step, eight steps along a sine, and a jagged line through every point; a second line, the same kind of tree on another sample, diverges more and more from the first.'}</desc>
      <path class="f-line f-blue" d={`M ${L.leg[0]} ${L.leg[1]} h 22`} />
      <text class="f-small" x={L.leg[0] + 28} y={L.leg[1] + 4}>{t.a}</text>
      <path class="f-line f-red f-dash" d={`M ${L.leg[0] + 190} ${L.leg[1]} h 22`} />
      <text class="f-small" x={L.leg[0] + 218} y={L.leg[1] + 4}>{t.b}</text>
      {depthFits.map((d, k) => {
        const [x0, y0] = L.pos(k);
        const sx = scale([0, 1], [x0, x0 + L.pw]), sy = scale([-1.9, 1.9], [y0 + L.ph, y0]);
        return (
          <g>
            <text class="f-small" x={x0} y={y0 - 30}>{t.names[k]}</text>
            <text class="f-note" x={x0} y={y0 - 12}>{`${t.tr} ${d.train.toFixed(3)} · ${t.te} ${d.test.toFixed(3)}`}</text>
            <rect x={x0} y={y0} width={L.pw} height={L.ph} style="fill: none; stroke: var(--line); stroke-width: 1" />
            <path class="f-thin f-muted f-dot" d={grid.map((x, i) => `${i ? 'L' : 'M'} ${sx(x).toFixed(1)} ${sy(f(x)).toFixed(1)}`).join(' ')} />
            {samples[0].xs.map((x, i) => <circle cx={sx(x)} cy={sy(samples[0].ys[i])} r="2.6" class="f-solid-muted" />)}
            <path class="f-line f-red f-dash" d={stepPath(d.steps[1], sx, sy)} />
            <path class="f-line f-blue" d={stepPath(d.steps[0], sx, sy)} />
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
