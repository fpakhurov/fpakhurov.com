---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The generator function countdown of the note, driven by three next(g) calls in CPython 3.14.7:
// next 1 prints 'start' and returns 2; next 2 returns 1; next 3 prints 'done' and raises StopIteration('finished').
// Replayed with a JavaScript generator, which suspends and resumes the same way.
function* countdown(n: number) { while (n > 0) { yield n; n -= 1; } return 'finished'; }
{
  const g = countdown(2);
  const r = [g.next(), g.next(), g.next()];
  if (JSON.stringify(r) !== '[{"value":2,"done":false},{"value":1,"done":false},{"value":"finished","done":true}]') throw new Error('GenTimeline: replay');
}

interface Msg { s: number; toGen: boolean; y: number; label: string; kind: 'call' | 'ret' | 'raise' }
interface Note { s: number; y: number; text: string; tone: string }
const msgs: Msg[] = [
  { s: 1, toGen: true, y: 70, label: 'countdown(2)', kind: 'call' },
  { s: 1, toGen: false, y: 116, label: ru ? 'объект-генератор g' : 'generator object g', kind: 'ret' },
  { s: 2, toGen: true, y: 160, label: 'next(g)', kind: 'call' },
  { s: 2, toGen: false, y: 222, label: '2', kind: 'ret' },
  { s: 3, toGen: true, y: 266, label: 'next(g)', kind: 'call' },
  { s: 3, toGen: false, y: 328, label: '1', kind: 'ret' },
  { s: 4, toGen: true, y: 372, label: 'next(g)', kind: 'call' },
  { s: 4, toGen: false, y: 434, label: "StopIteration('finished')", kind: 'raise' },
];
const notes: Note[] = ru
  ? [
      { s: 1, y: 94, text: 'кадр создан, код не запущен', tone: 'f-t-muted' },
      { s: 2, y: 182, text: "print('start')", tone: 'f-t-blue' },
      { s: 2, y: 202, text: 'yield n: пауза, n = 2', tone: 'f-t-amber' },
      { s: 3, y: 288, text: 'с места паузы: n -= 1', tone: 'f-t-blue' },
      { s: 3, y: 308, text: 'yield n: пауза, n = 1', tone: 'f-t-amber' },
      { s: 4, y: 394, text: "n = 0: print('done')", tone: 'f-t-blue' },
      { s: 4, y: 414, text: "return 'finished': кадр закрыт", tone: 'f-t-red' },
    ]
  : [
      { s: 1, y: 94, text: 'frame created, no code run', tone: 'f-t-muted' },
      { s: 2, y: 182, text: "print('start')", tone: 'f-t-blue' },
      { s: 2, y: 202, text: 'yield n: suspended, n = 2', tone: 'f-t-amber' },
      { s: 3, y: 288, text: 'resume: n -= 1', tone: 'f-t-blue' },
      { s: 3, y: 308, text: 'yield n: suspended, n = 1', tone: 'f-t-amber' },
      { s: 4, y: 394, text: "n = 0: print('done')", tone: 'f-t-blue' },
      { s: 4, y: 414, text: "return 'finished': closed", tone: 'f-t-red' },
    ];
const heads = ru ? ['вызывающий код', 'кадр генератора'] : ['caller', 'generator frame'];
const steps = ru
  ? ['вызов функции-генератора создаёт объект с кадром, но не выполняет код', 'next(g) запускает кадр до первого yield; 2 возвращается, кадр на паузе', 'next(g) продолжает с места паузы до следующего yield', 'next(g): цикл закончился, return превращается в StopIteration']
  : ['calling a generator function creates an object with a frame and runs no code', 'next(g) runs the frame up to the first yield; 2 is returned and the frame is suspended', 'next(g) resumes where it paused and runs to the next yield', 'next(g): the loop ends, and return becomes StopIteration'];

interface Layout { cls: string; W: number; H: number; lanes: [number, number]; sans: number; mono: number; noteX: number; noteAnchor: 'start' | 'end'; headAnchor: ['middle' | 'start' | 'end', 'middle' | 'start' | 'end']; noteDy?: number; headX: [number, number]; badgeX: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 452, lanes: [220, 440], sans: 6.5, mono: 7.5, noteX: 452, noteAnchor: 'start', headAnchor: ['middle', 'middle'], headX: [220, 440], badgeX: 40 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 452, lanes: [36, 330], sans: 7.3, mono: 8.4, noteX: 320, noteAnchor: 'end', headAnchor: ['start', 'end'], headX: [8, 352], badgeX: 14, noteDy: -6 },
];
for (const L of layouts) {
  const span = L.lanes[1] - L.lanes[0];
  for (const m of msgs) if (m.label.length * L.mono > span - 12) throw new Error(`label "${m.label}" wider than its arrow at ${L.W}`);
  for (const n of notes) {
    const w = n.text.length * L.mono;
    if (L.noteAnchor === 'start' && L.noteX + w > L.W - 4) throw new Error(`note "${n.text}" overflows at ${L.W}`);
    if (L.noteAnchor === 'end' && L.noteX - w < L.lanes[0] + 8) throw new Error(`note "${n.text}" runs into the caller lane at ${L.W}`);
  }
  if (L.headAnchor[1] === 'end' && L.headX[1] - heads[1].length * L.sans < L.headX[0] + heads[0].length * L.sans + 10) throw new Error('heads collide');
  if (L.headAnchor[1] === 'middle' && L.headX[1] + (heads[1].length * L.sans) / 2 > L.W - 2) throw new Error('head overflows');
}
const id = 'gen-timeline';
---

<Figure
  id={id}
  title={ru ? 'Генератор: кадр, который встаёт на паузу' : 'A generator: a frame that pauses'}
  caption={ru
    ? 'Функция-генератор countdown из текста, вызванная как g = countdown(2) и трижды next(g), CPython 3.14.7; время идёт сверху вниз. Вызов функции только создаёт объект-генератор с кадром: локальными переменными и позицией в коде (1). Каждый next(g) продолжает кадр с того места, где он остановился, до следующего yield, который отдаёт значение и снова ставит кадр на паузу; локальная переменная n сохраняется между вызовами (2, 3). Когда функция доходит до return, генератор закрывается, и next сообщает StopIteration со значением return (4). Синие строки — выполняемый код, жёлтые — паузы.'
    : 'The generator function countdown of the text, called as g = countdown(2) and then next(g) three times, CPython 3.14.7; time runs downwards. Calling the function only creates a generator object holding a frame: the local variables and a position in the code (1). Each next(g) resumes the frame where it stopped and runs to the next yield, which hands out a value and suspends the frame again; the local n survives between calls (2, 3). When the function reaches return, the generator closes and next signals StopIteration carrying the returned value (4). Blue lines are code that runs, amber ones the pauses.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Вызывающий код и кадр генератора по очереди' : 'The caller and the generator frame taking turns'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Две вертикальные линии: вызывающий код и кадр генератора. Вызов countdown(2) возвращает объект-генератор. Первый next(g) запускает кадр: печать start, yield 2. Второй продолжает его: n уменьшается, yield 1. Третий: цикл закончился, печать done, return, и вызывающий код получает StopIteration.'
        : 'Two vertical lines: the caller and the generator frame. Calling countdown(2) returns a generator object. The first next(g) starts the frame: it prints start and yields 2. The second resumes it: n decreases and it yields 1. The third: the loop ends, it prints done and returns, and the caller receives StopIteration.'}</desc>
      {heads.map((h, i) => (
        <g>
          <text class="f-small" x={L.headX[i]} y={34} text-anchor={L.headAnchor[i]} style="font-weight: 650">{h}</text>
          <path class="f-thin f-dash" style={`stroke: ${[toneVar.x, toneVar.h][i]}`} d={`M ${L.lanes[i]} ${44} V ${L.H - 6}`} />
        </g>
      ))}
      {msgs.map((m) => {
        const [x1, x2] = m.toGen ? [L.lanes[0], L.lanes[1]] : [L.lanes[1], L.lanes[0]];
        const dir = m.toGen ? 1 : -1;
        const cls = m.kind === 'raise' ? 'f-red f-bold' : m.kind === 'ret' ? 'f-muted f-dash' : '';
        const head = m.kind === 'raise' ? 'url(#f-arrow-red)' : m.kind === 'ret' ? 'url(#f-arrow-muted)' : 'url(#f-arrow)';
        return (
          <g data-s={String(m.s)}>
            <path class={`f-line ${cls}`} d={`M ${x1 + dir * 4} ${m.y} H ${x2 - dir * 6}`} marker-end={head} />
            <text class={`f-small f-halo ${m.kind === 'raise' ? 'f-t-red' : m.kind === 'ret' ? 'f-t-muted' : ''}`} x={(x1 + x2) / 2} y={m.y - 7} text-anchor="middle" style="font-family: var(--mono)">{m.label}</text>
          </g>
        );
      })}
      {notes.map((n) => (
        <text data-s={String(n.s)} class={`f-small ${n.tone}`} x={L.noteX} y={n.y + (L.noteDy ?? 0)} text-anchor={L.noteAnchor} style="font-family: var(--mono)">{n.text}</text>
      ))}
      {[1, 2, 3, 4].map((s) => (
        <g data-s={String(s)}><Badge x={L.badgeX} y={msgs.find((m) => m.s === s)!.y - 4} n={s} /></g>
      ))}
    </svg>
  ))}
  <Stepper steps={steps} />
</Figure>
