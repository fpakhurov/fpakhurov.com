---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Measured once with tracemalloc (peak bytes allocated during the call), CPython 3.14.7, 64-bit macOS (arm64):
// sum([x * x for x in range(n)]) against sum(x * x for x in range(n)).
const data: [number, number, number][] = [
  [1e3, 39712, 376], [3e3, 118304, 376], [1e4, 401440, 376], [3e4, 1202752, 376],
  [1e5, 3997280, 408], [3e5, 12197856, 408], [1e6, 40445024, 408],
];
const perItem = data[6][1] / data[6][0];
if (!(perItem > 40 && perItem < 41)) throw new Error(`GenMemory: ${perItem} bytes per item`);
if (Math.max(...data.map((d) => d[2])) > 500) throw new Error('GenMemory: generator should stay under 500 bytes');

const t = ru
  ? { x: 'число элементов n (лог. шкала)', y: 'пик памяти, байты (лог. шкала)', list: 'sum([x * x for x in range(n)])', gen: 'sum(x * x for x in range(n))', per: '≈ 40 байт на элемент', flat: '≈ 400 байт при любом n' }
  : { x: 'number of items n (log scale)', y: 'peak memory, bytes (log scale)', list: 'sum([x * x for x in range(n)])', gen: 'sum(x * x for x in range(n))', per: '≈ 40 bytes per item', flat: '≈ 400 bytes at any n' };
interface Layout { cls: string; W: number; H: number; x0: number; x1: number; y0: number; y1: number; sans: number; mono: number; leg: [number, number]; per: [number, number]; flat: [number, number] }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 320, x0: 80, x1: 440, y0: 262, y1: 30, sans: 6.5, mono: 7.5, leg: [470, 70], per: [96, 92], flat: [280, 222] },
  { cls: 'fig-narrow', W: 360, H: 420, x0: 56, x1: 340, y0: 262, y1: 30, sans: 6.5, mono: 7.5, leg: [16, 336], per: [64, 82], flat: [150, 224] },
];
for (const L of layouts) {
  for (const s of [t.list, t.gen]) if (L.leg[0] + 34 + s.length * L.mono > L.W - 4) throw new Error(`legend "${s}" overflows at ${L.W}`);
  if (L.per[0] + t.per.length * L.sans > L.x1) throw new Error('per label overflows');
  if (L.flat[0] + t.flat.length * L.sans > L.x1) throw new Error('flat label overflows');
}
const id = 'gen-memory';
---

<Figure
  id={id}
  title={ru ? 'Список хранит все элементы, генератор — один кадр' : 'A list holds every item, a generator one frame'}
  caption={ru
    ? 'Пик памяти, выделенной при вычислении суммы квадратов первых n чисел, обе оси логарифмические; tracemalloc, CPython 3.14.7 на 64-битной macOS (arm64), измерено один раз. Красная линия: включение строит список всех квадратов до того, как sum начнёт складывать, и память растёт пропорционально n: около 40 байт на элемент (8-байтовая ссылка, доля запасных ячеек списка и объект int размером 28–32 байта), 40 МБ при миллионе. Синяя: генераторное выражение отдаёт квадраты по одному, и sum выбрасывает каждый после сложения; пик — около 400 байт, сам генератор и один int, при любом n.'
    : 'The peak memory allocated while computing the sum of the first n squares, both axes logarithmic; tracemalloc, CPython 3.14.7 on 64-bit macOS (arm64), measured once. Red: the comprehension builds a list of all the squares before sum starts adding, and memory grows in proportion to n: about 40 bytes per item (an 8-byte reference, a share of the list's spare slots and an int object of 28 to 32 bytes), 40 MB for a million. Blue: the generator expression hands out the squares one at a time, and sum drops each after adding it; the peak is about 400 bytes, the generator and one int, at any n.'}
>
  {layouts.map((L) => {
    const sx = scale([3, 6], [L.x0, L.x1]), sy = scale([2, 8], [L.y0, L.y1]);
    const line = (k: number) => polyline(data.map((d) => [sx(Math.log10(d[0])), sy(Math.log10(d[k]))]));
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Пик памяти списка и генератора в зависимости от n' : 'Peak memory of a list and a generator against n'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Красная линия поднимается по прямой от 40 КБ при тысяче элементов до 40 МБ при миллионе. Синяя лежит горизонтально около 400 байт.'
          : 'The red line rises straight from 40 KB at a thousand items to 40 MB at a million. The blue line lies flat near 400 bytes.'}</desc>
        {[2, 3, 4, 5, 6, 7, 8].map((e) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(e)} H ${L.x1}`} />
            <text class="f-small f-t-muted" x={L.x0 - 8} y={sy(e) + 4} text-anchor="end">{`10${'⁰¹²³⁴⁵⁶⁷⁸'[e]}`}</text>
          </g>
        ))}
        {[3, 4, 5, 6].map((e) => <text class="f-small f-t-muted" x={sx(e)} y={L.y0 + 18} text-anchor="middle">{`10${'⁰¹²³⁴⁵⁶'[e]}`}</text>)}
        <path class="f-axis" d={`M ${L.x0} ${L.y1 - 6} V ${L.y0} H ${L.x1 + 6}`} />
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y0 + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.x0 - 40} y={L.y1 - 14}>{t.y}</text>
        <path class="f-line f-red" d={line(1)} />
        <path class="f-line f-blue" d={line(2)} />
        {data.map((d) => <circle cx={sx(Math.log10(d[0]))} cy={sy(Math.log10(d[1]))} r="3" class="f-solid-red" />)}
        {data.map((d) => <circle cx={sx(Math.log10(d[0]))} cy={sy(Math.log10(d[2]))} r="3" class="f-solid-blue" />)}
        <text class="f-small f-t-red f-halo" x={L.per[0]} y={L.per[1]}>{t.per}</text>
        <text class="f-small f-t-blue f-halo" x={L.flat[0]} y={L.flat[1]}>{t.flat}</text>
        {[[1, 'f-red', t.list], [2, 'f-blue', t.gen]].map(([, cls, label], i) => (
          <g>
            <path class={`f-line ${cls}`} d={`M ${L.leg[0]} ${L.leg[1] + i * 24 - 4} h 26`} />
            <text class="f-small" x={L.leg[0] + 34} y={L.leg[1] + i * 24} style="font-family: var(--mono)">{label}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
