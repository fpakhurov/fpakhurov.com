---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// for x in xs: print(x) with xs = [10, 20], as the loop runs it: GET_ITER once, then FOR_ITER before every pass
// (the bytecode of CPython 3.14.7). Replayed here with a JavaScript iterator, which follows the same protocol.
const xs = [10, 20];
const it = xs[Symbol.iterator]();
const seen: string[] = [];
for (let r = it.next(); !r.done; r = it.next()) seen.push(String(r.value));
if (seen.join() !== '10,20') throw new Error('IterProtocol: replay');

type Lane = 0 | 1 | 2;   // the for loop, the iterator, the list
interface Msg { s: number; from: Lane; to: Lane; y: number; label: string; kind: 'call' | 'ret' | 'raise' }
interface Note { s: number; lane: Lane; y: number; wide: string; narrow: string; side: 'left' | 'right' }
const msgs: Msg[] = [
  { s: 1, from: 0, to: 2, y: 70, label: 'iter(xs)', kind: 'call' },
  { s: 1, from: 2, to: 0, y: 100, label: ru ? 'list_iterator, индекс 0' : 'list_iterator, index 0', kind: 'ret' },
  { s: 2, from: 0, to: 1, y: 144, label: 'next(it)', kind: 'call' },
  { s: 2, from: 1, to: 2, y: 170, label: 'xs[0]', kind: 'call' },
  { s: 2, from: 1, to: 0, y: 196, label: '10', kind: 'ret' },
  { s: 3, from: 0, to: 1, y: 240, label: 'next(it)', kind: 'call' },
  { s: 3, from: 1, to: 2, y: 266, label: 'xs[1]', kind: 'call' },
  { s: 3, from: 1, to: 0, y: 292, label: '20', kind: 'ret' },
  { s: 4, from: 0, to: 1, y: 336, label: 'next(it)', kind: 'call' },
  { s: 4, from: 1, to: 0, y: 376, label: 'StopIteration', kind: 'raise' },
];
const notes: Note[] = [
  { s: 2, lane: 0, y: 200, wide: 'x = 10; print(x)', narrow: 'x = 10', side: 'left' },
  { s: 3, lane: 0, y: 296, wide: 'x = 20; print(x)', narrow: 'x = 20', side: 'left' },
  { s: 4, lane: 1, y: 358, wide: ru ? 'индекс 2 = len(xs)' : 'index 2 = len(xs)', narrow: ru ? 'конец' : 'no more', side: 'right' },
  { s: 4, lane: 0, y: 380, wide: ru ? 'цикл завершён' : 'the loop ends', narrow: ru ? 'выход' : 'exit', side: 'left' },
];
const heads = ru ? ['цикл for', 'итератор', 'список xs'] : ['for loop', 'iterator', 'list xs'];
const steps = ru
  ? ['GET_ITER: iter(xs) возвращает новый итератор с индексом 0', 'FOR_ITER: next(it) читает xs[0], возвращает 10; тело цикла выполняется с x = 10', 'FOR_ITER: next(it) возвращает 20; тело выполняется с x = 20', 'FOR_ITER: индекс дошёл до len(xs), next(it) сообщает StopIteration, и цикл завершается']
  : ['GET_ITER: iter(xs) returns a new iterator at index 0', 'FOR_ITER: next(it) reads xs[0] and returns 10; the body runs with x = 10', 'FOR_ITER: next(it) returns 20; the body runs with x = 20', 'FOR_ITER: the index has reached len(xs), next(it) signals StopIteration, and the loop ends'];
const code = ['xs = [10, 20]', 'for x in xs:', '    print(x)'];

interface Layout { cls: string; W: number; H: number; lanes: number[]; dy: number; sans: number; mono: number; codeAt: [number, number]; badgeX: number; wide: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 400, lanes: [250, 470, 670], dy: 0, sans: 6.5, mono: 7.5, codeAt: [40, 64], badgeX: 22, wide: true },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 476, lanes: [110, 222, 320], dy: 76, sans: 7.3, mono: 8.4, codeAt: [34, 20], badgeX: 14, wide: false },
];
for (const L of layouts) {
  for (const m of msgs) {
    const span = Math.abs(L.lanes[m.to] - L.lanes[m.from]);
    if (m.label.length * L.sans > span - 8) throw new Error(`label "${m.label}" wider than its arrow at ${L.W}`);
  }
  for (const n of notes) {
    const s = L.wide ? n.wide : n.narrow, w = s.length * L.mono;
    const x = L.lanes[n.lane];
    if (n.side === 'left' && x - 10 - w < (L.wide ? L.badgeX + 12 : 2)) throw new Error(`note "${s}" overflows left at ${L.W}`);
    if (n.side === 'right' && x + 10 + w > (L.lanes[n.lane + 1] ?? L.W) - 6) throw new Error(`note "${s}" crosses the next lane at ${L.W}`);
  }
  for (const [i, h] of heads.entries()) {
    const half = (h.length * L.sans) / 2;
    if (L.lanes[i] + half > L.W - 2) throw new Error(`head "${h}" overflows at ${L.W}`);
    if (i > 0 && L.lanes[i] - half < L.lanes[i - 1] + (heads[i - 1].length * L.sans) / 2 + 6) throw new Error(`heads collide at ${L.W}`);
  }
  for (const s of code) if (L.codeAt[0] + s.length * L.mono > (L.wide ? L.lanes[0] - 12 : L.W - 4)) throw new Error(`code "${s}" overflows at ${L.W}`);
  if (msgs[msgs.length - 1].y + L.dy + 16 > L.H) throw new Error('rows run off the bottom');
}
const id = 'iter-protocol';
---

<Figure
  id={id}
  title={ru ? 'Протокол итератора: что делает цикл for' : 'The iterator protocol: what a for loop does'}
  caption={ru
    ? 'Цикл for x in xs: print(x) для xs = [10, 20], время идёт сверху вниз. Один раз цикл вызывает iter(xs) и получает новый объект-итератор, который хранит ссылку на список и индекс (1). Перед каждым проходом он вызывает next(it): итератор читает элемент по индексу, сдвигает индекс и возвращает элемент, который связывается с x (2, 3). Когда индекс доходит до len(xs), next сообщает StopIteration, и цикл завершается (4). В байт-коде CPython 3.14.7 шаг 1 — команда GET_ITER, остальные — FOR_ITER. Сплошные стрелки — вызовы, пунктир — возвращаемые значения, красная — исключение.'
    : 'The loop for x in xs: print(x) with xs = [10, 20], time running downwards. The loop calls iter(xs) once and receives a new iterator object, which holds a reference to the list and an index (1). Before every pass it calls next(it): the iterator reads the item at its index, advances the index and returns the item, which is bound to x (2, 3). When the index reaches len(xs), next signals StopIteration, and the loop ends (4). In CPython 3.14.7 bytecode, step 1 is the instruction GET_ITER, the others FOR_ITER. Solid arrows are calls, dashed ones returned values, the red one the exception.'}
>
  {layouts.map((L) => {
    const top = 34 + L.dy;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Последовательность вызовов iter и next в цикле for' : 'The sequence of iter and next calls in a for loop'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Три вертикальные линии: цикл for, итератор и список. Цикл вызывает iter у списка и получает итератор. Затем трижды вызывает next у итератора: первые два раза итератор читает элемент списка и возвращает 10, затем 20; в третий раз он сообщает StopIteration, и цикл завершается.'
          : 'Three vertical lines: the for loop, the iterator and the list. The loop calls iter on the list and receives an iterator. It then calls next on the iterator three times: the first two times the iterator reads an item of the list and returns 10, then 20; the third time it signals StopIteration, and the loop ends.'}</desc>
        {code.map((s, i) => <text class="f-small" x={L.codeAt[0]} y={L.codeAt[1] + i * 20} style="font-family: var(--mono); white-space: pre">{s}</text>)}
        {heads.map((h, i) => (
          <g data-s={i === 1 ? '1 2 3 4' : undefined}>
            <text class="f-small" x={L.lanes[i]} y={top} text-anchor="middle" style="font-weight: 650">{h}</text>
            <path class="f-thin f-dash" style={`stroke: ${[toneVar.x, toneVar.g, toneVar.h][i]}`} d={`M ${L.lanes[i]} ${top + 8} V ${L.H - 8}`} />
          </g>
        ))}
        {msgs.map((m) => {
          const x1 = L.lanes[m.from], x2 = L.lanes[m.to], y = m.y + L.dy;
          const dir = Math.sign(x2 - x1);
          const cls = m.kind === 'raise' ? 'f-red f-bold' : m.kind === 'ret' ? 'f-muted f-dash' : '';
          const head = m.kind === 'raise' ? 'url(#f-arrow-red)' : m.kind === 'ret' ? 'url(#f-arrow-muted)' : 'url(#f-arrow)';
          return (
            <g data-s={String(m.s)}>
              <path class={`f-line ${cls}`} d={`M ${x1 + dir * 4} ${y} H ${x2 - dir * 6}`} marker-end={head} />
              <text class={`f-small f-halo ${m.kind === 'raise' ? 'f-t-red' : m.kind === 'ret' ? 'f-t-muted' : ''}`} x={(x1 + x2) / 2} y={y - 7} text-anchor="middle" style="font-family: var(--mono)">{m.label}</text>
            </g>
          );
        })}
        {notes.map((n) => {
          const x = L.lanes[n.lane];
          return (
            <text data-s={String(n.s)} class={`f-small ${n.s === 4 ? 'f-t-red' : 'f-t-blue'}`} x={n.side === 'left' ? x - 10 : x + 10} y={n.y + L.dy} text-anchor={n.side === 'left' ? 'end' : 'start'} style="font-family: var(--mono)">{L.wide ? n.wide : n.narrow}</text>
          );
        })}
        {[1, 2, 3, 4].map((s) => (
          <g data-s={String(s)}><Badge x={L.badgeX} y={msgs.find((m) => m.s === s)!.y + L.dy - 4} n={s} /></g>
        ))}
      </svg>
    );
  })}
  <Stepper steps={steps} />
</Figure>
