---
import Figure from '../Figure.astro';
import { polyline } from '../geometry';
import { bestFirst } from './search';
import { MAP, gridProblem } from './grid';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The grid of the Code section, searched three times with f = g + w·h, h the Manhattan distance to G.
const { start, goal, nb, h, wall, key } = gridProblem();
const runs = [0, 1, 2].map((w) => ({ w, ...bestFirst(start, goal, nb, h, w, key) }));
const got = runs.map((r) => `${r.steps.length}/${r.cost}`).join(' ');
if (got !== '136/21 80/21 68/25') throw new Error(`GridSearch: the searches drifted from the note (${got})`);

const t = ru
  ? { title: 'Сколько клеток раскрывает поиск при разных эвристиках', names: ['по стоимости (w = 0)', 'A* (w = 1)', 'взвешенный A* (w = 2)'], exp: 'раскрыто', cost: 'путь',
      desc: `Три копии одной сетки 16 на 10 со стенами между S слева и G справа. Закрашены раскрытые клетки, красная линия — найденный путь. Поиск по критерию стоимости раскрывает ${runs[0].steps.length} клеток и находит путь длины 21, A* — ${runs[1].steps.length} клеток и путь длины 21, взвешенный A* с w = 2 — ${runs[2].steps.length} клеток и путь длины 25.` }
  : { title: 'How many cells the search expands under different heuristics', names: ['uniform cost (w = 0)', 'A* (w = 1)', 'weighted A* (w = 2)'], exp: 'expanded', cost: 'path',
      desc: `Three copies of one 16 by 10 grid with walls between S on the left and G on the right. Shaded cells were expanded; the red line is the path found. Uniform-cost search expands ${runs[0].steps.length} cells and finds a path of length 21, A* expands ${runs[1].steps.length} cells for a path of length 21, weighted A* with w = 2 expands ${runs[2].steps.length} cells for a path of length 25.` };
const id = 'grid-search';
const caption = ru
  ? `Ход на соседнюю клетку стоит 1, эвристика — манхэттенское расстояние до G, f = g + w·h. При w = 0 (поиск по критерию стоимости) граница расходится от S во все стороны, и до цели раскрыто ${runs[0].steps.length} клеток. A* (w = 1) тянется к G и раскрывает ${runs[1].steps.length}; путь тот же, длины 21, потому что манхэттенское расстояние допустимо и согласовано. При w = 2 взвешенная эвристика 2h уже не допустима: поиск раскрывает ${runs[2].steps.length} клеток, но обходит первую стену сверху и находит путь длины 25, не длиннее 2 · 21, как гарантирует взвешенный A*.`
  : `Moves to a neighbouring cell cost 1, the heuristic is the Manhattan distance to G, and f = g + w·h. With w = 0 (uniform-cost search) the frontier spreads from S in every direction, and ${runs[0].steps.length} cells are expanded before the goal. A* (w = 1) is pulled towards G and expands ${runs[1].steps.length}; the path is the same, of length 21, because the Manhattan distance is admissible and consistent. With w = 2 the heuristic is no longer admissible: the search expands ${runs[2].steps.length} cells but goes over the top of the first wall and returns a path of length 25, no longer than 2 · 21, as weighted A* guarantees.`;

const rowsN = MAP.length, colsN = MAP[0].length;
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 214, cell: 14, at: (i: number) => [16 + i * 252, 30] as [number, number], tdy: -10, cdy: 160 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 560, cell: 13, at: (i: number) => [76, 26 + i * 184] as [number, number], tdy: -10, cdy: 150 },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
      {runs.map((r, i) => {
        const [x0, y0] = L.at(i), c = L.cell;
        const expanded = new Set(r.steps.map((s) => key(s.node)));
        const cx = (p: number[]) => x0 + (p[1] + 0.5) * c, cy = (p: number[]) => y0 + (p[0] + 0.5) * c;
        return (
          <g>
            <text class="f-small" x={x0} y={y0 + L.tdy}>{t.names[i]}</text>
            {MAP.flatMap((row, rr) => [...row].map((_, cc) => {
              const k = key([rr, cc]);
              const cls = wall[rr][cc] ? 'f-fill-ink' : expanded.has(k) ? 'f-fill-blue' : 'f-fill-paper';
              return <rect x={x0 + cc * c} y={y0 + rr * c} width={c} height={c} class={cls} style="stroke: var(--line); stroke-width: 0.6" />;
            }))}
            <rect x={x0} y={y0} width={colsN * c} height={rowsN * c} class="f-thin f-muted" fill="none" />
            <path class="f-line f-red" d={polyline(r.path.map((p) => [cx(p), cy(p)] as [number, number]))} />
            <text class="f-small f-t-green" x={cx(start)} y={cy(start) + 4} text-anchor="middle" style="font-weight: 700">S</text>
            <text class="f-small f-t-red" x={cx(goal)} y={cy(goal) + 4} text-anchor="middle" style="font-weight: 700">G</text>
            <text class="f-small f-t-muted" x={x0} y={y0 + L.cdy}>{`${t.exp} ${r.steps.length}, ${t.cost} ${r.cost}`}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
