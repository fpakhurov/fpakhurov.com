---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { bestFirst } from './search';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The graph of the worked example: undirected edges with costs, and a consistent heuristic h.
const edges: [string, string, number][] = [['S', 'A', 2], ['S', 'B', 3], ['A', 'C', 3], ['B', 'C', 1], ['A', 'D', 4], ['C', 'G', 4], ['D', 'G', 1], ['B', 'E', 2], ['E', 'G', 6]];
const H: Record<string, number> = { S: 6, A: 5, B: 4, C: 4, D: 1, E: 5, G: 0 };
for (const [u, v, c] of edges) if (H[u] > c + H[v] || H[v] > c + H[u]) throw new Error(`AStarTrace: h is not consistent on ${u}–${v}`);
const nb = (s: string): [string, number][] => edges.flatMap(([u, v, c]) => (u === s ? [[v, c]] : v === s ? [[u, c]] : [])) as [string, number][];
const astar = bestFirst('S', 'G', nb, (s) => H[s], 1);
const ucs = bestFirst('S', 'G', nb, () => 0, 0);
const got = [astar.steps.map((s) => s.node).join(''), astar.path.join(''), astar.cost, ucs.steps.map((s) => s.node).join(''), ucs.cost].join(' ');
if (got !== 'SBADG SADG 7 SABCEDG 7') throw new Error(`AStarTrace: the search drifted from the note (${got})`);
const onPath = new Set(astar.path.slice(1).map((v, i) => [astar.path[i], v].sort().join('')));
const order = new Map(astar.steps.map((s, i) => [s.node, i + 1]));

const t = ru
  ? { title: 'A* на графе разобранного примера', panel: 'граница после каждого раскрытия, f = g + h', exp: 'раскрыть', front: 'граница', empty: 'цель раскрыта: путь S–A–D–G, стоимость 7',
      desc: 'Граф из семи вершин S, A, B, C, D, E, G со стоимостями рёбер и значениями эвристики h у вершин. A* раскрывает вершины в порядке S, B, A, D, G и находит путь S–A–D–G стоимостью 7; C и E остаются на границе с f = 8 и f = 10.' }
  : { title: 'A* on the graph of the worked example', panel: 'the frontier after each expansion, f = g + h', exp: 'expand', front: 'frontier', empty: 'goal expanded: path S–A–D–G, cost 7',
      desc: 'A graph of seven nodes S, A, B, C, D, E, G with edge costs, and the heuristic h next to each node. A* expands S, B, A, D, G in that order and finds the path S–A–D–G of cost 7; C and E stay on the frontier with f = 8 and f = 10.' };
const steps = astar.steps.map((s) => (ru
  ? `раскрыть ${s.node}: g = ${s.g}, f = ${s.f}`
  : `expand ${s.node}: g = ${s.g}, f = ${s.f}`));
const rows = astar.steps.map((s, i) => ({
  head: `${t.exp} ${s.node}: g = ${s.g}, f = ${s.f}`,
  tail: i === astar.steps.length - 1 ? t.empty : `${t.front}: ${s.frontier.map((x) => `${x.node} ${x.f}`).join(' · ')}`,
}));
const id = 'astar-trace';
const caption = ru
  ? `Числа на рёбрах — стоимости шагов, у вершин — эвристика h, нижняя оценка стоимости пути до G; она согласована: h(n) ≤ c(n, n′) + h(n′) на каждом ребре. A* раскрывает вершину с наименьшим f = g + h (при равенстве — с большим g). Номера в кружках показывают порядок раскрытия: S, B, A, D, G. Путь S–A–D–G (жирные рёбра) стоит 7 и оптимален. Поиск по критерию стоимости (h = 0) раскрыл бы до цели семь вершин: S, A, B, C, E, D, G; A* раскрывает пять, потому что значения f у C (8) и у E (10) больше оптимальной стоимости 7.`
  : `Numbers on the edges are step costs; next to each node is the heuristic h, a lower estimate of the cost to G. It is consistent: h(n) ≤ c(n, n′) + h(n′) on every edge. A* expands the node with the smallest f = g + h (ties to the larger g). The badges give the order of expansion: S, B, A, D, G. The path S–A–D–G (bold edges) costs 7 and is optimal. Uniform-cost search (h = 0) would expand seven nodes, S, A, B, C, E, D, G, before the goal; A* expands five, because C with f = 8 and E with f = 10 lie above the optimal cost 7.`;

const pos: Record<string, [number, number]> = { S: [40, 150], A: [140, 70], B: [140, 230], C: [240, 150], D: [300, 50], E: [300, 250], G: [380, 150] };
const hPos: Record<string, [number, number]> = { S: [40, 188], A: [140, 42], B: [140, 270], C: [240, 190], D: [300, 22], E: [300, 285], G: [380, 188] };
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 300, gx: 0, gy: 0, s: 1, rx: 440, ry: 44, dy: 50 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 570, gx: -12, gy: 0, s: 0.86, rx: 16, ry: 300, dy: 58 },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const P = (n: string): [number, number] => [L.gx + L.s * pos[n][0] + (1 - L.s) * 40, L.gy + L.s * pos[n][1] + (1 - L.s) * 20];
    const HP = (n: string): [number, number] => [L.gx + L.s * hPos[n][0] + (1 - L.s) * 40, L.gy + L.s * hPos[n][1] + (1 - L.s) * 20];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {edges.map(([u, v, c]) => {
          const [x1, y1] = P(u), [x2, y2] = P(v);
          const path = onPath.has([u, v].sort().join(''));
          return (
            <g data-s={path ? '5' : undefined}>
              <path class={`f-line ${path ? 'f-red f-bold' : 'f-muted'}`} d={`M ${x1} ${y1} L ${x2} ${y2}`} />
              <text class="f-small f-halo" x={(x1 + x2) / 2} y={(y1 + y2) / 2 + 4} text-anchor="middle">{String(c)}</text>
            </g>
          );
        })}
        {Object.keys(pos).map((n) => {
          const [x, y] = P(n), [hx, hy] = HP(n);
          const k = order.get(n);
          return (
            <g data-s={k ? String(k) : undefined}>
              <circle cx={x} cy={y} r="17" class={k ? 'f-fill-blue' : 'f-fill-paper'} style={`stroke: var(${k ? '--fig-blue' : '--muted'}); stroke-width: 1.4`} />
              <text class="f-label" x={x} y={y + 5} text-anchor="middle">{n}</text>
              <text class="f-small f-t-amber" x={hx} y={hy} text-anchor="middle">{`h=${H[n]}`}</text>
              {k && <Badge x={x + 19} y={y - 17} n={k} />}
            </g>
          );
        })}
        <text class="f-small f-t-muted" x={L.rx} y={L.ry - 20}>{t.panel}</text>
        {rows.map((r, i) => (
          <g data-s={String(i + 1)}>
            <text class="f-small" x={L.rx} y={L.ry + i * L.dy}><tspan style="font-weight: 650">{`${i + 1}. `}</tspan>{r.head}</text>
            <text class="f-small f-t-muted" x={L.rx + 16} y={L.ry + i * L.dy + 18}>{r.tail}</text>
          </g>
        ))}
      </svg>
    );
  })}
  <Stepper steps={steps} />
</Figure>
