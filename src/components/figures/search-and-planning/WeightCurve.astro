---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { bestFirst } from './search';
import { gridProblem } from './grid';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Weighted A* on the grid of the Code section: f = g + w·h for seven weights.
const { start, goal, nb, h, key } = gridProblem();
const ws = [0, 0.5, 1, 1.5, 2, 3, 5];
const res = ws.map((w) => { const r = bestFirst(start, goal, nb, h, w, key); return { w, exp: r.steps.length, cost: r.cost }; });
const got = res.map((r) => `${r.exp}/${r.cost}`).join(' ');
if (got !== '136/21 123/21 80/21 75/23 68/25 65/25 60/25') throw new Error(`WeightCurve: drifted from the Code section (${got})`);
const Cstar = res[2].cost;
for (const r of res) if (r.w >= 1 && r.cost > r.w * Cstar) throw new Error('WeightCurve: the weighted A* bound is violated');

const t = ru
  ? { title: 'Вес эвристики: меньше работы, длиннее путь', exp: 'раскрыто клеток', cost: 'длина пути', w: 'вес эвристики w', opt: 'оптимум 21',
      desc: `Две панели в зависимости от веса w от 0 до 5. Левая: число раскрытых клеток падает со 136 при w = 0 до 80 при w = 1 и до 60 при w = 5. Правая: длина найденного пути равна оптимальной 21 при w ≤ 1, 23 при w = 1.5 и 25 при w ≥ 2.` }
  : { title: 'The weight on the heuristic: less work, longer paths', exp: 'cells expanded', cost: 'path length', w: 'heuristic weight w', opt: 'optimum 21',
      desc: `Two panels against the weight w from 0 to 5. Left: the number of expanded cells falls from 136 at w = 0 to 80 at w = 1 and to 60 at w = 5. Right: the length of the path found is the optimal 21 for w ≤ 1, 23 at w = 1.5 and 25 for w ≥ 2.` };
const id = 'weight-curve';
const caption = ru
  ? 'Та же сетка, f = g + w·h. До w = 1 эвристика допустима и путь оптимален; почти вся экономия приходится на переход от w = 0 к w = 1 (со 136 до 80 клеток), то есть на саму эвристику. При w > 1 поиск раскрывает ещё меньше клеток, но путь удлиняется до 23 и 25 шагов. Гарантия взвешенного A* — стоимость не больше w · C* — выполняется с большим запасом.'
  : 'The same grid, f = g + w·h. Up to w = 1 the heuristic is admissible and the path is optimal; most of the saving comes from going from w = 0 to w = 1 (from 136 to 80 cells), that is, from the heuristic itself. With w > 1 the search expands fewer cells still, but the path grows to 23 and 25 steps. The bound of weighted A*, a cost of at most w · C*, holds with a wide margin.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 270, panels: [[70, 360, 40, 210], [460, 744, 40, 210]] as number[][] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 520, panels: [[64, 344, 40, 200], [64, 344, 300, 460]] as number[][] },
];
const series = [
  { key: 'exp' as const, label: t.exp, dom: [0, 150], ticks: [0, 50, 100, 150], cls: 'blue' },
  { key: 'cost' as const, label: t.cost, dom: [18, 26], ticks: [18, 20, 22, 24, 26], cls: 'red' },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
      {series.map((S, i) => {
        const [x0, x1, y0, y1] = L.panels[i];
        const sx = scale([0, 5], [x0, x1]), sy = scale(S.dom as [number, number], [y1, y0]);
        const pts = res.map((r) => [sx(r.w), sy(r[S.key])] as [number, number]);
        return (
          <g>
            {S.ticks.map((v) => <path class="f-grid" d={`M ${x0} ${sy(v)} H ${x1}`} />)}
            <path class="f-axis" d={`M ${x0} ${y0 - 6} V ${y1} H ${x1}`} />
            {S.ticks.map((v) => <text class="f-small" x={x0 - 7} y={sy(v) + 4} text-anchor="end">{String(v)}</text>)}
            {[0, 1, 2, 3, 4, 5].map((v) => <text class="f-small" x={sx(v)} y={y1 + 18} text-anchor="middle">{String(v)}</text>)}
            <text class="f-small f-t-muted" x={(x0 + x1) / 2} y={y1 + 38} text-anchor="middle">{t.w}</text>
            <text class={`f-small f-t-${S.cls}`} x={x0 - 40} y={y0 - 18}>{S.label}</text>
            {S.key === 'cost' && <path class="f-line f-muted f-dash" d={`M ${x0} ${sy(Cstar)} H ${x1}`} />}
            {S.key === 'cost' && <text class="f-small f-t-muted" x={x1} y={sy(Cstar) + 16} text-anchor="end">{t.opt}</text>}
            <path class={`f-line f-${S.cls}`} d={polyline(pts)} />
            {pts.map(([x, y], j) => (
              <g>
                <circle cx={x} cy={y} r="3.2" class={`f-solid-${S.cls}`} />
                {S.key === 'exp' && <text class="f-small f-halo" x={j === pts.length - 1 ? x - 6 : x + 6} y={y - 7} text-anchor={j === pts.length - 1 ? 'end' : 'start'}>{String(res[j].exp)}</text>}
              </g>
            ))}
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
