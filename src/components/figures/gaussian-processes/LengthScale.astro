---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { X, Y, evidence, posterior, bestEll } from './gp';

const ru = pageLang(Astro.url) === 'ru';

// The log evidence of the 12 points as a function of the length scale, sf = 1 and noise sd 0.1 fixed,
// split into its data-fit and complexity terms, and the posterior for three length scales.
const ells = Array.from({ length: 121 }, (_, i) => Math.exp(Math.log(0.2) + (i / 120) * (Math.log(3) - Math.log(0.2))));
const ev = ells.map((l) => evidence(l));
const best = bestEll();
const picks = [0.3, 1.76, 3];
const pe = picks.map((l) => evidence(l).total);
const chk = [best.toFixed(2), ...pe.map((v) => v.toFixed(2))].join();
if (chk !== '1.76,-13.90,-3.89,-23.92') throw new Error(`LengthScale: evidence drifted from the note (${chk})`);
const grid = Array.from({ length: 97 }, (_, i) => -6 + i * 0.125);
const fits = picks.map((l) => posterior(grid, l));
const clamp = (v: number) => Math.max(-2, Math.min(2, v));
const fmt = (v: number) => (v < 0 ? '−' : '') + Math.abs(v).toFixed(1);

const t = ru
  ? { x: 'масштаб ℓ (логарифмическая шкала)', fit: 'согласие с данными', comp: 'штраф за сложность', tot: 'логарифм обоснованности', ev: 'логарифм обоснованности', steps: ['согласие с данными −½ yᵀK⁻¹y: лучше при коротком ℓ', 'член сложности −½ log det K: чем длиннее ℓ, тем меньше штраф', 'их сумма, логарифм обоснованности, максимальна при ℓ = 1.76', 'три модели: ℓ = 0.3 возвращается к нулю между точками, ℓ = 1.76 следует за sin x, ℓ = 3 слишком жёсткая'] }
  : { x: 'length scale ℓ (log scale)', fit: 'data fit', comp: 'complexity', tot: 'log evidence', ev: 'log evidence', steps: ['the data fit −½ yᵀK⁻¹y: better at short ℓ', 'the complexity term −½ log det K: a smaller penalty the longer ℓ is', 'their sum, the log evidence, peaks at ℓ = 1.76', 'three models: ℓ = 0.3 returns to zero between the points, ℓ = 1.76 follows sin x, ℓ = 3 is too stiff'] };
const id = 'gp-length-scale';
const layouts = [
  { cls: 'fig-wide fig-bp-640', W: 760, H: 330, P: { x0: 56, x1: 380, y0: 30, y1: 270 }, minis: [0, 1, 2].map((k) => ({ x0: 450, x1: 740, y0: 40 + k * 100, y1: 100 + k * 100 })) },
  { cls: 'fig-narrow seq-narrow fig-bp-640', W: 360, H: 690, P: { x0: 44, x1: 344, y0: 24, y1: 264 }, minis: [0, 1, 2].map((k) => ({ x0: 24, x1: 344, y0: 360 + k * 112, y1: 424 + k * 112 })) },
];
---

<Figure
  id={id}
  title={ru ? 'Выбор масштаба по обоснованности' : 'Choosing the length scale by the evidence'}
  caption={ru
    ? 'Логарифм маргинального правдоподобия 12 точек как функция масштаба ℓ RBF-ядра при sf = 1 и σn = 0.1. Согласие с данными (1) лучше всего при коротком масштабе, штраф за сложность (2) убывает с ростом ℓ, сумма (3) максимальна при ℓ = 1.76 и равна −3.89 (константа −6 log 2π = −11.03 входит в сумму). Справа (4): апостериорное среднее и 95-процентная полоса при ℓ = 0.3 (−13.90), 1.76 и 3 (−23.92).'
    : 'The log marginal likelihood of the 12 points as a function of the length scale ℓ of the RBF kernel, with sf = 1 and σn = 0.1. The data fit (1) is best at short length scales, the complexity penalty (2) shrinks as ℓ grows, and their sum (3) peaks at ℓ = 1.76 with −3.89 (the constant −6 log 2π = −11.03 is included in the sum). Right (4): the posterior mean and 95% band at ℓ = 0.3 (−13.90), 1.76 and 3 (−23.92).'}
>
  {layouts.map((L) => {
    const sx = scale([Math.log(0.2), Math.log(3)], [L.P.x0, L.P.x1]), sy = scale([-32, 20], [L.P.y1, L.P.y0]);
    const lx = (l: number) => sx(Math.log(l));
    const curve = (key: 'fit' | 'comp' | 'total') => polyline(ells.map((l, i) => [lx(l), sy(ev[i][key])]));
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Маргинальное правдоподобие как функция масштаба' : 'The marginal likelihood as a function of the length scale'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Согласие с данными падает с ростом масштаба, член сложности растёт, их сумма имеет максимум около 1.76. Три маленьких графика показывают слишком гибкую, подходящую и слишком жёсткую модели.' : 'The data fit falls as the length scale grows, the complexity term rises, and their sum peaks near 1.76. Three small plots show a too flexible, a fitting and a too stiff model.'}</desc>
        {[-30, -20, -10, 0, 10, 20].map((v) => (
          <g>
            <path class="f-grid" d={`M ${L.P.x0} ${sy(v)} H ${L.P.x1}`} />
            <text class="f-small f-t-muted" x={L.P.x0 - 5} y={sy(v) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${L.P.x0} ${L.P.y1} H ${L.P.x1}`} />
        {[0.2, 0.5, 1, 2, 3].map((v) => <text class="f-small f-t-muted" x={lx(v)} y={L.P.y1 + 18} text-anchor="middle">{v}</text>)}
        <text class="f-small f-t-muted" x={(L.P.x0 + L.P.x1) / 2} y={L.P.y1 + 38} text-anchor="middle">{t.x}</text>
        <g data-s="1">
          <path class="f-line f-amber" d={curve('fit')} />
          <path class="f-line f-amber" d={`M ${L.P.x0 + 12} ${L.P.y1 - 56} h 22`} />
          <Badge x={L.P.x0 + 46} y={L.P.y1 - 56} n={1} />
          <text class="f-small" x={L.P.x0 + 60} y={L.P.y1 - 52}>{t.fit}</text>
        </g>
        <g data-s="2">
          <path class="f-line f-green" d={curve('comp')} />
          <path class="f-line f-green" d={`M ${L.P.x0 + 12} ${L.P.y1 - 34} h 22`} />
          <Badge x={L.P.x0 + 46} y={L.P.y1 - 34} n={2} />
          <text class="f-small" x={L.P.x0 + 60} y={L.P.y1 - 30}>{t.comp}</text>
        </g>
        <g data-s="3">
          <path class="f-line f-blue f-bold" d={curve('total')} />
          <path class="f-line f-blue f-bold" d={`M ${L.P.x0 + 12} ${L.P.y1 - 12} h 22`} />
          <Badge x={L.P.x0 + 46} y={L.P.y1 - 12} n={3} />
          <text class="f-small" x={L.P.x0 + 60} y={L.P.y1 - 8}>{t.tot}</text>
          <path class="f-thin f-blue f-dash" d={`M ${lx(best)} ${sy(evidence(best).total)} V ${L.P.y1}`} />
          {picks.map((l, k) => <circle class="f-solid-blue" cx={lx(l)} cy={sy(pe[k])} r="4" />)}
        </g>
        <g data-s="4">
          {L.minis.map((M, k) => {
            const mx = scale([-6, 6], [M.x0, M.x1]), my0 = scale([-2, 2], [M.y1, M.y0]), my = (v: number) => my0(clamp(v));
            const f = fits[k];
            const up = polyline(grid.map((g, i) => [mx(g), my(f.mean[i] + 1.96 * f.sd[i])]));
            const dn = polyline(grid.map((g, i): [number, number] => [mx(g), my(f.mean[i] - 1.96 * f.sd[i])]).reverse()).replace(/^M/, 'L');
            return (
              <g>
                <text class="f-small" x={M.x0 + (k ? 0 : 16)} y={M.y0 - 8}>{`ℓ = ${picks[k]}: ${t.ev} ${fmt(pe[k])}`}</text>
                {k === 0 && <Badge x={M.x0 + 6} y={M.y0 - 12} n={4} />}
                <path class="f-grid" d={`M ${M.x0} ${my(0)} H ${M.x1}`} />
                <path class="f-fill-blue" d={`${up} ${dn} Z`} />
                <path class="f-line f-blue" d={polyline(grid.map((g, i) => [mx(g), my(f.mean[i])]))} />
                {X.map((x, i) => <circle class="f-fill-ink" cx={mx(x)} cy={my(Y[i])} r="2.6" />)}
              </g>
            );
          })}
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
