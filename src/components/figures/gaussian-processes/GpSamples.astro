---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { X, Y, rbf, posterior, draws } from './gp';

const ru = pageLang(Astro.url) === 'ru';

// Prior and posterior of a GP with the RBF kernel, sf = 1, ell = 1.76 (the evidence maximum), noise sd 0.1.
const ell = 1.76;
const grid = Array.from({ length: 97 }, (_, i) => -6 + i * 0.125);
const K = grid.map((a) => grid.map((b) => rbf(a, b, ell)));
const priorDraws = draws(grid.map(() => 0), K, 3, 7);
const post = posterior(grid, ell);
const postDraws = draws(post.mean, post.cov, 3, 11);
const at = (x: number) => grid.findIndex((g) => Math.abs(g - x) < 1e-9);
const chk = [post.mean[at(0)], post.sd[at(2.75)], post.sd[at(6)]].map((v) => v.toFixed(3)).join();
if (chk !== '-0.043,0.162,0.512') throw new Error(`GpSamples: posterior drifted from the note (${chk})`);
const lo = post.mean.map((m, i) => m - 1.96 * post.sd[i]), hi = post.mean.map((m, i) => m + 1.96 * post.sd[i]);
const tones = ['amber', 'green', 'red'];

const t = ru
  ? { prior: 'Априорное: три реализации f', post: 'Апостериорное после 12 наблюдений', steps: ['априорное распределение: среднее 0, полоса ±1.96 sf, три случайные функции', 'наблюдения: 12 зашумлённых значений sin x', 'апостериорное среднее и 95-процентная полоса: узкая у данных, шире в промежутке и за краями', 'три функции из апостериорного распределения: все проходят рядом с точками'] }
  : { prior: 'Prior: three draws of f', post: 'Posterior after 12 points', steps: ['the prior: mean 0, a band of ±1.96 sf, three random functions', 'the data: 12 noisy values of sin x', 'the posterior mean and 95% band: narrow at the data, wider in the gap and past the ends', 'three functions drawn from the posterior: all pass near the points'] };
const id = 'gp-samples';
const layouts = [
  { cls: 'fig-wide fig-bp-640', W: 760, H: 300, panels: [{ x0: 40, x1: 360, y0: 44, y1: 250 }, { x0: 420, x1: 740, y0: 44, y1: 250 }] },
  { cls: 'fig-narrow seq-narrow fig-bp-640', W: 360, H: 580, panels: [{ x0: 24, x1: 344, y0: 46, y1: 246 }, { x0: 24, x1: 344, y0: 330, y1: 530 }] },
];
---

<Figure
  id={id}
  title={ru ? 'Гауссовский процесс до и после данных' : 'A Gaussian process before and after the data'}
  caption={ru
    ? 'Слева: априорное распределение f ~ GP(0, k) с RBF-ядром, sf = 1, ℓ = 1.76; полоса ±1.96 одинакова везде, три реализации — гладкие функции, меняющиеся на масштабе ℓ (1). Справа: 12 наблюдений с шумом σn = 0.1 (2), апостериорное среднее с 95-процентной полосой для f (3) и три реализации из апостериорного распределения (4). Стандартное отклонение — 0.068 при x = 0, 0.162 в промежутке при x = 2.75 и 0.512 при x = 6, за последней точкой.'
    : 'Left: the prior f ~ GP(0, k) with the RBF kernel, sf = 1, ℓ = 1.76; the band of ±1.96 is the same everywhere, and the three draws are smooth functions that vary on the scale ℓ (1). Right: 12 observations with noise σn = 0.1 (2), the posterior mean with the 95% band for f (3), and three draws from the posterior (4). The standard deviation is 0.068 at x = 0, 0.162 in the gap at x = 2.75 and 0.512 at x = 6, past the last point.'}
>
  {layouts.map((L) => {
    const [P, Q] = L.panels;
    const sxP = scale([-6, 6], [P.x0, P.x1]), syP = scale([-2.6, 2.6], [P.y1, P.y0]);
    const sxQ = scale([-6, 6], [Q.x0, Q.x1]), syQ = scale([-2.6, 2.6], [Q.y1, Q.y0]);
    const axes = (S: typeof P, sx: (v: number) => number, sy: (v: number) => number) => (
      <g>
        <path class="f-grid" d={`M ${S.x0} ${sy(0)} H ${S.x1}`} />
        <path class="f-axis" d={`M ${S.x0} ${S.y1} H ${S.x1}`} />
        {[-6, -3, 0, 3, 6].map((v) => <text class="f-small f-t-muted" x={sx(v)} y={S.y1 + 18} text-anchor="middle">{v}</text>)}
        {[-2, 2].map((v) => <text class="f-small f-t-muted" x={S.x0 - 4} y={sy(v) + 4} text-anchor="end">{v}</text>)}
      </g>
    );
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Априорное и апостериорное распределения гауссовского процесса' : 'Prior and posterior of a Gaussian process'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Слева широкая полоса и три волнистые кривые вокруг нуля. Справа точки данных, через которые проходят узкая полоса и три близкие кривые; между x = 1.6 и 3.9 и за краями полоса расширяется.' : 'Left, a wide band and three wavy curves around zero. Right, data points with a narrow band and three close curves through them; the band widens between x = 1.6 and 3.9 and past the ends.'}</desc>
        {axes(P, sxP, syP)}
        {axes(Q, sxQ, syQ)}
        <g data-s="1">
          <text class="f-label" x={P.x0 + 14} y={P.y0 - 18}>{t.prior}</text>
          <Badge x={P.x0} y={P.y0 - 23} n={1} />
          <path class="f-fill-blue" d={`M ${P.x0} ${syP(1.96)} H ${P.x1} V ${syP(-1.96)} H ${P.x0} Z`} />
          {priorDraws.map((d, k) => <path class={`f-line f-${tones[k]}`} d={polyline(grid.map((g, i) => [sxP(g), syP(d[i])]))} />)}
        </g>
        <g data-s="2">
          <text class="f-label" x={Q.x0 + 14} y={Q.y0 - 18}>{t.post}</text>
          <Badge x={Q.x0} y={Q.y0 - 23} n={2} />
          {X.map((x, i) => <circle class="f-fill-ink" cx={sxQ(x)} cy={syQ(Y[i])} r="3.6" />)}
        </g>
        <g data-s="3">
          <path class="f-fill-blue" d={`${polyline(grid.map((g, i) => [sxQ(g), syQ(hi[i])]))} ${polyline(grid.map((g, i): [number, number] => [sxQ(g), syQ(lo[i])]).reverse()).replace(/^M/, 'L')} Z`} />
          <path class="f-line f-blue f-bold" d={polyline(grid.map((g, i) => [sxQ(g), syQ(post.mean[i])]))} />
          <Badge x={sxQ(2.75)} y={syQ(-1.4)} n={3} />
        </g>
        <g data-s="4">
          {postDraws.map((d, k) => <path class={`f-thin f-${tones[k]}`} d={polyline(grid.map((g, i) => [sxQ(g), syQ(d[i])]))} />)}
          <Badge x={sxQ(5.3)} y={syQ(1.9)} n={4} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
