---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import Arrow from '../seqflow/Arrow.astro';
import Sub from '../generative-modeling/Sub.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The factor graph of GP classification: one prior factor N(f | 0, K) joined to every latent value f_j, and one
// likelihood factor Φ(y_j f_j) joined to each f_j alone. EP refines the site of f_i in four steps: the cavity comes
// down from the prior factor (it carries the other sites), is multiplied by the exact factor, the product is matched
// by a Gaussian, and the new site (matched Gaussian ÷ cavity) goes back up and changes every other cavity.
const t = ru
  ? {
      title: 'EP как передача сообщений в факторном графе',
      prior: 'априорный фактор',
      rows: ['полость: априорное', 'и прочие сайты', 'наклонённое: полость × Φ(yᵢfᵢ)', 'те же среднее и дисперсия', 'сайт tᵢ = гауссиана ÷ полость'],
      narrow: ['полость: априорное и прочие сайты', 'наклонённое: полость × Φ(yᵢfᵢ)', 'те же среднее и дисперсия', 'сайт tᵢ = гауссиана ÷ полость'],
      steps: ['полость N(μ₋ᵢ, σ²₋ᵢ): сообщение от априорного фактора через fᵢ к его фактору правдоподобия; в ней априорное распределение и все остальные сайты', 'наклонённое распределение: полость, умноженная на точный фактор Φ(yᵢfᵢ); оно скошено и не гауссовское', 'сопоставление моментов: гауссиана с тем же средним и той же дисперсией, что у наклонённого распределения', 'новый сайт, то есть эта гауссиана, делённая на полость, уходит вверх, к априорному фактору, и меняет полости всех остальных fⱼ'],
      desc: 'Сверху прямоугольник априорного фактора N(f | 0, K), соединённый линиями с кружками f₁, f₂, fᵢ, fₙ. Под каждым кружком маленький квадрат — фактор правдоподобия Φ(yⱼfⱼ). У столбца fᵢ синяя стрелка идёт вниз от априорного фактора к квадрату, жёлтая стрелка — обратно вверх.',
    }
  : {
      title: 'EP as message passing on a factor graph',
      prior: 'prior factor',
      rows: ['cavity: the prior and', 'every other site', 'tilted: cavity × Φ(yᵢfᵢ)', 'match its mean and variance', 'new site tᵢ = Gaussian ÷ cavity'],
      narrow: ['cavity: prior and other sites', 'tilted: cavity × Φ(yᵢfᵢ)', 'match its mean and variance', 'site tᵢ = Gaussian ÷ cavity'],
      steps: ['the cavity N(μ₋ᵢ, σ²₋ᵢ): the message from the prior factor through fᵢ to its likelihood factor; it carries the prior and every other site', 'the tilted distribution: the cavity times the exact factor Φ(yᵢfᵢ), skewed and not Gaussian', 'moment matching: the Gaussian with the mean and variance of the tilted distribution', 'the new site, that Gaussian divided by the cavity, goes back up to the prior factor and changes the cavity of every other fⱼ'],
      desc: 'At the top, a box for the prior factor N(f | 0, K), joined by lines to circles f₁, f₂, fᵢ and fₙ. Below each circle a small square is the likelihood factor Φ(yⱼfⱼ). In the column of fᵢ a blue arrow runs down from the prior factor to the square and an amber arrow runs back up.',
    };

const fits = (s: string, room: number, px: number, what: string) => {
  if (s.length * px > room) throw new Error(`EpFactorGraph ${what}: "${s}" needs ${(s.length * px).toFixed(0)} px, has ${room}`);
};
// Wide: the graph spans x 40..440, the label column starts at x 466 and ends at 752 (f-small, about 6.9 px a character).
// Narrow: the graph spans x 20..340; the four labels sit below it from x 40 to 350 (f-small at 14 px, about 7.7 px).
t.rows.forEach((s) => fits(s, 752 - 466, 6.9, 'wide label'));
t.narrow.forEach((s) => fits(s, 350 - 40, 7.7, 'narrow label'));
fits(t.prior, 400 - 20, 6.9, 'wide prior');
fits(t.prior, 320 - 20, 7.7, 'narrow prior');

interface Layout { cls: string; W: number; H: number; box: [number, number, number, number]; xs: number[]; dots: number[]; yc: number; ys: number; ilab: number }
const layouts: Layout[] = [
  { cls: 'fig-wide fig-bp-640', W: 760, H: 300, box: [40, 22, 400, 46], xs: [80, 170, 300, 410], dots: [235, 355], yc: 150, ys: 236, ilab: 2 },
  { cls: 'fig-narrow seq-narrow fig-bp-640', W: 360, H: 450, box: [20, 18, 320, 46], xs: [46, 116, 222, 314], dots: [168, 268], yc: 140, ys: 222, ilab: 2 },
];
const names = ['f_1', 'f_2', 'f_i', 'f_n'];
const facs = ['Φ(y_1 f_1)', 'Φ(y_2 f_2)', 'Φ(y_i f_i)', 'Φ(y_n f_n)'];
const R = 19, S = 18;
const id = 'gp-ep-factor-graph';
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? 'Факторный граф классификации гауссовским процессом: априорный фактор N(f | 0, K) связан со всеми латентными значениями, у каждого fⱼ свой фактор правдоподобия. Шаги показывают одно обновление сайта i в EP. Синим показана полость, жёлтым — новый сайт; все остальные сообщения гауссовские и точные.'
    : 'The factor graph of GP classification: the prior factor N(f | 0, K) joins all latent values, and each fⱼ has its own likelihood factor. The steps show one EP update of site i. Blue is the cavity, amber the new site; every other message is Gaussian and exact.'}
>
  {layouts.map((L) => {
    const [bx, by, bw, bh] = L.box;
    const wide = L.W === 760;
    const xi = L.xs[2];
    const top = L.yc - R, bot = L.yc + R, sq = L.ys - S / 2;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        <rect class="f-box-soft" x={bx} y={by} width={bw} height={bh} rx="6" />
        <text class="f-math" x={bx + bw / 2} y={by + 22} text-anchor="middle">N(f | 0, K)</text>
        <text class="f-small f-t-muted" x={bx + bw / 2} y={by + 39} text-anchor="middle">{t.prior}</text>
        {L.xs.map((x, k) => (
          <g>
            <path class="f-thin" d={`M ${x} ${by + bh} V ${top}`} />
            <path class="f-thin" d={`M ${x} ${bot} V ${sq}`} />
            <circle cx={x} cy={L.yc} r={R} class={k === L.ilab ? 'f-fill-blue' : 'f-fill-paper'} style={`stroke: ${k === L.ilab ? 'var(--fig-blue)' : 'var(--ink)'}; stroke-width: 1.4`} />
            <text class="f-math" x={x} y={L.yc + 6} text-anchor="middle"><Sub label={names[k]} /></text>
            <rect class="f-fill-ink" x={x - S / 2} y={sq} width={S} height={S} />
            {(wide || k === L.ilab) && <text class="f-small" x={x} y={L.ys + 30} text-anchor="middle"><Sub label={facs[k]} /></text>}
          </g>
        ))}
        {L.dots.map((x) => <text class="f-label f-t-muted" x={x} y={L.yc + 5} text-anchor="middle">⋯</text>)}
        <g data-s="1">
          <Arrow pts={[[xi + 12, by + bh + 6], [xi + 12, top - 4]]} tone="blue" bold />
          <Arrow pts={[[xi + 12, bot + 4], [xi + 12, sq - 4]]} tone="blue" bold />
        </g>
        <g data-s="2"><circle cx={xi} cy={L.ys} r={S} class="f-fill-amber" style="stroke: var(--fig-amber); stroke-width: 1.4; stroke-dasharray: 4 3" /></g>
        <g data-s="4">
          <Arrow pts={[[xi - 12, sq - 4], [xi - 12, bot + 4]]} tone="amber" bold />
          <Arrow pts={[[xi - 12, top - 4], [xi - 12, by + bh + 6]]} tone="amber" bold />
        </g>
        {wide ? (
          <g>
            <g data-s="1">
              <Badge x={480} y={96} n={1} />
              <text class="f-small" x={496} y={92}>{t.rows[0]}</text>
              <text class="f-small" x={496} y={110}>{t.rows[1]}</text>
            </g>
            <g data-s="4">
              <Badge x={480} y={166} n={4} />
              <text class="f-small" x={496} y={170}>{t.rows[4]}</text>
            </g>
            <g data-s="2">
              <Badge x={480} y={222} n={2} />
              <text class="f-small" x={496} y={226}>{t.rows[2]}</text>
            </g>
            <g data-s="3">
              <Badge x={480} y={250} n={3} />
              <text class="f-small" x={496} y={254}>{t.rows[3]}</text>
            </g>
          </g>
        ) : (
          <g>
            {t.narrow.map((s, k) => {
              const n = [1, 2, 3, 4][k];
              return (
                <g data-s={String(n)}>
                  <Badge x={28} y={300 + k * 36} n={n} />
                  <text class="f-small" x={44} y={305 + k * 36}>{s}</text>
                </g>
              );
            })}
          </g>
        )}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
