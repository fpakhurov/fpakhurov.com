---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A three-state weather chain. Starting from a sunny day, the distribution after t days is π_t = π_0 Pᵗ; it approaches
// the stationary distribution (21/46, 13/46, 12/46) whatever the start.
const P = [[0.7, 0.2, 0.1], [0.3, 0.4, 0.3], [0.2, 0.3, 0.5]];
const step = (pi: number[]) => [0, 1, 2].map((j) => pi.reduce((s, p, i) => s + p * P[i][j], 0));
const dists: number[][] = [[1, 0, 0]];
for (let t = 1; t <= 10; t++) dists.push(step(dists[t - 1]));
const shown = [0, 1, 2, 10];
const stationary = [21 / 46, 13 / 46, 12 / 46];
if (step(stationary).some((v, j) => Math.abs(v - stationary[j]) > 1e-12) || dists[2].map((v) => v.toFixed(2)).join() !== '0.57,0.25,0.18') throw new Error('WeatherChain: numbers drifted from the note');
const names = ru ? ['ясно', 'облачно', 'дождь'] : ['sunny', 'cloudy', 'rainy'];
const tones = ['amber', 'muted', 'blue'];
const t = ru
  ? { day: 'день', steps: ['день 0: ясно с вероятностью 1', 'день 1: строка «ясно» матрицы P: 0.70, 0.20, 0.10', 'день 2: π₁P = 0.57, 0.25, 0.18', 'день 10: 0.457, 0.283, 0.261 — почти стационарное распределение 21/46, 13/46, 12/46'] }
  : { day: 'day', steps: ['day 0: sunny with probability 1', 'day 1: the "sunny" row of P: 0.70, 0.20, 0.10', 'day 2: π₁P = 0.57, 0.25, 0.18', 'day 10: 0.457, 0.283, 0.261, nearly the stationary distribution 21/46, 13/46, 12/46'] };
const id = 'weather-chain';
const R = 30;
const edge = (a: number[], b: number[], side: number) => {
  const dx = b[0] - a[0], dy = b[1] - a[1], d = Math.hypot(dx, dy), ux = dx / d, uy = dy / d, nx = -uy * side, ny = ux * side;
  const s = [a[0] + ux * R + nx * 9, a[1] + uy * R + ny * 9], e = [b[0] - ux * (R + 4) + nx * 9, b[1] - uy * (R + 4) + ny * 9];
  const c = [(a[0] + b[0]) / 2 + nx * 26, (a[1] + b[1]) / 2 + ny * 26];
  return { d: `M ${s[0].toFixed(1)} ${s[1].toFixed(1)} Q ${c[0].toFixed(1)} ${c[1].toFixed(1)} ${e[0].toFixed(1)} ${e[1].toFixed(1)}`, lx: (a[0] + b[0]) / 2 + nx * 30, ly: (a[1] + b[1]) / 2 + ny * 30 + 5 };
};
const layouts = [
  { cls: 'fig-wide fig-medium', W: 640, H: 300, pos: [[150, 60], [60, 230], [240, 230]], tx: 340, ty: 70, cw: 80 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 470, pos: [[180, 56], [80, 226], [280, 226]], tx: 24, ty: 330, cw: 92 },
];
const pairs = [[0, 1], [0, 2], [1, 2]];
---

<Figure
  id={id}
  title={ru ? 'Цепь Маркова для погоды' : 'A Markov chain for the weather'}
  caption={ru
    ? 'Три состояния погоды; стрелка из состояния i в j подписана вероятностью перехода Pᵢⱼ, вероятность остаться — внутри кружка. Если день 0 ясный (1), распределение на следующий день — строка «ясно» матрицы (2), на день 2 — π₁P (3); к десятому дню оно почти не зависит от начала и равно стационарному распределению 21/46, 13/46, 12/46 (4).'
    : 'Three weather states; an arrow from state i to j carries the transition probability Pᵢⱼ, and the probability of staying is inside the circle. If day 0 is sunny (1), the distribution of the next day is the "sunny" row of the matrix (2), that of day 2 is π₁P (3); by day 10 it barely depends on the start and equals the stationary distribution 21/46, 13/46, 12/46 (4).'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Граф переходов и распределения по дням' : 'The transition graph and the distributions by day'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'Три кружка со стрелками в обе стороны; таблица распределений для дней 0, 1, 2 и 10.' : 'Three circles with arrows both ways; a table of the distributions for days 0, 1, 2 and 10.'}</desc>
      {pairs.flatMap(([i, j]) => [[i, j], [j, i]]).map(([i, j]) => {
        const e = edge(L.pos[i], L.pos[j], 1);
        return (
          <g>
            <path class="f-thin f-muted" d={e.d} marker-end="url(#f-arrow-muted)" />
            <text class="f-note f-halo" x={e.lx} y={e.ly} text-anchor="middle">{P[i][j].toFixed(1)}</text>
          </g>
        );
      })}
      {L.pos.map(([x, y], i) => (
        <g>
          <circle cx={x} cy={y} r={R} style={`fill: var(--fig-${tones[i] === 'muted' ? 'blue' : tones[i]}); fill-opacity: ${tones[i] === 'muted' ? 0.06 : 0.16}; stroke: var(--${tones[i] === 'muted' ? 'muted' : `fig-${tones[i]}`}); stroke-width: 1.4`} />
          <text class="f-small" x={x} y={y - 2} text-anchor="middle">{names[i]}</text>
          <text class="f-note" x={x} y={y + 15} text-anchor="middle">{P[i][i].toFixed(1)}</text>
        </g>
      ))}
      {names.map((nm, j) => <text class="f-note" x={L.tx + 84 + j * L.cw} y={L.ty - 20} text-anchor="middle">{nm}</text>)}
      {shown.map((d, k) => (
        <g data-s={k + 1}>
          <text class="f-small" x={L.tx} y={L.ty + k * 30}>{`${t.day} ${d}`}</text>
          {dists[d].map((v, j) => (
            <g>
              <rect x={L.tx + 84 + j * L.cw - (L.cw - 14) / 2} y={L.ty + k * 30 - 13} width={(L.cw - 14) * v} height="16" rx="2" style={`fill: var(--fig-${tones[j] === 'muted' ? 'blue' : tones[j]}); fill-opacity: ${tones[j] === 'muted' ? 0.12 : 0.3}`} />
              <text class="f-small" x={L.tx + 84 + j * L.cw} y={L.ty + k * 30} text-anchor="middle">{d === 10 ? v.toFixed(3) : v.toFixed(2)}</text>
            </g>
          ))}
          <Badge x={L.tx + 84 + 2.5 * L.cw + 4} y={L.ty + k * 30 - 5} n={k + 1} />
        </g>
      ))}
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
