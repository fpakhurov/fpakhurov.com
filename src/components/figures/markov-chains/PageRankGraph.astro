---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Five pages and their links. The random surfer follows a random outgoing link with probability 0.85 and jumps to a
// random page with probability 0.15; PageRank is the stationary distribution of that chain (power iteration).
const links: number[][] = [[1, 2], [2], [0], [0, 2], [3, 2]];
const n = 5, d = 0.85;
let r = new Array(n).fill(1 / n);
for (let it = 0; it < 200; it++) {
  const next = new Array(n).fill((1 - d) / n);
  links.forEach((outs, i) => outs.forEach((j) => { next[j] += (d * r[i]) / outs.length; }));
  r = next;
}
if (r.map((v) => v.toFixed(3)).join() !== '0.367,0.186,0.375,0.043,0.030') throw new Error('PageRankGraph: ranks drifted from the note');
const names = ['A', 'B', 'C', 'D', 'E'];
const id = 'pagerank-graph';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 560, H: 300, pos: [[120, 70], [330, 70], [225, 180], [90, 250], [400, 250]] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 320, pos: [[80, 70], [280, 70], [180, 180], [60, 270], [300, 270]] },
];
const rad = (v: number) => 14 + 40 * Math.sqrt(v);
const arrow = (a: number[], b: number[], ra: number, rb: number) => {
  const dx = b[0] - a[0], dy = b[1] - a[1], L = Math.hypot(dx, dy), ux = dx / L, uy = dy / L;
  return `M ${(a[0] + ux * ra).toFixed(1)} ${(a[1] + uy * ra).toFixed(1)} L ${(b[0] - ux * (rb + 4)).toFixed(1)} ${(b[1] - uy * (rb + 4)).toFixed(1)}`;
};
---

<Figure
  id={id}
  title={ru ? 'PageRank — стационарное распределение случайного блуждания' : 'PageRank is the stationary distribution of a random walk'}
  caption={ru
    ? `Пять страниц и ссылки между ними. Случайный пользователь с вероятностью 0.85 переходит по случайной ссылке со страницы, а с вероятностью 0.15 — на случайную страницу. Доли времени, которые он проводит на каждой странице в долгом блуждании, — её PageRank (площадь кружка): ${r.map((v, i) => `${names[i]} ${v.toFixed(3)}`).join(', ')}. На C ссылаются четыре страницы, но A почти не уступает ей: единственная ссылка C ведёт на A и передаёт ей весь свой вес.`
    : `Five pages and the links between them. A random surfer follows a random link from the page with probability 0.85 and jumps to a random page with probability 0.15. The share of time a long walk spends on each page is its PageRank (circle area): ${r.map((v, i) => `${names[i]} ${v.toFixed(3)}`).join(', ')}. Four pages link to C, yet A is nearly as important: C's only link goes to A and passes all of C's weight to it.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Граф ссылок пяти страниц' : 'The link graph of five pages'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'Кружки страниц размером по PageRank; A и C крупные, D и E мелкие.' : 'Page circles sized by PageRank; A and C are large, D and E small.'}</desc>
      {links.flatMap((outs, i) => outs.map((j) => <path class="f-thin f-muted" d={arrow(L.pos[i], L.pos[j], rad(r[i]), rad(r[j]))} marker-end="url(#f-arrow-muted)" />))}
      {L.pos.map(([x, y], i) => (
        <g>
          <circle cx={x} cy={y} r={rad(r[i])} style="fill: var(--fig-blue); fill-opacity: .16; stroke: var(--fig-blue); stroke-width: 1.4" />
          <text class="f-label" x={x} y={y + 1} text-anchor="middle">{names[i]}</text>
          <text class="f-note" x={x} y={y + 17} text-anchor="middle">{r[i].toFixed(3)}</text>
        </g>
      ))}
    </svg>
  ))}
</Figure>
