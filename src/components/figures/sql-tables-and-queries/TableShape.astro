---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { lines } from './example';

const ru = pageLang(Astro.url) === 'ru';
const id = 'sql-table-shape';
const fields = [
  { name: 'order_id', type: 'integer', x: 24, w: 112 },
  { name: 'line_no', type: 'integer', x: 136, w: 104 },
  { name: 'product', type: 'text', x: 240, w: 148 },
  { name: 'quantity', type: 'integer', x: 388, w: 112 },
  { name: 'unit_price_cents', type: 'integer', x: 500, w: 236 },
];
const values = (line: typeof lines[number]) => [line.orderId, line.lineNo, line.product, line.quantity, line.unitPriceCents];
---

<Figure id={id}
  title={ru ? 'Одна строка — одна позиция заказа' : 'One row records one order line'}
  caption={ru
    ? 'Шесть позиций, пять столбцов. Заказ 101 занимает две строки. Пара order_id и line_no различает позиции в этом примере; product повторяется. В узкой версии отдельно показаны значения и типы первой строки.'
    : 'Six order lines, five columns. Order 101 occupies two rows. The pair order_id and line_no distinguishes the lines in this example; product repeats. The narrow version separates the values and types of the first row.'}>
  <svg class="fig-wide fig-bp-640" viewBox="0 0 760 338" role="img" aria-labelledby={`${id}-wide-title ${id}-wide-desc`}>
    <title id={`${id}-wide-title`}>{ru ? 'Столбцы, типы и шесть позиций заказа' : 'Columns, types and six order lines'}</title>
    <desc id={`${id}-wide-desc`}>{ru ? 'Таблица с пятью столбцами. Первые две строки относятся к заказу 101 и различаются номером позиции. Количество и цена хранятся целыми числами.' : 'A five-column table. The first two rows belong to order 101 and differ by line number. Quantities and prices are integers.'}</desc>
    {fields.map((field) => <>
      <rect x={field.x} y="20" width={field.w} height="51" style="fill: var(--fig-blue); fill-opacity: 0.12" />
      <text class="f-small" x={field.x + 10} y="41" style="font-family: var(--mono); font-size: 13px">{field.name}</text>
      <text class="f-small f-t-muted" x={field.x + 10} y="59">{field.type}</text>
    </>)}
    {lines.map((line, row) => <>
      <rect x="24" y={75 + row * 32} width="712" height="32" fill={line.orderId === 101 ? 'var(--fig-green)' : 'transparent'} fill-opacity="0.10" />
      {values(line).map((value, column) => <text class="f-small" x={fields[column].x + 10} y={96 + row * 32} style="font-family: var(--mono); font-size: 13px">{value}</text>)}
      <path class="f-line f-muted" d={`M 24 ${107 + row * 32} H 736`} opacity="0.35" />
    </>)}
    <text class="f-small f-t-green" x="34" y="302">{ru ? '101/1 и 101/2: один заказ, две позиции' : '101/1 and 101/2: one order, two lines'}</text>
    <text class="f-small f-t-muted" x="34" y="324">{ru ? 'Номер строки на экране не входит в данные.' : 'The display position is not a field of the data.'}</text>
  </svg>
  <svg class="fig-narrow fig-bp-640 seq-narrow" viewBox="0 0 360 344" role="img" aria-labelledby={`${id}-narrow-title ${id}-narrow-desc`}>
    <title id={`${id}-narrow-title`}>{ru ? 'Первая позиция заказа и её схема' : 'The first order line and its schema'}</title>
    <desc id={`${id}-narrow-desc`}>{ru ? 'Первая строка: order_id 101, line_no 1, product tea, quantity 2, unit_price_cents 350. Для каждого поля указан тип. Всего в исходной таблице шесть строк.' : 'The first row contains order_id 101, line_no 1, product tea, quantity 2 and unit_price_cents 350. Each field has a type. The source table contains six rows.'}</desc>
    <text class="f-label" x="18" y="25">{ru ? 'Первая строка: позиция 101/1' : 'First row: order line 101/1'}</text>
    {fields.map((field, row) => <>
      <rect x="16" y={40 + row * 45} width="328" height="43" rx="4" style="fill: var(--fig-blue); fill-opacity: 0.08" />
      <text class="f-small" x="26" y={59 + row * 45} style="font-family: var(--mono)">{field.name}</text>
      <text class="f-small f-t-muted" x="26" y={75 + row * 45}>{field.type}</text>
      <text class="f-label f-t-green" x="293" y={67 + row * 45} text-anchor="middle" style="font-family: var(--mono)">{values(lines[0])[row]}</text>
    </>)}
    <text class="f-small f-t-green" x="20" y="292">{ru ? '101/2 — другая позиция заказа 101' : '101/2 is another line of order 101'}</text>
    <text class="f-small f-t-muted" x="20" y="315">{ru ? 'Вся таблица: 6 строк × 5 столбцов' : 'Full table: 6 rows × 5 columns'}</text>
    <text class="f-small f-t-muted" x="20" y="335">{ru ? 'Позиция на экране не служит ключом.' : 'Display position does not identify a row.'}</text>
  </svg>
</Figure>
