---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { keyOf, lines } from './example';

const ru = pageLang(Astro.url) === 'ru';
const id = 'sql-select-columns';
const layouts = [{ cls: 'fig-wide fig-bp-640', w: 760, x1: 50, x2: 480, start: 230, end: 450 }, { cls: 'fig-narrow fig-bp-640 seq-narrow', w: 360, x1: 26, x2: 230, start: 125, end: 209 }];
---

<Figure id={id}
  title={ru ? 'Один столбец результата сохраняет шесть строк' : 'One output column still contains six rows'}
  caption={ru
    ? 'SELECT product выдаёт одно значение для каждой исходной позиции. Три значения tea остаются тремя строками. Слева показаны идентификаторы исходных позиций, которых уже нет в результате справа.'
    : 'SELECT product emits one value per source line. The three tea values remain three rows. The left-hand side shows source-line identities that the output on the right no longer contains.'}>
  {layouts.map((L) => <svg class={L.cls} viewBox={`0 0 ${L.w} 348`} role="img" aria-labelledby={`${id}-${L.w}-title ${id}-${L.w}-desc`}>
    <title id={`${id}-${L.w}-title`}>{ru ? 'Выбор столбца product без удаления повторов' : 'Selecting product without removing duplicates'}</title>
    <desc id={`${id}-${L.w}-desc`}>{ru ? 'Шесть разных позиций дают значения tea, coffee, tea, coffee, tea, cocoa. Одинаковые значения не сливаются.' : 'Six distinct order lines produce tea, coffee, tea, coffee, tea and cocoa. Equal values are not merged.'}</desc>
    <text class="f-small f-t-muted" x={L.x1} y="28">{ru ? 'исходная позиция' : 'source line'}</text>
    <text class="f-small" x={L.x2} y="28" style="font-family: var(--mono)">product</text>
    {lines.map((line, row) => {
      const y = 64 + row * 39;
      return <>
        <text class="f-small f-t-blue" x={L.x1} y={y} style="font-family: var(--mono)">{keyOf(line)}</text>
        <path class="f-line f-muted" d={`M ${L.start} ${y - 5} H ${L.end}`} marker-end="url(#f-arrow-muted)" />
        <rect x={L.x2 - 10} y={y - 21} width={L.w === 360 ? 100 : 190} height="32" rx="5" style={`fill: var(${line.product === 'tea' ? '--fig-amber' : '--fig-red'}); fill-opacity: 0.11`} />
        <text class={`f-small ${line.product === 'tea' ? 'f-t-amber' : ''}`} x={L.x2} y={y} style="font-family: var(--mono)">{line.product}</text>
      </>;
    })}
    <text class="f-small f-t-muted" x={L.x1} y="322">{ru ? '6 позиций → 6 строк, 3 значения tea' : '6 lines → 6 rows, including 3 tea values'}</text>
  </svg>)}
</Figure>
