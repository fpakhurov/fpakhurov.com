---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { keyOf, selected } from './example';

const ru = pageLang(Astro.url) === 'ru';
const id = 'sql-result-order';
const a = selected.map(keyOf);
const b = [a[2], a[0], a[1]];
const layouts = [{ cls: 'fig-wide fig-bp-640', w: 760, boxW: 208, xs: [24, 276, 528], ys: [56, 56, 56] }, { cls: 'fig-narrow fig-bp-640 seq-narrow', w: 360, boxW: 148, xs: [18, 194, 106], ys: [55, 55, 262] }];
---

<Figure id={id}
  title={ru ? 'Порядок результата задаётся отдельно' : 'Result order is a separate requirement'}
  caption={ru
    ? 'Для условия quantity >= 2 без ORDER BY допустимы оба порядка, A и B. Запрос ORDER BY order_id, line_no задаёт порядок A. Пары полей различны в примере, поэтому порядок определён полностью.'
    : 'For quantity >= 2, both orders A and B are permitted without ORDER BY. ORDER BY order_id, line_no gives order A. Those pairs are distinct in this example, so they determine the full order.'}>
  {layouts.map((L) => <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.w === 360 ? 436 : 274}`} role="img" aria-labelledby={`${id}-${L.w}-title ${id}-${L.w}-desc`}>
    <title id={`${id}-${L.w}-title`}>{ru ? 'Два допустимых порядка и один явно заданный' : 'Two permitted orders and one explicitly requested order'}</title>
    <desc id={`${id}-${L.w}-desc`}>{ru ? 'Без сортировки допустимы порядки 101/1, 103/1, 104/1 и 104/1, 101/1, 103/1. Сортировка по номеру заказа и позиции задаёт первый порядок.' : 'Without sorting, 101/1, 103/1, 104/1 and 104/1, 101/1, 103/1 are both permitted. Ordering by order and line number requires the first order.'}</desc>
    <text class="f-small f-t-muted" x="18" y="25">{ru ? 'Без ORDER BY: A или B' : 'Without ORDER BY: A or B'}</text>
    {[a, b, a].map((rows, column) => <>
      <rect x={L.xs[column]} y={L.ys[column]} width={L.boxW} height="135" rx="6" style={`fill: var(${column === 2 ? '--fig-green' : '--fig-blue'}); fill-opacity: 0.09; stroke: var(${column === 2 ? '--fig-green' : '--fig-blue'}); stroke-width: 1`} />
      <text class={`f-small ${column === 2 ? 'f-t-green' : 'f-t-blue'}`} x={L.xs[column] + 14} y={L.ys[column] + 24}>{column === 2 ? (ru ? 'Заданный порядок' : 'Requested order') : column === 0 ? 'A' : 'B'}</text>
      {rows.map((key, row) => <text class="f-label" x={L.xs[column] + L.boxW / 2} y={L.ys[column] + 55 + row * 27} text-anchor="middle" style="font-family: var(--mono); font-size: 14px">{key}</text>)}
    </>)}
    <text class="f-small f-t-green" x={L.w === 360 ? 42 : 530} y={L.w === 360 ? 243 : 220} style="font-family: var(--mono)">ORDER BY order_id, line_no</text>
    {L.w !== 360 && <text class="f-small f-t-muted" x="24" y="255">{ru ? 'Те же строки. Разный порядок показа.' : 'The same rows, with a different presentation order.'}</text>}
    {L.w === 360 && <text class="f-small f-t-muted" x="23" y="425">{ru ? 'Порядок задаётся запросом.' : 'The query specifies presentation order.'}</text>}
  </svg>)}
</Figure>
