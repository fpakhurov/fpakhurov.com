---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { keyOf, lines, selected } from './example';

const ru = pageLang(Astro.url) === 'ru';
const id = 'sql-filter-rows';
const layouts = [{ cls: 'fig-wide fig-bp-640', w: 760, left: 30, pred: 280, result: 500, gap: 37 }, { cls: 'fig-narrow fig-bp-640 seq-narrow', w: 360, left: 20, pred: 175, result: null, gap: 37 }];
---

<Figure id={id}
  title={ru ? 'WHERE сохраняет строки, для которых условие истинно' : 'WHERE keeps rows whose condition is true'}
  caption={ru
    ? 'Для каждой из шести позиций проверено quantity >= 2. Сохраняются 101/1, 103/1 и 104/1. Все количества в примере известны; исходные строки не изменяются.'
    : 'Evaluate quantity >= 2 for each of the six lines. Lines 101/1, 103/1 and 104/1 survive. Every quantity in this example is known; the source rows stay unchanged.'}>
  {layouts.map((L) => <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.result === null ? 432 : 326}`} role="img" aria-labelledby={`${id}-${L.w}-title ${id}-${L.w}-desc`}>
    <title id={`${id}-${L.w}-title`}>{ru ? 'Проверка условия для каждой позиции заказа' : 'Evaluate the condition for each order line'}</title>
    <desc id={`${id}-${L.w}-desc`}>{ru ? 'Количества равны 2, 1, 1, 2, 1 и 3. Условие не меньше двух истинно для первой, четвёртой и шестой позиции.' : 'The quantities are 2, 1, 1, 2, 1 and 3. At least two is true for the first, fourth and sixth order line.'}</desc>
    <text class="f-small f-t-muted" x={L.left} y="24">{ru ? 'позиция · quantity' : 'line · quantity'}</text>
    <text class="f-small" x={L.pred} y="24" style="font-family: var(--mono)">quantity &gt;= 2</text>
    {L.result !== null && <text class="f-small f-t-red" x={L.result} y="24">{ru ? 'сохранённые позиции' : 'retained order lines'}</text>}
    {lines.map((line, row) => {
      const keep = line.quantity >= 2;
      const y = 46 + row * L.gap;
      return <>
        <rect x={L.left - 7} y={y - 16} width={L.w === 360 ? 321 : 411} height="29" rx="4" style={`fill: var(${keep ? '--fig-green' : '--muted'}); fill-opacity: ${keep ? 0.12 : 0.04}`} />
        <text class="f-small" x={L.left} y={y + 3} style="font-family: var(--mono)">{keyOf(line)} · {line.quantity}</text>
        <text class={`f-small ${keep ? 'f-t-green' : 'f-t-muted'}`} x={L.pred} y={y + 3} style="font-family: var(--mono)">{keep ? 'TRUE' : 'FALSE'}</text>
        {L.result !== null && keep && <>
          <path class="f-line f-green" d={`M 425 ${y - 2} H 478`} marker-end="url(#f-arrow-green)" />
          <text class="f-small f-t-red" x={L.result} y={y + 3} style="font-family: var(--mono); font-size: 13px">{keyOf(line)}</text>
        </>}
      </>;
    })}
    {L.result === null ? <>
      <path class="f-line f-muted" d="M 180 278 V 302" marker-end="url(#f-arrow-muted)" />
      <rect x="18" y="315" width="324" height="99" rx="6" style="fill: var(--fig-red); fill-opacity: 0.08; stroke: var(--fig-red); stroke-width: 1" />
      <text class="f-small f-t-red" x="30" y="339">{ru ? 'Сохраняются 3 позиции:' : 'Keep 3 order lines:'}</text>
      {selected.map((line, row) => <text class="f-small" x={38 + row * 103} y="378" style="font-family: var(--mono)">{keyOf(line)}</text>)}
    </> : <text class="f-small f-t-muted" x="30" y="307">{ru ? '6 исходных строк → 3 строки результата' : '6 source rows → 3 result rows'}</text>}
  </svg>)}
</Figure>
