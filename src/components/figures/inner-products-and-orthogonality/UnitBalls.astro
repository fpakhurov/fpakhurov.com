---
import Figure from '../Figure.astro';
import { polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Unit balls {x : ‖x‖_p ≤ 1} of the ℓ1, ℓ2 and ℓ∞ norms in the plane, traced as the curves |x1|^p + |x2|^p = 1
// (p = ∞: max(|x1|, |x2|) = 1), and the point x = (0.6, 0.8) with ‖x‖₁ = 1.4, ‖x‖₂ = 1, ‖x‖∞ = 0.8.
type P2 = [number, number];
const x: P2 = [0.6, 0.8];
const n1 = Math.abs(x[0]) + Math.abs(x[1]), n2 = Math.hypot(...x), ninf = Math.max(Math.abs(x[0]), Math.abs(x[1]));
if (n1.toFixed(6) !== '1.400000' || n2.toFixed(6) !== '1.000000' || ninf.toFixed(6) !== '0.800000') throw new Error('UnitBalls: the norms drifted from the note');
// A point on the unit sphere of the p-norm in direction θ: scale (cos θ, sin θ) by 1 / ‖(cos θ, sin θ)‖_p.
const pnorm = (v: P2, p: number) => (p === Infinity ? Math.max(Math.abs(v[0]), Math.abs(v[1])) : (Math.abs(v[0]) ** p + Math.abs(v[1]) ** p) ** (1 / p));
const sphere = (p: number) => Array.from({ length: 361 }, (_, i) => {
  const th = (2 * Math.PI * i) / 360, d: P2 = [Math.cos(th), Math.sin(th)], r = 1 / pnorm(d, p);
  return [r * d[0], r * d[1]] as P2;
});
const balls = [
  { p: 1, cls: 'f-line f-amber', name: '‖x‖₁ ≤ 1', tone: 'f-t-amber' },
  { p: 2, cls: 'f-line f-blue', name: '‖x‖₂ ≤ 1', tone: 'f-t-blue' },
  { p: Infinity, cls: 'f-line f-green', name: '‖x‖∞ ≤ 1', tone: 'f-t-green' },
];
const t = ru
  ? { x: 'x = (0.6, 0.8)', vals: ['‖x‖₁ = 1.4', '‖x‖₂ = 1', '‖x‖∞ = 0.8'],
      title: 'Единичные шары норм ℓ₁, ℓ₂ и ℓ∞ на плоскости',
      tt: 'Ромб, круг и квадрат: единичные шары трёх норм',
      desc: 'Ромб с вершинами на осях — единичный шар нормы ℓ₁; круг — шар нормы ℓ₂; квадрат со сторонами, параллельными осям, — шар нормы ℓ∞. Точка x = (0.6, 0.8) лежит на окружности, вне ромба и внутри квадрата.' }
  : { x: 'x = (0.6, 0.8)', vals: ['‖x‖₁ = 1.4', '‖x‖₂ = 1', '‖x‖∞ = 0.8'],
      title: 'Unit balls of the ℓ₁, ℓ₂ and ℓ∞ norms in the plane',
      tt: 'A diamond, a disc and a square: the unit balls of three norms',
      desc: 'The diamond with corners on the axes is the unit ball of the ℓ₁ norm; the disc is the ball of the ℓ₂ norm; the square with sides parallel to the axes is the ball of the ℓ∞ norm. The point x = (0.6, 0.8) lies on the circle, outside the diamond and inside the square.' };
const caption = ru
  ? 'Единичный шар нормы — множество векторов с нормой не больше 1. Для ℓ₁ это ромб |x₁| + |x₂| ≤ 1, для ℓ₂ — круг, для ℓ∞ — квадрат max(|x₁|, |x₂|) ≤ 1. Ромб лежит внутри круга, круг — внутри квадрата: ‖x‖∞ ≤ ‖x‖₂ ≤ ‖x‖₁. Точка x = (0.6, 0.8) имеет ‖x‖₂ = 1 и лежит на окружности, но ‖x‖₁ = 1.4 (вне ромба) и ‖x‖∞ = 0.8 (внутри квадрата). Вершины ромба на осях — причина, по которой штраф ℓ₁ обнуляет координаты.'
  : 'The unit ball of a norm is the set of vectors of norm at most 1. For ℓ₁ it is the diamond |x₁| + |x₂| ≤ 1, for ℓ₂ the disc, for ℓ∞ the square max(|x₁|, |x₂|) ≤ 1. The diamond lies inside the disc and the disc inside the square: ‖x‖∞ ≤ ‖x‖₂ ≤ ‖x‖₁. The point x = (0.6, 0.8) has ‖x‖₂ = 1 and lies on the circle, but ‖x‖₁ = 1.4 (outside the diamond) and ‖x‖∞ = 0.8 (inside the square). The corners of the diamond on the axes are why an ℓ₁ penalty sets coordinates to zero.';

const id = 'unit-balls';
type Label = { x: number; y: number; text: string; cls: string; anchor?: 'start' | 'middle' | 'end' };
const layouts = [{ cls: 'fig-compact', W: 420, H: 280, s: 108, o: [140, 140] as P2, lx: 284, ly: 92 }];
const draw = (L: (typeof layouts)[number]) => {
  const S = (p: P2): P2 => [L.o[0] + L.s * p[0], L.o[1] - L.s * p[1]];
  const paths = balls.map((b) => polyline(sphere(b.p).map(S)));
  const axes = [polyline([S([-1.25, 0]), S([1.25, 0])]), polyline([S([0, -1.25]), S([0, 1.25])])];
  const X = S(x);
  const legend = balls.map((b, i) => ({ y: L.ly + i * 34, ...b }));
  const labels: Label[] = [
    { x: X[0] + 8, y: X[1] - 8, text: t.x, cls: 'f-small' },
    ...legend.map((g) => ({ x: L.lx + 30, y: g.y + 5, text: g.name, cls: `f-small ${g.tone}` })),
    ...t.vals.map((v, i) => ({ x: L.lx + 30, y: L.ly + 3 * 34 + 14 + i * 20, text: v, cls: 'f-small f-t-muted' })),
  ];
  return { paths, axes, X, legend, labels };
};
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const D = draw(L);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-t ${id}-d`}>
        <title id={`${id}-t`}>{t.tt}</title>
        <desc id={`${id}-d`}>{t.desc}</desc>
        {D.axes.map((d) => <path class="f-axis" d={d} />)}
        {D.paths.map((d, i) => <path class={balls[i].cls} d={d} />)}
        <circle cx={D.X[0]} cy={D.X[1]} r="4.5" class="f-solid-red" />
        {D.legend.map((g) => <path class={g.cls} d={`M ${L.lx} ${g.y} L ${L.lx + 22} ${g.y}`} />)}
        {D.labels.map((l) => <text class={`${l.cls} f-halo`} x={l.x} y={l.y} text-anchor={l.anchor ?? 'start'}>{l.text}</text>)}
      </svg>
    );
  })}
</Figure>
