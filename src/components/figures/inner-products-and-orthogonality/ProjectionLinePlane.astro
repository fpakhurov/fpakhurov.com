---
import Figure from '../Figure.astro';
import { polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Left: projection of b = (3, 4) onto the line through a = (2, 1): x̂ = aᵀb / aᵀa = 2, p = (4, 2), e = (−1, 2).
// Right: projection of b = (1, 2, 6) onto the plane spanned by a1 = (1, 0, 1), a2 = (0, 1, 1): x̂ = (2, 3), p = (2, 3, 5), e = (−1, −1, 1).
type V = number[];
const dot = (u: V, v: V) => u.reduce((s, ui, i) => s + ui * v[i], 0);
const sub = (u: V, v: V) => u.map((ui, i) => ui - v[i]);
const mul = (k: number, u: V) => u.map((ui) => k * ui);
const nrm = (u: V) => Math.sqrt(dot(u, u));
const a = [2, 1], b = [3, 4];
const xh = dot(a, b) / dot(a, a), p = mul(xh, a), e = sub(b, p);
if (xh !== 2 || p.join() !== '4,2' || e.join() !== '-1,2' || dot(a, e) !== 0 || dot(b, b) !== dot(p, p) + dot(e, e))
  throw new Error('ProjectionLinePlane: the line example drifted from the note');
const a1 = [1, 0, 1], a2 = [0, 1, 1], b3 = [1, 2, 6];
// Normal equations [[2, 1], [1, 2]] x = (7, 8).
const g11 = dot(a1, a1), g12 = dot(a1, a2), g22 = dot(a2, a2), c1 = dot(a1, b3), c2 = dot(a2, b3), dt = g11 * g22 - g12 * g12;
const x3 = [(g22 * c1 - g12 * c2) / dt, (g11 * c2 - g12 * c1) / dt];
const p3 = a1.map((v, i) => x3[0] * v + x3[1] * a2[i]), e3 = sub(b3, p3);
if (x3.join() !== '2,3' || p3.join() !== '2,3,5' || e3.join() !== '-1,-1,1' || dot(e3, a1) !== 0 || dot(e3, a2) !== 0)
  throw new Error('ProjectionLinePlane: the plane example drifted from the note');
// An orthonormal frame for the drawing: q1, q2 span the plane (Gram–Schmidt), n is the direction of e.
const q1 = mul(1 / nrm(a1), a1);
const t2 = sub(a2, mul(dot(a2, q1), q1)), q2 = mul(1 / nrm(t2), t2);
const n3 = mul(1 / nrm(e3), e3);
const frame = (v: V) => [dot(v, q1), dot(v, q2), dot(v, n3)];

const t = ru
  ? { left: 'на прямую', right: 'на плоскость', a: 'a = (2, 1)', b: 'b = (3, 4)', p: 'p = 2a = (4, 2)', e: 'e = (−1, 2)', span: 'span(a)',
      b3: 'b = (1, 2, 6)', p3: 'p = (2, 3, 5)', e3: 'e ⊥ col(A)', a1: 'a₁', a2: 'a₂', col: 'col(A)',
      title: 'Ортогональная проекция на прямую и на плоскость',
      tt: 'Проекция вектора на прямую и на плоскость',
      desc: 'Слева: прямая через a = (2, 1), точка b = (3, 4), её проекция p = (4, 2) на прямую и перпендикуляр e = (−1, 2). Справа: плоскость, натянутая на a₁ = (1, 0, 1) и a₂ = (0, 1, 1), нарисованная в косоугольной проекции; точка b = (1, 2, 6) над ней, проекция p = (2, 3, 5) и перпендикуляр e = (−1, −1, 1) с прямым углом.' }
  : { left: 'onto a line', right: 'onto a plane', a: 'a = (2, 1)', b: 'b = (3, 4)', p: 'p = 2a = (4, 2)', e: 'e = (−1, 2)', span: 'span(a)',
      b3: 'b = (1, 2, 6)', p3: 'p = (2, 3, 5)', e3: 'e ⊥ col(A)', a1: 'a₁', a2: 'a₂', col: 'col(A)',
      title: 'Orthogonal projection onto a line and onto a plane',
      tt: 'Projection of a vector onto a line and onto a plane',
      desc: 'Left: the line through a = (2, 1), the point b = (3, 4), its projection p = (4, 2) onto the line and the perpendicular e = (−1, 2). Right: the plane spanned by a₁ = (1, 0, 1) and a₂ = (0, 1, 1), drawn in an oblique view; the point b = (1, 2, 6) above it, its projection p = (2, 3, 5) and the perpendicular e = (−1, −1, 1) with a right angle.' };
const caption = ru
  ? 'Слева: ближайшая к b = (3, 4) точка прямой через a = (2, 1) — это p = x̂a с x̂ = aᵀb / aᵀa = 10/5 = 2, то есть p = (4, 2). Ошибка e = b − p = (−1, 2) перпендикулярна a: aᵀe = −2 + 2 = 0, и по теореме Пифагора ‖b‖² = 25 = 20 + 5 = ‖p‖² + ‖e‖². Справа то же для плоскости col(A), натянутой на a₁ = (1, 0, 1) и a₂ = (0, 1, 1), в трёхмерном пространстве: нормальные уравнения AᵀAx̂ = Aᵀb дают x̂ = (2, 3), проекция p = 2a₁ + 3a₂ = (2, 3, 5), ошибка e = (−1, −1, 1) перпендикулярна обоим столбцам. Плоскость нарисована в косоугольной проекции, поэтому длины на рисунке не в масштабе.'
  : 'Left: the point of the line through a = (2, 1) closest to b = (3, 4) is p = x̂a with x̂ = aᵀb / aᵀa = 10/5 = 2, so p = (4, 2). The error e = b − p = (−1, 2) is perpendicular to a: aᵀe = −2 + 2 = 0, and by Pythagoras ‖b‖² = 25 = 20 + 5 = ‖p‖² + ‖e‖². Right: the same for the plane col(A) spanned by a₁ = (1, 0, 1) and a₂ = (0, 1, 1) in three dimensions: the normal equations AᵀAx̂ = Aᵀb give x̂ = (2, 3), the projection is p = 2a₁ + 3a₂ = (2, 3, 5), and the error e = (−1, −1, 1) is perpendicular to both columns. The plane is drawn in an oblique view, so lengths in the drawing are not to scale.';

const id = 'projection-line-plane';
type Label = { x: number; y: number; text: string; cls: string; anchor?: 'start' | 'middle' | 'end' };
// o2: screen origin of the 2D panel (scale s2); o3: origin of the oblique plane view (scale s3).
const layouts = [
  { cls: 'fig-wide fig-bp-640', W: 760, H: 300, s2: 50, o2: [52, 262], s3: 40, o3: [392, 214], ty: [22, 22], tx: [160, 560] },
  { cls: 'fig-narrow fig-bp-640 seq-narrow', W: 360, H: 510, s2: 52, o2: [66, 268], s3: 34, o3: [40, 458], ty: [22, 322], tx: [180, 180] },
];
const draw = (L: (typeof layouts)[number]) => {
  const S = (v: V) => [L.o2[0] + L.s2 * v[0], L.o2[1] - L.s2 * v[1]];
  // Oblique view of the frame coordinates (u, v, w): u to the right, v receding up and right, w up.
  const O3 = (v: V) => { const [u, w2, h] = frame(v); return [L.o3[0] + L.s3 * (u + 0.5 * w2), L.o3[1] - L.s3 * (0.33 * w2 + h)]; };
  const Q = (u: number, w2: number) => [L.o3[0] + L.s3 * (u + 0.5 * w2), L.o3[1] - L.s3 * 0.33 * w2];
  const k2 = 0.28, ua = mul(1 / nrm(a), a), ue = mul(1 / nrm(e), e);
  const box2 = polyline([S(p.map((v, i) => v + k2 * ue[i])), S(p.map((v, i) => v + k2 * ue[i] - k2 * ua[i])), S(p.map((v, i) => v - k2 * ua[i]))] as [number, number][]);
  const k3 = 0.3, dIn = mul(-1 / nrm(p3), p3);
  const box3 = polyline([O3(p3.map((v, i) => v + k3 * n3[i])), O3(p3.map((v, i) => v + k3 * n3[i] + k3 * dIn[i])), O3(p3.map((v, i) => v + k3 * dIn[i]))] as [number, number][]);
  const plane = polyline([Q(-0.5, -0.6), Q(6.0, -0.6), Q(6.0, 4.4), Q(-0.5, 4.4), Q(-0.5, -0.6)] as [number, number][]) + ' Z';
  const axes = [polyline([S([-0.6, 0]), S([4.9, 0])] as [number, number][]), polyline([S([0, -0.6]), S([0, 4.6])] as [number, number][])];
  const line = polyline([S([-0.5, -0.25]), S([4.9, 2.45])] as [number, number][]);
  const P2 = { O: S([0, 0]), A: S(a), B: S(b), P: S(p) };
  const P3 = { O: O3([0, 0, 0]), A1: O3(a1), A2: O3(a2), B: O3(b3), P: O3(p3) };
  const eMid = S([(b[0] + p[0]) / 2, (b[1] + p[1]) / 2]);
  const e3Mid = [(P3.B[0] + P3.P[0]) / 2, (P3.B[1] + P3.P[1]) / 2];
  const colAt = Q(-0.3, 3.6);
  const labels: Label[] = [
    { x: L.tx[0], y: L.ty[0], text: t.left, cls: 'f-small', anchor: 'middle' },
    { x: L.tx[1], y: L.ty[1], text: t.right, cls: 'f-small', anchor: 'middle' },
    { x: P2.A[0] + 4, y: P2.A[1] + 20, text: t.a, cls: 'f-small f-t-green' },
    { x: P2.B[0] + 10, y: P2.B[1] + 4, text: t.b, cls: 'f-small f-t-red' },
    { x: P2.P[0], y: P2.P[1] + 22, text: t.p, cls: 'f-small f-t-blue', anchor: 'middle' },
    { x: eMid[0] + 9, y: eMid[1] + 4, text: t.e, cls: 'f-small f-t-amber' },
    { x: P2.O[0] + 6, y: P2.O[1] - 34, text: t.span, cls: 'f-small f-t-muted' },
    { x: colAt[0], y: colAt[1], text: t.col, cls: 'f-small f-t-blue' },
    { x: P3.A1[0] + 2, y: P3.A1[1] + 18, text: t.a1, cls: 'f-small f-t-green' },
    { x: P3.A2[0] - 6, y: P3.A2[1] - 6, text: t.a2, cls: 'f-small f-t-green', anchor: 'end' },
    { x: P3.B[0] - 10, y: P3.B[1] + 2, text: t.b3, cls: 'f-small f-t-red', anchor: 'end' },
    { x: P3.P[0] - 10, y: P3.P[1] + 20, text: t.p3, cls: 'f-small f-t-blue', anchor: 'end' },
    { x: e3Mid[0] + 9, y: e3Mid[1] + 4, text: t.e3, cls: 'f-small f-t-amber' },
  ];
  return { axes, line, box2, box3, plane, P2, P3, labels };
};
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const D = draw(L);
    const seg = (u: number[], v: number[]) => `M ${u[0].toFixed(2)} ${u[1].toFixed(2)} L ${v[0].toFixed(2)} ${v[1].toFixed(2)}`;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.tt}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        {D.axes.map((d) => <path class="f-axis" d={d} />)}
        <path class="f-line f-muted" d={D.line} />
        <path class="f-line f-blue f-bold" d={seg(D.P2.O, D.P2.P)} />
        <path class="f-line f-green f-bold" d={seg(D.P2.O, D.P2.A)} marker-end="url(#f-arrow-green)" />
        <path class="f-line f-red" d={seg(D.P2.O, D.P2.B)} marker-end="url(#f-arrow-red)" />
        <path class="f-line f-amber f-dash" d={seg(D.P2.P, D.P2.B)} />
        <path class="f-thin" d={D.box2} />
        <circle cx={D.P2.P[0]} cy={D.P2.P[1]} r="4" class="f-solid-blue" />
        <path d={D.plane} class="f-fill-blue" style="stroke: var(--fig-blue); stroke-opacity: .5; stroke-width: 1" />
        <path class="f-line f-green" d={seg(D.P3.O, D.P3.A1)} marker-end="url(#f-arrow-green)" />
        <path class="f-line f-green" d={seg(D.P3.O, D.P3.A2)} marker-end="url(#f-arrow-green)" />
        <path class="f-thin f-blue f-dash" d={seg(D.P3.O, D.P3.P)} />
        <path class="f-line f-amber f-bold" d={seg(D.P3.P, D.P3.B)} />
        <path class="f-thin" d={D.box3} />
        <circle cx={D.P3.O[0]} cy={D.P3.O[1]} r="2.5" class="f-solid-muted" />
        <circle cx={D.P3.P[0]} cy={D.P3.P[1]} r="4" class="f-solid-blue" />
        <circle cx={D.P3.B[0]} cy={D.P3.B[1]} r="4" class="f-solid-red" />
        {D.labels.map((l) => <text class={`${l.cls} f-halo`} x={l.x} y={l.y} text-anchor={l.anchor ?? 'start'}>{l.text}</text>)}
      </svg>
    );
  })}
</Figure>
