---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The worked example of the note: Gram–Schmidt on a1 = (4, 3), a2 = (2, 4).
// r11 = 5, q1 = (0.8, 0.6); r12 = q1·a2 = 4; v2 = a2 − 4 q1 = (−1.2, 1.6); r22 = 2, q2 = (−0.6, 0.8); R = [[5, 4], [0, 2]].
type P2 = [number, number];
const a1: P2 = [4, 3], a2: P2 = [2, 4];
const r11 = Math.hypot(...a1), q1: P2 = [a1[0] / r11, a1[1] / r11];
const r12 = q1[0] * a2[0] + q1[1] * a2[1];
const foot: P2 = [r12 * q1[0], r12 * q1[1]];
const v2: P2 = [a2[0] - foot[0], a2[1] - foot[1]];
const r22 = Math.hypot(...v2), q2: P2 = [v2[0] / r22, v2[1] / r22];
const f2 = (v: number) => Number(v.toFixed(6));
const quoted = [r11, ...q1, r12, ...foot, ...v2, r22, ...q2].map(f2).join();
if (quoted !== '5,0.8,0.6,4,3.2,2.4,-1.2,1.6,2,-0.6,0.8' || Math.abs(q1[0] * q2[0] + q1[1] * q2[1]) > 1e-12)
  throw new Error(`GramSchmidtSteps: the example drifted from the note (${quoted})`);

const t = ru
  ? { a1: 'a₁', a2: 'a₂', q1: 'q₁', q2: 'q₂', v2: 'v₂', foot: '4q₁',
      lines: ['a₁ = (4, 3), a₂ = (2, 4)', 'r₁₁ = ‖a₁‖ = 5, q₁ = (0.8, 0.6)', 'r₁₂ = q₁ · a₂ = 4', 'v₂ = a₂ − 4q₁ = (−1.2, 1.6)', 'r₂₂ = ‖v₂‖ = 2, q₂ = (−0.6, 0.8)'],
      R: 'R = (5 4; 0 2), A = QR',
      steps: ['столбцы a₁ = (4, 3) и a₂ = (2, 4)', 'нормировать a₁: r₁₁ = 5, q₁ = (0.8, 0.6)', 'компонента a₂ вдоль q₁: r₁₂ = q₁ · a₂ = 4, вектор 4q₁ = (3.2, 2.4)', 'вычесть её: v₂ = a₂ − 4q₁ = (−1.2, 1.6), перпендикулярен q₁', 'нормировать v₂: r₂₂ = 2, q₂ = (−0.6, 0.8); A = QR'],
      title: 'Процесс Грама–Шмидта на двух векторах плоскости',
      tt: 'Шаги процесса Грама–Шмидта',
      desc: 'Векторы a₁ = (4, 3) и a₂ = (2, 4). Единичный вектор q₁ вдоль a₁; основание перпендикуляра из a₂ на прямую a₁ в точке 4q₁ = (3.2, 2.4); разность v₂ = (−1.2, 1.6), перпендикулярная q₁; единичный вектор q₂ = (−0.6, 0.8). Справа формулы каждого шага и матрица R = (5 4; 0 2).' }
  : { a1: 'a₁', a2: 'a₂', q1: 'q₁', q2: 'q₂', v2: 'v₂', foot: '4q₁',
      lines: ['a₁ = (4, 3), a₂ = (2, 4)', 'r₁₁ = ‖a₁‖ = 5, q₁ = (0.8, 0.6)', 'r₁₂ = q₁ · a₂ = 4', 'v₂ = a₂ − 4q₁ = (−1.2, 1.6)', 'r₂₂ = ‖v₂‖ = 2, q₂ = (−0.6, 0.8)'],
      R: 'R = (5 4; 0 2), A = QR',
      steps: ['the columns a₁ = (4, 3) and a₂ = (2, 4)', 'normalize a₁: r₁₁ = 5, q₁ = (0.8, 0.6)', 'the component of a₂ along q₁: r₁₂ = q₁ · a₂ = 4, the vector 4q₁ = (3.2, 2.4)', 'subtract it: v₂ = a₂ − 4q₁ = (−1.2, 1.6), perpendicular to q₁', 'normalize v₂: r₂₂ = 2, q₂ = (−0.6, 0.8); A = QR'],
      title: 'Gram–Schmidt on two vectors in the plane',
      tt: 'The steps of Gram–Schmidt',
      desc: 'The vectors a₁ = (4, 3) and a₂ = (2, 4). The unit vector q₁ along a₁; the foot of the perpendicular from a₂ to the line of a₁ at 4q₁ = (3.2, 2.4); the difference v₂ = (−1.2, 1.6), perpendicular to q₁; the unit vector q₂ = (−0.6, 0.8). On the right, the formulas of each step and the matrix R = (5 4; 0 2).' };
const caption = ru
  ? 'Процесс Грама–Шмидта превращает столбцы a₁, a₂ в ортонормированные векторы q₁, q₂, на которые натянута та же плоскость. Первый вектор только нормируется (2). Из второго вычитается его проекция на q₁ (3, 4): остаток v₂ = a₂ − (q₁ · a₂)q₁ перпендикулярен q₁, потому что q₁ · v₂ = 4 − 4 = 0, и затем нормируется (5). Коэффициенты, которые при этом появились, образуют верхнюю треугольную матрицу R: a₁ = 5q₁ и a₂ = 4q₁ + 2q₂, то есть A = QR. Пунктирный зелёный отрезок от 4q₁ до a₂ — тот же вектор v₂, отложенный от основания перпендикуляра. Нажмите ▶, чтобы пройти шаги по одному.'
  : 'Gram–Schmidt turns the columns a₁, a₂ into orthonormal q₁, q₂ that span the same plane. The first vector is only normalized (2). From the second, its projection onto q₁ is subtracted (3, 4): the remainder v₂ = a₂ − (q₁ · a₂)q₁ is perpendicular to q₁, because q₁ · v₂ = 4 − 4 = 0, and is then normalized (5). The coefficients that appear along the way form the upper triangular matrix R: a₁ = 5q₁ and a₂ = 4q₁ + 2q₂, that is, A = QR. The dashed green segment from 4q₁ to a₂ is the same vector v₂, drawn from the foot of the perpendicular. Press ▶ to go through the steps one at a time.';

const id = 'gram-schmidt-steps';
type Label = { x: number; y: number; text: string; cls: string; anchor?: 'start' | 'middle' | 'end' };
// o: screen origin of the plot; s: scale; text block at (tx, ty) with line spacing dy.
const layouts = [
  { cls: 'fig-wide fig-bp-640', W: 760, H: 310, s: 56, o: [112, 278] as P2, tx: 446, ty: 64, dy: 40 },
  { cls: 'fig-narrow fig-bp-640 seq-narrow', W: 360, H: 520, s: 50, o: [96, 254] as P2, tx: 44, ty: 316, dy: 36 },
];
const draw = (L: (typeof layouts)[number]) => {
  const S = (p: P2): P2 => [L.o[0] + L.s * p[0], L.o[1] - L.s * p[1]];
  const O = S([0, 0]), A1 = S(a1), A2 = S(a2), Q1 = S(q1), F = S(foot), V2 = S(v2), Q2 = S(q2);
  const axes = [polyline([S([-1.6, 0]), S([4.6, 0])]), polyline([S([0, -0.4]), S([0, 4.5])])];
  const k = 0.22;
  const boxFoot = polyline([S([foot[0] + k * q2[0], foot[1] + k * q2[1]]), S([foot[0] + k * q2[0] - k * q1[0], foot[1] + k * q2[1] - k * q1[1]]), S([foot[0] - k * q1[0], foot[1] - k * q1[1]])]);
  const boxO = polyline([S([k * q2[0], k * q2[1]]), S([k * q2[0] + k * q1[0], k * q2[1] + k * q1[1]]), S([k * q1[0], k * q1[1]])]);
  const plotLabels: Label[][] = [
    [{ x: A1[0] + 9, y: A1[1] + 4, text: t.a1, cls: 'f-small' }, { x: A2[0] - 8, y: A2[1] - 2, text: t.a2, cls: 'f-small', anchor: 'end' }],
    [{ x: Q1[0] + 6, y: Q1[1] + 18, text: t.q1, cls: 'f-small f-t-blue' }],
    [{ x: F[0] + 9, y: F[1] + 16, text: t.foot, cls: 'f-small f-t-amber' }],
    [{ x: V2[0] - 8, y: V2[1] + 2, text: t.v2, cls: 'f-small f-t-green', anchor: 'end' }],
    [{ x: Q2[0] + 9, y: Q2[1] + 4, text: t.q2, cls: 'f-small f-t-blue' }],
  ];
  const textLabels: Label[] = t.lines.map((s, i) => ({ x: L.tx + 22, y: L.ty + i * L.dy + 5, text: s, cls: 'f-label' }));
  const rLabel: Label = { x: L.tx + 22, y: L.ty + 5 * L.dy + 5, text: t.R, cls: 'f-label f-t-blue' };
  const badges = t.lines.map((_, i) => [L.tx, L.ty + i * L.dy] as P2);
  const labels = [...plotLabels.flat(), ...textLabels, rLabel];
  const boxes = badges.map(([bx, by], i) => ({ t: `badge ${i + 1}`, x0: bx - 9.5, x1: bx + 9.5, y0: by - 9.5, y1: by + 9.5 }));
  return { O, A1, A2, Q1, F, V2, Q2, axes, boxFoot, boxO, plotLabels, textLabels, rLabel, badges, labels, boxes };
};
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const D = draw(L);
    const seg = (u: number[], v: number[]) => `M ${u[0].toFixed(2)} ${u[1].toFixed(2)} L ${v[0].toFixed(2)} ${v[1].toFixed(2)}`;
    const lbl = (l: { x: number; y: number; text: string; cls: string; anchor?: string }) => <text class={`${l.cls} f-halo`} x={l.x} y={l.y} text-anchor={l.anchor ?? 'start'}>{l.text}</text>;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.tt}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        {D.axes.map((d) => <path class="f-axis" d={d} />)}
        <g data-s="1">
          <path class="f-line" d={seg(D.O, D.A1)} marker-end="url(#f-arrow)" />
          <path class="f-line" d={seg(D.O, D.A2)} marker-end="url(#f-arrow)" />
          {D.plotLabels[0].map(lbl)}
          <Badge x={D.badges[0][0]} y={D.badges[0][1]} n={1} />
          {lbl(D.textLabels[0])}
        </g>
        <g data-s="2">
          <path class="f-line f-blue f-bold" d={seg(D.O, D.Q1)} marker-end="url(#f-arrow-blue)" />
          {D.plotLabels[1].map(lbl)}
          <Badge x={D.badges[1][0]} y={D.badges[1][1]} n={2} />
          {lbl(D.textLabels[1])}
        </g>
        <g data-s="3">
          <path class="f-line f-amber f-dot" d={seg(D.A2, D.F)} />
          <path class="f-thin" d={D.boxFoot} />
          <circle cx={D.F[0]} cy={D.F[1]} r="4" style="fill: var(--fig-amber)" />
          {D.plotLabels[2].map(lbl)}
          <Badge x={D.badges[2][0]} y={D.badges[2][1]} n={3} />
          {lbl(D.textLabels[2])}
        </g>
        <g data-s="4">
          <path class="f-line f-green f-dash" d={seg(D.F, D.A2)} marker-end="url(#f-arrow-green)" />
          <path class="f-line f-green" d={seg(D.O, D.V2)} marker-end="url(#f-arrow-green)" />
          {D.plotLabels[3].map(lbl)}
          <Badge x={D.badges[3][0]} y={D.badges[3][1]} n={4} />
          {lbl(D.textLabels[3])}
        </g>
        <g data-s="5">
          <path class="f-line f-blue f-bold" d={seg(D.O, D.Q2)} marker-end="url(#f-arrow-blue)" />
          <path class="f-thin" d={D.boxO} />
          {D.plotLabels[4].map(lbl)}
          <Badge x={D.badges[4][0]} y={D.badges[4][1]} n={5} />
          {lbl(D.textLabels[4])}
          {lbl(D.rLabel)}
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
