---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
const id = 'db-sessions';
const clients = [
  { x: 16, session: 'A', label: ru ? 'Кассовый сервис' : 'Checkout service' },
  { x: 196, session: 'B', label: ru ? 'Отчёт' : 'Reporting tool' },
];
---

<Figure id={id}
  title={ru ? 'Два сеанса работают с одними таблицами' : 'Two sessions share the same tables'}
  caption={ru
    ? 'Каждый клиент передаёт запросы через своё подключение. PostgreSQL хранит контекст каждого сеанса и выполняет операции над общими таблицами.'
    : 'Each client sends requests over its own connection. PostgreSQL keeps the context of each session and executes operations on the shared tables.'}>
  <svg class="fig-compact seq-narrow" viewBox="0 0 360 268" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
    <title id={`${id}-title`}>{ru ? 'Кассовый сервис и отчёт подключены к PostgreSQL' : 'Checkout and reporting clients connect to PostgreSQL'}</title>
    <desc id={`${id}-desc`}>{ru ? 'Касса отправляет запросы в сеанс A. Отчёт отправляет запросы в сеанс B. Оба сеанса обращаются к общим таблицам orders и payments.' : 'The checkout sends requests in session A. The report sends requests in session B. Both sessions access the shared orders and payments tables.'}</desc>
    <rect x="16" y="97" width="328" height="159" rx="8" style="fill: var(--fig-blue); fill-opacity: 0.06; stroke: var(--fig-blue)" />
    <text class="f-label f-t-blue" x="180" y="120" text-anchor="middle">PostgreSQL</text>
    {clients.map(({ x, session, label }, index) => {
      const sessionX = index === 0 ? 94 : 266;
      return <>
        <rect x={x} y="13" width="148" height="46" rx="6" style="fill: var(--fig-green); fill-opacity: 0.14" />
        <text class="f-small" x={x + 74} y="41" text-anchor="middle">{label}</text>
        <path class="f-line f-green" d={`M ${x + 74} 60 V 132`} marker-end="url(#f-arrow-green)" />
        <text class="f-small f-t-muted" x={x + 86} y="83">SQL</text>
        <rect x={sessionX - 56} y="139" width="112" height="38" rx="6" style="fill: var(--fig-blue); fill-opacity: 0.12" />
        <text class="f-small" x={sessionX} y="163" text-anchor="middle">{ru ? 'Сеанс' : 'Session'} {session}</text>
        <path class="f-line f-blue" d={`M ${sessionX} 178 V 208`} marker-end="url(#f-arrow-blue)" />
      </>;
    })}
    <rect x="40" y="214" width="280" height="30" rx="6" style="fill: var(--fig-amber); fill-opacity: 0.14" />
    <text class="f-small" x="180" y="234" text-anchor="middle" style="font-family: var(--mono)">orders · payments</text>
  </svg>
</Figure>
