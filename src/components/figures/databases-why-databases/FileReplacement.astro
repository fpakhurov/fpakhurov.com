---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
const id = 'db-file-replacement';
const steps = ru
  ? [
      { action: 'A читает файл', local: 'пустая копия', visible: '∅' },
      { action: 'B читает файл', local: 'пустая копия', visible: '∅' },
      { action: 'A заменяет файл', local: 'копия со строкой 501', visible: '501' },
      { action: 'B заменяет файл', local: 'копия со строкой 502', visible: '502' },
    ]
  : [
      { action: 'A reads the file', local: 'empty copy', visible: '∅' },
      { action: 'B reads the file', local: 'empty copy', visible: '∅' },
      { action: 'A replaces the file', local: 'copy with row 501', visible: '501' },
      { action: 'B replaces the file', local: 'copy with row 502', visible: '502' },
    ];
---

<Figure id={id}
  title={ru ? 'Вторая замена использует старую копию' : 'The second replacement uses a stale copy'}
  caption={ru
    ? 'Строки 501 и 502 представляют разные оплаты. Справа показано содержимое общего файла после каждого шага. Знак ∅ обозначает файл без оплат.'
    : 'Rows 501 and 502 represent different payments. The right column shows the shared file after each step. The empty-set symbol stands for a file with no payments.'}>
  <svg class="fig-compact seq-narrow" viewBox="0 0 360 281" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
    <title id={`${id}-title`}>{ru ? 'Расписание двух замен общего файла' : 'Schedule of two replacements of a shared file'}</title>
    <desc id={`${id}-desc`}>{ru ? 'A и B читают пустой файл. A заменяет его копией с оплатой 501. B заменяет его копией с оплатой 502. В файле остаётся только 502.' : 'A and B read the empty file. A replaces it with a copy containing payment 501. B replaces it with a copy containing payment 502. Only payment 502 remains.'}</desc>
    <text class="f-small f-t-muted" x="50" y="22">{ru ? 'Операция' : 'Operation'}</text>
    <text class="f-small f-t-muted" x="285" y="22" text-anchor="middle">{ru ? 'Общий файл' : 'Shared file'}</text>
    <path class="f-line f-muted" d="M 22 54 V 238" marker-end="url(#f-arrow-muted)" />
    {steps.map((step, index) => {
      const y = 34 + index * 60;
      return <>
        <circle cx="22" cy={y + 23} r="11" style="fill: var(--paper); stroke: var(--muted)" />
        <text class="f-small" x="22" y={y + 28} text-anchor="middle">{index + 1}</text>
        <rect x="42" y={y} width="177" height="49" rx="6" style="fill: var(--fig-blue); fill-opacity: 0.10" />
        <text class="f-small" x="52" y={y + 20}>{step.action}</text>
        <text class="f-small f-t-muted" x="52" y={y + 39}>{step.local}</text>
        <rect x="230" y={y} width="110" height="49" rx="6" fill={index === 3 ? 'var(--fig-red)' : 'var(--fig-amber)'} fill-opacity="0.11" />
        <text class="f-label" x="285" y={y + 31} text-anchor="middle" style="font-family: var(--mono)">{step.visible}</text>
      </>;
    })}
  </svg>
</Figure>
