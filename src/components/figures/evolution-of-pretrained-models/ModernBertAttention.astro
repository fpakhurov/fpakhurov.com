---
import Figure from '../Figure.astro';
import Arrow from '../seqflow/Arrow.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// ModernBERT-base: 22 layers, layer i global when i is a multiple of 3, the others a sliding window of 128 tokens
// (64 on each side). The masks are drawn for 16 tokens with a window of ±2. Unpadding: four sequences of
// 512, 320, 128 and 64 tokens (one cell per 64 tokens), padded to 512 or concatenated.
const L = 22;
const layerGlobal = Array.from({ length: L }, (_, i) => i % 3 === 0);
const nGlobal = layerGlobal.filter(Boolean).length;
if (nGlobal !== 8) throw new Error(`ModernBertAttention: expected 8 global layers, got ${nGlobal}`);
const T = 16, half = 2;
const sees = (i: number, j: number, global: boolean) => global || Math.abs(i - j) <= half;
const localCount = Array.from({ length: T }, (_, i) => Array.from({ length: T }, (_, j) => sees(i, j, false)).filter(Boolean).length);
if (localCount[8] !== 2 * half + 1) throw new Error('ModernBertAttention: a middle token sees 2·half + 1 keys');
const lengths = [512, 320, 128, 64], unit = 64;
const cells = lengths.map((l) => l / unit);
const padded = lengths.length * Math.max(...lengths), real = lengths.reduce((a, b) => a + b, 0);
if (padded !== 2048 || real !== 1024) throw new Error(`ModernBertAttention: unpadding numbers drifted (${padded}, ${real})`);
const t = ru
  ? { strip: 'слои ModernBERT-base: Г — глобальное внимание, Л — локальное', stripN: 'слои ModernBERT-base: Г глобальные, Л локальные', G: 'Г', Lc: 'Л',
      glob: 'глобальный слой', globSub: 'каждый токен видит все', loc: 'локальный слой', locSub: 'окно ±2 (в модели ±64)', locSubN: 'здесь окно ±2',
      pad: 'с паддингом: 4 × 512 = 2048 позиций', packed: 'без паддинга: 1024 токена в одной строке', cell: ['клетка = 64 токена;', 'внимание не выходит за свою последовательность'] }
  : { strip: 'layers of ModernBERT-base: G global attention, L local', stripN: 'ModernBERT-base layers: G global, L local', G: 'G', Lc: 'L',
      glob: 'global layer', globSub: 'every token sees all', loc: 'local layer', locSub: 'window ±2 (±64 in the model)', locSubN: 'window ±2 here',
      pad: 'padded: 4 × 512 = 2,048 positions', packed: 'unpadded: 1,024 tokens in one row', cell: ['one cell = 64 tokens;', 'attention stays inside each sequence'] };
const id = 'modernbert-attention-unpadding';
interface Lay { cls: string; W: number; H: number; strip: [number, number, number]; mats: [number, number][]; mc: number; pad: [number, number]; pc: number; packY: number; narrow: boolean }
const layouts: Lay[] = [
  { cls: 'fig-wide fig-bp-640', W: 760, H: 318, strip: [40, 34, 30], mats: [[40, 112], [220, 112]], mc: 8.5, pad: [430, 112], pc: 19, packY: 250, narrow: false },
  { cls: 'fig-narrow fig-bp-640', W: 360, H: 540, strip: [12, 34, 15], mats: [[20, 120], [196, 120]], mc: 8.5, pad: [20, 320], pc: 20, packY: 470, narrow: true },
];
const seqTone = ['0.62', '0.40', '0.62', '0.40'];
// Whether cell j of padded row s holds a real token (kept out of the template, which avoids comparisons).
const isReal = (s: number, j: number) => j < cells[s];
---

<Figure
  id={id}
  title={ru ? 'ModernBERT: чередование глобального и локального внимания и работа без паддинга' : 'ModernBERT: alternating global and local attention, and unpadding'}
  caption={ru
    ? `Сверху: ${L} слоя ModernBERT-base; каждый третий, начиная с первого, глобальный (${nGlobal} слоёв), остальные ${L - nGlobal} — локальные. Слева: какие пары токенов получают оценку внимания в глобальном и в локальном слое, на ${T} токенах с окном ±${half}; в модели окно ±64, так что на 8192 токенах локальный слой считает примерно в 64 раза меньше оценок. Справа: четыре последовательности из 512, 320, 128 и 64 токенов (клетка — 64 токена). С паддингом батч занимает ${padded} позиций, из которых ${real} — настоящие токены; без паддинга последовательности склеены в одну строку из ${real} токенов, а GPU-ядро внимания для последовательностей переменной длины не даёт им смотреть друг на друга. Результат на настоящих токенах тот же; меняется только объём вычислений.`
    : `Top: the ${L} layers of ModernBERT-base; every third one, starting with the first, is global (${nGlobal} layers), the other ${L - nGlobal} are local. Left: which pairs of tokens get an attention score in a global and in a local layer, for ${T} tokens and a window of ±${half}; the model's window is ±64, so at 8,192 tokens a local layer computes about 64 times fewer scores. Right: four sequences of 512, 320, 128 and 64 tokens (one cell per 64 tokens). Padded, the batch takes ${padded.toLocaleString('en')} positions, of which ${real.toLocaleString('en')} are real tokens; unpadded, the sequences are concatenated into one row of ${real.toLocaleString('en')} tokens, and a variable-length attention kernel keeps them from attending to each other. The output on the real tokens is the same; only the amount of computation changes.`}
>
  {layouts.map((Ly) => {
    const [sx, sy, sw] = Ly.strip;
    const mat = (ox: number, oy: number, global: boolean) => (
      <g>
        {Array.from({ length: T }, (_, i) => Array.from({ length: T }, (_, j) => (
          <rect x={ox + j * Ly.mc} y={oy + i * Ly.mc} width={Ly.mc - 1} height={Ly.mc - 1} class={sees(i, j, global) ? 'f-fill-blue' : 'f-fill-paper'} style={sees(i, j, global) ? 'fill-opacity: 0.6' : undefined} />
        )))}
        <rect class="f-thin f-muted" x={ox - 1} y={oy - 1} width={T * Ly.mc + 1} height={T * Ly.mc + 1} fill="none" />
      </g>
    );
    const [px, py] = Ly.pad;
    const maxC = Math.max(...cells);
    let acc = 0;
    const packStart = cells.map((c) => { const s = acc; acc += c; return s; });
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.W}-t ${id}-${Ly.W}-d`}>
        <title id={`${id}-${Ly.W}-t`}>{ru ? 'Чередование слоёв внимания и упаковка батча' : 'Alternating attention layers and a packed batch'}</title>
        <desc id={`${id}-${Ly.W}-d`}>{ru
          ? `Полоса из ${L} слоёв: ${layerGlobal.map((g) => (g ? 'Г' : 'Л')).join('')}. Две матрицы ${T} на ${T}: глобальная заполнена целиком, локальная — полосой ширины ${2 * half + 1} вдоль диагонали. Батч из четырёх последовательностей с паддингом занимает ${padded} позиций, без паддинга — ${real}.`
          : `A strip of ${L} layers: ${layerGlobal.map((g) => (g ? 'G' : 'L')).join('')}. Two ${T} by ${T} matrices: the global one is full, the local one is a band of width ${2 * half + 1} along the diagonal. A batch of four sequences takes ${padded} positions padded and ${real} unpadded.`}</desc>
        <text class="f-small" x={sx} y={sy - 12} style="font-weight: 650">{Ly.narrow ? t.stripN : t.strip}</text>
        {layerGlobal.map((g, i) => (
          <g>
            <rect class={g ? 'f-fill-blue' : 'f-fill-paper'} style={g ? 'fill-opacity: 0.6' : undefined} x={sx + i * sw} y={sy} width={sw - 3} height="22" rx="3" />
            <rect class={`f-thin ${g ? 'f-blue' : 'f-muted'}`} x={sx + i * sw} y={sy} width={sw - 3} height="22" rx="3" fill="none" />
            <text class="f-small" x={sx + i * sw + (sw - 3) / 2} y={sy + 15.5} text-anchor="middle" style={Ly.narrow ? 'font-size: 10.5px' : undefined}>{g ? t.G : t.Lc}</text>
          </g>
        ))}
        {[true, false].map((g, k) => {
          const [ox, oy] = Ly.mats[k];
          return (
            <g>
              <text class="f-small" x={ox} y={oy - 26} style="font-weight: 650">{g ? t.glob : t.loc}</text>
              <text class="f-small f-t-muted" x={ox} y={oy - 10}>{g ? t.globSub : Ly.narrow ? t.locSubN : t.locSub}</text>
              {mat(ox, oy, g)}
            </g>
          );
        })}
        <text class="f-small" x={px} y={py - 10} style="font-weight: 650">{t.pad}</text>
        {cells.map((c, s) => Array.from({ length: maxC }, (_, j) => (
          <rect x={px + j * Ly.pc} y={py + s * Ly.pc} width={Ly.pc - 2} height={Ly.pc - 2} rx="2"
            class={isReal(s, j) ? 'f-fill-green' : 'f-fill-paper'} style={isReal(s, j) ? `fill-opacity: ${seqTone[s]}` : 'stroke: var(--muted); stroke-width: 1; stroke-dasharray: 2 2; stroke-opacity: 0.6'} />
        )))}
        <Arrow pts={[[px + 4 * Ly.pc, py + 4 * Ly.pc + 6], [px + 4 * Ly.pc, Ly.packY - 30]]} />
        <text class="f-small" x={px} y={Ly.packY - 10} style="font-weight: 650">{t.packed}</text>
        {cells.map((c, s) => Array.from({ length: c }, (_, j) => (
          <rect x={px + (packStart[s] + j) * (Ly.narrow ? Ly.pc : Ly.pc * 0.98)} y={Ly.packY} width={(Ly.narrow ? Ly.pc : Ly.pc * 0.98) - 2} height={Ly.pc - 2} rx="2" class="f-fill-green" style={`fill-opacity: ${seqTone[s]}`} />
        )))}
        {packStart.slice(1).map((s) => <path class="f-line" d={`M ${px + s * (Ly.narrow ? Ly.pc : Ly.pc * 0.98) - 1} ${Ly.packY - 4} V ${Ly.packY + Ly.pc + 2}`} />)}
        {t.cell.map((line, li) => <text class="f-small f-t-muted" x={px} y={Ly.packY + Ly.pc + 16 + li * 16}>{line}</text>)}
      </svg>
    );
  })}
</Figure>
