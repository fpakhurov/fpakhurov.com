---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Arrow from '../seqflow/Arrow.astro';
import NewMark from '../seqflow/NewMark.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import Sub from '../generative-modeling/Sub.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Replaced-token detection on the sentence of the BERT figure. Two positions are masked; the generator samples
// "dog" for "cat" (a replacement) and "mat" for "mat" (the original token again, so its label is "original").
const words = ['the', 'cat', 'sat', 'on', 'the', 'warm', 'mat'];
const masked = new Set([1, 6]);
const sample: Record<number, string> = { 1: 'dog', 6: 'mat' };
const corrupted = words.map((w, i) => (masked.has(i) ? sample[i] : w));
const replaced = corrupted.map((w, i) => w !== words[i]);
const nRep = replaced.filter(Boolean).length;
if (nRep !== 1 || masked.size !== 2) throw new Error('ElectraFlow: the example drifted from the text (2 masked, 1 replaced)');
const t = ru
  ? { rows: ['текст', 'вход генератора', 'вход дискриминатора', 'метки'], gen: 'генератор: небольшая модель MLM', genN: 'генератор (малая MLM)',
      disc: 'дискриминатор (ELECTRA): метка в каждой позиции', discN: 'дискриминатор (ELECTRA)',
      orig: 'исходный', rep: 'заменён', origN: 'исх.', repN: 'зам.', newLab: 'новое: метка в каждой позиции', newLabN: 'новое',
      loss: [`генератор: −log p_G(исходного токена) в ${masked.size} маскированных позициях`, `дискриминатор: бинарная кросс-энтропия во всех ${words.length} позициях`, 'итого: L_{MLM} + λ · L_{Disc}, λ = 50; генератор потом выбрасывается'],
      lossN: ['генератор: −log p_G(исходного токена)', `  в ${masked.size} маскированных позициях`, 'дискриминатор: бинарная', `  кросс-энтропия во всех ${words.length} позициях`, 'итого: L_{MLM} + λ · L_{Disc}, λ = 50'],
      steps: ['выбрать позиции и заменить их на [MASK]', 'генератор сэмплирует токен в каждой маскированной позиции', 'сэмплы встают на место масок: искажённый вход', 'дискриминатор помечает каждую позицию: исходный или заменён', 'функции потерь: MLM в маскированных позициях, обнаружение замен — во всех'] }
  : { rows: ['text', 'generator input', 'discriminator input', 'labels'], gen: 'generator: a small masked language model', genN: 'generator (small MLM)',
      disc: 'discriminator (ELECTRA): a label at every position', discN: 'discriminator (ELECTRA)',
      orig: 'original', rep: 'replaced', origN: 'orig.', repN: 'repl.', newLab: 'new: a label at every position', newLabN: 'new',
      loss: [`generator: −log p_G(original token) at the ${masked.size} masked positions`, `discriminator: binary cross-entropy at all ${words.length} positions`, 'total: L_{MLM} + λ · L_{Disc}, λ = 50; the generator is discarded afterwards'],
      lossN: ['generator: −log p_G(original token)', `  at the ${masked.size} masked positions`, 'discriminator: binary cross-entropy', `  at all ${words.length} positions`, 'total: L_{MLM} + λ · L_{Disc}, λ = 50'],
      steps: ['select positions and replace them by [MASK]', 'the generator samples a token at each masked position', 'the samples take the place of the masks: the corrupted input', 'the discriminator labels every position original or replaced', 'losses: MLM at the masked positions, detection at all positions'] };
interface Layout { cls: string; W: number; H: number; x0: number; cw: number; gap: number; y: number[]; narrow: boolean; legend: [number, number]; step: number; rows: number; tok: string }
// y: text, generator input, generator band, discriminator input, discriminator band, labels, first loss line.
const layouts: Layout[] = [
  { cls: 'fig-wide fig-bp-640', W: 760, H: 474, x0: 190, cw: 74, gap: 6, y: [22, 60, 116, 196, 252, 332, 400], narrow: false, legend: [190, 462], step: 130, rows: 1, tok: '12.5px' },
  { cls: 'fig-narrow fig-bp-640', W: 360, H: 532, x0: 10, cw: 44, gap: 4, y: [26, 76, 130, 214, 268, 350, 410], narrow: true, legend: [10, 506], step: 170, rows: 2, tok: '11.5px' },
];
const id = 'electra-replaced-token-detection';
---

<Figure
  id={id}
  title={ru ? 'Обнаружение заменённых токенов: что куда идёт' : 'Replaced-token detection: what goes where'}
  caption={ru
    ? `Предложение рисунка про BERT. Выбраны две позиции из семи (на практике 15%), в них стоит [MASK] (1). Небольшой генератор — обычная модель MLM — предсказывает распределение в каждой маскированной позиции и сэмплирует из него токен: dog вместо cat и mat вместо mat (2). Сэмплы встают на место масок (3). Дискриминатор читает искажённое предложение и в каждой из семи позиций предсказывает, исходный ли там токен (4). Позиция, где генератор случайно выдал исходное слово (mat), получает метку «исходный». Генератор учится по MLM только в маскированных позициях, дискриминатор — во всех; градиент дискриминатора в генератор не идёт, потому что сэмплирование дискретно (5). После предобучения генератор выбрасывают, а дообучают дискриминатор.`
    : `The sentence of the BERT figure. Two of the seven positions are selected (15% in practice) and replaced by [MASK] (1). A small generator, an ordinary MLM, predicts a distribution at each masked position and samples a token from it: dog for cat and mat for mat (2). The samples take the place of the masks (3). The discriminator reads the corrupted sentence and predicts at every one of the seven positions whether the token there is the original (4). A position where the generator happened to produce the original word (mat) is labelled original. The generator learns by MLM at the masked positions only, the discriminator at all positions; the discriminator's gradient does not flow into the generator, because sampling is discrete (5). After pretraining the generator is thrown away and the discriminator is fine-tuned.`}
>
  {layouts.map((L) => {
    const x = (i: number) => L.x0 + i * (L.cw + L.gap);
    const right = x(words.length - 1) + L.cw;
    const [yText, yIn, yGen, yCor, yDisc, yLab, yLoss] = L.y;
    const BH = 38, CH = 28;
    const rowLabel = (r: number, yy: number) => (L.narrow
      ? <text class="f-small f-t-muted f-halo" x={L.x0 + 24} y={yy - 9}>{t.rows[r]}</text>
      : <text class="f-small f-t-muted" x={L.x0 - 14} y={yy + 18} text-anchor="end">{t.rows[r]}</text>);
    const badgeX = L.narrow ? L.x0 + 10 : 26;
    const badgeY = (yy: number, band = false) => (L.narrow && !band ? yy - 13 : yy + (band ? BH / 2 : CH / 2));
    const cell = (i: number, yy: number, cls: string, stroke: string, label: string, opts: { bold?: boolean; mono?: boolean; w?: number } = {}) => (
      <g>
        <rect class={cls} x={x(i)} y={yy} width={L.cw} height={CH} rx="5" />
        <rect class={`f-thin ${stroke}`} x={x(i)} y={yy} width={L.cw} height={CH} rx="5" fill="none" style={opts.w ? `stroke-width: ${opts.w}` : undefined} />
        <text class="f-small" x={x(i) + L.cw / 2} y={yy + 18.5} text-anchor="middle" font-family={opts.mono === false ? undefined : 'var(--mono)'} style={`font-size: ${L.tok}${opts.bold ? '; font-weight: 700' : ''}`}>{label}</text>
      </g>
    );
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Генератор и дискриминатор ELECTRA на одном предложении' : 'ELECTRA’s generator and discriminator on one sentence'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? `Текст ${words.join(' ')}. Позиции cat и mat заменены на [MASK]. Генератор сэмплирует dog и mat. Дискриминатор получает ${corrupted.join(' ')} и ставит метку в каждой из ${words.length} позиций: заменён только dog, остальные исходные. Потери генератора — в двух маскированных позициях, дискриминатора — во всех семи.`
          : `The text ${words.join(' ')}. Positions cat and mat are replaced by [MASK]. The generator samples dog and mat. The discriminator receives ${corrupted.join(' ')} and labels each of the ${words.length} positions: only dog is replaced, the rest are original. The generator's loss is at the two masked positions, the discriminator's at all seven.`}</desc>
        {!L.narrow && <text class="f-small f-t-muted" x={L.x0 - 14} y={yText + 4} text-anchor="end">{t.rows[0]}</text>}
        {words.map((w, i) => <text class="f-small f-t-muted" x={x(i) + L.cw / 2} y={yText + 4} text-anchor="middle" font-family="var(--mono)" style={`font-size: ${L.tok}`}>{w}</text>)}

        <g data-s="1">
          {words.map((_, i) => <Arrow pts={[[x(i) + L.cw / 2, yText + 10], [x(i) + L.cw / 2, yIn - 3]]} tone={masked.has(i) ? 'blue' : 'muted'} />)}
          {rowLabel(1, yIn)}
          {words.map((w, i) => (masked.has(i) ? cell(i, yIn, 'f-fill-blue', 'f-blue', '[MASK]') : cell(i, yIn, 'f-fill-paper', 'f-muted', w)))}
          <Badge x={badgeX} y={badgeY(yIn)} n={1} />
        </g>

        <g data-s="2">
          {words.map((_, i) => <Arrow pts={[[x(i) + L.cw / 2, yIn + CH + 1], [x(i) + L.cw / 2, yGen - 3]]} />)}
          <rect class="f-fill-paper" x={L.x0} y={yGen} width={right - L.x0} height={BH} rx="7" />
          <rect class="f-thin" x={L.x0} y={yGen} width={right - L.x0} height={BH} rx="7" fill="none" />
          <text class="f-small" x={(L.x0 + right) / 2} y={yGen + 24} text-anchor="middle">{L.narrow ? t.genN : t.gen}</text>
          <NewMark x={L.x0 - 4} y={yGen - 4} w={right - L.x0 + 8} h={BH + 8} at="bl" label={ru ? 'новое' : 'new'} />
          <Badge x={badgeX} y={badgeY(yGen, true)} n={2} />
        </g>

        <g data-s="3">
          {[...masked].map((i) => <Arrow pts={[[x(i) + L.cw / 2, yGen + BH + 1], [x(i) + L.cw / 2, yCor - 3]]} tone="amber" bold />)}
          {rowLabel(2, yCor)}
          {corrupted.map((w, i) => (replaced[i]
            ? cell(i, yCor, 'f-fill-green', 'f-amber', w, { bold: true, w: 2.4 })
            : cell(i, yCor, 'f-fill-green', 'f-green', w)))}
          <Badge x={badgeX} y={badgeY(yCor)} n={3} />
        </g>

        <g data-s="4">
          {words.map((_, i) => <Arrow pts={[[x(i) + L.cw / 2, yCor + CH + 1], [x(i) + L.cw / 2, yDisc - 3]]} tone="green" />)}
          <rect class="f-fill-paper" x={L.x0} y={yDisc} width={right - L.x0} height={BH} rx="7" />
          <rect class="f-thin" x={L.x0} y={yDisc} width={right - L.x0} height={BH} rx="7" fill="none" />
          <text class="f-small" x={(L.x0 + right) / 2} y={yDisc + 24} text-anchor="middle">{L.narrow ? t.discN : t.disc}</text>
          <Badge x={badgeX} y={badgeY(yDisc, true)} n={4} />
          {words.map((_, i) => <Arrow pts={[[x(i) + L.cw / 2, yDisc + BH + 1], [x(i) + L.cw / 2, yLab - 3]]} tone="red" />)}
          {rowLabel(3, yLab)}
          {replaced.map((r, i) => cell(i, yLab, 'f-fill-red', 'f-red', L.narrow ? (r ? t.repN : t.origN) : (r ? t.rep : t.orig), { bold: r, mono: false, w: r ? 2.4 : undefined }))}
          <NewMark x={L.x0 - 4} y={yLab - 4} w={right - L.x0 + 8} h={CH + 8} at="br" label={L.narrow ? t.newLabN : t.newLab} />
        </g>

        <g data-s="5">
          {(L.narrow ? t.lossN : t.loss).map((line, li) => <text class="f-small" x={(L.narrow ? L.x0 + 24 : L.x0) + (line.startsWith('  ') ? 14 : 0)} y={yLoss + li * 17}><Sub label={line.trim()} /></text>)}
          <Badge x={badgeX} y={yLoss - 4} n={5} />
        </g>
        <Legend x={L.legend[0]} y={L.legend[1]} step={L.step} rows={L.rows} />
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
