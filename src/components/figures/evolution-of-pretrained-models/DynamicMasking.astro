---
import Figure from '../Figure.astro';
import { mulberry32 } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One sentence over eight epochs. Static: two masks drawn once (the data copied twice), each reused four times.
// Dynamic: a new mask every time the sentence is read. Two of ten positions per mask, so the cells are visible.
const words = ['the', 'cat', 'sat', 'on', 'the', 'warm', 'mat', 'by', 'the', 'door'];
const n = words.length, k = 2, epochs = 8, copies = 2;
const rand = mulberry32(16);
const drawMask = () => {
  const pick = new Set<number>();
  while (pick.size !== k) pick.add(Math.floor(rand() * n));
  return pick;
};
const staticMasks = Array.from({ length: copies }, drawMask);
const staticRows = Array.from({ length: epochs }, (_, e) => staticMasks[e % copies]);
const dynamicRows = Array.from({ length: epochs }, drawMask);
const key = (m: Set<number>) => [...m].sort((a, b) => a - b).join(',');
const stats = (rows: Set<number>[]) => ({ distinct: new Set(rows.map(key)).size, ever: new Set(rows.flatMap((m) => [...m])).size });
const sStat = stats(staticRows), dStat = stats(dynamicRows);
const quoted = [sStat.distinct, sStat.ever, dStat.distinct, dStat.ever].join();
if (quoted !== '2,4,8,8') throw new Error(`DynamicMasking: numbers drifted from the caption (${quoted})`);
const t = ru
  ? { epoch: 'эпоха', st: 'статическое: 2 маски, каждая 4 раза', dy: 'динамическое: новая маска каждую эпоху',
      stN: 'статическое маскирование', dyN: 'динамическое маскирование',
      sum: (s: { distinct: number; ever: number }) => `различных масок: ${s.distinct} · под маской хоть раз: ${s.ever} из ${n}` }
  : { epoch: 'epoch', st: 'static: 2 masks, each used 4 times', dy: 'dynamic: a new mask every epoch',
      stN: 'static masking', dyN: 'dynamic masking',
      sum: (s: { distinct: number; ever: number }) => `distinct masks: ${s.distinct} · positions ever masked: ${s.ever} of ${n}` };
const panels = [
  { title: t.st, titleN: t.stN, rows: staticRows, stat: sStat, tags: staticRows.map((_, e) => (e % copies === 0 ? 'A' : 'B')) },
  { title: t.dy, titleN: t.dyN, rows: dynamicRows, stat: dStat, tags: undefined as string[] | undefined },
];
const id = 'static-vs-dynamic-masking';
const RH = 21, GAP = 2;
interface Place { x: number; y: number }
const layouts = [
  { cls: 'fig-wide fig-bp-640', W: 760, H: 258, places: [{ x: 66, y: 22 }, { x: 424, y: 22 }] as Place[], narrow: false, CW: 30, tx: [66, 424] },
  { cls: 'fig-narrow fig-bp-640', W: 360, H: 548, places: [{ x: 44, y: 22 }, { x: 44, y: 312 }] as Place[], narrow: true, CW: 28, tx: [4, 4] },
];
---

<Figure
  id={id}
  title={ru ? 'Статическое и динамическое маскирование одного предложения' : 'Static and dynamic masking of one sentence'}
  caption={ru
    ? `Одно предложение из ${n} токенов, прочитанное ${epochs} раз; закрашены позиции, выбранные для предсказания (здесь ${k} из ${n}, чтобы клетки были видны; на практике 15%). Слева статическая схема: маски выбраны один раз при подготовке данных, данные скопированы ${copies} раза, и каждая маска (A или B) повторяется 4 раза — так же, как 10 копий на 40 эпохах у BERT. Справа динамическая: маска выбирается заново при каждом чтении. За те же ${epochs} эпох статическая схема показывает модели ${sStat.distinct} разных задачи и ${sStat.ever} позиции из ${n}, динамическая — ${dStat.distinct} разных задач и ${dStat.ever} позиций.`
    : `One sentence of ${n} tokens read ${epochs} times; shaded cells are the positions selected for prediction (${k} of ${n} here so that the cells are visible; 15% in practice). Left, static masking: the masks are drawn once when the data are prepared, the data are copied ${copies} times, and each mask (A or B) recurs 4 times, as BERT's 10 copies did over 40 epochs. Right, dynamic masking: a new mask is drawn every time the sentence is read. Over the same ${epochs} epochs the static scheme shows the model ${sStat.distinct} different tasks and ${sStat.ever} of the ${n} positions, the dynamic one ${dStat.distinct} different tasks and ${dStat.ever} positions.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Маски одного предложения по эпохам' : 'Masks of one sentence, epoch by epoch'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? `Две сетки ${epochs} на ${n}: строки — эпохи, столбцы — токены. В статической сетке чередуются две одинаковые маски, под маской побывали ${sStat.ever} позиции. В динамической каждая строка своя, под маской побывали ${dStat.ever} позиций.`
        : `Two grids of ${epochs} by ${n}: rows are epochs, columns are tokens. In the static grid two masks alternate and ${sStat.ever} positions are ever masked. In the dynamic grid every row is different and ${dStat.ever} positions are ever masked.`}</desc>
      {panels.map((P, pi) => {
        const { x, y } = L.places[pi];
        const CW = L.CW, panelW = n * (CW + GAP) - GAP, tx = L.tx[pi];
        const gy = y + 40;
        return (
          <g>
            <text class="f-small" x={tx} y={y} style="font-weight: 650">{L.narrow ? P.titleN : P.title}</text>
            {words.map((w, j) => <text class="f-small f-t-muted" x={x + j * (CW + GAP) + CW / 2} y={gy - 9} text-anchor="middle" font-family="var(--mono)">{w}</text>)}
            {P.rows.map((m, e) => (
              <g>
                {(pi === 0 || L.narrow) && <text class="f-small f-t-muted" x={x - 8} y={gy + e * RH + 15} text-anchor="end">{e + 1}</text>}
                {words.map((_, j) => (
                  <rect class={m.has(j) ? 'f-fill-blue' : 'f-fill-paper'} x={x + j * (CW + GAP)} y={gy + e * RH} width={CW} height={RH - 3} rx="3" style={m.has(j) ? 'fill-opacity: 0.55' : undefined} />
                ))}
                {words.map((_, j) => (
                  <rect class={`f-thin ${m.has(j) ? 'f-blue' : 'f-muted'}`} x={x + j * (CW + GAP)} y={gy + e * RH} width={CW} height={RH - 3} rx="3" fill="none" style={m.has(j) ? undefined : 'stroke-opacity: 0.35'} />
                ))}
                {P.tags && <text class="f-small f-t-muted" x={x + panelW + 6} y={gy + e * RH + 14}>{P.tags[e]}</text>}
              </g>
            ))}
            {(pi === 0 || L.narrow) && <text class="f-small f-t-muted" x={x - 8} y={gy - 9} text-anchor="end">{t.epoch}</text>}
            <text class="f-small" x={tx} y={gy + epochs * RH + 18}>{t.sum(P.stat)}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
