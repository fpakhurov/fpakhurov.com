---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Which part of the recipe each model changed against its parent: 2 = the main change, 1 = a smaller one, 0 = kept.
type Level = 0 | 1 | 2;
interface Cell { lv: Level; en: string[]; ru: string[] }
interface Row { name: string; from: [string, string]; cells: Cell[] }
const axes = ru
  ? ['архитектура', 'цель', 'процедура', 'данные', 'размер', 'реализация']
  : ['architecture', 'objective', 'procedure', 'data', 'size', 'implementation'];
const rows: Row[] = [
  { name: 'RoBERTa', from: ['vs BERT', 'от BERT'], cells: [
    { lv: 0, en: ['as in BERT'], ru: ['как у BERT'] },
    { lv: 1, en: ['NSP dropped'], ru: ['без NSP'] },
    { lv: 2, en: ['dynamic masks,', '8K batches,', 'more steps'], ru: ['динам. маски,', 'батч 8K,', 'больше шагов'] },
    { lv: 2, en: ['16 → 160 GB'], ru: ['16 → 160 ГБ'] },
    { lv: 0, en: ['BERT-large'], ru: ['BERT-large'] },
    { lv: 0, en: ['—'], ru: ['—'] },
  ] },
  { name: 'ELECTRA', from: ['vs BERT', 'от BERT'], cells: [
    { lv: 1, en: ['+ generator,', 'for pretraining'], ru: ['+ генератор', 'для предобуч.'] },
    { lv: 2, en: ['replaced-token', 'detection'], ru: ['обнаружение', 'заменённых', 'токенов'] },
    { lv: 1, en: ['G and D trained', 'jointly'], ru: ['G и D обучаются', 'совместно'] },
    { lv: 0, en: ['BERT’s data'], ru: ['данные BERT'] },
    { lv: 0, en: ['BERT sizes'], ru: ['размеры BERT'] },
    { lv: 0, en: ['—'], ru: ['—'] },
  ] },
  { name: 'GPT-2', from: ['vs GPT', 'от GPT'], cells: [
    { lv: 1, en: ['pre-norm,', '1,024 context'], ru: ['pre-norm,', 'контекст 1024'] },
    { lv: 0, en: ['next token'], ru: ['след. токен'] },
    { lv: 1, en: ['batch 512'], ru: ['батч 512'] },
    { lv: 2, en: ['WebText,', '40 GB'], ru: ['WebText,', '40 ГБ'] },
    { lv: 2, en: ['117 M → 1.5 B'], ru: ['117 млн →', '1.5 млрд'] },
    { lv: 0, en: ['—'], ru: ['—'] },
  ] },
  { name: 'ModernBERT', from: ['vs BERT', 'от BERT'], cells: [
    { lv: 2, en: ['RoPE, GeGLU,', 'local + global'], ru: ['RoPE, GeGLU,', 'локал. + глоб.'] },
    { lv: 1, en: ['MLM at 30 %,', 'no NSP'], ru: ['MLM 30%,', 'без NSP'] },
    { lv: 1, en: ['new optimizer,', '8K context'], ru: ['новый оптим.,', 'контекст 8K'] },
    { lv: 2, en: ['2 T tokens,', 'with code'], ru: ['2 трлн токенов,', 'с кодом'] },
    { lv: 0, en: ['149 M / 395 M'], ru: ['149 / 395 млн'] },
    { lv: 2, en: ['unpadding,', 'FlashAttention'], ru: ['без паддинга,', 'FlashAttention'] },
  ] },
];
if (rows.some((r) => r.cells.length !== axes.length || r.cells.some((c) => c.en.length > 3 || c.ru.length > 3))) throw new Error('ChangeMap: one cell per axis, at most three lines each');
// Wide cells are 106 units wide; at about 6.5 units per character a line holds 15 characters.
for (const r of rows) for (const c of r.cells) for (const line of ru ? c.ru : c.en) {
  if (line.length > 15) throw new Error(`ChangeMap: cell text too long for its box (${line})`);
}
const main = rows.map((r) => r.cells.filter((c) => c.lv === 2).length).join();
if (main !== '2,1,2,3') throw new Error(`ChangeMap: the main changes drifted from the note (${main})`);
const t = ru
  ? { key: [['главное изменение', 2], ['меньшее изменение', 1], ['без изменений', 0]] as [string, Level][], kept: 'без изменений' }
  : { key: [['main change', 2], ['smaller change', 1], ['kept', 0]] as [string, Level][], kept: 'kept' };
const cellCls = (lv: Level) => (lv === 2 ? 'f-fill-amber' : lv === 1 ? 'f-fill-amber' : 'f-fill-paper');
const cellStyle = (lv: Level) => (lv === 1 ? 'fill-opacity: 0.07' : undefined);
const strokeCls = (lv: Level) => (lv === 0 ? 'f-thin f-muted' : lv === 1 ? 'f-thin f-amber f-dash' : 'f-thin f-amber');
const id = 'pretrained-change-map';
// Wide: a grid, models down, kinds of change across.
const LX = 116, CW = 106, Y0 = 40, RH = 64;
const wideH = Y0 + rows.length * RH + 36;
// Narrow: one block per model listing what changed, then what was kept.
const LH = 18;
const blocks = rows.map((r) => ({
  r,
  changed: r.cells.map((c, k) => ({ c, k })).filter(({ c }) => c.lv > 0),
  kept: r.cells.map((c, k) => ({ c, k })).filter(({ c }) => c.lv === 0).map(({ k }) => axes[k]),
}));
let yy = 24;
const narrowPos = blocks.map((b) => {
  const top = yy;
  yy += 22 + b.changed.length * LH + LH + 14;
  return top;
});
const narrowH = yy + 10;
for (const b of blocks) for (const { c, k } of b.changed) {
  const line = `${axes[k]}: ${(ru ? c.ru : c.en).join(' ')}`;
  if (line.length * 6.5 + 26 > 352) throw new Error(`ChangeMap: narrow line too long (${line})`);
}
for (const b of blocks) {
  const line = `${t.kept}: ${b.kept.join(', ')}`;
  if (line.length * 6.5 + 26 > 352) throw new Error(`ChangeMap: narrow line too long (${line})`);
}
---

<Figure
  id={id}
  title={ru ? 'Что меняла каждая модель' : 'What each model changed'}
  caption={ru
    ? 'Строки — модели этой заметки, столбцы — части рецепта предобучения. Сплошная янтарная рамка — главное изменение по сравнению с исходной моделью (для GPT-2 это GPT, для остальных BERT), пунктирная — меньшее, серая — без изменений. RoBERTa не трогает архитектуру; ELECTRA меняет прежде всего цель; GPT-2 — данные и размер; ModernBERT — архитектуру, данные и реализацию. Цифры: объём текста, размер батча в последовательностях, число параметров, число токенов предобучения.'
    : 'Rows are the models of this note, columns the parts of the pretraining recipe. A solid amber outline marks the main change against the parent model (GPT for GPT-2, BERT for the others), a dashed one a smaller change, a grey one a part that was kept. RoBERTa leaves the architecture alone; ELECTRA changes mainly the objective; GPT-2 the data and the size; ModernBERT the architecture, the data and the implementation. Numbers are text volume, batch size in sequences, parameter counts and pretraining tokens.'}
>
  <svg class="fig-wide fig-bp-640" viewBox={`0 0 760 ${wideH}`} role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{ru ? 'Таблица изменений: четыре модели, шесть частей рецепта' : 'A grid of changes: four models, six parts of the recipe'}</title>
    <desc id={`${id}-w-d`}>{rows.map((r) => `${r.name}: ${r.cells.map((c, k) => `${axes[k]} ${c.lv === 2 ? (ru ? 'главное' : 'main') : c.lv === 1 ? (ru ? 'меньшее' : 'smaller') : (ru ? 'без изменений' : 'kept')} (${(ru ? c.ru : c.en).join(' ')})`).join('; ')}`).join('. ')}.</desc>
    {axes.map((a, k) => <text class="f-small f-t-muted" x={LX + k * CW + CW / 2} y={Y0 - 12} text-anchor="middle" style="font-weight: 650">{a}</text>)}
    {rows.map((r, i) => {
      const y = Y0 + i * RH;
      return (
        <g>
          <text class="f-label" x="6" y={y + RH / 2 - 2} style="font-weight: 650">{r.name}</text>
          <text class="f-small f-t-muted" x="6" y={y + RH / 2 + 15}>{ru ? r.from[1] : r.from[0]}</text>
          {r.cells.map((c, k) => {
            const x = LX + k * CW;
            const lines = ru ? c.ru : c.en;
            const ty = y + RH / 2 + 4.5 - (lines.length - 1) * 7.5;
            return (
              <g>
                <rect class={cellCls(c.lv)} style={cellStyle(c.lv)} x={x + 3} y={y + 4} width={CW - 6} height={RH - 8} rx="7" />
                <rect class={strokeCls(c.lv)} x={x + 3} y={y + 4} width={CW - 6} height={RH - 8} rx="7" fill="none" style={c.lv === 2 ? 'stroke-width: 1.8' : undefined} />
                {lines.map((line, li) => <text class={`f-small${c.lv === 0 ? ' f-t-muted' : ''}`} x={x + CW / 2} y={ty + li * 15} text-anchor="middle">{line}</text>)}
              </g>
            );
          })}
        </g>
      );
    })}
    {t.key.map(([label, lv], j) => {
      const x = LX + j * 190, y = wideH - 14;
      return (
        <g>
          <rect class={cellCls(lv)} style={cellStyle(lv)} x={x} y={y - 11} width="22" height="14" rx="4" />
          <rect class={strokeCls(lv)} x={x} y={y - 11} width="22" height="14" rx="4" fill="none" style={lv === 2 ? 'stroke-width: 1.8' : undefined} />
          <text class="f-small" x={x + 30} y={y}>{label}</text>
        </g>
      );
    })}
  </svg>

  <svg class="fig-narrow fig-bp-640" viewBox={`0 0 360 ${narrowH}`} role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{ru ? 'Что меняла каждая модель' : 'What each model changed'}</title>
    <desc id={`${id}-n-d`}>{blocks.map((b) => `${b.r.name}: ${b.changed.map(({ c, k }) => `${axes[k]} (${(ru ? c.ru : c.en).join(' ')})`).join(', ')}; ${t.kept}: ${b.kept.join(', ')}`).join('. ')}.</desc>
    {blocks.map((b, i) => {
      const top = narrowPos[i];
      return (
        <g>
          <text class="f-label" x="4" y={top} style="font-weight: 650">{b.r.name}<tspan class="f-t-muted" dx="8" style="font-weight: 400; font-size: 12.5px; fill: var(--muted)">{ru ? b.r.from[1] : b.r.from[0]}</tspan></text>
          {b.changed.map(({ c, k }, j) => {
            const y = top + 22 + j * LH;
            return (
              <g>
                <rect class={cellCls(c.lv)} style={cellStyle(c.lv)} x="4" y={y - 10} width="16" height="12" rx="3" />
                <rect class={strokeCls(c.lv)} x="4" y={y - 10} width="16" height="12" rx="3" fill="none" />
                <text class="f-small" x="26" y={y}><tspan style="font-weight: 650">{axes[k]}:</tspan> {(ru ? c.ru : c.en).join(' ')}</text>
              </g>
            );
          })}
          <text class="f-small f-t-muted" x="26" y={top + 22 + b.changed.length * LH}>{t.kept}: {b.kept.join(', ')}</text>
        </g>
      );
    })}
    {t.key.slice(0, 2).map(([label, lv], j) => {
      const x = 4 + j * 170, y = narrowH - 6;
      return (
        <g>
          <rect class={cellCls(lv)} style={cellStyle(lv)} x={x} y={y - 10} width="16" height="12" rx="3" />
          <rect class={strokeCls(lv)} x={x} y={y - 10} width="16" height="12" rx="3" fill="none" />
          <text class="f-small" x={x + 22} y={y}>{label}</text>
        </g>
      );
    })}
  </svg>
</Figure>
