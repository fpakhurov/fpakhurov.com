---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Zero-shot LAMBADA perplexity of the four WebText models (Radford et al., 2019, Table 3) against parameter count;
// the previous best result on the benchmark was 99.8. Both axes are logarithmic.
const pts = [
  { n: 117e6, ppl: 35.13, lab: '117 M', labRu: '117 млн' },
  { n: 345e6, ppl: 15.60, lab: '345 M', labRu: '345 млн' },
  { n: 762e6, ppl: 10.87, lab: '762 M', labRu: '762 млн' },
  { n: 1542e6, ppl: 8.63, lab: '1.5 B', labRu: '1.5 млрд' },
];
const sota = 99.8;
const ratioN = pts[3].n / pts[0].n, ratioP = pts[0].ppl / pts[3].ppl;
if (ratioN.toFixed(1) !== '13.2' || ratioP.toFixed(1) !== '4.1') throw new Error(`Gpt2Scale: ratios drifted from the caption (${ratioN.toFixed(1)}, ${ratioP.toFixed(1)})`);
// Decimal points in both languages, as in the note's prose and formulas.
const fmtN = (v: number) => v.toFixed(2);
const sotaTxt = '99.8';
const t = ru
  ? { x: 'параметры (логарифмическая шкала)', y: 'перплексия', sota: `лучший результат до GPT-2: ${sotaTxt}`, sotaN: `прежний рекорд: ${sotaTxt}` }
  : { x: 'parameters (log scale)', y: 'perplexity', sota: `best result before GPT-2: ${sotaTxt}`, sotaN: `previous best: ${sotaTxt}` };
const id = 'gpt2-lambada-scale';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 330, x0: 70, x1: 570, y0: 20, y1: 260, narrow: false },
  { cls: 'fig-narrow', W: 360, H: 320, x0: 52, x1: 340, y0: 20, y1: 250, narrow: true },
];
const yTicks = [5, 10, 20, 50, 100];
---

<Figure
  id={id}
  title={ru ? 'GPT-2: перплексия на LAMBADA в режиме zero-shot и размер модели' : 'GPT-2: zero-shot LAMBADA perplexity against model size'}
  caption={ru
    ? `Четыре модели, обученные на WebText с одной и той же процедурой, оценены на LAMBADA без дообучения (предсказать последнее слово фрагмента, для которого нужен широкий контекст); обе оси логарифмические. Перплексия падает с ${fmtN(pts[0].ppl)} у модели на 117 млн параметров до ${fmtN(pts[3].ppl)} у модели на 1.5 млрд: рост числа параметров в ${ratioN.toFixed(1)} раза снижает её в ${ratioP.toFixed(1)} раза. Пунктир — лучший результат, опубликованный до GPT-2 (${sotaTxt}), полученный другой моделью по другому протоколу; это ориентир, а не сравнение в одинаковых условиях.`
    : `Four models trained on WebText with the same procedure, evaluated on LAMBADA without fine-tuning (predict the last word of a passage that needs broad context); both axes are logarithmic. Perplexity falls from ${fmtN(pts[0].ppl)} for the 117 M model to ${fmtN(pts[3].ppl)} for the 1.5 B model: ${ratioN.toFixed(1)} times the parameters, ${ratioP.toFixed(1)} times lower perplexity. The dashed line is the best result published before GPT-2 (${sotaTxt}), obtained by a different model under a different protocol; it is a reference point, not a like-for-like comparison.`}
>
  {layouts.map((L) => {
    const sx = scale([Math.log10(8e7), Math.log10(2.2e9)], [L.x0, L.x1]);
    const sy = scale([Math.log10(4), Math.log10(150)], [L.y1, L.y0]);
    const P = pts.map((p) => [sx(Math.log10(p.n)), sy(Math.log10(p.ppl))] as [number, number]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Перплексия падает с ростом модели' : 'Perplexity falls as the model grows'}</title>
        <desc id={`${id}-${L.W}-d`}>{pts.map((p) => `${ru ? p.labRu : p.lab}: ${fmtN(p.ppl)}`).join('; ')}. {t.sota}.</desc>
        {yTicks.map((v) => <g><path class="f-grid" d={`M ${L.x0} ${sy(Math.log10(v))} H ${L.x1}`} /><text class="f-small f-t-muted" x={L.x0 - 8} y={sy(Math.log10(v)) + 4} text-anchor="end">{v}</text></g>)}
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {pts.map((p, i) => <text class="f-small f-t-muted" x={P[i][0]} y={L.y1 + 18} text-anchor="middle">{ru ? p.labRu : p.lab}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 40} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x="4" y={L.y0 - 6}>{t.y}</text>
        <path class="f-line f-muted f-dash" d={`M ${L.x0} ${sy(Math.log10(sota))} H ${L.x1}`} />
        <text class="f-small f-t-muted f-halo" x={L.x1 - 4} y={sy(Math.log10(sota)) - 7} text-anchor="end">{L.narrow ? t.sotaN : t.sota}</text>
        <path class="f-line f-blue" d={polyline(P)} />
        {P.map(([a, b]) => <circle cx={a.toFixed(1)} cy={b.toFixed(1)} r="4.5" class="f-solid-blue" style="stroke: var(--paper); stroke-width: 2" />)}
        {P.map(([a, b], i) => <text class="f-small f-halo" x={a + 9} y={b - 9}>{fmtN(pts[i].ppl)}</text>)}
      </svg>
    );
  })}
</Figure>
