---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? "Оценка пересечения меняется" : "The estimated overlap changes";
const caption = ru ? "Статистики отдельных столбцов дают оценку 60 строк. После сбора совместных частот оценка совпадает с фактическими 180 строками." : "Single-column statistics estimate 60 rows. After collecting joint values, the estimate matches the observed 180 rows.";
const desc = ru ? "Оценка при независимости равна 60. Фактическое число и оценка с многомерной статистикой равны 180." : "The independent estimate is 60. The actual count and the estimate after multivariate statistics are both 180.";
const bars = [
  { label: ru ? 'Оценка до' : 'Estimate before', count: 60, color: 'f-fill-amber' },
  { label: ru ? 'Факт' : 'Actual', count: 180, color: 'f-fill-blue' },
  { label: ru ? 'Оценка после' : 'Estimate after', count: 180, color: 'f-fill-green' },
];
const scale = 1.45;
---
<Figure id="db-estimate-bars" title={title} caption={caption}>
  <svg viewBox="0 0 340 201" role="img" aria-labelledby="db-estimate-bars-title db-estimate-bars-desc" style="max-width: 550px; margin-inline: auto">
    <title id="db-estimate-bars-title">{title}</title>
    <desc id="db-estimate-bars-desc">{desc}</desc>
    {bars.map(({ label, count, color }, index) => (
      <g transform={`translate(0 ${index * 59})`}>
        <text class="f-label" x="23" y="25">{label}</text>
        <rect class={color} x="23" y="33" width={count * scale} height="23" rx="4" />
        <text class="f-label" x={31 + count * scale} y="50">{count}</text>
      </g>
    ))}
  </svg>
</Figure>
