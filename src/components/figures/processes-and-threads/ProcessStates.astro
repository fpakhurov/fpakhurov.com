---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The five process states and the events that move a process between them.
type Tone = 'soft' | 'green' | 'blue' | 'amber' | 'red';
const fill: Record<Tone, string> = { soft: 'f-box-soft', green: 'f-fill-green', blue: 'f-fill-blue', amber: 'f-fill-amber', red: 'f-fill-red' };
const stroke: Record<Tone, string> = { soft: 'f-muted', green: 'f-green', blue: 'f-blue', amber: 'f-amber', red: 'f-red' };
const names = ru
  ? { new: 'новый', ready: 'готов', running: 'выполняется', blocked: 'заблокирован', zombie: 'зомби' }
  : { new: 'new', ready: 'ready', running: 'running', blocked: 'blocked', zombie: 'zombie' };
const tones: Record<keyof typeof names, Tone> = { new: 'soft', ready: 'green', running: 'blue', blocked: 'amber', zombie: 'red' };

interface Edge { d: string; label: string; at: [number, number]; anchor: 'start' | 'middle' | 'end'; tone?: string; dashed?: boolean }
interface Layout { cls: string; W: number; H: number; boxes: Record<keyof typeof names, [number, number, number, number]>; edges: Edge[]; notes: { x: number; y: number; text: string; anchor: 'start' | 'middle' | 'end' }[] }

const wide: Layout = {
  cls: 'fig-wide', W: 760, H: 236,
  boxes: { new: [16, 40, 104, 44], ready: [200, 40, 124, 44], running: [440, 40, 124, 44], blocked: [320, 160, 124, 44], zombie: [640, 40, 104, 44] },
  edges: [
    { d: 'M 120 62 H 197', label: ru ? 'создан' : 'admitted', at: [159, 54], anchor: 'middle' },
    { d: 'M 262 40 V 18 H 502 V 37', label: ru ? 'выбран планировщиком' : 'scheduled', at: [382, 12], anchor: 'middle', tone: 'blue' },
    { d: 'M 440 62 H 327', label: ru ? 'по таймеру' : 'timer interrupt', at: [383, 55], anchor: 'middle' },
    { d: 'M 502 84 V 182 H 447', label: ru ? 'ждёт ввода-вывода или потомка' : 'waits for I/O or a child', at: [510, 140], anchor: 'start', tone: 'amber' },
    { d: 'M 320 182 H 262 V 87', label: ru ? 'событие произошло' : 'the event occurs', at: [254, 140], anchor: 'end', tone: 'green' },
    { d: 'M 564 62 H 637', label: 'exit()', at: [601, 54], anchor: 'middle', tone: 'red' },
  ],
  notes: [{ x: 744, y: 104, text: ru ? 'до wait() родителя' : 'until the parent waits', anchor: 'end' }],
};
const narrow: Layout = {
  cls: 'fig-narrow seq-narrow', W: 360, H: 420,
  boxes: { new: [118, 8, 124, 40], ready: [118, 88, 124, 40], running: [118, 208, 124, 40], blocked: [242, 270, 112, 40], zombie: [118, 330, 124, 40] },
  edges: [
    { d: 'M 180 48 V 85', label: ru ? 'создан' : 'admitted', at: [188, 72], anchor: 'start' },
    { d: 'M 205 128 V 205', label: ru ? 'выбран' : 'scheduled', at: [212, 172], anchor: 'start', tone: 'blue' },
    { d: 'M 150 208 V 131', label: ru ? 'по таймеру' : 'timer', at: [142, 172], anchor: 'end' },
    { d: 'M 242 228 H 298 V 267', label: ru ? 'ждёт' : 'waits', at: [250, 220], anchor: 'start', tone: 'amber' },
    { d: 'M 334 270 V 108 H 245', label: ru ? 'событие' : 'event', at: [340, 150], anchor: 'end', tone: 'green' },
    { d: 'M 180 248 V 327', label: 'exit()', at: [188, 292], anchor: 'start', tone: 'red' },
  ],
  notes: [{ x: 180, y: 396, text: ru ? 'до wait() родителя' : 'until the parent waits', anchor: 'middle' }],
};
const id = 'processes-states';
const desc = ru
  ? 'Пять состояний процесса: новый, готов, выполняется, заблокирован, зомби. Новый процесс становится готовым; планировщик переводит готовый в выполняемый; прерывание таймера возвращает выполняемый в готовые; ожидание ввода-вывода или потомка переводит его в заблокированные, а наступившее событие — обратно в готовые; exit делает процесс зомби, пока родитель не вызовет wait.'
  : 'Five process states: new, ready, running, blocked and zombie. A new process becomes ready; the scheduler moves a ready process to running; a timer interrupt moves it back to ready; waiting for I/O or a child moves it to blocked, and the event moves it back to ready; exit makes it a zombie until the parent calls wait.';
---

<Figure
  id={id}
  title={ru ? 'Состояния процесса' : 'The states of a process'}
  caption={ru
    ? 'Процесс выполняется, только когда планировщик выбрал его (синяя стрелка). Таймер возвращает его в очередь готовых, ожидание события делает его заблокированным, а прерывание, сообщающее о событии, снова делает готовым: заблокированный процесс никогда не переходит сразу к выполнению. После exit от процесса остаётся только запись с кодом завершения, пока родитель не заберёт её вызовом wait.'
    : 'A process runs only when the scheduler picks it (blue arrow). The timer sends it back to the ready queue, waiting for an event blocks it, and the interrupt that reports the event makes it ready again: a blocked process never goes straight to running. After exit only an entry with the exit status remains, until the parent collects it with wait.'}
>
  {[wide, narrow].map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Диаграмма состояний процесса' : 'State diagram of a process'}</title>
      <desc id={`${id}-${L.W}-d`}>{desc}</desc>
      {L.edges.map((e) => (
        <g>
          <path class={`f-line ${e.tone ? `f-${e.tone}` : ''}`} d={e.d} marker-end={`url(#f-arrow${e.tone ? `-${e.tone}` : ''})`} />
          <text class={`f-small f-halo ${e.tone ? `f-t-${e.tone}` : 'f-t-muted'}`} x={e.at[0]} y={e.at[1]} text-anchor={e.anchor}>{e.label}</text>
        </g>
      ))}
      {(Object.keys(names) as (keyof typeof names)[]).map((k) => {
        const [x, y, w, h] = L.boxes[k];
        return (
          <g>
            <rect class={fill[tones[k]]} x={x} y={y} width={w} height={h} rx="7" />
            <rect class={`f-thin ${stroke[tones[k]]}`} x={x} y={y} width={w} height={h} rx="7" fill="none" />
            <text class="f-label" x={x + w / 2} y={y + h / 2 + 5} text-anchor="middle">{names[k]}</text>
          </g>
        );
      })}
      {L.notes.map((n) => <text class="f-small f-t-muted" x={n.x} y={n.y} text-anchor={n.anchor}>{n.text}</text>)}
    </svg>
  ))}
</Figure>
