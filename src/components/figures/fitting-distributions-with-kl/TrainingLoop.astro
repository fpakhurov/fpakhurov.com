---
import Figure from '../Figure.astro';

// One training iteration of the notebook's KL fit, drawn as a cycle.
// Each box: a heading and up to two content lines (kind: math, code or text).
type Line = { text: string; kind: 'math' | 'code' | 'text' };
type Box = { key: string; head: string; tone: 'blue' | 'red' | 'ink' | 'amber'; lines: Line[] };

const boxes: Box[] = [
  { key: 'params', head: 'Trainable parameters', tone: 'blue', lines: [{ text: 'μ,  s = log σ', kind: 'math' }, { text: 'requires_grad=True', kind: 'code' }] },
  { key: 'model', head: 'Distribution', tone: 'blue', lines: [{ text: 'Q = 𝒩(μ, σ²)', kind: 'math' }, { text: 'σ = exp(s)', kind: 'math' }] },
  { key: 'dens', head: 'Densities at xᵢ', tone: 'ink', lines: [{ text: 'q(xᵢ) and p(xᵢ)', kind: 'math' }] },
  { key: 'loss', head: 'Loss', tone: 'amber', lines: [{ text: 'mean(log p(xᵢ) − log q(xᵢ))', kind: 'code' }, { text: '≈ KL(P ‖ Q)', kind: 'math' }] },
  { key: 'grad', head: 'Gradients', tone: 'ink', lines: [{ text: '∂loss/∂μ,  ∂loss/∂s', kind: 'math' }] },
  { key: 'step', head: 'optim.step()', tone: 'blue', lines: [{ text: 'μ ← μ − η·∂loss/∂μ', kind: 'math' }, { text: 's ← s − η·∂loss/∂s', kind: 'math' }] },
];

const headClass = { blue: 'f-title f-t-blue', red: 'f-title f-t-red', ink: 'f-title', amber: 'f-title f-t-amber' };
const lineClass = (l: Line) => (l.kind === 'math' ? 'f-math f-upright' : l.kind === 'code' ? 'f-small' : 'f-label');

// ---- Wide layout: two rows of three boxes, the cycle runs clockwise. ----
const BW = 178;
const BH = 92;
const GAP = 86;
const X0 = 20;
const colX = [X0, X0 + BW + GAP, X0 + 2 * (BW + GAP)];
const rowY = [78, 268];
// Order on the cycle: top row left→right, bottom row right→left.
const wideBoxes = [
  { ...boxes[0], x: colX[0], y: rowY[0] },
  { ...boxes[1], x: colX[1], y: rowY[0] },
  { ...boxes[2], x: colX[2], y: rowY[0] },
  { ...boxes[3], x: colX[2], y: rowY[1] },
  { ...boxes[4], x: colX[1], y: rowY[1] },
  { ...boxes[5], x: colX[0], y: rowY[1] },
];
const WW = colX[2] + BW + 20;
const WH = rowY[1] + BH + 22;
const midTop = rowY[0] + BH / 2;
const midBot = rowY[1] + BH / 2;

// ---- Narrow layout: one column, the return arrow runs up the left side. ----
const NBW = 252;
const NBH = 88;
const NGAP = 52;
const NX = 82;
const NY0 = 74;
const narrowBoxes = boxes.map((b, i) => ({ ...b, x: NX, y: NY0 + i * (NBH + NGAP) }));
const NW = 360;
const NH = NY0 + 6 * NBH + 5 * NGAP + 20;
const narrowArrowLabels = ['build Q', 'Q.log_prob(xᵢ)', 'kl_loss(px, qx)', 'loss.backward()', 'gradients'];

const id = 'fitting-distributions-with-kl-training-loop';
---

<Figure
  id={id}
  title="One iteration of the fitting loop"
  caption="The optimizer is told which tensors to train (those created with requires_grad=True): here μ and s = log σ, so that σ = exp(s) stays positive. Each iteration rebuilds Q from the current parameters, scores the fixed samples xᵢ ~ P, computes the sample estimate of KL(P‖Q), back-propagates it and takes one step. Adam, used in the notebook, steps along the anti-gradient with per-coordinate step sizes; the update shown is plain SGD."
  origin="illustrative"
  pages="19–20"
>
  <svg class="fig-wide" viewBox={`0 0 ${WW} ${WH}`} role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>The KL training loop as a cycle</title>
    <desc id={`${id}-w-d`}>Six boxes connected clockwise. Trainable parameters mu and s equal to log sigma, with requires_grad true, build the distribution Q equal to a normal with mean mu and variance sigma squared, where sigma is exp of s. Q is evaluated at samples x_i drawn from P, which also come with the true densities p of x_i. The loss is the mean of log p minus log q, an estimate of KL of P from Q. loss.backward gives the gradients of the loss with respect to mu and s. optim.step moves mu and s against the gradient, and the updated parameters feed the next iteration.</desc>

    {wideBoxes.map((b) => (
      <g>
        <rect class="f-box" x={b.x} y={b.y} width={BW} height={BH} rx="10" />
        <text class={headClass[b.tone]} x={b.x + BW / 2} y={b.y + 26} text-anchor="middle">{b.head}</text>
        {b.lines.map((l, j) => (
          <text class={lineClass(l)} x={b.x + BW / 2} y={b.y + (b.lines.length === 1 ? 62 : 52 + j * 24)} text-anchor="middle">{l.text}</text>
        ))}
      </g>
    ))}

    <!-- samples from P enter from above -->
    <text class="f-label f-t-red" x={colX[2] + BW / 2} y="22" text-anchor="middle">fixed samples xᵢ ~ P</text>
    <text class="f-small f-t-red" x={colX[2] + BW / 2} y="40" text-anchor="middle">px = p(xᵢ), known true density</text>
    <path class="f-line f-red" d={`M ${colX[2] + BW / 2} 48 V ${rowY[0] - 4}`} marker-end="url(#f-arrow-red)" />

    <!-- top row arrows -->
    <path class="f-line" d={`M ${colX[0] + BW + 4} ${midTop} H ${colX[1] - 6}`} marker-end="url(#f-arrow)" />
    <text class="f-small" x={colX[0] + BW + GAP / 2} y={midTop - 10} text-anchor="middle">build Q</text>
    <path class="f-line" d={`M ${colX[1] + BW + 4} ${midTop} H ${colX[2] - 6}`} marker-end="url(#f-arrow)" />
    <text class="f-small" x={colX[1] + BW + GAP / 2} y={midTop - 10} text-anchor="middle">log_prob</text>

    <!-- down the right side -->
    <path class="f-line" d={`M ${colX[2] + BW / 2} ${rowY[0] + BH + 4} V ${rowY[1] - 6}`} marker-end="url(#f-arrow)" />
    <text class="f-small" x={colX[2] + BW / 2 - 10} y={(rowY[0] + BH + rowY[1]) / 2 + 4} text-anchor="end">kl_loss(px, qx)</text>

    <!-- bottom row arrows, right to left -->
    <path class="f-line f-amber" d={`M ${colX[2] - 4} ${midBot} H ${colX[1] + BW + 6}`} marker-end="url(#f-arrow)" />
    <text class="f-small" x={colX[1] + BW + GAP / 2} y={midBot - 22} text-anchor="middle">loss.</text>
    <text class="f-small" x={colX[1] + BW + GAP / 2} y={midBot - 8} text-anchor="middle">backward()</text>
    <path class="f-line" d={`M ${colX[1] - 4} ${midBot} H ${colX[0] + BW + 6}`} marker-end="url(#f-arrow)" />
    <text class="f-small" x={colX[0] + BW + GAP / 2} y={midBot - 10} text-anchor="middle">.grad</text>

    <!-- back up the left side -->
    <path class="f-line f-blue" d={`M ${colX[0] + BW / 2} ${rowY[1] - 4} V ${rowY[0] + BH + 6}`} marker-end="url(#f-arrow-blue)" />
    <text class="f-small f-t-blue" x={colX[0] + BW / 2 + 10} y={(rowY[0] + BH + rowY[1]) / 2 - 4}>updated μ, s:</text>
    <text class="f-small f-t-blue" x={colX[0] + BW / 2 + 10} y={(rowY[0] + BH + rowY[1]) / 2 + 12}>next iteration</text>

    <!-- centre note -->
    <text class="f-note" x={colX[1] + BW / 2} y={(rowY[0] + BH + rowY[1]) / 2 + 4} text-anchor="middle">↻ repeat; zero_grad() first</text>

    <!-- what the optimizer was told -->
    <text class="f-small f-t-blue" x={colX[0]} y="22">optim.Adam([train_mu, log_std])</text>
    <text class="f-small f-t-muted" x={colX[0]} y="40">“optimize these tensors by gradient”</text>
    <path class="f-thin f-blue" d={`M ${colX[0] + 60} 48 Q ${colX[0] + 52} 62 ${colX[0] + 60} ${rowY[0] - 4}`} marker-end="url(#f-arrow-blue)" />
  </svg>

  <svg class="fig-narrow" viewBox={`0 0 ${NW} ${NH}`} role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>The KL training loop as a cycle</title>
    <desc id={`${id}-n-d`}>Six boxes stacked vertically, top to bottom: trainable parameters mu and s equal to log sigma, the distribution Q equal to a normal with mean mu and variance sigma squared with sigma equal to exp of s, the densities q and p at the samples x_i drawn from P, the loss equal to the mean of log p minus log q, the gradients of the loss with respect to mu and s, and optim.step which moves mu and s against the gradient. An arrow on the left returns from the last box to the first: the updated parameters feed the next iteration.</desc>

    <text class="f-small f-t-blue" x={NX} y="22">optim.Adam([train_mu, log_std])</text>
    <text class="f-small f-t-muted" x={NX} y="40">optimize these tensors by gradient</text>
    <path class="f-thin f-blue" d={`M ${NX + 40} 48 V ${NY0 - 5}`} marker-end="url(#f-arrow-blue)" />

    {narrowBoxes.map((b, i) => (
      <g>
        <rect class="f-box" x={b.x} y={b.y} width={NBW} height={NBH} rx="10" />
        <text class={headClass[b.tone]} x={b.x + NBW / 2} y={b.y + 25} text-anchor="middle">{b.head}</text>
        {b.lines.map((l, j) => (
          <text class={lineClass(l)} x={b.x + NBW / 2} y={b.y + (b.lines.length === 1 ? 60 : 50 + j * 24)} text-anchor="middle">{l.text}</text>
        ))}
        {i < 5 && (
          <g>
            <path class={`f-line${i === 3 ? ' f-amber' : ''}`} d={`M ${b.x + NBW / 2} ${b.y + NBH + 4} V ${b.y + NBH + NGAP - 6}`} marker-end="url(#f-arrow)" />
            <text class="f-small" x={b.x + NBW / 2 + 10} y={b.y + NBH + NGAP / 2 + 5}>{narrowArrowLabels[i]}</text>
          </g>
        )}
      </g>
    ))}

    <!-- samples from P enter the densities box from the right -->
    <path class="f-line f-red" d={`M ${NW - 6} ${narrowBoxes[2].y + 10} V ${narrowBoxes[2].y + NBH / 2} H ${NX + NBW + 6}`} marker-end="url(#f-arrow-red)" />
    <text class="f-small f-t-red" x={NW - 6} y={narrowBoxes[2].y - 4} text-anchor="end">xᵢ ~ P, p(xᵢ)</text>

    <!-- return arrow -->
    <path class="f-line f-blue" d={`M ${NX - 4} ${narrowBoxes[5].y + NBH / 2} H ${NX - 34} V ${narrowBoxes[0].y + NBH / 2} H ${NX - 6}`} marker-end="url(#f-arrow-blue)" />
    <text class="f-small f-t-blue" transform={`translate(${NX - 44} ${(narrowBoxes[0].y + narrowBoxes[5].y + NBH) / 2}) rotate(-90)`} text-anchor="middle">updated μ, s → next iteration</text>
  </svg>
</Figure>
