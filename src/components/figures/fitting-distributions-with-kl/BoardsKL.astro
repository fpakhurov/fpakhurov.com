---
import Figure from '../Figure.astro';
import { scale } from '../geometry';

// The two tic-tac-toe boards from the entropy note: A = (1/2, 1/2), B = (9/10, 1/10) over {O, X}.
const A = [0.5, 0.5];
const Bd = [0.9, 0.1];
const H = (p: number[]) => -p.reduce((s, v) => s + v * Math.log2(v), 0);
const KL = (p: number[], q: number[]) => p.reduce((s, v, i) => s + v * Math.log2(v / q[i]), 0);
const hA = H(A);
const hB = H(Bd);
const klAB = KL(A, Bd);
const klBA = KL(Bd, A);

const W = 520;
const HT = 300;
const base = 220;
const top = 70;
const sy = scale([0, 1], [base, top]);
const bw = 42;
const boards = [
  { name: 'Board A', p: A, h: hA, x0: 40, cls: 'f-solid-red' },
  { name: 'Board B', p: Bd, h: hB, x0: W - 40 - 2 * bw - 16, cls: 'f-solid-red' },
];
const labels = ['O', 'X'];
const fmtP = ['1/2', '1/2', '9/10', '1/10'];
const id = 'fitting-distributions-with-kl-boards';
const aRight = boards[0].x0 + 2 * bw + 16;
const bLeft = boards[1].x0;
---

<Figure
  id={id}
  title="The two boards compared with KL"
  caption={`The two boards from the start of the note as distributions over {O, X}. Entropies are ${hA.toFixed(0)} bit and ${hB.toFixed(3)} bits; the KL divergence between them is ${klAB.toFixed(3)} bits one way and ${klBA.toFixed(3)} bits the other. Both boards give every outcome positive probability, so both directions are finite. Each arrow runs from the distribution treated as the truth (the first argument) to the one treated as the model.`}
  origin="illustrative"
  pages="19"
>
  <svg class="fig-compact" viewBox={`0 0 ${W} ${HT}`} role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>KL between the balanced and the skewed board</title>
    <desc id={`${id}-d`}>Two bar charts. Board A has bars of height one half for O and for X, entropy 1 bit. Board B has bars of 9/10 for O and 1/10 for X, entropy 0.469 bits. A curved arrow from A to B is labelled KL of A from B equals 0.737 bits; a curved arrow back from B to A is labelled KL of B from A equals 0.531 bits.</desc>

    {boards.map((b, k) => (
      <g>
        <text class="f-title" x={b.x0 + bw + 8} y="24" text-anchor="middle">{b.name}</text>
        <path class="f-axis" d={`M ${b.x0 - 8} ${base} H ${b.x0 + 2 * bw + 24}`} />
        {b.p.map((v, i) => (
          <g>
            <rect class={i === 0 ? 'f-fill-red' : 'f-solid-red'} x={b.x0 + i * (bw + 16)} y={sy(v)} width={bw} height={base - sy(v)} stroke="var(--fig-red)" stroke-width="1.2" />
            <text class="f-label" x={b.x0 + i * (bw + 16) + bw / 2} y={sy(v) - 8} text-anchor="middle">{fmtP[2 * k + i]}</text>
            <text class="f-label" x={b.x0 + i * (bw + 16) + bw / 2} y={base + 20} text-anchor="middle">{labels[i]}</text>
          </g>
        ))}
        <text class="f-label" x={b.x0 + bw + 8} y={base + 50} text-anchor="middle">H = {k === 0 ? '1 bit' : `${b.h.toFixed(3)} bits`}</text>
      </g>
    ))}

    <path class="f-line f-blue" d={`M ${aRight + 6} ${sy(0.75)} Q ${W / 2} ${sy(1.08)} ${bLeft - 10} ${sy(0.75)}`} marker-end="url(#f-arrow-blue)" />
    <text class="f-label f-t-blue" x={W / 2} y={sy(0.96) - 10} text-anchor="middle">KL(A‖B) = {klAB.toFixed(3)}</text>
    <path class="f-line f-green" d={`M ${bLeft - 6} ${sy(0.3)} Q ${W / 2} ${sy(0.12)} ${aRight + 10} ${sy(0.3)}`} marker-end="url(#f-arrow-green)" />
    <text class="f-label f-t-green" x={W / 2} y={sy(0.02)} text-anchor="middle">KL(B‖A) = {klBA.toFixed(3)}</text>
    <text class="f-small" x={W / 2} y={sy(0.55)} text-anchor="middle">bits; not symmetric</text>
  </svg>
</Figure>
