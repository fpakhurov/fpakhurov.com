---
import Figure from '../Figure.astro';
import { plot, area, scale, gaussian, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Target P = N(3, 1). Model Q = N(μ, σ²) with σ = exp(s), as in the notebook's log-std parameterization.
// Closed form: KL(P‖Q) = log(σ_Q/σ_P) + (σ_P² + (μ_P − μ)²) / (2σ_Q²) − 1/2   (nats).
const muP = 3;
const sigP = 1;
const kl = (mu: number, s: number) => {
  const v = Math.exp(2 * s);
  return s - Math.log(sigP) + (sigP ** 2 + (muP - mu) ** 2) / (2 * v) - 0.5;
};

// Plain gradient descent on (μ, s): ∂KL/∂μ = −(μ_P − μ)/σ², ∂KL/∂s = 1 − (σ_P² + (μ_P − μ)²)/σ².
const lr = 0.01;
const steps = 1600;
const traj: { mu: number; sigma: number; kl: number }[] = [];
let mu = -2;
let s = Math.log(0.5);
for (let t = 0; t <= steps; t += 1) {
  traj.push({ mu, sigma: Math.exp(s), kl: kl(mu, s) });
  const v = Math.exp(2 * s);
  const gMu = -(muP - mu) / v;
  const gS = 1 - (sigP ** 2 + (muP - mu) ** 2) / v;
  mu -= lr * gMu;
  s -= lr * gS;
}

const snaps = [0, 5, 50, 400, 800, 1100, 1600];
const opacity = (i: number) => 0.45 + (0.55 * i) / (snaps.length - 1);

// --- shared geometry; the x scale depends on the variant's width ---
const L = 58;
const T = 30;
const B = 268;
const xr: [number, number] = [-6, 10];
const yMax = 0.85;
const sy = scale([0, yMax], [B, T]);
const yTicks = [0, 0.2, 0.4, 0.6, 0.8];

const start = traj[0];
const startPeak = gaussian(start.mu, start.mu, start.sigma);
const wide = traj[50];
const last = traj[steps];

// --- loss panel (log scale) ---
const LT = 340;
const LB = 470;
const lyr: [number, number] = [-3, 2]; // log10 KL from 0.001 to 100
const syL = scale(lyr, [LB, LT]);
const lossTicks = [-3, -2, -1, 0, 1, 2];
const H = LB + 46;
const f2 = (v: number) => v.toFixed(2);
const logTick = (v: number) => (v === 0 ? '1' : `10${v < 0 ? '⁻' : ''}${['', '¹', '²', '³'][Math.abs(v)]}`);

const variants = [
  { cls: 'fig-wide', W: 640, narrow: false, xTicks: [-6, -4, -2, 0, 2, 4, 6, 8, 10], iterTicks: [0, 400, 800, 1200, 1600] },
  { cls: 'fig-narrow', W: 390, narrow: true, xTicks: [-4, 0, 4, 8], iterTicks: [0, 800, 1600] },
].map((v) => {
  const R = v.W - 20;
  const sx = scale(xr, [L, R]);
  const sxL = scale([0, steps], [L, R]);
  return {
    ...v,
    R,
    sx,
    sxL,
    pPath: plot((x) => gaussian(x, muP, sigP), xr[0], xr[1], sx, sy, 260),
    pArea: area((x) => gaussian(x, muP, sigP), xr[0], xr[1], sx, sy, 260),
    qPaths: snaps.map((t) => plot((x) => gaussian(x, traj[t].mu, traj[t].sigma), xr[0], xr[1], sx, sy, 260)),
    lossPath: polyline(traj.map((pt, t) => [sxL(t), syL(Math.max(Math.log10(pt.kl), lyr[0]))] as const).filter((_, t) => t < 60 || t % 5 === 0)),
  };
});
const id = 'fitting-distributions-with-kl-trajectory';
---

<Figure
  id={id}
  title={ru ? "Подгонка Q = 𝒩(μ, σ²) к P = 𝒩(3, 1) градиентным спуском по KL(P‖Q)" : "Fitting Q = 𝒩(μ, σ²) to P = 𝒩(3, 1) by gradient descent on KL(P‖Q)"}
  caption={ru ? `Q стартует с 𝒩(−2, 0.5²) и показано на итерациях ${snaps.join(', ')} (от бледных тонких кривых к сплошным жирным). Поскольку у P есть масса там, где узкое Q почти равно нулю, первые шаги в основном раздувают σ (до ${f2(wide.sigma)} к итерации 50, тогда как μ лишь медленно сдвигается от −2 до ${f2(wide.mu).replace('-', '−')}); затем μ смещается к 3, а σ сжимается до 1. После ${steps} шагов μ = ${f2(last.mu)}, σ = ${f2(last.sigma)}. Нижняя панель: KL(P‖Q) в натах в логарифмическом масштабе. Расчёт: KL между гауссианами в замкнутом виде, обычный градиентный спуск по параметрам (μ, log σ) с шагом обучения ${lr}.` : `Q starts at 𝒩(−2, 0.5²) and is drawn at iterations ${snaps.join(', ')} (from faint and thin to solid and bold). Because P has mass where the narrow Q is almost zero, the first steps mostly inflate σ (to ${f2(wide.sigma)} by iteration 50, while μ only creeps from −2 to ${f2(wide.mu).replace('-', '−')}); then μ slides towards 3 and σ shrinks to 1. After ${steps} steps μ = ${f2(last.mu)}, σ = ${f2(last.sigma)}. Lower panel: KL(P‖Q) in nats on a log scale. Computed with the closed-form Gaussian KL and plain gradient descent, learning rate ${lr}, on the parameters (μ, log σ).`}
>
  {variants.map((v) => (
    <svg class={v.cls} viewBox={`0 0 ${v.W} ${H}`} role="img" aria-labelledby={`${id}-${v.cls}-t ${id}-${v.cls}-d`}>
      <title id={`${id}-${v.cls}-t`}>{ru ? "Траектория Q при минимизации KL к гауссовской цели" : "Trajectory of Q while minimizing KL to a Gaussian target"}</title>
      <desc id={`${id}-${v.cls}-d`}>{ru ? "Сверху: красная целевая плотность P — нормальное распределение со средним 3 и стандартным отклонением 1 — и семь синих кривых Q на возрастающих итерациях, от бледных и тонких к сплошным и жирным. Первая Q — высокий узкий горб в минус 2. Следующие становятся очень широкими и плоскими, затем смещаются вправо и сужаются, пока последняя, самая жирная кривая почти не совпадает с P. Снизу: KL-дивергенция в логарифмическом масштабе падает примерно с 51 ната почти до нуля за 1600 итераций, с длинным плато около 1.5 ната, пока Q широкое." : "Top: the red target density P, a normal with mean 3 and standard deviation 1, and seven blue curves for Q at increasing iterations, drawn from faint and thin to solid and bold. The first Q is a tall narrow bump at minus 2. The next ones become very wide and flat, then move right and narrow down until the last, boldest curve almost coincides with P. Bottom: the KL divergence on a log scale drops from about 51 nats to almost zero over 1600 iterations, with a long plateau around 1.5 nats while Q is wide."}</desc>

      {yTicks.map((t) => <line class="f-grid" x1={L} x2={v.R} y1={sy(t)} y2={sy(t)} />)}
      {yTicks.map((t) => <text class="f-note" x={L - 10} y={sy(t) + 5} text-anchor="end">{t}</text>)}
      {v.xTicks.map((t) => <text class="f-note" x={v.sx(t)} y={B + 20} text-anchor="middle">{t < 0 ? `−${-t}` : t}</text>)}
      <path class="f-axis" d={`M ${L} ${B} H ${v.R}`} />
      <text class="f-math" x={v.R} y={B + 42} text-anchor="end">x</text>
      <text class="f-label" transform={`translate(${L - 44} ${(T + B) / 2}) rotate(-90)`} text-anchor="middle">{ru ? "плотность" : "density"}</text>

      <path class="f-fill-red" d={v.pArea} />
      <path class="f-line f-red f-bold" d={v.pPath} />
      {v.qPaths.map((d, i) => <path class={`f-line f-blue${i === snaps.length - 1 ? ' f-bold' : ''}`} d={d} stroke-opacity={opacity(i)} />)}

      <!-- labels -->
      {v.narrow ? (
        <g>
          <text class="f-label f-t-red" x={v.sx(4.6)} y={sy(0.2)}>P</text>
          <text class="f-small f-t-blue f-halo" x={v.sx(-1.2)} y={sy(startPeak) + 4}>{ru ? "старт: 𝒩(−2, 0.5²)" : "start: 𝒩(−2, 0.5²)"}</text>
          <text class="f-small f-t-blue" x={v.sx(-5.85)} y={sy(0.42)}>{ru ? "итер. 50:" : "iter. 50:"}</text>
          <text class="f-small f-t-blue" x={v.sx(-5.85)} y={sy(0.42) + 16}>σ = {f2(wide.sigma)}</text>
          <path class="f-thin f-blue" d={`M ${v.sx(-4.6)} ${sy(0.42) + 24} Q ${v.sx(-4.6)} ${sy(0.16)} ${v.sx(-4.4)} ${sy(gaussian(-4.4, wide.mu, wide.sigma)) - 6}`} marker-end="url(#f-arrow-blue)" />
          <text class="f-small f-t-blue" x={v.R} y={sy(0.66)} text-anchor="end">{ru ? 'итер.' : 'iter.'} {steps}:</text>
          <text class="f-small f-t-blue" x={v.R} y={sy(0.66) + 16} text-anchor="end">μ = {f2(last.mu)}</text>
          <text class="f-small f-t-blue" x={v.R} y={sy(0.66) + 32} text-anchor="end">σ = {f2(last.sigma)}</text>
          <path class="f-thin f-blue" d={`M ${v.sx(7.4)} ${sy(0.66) + 40} Q ${v.sx(5.2)} ${sy(0.45)} ${v.sx(3.35)} ${sy(gaussian(3.35, last.mu, last.sigma)) - 6}`} marker-end="url(#f-arrow-blue)" />
        </g>
      ) : (
        <g>
          <text class="f-label f-t-red" x={v.sx(4.55)} y={sy(0.2)}>P = 𝒩(3, 1)</text>
          <text class="f-label f-t-blue f-halo" x={v.sx(-1.25)} y={sy(startPeak) + 4}>{ru ? "старт: 𝒩(−2, 0.5²)" : "start: 𝒩(−2, 0.5²)"}</text>
          <text class="f-small f-t-blue" x={v.sx(-5.85)} y={sy(0.4)}>{ru ? "итерация 50:" : "iteration 50:"}</text>
          <text class="f-small f-t-blue" x={v.sx(-5.85)} y={sy(0.4) + 16}>{ru ? "очень широкое," : "very wide,"}</text>
          <text class="f-small f-t-blue" x={v.sx(-5.85)} y={sy(0.4) + 32}>σ = {f2(wide.sigma)}</text>
          <path class="f-thin f-blue" d={`M ${v.sx(-4.9)} ${sy(0.4) + 40} Q ${v.sx(-4.75)} ${sy(0.16)} ${v.sx(-4.4)} ${sy(gaussian(-4.4, wide.mu, wide.sigma)) - 6}`} marker-end="url(#f-arrow-blue)" />
          <text class="f-small f-t-blue" x={v.sx(7.6)} y={sy(0.6)} text-anchor="middle">{ru ? 'итерация' : 'iteration'} {steps}:</text>
          <text class="f-small f-t-blue" x={v.sx(7.6)} y={sy(0.6) + 16} text-anchor="middle">μ = {f2(last.mu)}, σ = {f2(last.sigma)}</text>
          <path class="f-thin f-blue" d={`M ${v.sx(6.7)} ${sy(0.6) + 24} Q ${v.sx(5)} ${sy(0.5)} ${v.sx(3.25)} ${sy(gaussian(3.25, last.mu, last.sigma)) - 6}`} marker-end="url(#f-arrow-blue)" />
        </g>
      )}

      <!-- loss panel -->
      {lossTicks.map((t) => <line class="f-grid" x1={L} x2={v.R} y1={syL(t)} y2={syL(t)} />)}
      {lossTicks.map((t) => <text class="f-note" x={L - 10} y={syL(t) + 5} text-anchor="end">{logTick(t)}</text>)}
      {v.iterTicks.map((t) => <text class="f-note" x={v.sxL(t)} y={LB + 20} text-anchor="middle">{t}</text>)}
      <path class="f-axis" d={`M ${L} ${LB} H ${v.R}`} />
      <text class="f-label" x={v.R} y={LB + 40} text-anchor="end">{ru ? "итерация" : "iteration"}</text>
      <text class="f-label" x={L} y={LT - 12}>{ru ? "KL(P‖Q), наты" : "KL(P‖Q), nats"}</text>
      <path class="f-line f-amber" d={v.lossPath} />
      {snaps.map((t, i) => <circle class="f-solid-blue" cx={v.sxL(t)} cy={syL(Math.max(Math.log10(traj[t].kl), lyr[0]))} r="4" fill-opacity={opacity(i)} />)}
      {v.narrow ? (
        <g>
          <text class="f-small" x={v.sxL(330)} y={syL(0.18) - 26}>{ru ? "плато ≈ 1.5:" : "plateau ≈ 1.5:"}</text>
          <text class="f-small" x={v.sxL(330)} y={syL(0.18) - 10}>{ru ? "Q широкое, смещено" : "Q wide, off-centre"}</text>
        </g>
      ) : (
        <text class="f-small" x={v.sxL(420)} y={syL(0.18) - 10}>{ru ? "плато ≈ 1.5: Q широкое и ещё смещено" : "plateau ≈ 1.5: Q wide and still off-centre"}</text>
      )}
    </svg>
  ))}
</Figure>
