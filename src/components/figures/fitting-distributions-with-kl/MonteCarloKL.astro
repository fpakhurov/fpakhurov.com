---
import Figure from '../Figure.astro';
import { plot, scale, gaussian, normals } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// P = N(3, 1), Q = N(1.5, 1.5²). Samples x_i ~ P; the notebook's estimator averages log p(x_i) − log q(x_i).
const muP = 3;
const sP = 1;
const muQ = 1.5;
const sQ = 1.5;
const p = (x: number) => gaussian(x, muP, sP);
const q = (x: number) => gaussian(x, muQ, sQ);
const logRatio = (x: number) => Math.log(p(x) / q(x));
const N = 40;
const xs = normals(N, 7).map((z) => muP + sP * z);
const estimate = xs.reduce((s, x) => s + logRatio(x), 0) / N;
const exact = Math.log(sQ / sP) + (sP ** 2 + (muP - muQ) ** 2) / (2 * sQ ** 2) - 0.5;

const L = 58;
const xr: [number, number] = [-2.5, 7];
// top panel: densities
const T1 = 24;
const B1 = 190;
const sy1 = scale([0, 0.42], [B1, T1]);
// bottom panel: log ratio
const T2 = 250;
const B2 = 420;
const lr: [number, number] = [-2.5, 2.5];
const sy2 = scale(lr, [B2, T2]);
// x where log p = log q (the curve crosses zero)
const crossings: number[] = [];
for (let i = 0; i < 2000; i += 1) {
  const a = xr[0] + ((xr[1] - xr[0]) * i) / 2000;
  const b = xr[0] + ((xr[1] - xr[0]) * (i + 1)) / 2000;
  if (Math.sign(logRatio(a)) !== Math.sign(logRatio(b))) crossings.push((a + b) / 2);
}
const H = B2 + 50;
const ticks = [-2, 0, 2, 4, 6];
const tickText = (t: number) => (t < 0 ? `−${-t}` : `${t}`);
// Wide variant for the full column, narrow variant (viewBox ≈ 380) for small screens.
const variants = [
  { cls: 'fig-wide', W: 600, narrow: false },
  { cls: 'fig-narrow', W: 380, narrow: true },
].map((v) => {
  const R = v.W - 16;
  const sx = scale(xr, [L, R]);
  return {
    ...v,
    R,
    sx,
    pPath: plot(p, xr[0], xr[1], sx, sy1, 200),
    qPath: plot(q, xr[0], xr[1], sx, sy1, 200),
    ratioPath: plot((x) => {
      const r = logRatio(x);
      return r < lr[0] ? Number.NaN : r;
    }, xr[0], xr[1], sx, sy2, 260),
  };
});
const id = 'fitting-distributions-with-kl-monte-carlo';
---

<Figure
  id={id}
  title={ru ? "Выборочная оценка KL(P‖Q), используемая в ноутбуке" : "The sample estimate of KL(P‖Q) used in the notebook"}
  caption={ru ? `Сверху: P = 𝒩(3, 1) — красным, Q = 𝒩(1.5, 1.5²) — синим, ${N} сэмплов xᵢ ~ P — штрихами. Снизу: log p(x) − log q(x) с отмеченными сэмплами. Эта разность положительна примерно между ${crossings[0].toFixed(1)} и ${crossings[1].toFixed(1)}, где Q недооценивает плотность P, и сэмплы попадают в основном туда. Их среднее, ${estimate.toFixed(3)} ната, — шумная оценка (N = ${N}) точного значения KL(P‖Q) = ${exact.toFixed(3)} ната; ноутбук использует log₂ и поэтому выдаёт биты (значение в натах, делённое на ln 2).` : `Top: P = 𝒩(3, 1) in red, Q = 𝒩(1.5, 1.5²) in blue, and ${N} samples xᵢ ~ P as ticks. Bottom: log p(x) − log q(x) with the samples marked. It is positive between about ${crossings[0].toFixed(1)} and ${crossings[1].toFixed(1)}, where Q underestimates P's density, and the samples land mostly there. Their mean, ${estimate.toFixed(3)} nats, is a noisy estimate (N = ${N}) of the exact KL(P‖Q) = ${exact.toFixed(3)} nats; the notebook uses log₂ and so reports bits (divide by ln 2).`}
>
  {variants.map((v) => (
    <svg class={v.cls} viewBox={`0 0 ${v.W} ${H}`} role="img" aria-labelledby={`${id}-${v.cls}-t ${id}-${v.cls}-d`}>
      <title id={`${id}-${v.cls}-t`}>{ru ? "Оценка KL-дивергенции методом Монте-Карло" : "Monte Carlo estimate of the KL divergence"}</title>
      <desc id={`${id}-${v.cls}-d`}>{ru ? "Верхний график: красная гауссиана P с центром в 3 и более широкая синяя гауссиана Q с центром в 1.5; сорок коротких красных штрихов вдоль оси отмечают сэмплы из P. Нижний график: кривая log p минус log q, положительная примерно между 2 и 6.4 и отрицательная по обе стороны от этого промежутка. Точки на кривой в позициях сэмплов лежат в основном в положительной области; их среднее, 0.72 ната, оценивает точную KL-дивергенцию, равную 0.63 ната." : "Upper plot: a red Gaussian P centred at 3 and a wider blue Gaussian Q centred at 1.5, with forty short red ticks along the axis for samples drawn from P. Lower plot: the curve log p minus log q, which is positive between about 2 and 6.4 and negative on both sides. Dots on the curve at the sample positions are mostly in the positive region; their average, 0.72 nats, estimates the exact KL divergence of 0.63 nats."}</desc>

      <!-- densities -->
      <path class="f-axis" d={`M ${L} ${B1} H ${v.R}`} />
      <path class="f-fill-red" d={`${v.pPath} L ${v.sx(xr[1])} ${sy1(0)} L ${v.sx(xr[0])} ${sy1(0)} Z`} />
      <path class="f-line f-red f-bold" d={v.pPath} />
      <path class="f-line f-blue f-bold" d={v.qPath} />
      {xs.map((x) => <line class="f-thin f-red" x1={v.sx(x)} x2={v.sx(x)} y1={B1 - 9} y2={B1 + 1} />)}
      <text class="f-label f-t-red" x={v.sx(3.75)} y={sy1(0.37)}>p(x)</text>
      <text class="f-label f-t-blue" x={v.sx(-0.4)} y={sy1(0.25)} text-anchor="end">q(x)</text>
      <text class="f-small f-t-red" x={v.sx(v.narrow ? 5.2 : 5.4)} y={sy1(0.12)}>xᵢ ~ P</text>
      <path class="f-thin f-red" d={`M ${v.sx(5.6)} ${sy1(0.1)} Q ${v.sx(5.2)} ${sy1(0.04)} ${v.sx(4.75)} ${B1 - 12}`} marker-end="url(#f-arrow-red)" />
      {ticks.map((t) => <text class="f-note" x={v.sx(t)} y={B1 + 20} text-anchor="middle">{tickText(t)}</text>)}

      <!-- log ratio -->
      {[-2, -1, 0, 1, 2].map((r) => <line class="f-grid" x1={L} x2={v.R} y1={sy2(r)} y2={sy2(r)} />)}
      {[-2, -1, 0, 1, 2].map((r) => <text class="f-note" x={L - 10} y={sy2(r) + 5} text-anchor="end">{tickText(r)}</text>)}
      <path class="f-axis" d={`M ${L} ${sy2(0)} H ${v.R}`} />
      {crossings.map((c) => <line class="f-thin f-muted f-dash" x1={v.sx(c)} x2={v.sx(c)} y1={B1 + 28} y2={B2} />)}
      <path class="f-line f-amber f-bold" d={v.ratioPath} />
      {xs.map((x) => <circle class="f-solid-red" cx={v.sx(x)} cy={sy2(Math.max(logRatio(x), lr[0]))} r="3.2" fill-opacity="0.7" />)}
      <line class="f-line f-green f-dash" x1={L} x2={v.R} y1={sy2(estimate)} y2={sy2(estimate)} />
      <text class="f-label f-t-green f-halo" x={L + 6} y={sy2(estimate) - 8}>{v.narrow ? (ru ? `среднее = ${estimate.toFixed(2)}` : `mean = ${estimate.toFixed(2)}`) : (ru ? `среднее = ${estimate.toFixed(2)} (точно ${exact.toFixed(2)})` : `mean = ${estimate.toFixed(2)} (exact ${exact.toFixed(2)})`)}</text>
      {v.narrow && <text class="f-small f-t-green f-halo" x={L + 6} y={sy2(estimate) + 20}>{ru ? 'точная KL = ' : 'exact KL = '}{exact.toFixed(2)}</text>}
      <text class="f-small f-t-amber" x={v.sx(4.2)} y={sy2(2.42)} text-anchor="middle">{v.narrow ? (ru ? "Q занижено:" : "Q too low:") : (ru ? "Q недооценивает p:" : "Q underestimates p:")}</text>
      <text class="f-small f-t-amber" x={v.sx(4.2)} y={sy2(2.42) + 16} text-anchor="middle">log p − log q &gt; 0</text>
      <text class="f-small f-t-amber" x={L + 6} y={sy2(-1.55)}>{v.narrow ? (ru ? "Q завышено: < 0" : "Q too high: < 0,") : (ru ? "Q переоценивает: < 0," : "Q overestimates: < 0,")}</text>
      <text class="f-small f-t-amber" x={L + 6} y={sy2(-1.55) + 16}>{v.narrow ? (ru ? "сэмплов мало" : "few samples") : (ru ? "но сэмплов здесь мало" : "but few samples here")}</text>
      <text class="f-label" transform={`translate(${L - 42} ${(T2 + B2) / 2}) rotate(-90)`} text-anchor="middle">log p − log q</text>
      <text class="f-math" x={v.R} y={B2 + 34} text-anchor="end">x</text>
      {ticks.map((t) => <text class="f-note" x={v.sx(t)} y={B2 + 20} text-anchor="middle">{tickText(t)}</text>)}
    </svg>
  ))}
</Figure>
