---
import Figure from '../Figure.astro';
import { plot, area, scale, gaussian, polyline } from '../geometry';

// P: equal mixture of N(−2.5, 0.7²) and N(2.5, 0.7²).
const m = 2.5;
const sd = 0.7;
const p = (x: number) => 0.5 * gaussian(x, -m, sd) + 0.5 * gaussian(x, m, sd);
// Q1 locks onto one mode; Q2 is the moment-matched Gaussian (the best single Gaussian for KL(P‖Q)).
const sdBroad = Math.sqrt(sd * sd + m * m);
const q1 = (x: number) => gaussian(x, m, sd);
const q2 = (x: number) => gaussian(x, 0, sdBroad);

// KL(a‖b) by the trapezoidal rule on [−14, 14], natural log.
function kl(a: (x: number) => number, b: (x: number) => number) {
  const lo = -14;
  const hi = 14;
  const n = 14000;
  const h = (hi - lo) / n;
  let sum = 0;
  for (let i = 0; i <= n; i += 1) {
    const x = lo + i * h;
    const pa = a(x);
    if (pa <= 0) continue;
    const term = pa * Math.log(pa / Math.max(b(x), 1e-300));
    sum += i === 0 || i === n ? term / 2 : term;
  }
  return sum * h;
}
const panels = [
  { key: 'modes', q: q1, title: 'Q misses a mode', fwd: kl(p, q1), rev: kl(q1, p), hot: 'fwd' },
  { key: 'tails', q: q2, title: 'Q spreads mass where P has none', fwd: kl(p, q2), rev: kl(q2, p), hot: 'rev' },
];

const PW = 310;
const PH = 300;
const L = 14;
const R = PW - 12;
const T = 100;
const B = PH - 30;
const xr: [number, number] = [-6.5, 6.5];
const sx = scale(xr, [L, R]);
const sy = scale([0, 0.6], [B, T]);
const pPath = plot(p, xr[0], xr[1], sx, sy, 260);
const missed = area(p, xr[0], 0, sx, sy, 140);

// Region where the broad Q has more mass than P: between q2 and min(p, q2).
function excess(q: (x: number) => number) {
  const n = 260;
  const xs = Array.from({ length: n + 1 }, (_, i) => xr[0] + ((xr[1] - xr[0]) * i) / n);
  const upper = xs.map((x) => [sx(x), sy(q(x))] as const);
  const lower = xs.map((x) => [sx(x), sy(Math.min(p(x), q(x)))] as const).reverse();
  return `${polyline([...upper, ...lower])} Z`;
}
const extra = excess(q2);

const GAP = 30;
const variants = [
  { cls: 'fig-wide', vb: `0 0 ${2 * PW + GAP} ${PH}`, o: [[0, 0], [PW + GAP, 0]] },
  { cls: 'fig-narrow', vb: `0 0 ${PW} ${2 * PH + 16}`, o: [[0, 0], [0, PH + 16]] },
];
const f2 = (v: number) => v.toFixed(2);
const id = 'fitting-distributions-with-kl-direction';
---

<Figure
  id={id}
  title="Which direction penalizes what: missed modes versus extra mass"
  caption={`P (red) is an equal mixture of 𝒩(±${m}, ${sd}²). Left: Q sits on one mode. The missed mode is where P lives and Q is almost zero, so the forward divergence KL(P‖Q) = ${f2(panels[0].fwd)} nats is large, while the reverse KL(Q‖P) = ${f2(panels[0].rev)} ≈ ln 2. Right: Q = 𝒩(0, ${f2(sdBroad)}²) covers both modes (it is the best single Gaussian for KL(P‖Q)), but puts mass between and beyond them where P ≈ 0 (shaded), so KL(Q‖P) = ${f2(panels[1].rev)} is now the larger one and KL(P‖Q) = ${f2(panels[1].fwd)}. All values computed by numerical integration.`}
>
  {variants.map((v) => (
    <svg class={v.cls} viewBox={v.vb} role="img" aria-labelledby={`${id}-${v.cls}-t ${id}-${v.cls}-d`}>
      <title id={`${id}-${v.cls}-t`}>Missed modes versus extra mass</title>
      <desc id={`${id}-${v.cls}-d`}>Two plots of the same red bimodal density P with peaks at minus 2.5 and 2.5. In the first, a narrow blue Q sits only on the right peak; the left peak is shaded and labelled missed mode, and the forward divergence KL of P from Q is about 12 nats while the reverse is about 0.69. In the second, a wide blue Gaussian covers both peaks; the area where Q is above P, in the middle and in the outer tails, is shaded and labelled extra mass, and now the reverse divergence, about 1.54 nats, is larger than the forward one, about 0.62.</desc>

      <defs>
        <marker id={`${id}-${v.cls}-arrow`} viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="9" markerHeight="9" markerUnits="userSpaceOnUse" orient="auto-start-reverse">
          <path d="M 0 0.8 L 9.5 5 L 0 9.2 L 2.6 5 Z" fill="var(--fig-amber)" />
        </marker>
      </defs>

      {panels.map((pn, k) => (
        <g transform={`translate(${v.o[k][0]} ${v.o[k][1]})`}>
          <text class="f-title" x={L} y="20">{pn.title}</text>
          <text class={`f-label${pn.hot === 'fwd' ? ' f-t-amber f-title' : ''}`} x={L} y="46">KL(P‖Q) = {f2(pn.fwd)}</text>
          <text class={`f-label${pn.hot === 'rev' ? ' f-t-amber f-title' : ''}`} x={L} y="68">KL(Q‖P) = {f2(pn.rev)}</text>
          <path class="f-axis" d={`M ${L} ${B} H ${R}`} />
          {pn.key === 'modes' ? <path class="f-fill-amber" d={missed} /> : <path class="f-fill-amber" d={extra} />}
          <path class="f-line f-blue f-bold" d={plot(pn.q, xr[0], xr[1], sx, sy, 260)} />
          <path class="f-line f-red" d={pPath} />
          {[-m, 0, m].map((t) => <text class="f-note" x={sx(t)} y={B + 20} text-anchor="middle">{t < 0 ? `−${-t}` : t}</text>)}
          {pn.key === 'modes' ? (
            <g>
              <text class="f-label f-t-blue" x={sx(m) + 26} y={sy(0.5)}>Q</text>
              <text class="f-label f-t-red" x={sx(-m) + 30} y={sy(0.3)}>P</text>
              <text class="f-small f-t-amber" x={sx(-6.3)} y={sy(0.56)}>missed mode: p &gt; 0, q ≈ 0</text>
              <text class="f-small" x={sx(-6.3)} y={sy(0.56) + 16}>KL(P‖Q) punishes this</text>
              <path class="f-thin f-amber" d={`M ${sx(-4.6)} ${sy(0.56) + 24} Q ${sx(-3.7)} ${sy(0.3)} ${sx(-2.9)} ${sy(0.17)}`} marker-end={`url(#${id}-${v.cls}-arrow)`} />
            </g>
          ) : (
            <g>
              <text class="f-label f-t-blue" x={sx(0.35)} y={sy(0.19)}>Q</text>
              <text class="f-label f-t-red" x={sx(-m) - 34} y={sy(0.28)}>P</text>
              <text class="f-small f-t-amber" x={sx(0)} y={sy(0.56)} text-anchor="middle">extra mass: q &gt; 0, p ≈ 0</text>
              <text class="f-small" x={sx(0)} y={sy(0.56) + 16} text-anchor="middle">KL(Q‖P) punishes this</text>
              <path class="f-thin f-amber" d={`M ${sx(-0.3)} ${sy(0.56) + 24} Q ${sx(-0.6)} ${sy(0.3)} ${sx(-0.1)} ${sy(0.08)}`} marker-end={`url(#${id}-${v.cls}-arrow)`} />
              <path class="f-thin f-amber" d={`M ${sx(2.6)} ${sy(0.56) + 20} Q ${sx(4.9)} ${sy(0.38)} ${sx(4.8)} ${sy(0.04)}`} marker-end={`url(#${id}-${v.cls}-arrow)`} />
            </g>
          )}
        </g>
      ))}
    </svg>
  ))}
</Figure>
