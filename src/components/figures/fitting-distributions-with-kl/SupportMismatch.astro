---
import Figure from '../Figure.astro';
import { plot, area, scale, gaussian } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// P = N(0, 1). Left: Q = Uniform[−a, a] (has holes). Right: Q = N(0, s²) (positive everywhere).
const a = 1.5;
const s = 1.5;
const p = (x: number) => gaussian(x);
const qU = (x: number) => (Math.abs(x) <= a ? 1 / (2 * a) : 0);
const qG = (x: number) => gaussian(x, 0, s);
// Mass of P that falls where the uniform Q is zero.
const erf = (x: number) => {
  // Abramowitz–Stegun 7.1.26, |error| < 1.5e-7
  const t = 1 / (1 + 0.3275911 * Math.abs(x));
  const y = 1 - ((((1.061405429 * t - 1.453152027) * t + 1.421413741) * t - 0.284496736) * t + 0.254829592) * t * Math.exp(-x * x);
  return x >= 0 ? y : -y;
};
const outside = 1 - erf(a / Math.SQRT2);
// Closed-form KL(N(0,1) ‖ N(0,s²)) = log s + 1/(2s²) − 1/2.
const klBlur = Math.log(s) + 1 / (2 * s * s) - 0.5;

const PW = 300;
const PH = 250;
const L = 16;
const R = PW - 14;
const T = 64;
const B = PH - 34;
const xr: [number, number] = [-4, 4];
const sx = scale(xr, [L, R]);
const sy = scale([0, 0.45], [B, T]);
const pPath = plot(p, xr[0], xr[1], sx, sy, 200);
const leftTail = area(p, xr[0], -a, sx, sy, 80);
const rightTail = area(p, a, xr[1], sx, sy, 80);
const uniPath = `M ${sx(xr[0])} ${sy(0)} H ${sx(-a)} V ${sy(qU(0))} H ${sx(a)} V ${sy(0)} H ${sx(xr[1])}`;
const blurPath = plot(qG, xr[0], xr[1], sx, sy, 200);
const blurArea = area(qG, xr[0], xr[1], sx, sy, 200);

const GAP = 30;
const variants = [
  { cls: 'fig-wide', vb: `0 0 ${2 * PW + GAP} ${PH}`, o: [[0, 0], [PW + GAP, 0]] },
  { cls: 'fig-narrow', vb: `0 0 ${PW} ${2 * PH + 16}`, o: [[0, 0], [0, PH + 16]] },
];
const id = 'fitting-distributions-with-kl-support';
---

<Figure
  id={id}
  title={ru ? "Общий носитель: у Q не должно быть дыр там, где живёт P" : "Common support: Q must not have holes where P lives"}
  caption={ru ? `P = 𝒩(0, 1) — красным. Слева: Q равномерно на [−${a}, ${a}]. В закрашенных хвостах сосредоточено ${(outside * 100).toFixed(1)}% массы P, и там p(x) > 0, а q(x) = 0, поэтому подынтегральное выражение p log(p/q) бесконечно и KL(P‖Q) = ∞. Справа: «размытая» гауссиана Q = 𝒩(0, ${s}²) положительна всюду, и KL(P‖Q) = ${klBlur.toFixed(3)} ната.` : `P = 𝒩(0, 1) in red. Left: Q uniform on [−${a}, ${a}]. The shaded tails hold ${(outside * 100).toFixed(1)}% of P's mass, and there p(x) > 0 while q(x) = 0, so the integrand p log(p/q) is infinite and KL(P‖Q) = ∞. Right: a “blurry” Gaussian Q = 𝒩(0, ${s}²) is positive everywhere, and KL(P‖Q) = ${klBlur.toFixed(3)} nats.`}
>
  {variants.map((v) => (
    <svg class={v.cls} viewBox={v.vb} role="img" aria-labelledby={`${id}-${v.cls}-t ${id}-${v.cls}-d`}>
      <title id={`${id}-${v.cls}-t`}>{ru ? "Модель с дырами и размытая модель" : "A model with holes versus a blurry model"}</title>
      <desc id={`${id}-${v.cls}-d`}>{ru ? "Два графика одной и той же красной плотности стандартного нормального распределения P. На первом Q — плоский прямоугольник между минус 1.5 и 1.5 и ноль вне его; хвосты P вне прямоугольника закрашены красным и подписаны «p больше 0, q равно 0», поэтому log p по q бесконечен и KL бесконечна. На втором Q — более широкая синяя гауссиана, всюду положительная, и KL конечна, около 0.128 ната." : "Two plots of the same red standard normal density P. In the first, Q is a flat box between minus 1.5 and 1.5 and zero outside; the tails of P outside the box are shaded red and labelled p greater than 0, q equal to 0, so log p over q is infinite and KL is infinite. In the second, Q is a wider blue Gaussian that is positive everywhere and KL is finite, about 0.128 nats."}</desc>

      <g transform={`translate(${v.o[0][0]} ${v.o[0][1]})`}>
        <text class="f-title" x={L} y="20">{ru ? "Q с дырами" : "Q with holes"}</text>
        <text class="f-label f-t-red" x={L} y="42">KL(P‖Q) = ∞</text>
        <path class="f-axis" d={`M ${L} ${B} H ${R}`} />
        <path class="f-fill-red" d={leftTail} />
        <path class="f-fill-red" d={rightTail} />
        <path class="f-line f-blue f-bold" d={uniPath} />
        <path class="f-line f-red" d={pPath} />
        {[-a, a].map((t) => <text class="f-note" x={sx(t)} y={B + 20} text-anchor="middle">{t > 0 ? `${t}` : `−${a}`}</text>)}
        <text class="f-label f-t-blue" x={sx(-a) + 8} y={sy(qU(0)) - 8}>Q</text>
        <text class="f-label f-t-red" x={sx(0.75)} y={sy(0.41)}>P</text>
        <text class="f-small f-t-red" x={R} y="22" text-anchor="end">p &gt; 0, q = 0</text>
        <text class="f-small f-t-red" x={R} y="40" text-anchor="end">⇒ log p/q = ∞</text>
        <path class="f-thin f-red" d={`M ${R - 26} 48 Q ${R - 10} ${sy(0.12)} ${sx(2.1)} ${sy(0.02) - 2}`} marker-end="url(#f-arrow-red)" />
        <text class="f-small f-t-muted" x={sx(-3.8)} y={sy(0.12)}>q = 0</text>
        <path class="f-thin f-muted" d={`M ${sx(-3.3)} ${sy(0.105)} Q ${sx(-3.2)} ${sy(0.04)} ${sx(-3.1)} ${sy(0) - 5}`} marker-end="url(#f-arrow-muted)" />
      </g>

      <g transform={`translate(${v.o[1][0]} ${v.o[1][1]})`}>
        <text class="f-title" x={L} y="20">{ru ? "«Размытая» гауссиана Q" : "“Blurry” Gaussian Q"}</text>
        <text class="f-label f-t-blue" x={L} y="42">KL(P‖Q) = {klBlur.toFixed(3)} {ru ? 'ната' : 'nats'}</text>
        <path class="f-axis" d={`M ${L} ${B} H ${R}`} />
        <path class="f-fill-blue" d={blurArea} />
        <path class="f-line f-blue f-bold" d={blurPath} />
        <path class="f-line f-red" d={pPath} />
        <text class="f-label f-t-red" x={sx(0.75)} y={sy(0.41)}>P</text>
        <text class="f-small f-t-blue" x={sx(2.0)} y={sy(0.2)}>q &gt; 0</text>
        <text class="f-small f-t-blue" x={sx(2.0)} y={sy(0.2) + 16}>{ru ? "всюду" : "everywhere"}</text>
        <path class="f-thin f-blue" d={`M ${sx(2.9)} ${sy(0.2) + 22} Q ${sx(3.3)} ${sy(0.1)} ${sx(3.2)} ${sy(qG(3.2)) - 5}`} marker-end="url(#f-arrow-blue)" />
        {[-2, 0, 2].map((t) => <text class="f-note" x={sx(t)} y={B + 20} text-anchor="middle">{t < 0 ? `−${-t}` : t}</text>)}
      </g>
    </svg>
  ))}
</Figure>
