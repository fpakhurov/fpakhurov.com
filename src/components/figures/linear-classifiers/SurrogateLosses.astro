---
import Figure from '../Figure.astro';
import { scale, plot } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The 0–1 loss and its surrogates as functions of the margin M. The logistic loss is taken with log base 2,
// so that it equals 1 at M = 0 and bounds the 0–1 loss from above, like the others.
const losses = [
  { key: 'logistic', f: (M: number) => Math.log2(1 + Math.exp(-M)), cls: 'f-line f-blue f-bold', en: 'logistic, log₂(1 + exp(−M))', ru: 'логистическая, log₂(1 + exp(−M))' },
  { key: 'hinge', f: (M: number) => Math.max(0, 1 - M), cls: 'f-line f-red f-bold', en: 'hinge, max(0, 1 − M)', ru: 'кусочно-линейная, max(0, 1 − M)' },
  { key: 'exp', f: (M: number) => Math.exp(-M), cls: 'f-line f-amber f-bold', en: 'exponential, exp(−M)', ru: 'экспоненциальная, exp(−M)' },
  { key: 'sqhinge', f: (M: number) => Math.max(0, 1 - M) ** 2, cls: 'f-line f-green f-bold', en: 'squared hinge, max(0, 1 − M)²', ru: 'квадрат hinge, max(0, 1 − M)²' },
  { key: 'square', f: (M: number) => (1 - M) ** 2, cls: 'f-line f-muted f-dash', en: 'squared error, (1 − M)²', ru: 'квадратичная ошибка, (1 − M)²' },
];
const at = (key: string, M: number) => losses.find((l) => l.key === key)!.f(M);
const r2 = (v: number) => v.toFixed(2);
const quoted = [r2(at('logistic', -1)), r2(at('hinge', -1)), r2(at('exp', -1)), r2(at('sqhinge', -1)), r2(at('logistic', 2)), r2(at('exp', 2)), r2(at('square', 2))];
if (quoted.join(' ') !== '1.89 2.00 2.72 4.00 0.18 0.14 1.00') throw new Error(`SurrogateLosses: quoted values drifted: ${quoted.join(' ')}`);
for (const l of losses) if (Math.abs(l.f(0) - 1) > 1e-12) throw new Error('SurrogateLosses: a surrogate is not 1 at M = 0');
// every surrogate is an upper bound on the 0–1 loss on a grid of margins
for (let M = -3; M <= 3; M += 0.01) for (const l of losses) if (l.f(M) < (M <= 0 ? 1 : 0) - 1e-12) throw new Error('SurrogateLosses: not an upper bound');

const tErr = ru ? 'ошибка, M < 0' : 'error, M < 0';
const tOk = ru ? 'верно, M > 0' : 'correct, M > 0';
const tZero = ru ? '0–1: [M ≤ 0]' : '0–1 loss, [M ≤ 0]';
const xTicks = [-2, -1, 0, 1, 2, 3].map((v) => ({ v, label: v < 0 ? `−${-v}` : String(v) }));
const id = 'linear-classifiers-surrogate-losses';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 340, px: [52, 452] as [number, number], py: [24, 284] as [number, number], lx: 486, ly: 46, dy: 30 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 520, px: [44, 344] as [number, number], py: [20, 268] as [number, number], lx: 14, ly: 340, dy: 30 },
];
---

<Figure
  id={id}
  title={ru ? 'Функция потерь 0–1 и её выпуклые верхние оценки' : 'The 0–1 loss and its convex upper bounds'}
  caption={ru
    ? 'Потери одного примера как функции отступа M = y(⟨w, x⟩ + b). Ступенька — функция потерь 0–1: 1 при ошибке (M ≤ 0), 0 при верном ответе. Все суррогаты равны 1 при M = 0 и лежат не ниже ступеньки. При M = −1 логистическая потеря равна 1.89, кусочно-линейная 2, экспоненциальная 2.72, квадрат кусочно-линейной 4: чем быстрее рост слева, тем сильнее модель реагирует на грубые ошибки и выбросы. Справа кусочно-линейная и её квадрат обращаются в ноль при M ≥ 1, логистическая и экспоненциальная лишь убывают (0.18 и 0.14 при M = 2). Пунктир — квадратичная ошибка регрессии на метках ±1: при M = 2 она снова равна 1 и наказывает уверенно верные ответы.'
    : 'Loss of one example as a function of the margin M = y(⟨w, x⟩ + b). The step is the 0–1 loss: 1 for an error (M ≤ 0), 0 for a correct answer. Every surrogate equals 1 at M = 0 and lies on or above the step. At M = −1 the logistic loss is 1.89, the hinge 2, the exponential 2.72 and the squared hinge 4: the faster a loss grows on the left, the harder the model reacts to gross errors and outliers. On the right the hinge and squared hinge reach zero at M ≥ 1, while the logistic and exponential losses only decay (0.18 and 0.14 at M = 2). The dashed curve is the squared error of regression on ±1 labels: at M = 2 it is back at 1 and punishes confidently correct answers.'}
>
  {layouts.map((L) => {
    const sx = scale([-2, 3], L.px), sy = scale([0, 4], [L.py[1], L.py[0]]);
    const clip = `${id}-${L.sfx}-clip`;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{ru ? 'Суррогатные функции потерь в зависимости от отступа' : 'Surrogate losses against the margin'}</title>
        <desc id={`${id}-${L.sfx}-d`}>{ru
          ? 'Ступенчатая функция 0–1 и пять кривых: логистическая, кусочно-линейная, экспоненциальная, квадрат кусочно-линейной и пунктирная парабола квадратичной ошибки. Все проходят через точку M = 0, потеря 1, и лежат выше ступеньки.'
          : 'A step-shaped 0–1 loss and five curves: logistic, hinge, exponential, squared hinge and the dashed parabola of the squared error. All pass through the point M = 0, loss 1, and lie above the step.'}</desc>
        <defs><clipPath id={clip}><rect x={L.px[0]} y={L.py[0] - 2} width={L.px[1] - L.px[0]} height={L.py[1] - L.py[0] + 4} /></clipPath></defs>
        <rect x={sx(-2)} y={L.py[0]} width={sx(0) - sx(-2)} height={L.py[1] - L.py[0]} class="f-fill-red" style="fill-opacity: .06" />
        <text class="f-small f-t-red" x={sx(-1.95)} y={sy(0.12)}>{tErr}</text>
        <text class="f-small f-t-green" x={sx(0.1)} y={sy(3.75)}>{tOk}</text>
        {[1, 2, 3, 4].map((v) => <path class="f-grid" d={`M ${L.px[0]} ${sy(v)} H ${L.px[1]}`} />)}
        <path class="f-axis" d={`M ${L.px[0]} ${L.py[1]} H ${L.px[1]} M ${sx(0)} ${L.py[0]} V ${L.py[1]}`} />
        {xTicks.map((k) => <text class="f-note" x={sx(k.v)} y={L.py[1] + 18} text-anchor="middle">{k.label}</text>)}
        {[0, 1, 2, 3, 4].map((v) => <text class="f-note" x={L.px[0] - 8} y={sy(v) + 5} text-anchor="end">{v}</text>)}
        <text class="f-small" x={(L.px[0] + L.px[1]) / 2} y={L.py[1] + 40} text-anchor="middle">{ru ? 'отступ M = y(⟨w, x⟩ + b)' : 'margin M = y(⟨w, x⟩ + b)'}</text>
        <g clip-path={`url(#${clip})`}>
          {losses.map((l) => <path class={l.cls} d={plot(l.f, -2, 3, sx, sy, 250)} />)}
          <path class="f-line" style="stroke-width: 2.4" d={`M ${sx(-2)} ${sy(1)} H ${sx(0)} V ${sy(0)} H ${sx(3)}`} />
        </g>
        <circle cx={sx(0)} cy={sy(1)} r="4" class="f-solid-muted" />
        <path class="f-line" style="stroke-width: 2.4" d={`M ${L.lx} ${L.ly - 5} h 26`} />
        <text class="f-small" x={L.lx + 34} y={L.ly}>{tZero}</text>
        {losses.map((l, i) => (
          <g>
            <path class={l.cls} d={`M ${L.lx} ${L.ly + (i + 1) * L.dy - 5} h 26`} />
            <text class="f-small" x={L.lx + 34} y={L.ly + (i + 1) * L.dy}>{ru ? l.ru : l.en}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
