---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { points } from './planeData';
const ru = pageLang(Astro.url) === 'ru';
const rows = points.map((p) => ({ ...p,
  logistic: (Math.max(0, -p.margin) + Math.log1p(Math.exp(-Math.abs(p.margin)))) / Math.log(2),
  hinge: Math.max(0, 1 - p.margin),
}));
const error = rows.filter((r) => r.margin <= 0).length / rows.length;
const mean = (key: 'logistic' | 'hinge') => rows.reduce((s, r) => s + r[key], 0) / rows.length;
if (Math.abs(error - 2 / 7) > 1e-12 || Math.abs(mean('hinge') - 6 / 7) > 1e-12 || mean('logistic').toFixed(3) !== '1.007') throw new Error('SurrogateLosses: finite fixture changed');
---
<Figure id="linear-classifiers-surrogate-losses"
  title={ru ? 'Одни наблюдения, две верхние оценки' : 'One dataset, two upper bounds'}
  caption={ru
    ? 'Точки из предыдущего рисунка. Доля ошибок — 2/7 ≈ 0.286; средние потери — 1.007 и 0.857. Обе оценки могут превышать саму долю и даже единицу. Положительные отступы тоже вносят вклад в логистические потери.'
    : 'Points from the preceding figure. The error fraction is 2/7 ≈ 0.286; mean losses are 1.007 and 0.857. An upper bound can exceed the actual error fraction and even one. Positive margins still contribute logistic loss.'}>
  <div class="loss-table-wrap"><table>
    <thead><tr><th scope="col">{ru ? 'Точка' : 'Point'}</th><th scope="col">M</th><th scope="col">{ru ? 'Ошибка' : 'Error'}</th><th scope="col">{ru ? 'Логист.' : 'Logistic'}</th><th scope="col">Hinge</th></tr></thead>
    <tbody>{rows.map((r) => <tr><th scope="row">{r.id}</th><td>{r.margin}</td><td>{r.margin <= 0 ? 1 : 0}</td><td>{r.logistic.toFixed(3)}</td><td>{r.hinge.toFixed(3)}</td></tr>)}</tbody>
    <tfoot><tr><th scope="row">{ru ? 'Среднее' : 'Mean'}</th><td>—</td><td>{error.toFixed(3)}</td><td>{mean('logistic').toFixed(3)}</td><td>{mean('hinge').toFixed(3)}</td></tr></tfoot>
  </table></div>
</Figure>
<style>
  .loss-table-wrap { max-width: 42rem; margin-inline: auto; }
  table { width: 100%; table-layout: fixed; border-collapse: collapse; font-size: .9rem; font-variant-numeric: tabular-nums; }
  th, td { padding: .5rem .25rem; text-align: right; border-bottom: 1px solid var(--line); }
  th:first-child { text-align: left; }
  tfoot { font-weight: 600; }
  @media (max-width: 420px) { table { font-size: .76rem; } th, td { padding: .45rem .15rem; } }
</style>
