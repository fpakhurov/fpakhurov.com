---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { points, example, exampleDist, foot, nearest, worst, wrong } from './planeData';

const ru = pageLang(Astro.url) === 'ru';

// The hyperplane 3x₁ + 4x₂ − 5 = 0 of the worked example, 44 seeded points, the normal vector w,
// the distance of x = (3, 1) and the margins of three points. Equal scales on both axes keep right angles right.
const X: [number, number] = [-2.5, 5];
const Y: [number, number] = [-2.5, 4];
const lineEnds: [number, number][] = [[-2.5, 3.125], [5, -2.5]];
const arrowFrom: [number, number] = [0.2, 1.1];
const arrowTo: [number, number] = [0.2 + 0.66, 1.1 + 0.88];
const fmt = (v: number) => (v < 0 ? '−' : '') + Math.abs(v).toFixed(1);
const mNear = fmt(nearest.margin), mWorst = fmt(worst.margin);
if (mNear !== '0.9' || mWorst !== '−5.5' || exampleDist !== 1.6) throw new Error('HyperplaneGeometry: annotated margins drifted');
const t = ru
  ? {
      plus: '● класс +1', minus: '■ класс −1',
      legend: [
        'граница: 3x₁ + 4x₂ − 5 = 0',
        'w = (3, 4) перпендикулярен границе',
        'x = (3, 1): ⟨w, x⟩ + b = 8, ‖w‖ = 5,',
        'расстояние до границы 8/5 = 1.6',
        'отступ M = y(⟨w, x⟩ + b):',
        'M > 0 — верно, M < 0 — ошибка',
      ],
    }
  : {
      plus: '● class +1', minus: '■ class −1',
      legend: [
        'boundary: 3x₁ + 4x₂ − 5 = 0',
        'w = (3, 4) is perpendicular to it',
        'x = (3, 1): ⟨w, x⟩ + b = 8, ‖w‖ = 5,',
        'distance to the boundary 8/5 = 1.6',
        'margin M = y(⟨w, x⟩ + b):',
        'M > 0 correct, M < 0 an error',
      ],
    };
const id = 'linear-classifiers-geometry';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 380, u: 52, x0: 16, y0: 22, lx: 448, ly: 70, narrow: false },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 500, u: 44.8, x0: 12, y0: 16, lx: 14, ly: 340, narrow: true },
];
---

<Figure
  id={id}
  title={ru ? 'Линейный классификатор: граница, нормаль и отступ' : 'A linear classifier: boundary, normal and margin'}
  caption={ru
    ? `Граница 3x₁ + 4x₂ − 5 = 0 из разобранного примера и 44 точки двух классов. Вектор w = (3, 4) перпендикулярен границе и смотрит в сторону класса +1. Точка x = (3, 1) имеет значение ⟨w, x⟩ + b = 8 и лежит на расстоянии 8/‖w‖ = 1.6 от границы (пунктир). Отступ M = y(⟨w, x⟩ + b) положителен у верно классифицированных точек, у ближайшей к границе из них он равен ${mNear}; у ${wrong.length} точек он отрицателен, худшая из них, точка класса −1 глубоко на стороне +1, имеет M = ${mWorst}. Масштабы осей одинаковы, поэтому прямые углы изображены прямыми.`
    : `The boundary 3x₁ + 4x₂ − 5 = 0 of the worked example and 44 points of two classes. The vector w = (3, 4) is perpendicular to the boundary and points towards class +1. The point x = (3, 1) has ⟨w, x⟩ + b = 8 and lies at distance 8/‖w‖ = 1.6 from the boundary (dashed). The margin M = y(⟨w, x⟩ + b) is positive for correctly classified points, ${mNear} for the one closest to the boundary; it is negative for ${wrong.length} points, the worst being a point of class −1 deep on the +1 side with M = ${mWorst}. Both axes have the same scale, so right angles look right.`}
>
  {layouts.map((L) => {
    const sx = scale(X, [L.x0, L.x0 + (X[1] - X[0]) * L.u]);
    const sy = scale(Y, [L.y0 + (Y[1] - Y[0]) * L.u, L.y0]);
    const P = (p: [number, number]) => `${sx(p[0]).toFixed(1)} ${sy(p[1]).toFixed(1)}`;
    const posPoly = `M ${P([-2.5, 3.125])} L ${P([-2.5, 4])} L ${P([5, 4])} L ${P([5, -2.5])} Z`;
    const negPoly = `M ${P([-2.5, 3.125])} L ${P([5, -2.5])} L ${P([-2.5, -2.5])} Z`;
    const mid: [number, number] = [(example.x[0] + foot[0]) / 2, (example.x[1] + foot[1]) / 2];
    // a small right-angle mark at the foot of the perpendicular: unit vectors along the line and along w
    const e1: [number, number] = [0.8, -0.6], e2: [number, number] = [0.6, 0.8], k = 0.18;
    const c1: [number, number] = [foot[0] + k * e2[0], foot[1] + k * e2[1]];
    const c2: [number, number] = [c1[0] - k * e1[0], c1[1] - k * e1[1]];
    const c3: [number, number] = [foot[0] - k * e1[0], foot[1] - k * e1[1]];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{ru ? 'Гиперплоскость, нормаль и отступы точек' : 'A hyperplane, its normal and the margins of points'}</title>
        <desc id={`${id}-${L.sfx}-d`}>{ru
          ? 'Плоскость разделена наклонной прямой на две закрашенные полуплоскости. Синие кружки класса +1 в основном сверху справа, красные квадраты класса −1 снизу слева. Стрелка w перпендикулярна прямой. От точки (3, 1) к прямой идёт пунктир длины 1.6. Две точки на чужой стороне обведены красным.'
          : 'A slanted line splits the plane into two shaded half-planes. Blue circles of class +1 lie mostly at the top right, red squares of class −1 at the bottom left. An arrow w is perpendicular to the line. A dashed segment of length 1.6 runs from the point (3, 1) to the line. Two points on the wrong side are circled in red.'}</desc>
        <path d={posPoly} class="f-fill-blue" style="fill-opacity: .07" />
        <path d={negPoly} class="f-fill-red" style="fill-opacity: .07" />
        <rect x={sx(X[0])} y={sy(Y[1])} width={sx(X[1]) - sx(X[0])} height={sy(Y[0]) - sy(Y[1])} class="f-grid" style="fill: none" />
        <path class="f-line" d={`M ${P(lineEnds[0])} L ${P(lineEnds[1])}`} />
        <text class="f-small f-t-blue" x={sx(4.9)} y={sy(3.75)} text-anchor="end">+1: ⟨w, x⟩ + b &gt; 0</text>
        <text class="f-small f-t-red" x={sx(3.9)} y={sy(-2.3)} text-anchor="end">−1: ⟨w, x⟩ + b &lt; 0</text>
        {points.map((p) => p.y === 1
          ? <circle cx={sx(p.x[0]).toFixed(1)} cy={sy(p.x[1]).toFixed(1)} r="3.8" class="f-solid-blue" style="fill-opacity: .85" />
          : <rect x={(sx(p.x[0]) - 3.4).toFixed(1)} y={(sy(p.x[1]) - 3.4).toFixed(1)} width="6.8" height="6.8" class="f-solid-red" style="fill-opacity: .85" />)}
        {wrong.map((p) => <circle cx={sx(p.x[0]).toFixed(1)} cy={sy(p.x[1]).toFixed(1)} r="8" class="f-line f-red" style="stroke-width: 1.4" />)}
        <path class="f-line f-amber f-bold" d={`M ${P(arrowFrom)} L ${P(arrowTo)}`} marker-end="url(#f-arrow-amber)" />
        <text class="f-math f-t-amber" x={sx(arrowTo[0]) - 18} y={sy(arrowTo[1]) + 2}>w</text>
        <path class="f-line f-dash" d={`M ${P(example.x)} L ${P(foot)}`} />
        <path class="f-thin" d={`M ${P(c3)} L ${P(c2)} L ${P(c1)}`} />
        <circle cx={sx(example.x[0])} cy={sy(example.x[1])} r="5.5" class="f-solid-blue" style="stroke: var(--ink); stroke-width: 1.5" />
        <text class="f-small f-halo" x={sx(example.x[0]) + 10} y={sy(example.x[1]) + 22}>x, M = 8</text>
        <text class="f-small f-halo" x={sx(mid[0]) + 8} y={sy(mid[1]) + 14}>1.6</text>
        <text class="f-small f-halo" x={sx(nearest.x[0]) + 10} y={sy(nearest.x[1]) + 5}>M = {mNear}</text>
        <text class="f-small f-t-red f-halo" x={sx(worst.x[0]) - 2} y={sy(worst.x[1]) - 13} text-anchor="end">M = {mWorst}</text>
        <text class="f-small f-t-blue" x={L.lx} y={L.ly}>{t.plus}</text>
        <text class="f-small f-t-red" x={L.lx + 120} y={L.ly}>{t.minus}</text>
        {t.legend.map((line, i) => <text class="f-small f-t-muted" x={L.lx} y={L.ly + (i + 1) * (L.narrow ? 22 : 26)}>{line}</text>)}
      </svg>
    );
  })}
</Figure>
