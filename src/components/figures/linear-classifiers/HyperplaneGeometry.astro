---
import Figure from '../Figure.astro';
import { scale } from '../regressionGeometry';
import { pageLang } from '../../../utils/lang';
import { points, example, foot } from './planeData';
const ru = pageLang(Astro.url) === 'ru';
const id = 'linear-classifiers-geometry';
const layouts = [
  { key: 'wide', cls: 'fig-wide', width: 760, height: 370, unit: 39, left: 45, top: 24, tx: 335, ty: 62 },
  { key: 'narrow', cls: 'fig-narrow seq-narrow', width: 360, height: 510, unit: 39, left: 45, top: 24, tx: 20, ty: 375 },
];
---
<Figure id={id}
  title={ru ? 'Семь заданных точек и одна граница' : 'Seven specified points and one boundary'}
  caption={ru
    ? 'Граница 2x₁ − x₂ − 1 = 0 ошибается на F и G. Отрезок от E до границы перпендикулярен ей и имеет длину 4/√5. Одинаковый масштаб осей сохраняет углы. Все координаты заданы для этого примера.'
    : 'The boundary 2x₁ − x₂ − 1 = 0 misclassifies F and G. The perpendicular from E has length 4/√5. Equal axis scales preserve angles. All coordinates are specified for this example.'}>
  {layouts.map((a) => {
    const sx = scale([-2, 4], [a.left, a.left + 6 * a.unit]);
    const sy = scale([-3, 5], [a.top + 8 * a.unit, a.top]);
    const point = (p: number[]) => `${sx(p[0])} ${sy(p[1])}`;
    const start = [0, -1], end = [1.2, -1.6];
    const mark = [[foot[0] + .16, foot[1] - .08], [foot[0] + .24, foot[1] + .08], [foot[0] + .08, foot[1] + .16]];
    return <svg class={a.cls} viewBox={`0 0 ${a.width} ${a.height}`} role="img" aria-labelledby={`${id}-${a.key}-title ${id}-${a.key}-desc`}>
      <title id={`${id}-${a.key}-title`}>{ru ? 'Нормаль и расстояние до прямой' : 'Normal and distance to a line'}</title>
      <desc id={`${id}-${a.key}-desc`}>{ru ? 'Точки A–G имеют отступы 4, 3, 1, 2, 4, −1, −3. Синие круги — положительный класс, красные квадраты — отрицательный. Пунктир соединяет E=(3,1) с проекцией (1.4,1.8).' : 'Points A–G have margins 4, 3, 1, 2, 4, −1, −3. Blue circles mark the positive class; red squares mark the negative class. A dashed line connects E=(3,1) to its projection (1.4,1.8).'}</desc>
      {[-2, -1, 0, 1, 2, 3, 4].map((v) => <g><path class="f-grid" d={`M ${sx(v)} ${sy(-3)} V ${sy(5)}`} /><text class="f-note" x={sx(v)} y={sy(-3) + 18} text-anchor="middle">{v}</text></g>)}
      {[-3, -2, -1, 0, 1, 2, 3, 4, 5].map((v) => <g><path class="f-grid" d={`M ${sx(-2)} ${sy(v)} H ${sx(4)}`} /><text class="f-note" x={sx(-2) - 8} y={sy(v) + 4} text-anchor="end">{v}</text></g>)}
      <path class="f-axis" d={`M ${sx(-2)} ${sy(0)} H ${sx(4)} M ${sx(0)} ${sy(-3)} V ${sy(5)}`} />
      <path class="f-line f-bold" d={`M ${point([-1, -3])} L ${point([3, 5])}`} />
      {points.map((p) => <g>
        {p.y === 1 ? <circle cx={sx(p.x[0])} cy={sy(p.x[1])} r="5" class="f-solid-blue" /> : <rect x={sx(p.x[0]) - 4.5} y={sy(p.x[1]) - 4.5} width="9" height="9" class="f-solid-red" />}
        {p.margin < 0 && <circle cx={sx(p.x[0])} cy={sy(p.x[1])} r="10" class="f-line f-red" />}
        <text class="f-small f-halo" x={sx(p.x[0]) + 12} y={sy(p.x[1]) - 9}>{p.id}</text>
      </g>)}
      <path class="f-line f-dash" d={`M ${point(example.x)} L ${point(foot)}`} />
      <path class="f-thin" d={`M ${point(mark[0])} L ${point(mark[1])} L ${point(mark[2])}`} />
      <path class="f-line f-amber" d={`M ${point(start)} L ${point(end)}`} marker-end="url(#f-arrow-amber)" />
      <text class="f-small f-halo" x={sx(end[0]) + 8} y={sy(end[1])}>w</text>
      <text class="f-small" x={a.tx} y={a.ty}>w = (2, −1), b = −1</text>
      <text class="f-small" x={a.tx} y={a.ty + 28}>E = (3, 1), f(E) = 4</text>
      <text class="f-small" x={a.tx} y={a.ty + 56}>{ru ? 'Проекция: (1.4, 1.8)' : 'Projection: (1.4, 1.8)'}</text>
      <text class="f-small" x={a.tx} y={a.ty + 84}>{ru ? 'Расстояние: 4/√5 ≈ 1.789' : 'Distance: 4/√5 ≈ 1.789'}</text>
      <text class="f-small f-t-muted" x={a.tx} y={a.ty + 112}>{ru ? '● класс +1     ■ класс −1' : '● class +1     ■ class −1'}</text>
    </svg>;
  })}
</Figure>
