---
import Figure from '../Figure.astro';

const ru = Astro.props.lang === 'ru';
const title = ru ? 'Что представляет строка на каждом этапе' : 'What one row represents at each stage';
const caption = ru
  ? 'Группировка меняет гранулярность с позиции на заказ. Фильтр суммы убирает заказ 102, сохраняя гранулярность остальных строк.'
  : 'Grouping changes the grain from line to order. The total filter removes order 102 while preserving the remaining grain.';
const desc = ru
  ? 'Шесть позиций переходят в четыре заказа. После отбора по сумме остаются три заказа.'
  : 'Six lines become four orders. The total filter leaves three orders.';
const stages = [
  { name: 'line_amounts', label: ru ? '6 позиций' : '6 order lines' },
  { name: 'order_totals', label: ru ? '4 заказа' : '4 orders' },
  { name: 'WHERE total_cents ≥ 1200', label: ru ? '3 заказа' : '3 orders' },
];
---
<Figure id="sql-cte-order-totals" title={title} caption={caption}>
  <svg viewBox="0 0 340 190" role="img" aria-labelledby="cte-totals-title cte-totals-desc" style="max-width: 510px; margin-inline: auto">
    <title id="cte-totals-title">{title}</title>
    <desc id="cte-totals-desc">{desc}</desc>
    {stages.map(({name, label}, i) => (
      <g transform={`translate(0 ${i * 63})`}>
        <rect class={i === 2 ? 'f-fill-green' : 'f-fill-blue'} x="10" y="5" width="320" height="47" rx="7" />
        <text class="f-label" x="22" y="33">{name}</text>
        <text class="f-small" x="318" y="33" text-anchor="end">{label}</text>
        {i < 2 && <path class="f-line" d="M 170 54 V 65 M 166 61 L 170 65 L 174 61" />}
      </g>
    ))}
  </svg>
</Figure>
