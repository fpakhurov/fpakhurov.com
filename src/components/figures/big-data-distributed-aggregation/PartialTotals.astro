---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? "Частичные суммы объединяются по магазину" : "Merge partial sums by store";
const caption = ru ? "Каждый столбец хранит состояния отдельного магазина. Получатель складывает свой столбец." : "Each column holds the state for a different store. A receiver sums its own column.";
const desc = ru ? "Суммы магазина 1 равны 300, 150, 150 и 200, итог 800. Для магазина 2 это 50, 100, 200 и 200, итог 550." : "The store 1 partials 300, 150, 150 and 200 sum to 800. The store 2 partials 50, 100, 200 and 200 sum to 550.";
const partials = [[300, 50], [150, 100], [150, 200], [200, 200]];
const workers = ['A', 'B', 'C', 'D'];
---
<Figure id="bd-partial-totals" title={title} caption={caption}>
  <svg viewBox="0 0 340 212" role="img" aria-labelledby="bd-partial-totals-title bd-partial-totals-desc" style="max-width: 550px; margin-inline: auto">
    <title id="bd-partial-totals-title">{title}</title>
    <desc id="bd-partial-totals-desc">{desc}</desc>
    {[1, 2].map((store) => (
      <text class="f-label" x={34 + store * 99} y="25" text-anchor="middle">{ru ? 'Магазин' : 'Store'} {store}</text>
    ))}
    {partials.map(([left, right], i) => (
      <g transform={`translate(0 ${i * 32})`}>
        <text class="f-label" x="42" y="56" text-anchor="middle">{workers[i]}</text>
        <rect class="f-fill-blue" x="91" y="37" width="84" height="26" rx="4" />
        <rect class="f-fill-blue" x="190" y="37" width="84" height="26" rx="4" />
        <text class="f-label" x="133" y="56" text-anchor="middle">{left}</text>
        <text class="f-label" x="232" y="56" text-anchor="middle">{right}</text>
      </g>
    ))}
    <text class="f-label" x="42" y="190" text-anchor="middle">{ru ? 'Итог' : 'Total'}</text>
    {[0, 1].map((column) => (
      <g transform={`translate(${column * 99} 0)`}>
        <rect class="f-fill-green" x="91" y="169" width="84" height="32" rx="4" />
        <text class="f-label" x="133" y="190" text-anchor="middle">{partials.reduce((sum, row) => sum + row[column], 0)}</text>
      </g>
    ))}
  </svg>
</Figure>
