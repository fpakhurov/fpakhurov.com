---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar, type Tone } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The path of one line of Python, os.write(1, b"hello, world\n"), from source to the kernel, in CPython 3.12.
// The bytecode is the output of dis for that line; the message is the 13 bytes of the hello-world program.
const msg = 'hello, world\n';
if (msg.length !== 13) throw new Error(`message length ${msg.length}`);
const bytecode = ['LOAD_NAME os', 'LOAD_ATTR write', 'LOAD_CONST 1', "LOAD_CONST b'hello, world\\n'", 'CALL 2'];
if (bytecode.length !== 5) throw new Error('five instructions');

interface Row { tone: Tone; title: string; wide: string; narrow: string; note: [string, string] }
const rows: Row[] = ru
  ? [
      { tone: 'x', title: 'исходный код на Python', wide: 'os.write(1, b"hello, world\\n")', narrow: 'os.write(1, b"hello, world\\n")',
        note: ['компилятор CPython переводит строку в байт-код', 'при загрузке модуля, один раз'] },
      { tone: 'x', title: 'байт-код (CPython 3.12)', wide: 'LOAD_NAME, LOAD_ATTR, LOAD_CONST ×2, CALL', narrow: 'LOAD_NAME … CALL 2',
        note: ['команды стековой машины; их набор', 'меняется от версии к версии'] },
      { tone: 'h', title: 'цикл интерпретатора', wide: '_PyEval_EvalFrameDefault', narrow: '_PyEval_EvalFrameDefault',
        note: ['цикл на C выбирает каждую команду и выполняет её;', 'CALL находит функцию, написанную на C'] },
      { tone: 'h', title: 'os.write на C', wide: 'os_write_impl → _Py_write', narrow: 'os_write_impl → _Py_write',
        note: ['переводит объекты int и bytes Python в int', 'и указатель языка C, затем отпускает GIL'] },
      { tone: 'h', title: 'библиотека C', wide: 'write(1, buf, 13) → svc / syscall / ecall', narrow: 'write(1, buf, 13) → svc',
        note: ['кладёт номер вызова и аргументы в регистры', 'и выполняет команду перехода в ядро'] },
      { tone: 'y', title: 'ядро', wide: 'write: 13 байт в дескриптор 1', narrow: 'write: 13 байт в дескриптор 1',
        note: ['копирует 13 байт; на обратном пути GIL снова', 'захватывается, и 13 становится объектом int Python'] },
    ]
  : [
      { tone: 'x', title: 'Python source', wide: 'os.write(1, b"hello, world\\n")', narrow: 'os.write(1, b"hello, world\\n")',
        note: ['the CPython compiler turns the line into bytecode', 'once, when the module is loaded'] },
      { tone: 'x', title: 'bytecode (CPython 3.12)', wide: 'LOAD_NAME, LOAD_ATTR, LOAD_CONST ×2, CALL', narrow: 'LOAD_NAME … CALL 2',
        note: ['instructions for a stack machine; the instruction', 'set changes from version to version'] },
      { tone: 'h', title: 'the interpreter loop', wide: '_PyEval_EvalFrameDefault', narrow: '_PyEval_EvalFrameDefault',
        note: ['a C loop fetches each instruction and runs it;', 'CALL finds a function written in C'] },
      { tone: 'h', title: 'os.write in C', wide: 'os_write_impl → _Py_write', narrow: 'os_write_impl → _Py_write',
        note: ['converts the Python int and bytes into a C int and', 'a pointer, then releases the GIL'] },
      { tone: 'h', title: 'the C library', wide: 'write(1, buf, 13) → svc / syscall / ecall', narrow: 'write(1, buf, 13) → svc',
        note: ['puts the call number and the arguments in registers', 'and executes the instruction that enters the kernel'] },
      { tone: 'y', title: 'the kernel', wide: 'write: 13 bytes to descriptor 1', narrow: 'write: 13 bytes to descriptor 1',
        note: ['copies the 13 bytes; on the way back the GIL is taken', 'again, and 13 becomes a Python int object'] },
    ];
const t = ru
  ? { user: 'пользовательский режим', kernel: 'режим ядра',
      steps: ['исходная строка компилируется в байт-код', 'байт-код: пять команд стековой машины', 'цикл интерпретатора выполняет их по одной', 'функция на C преобразует аргументы и отпускает GIL', 'библиотека C выполняет системный вызов', 'ядро записывает 13 байт и возвращает 13'] }
  : { user: 'user mode', kernel: 'kernel mode',
      steps: ['the source line is compiled to bytecode', 'bytecode: five instructions of a stack machine', 'the interpreter loop runs them one by one', 'a C function converts the arguments and releases the GIL', 'the C library makes the system call', 'the kernel writes 13 bytes and returns 13'] };

interface Layout { cls: string; W: number; H: number; bx: number; bw: number; bh: number; rowY: (k: number) => number; noteX: number | null; content: 'wide' | 'narrow'; boundaryX: [number, number]; badgeX: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 420, bx: 40, bw: 340, bh: 46, rowY: (k) => 14 + k * 64 + (k === 5 ? 30 : 0), noteX: 398, content: 'wide', boundaryX: [8, 752], badgeX: 20 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 444, bx: 34, bw: 318, bh: 50, rowY: (k) => 12 + k * 66 + (k === 5 ? 40 : 0), noteX: null, content: 'narrow', boundaryX: [8, 352], badgeX: 17 },
];
const hasNext = rows.map((_, k) => k !== rows.length - 1);
const id = 'python-to-kernel';
---

<Figure
  id={id}
  title={ru ? 'Путь одной строки Python до ядра' : 'The path of one line of Python to the kernel'}
  caption={ru
    ? 'Как CPython 3.12 выполняет os.write(1, b"hello, world\\n"). Строка компилируется в байт-код (1) — пять команд стековой машины (2), которые цикл интерпретатора на C выполняет по одной (3). Команда CALL вызывает функцию из модуля os, написанную на C: она переводит объекты Python в значения C и отпускает GIL (4). Дальше путь тот же, что у программы на C: библиотека C делает системный вызов write (5), и ядро копирует 13 байт (6). Зелёным отмечен код Python, синим — код среды выполнения и библиотеки на C, красным — ядро.'
    : 'How CPython 3.12 runs os.write(1, b"hello, world\\n"). The line is compiled to bytecode (1), five instructions for a stack machine (2), which the interpreter loop, written in C, runs one at a time (3). The CALL instruction calls a function of the os module that is written in C: it converts the Python objects into C values and releases the GIL (4). From there the path is the same as for a C program: the C library makes the write system call (5), and the kernel copies the 13 bytes (6). Green marks Python code, blue the C code of the runtime and the library, red the kernel.'}
>
  {layouts.map((L) => {
    const by = (L.rowY(4) + L.bh + L.rowY(5)) / 2;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Слои между строкой Python и системным вызовом' : 'The layers between a line of Python and a system call'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Шесть блоков сверху вниз, соединённых стрелками: исходный код на Python, байт-код, цикл интерпретатора, функция os.write на C, библиотека C с системным вызовом write и ядро. Пунктир перед последним блоком отделяет пользовательский режим от режима ядра.'
          : 'Six boxes from top to bottom, joined by arrows: Python source, bytecode, the interpreter loop, the os.write function in C, the C library with the write system call, and the kernel. A dashed line before the last box separates user mode from kernel mode.'}</desc>
        {rows.map((r, k) => {
          const y = L.rowY(k);
          return (
            <g data-s={String(k + 1)}>
              <rect x={L.bx} y={y} width={L.bw} height={L.bh} rx="7" style={`fill: ${toneVar[r.tone]}; fill-opacity: 0.12; stroke: ${toneVar[r.tone]}; stroke-width: 1.3`} />
              <text class="f-small" x={L.bx + 10} y={y + 18} style="font-weight: 650">{r.title}</text>
              <text class="f-small" x={L.bx + 10} y={y + (L.content === 'wide' ? 37 : 40)} style="font-family: var(--mono)">{L.content === 'wide' ? r.wide : r.narrow}</text>
              {L.noteX !== null && r.note.map((line, i) => (
                <text class="f-small f-t-muted" x={L.noteX!} y={y + 18 + i * 19}>{line}</text>
              ))}
              {hasNext[k] && <path class="f-line f-muted" d={`M ${L.bx + L.bw / 2} ${y + L.bh + 2} V ${L.rowY(k + 1) - 3}`} marker-end="url(#f-arrow-muted)" />}
              <Badge x={L.badgeX} y={y + L.bh / 2} n={k + 1} />
            </g>
          );
        })}
        <path class="f-thin f-red f-dash" d={`M ${L.boundaryX[0]} ${by} H ${L.boundaryX[1]}`} />
        <text class="f-small f-t-muted f-halo" x={L.boundaryX[1]} y={by - 6} text-anchor="end">{t.user}</text>
        <text class="f-small f-t-red f-halo" x={L.boundaryX[1]} y={by + 15} text-anchor="end">{t.kernel}</text>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
