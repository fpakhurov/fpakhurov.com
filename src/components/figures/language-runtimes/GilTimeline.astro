---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A schematic timeline of the GIL over 40 ms, with CPython's default switch interval of 5 ms.
// Top: two CPU-bound threads; they take turns, so together they use one core.
// Bottom: a CPU-bound thread and a thread that waits for data in recv. While it waits in the kernel it holds no GIL;
// when its data arrives at 20 ms it must wait one switch interval for the GIL, runs for 1 ms and waits again.
const interval = 5;
const T = 40;
type State = 'run' | 'gil' | 'io';
type Seg = [number, number, State];
const alternate = (first: boolean): Seg[] =>
  Array.from({ length: T / interval }, (_, k) => [k * interval, (k + 1) * interval, (k % 2 === 0) === first ? 'run' : 'gil'] as Seg);
const panels: { title: string; rows: { label: string; segs: Seg[] }[] }[] = [
  {
    title: ru ? 'два потока, занятых вычислениями' : 'two CPU-bound threads',
    rows: [
      { label: ru ? 'поток 1' : 'thread 1', segs: alternate(true) },
      { label: ru ? 'поток 2' : 'thread 2', segs: alternate(false) },
    ],
  },
  {
    title: ru ? 'вычислительный поток и поток, ждущий данных' : 'a CPU-bound thread and a thread doing I/O',
    rows: [
      { label: ru ? 'поток 1' : 'thread 1', segs: [[0, 1, 'gil'], [1, 25, 'run'], [25, 26, 'gil'], [26, 40, 'run']] },
      { label: ru ? 'поток 3' : 'thread 3', segs: [[0, 1, 'run'], [1, 20, 'io'], [20, 25, 'gil'], [25, 26, 'run'], [26, 40, 'io']] },
    ],
  },
];
// Checks: in every panel exactly one thread runs at any time, and the segments of each row tile [0, T].
for (const p of panels) {
  for (const r of p.rows) {
    let end = 0;
    for (const [a, b] of r.segs) { if (a !== end) throw new Error(`gap in ${r.label}`); end = b; }
    if (end !== T) throw new Error(`row ${r.label} ends at ${end}`);
  }
  for (let ms = 0.5; ms < T; ms += 1) {
    const running = p.rows.filter((r) => r.segs.some(([a, b, s]) => s === 'run' && a <= ms && ms < b)).length;
    if (running !== 1) throw new Error(`${running} threads run at ${ms} ms in "${p.title}"`);
  }
}
const busy = panels[0].rows.map((r) => r.segs.filter(([, , s]) => s === 'run').reduce((a, [x, y]) => a + y - x, 0));
if (busy[0] !== 20 || busy[1] !== 20) throw new Error(`busy ${busy}`);

const fill: Record<State, string> = {
  run: `fill: ${toneVar.h}; fill-opacity: 0.55; stroke: ${toneVar.h}; stroke-width: 1`,
  gil: `fill: none; stroke: ${toneVar.n}; stroke-width: 1; stroke-dasharray: 3 2`,
  io: `fill: ${toneVar.g}; fill-opacity: 0.22; stroke: ${toneVar.g}; stroke-width: 1`,
};
const legend: [State, string][] = ru
  ? [['run', 'выполняет байт-код, держит GIL'], ['gil', 'ждёт GIL'], ['io', 'в системном вызове, GIL отпущен']]
  : [['run', 'runs bytecode, holds the GIL'], ['gil', 'waits for the GIL'], ['io', 'in a system call, GIL released']];
const t = ru ? { ms: 'мс', wait: 'ждёт 5 мс' } : { ms: 'ms', wait: 'waits 5 ms' };
interface Layout { cls: string; W: number; H: number; x0: number; x1: number; rowY: [number, number][]; titleY: [number, number]; axisY: number; tickStep: number; legendAt: [number, number][]; rh: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 290, x0: 100, x1: 740, rowY: [[34, 64], [130, 160]], titleY: [20, 116], axisY: 222, tickStep: 5, legendAt: [[100, 276], [360, 276], [500, 276]], rh: 22 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 362, x0: 82, x1: 346, rowY: [[36, 66], [134, 164]], titleY: [20, 118], axisY: 228, tickStep: 10, legendAt: [[8, 290], [8, 318], [8, 346]], rh: 22 },
];
const id = 'gil-timeline';
---

<Figure
  id={id}
  title={ru ? 'GIL: кто выполняет байт-код в каждый момент' : 'The GIL: who runs bytecode at each moment'}
  caption={ru
    ? 'Схема 40 мс работы CPython с интервалом переключения по умолчанию, 5 мс. Сверху: два потока, занятых вычислениями, по очереди держат GIL, и в каждый момент работает только один; вместе они загружают одно ядро, сколько бы ядер ни было. Снизу: поток 3 большую часть времени ждёт данных в системном вызове и не держит GIL, так что поток 1 работает почти без пауз; когда данные приходят (20 мс), поток 3 ждёт GIL один интервал переключения и только потом их обрабатывает. Это схема, а не измерение: реальные моменты переключения зависят от планировщика ОС.'
    : 'A schematic of 40 ms of CPython with the default switch interval of 5 ms. Top: two CPU-bound threads take turns holding the GIL, and only one runs at any moment; together they keep one core busy, however many cores there are. Bottom: thread 3 spends most of its time waiting for data inside a system call, where it holds no GIL, so thread 1 runs almost without pause; when the data arrives (at 20 ms), thread 3 waits one switch interval for the GIL before it can handle it. This is a schematic, not a measurement: the real switching moments depend on the OS scheduler.'}
>
  {layouts.map((L) => {
    const sx = scale([0, T], [L.x0, L.x1]);
    const ticks = Array.from({ length: T / L.tickStep + 1 }, (_, k) => k * L.tickStep);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Временная диаграмма потоков, разделяющих GIL' : 'Timeline of threads sharing the GIL'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Две панели по две строки, ось времени от 0 до 40 мс. В верхней панели потоки 1 и 2 чередуются каждые 5 мс: пока один выполняется, другой ждёт GIL. В нижней поток 1 выполняется почти всё время, а поток 3 выполняется 1 мс в начале, затем ждёт данных в системном вызове до 20 мс, ждёт GIL до 25 мс, выполняется 1 мс и снова ждёт данных.'
          : 'Two panels of two rows each, with a time axis from 0 to 40 ms. In the top panel threads 1 and 2 alternate every 5 ms: while one runs, the other waits for the GIL. In the bottom panel thread 1 runs almost all the time, while thread 3 runs for 1 ms at the start, waits for data in a system call until 20 ms, waits for the GIL until 25 ms, runs for 1 ms and waits for data again.'}</desc>
        {panels.map((p, i) => (
          <g>
            <text class="f-small" x={L.cls === 'fig-wide' ? L.x0 : 8} y={L.titleY[i]} style="font-weight: 650">{p.title}</text>
            {p.rows.map((r, j) => (
              <g>
                <text class="f-small f-t-muted" x={L.x0 - 10} y={L.rowY[i][j] + L.rh / 2 + 4.5} text-anchor="end">{r.label}</text>
                {r.segs.map(([a, b, s]) => (
                  <rect x={sx(a)} y={L.rowY[i][j]} width={sx(b) - sx(a)} height={L.rh} style={fill[s]} />
                ))}
              </g>
            ))}
          </g>
        ))}
        <path class="f-line f-muted" d={`M ${sx(20)} ${L.rowY[1][1] + L.rh + 8} V ${L.rowY[1][1] + L.rh + 2}`} marker-end="url(#f-arrow-muted)" />
        <text class="f-small f-t-muted" x={sx(22.5)} y={L.rowY[1][1] + L.rh + 20} text-anchor="middle">{t.wait}</text>
        <path class="f-axis" d={`M ${L.x0} ${L.axisY} H ${L.x1}`} />
        {ticks.map((ms) => (
          <g>
            <path class="f-axis" d={`M ${sx(ms)} ${L.axisY} v 5`} />
            <text class="f-note" x={sx(ms)} y={L.axisY + 20} text-anchor="middle">{ms}</text>
          </g>
        ))}
        <text class="f-note" x={L.x0 - 10} y={L.axisY + 20} text-anchor="end">{t.ms}</text>
        {legend.map(([s, label], k) => (
          <g>
            <rect x={L.legendAt[k][0]} y={L.legendAt[k][1] - 11} width="18" height="13" style={fill[s]} />
            <text class="f-small f-t-muted" x={L.legendAt[k][0] + 26} y={L.legendAt[k][1]}>{label}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
