---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// "Café's menus" with é stored as e + U+0301, through every step of the note.
// A token is `changed` when this step produced it, `dropped` when this step removes it.
type Tok = { t: string; changed?: boolean; dropped?: boolean };
const raw = "Cafe\u0301's menus";
const bytes = [...new TextEncoder().encode(raw)].map((b) => b.toString(16).toUpperCase().padStart(2, '0'));
const show = (c: string) => (c === ' ' ? '␣' : c === '\u0301' ? 'U+0301' : c);
const codePoints = [...raw];
const nfc = [...raw.normalize('NFC')];
if (bytes.length !== 14 || codePoints.length !== 13 || nfc.length !== 12) throw new Error('text-as-data Steps: unexpected lengths');

interface Step { name: string; note: string; toks: Tok[]; mono: boolean }
const steps: Step[] = [
  { name: ru ? 'байты' : 'bytes', note: ru ? 'то, что хранит файл' : 'what the file stores', mono: true, toks: bytes.map((b, i) => ({ t: b, changed: i === 4 || i === 5 })) },
  { name: ru ? 'декодирование UTF-8' : 'decode UTF-8', note: ru ? '14 байт → 13 кодовых точек' : '14 bytes → 13 code points', mono: true, toks: codePoints.map((c) => ({ t: show(c), changed: c === '\u0301' })) },
  { name: ru ? 'нормализация NFC' : 'normalize (NFC)', note: 'e + U+0301 → é', mono: true, toks: nfc.map((c) => ({ t: show(c), changed: c === 'é' })) },
  { name: ru ? 'сегментация \\w+' : 'segment (\\w+)', note: ru ? "отбрасывает ' и пробел" : "drops ' and the space", mono: false, toks: [{ t: 'Café' }, { t: "'", dropped: true }, { t: 's' }, { t: '␣', dropped: true }, { t: 'menus' }] },
  { name: ru ? 'нижний регистр' : 'lowercase', note: 'Café = café', mono: false, toks: [{ t: 'café', changed: true }, { t: 's' }, { t: 'menus' }] },
  { name: ru ? 'удаление стоп-слов' : 'remove stopwords', note: ru ? 'убирает s (и not)' : 'drops s (and not)', mono: false, toks: [{ t: 'café' }, { t: 's', dropped: true }, { t: 'menus' }] },
  { name: ru ? 'лемматизация' : 'lemmatize', note: 'menus → menu', mono: false, toks: [{ t: 'café' }, { t: 'menu', changed: true }] },
];
const groups = [
  { from: 0, to: 2, tone: 'green', short: ru ? 'тот же текст в одной записи: всегда' : 'the same text, one canonical form: always', lines: ru ? ['тот же текст,', 'одна каноническая', 'запись: всегда'] : ['the same text,', 'one canonical form:', 'always'] },
  { from: 3, to: 6, tone: 'amber', short: ru ? 'единицы и очистка: под задачу' : 'units and cleaning: chosen per task', lines: ru ? ['единицы и очистка:', 'теряют информацию,', 'выбираются', 'под задачу'] : ['units and cleaning:', 'lose information,', 'chosen per task'] },
] as const;

interface Layout { cls: string; W: number; stacked: boolean; labX: number; cx: number; step: number; header: number; minBox: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 730, stacked: false, labX: 16, cx: 230, step: 50, header: 0, minBox: 22 },
  { cls: 'fig-narrow', W: 360, stacked: true, labX: 8, cx: 8, step: 84, header: 26, minBox: 20 },
];
const charW = (mono: boolean) => (mono ? 7.6 : 8.2);
const boxW = (t: Tok, mono: boolean, L: Layout) => Math.max(L.minBox, t.t.length * charW(mono) + (mono ? 10 : 14));
const id = 'text-as-data-steps';
const rowTop = (L: Layout, i: number) => 10 + i * L.step + (L.stacked ? (i >= groups[1].from ? 2 : 1) * L.header : 0);
---

<Figure
  id={id}
  title={ru ? 'От байтов к очищенным единицам' : 'From bytes to cleaned units'}
  caption={ru
    ? 'Фрагмент «Café\'s menus», в котором é записано как e плюс комбинируемое ударение, проходит по шагам этой заметки. Первые три шага меняют только запись текста: 14 байт декодируются в 13 кодовых точек, а нормализация NFC собирает e + U+0301 в одну кодовую точку é, и слово становится равным любой другой своей записи. Последние четыре шага определяют единицы и выбрасывают информацию: сегментация по \\w+ отбрасывает апостроф и пробел, приведение к нижнему регистру сливает Café и café, удаление стоп-слов убирает s, лемматизация сводит menus к menu. Зачёркнутые клетки отброшены, закрашенные изменены этим шагом. Какие из последних четырёх шагов применять, зависит от задачи.'
    : "The fragment “Café's menus”, stored with é as e plus a combining accent, through the steps of this note. The first three steps change only how the text is written down: 14 bytes decode to 13 code points, and NFC normalization composes e + U+0301 into the single code point é, so the word compares equal to every other spelling of it. The last four steps decide the units and throw information away: segmentation on \\w+ drops the apostrophe and the space, lowercasing merges Café and café, stopword removal drops s, and lemmatization folds menus onto menu. Struck-out cells are dropped, filled cells were changed by the step. Which of the last four to apply depends on the task."}
>
  {layouts.map((L) => {
    const H = rowTop(L, steps.length - 1) + (L.stacked ? 72 : 44) + 6;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Шаги предобработки текста' : 'Text preprocessing steps'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? `Семь шагов сверху вниз. Байты ${bytes.join(' ')}; декодирование даёт 13 кодовых точек, среди них отдельное комбинируемое ударение; NFC собирает e и ударение в é; сегментация даёт Café, s, menus и отбрасывает апостроф и пробел; нижний регистр даёт café; удаление стоп-слов убирает s; лемматизация даёт café, menu. Первые три шага помечены как одна каноническая запись того же текста, последние четыре — как выбор под задачу.`
          : `Seven steps from top to bottom. Bytes ${bytes.join(' ')}; decoding gives 13 code points, one of them a separate combining accent; NFC composes e and the accent into é; segmentation gives Café, s, menus and drops the apostrophe and the space; lowercasing gives café; stopword removal drops s; lemmatization gives café, menu. The first three steps are marked as one canonical form of the same text, the last four as chosen per task.`}</desc>
        {groups.map((g, gi) => {
          if (L.stacked) {
            const y = (gi === 0 ? 10 : rowTop(L, g.from) - L.header) + 14;
            return <text class={`f-small f-t-${g.tone}`} x={L.labX} y={y}>{g.short}</text>;
          }
          const y0 = rowTop(L, g.from) + 2, y1 = rowTop(L, g.to) + 34, x = 586;
          return (
            <g>
              <path class={`f-thin f-${g.tone}`} d={`M ${x - 6} ${y0} H ${x} V ${y1} H ${x - 6}`} />
              {g.lines.map((line, li) => <text class={`f-small f-t-${g.tone}`} x={x + 10} y={(y0 + y1) / 2 - ((g.lines.length - 1) * 16) / 2 + 4 + li * 16}>{line}</text>)}
            </g>
          );
        })}
        {!L.stacked && <path class="f-thin f-muted f-dash" d={`M ${L.labX} ${rowTop(L, 3) - 8} H 570`} />}
        {steps.map((s, si) => {
          const head = rowTop(L, si);
          const top = L.stacked ? head + 42 : head + 4;
          let x = L.cx;
          return (
            <g>
              <text class="f-title" x={L.labX} y={head + 19}>{s.name}</text>
              <text class="f-note" x={L.labX} y={head + 37}>{s.note}</text>
              {si > 0 && !L.stacked && <path class="f-thin f-muted" d={`M ${L.cx - 20} ${head - 14} V ${head + 2}`} marker-end="url(#f-arrow-muted)" />}
              {s.toks.map((tok) => {
                const w = boxW(tok, s.mono, L);
                const el = (
                  <g>
                    <rect class={tok.dropped ? 'f-box-soft' : tok.changed ? (si < 3 ? 'f-box f-fill-green' : 'f-box f-fill-amber') : 'f-box'} x={x} y={top} width={w} height="28" rx="4" />
                    <text class={`${s.mono ? 'f-small' : 'f-label'}${tok.dropped ? ' f-t-muted' : ''}`} x={x + w / 2} y={top + 19} text-anchor="middle" font-family="var(--mono)">{tok.t}</text>
                    {tok.dropped && <path class="f-thin f-red" d={`M ${x + 3} ${top + 25} L ${x + w - 3} ${top + 3}`} />}
                  </g>
                );
                x += w + 2;
                return el;
              })}
            </g>
          );
        })}
      </svg>
    );
  })}
</Figure>
