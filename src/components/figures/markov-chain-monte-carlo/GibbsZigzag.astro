---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { mulberry32, normal } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Gibbs sampling for a bivariate normal with unit variances and correlation ρ: X1 | X2 ~ N(ρ x2, 1 − ρ²) and the same for X2.
// Each update moves along one axis; with ρ = 0.95 the moves are short compared with the long diagonal of the ellipse.
const rho = 0.95, s = Math.sqrt(1 - rho * rho), z = normal(mulberry32(7));
let x1 = -2.4, x2 = -2.4;
const path: [number, number][] = [[x1, x2]];
for (let t = 0; t < 40; t++) { x1 = rho * x2 + s * z(); path.push([x1, x2]); x2 = rho * x1 + s * z(); path.push([x1, x2]); }
const ell = (k: number) => Array.from({ length: 121 }, (_, i) => {
  const a = (2 * Math.PI * i) / 120, u = k * Math.sqrt(1 + rho) * Math.cos(a), v = k * Math.sqrt(1 - rho) * Math.sin(a);
  return [(u - v) / Math.SQRT2, (u + v) / Math.SQRT2] as [number, number];
});
const id = 'gibbs-zigzag';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 520, H: 340, x0: 110, x1: 410, y0: 20, y1: 320 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 340, x0: 30, x1: 330, y0: 20, y1: 320 },
];
---

<Figure
  id={id}
  title={ru ? 'Сэмплирование по Гиббсу ходит зигзагом' : 'Gibbs sampling moves in a zigzag'}
  caption={ru
    ? 'Двумерное нормальное распределение с корреляцией 0.95 (эллипсы расстояния 1 и 2) и первые 40 полных шагов сэмплирования по Гиббсу из точки (−2.4, −2.4). Каждое обновление меняет одну координату, выбирая её из условного распределения при другой, поэтому цепь движется только по осям. Узкий диагональный эллипс позволяет лишь короткие шаги, и цепь медленно ползёт вдоль диагонали: соседние значения сильно коррелированы (ρ² = 0.90 на шаг).'
    : 'A bivariate normal with correlation 0.95 (ellipses of distance 1 and 2) and the first 40 full sweeps of Gibbs sampling from (−2.4, −2.4). Each update changes one coordinate, drawn from its conditional distribution given the other, so the chain only moves along the axes. The narrow diagonal ellipse allows only short moves, and the chain crawls along the diagonal: successive values are strongly correlated (ρ² = 0.90 per sweep).'}
>
  {layouts.map((L) => {
    const sx = scale([-3, 3], [L.x0, L.x1]), sy = scale([-3, 3], [L.y1, L.y0]);
    const P = (q: [number, number][]) => polyline(q.map(([a, b]) => [sx(a), sy(b)]));
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Зигзаг Гиббса внутри узкого эллипса' : 'The Gibbs zigzag inside a narrow ellipse'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Ступенчатая траектория из горизонтальных и вертикальных отрезков вдоль диагонального эллипса.' : 'A staircase path of horizontal and vertical segments along a diagonal ellipse.'}</desc>
        <path class="f-grid" d={`M ${sx(-3)} ${sy(0)} H ${sx(3)} M ${sx(0)} ${sy(-3)} V ${sy(3)}`} />
        <path class="f-line f-blue" d={P(ell(1))} />
        <path class="f-line f-blue f-dash" d={P(ell(2))} />
        <path class="f-thin f-red" style="stroke-width: 1.3" d={P(path)} />
        <circle cx={sx(path[0][0])} cy={sy(path[0][1])} r="4" class="f-solid-red" />
        <text class="f-note f-halo" x={sx(path[0][0]) + 8} y={sy(path[0][1]) + 16}>{ru ? 'старт' : 'start'}</text>
        <text class="f-note" x={sx(3)} y={sy(0) + 16} text-anchor="end">x₁</text>
        <text class="f-note" x={sx(0) + 6} y={sy(3) + 12}>x₂</text>
      </svg>
    );
  })}
</Figure>
