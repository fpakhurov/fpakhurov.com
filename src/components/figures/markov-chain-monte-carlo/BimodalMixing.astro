---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { mulberry32, normal } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A target with two modes, an equal mixture of N(−3, 0.6²) and N(3, 0.6²). Random-walk Metropolis from x = −3 with a small
// and with a large step; 2,000 states each. The small-step chain never leaves the first mode.
const logp = (x: number) => Math.log(0.5 * Math.exp(-((x + 3) ** 2) / 0.72) + 0.5 * Math.exp(-((x - 3) ** 2) / 0.72));
const run = (step: number, seed: number) => {
  const u = mulberry32(seed), z = normal(u);
  let x = -3, lp = logp(x);
  return Array.from({ length: 2000 }, () => { const y = x + step * z(), ly = logp(y); if (Math.log(u()) < ly - lp) { x = y; lp = ly; } return x; });
};
const chains = [run(0.5, 41), run(4, 42)];
const right = chains.map((c) => c.filter((x) => x > 0).length / c.length);
if (right[0] > 0 || right[1] < 0.3 || right[1] > 0.7) throw new Error('BimodalMixing: the seeded chains no longer show the contrast');
const t = ru
  ? { names: [`шаг 0.5: в правой моде ${(right[0] * 100).toFixed(0)}% времени`, `шаг 4: в правой моде ${(right[1] * 100).toFixed(0)}% времени`] }
  : { names: [`step 0.5: ${(right[0] * 100).toFixed(0)}% of the time in the right mode`, `step 4: ${(right[1] * 100).toFixed(0)}% of the time in the right mode`] };
const id = 'bimodal-mixing';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 250, pos: (k: number) => [40, 30 + k * 110], pw: 700, ph: 80 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 280, pos: (k: number) => [28, 40 + k * 124], pw: 320, ph: 84 },
];
---

<Figure
  id={id}
  title={ru ? 'Цепь, застрявшая в одной моде' : 'A chain stuck in one mode'}
  caption={ru
    ? 'Целевое распределение — смесь двух нормальных с центрами −3 и 3 и одинаковыми весами. Обе цепи начинают в −3. С шагом 0.5 цепь за 2000 шагов ни разу не переходит во вторую моду, и её выборка выглядит как сэмплы одного нормального распределения: по ней нельзя заметить, что половина вероятности пропущена. С шагом 4 предложения перепрыгивают провал между модами, и цепь проводит в каждой примерно половину времени.'
    : 'The target is an equal mixture of two normals centred at −3 and 3. Both chains start at −3. With step 0.5 the chain never reaches the second mode in 2,000 steps, and its samples look like draws from a single normal: nothing in them reveals that half of the probability is missing. With step 4 proposals jump the gap between the modes, and the chain spends about half its time in each.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Две траектории для двухмодального распределения' : 'Two traces for a two-mode target'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'Верхняя линия всё время около −3; нижняя прыгает между −3 и 3.' : 'The top line stays near −3; the bottom one jumps between −3 and 3.'}</desc>
      {chains.map((c, k) => {
        const [x0, y0] = L.pos(k);
        const sx = scale([0, 1999], [x0, x0 + L.pw]), sy = scale([-5, 5], [y0 + L.ph, y0]);
        return (
          <g>
            <text class="f-small" x={x0} y={y0 - 8}>{t.names[k]}</text>
            {[-3, 3].map((v) => <g><path class="f-thin f-amber f-dash" d={`M ${x0} ${sy(v)} H ${x0 + L.pw}`} /><text class="f-note" x={x0 - 6} y={sy(v) + 5} text-anchor="end">{v}</text></g>)}
            <path class="f-thin f-blue" d={polyline(c.map((x, i) => [sx(i), sy(Math.max(-5, Math.min(5, x)))]))} />
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
