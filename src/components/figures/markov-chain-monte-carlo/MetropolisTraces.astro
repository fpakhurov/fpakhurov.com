---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { mulberry32, normal } from '../random';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Random-walk Metropolis on a standard normal target with three proposal step sizes; the first 500 states of each chain.
const run = (step: number, seed: number) => {
  const u = mulberry32(seed), z = normal(u);
  let x = 0, acc = 0;
  const xs: number[] = [];
  for (let t = 0; t < 500; t++) {
    const y = x + step * z();
    if (Math.log(u()) < (x * x - y * y) / 2) { x = y; acc++; }
    xs.push(x);
  }
  return { xs, acc: acc / 500 };
};
const steps = [0.1, 2.4, 25];
const chains = steps.map((s, k) => run(s, 31 + k));
if (!(chains[0].acc > 0.9 && chains[1].acc > 0.3 && chains[1].acc < 0.6 && chains[2].acc < 0.15)) throw new Error('MetropolisTraces: acceptance rates are unusual');
const t = ru
  ? { names: ['шаг 0.1: малые шаги, почти все приняты', 'шаг 2.4: хорошее перемешивание', 'шаг 25: почти все отклонены'], acc: 'принято' }
  : { names: ['step 0.1: tiny moves, almost all accepted', 'step 2.4: good mixing', 'step 25: almost all rejected'], acc: 'accepted' };
const id = 'metropolis-traces';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 330, pos: (k: number) => [40, 30 + k * 100], pw: 700, ph: 70, wide: true },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 410, pos: (k: number) => [28, 56 + k * 132], pw: 320, ph: 72, wide: false },
];
---

<Figure
  id={id}
  title={ru ? 'Метрополис со слишком малым, хорошим и слишком большим шагом' : 'Metropolis with too small, good and too large steps'}
  caption={ru
    ? `Первые 500 состояний трёх цепей Метрополиса для стандартного нормального распределения. С шагом 0.1 принимается почти всё (${(chains[0].acc * 100).toFixed(0)}%), но цепь ползёт и за 500 шагов не успевает обойти распределение. С шагом 25 почти всё отклоняется (${(chains[2].acc * 100).toFixed(0)}%), и цепь подолгу стоит на месте. Шаг 2.4 принимает ${(chains[1].acc * 100).toFixed(0)}% предложений и быстро пробегает всё распределение.`
    : `The first 500 states of three Metropolis chains for a standard normal target. With step 0.1 almost every proposal is accepted (${(chains[0].acc * 100).toFixed(0)}%), but the chain crawls and does not cover the distribution in 500 steps. With step 25 almost every proposal is rejected (${(chains[2].acc * 100).toFixed(0)}%) and the chain sits still for long stretches. Step 2.4 accepts ${(chains[1].acc * 100).toFixed(0)}% of proposals and runs over the whole distribution quickly.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Три траектории цепей' : 'Three chain traces'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'Медленно дрейфующая линия, быстро колеблющаяся линия и ступенчатая линия с долгими площадками.' : 'A slowly drifting line, a rapidly oscillating line and a step-like line with long flat stretches.'}</desc>
      {chains.map((c, k) => {
        const [x0, y0] = L.pos(k);
        const sx = scale([0, 499], [x0, x0 + L.pw]), sy = scale([-3, 3], [y0 + L.ph, y0]);
        return (
          <g>
            {L.wide
              ? <text class="f-small" x={x0} y={y0 - 8}>{`${t.names[k]} · ${t.acc} ${(c.acc * 100).toFixed(0)}%`}</text>
              : <g><text class="f-small" x={x0} y={y0 - 26}>{t.names[k]}</text><text class="f-note" x={x0} y={y0 - 8}>{`${t.acc} ${(c.acc * 100).toFixed(0)}%`}</text></g>}
            <path class="f-grid" d={`M ${x0} ${sy(0)} H ${x0 + L.pw}`} />
            <path class="f-thin f-blue" d={polyline(c.xs.map((x, i) => [sx(i), sy(Math.max(-3, Math.min(3, x)))]))} />
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
