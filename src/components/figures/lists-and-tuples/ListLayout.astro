---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Five appends to an empty list in CPython 3.14.7, replayed with the growth rule of Objects/listobject.c.
// sys.getsizeof gives 56 bytes for [], 88 after appends 1–4 (4 slots) and 120 after the fifth (8 slots).
const grow = (newsize: number, oldsize: number) => {
  let a = (newsize + (newsize >> 3) + 6) & ~3;
  if (newsize - oldsize > a - newsize) a = (newsize + 3) & ~3;
  return a;
};
const values = [10, 20, 30, 40, 50];
const caps: number[] = [];
{
  let cap = 0;
  values.forEach((_, i) => { if (i + 1 > cap) cap = grow(i + 1, i); caps.push(cap); });
}
if (caps.join() !== '4,4,4,4,8') throw new Error(`ListLayout: capacities ${caps}`);
if ([56 + 8 * caps[0], 56 + 8 * caps[4]].join() !== '88,120') throw new Error('ListLayout: getsizeof');

const t = ru
  ? { list: 'list: длина · ёмкость · items', obj: 'объекты int', empty: 'xs = []: длина 0, ёмкость 0',
      a1: 'ёмкость 4: длина 1, затем 4', a2: 'освобождён на шаге 4',
      b1: 'ёмкость 8: 4 ссылки скопированы, 50 добавлено', b2: 'xs[4]: ячейка по адресу items + 8·4 → 50',
      code3: ['xs.append(20)', 'xs.append(30)', 'xs.append(40)'],
      steps: ['пустой список: заголовок без массива', 'первое добавление выделяет 4 ячейки', 'добавления 2–4 занимают запасные ячейки без выделения памяти', 'места нет: новый массив на 8 ячеек, 4 ссылки копируются', 'индекс — это адрес: xs[4] читает ячейку 4 сразу'] }
  : { list: 'list: size · capacity · items', obj: 'int objects', empty: 'xs = []: size 0, capacity 0',
      a1: 'capacity 4: size 1, then 4', a2: 'freed at step 4',
      b1: 'capacity 8: 4 references copied, 50 added', b2: 'xs[4] reads the slot at items + 8·4 → 50',
      code3: ['xs.append(20)', 'xs.append(30)', 'xs.append(40)'],
      steps: ['an empty list: a header and no array', 'the first append allocates 4 slots', 'appends 2 to 4 fill the spare slots, no allocation', 'no room: a new array of 8 slots, 4 references copied', 'an index is an address: xs[4] reads slot 4 directly'] };

interface Layout {
  cls: string; W: number; H: number; sans: number; mono: number;
  codeX: number; codeY: number[]; badges: boolean[];
  nameX: number; headX: number; headW: number; headY: number; headH: number; empty: [number, number];
  x0: number; cw: number; ch: number; yA: number; yO: number; yB: number; ow: number; oh: number;
  railX: number; a1: [number, number]; a2: [number, number]; objLabX: number; bX: number; bY: number;
}
// Code lines: xs = [], three appends for step 3, append(50), xs[4]; one badge per step.
const badges = [true, true, true, false, false, true, true];
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 392, sans: 6.5, mono: 7.5, codeX: 44, codeY: [57, 136, 160, 180, 200, 316, 370], badges,
    nameX: 200, headX: 262, headW: 230, headY: 36, headH: 34, empty: [500, 57],
    x0: 300, cw: 46, ch: 30, yA: 116, yO: 204, yB: 296, ow: 40, oh: 26,
    railX: 280, a1: [500, 128], a2: [500, 148], objLabX: 540, bX: 300, bY: 348 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 540, sans: 7.3, mono: 8.4, codeX: 34, codeY: [42, 64, 86, 108, 130, 152, 174], badges,
    nameX: 8, headX: 56, headW: 260, headY: 214, headH: 34, empty: [56, 204],
    x0: 64, cw: 34, ch: 30, yA: 288, yO: 368, yB: 448, ow: 30, oh: 26,
    railX: 48, a1: [100, 278], a2: [208, 308], objLabX: 240, bX: 16, bY: 502 },
];
const codeLines = ['xs = []', 'xs.append(10)', ...t.code3, 'xs.append(50)', 'xs[4]'];
const codeStep = [1, 2, 3, 3, 3, 4, 5];
for (const L of layouts) {
  const right = L.W - 4;
  const fits = (s: string, x: number, w: number) => { if (x + s.length * w > right) throw new Error(`"${s}" overflows at ${L.W}`); };
  if (L.x0 + 8 * L.cw > right) throw new Error(`row B overflows at ${L.W}`);
  fits(t.a1, L.a1[0], L.sans); fits(t.a2, L.a2[0], L.sans); fits(t.empty, L.empty[0], L.sans);
  fits(t.obj, L.objLabX, L.sans); fits(t.b1, L.bX, L.sans); fits(t.b2, L.bX, L.sans);
  if (L.a2[0] < L.x0 + 4 * L.cw + 8 && L.a2[1] > L.yA - 4 && L.a2[1] < L.yA + L.ch + 14) throw new Error('freed label overlaps row A');
  if (L.a1[1] < L.yA && L.a1[1] < L.headY + L.headH + 14) throw new Error('row A label overlaps the header');
  if (L.objLabX < L.x0 + 4.5 * L.cw + L.ow / 2 + 6) throw new Error('object label overlaps 50');
  if (L.headX + 10 + t.list.length * L.sans > L.headX + L.headW) throw new Error('header text overflows');
  if (L.bY + 30 > L.H) throw new Error('labels below row B do not fit');
  if (L.codeX < L.nameX) { for (const s of codeLines) if (L.codeX + s.length * L.mono > L.nameX - 10) throw new Error(`code "${s}" runs into the name`); }
  else for (const s of codeLines) fits(s, L.codeX, L.mono);
  if (L.codeX > L.nameX && L.codeY[6] + 20 > L.empty[1]) throw new Error('code runs into the diagram');
}
const id = 'list-layout';
---

<Figure
  id={id}
  title={ru ? 'Список — это динамический массив ссылок' : 'A list is a dynamic array of references'}
  caption={ru
    ? 'Пять добавлений в пустой список в CPython 3.14.7. Объект списка хранит длину, ёмкость и указатель items на отдельный массив ячеек; каждая ячейка — 8-байтовая ссылка на объект, лежащий в другом месте. Первое добавление выделяет 4 ячейки (2), следующие три пишут в запасные ячейки (3). Пятому места нет: выделяется массив на 8 ячеек, 4 ссылки копируются, старый массив освобождается (4); сами числа не копируются. Ёмкости 4 и 8 следуют из правила роста в Objects/listobject.c, и sys.getsizeof подтверждает их: 88 и 120 байт. Индекс вычисляет адрес ячейки (5), поэтому xs[i] стоит одинаково при любой длине.'
    : 'Five appends to an empty list in CPython 3.14.7. The list object holds a size, a capacity and a pointer, items, to a separate array of slots; each slot is an 8-byte reference to an object stored elsewhere. The first append allocates 4 slots (2), the next three write into spare slots (3). The fifth finds no room: an array of 8 slots is allocated, 4 references are copied and the old array is freed (4); the numbers themselves are not copied. The capacities 4 and 8 follow from the growth rule in Objects/listobject.c, and sys.getsizeof confirms them: 88 and 120 bytes. An index computes the address of a slot (5), so xs[i] costs the same at any length.'}
>
  {layouts.map((L) => {
    const cx = (i: number) => L.x0 + i * L.cw + L.cw / 2;
    const headMid = L.headY + L.headH / 2;
    const slot = (x: number, y: number, step: string, filled: boolean, bold = false) => (
      <g data-s={step}>
        <rect x={x} y={y} width={L.cw} height={L.ch} style={`fill: ${toneVar.h}; fill-opacity: ${filled ? 0.16 : 0.04}; stroke: ${bold ? 'var(--fig-amber)' : toneVar.h}; stroke-width: ${bold ? 2.6 : 1.2}`} />
        {filled && <circle cx={x + L.cw / 2} cy={y + L.ch / 2} r="3.4" class="f-solid-blue" />}
      </g>
    );
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Объект списка, массив ячеек и объекты, на которые они ссылаются' : 'A list object, its array of slots and the objects they refer to'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Имя xs указывает на заголовок списка. Заголовок указывает сначала на массив из 4 ячеек, потом на массив из 8 ячеек. Между массивами — пять объектов int: 10, 20, 30, 40, 50; из заполненных ячеек к ним идут стрелки. Старый массив из 4 ячеек помечен как освобождённый, ячейка 4 нового массива выделена.'
          : 'The name xs points to the list header. The header points first to an array of 4 slots, then to an array of 8 slots. Between the arrays are five int objects, 10, 20, 30, 40 and 50, with arrows to them from the filled slots. The old 4-slot array is marked as freed, and slot 4 of the new array is highlighted.'}</desc>
        {codeLines.map((s, i) => (
          <g data-s={String(codeStep[i])}>
            {L.badges[i] && <Badge x={L.codeX - 18} y={L.codeY[i] - 5} n={codeStep[i]} />}
            <text class="f-small" x={L.codeX} y={L.codeY[i]} style="font-family: var(--mono)">{s}</text>
          </g>
        ))}
        <g data-s="1">
          <rect x={L.nameX} y={L.headY + 2} width={32} height={L.headH - 4} rx="5" style={`fill: ${toneVar.x}; fill-opacity: 0.14; stroke: ${toneVar.x}; stroke-width: 1.3`} />
          <text class="f-label" x={L.nameX + 16} y={headMid + 5} text-anchor="middle" style="font-family: var(--mono)">xs</text>
          <path class="f-line f-green" d={`M ${L.nameX + 34} ${headMid} H ${L.headX - 4}`} marker-end="url(#f-arrow-green)" />
          <rect x={L.headX} y={L.headY} width={L.headW} height={L.headH} rx="6" style={`fill: ${toneVar.h}; fill-opacity: 0.1; stroke: ${toneVar.h}; stroke-width: 1.3`} />
          <text class="f-small" x={L.headX + 10} y={headMid + 4.5}>{t.list}</text>
          <text class="f-small f-t-muted" x={L.empty[0]} y={L.empty[1]}>{t.empty}</text>
        </g>
        <g data-s="2 3">
          <path class="f-line f-blue" d={`M ${cx(0)} ${L.headY + L.headH} V ${L.yA - 4}`} marker-end="url(#f-arrow-blue)" />
          {[0, 1, 2, 3].map((i) => slot(L.x0 + i * L.cw, L.yA, i === 0 ? '2' : '3', true))}
          <text class="f-small f-t-muted" x={L.a1[0]} y={L.a1[1]}>{t.a1}</text>
        </g>
        {values.map((v, i) => (
          <g data-s={['2', '3', '3', '3', '4'][i]}>
            <rect x={cx(i) - L.ow / 2} y={L.yO} width={L.ow} height={L.oh} rx="4" class="f-box-soft" />
            <text class="f-small" x={cx(i)} y={L.yO + L.oh / 2 + 4.5} text-anchor="middle">{v}</text>
          </g>
        ))}
        <text class="f-small f-t-muted" x={L.objLabX} y={L.yO + L.oh / 2 + 4.5} data-s="2">{t.obj}</text>
        {[0, 1, 2, 3].map((i) => (
          <path data-s={i === 0 ? '2' : '3'} class="f-line f-blue" d={`M ${cx(i)} ${L.yA + L.ch / 2 + 5} V ${L.yO - 4}`} marker-end="url(#f-arrow-blue)" />
        ))}
        <g data-s="4">
          <text class="f-small f-t-red" x={L.a2[0]} y={L.a2[1]}>{t.a2}</text>
          <path class="f-line f-red" d={`M ${L.x0 - 4} ${L.yA - 4} L ${L.x0 + 4 * L.cw + 4} ${L.yA + L.ch + 4}`} />
          <path class="f-line f-blue" d={`M ${L.headX + 8} ${L.headY + L.headH} V ${L.headY + L.headH + 8} H ${L.railX} V ${L.yB + L.ch / 2} H ${L.x0 - 4}`} marker-end="url(#f-arrow-blue)" />
          {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => slot(L.x0 + i * L.cw, L.yB, '4', [0, 1, 2, 3, 4].includes(i)))}
          {[0, 1, 2, 3, 4].map((i) => (
            <path class="f-line f-blue" d={`M ${cx(i)} ${L.yB + L.ch / 2 - 5} V ${L.yO + L.oh + 4}`} marker-end="url(#f-arrow-blue)" />
          ))}
          <text class="f-small" x={L.bX} y={L.bY}>{t.b1}</text>
        </g>
        <g data-s="5">
          <rect x={L.x0 + 4 * L.cw} y={L.yB} width={L.cw} height={L.ch} style="fill: none; stroke: var(--fig-amber); stroke-width: 2.6" />
          <text class="f-small f-t-amber" x={L.bX} y={L.bY + 22}>{t.b2}</text>
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
