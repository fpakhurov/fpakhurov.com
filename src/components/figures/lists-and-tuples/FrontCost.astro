---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Measured once: CPython 3.14.7, Apple M1, macOS 26, nanoseconds per operation (the mean of a push and a pop,
// best of 5 runs of 2000 pairs) on a container that holds n items.
const data: [number, number, number, number][] = [
  // n, list insert(0)/pop(0), list append/pop, deque appendleft/popleft
  [1e3, 156.7, 14.4, 15.4], [3e3, 458.4, 14.6, 15.5], [1e4, 1618.5, 14.7, 15.7], [3e4, 5201.4, 14.6, 15.4],
  [1e5, 18582.6, 14.5, 15.4], [3e5, 56457.6, 14.6, 15.4], [1e6, 210712.0, 15.6, 16.6],
];
// The front operations grow linearly: the slope of log(time) against log(n) between the ends is close to 1.
const slope = Math.log10(data[6][1] / data[0][1]) / 3;
if (!(slope > 0.95 && slope < 1.1)) throw new Error(`FrontCost: slope ${slope}`);
for (const d of data) if (d[2] > 20 || d[3] > 20) throw new Error('FrontCost: end operations should stay flat');

const t = ru
  ? { x: 'число элементов n (лог. шкала)', y: 'нс на операцию (лог. шкала)', front: 'list: insert(0) / pop(0)', back: 'list: append / pop', dq: 'deque: appendleft / popleft', per: '≈ 0.2 нс на сдвиг одной ссылки' }
  : { x: 'number of items n (log scale)', y: 'ns per operation (log scale)', front: 'list: insert(0) / pop(0)', back: 'list: append / pop', dq: 'deque: appendleft / popleft', per: '≈ 0.2 ns per reference moved' };
interface Layout { cls: string; W: number; H: number; x0: number; x1: number; y0: number; y1: number; sans: number; leg: [number, number] }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 320, x0: 80, x1: 500, y0: 262, y1: 30, sans: 6.5, leg: [530, 60] },
  { cls: 'fig-narrow', W: 360, H: 420, x0: 56, x1: 340, y0: 262, y1: 30, sans: 6.5, leg: [20, 330] },
];
for (const L of layouts) for (const s of [t.front, t.back, t.dq]) if (L.leg[0] + 34 + s.length * L.sans > L.W - 4) throw new Error(`legend "${s}" overflows at ${L.W}`);
const id = 'front-cost';
---

<Figure
  id={id}
  title={ru ? 'Начало списка стоит O(n), его конец и оба конца deque — O(1)' : 'The front of a list costs O(n); its end and both ends of a deque cost O(1)'}
  caption={ru
    ? 'Время одной операции в зависимости от числа элементов, обе оси логарифмические; измерено один раз на Apple M1, CPython 3.14.7 (среднее из вставки и удаления, лучший из 5 прогонов по 2000 пар). Вставка и удаление в начале списка сдвигают все n ссылок, и время растёт пропорционально n: в 1000 раз больше элементов — в 1340 раз дольше, около 0.2 нс на ссылку. Добавление и удаление в конце списка и на обоих концах deque не зависят от n и стоят 14–17 нс.'
    : 'The time of one operation against the number of items, both axes logarithmic; measured once on an Apple M1, CPython 3.14.7 (the mean of an insertion and a removal, best of 5 runs of 2000 pairs). Inserting and removing at the front of a list shifts all n references, and the time grows in proportion to n: 1000 times more items take 1340 times longer, about 0.2 ns per reference. Appending and popping at the end of a list, and at either end of a deque, do not depend on n and cost 14–17 ns.'}
>
  {layouts.map((L) => {
    const sx = scale([3, 6], [L.x0, L.x1]), sy = scale([1, 6], [L.y0, L.y1]);
    const line = (k: number) => polyline(data.map((d) => [sx(Math.log10(d[0])), sy(Math.log10(d[k]))]));
    const series: [number, string, string][] = [[1, 'f-red', t.front], [2, 'f-blue', t.back], [3, 'f-green f-dash', t.dq]];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Время операции в зависимости от размера списка и deque' : 'Time per operation against the size of a list and a deque'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Красная линия insert(0) и pop(0) поднимается по прямой от 157 нс при тысяче элементов до 211 микросекунд при миллионе. Синяя линия append и pop и зелёная линия deque лежат горизонтально около 15 нс.'
          : 'The red line for insert(0) and pop(0) rises straight from 157 ns at a thousand items to 211 microseconds at a million. The blue line for append and pop and the green line for the deque lie flat near 15 ns.'}</desc>
        {[1, 2, 3, 4, 5, 6].map((e) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(e)} H ${L.x1}`} />
            <text class="f-small f-t-muted" x={L.x0 - 8} y={sy(e) + 4} text-anchor="end">{`10${'⁰¹²³⁴⁵⁶'[e]}`}</text>
          </g>
        ))}
        {[3, 4, 5, 6].map((e) => <text class="f-small f-t-muted" x={sx(e)} y={L.y0 + 18} text-anchor="middle">{`10${'⁰¹²³⁴⁵⁶'[e]}`}</text>)}
        <path class="f-axis" d={`M ${L.x0} ${L.y1 - 6} V ${L.y0} H ${L.x1 + 6}`} />
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y0 + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.x0 - 40} y={L.y1 - 14}>{t.y}</text>
        {series.map(([k, cls]) => (
          <g>
            <path class={`f-line ${cls}`} d={line(k)} />
            {data.map((d) => <circle cx={sx(Math.log10(d[0]))} cy={sy(Math.log10(d[k]))} r="3" class={`f-solid-${cls.split(' ')[0].slice(2)}`} />)}
          </g>
        ))}
        <text class="f-small f-t-red f-halo" x={L.x0 + 8} y={sy(5.5)}>{t.per}</text>
        {series.map(([, cls, label], i) => (
          <g>
            <path class={`f-line ${cls}`} d={`M ${L.leg[0]} ${L.leg[1] + i * 22 - 4} h 26`} />
            <text class="f-small" x={L.leg[0] + 34} y={L.leg[1] + i * 22}>{label}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
