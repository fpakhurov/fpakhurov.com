---
import Figure from '../Figure.astro';
import { scale, polyline, type Point } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Measured once on CPython 3.14.7, 64-bit macOS (arm64): appending None to an empty list one item at a time,
// the length at which sys.getsizeof(xs) changed and the capacity (getsizeof - 56) / 8 it changed to.
const measured: [number, number][] = [[1, 4], [5, 8], [9, 16], [17, 24], [25, 32], [33, 40], [41, 52], [53, 64], [65, 76], [77, 92], [93, 108], [109, 128], [129, 148]];
// The growth rule of list_resize in Objects/listobject.c (3.14).
const grow = (newsize: number, oldsize: number) => {
  let a = (newsize + (newsize >> 3) + 6) & ~3;
  if (newsize - oldsize > a - newsize) a = (newsize + 3) & ~3;
  return a;
};
const resizes: [number, number][] = [];
const ratio: Point[] = [];   // (n, references copied so far / n), sampled for the right panel
let cap = 0, copies = 0, worst = 0;
const N = 1_000_000;
const sampleAt = new Set<number>();
for (let e = 1; e <= 6; e += 0.02) sampleAt.add(Math.round(10 ** e));
for (let n = 1; n <= N; n += 1) {
  const jump = n > cap;
  if (jump) { copies += n - 1; cap = grow(n, n - 1); resizes.push([n, cap]); }
  const r = copies / n;
  if (n >= 10 && (jump || sampleAt.has(n) || n + 1 > cap)) ratio.push([n, r]);
  if (n > 1000) worst = Math.max(worst, r);
}
if (JSON.stringify(resizes.slice(0, measured.length)) !== JSON.stringify(measured)) throw new Error('ListGrowth: rule and measurement disagree');
if (copies !== 8445096) throw new Error(`ListGrowth: copies ${copies}`);
if (!(worst < 9 && worst > 8.99)) throw new Error(`ListGrowth: worst ratio ${worst}`);
for (let i = 1; i < resizes.length; i += 1) if (resizes[i][1] < (9 / 8) * resizes[i - 1][1]) throw new Error('ListGrowth: growth below 9/8');

const t = ru
  ? { titleL: 'ёмкость в зависимости от длины', titleR: 'скопировано ссылок на одно добавление', x: 'длина списка', xr: 'число добавлений n (лог. шкала)',
      cap: 'ёмкость', len: 'длина = ёмкость', bound: 'граница 9', meas: '8.45 при n = 10⁶' }
  : { titleL: 'capacity against length', titleR: 'references copied per append', x: 'length of the list', xr: 'number of appends n (log scale)',
      cap: 'capacity', len: 'length = capacity', bound: 'bound 9', meas: '8.45 at n = 10⁶' };

interface Panel { x: [number, number]; y: [number, number] }
interface Layout { cls: string; W: number; H: number; sans: number; L: Panel; R: Panel }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 330, sans: 6.5, L: { x: [64, 350], y: [44, 270] }, R: { x: [450, 736], y: [44, 270] } },
  { cls: 'fig-narrow', W: 360, H: 640, sans: 6.5, L: { x: [56, 340], y: [44, 260] }, R: { x: [56, 340], y: [370, 576] } },
];
for (const Ly of layouts) {
  for (const [P, s] of [[Ly.L, t.titleL], [Ly.R, t.titleR]] as [Panel, string][]) if (P.x[0] - 40 + s.length * Ly.sans > Ly.W - 2) throw new Error(`"${s}" overflows at ${Ly.W}`);
  if (Ly.R.x[1] - 4 - t.meas.length * Ly.sans < Ly.R.x[0]) throw new Error('meas label too long');
}
const staircase = (ax: (v: number) => number, ay: (v: number) => number) => {
  const pts: Point[] = [[ax(0), ay(0)]];
  let c = 0;
  for (const [n, k] of resizes.filter(([n]) => n <= 140)) { pts.push([ax(n), ay(c)], [ax(n), ay(k)]); c = k; }
  pts.push([ax(140), ay(c)]);
  return pts;
};
const id = 'list-growth';
---

<Figure
  id={id}
  title={ru ? 'Как растёт список: ёмкость и стоимость добавления' : 'How a list grows: capacity and the cost of appending'}
  caption={ru
    ? 'Слева: ёмкость списка (синяя ступенчатая линия) при добавлении элементов по одному, по правилу роста из Objects/listobject.c; красные точки — ёмкости, измеренные через sys.getsizeof в CPython 3.14.7 на 64-битной macOS (arm64), и все 13 совпадают с правилом. Пунктир — длина: расстояние до ступеньки — запасные ячейки. Справа: сколько ссылок скопировали все расширения массива, делённое на число добавлений n, если бы каждое расширение переносило массив. Пилообразная кривая остаётся ниже 9 (пунктир), как требует вывод в тексте; при n = 10⁶ это 8.45. Стоимость одного добавления в среднем постоянна.'
    : 'Left: the capacity of a list (blue staircase) as items are appended one at a time, by the growth rule of Objects/listobject.c; the red dots are the capacities measured with sys.getsizeof on CPython 3.14.7, 64-bit macOS (arm64), and all 13 agree with the rule. The dashed line is the length: the gap up to the staircase is the spare slots. Right: the references copied by all resizes so far, divided by the number of appends n, if every resize moved the array. The sawtooth stays below 9 (dashed), as the derivation in the text requires; at n = 10⁶ it is 8.45. The cost of one append is constant on average.'}
>
  {layouts.map((Ly) => {
    const { L: A, R: B } = Ly;
    const ax = scale([0, 140], A.x), ay = scale([0, 160], [A.y[1], A.y[0]]);
    const bx = scale([1, 6], B.x), by = scale([0, 10], [B.y[1], B.y[0]]);
    const stair = staircase(ax, ay);
    const saw = polyline(ratio.map(([n, r]) => [bx(Math.log10(n)), by(r)]));
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.W}-t ${id}-${Ly.W}-d`}>
        <title id={`${id}-${Ly.W}-t`}>{ru ? 'Ёмкость списка и число копирований на одно добавление' : 'List capacity and copies per append'}</title>
        <desc id={`${id}-${Ly.W}-d`}>{ru
          ? 'Слева ступенчатая линия ёмкости 0, 4, 8, 16, 24, 32, 40, 52, 64, 76, 92, 108, 128, 148 над диагональю длины, с измеренными точками на каждой ступеньке. Справа пилообразная кривая отношения копирований к числу добавлений, колеблется между 7 и 9 и остаётся ниже пунктирной линии 9.'
          : 'Left, a staircase of capacities 0, 4, 8, 16, 24, 32, 40, 52, 64, 76, 92, 108, 128, 148 above the diagonal of the length, with a measured dot on every step. Right, a sawtooth curve of copies per append that oscillates between 7 and 9 and stays below a dashed line at 9.'}</desc>
        {[0, 40, 80, 120, 160].map((v) => (
          <g>
            <path class="f-grid" d={`M ${A.x[0]} ${ay(v)} H ${A.x[1]}`} />
            <text class="f-small f-t-muted" x={A.x[0] - 8} y={ay(v) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        {[0, 35, 70, 105, 140].map((v) => <text class="f-small f-t-muted" x={ax(v)} y={A.y[1] + 18} text-anchor="middle">{v}</text>)}
        {[0, 3, 6, 9].map((v) => (
          <g>
            <path class="f-grid" d={`M ${B.x[0]} ${by(v)} H ${B.x[1]}`} />
            <text class="f-small f-t-muted" x={B.x[0] - 8} y={by(v) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        {[1, 2, 3, 4, 5, 6].map((e) => <text class="f-small f-t-muted" x={bx(e)} y={B.y[1] + 18} text-anchor="middle">{`10${'⁰¹²³⁴⁵⁶'[e]}`}</text>)}
        <path class="f-axis" d={`M ${A.x[0]} ${A.y[0] - 6} V ${A.y[1]} H ${A.x[1] + 6} M ${B.x[0]} ${B.y[0] - 6} V ${B.y[1]} H ${B.x[1] + 6}`} />
        <text class="f-small" x={A.x[0] - 40} y={A.y[0] - 18} style="font-weight: 650">{t.titleL}</text>
        <text class="f-small" x={B.x[0] - 40} y={B.y[0] - 18} style="font-weight: 650">{t.titleR}</text>
        <text class="f-small f-t-muted" x={(A.x[0] + A.x[1]) / 2} y={A.y[1] + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={(B.x[0] + B.x[1]) / 2} y={B.y[1] + 38} text-anchor="middle">{t.xr}</text>
        <path class="f-line f-muted f-dash" d={`M ${ax(0)} ${ay(0)} L ${ax(140)} ${ay(140)}`} />
        <path class="f-line f-blue" d={polyline(stair)} />
        {measured.map(([n, k]) => <circle cx={ax(n)} cy={ay(k)} r="3.4" class="f-solid-red" />)}
        <text class="f-small f-t-blue f-halo" x={ax(4)} y={ay(46)}>{t.cap}</text>
        <text class="f-small f-t-muted f-halo" x={ax(84)} y={ay(64)}>{t.len}</text>
        <path class="f-line f-red f-dash" d={`M ${B.x[0]} ${by(9)} H ${B.x[1]}`} />
        <path class="f-line f-blue" d={saw} />
        <text class="f-small f-t-red f-halo" x={B.x[0] + 8} y={by(9) - 8}>{t.bound}</text>
        <text class="f-small f-t-blue f-halo" x={B.x[1] - 4} y={by(6) + 4} text-anchor="end">{t.meas}</text>
      </svg>
    );
  })}
</Figure>
