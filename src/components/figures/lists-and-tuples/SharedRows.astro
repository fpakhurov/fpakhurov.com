---
import Figure from '../Figure.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Left: rows = [[1, 2], [3, 4]]; shallow = rows.copy(); deep = copy.deepcopy(rows).
// Right: [[0] * 3] * 3 against [[0] * 3 for _ in range(3)]. Replayed here: which inner list each outer slot refers to.
{
  const a = [1, 2], b = [3, 4];
  const rows = [a, b], shallow = [...rows], deep = rows.map((r) => [...r]);
  if (shallow[0] !== rows[0] || deep[0] === rows[0] || shallow === rows) throw new Error('SharedRows: copies');
  const inner = [0, 0, 0];
  const grid = [inner, inner, inner];
  grid[0][0] = 1;
  if (grid.map((r) => r.join('')).join() !== '100,100,100') throw new Error('SharedRows: trap');
}

const t = ru
  ? { copies: 'копии', rep: 'повторение', shallowNote: 'rows.copy(): новый внешний список, те же строки', deepNote: 'deepcopy: новые внутренние списки тоже',
      same: 'grid[0] is grid[1] → True', diff: 'grid[0] is grid[1] → False' }
  : { copies: 'copies', rep: 'repetition', shallowNote: 'rows.copy(): a new outer list, the same rows', deepNote: 'deepcopy: new inner lists as well',
      same: 'grid[0] is grid[1] → True', diff: 'grid[0] is grid[1] → False' };

const cw = 30, ch = 26, nameW = 68;
// One geometry for the right panel, drawn at (dx, dy): beside the left panel when wide, under it when narrow.
interface Layout { cls: string; W: number; H: number; sans: number; mono: number; dx: number; dy: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 348, sans: 6.5, mono: 7.5, dx: 400, dy: 0 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 700, sans: 7.3, mono: 8.4, dx: 10, dy: 352 },
];
const codeTop = '[[0] * 3] * 3', codeBot = '[[0] * 3 for _ in range(3)]';
for (const L of layouts) {
  const leftW = L.dx > 100 ? L.dx - 20 : L.W - 4;
  for (const s of [t.shallowNote, t.deepNote]) if (10 + s.length * L.sans > leftW) throw new Error(`"${s}" overflows at ${L.W}`);
  for (const s of [codeBot, t.same, t.diff]) if (L.dx + s.length * L.mono > L.W - 4) throw new Error(`"${s}" overflows at ${L.W}`);
  if (L.dx + 220 + 3 * cw > L.W - 4) throw new Error('inner lists overflow');
  for (const s of ['shallow', 'deep', 'rows', 'grid']) if (s.length * L.mono > nameW - 8) throw new Error(`name ${s} overflows its box`);
}
const id = 'shared-rows';
---

<Figure
  id={id}
  title={ru ? 'Что копирует копия и что повторяет *' : 'What a copy copies and what * repeats'}
  caption={ru
    ? 'Слева: rows.copy() создаёт новый внешний список, но его ячейки ссылаются на те же внутренние списки, что и ячейки rows, поэтому rows[0].append(99) видно и через rows, и через shallow. copy.deepcopy(rows) копирует и внутренние списки. Справа: [[0] * 3] * 3 повторяет ссылку на один внутренний список три раза, и запись в grid[0][0] видна во всех трёх строках; включение вычисляет [0] * 3 заново для каждой строки. Для краткости ячейки внутренних списков показаны со значениями чисел, хотя и они хранят ссылки.'
    : 'Left: rows.copy() creates a new outer list, but its slots refer to the same inner lists as the slots of rows, so rows[0].append(99) is seen through both. copy.deepcopy(rows) copies the inner lists too. Right: [[0] * 3] * 3 repeats a reference to one inner list three times, and a write to grid[0][0] shows in all three rows; the comprehension evaluates [0] * 3 afresh for every row. For brevity the cells of the inner lists show the numbers, although they too hold references.'}
>
  {layouts.map((L) => {
    const name = (x: number, y: number, s: string) => (
      <g>
        <rect x={x} y={y} width={nameW} height={ch} rx="5" style={`fill: ${toneVar.x}; fill-opacity: 0.14; stroke: ${toneVar.x}; stroke-width: 1.3`} />
        <text class="f-small" x={x + nameW / 2} y={y + ch / 2 + 4.5} text-anchor="middle" style="font-family: var(--mono)">{s}</text>
      </g>
    );
    const outer = (x: number, y: number, n: number) => Array.from({ length: n }, (_, i) => (
      <g>
        <rect x={x + i * cw} y={y} width={cw} height={ch} style={`fill: ${toneVar.h}; fill-opacity: 0.16; stroke: ${toneVar.h}; stroke-width: 1.2`} />
        <circle cx={x + i * cw + cw / 2} cy={y + ch / 2} r="3.2" class="f-solid-blue" />
      </g>
    ));
    const inner = (x: number, y: number, vals: string[], tone = toneVar.h) => vals.map((v, i) => (
      <g>
        <rect x={x + i * cw} y={y} width={cw} height={ch} style={`fill: ${tone}; fill-opacity: 0.08; stroke: ${tone}; stroke-width: 1.2`} />
        <text class="f-small" x={x + i * cw + cw / 2} y={y + ch / 2 + 4.5} text-anchor="middle">{v}</text>
      </g>
    ));
    const arrow = (x1: number, y1: number, x2: number, y2: number, cls = 'f-blue') => (
      <path class={`f-line ${cls}`} d={`M ${x1} ${y1} L ${x2} ${y2}`} marker-end={`url(#f-arrow-${cls.slice(2)})`} />
    );
    const link = (nx: number, y: number, ox: number) => <path class="f-line f-green" d={`M ${nx + nameW + 2} ${y + ch / 2} H ${ox - 4}`} marker-end="url(#f-arrow-green)" />;
    const ox = 100, ix = 230;
    // left panel rows: name y, outer y; inner lists A, B (shared) and A', B' (deep)
    const yr = 48, ys = 104, yd = 214, yA = 40, yB = 128, yA2 = 196, yB2 = 248;
    const sc = (i: number) => ox + i * cw + cw / 2;
    const R = { x: L.dx, y: L.dy };
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Поверхностная и глубокая копия; повторение ссылки на строку' : 'Shallow and deep copy; a repeated reference to a row'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Слева имена rows и shallow указывают на два разных внешних списка, ячейки которых указывают на одни и те же внутренние списки [1, 2] и [3, 4]; имя deep указывает на внешний список со своими копиями этих списков. Справа внешний список из [[0] * 3] * 3 имеет три ячейки, и все три стрелки идут к одному списку [0, 0, 0]; во втором варианте три стрелки идут к трём разным спискам.'
          : 'Left, the names rows and shallow point to two different outer lists whose slots point to the same inner lists [1, 2] and [3, 4]; the name deep points to an outer list with its own copies of those lists. Right, the outer list of [[0] * 3] * 3 has three slots whose arrows all go to one list [0, 0, 0]; in the second version the three arrows go to three different lists.'}</desc>
        <text class="f-small f-t-muted" x="10" y="20" style="font-weight: 650">{t.copies}</text>
        {name(10, yr, 'rows')}{link(10, yr, ox)}{outer(ox, yr, 2)}
        {name(10, ys, 'shallow')}{link(10, ys, ox)}{outer(ox, ys, 2)}
        {name(10, yd, 'deep')}{link(10, yd, ox)}{outer(ox, yd, 2)}
        {inner(ix, yA, ['1', '2'])}{inner(ix, yB, ['3', '4'])}
        {inner(ix, yA2, ['1', '2'], 'var(--fig-amber)')}{inner(ix, yB2, ['3', '4'], 'var(--fig-amber)')}
        {arrow(sc(0), yr + ch / 2, ix - 4, yA + ch / 2)}{arrow(sc(1), yr + ch / 2, ix - 4, yB + 6)}
        {arrow(sc(0), ys + ch / 2, ix - 4, yA + ch - 4)}{arrow(sc(1), ys + ch / 2, ix - 4, yB + ch / 2)}
        {arrow(sc(0), yd + ch / 2, ix - 4, yA2 + ch / 2, 'f-amber')}{arrow(sc(1), yd + ch / 2, ix - 4, yB2 + ch / 2, 'f-amber')}
        <text class="f-small" x="10" y="306">{t.shallowNote}</text>
        <text class="f-small f-t-amber" x="10" y="328">{t.deepNote}</text>
        <g transform={`translate(${R.x - 400} ${R.y})`}>
          <text class="f-small f-t-muted" x="400" y="20" style="font-weight: 650">{t.rep}</text>
          <text class="f-small" x="400" y="40" style="font-family: var(--mono)">{codeTop}</text>
          {name(400, 52, 'grid')}{link(400, 52, 480)}{outer(480, 52, 3)}
          {inner(620, 96, ['0', '0', '0'], 'var(--fig-red)')}
          {[0, 1, 2].map((i) => arrow(495 + i * cw, 65, 616, 104 + i * 4, 'f-red'))}
          <text class="f-small f-t-red" x="400" y="150" style="font-family: var(--mono)">{t.same}</text>
          <text class="f-small" x="400" y="190" style="font-family: var(--mono)">{codeBot}</text>
          {name(400, 204, 'grid')}{link(400, 204, 480)}{outer(480, 204, 3)}
          {[0, 1, 2].map((i) => inner(620, 200 + i * 40, ['0', '0', '0']))}
          {[0, 1, 2].map((i) => arrow(495 + i * cw, 217, 616, 213 + i * 40))}
          <text class="f-small" x="400" y="336" style="font-family: var(--mono)">{t.diff}</text>
        </g>
      </svg>
    );
  })}
</Figure>
