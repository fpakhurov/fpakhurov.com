---
import Figure from '../Figure.astro';
import { plot, area, scale, gaussian, normals, type Point } from '../geometry';

const id = 'vae-joint-marginals';

// Joint p(x, z): a mixture of two correlated bivariate Gaussians on x ∈ [0, 10].
type Comp = { w: number; mx: number; mz: number; sx: number; sz: number; rho: number };
const comps: Comp[] = [
  { w: 0.6, mx: 3.4, mz: 4.2, sx: 1.2, sz: 1.0, rho: 0.6 },
  { w: 0.4, mx: 7.0, mz: 2.2, sx: 1.0, sz: 0.8, rho: -0.45 },
];
const px = (x: number) => comps.reduce((s, c) => s + c.w * gaussian(x, c.mx, c.sx), 0);
const pz = (z: number) => comps.reduce((s, c) => s + c.w * gaussian(z, c.mz, c.sz), 0);
const z0 = 3;
// Conditional p(x | z = z0): the slice of the joint renormalized by p(z0).
const pxGivenZ = (x: number) =>
  comps.reduce((s, c) => {
    const m = c.mx + (c.rho * c.sx * (z0 - c.mz)) / c.sz;
    const sd = c.sx * Math.sqrt(1 - c.rho * c.rho);
    return s + c.w * gaussian(z0, c.mz, c.sz) * gaussian(x, m, sd);
  }, 0) / pz(z0);

// Seeded samples from the joint.
const n = normals(640, 11);
const samples: Point[] = [];
for (let i = 0; i < 320; i += 1) {
  const c = comps[i < 192 ? 0 : 1];
  const a = n[2 * i];
  const b = n[2 * i + 1];
  samples.push([c.mx + c.sx * a, c.mz + c.sz * (c.rho * a + Math.sqrt(1 - c.rho * c.rho) * b)]);
}

// Layout: joint panel, p(z) to the left of the z axis, p(x) below the x axis.
// Wide: formula notes sit left of the panel. Narrow: they move below the plot so the text keeps its size.
const layouts = [
  { cls: 'fig-medium fig-wide', s: 'w', vb: '0 0 600 362', L: 150, R: 570, T: 34, B: 262, hx: 64, hz: 62, hc: 64, tip: 26, notesY: null as number | null },
  { cls: 'fig-narrow', s: 'n', vb: '0 0 360 362', L: 84, R: 340, T: 34, B: 230, hx: 52, hz: 58, hc: 50, tip: 20, notesY: 326 as number | null },
].map((v) => {
  const sx = scale([0, 10], [v.L, v.R]);
  const sz = scale([0, 7], [v.B, v.T]);
  const kx = v.hx / 0.22; // marginal heights in screen units
  const kz = v.hz / 0.26;
  const pxPath = plot(px, 0, 10, sx, (y) => v.B + 12 + kx * y, 200);
  const pzPts: string[] = [];
  for (let i = 0; i <= 160; i += 1) {
    const z = (7 * i) / 160;
    pzPts.push(`${i ? 'L' : 'M'} ${(v.L - 12 - kz * pz(z)).toFixed(1)} ${sz(z).toFixed(1)}`);
  }
  const pzPath = pzPts.join(' ');
  // Conditional slice drawn on top of the line z = 3 (height scaled for display).
  const kc = v.hc / 0.23;
  return {
    ...v,
    sx,
    sz,
    pxPath,
    pxArea: `${pxPath} L ${sx(10)} ${v.B + 12} L ${sx(0)} ${v.B + 12} Z`,
    pzPath,
    pzArea: `${pzPath} L ${v.L - 12} ${sz(7)} L ${v.L - 12} ${sz(0)} Z`,
    condPath: plot(pxGivenZ, 0, 10, sx, (y) => sz(z0) - kc * y, 200),
    condArea: area(pxGivenZ, 0, 10, sx, (y) => sz(z0) - kc * y, 200),
  };
});
const inside = samples.filter(([x, z]) => x > 0.1 && x < 9.9 && z > 0.1 && z < 6.9);
---

<Figure
  id={id}
  title="Joint, marginals and a conditional"
  caption="Grey dots are samples from a joint density p(x, z), here a mixture of two correlated Gaussians. Integrating the joint over z gives the marginal p(x) under the x axis; integrating over x gives p(z) to the left of the z axis. The amber curve is the slice along z = 3, rescaled by p(z = 3) so that it is a density in x: the conditional p(x | z = 3)."
>
  {layouts.map((v) => (
    <svg class={v.cls} viewBox={v.vb} role="img" aria-labelledby={`${id}-${v.s}-t ${id}-${v.s}-d`}>
      <title id={`${id}-${v.s}-t`}>Joint density with its marginals and one conditional slice</title>
      <desc id={`${id}-${v.s}-d`}>A scatter of samples in the x–z plane forms two tilted clouds, one around x = 3.4, z = 4.2 and one around x = 7, z = 2.2. Below the x axis, a red curve shows the marginal p(x) with two bumps. To the left of the z axis, a blue curve shows the marginal p(z). A horizontal dashed line at z = 3 carries an amber curve: the conditional density p(x given z = 3), which also has two bumps, one under each cloud.</desc>

      <!-- joint -->
      {inside.map(([x, z]) => <circle class="f-solid-muted" cx={v.sx(x).toFixed(1)} cy={v.sz(z).toFixed(1)} r="2" fill-opacity="0.45" />)}
      <path class="f-axis" d={`M ${v.L} ${v.B} H ${v.R + 16}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-axis" d={`M ${v.L} ${v.B} V ${v.T - 14}`} marker-end="url(#f-arrow-muted)" />
      <text class="f-math" x={v.R + 18} y={v.B + 24} text-anchor="end">x</text>
      <text class="f-math" x={v.L + 12} y={v.T - 4}>z</text>
      <text class="f-label f-halo" x={v.sx(2.0)} y={v.sz(6.45)}>joint p(x, z)</text>

      <!-- marginal p(z), drawn to the left -->
      <path class="f-fill-blue" d={v.pzArea} />
      <path class="f-line f-blue" d={v.pzPath} />
      <path class="f-thin f-muted" d={`M ${v.L - 12} ${v.sz(0)} V ${v.sz(7)}`} />
      <text class="f-math f-t-blue" x="12" y={v.sz(6.6)}>p(z)</text>

      <!-- marginal p(x), drawn below -->
      <path class="f-fill-red" d={v.pxArea} />
      <path class="f-line f-red" d={v.pxPath} />
      <text class="f-math f-t-red" x="12" y={v.B + 34}>p(x)</text>

      {v.notesY === null ? (
        <g>
          <text class="f-note" x="12" y={v.sz(6.6) + 20}>= ∫ p(x, z) dx</text>
          <text class="f-note" x="12" y={v.B + 54}>= ∫ p(x, z) dz</text>
          <text class="f-note" x="12" y={v.B + 74}>marginal: integrate</text>
          <text class="f-note" x="12" y={v.B + 92}>the other variable out</text>
        </g>
      ) : (
        <g>
          <text class="f-note" x="180" y={v.notesY} text-anchor="middle">p(x) = ∫ p(x, z) dz,  p(z) = ∫ p(x, z) dx</text>
          <text class="f-note" x="180" y={v.notesY + 20} text-anchor="middle">marginal: integrate the other variable out</text>
        </g>
      )}

      <!-- conditional slice at z = 3 -->
      <path class="f-thin f-amber f-dash" d={`M ${v.L} ${v.sz(z0)} H ${v.R}`} />
      <text class="f-math f-t-amber f-halo" x={v.L + 6} y={v.sz(z0) + 22}>z = 3</text>
      <path class="f-fill-amber" d={v.condArea} />
      <path class="f-line f-amber f-bold" d={v.condPath} />
      {v.notesY === null ? (
        <g>
          <text class="f-math f-t-amber f-halo" x={v.sx(8.0)} y={v.sz(5.6)}>p(x | z = 3)</text>
          <text class="f-note f-halo" x={v.sx(8.0)} y={v.sz(5.6) + 20}>= p(x, 3) / p(z = 3)</text>
        </g>
      ) : (
        <g>
          <text class="f-math f-t-amber f-halo" x={v.R} y={v.sz(5.6)} text-anchor="end">p(x | z = 3)</text>
          <text class="f-note f-halo" x={v.R} y={v.sz(5.6) + 20} text-anchor="end">= p(x, 3) / p(z = 3)</text>
        </g>
      )}
      <path class="f-thin" d={`M ${v.sx(8.6)} ${v.sz(5.6) + 28} Q ${v.sx(8.9)} ${v.sz(4.0)} ${v.sx(7.75)} ${v.sz(z0) - v.tip}`} marker-end="url(#f-arrow)" />
    </svg>
  ))}
</Figure>
