---
import Figure from '../Figure.astro';
import { plot, area, scale, gaussian, normals, type Point } from '../geometry';

const id = 'vae-joint-marginals';

// Joint p(x, z): a mixture of two correlated bivariate Gaussians on x ∈ [0, 10].
type Comp = { w: number; mx: number; mz: number; sx: number; sz: number; rho: number };
const comps: Comp[] = [
  { w: 0.6, mx: 3.4, mz: 4.2, sx: 1.2, sz: 1.0, rho: 0.6 },
  { w: 0.4, mx: 7.0, mz: 2.2, sx: 1.0, sz: 0.8, rho: -0.45 },
];
const px = (x: number) => comps.reduce((s, c) => s + c.w * gaussian(x, c.mx, c.sx), 0);
const pz = (z: number) => comps.reduce((s, c) => s + c.w * gaussian(z, c.mz, c.sz), 0);
const z0 = 3;
// Conditional p(x | z = z0): the slice of the joint renormalized by p(z0).
const pxGivenZ = (x: number) =>
  comps.reduce((s, c) => {
    const m = c.mx + (c.rho * c.sx * (z0 - c.mz)) / c.sz;
    const sd = c.sx * Math.sqrt(1 - c.rho * c.rho);
    return s + c.w * gaussian(z0, c.mz, c.sz) * gaussian(x, m, sd);
  }, 0) / pz(z0);

// Seeded samples from the joint.
const n = normals(640, 11);
const samples: Point[] = [];
for (let i = 0; i < 320; i += 1) {
  const c = comps[i < 192 ? 0 : 1];
  const a = n[2 * i];
  const b = n[2 * i + 1];
  samples.push([c.mx + c.sx * a, c.mz + c.sz * (c.rho * a + Math.sqrt(1 - c.rho * c.rho) * b)]);
}

// Layout: joint panel, p(z) to the left of the z axis, p(x) below the x axis.
const L = 150;
const R = 570;
const T = 34;
const B = 262;
const sx = scale([0, 10], [L, R]);
const sz = scale([0, 7], [B, T]);
const inside = samples.filter(([x, z]) => x > 0.1 && x < 9.9 && z > 0.1 && z < 6.9);
const kx = 64 / 0.22; // marginal heights in screen units
const kz = 62 / 0.26;
const pxPath = plot(px, 0, 10, sx, (v) => B + 12 + kx * v, 200);
const pxArea = `${pxPath} L ${sx(10)} ${B + 12} L ${sx(0)} ${B + 12} Z`;
const pzPts: string[] = [];
for (let i = 0; i <= 160; i += 1) {
  const z = (7 * i) / 160;
  pzPts.push(`${i ? 'L' : 'M'} ${(L - 12 - kz * pz(z)).toFixed(1)} ${sz(z).toFixed(1)}`);
}
const pzPath = pzPts.join(' ');
const pzArea = `${pzPath} L ${L - 12} ${sz(7)} L ${L - 12} ${sz(0)} Z`;
// Conditional slice drawn on top of the line z = 3 (height scaled for display).
const kc = 64 / 0.23;
const condPath = plot(pxGivenZ, 0, 10, sx, (v) => sz(z0) - kc * v, 200);
const condArea = area(pxGivenZ, 0, 10, sx, (v) => sz(z0) - kc * v, 200);
---

<Figure
  id={id}
  title="Joint, marginals and a conditional"
  caption="Grey dots are samples from a joint density p(x, z), here a mixture of two correlated Gaussians. Integrating the joint over z gives the marginal p(x) under the x axis; integrating over x gives p(z) to the left of the z axis. The amber curve is the slice along z = 3, rescaled by p(z = 3) so that it is a density in x: the conditional p(x | z = 3)."
  origin="expanded"
  pages="26–27"
>
  <svg class="fig-medium" viewBox="0 0 600 362" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>Joint density with its marginals and one conditional slice</title>
    <desc id={`${id}-d`}>A scatter of samples in the x–z plane forms two tilted clouds, one around x = 3.4, z = 4.2 and one around x = 7, z = 2.2. Below the x axis, a red curve shows the marginal p(x) with two bumps. To the left of the z axis, a blue curve shows the marginal p(z). A horizontal dashed line at z = 3 carries an amber curve: the conditional density p(x given z = 3), which also has two bumps, one under each cloud.</desc>

    <!-- joint -->
    {inside.map(([x, z]) => <circle class="f-solid-muted" cx={sx(x).toFixed(1)} cy={sz(z).toFixed(1)} r="2" fill-opacity="0.45" />)}
    <path class="f-axis" d={`M ${L} ${B} H ${R + 16}`} marker-end="url(#f-arrow-muted)" />
    <path class="f-axis" d={`M ${L} ${B} V ${T - 14}`} marker-end="url(#f-arrow-muted)" />
    <text class="f-math" x={R + 18} y={B + 24} text-anchor="end">x</text>
    <text class="f-math" x={L + 12} y={T - 4}>z</text>
    <text class="f-label f-halo" x={sx(2.0)} y={sz(6.45)}>joint p(x, z)</text>

    <!-- marginal p(z), drawn to the left -->
    <path class="f-fill-blue" d={pzArea} />
    <path class="f-line f-blue" d={pzPath} />
    <path class="f-thin f-muted" d={`M ${L - 12} ${sz(0)} V ${sz(7)}`} />
    <text class="f-math f-t-blue" x="12" y={sz(6.6)}>p(z)</text>
    <text class="f-note" x="12" y={sz(6.6) + 20}>= ∫ p(x, z) dx</text>

    <!-- marginal p(x), drawn below -->
    <path class="f-fill-red" d={pxArea} />
    <path class="f-line f-red" d={pxPath} />
    <text class="f-math f-t-red" x="12" y={B + 34}>p(x)</text>
    <text class="f-note" x="12" y={B + 54}>= ∫ p(x, z) dz</text>
    <text class="f-note" x="12" y={B + 74}>marginal: integrate</text>
    <text class="f-note" x="12" y={B + 92}>the other variable out</text>

    <!-- conditional slice at z = 3 -->
    <path class="f-thin f-amber f-dash" d={`M ${L} ${sz(z0)} H ${R}`} />
    <text class="f-math f-t-amber f-halo" x={L + 6} y={sz(z0) + 22}>z = 3</text>
    <path class="f-fill-amber" d={condArea} />
    <path class="f-line f-amber f-bold" d={condPath} />
    <text class="f-math f-t-amber f-halo" x={sx(8.0)} y={sz(5.6)}>p(x | z = 3)</text>
    <text class="f-note f-halo" x={sx(8.0)} y={sz(5.6) + 20}>= p(x, 3) / p(z = 3)</text>
    <path class="f-thin" d={`M ${sx(8.6)} ${sz(5.6) + 28} Q ${sx(8.9)} ${sz(4.0)} ${sx(7.75)} ${sz(z0) - 26}`} marker-end="url(#f-arrow)" />
  </svg>
</Figure>
