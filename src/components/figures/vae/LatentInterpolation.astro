---
import Figure from '../Figure.astro';
import { normals, type Point } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

const id = 'vae-interp';

// Latent plane in units of the prior's standard deviation.
const za: Point = [-1.05, 0.45];
const zb: Point = [1.0, -0.35];
const nz = normals(160, 3);
// Codes are drawn around each class centre and kept inside the 2σ contour of the prior.
const cloud = (c: Point, k: number): Point[] =>
  Array.from({ length: 40 }, (_, i) => [c[0] + 0.36 * nz[(k * 80 + 2 * i) % 160], c[1] + 0.36 * nz[(k * 80 + 2 * i + 1) % 160]] as Point)
    .filter(([x, y]) => Math.hypot(x, y) < 1.9);
const ones = cloud(za, 0);
const sevens = cloud(zb, 1);
const lambdas = [0, 0.25, 0.5, 0.75, 1];
const zl = (l: number): Point => [(1 - l) * za[0] + l * zb[0], (1 - l) * za[1] + l * zb[1]];

// Schematic thumbnails: strokes of a "1" morphing into a "7" (unit box coordinates).
const glyphOne: Point[] = [[0.34, 0.32], [0.55, 0.15], [0.55, 0.5], [0.55, 0.86]];
const glyphSeven: Point[] = [[0.2, 0.2], [0.8, 0.2], [0.62, 0.52], [0.44, 0.86]];
const glyph = (l: number, x: number, y: number, s: number) =>
  glyphOne
    .map((p, i) => {
      const q = glyphSeven[i];
      const u = (1 - l) * p[0] + l * q[0];
      const v = (1 - l) * p[1] + l * q[1];
      return `${i ? 'L' : 'M'} ${(x + u * s).toFixed(1)} ${(y + v * s).toFixed(1)}`;
    })
    .join(' ');

const layouts = [
  // Label anchors (in viewBox units) are chosen outside the dashed contours so no text crosses them.
  { cls: 'fig-wide', s: 'w', vb: '0 0 660 324', cx: 160, cy: 172, u: 62, thumbX: 380, thumbY: 150, thumb: 48, gap: 8,
    onesL: [36, 40, 'start'] as const, sevensL: [40, 70, 'start'] as const },
  { cls: 'fig-narrow', s: 'n', vb: '0 0 360 454', cx: 180, cy: 172, u: 56, thumbX: 31, thumbY: 358, thumb: 54, gap: 7,
    onesL: [8, 40, 'start'] as const, sevensL: [4, 114, 'middle'] as const },
].map((v) => {
  const P = (p: Point) => [v.cx + v.u * p[0], v.cy - v.u * p[1]] as const;
  return {
    ...v,
    P,
    a: P(za),
    b: P(zb),
    ones: ones.map(P),
    sevens: sevens.map(P),
    ticks: lambdas.map((l) => ({ l, p: P(zl(l)) })),
    thumbs: lambdas.map((l, i) => ({ l, x: v.thumbX + i * (v.thumb + v.gap), y: v.thumbY })),
  };
});
---

<Figure
  id={id}
  title={ru ? "Интерполяция в упорядоченном латентном пространстве" : "Interpolating in an organized latent space"}
  caption={ru ? "В VAE коды всех изображений притягиваются к априорному распределению N(0, I) (пунктирные линии уровня 1σ и 2σ), поэтому прямой отрезок между кодом единицы и кодом семёрки проходит через осмысленные коды. Декодирование смеси (1 − λ)·(код единицы) + λ·(код семёрки) при растущем λ даёт постепенный переход между классами. Миниатюры схематичны и не являются выходами обученной модели." : "In a VAE the codes of all images are pulled toward the prior N(0, I) (dashed contours at 1σ and 2σ), so the straight segment between the code of a 1 and the code of a 7 runs through meaningful codes. Decoding the mixture (1 − λ)·(code of the 1) + λ·(code of the 7) for growing λ gives a gradual transition between the classes. The thumbnails are schematic, not outputs of a trained model."}
>
  {layouts.map((v) => (
    <svg class={v.cls} viewBox={v.vb} role="img" aria-labelledby={`${id}-${v.s}-t ${id}-${v.s}-d`}>
      <title id={`${id}-${v.s}-t`}>{ru ? "Латентная интерполяция между двумя классами" : "Latent interpolation between two classes"}</title>
      <desc id={`${id}-${v.s}-d`}>{ru ? "Латентная плоскость с пунктирными круговыми линиями уровня стандартного нормального априорного распределения. Синее облако кодов цифры 1 лежит левее центра около z_a, красное облако кодов цифры 7 — правее центра около z_b. Прямой отрезок соединяет z_a и z_b, на нём отмечены точки lambda = 0, 0.25, 0.5, 0.75 и 1. Рядом пять декодированных миниатюр показывают, как 1 постепенно превращается в 7." : "A latent plane with dashed circular contours of the standard normal prior. A blue cloud of codes of the digit 1 sits left of centre around z_a, a red cloud of codes of the digit 7 right of centre around z_b. A straight segment joins z_a and z_b with ticks at lambda = 0, 0.25, 0.5, 0.75 and 1. Next to it, five decoded thumbnails show a 1 gradually turning into a 7."}</desc>

      {[1, 2].map((k) => <circle class="f-thin f-muted f-dash" cx={v.cx} cy={v.cy} r={k * v.u} />)}
      <text class="f-math f-t-muted f-halo" x={v.cx + 0.9 * v.u} y={v.cy - 2 * v.u - 14}>p(z) = N(0, I)</text>
      {v.ones.map(([x, y]) => <circle class="f-solid-blue" cx={x.toFixed(1)} cy={y.toFixed(1)} r="2.4" fill-opacity="0.45" />)}
      {v.sevens.map(([x, y]) => <circle class="f-solid-red" cx={x.toFixed(1)} cy={y.toFixed(1)} r="2.4" fill-opacity="0.45" />)}
      <text class="f-label f-t-blue f-halo" x={v.onesL[0]} y={v.onesL[1]} text-anchor={v.onesL[2]}>{ru ? "коды «1»" : "codes of “1”"}</text>
      <text class="f-label f-t-red f-halo" x={v.b[0] + v.sevensL[0]} y={v.b[1] + v.sevensL[1]} text-anchor={v.sevensL[2]}>{ru ? "коды «7»" : "codes of “7”"}</text>

      <path class="f-line f-amber f-bold" d={`M ${v.a[0]} ${v.a[1]} L ${v.b[0]} ${v.b[1]}`} />
      {v.ticks.map((t) => <circle cx={t.p[0]} cy={t.p[1]} r="4.5" fill="var(--fig-amber)" stroke="var(--paper)" stroke-width="1.5" />)}
      <text class="f-math f-halo" x={v.a[0] - 22} y={v.a[1] + 36} text-anchor="end">z<tspan dy="4" font-size="13">a</tspan></text>
      <text class="f-math f-halo" x={v.b[0] + 26} y={v.b[1] - 18}>z<tspan dy="4" font-size="13">b</tspan></text>
      <text class="f-math f-t-amber f-halo" x={v.ticks[2].p[0] + 8} y={v.ticks[2].p[1] - 12}>z<tspan dy="4" font-size="13">λ</tspan></text>

      {v.s === 'w' ? (
        <g>
          <path class="f-line" d={`M ${v.cx + 2.2 * v.u} ${v.thumbY + v.thumb / 2} H ${v.thumbX - 10}`} marker-end="url(#f-arrow)" />
          <text class="f-label" x={v.thumbX + 2.5 * v.thumb + 2 * v.gap} y={v.thumbY - 42} text-anchor="middle">{ru ? 'декодируем z' : 'decode z'}<tspan dy="4" font-size="12">λ</tspan><tspan dy="-4"> = (1 − λ) z</tspan><tspan dy="4" font-size="12">a</tspan><tspan dy="-4"> + λ z</tspan><tspan dy="4" font-size="12">b</tspan></text>
        </g>
      ) : (
        <g>
          <path class="f-line" d={`M ${v.cx} ${v.cy + 2.15 * v.u} V ${v.thumbY - 10}`} marker-end="url(#f-arrow)" />
          <text class="f-label" x={v.cx - 12} y={v.cy + 2.15 * v.u + 24} text-anchor="end">{ru ? 'декодируем z' : 'decode z'}<tspan dy="4" font-size="12">λ</tspan></text>
        </g>
      )}
      {v.thumbs.map((t) => (
        <g>
          <rect class="f-box" x={t.x} y={t.y} width={v.thumb} height={v.thumb} />
          <path class="f-line f-bold" d={glyph(t.l, t.x, t.y, v.thumb)} />
          <text class="f-small" x={t.x + v.thumb / 2} y={t.y + v.thumb + 20} text-anchor="middle">λ = {t.l}</text>
        </g>
      ))}
    </svg>
  ))}
</Figure>
