---
import Figure from '../Figure.astro';
import { smooth, blob } from './shapes';

const id = 'vae-elbo-terms';

/** Horizontal curly brace from x1 to x2 opening downward, tip at the middle. */
const brace = (x1: number, x2: number, y: number, h = 16, q = 10) => {
  const m = (x1 + x2) / 2;
  const yh = y + h / 2;
  return `M ${x1} ${y} Q ${x1} ${yh} ${x1 + q} ${yh} L ${m - q} ${yh} Q ${m} ${yh} ${m} ${y + h} Q ${m} ${yh} ${m + q} ${yh} L ${x2 - q} ${yh} Q ${x2} ${yh} ${x2} ${y}`;
};

/** Small autoencoder sketch: x → encoder → z → decoder → x̂, with a "compare" arrow. Width 292. */
const ae = (ox: number, oy: number) => ({
  xBox: { x: ox, y: oy, s: 44 },
  enc: `M ${ox + 72} ${oy} L ${ox + 118} ${oy + 12} L ${ox + 118} ${oy + 32} L ${ox + 72} ${oy + 44} Z`,
  zBox: { x: ox + 132, y: oy + 8, s: 28 },
  dec: `M ${ox + 174} ${oy + 12} L ${ox + 220} ${oy} L ${ox + 220} ${oy + 44} L ${ox + 174} ${oy + 32} Z`,
  outBox: { x: ox + 248, y: oy, s: 44 },
  arrows: [
    [ox + 48, ox + 68],
    [ox + 120, ox + 129],
    [ox + 162, ox + 171],
    [ox + 222, ox + 244],
  ],
  cy: oy + 22,
  compare: `M ${ox + 22} ${oy + 52} Q ${ox + 146} ${oy + 112} ${ox + 270} ${oy + 52}`,
  compareLabel: { x: ox + 146, y: oy + 104 },
});

/** Prior contours with an off-centre, too-narrow posterior blob inside and the pull arrows. */
const prior = (cx: number, cy: number, u: number) => {
  const qc = [cx + 1.35 * u, cy - 0.85 * u] as const;
  return {
    radii: [u, 2 * u, 3 * u],
    q: smooth(blob(qc[0], qc[1], 0.55 * u, [[2, 0.2, 0.4], [3, 0.14, 1.1], [4, 0.08, 2.0]], 24), true),
    qc,
    shift: `M ${qc[0] - 0.5 * u} ${qc[1] + 0.3 * u} L ${cx + 0.14 * u} ${cy - 0.08 * u}`,
    widen: [
      `M ${qc[0] + 0.55 * u} ${qc[1] - 0.25 * u} L ${qc[0] + 1.1 * u} ${qc[1] - 0.6 * u}`,
      `M ${qc[0] + 0.25 * u} ${qc[1] + 0.6 * u} L ${qc[0] + 0.5 * u} ${qc[1] + 1.2 * u}`,
    ],
  };
};

const wa = ae(50, 196);
const wp = prior(540, 262, 28);
const na = ae(34, 166);
const np = prior(180, 572, 28);
---

<Figure
  id={id}
  title="The two terms of the ELBO"
  caption="The first term asks that an image survive the round trip real → latent → real. The second is a penalty on how far each posterior q(z | x) is from the prior p(z) = N(0, I) (dashed contours): it pulls an off-centre, too-narrow q toward the centre and widens it, shaping it toward the normal distribution."
>
  <svg class="fig-wide" viewBox="0 0 680 404" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>Reconstruction and regularization terms of the ELBO</title>
    <desc id={`${id}-d`}>The formula L(x) = E over q(z given x) of log p(x given z), minus KL of q(z given x) from p(z). A brace under the first term is labelled reconstruction: how well we reconstruct, comparing the real image with the image after real to latent to real; with a Gaussian decoder it reduces to the summed squared-error reconstruction loss. A small sketch shows x, encoder, z, decoder, x hat, and a red double arrow labelled compare between x and x hat. A brace under the second term is labelled regularization: how close the posterior q(z given x) is to the prior p(z). A sketch shows dashed concentric circles for p(z) and a small blue blob q(z given x) off-centre inside them, with red arrows pulling it toward the centre and outward, labelled pull q toward p; shape to the normal distribution.</desc>

    <!-- formula -->
    <text class="f-math" x="196" y="40" text-anchor="end">ℒ(x) =</text>
    <text class="f-math f-t-red" x="292" y="40" text-anchor="middle">E<tspan dy="5" font-size="13">q(z|x)</tspan><tspan dy="-5">[log p(x | z)]</tspan></text>
    <text class="f-math" x="408" y="40" text-anchor="middle">−</text>
    <text class="f-math f-t-blue" x="520" y="40" text-anchor="middle">KL(q(z | x) <tspan font-style="normal">‖</tspan> p(z))</text>
    <path class="f-thin f-red" d={brace(212, 372, 54)} />
    <path class="f-thin f-blue" d={brace(440, 600, 54)} />
    <text class="f-title f-t-red" x="292" y="96" text-anchor="middle">reconstruction</text>
    <text class="f-title f-t-blue" x="520" y="96" text-anchor="middle">regularization</text>

    {/* separator between the two terms */}
    <path class="f-thin f-muted" d="M 412 70 Q 380 230 404 396" />

    <!-- left: reconstruction -->
    <text class="f-label" x="196" y="126" text-anchor="middle">how well we reconstruct</text>
    <text class="f-note" x="196" y="146" text-anchor="middle">compare real → latent → real</text>
    <rect class="f-box" x={wa.xBox.x} y={wa.xBox.y} width={wa.xBox.s} height={wa.xBox.s} />
    <text class="f-math f-t-red" x={wa.xBox.x + 22} y={wa.cy + 6} text-anchor="middle">x</text>
    <path class="f-box" d={wa.enc} />
    <rect class="f-box" x={wa.zBox.x} y={wa.zBox.y} width={wa.zBox.s} height={wa.zBox.s} />
    <text class="f-math" x={wa.zBox.x + 14} y={wa.cy + 6} text-anchor="middle">z</text>
    <path class="f-box" d={wa.dec} />
    <rect class="f-box" x={wa.outBox.x} y={wa.outBox.y} width={wa.outBox.s} height={wa.outBox.s} />
    <text class="f-math f-t-blue" x={wa.outBox.x + 22} y={wa.cy + 6} text-anchor="middle">x̂</text>
    {wa.arrows.map(([a, b]) => <path class="f-thin" d={`M ${a} ${wa.cy} H ${b}`} marker-end="url(#f-arrow)" />)}
    <path class="f-line f-red" d={wa.compare} marker-start="url(#f-arrow-red)" marker-end="url(#f-arrow-red)" />
    <text class="f-label f-t-red" x={wa.compareLabel.x} y={wa.compareLabel.y} text-anchor="middle">compare</text>
    <text class="f-label" x="196" y="346" text-anchor="middle">Gaussian decoder ⇒ squared-error loss</text>
    <text class="f-note" x="196" y="366" text-anchor="middle">(summed squared error <tspan style="font-family: var(--serif); font-style: italic">‖x − x̂‖²</tspan>)</text>

    <!-- right: regularization -->
    <text class="f-label" x="544" y="126" text-anchor="middle">how close the posterior q(z | x)</text>
    <text class="f-label" x="544" y="146" text-anchor="middle">is to the prior p(z)</text>
    {wp.radii.map((r) => <circle class="f-thin f-muted f-dash" cx="540" cy="262" r={r} />)}
    <text class="f-math f-t-muted" x={540 - 66} y={262 - 66} text-anchor="end">p(z)</text>
    <path class="f-fill-blue" d={wp.q} />
    <path class="f-line f-blue" d={wp.q} />
    <text class="f-math f-t-blue f-halo" x="606" y="334" font-size="16">q(z | x)</text>
    <path class="f-thin f-blue" d={`M 620 316 Q 616 286 ${wp.qc[0] + 12} ${wp.qc[1] + 20}`} marker-end="url(#f-arrow-blue)" />
    <path class="f-line f-red" d={wp.shift} marker-end="url(#f-arrow-red)" />
    {wp.widen.map((d) => <path class="f-line f-red" d={d} marker-end="url(#f-arrow-red)" />)}
    <text class="f-label f-t-red f-halo" x="414" y="342">pull q</text>
    <text class="f-label f-t-red f-halo" x="414" y="360">toward p</text>
    <path class="f-thin f-red" d="M 462 336 Q 514 322 534 272" marker-end="url(#f-arrow-red)" />
    <text class="f-note" x="544" y="394" text-anchor="middle">shape it to the normal distribution</text>
  </svg>

  <svg class="fig-narrow" viewBox="0 0 360 700" role="img" aria-labelledby={`${id}-nt ${id}-nd`}>
    <title id={`${id}-nt`}>Reconstruction and regularization terms of the ELBO</title>
    <desc id={`${id}-nd`}>Top: the first ELBO term, E over q(z given x) of log p(x given z), labelled reconstruction, how well we reconstruct, with a sketch of x, encoder, z, decoder, x hat and a red compare arrow; with a Gaussian decoder it reduces to the summed squared-error loss. Bottom: minus KL of q(z given x) from p(z), labelled regularization, how close the posterior is to the prior, with a sketch of a small blue blob q inside dashed circles p(z) and red arrows pulling it toward the centre and outward.</desc>

    <text class="f-math" x="180" y="30" text-anchor="middle">ℒ(x) =</text>
    <text class="f-math f-t-red" x="180" y="62" text-anchor="middle">E<tspan dy="5" font-size="13">q(z|x)</tspan><tspan dy="-5">[log p(x | z)]</tspan></text>
    <path class="f-thin f-red" d={brace(100, 260, 74)} />
    <text class="f-title f-t-red" x="180" y="114" text-anchor="middle">reconstruction</text>
    <text class="f-note" x="180" y="134" text-anchor="middle">how well we reconstruct: real → latent → real</text>
    <rect class="f-box" x={na.xBox.x} y={na.xBox.y} width={na.xBox.s} height={na.xBox.s} />
    <text class="f-math f-t-red" x={na.xBox.x + 22} y={na.cy + 6} text-anchor="middle">x</text>
    <path class="f-box" d={na.enc} />
    <rect class="f-box" x={na.zBox.x} y={na.zBox.y} width={na.zBox.s} height={na.zBox.s} />
    <text class="f-math" x={na.zBox.x + 14} y={na.cy + 6} text-anchor="middle">z</text>
    <path class="f-box" d={na.dec} />
    <rect class="f-box" x={na.outBox.x} y={na.outBox.y} width={na.outBox.s} height={na.outBox.s} />
    <text class="f-math f-t-blue" x={na.outBox.x + 22} y={na.cy + 6} text-anchor="middle">x̂</text>
    {na.arrows.map(([a, b]) => <path class="f-thin" d={`M ${a} ${na.cy} H ${b}`} marker-end="url(#f-arrow)" />)}
    <path class="f-line f-red" d={na.compare} marker-start="url(#f-arrow-red)" marker-end="url(#f-arrow-red)" />
    <text class="f-label f-t-red" x={na.compareLabel.x} y={na.compareLabel.y} text-anchor="middle">compare</text>
    <text class="f-label" x="180" y="306" text-anchor="middle">Gaussian decoder ⇒ squared-error loss</text>
    <text class="f-note" x="180" y="326" text-anchor="middle">(summed squared error <tspan style="font-family: var(--serif); font-style: italic">‖x − x̂‖²</tspan>)</text>

    <line class="f-grid" x1="40" x2="320" y1="350" y2="350" />

    <text class="f-math f-t-blue" x="180" y="386" text-anchor="middle">− KL(q(z | x) <tspan font-style="normal">‖</tspan> p(z))</text>
    <path class="f-thin f-blue" d={brace(96, 264, 398)} />
    <text class="f-title f-t-blue" x="180" y="438" text-anchor="middle">regularization</text>
    <text class="f-note" x="180" y="458" text-anchor="middle">how close the posterior q(z | x) is to the prior p(z)</text>
    {np.radii.map((r) => <circle class="f-thin f-muted f-dash" cx="180" cy="572" r={r} />)}
    <text class="f-math f-t-muted" x={180 - 66} y={572 - 66} text-anchor="end">p(z)</text>
    <path class="f-fill-blue" d={np.q} />
    <path class="f-line f-blue" d={np.q} />
    <text class="f-math f-t-blue f-halo" x="262" y="648" font-size="16">q(z | x)</text>
    <path class="f-thin f-blue" d={`M 276 632 Q 272 600 ${np.qc[0] + 12} ${np.qc[1] + 20}`} marker-end="url(#f-arrow-blue)" />
    <path class="f-line f-red" d={np.shift} marker-end="url(#f-arrow-red)" />
    {np.widen.map((d) => <path class="f-line f-red" d={d} marker-end="url(#f-arrow-red)" />)}
    <text class="f-label f-t-red f-halo" x="22" y="628">pull q</text>
    <text class="f-label f-t-red f-halo" x="22" y="646">toward p</text>
    <path class="f-thin f-red" d="M 72 620 Q 150 620 176 580" marker-end="url(#f-arrow-red)" />
    <text class="f-note" x="180" y="686" text-anchor="middle">shape it to the normal distribution</text>
  </svg>
</Figure>
