---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
const id = 'vae-reparam';
// Fixed selected noise values, not an empirical normal sample or training trace.
const epsilon = [-1.5, -0.5, 0.5, 1.5];
const mu = 0.4, sigma = 0.7, delta = 0.2;
const rows = [
  { mean: mu, sd: sigma, y: 112, label: 'μ = 0.4, σ = 0.7' },
  { mean: mu + delta, sd: sigma, y: 218, label: 'μ = 0.6, σ = 0.7' },
  { mean: mu, sd: sigma + delta, y: 324, label: 'μ = 0.4, σ = 0.9' },
].map((r) => ({ ...r, values: epsilon.map((e) => r.mean + r.sd * e) }));
const sx = scale([-1.2, 2], [45, 330]);
---
<Figure id={id}
  title={ru ? 'Фиксируем шум и меняем параметры' : 'Fix the noise and vary the parameters'}
  caption={ru ? 'Четыре выбранных ε одинаковы во всех строках. При увеличении μ на 0.2 каждый z сдвигается на 0.2. При увеличении σ на 0.2 сдвиг равен 0.2ε: слева влево, справа вправо. Это вычисленные значения z = μ + σε, показывающие производные 1 и ε.' : 'The same four selected ε values are used in every row. Increasing μ by 0.2 moves each z by 0.2. Increasing σ by 0.2 moves it by 0.2ε: left points leftward, right points rightward. These computed z = μ + σε values demonstrate derivatives 1 and ε.'}>
  <svg style="max-width: 440px" viewBox="0 0 360 386" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>{ru ? 'Фиксированные значения шума дают проверяемые сдвиги сэмплов' : 'Fixed noise values yield verifiable sample shifts'}</title>
    <desc id={`${id}-d`}>{ru ? 'Шум ε равен −1.5, −0.5, 0.5, 1.5. Базовые z: −0.65, 0.05, 0.75, 1.45. При сдвиге среднего: −0.45, 0.25, 0.95, 1.65. При увеличении стандартного отклонения: −0.95, −0.05, 0.85, 1.75. Нижние строки сравниваются с базовой.' : 'Noise ε equals −1.5, −0.5, 0.5, 1.5. Base z: −0.65, 0.05, 0.75, 1.45. With shifted mean: −0.45, 0.25, 0.95, 1.65. With increased standard deviation: −0.95, −0.05, 0.85, 1.75. Lower rows are compared with the base.'}</desc>
    <text class="f-note" x="180" y="24" text-anchor="middle">ε: −1.5, −0.5, 0.5, 1.5</text>
    {rows.map((r,i) => <g>
      <text class="f-title" x="45" y={r.y-33}>{r.label}</text>
      <line class="f-axis" x1="45" x2="330" y1={r.y} y2={r.y} />
      {r.values.map((z,j) => <g>
        {i>0 && <g><circle class="f-thin f-muted" cx={sx(rows[0].values[j])} cy={r.y} r="5" /><line class={i===1?'f-line f-blue':'f-line f-red'} x1={sx(rows[0].values[j])} x2={sx(z)} y1={r.y} y2={r.y} /></g>}
        <circle class={i===2?'f-solid-red':'f-solid-blue'} cx={sx(z)} cy={r.y} r="4" />
        <text class="f-small" x={sx(z)} y={r.y+22} text-anchor="middle">{z.toFixed(2)}</text>
      </g>)}
      <text class="f-math" x="342" y={r.y+5}>z</text>
    </g>)}
    <text class="f-note" x="180" y="375" text-anchor="middle">{ru ? 'пустые кружки: базовые z' : 'open circles: base z values'}</text>
  </svg>
</Figure>
