---
import Figure from '../Figure.astro';
import { arrowHead } from './shapes';

const id = 'vae-reparam';

// One row of the pipeline; all x positions are in the SVG's own units.
type Layout = {
  cls: string; s: string; vb: string;
  xIn: number; encX: number; encW: number; encHb: number; encHs: number;
  msX: number; ms: number; boxX: number; boxW: number; boxH: number;
  zX: number; zS: number; decX: number; decW: number; outX: number; lossX: number | null;
  rows: { cy: number; title: string; kind: 'sample' | 'reparam' }[];
  boxFont: number; gap: number; noteX: number; epsDx: number; epsUp: number;
};

const wide: Layout = {
  cls: 'fig-wide', s: 'w', vb: '0 0 660 456',
  xIn: 22, encX: 52, encW: 70, encHb: 80, encHs: 34,
  msX: 142, ms: 28, boxX: 202, boxW: 136, boxH: 46,
  zX: 362, zS: 30, decX: 416, decW: 70, outX: 512, lossX: 588,
  rows: [
    { cy: 112, title: '(a) sampling inside the network', kind: 'sample' },
    { cy: 352, title: '(b) reparameterized: z = μ + σ ⊙ ε', kind: 'reparam' },
  ],
  boxFont: 18, gap: 72, noteX: 330, epsDx: 26, epsUp: 44,
};
const narrow: Layout = {
  cls: 'fig-narrow', s: 'n', vb: '0 0 360 456',
  // Every connector is 14 units long so the arrowheads stay clear of the boxes.
  xIn: 2, encX: 34, encW: 26, encHb: 60, encHs: 26,
  msX: 80, ms: 20, boxX: 121, boxW: 100, boxH: 42,
  zX: 242, zS: 20, decX: 283, decW: 26, outX: 332, lossX: null,
  rows: [
    { cy: 92, title: '(a) sampling inside the network', kind: 'sample' },
    { cy: 352, title: '(b) reparameterized: z = μ + σ ⊙ ε', kind: 'reparam' },
  ],
  boxFont: 15, gap: 64, noteX: 180, epsDx: 22, epsUp: 58,
};

const build = (L: Layout) =>
  L.rows.map((r) => {
    const cy = r.cy;
    const enc = `M ${L.encX} ${cy - L.encHb / 2} L ${L.encX + L.encW} ${cy - L.encHs / 2} L ${L.encX + L.encW} ${cy + L.encHs / 2} L ${L.encX} ${cy + L.encHb / 2} Z`;
    const dec = `M ${L.decX} ${cy - L.encHs / 2} L ${L.decX + L.decW} ${cy - L.encHb / 2} L ${L.decX + L.decW} ${cy + L.encHb / 2} L ${L.decX} ${cy + L.encHs / 2} Z`;
    const muY = cy - L.ms - 2;
    const sgY = cy + 2;
    const boxMid = L.boxX + L.boxW / 2;
    const end = L.lossX ?? L.outX + 8;
    const by = cy + L.gap; // backprop line
    return {
      ...r, enc, dec, muY, sgY, boxMid, by,
      arrows: [
        [L.xIn + 14, L.encX - 4, cy, cy],
        [L.encX + L.encW + 2, L.msX - 4, cy - 8, muY + L.ms / 2],
        [L.encX + L.encW + 2, L.msX - 4, cy + 8, sgY + L.ms / 2],
        [L.msX + L.ms + 3, L.boxX - 4, muY + L.ms / 2, cy - 8],
        [L.msX + L.ms + 3, L.boxX - 4, sgY + L.ms / 2, cy + 8],
        [L.boxX + L.boxW + 3, L.zX - 4, cy, cy],
        [L.zX + L.zS + 3, L.decX - 4, cy, cy],
        [L.decX + L.decW + 3, L.outX - 6, cy, cy],
        ...(L.lossX ? [[L.outX + 22, L.lossX - 8, cy, cy]] : []),
      ],
      // Backprop: from the loss (or the output) down, then right to left under the row.
      grad:
        r.kind === 'reparam'
          ? `M ${end + 6} ${cy + 18} V ${by} H ${L.encX + L.encW / 2} V ${cy + L.encHb / 2 + 8}`
          : `M ${end + 6} ${cy + 18} V ${by} H ${boxMid + 18}`,
      blocked: { x: boxMid, y: by },
      dead: `M ${boxMid - 16} ${by} H ${L.encX + L.encW / 2}`,
      eps: { x: boxMid, y: cy - L.boxH / 2 - L.epsUp },
    };
  });

const variants = [wide, narrow].map((L) => ({ L, rows: build(L) }));
---

<Figure
  id={id}
  title="Why the reparameterization trick is needed"
  caption="Green arrows are the backward pass from the loss. (a) If z is drawn inside the network, the gradient stops at the random draw and never reaches μ, σ or the encoder. (b) The same distribution is obtained by drawing ε ~ N(0, I) outside the network and computing z = μ + σ ⊙ ε, a deterministic, differentiable function of μ and σ."
>
  {variants.map(({ L, rows }) => (
    <svg class={L.cls} viewBox={L.vb} role="img" aria-labelledby={`${id}-${L.s}-t ${id}-${L.s}-d`}>
      <title id={`${id}-${L.s}-t`}>VAE with sampling versus the reparameterized VAE</title>
      <desc id={`${id}-${L.s}-d`}>Two rows. Row a: x goes into an encoder that outputs mu and sigma, then a box z ~ N(mu, sigma squared) draws z, which goes through the decoder to x hat. A green backward arrow from the loss runs right to left under the row and is stopped by a red cross under the sampling box, labelled cannot backprop through sampling. Row b: the same encoder outputs mu and sigma, which enter a box mu + sigma times epsilon; epsilon ~ N(0, I) is a random point injected from above. The result z goes to the decoder. The green backward arrow now runs all the way back to the encoder, labelled differentiable: dz/dmu = 1, dz/dsigma = epsilon.</desc>

      {rows.map((r) => (
        <g>
          <text class="f-title" x={L.xIn} y={r.cy - (r.kind === 'reparam' ? L.boxH / 2 + 86 : L.encHb / 2 + 40)}>{r.title}</text>

          <text class="f-math f-t-red" x={L.xIn} y={r.cy + 6}>x</text>
          <path class="f-box" d={r.enc} />
          <text class={L.s === 'w' ? 'f-label' : 'f-small'} x={L.encX + L.encW / 2} y={r.cy - L.encHb / 2 - 8} text-anchor="middle">encoder</text>

          <rect class="f-box" x={L.msX} y={r.muY} width={L.ms} height={L.ms} />
          <text class="f-math f-t-blue" x={L.msX + L.ms / 2} y={r.muY + L.ms / 2 + 6} text-anchor="middle">μ</text>
          <rect class="f-box" x={L.msX} y={r.sgY} width={L.ms} height={L.ms} />
          <text class="f-math f-t-blue" x={L.msX + L.ms / 2} y={r.sgY + L.ms / 2 + 5} text-anchor="middle">σ</text>

          {r.kind === 'sample' ? (
            <g>
              <rect class="f-box-soft" x={L.boxX} y={r.cy - L.boxH / 2} width={L.boxW} height={L.boxH} rx="8" stroke-dasharray="5 4" />
              <text class="f-math" x={r.boxMid} y={r.cy + 6} text-anchor="middle" font-size={L.boxFont}>z ~ N(μ, σ²)</text>
              <text class="f-note" x={r.boxMid} y={r.cy - L.boxH / 2 - 10} text-anchor="middle">random draw</text>
            </g>
          ) : (
            <g>
              <rect class="f-box" x={L.boxX} y={r.cy - L.boxH / 2} width={L.boxW} height={L.boxH} rx="8" />
              <text class="f-math" x={r.boxMid} y={r.cy + 6} text-anchor="middle" font-size={L.boxFont}>μ + σ ⊙ ε</text>
              <circle cx={r.eps.x} cy={r.eps.y} r="15" fill="var(--paper)" stroke="var(--fig-amber)" stroke-width="1.7" />
              <text class="f-math f-t-amber" x={r.eps.x} y={r.eps.y + 6} text-anchor="middle">ε</text>
              <path class="f-line f-amber" d={`M ${r.eps.x} ${r.eps.y + 17} V ${r.cy - L.boxH / 2 - 6}`} />
              <path d={arrowHead(r.eps.x, r.cy - L.boxH / 2 - 3, r.eps.x, r.eps.y)} fill="var(--fig-amber)" />
              <text class="f-math f-t-amber" x={r.eps.x + L.epsDx} y={r.eps.y - 2} font-size="16">~ N(0, I)</text>
              <text class="f-note" x={r.eps.x + L.epsDx} y={r.eps.y + 16}>random point</text>
            </g>
          )}

          <rect class="f-box" x={L.zX} y={r.cy - L.zS / 2} width={L.zS} height={L.zS} />
          <text class="f-math" x={L.zX + L.zS / 2} y={r.cy + 6} text-anchor="middle">z</text>
          <path class="f-box" d={r.dec} />
          <text class={L.s === 'w' ? 'f-label' : 'f-small'} x={L.decX + L.decW / 2} y={r.cy - L.encHb / 2 - 8} text-anchor="middle">decoder</text>
          <text class="f-math f-t-blue" x={L.outX} y={r.cy + 6}>x̂</text>
          {L.lossX && <text class="f-math" x={L.lossX} y={r.cy + 6}>ℒ</text>}

          {r.arrows.map(([x1, x2, y1, y2]) => <path class="f-thin" d={`M ${x1} ${y1} L ${x2} ${y2}`} marker-end="url(#f-arrow)" />)}

          {r.kind === 'sample' ? (
            <g>
              <path class="f-line f-green" d={r.grad} marker-end="url(#f-arrow-green)" />
              <path class="f-thin f-muted f-dot" d={r.dead} />
              <path class="f-line f-red f-bold" d={`M ${r.blocked.x - 8} ${r.blocked.y - 8} l 16 16 m 0 -16 l -16 16`} />
              <text class="f-label f-t-red" x={L.noteX} y={r.by + 24} text-anchor="middle">cannot backprop through sampling</text>
            </g>
          ) : (
            <g>
              <path class="f-line f-green" d={r.grad} marker-end="url(#f-arrow-green)" />
              <text class="f-label f-t-green" x={L.noteX} y={r.by + 24} text-anchor="middle">differentiable: ∂z/∂μ = 1, ∂z/∂σ = ε</text>
            </g>
          )}
        </g>
      ))}
    </svg>
  ))}
</Figure>
