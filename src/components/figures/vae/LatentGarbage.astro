---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
const id = 'vae-latent-garbage';
// Original finite interpolation example. No fitted model or external observations.
const training = [-2, 0, 2];
const g0 = (z: number) => z;
const g1 = (z: number) => z + 0.75 * z * (z * z - 4);
const variants = [
  { cls: 'fig-wide', key: 'w', width: 640, left: 62, right: 610 },
  { cls: 'fig-narrow', key: 'n', width: 360, left: 48, right: 334 },
].map((v) => {
  const sx = scale([-2.3, 2.3], [v.left, v.right]);
  const sy = scale([-4, 4], [310, 78]);
  return { ...v, sx, sy, p0: plot(g0, -2.2, 2.2, sx, sy, 200), p1: plot(g1, -2.2, 2.2, sx, sy, 200) };
});
---
<Figure id={id}
  title={ru ? 'Одинаковая реконструкция, разные новые выходы' : 'Same reconstructions, different unseen outputs'}
  caption={ru ? 'Заданный энкодер z = x и два явных декодера точно восстанавливают −2, 0, 2. При новом z = 1 они дают 1 и −1.25. Это контрпример достаточности обучающей реконструкции, без обученной сети или внешних данных.' : 'With encoder z = x, two explicit decoders reconstruct −2, 0, 2 exactly. At unseen z = 1 they give 1 and −1.25. This counterexample tests what reconstruction alone establishes; no network or external data is used.'}>
  {variants.map((v) => (
    <svg class={v.cls} viewBox={`0 0 ${v.width} 390`} role="img" aria-labelledby={`${id}-${v.key}-t ${id}-${v.key}-d`}>
      <title id={`${id}-${v.key}-t`}>{ru ? 'Два декодера проходят через три обучающие точки' : 'Two decoders pass through three training points'}</title>
      <desc id={`${id}-${v.key}-d`}>{ru ? 'Синий g0(z) = z; красный g1(z) = z + 0.75z(z² − 4). Оба проходят через (−2,−2), (0,0), (2,2). На вертикали z = 1 их значения 1 и −1.25.' : 'Blue g0(z) = z; red g1(z) = z + 0.75z(z² − 4). Both pass through (−2,−2), (0,0), (2,2). At z = 1 the outputs are 1 and −1.25.'}</desc>
      <text class="f-math f-t-blue" x={v.left} y="24">g₀(z) = z</text>
      <text class="f-math f-t-red" x={v.left} y="51">g₁(z) = z + ¾z(z² − 4)</text>
      {[-4, -2, 0, 2, 4].map((y) => <g><line class="f-grid" x1={v.left} x2={v.right} y1={v.sy(y)} y2={v.sy(y)} /><text class="f-note" x={v.left - 12} y={v.sy(y) + 5} text-anchor="end">{y}</text></g>)}
      <path class="f-axis" d={`M ${v.left} ${v.sy(0)} H ${v.right} M ${v.sx(0)} 310 V 78`} />
      {training.map((z) => <text class="f-note" x={v.sx(z)} y="334" text-anchor="middle">{z}</text>)}
      <path class="f-line f-blue f-bold" d={v.p0} />
      <path class="f-line f-red" d={v.p1} />
      {training.map((z) => <circle class="f-solid-blue" cx={v.sx(z)} cy={v.sy(z)} r="5" />)}
      <line class="f-thin f-amber f-dash" x1={v.sx(1)} x2={v.sx(1)} y1={v.sy(1)} y2={v.sy(-1.25)} />
      <circle class="f-solid-blue" cx={v.sx(1)} cy={v.sy(1)} r="4" />
      <circle class="f-solid-red" cx={v.sx(1)} cy={v.sy(-1.25)} r="4" />
      <text class="f-note f-halo" x={v.sx(1) + 9} y={v.sy(1) - 8}>1</text>
      <text class="f-note f-halo" x={v.sx(1) + 9} y={v.sy(-1.25) + 20}>−1.25</text>
      <text class="f-label" x={v.width / 2} y="365" text-anchor="middle">{ru ? 'новый код z = 1' : 'unseen code z = 1'}</text>
      <text class="f-math" x={v.right} y="334" text-anchor="end">z</text>
    </svg>
  ))}
</Figure>
