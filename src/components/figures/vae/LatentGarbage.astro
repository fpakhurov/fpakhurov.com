---
import Figure from '../Figure.astro';
import { seeded, normals, type Point } from '../geometry';
import { smooth } from './shapes';

const id = 'vae-latent-garbage';

// Digit "7" and the decoded scribble, in unit coordinates of their image box.
const seven: Point[] = [[0.2, 0.3], [0.22, 0.2], [0.8, 0.2], [0.58, 0.5], [0.42, 0.86]];
const sevenBar: Point[] = [[0.46, 0.53], [0.7, 0.53]];
const rnd = seeded(26);
const scribble: Point[] = Array.from({ length: 9 }, (_, i) => {
  const t = i / 8;
  return [0.2 + 0.6 * rnd(), 0.12 + 0.76 * (i % 2 === 0 ? t : 1 - t) * 0.7 + 0.2 * rnd()] as Point;
});
const inBox = (pts: Point[], x: number, y: number, s: number): Point[] => pts.map(([u, v]) => [x + u * s, y + v * s]);
const poly = (pts: Point[]) => pts.map(([x, y], i) => `${i ? 'L' : 'M'} ${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');

// Latent codes of training images: a few irregular clusters with empty gaps between them (unit square).
const nz = normals(120, 7);
const clusters: [number, number, number][] = [[0.16, 0.2, 0.05], [0.84, 0.14, 0.04], [0.17, 0.84, 0.05], [0.87, 0.84, 0.035]];
const islands: Point[] = clusters.flatMap(([cx, cy, s], k) =>
  Array.from({ length: 12 }, (_, i) => [cx + s * nz[(k * 24 + 2 * i) % 120], cy + s * nz[(k * 24 + 2 * i + 1) % 120]] as Point),
).filter(([u, v]) => u > 0.04 && u < 0.96 && v > 0.04 && v < 0.96);
// Reference code: the input 7 sits on the edge of a small island of other 7s.
// Its three neighbours fall into the empty gap. Offsets are in pixels of the
// 168-px latent panel (same size in both layouts); labels sit outside the circle.
const PAN = 168;
const ref: Point = [0.56, 0.5];
const R = 42; // neighbourhood circle radius, px
const px = ([dx, dy]: Point): Point => [ref[0] + dx / PAN, ref[1] + dy / PAN];
const sevens: Point[] = Array.from({ length: 12 }, (_, i) => px([-10 + 3.6 * nz[96 + 2 * i], 17 + 3.6 * nz[97 + 2 * i]]));
const near: { name: string; p: Point; lx: number; ly: number; anchor: string }[] = [
  { name: 'z₁', p: px([-24, -2]), lx: -48, ly: 4, anchor: 'end' },
  { name: 'z₂', p: px([-6, -24]), lx: -6, ly: -52, anchor: 'middle' },
  { name: 'z₃', p: px([20, -18]), lx: 38, ly: -36, anchor: 'start' },
];

// Encoder (wide → narrow) and decoder (narrow → wide) trapezoids.
const trapH = (x: number, y: number, w: number, hBig: number, hSmall: number, widening: boolean) => {
  const [hl, hr] = widening ? [hSmall, hBig] : [hBig, hSmall];
  return `M ${x} ${y - hl / 2} L ${x + w} ${y - hr / 2} L ${x + w} ${y + hr / 2} L ${x} ${y + hl / 2} Z`;
};
const trapV = (x: number, y: number, h: number, wBig: number, wSmall: number, widening: boolean) => {
  const [wt, wb] = widening ? [wSmall, wBig] : [wBig, wSmall];
  return `M ${x - wt / 2} ${y} L ${x + wt / 2} ${y} L ${x + wb / 2} ${y + h} L ${x - wb / 2} ${y + h} Z`;
};

// ---------- wide layout ----------
const cy = 150;
const W = {
  inX: 24, img: 96,
  encX: 146, encW: 62,
  panX: 240, panY: 66, pan: 168,
  decX: 440, decW: 62,
  outX: 536,
};
const wPan = (p: Point): Point => [W.panX + p[0] * W.pan, W.panY + p[1] * W.pan];
const wRef = wPan(ref);
const codes: Point[] = [...islands, ...sevens];

// ---------- narrow layout ----------
const N = { cx: 180, inY: 40, img: 84, encY: 154, encH: 46, panY: 236, pan: 168, decY: 444, decH: 46, outY: 524 };
const nPanX = N.cx - N.pan / 2;
const nPan = (p: Point): Point => [nPanX + p[0] * N.pan, N.panY + p[1] * N.pan];
const nRef = nPan(ref);
---

<Figure
  id={id}
  title="A plain autoencoder cannot generate"
  caption="The input 7 is encoded to the red reference code, on the edge of the small island of other 7s. The grey dots are codes of training images: they form islands with empty space between them, because nothing in the training organizes the latent space. The nearby points z₁, z₂, z₃ fall into that empty space, and the decoder turns them into scribbles. The picture is schematic, not the output of a trained model."
>
  <svg class="fig-wide" viewBox="0 0 660 330" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>Decoding neighbours of a reference code in a plain autoencoder</title>
    <desc id={`${id}-d`}>From left to right: an input image of the digit 7, labelled data; an encoder narrowing to the latent space; a two-dimensional latent plane with grey clusters of training codes, a red reference point z_ref on the edge of a small cluster of other 7s, and three blue nearby points z1, z2 and z3 inside a dashed circle; a decoder widening back to image size; and an output image showing a meaningless scribble, labelled garbage. A red note reads: disorganized latent space, neighbours of z_ref decode to nonsense.</desc>

    <!-- input -->
    <text class="f-label f-t-red" x={W.inX + W.img / 2} y={cy - W.img / 2 - 14} text-anchor="middle">data x</text>
    <rect class="f-box" x={W.inX} y={cy - W.img / 2} width={W.img} height={W.img} />
    <path class="f-line f-bold" d={poly(inBox(seven, W.inX, cy - W.img / 2, W.img))} />
    <path class="f-line f-bold" d={poly(inBox(sevenBar, W.inX, cy - W.img / 2, W.img))} />

    <!-- encoder -->
    <path class="f-line" d={`M ${W.inX + W.img + 6} ${cy} H ${W.encX - 6}`} marker-end="url(#f-arrow)" />
    <path class="f-box" d={trapH(W.encX, cy, W.encW, 100, 40, false)} />
    <text class="f-label" x={W.encX + W.encW / 2} y={cy + 72} text-anchor="middle">encoder</text>
    <path class="f-line" d={`M ${W.encX + W.encW + 6} ${cy} H ${W.panX - 8}`} marker-end="url(#f-arrow)" />

    <!-- latent plane -->
    <text class="f-label" x={W.panX + W.pan / 2} y={W.panY - 30} text-anchor="middle">latent space z</text>
    <text class="f-note" x={W.panX + W.pan / 2} y={W.panY - 12} text-anchor="middle">512 numbers</text>
    <rect class="f-grid" x={W.panX} y={W.panY} width={W.pan} height={W.pan} fill="none" />
    <path class="f-axis" d={`M ${W.panX} ${W.panY + W.pan} V ${W.panY - 2}`} />
    <path class="f-axis" d={`M ${W.panX} ${W.panY + W.pan} H ${W.panX + W.pan + 2}`} />
    {codes.map((p) => { const [x, y] = wPan(p); return <circle class="f-solid-muted" cx={x} cy={y} r="2.6" fill-opacity="0.55" />; })}
    <circle class="f-thin f-blue f-dash" cx={wRef[0]} cy={wRef[1]} r={R} />
    {near.map((n) => { const [x, y] = wPan(n.p); return (
      <g>
        <circle class="f-solid-blue" cx={x} cy={y} r="4" />
        <text class="f-math f-t-blue f-halo" x={wRef[0] + n.lx} y={wRef[1] + n.ly} text-anchor={n.anchor} font-size="16">{n.name}</text>
      </g>
    ); })}
    <circle class="f-solid-red" cx={wRef[0]} cy={wRef[1]} r="5" />
    <text class="f-math f-t-red f-halo" x={wRef[0] + 9} y={wRef[1] + 5} font-size="16">z<tspan dy="4" font-size="12">ref</tspan></text>

    <!-- decoder -->
    <path class="f-line" d={`M ${W.panX + W.pan + 8} ${cy} H ${W.decX - 6}`} marker-end="url(#f-arrow)" />
    <path class="f-box" d={trapH(W.decX, cy, W.decW, 100, 40, true)} />
    <text class="f-label" x={W.decX + W.decW / 2} y={cy + 72} text-anchor="middle">decoder</text>
    <path class="f-line" d={`M ${W.decX + W.decW + 6} ${cy} H ${W.outX - 6}`} marker-end="url(#f-arrow)" />

    <!-- output -->
    <text class="f-label f-t-red" x={W.outX + W.img / 2} y={cy - W.img / 2 - 14} text-anchor="middle">garbage</text>
    <rect class="f-box" x={W.outX} y={cy - W.img / 2} width={W.img} height={W.img} />
    <path class="f-line f-bold" d={smooth(inBox(scribble, W.outX, cy - W.img / 2, W.img))} />

    <!-- annotation -->
    <text class="f-label f-t-red" x="330" y="292" text-anchor="middle">disorganized latent space: neighbours of z<tspan dy="4" font-size="12">ref</tspan><tspan dy="-4"> decode to nonsense</tspan></text>
    <path class="f-line f-red" d={`M 268 276 Q 262 254 ${wRef[0] - 36} ${wRef[1] + 38}`} marker-end="url(#f-arrow-red)" />
    <path class="f-line f-red" d={`M 520 276 Q 584 262 ${W.outX + W.img / 2} ${cy + W.img / 2 + 6}`} marker-end="url(#f-arrow-red)" />
  </svg>

  <svg class="fig-narrow" viewBox="0 0 360 690" role="img" aria-labelledby={`${id}-nt ${id}-nd`}>
    <title id={`${id}-nt`}>Decoding neighbours of a reference code in a plain autoencoder</title>
    <desc id={`${id}-nd`}>From top to bottom: an input image of the digit 7; an encoder; a latent plane with grey clusters of training codes, a red reference point z_ref on the edge of a small cluster of other 7s, and three blue nearby points z1, z2, z3; a decoder; and an output image showing a meaningless scribble, labelled garbage. Note: disorganized latent space, neighbours of z_ref decode to nonsense.</desc>

    <rect class="f-box" x={N.cx - N.img / 2} y={N.inY} width={N.img} height={N.img} />
    <path class="f-line f-bold" d={poly(inBox(seven, N.cx - N.img / 2, N.inY, N.img))} />
    <path class="f-line f-bold" d={poly(inBox(sevenBar, N.cx - N.img / 2, N.inY, N.img))} />
    <text class="f-label f-t-red" x={N.cx + N.img / 2 + 14} y={N.inY + N.img / 2 + 5}>data x</text>

    <path class="f-line" d={`M ${N.cx} ${N.inY + N.img + 5} V ${N.encY - 5}`} marker-end="url(#f-arrow)" />
    <path class="f-box" d={trapV(N.cx, N.encY, N.encH, 110, 44, false)} />
    <text class="f-label" x={N.cx + 70} y={N.encY + N.encH / 2 + 5}>encoder</text>
    <path class="f-line" d={`M ${N.cx} ${N.encY + N.encH + 5} V ${N.panY - 6}`} marker-end="url(#f-arrow)" />

    <rect class="f-grid" x={nPanX} y={N.panY} width={N.pan} height={N.pan} fill="none" />
    <path class="f-axis" d={`M ${nPanX} ${N.panY + N.pan} V ${N.panY - 2}`} />
    <path class="f-axis" d={`M ${nPanX} ${N.panY + N.pan} H ${nPanX + N.pan + 2}`} />
    <text class="f-label" x={nPanX + N.pan + 10} y={N.panY + 18}>latent z</text>
    <text class="f-note" x={nPanX + N.pan + 10} y={N.panY + 36}>512</text>
    <text class="f-note" x={nPanX + N.pan + 10} y={N.panY + 52}>numbers</text>
    {codes.map((p) => { const [x, y] = nPan(p); return <circle class="f-solid-muted" cx={x} cy={y} r="2.6" fill-opacity="0.55" />; })}
    <circle class="f-thin f-blue f-dash" cx={nRef[0]} cy={nRef[1]} r={R} />
    {near.map((n) => { const [x, y] = nPan(n.p); return (
      <g>
        <circle class="f-solid-blue" cx={x} cy={y} r="4" />
        <text class="f-math f-t-blue f-halo" x={nRef[0] + n.lx} y={nRef[1] + n.ly} text-anchor={n.anchor} font-size="16">{n.name}</text>
      </g>
    ); })}
    <circle class="f-solid-red" cx={nRef[0]} cy={nRef[1]} r="5" />
    <text class="f-math f-t-red f-halo" x={nRef[0] + 9} y={nRef[1] + 5} font-size="16">z<tspan dy="4" font-size="12">ref</tspan></text>

    <path class="f-line" d={`M ${N.cx} ${N.panY + N.pan + 6} V ${N.decY - 5}`} marker-end="url(#f-arrow)" />
    <path class="f-box" d={trapV(N.cx, N.decY, N.decH, 110, 44, true)} />
    <text class="f-label" x={N.cx + 70} y={N.decY + N.decH / 2 + 5}>decoder</text>
    <path class="f-line" d={`M ${N.cx} ${N.decY + N.decH + 5} V ${N.outY - 5}`} marker-end="url(#f-arrow)" />

    <rect class="f-box" x={N.cx - N.img / 2} y={N.outY} width={N.img} height={N.img} />
    <path class="f-line f-bold" d={smooth(inBox(scribble, N.cx - N.img / 2, N.outY, N.img))} />
    <text class="f-label f-t-red" x={N.cx + N.img / 2 + 14} y={N.outY + N.img / 2 + 5}>garbage</text>

    <text class="f-label f-t-red" x={N.cx} y={N.outY + N.img + 30} text-anchor="middle">disorganized latent space:</text>
    <text class="f-label f-t-red" x={N.cx} y={N.outY + N.img + 50} text-anchor="middle">neighbours of z<tspan dy="4" font-size="12">ref</tspan><tspan dy="-4"> decode to nonsense</tspan></text>
  </svg>
</Figure>
