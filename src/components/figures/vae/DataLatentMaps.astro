---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
const id = 'vae-data-latent';
// Original scalar fixture shared with the local optional practice, not source artwork.
const weight = 1.4, noiseVariance = 0.36, observation = 0.7;
const evidenceVariance = weight * weight + noiseVariance;
const posteriorMean = weight * observation / evidenceVariance;
const posteriorVariance = noiseVariance / evidenceVariance;
const density = (x: number, mean: number, variance: number) => Math.exp(-((x - mean) ** 2) / (2 * variance)) / Math.sqrt(2 * Math.PI * variance);
const sx = scale([-3.5, 3.5], [48, 330]);
const syTop = scale([0, 0.3], [198, 74]);
const syBottom = scale([0, 1.1], [424, 278]);
const evidence = plot((x) => density(x, 0, evidenceVariance), -3.5, 3.5, sx, syTop, 200);
const prior = plot((z) => density(z, 0, 1), -3.5, 3.5, sx, syBottom, 200);
const posterior = plot((z) => density(z, posteriorMean, posteriorVariance), -3.5, 3.5, sx, syBottom, 200);
---
<Figure id={id}
  title={ru ? 'Наблюдение уточняет распределение кода' : 'An observation updates the code distribution'}
  caption={ru ? 'Явная модель z ~ N(0, 1), x | z ~ N(1.4z, 0.36). Сверху плотность x: N(0, 2.32). После x = 0.7 апостериорное распределение z — N(0.422414, 0.155172), красная кривая внизу. Это точное гауссовское обусловливание, без обучения нейросети.' : 'Explicit model: z ~ N(0, 1), x | z ~ N(1.4z, 0.36). Above: x has density N(0, 2.32). Observing x = 0.7 yields posterior z ~ N(0.422414, 0.155172), the red curve below. This is exact Gaussian conditioning, without neural-network training.'}>
  <svg style="max-width: 440px" viewBox="0 0 360 470" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>{ru ? 'Плотность наблюдений и обновление латентной плотности' : 'Observation density and latent density update'}</title>
    <desc id={`${id}-d`}>{ru ? 'Вверху широкая гауссовская плотность x с вертикальной отметкой x = 0.7. Внизу синий стандартный нормальный prior и красный более узкий posterior со средним 0.422414. Обе вертикальные оси показывают плотность, горизонтальные — значение своей переменной.' : 'The upper plot shows the Gaussian density of x, marking x = 0.7. The lower plot shows the blue standard normal prior and a narrower red posterior with mean 0.422414. Vertical axes show density; horizontal axes show the respective variable.'}</desc>
    <text class="f-title" x="48" y="28">{ru ? 'До наблюдения: p(x)' : 'Before observing: p(x)'}</text>
    <text class="f-note" x="48" y="51">N(0, 2.32)</text>
    {[0, 0.1, 0.2].map((v) => <g><line class="f-grid" x1="48" x2="330" y1={syTop(v)} y2={syTop(v)} /><text class="f-note" x="38" y={syTop(v)+5} text-anchor="end">{v}</text></g>)}
    <path class="f-line f-blue" d={evidence} />
    <line class="f-thin f-amber f-dash" x1={sx(observation)} x2={sx(observation)} y1={syTop(0)} y2={syTop(density(observation, 0, evidenceVariance))} />
    <circle class="f-solid-blue" cx={sx(observation)} cy={syTop(density(observation, 0, evidenceVariance))} r="4" />
    <text class="f-note f-halo" x={sx(observation)+10} y="84">x = 0.7</text>
    <line class="f-axis" x1="48" x2="330" y1="198" y2="198" />
    {[-3,0,3].map((x) => <text class="f-note" x={sx(x)} y="217" text-anchor="middle">{x}</text>)}
    <text class="f-math" x="343" y="202">x</text>
    <text class="f-title" x="48" y="254">{ru ? 'После x = 0.7: p(z | x)' : 'After x = 0.7: p(z | x)'}</text>
    {[0,0.5,1].map((v) => <g><line class="f-grid" x1="48" x2="330" y1={syBottom(v)} y2={syBottom(v)} /><text class="f-note" x="38" y={syBottom(v)+5} text-anchor="end">{v}</text></g>)}
    <path class="f-line f-blue" d={prior} /><path class="f-line f-red" d={posterior} />
    <text class="f-note f-t-blue" x="57" y="343">p(z)</text>
    <text class="f-note f-t-red" x="245" y="313">p(z | x)</text>
    <line class="f-axis" x1="48" x2="330" y1="424" y2="424" />
    {[-3,0,3].map((z) => <text class="f-note" x={sx(z)} y="443" text-anchor="middle">{z}</text>)}
    <text class="f-math" x="343" y="428">z</text>
  </svg>
</Figure>
