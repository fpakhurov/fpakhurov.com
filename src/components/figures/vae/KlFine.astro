---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';
import { klStd } from './shapes';

const id = 'vae-kl-fine';
const yMax = 3.2;
const yTicks = [0, 1, 2, 3];
// Smallest σ drawn: where the μ = 0 curve reaches the top of the plot (KL = yMax), found by bisection.
const sigmaTop = (() => {
  let lo = 1e-6;
  let hi = 1;
  for (let i = 0; i < 60; i += 1) {
    const m = (lo + hi) / 2;
    if (klStd(0, m) > yMax) lo = m;
    else hi = m;
  }
  return hi;
})();

type Panel = {
  x0: number; y0: number; w: number; h: number;
  key: 'sigma' | 'mu'; title: string; dom: [number, number]; ticks: number[];
};
const panelsFor = (wide: boolean): Panel[] => {
  const w = wide ? 236 : 252;
  const h = wide ? 200 : 180;
  return [
    { x0: wide ? 70 : 62, y0: 56, w, h, key: 'sigma', title: 'μ = 0, vary σ', dom: [0, 3], ticks: [0, 0.5, 1, 2, 3] },
    { x0: wide ? 392 : 62, y0: wide ? 56 : 330, w, h, key: 'mu', title: 'σ = 1, vary μ', dom: [-2.5, 2.5], ticks: [-2, -1, 0, 1, 2] },
  ];
};

const build = (p: Panel) => {
  const sx = scale(p.dom, [p.x0, p.x0 + p.w]);
  const sy = scale([0, yMax], [p.y0 + p.h, p.y0]);
  const f = p.key === 'sigma' ? (s: number) => klStd(0, s) : (m: number) => klStd(m, 1);
  const curve = p.key === 'sigma' ? plot(f, sigmaTop, 3, sx, sy, 400) : plot(f, -2.5, 2.5, sx, sy, 200);
  const marks = (p.key === 'sigma' ? [0.1, 0.5, 2] : [-2, 1]).map((v) => ({ v, k: f(v), x: sx(v), y: sy(f(v)) }));
  const min = { x: sx(p.key === 'sigma' ? 1 : 0), y: sy(0) };
  return { ...p, sx, sy, curve, marks, min };
};

const variants = [
  { cls: 'fig-wide', s: 'w', vb: '0 0 660 330', panels: panelsFor(true).map(build) },
  { cls: 'fig-narrow', s: 'n', vb: '0 0 360 600', panels: panelsFor(false).map(build) },
];
const fmt = (v: number) => (Math.abs(v - Math.round(v)) < 1e-9 ? String(Math.round(v)) : v.toFixed(2));
---

<Figure
  id={id}
  title="The KL fine grows only logarithmically as σ → 0"
  caption={`Closed form ½(μ² + σ² − 1 − log σ²) in nats. First panel: at μ = 0, shrinking σ costs ½σ² − log σ − ½ ≈ −log σ − ½ for small σ, so even σ = 0.1 costs only 1.81. The fine is finite for every σ > 0 but grows without bound, slowly, as σ → 0; the curve leaves the top of the plot at σ ≈ ${sigmaTop.toFixed(3)}. A single-point code would pay an infinite fine. Widening costs ½σ² − log σ − ½, which grows like σ²/2. Second panel: at σ = 1, moving the mean costs ½μ². The fine is zero only at μ = 0, σ = 1 (red rings).`}
>
  {variants.map((v) => (
    <svg class={v.cls} viewBox={v.vb} role="img" aria-labelledby={`${id}-${v.s}-t ${id}-${v.s}-d`}>
      <title id={`${id}-${v.s}-t`}>KL divergence to the standard normal as a function of σ and of μ</title>
      <desc id={`${id}-${v.s}-d`}>Two plots of the KL divergence from N(mu, sigma squared) to N(0, 1). First, with mu = 0, as a function of sigma from 0 to 3: a U-shaped curve with minimum 0 at sigma = 1, value 1.81 at sigma = 0.1, 0.32 at sigma = 0.5 and 0.81 at sigma = 2; for small sigma it rises like minus log sigma minus one half and goes to infinity as sigma goes to 0. Second, with sigma = 1, as a function of mu from minus 2.5 to 2.5: the parabola one half mu squared, 0.5 at mu = 1 and 2 at mu = minus 2, minimum 0 at mu = 0.</desc>
      {v.panels.map((p) => (
        <g>
          <text class="f-title" x={p.x0 + p.w / 2} y={p.y0 - 24} text-anchor="middle">{p.title}</text>
          {yTicks.map((t) => <line class="f-grid" x1={p.x0} x2={p.x0 + p.w} y1={p.sy(t)} y2={p.sy(t)} />)}
          {yTicks.map((t) => <text class="f-note" x={p.x0 - 10} y={p.sy(t) + 5} text-anchor="end">{t}</text>)}
          {p.ticks.map((t) => <text class="f-note" x={p.sx(t)} y={p.y0 + p.h + 20} text-anchor="middle">{t}</text>)}
          <path class="f-axis" d={`M ${p.x0} ${p.y0 + p.h} H ${p.x0 + p.w + 14}`} marker-end="url(#f-arrow-muted)" />
          <path class="f-axis" d={`M ${p.x0} ${p.y0 + p.h} V ${p.y0 - 8}`} marker-end="url(#f-arrow-muted)" />
          {p.key === 'sigma' && <path class="f-axis" d={`M ${p.sx(0)} ${p.y0 + p.h} V ${p.y0 - 8}`} />}
          {p.key === 'mu' && <line class="f-grid" x1={p.sx(0)} x2={p.sx(0)} y1={p.y0} y2={p.y0 + p.h} />}
          <text class="f-math" x={p.x0 + p.w + 20} y={p.y0 + p.h + 6}>{p.key === 'sigma' ? 'σ' : 'μ'}</text>
          <text class="f-note" transform={`translate(${p.x0 - 38} ${p.y0 + p.h / 2}) rotate(-90)`} text-anchor="middle">KL, nats</text>

          <path class="f-line f-blue f-bold" d={p.curve} />
          {p.marks.map((m) => (
            <g>
              <circle class="f-solid-blue" cx={m.x} cy={m.y} r="4" />
              <text class="f-small f-halo" x={m.x + (p.key === 'mu' && m.v > 0 ? -10 : p.key === 'sigma' && m.v > 1 ? 10 : 9)} y={m.y + (p.key === 'sigma' && m.v > 1 ? 18 : -8)} text-anchor={p.key === 'mu' && m.v > 0 ? 'end' : 'start'}>{fmt(m.k)}</text>
            </g>
          ))}
          <circle class="f-line f-red" cx={p.min.x} cy={p.min.y} r="8" />

          {p.key === 'sigma' ? (
            <g>
              <text class="f-small f-t-blue f-halo" x={p.sx(0.16)} y={p.sy(2.75)}>≈ −log σ − ½,</text>
              <text class="f-small f-t-blue f-halo" x={p.sx(0.16)} y={p.sy(2.75) + 16}>→ ∞ as σ → 0</text>
              <text class="f-small f-t-blue f-halo" x={p.sx(2.3)} y={p.sy(1.75)} text-anchor="end">½σ² − log σ − ½</text>
            </g>
          ) : (
            <text class="f-math f-t-blue f-halo" x={p.sx(1.2)} y={p.sy(2.5)}>½ μ²</text>
          )}
        </g>
      ))}
    </svg>
  ))}
</Figure>
