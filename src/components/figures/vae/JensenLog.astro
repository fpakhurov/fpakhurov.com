---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';
import { arrowHead } from './shapes';

const id = 'vae-jensen-log';
// Y takes two values with probability 1/2 each.
const a = 0.6;
const b = 5.4;
const mean = (a + b) / 2;
const logMean = Math.log(mean);
const meanLog = (Math.log(a) + Math.log(b)) / 2;

const L = 74;
const R = 560;
const T = 30;
const B = 290;
const sx = scale([0, 6.2], [L, R]);
const sy = scale([-1.2, 2.1], [B, T]);
const curve = plot(Math.log, Math.exp(-1.2), 6.2, sx, sy, 240);
const A = [sx(a), sy(Math.log(a))];
const Bp = [sx(b), sy(Math.log(b))];
const top = [sx(mean), sy(logMean)];
const bot = [sx(mean), sy(meanLog)];
const yTicks = [-1, 0, 1, 2];
const f2 = (v: number) => v.toFixed(2);
// Amber callout from the label to the middle of the gap segment.
const gapTip = [top[0] + 6, (top[1] + bot[1]) / 2];
const gapCtl = [sx(3.5), sy(0.68)];
---

<Figure
  id={id}
  title="Jensen's inequality for the concave logarithm"
  caption={`Y takes the values ${a} and ${b} with probability ½ each. The chord between the two points of the log curve lies below the curve, so the average of the logs, E[log Y] = ${f2(meanLog)}, is below the log of the average, log E[Y] = log ${mean} = ${f2(logMean)}. For a convex f the picture flips: E[f(Y)] ≥ f(E[Y]).`}
  origin="illustrative"
  pages="29"
>
  <svg class="fig-medium" viewBox="0 0 600 340" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>The chord of log y lies below the curve</title>
    <desc id={`${id}-d`}>The concave curve y = log of Y for Y from 0.3 to 6.2. Two points on it, at Y = {a} and Y = {b}, are joined by a straight dashed chord. At the mean E[Y] = {mean}, the curve is at log E[Y] = {f2(logMean)} and the chord is lower, at E[log Y] = {f2(meanLog)}. An amber segment between them is labelled Jensen gap. A box states log E[Y] is greater than or equal to E[log Y].</desc>

    {yTicks.map((t) => <line class="f-grid" x1={L} x2={R} y1={sy(t)} y2={sy(t)} />)}
    {yTicks.map((t) => <text class="f-note" x={L - 12} y={sy(t) + 5} text-anchor="end">{t}</text>)}
    <path class="f-axis" d={`M ${L} ${sy(0)} H ${R + 18}`} marker-end="url(#f-arrow-muted)" />
    <path class="f-axis" d={`M ${L} ${B} V ${T - 12}`} marker-end="url(#f-arrow-muted)" />
    <text class="f-math" x={R + 18} y={sy(0) + 24} text-anchor="end">Y</text>

    <path class="f-line f-blue f-bold" d={curve} />
    <text class="f-math f-t-blue" x={sx(4.5)} y={sy(1.88)} text-anchor="end">log Y</text>

    {[a, mean, b].map((v) => <line class="f-thin f-muted f-dot" x1={sx(v)} x2={sx(v)} y1={sy(0)} y2={v === mean ? top[1] : sy(Math.log(v))} />)}
    <text class="f-math" x={sx(a)} y={sy(0) - 10} text-anchor="middle">a</text>
    <text class="f-math" x={sx(mean)} y={sy(0) + 24} text-anchor="middle">E[Y]</text>
    <text class="f-math" x={sx(b)} y={sy(0) + 24} text-anchor="middle">b</text>

    <path class="f-line f-red f-dash" d={`M ${A[0]} ${A[1]} L ${Bp[0]} ${Bp[1]}`} />
    <circle class="f-solid-blue" cx={A[0]} cy={A[1]} r="5" />
    <circle class="f-solid-blue" cx={Bp[0]} cy={Bp[1]} r="5" />
    <text class="f-note f-halo" x={A[0] + 12} y={A[1] + 6}>(a, log a)</text>
    <text class="f-note f-halo" x={Bp[0] + 10} y={Bp[1] + 24}>(b, log b)</text>

    <path class="f-line f-amber f-bold" d={`M ${top[0]} ${top[1]} V ${bot[1]}`} />
    <circle class="f-solid-blue" cx={top[0]} cy={top[1]} r="5" />
    <circle class="f-solid-red" cx={bot[0]} cy={bot[1]} r="5" />
    <text class="f-math f-t-blue f-halo" x={top[0] - 12} y={top[1] - 10} text-anchor="end">log E[Y] = {f2(logMean)}</text>
    <text class="f-math f-t-red f-halo" x={bot[0] + 12} y={bot[1] + 26}>E[log Y] = {f2(meanLog)}</text>
    <path class="f-thin f-amber" d={`M ${sx(4.2) - 4} ${sy(0.8) - 5} Q ${gapCtl[0]} ${gapCtl[1]} ${gapTip[0]} ${gapTip[1]}`} />
    <path d={arrowHead(gapTip[0], gapTip[1], gapCtl[0], gapCtl[1])} fill="var(--fig-amber)" />
    <text class="f-label f-t-amber f-halo" x={sx(4.2)} y={sy(0.8)}>Jensen gap</text>
    <text class="f-note f-halo" x={sx(3.6)} y={sy(-0.55)}>chord lies below the concave curve</text>

    <rect class="f-box" x={L + 22} y={T + 6} width="206" height="38" rx="6" />
    <text class="f-math" x={L + 125} y={T + 31} text-anchor="middle">log E[Y] ≥ E[log Y]</text>
  </svg>
</Figure>
