---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';
import { arrowHead } from './shapes';

const id = 'vae-jensen-log';
// Y takes two values with probability 1/2 each.
const a = 0.6;
const b = 5.4;
const mean = (a + b) / 2;
const logMean = Math.log(mean);
const meanLog = (Math.log(a) + Math.log(b)) / 2;
const yTicks = [-1, 0, 1, 2];
const f2 = (v: number) => v.toFixed(2);

// Wide: the boxed inequality and the chord note sit inside the plot.
// Narrow: both move outside the plotting area (box above, note below) so the labels keep their size.
const layouts = [
  { cls: 'fig-medium fig-wide', s: 'w', vb: '0 0 600 340', L: 74, R: 560, T: 30, B: 290, box: { x: 96, y: 36 }, noteY: null as number | null },
  { cls: 'fig-narrow', s: 'n', vb: '0 0 360 392', L: 44, R: 300, T: 86, B: 340, box: { x: 77, y: 8 }, noteY: 380 as number | null },
].map((v) => {
  const sx = scale([0, 6.2], [v.L, v.R]);
  const sy = scale([-1.2, 2.1], [v.B, v.T]);
  const top = [sx(mean), sy(logMean)];
  const bot = [sx(mean), sy(meanLog)];
  return {
    ...v,
    sx,
    sy,
    curve: plot(Math.log, Math.exp(-1.2), 6.2, sx, sy, 240),
    A: [sx(a), sy(Math.log(a))],
    Bp: [sx(b), sy(Math.log(b))],
    top,
    bot,
    // Amber callout from the label to the middle of the gap segment.
    gapTip: [top[0] + 6, (top[1] + bot[1]) / 2],
    gapCtl: [sx(3.5), sy(0.68)],
  };
});
---

<Figure
  id={id}
  title="Jensen's inequality for the concave logarithm"
  caption={`Y takes the values ${a} and ${b} with probability ½ each. The chord between the two points of the log curve lies below the curve, so the average of the logs, E[log Y] = ${f2(meanLog)}, is below the log of the average, log E[Y] = log ${mean} = ${f2(logMean)}. For a convex f the picture flips: E[f(Y)] ≥ f(E[Y]).`}
>
  {layouts.map((v) => (
    <svg class={v.cls} viewBox={v.vb} role="img" aria-labelledby={`${id}-${v.s}-t ${id}-${v.s}-d`}>
      <title id={`${id}-${v.s}-t`}>The chord of log y lies below the curve</title>
      <desc id={`${id}-${v.s}-d`}>The concave curve y = log of Y for Y from 0.3 to 6.2. Two points on it, at Y = {a} and Y = {b}, are joined by a straight dashed chord. At the mean E[Y] = {mean}, the curve is at log E[Y] = {f2(logMean)} and the chord is lower, at E[log Y] = {f2(meanLog)}. An amber segment between them is labelled Jensen gap. A box states log E[Y] is greater than or equal to E[log Y].</desc>

      {yTicks.map((t) => <line class="f-grid" x1={v.L} x2={v.R} y1={v.sy(t)} y2={v.sy(t)} />)}
      {yTicks.map((t) => <text class="f-note" x={v.L - 12} y={v.sy(t) + 5} text-anchor="end">{t}</text>)}
      <path class="f-axis" d={`M ${v.L} ${v.sy(0)} H ${v.R + 18}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-axis" d={`M ${v.L} ${v.B} V ${v.T - 12}`} marker-end="url(#f-arrow-muted)" />
      <text class="f-math" x={v.R + 18} y={v.sy(0) + 24} text-anchor="end">Y</text>

      <path class="f-line f-blue f-bold" d={v.curve} />
      <text class="f-math f-t-blue" x={v.sx(4.5)} y={v.sy(1.88)} text-anchor="end">log Y</text>

      {[a, mean, b].map((y) => <line class="f-thin f-muted f-dot" x1={v.sx(y)} x2={v.sx(y)} y1={v.sy(0)} y2={y === mean ? v.top[1] : v.sy(Math.log(y))} />)}
      <text class="f-math" x={v.sx(a)} y={v.sy(0) - 10} text-anchor="middle">a</text>
      <text class="f-math" x={v.sx(mean)} y={v.sy(0) + 24} text-anchor="middle">E[Y]</text>
      <text class="f-math" x={v.sx(b)} y={v.sy(0) + 24} text-anchor="middle">b</text>

      <path class="f-line f-red f-dash" d={`M ${v.A[0]} ${v.A[1]} L ${v.Bp[0]} ${v.Bp[1]}`} />
      <circle class="f-solid-blue" cx={v.A[0]} cy={v.A[1]} r="5" />
      <circle class="f-solid-blue" cx={v.Bp[0]} cy={v.Bp[1]} r="5" />
      <text class="f-note f-halo" x={v.A[0] + 12} y={v.A[1] + 6}>(a, log a)</text>
      <text class="f-note f-halo" x={v.Bp[0] + (v.s === 'w' ? 10 : 8)} y={v.Bp[1] + 24}>(b, log b)</text>

      <path class="f-line f-amber f-bold" d={`M ${v.top[0]} ${v.top[1]} V ${v.bot[1]}`} />
      <circle class="f-solid-blue" cx={v.top[0]} cy={v.top[1]} r="5" />
      <circle class="f-solid-red" cx={v.bot[0]} cy={v.bot[1]} r="5" />
      <text class="f-math f-t-blue f-halo" x={v.top[0] - 12} y={v.top[1] - 10} text-anchor="end">log E[Y] = {f2(logMean)}</text>
      <text class="f-math f-t-red f-halo" x={v.bot[0] + 12} y={v.bot[1] + 26}>E[log Y] = {f2(meanLog)}</text>
      <path class="f-thin f-amber" d={`M ${v.sx(4.2) - 4} ${v.sy(0.8) - 5} Q ${v.gapCtl[0]} ${v.gapCtl[1]} ${v.gapTip[0]} ${v.gapTip[1]}`} />
      <path d={arrowHead(v.gapTip[0], v.gapTip[1], v.gapCtl[0], v.gapCtl[1])} fill="var(--fig-amber)" />
      <text class="f-label f-t-amber f-halo" x={v.sx(4.2)} y={v.sy(0.8)}>Jensen gap</text>
      {v.noteY === null
        ? <text class="f-note f-halo" x={v.sx(3.6)} y={v.sy(-0.55)}>chord lies below the concave curve</text>
        : <text class="f-note" x={(v.L + v.R) / 2} y={v.noteY} text-anchor="middle">chord lies below the concave curve</text>}

      <rect class="f-box" x={v.box.x} y={v.box.y} width="206" height="38" rx="6" />
      <text class="f-math" x={v.box.x + 103} y={v.box.y + 25} text-anchor="middle">log E[Y] ≥ E[log Y]</text>
    </svg>
  ))}
</Figure>
