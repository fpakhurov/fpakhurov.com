---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { A, B, quoted, at1, nPos, nNeg } from './curves';

const ru = pageLang(Astro.url) === 'ru';

// ROC curves (left) and precision–recall curves (right) of two classifiers on seeded simulated scores,
// 150 positives and 2,850 negatives. The PR curves are drawn as the steps whose area is the average precision.
const q = quoted;
const prevalence = nPos / (nPos + nNeg);
if (prevalence !== 0.05) throw new Error('RocPr: prevalence drifted');
const prSteps = (pr: [number, number][]) => {
  const pts: [number, number][] = [];
  let r0 = 0;
  for (const [r, p] of pr) { pts.push([r0, p], [r, p]); r0 = r; }
  return pts;
};
const curvesA = { roc: A.roc, pr: prSteps(A.pr) }, curvesB = { roc: B.roc, pr: prSteps(B.pr) };
const t = ru
  ? { roc: 'ROC-кривая', pr: 'кривая точность–полнота', fpr: 'доля ложных срабатываний (FPR)', tpr: 'полнота (TPR)', rec: 'полнота', prec: 'точность', aucA: `A: AUC ${q.aucA}`, aucB: `B: AUC ${q.aucB}`, chance: 'случайный: 0.5', apA: `A: AP ${q.apA}`, apB: `B: AP ${q.apB}`, base: 'случайный: π = 0.05' }
  : { roc: 'ROC curve', pr: 'precision–recall curve', fpr: 'false positive rate (FPR)', tpr: 'recall (TPR)', rec: 'recall', prec: 'precision', aucA: `A: AUC ${q.aucA}`, aucB: `B: AUC ${q.aucB}`, chance: 'chance: 0.5', apA: `A: AP ${q.apA}`, apB: `B: AP ${q.apB}`, base: 'chance: π = 0.05' };
const id = 'classification-metrics-roc-pr';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 380, size: 270, p1: [64, 34] as [number, number], p2: [452, 34] as [number, number] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 790, size: 280, p1: [62, 34] as [number, number], p2: [62, 430] as [number, number] },
];
---

<Figure
  id={id}
  title={ru ? 'ROC-кривые и кривые точность–полнота двух классификаторов' : 'ROC and precision–recall curves of two classifiers'}
  caption={ru
    ? `Смоделированные оценки двух классификаторов на тестовой выборке из ${nPos} положительных и ${nNeg} отрицательных примеров (5% положительных). Отрицательные получают оценки из N(0, 1); положительные — из N(1.5, 1) у классификатора A и из N(1.5, 2²) у B. Слева: A лучше упорядочивает в среднем, AUC ${q.aucA} против ${q.aucB} (в генеральной совокупности ${q.exactA} и ${q.exactB}). Справа: B ставит больше положительных на самый верх списка, и его средняя точность выше, ${q.apB} против ${q.apA}. При доле ложных срабатываний 1% A находит ${at1.A}% положительных, B — ${at1.B}%, но на графике ROC эта область занимает лишь узкую полоску у левого края. Кривые ROC пересекаются, поэтому ни одна метрика-площадь не решает, какой классификатор лучше, без вопроса о том, какая часть кривой важна.`
    : `Simulated scores of two classifiers on a test set of ${nPos} positives and ${nNeg} negatives (5% positive). Negatives get scores from N(0, 1); positives from N(1.5, 1) for classifier A and from N(1.5, 2²) for B. Left: A ranks better on average, AUC ${q.aucA} against ${q.aucB} (population values ${q.exactA} and ${q.exactB}). Right: B puts more positives at the very top of the list, and its average precision is higher, ${q.apB} against ${q.apA}. At a false positive rate of 1%, A finds ${at1.A}% of the positives and B ${at1.B}%, but on the ROC plot that region is a thin strip at the left edge. The ROC curves cross, so neither area settles which classifier is better without asking which part of the curve matters.`}
>
  {layouts.map((L) => {
    const s1x = scale([0, 1], [L.p1[0], L.p1[0] + L.size]), s1y = scale([0, 1], [L.p1[1] + L.size, L.p1[1]]);
    const s2x = scale([0, 1], [L.p2[0], L.p2[0] + L.size]), s2y = scale([0, 1], [L.p2[1] + L.size, L.p2[1]]);
    const panels = [
      { sx: s1x, sy: s1y, p: L.p1, title: t.roc, xl: t.fpr, yl: t.tpr },
      { sx: s2x, sy: s2y, p: L.p2, title: t.pr, xl: t.rec, yl: t.prec },
    ];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{ru ? 'Две ROC-кривые и две кривые точность–полнота' : 'Two ROC curves and two precision–recall curves'}</title>
        <desc id={`${id}-${L.sfx}-d`}>{ru
          ? 'Слева две ступенчатые ROC-кривые над диагональю: синяя A выше почти везде, красная B выше только у самого левого края. Справа кривые точность–полнота: красная B начинается с точности около 1 и выше синей до полноты около 0.4, затем падает ниже; пунктир внизу на уровне 0.05.'
          : 'Left: two staircase ROC curves above the diagonal; the blue A is higher almost everywhere, the red B only at the far left. Right: precision–recall curves; the red B starts at precision near 1 and stays above the blue A up to recall about 0.4, then drops below; a dashed line at 0.05 at the bottom.'}</desc>
        {panels.map((P) => (
          <g>
            <text class="f-small" x={P.p[0]} y={P.p[1] - 14}>{P.title}</text>
            <rect x={P.p[0]} y={P.p[1]} width={L.size} height={L.size} class="f-grid" style="fill: none" />
            {[0.25, 0.5, 0.75].map((v) => <path class="f-grid" d={`M ${P.sx(v)} ${P.p[1]} V ${P.p[1] + L.size} M ${P.p[0]} ${P.sy(v)} H ${P.p[0] + L.size}`} />)}
            {[0, 0.5, 1].map((v) => <text class="f-note" x={P.sx(v)} y={P.p[1] + L.size + 17} text-anchor="middle">{v}</text>)}
            {[0, 0.5, 1].map((v) => <text class="f-note" x={P.p[0] - 7} y={P.sy(v) + 5} text-anchor="end">{v}</text>)}
            <text class="f-small" x={P.p[0] + L.size / 2} y={P.p[1] + L.size + 36} text-anchor="middle">{P.xl}</text>
            <text class="f-small" transform={`translate(${P.p[0] - 34} ${P.p[1] + L.size / 2}) rotate(-90)`} text-anchor="middle">{P.yl}</text>
          </g>
        ))}
        <path class="f-line f-muted f-dash" d={`M ${s1x(0)} ${s1y(0)} L ${s1x(1)} ${s1y(1)}`} />
        <path class="f-line f-red" d={polyline(curvesB.roc.map(([x, y]) => [s1x(x), s1y(y)]))} />
        <path class="f-line f-blue" d={polyline(curvesA.roc.map(([x, y]) => [s1x(x), s1y(y)]))} />
        <path class="f-line f-muted f-dash" d={`M ${s2x(0)} ${s2y(prevalence)} H ${s2x(1)}`} />
        <path class="f-line f-red" d={polyline(curvesB.pr.map(([x, y]) => [s2x(x), s2y(y)]))} />
        <path class="f-line f-blue" d={polyline(curvesA.pr.map(([x, y]) => [s2x(x), s2y(y)]))} />
        <text class="f-small f-t-blue" x={s1x(0.96)} y={s1y(0.24)} text-anchor="end">{t.aucA}</text>
        <text class="f-small f-t-red" x={s1x(0.96)} y={s1y(0.15)} text-anchor="end">{t.aucB}</text>
        <text class="f-small f-t-muted" x={s1x(0.96)} y={s1y(0.06)} text-anchor="end">{t.chance}</text>
        <text class="f-small f-t-blue" x={s2x(0.96)} y={s2y(0.9)} text-anchor="end">{t.apA}</text>
        <text class="f-small f-t-red" x={s2x(0.96)} y={s2y(0.81)} text-anchor="end">{t.apB}</text>
        <text class="f-small f-t-muted" x={s2x(0.96)} y={s2y(0.72)} text-anchor="end">{t.base}</text>
      </svg>
    );
  })}
</Figure>
