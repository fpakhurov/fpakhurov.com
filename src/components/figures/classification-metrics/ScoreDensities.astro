---
import Figure from '../Figure.astro';
import { scale, plot, area } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { Phi, phi } from '../normal';

const ru = pageLang(Astro.url) === 'ru';

// Classifier A of the note: scores of negatives N(0, 1), of positives N(1.5, 1), 5% positives, threshold t = 1.5.
// Top: the class-conditional densities, which the ROC curve sees (TPR and FPR are areas to the right of t).
// Bottom: the same densities weighted by the class shares, which precision sees.
const mu = 1.5, pi = 0.05, thr = 1.5;
const tpr = 1 - Phi(thr - mu), fpr = 1 - Phi(thr);
const tpShare = pi * tpr, fpShare = (1 - pi) * fpr, precision = tpShare / (tpShare + fpShare);
const f = { tpr: tpr.toFixed(2), fpr: fpr.toFixed(3), tp: tpShare.toFixed(3), fp: fpShare.toFixed(3), prec: precision.toFixed(2) };
if (Object.values(f).join(' ') !== '0.50 0.067 0.025 0.063 0.28') throw new Error(`ScoreDensities: quoted values drifted: ${JSON.stringify(f)}`);
const pos = (x: number) => phi(x - mu), neg = (x: number) => phi(x);
const posW = (x: number) => pi * pos(x), negW = (x: number) => (1 - pi) * neg(x);
const t = ru
  ? {
      top: 'плотности оценок внутри классов: их видит ROC', bot: 'те же плотности, умноженные на доли классов: их видит точность',
      botLines: ['те же плотности, умноженные на доли классов:', 'их видит точность'],
      neg: 'отрицательные, N(0, 1)', pos: 'положительные, N(1.5, 1)', thr: 'порог t = 1.5',
      negW: '0.95 × отрицательные', posW: '0.05 × положительные',
      short: { neg: 'отрицательные', pos: 'положительные', negW: '× 0.95', posW: '× 0.05' },
      l1: [`TPR = ${f.tpr} (синяя площадь)`, `FPR = ${f.fpr} (красная площадь)`],
      l2: [`верно найденные: 0.05 × ${f.tpr} = ${f.tp}`, `ложные тревоги: 0.95 × ${f.fpr} = ${f.fp}`, `точность = ${f.tp} / (${f.tp} + ${f.fp}) = ${f.prec}`],
      axis: 'оценка классификатора',
    }
  : {
      top: 'score densities within each class: what ROC sees', bot: 'the same densities times the class shares: what precision sees',
      botLines: ['the same densities times the class shares:', 'what precision sees'],
      neg: 'negatives, N(0, 1)', pos: 'positives, N(1.5, 1)', thr: 'threshold t = 1.5',
      negW: '0.95 × negatives', posW: '0.05 × positives',
      short: { neg: 'negatives', pos: 'positives', negW: '× 0.95', posW: '× 0.05' },
      l1: [`TPR = ${f.tpr} (blue area)`, `FPR = ${f.fpr} (red area)`],
      l2: [`true positives: 0.05 × ${f.tpr} = ${f.tp}`, `false alarms: 0.95 × ${f.fpr} = ${f.fp}`, `precision = ${f.tp} / (${f.tp} + ${f.fp}) = ${f.prec}`],
      axis: 'classifier score',
    };
const id = 'classification-metrics-score-densities';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 430, xr: [-4, 5.5] as [number, number], x: [30, 730] as [number, number], top: [44, 184] as [number, number], bot: [250, 390] as [number, number], inside: true, tx: 3.3, bx: 1.75 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 580, xr: [-3.5, 5] as [number, number], x: [14, 346] as [number, number], top: [62, 182] as [number, number], bot: [338, 458] as [number, number], inside: false, tx: 0, bx: 0 },
];
---

<Figure
  id={id}
  title={ru ? 'Порог на оценках: что видят ROC и точность' : 'A threshold on the scores: what ROC and precision see'}
  caption={ru
    ? `Классификатор A из текста: оценки отрицательных примеров распределены как N(0, 1), положительных как N(1.5, 1), положительных 5%. Порог t = 1.5 объявляет положительным всё правее себя. Сверху плотности внутри каждого класса: полнота (TPR) — синяя площадь, ${f.tpr}, доля ложных срабатываний (FPR) — красная, ${f.fpr}; обе не зависят от доли классов, и ROC-кривая строится только из них. Снизу те же плотности, умноженные на доли классов 0.05 и 0.95: красный хвост отрицательных теперь больше синего горба положительных, и из всех срабатываний верны только ${f.prec}.`
    : `Classifier A of the text: scores of negatives are N(0, 1), of positives N(1.5, 1), and 5% of the examples are positive. The threshold t = 1.5 calls everything to its right positive. Top: the densities within each class. Recall (TPR) is the blue area, ${f.tpr}, and the false positive rate (FPR) the red area, ${f.fpr}; neither depends on the class shares, and the ROC curve is built from these two alone. Bottom: the same densities multiplied by the class shares 0.05 and 0.95. The red tail of the negatives now outweighs the blue bump of the positives, and only ${f.prec} of the alarms are correct.`}
>
  {layouts.map((L) => {
    const sx = scale(L.xr, L.x);
    const yTop = scale([0, 0.42], [L.top[1], L.top[0]]), yBot = scale([0, 0.42], [L.bot[1], L.bot[0]]);
    const ticks = [-2, 0, 2, 4].map((v) => ({ v, label: String(v).replace('-', '−') }));
    const lab = L.inside ? { neg: t.neg, pos: t.pos, negW: t.negW, posW: t.posW } : t.short;
    const panels = [
      { sy: yTop, y: L.top, p: pos, n: neg, titles: [t.top], negLab: lab.neg, negY: 0.41 },
      { sy: yBot, y: L.bot, p: posW, n: negW, titles: L.inside ? [t.bot] : t.botLines, negLab: lab.negW, negY: 0.38 },
    ];
    // a two-line title stacks upwards from the usual baseline
    const titleY = (P: { y: [number, number]; titles: string[] }, i: number) => P.y[0] - 16 - (P.titles.length - 1 - i) * 18;
    const lines1 = L.inside ? t.l1.map((s, i) => ({ s, x: sx(L.tx), y: yTop(0.3 - i * 0.075) })) : t.l1.map((s, i) => ({ s, x: L.x[0], y: L.top[1] + 42 + i * 22 }));
    const lines2 = L.inside ? t.l2.map((s, i) => ({ s, x: sx(L.bx), y: yBot(0.3 - i * 0.075) })) : t.l2.map((s, i) => ({ s, x: L.x[0], y: L.bot[1] + 42 + i * 22 }));
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{ru ? 'Плотности оценок двух классов и порог' : 'Score densities of two classes and a threshold'}</title>
        <desc id={`${id}-${L.sfx}-d`}>{ru
          ? 'Два графика с вертикальной линией порога. Сверху два колокола одинаковой высоты, красный слева и синий справа; правее порога закрашены половина синего колокола и маленький красный хвост. Снизу красный колокол почти той же высоты, а синий превратился в низкий горб, меньший красного хвоста правее порога.'
          : 'Two plots with a vertical threshold line. Top: two bells of equal height, red on the left and blue on the right; to the right of the threshold half of the blue bell and a small red tail are shaded. Bottom: the red bell is almost as tall, while the blue one has become a low bump, smaller than the red tail right of the threshold.'}</desc>
        {panels.map((P) => (
          <g>
            {P.titles.map((s, i) => <text class="f-small f-t-muted" x={L.x[0]} y={titleY(P, i)}>{s}</text>)}
            <path d={area(P.n, thr, L.xr[1], sx, P.sy)} class="f-fill-red" style="fill-opacity: .35" />
            <path d={area(P.p, thr, L.xr[1], sx, P.sy)} class="f-fill-blue" style="fill-opacity: .35" />
            <path class="f-line f-red" d={plot(P.n, L.xr[0], L.xr[1], sx, P.sy, 220)} />
            <path class="f-line f-blue" d={plot(P.p, L.xr[0], L.xr[1], sx, P.sy, 220)} />
            <path class="f-axis" d={`M ${L.x[0]} ${P.y[1]} H ${L.x[1]}`} />
            <path class="f-line f-amber f-bold" d={`M ${sx(thr)} ${P.y[0] - 4} V ${P.y[1]}`} />
            {ticks.map((k) => <text class="f-note" x={sx(k.v)} y={P.y[1] + 16} text-anchor="middle">{k.label}</text>)}
            <text class="f-note f-t-red" x={sx(-0.3)} y={P.sy(P.negY)} text-anchor="end">{P.negLab}</text>
          </g>
        ))}
        <text class="f-note f-t-blue" x={sx(1.8)} y={yTop(0.4)}>{lab.pos}</text>
        <text class="f-note f-t-blue" x={sx(3.2)} y={yBot(0.035)}>{lab.posW}</text>
        <text class="f-note f-t-amber" x={sx(thr) - 6} y={L.top[0] - 1} text-anchor="end">{L.inside ? t.thr : ''}</text>
        {lines1.map((l) => <text class="f-small" x={l.x} y={l.y}>{l.s}</text>)}
        {lines2.map((l, i) => <text class={i === 2 ? 'f-small' : 'f-small f-t-muted'} x={l.x} y={l.y}>{l.s}</text>)}
      </svg>
    );
  })}
</Figure>
