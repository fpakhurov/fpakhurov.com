---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar, type Tone } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// What `python -m pytest` does with test_stats.py of the note (pytest 9.1.1, CPython 3.14.7).
// The item ids are the ones pytest printed for the parametrized test; three parameter rows give three items.
const cases: [string, number][] = [['[5]', 5.0], ['[1, 3]', 2.0], ['[-1, 0, 1]', 0.0]];
const ids = cases.map(([, e], i) => `test_mean_cases[values${i}-${e.toFixed(1)}]`);
if (ids[1] !== 'test_mean_cases[values1-2.0]') throw new Error('parametrize ids');
// The fixture chain of test_read_scores: the test needs scores_file, which needs the built-in tmp_path.
const chain = ['test_read_scores', 'scores_file', 'tmp_path'];
if (chain.length !== 3) throw new Error('fixture chain');

interface Row { tone: Tone; title: string; lines: string[]; note: [string, string] }
const rows: Row[] = ru
  ? [
      { tone: 'x', title: 'сбор тестов из test_stats.py', lines: ['test_mean_of_three', ids[0], `${ids[1]} ...`, 'test_read_scores'], note: ['файлы test_*.py, функции test*;', 'parametrize: элемент на строку'] },
      { tone: 'g', title: 'хук импорта переписывает assert', lines: ['assert mean(xs) == 2', 'становится: r = mean(xs)', 'if not r == 2: показать r, xs'], note: ['только в тестах и conftest.py;', 'при падении видны все значения'] },
      { tone: 'g', title: 'фикстуры находятся по имени', lines: [`${chain[0]}(${chain[1]})`, `${chain[1]}(${chain[2]})`, `${chain[2]}  (встроенная)`], note: ['имя параметра = имя фикстуры;', 'фикстуре могут быть нужны фикстуры'] },
      { tone: 'h', title: 'подготовка в порядке зависимостей', lines: ['tmp_path → .../test_read_scores0/', 'scores_file → пишет scores.csv'], note: ['каждая фикстура выполняется', 'до своего return или yield'] },
      { tone: 'h', title: 'вызов теста', lines: ['test_read_scores(scores_file=path)', 'assert read_scores(path) == {...}'], note: ['значения фикстур приходят', 'как аргументы теста'] },
      { tone: 'y', title: 'очистка, затем отчёт', lines: ['код после yield, в обратном порядке', '. прошёл  F упал  E ошибка фикстуры'], note: ['падение печатает переписанный', 'assert со значениями'] },
    ]
  : [
      { tone: 'x', title: 'collect the tests of test_stats.py', lines: ['test_mean_of_three', ids[0], `${ids[1]} ...`, 'test_read_scores'], note: ['files test_*.py, functions test*;', 'parametrize: one item per row'] },
      { tone: 'g', title: 'an import hook rewrites assert', lines: ['assert mean(xs) == 2', 'becomes: r = mean(xs)', 'if not r == 2: report r, xs'], note: ['only in test files and conftest.py;', 'a failure can show every value'] },
      { tone: 'g', title: 'resolve fixtures by name', lines: [`${chain[0]}(${chain[1]})`, `${chain[1]}(${chain[2]})`, `${chain[2]}  (built in)`], note: ['a parameter name is a fixture name;', 'fixtures may need fixtures'] },
      { tone: 'h', title: 'set up, in dependency order', lines: ['tmp_path → .../test_read_scores0/', 'scores_file → writes scores.csv'], note: ['each fixture runs up to', 'its return or yield'] },
      { tone: 'h', title: 'call the test', lines: ['test_read_scores(scores_file=path)', 'assert read_scores(path) == {...}'], note: ['fixture values arrive as', "the test's arguments"] },
      { tone: 'y', title: 'tear down, then report', lines: ['code after each yield, reversed', '. pass   F fail   E setup error'], note: ['a failure prints the rewritten', 'assert with its values'] },
    ];
const steps = ru
  ? ['сбор: файлы, функции, строки parametrize', 'при импорте assert переписывается', 'фикстуры находятся по именам параметров', 'фикстуры выполняются до return или yield', 'тест вызывается со значениями фикстур', 'код после yield, затем результат в отчёте']
  : ['collect: files, functions, parametrize rows', 'importing the file rewrites each assert', 'fixtures are found by parameter name', 'fixtures run up to their return or yield', 'the test is called with the fixture values', 'code after yield runs, then the outcome is reported'];

interface Layout { cls: string; W: number; bx: number; bw: number; head: number; lh: number; gap: number; noteX: number | null; mono: number; sans: number; badgeX: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, bx: 40, bw: 350, head: 20, lh: 18, gap: 18, noteX: 408, mono: 7.5, sans: 6.5, badgeX: 20 },
  { cls: 'fig-narrow seq-narrow', W: 360, bx: 34, bw: 318, head: 22, lh: 20, gap: 18, noteX: null, mono: 8.4, sans: 7.3, badgeX: 17 },
];
const geom = layouts.map((L) => {
  let y = 10;
  const ys = rows.map((r) => {
    const h = L.head + 12 + r.lines.length * L.lh;
    const top = y;
    y += h + L.gap;
    return { top, h };
  });
  for (const r of rows) {
    if (10 + r.title.length * L.sans > L.bw - 8) throw new Error(`title "${r.title}" overflows at ${L.W}`);
    for (const s of r.lines) if (10 + s.length * L.mono > L.bw - 6) throw new Error(`"${s}" overflows at ${L.W}`);
    if (L.noteX !== null) for (const s of r.note) if (L.noteX + s.length * L.sans > L.W - 4) throw new Error(`note "${s}" overflows`);
  }
  return { ys, H: y - L.gap + 10 };
});
const id = 'pytest-run';
---

<Figure
  id={id}
  title={ru ? 'Что pytest делает с файлом тестов' : 'What pytest does with a test file'}
  caption={ru
    ? 'Прогон test_stats.py в pytest 9.1.1. Сначала pytest собирает тесты (1): параметризованная функция с тремя строками данных даёт три элемента с идентификаторами в квадратных скобках. При импорте файла каждый assert переписывается так, чтобы запомнить значения подвыражений (2; строки показывают идею, а не настоящий сгенерированный код). Для каждого теста фикстуры находятся по именам параметров (3) и выполняются в порядке зависимостей (4); тест вызывается с их значениями (5); код после yield выполняется в обратном порядке, и результат попадает в отчёт (6). Зелёным отмечен вход, жёлтым — подготовка, синим — выполнение, красным — результат.'
    : 'One run of test_stats.py under pytest 9.1.1. pytest first collects the tests (1): a parametrized function with three rows of data becomes three items with ids in brackets. While importing the file it rewrites each assert so that the values of its subexpressions are kept (2; the lines show the idea, not the generated code). For each test the fixtures are found by parameter name (3) and run in dependency order (4); the test is called with their values (5); code after each yield runs in reverse order and the outcome is reported (6). Green marks the input, amber the preparation, blue what runs, red the result.'}
>
  {layouts.map((L, li) => {
    const { ys, H } = geom[li];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Шесть стадий прогона pytest' : 'Six stages of a pytest run'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Шесть блоков сверху вниз, соединённых стрелками: сбор тестов, переписывание assert, поиск фикстур по имени, подготовка фикстур, вызов теста, очистка и отчёт.'
          : 'Six boxes from top to bottom joined by arrows: collecting the tests, rewriting assert, resolving fixtures by name, setting up the fixtures, calling the test, tearing down and reporting.'}</desc>
        {rows.map((r, k) => {
          const { top, h } = ys[k];
          return (
            <g data-s={String(k + 1)}>
              <rect x={L.bx} y={top} width={L.bw} height={h} rx="7" style={`fill: ${toneVar[r.tone]}; fill-opacity: 0.12; stroke: ${toneVar[r.tone]}; stroke-width: 1.3`} />
              <text class="f-small" x={L.bx + 10} y={top + L.head - 2} style="font-weight: 650">{r.title}</text>
              {r.lines.map((s, si) => (
                <text class="f-small" x={L.bx + 10} y={top + L.head + 4 + (si + 1) * L.lh - 4} style="font-family: var(--mono)">{s}</text>
              ))}
              {L.noteX !== null && r.note.map((s, i) => (
                <text class="f-small f-t-muted" x={L.noteX!} y={top + 20 + i * 19}>{s}</text>
              ))}
              {k !== rows.length - 1 && <path class="f-line f-muted" d={`M ${L.bx + L.bw / 2} ${top + h + 2} V ${ys[k + 1].top - 3}`} marker-end="url(#f-arrow-muted)" />}
              <Badge x={L.badgeX} y={top + Math.min(h / 2, 22)} n={k + 1} />
            </g>
          );
        })}
      </svg>
    );
  })}
  <Stepper steps={steps} />
</Figure>
