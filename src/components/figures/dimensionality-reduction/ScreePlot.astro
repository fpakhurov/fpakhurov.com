---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { factorData, covariance, eigSym } from './pca';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// 500 points in 10 dimensions from x = W z + ε: three latent factors and isotropic noise of variance 0.25 (seed 1).
// Left: the eigenvalues of the sample covariance on a log scale. Right: the cumulative share of explained variance.
const X = factorData(1, 500);
const { values: lam } = eigSym(covariance(X).C);
const total = lam.reduce((s, v) => s + v, 0);
let acc = 0;
const cum = lam.map((v) => (acc += v) / total);
const noise = lam.slice(3).reduce((s, v) => s + v, 0) / 7;
const k90 = cum.findIndex((c) => c >= 0.9) + 1;
if (lam.slice(0, 4).map((v) => v.toFixed(2)).join() !== '8.98,4.13,2.41,0.31' || noise.toFixed(3) !== '0.250') throw new Error('ScreePlot: eigenvalues drifted from the note');
if (cum.slice(0, 4).map((v) => v.toFixed(3)).join() !== '0.520,0.759,0.899,0.917' || k90 !== 4) throw new Error('ScreePlot: explained variance drifted from the note');

const t = ru
  ? { a: 'собственные значения (лог. шкала)', b: 'доля объяснённой дисперсии', comp: 'номер компоненты j', noise: `среднее остальных: ${noise.toFixed(3)}` }
  : { a: 'eigenvalues (log scale)', b: 'cumulative explained variance', comp: 'component j', noise: `mean of the rest: ${noise.toFixed(3)}` };
const id = 'scree-plot';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 290, panels: [[52, 30, 330, 200], [432, 30, 310, 200]] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 560, panels: [[46, 30, 300, 200], [46, 310, 300, 200]] },
];
const logs = (v: number) => Math.log10(v);
// The three signal components are blue, the seven noise components amber.
const tone = lam.map((_, j) => (j < 3 ? 'blue' : 'amber'));
const opacity = lam.map((_, j) => (j < 3 ? 0.75 : 0.55));
---

<Figure
  id={id}
  title={ru ? 'Сколько компонент оставить' : 'How many components to keep'}
  caption={ru
    ? `500 точек в 10 измерениях, порождённых тремя скрытыми факторами и изотропным шумом с дисперсией 0.25. Слева: собственные значения выборочной ковариации, ${lam.slice(0, 3).map((v) => v.toFixed(2)).join(', ')}, а дальше «пол» из семи значений от ${lam[3].toFixed(2)} до ${lam[9].toFixed(2)} — излом после третьей компоненты. Среднее семи отброшенных значений ${noise.toFixed(3)} — оценка дисперсии шума в вероятностном PCA, здесь она совпадает с истинной. Справа: накопленная доля объяснённой дисперсии; три компоненты объясняют ${(cum[2] * 100).toFixed(1)}%, и правило «90%» оставило бы четыре.`
    : `500 points in 10 dimensions generated by three latent factors and isotropic noise of variance 0.25. Left: the eigenvalues of the sample covariance, ${lam.slice(0, 3).map((v) => v.toFixed(2)).join(', ')}, then a floor of seven values between ${lam[3].toFixed(2)} and ${lam[9].toFixed(2)}: the elbow is after the third component. The mean of the seven discarded values, ${noise.toFixed(3)}, is the noise-variance estimate of probabilistic PCA, here equal to the true value. Right: the cumulative share of explained variance; three components explain ${(cum[2] * 100).toFixed(1)}%, and a 90% rule would keep four.`}
>
  {layouts.map((L) => {
    const [ax, ay, aw, ah] = L.panels[0], [bx, by, bw, bh] = L.panels[1];
    const bxs = (j: number) => ax + ((j + 0.5) / 10) * aw, ys = scale([-1, 1], [ay + ah, ay]);
    const cx = scale([0.5, 10.5], [bx, bx + bw]), cy = scale([0.4, 1], [by + bh, by]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Собственные значения и накопленная объяснённая дисперсия' : 'Eigenvalues and cumulative explained variance'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Три высоких столбца и семь низких на уровне шума; кривая накопленной доли растёт до 0.899 за три компоненты и дальше почти линейно.' : 'Three tall bars and seven low ones at the noise level; the cumulative curve rises to 0.899 in three components and then almost linearly.'}</desc>
        <text class="f-small" x={ax} y={ay - 12}>{t.a}</text>
        {[0.1, 1, 10].map((v) => <g><path class="f-grid" d={`M ${ax} ${ys(logs(v))} H ${ax + aw}`} /><text class="f-note" x={ax - 6} y={ys(logs(v)) + 4} text-anchor="end">{v}</text></g>)}
        {lam.map((v, j) => <rect x={bxs(j) - aw / 26} y={ys(logs(v))} width={aw / 13} height={ys(-1) - ys(logs(v))} style={`fill: var(--fig-${tone[j]}); fill-opacity: ${opacity[j]}`} />)}
        <path class="f-thin f-red f-dash" d={`M ${ax} ${ys(logs(noise))} H ${ax + aw}`} />
        <text class="f-small f-t-red f-halo" x={ax + aw - 4} y={ys(logs(noise)) - 22} text-anchor="end">{t.noise}</text>
        <path class="f-axis" d={`M ${ax} ${ay + ah} H ${ax + aw}`} />
        {lam.map((_, j) => <text class="f-note" x={bxs(j)} y={ay + ah + 17} text-anchor="middle">{j + 1}</text>)}
        <text class="f-small f-t-muted" x={ax + aw / 2} y={ay + ah + 38} text-anchor="middle">{t.comp}</text>

        <text class="f-small" x={bx} y={by - 12}>{t.b}</text>
        {[0.4, 0.6, 0.8, 1].map((v) => <g><path class="f-grid" d={`M ${bx} ${cy(v)} H ${bx + bw}`} /><text class="f-note" x={bx - 6} y={cy(v) + 4} text-anchor="end">{v}</text></g>)}
        <path class="f-thin f-red f-dash" d={`M ${bx} ${cy(0.9)} H ${bx + bw}`} />
        <text class="f-small f-t-red f-halo" x={bx + bw - 4} y={cy(0.9) + 16} text-anchor="end">90%</text>
        <path class="f-line f-blue" d={polyline(cum.map((c, j) => [cx(j + 1), cy(c)]))} />
        {cum.map((c, j) => <circle cx={cx(j + 1)} cy={cy(c)} r="3.5" style={`fill: var(--fig-${tone[j]})`} />)}
        <text class="f-small f-t-blue f-halo" x={cx(3) + 8} y={cy(cum[2]) + 18}>{cum[2].toFixed(3)}</text>
        <path class="f-axis" d={`M ${bx} ${by + bh} H ${bx + bw}`} />
        {lam.map((_, j) => <text class="f-note" x={cx(j + 1)} y={by + bh + 17} text-anchor="middle">{j + 1}</text>)}
        <text class="f-small f-t-muted" x={bx + bw / 2} y={by + bh + 38} text-anchor="middle">{t.comp}</text>
      </svg>
    );
  })}
</Figure>
