---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { gauss2, covariance, eigSym, type P } from './pca';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// 60 draws of N(0, Σ), Σ = [[2, 1.2], [1.2, 1]] (seed 5): the covariance of the probability course's multivariate
// Gaussian note, with eigenvalues 2.8 and 0.2. PCA of the sample: centre, take the covariance, eigendecompose.
const X = gauss2(5, 60, 2, 1.2, 1);
const { mean, C } = covariance(X);
const { values: lam, vectors: V } = eigSym(C);
const u = V[0][0] < 0 ? V[0].map((v) => -v) : V[0];
const ratio = lam[0] / (lam[0] + lam[1]);
// Variance along u (the mean squared projection) and the mean squared residual: they add up to the total variance.
const proj = X.map((x) => (x[0] - mean[0]) * u[0] + (x[1] - mean[1]) * u[1]);
const resid2 = X.map((x, i) => (x[0] - mean[0] - proj[i] * u[0]) ** 2 + (x[1] - mean[1] - proj[i] * u[1]) ** 2);
const varAlong = proj.reduce((s, p) => s + p * p, 0) / X.length, mse = resid2.reduce((s, r) => s + r, 0) / X.length;
if (lam.map((v) => v.toFixed(2)).join() !== '2.59,0.21' || ratio.toFixed(3) !== '0.924') throw new Error('PcaGeometry: eigenvalues drifted from the note');
if (Math.abs(varAlong - lam[0]) > 1e-9 || Math.abs(mse - lam[1]) > 1e-9) throw new Error('PcaGeometry: variance and residual must equal the eigenvalues');

const t = ru
  ? { pc1: 'первая компонента', pc2: 'вторая', res: 'остатки' }
  : { pc1: 'first component', pc2: 'second', res: 'residuals' };
const id = 'pca-geometry';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 330, x0: 20, x1: 580, y0: 15, y1: 315, leg: [36, 36] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 300, x0: 6, x1: 354, y0: 12, y1: 288, leg: [16, 30] },
];
const half = 2.3;
---

<Figure
  id={id}
  title={ru ? 'Две стороны одной задачи: дисперсия и ошибка восстановления' : 'Two sides of one problem: variance and reconstruction error'}
  caption={ru
    ? `60 точек из N(0, Σ), Σ = [[2, 1.2], [1.2, 1]]. Красная прямая — первая главная компонента выборки: собственный вектор выборочной ковариации с наибольшим собственным значением ${lam[0].toFixed(2)}. Проекции точек на неё (красные кружки) имеют дисперсию ${varAlong.toFixed(2)}, наибольшую среди всех направлений; средний квадрат длины остатков (жёлтые отрезки) равен второму собственному значению ${lam[1].toFixed(2)}, наименьшему возможному. Сумма двух чисел — полная дисперсия ${(lam[0] + lam[1]).toFixed(2)}, поэтому максимизировать первое и минимизировать второе — одно и то же. Первая компонента объясняет ${(ratio * 100).toFixed(1)}% дисперсии выборки (для самого распределения 2.8 / 3 = 93.3%).`
    : `60 points from N(0, Σ), Σ = [[2, 1.2], [1.2, 1]]. The red line is the sample's first principal component: the eigenvector of the sample covariance with the largest eigenvalue, ${lam[0].toFixed(2)}. The projections of the points onto it (red dots) have variance ${varAlong.toFixed(2)}, the largest over all directions; the mean squared length of the residuals (amber segments) equals the second eigenvalue, ${lam[1].toFixed(2)}, the smallest possible. The two add up to the total variance ${(lam[0] + lam[1]).toFixed(2)}, so maximizing the first and minimizing the second are the same problem. The first component explains ${(ratio * 100).toFixed(1)}% of the sample variance (2.8 / 3 = 93.3% for the distribution itself).`}
>
  {layouts.map((L) => {
    const aspect = (L.x1 - L.x0) / (L.y1 - L.y0), hy = half, hx = half * aspect;
    const sx = scale([mean[0] - hx, mean[0] + hx], [L.x0, L.x1]), sy = scale([mean[1] - hy, mean[1] + hy], [L.y1, L.y0]);
    const S = (p: P) => [sx(p[0]), sy(p[1])];
    const along = (s: number) => [mean[0] + s * u[0], mean[1] + s * u[1]] as P;
    const v2: P = [-u[1], u[0]];
    const smax = 0.97 * Math.min(hx / Math.abs(u[0]), hy / Math.abs(u[1]));
    const a = S(along(-smax)), b = S(along(smax));
    const tip2 = S([mean[0] + Math.sqrt(lam[1]) * 2 * v2[0], mean[1] + Math.sqrt(lam[1]) * 2 * v2[1]]);
    const tip1 = S(along(-0.62 * smax));
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Проекция облака точек на первую главную компоненту' : 'A point cloud projected onto its first principal component'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Вытянутое облако точек, прямая вдоль его длинной оси, проекции точек на неё и короткие отрезки остатков.' : 'An elongated cloud of points, a line along its long axis, the projections of the points onto it and the short residual segments.'}</desc>
        <rect x={L.x0} y={L.y0} width={L.x1 - L.x0} height={L.y1 - L.y0} class="f-grid" />
        <path class="f-line f-red" d={`M ${a[0]} ${a[1]} L ${b[0]} ${b[1]}`} />
        {X.map((x, i) => { const p = S(x), q = S(along(proj[i])); return <path class="f-thin f-amber" d={`M ${p[0]} ${p[1]} L ${q[0]} ${q[1]}`} style="stroke-width: 1.3" />; })}
        {X.map((x, i) => { const q = S(along(proj[i])); return <circle cx={q[0].toFixed(1)} cy={q[1].toFixed(1)} r="2.2" class="f-solid-red" />; })}
        {X.map((x) => { const p = S(x); return <circle cx={p[0].toFixed(1)} cy={p[1].toFixed(1)} r="3" style="fill: var(--fig-blue); fill-opacity: .75" />; })}
        <path class="f-line" d={`M ${sx(mean[0])} ${sy(mean[1])} L ${tip2[0]} ${tip2[1]}`} marker-end="url(#f-arrow)" />
        <text class="f-small f-halo" x={tip2[0] - 6} y={tip2[1] - 6} text-anchor="end">{t.pc2}</text>
        <text class="f-small f-t-red f-halo" x={tip1[0] + 10} y={tip1[1] + 22}>{t.pc1}</text>
        <path class="f-thin f-amber" d={`M ${L.leg[0]} ${L.leg[1] - 4} h 20`} style="stroke-width: 1.6" />
        <text class="f-small f-t-amber" x={L.leg[0] + 26} y={L.leg[1]}>{t.res}</text>
      </svg>
    );
  })}
</Figure>
