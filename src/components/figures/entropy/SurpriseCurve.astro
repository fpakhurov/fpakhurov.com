---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';

// Plot area in viewBox units.
const left = 64;
const right = 540;
const top = 26;
const bottom = 292;
const yMax = 5;
const sx = scale([0, 1], [left, right]);
const sy = scale([0, yMax], [bottom, top]);

const surprise = (p: number) => -Math.log2(p);
const reciprocal = (p: number) => 1 / p;

// Clip both curves to the plot area so steep parts do not spill over the labels.
const surprisePath = plot(surprise, 1 / 2 ** yMax, 1, sx, sy, 240);
const reciprocalPath = plot(reciprocal, 1 / yMax, 1, sx, sy, 200);

const heads = { p: 0.9, s: surprise(0.9) };
const tails = { p: 0.1, s: surprise(0.1) };
const xTicks = [0, 0.1, 0.5, 0.9, 1];
const yTicks = [0, 1, 2, 3, 4, 5];
---

<Figure
  id="surprise-curve"
  title="Surprise must vanish for a certain outcome"
  caption="The first attempt, 1/p(x), ranks rare outcomes correctly but still equals 1 when p(x) = 1. Taking the logarithm moves that point to zero. Values are in bits (log base 2)."
>
  <svg class="fig-medium" viewBox="0 0 590 350" role="img" aria-labelledby="surprise-curve-t surprise-curve-d">
    <title id="surprise-curve-t">Surprise as a function of probability</title>
    <desc id="surprise-curve-d">Two decreasing curves over probability from 0 to 1. The dashed curve 1 over p ends at height 1 when p equals 1. The solid curve minus log base 2 of p ends at zero, marked as no surprise. Points mark heads with probability 0.9 and surprise 0.15 bits, and tails with probability 0.1 and surprise 3.32 bits.</desc>

    {yTicks.map((tick) => <line class="f-grid" x1={left} x2={right} y1={sy(tick)} y2={sy(tick)} />)}
    {yTicks.map((tick) => <text class="f-note" x={left - 12} y={sy(tick) + 5} text-anchor="end">{tick}</text>)}
    {xTicks.map((tick) => <text class="f-note" x={sx(tick)} y={bottom + 22} text-anchor="middle">{tick}</text>)}
    <path class="f-axis" d={`M ${left} ${bottom} H ${right + 30}`} marker-end="url(#f-arrow-muted)" />
    <path class="f-axis" d={`M ${left} ${bottom} V ${top - 10}`} marker-end="url(#f-arrow-muted)" />
    <text class="f-math" x={right + 30} y={bottom + 44} text-anchor="end">p(x)</text>
    <text class="f-label" transform={`translate(${left - 42} ${(top + bottom) / 2}) rotate(-90)`} text-anchor="middle">surprise, bits</text>

    <path class="f-line f-muted f-dash" d={reciprocalPath} />
    <path class="f-line f-blue f-bold" d={surprisePath} />

    <text class="f-math f-t-muted" x={sx(0.3)} y={sy(4.2)}>1 / p(x)</text>
    <text class="f-math f-t-blue" x={sx(0.2)} y={sy(1.12)}>−log₂ p(x)</text>

    <!-- Tails: rare outcome, large surprise -->
    <line class="f-thin f-muted f-dash" x1={sx(tails.p)} x2={sx(tails.p)} y1={bottom} y2={sy(tails.s)} />
    <circle class="f-solid-blue" cx={sx(tails.p)} cy={sy(tails.s)} r="5" />
    <text class="f-label" x={sx(tails.p) + 14} y={sy(tails.s) + 24}>tails: 3.32 bits</text>

    <!-- Heads: common outcome, small surprise -->
    <circle class="f-solid-blue" cx={sx(heads.p)} cy={sy(heads.s)} r="5" />
    <text class="f-label" x={sx(heads.p) - 6} y={sy(1.55)} text-anchor="end">heads: 0.15 bits</text>
    <path class="f-thin" d={`M ${sx(heads.p) - 20} ${sy(1.45)} Q ${sx(heads.p) - 4} ${sy(1.1)} ${sx(heads.p) - 1} ${sy(heads.s) - 10}`} marker-end="url(#f-arrow)" />

    <!-- The key property: zero surprise at p = 1, while 1/p stays at 1 -->
    <circle class="f-line f-red" cx={sx(1)} cy={sy(0)} r="11" />
    <text class="f-label f-t-red" x={sx(0.62)} y={sy(2.55)}>no surprise when p(x) = 1</text>
    <path class="f-line f-red" d={`M ${sx(0.86)} ${sy(2.38)} Q ${sx(1.03)} ${sy(1.6)} ${sx(1) + 3} ${sy(0) - 14}`} marker-end="url(#f-arrow-red)" />
    <circle class="f-solid-muted" cx={sx(1)} cy={sy(1)} r="4" />
    <text class="f-note" x={sx(1) + 10} y={sy(1) - 8}>1/p = 1</text>
  </svg>
</Figure>
