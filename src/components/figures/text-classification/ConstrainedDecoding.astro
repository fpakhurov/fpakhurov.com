---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Constrained decoding at the first step of a Literal["Positive", "Negative", "Neutral"] schema.
// Illustrative probabilities; labels are treated as single tokens for clarity.
const dist = [
  { t: 'The', p: 0.30, ok: false },
  { t: 'Positive', p: 0.24, ok: true },
  { t: 'I', p: 0.14, ok: false },
  { t: 'Negative', p: 0.10, ok: true },
  { t: 'Sure', p: 0.08, ok: false },
  { t: 'Neutral', p: 0.06, ok: true },
];
const mass = dist.filter((d) => d.ok).reduce((a, d) => a + d.p, 0);
const after = dist.map((d) => ({ ...d, q: d.ok ? d.p / mass : 0 }));
const t = ru
  ? { left: 'распределение модели', right: 'после маски схемы', rest: 'остальные токены: 0.08', masked: 'запрещено', schema: 'схема: Literal["Positive", "Negative", "Neutral"]' }
  : { left: "the model's distribution", right: 'after the schema mask', rest: 'all other tokens: 0.08', masked: 'not allowed', schema: 'schema: Literal["Positive", "Negative", "Neutral"]' };
const id = 'constrained-decoding';
interface Layout { cls: string; W: number; H: number; panels: [number, number][]; labW: number; barW: number; rowH: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 700, H: 262, panels: [[10, 36], [370, 36]], labW: 86, barW: 190, rowH: 30 },
  { cls: 'fig-narrow', W: 360, H: 480, panels: [[8, 58], [8, 290]], labW: 86, barW: 200, rowH: 28 },
];
const f2 = (v: number) => v.toFixed(2);
---

<Figure
  id={id}
  title={ru ? 'Ограниченное декодирование для классификации' : 'Constrained decoding for classification'}
  caption={ru
    ? 'Первый шаг порождения, когда модель с инструкциями просят дать метку тональности. Слева — её распределение следующего токена: самый вероятный токен начинает вежливую фразу, а не метку. Справа — то же распределение после маски, которую строит схема: токены, не способные начать допустимый выход, получают нулевую вероятность, а оставшиеся три перенормируются (0.24 / 0.40 = 0.60 и так далее). Модель больше не может выдать ничего, кроме одной из трёх меток. Вероятности условные, метки для наглядности считаются одним токеном; настоящая метка может занимать несколько токенов, и тогда маска пересчитывается на каждом шаге.'
    : 'The first generation step when an instruction-tuned model is asked for a sentiment label. Left: its next-token distribution, where the most probable token starts a polite sentence, not a label. Right: the same distribution after the mask the schema builds: tokens that cannot start a valid output get probability zero and the remaining three are renormalized (0.24 / 0.40 = 0.60, and so on). The model can no longer produce anything but one of the three labels. Probabilities are illustrative, and each label is treated as one token for clarity; a real label can span several tokens, and the mask is then recomputed at every step.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Распределение следующего токена до и после маски' : 'Next-token distribution before and after the mask'}</title>
      <desc id={`${id}-${L.W}-d`}>{`${dist.map((d) => `${d.t} ${f2(d.p)}`).join(', ')}. ${ru ? 'После маски' : 'After the mask'}: ${after.filter((d) => d.ok).map((d) => `${d.t} ${f2(d.q)}`).join(', ')}.`}</desc>
      {(L.cls === 'fig-wide' ? [t.schema] : [t.schema.slice(0, t.schema.indexOf(' ') + 1), t.schema.slice(t.schema.indexOf(' ') + 1)]).map((line, li) => <text class="f-small f-t-muted" x={L.panels[0][0]} y={16 + li * 16} font-family="var(--mono)">{line}</text>)}
      {L.panels.map(([px, py], pi) => (
        <g>
          <text class="f-title" x={px} y={py + 4}>{pi === 0 ? t.left : t.right}</text>
          {after.map((d, i) => {
            const y = py + 16 + i * L.rowH;
            const v = pi === 0 ? d.p : d.q;
            const blocked = pi === 1 && !d.ok;
            return (
              <g>
                <text class={`f-small${blocked ? ' f-t-muted' : ''}`} x={px + L.labW - 8} y={y + 16} text-anchor="end" font-family="var(--mono)">{d.t}</text>
                {blocked
                  ? <path class="f-thin f-red" d={`M ${px + L.labW - 8 - d.t.length * 7.6} ${y + 12} H ${px + L.labW - 6}`} />
                  : <rect x={px + L.labW} y={y + 4} width={v * L.barW / 0.6} height="16" style={`fill: var(--fig-${d.ok ? 'green' : 'blue'}); fill-opacity: ${d.ok ? 0.6 : 0.45}`} />}
                <text class={`f-small${blocked ? ' f-t-red' : ''}`} x={px + L.labW + (blocked ? 0 : v * L.barW / 0.6 + 6)} y={y + 16}>{blocked ? t.masked : f2(v)}</text>
              </g>
            );
          })}
          {pi === 0 && <text class="f-small f-t-muted" x={px + L.labW} y={py + 16 + dist.length * L.rowH + 14}>{t.rest}</text>}
        </g>
      ))}
      {L.cls === 'fig-wide' && <path class="f-line f-muted" d="M 334 130 H 362" marker-end="url(#f-arrow-muted)" />}
    </svg>
  ))}
</Figure>
