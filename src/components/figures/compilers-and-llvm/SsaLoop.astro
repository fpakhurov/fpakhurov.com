---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The control-flow graph of sum_to after mem2reg (LLVM 17), with types left out and labels written without %.
// The trace runs the SSA form for n = 3: the values the phi nodes take each time control enters for.cond.
const n = 3;
const iVals: number[] = [], sVals: number[] = [], cmps: boolean[] = [];
let i = 1, s = 0;
for (;;) {
  iVals.push(i); sVals.push(s);
  const cmp = i <= n;
  cmps.push(cmp);
  if (!cmp) break;
  s = s + i; // %add
  i = i + 1; // %inc
}
if (iVals.join() !== '1,2,3,4' || sVals.join() !== '0,1,3,6' || s !== 6) throw new Error(`trace ${iVals} ${sVals}`);

type Key = 'entry' | 'cond' | 'body' | 'inc' | 'end';
const lines: Record<Key, string[]> = {
  entry: ['entry:', 'br for.cond'],
  cond: ['for.cond:', '%s.0 = phi [0, entry], [%add, for.inc]', '%i.0 = phi [1, entry], [%inc, for.inc]', '%cmp = icmp sle %i.0, %n', 'br %cmp, for.body, for.end'],
  body: ['for.body:', '%add = add %s.0, %i.0', 'br for.inc'],
  inc: ['for.inc:', '%inc = add %i.0, 1', 'br for.cond'],
  end: ['for.end:', 'ret %s.0'],
};
const keys: Key[] = ['entry', 'cond', 'body', 'inc', 'end'];
const isPhi = (line: string) => line.includes('phi');
const lh = 18;
const height = (k: Key) => 10 + lh * lines[k].length;
const yes = ru ? 'да' : 'true', no = ru ? 'нет' : 'false';
const t = ru
  ? {
      traceHead: 'n = 3, при входе в for.cond:', fails: 'четвёртая проверка ложна:', ret: 'возврат %s.0 = 6',
      narrow: ['n = 3: %i.0 = 1, 2, 3, 4,', '%s.0 = 0, 1, 3, 6; возврат 6'], back: 'обратная дуга', yes, no,
      steps: [
        'entry: переход к заголовку цикла',
        'for.cond: φ-узлы выбирают 0 и 1 при входе из entry, %add и %inc — при возврате из for.inc; затем проверка',
        'for.body: новая сумма получает новое имя, %add',
        'for.inc: новый счётчик, %inc, и обратная дуга',
        'for.end: возврат %s.0; при n = 3 заголовок видит i = 1, 2, 3, 4 и s = 0, 1, 3, 6, а функция возвращает 6',
      ],
    }
  : {
      traceHead: 'n = 3, on entering for.cond:', fails: 'the fourth test fails:', ret: 'return %s.0 = 6',
      narrow: ['n = 3: %i.0 = 1, 2, 3, 4,', '%s.0 = 0, 1, 3, 6; returns 6'], back: 'back edge', yes, no,
      steps: [
        'entry: jump to the loop header',
        'for.cond: the φ nodes pick 0 and 1 when control comes from entry, %add and %inc when it comes back from for.inc; then the test',
        'for.body: the new sum gets a new name, %add',
        'for.inc: the new counter, %inc, and the back edge',
        'for.end: return %s.0; with n = 3 the header sees i = 1, 2, 3, 4 and s = 0, 1, 3, 6, and returns 6',
      ],
    };
interface Layout { cls: string; W: number; H: number; box: Record<Key, [number, number, number]>; mono: string; pad: number }
const layouts: Layout[] = [
  {
    cls: 'fig-wide', W: 760, H: 404,
    box: { entry: [50, 20, 310], cond: [50, 96, 310], body: [50, 226, 310], inc: [50, 320, 310], end: [470, 226, 180] },
    mono: 'font-family: var(--mono)', pad: 10,
  },
  {
    cls: 'fig-narrow seq-narrow', W: 360, H: 514,
    box: { entry: [26, 16, 308], cond: [26, 90, 308], body: [26, 218, 308], inc: [26, 310, 308], end: [26, 402, 308] },
    mono: 'font-family: var(--mono); font-size: 13px', pad: 6,
  },
];
const cols = [540, 580, 620, 660];
const traceRows: [string, string[]][] = [
  ['%i.0', iVals.map(String)],
  ['%s.0', sVals.map(String)],
  ['%cmp', cmps.map((c) => (c ? t.yes : t.no))],
];
const id = 'ssa-loop';
---

<Figure
  id={id}
  title={ru ? 'Цикл sum_to в форме SSA после mem2reg' : 'The loop of sum_to in SSA form after mem2reg'}
  caption={ru
    ? 'Граф потока управления функции sum_to после прохода mem2reg (LLVM 17; типы опущены, метки записаны без %). Каждое значение присваивается ровно один раз. Переменные s и i, которые в C менялись в цикле, в SSA получают по два имени: значение на входе в заголовок (%s.0, %i.0) и новое значение, вычисленное в теле (%add, %inc); φ-узлы в заголовке for.cond выбирают одно из них по тому, откуда пришло управление (2). Справа — значения при n = 3: заголовок выполняется четыре раза, и функция возвращает 6 (5).'
    : 'The control-flow graph of sum_to after the mem2reg pass (LLVM 17; types left out, labels written without %). Every value is assigned exactly once. Where the C variables s and i changed inside the loop, SSA has two names for each: the value on entry to the header (%s.0, %i.0) and the new value made in the body (%add, %inc); the φ nodes of the header for.cond choose between them by where control came from (2). At the right: the values for n = 3; the header runs four times, and the function returns 6 (5).'}
>
  {layouts.map((L) => {
    const [cx, cy, cw] = L.box.cond;
    const mid = (k: Key) => L.box[k][0] + L.box[k][2] / 2;
    const bottom = (k: Key) => L.box[k][1] + height(k);
    const condMidY = cy + height('cond') / 2;
    const falseY = cy + height('cond') - 14;
    const [ex, ey, ew] = L.box.end;
    const [ix, iy] = L.box.inc;
    const wide = L.cls === 'fig-wide';
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Граф потока управления цикла с φ-узлами' : 'Control-flow graph of a loop with phi nodes'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Пять базовых блоков: entry переходит в заголовок for.cond, в котором два φ-узла для %s.0 и %i.0, сравнение и ветвление. Ветвь «да» ведёт в for.body, где %add = %s.0 + %i.0, затем в for.inc, где %inc = %i.0 + 1, и обратная дуга возвращает в for.cond. Ветвь «нет» ведёт в for.end, который возвращает %s.0. Для n = 3 значения %i.0 равны 1, 2, 3, 4, значения %s.0 — 0, 1, 3, 6, результат 6.'
          : 'Five basic blocks: entry jumps to the header for.cond, which holds two phi nodes for %s.0 and %i.0, a comparison and a branch. The true branch leads to for.body, where %add = %s.0 + %i.0, then to for.inc, where %inc = %i.0 + 1, and a back edge returns to for.cond. The false branch leads to for.end, which returns %s.0. For n = 3 the values of %i.0 are 1, 2, 3, 4, those of %s.0 are 0, 1, 3, 6, and the result is 6.'}</desc>
        {keys.map((k, step) => {
          const [x, y, w] = L.box[k];
          return (
            <g data-s={String(step + 1)}>
              <rect x={x} y={y} width={w} height={height(k)} rx="6" style={k === 'cond' ? `fill: ${toneVar.g}; fill-opacity: 0.08; stroke: ${toneVar.g}; stroke-width: 1.3` : 'fill: var(--paper-strong); stroke: var(--line); stroke-width: 1.3'} />
              {lines[k].map((line, j) => (
                <text class={`f-small${isPhi(line) ? ' f-t-amber' : ''}`} x={x + L.pad} y={y + 18 + j * lh} style={j === 0 ? `${L.mono}; font-weight: 650` : L.mono}>{line}</text>
              ))}
              <Badge x={x + w - 14} y={y + 14} n={step + 1} />
            </g>
          );
        })}
        <g data-s="1">
          <path class="f-line f-muted" d={`M ${mid('entry')} ${bottom('entry')} V ${cy - 2}`} marker-end="url(#f-arrow-muted)" />
        </g>
        <g data-s="3">
          <path class="f-line f-green" d={`M ${mid('cond')} ${bottom('cond')} V ${L.box.body[1] - 2}`} marker-end="url(#f-arrow-green)" />
          <text class="f-small f-t-green" x={mid('cond') + 8} y={bottom('cond') + 18}>{t.yes}</text>
        </g>
        <g data-s="4">
          <path class="f-line f-muted" d={`M ${mid('body')} ${bottom('body')} V ${iy - 2}`} marker-end="url(#f-arrow-muted)" />
          <path class="f-line f-amber" d={`M ${ix} ${iy + height('inc') / 2} H ${ix - 14} V ${condMidY} H ${cx - 2}`} marker-end="url(#f-arrow-amber)" />
          {wide && <text class="f-small f-t-amber" x="20" y={(iy + condMidY) / 2 + 40} transform={`rotate(-90 20 ${(iy + condMidY) / 2 + 40})`}>{t.back}</text>}
        </g>
        <g data-s="5">
          {wide
            ? <path class="f-line f-red" d={`M ${cx + cw} ${falseY} H ${ex + ew / 2} V ${ey - 2}`} marker-end="url(#f-arrow-red)" />
            : <path class="f-line f-red" d={`M ${cx + cw} ${condMidY} H 348 V ${ey + height('end') / 2} H ${ex + ew + 2}`} marker-end="url(#f-arrow-red)" />}
          {wide
            ? <text class="f-small f-t-red" x={cx + cw + 12} y={falseY - 8}>{t.no}</text>
            : <text class="f-small f-t-red" x="344" y={ey - 8} text-anchor="end">{t.no}</text>}
          {wide
            ? <g>
                <text class="f-small" x="470" y="40" style="font-weight: 650">{t.traceHead}</text>
                {traceRows.map(([name, vals], r) => (
                  <g>
                    <text class="f-small" x="470" y={66 + r * 22} style={L.mono}>{name}</text>
                    {vals.map((v, c) => <text class={`f-small${r === 2 && c === 3 ? ' f-t-red' : ''}`} x={cols[c]} y={66 + r * 22}>{v}</text>)}
                  </g>
                ))}
                <text class="f-small f-t-muted" x="470" y="146">{t.fails}</text>
                <text class="f-small" x="470" y="166" style={L.mono}>{t.ret}</text>
              </g>
            : t.narrow.map((line, j) => <text class="f-small" x="26" y={478 + j * 20} style={L.mono}>{line}</text>)}
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
