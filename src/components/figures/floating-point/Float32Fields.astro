---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The single-precision bits of −12.5, split into sign, exponent and fraction, and decoded as in the note.
const value = -12.5;
const dv = new DataView(new ArrayBuffer(4));
dv.setFloat32(0, value);
const word = dv.getUint32(0);
const bits = word.toString(2).padStart(32, '0');
const s = word >>> 31, E = (word >>> 23) & 0xff, f = word & 0x7fffff;
const e = E - 127, sig = 1 + f / 2 ** 23;
const back = (s ? -1 : 1) * sig * 2 ** e;
if (word !== 0xc1480000 || E !== 130 || e !== 3 || sig !== 1.5625 || back !== value) throw new Error(`Float32Fields: decoding drifted (${word.toString(16)})`);

// field of bit i (i = 0 is bit 31): sign, exponent, fraction
const kind = (i: number) => (i === 0 ? 'red' : i <= 8 ? 'amber' : 'blue');
const style = (k: string) => `fill: var(--fig-${k}); fill-opacity: 0.14; stroke: var(--fig-${k}); stroke-width: 1`;
const step = (k: string) => (k === 'red' ? '1' : k === 'amber' ? '2' : '3');

const lines = ru
  ? [`s = ${s}: число отрицательное`, `E = 1000 0010₂ = ${E}, e = ${E} − 127 = ${e}`, `1.f = 1.1001₂ = 1 + 1/2 + 1/16 = ${sig}`, `x = (−1)¹ × ${sig} × 2³ = −12.5`]
  : [`s = ${s}: negative`, `E = 1000 0010₂ = ${E}, e = ${E} − 127 = ${e}`, `1.f = 1.1001₂ = 1 + 1/2 + 1/16 = ${sig}`, `x = (−1)¹ × ${sig} × 2³ = −12.5`];
const tones = ['f-t-red', 'f-t-amber', 'f-t-blue', ''];
const t = ru
  ? { sign: 'знак', exp: 'порядок E, 8 бит', frac: 'дробная часть f, 23 бита', expS: 'порядок E', fracS: 'дробная часть f',
      steps: ['знаковый бит', 'поле порядка минус смещение 127', 'дробная часть со скрытой единицей', 'значение'] }
  : { sign: 'sign', exp: 'exponent E, 8 bits', frac: 'fraction f, 23 bits', expS: 'exponent E', fracS: 'fraction f',
      steps: ['the sign bit', 'the exponent field minus the bias 127', 'the fraction with the hidden 1', 'the value'] };

interface Layout { cls: string; W: number; H: number; x0: number; cw: number; ch: number; perRow: number; rowY: number[]; lineY: number[]; lx: number; wide: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 252, x0: 44, cw: 21, ch: 30, perRow: 32, rowY: [46], lineY: [128, 160, 192, 224], lx: 68, wide: true },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 300, x0: 20, cw: 20, ch: 30, perRow: 16, rowY: [46, 106], lineY: [184, 214, 244, 274], lx: 40, wide: false },
];
const mono = 'font-family: var(--mono)';
const id = 'float32-fields';
---

<Figure
  id={id}
  title={ru ? 'Число −12.5 одинарной точности, бит за битом' : 'The single-precision float −12.5, bit by bit'}
  caption={ru
    ? 'Слово 0xC1480000: знаковый бит (красный), 8-битное поле порядка (оранжевое) и 23-битная дробная часть (синяя). Знак 1 означает отрицательное число (1); поле порядка 130 минус смещение 127 даёт порядок 3 (2); дробная часть 1001 с восстановленной скрытой единицей даёт мантиссу 1.1001₂ = 1.5625 (3); значение равно −1.5625 × 8 = −12.5 (4).'
    : 'The word 0xC1480000: the sign bit (red), the 8-bit exponent field (amber) and the 23-bit fraction (blue). The sign 1 makes the number negative (1); the exponent field 130 minus the bias 127 gives the exponent 3 (2); the fraction 1001 with the hidden 1 restored gives the significand 1.1001₂ = 1.5625 (3); the value is −1.5625 × 8 = −12.5 (4).'}
>
  {layouts.map((L) => {
    const cx = (i: number) => L.x0 + (i % L.perRow) * L.cw;
    const cy = (i: number) => L.rowY[Math.floor(i / L.perRow)];
    const top = L.rowY[0] - 10;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Поля числа одинарной точности' : 'The fields of a single-precision number'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Тридцать два бита 1 10000010 10010000000000000000000, раскрашенные по полям: знак, порядок и дробная часть. Под ними четыре строки расшифровки: s = 1; E = 130, e = 3; мантисса 1.5625; значение −12.5.'
          : 'Thirty-two bits, 1 10000010 10010000000000000000000, coloured by field: sign, exponent and fraction. Below, four decoding lines: s = 1; E = 130, e = 3; significand 1.5625; value −12.5.'}</desc>
        <g data-s="1"><text class="f-small f-t-red" x={cx(0)} y={top}>{t.sign}</text></g>
        <g data-s="2"><text class="f-small f-t-amber" x={cx(1) + 16} y={top}>{L.wide ? t.exp : t.expS}</text></g>
        <g data-s="3"><text class="f-small f-t-blue" x={cx(9) + 6} y={top}>{L.wide ? t.frac : t.fracS}</text></g>
        {[...bits].map((b, i) => (
          <g data-s={step(kind(i))}>
            <rect x={cx(i)} y={cy(i)} width={L.cw} height={L.ch} style={style(kind(i))} />
            <text class="f-small" x={cx(i) + L.cw / 2} y={cy(i) + 20} text-anchor="middle" style={mono}>{b}</text>
          </g>
        ))}
        {[[0, '31'], [8, '23'], [31, '0']].map(([i, label]) => (
          <text class="f-small f-t-muted" x={cx(i as number) + L.cw / 2} y={cy(i as number) + L.ch + 16} text-anchor="middle">{label}</text>
        ))}
        {lines.map((line, k) => (
          <g data-s={`${k + 1}`}>
            <Badge x={L.lx - 18} y={L.lineY[k] - 5} n={k + 1} />
            <text class={`f-small ${tones[k]}`} x={L.lx} y={L.lineY[k]}>{line}</text>
          </g>
        ))}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
