---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Every non-negative finite value of a toy 6-bit format with the IEEE layout: 1 sign bit, a 3-bit exponent
// field with bias 3 and a 2-bit fraction (precision p = 3). E = 0 gives 0 and the subnormals, E = 7 is reserved
// for infinity and NaN. The spacing doubles at each power of two; the subnormals continue the spacing of the
// lowest normal binade down to 0.
const bias = 3, fbits = 2;
const vals: { v: number; sub: boolean }[] = [];
for (let E = 0; E <= 6; E++) {
  for (let f = 0; f < 1 << fbits; f++) {
    const v = E === 0 ? (f / (1 << fbits)) * 2 ** (1 - bias) : (1 + f / (1 << fbits)) * 2 ** (E - bias);
    vals.push({ v, sub: E === 0 && f > 0 });
  }
}
const max = Math.max(...vals.map((x) => x.v));
const minSub = vals.filter((x) => x.sub)[0].v;
const minNormal = 2 ** (1 - bias);
if (vals.length !== 28 || max !== 14 || minSub !== 1 / 16 || minNormal !== 0.25) throw new Error('NumberLine: toy format drifted');
const small = vals.filter((x) => x.v <= 1);
if (small.length !== 13) throw new Error(`NumberLine: ${small.length} values in [0, 1]`);

// binades shown with their spacing: [lo, hi) and the gap between neighbours inside it
const gap = (lo: number) => (lo < minNormal ? minSub : lo * 2 ** (1 - (fbits + 1)));
const bigBands = [1, 2, 4, 8].map((lo) => ({ lo, hi: Math.min(2 * lo, max), g: gap(lo) }));
const smallBands = [0, 0.25, 0.5].map((lo) => ({ lo, hi: lo === 0 ? 0.25 : 2 * lo, g: gap(lo) }));
if (bigBands.map((b) => b.g).join(' ') !== '0.25 0.5 1 2' || smallBands.map((b) => b.g).join(' ') !== '0.0625 0.0625 0.125') throw new Error('NumberLine: spacings drifted');
const frac = (g: number) => (g >= 1 ? String(g) : `1/${Math.round(1 / g)}`);

const t = ru
  ? { head: 'расстояние между соседями:', zoom: '[0, 1] крупным планом', legend: 'зелёные: субнормальные числа', max: 'наибольшее' }
  : { head: 'gap between neighbours:', zoom: '[0, 1] enlarged', legend: 'green: subnormal numbers', max: 'largest' };

interface Layout { cls: string; W: number; H: number; x0: number; x1: number; head: number; a1: number; a2: number; legend: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 262, x0: 40, x1: 720, head: 26, a1: 92, a2: 204, legend: 250 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 266, x0: 22, x1: 338, head: 22, a1: 90, a2: 202, legend: 252 },
];
const big = [0, 1, 2, 4, 8, 14];
const smallTicks: [number, string][] = [[0, '0'], [0.25, '1/4'], [0.5, '1/2'], [1, '1']];
const id = 'float-number-line';
---

<Figure
  id={id}
  title={ru ? 'Числа с плавающей точкой на прямой: промежутки удваиваются' : 'Floating-point numbers on the line: the gaps double'}
  caption={ru
    ? 'Все неотрицательные конечные значения игрушечного 6-битного формата с раскладкой полей IEEE: 1 бит знака, 3 бита порядка со смещением 3 и 2 бита дробной части. Сверху вся прямая от 0 до наибольшего значения 14: внутри каждого промежутка от 2ᵉ до 2ᵉ⁺¹ четыре равноотстоящих числа, и расстояние между ними удваивается с каждой степенью двойки (1/4, 1/2, 1, 2). Снизу — отрезок [0, 1] крупным планом: наименьшее нормальное число 1/4, а субнормальные числа 1/16, 2/16, 3/16 (зелёные) продолжают шаг 1/16 до нуля — это постепенное исчезновение порядка (gradual underflow). Одинарная точность подчиняется тем же правилам, но с 23 битами дробной части.'
    : 'Every non-negative finite value of a toy 6-bit format with the IEEE layout: 1 sign bit, a 3-bit exponent with bias 3, and a 2-bit fraction. Top: the whole line from 0 to the largest value, 14. Each interval from 2ᵉ to 2ᵉ⁺¹ holds four evenly spaced numbers, and the gap doubles at every power of two (1/4, 1/2, 1, 2). Bottom: the interval [0, 1] enlarged. The smallest normal number is 1/4, and the subnormal numbers 1/16, 2/16 and 3/16 (green) continue the gap of 1/16 down to zero: gradual underflow. Single precision follows the same rules with a 23-bit fraction.'}
>
  {layouts.map((L) => {
    const s1 = scale([0, max], [L.x0, L.x1]);
    const s2 = scale([0, 1], [L.x0, L.x1]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Представимые значения игрушечного формата' : 'The representable values of a toy format'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Две числовые прямые с засечками в представимых значениях. На верхней, от 0 до 14, засечки сгущаются к нулю: шаг 2 между 8 и 14, 1 между 4 и 8, 1/2 между 2 и 4, 1/4 между 1 и 2. Нижняя показывает отрезок от 0 до 1: шаг 1/8 между 1/2 и 1, 1/16 между 1/4 и 1/2 и тот же шаг 1/16 у субнормальных чисел между 0 и 1/4.'
          : 'Two number lines with ticks at the representable values. On the top line, from 0 to 14, the ticks crowd towards zero: a gap of 2 between 8 and 14, 1 between 4 and 8, 1/2 between 2 and 4, 1/4 between 1 and 2. The bottom line shows 0 to 1: a gap of 1/8 between 1/2 and 1, 1/16 between 1/4 and 1/2, and the same 1/16 for the subnormal numbers between 0 and 1/4.'}</desc>
        <text class="f-small f-t-muted" x={L.x0} y={L.head}>{t.head}</text>

        {/* the whole line */}
        {bigBands.map((b, k) => (
          <g>
            <rect x={s1(b.lo)} y={L.a1 - 30} width={s1(b.hi) - s1(b.lo)} height="30" class="f-fill-blue" style={`fill-opacity: ${k % 2 ? 0.07 : 0.15}`} />
            <text class="f-small f-t-blue" x={(s1(b.lo) + s1(b.hi)) / 2} y={L.a1 - 38} text-anchor="middle">{frac(b.g)}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${L.x0} ${L.a1} H ${L.x1}`} />
        {vals.map((x) => <path class={x.sub ? 'f-line f-green' : 'f-line'} style="stroke-width: 1.3" d={`M ${s1(x.v).toFixed(2)} ${L.a1 - 12} V ${L.a1}`} />)}
        {big.map((v) => <text class="f-small" x={s1(v)} y={L.a1 + 18} text-anchor="middle">{v}</text>)}

        {/* zoom guides from [0, 1] on the top line to the bottom line */}
        <path class="f-thin f-muted f-dash" d={`M ${L.x0} ${L.a1 + 24} L ${L.x0} ${L.a2 - 52} M ${s1(1)} ${L.a1 + 24} L ${L.x1} ${L.a2 - 52}`} />
        <text class="f-small f-t-muted" x={L.x0 + 10} y={L.a1 + 48}>{t.zoom}</text>

        {/* [0, 1] enlarged */}
        {smallBands.map((b, k) => (
          <g>
            <rect x={s2(b.lo)} y={L.a2 - 30} width={s2(b.hi) - s2(b.lo)} height="30" class={k === 0 ? 'f-fill-green' : 'f-fill-blue'} style={`fill-opacity: ${k === 1 ? 0.07 : 0.15}`} />
            <text class={`f-small ${k === 0 ? 'f-t-green' : 'f-t-blue'}`} x={(s2(b.lo) + s2(b.hi)) / 2} y={L.a2 - 38} text-anchor="middle">{frac(b.g)}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${L.x0} ${L.a2} H ${L.x1}`} />
        {small.map((x) => <path class={x.sub ? 'f-line f-green' : 'f-line'} style="stroke-width: 1.5" d={`M ${s2(x.v).toFixed(2)} ${L.a2 - 14} V ${L.a2}`} />)}
        {smallTicks.map(([v, label]) => <text class="f-small" x={s2(v)} y={L.a2 + 18} text-anchor="middle">{label}</text>)}
        <text class="f-small f-t-green" x={L.x0} y={L.legend}>{t.legend}</text>
      </svg>
    );
  })}
</Figure>
