---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { byDepth, depths, grid, noise, best, sets } from './data';
import { f } from '../decision-trees/data';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Regression trees of every depth fitted to 200 training sets of 40 points of y = sin 2πx + N(0, 0.3²).
// Left: 20 of the fits at depth 2 and at full depth, their mean over all 200 sets, and the truth. Right: squared bias,
// variance and expected test error (noise 0.09 + bias² + variance) against depth.
const d2 = byDepth[1], full = byDepth[byDepth.length - 1];
const check = [d2.bias2, d2.variance, full.bias2, full.variance, best.total, byDepth[0].bias2, byDepth[0].variance].map((v) => v.toFixed(3)).join(' ');
if (check !== '0.025 0.061 0.001 0.095 0.150 0.072 0.043' || best.depth !== 3 || sets !== 200) throw new Error(`BiasVarianceTrees: numbers drifted from the caption (${check})`);
const t = ru
  ? { names: ['глубина 2', 'без ограничения'], nums: [[`смещение² ${d2.bias2.toFixed(3)}`, `разброс ${d2.variance.toFixed(3)}`], [`смещение² ${full.bias2.toFixed(3)}`, `разброс ${full.variance.toFixed(3)}`]], depth: 'глубина дерева', full: 'полн.', bias: 'смещение²', vari: 'разброс', total: 'ошибка на тесте', noise: 'шум σ²', best: `минимум: глубина 3, ${best.total.toFixed(3)}` }
  : { names: ['depth 2', 'full depth'], nums: [[`bias² ${d2.bias2.toFixed(3)}`, `variance ${d2.variance.toFixed(3)}`], [`bias² ${full.bias2.toFixed(3)}`, `variance ${full.variance.toFixed(3)}`]], depth: 'tree depth', full: 'full', bias: 'bias²', vari: 'variance', total: 'test error', noise: 'noise σ²', best: `minimum: depth 3, ${best.total.toFixed(3)}` };
const id = 'bias-variance-trees';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 310, bundles: [[16, 60], [216, 60]], bw: 180, bh: 190, curve: [470, 30, 270, 220], nums: t.nums, nameDy: 44 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 760, bundles: [[16, 60], [16, 320]], bw: 328, bh: 170, curve: [56, 540, 280, 170], nums: t.nums.map((n) => [n.join(' · ')]), nameDy: 30 },
];
// the bias and variance line(s) above each bundle panel, stacked upwards from 12 above the panel
const numY = (lines: string[], i: number) => -12 - (lines.length - 1 - i) * 16;
const stepPath = (vals: number[], sx: (v: number) => number, sy: (v: number) => number) =>
  vals.map((v, j) => `${j ? 'L' : 'M'} ${sx(grid[j]).toFixed(1)} ${sy(Math.max(-1.8, Math.min(1.8, v))).toFixed(1)}`).join(' ');
const curves = [
  { key: 'bias2', tone: 'blue', label: 'bias' },
  { key: 'variance', tone: 'amber', label: 'vari' },
  { key: 'total', tone: 'red', label: 'total' },
] as const;
const xLabels = depths.map((dd) => (Number.isFinite(dd) ? String(dd) : t.full));
---

<Figure
  id={id}
  title={ru ? 'Смещение и разброс регрессионных деревьев' : 'Bias and variance of regression trees'}
  caption={ru
    ? `На двух панелях с пучками — 20 из ${sets} деревьев, выращенных на независимых обучающих выборках по 40 точек y = sin 2πx + шум (σ = 0.3), их среднее по всем ${sets} выборкам (синее) и истинная функция (пунктир). Дерево глубины 2 в среднем огрубляет синусоиду (смещение), полностью выращенное в среднем почти точно, но каждое повторяет шум своей выборки (разброс ${full.variance.toFixed(3)}, примерно σ² = 0.09). На панели с кривыми квадрат смещения падает с глубиной, разброс растёт; ожидаемая ошибка на тесте, их сумма с шумом 0.09, минимальна на глубине 3.`
    : `In the two bundle panels, 20 of ${sets} trees grown on independent training sets of 40 points of y = sin 2πx + noise (σ = 0.3), their mean over all ${sets} sets (blue) and the true function (dotted). The depth-2 tree coarsens the sine on average (bias); the fully grown tree is nearly right on average, but each one copies the noise of its own sample (variance ${full.variance.toFixed(3)}, about σ² = 0.09). In the curve panel, the squared bias falls with depth and the variance rises; the expected test error, their sum plus the noise 0.09, is smallest at depth 3.`}
>
  {layouts.map((L) => {
    const [cx, cy, cw, ch] = L.curve;
    const ux = scale([0, depths.length - 1], [cx, cx + cw]), uy = scale([0, 0.22], [cy + ch, cy]);
    const bestIdx = byDepth.indexOf(best);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Пучки деревьев и U-образная кривая ошибки' : 'Bundles of trees and the U-shaped error curve'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Две панели с пучками ступенчатых кривых, узким и широким; справа убывающая кривая смещения, возрастающая кривая разброса и их сумма с минимумом на глубине 3.' : 'Two panels with bundles of step curves, one tight and one wide; on the right a falling bias curve, a rising variance curve and their sum with its minimum at depth 3.'}</desc>
        {[d2, full].map((dd, k) => {
          const [x0, y0] = L.bundles[k];
          const sx = scale([0, 1], [x0, x0 + L.bw]), sy = scale([-1.8, 1.8], [y0 + L.bh, y0]);
          return (
            <g>
              <text class="f-small" x={x0} y={y0 - L.nameDy}>{t.names[k]}</text>
              {L.nums[k].map((s, i) => <text class="f-note" x={x0} y={y0 + numY(L.nums[k], i)}>{s}</text>)}
              <rect x={x0} y={y0} width={L.bw} height={L.bh} style="fill: none; stroke: var(--line); stroke-width: 1" />
              {dd.fits.slice(0, 20).map((r) => <path class="f-thin f-muted" style="stroke-opacity: .45" d={stepPath(r, sx, sy)} />)}
              <path class="f-thin f-dot" style="stroke: var(--ink); stroke-width: 1.6" d={stepPath(grid.map(f), sx, sy)} />
              <path class="f-line f-blue f-bold" d={stepPath(dd.meanFit, sx, sy)} />
            </g>
          );
        })}
        <path class="f-axis" d={`M ${cx} ${cy} V ${cy + ch} H ${cx + cw}`} />
        {[0, 0.1, 0.2].map((v) => <g><path class="f-grid" d={`M ${cx} ${uy(v)} H ${cx + cw}`} /><text class="f-note" x={cx - 6} y={uy(v) + 4} text-anchor="end">{v}</text></g>)}
        {xLabels.map((s, i) => <text class="f-note" x={ux(i)} y={cy + ch + 16} text-anchor="middle">{s}</text>)}
        <text class="f-small f-t-muted" x={cx + cw / 2} y={cy + ch + 36} text-anchor="middle">{t.depth}</text>
        <path class="f-thin f-muted f-dash" d={`M ${cx} ${uy(noise)} H ${cx + cw}`} />
        <text class="f-note" x={cx + 8} y={uy(noise) - 6}>{t.noise}</text>
        {curves.map((c) => (
          <g>
            <path class={`f-line f-${c.tone}`} d={byDepth.map((dd, i) => `${i ? 'L' : 'M'} ${ux(i).toFixed(1)} ${uy(dd[c.key]).toFixed(1)}`).join(' ')} />
            {byDepth.map((dd, i) => <circle cx={ux(i)} cy={uy(dd[c.key])} r="2.8" class={`f-solid-${c.tone === 'amber' ? 'muted' : c.tone}`} style={c.tone === 'amber' ? 'fill: var(--fig-amber)' : ''} />)}
          </g>
        ))}
        <text class="f-small f-t-red" x={ux(1)} y={uy(byDepth[0].total) - 6}>{t.total}</text>
        <text class="f-small f-t-blue" x={ux(4)} y={uy(byDepth[4].bias2) - 8}>{t.bias}</text>
        <text class="f-small f-t-amber" x={ux(6)} y={uy(byDepth[6].variance) + 18} text-anchor="middle">{t.vari}</text>
        <circle cx={ux(bestIdx)} cy={uy(best.total)} r="6" style="fill: none; stroke: var(--fig-red); stroke-width: 1.6" />
        <text class="f-note" x={ux(bestIdx) + 10} y={uy(best.total) + 22}>{t.best}</text>
      </svg>
    );
  })}
</Figure>
