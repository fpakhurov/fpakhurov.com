---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Op from '../seqflow/Op.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One iteration of search over a language model's proposals: select, propose, verify, transition, evaluate and keep.
const k = 3, b = 3;
if (k !== 3 || b !== 3) throw new Error('ProposeVerifySearch: k and b should match the Code section');
const t = ru
  ? {
      title: 'Поиск по предложениям модели',
      front: 'граница', frontSub: `${b} лучших состояния`, model: 'языковая модель', modelSub: `предлагает ${k} действия`,
      verify: 'проверка', drop: 'неверные', drop2: 'отброшены', trans: 'переход f(s, a)', transSub: 'симулятор, модель мира',
      value: 'ценность V(s′)', valueSub: 'оставляет b лучших', plan: 'цель: план готов', repeat: 'повторить с новой границей',
      greedy: `жадный агент — частный случай: k = 1, b = 1, без проверки`,
      steps: ['выбор: состояния текущей границы', 'предложение: модель выдаёт k кандидатов действий', 'проверка: недопустимые и некорректные предложения отбрасываются', 'переход: каждое оставшееся действие даёт следующее состояние', 'оценка: новые состояния оцениваются, b лучших остаются; состояние, прошедшее проверку цели, завершает поиск'],
      desc: 'Цикл слева направо: граница из b лучших состояний; языковая модель предлагает k действий для каждого; блок проверки отбрасывает недопустимые; модель перехода (симулятор или модель мира) даёт следующие состояния; оценка ценности оставляет b лучших и возвращает их на границу. Если следующее состояние проходит проверку цели, поиск выдаёт план. Подпись внизу: жадный агент соответствует k = 1, b = 1 без проверки.',
    }
  : {
      title: "Search over a model's proposals",
      front: 'frontier', frontSub: `the ${b} best states`, model: 'language model', modelSub: `proposes ${k} actions`,
      verify: 'verify', drop: 'illegal:', drop2: 'dropped', trans: 'transition f(s, a)', transSub: 'simulator, world model',
      value: 'value V(s′)', valueSub: 'keeps the best b', plan: 'goal reached: plan', repeat: 'repeat with the new frontier',
      greedy: 'greedy proposal-following is the special case k = 1, b = 1, no verifier',
      steps: ['select: the states of the current frontier', 'propose: the model samples k candidate actions', 'verify: illegal or malformed proposals are dropped', 'transition: each surviving action gives a next state', 'evaluate and keep: new states are scored and the best b kept; a state that passes the goal test ends the search'],
      desc: 'A cycle from left to right: a frontier of the b best states; the language model proposes k actions for each; a verify block drops illegal ones; a transition model (a simulator or a world model) gives the next states; a value estimate keeps the best b and returns them to the frontier. If a next state passes the goal test, the search returns a plan. A note at the bottom: greedy following is k = 1, b = 1 without a verifier.',
    };
const id = 'propose-verify-search';
const caption = ru
  ? 'Синее — состояние поиска, красное — то, что выдаёт модель, янтарное — то, что решает, какие варианты выживут. Модель играет две роли: распределение предложений и (часто) оценку ценности; ни одна из них не гарантирована. Проверка и проверка цели — механические: правила среды, PDDL-домен, тесты. Tree of Thoughts, RAP и LATS отличаются алгоритмом поиска (лучевой, в глубину, MCTS) и тем, откуда берутся переход и оценка.'
  : 'Blue: the state of the search. Red: what the model emits. Amber: what decides which candidates survive. The model plays two roles, the proposal distribution and (often) the value estimate, and neither comes with a guarantee. The verifier and the goal test are mechanical: the rules of the environment, a PDDL domain, unit tests. Tree of Thoughts, RAP and LATS differ in the search algorithm (beam, depth-first, MCTS) and in where the transition and the value come from.';
const opHalf = (14 + t.verify.length * 7.6) / 2;
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 300" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <g data-s="1">
      <Box x={16} y={110} w={136} h={56} label={t.front} sub={t.frontSub} tone="h" />
      <Badge x={84} y={92} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[152, 138], [180, 138]]} />
      <Box x={182} y={110} w={140} h={56} label={t.model} sub={t.modelSub} />
      <Badge x={252} y={92} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[322, 138], [382 - opHalf - 2, 138]]} tone="red" />
      <Op x={382} y={138} sym={t.verify} tone="amber" />
      <Arrow pts={[[382, 151], [382, 196]]} tone="red" dashed />
      <text class="f-small f-t-red" x="382" y="214" text-anchor="middle">{t.drop}</text>
      <text class="f-small f-t-red" x="382" y="230" text-anchor="middle">{t.drop2}</text>
      <Badge x={382} y={106} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[382 + opHalf, 138], [434, 138]]} tone="red" />
      <Box x={436} y={110} w={156} h={56} label={t.trans} sub={t.transSub} />
      <Badge x={514} y={186} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[592, 138], [610, 138]]} tone="blue" />
      <Box x={612} y={110} w={140} h={56} label={t.value} sub={t.valueSub} tone="g" />
      <Arrow pts={[[682, 166], [682, 250], [84, 250], [84, 168]]} tone="blue" />
      <text class="f-small f-t-blue" x="430" y="268" text-anchor="middle">{t.repeat}</text>
      <Arrow pts={[[514, 110], [514, 50], [610, 50]]} tone="red" />
      <Box x={612} y={30} w={140} h={40} label={t.plan} tone="y" />
      <Badge x={704} y={200} n={5} />
    </g>
    <text class="f-small f-t-muted" x="16" y="292">{t.greedy}</text>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 470" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <g data-s="1">
      <Box x={60} y={12} w={190} h={52} label={t.front} sub={t.frontSub} tone="h" />
      <Badge x={272} y={38} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[155, 64], [155, 88]]} />
      <Box x={60} y={90} w={190} h={52} label={t.model} sub={t.modelSub} />
      <Badge x={272} y={116} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[155, 142], [155, 161]]} tone="red" />
      <Op x={155} y={176} sym={t.verify} tone="amber" />
      <Arrow pts={[[155 + opHalf, 176], [262, 176]]} tone="red" dashed />
      <text class="f-small f-t-red" x="268" y="172">{t.drop}</text>
      <text class="f-small f-t-red" x="268" y="190">{t.drop2}</text>
      <Badge x={90} y={176} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[155, 189], [155, 212]]} tone="red" />
      <Box x={60} y={214} w={190} h={52} label={t.trans} sub={t.transSub} />
      <Badge x={272} y={222} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[155, 266], [155, 290]]} tone="blue" />
      <Box x={60} y={292} w={190} h={52} label={t.value} sub={t.valueSub} tone="g" />
      <Arrow pts={[[60, 318], [30, 318], [30, 38], [58, 38]]} tone="blue" />
      <Arrow pts={[[250, 248], [300, 248], [300, 392], [252, 392]]} tone="red" />
      <Box x={60} y={372} w={190} h={40} label={t.plan} tone="y" />
      <Badge x={272} y={318} n={5} />
    </g>
    <text class="f-small f-t-muted" x="8" y="440">{ru ? 'жадный агент: k = 1, b = 1,' : 'greedy: k = 1, b = 1,'}</text>
    <text class="f-small f-t-muted" x="8" y="460">{ru ? 'без проверки' : 'no verifier'}</text>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
