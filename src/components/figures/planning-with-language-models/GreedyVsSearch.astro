---
import Figure from '../Figure.astro';
import Arrow from '../seqflow/Arrow.astro';
import { curve } from '../geometry';
import { canon, apply, key, glyph, type State, type Move } from './blocks';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The Sussman anomaly: C on A, B on the table; goal A on B on C. Top: the greedy proposer's trap (B onto C, then B back
// to the table, repeated). Bottom: the optimal plan that A* returns in the Code section.
const start = canon([['A', 'C'], ['B']]);
const goal = canon([['C', 'B', 'A']]);
const trap = apply(start, ['B', 'C']);
const back = apply(trap, ['B', 'T']);
if (key(back) !== key(start)) throw new Error('GreedyVsSearch: B to the table should return to the start');
if (trap.length !== 1) throw new Error('GreedyVsSearch: after B onto C all three blocks should form one tower');
const plan: Move[] = [['C', 'T'], ['B', 'C'], ['A', 'B']];
const path: State[] = [start];
for (const m of plan) path.push(apply(path[path.length - 1], m));
if (key(path[3]) !== key(goal)) throw new Error('GreedyVsSearch: the plan of the Code section does not reach the goal');

const t = ru
  ? {
      title: 'Жадное следование предложениям против поиска',
      greedy: 'жадно: берём первое предложение модели', astar: 'A*: поиск с проверкой цели',
      bc: 'B на C', bcSub: 'достигает on(B, C)', bt: 'B на стол', btSub: 'единственный ход', again: 'снова',
      cyc1: 'в одном запуске цикл повторился', cyc2: '6 раз, и план занял 15 ходов', cyc3: 'вместо 3',
      start: 'начало', buried: 'A погребён', startAgain: 'снова начало', goal: 'цель',
      m: ['C на стол', 'B на C', 'A на B'], note: 'A* раскрывает 4 состояния; план оптимален',
      nl1: 'цель, достигнутая слишком рано, требует отката:', nl2: 'цикл повторился 6 раз (15 ходов)', nlm: '1 C на стол · 2 B на C · 3 A на B',
      desc: 'Верхний ряд: из начального состояния (C на A, B на столе) жадный агент ставит B на C, потому что это делает истинным целевой факт on(B, C); теперь A погребён под башней, и единственный допустимый ход снимает B обратно на стол, возвращая начальное состояние. Красная дуга показывает повтор цикла. Нижний ряд: план A* из трёх ходов — C на стол, B на C, A на B — приводит к башне A на B на C.',
    }
  : {
      title: 'Greedy proposal-following against search',
      greedy: "greedy: take the model's first proposal", astar: 'A*: search with a goal test',
      bc: 'B onto C', bcSub: 'makes on(B, C) true', bt: 'B to the table', btSub: 'the only legal move', again: 'again',
      cyc1: 'in one run the cycle repeated', cyc2: '6 times, and the plan took 15 moves', cyc3: 'instead of 3',
      start: 'start', buried: 'A is buried', startAgain: 'start again', goal: 'goal',
      m: ['C to the table', 'B onto C', 'A onto B'], note: 'A* expands 4 states; the plan is optimal',
      nl1: 'a goal fact made true too early must be undone:', nl2: 'the cycle repeated 6 times (15 moves)', nlm: '1 C to the table · 2 B onto C · 3 A onto B',
      desc: 'Top row: from the start state (C on A, B on the table) the greedy agent puts B onto C, because that makes the goal fact on(B, C) true; now A is buried under a tower, and the only legal move takes B back to the table, which restores the start state. A red arc marks the cycle repeating. Bottom row: the three-move plan of A*, C to the table, B onto C, A onto B, reaches the tower A on B on C.',
    };
const id = 'greedy-vs-search';
const caption = ru
  ? 'Аномалия Зуссмана. Заскриптованная модель предлагает ходы, которые делают целевой факт истинным, и избегает ходов, которые его отменяют. Ход «B на C» выглядит хорошим в начальном состоянии каждый раз, когда агент туда возвращается, поэтому жадный агент ходит по кругу, пока шум не разрывает ничью; в десяти запусках раздела «Код» планы заняли от 3 до 15 ходов, в среднем 6.8. Поиск с проверкой цели и допустимой эвристикой (число блоков не на своём месте) находит оптимальный план из 3 ходов.'
  : 'The Sussman anomaly. The scripted model proposes moves that make a goal fact true and avoids moves that undo one. "B onto C" looks good in the start state every time the agent returns there, so the greedy agent cycles until noise breaks the tie; over the ten runs of the Code section its plans took 3 to 15 moves, 6.8 on average. Search with a goal test and an admissible heuristic (the number of blocks not yet in their final place) finds the optimal plan of 3 moves.';

const blocks = (s: State, cx: number, base: number, size: number, gap: number) => glyph(s, cx, base, size, gap);
const half = (s: State, size: number, gap: number) => (s.length * size + (s.length - 1) * gap) / 2;
// wide layout
const W = { size: 22, gap: 6, b1: 132, b2: 292 };
const g1 = [{ s: start, cx: 80, lab: t.start }, { s: trap, cx: 260, lab: t.buried }, { s: back, cx: 440, lab: t.startAgain }];
const g2 = path.map((s, i) => ({ s, cx: 80 + i * 200, lab: i === 0 ? t.start : i === 3 ? t.goal : '' }));
// narrow layout
const N = { size: 16, gap: 4, b1: 110, b2: 282 };
const n1 = [{ s: start, cx: 50 }, { s: trap, cx: 170 }, { s: back, cx: 290 }];
const n2 = path.map((s, i) => ({ s, cx: [40, 130, 230, 320][i] }));
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 334" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <text class="f-label f-t-red" x="16" y="26">{t.greedy}</text>
    {g1.map((G) => (
      <g>
        <path class="f-axis" d={`M ${G.cx - half(G.s, W.size, W.gap) - 8} ${W.b1} H ${G.cx + half(G.s, W.size, W.gap) + 8}`} />
        {blocks(G.s, G.cx, W.b1, W.size, W.gap).map((r) => (
          <g><rect class="f-box-soft" x={r.x} y={r.y} width={W.size} height={W.size} rx="3" /><text class="f-small" x={r.x + W.size / 2} y={r.y + W.size / 2 + 4.5} text-anchor="middle">{r.b}</text></g>
        ))}
        <text class="f-small f-t-muted" x={G.cx} y={W.b1 + 18} text-anchor="middle">{G.lab}</text>
      </g>
    ))}
    <Arrow pts={[[80 + half(start, W.size, W.gap) + 6, W.b1 - 22], [260 - half(trap, W.size, W.gap) - 8, W.b1 - 22]]} tone="red" />
    <text class="f-small f-t-red" x="177" y={W.b1 - 30} text-anchor="middle">{t.bc}</text>
    <text class="f-small f-t-muted" x="177" y={W.b1 - 4} text-anchor="middle">{t.bcSub}</text>
    <Arrow pts={[[260 + half(trap, W.size, W.gap) + 6, W.b1 - 22], [440 - half(back, W.size, W.gap) - 8, W.b1 - 22]]} tone="red" />
    <text class="f-small f-t-red" x="343" y={W.b1 - 30} text-anchor="middle">{t.bt}</text>
    <text class="f-small f-t-muted" x="343" y={W.b1 - 4} text-anchor="middle">{t.btSub}</text>
    <path class="f-line f-red f-dash" d={curve(440, W.b1 - 50, 268, W.b1 - 72, 26)} marker-end="url(#f-arrow-red)" />
    <text class="f-small f-t-red" x="356" y="44" text-anchor="middle">{t.again}</text>
    <text class="f-small f-t-muted" x="500" y="78">{t.cyc1}</text>
    <text class="f-small f-t-muted" x="500" y="96">{t.cyc2}</text>
    <text class="f-small f-t-muted" x="500" y="114">{t.cyc3}</text>
    <text class="f-label f-t-green" x="16" y="186">{t.astar}</text>
    {g2.map((G, i) => (
      <g>
        <path class="f-axis" d={`M ${G.cx - half(G.s, W.size, W.gap) - 8} ${W.b2} H ${G.cx + half(G.s, W.size, W.gap) + 8}`} />
        {blocks(G.s, G.cx, W.b2, W.size, W.gap).map((r) => (
          <g><rect class="f-box-soft" x={r.x} y={r.y} width={W.size} height={W.size} rx="3" /><text class="f-small" x={r.x + W.size / 2} y={r.y + W.size / 2 + 4.5} text-anchor="middle">{r.b}</text></g>
        ))}
        <text class="f-small f-t-muted" x={G.cx} y={W.b2 + 18} text-anchor="middle">{G.lab}</text>
        {i !== 3 && <Arrow pts={[[G.cx + half(G.s, W.size, W.gap) + 6, W.b2 - 22], [g2[i + 1].cx - half(g2[i + 1].s, W.size, W.gap) - 8, W.b2 - 22]]} tone="green" />}
        {i !== 3 && <text class="f-small f-t-green" x={G.cx + 100} y={W.b2 - 30} text-anchor="middle">{t.m[i]}</text>}
      </g>
    ))}
    <text class="f-small f-t-muted" x="16" y="326">{t.note}</text>
  </svg>
  <svg class="fig-narrow" viewBox="0 0 360 352" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <text class="f-label f-t-red" x="8" y="22">{ru ? 'жадно' : 'greedy'}</text>
    {n1.map((G) => (
      <g>
        <path class="f-axis" d={`M ${G.cx - half(G.s, N.size, N.gap) - 6} ${N.b1} H ${G.cx + half(G.s, N.size, N.gap) + 6}`} />
        {blocks(G.s, G.cx, N.b1, N.size, N.gap).map((r) => (
          <g><rect class="f-box-soft" x={r.x} y={r.y} width={N.size} height={N.size} rx="2" /><text class="f-small" x={r.x + N.size / 2} y={r.y + N.size / 2 + 4.3} text-anchor="middle">{r.b}</text></g>
        ))}
      </g>
    ))}
    <Arrow pts={[[50 + half(start, N.size, N.gap) + 5, N.b1 - 16], [170 - half(trap, N.size, N.gap) - 7, N.b1 - 16]]} tone="red" />
    <text class="f-small f-t-red" x="114" y={N.b1 - 24} text-anchor="middle">{t.bc}</text>
    <Arrow pts={[[170 + half(trap, N.size, N.gap) + 5, N.b1 - 16], [290 - half(back, N.size, N.gap) - 7, N.b1 - 16]]} tone="red" />
    <text class="f-small f-t-red" x="226" y={N.b1 - 24} text-anchor="middle">{ru ? 'B на стол' : 'B to table'}</text>
    <path class="f-line f-red f-dash" d={curve(290, N.b1 - 36, 176, N.b1 - 54, 22)} marker-end="url(#f-arrow-red)" />
    <text class="f-small f-t-muted" x="8" y="142">{t.nl1}</text>
    <text class="f-small f-t-muted" x="8" y="160">{t.nl2}</text>
    <text class="f-label f-t-green" x="8" y="200">A*</text>
    {n2.map((G, i) => (
      <g>
        <path class="f-axis" d={`M ${G.cx - half(G.s, N.size, N.gap) - 6} ${N.b2} H ${G.cx + half(G.s, N.size, N.gap) + 6}`} />
        {blocks(G.s, G.cx, N.b2, N.size, N.gap).map((r) => (
          <g><rect class="f-box-soft" x={r.x} y={r.y} width={N.size} height={N.size} rx="2" /><text class="f-small" x={r.x + N.size / 2} y={r.y + N.size / 2 + 4.3} text-anchor="middle">{r.b}</text></g>
        ))}
        {i !== 3 && <Arrow pts={[[G.cx + half(G.s, N.size, N.gap) + 4, N.b2 - 16], [n2[i + 1].cx - half(n2[i + 1].s, N.size, N.gap) - 6, N.b2 - 16]]} tone="green" />}
        {i !== 3 && <text class="f-small f-t-green" x={(G.cx + n2[i + 1].cx) / 2} y={N.b2 - 24} text-anchor="middle">{String(i + 1)}</text>}
      </g>
    ))}
    <text class="f-small f-t-muted" x="8" y="310">{t.nlm}</text>
    <text class="f-small f-t-muted" x="8" y="330">{t.note}</text>
  </svg>
</Figure>
