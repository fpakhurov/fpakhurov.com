---
import BlockDiagram, { type DLayout, type DNode, type DEdge } from '../BlockDiagram.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Booting Linux on the QEMU RISC-V "virt" machine: the boot ROM at 0x1000 jumps to OpenSBI at the start of RAM
// (0x80000000); OpenSBI, built as the generic fw_jump firmware for 64-bit, enters the next stage at an offset of
// 0x200000 in S-mode; the kernel starts the first user process.
const ram = 0x80000000, jumpOffset = 0x200000;
const kernelAt = ram + jumpOffset;
if (kernelAt.toString(16) !== '80200000') throw new Error('kernel entry');
const hex = (v: number) => '0x' + v.toString(16);
const t = ru
  ? { rom: 'загрузочное ПЗУ', sbi: 'OpenSBI', kern: 'ядро Linux', init: 'init', shell: 'службы, оболочка', pid: 'PID 1', jump: 'переход', fork: 'fork, exec',
      key: 'цвет — режим: янтарный M, синий S, зелёный U', modeM: 'режим M', modeS: 'режим S', modeU: 'режим U' }
  : { rom: 'boot ROM', sbi: 'OpenSBI', kern: 'Linux kernel', init: 'init', shell: 'services, shell', pid: 'PID 1', jump: 'jump', fork: 'fork, exec',
      key: 'colour shows the mode: amber M, blue S, green U', modeM: 'M-mode', modeS: 'S-mode', modeU: 'U-mode' };
const desc = ru
  ? `Пять блоков в цепочке: загрузочное ПЗУ по адресу 0x1000 и OpenSBI по адресу ${hex(ram)} в режиме M, ядро Linux по адресу ${hex(kernelAt)} в режиме S, процесс init с PID 1 и службы с оболочкой в режиме U. Стрелки подписаны: переход, mret, sret, fork и exec.`
  : `Five boxes in a chain: the boot ROM at 0x1000 and OpenSBI at ${hex(ram)} in M-mode, the Linux kernel at ${hex(kernelAt)} in S-mode, the init process with PID 1 and the services and shell in U-mode. The arrows are labelled jump, mret, sret, and fork and exec.`;
const labels = [t.rom, t.sbi, t.kern, t.init, t.shell];
// in the wide layout the Russian label of the last box is too long for one line of a 120-wide box
const labelsWide = labels.map((l, i) => (ru && i === 4 ? 'службы,\nоболочка' : l));
const subsWide = ['0x1000', hex(ram), hex(kernelAt), t.pid, ''];
const subsNarrow = [`0x1000, ${t.modeM}`, `${hex(ram)}, ${t.modeM}`, `${hex(kernelAt)}, ${t.modeS}`, `${t.pid}, ${t.modeU}`, t.modeU];
const tones: DNode['tone'][] = ['amber', 'amber', 'blue', 'green', 'green'];
const edgeLabels = [t.jump, 'mret', 'sret', t.fork];
const ids = ['rom', 'sbi', 'kern', 'init', 'shell'];
const ww = 120, gap = (744 - 5 * ww) / 4;
const wide: DLayout = {
  cls: 'fig-wide', w: 760, h: 124, desc,
  nodes: ids.map((id, i) => ({ id, x: 8 + i * (ww + gap), y: 34, w: ww, h: 56, label: labelsWide[i], sub: subsWide[i] || undefined, tone: tones[i] })),
  edges: ids.slice(1).map((id, i): DEdge => ({ from: ids[i], to: id, label: edgeLabels[i], at: [8 + (i + 1) * (ww + gap) - gap / 2, 24] })),
  texts: [{ x: 8, y: 116, text: t.key }],
};
const narrow: DLayout = {
  cls: 'fig-narrow', w: 360, h: 392, desc,
  nodes: ids.map((id, i) => ({ id, x: 40, y: 8 + i * 74, w: 230, h: 50, label: labels[i], sub: subsNarrow[i], tone: tones[i] })),
  edges: ids.slice(1).map((id, i): DEdge => ({ from: ids[i], to: id, label: edgeLabels[i], at: [162, 8 + i * 74 + 66], anchor: 'start' })),
  texts: [{ x: 8, y: 384, text: t.key }],
};
---

<BlockDiagram
  id="boot-chain"
  title={ru ? 'Загрузка Linux на машине QEMU virt' : 'Booting Linux on the QEMU virt machine'}
  svgTitle={ru ? 'Цепочка загрузки от ПЗУ до оболочки' : 'The boot chain from ROM to the shell'}
  caption={ru
    ? `Загрузка на эмулируемой плате RISC-V QEMU virt. После сброса процессор в машинном режиме выполняет несколько команд ПЗУ по адресу 0x1000 и переходит в начало RAM, ${hex(ram)}, где лежит прошивка OpenSBI. Она настраивает таймер и прерывания, остаётся в памяти как обработчик вызовов SBI и командой mret входит в режим S по адресу ${hex(kernelAt)} (смещение ${hex(jumpOffset)} в прошивке fw_jump для 64 бит), где лежит ядро. Ядро строит таблицы страниц, записывает адрес обработчика ловушек, находит устройства, монтирует корневую файловую систему и первой командой sret запускает /sbin/init в режиме U. Init (в большинстве дистрибутивов systemd) порождает остальные процессы. На реальных платах и ПК между прошивкой и ядром стоит загрузчик, например U-Boot или GRUB.`
    : `Booting on the emulated QEMU virt RISC-V board. After reset the processor, in machine mode, runs a few instructions of ROM at 0x1000 and jumps to the start of RAM, ${hex(ram)}, where the OpenSBI firmware sits. OpenSBI sets up the timer and interrupts, stays resident to serve SBI calls, and enters S-mode with mret at ${hex(kernelAt)} (the offset ${hex(jumpOffset)} of the 64-bit fw_jump firmware), where the kernel sits. The kernel builds page tables, stores the address of its trap handler, finds the devices, mounts the root file system and starts /sbin/init in U-mode with its first sret. Init (systemd on most distributions) starts every other process. On real boards and PCs a bootloader such as U-Boot or GRUB sits between the firmware and the kernel.`}
  layouts={[wide, narrow]}
/>
