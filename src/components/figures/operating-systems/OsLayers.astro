---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The layers of a Linux system on RISC-V and the four ways control crosses the line between user mode and the
// kernel: a system call (ecall), an exception (here a page fault), an interrupt (here the timer) and the return
// (sret). User programs run in U-mode, the kernel in S-mode, the firmware in M-mode.
const t = ru
  ? {
      u: 'пользовательский режим (U)', s: 'режим ядра (S): ядро Linux', sShort: 'режим ядра (S): Linux', m: 'машинный режим (M)', mShort: 'машинный (M)', hw: 'аппаратура',
      apps: ['браузер', 'программа', 'оболочка'], libc: 'библиотека C',
      iface: 'интерфейс системных вызовов',
      kern: ['память', 'файлы', 'процессы', 'сеть', 'драйверы'], kernSub: ['страницы', 'VFS', 'планировщик', 'TCP/IP', 'устройства'],
      fw: 'прошивка (OpenSBI)', hwb: ['ЦП', 'RAM и MMU', 'таймер', 'диск', 'сетевая карта'],
      a1: 'ecall', a2: 'отказ страницы', a3: 'прерывание', a4: 'sret',
      steps: [
        'системный вызов: программа выполняет ecall и входит в ядро по адресу из stvec',
        'исключение: обращение браузера к неотображённой странице передаёт управление обработчику страничных отказов',
        'прерывание: таймер останавливает текущую программу, и планировщик выбирает следующую',
        'возврат: sret возвращает процессор в режим U на сохранённый адрес',
      ],
    }
  : {
      u: 'user mode (U)', s: 'kernel mode (S): the Linux kernel', sShort: 'kernel mode (S): Linux', m: 'machine mode (M)', mShort: 'machine (M)', hw: 'hardware',
      apps: ['browser', 'program', 'shell'], libc: 'C library',
      iface: 'system-call interface',
      kern: ['memory', 'files', 'processes', 'network', 'drivers'], kernSub: ['pages', 'VFS', 'scheduler', 'TCP/IP', 'devices'],
      fw: 'firmware (OpenSBI)', hwb: ['CPU', 'RAM and MMU', 'timer', 'disk', 'network card'],
      a1: 'ecall', a2: 'page fault', a3: 'interrupt', a4: 'sret',
      steps: [
        'system call: the program executes ecall and enters the kernel at the address in stvec',
        'exception: the browser touches an unmapped page, and the page-fault handler takes over',
        'interrupt: the timer stops the running program, and the scheduler picks the next one',
        'return: sret puts the processor back in U-mode at the saved address',
      ],
    };
if (t.steps.length !== 4) throw new Error('four crossings expected');

type B = [number, number, number, number]; // x, y, w, h
interface Arrow { pts: [number, number][]; cls: string; head: string; label: string; at: [number, number]; anchor: 'start' | 'end' | 'middle'; badge: [number, number]; n: number }
interface Layout {
  cls: string; W: number; H: number;
  bands: { b: B; label: string; at: [number, number] }[];
  apps: B[]; kern: B[]; fw: B; hw: B[];
  iface: { y: number; x0: number; x1: number; at: [number, number] };
  arrows: Arrow[];
}

// Wide: bands as rows, the band name inside each band. Columns are aligned so that every arrow is vertical.
const wideCols = [24, 172, 320, 468, 616];
const wideApps: B[] = wideCols.slice(0, 3).map((x) => [x, 34, 120, 50] as B);
const wideKern: B[] = wideCols.map((x) => [x, 158, 120, 50] as B);
const wideHw: B[] = wideCols.map((x) => [x, 332, 120, 40] as B);
// Narrow: three columns 12, 128, 244 (width 104); the kernel and the hardware take two rows.
const col = [12, 128, 244];
const narrowApps: B[] = col.map((x) => [x, 26, 104, 46] as B);
const narrowKern: B[] = [[col[0], 140, 104, 44], [col[1], 140, 104, 44], [col[2], 140, 104, 44], [col[0], 192, 104, 44], [col[1], 192, 104, 44]];
const narrowHw: B[] = [[col[0], 362, 104, 36], [col[1], 362, 104, 36], [col[2], 362, 104, 36], [col[0], 404, 104, 36], [col[1], 404, 104, 36]];
// Kernel boxes in the order memory, files, processes, network, drivers; hardware CPU, RAM, timer, disk, network card.
const cx = (b: B) => b[0] + b[2] / 2;
const bottom = (b: B) => b[1] + b[3];
const xw = { fault: cx(wideKern[0]), call: cx(wideKern[1]) - 8, ret: cx(wideKern[1]) + 8, irq: cx(wideKern[2]) + 30 };
const xn = { fault: cx(narrowKern[0]), call: cx(narrowKern[1]) - 8, ret: cx(narrowKern[1]) + 8, irq: cx(narrowKern[2]) + 34 };
const layouts: Layout[] = [
  {
    cls: 'fig-wide', W: 760, H: 388,
    bands: [
      { b: [8, 8, 744, 100], label: t.u, at: [16, 24] },
      { b: [8, 132, 744, 104], label: t.s, at: [16, 228] },
      { b: [8, 246, 744, 44], label: t.m, at: [16, 273] },
      { b: [8, 300, 744, 80], label: t.hw, at: [16, 322] },
    ],
    apps: wideApps, kern: wideKern, fw: [468, 253, 268, 30], hw: wideHw,
    iface: { y: 124, x0: 8, x1: 752, at: [748, 120] },
    arrows: [
      { pts: [[xw.call, 86], [xw.call, 156]], cls: 'f-line f-blue', head: 'url(#f-arrow-blue)', label: t.a1, at: [xw.call - 6, 146], anchor: 'end', badge: [xw.call - 16, 97], n: 1 },
      { pts: [[xw.fault, 86], [xw.fault, 156]], cls: 'f-line f-red', head: 'url(#f-arrow-red)', label: t.a2, at: [xw.fault + 6, 146], anchor: 'start', badge: [xw.fault - 16, 97], n: 2 },
      { pts: [[xw.irq, 330], [xw.irq, bottom(wideKern[2]) + 2]], cls: 'f-line f-amber', head: 'url(#f-arrow-amber)', label: t.a3, at: [xw.irq - 6, 273], anchor: 'end', badge: [xw.irq + 14, 316], n: 3 },
      { pts: [[xw.ret, 156], [xw.ret, 88]], cls: 'f-line f-green', head: 'url(#f-arrow-green)', label: t.a4, at: [xw.ret + 6, 146], anchor: 'start', badge: [xw.ret + 16, 97], n: 4 },
    ],
  },
  {
    cls: 'fig-narrow seq-narrow', W: 360, H: 450,
    bands: [
      { b: [4, 4, 352, 92], label: t.u, at: [10, 18] },
      { b: [4, 112, 352, 154], label: t.sShort, at: [10, 256] },
      { b: [4, 276, 352, 52], label: t.mShort, at: [10, 306] },
      { b: [4, 338, 352, 108], label: t.hw, at: [10, 354] },
    ],
    apps: narrowApps, kern: narrowKern, fw: [150, 284, 150, 36], hw: narrowHw,
    iface: { y: 104, x0: 4, x1: 356, at: [0, 0] },
    arrows: [
      { pts: [[xn.call, 74], [xn.call, 138]], cls: 'f-line f-blue', head: 'url(#f-arrow-blue)', label: t.a1, at: [xn.ret + 8, 120], anchor: 'start', badge: [xn.call - 16, 86], n: 1 },
      { pts: [[xn.fault, 74], [xn.fault, 138]], cls: 'f-line f-red', head: 'url(#f-arrow-red)', label: t.a2, at: [xn.fault + 6, 128], anchor: 'start', badge: [xn.fault - 16, 86], n: 2 },
      { pts: [[xn.irq, 360], [xn.irq, bottom(narrowKern[2]) + 2]], cls: 'f-line f-amber', head: 'url(#f-arrow-amber)', label: t.a3, at: [xn.irq - 6, 352], anchor: 'end', badge: [xn.irq - 18, 306], n: 3 },
      { pts: [[xn.ret, 138], [xn.ret, 76]], cls: 'f-line f-green', head: 'url(#f-arrow-green)', label: t.a4, at: [xn.ret + 8, 136], anchor: 'start', badge: [xn.ret + 16, 86], n: 4 },
    ],
  },
];
// In the narrow layout the timer column must be free between the hardware and the scheduler box.
if (narrowKern[2][0] !== narrowHw[2][0] || wideKern[2][0] !== wideHw[2][0]) throw new Error('timer and scheduler must share a column');
if (xn.irq <= 300 || xn.irq >= narrowKern[2][0] + narrowKern[2][2]) throw new Error('the narrow interrupt arrow must miss the firmware box and hit the scheduler');
const tone = (k: 'u' | 's' | 'm' | 'h') => (k === 'u' ? 'var(--fig-green)' : k === 's' ? 'var(--fig-blue)' : k === 'm' ? 'var(--fig-amber)' : 'var(--muted)');
const kinds: ('u' | 's' | 'm' | 'h')[] = ['u', 's', 'm', 'h'];
const id = 'os-layers';
---

<Figure
  id={id}
  title={ru ? 'Слои системы и четыре пути через границу ядра' : 'The layers of a system and the four ways across the kernel boundary'}
  caption={ru
    ? 'Система Linux на RISC-V. Программы работают в пользовательском режиме U и обращаются к ядру через библиотеку C; ядро работает в режиме супервизора S и одно управляет памятью, файлами, процессами, сетью и устройствами; прошивка OpenSBI остаётся в машинном режиме M. Управление переходит из U в S только через ловушку: системный вызов ecall (1), исключение, например страничный отказ (2), или прерывание от устройства, например таймера (3). Каждый раз процессор переходит по адресу, который заранее записало ядро, а не программа. Назад в U ведёт одна команда, sret (4).'
    : 'A Linux system on RISC-V. Programs run in user mode U and reach the kernel through the C library; the kernel runs in supervisor mode S and alone manages memory, files, processes, the network and devices; the OpenSBI firmware stays in machine mode M. Control passes from U to S only through a trap: an ecall system call (1), an exception such as a page fault (2), or an interrupt from a device such as the timer (3). Each time the processor jumps to an address the kernel stored in advance, not one the program chose. One instruction, sret, leads back to U (4).'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Режимы привилегий и переходы между ними' : 'Privilege modes and the transitions between them'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Четыре горизонтальные полосы: пользовательский режим с браузером, программой и оболочкой поверх библиотеки C; режим ядра с блоками память, файлы, процессы, сеть и драйверы; машинный режим с прошивкой; аппаратура: процессор, память, таймер, диск, сетевая карта. Стрелка ecall идёт от программы вниз к блоку файлов, стрелка страничного отказа от браузера к памяти, стрелка прерывания от таймера вверх к процессам, стрелка sret от ядра вверх к программе.'
        : 'Four horizontal bands: user mode with a browser, a program and a shell on top of the C library; kernel mode with boxes for memory, files, processes, network and drivers; machine mode with the firmware; hardware: CPU, memory, timer, disk and network card. An ecall arrow goes down from the program to the files box, a page-fault arrow from the browser to memory, an interrupt arrow up from the timer to processes, and an sret arrow up from the kernel to the program.'}</desc>
      {L.bands.map((band, i) => (
        <g>
          <rect x={band.b[0]} y={band.b[1]} width={band.b[2]} height={band.b[3]} rx="8" style={`fill: ${tone(kinds[i])}; fill-opacity: 0.06; stroke: ${tone(kinds[i])}; stroke-opacity: 0.5; stroke-width: 1`} />
          <text class="f-small f-t-muted" x={band.at[0]} y={band.at[1]} style="font-weight: 600">{band.label}</text>
        </g>
      ))}
      <path class="f-thin f-muted f-dash" d={`M ${L.iface.x0} ${L.iface.y} H ${L.iface.x1}`} />
      {L.iface.at[0] > 0 && <text class="f-small f-t-muted" x={L.iface.at[0]} y={L.iface.at[1]} text-anchor="end">{t.iface}</text>}
      {L.apps.map((b, i) => (
        <g>
          <rect x={b[0]} y={b[1]} width={b[2]} height={b[3]} rx="7" style="fill: var(--fig-green); fill-opacity: 0.14; stroke: var(--fig-green); stroke-width: 1.3" />
          <text class="f-label" x={cx(b)} y={b[1] + 20} text-anchor="middle">{t.apps[i]}</text>
          <path class="f-thin f-green" d={`M ${b[0] + 6} ${b[1] + 29} H ${b[0] + b[2] - 6}`} />
          <text class="f-small f-t-muted" x={cx(b)} y={b[1] + 44} text-anchor="middle">{t.libc}</text>
        </g>
      ))}
      {L.kern.map((b, i) => (
        <g>
          <rect x={b[0]} y={b[1]} width={b[2]} height={b[3]} rx="7" style="fill: var(--fig-blue); fill-opacity: 0.14; stroke: var(--fig-blue); stroke-width: 1.3" />
          <text class="f-label" x={cx(b)} y={b[1] + 20} text-anchor="middle">{t.kern[i]}</text>
          <text class="f-small f-t-muted" x={cx(b)} y={b[1] + 38} text-anchor="middle">{t.kernSub[i]}</text>
        </g>
      ))}
      <rect x={L.fw[0]} y={L.fw[1]} width={L.fw[2]} height={L.fw[3]} rx="7" style="fill: var(--fig-amber); fill-opacity: 0.14; stroke: var(--fig-amber); stroke-width: 1.3" />
      <text class="f-small" x={cx(L.fw)} y={L.fw[1] + L.fw[3] / 2 + 4.5} text-anchor="middle">{t.fw}</text>
      {L.hw.map((b, i) => (
        <g>
          <rect class="f-box-soft" x={b[0]} y={b[1]} width={b[2]} height={b[3]} rx="7" />
          <text class="f-small" x={cx(b)} y={b[1] + b[3] / 2 + 4.5} text-anchor="middle">{t.hwb[i]}</text>
        </g>
      ))}
      {L.arrows.map((a) => (
        <g data-s={String(a.n)}>
          <path class={a.cls} d={a.pts.map((p, i) => `${i ? 'L' : 'M'} ${p[0]} ${p[1]}`).join(' ')} marker-end={a.head} />
          {a.label && <text class={`f-small f-halo ${a.cls.includes('blue') ? 'f-t-blue' : a.cls.includes('red') ? 'f-t-red' : a.cls.includes('amber') ? 'f-t-amber' : 'f-t-green'}`} x={a.at[0]} y={a.at[1]} text-anchor={a.anchor}>{a.label}</text>}
          <Badge x={a.badge[0]} y={a.badge[1]} n={a.n} />
        </g>
      ))}
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
