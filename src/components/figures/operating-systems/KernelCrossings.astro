---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One read() whose block must come from the disk driver, in a monolithic kernel and in a microkernel.
// Every arrow is one transfer of control. An arrow that crosses between the user band and the kernel band is a
// mode switch; in the microkernel, delivering a message to a different server process also switches address spaces.
type Who = 'app' | 'fs' | 'drv' | 'k';
interface Hop { from: Who; to: Who }
const mono: Hop[] = [
  { from: 'app', to: 'fs' }, // trap into the kernel; the file system is kernel code
  { from: 'fs', to: 'drv' }, // a function call inside the kernel
  { from: 'drv', to: 'fs' }, // its return
  { from: 'fs', to: 'app' }, // sret
];
const micro: Hop[] = [
  { from: 'app', to: 'k' }, { from: 'k', to: 'fs' }, { from: 'fs', to: 'k' }, { from: 'k', to: 'drv' },
  { from: 'drv', to: 'k' }, { from: 'k', to: 'fs' }, { from: 'fs', to: 'k' }, { from: 'k', to: 'app' },
];
// In the monolithic kernel fs and drv run in kernel mode; in the microkernel they are user processes.
const kernelSide = (w: Who, monolithic: boolean) => w === 'k' || (monolithic && w !== 'app');
const modeSwitches = (hops: Hop[], m: boolean) => hops.filter((h) => kernelSide(h.from, m) !== kernelSide(h.to, m)).length;
// Address-space switches: the user process that runs after the kernel differs from the one that ran before it.
function spaceSwitches(hops: Hop[], m: boolean) {
  let last: Who = 'app', n = 0;
  for (const h of hops) if (!kernelSide(h.to, m)) { if (h.to !== last) n++; last = h.to; }
  return n;
}
const counts = { mono: [modeSwitches(mono, true), spaceSwitches(mono, true)], micro: [modeSwitches(micro, false), spaceSwitches(micro, false)] };
if (counts.mono.join() !== '2,0' || counts.micro.join() !== '8,4') throw new Error(`crossings ${JSON.stringify(counts)}`);

const t = ru
  ? {
      monoT: 'монолитное ядро (Linux)', microT: 'микроядро (seL4, QNX)', user: 'режим U', kern: 'режим S',
      app: 'программа', fs: 'файловая система', drv: 'драйвер диска', fsS: 'файловый сервер', drvS: 'драйвер диска',
      k: 'микроядро: сообщения (IPC)', kernel: 'ядро', call: 'вызов функции',
      sum: (a: number, b: number) => `${a} смены режима, ${b} смен адресного пространства`,
      sumM: (a: number, b: number) => `${a} смен режима, ${b} смены адресного пространства`,
    }
  : {
      monoT: 'monolithic kernel (Linux)', microT: 'microkernel (seL4, QNX)', user: 'U-mode', kern: 'S-mode',
      app: 'program', fs: 'file system', drv: 'disk driver', fsS: 'file server', drvS: 'disk driver',
      k: 'microkernel: messages (IPC)', kernel: 'kernel', call: 'function call',
      sum: (a: number, b: number) => `${a} mode switches, ${b} address-space switches`,
      sumM: (a: number, b: number) => `${a} mode switches, ${b} address-space switches`,
    };

interface Panel { ox: number; oy: number }
interface Layout { cls: string; W: number; H: number; mono: Panel; micro: Panel }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 290, mono: { ox: 8, oy: 0 }, micro: { ox: 392, oy: 0 } },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 592, mono: { ox: 0, oy: 0 }, micro: { ox: 0, oy: 302 } },
];
// Geometry inside a 360-wide panel, relative to its origin.
const U = { y: 26, h: 96 }, S = { y: 132, h: 118 };
const boxY = 52, boxH = 42, kY = 170, kH = 44;
// Microkernel: x of each up and down arrow under the three user boxes.
const microX: Record<number, number> = { 1: 46, 8: 78, 2: 154, 3: 176, 6: 198, 7: 220, 4: 286, 5: 314 };
const id = 'kernel-crossings';
---

<Figure
  id={id}
  title={ru ? 'Одно чтение с диска в монолитном ядре и в микроядре' : 'One disk read in a monolithic kernel and in a microkernel'}
  caption={ru
    ? `Программа читает блок, которого нет в памяти, поэтому запрос доходит до драйвера диска. Слева, в монолитном ядре, файловая система и драйвер — код ядра: ловушка в ядро (1), вызов функции драйвера (2) и возврат из него (3), sret в программу (4) — ${counts.mono[0]} смены режима. Справа, в микроядре, файловая система и драйвер — отдельные процессы в режиме U, и каждая передача управления идёт сообщением через микроядро (1–8): ${counts.micro[0]} смен режима и ${counts.micro[1]} смены адресного пространства. Стрелки вниз — вход в ядро, стрелки вверх — выход из него.`
    : `A program reads a block that is not in memory, so the request reaches the disk driver. On the left, in a monolithic kernel, the file system and the driver are kernel code: a trap into the kernel (1), a function call into the driver (2) and its return (3), and sret back to the program (4): ${counts.mono[0]} mode switches. On the right, in a microkernel, the file system and the driver are separate processes in U-mode, and every transfer of control is a message through the microkernel (1–8): ${counts.micro[0]} mode switches and ${counts.micro[1]} address-space switches. Downward arrows enter the kernel; upward arrows leave it.`}
>
  {layouts.map((L) => {
    const m = L.mono, k = L.micro;
    const mApp: [number, number, number] = [m.ox + 24, m.oy + boxY, 128];
    const mFs: [number, number, number] = [m.ox + 24, m.oy + kY, 128];
    const mDrv: [number, number, number] = [m.ox + 208, m.oy + kY, 128];
    const uBoxes: [string, number][] = [[t.app, 14], [t.fsS, 128], [t.drvS, 246]];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Переходы между режимами при чтении с диска' : 'Mode switches during a disk read'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? `Две панели. Монолитное ядро: программа в полосе режима U, файловая система и драйвер внутри ядра в полосе режима S; стрелка вниз от программы к файловой системе, вызов драйвера и возврат, стрелка вверх к программе; итог ${counts.mono[0]} смены режима. Микроядро: программа, файловый сервер и драйвер в полосе U, микроядро в полосе S; восемь вертикальных стрелок по очереди между этими процессами и микроядром; итог ${counts.micro[0]} смен режима и ${counts.micro[1]} смены адресного пространства.`
          : `Two panels. Monolithic kernel: the program in the U-mode band, the file system and the driver inside the kernel in the S-mode band; an arrow down from the program to the file system, a call to the driver and its return, an arrow up to the program; ${counts.mono[0]} mode switches in total. Microkernel: the program, a file server and a driver in the U band, the microkernel in the S band; eight vertical arrows in turn between these processes and the microkernel; ${counts.micro[0]} mode switches and ${counts.micro[1]} address-space switches in total.`}</desc>
        {[m, k].map((p, i) => (
          <g>
            <text class="f-label" x={p.ox + 8} y={p.oy + 16} style="font-weight: 600">{i === 0 ? t.monoT : t.microT}</text>
            <rect x={p.ox + 4} y={p.oy + U.y} width="352" height={U.h} rx="8" style="fill: var(--fig-green); fill-opacity: 0.06; stroke: var(--fig-green); stroke-opacity: 0.5" />
            <rect x={p.ox + 4} y={p.oy + S.y} width="352" height={S.h} rx="8" style="fill: var(--fig-blue); fill-opacity: 0.06; stroke: var(--fig-blue); stroke-opacity: 0.5" />
            <text class="f-small f-t-muted" x={p.ox + 350} y={p.oy + U.y + 14} text-anchor="end">{t.user}</text>
            <text class="f-small f-t-muted" x={p.ox + 350} y={p.oy + S.y + S.h - 8} text-anchor="end">{t.kern}</text>
            <text class="f-small" x={p.ox + 8} y={p.oy + 280}>{i === 0 ? t.sum(counts.mono[0], counts.mono[1]) : t.sumM(counts.micro[0], counts.micro[1])}</text>
          </g>
        ))}
        {/* monolithic */}
        <rect x={mApp[0]} y={mApp[1]} width={mApp[2]} height={boxH} rx="7" style="fill: var(--fig-green); fill-opacity: 0.14; stroke: var(--fig-green); stroke-width: 1.3" />
        <text class="f-small" x={mApp[0] + mApp[2] / 2} y={mApp[1] + 25} text-anchor="middle">{t.app}</text>
        <text class="f-small f-t-muted" x={m.ox + 12} y={m.oy + S.y + 18}>{t.kernel}</text>
        {[[mFs, t.fs], [mDrv, t.drv]].map(([b, label]) => {
          const bb = b as [number, number, number];
          return (
            <g>
              <rect x={bb[0]} y={bb[1]} width={bb[2]} height={kH} rx="7" style="fill: var(--fig-blue); fill-opacity: 0.14; stroke: var(--fig-blue); stroke-width: 1.3" />
              <text class="f-small" x={bb[0] + bb[2] / 2} y={bb[1] + 26} text-anchor="middle">{label as string}</text>
            </g>
          );
        })}
        <path class="f-line f-blue" d={`M ${mApp[0] + 44} ${mApp[1] + boxH + 2} V ${mFs[1] - 3}`} marker-end="url(#f-arrow-blue)" />
        <path class="f-line f-green" d={`M ${mApp[0] + 84} ${mFs[1] - 2} V ${mApp[1] + boxH + 3}`} marker-end="url(#f-arrow-green)" />
        <path class="f-line" d={`M ${mFs[0] + mFs[2] + 2} ${mFs[1] + 10} H ${mDrv[0] - 3}`} marker-end="url(#f-arrow)" />
        <path class="f-line f-dash" d={`M ${mDrv[0] - 2} ${mFs[1] + 34} H ${mFs[0] + mFs[2] + 3}`} marker-end="url(#f-arrow)" />
        <text class="f-small f-t-muted f-halo" x={(mFs[0] + mFs[2] + mDrv[0]) / 2} y={mFs[1] - 6} text-anchor="middle">{t.call}</text>
        <Badge x={mApp[0] + 28} y={m.oy + 112} n={1} />
        <Badge x={(mFs[0] + mFs[2] + mDrv[0]) / 2} y={mFs[1] + 10} n={2} />
        <Badge x={(mFs[0] + mFs[2] + mDrv[0]) / 2} y={mFs[1] + 34} n={3} />
        <Badge x={mApp[0] + 100} y={m.oy + 112} n={4} />
        {/* microkernel */}
        {uBoxes.map(([label, x]) => (
          <g>
            <rect x={k.ox + x} y={k.oy + boxY} width="100" height={boxH} rx="7" style="fill: var(--fig-green); fill-opacity: 0.14; stroke: var(--fig-green); stroke-width: 1.3" />
            <text class="f-small" x={k.ox + x + 50} y={k.oy + boxY + 25} text-anchor="middle">{label}</text>
          </g>
        ))}
        <rect x={k.ox + 14} y={k.oy + kY} width="332" height={kH} rx="7" style="fill: var(--fig-blue); fill-opacity: 0.14; stroke: var(--fig-blue); stroke-width: 1.3" />
        <text class="f-small" x={k.ox + 180} y={k.oy + kY + 26} text-anchor="middle">{t.k}</text>
        {micro.map((h, i) => {
          const n = i + 1, x = k.ox + microX[n], down = h.to === 'k';
          const y0 = k.oy + boxY + boxH, y1 = k.oy + kY;
          return (
            <g>
              <path class={`f-line ${down ? 'f-blue' : 'f-green'}`} d={down ? `M ${x} ${y0 + 2} V ${y1 - 3}` : `M ${x} ${y1 - 2} V ${y0 + 3}`} marker-end={down ? 'url(#f-arrow-blue)' : 'url(#f-arrow-green)'} />
              <Badge x={x} y={k.oy + (down ? 112 : 148)} n={n} />
            </g>
          );
        })}
      </svg>
    );
  })}
</Figure>
