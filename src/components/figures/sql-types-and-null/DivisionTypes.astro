---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
const id = 'sql-division-types';
const title = ru ? 'В какой момент меняется тип' : 'Where the type changes';
const division = 350 / 100;
const integerQuotient = Math.trunc(division);
const decimalQuotient = ru ? String(division).replace('.', ',') : String(division);
const paths = [
  {
    x: 84,
    label: ru ? 'CAST после деления' : 'Cast after division',
    steps: ['integer ÷ integer', String(integerQuotient) + ' (integer)', String(integerQuotient) + ' (numeric)'],
  },
  {
    x: 246,
    label: ru ? 'CAST до деления' : 'Cast before division',
    steps: ['numeric ÷ integer', 'numeric ÷ numeric', decimalQuotient + ' (numeric)'],
  },
];
---

<Figure id={id} title={title}
  caption={ru
    ? 'Обе ветви делят 350 на 100. Слева CAST получает уже усечённое значение. Справа дробная часть сохраняется при делении.'
    : 'Both paths divide 350 by 100. On the left, CAST receives the truncated result. On the right, division retains the fractional part.'}>
  <svg class="fig-compact" viewBox="0 0 330 182" role="img" aria-labelledby={id + '-title ' + id + '-desc'}>
    <title id={id + '-title'}>{title}</title>
    <desc id={id + '-desc'}>{ru
      ? 'Приведение результата целочисленного деления к numeric даёт 3. Приведение первого операнда перед делением даёт 3,5.'
      : 'Casting the integer quotient to numeric gives 3. Casting the first operand before division gives 3.5.'}</desc>
    {paths.map(({ x, label, steps }) => (
      <g>
        <text class="f-title" x={x} y="16" text-anchor="middle">{label}</text>
        {steps.map((step, i) => (
          <g>
            {i > 0 && <path class="f-axis" d={'M ' + x + ' ' + (i * 53 - 1) + ' v 17'} marker-end="url(#f-arrow-muted)" />}
            <rect class={i === 2 ? 'f-box f-green' : 'f-box-soft'} x={x - 76} y={21 + 53 * i} width="152" height="31" rx="5" />
            <text x={x} y={42 + 53 * i} text-anchor="middle" style="font-family: var(--mono)">{step}</text>
          </g>
        ))}
      </g>
    ))}
  </svg>
</Figure>
