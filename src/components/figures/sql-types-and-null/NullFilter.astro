---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import { keyOf, lines } from '../sql-tables-and-queries/example';

const ru = pageLang(Astro.url) === 'ru';
const id = 'sql-null-filter';
const title = ru ? 'Неизвестный результат исключают оба фильтра' : 'Both filters discard the unknown result';
const quotes = lines
  .filter((line) => ['101/1', '102/1', '103/1'].includes(keyOf(line)))
  .map((line) => ({
    key: keyOf(line),
    amount: keyOf(line) === '103/1' ? null : line.quantity * line.unitPriceCents,
  }));
quotes.push({ key: '105/1', amount: 0 });

const status = (value: boolean | null) => value === null ? 'NULL' : value ? 'TRUE' : 'FALSE';
const rows = quotes.map(({ key, amount }) => {
  const predicate = amount === null ? null : amount >= 700;
  const negated = predicate === null ? null : !predicate;
  return { key, cells: [status(predicate), status(negated)] };
});
---

<Figure id={id} title={title}
  caption={ru
    ? 'P проверяет, достигла ли стоимость 700 копеек. Зелёные клетки отмечают истинные результаты, которые пропускает WHERE. Для 103/1 цена ещё неизвестна, поэтому ни одна проверка не истинна.'
    : 'P tests whether the amount reaches 700 cents. Green cells mark the true results that pass WHERE. The price on 103/1 is pending, so neither test is true.'}>
  <svg class="fig-compact" viewBox="0 0 330 193" role="img" aria-labelledby={id + '-title ' + id + '-desc'}>
    <title id={id + '-title'}>{title}</title>
    <desc id={id + '-desc'}>{ru
      ? 'WHERE P оставляет 101/1. WHERE NOT P оставляет 102/1 и 105/1. Оба фильтра исключают 103/1.'
      : 'WHERE P keeps 101/1. WHERE NOT P keeps 102/1 and 105/1. Both filters discard 103/1.'}</desc>
    <text class="f-title" x="48" y="17" text-anchor="middle">{ru ? 'Позиция' : 'Line'}</text>
    <text class="f-title" x="147" y="17" text-anchor="middle">P</text>
    <text class="f-title" x="263" y="17" text-anchor="middle">NOT P</text>
    {rows.map(({ key, cells }, row) => {
      const y = 26 + row * 40;
      return (
        <g>
          <rect class="f-box-soft" x="4" y={y} width="322" height="34" rx="5" />
          <text x="48" y={y + 22} text-anchor="middle" style="font-family: var(--mono)">{key}</text>
          {cells.map((value, index) => {
            const x = index === 0 ? 147 : 263;
            return (
              <g>
                {value === 'TRUE' && <rect class="f-fill-green" x={x - 36} y={y + 4} width="72" height="26" rx="4" />}
                <text class={value === 'NULL' ? 'f-t-amber' : undefined} x={x} y={y + 22}
                  text-anchor="middle" style="font-family: var(--mono)">{value}</text>
              </g>
            );
          })}
        </g>
      );
    })}
  </svg>
</Figure>
