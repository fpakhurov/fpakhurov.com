---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Three ways of sending traffic to a candidate model v2 beside the current v1: a shadow (v2 gets a copy of every
// request, its answers are only logged), a canary (5% of requests answered by v2), an A/B test (users split by a hash).
const CANARY = 5;
interface Row { name: string; who: string; router: string; top: string; bottom: string; dashed: boolean; notes: string[]; noteN: string; split: boolean }
const rows: Row[] = ru
  ? [
      { name: 'теневой запуск', who: 'все видят v1', router: 'копирует', top: '100%, отвечает', bottom: 'копия, не видна', dashed: true, notes: ['пользователю', 'в лог, не отдаётся'], noteN: 'v1 отвечает пользователю; v2 только в лог', split: true },
      { name: 'канарейка', who: `${CANARY}% видят v2`, router: 'по запросу', top: `${100 - CANARY}%`, bottom: `${CANARY}%`, dashed: false, notes: ['обе отвечают;', 'метрики сравнивают'], noteN: 'обе отвечают; метрики сравнивают', split: false },
      { name: 'A/B-тест', who: 'половина — v2', router: 'по хешу id', top: 'хеш 0–49', bottom: 'хеш 50–99', dashed: false, notes: ['исходы сравнивают', 'в конце теста'], noteN: 'исходы сравнивают в конце теста', split: false },
    ]
  : [
      { name: 'shadow', who: 'users see v1', router: 'mirrors', top: '100%, answered', bottom: 'copy, not shown', dashed: true, notes: ['to the user', 'logged, dropped'], noteN: 'v1 answers the user; v2 is only logged', split: true },
      { name: 'canary', who: `${CANARY}% see v2`, router: 'by request', top: `${100 - CANARY}%`, bottom: `${CANARY}%`, dashed: false, notes: ['both answer users;', 'metrics compared'], noteN: 'both answer users; metrics compared', split: false },
      { name: 'A/B test', who: 'half see v2', router: 'by user hash', top: 'users 0–49', bottom: 'users 50–99', dashed: false, notes: ['outcomes compared', 'at the planned end'], noteN: 'outcomes compared at the planned end', split: false },
    ];
const v1 = ru ? 'v1 текущая' : 'v1 current', v2 = ru ? 'v2 кандидат' : 'v2 candidate', router = ru ? 'маршрутизатор' : 'router';
const title = ru ? 'Трафик теневого запуска, канарейки и A/B-теста' : 'Traffic in a shadow, a canary and an A/B test';
const steps = ru
  ? ['теневой запуск: каждый запрос идёт к v1, которая отвечает, и копией к v2, чей ответ только записывается в лог', `канарейка: ${CANARY}% запросов отвечает v2; её ошибки, задержка и распределение предсказаний сравниваются с v1`, 'A/B-тест: пользователи делятся по хешу идентификатора, каждый всегда видит одну модель; исходы групп сравнивают в конце']
  : ['shadow: every request goes to v1, which answers, and as a copy to v2, whose answer is only logged', `canary: ${CANARY}% of requests are answered by v2; its errors, latency and distribution of predictions are compared with v1`, 'A/B test: users are split by a hash of their identifier, and each always sees one model; the outcomes of the groups are compared at the end'];
const desc = ru
  ? 'Три ряда, в каждом маршрутизатор и две модели, v1 и v2. В теневом ряду сплошная стрелка ведёт к v1 со стопроцентным трафиком, пунктирная к v2 с копией; ответ v1 уходит пользователю, ответ v2 в лог. В ряду канарейки стрелки помечены 95% и 5%, обе модели отвечают, метрики сравнивают. В ряду A/B-теста маршрутизатор делит пользователей по хешу идентификатора: значения 0–49 — к v1, 50–99 — к v2; исходы сравнивают в конце теста.'
  : 'Three rows, each with a router and two models, v1 and v2. In the shadow row a solid arrow leads to v1 with all traffic and a dashed one to v2 with a copy; v1 answers the user, v2 goes to a log. In the canary row the arrows are labelled 95% and 5%, both models answer, and their metrics are compared. In the A/B row the router splits users by a hash: identifiers 0 to 49 go to v1 and 50 to 99 to v2; outcomes are compared at the end of the test.';

const fits = (s: string, room: number, px: number, what: string) => {
  if (s.length * px > room) throw new Error(`${what}: "${s}" needs ${(s.length * px).toFixed(0)} px, has ${room}`);
};
// Wide: rows of 96 px. Left column 12..160, router 170..300, arrow labels between 304 and 420, models 430..560,
// notes 596..748. Narrow: rows of 138 px; title line, router 4..116, models 230..350, one note line.
for (const r of rows) {
  fits(r.name, 160 - 34, 7.5, 'wide name');
  fits(r.who, 160 - 34, 6.5, 'wide who');
  fits(r.router, 130 - 8, 6.5, 'wide router sub');
  for (const s of [r.top, r.bottom]) fits(s, 420 - 304, 6.5, 'wide arrow label');
  for (const s of r.notes) fits(s, 152 - 10, 6.5, 'wide note');
  fits(r.router, 112 - 6, 7.3, 'narrow router sub');
  for (const s of [r.top, r.bottom]) fits(s, 228 - 118, 7.3, 'narrow arrow label');
  fits(r.noteN, 340, 7.3, 'narrow note');
  if (34 + r.name.length * 8 + 12 + r.who.length * 7.3 > 350) throw new Error(`narrow title line of ${r.name}`);
}
fits(router, 130 - 8, 7.5, 'wide router');
fits(router, 112 - 6, 8.0, 'narrow router');
for (const s of [v1, v2]) { fits(s, 130 - 8, 7.5, 'wide model'); fits(s, 120 - 8, 8.0, 'narrow model'); }
const id = 'traffic-splits';
const caption = ru
  ? `Как кандидат v2 получает трафик на каждом шаге выкатки. В теневом запуске (1) v2 обрабатывает копию каждого запроса, но её ответы только записываются: пользователи видят лишь v1, поэтому сбои, задержка и расхождения предсказаний видны, а реакция пользователей — нет. Канарейка (2) отдаёт ответы v2 на ${CANARY}% запросов и сравнивает её метрики с v1. A/B-тест (3) делит пользователей, а не запросы, по хешу идентификатора с солью эксперимента, так что каждый пользователь всё время видит одну модель, и сравнивает исходы групп в запланированный момент.`
  : `How the candidate v2 receives traffic at each step of a rollout. In a shadow (1), v2 processes a copy of every request, but its answers are only logged: users see only v1, so failures, latency and differences in predictions are visible, and users' responses are not. A canary (2) returns v2's answers for ${CANARY}% of requests and compares its metrics with v1's. An A/B test (3) splits users, not requests, by a hash of the identifier with an experiment salt, so that every user always sees the same model, and compares the outcomes of the groups at the planned time.`;
---

<Figure id={id} title={title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 302" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{title}</title>
    <desc id={`${id}-w-d`}>{desc}</desc>
    {rows.map((r, i) => {
      const y0 = 8 + i * 98;
      return (
        <g data-s={String(i + 1)}>
          <Badge x={20} y={y0 + 34} n={i + 1} />
          <text class="f-label" x={34} y={y0 + 39} style="font-weight: 650">{r.name}</text>
          <text class="f-small f-t-muted" x={34} y={y0 + 58}>{r.who}</text>
          <Box x={170} y={y0 + 18} w={130} h={48} label={router} sub={r.router} tone="n" />
          <Box x={430} y={y0 + 4} w={130} h={32} label={v1} tone="h" />
          <Box x={430} y={y0 + 48} w={130} h={32} label={v2} tone="x" />
          <Arrow pts={[[302, y0 + 34], [400, y0 + 20], [428, y0 + 20]]} tone="blue" />
          <text class="f-small f-t-blue f-halo" x={306} y={y0 + 18}>{r.top}</text>
          <Arrow pts={[[302, y0 + 50], [400, y0 + 64], [428, y0 + 64]]} tone="green" dashed={r.dashed} />
          <text class="f-small f-t-green f-halo" x={306} y={y0 + 82}>{r.bottom}</text>
          {r.split
            ? <g>
                <Arrow pts={[[562, y0 + 20], [594, y0 + 20]]} tone="blue" />
                <rect x={596} y={y0 + 8} width={152} height={24} rx="5" style="fill: var(--fig-blue); fill-opacity: 0.1; stroke: var(--fig-blue); stroke-width: 1" />
                <text class="f-small" x={672} y={y0 + 24} text-anchor="middle">{r.notes[0]}</text>
                <Arrow pts={[[562, y0 + 64], [594, y0 + 64]]} tone="green" dashed />
                <rect x={596} y={y0 + 52} width={152} height={24} rx="5" style="fill: none; stroke: var(--muted); stroke-width: 1; stroke-dasharray: 4 3" />
                <text class="f-small f-t-muted" x={672} y={y0 + 68} text-anchor="middle">{r.notes[1]}</text>
              </g>
            : <g>
                <path class="f-line f-amber" d={`M 562 ${y0 + 20} H 578 V ${y0 + 64} H 562`} />
                <Arrow pts={[[578, y0 + 42], [594, y0 + 42]]} tone="amber" />
                <rect x={596} y={y0 + 16} width={152} height={52} rx="5" style="fill: var(--fig-amber); fill-opacity: 0.1; stroke: var(--fig-amber); stroke-width: 1" />
                <text class="f-small" x={672} y={y0 + 38} text-anchor="middle">{r.notes[0]}</text>
                <text class="f-small" x={672} y={y0 + 56} text-anchor="middle">{r.notes[1]}</text>
              </g>}
        </g>
      );
    })}
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 420" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{title}</title>
    <desc id={`${id}-n-d`}>{desc}</desc>
    {rows.map((r, i) => {
      const y0 = 6 + i * 138;
      return (
        <g data-s={String(i + 1)}>
          <Badge x={18} y={y0 + 10} n={i + 1} />
          <text class="f-label" x={34} y={y0 + 16} style="font-weight: 650">{r.name}</text>
          <text class="f-small f-t-muted" x={350} y={y0 + 16} text-anchor="end">{r.who}</text>
          <Box x={4} y={y0 + 40} w={112} h={52} label={router} sub={r.router} tone="n" />
          <Box x={230} y={y0 + 30} w={120} h={30} label={v1} tone="h" />
          <Box x={230} y={y0 + 74} w={120} h={30} label={v2} tone="x" />
          <Arrow pts={[[118, y0 + 58], [228, y0 + 45]]} tone="blue" />
          <text class="f-small f-t-blue f-halo" x={173} y={y0 + 42} text-anchor="middle">{r.top}</text>
          <Arrow pts={[[118, y0 + 74], [228, y0 + 89]]} tone="green" dashed={r.dashed} />
          <text class="f-small f-t-green f-halo" x={173} y={y0 + 104} text-anchor="middle">{r.bottom}</text>
          <text class={`f-small ${r.split ? 'f-t-muted' : 'f-t-amber'}`} x={350} y={y0 + 126} text-anchor="end">{r.noteN}</text>
        </g>
      );
    })}
  </svg>
  <Stepper steps={steps} />
</Figure>
