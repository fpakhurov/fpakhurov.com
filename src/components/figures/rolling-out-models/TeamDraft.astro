---
import Figure from '../Figure.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Team-draft interleaving of ranker A's list [a, b, c, d] and ranker B's [b, e, a, f]. Round 1: the coin says A first,
// A adds a, B adds b. Round 2: the coin says B first, B adds e (b is taken), A adds c. The user sees [a, b, e, c] and
// clicks b and e, both on B's team: B wins this impression 2 to 0. A's list sits above the merged list and B's below,
// so every arrow runs between neighbouring rows.
const A = ['a', 'b', 'c', 'd'], B = ['b', 'e', 'a', 'f'];
const coins: ('A' | 'B')[] = ['A', 'B'];
const merged: { item: string; team: 'A' | 'B'; from: number }[] = [];
for (const first of coins) {
  for (const team of first === 'A' ? ['A', 'B'] as const : ['B', 'A'] as const) {
    const list = team === 'A' ? A : B;
    const from = list.findIndex((x) => !merged.some((m) => m.item === x));
    merged.push({ item: list[from], team, from });
  }
}
if (merged.map((m) => m.item).join('') !== 'abec' || merged.map((m) => m.team).join('') !== 'ABBA') throw new Error('team draft');
const clicks = ['b', 'e'];
if (merged.filter((m) => m.team === 'B' && clicks.includes(m.item)).length !== 2 || merged.some((m) => m.team === 'A' && clicks.includes(m.item))) throw new Error('clicks');

const t = ru
  ? { title: 'Командный драфт: два ранжирования, один список', a: 'ранжирование A', b: 'ранжирование B', m: 'видит пользователь', round: (r: number, f: string) => `раунд ${r}: монета → ${f} первым`, result: 'клики на b и e: B выигрывает 2 : 0',
      steps: ['раунд 1: монета выбрала A; A добавляет свой верхний элемент a, B — свой верхний b', 'раунд 2: монета выбрала B; b уже занят, поэтому B добавляет e, а A — c', 'пользователь видит [a, b, e, c] и кликает b и e, оба из команды B: этот показ B выигрывает 2 : 0'] }
  : { title: 'Team-draft interleaving: two rankings, one list', a: 'ranker A', b: 'ranker B', m: 'the user sees', round: (r: number, f: string) => `round ${r}: coin → ${f} first`, result: 'clicks on b and e: B wins 2 to 0',
      steps: ['round 1: the coin says A; A adds its top item a, and B its top item b', 'round 2: the coin says B; b is taken, so B adds e, and A adds c', 'the user sees [a, b, e, c] and clicks b and e, both on B’s team: B wins this impression 2 to 0'] };
const desc = ru
  ? 'Три ряда. Сверху ранжирование A: a, b, c, d. Снизу ранжирование B: b, e, a, f. Посередине объединённый список a, b, e, c; a и c окрашены в цвет A, b и e — в цвет B, стрелки идут к ним от элементов, которые их добавили. На b и e отмечены клики; итог: B выигрывает 2 : 0.'
  : 'Three rows. On top, ranker A: a, b, c, d. At the bottom, ranker B: b, e, a, f. In the middle, the merged list a, b, e, c, with a and c in A’s colour and b and e in B’s; arrows lead to them from the items that added them. Clicks are marked on b and e, and B wins 2 to 0.';
const caption = ru
  ? 'Командный драфт ранжирований A и B. В каждом раунде монета решает, кто выбирает первым, и каждое ранжирование добавляет свой верхний ещё не занятый элемент. Клик засчитывается команде, которая добавила элемент.'
  : 'Team-draft interleaving of rankers A and B. In each round a coin decides who picks first, and each ranker adds its highest item not yet taken. A click is credited to the team that added the item.';

const tone = (team: 'A' | 'B') => (team === 'A' ? 'blue' : 'red');
interface L { cls: string; W: number; H: number; x0: number; cell: number; gap: number; rows: [number, number, number]; labelLeft: boolean; noteX: number; noteY: number[]; sans: number }
const layouts: L[] = [
  { cls: 'fig-wide', W: 760, H: 270, x0: 170, cell: 50, gap: 16, rows: [30, 120, 210], labelLeft: true, noteX: 470, noteY: [52, 82, 142], sans: 6.5 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 380, x0: 24, cell: 58, gap: 16, rows: [40, 140, 240], labelLeft: false, noteX: 24, noteY: [306, 332, 358], sans: 7.3 },
];
for (const L of layouts) {
  const right = L.x0 + 4 * L.cell + 3 * L.gap;
  if (L.labelLeft) for (const s of [t.a, t.b, t.m]) if (16 + s.length * L.sans > L.x0 - 10) throw new Error(`row label ${s} at ${L.W}`);
  for (const s of [t.round(1, 'A'), t.result]) if (L.noteX + 18 + s.length * L.sans > L.W - 6) throw new Error(`note ${s} at ${L.W}`);
  if (L.labelLeft && L.noteX < right + 30) throw new Error('notes over the lists');
}
const id = 'team-draft';
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const cx = (i: number) => L.x0 + i * (L.cell + L.gap);
    const [yA, yM, yB] = L.rows;
    const label = (s: string, y: number, cls: string) => L.labelLeft
      ? <text class={`f-small ${cls}`} x={16} y={y + 21} style="font-weight: 650">{s}</text>
      : <text class={`f-small ${cls}`} x={L.x0} y={y - 8} style="font-weight: 650">{s}</text>;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{desc}</desc>
        {label(t.a, yA, 'f-t-blue')}
        {label(t.m, yM, '')}
        {label(t.b, yB, 'f-t-red')}
        {[[A, yA, 'blue', 'A'], [B, yB, 'red', 'B']].map(([list, y, c, team]) => (list as string[]).map((x, i) => (
          <g>
            <rect x={cx(i)} y={y as number} width={L.cell} height={32} rx="6" style={`fill: var(--fig-${c}); fill-opacity: ${merged.some((m) => m.team === team && m.item === x) ? 0.24 : 0.06}; stroke: var(--fig-${c})`} />
            <text class="f-label" x={cx(i) + L.cell / 2} y={(y as number) + 21} text-anchor="middle">{x}</text>
          </g>
        )))}
        {merged.map((m, k) => {
          const fromY = m.team === 'A' ? yA + 34 : yB - 2;
          const toY = m.team === 'A' ? yM - 3 : yM + 35;
          return (
            <g data-s={String(Math.floor(k / 2) + 1)}>
              <Arrow pts={[[cx(m.from) + L.cell / 2, fromY], [cx(k) + L.cell / 2, toY]]} tone={tone(m.team)} />
              <rect x={cx(k)} y={yM} width={L.cell} height={32} rx="6" style={`fill: var(--fig-${tone(m.team)}); fill-opacity: 0.24; stroke: var(--fig-${tone(m.team)}); stroke-width: 1.6`} />
              <text class="f-label" x={cx(k) + L.cell / 2} y={yM + 21} text-anchor="middle">{m.item}</text>
            </g>
          );
        })}
        {coins.map((first, r) => (
          <g data-s={String(r + 1)}>
            <Badge x={L.noteX + 6} y={L.noteY[r] - 5} n={r + 1} />
            <text class="f-small f-t-muted" x={L.noteX + 18} y={L.noteY[r]}>{t.round(r + 1, first)}</text>
          </g>
        ))}
        <g data-s="3">
          {merged.map((m, k) => clicks.includes(m.item) && (
            <circle cx={cx(k) + L.cell - 6} cy={yM + 6} r="5" style="fill: var(--fig-amber)" />
          ))}
          <Badge x={L.noteX + 6} y={L.noteY[2] - 5} n={3} />
          <circle cx={L.noteX + 22} cy={L.noteY[2] - 5} r="5" style="fill: var(--fig-amber)" />
          <text class="f-small f-t-amber" x={L.noteX + 32} y={L.noteY[2]} style="font-weight: 650">{t.result}</text>
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
