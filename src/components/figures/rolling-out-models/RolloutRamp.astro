---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The share of users answered by the candidate over a rollout: shadow (0%, a copy of traffic) for 3 days, a canary at
// 1% then 5% until day 7, a 50/50 experiment for two whole weeks, then 100% minus a 5% long-term holdout.
const DAYS = 28;
const phases = [
  { from: 0, to: 3 }, { from: 3, to: 7 }, { from: 7, to: 21 }, { from: 21, to: 28 },
];
// Exposure on an uneven scale: equal steps between 0, 1%, 5%, 50% and 100%.
const LEVELS = [0, 0.01, 0.05, 0.5, 1];
const lv = (share: number) => {
  for (let i = 1; i < LEVELS.length; i++) if (share <= LEVELS[i]) return i - 1 + (share - LEVELS[i - 1]) / (LEVELS[i] - LEVELS[i - 1]);
  return LEVELS.length - 1;
};
const path: [number, number][] = [[3, 0.01], [4.5, 0.01], [4.5, 0.05], [7, 0.05], [7, 0.5], [21, 0.5], [21, 0.95], [28, 0.95]];

const t = ru
  ? { title: 'Одна лестница выкатки: от теневого запуска до 100%', y: 'доля пользователей у новой модели', x: 'дни', ticks: ['0', '1%', '5%', '50%', '100%'],
      names: ['тень', 'канарейка', 'эксперимент 50/50', '100% и контроль'], copy: 'копия трафика', hold: 'контроль 5%',
      steps: ['теневой запуск: новая модель отвечает на копию трафика, пользователи её не видят; ищем, что ломается', 'канарейка: 1%, затем 5% пользователей на несколько дней; ловим грубые сбои, пока пострадавших мало', 'эксперимент 50/50 на две полные недели: только эта фаза решает, лучше ли новая модель', 'выкатка на всех, кроме постоянной контрольной группы в 5%: она показывает эффекты, которые проявляются медленно'] }
  : { title: 'One rollout ramp, from shadow to 100%', y: 'share of users on the new model', x: 'days', ticks: ['0', '1%', '5%', '50%', '100%'],
      names: ['shadow', 'canary', '50/50 experiment', '100% + holdout'], copy: 'copy of traffic', hold: '5% holdout',
      steps: ['shadow: the new model answers a copy of traffic that no user sees; we look for what breaks', 'canary: 1%, then 5% of users for a few days, to catch gross failures while few people are exposed', '50/50 experiment for two whole weeks: the only phase that decides whether the new model is better', 'full rollout, except a 5% long-term holdout that measures effects that appear slowly'] };
const desc = ru
  ? 'Ступенчатый график доли пользователей, которых обслуживает новая модель, по дням от 0 до 28; вертикальная шкала неравномерная: 0, 1%, 5%, 50%, 100%. Дни 0–3: теневой запуск, доля 0, пунктир «копия трафика». Дни 3–7: канарейка, 1%, затем 5%. Дни 7–21: эксперимент 50/50. С 21-го дня: 95%, оставшиеся 5% — долгосрочная контрольная группа.'
  : 'A step plot of the share of users served by the new model over days 0 to 28, on an uneven vertical scale with steps at 0, 1%, 5%, 50% and 100%. Days 0 to 3: shadow, share 0, a dashed line marked copy of traffic. Days 3 to 7: canary at 1%, then 5%. Days 7 to 21: a 50/50 experiment. From day 21: 95%, with the other 5% kept as a long-term holdout.';
const caption = ru
  ? 'Доля пользователей у новой модели на каждой фазе выкатки (шкала неравномерная). Ранние фазы ограничивают риск, решение принимается только в эксперименте 50/50, который длится целые недели; после выкатки 5% пользователей остаются на старой модели.'
  : 'The share of users on the new model in each phase of a rollout (uneven scale). The early phases limit risk; only the 50/50 phase, run for whole weeks, decides; after the rollout, 5% of users stay on the old model.';

interface L { cls: string; W: number; H: number; x0: number; x1: number; y0: number; y1: number; sans: number; names: boolean }
const layouts: L[] = [
  { cls: 'fig-wide', W: 760, H: 300, x0: 70, x1: 740, y0: 56, y1: 250, sans: 6.5, names: true },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 330, x0: 50, x1: 350, y0: 40, y1: 270, sans: 7.3, names: false },
];
const geo = layouts.map((L) => {
  const sx = (d: number) => L.x0 + (d / DAYS) * (L.x1 - L.x0);
  const sy = (share: number) => L.y1 - (lv(share) / (LEVELS.length - 1)) * (L.y1 - L.y0);
  if (L.names) phases.forEach((ph, i) => {
    if (t.names[i].length * L.sans > sx(ph.to) - sx(ph.from) - 22) throw new Error(`phase name ${t.names[i]} at ${L.W}`);
  });
  if (t.y.length * L.sans > L.x1 - L.x0) throw new Error('y title');
  if (t.copy.length * L.sans > sx(3) - sx(0) + 40 && L.names) throw new Error('copy label');
  const d = path.map(([day, share], i) => `${i ? 'L' : 'M'} ${sx(day).toFixed(1)} ${sy(share).toFixed(1)}`).join(' ');
  return { sx, sy, d };
});
const id = 'rollout-ramp';
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L, li) => {
    const g = geo[li];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{desc}</desc>
        {phases.map((ph, i) => (
          <g data-s={String(i + 1)}>
            <rect x={g.sx(ph.from)} y={L.y0 - 8} width={g.sx(ph.to) - g.sx(ph.from)} height={L.y1 - L.y0 + 8} style={`fill: var(--fig-${i === 2 ? 'blue' : 'amber'}); fill-opacity: ${i % 2 ? 0.1 : 0.04}`} />
            <Badge x={g.sx(ph.from) + 12} y={L.y0 - 26} n={i + 1} />
            {L.names && <text class="f-small" x={g.sx(ph.from) + 24} y={L.y0 - 21} style="font-weight: 650">{t.names[i]}</text>}
          </g>
        ))}
        {LEVELS.map((v, i) => (
          <g>
            <line class="f-grid" x1={L.x0} x2={L.x1} y1={g.sy(v)} y2={g.sy(v)} />
            <text class="f-small f-t-muted" x={L.x0 - 6} y={g.sy(v) + 4} text-anchor="end">{t.ticks[i]}</text>
          </g>
        ))}
        {[0, 7, 14, 21, 28].map((d, i) => (
          <text class="f-small f-t-muted" x={g.sx(d)} y={L.y1 + 16} text-anchor={i === 0 ? 'start' : i === 4 ? 'end' : 'middle'}>{String(d)}</text>
        ))}
        <path class="f-axis" d={`M ${L.x0} ${L.y0 - 8} V ${L.y1} H ${L.x1}`} />
        <text class="f-small f-t-muted" x={L.x1} y={L.y1 + 34} text-anchor="end">{t.x}</text>
        <text class="f-small f-t-muted" x={L.x0} y={L.y1 + 34}>{t.y}</text>
        <g data-s="1">
          <line x1={g.sx(0)} x2={g.sx(3)} y1={g.sy(0) - 3} y2={g.sy(0) - 3} style="stroke: var(--fig-green); stroke-width: 2.4; stroke-dasharray: 5 4" />
          {L.names && <text class="f-small f-t-green f-halo" x={g.sx(0) + 4} y={g.sy(0) - 10}>{t.copy}</text>}
        </g>
        <path d={g.d} style="fill: none; stroke: var(--fig-blue); stroke-width: 2.6; stroke-linejoin: round" />
        <g data-s="4">
          <rect x={g.sx(21)} y={g.sy(1)} width={g.sx(28) - g.sx(21)} height={g.sy(0.95) - g.sy(1)} style="fill: var(--fig-red); fill-opacity: 0.18" />
          {L.names && <text class="f-small f-t-red f-halo" x={g.sx(28) - 4} y={g.sy(0.95) + 16} text-anchor="end">{t.hold}</text>}
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
