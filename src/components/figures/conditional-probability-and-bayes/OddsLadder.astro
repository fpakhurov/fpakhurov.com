---
// Original two-flag population and sequential evidence diagram, AI-assisted.
// No external dataset, prior odds-ladder layout or log-odds implementation reused.
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
const ru = pageLang(Astro.url) === 'ru';
const table = {H:[12,6,4,2],L:[2,10,6,30]};
function gcd(a:number,b:number):number{return b?gcd(b,a%b):a;}
function ratio(a:number,b:number){const d=gcd(a,b);return `${a/d}:${b/d}`;}
function probability(a:number,b:number){const d=gcd(a,a+b);return `${a/d}/${(a+b)/d}`;}
const stages=[
 {id:'prior',evidence:ru?'До признаков':'Before flags',h:table.H.reduce((a,b)=>a+b,0),l:table.L.reduce((a,b)=>a+b,0),factor:'—'},
 {id:'u',evidence:ru?'После U':'After U',h:table.H[0]+table.H[1],l:table.L[0]+table.L[1],factor:'× 3'},
 {id:'uv',evidence:ru?'После U и V':'After U and V',h:table.H[0],l:table.L[0],factor:'× 4'},
];
if(stages.map(s=>ratio(s.h,s.l)).join(',')!=='1:2,3:2,6:1')throw new Error('Odds stages drift');
---
<Figure id="odds-ladder"
 title={ru?'Два разных наблюдения обновляют шансы':'Two distinct observations update the odds'}
 caption={ru?'В каждой строке шансы H:L вычислены по оставшимся записям. Множитель V равен четырём благодаря условной независимости внутри каждого режима. Повторный показ того же U сохранил бы вторую строку.':'Each row calculates H:L odds from the retained records. The V multiplier is four because the flags are conditionally independent within each mode. Showing the same U again would leave the second row unchanged.'}>
 <div class="odds-steps">{stages.map(s=><section data-odds-stage={s.id}>
  <div class="step-heading"><h4>{s.evidence}</h4><span>{s.factor}</span></div>
  <div class="step-values"><span>H: <strong>{s.h}</strong> · L: <strong>{s.l}</strong></span><span>{ru?'Шансы':'Odds'} <strong>{ratio(s.h,s.l)}</strong></span></div>
  <div class="odds-bar" aria-hidden="true"><span style={`width:${100*s.h/(s.h+s.l)}%`}></span></div>
  <p>P(H{ s.id==='prior'?'':s.id==='u'?' | U':' | U ∩ V'}) = {probability(s.h,s.l)}</p>
 </section>)}</div>
</Figure>
<style>
 .odds-steps{display:grid;gap:.7rem;font-size:.875rem;font-variant-numeric:tabular-nums}
 .odds-steps section{padding:.75rem;border:1px solid var(--line);border-radius:.5rem}
 .step-heading,.step-values{display:flex;justify-content:space-between;flex-wrap:wrap;gap:.3rem .7rem}
 .step-heading h4{font:inherit;font-weight:650;margin:0}
 .step-heading>span{font-weight:650;color:var(--fig-blue)}
 .step-values{margin:.35rem 0 .5rem}
 .odds-bar{height:.7rem;border-radius:.25rem;overflow:hidden;background:var(--fig-amber)}
 .odds-bar span{display:block;height:100%;background:var(--fig-blue)}
 .odds-steps p{margin:.35rem 0 0}
</style>
