---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Bayes' formula in odds form: every positive test multiplies the odds of "sick" by the likelihood ratio 0.9 / 0.09 = 10.
// On a log-odds axis each test is the same step. Prior 1%, then up to three positive tests, independent given the status.
const prior = 0.01, sens = 0.9, fpr = 0.09, lr = sens / fpr;
const states = [0, 1, 2, 3].map((k) => { const odds = (prior / (1 - prior)) * lr ** k; return { k, odds, p: odds / (1 + odds), lo: Math.log10(odds) }; });
if (states.map((s) => s.p.toFixed(3)).join() !== '0.010,0.092,0.503,0.910') throw new Error('OddsLadder: posteriors drifted from the note');
const ticks = [0.001, 0.01, 0.1, 0.5, 0.9, 0.99].map((p) => ({ p, lo: Math.log10(p / (1 - p)) }));
const oddsText = (k: number) => `${10 ** k} : 99`;
const t = ru
  ? { axis: 'вероятность болезни (шкала логарифма шансов)', odds: 'шансы', step: '×10',
      steps: ['априорно: 1% больных, шансы 1 : 99', 'положительный тест умножает шансы на 0.9 / 0.09 = 10: 0.092', 'второй положительный тест, независимый при известном статусе: 0.503', 'третий: 0.910'] }
  : { axis: 'probability of the disease (log-odds scale)', odds: 'odds', step: '×10',
      steps: ['prior: 1% are sick, odds 1 : 99', 'a positive test multiplies the odds by 0.9 / 0.09 = 10: 0.092', 'a second positive test, independent given the status: 0.503', 'a third one: 0.910'] };
const id = 'odds-ladder';
const range: [number, number] = [-3.2, 2.2];
const W = 720, wideAxis = 150, sx = scale(range, [40, 680]);
const NW = 360, narrowAxis = 120, sy = scale(range, [450, 40]);
const gap = (k: number) => states[k + 1].lo - states[k].lo;
---

<Figure
  id={id}
  title={ru ? 'Каждый положительный тест — одинаковый шаг в логарифме шансов' : 'Every positive test is the same step in log-odds'}
  caption={ru
    ? 'Болезнь у 1% людей, тест находит 90% больных и даёт 9% ложных срабатываний. В форме шансов формула Байеса — умножение: апостериорные шансы = априорные шансы × отношение правдоподобий, а отношение правдоподобий положительного теста 0.9 / 0.09 = 10. Шансы 1 : 99 превращаются в 10 : 99 (вероятность 0.092), второй тест, независимый при известном статусе, даёт 100 : 99 (0.503), третий — 1000 : 99 (0.910). На логарифмической шкале шансов каждое свидетельство — сдвиг на одну и ту же величину.'
    : 'The disease affects 1% of people; the test detects 90% of the sick and has 9% false positives. In odds form Bayes\' formula is a product: posterior odds = prior odds × likelihood ratio, and the likelihood ratio of a positive test is 0.9 / 0.09 = 10. Odds of 1 : 99 become 10 : 99 (probability 0.092); a second test, independent given the status, gives 100 : 99 (0.503), a third 1000 : 99 (0.910). On a log-odds scale every piece of evidence is a shift by the same amount.'}
>
  <svg class="fig-wide" viewBox={`0 0 ${W} 214`} role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{ru ? 'Шкала логарифма шансов с четырьмя состояниями' : 'A log-odds axis with four states'}</title>
    <desc id={`${id}-w-d`}>{ru ? 'Вероятности 0.010, 0.092, 0.503 и 0.910 на равных расстояниях на оси логарифма шансов.' : 'Probabilities 0.010, 0.092, 0.503 and 0.910 at equal distances on a log-odds axis.'}</desc>
    <path class="f-axis" d={`M ${sx(range[0])} ${wideAxis} H ${sx(range[1])}`} />
    {ticks.map((tk) => <g><path class="f-axis" d={`M ${sx(tk.lo)} ${wideAxis} v 6`} /><text class="f-note" x={sx(tk.lo)} y={wideAxis + 24} text-anchor="middle">{tk.p}</text></g>)}
    <text class="f-small f-t-muted" x={sx(range[0])} y={wideAxis + 54}>{t.axis}</text>
    {states.map((s) => (
      <g data-s={s.k + 1}>
        {s.k !== 0 && <path class="f-thin f-amber" d={`M ${sx(states[s.k - 1].lo) + 6} ${wideAxis - 54} Q ${sx(states[s.k - 1].lo + gap(s.k - 1) / 2)} ${wideAxis - 84} ${sx(s.lo) - 6} ${wideAxis - 54}`} marker-end="url(#f-arrow-amber)" />}
        {s.k !== 0 && <text class="f-small f-t-amber" x={sx(states[s.k - 1].lo + gap(s.k - 1) / 2)} y={wideAxis - 82} text-anchor="middle">{t.step}</text>}
        <circle cx={sx(s.lo)} cy={wideAxis} r="6" style={`fill: var(${s.k === 0 ? '--fig-blue' : '--fig-red'})`} />
        <text class="f-label" x={sx(s.lo)} y={wideAxis - 32} text-anchor="middle">{s.p.toFixed(3)}</text>
        <text class="f-note" x={sx(s.lo)} y={wideAxis - 14} text-anchor="middle">{oddsText(s.k)}</text>
        <Badge x={sx(s.lo) - 38} y={wideAxis - 37} n={s.k + 1} />
      </g>
    ))}
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox={`0 0 ${NW} 500`} role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{ru ? 'Шкала логарифма шансов с четырьмя состояниями' : 'A log-odds axis with four states'}</title>
    <desc id={`${id}-n-d`}>{ru ? 'Вероятности 0.010, 0.092, 0.503 и 0.910 на равных расстояниях на вертикальной оси логарифма шансов.' : 'Probabilities 0.010, 0.092, 0.503 and 0.910 at equal distances on a vertical log-odds axis.'}</desc>
    <path class="f-axis" d={`M ${narrowAxis} ${sy(range[0])} V ${sy(range[1])}`} />
    {ticks.map((tk) => <g><path class="f-axis" d={`M ${narrowAxis} ${sy(tk.lo)} h -6`} /><text class="f-note" x={narrowAxis - 12} y={sy(tk.lo) + 5} text-anchor="end">{tk.p}</text></g>)}
    <text class="f-small f-t-muted" x="16" y="488">{t.axis}</text>
    {states.map((s) => (
      <g data-s={s.k + 1}>
        {s.k !== 0 && <path class="f-thin f-amber" d={`M ${narrowAxis + 10} ${sy(states[s.k - 1].lo) - 6} Q ${narrowAxis + 44} ${sy(states[s.k - 1].lo + gap(s.k - 1) / 2)} ${narrowAxis + 10} ${sy(s.lo) + 6}`} marker-end="url(#f-arrow-amber)" />}
        {s.k !== 0 && <text class="f-small f-t-amber" x={narrowAxis + 40} y={sy(states[s.k - 1].lo + gap(s.k - 1) / 2) + 5}>{t.step}</text>}
        <circle cx={narrowAxis} cy={sy(s.lo)} r="6" style={`fill: var(${s.k === 0 ? '--fig-blue' : '--fig-red'})`} />
        <text class="f-label" x={narrowAxis + 112} y={sy(s.lo)}>{s.p.toFixed(3)}</text>
        <text class="f-note" x={narrowAxis + 112} y={sy(s.lo) + 18}>{`${t.odds} ${oddsText(s.k)}`}</text>
        <Badge x={narrowAxis + 92} y={sy(s.lo) - 5} n={s.k + 1} />
      </g>
    ))}
  </svg>
  <Stepper steps={t.steps} />
</Figure>
