---
// Original fictional population composed for this project with AI assistance.
// Compatibility filename and anchor retained; no former dice-grid code is used.
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
const ru = pageLang(Astro.url) === 'ru';
const counts = { H: [12, 6, 4, 2], L: [2, 10, 6, 30] };
const h = counts.H.reduce((a,b)=>a+b,0), l = counts.L.reduce((a,b)=>a+b,0);
const hu = counts.H[0]+counts.H[1], lu = counts.L[0]+counts.L[1];
const panels = [
 {id:'all',title:ru?'Все записи':'All records',left:'H',right:'L',a:h,b:l,result:'P(H) = 24/72 = 1/3'},
 {id:'given-u',title:ru?'Оставляем U':'Keep U',left:'H ∩ U',right:'L ∩ U',a:hu,b:lu,result:'P(H | U) = 18/30 = 3/5'},
 {id:'given-h',title:ru?'Оставляем H':'Keep H',left:'U ∩ H',right:'¬U ∩ H',a:hu,b:h-hu,result:'P(U | H) = 18/24 = 3/4'},
];
if(h!==24||l!==48||hu!==18||lu!==12)throw new Error('Conditional population drift');
---
<Figure id="dice-conditioning"
 title={ru?'Один числитель, разные знаменатели':'One numerator, different denominators'}
 caption={ru?'В обоих условиях пересечение содержит 18 записей. При U знаменатель равен 30, при H — 24. Ширина частей показывает доли внутри оставшейся совокупности; подписанные числа обозначают записи.':'Both conditions use an intersection of 18 records. Conditioning on U gives denominator 30; conditioning on H gives 24. Bar widths show shares within the retained population; labelled numbers count records.'}>
 <div class="population-panels">{panels.map(p=><section data-population={p.id}>
  <h4>{p.title}</h4>
  <p class="total">{ru?'Всего':'Total'}: {p.a+p.b}</p>
  <div class="population-bar" aria-hidden="true"><span style={`width:${100*p.a/(p.a+p.b)}%`}></span></div>
  <div class="counts"><span>{p.left}: <strong>{p.a}</strong></span><span>{p.right}: <strong>{p.b}</strong></span></div>
  <p class="result">{p.result}</p>
 </section>)}</div>
</Figure>
<style>
 .population-panels{display:grid;gap:.8rem;font-size:.875rem;font-variant-numeric:tabular-nums}
 .population-panels section{border:1px solid var(--line);border-radius:.5rem;padding:.75rem;min-width:0}
 .population-panels h4{margin:0;font:inherit;font-weight:650}
 .population-panels .total{margin:.2rem 0 .5rem;color:var(--muted)}
 .population-bar{height:.8rem;border-radius:.3rem;background:var(--fig-amber);overflow:hidden}
 .population-bar span{display:block;height:100%;background:var(--fig-blue)}
 .counts{display:flex;justify-content:space-between;gap:.5rem;margin-top:.4rem}
 .result{margin:.6rem 0 0;overflow-wrap:anywhere}
 @media(min-width:45rem){.population-panels{grid-template-columns:repeat(3,minmax(0,1fr))}}
</style>
