---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Two dice; rows are the first die, columns the second. A = "the first die is 3", B = "the sum is 8".
// Conditioning on an event keeps only its cells; the conditional probability is the share of them that are also in the other event.
const faces = [1, 2, 3, 4, 5, 6];
const inA = (i: number) => i === 3, inB = (i: number, j: number) => i + j === 8;
const cells = faces.flatMap((i) => faces.map((j) => ({ i, j })));
const nB = cells.filter((c) => inB(c.i, c.j)).length, nA = cells.filter((c) => inA(c.i)).length;
const nAB = cells.filter((c) => inA(c.i) && inB(c.i, c.j)).length;
if (nB !== 5 || nA !== 6 || nAB !== 1) throw new Error('DiceConditioning: counts drifted from the note');
const panels = [
  { given: (c: { i: number; j: number }) => inB(c.i, c.j), title: ru ? '(а) известно: сумма равна 8' : '(a) given: the sum is 8', p: ru ? `P(первая 3 | сумма 8) = ${nAB}/${nB}` : `P(first is 3 | sum is 8) = ${nAB}/${nB}` },
  { given: (c: { i: number; j: number }) => inA(c.i), title: ru ? '(б) известно: на первой кости 3' : '(b) given: the first die is 3', p: ru ? `P(сумма 8 | первая 3) = ${nAB}/${nA}` : `P(sum is 8 | first is 3) = ${nAB}/${nA}` },
];
const id = 'dice-conditioning';
const cell = 28;
const layouts = [
  { cls: 'fig-wide', W: 760, H: 300, pos: (k: number) => [80 + k * 380, 74], text: (k: number) => 40 + k * 380 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 590, pos: (k: number) => [110, 74 + k * 290], text: () => 20 },
];
---

<Figure
  id={id}
  title={ru ? 'Условная вероятность сужает пространство исходов' : 'Conditioning shrinks the sample space'}
  caption={ru
    ? `Строки — первая кость, столбцы — вторая. (а) Если известно, что сумма равна 8, остаются ${nB} клеток (синие), и в одной из них на первой кости 3 (жёлтая): P = 1/${nB}. (б) Если известно, что на первой кости 3, остаются ${nA} клеток строки 3, и сумма 8 только в одной: P = 1/${nA}. Пересечение одно и то же, а знаменатели разные: P(A | B) и P(B | A) — разные числа.`
    : `Rows are the first die, columns the second. (a) Given that the sum is 8, ${nB} cells remain (blue), and in one of them the first die shows 3 (amber): P = 1/${nB}. (b) Given that the first die shows 3, the ${nA} cells of row 3 remain, and only one of them sums to 8: P = 1/${nA}. The intersection is the same cell, the denominators differ: P(A | B) and P(B | A) are different numbers.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Две сетки 6 × 6 для двух условий' : 'Two 6 × 6 grids for two conditions'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? 'Слева выделены 5 клеток с суммой 8, одна из них с первой костью 3. Справа выделена строка 3 из 6 клеток, одна из них с суммой 8.' : 'Left, the 5 cells with sum 8 are highlighted, one of them with first die 3. Right, row 3 with 6 cells is highlighted, one of them with sum 8.'}</desc>
      {panels.map((P, k) => {
        const [x0, y0] = L.pos(k), tx = L.text(k);
        return (
          <g>
            <text class="f-small" x={tx} y={y0 - 46}>{P.title}</text>
            {faces.map((f, j) => <text class="f-note" x={x0 + j * cell + cell / 2 - 1} y={y0 - 8} text-anchor="middle">{f}</text>)}
            {faces.map((f, i) => <text class="f-note" x={x0 - 12} y={y0 + i * cell + cell / 2 + 5} text-anchor="middle">{f}</text>)}
            {cells.map((c) => {
              const g = P.given(c), both = inA(c.i) && inB(c.i, c.j);
              const fill = both ? 'var(--fig-amber)' : g ? 'var(--fig-blue)' : 'var(--muted)';
              const op = both ? 0.75 : g ? 0.45 : 0.08;
              return <rect x={x0 + (c.j - 1) * cell} y={y0 + (c.i - 1) * cell} width={cell - 2} height={cell - 2} rx="3" style={`fill: ${fill}; fill-opacity: ${op}; stroke: var(--line); stroke-width: 1`} />;
            })}
            <text class="f-label" x={tx} y={y0 + 6 * cell + 30}>{P.p}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
