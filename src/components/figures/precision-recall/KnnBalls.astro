---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The one-dimensional worked example of the note: k = 1, four real and four generated samples.
const X = [0, 1, 2, 3];
const Y = [0.2, 0.8, 1.1, 7];
const radius = (A: number[]) => A.map((a, i) => Math.min(...A.filter((_, j) => j !== i).map((b) => Math.abs(a - b))));
const rX = radius(X), rY = radius(Y);
const inX = Y.map((y) => X.some((x, i) => Math.abs(y - x) <= rX[i]));
const inY = X.map((x) => Y.some((y, j) => Math.abs(x - y) <= rY[j]));
const precision = inX.filter(Boolean).length / Y.length, recall = inY.filter(Boolean).length / X.length;
if (precision !== 0.75 || recall !== 1 || rY[3].toFixed(1) !== '5.9') throw new Error('KnnBalls: example drifted from the note');
const t = ru
  ? { a: 'шары вокруг настоящих точек → точность', b: 'шары вокруг сгенерированных точек → полнота', real: 'настоящие', gen: 'сгенерированные', p: 'точность = 3/4', r: 'полнота = 4/4', out: 'выброс 7: радиус 5.9' }
  : { a: 'balls around real samples → precision', b: 'balls around generated samples → recall', real: 'real', gen: 'generated', p: 'precision = 3/4', r: 'recall = 4/4', out: 'outlier 7: radius 5.9' };
const id = 'precision-recall-knn-balls';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 720, H: 300, x0: 40, x1: 700, narrow: false },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 350, x0: 14, x1: 346, narrow: true },
];
---

<Figure
  id={id}
  title={ru ? 'Шары k ближайших соседей и выброс' : 'k-NN balls, and an outlier'}
  caption={ru
    ? 'Разобранный пример из текста при k = 1: настоящие точки 0, 1, 2, 3 (серые) и сгенерированные 0.2, 0.8, 1.1, 7 (синие). Сверху вокруг каждой настоящей точки — отрезок радиуса до её ближайшей настоящей соседки, а над прямой — проверяемые сгенерированные точки: зелёная попадает хотя бы в один отрезок и засчитывается в точность, красная нет, так что точность 3/4. Снизу отрезки строятся вокруг сгенерированных точек, а проверяются настоящие: покрытые засчитываются в полноту. Изолированная точка 7 получает радиус 5.9 и одна покрывает 2 и 3: полнота 4/4, хотя модель не порождает ничего рядом с ними. Без выброса полнота была бы 2/4.'
    : 'The worked example of the text with k = 1: real samples 0, 1, 2, 3 (grey) and generated samples 0.2, 0.8, 1.1, 7 (blue). Top: around each real sample, a segment whose radius is the distance to its nearest real neighbour, and above the line the generated samples being checked: green if it lies in at least one segment and counts toward precision, red if not, so precision is 3/4. Bottom: the segments are built around the generated samples and the real samples are checked; covered ones count toward recall. The isolated sample 7 gets radius 5.9 and on its own covers 2 and 3: recall is 4/4 although the model produces nothing near them. Without the outlier, recall would be 2/4.'}
>
  {layouts.map((L) => {
    const sx = scale([-1.5, 13.5], [L.x0, L.x1]);
    const rows = [
      { title: t.a, centres: X, radii: rX, top: L.narrow ? 50 : 34, tone: 'muted', points: Y, hits: inX, pointTone: 'blue', result: t.p },
      { title: t.b, centres: Y, radii: rY, top: L.narrow ? 214 : 170, tone: 'blue', points: X, hits: inY, pointTone: 'muted', result: t.r },
    ];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{ru ? 'Точность и полнота по k ближайшим соседям в одном измерении' : 'k-NN precision and recall in one dimension'}</title>
        <desc id={`${id}-${L.sfx}-d`}>{ru ? 'Две числовые прямые. Сверху отрезки радиуса 1 вокруг настоящих точек 0, 1, 2, 3; сгенерированные точки 0.2, 0.8 и 1.1 внутри, точка 7 снаружи: точность 3/4. Снизу отрезки вокруг сгенерированных точек с радиусами 0.6, 0.3, 0.3 и 5.9; отрезок выброса 7 накрывает настоящие точки 2 и 3: полнота 4/4.' : 'Two number lines. Top: segments of radius 1 around the real samples 0, 1, 2, 3; generated samples 0.2, 0.8 and 1.1 lie inside, 7 outside: precision 3/4. Bottom: segments around the generated samples with radii 0.6, 0.3, 0.3 and 5.9; the segment of the outlier 7 covers the real samples 2 and 3: recall 4/4.'}</desc>
        {rows.map((row) => {
          const axisY = row.top + 70;
          return (
            <g>
              <text class="f-label" x={L.x0} y={row.top - (L.narrow ? 30 : 12)}>{L.narrow ? row.title.split(' → ')[0] : row.title}</text>
              <text class="f-label f-t-green" x={L.narrow ? L.x0 : L.x1} y={row.top - 12} text-anchor={L.narrow ? 'start' : 'end'}>{row.result}</text>
              {row.centres.map((c, i) => (
                <g>
                  <path class={`f-line ${row.tone === 'blue' ? 'f-blue' : 'f-muted'}`} d={`M ${sx(c - row.radii[i])} ${row.top + 4 + i * 10} H ${sx(c + row.radii[i])}`} />
                  <path class="f-thin f-muted f-dot" d={`M ${sx(c)} ${row.top + 4 + i * 10} V ${axisY}`} />
                </g>
              ))}
              <path class="f-axis" d={`M ${sx(-1.5)} ${axisY} H ${sx(13.5)}`} />
              {[0, 1, 2, 3, 5, 7, 10, 13].map((v) => <text class="f-note" x={sx(v)} y={axisY + 18} text-anchor="middle">{v}</text>)}
              {row.centres.map((c) => <circle cx={sx(c)} cy={axisY} r="4.5" style={`fill: var(--${row.tone === 'blue' ? 'fig-blue' : 'muted'})`} />)}
              {row.points.map((p, i) => <circle cx={sx(p)} cy={axisY - 14} r="4.5" style={`fill: var(--fig-${row.hits[i] ? 'green' : 'red'})`} />)}
            </g>
          );
        })}
        <text class="f-note f-t-blue f-halo" x={sx(9.5)} y={rows[1].top + 4 + 3 * 10 - 6} text-anchor="middle">{t.out}</text>
      </svg>
    );
  })}
</Figure>
