---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';
import { real, scenarios } from './scenarios';

const ru = pageLang(Astro.url) === 'ru';

const f2 = (v: number) => v.toFixed(2);
const [narrowS, matched, broad] = scenarios;
if (f2(narrowS.precision) !== '0.98' || f2(narrowS.recall) !== '0.48' || f2(broad.precision) !== '0.88' || f2(broad.recall) !== '0.99') throw new Error('Scenarios: numbers drifted from the note');
const shown = 260;
const t = ru
  ? { real: 'настоящие', gen: 'сгенерированные', p: 'точность', r: 'полнота', names: ['сжатая модель', 'точная модель', 'размытая модель'] }
  : { real: 'real', gen: 'generated', p: 'precision', r: 'recall', names: ['collapsed model', 'matched model', 'spread-out model'] };
const id = 'precision-recall-scenarios';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 720, H: 312, size: 212, gap: 22, top: 40, row: false },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 980, size: 230, gap: 64, top: 40, row: true },
];
---

<Figure
  id={id}
  title={ru ? 'Одинаковый FID, противоположные точность и полнота' : 'The same FID, opposite precision and recall'}
  caption={ru
    ? `Настоящие данные — 2000 точек из N(0, I) (серые), модели — по 2000 из N(0, s²I) с s = 0.3, 1 и 1.7 (цветные); показаны первые ${shown}. FID = 2(1 − s)² равен 0.98 при s = 0.3 и 1.7. При k = 3 у сжатой модели точность ${f2(narrowS.precision)} и полнота ${f2(narrowS.recall)}, у размытой — точность ${f2(broad.precision)} и полнота ${f2(broad.recall)}.`
    : `Real data: 2000 points from N(0, I) (grey); models: 2000 points from N(0, s²I) with s = 0.3, 1 and 1.7 (coloured), the first ${shown} of each shown. FID = 2(1 − s)² is 0.98 for both s = 0.3 and 1.7. With k = 3, the collapsed model has precision ${f2(narrowS.precision)} and recall ${f2(narrowS.recall)}; the spread-out one, precision ${f2(broad.precision)} and recall ${f2(broad.recall)}.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{ru ? 'Три модели против одних данных' : 'Three models against the same data'}</title>
      <desc id={`${id}-${L.sfx}-d`}>{scenarios.map((sc, i) => `${t.names[i]}, s = ${sc.s}: FID ${f2(sc.fid)}, ${t.p} ${f2(sc.precision)}, ${t.r} ${f2(sc.recall)}`).join('; ')}.</desc>
      {scenarios.map((sc, i) => {
        const x0 = L.row ? (L.W - L.size) / 2 : 12 + i * (L.size + L.gap);
        const y0 = L.row ? L.top + i * (L.size + L.gap + 30) : L.top;
        const sx = scale([-4, 4], [x0, x0 + L.size]);
        const sy = scale([-4, 4], [y0 + L.size, y0]);
        const tone = ['red', 'blue', 'amber'][i];
        return (
          <g>
            <text class="f-label" x={x0} y={y0 - 12}>{`${t.names[i]}, s = ${sc.s}`}</text>
            <rect class="f-thin f-muted" x={x0} y={y0} width={L.size} height={L.size} fill="none" />
            {real.slice(0, shown).map(([x, y]) => <circle cx={sx(x)} cy={sy(y)} r="1.9" style="fill: var(--muted); opacity: 0.55" />)}
            {sc.gen.slice(0, shown).filter(([x, y]) => Math.abs(x) < 4 && Math.abs(y) < 4).map(([x, y]) => <circle cx={sx(x)} cy={sy(y)} r="1.9" style={`fill: var(--fig-${tone}); opacity: 0.8`} />)}
            <text class="f-note" x={x0} y={y0 + L.size + 20}>{`FID ${f2(sc.fid)}`}</text>
            <text class="f-note" x={x0} y={y0 + L.size + 38}>{`${t.p} ${f2(sc.precision)} · ${t.r} ${f2(sc.recall)}`}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
