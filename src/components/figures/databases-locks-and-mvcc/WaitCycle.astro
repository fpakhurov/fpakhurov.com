---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
const id = 'db-wait-cycle';
const title = ru ? 'Цикл ожидания из двух транзакций' : 'A two-transaction wait cycle';
---
<Figure id={id} title={title} caption={ru
  ? 'T1 владеет блокировкой строки A, T2 владеет блокировкой строки B. Каждая стрелка ведёт от ожидающей транзакции к владельцу нужной ей блокировки.'
  : 'T1 holds the lock on row A and T2 holds the lock on row B. Each arrow points from the waiting transaction to the holder it needs.'}>
  <svg viewBox="0 0 330 134" class="fig-compact" role="img" aria-labelledby={id + '-title ' + id + '-desc'}>
    <title id={id + '-title'}>{title}</title>
    <desc id={id + '-desc'}>{ru ? 'T1 ждёт строку B, заблокированную T2. T2 ждёт строку A, заблокированную T1.' : 'T1 waits for row B held by T2, and T2 waits for row A held by T1.'}</desc>
    <rect x="11" y="52" width="86" height="39" rx="6" class="f-fill-blue" />
    <text x="54" y="77" class="f-title" text-anchor="middle">T1 · A</text>
    <rect x="233" y="52" width="86" height="39" rx="6" class="f-fill-green" />
    <text x="276" y="77" class="f-title" text-anchor="middle">T2 · B</text>
    <path d="M 99 62 C 135 38 197 38 229 62" class="f-axis" marker-end="url(#f-arrow-muted)" />
    <path d="M 231 82 C 195 108 133 108 101 82" class="f-axis" marker-end="url(#f-arrow-muted)" />
    <text x="165" y="31" text-anchor="middle">{ru ? 'Ждёт B' : 'Waits for B'}</text>
    <text x="165" y="127" text-anchor="middle">{ru ? 'Ждёт A' : 'Waits for A'}</text>
  </svg>
</Figure>
