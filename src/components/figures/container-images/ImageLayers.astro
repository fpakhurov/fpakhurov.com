---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Two orders of the same Dockerfile, after an edit to one file of the code (src/calc/web.py).
// A step misses the cache if its own inputs changed or if the step below it missed.
interface Step { text: string; changed: boolean }
const orderA: Step[] = [
  { text: 'FROM python:3.14-slim', changed: false },
  { text: 'WORKDIR /app', changed: false },
  { text: 'COPY . .', changed: true },
  { text: 'RUN uv sync --locked', changed: false },
  { text: 'CMD ["uvicorn", …]', changed: false },
];
const orderB: Step[] = [
  { text: 'FROM python:3.14-slim', changed: false },
  { text: 'WORKDIR /app', changed: false },
  { text: 'COPY pyproject.toml uv.lock ./', changed: false },
  { text: 'RUN uv sync --no-install-project', changed: false },
  { text: 'COPY src/ ./src/', changed: true },
  { text: 'RUN uv sync --no-editable', changed: false },
  { text: 'CMD ["uvicorn", …]', changed: false },
];
type Status = 'hit' | 'miss' | 'rerun';
function simulate(steps: Step[]): Status[] {
  let missed = false;
  return steps.map((s) => {
    if (s.changed && !missed) { missed = true; return 'miss'; }
    return missed ? 'rerun' : 'hit';
  });
}
const stA = simulate(orderA), stB = simulate(orderB);
const runs = (st: Status[]) => st.filter((s) => s !== 'hit').length;
if (runs(stA) !== 3 || runs(stB) !== 3) throw new Error('expected 3 steps to run in each order');
// The dependency installation is the expensive step: it runs again in order A only.
if (stA[3] !== 'rerun' || stB[3] !== 'hit') throw new Error('dependency step status');

const word: Record<Status, string> = ru ? { hit: 'кэш', miss: 'промах', rerun: 'заново' } : { hit: 'hit', miss: 'miss', rerun: 'rerun' };
const tone: Record<Status, string> = { hit: 'var(--muted)', miss: 'var(--fig-amber)', rerun: 'var(--fig-red)' };
const ruSteps = (n: number) => (n % 10 === 1 && n % 100 !== 11 ? 'шаг' : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? 'шага' : 'шагов');
const summary = (st: Status[], depsAgain: boolean) => ru
  ? `заново: ${runs(st)} ${ruSteps(runs(st))} из ${st.length}${depsAgain ? ', включая установку' : ', установка из кэша'}`
  : `${runs(st)} of ${st.length} steps run${depsAgain ? ', install included' : ', install cached'}`;
const sumA = summary(stA, true), sumB = summary(stB, false);
const titleA = ru ? 'COPY . . до установки' : 'COPY . . before the install';
const titleB = ru ? 'сначала файл блокировки' : 'the lockfile first';
const note = ru ? 'изменён один файл: src/calc/web.py' : 'one file changed: src/calc/web.py';
const steps = ru
  ? ['изменён один файл кода', 'порядок A: промах на COPY . ., зависимости устанавливаются заново', 'порядок B: файл блокировки и зависимости из кэша, промах только на COPY src/']
  : ['one file of the code changes', 'order A: the miss is at COPY . ., and the dependencies are installed again', 'order B: the lockfile and dependencies are cache hits; the miss is at COPY src/'];

interface Layout {
  cls: string; W: number; H: number; w: number; rowH: number; gap: number; mono: number; sans: number;
  noteY: number; ax: number; bx: number; aTitleY: number; bTitleY: number; aBottom: number; bBottom: number; aSumY: number; bSumY: number;
}
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 322, w: 330, rowH: 28, gap: 4, mono: 7.5, sans: 6.5, noteY: 21, ax: 30, bx: 400, aTitleY: 52, bTitleY: 52, aBottom: 288, bBottom: 288, aSumY: 310, bSumY: 310 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 530, w: 344, rowH: 28, gap: 4, mono: 8.4, sans: 7.3, noteY: 21, ax: 8, bx: 8, aTitleY: 50, bTitleY: 268, aBottom: 218, bBottom: 500, aSumY: 240, bSumY: 522 },
];
for (const L of layouts) {
  for (const [stepsX, st] of [[orderA, stA], [orderB, stB]] as [Step[], Status[]][]) {
    stepsX.forEach((s, i) => {
      if (10 + s.text.length * L.mono + 10 + word[st[i]].length * L.sans + 10 > L.w) throw new Error(`row "${s.text}" too wide at ${L.W}`);
    });
  }
  for (const t of [sumA, sumB, titleA, titleB]) if (34 + t.length * L.sans > (L.W === 760 ? 370 : L.W - 4)) throw new Error(`text "${t}" too wide at ${L.W}`);
  if (34 + note.length * L.sans > L.W - 4) throw new Error('note too wide');
  // Stacks do not run into their titles.
  if (L.aBottom - orderA.length * (L.rowH + L.gap) < L.aTitleY + 8) throw new Error('stack A overlaps its title');
  if (L.bBottom - orderB.length * (L.rowH + L.gap) < L.bTitleY + 8) throw new Error('stack B overlaps its title');
}
// Rows are drawn from the bottom up: the base image at the bottom, each step on top of the one before.
const rowTop = (L: Layout, bottom: number, i: number) => bottom - (i + 1) * (L.rowH + L.gap) + L.gap;
const id = 'image-layers';
---

<Figure
  id={id}
  title={ru ? 'Кэш сборки при двух порядках шагов Dockerfile' : 'The build cache under two orders of Dockerfile steps'}
  caption={ru
    ? 'Каждый шаг Dockerfile лежит на предыдущем, базовый образ внизу. После правки одного файла кода (1) шаг не находит своего результата в кэше (промах), если изменились его собственные входы или промах случился на шаге под ним. В порядке A (2) копия всего контекста COPY . . меняется, и всё выше неё выполняется заново, включая установку всех зависимостей. В порядке B (3) pyproject.toml и uv.lock не менялись, поэтому их копия и установка зависимостей берутся из кэша; промах приходится на COPY src/, и заново выполняются только дешёвые шаги: в обоих порядках три шага, но в B среди них нет установки зависимостей.'
    : 'Each Dockerfile step sits on the one before it, the base image at the bottom. After an edit to one file of the code (1), a step misses the cache if its own inputs changed or if the step below it missed. In order A (2), the copy of the whole context, COPY . ., changes, and everything above it runs again, including the installation of every dependency. In order B (3), pyproject.toml and uv.lock did not change, so their copy and the dependency installation are cache hits; the miss comes at COPY src/, and only cheap steps run again: three steps run in both orders, but in B the dependency installation is not among them.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Слои образа и кэш сборки' : 'Image layers and the build cache'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Две стопки шагов сборки. В первой (порядок A) после изменения кода промах на COPY . ., и установка зависимостей выполняется заново. Во второй (порядок B) копия файла блокировки и установка зависимостей берутся из кэша, промах на COPY src/.'
        : 'Two stacks of build steps. In the first (order A), after a code change the miss is at COPY . ., and the dependency installation runs again. In the second (order B), the lockfile copy and the dependency installation are cache hits, and the miss is at COPY src/.'}</desc>
      <g data-s="1">
        <Badge x={L.ax + 10} y={L.noteY - 5} n={1} />
        <text class="f-small" x={L.ax + 26} y={L.noteY} style="font-weight: 650">{note}</text>
      </g>
      {[
        { steps: orderA, st: stA, x: L.ax, titleY: L.aTitleY, bottom: L.aBottom, sumY: L.aSumY, title: titleA, sum: sumA, n: 2 },
        { steps: orderB, st: stB, x: L.bx, titleY: L.bTitleY, bottom: L.bBottom, sumY: L.bSumY, title: titleB, sum: sumB, n: 3 },
      ].map((S) => (
        <g data-s={String(S.n)}>
          <Badge x={S.x + 10} y={S.titleY - 5} n={S.n} />
          <text class="f-small" x={S.x + 26} y={S.titleY} style="font-weight: 650">{S.title}</text>
          {S.steps.map((s, i) => {
            const y = rowTop(L, S.bottom, i), st = S.st[i], c = tone[st];
            return (
              <g>
                <rect x={S.x} y={y} width={L.w} height={L.rowH} rx="5" style={`fill: ${st === 'hit' ? 'var(--paper-strong)' : c}; fill-opacity: ${st === 'hit' ? 1 : 0.15}; stroke: ${c}; stroke-width: ${st === 'hit' ? 1 : 1.6}`} />
                <text class="f-small" x={S.x + 10} y={y + L.rowH / 2 + 4.5} style="font-family: var(--mono)">{s.text}</text>
                <text class={`f-small ${st === 'hit' ? 'f-t-muted' : st === 'miss' ? 'f-t-amber' : 'f-t-red'}`} x={S.x + L.w - 10} y={y + L.rowH / 2 + 4.5} text-anchor="end" style="font-weight: 650">{word[st]}</text>
              </g>
            );
          })}
          <text class="f-small f-t-muted" x={S.x + 26} y={S.sumY}>{S.sum}</text>
        </g>
      ))}
    </svg>
  ))}
  <Stepper steps={steps} />
</Figure>
