---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The string "naïve €" as Python sees it (7 code points) and as UTF-8 stores it (10 bytes).
// Code points and bytes are computed here, and checked against the REPL output of the note:
// s.encode("utf-8") == b'na\xc3\xafve \xe2\x82\xac'.
const s = 'naïve €';
const chars = [...s];
const cps = chars.map((c) => c.codePointAt(0)!);
const enc = new TextEncoder();
const bytesOf = chars.map((c) => [...enc.encode(c)]);
const hex = (v: number, w: number) => v.toString(16).toUpperCase().padStart(w, '0');
const allBytes = bytesOf.flat();
if (chars.length !== 7) throw new Error(`len ${chars.length}`);
if (allBytes.length !== 10) throw new Error(`bytes ${allBytes.length}`);
if (allBytes.map((b) => hex(b, 2)).join(' ') !== '6E 61 C3 AF 76 65 20 E2 82 AC') throw new Error('UTF-8 bytes');
if (bytesOf.map((b) => b.length).join() !== '1,1,2,1,1,1,3') throw new Error('bytes per character');
const glyph = (c: string) => (c === ' ' ? '␣' : c);
// Byte offset at which each character starts.
const start = bytesOf.map((_, i) => bytesOf.slice(0, i).reduce((a, b) => a + b.length, 0));

const t = ru
  ? { top: 'str: последовательность кодовых точек', short: '7 кодовых точек, 10 байт', bottom: "bytes: s.encode('utf-8')", sum: "len(s) == 7, len(s.encode('utf-8')) == 10",
      steps: ['строка состоит из семи символов', 'каждый символ — кодовая точка Юникода, число', 'индексы считаются по кодовым точкам, с начала и с конца', 'UTF-8 записывает кодовую точку одним, двумя или тремя байтами (до четырёх)', 'длины разные: 7 кодовых точек, 10 байт'] }
  : { top: 'str: a sequence of code points', short: '7 code points, 10 bytes', bottom: "bytes: s.encode('utf-8')", sum: "len(s) == 7, len(s.encode('utf-8')) == 10",
      steps: ['the string holds seven characters', 'each character is a Unicode code point, a number', 'indices count code points, from the start and from the end', 'UTF-8 stores a code point in one, two or three bytes (up to four)', 'the lengths differ: 7 code points, 10 bytes'] };

interface Layout { cls: string; W: number; H: number; x0: number; cw: number; bw: number; prefix: boolean; sans: number; mono: number; badgeX: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 296, x0: 96, cw: 86, bw: 60.2, prefix: true, sans: 6.5, mono: 7.5, badgeX: 76 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 296, x0: 36, cw: 44, bw: 30.8, prefix: false, sans: 7.3, mono: 8.4, badgeX: 16 },
];
const Y = { top: 20, pos: 46, cell: 56, ch: 52, neg: 126, trap: 136, bytes: 192, bh: 34, bottom: 248, sum: 276 };
for (const L of layouts) {
  if (Math.abs(chars.length * L.cw - allBytes.length * L.bw) > 0.5) throw new Error('rows of different widths');
  if (L.x0 + chars.length * L.cw > L.W - 4) throw new Error(`row overflows at ${L.W}`);
  const cpw = (L.prefix ? 6 : 4) * L.sans;
  if (cpw > L.cw - 6) throw new Error(`code point label too wide at ${L.W}`);
  if (2 * L.sans > L.bw - 6) throw new Error('byte label too wide');
  for (const str of [t.top, t.bottom]) if (L.x0 + str.length * L.sans > L.W - 4) throw new Error(`"${str}" overflows at ${L.W}`);
  if (L.x0 + (L.prefix ? t.sum.length * L.mono : t.short.length * L.sans) > L.W - 4) throw new Error('summary overflows');
}
const id = 'utf8-bytes';
---

<Figure
  id={id}
  title={ru ? 'Строка как кодовые точки и как байты UTF-8' : 'A string as code points and as UTF-8 bytes'}
  caption={ru
    ? 'Строка «naïve €» (␣ — пробел). Для Python это семь кодовых точек Юникода (1–2), и индексы, положительные и отрицательные, считают именно их (3). При кодировании в UTF-8 каждая кодовая точка становится одним, двумя или тремя байтами: ASCII-символы — одним, ï (U+00EF) — двумя, € (U+20AC) — тремя (4); эмодзи заняли бы четыре. Поэтому длина строки и длина её байтов различаются: 7 и 10 (5). В узкой версии кодовые точки записаны без префикса U+.'
    : 'The string "naïve €" (␣ is the space). To Python it is seven Unicode code points (1–2), and indices, positive and negative, count those (3). Encoded as UTF-8, each code point becomes one, two or three bytes: ASCII characters one, ï (U+00EF) two, € (U+20AC) three (4); an emoji would take four. So the length of the string and the length of its bytes differ: 7 and 10 (5). The narrow version writes code points without the U+ prefix.'}
>
  {layouts.map((L) => {
    const cx = (i: number) => L.x0 + i * L.cw;
    const bx = (j: number) => L.x0 + j * L.bw;
    const n = chars.length;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Кодовые точки и байты строки naïve €' : 'The code points and bytes of the string naïve €'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Верхний ряд: семь ячеек с символами n, a, ï, v, e, пробелом и €, их кодовыми точками и индексами от 0 до 6 и от −7 до −1. Нижний ряд: десять байтов 6E 61 C3 AF 76 65 20 E2 82 AC; трапеции связывают каждый символ с его байтами.'
          : 'Top row: seven cells with the characters n, a, ï, v, e, space and €, their code points, and indices 0 to 6 and −7 to −1. Bottom row: ten bytes 6E 61 C3 AF 76 65 20 E2 82 AC; trapezoids connect each character to its bytes.'}</desc>
        <text class="f-small f-t-muted" x={L.x0} y={Y.top} style="font-weight: 650">{t.top}</text>
        <g data-s="1">
          {chars.map((c, i) => (
            <g>
              <rect x={cx(i)} y={Y.cell} width={L.cw} height={Y.ch} style={`fill: ${toneVar.x}; fill-opacity: 0.14; stroke: ${toneVar.x}; stroke-width: 1.2`} />
              <text class="f-label" x={cx(i) + L.cw / 2} y={Y.cell + 22} text-anchor="middle">{glyph(c)}</text>
            </g>
          ))}
          <Badge x={L.badgeX} y={Y.cell + 14} n={1} />
        </g>
        <g data-s="2">
          {cps.map((v, i) => (
            <text class="f-small f-t-muted" x={cx(i) + L.cw / 2} y={Y.cell + 43} text-anchor="middle" style="font-family: var(--mono)">{(L.prefix ? 'U+' : '') + hex(v, 4)}</text>
          ))}
          <Badge x={L.badgeX} y={Y.cell + 38} n={2} />
        </g>
        <g data-s="3">
          {chars.map((_, i) => (
            <g>
              <text class="f-small f-t-blue" x={cx(i) + L.cw / 2} y={Y.pos} text-anchor="middle">{i}</text>
              <text class="f-small f-t-blue" x={cx(i) + L.cw / 2} y={Y.neg} text-anchor="middle">{`−${n - i}`}</text>
            </g>
          ))}
          <Badge x={L.badgeX} y={Y.neg - 5} n={3} />
        </g>
        <g data-s="4">
          {bytesOf.map((bs, i) => (
            <path d={`M ${cx(i) + 2} ${Y.trap} L ${cx(i) + L.cw - 2} ${Y.trap} L ${bx(start[i] + bs.length) - 2} ${Y.bytes - 4} L ${bx(start[i]) + 2} ${Y.bytes - 4} Z`} style={`fill: ${toneVar.g}; fill-opacity: ${bs.length > 1 ? 0.22 : 0.1}; stroke: ${toneVar.g}; stroke-width: 1`} />
          ))}
          {allBytes.map((b, j) => (
            <g>
              <rect x={bx(j)} y={Y.bytes} width={L.bw} height={Y.bh} style={`fill: ${toneVar.h}; fill-opacity: 0.14; stroke: ${toneVar.h}; stroke-width: 1.2`} />
              <text class="f-small" x={bx(j) + L.bw / 2} y={Y.bytes + 22} text-anchor="middle" style="font-family: var(--mono)">{hex(b, 2)}</text>
            </g>
          ))}
          <text class="f-small f-t-muted" x={L.x0} y={Y.bottom} style="font-weight: 650">{t.bottom}</text>
          <Badge x={L.badgeX} y={Y.bytes + 17} n={4} />
        </g>
        <g data-s="5">
          <text class="f-small" x={L.x0} y={Y.sum} style={L.prefix ? 'font-family: var(--mono)' : ''}>{L.prefix ? t.sum : t.short}</text>
          <Badge x={L.badgeX} y={Y.sum - 5} n={5} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
