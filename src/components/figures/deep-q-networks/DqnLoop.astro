---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The DQN training loop with the hyperparameters of the Atari agent (Mnih et al., 2015, Extended Data Table 1):
// replay memory of 10^6 transitions, minibatches of 32, target network copied every 10^4 updates, ε from 1 to 0.1.
const atari = { N: '10⁶', B: 32, C: '10 000', eps: '1 → 0.1' };
if (atari.B !== 32) throw new Error('DqnLoop: minibatch size changed');

const t = ru
  ? {
      title: 'Цикл обучения DQN',
      env: 'среда', envSub: 'CartPole, игра Atari', act: 'ε-жадное действие', actSub: 'жадно по Q или случайно',
      tr: '(s, a, r, s′)', buf: 'буфер воспроизведения D', bufSub: `последние N = ${atari.N} переходов`,
      mb: 'мини-батч', mbSub: `B = ${atari.B}, равномерно`,
      tgt: 'целевая сеть Q_{θ⁻}', tgtSub: 'замороженная копия θ', y: 'y = r + γ max Q_{θ⁻}(s′, ·)', ySub: '0 после терминального состояния',
      loss: 'потери Хьюбера: Q_θ(s, a) − y', lossSub: 'градиентный шаг только по θ', on: 'основная сеть Q_θ', onSub: 'даёт Q(s, a) и выбирает действия',
      sync: 'θ⁻ ← θ', grad: '∇θ',
      atari: ['Atari (Mnih и др., 2015):', 'вход: 4 кадра 84 × 84 пикселя', '3 свёрточных слоя + 512 нейронов → до 18 Q', `C = ${atari.C} обновлений; ε: ${atari.eps}`],
      steps: ['действие: агент выбирает a ε-жадно по Q_θ, среда возвращает r и s′', 'запись: переход (s, a, r, s′) кладётся в буфер, самый старый вытесняется', 'выборка: из буфера берётся случайный мини-батч переходов', 'цель: целевая сеть оценивает s′, и y = r + γ max Q_θ⁻(s′, ·)', 'шаг: функция потерь сравнивает Q_θ(s, a) с y, градиент меняет только θ', 'синхронизация: каждые C шагов θ копируется в θ⁻'],
      desc: 'Слева среда и ε-жадный выбор действия. Переходы (s, a, r, s′) идут в буфер воспроизведения, из которого берётся случайный мини-батч. Справа сверху вниз: целевая сеть с замороженными весами θ⁻ оценивает s′ и даёт цель y; функция потерь Хьюбера сравнивает её с Q_θ(s, a) основной сети; градиент меняет только θ; каждые C шагов θ копируется в θ⁻. Внизу слева параметры агента для Atari.',
    }
  : {
      title: 'The DQN training loop',
      env: 'environment', envSub: 'CartPole, an Atari game', act: 'act ε-greedily', actSub: 'greedy in Q, or random',
      tr: '(s, a, r, s′)', buf: 'replay buffer D', bufSub: `last N = ${atari.N} transitions`,
      mb: 'minibatch', mbSub: `B = ${atari.B}, drawn uniformly`,
      tgt: 'target network Q_{θ⁻}', tgtSub: 'a frozen copy of θ', y: 'y = r + γ max Q_{θ⁻}(s′, ·)', ySub: '0 after a terminal state',
      loss: 'Huber loss of Q_θ(s, a) − y', lossSub: 'gradient step on θ only', on: 'online network Q_θ', onSub: 'gives Q(s, a) and chooses actions',
      sync: 'θ⁻ ← θ', grad: '∇θ',
      atari: ['Atari (Mnih et al., 2015):', 'input: 4 frames of 84 × 84 pixels', '3 conv layers + 512 units → up to 18 Q-values', `C = ${atari.C} updates; ε: ${atari.eps}`],
      steps: ['act: the agent picks a ε-greedily from Q_θ; the environment returns r and s′', 'store: the transition (s, a, r, s′) goes into the buffer, the oldest one drops out', 'sample: a random minibatch of transitions is drawn from the buffer', 'target: the target network evaluates s′, and y = r + γ max Q_θ⁻(s′, ·)', 'step: the loss compares Q_θ(s, a) with y, and the gradient changes θ only', 'sync: every C steps θ is copied into θ⁻'],
      desc: 'On the left, the environment and the ε-greedy choice of action. Transitions (s, a, r, s′) go into the replay buffer, from which a random minibatch is drawn. On the right, from top to bottom: the target network with frozen weights θ⁻ evaluates s′ and gives the target y; a Huber loss compares it with the online network\'s Q_θ(s, a); the gradient changes only θ; every C steps θ is copied into θ⁻. Bottom left, the settings of the Atari agent.',
    };
const id = 'dqn-loop';
const caption = ru
  ? 'Два приёма DQN выделены цветом: буфер воспроизведения (зелёный) разрывает корреляцию между соседними переходами и позволяет использовать каждый переход много раз; целевая сеть (жёлтая) держит цель y неподвижной между синхронизациями, так что каждый отрезок обучения — обычная регрессия. Без них Q-обучение с нейросетью гонится за целью, которая сдвигается с каждым шагом.'
  : 'The two devices of DQN are coloured: the replay buffer (green) breaks the correlation between consecutive transitions and lets each transition be used many times; the target network (amber) holds the target y still between synchronizations, so that each stretch of training is an ordinary regression. Without them, Q-learning with a network chases a target that moves with every step.';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 350" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <Box x={16} y={40} w={170} h={50} label={t.env} sub={t.envSub} />
    <g data-s="1">
      <Box x={16} y={150} w={170} h={50} label={t.act} sub={t.actSub} tone="y" />
      <Arrow pts={[[101, 148], [101, 92]]} tone="red" />
      <Badge x={120} y={120} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[186, 65], [226, 65]]} tone="green" />
      <text class="f-small f-t-green" x="206" y="30" text-anchor="middle">{t.tr}</text>
      <Box x={228} y={40} w={190} h={50} label={t.buf} sub={t.bufSub} tone="x" />
      <Badge x={418} y={40} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[323, 90], [323, 148]]} tone="green" />
      <Box x={228} y={150} w={190} h={50} label={t.mb} sub={t.mbSub} tone="x" />
      <Badge x={342} y={120} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[418, 165], [446, 165], [446, 65], [468, 65]]} tone="green" label="s′" at={[452, 110]} labelTone="x" />
      <Box x={470} y={40} w={230} h={50} label={t.tgt} sub={t.tgtSub} tone="g" />
      <Arrow pts={[[585, 90], [585, 118]]} />
      <Box x={470} y={120} w={230} h={50} label={t.y} sub={t.ySub} tone="y" math={false} />
      <Badge x={700} y={120} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[418, 185], [446, 185], [446, 305], [468, 305]]} tone="green" label="s, a" at={[440, 250]} anchor="end" labelTone="x" />
      <Arrow pts={[[585, 170], [585, 198]]} />
      <Box x={470} y={200} w={230} h={50} label={t.loss} sub={t.lossSub} />
      <Box x={470} y={280} w={230} h={50} label={t.on} sub={t.onSub} tone="h" />
      <Arrow pts={[[540, 280], [540, 252]]} tone="blue" />
      <Arrow pts={[[630, 252], [630, 278]]} tone="red" dashed label={t.grad} at={[637, 270]} labelTone="y" />
      <Badge x={700} y={200} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[700, 315], [716, 315], [716, 65], [702, 65]]} tone="amber" dashed />
      <text class="f-small f-t-amber" x="720" y="190">{t.sync}</text>
      <Badge x={716} y={230} n={6} />
    </g>
    {t.atari.map((line, i) => <text class={i === 0 ? 'f-small' : 'f-small f-t-muted'} x="16" y={250 + i * 22} style={i === 0 ? 'font-weight: 600' : ''}>{line}</text>)}
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 580" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <Box x={16} y={16} w={156} h={50} label={t.env} sub={ru ? 'CartPole, Atari' : 'CartPole, Atari'} />
    <g data-s="1">
      <Box x={188} y={16} w={156} h={50} label={ru ? 'ε-жадно' : 'act ε-greedily'} sub={ru ? 'жадно по Q' : 'greedy in Q'} tone="y" />
      <Arrow pts={[[188, 41], [174, 41]]} tone="red" />
      <Badge x={181} y={80} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[94, 66], [94, 98]]} tone="green" />
      <text class="f-small f-t-green" x="104" y="88">{t.tr}</text>
      <Box x={16} y={100} w={328} h={50} label={t.buf} sub={t.bufSub} tone="x" />
      <Badge x={344} y={100} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[94, 150], [94, 178]]} tone="green" />
      <Box x={16} y={180} w={328} h={50} label={t.mb} sub={t.mbSub} tone="x" />
      <Badge x={344} y={180} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[94, 230], [94, 268]]} tone="green" label="s′" at={[102, 254]} labelTone="x" />
      <Box x={16} y={270} w={250} h={50} label={ru ? 'целевая сеть Q_{θ⁻}' : 'target network Q_{θ⁻}'} sub={t.tgtSub} tone="g" />
      <Arrow pts={[[141, 320], [141, 348]]} />
      <Box x={16} y={350} w={250} h={50} label={ru ? 'цель y' : 'target y'} sub={ru ? 'r + γ max по a′ от Q⁻(s′, a′)' : 'r + γ max over a′ of Q⁻(s′, a′)'} tone="y" />
      <Badge x={16} y={270} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[141, 400], [141, 428]]} />
      <Box x={16} y={430} w={250} h={50} label={ru ? 'функция потерь Хьюбера' : 'Huber loss'} sub={ru ? 'Q(s, a) − y, шаг по θ' : 'Q(s, a) − y, step on θ'} />
      <Box x={16} y={510} w={250} h={50} label={ru ? 'основная сеть Q_θ' : 'online network Q_θ'} sub={ru ? 'даёт Q(s, a)' : 'gives Q(s, a)'} tone="h" />
      <Arrow pts={[[80, 510], [80, 482]]} tone="blue" />
      <Arrow pts={[[200, 482], [200, 508]]} tone="red" dashed />
      <Arrow pts={[[330, 230], [330, 545], [268, 545]]} tone="green" label="s, a" at={[324, 262]} anchor="end" labelTone="x" />
      <Badge x={16} y={430} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[266, 522], [292, 522], [292, 295], [268, 295]]} tone="amber" dashed />
      <text class="f-small f-t-amber f-halo" x="286" y="420" text-anchor="end">{t.sync}</text>
      <Badge x={292} y={330} n={6} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
