---
import Figure from '../Figure.astro';
import Curves from '../temporal-difference-learning/Curves.astro';
import { scale } from '../geometry';
import { bins, mean } from '../temporal-difference-learning/td';
import { maxBias } from './dqn';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// From A, "right" ends with reward 0 and "left" goes to B with reward 0; B has 10 actions, each ending with a reward
// from N(-0.1, 1). Left is worse by 0.1. ε = 0.1, α = 0.1, γ = 1; 2000 runs of 300 episodes.
const q = maxBias('q'), dbl = maxBias('double');
const peakQ = Math.max(...q), at = q.indexOf(peakQ);
const chk = [mean(q, 0, 100), mean(dbl, 0, 100), mean(q, 290, 300), mean(dbl, 290, 300), peakQ].map((v) => v.toFixed(2)).join(' ') + ` ${at + 1}`;
if (chk !== '0.75 0.19 0.11 0.08 0.95 22') throw new Error(`MaxBias: numbers drifted from the note (${chk})`);

const t = ru
  ? { title: 'Смещение максимума: Q-обучение против двойного Q-обучения', x: 'эпизоды', y: 'доля эпизодов, где из A выбран путь влево',
      q: 'Q-обучение', d: 'двойное Q-обучение', opt: 'оптимум при ε = 0.1: 0.05',
      desc: `Две кривые доли эпизодов, в которых агент из A пошёл влево, за 300 эпизодов. Q-обучение быстро поднимается почти до 0.95 к ${at + 1}-му эпизоду и медленно спускается до 0.11. Двойное Q-обучение начинает с 0.5 и быстро опускается к 0.08. Пунктир — 0.05, доля левых действий у оптимальной ε-жадной стратегии.` }
  : { title: 'Maximization bias: Q-learning against Double Q-learning', x: 'episodes', y: 'fraction of episodes that go left from A',
      q: 'Q-learning', d: 'Double Q-learning', opt: 'optimal with ε = 0.1: 0.05',
      desc: `Two curves of the fraction of episodes in which the agent went left from A, over 300 episodes. Q-learning climbs to almost 0.95 by episode ${at + 1} and only slowly comes down to 0.11. Double Q-learning starts at 0.5 and drops quickly towards 0.08. The dashed line is 0.05, the fraction of left actions of the optimal ε-greedy policy.` };
const id = 'dqn-max-bias';
const caption = ru
  ? `Из A действие «вправо» сразу заканчивает эпизод с наградой 0, «влево» ведёт в B с наградой 0; в B десять действий, каждое заканчивает эпизод с наградой из N(−0.1, 1), так что влево хуже на 0.1. ε = 0.1, α = 0.1, γ = 1, среднее по 2000 запускам, сглажено по окнам из 5 эпизодов. Q-обучение оценивает A–влево через максимум десяти шумных оценок в B, который в начале почти всегда положителен; за первые 100 эпизодов оно уходит влево в ${(100 * mean(q, 0, 100)).toFixed(0)}% эпизодов. Двойное Q-обучение выбирает действие в B по одной таблице, а оценивает по другой, и уходит влево в ${(100 * mean(dbl, 0, 100)).toFixed(0)}%.`
  : `From A, "right" ends the episode with reward 0 and "left" leads to B with reward 0; B has ten actions, each ending the episode with a reward drawn from N(−0.1, 1), so left is worse by 0.1. ε = 0.1, α = 0.1, γ = 1, averaged over 2000 runs and smoothed over windows of 5 episodes. Q-learning values A–left through the maximum of ten noisy estimates in B, which at first is almost always positive; over the first 100 episodes it goes left in ${(100 * mean(q, 0, 100)).toFixed(0)}% of them. Double Q-learning chooses the action in B with one table and evaluates it with the other, and goes left in ${(100 * mean(dbl, 0, 100)).toFixed(0)}%.`;

const cq = bins(q, 5), cd = bins(dbl, 5);
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [70, 600] as [number, number], py: [40, 270] as [number, number], legend: false },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 400, px: [52, 344] as [number, number], py: [44, 270] as [number, number], legend: true },
];
const dy: [number, number] = [0, 1];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sy = scale(dy, [L.py[1], L.py[0]]), sx = scale([0, 300], L.px);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        <Curves px={L.px} py={L.py} dx={[0, 300]} dy={dy} xTicks={[0, 100, 200, 300]} yTicks={[0, 0.25, 0.5, 0.75, 1]}
          yFmt={(v: number) => v.toFixed(2)} xLabel={t.x} yLabel={t.y}
          series={[{ xs: cq.xs, ys: cq.ys, cls: 'f-line f-red' }, { xs: cd.xs, ys: cd.ys, cls: 'f-line f-blue' }]} />
        <path class="f-line f-muted f-dash" d={`M ${L.px[0]} ${sy(0.05)} H ${L.px[1]}`} style="stroke-width: 1.1" />
        <text class="f-small f-t-muted f-halo" x={L.px[1] - 4} y={sy(0.05) - 6} text-anchor="end">{t.opt}</text>
        {!L.legend && <text class="f-small f-t-red f-halo" x={sx(60)} y={sy(0.88)}>{t.q}</text>}
        {!L.legend && <text class="f-small f-t-blue f-halo" x={sx(40)} y={sy(0.3)}>{t.d}</text>}
        {L.legend && (
          <g>
            <path class="f-line f-red" d="M 16 333 h 24" />
            <text class="f-small f-t-red" x="48" y="338">{t.q}</text>
            <path class="f-line f-blue" d="M 16 359 h 24" />
            <text class="f-small f-t-blue" x="48" y="364">{t.d}</text>
          </g>
        )}
      </svg>
    );
  })}
</Figure>
