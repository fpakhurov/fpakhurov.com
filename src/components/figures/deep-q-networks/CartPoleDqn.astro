---
import Figure from '../Figure.astro';
import Curves from '../temporal-difference-learning/Curves.astro';
import { scale } from '../geometry';
import { spread } from '../temporal-difference-learning/td';
import { cartpoleCurves, cartpoleSummary } from './cartpole-data';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Data: the Code section of the note (CartPole, 20,000 steps, two seeds per variant). Each point is the mean return of
// the episodes that ended in a block of 1000 steps, averaged over the two seeds.
const names = ['neither', 'replay only', 'target only', 'DQN', 'Double DQN'];
const avg = (k: string) => cartpoleCurves[k][0].map((v, i) => (v + cartpoleCurves[k][1][i]) / 2);
const curves = Object.fromEntries(names.map((k) => [k, avg(k)]));
const late = (k: string) => curves[k].slice(10).reduce((s, v) => s + v, 0) / 10;
const chk = names.map((k) => late(k).toFixed(0)).join(' ') + ' | ' + names.map((k) => cartpoleSummary[k][1].toFixed(1)).join(' ');
if (chk !== '10 10 14 154 162 | 10.4 10.3 14.1 94.0 106.7') throw new Error(`CartPoleDqn: numbers drifted from the note (${chk})`);
if (!(cartpoleSummary['neither'][3] > 1e6 && cartpoleSummary['replay only'][3] > 1e6 && cartpoleSummary['DQN'][3] < 100)) throw new Error('CartPoleDqn: divergence pattern changed');

const cls: Record<string, string> = { neither: 'f-line f-muted f-dash', 'replay only': 'f-line f-red f-dash', 'target only': 'f-line f-amber', DQN: 'f-line f-blue f-bold', 'Double DQN': 'f-line f-green' };
const tcls: Record<string, string> = { neither: 'f-t-muted', 'replay only': 'f-t-red', 'target only': 'f-t-amber', DQN: 'f-t-blue', 'Double DQN': 'f-t-green' };
const lab: Record<string, string> = ru
  ? { neither: 'без обоих приёмов', 'replay only': 'только буфер', 'target only': 'только целевая сеть', DQN: 'DQN: оба', 'Double DQN': 'двойная DQN' }
  : { neither: 'neither', 'replay only': 'replay only', 'target only': 'target network only', DQN: 'DQN: both', 'Double DQN': 'Double DQN' };
const t = ru
  ? { title: 'Буфер воспроизведения и целевая сеть на CartPole', x: 'шаги среды, тысячи', y: 'средняя отдача эпизода',
      desc: `Пять кривых средней отдачи эпизода за 20 000 шагов. Без целевой сети, с буфером или без него, отдача падает до 10: Q-значения расходятся до миллионов. Только с целевой сетью отдача колеблется между 10 и 30. DQN и двойная DQN поднимаются до 150–200 к 5000 шагам и держатся там; за последние 10 000 шагов в среднем ${late('DQN').toFixed(0)} и ${late('Double DQN').toFixed(0)}.` }
  : { title: 'Replay and the target network on CartPole', x: 'environment steps, thousands', y: 'mean episode return',
      desc: `Five curves of the mean episode return over 20,000 steps. Without a target network, with or without replay, the return falls to 10: the Q-values diverge to millions. With the target network alone it wanders between 10 and 30. DQN and Double DQN climb to 150–200 by 5000 steps and stay there, averaging ${late('DQN').toFixed(0)} and ${late('Double DQN').toFixed(0)} over the last 10,000 steps.` };
const id = 'dqn-cartpole';
const caption = ru
  ? `Код в конце заметки: CartPole, сеть 4–64–64–2, ε-жадное поведение с ε от 1 до 0.05 за первые 5000 шагов, по два запуска на вариант. Точка — средняя отдача эпизодов, закончившихся в блоке из 1000 шагов. Эпизод длится не больше 500 шагов, а ε = 0.05 в конце обучения роняет шест раньше, чем жадная стратегия. Без целевой сети наибольшее |Q| за обучение — ${cartpoleSummary['neither'][3].toExponential(1)} и ${cartpoleSummary['replay only'][3].toExponential(1)}, хотя истинные значения не превышают 1/(1 − γ) = 100. Два запуска на вариант — мало, чтобы различить DQN и двойную DQN.`
  : `The Code section of the note: CartPole, a 4–64–64–2 network, ε-greedy behaviour with ε going from 1 to 0.05 over the first 5000 steps, two runs per variant. Each point is the mean return of the episodes that ended in a block of 1000 steps. Episodes last at most 500 steps, and ε = 0.05 at the end of training drops the pole sooner than the greedy policy would. Without a target network the largest |Q| seen in training is ${cartpoleSummary['neither'][3].toExponential(1)} and ${cartpoleSummary['replay only'][3].toExponential(1)}, although the true values cannot exceed 1/(1 − γ) = 100. Two runs per variant are too few to tell DQN and Double DQN apart.`;

const xs = Array.from({ length: 20 }, (_, i) => i + 0.5);
const order = ['DQN', 'Double DQN', 'target only', 'replay only', 'neither'];
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [70, 590] as [number, number], py: [40, 270] as [number, number], legend: false },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 440, px: [52, 344] as [number, number], py: [44, 270] as [number, number], legend: true },
];
const dy: [number, number] = [0, 250];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sy = scale(dy, [L.py[1], L.py[0]]);
    const ends = spread(order.map((k) => sy(curves[k][19])), 16);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        <Curves px={L.px} py={L.py} dx={[0, 20]} dy={dy} xTicks={[0, 5, 10, 15, 20]} yTicks={[0, 50, 100, 150, 200, 250]}
          xLabel={t.x} yLabel={t.y} series={order.map((k) => ({ xs, ys: curves[k], cls: cls[k] }))} />
        {!L.legend && order.map((k, i) => <text class={`f-small ${tcls[k]}`} x={L.px[1] + 8} y={ends[i] + 4}>{lab[k]}</text>)}
        {L.legend && order.map((k, i) => (
          <g>
            <path class={cls[k]} d={`M ${16 + (i % 2) * 172} ${338 + Math.floor(i / 2) * 26 - 5} h 24`} />
            <text class={`f-small ${tcls[k]}`} x={48 + (i % 2) * 172} y={338 + Math.floor(i / 2) * 26}>{lab[k]}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
