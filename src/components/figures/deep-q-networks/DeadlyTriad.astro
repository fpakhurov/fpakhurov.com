---
import Figure from '../Figure.astro';
import Curves from '../temporal-difference-learning/Curves.astro';
import { scale } from '../geometry';
import { spread } from '../temporal-difference-learning/td';
import { triad } from './dqn';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The two-state example of the note: features 1 and 2, one weight w, transition 1 -> 2 with reward 0, γ = 0.9,
// α = 0.1, w = 1 at the start; all true values are 0. Estimate of state 1 after each update, on a log scale.
const tr = triad(60);
const keys = ['offTd', 'tabular', 'offMc', 'onTd'] as const;
const chk = [tr.offTd[1], tr.offTd[60], tr.tabular[60], tr.offMc[60], tr.onTd[2]].map((v) => v.toPrecision(3)).join(' ');
if (chk !== '1.08 101 1.80 0.00180 0.648') throw new Error(`DeadlyTriad: numbers drifted from the note (${chk})`);

const floor = -3, ceil = 3;
const lg = (v: number) => Math.max(floor, Math.min(ceil, Math.log10(Math.abs(v))));
const cls = { offTd: 'f-line f-red f-bold', tabular: 'f-line f-amber', offMc: 'f-line f-green', onTd: 'f-line f-blue' };
const tcls = { offTd: 'f-t-red', tabular: 'f-t-amber', offMc: 'f-t-green', onTd: 'f-t-blue' };
const t = ru
  ? { title: 'Смертельная триада на двух состояниях', x: 'число обновлений', y: 'оценка состояния 1 (лог. шкала)',
      names: { offTd: 'все три: расходится', tabular: 'без аппроксимации: таблица', offMc: 'без бутстрэппинга: Монте-Карло', onTd: 'по текущей стратегии: как в эпизодах' },
      desc: 'Оценка первого состояния за 60 обновлений в логарифмической шкале. Полуградиентный TD с признаками 1 и 2, обновляющий только переход из первого состояния, растёт в 1.08 раза за обновление и доходит до 101. Если обновлять оба состояния так, как их посещают эпизоды, оценка падает к нулю. С целью Монте-Карло она падает как 0.9 в степени числа обновлений. С отдельными значениями для каждого состояния она выходит на 1.8.' }
  : { title: 'The deadly triad on two states', x: 'updates', y: 'estimate of state 1 (log scale)',
      names: { offTd: 'all three: diverges', tabular: 'no approximation: a table', offMc: 'no bootstrapping: Monte Carlo', onTd: 'not off-policy: updates follow episodes' },
      desc: 'The estimate of the first state over 60 updates, on a log scale. Semi-gradient TD with features 1 and 2 that updates only the transition out of the first state grows by a factor 1.08 per update and reaches 101. Updating both states as the episodes visit them sends the estimate to zero. With the Monte Carlo target it falls like 0.9 to the power of the number of updates. With a separate value for each state it levels off at 1.8.' };
const id = 'dqn-deadly-triad';
const caption = ru
  ? 'Признак состояния 1 равен 1, состояния 2 — 2, линейная оценка с одним весом w даёт v(1) = w и v(2) = 2w; переход 1 → 2 с наградой 0, затем конец эпизода, все истинные ценности 0; γ = 0.9, α = 0.1, w = 1 в начале. Красная кривая сочетает все три составляющие триады и умножается на 1 + α(2γ − 1) = 1.08 за обновление. Каждая из трёх других убирает одну составляющую и сходится: обновления по эпизодам (на графике обрезаны снизу на 0.001), цель Монте-Карло без бутстрэппинга, таблица без общих признаков (она сходится к γ · 2 = 1.8, потому что состояние 2 никогда не обновляется).'
  : 'State 1 has feature 1 and state 2 feature 2, so a linear estimate with one weight w gives v(1) = w and v(2) = 2w; the transition 1 → 2 has reward 0 and then the episode ends, so every true value is 0; γ = 0.9, α = 0.1, w = 1 at the start. The red curve combines all three legs of the triad and is multiplied by 1 + α(2γ − 1) = 1.08 per update. Each of the other three removes one leg and converges: updates that follow the episodes (clipped at 0.001 in the plot), a Monte Carlo target without bootstrapping, and a table without shared features (it converges to γ · 2 = 1.8 because state 2 is never updated).';

const xs = Array.from({ length: 61 }, (_, i) => i);
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [70, 470] as [number, number], py: [40, 270] as [number, number], legend: false },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 450, px: [56, 344] as [number, number], py: [44, 270] as [number, number], legend: true },
];
const dy: [number, number] = [floor, ceil];
const yFmt = (v: number) => ['0.001', '0.01', '0.1', '1', '10', '100', '1000'][v + 3];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sy = scale(dy, [L.py[1], L.py[0]]);
    const ends = spread(keys.map((k) => sy(lg(tr[k][60]))), 17);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        <Curves px={L.px} py={L.py} dx={[0, 60]} dy={dy} xTicks={[0, 20, 40, 60]} yTicks={[-3, -2, -1, 0, 1, 2, 3]}
          yFmt={yFmt} xLabel={t.x} yLabel={t.y} yLabelAt={[L.px[0] - 48, L.py[0] - 20]}
          series={keys.map((k) => ({ xs, ys: tr[k].map(lg), cls: cls[k] }))} />
        {!L.legend && keys.map((k, i) => <text class={`f-small ${tcls[k]}`} x={L.px[1] + 8} y={ends[i] + 4}>{t.names[k]}</text>)}
        {L.legend && keys.map((k, i) => (
          <g>
            <path class={cls[k]} d={`M 16 ${338 + i * 26 - 5} h 24`} />
            <text class={`f-small ${tcls[k]}`} x={48} y={338 + i * 26}>{t.names[k]}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
