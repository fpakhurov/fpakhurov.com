---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// RoPE on one pair of coordinates with a toy frequency of 30° per position. q = (1, 0) and k = (0.8, 0.6) are rotated
// by m·ω and n·ω. The score of the rotated pair is cos(angle between them) = cos(36.87° + 30°·(n − m)), so it depends
// on the offset n − m only. Three panels: (m, n) = (0, 1), (3, 4) and (3, 5).
const w = Math.PI / 6;
const q: [number, number] = [1, 0];
const k: [number, number] = [0.8, 0.6];
const rot = ([a, b]: [number, number], t: number): [number, number] => [a * Math.cos(t) - b * Math.sin(t), a * Math.sin(t) + b * Math.cos(t)];
const dot = (a: [number, number], b: [number, number]) => a[0] * b[0] + a[1] * b[1];
const deg = (t: number) => (t * 180) / Math.PI;
const cases = [[0, 1], [3, 4], [3, 5]].map(([m, n]) => {
  const qm = rot(q, m * w), kn = rot(k, n * w);
  const aq = Math.atan2(qm[1], qm[0]), ak = Math.atan2(kn[1], kn[0]);
  let gap = ak - aq;
  while (gap <= 0) gap += 2 * Math.PI;
  return { m, n, qm, kn, aq, gap, score: dot(qm, kn) };
});
const s3 = (v: number) => (v < 0 ? '−' : '') + Math.abs(v).toFixed(3);
const scores = cases.map((c) => s3(c.score));
if (scores.join() !== '0.393,0.393,−0.120') throw new Error('RopeRotation: scores drifted ' + scores.join());
const gaps = cases.map((c) => deg(c.gap).toFixed(2));
if (gaps.join() !== '66.87,66.87,96.87') throw new Error('RopeRotation: angles drifted ' + gaps.join());
if (Math.abs(dot(q, k) - 0.8) > 1e-12) throw new Error('RopeRotation: unrotated score drifted');

const t = ru
  ? { off: 'n − m', angle: 'угол', score: 'оценка' }
  : { off: 'n − m', angle: 'angle', score: 'score' };
const id = 'rope-rotation';
interface Panel { cx: number; cy: number }
interface Layout { sfx: string; cls: string; W: number; H: number; r: number; panels: Panel[]; titleDy: number; footDy: number; lineH: number }
const layouts: Layout[] = [
  { sfx: 'w', cls: 'fig-wide fig-bp-640', W: 760, H: 318, r: 82, panels: [{ cx: 127, cy: 140 }, { cx: 380, cy: 140 }, { cx: 633, cy: 140 }], titleDy: -114, footDy: 122, lineH: 19 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow fig-bp-640', W: 360, H: 494, r: 58, panels: [{ cx: 90, cy: 104 }, { cx: 270, cy: 104 }, { cx: 180, cy: 352 }], titleDy: -88, footDy: 96, lineH: 19 },
];
// Screen coordinates: y grows downwards, so a counter-clockwise angle a maps to (cos a, −sin a).
const at = (P: Panel, rad: number, a: number): [number, number] => [P.cx + rad * Math.cos(a), P.cy - rad * Math.sin(a)];
const arc = (P: Panel, rad: number, a0: number, a1: number) => {
  const [x0, y0] = at(P, rad, a0), [x1, y1] = at(P, rad, a1);
  const large = a1 - a0 > Math.PI ? 1 : 0;
  return `M ${x0.toFixed(1)} ${y0.toFixed(1)} A ${rad} ${rad} 0 ${large} 0 ${x1.toFixed(1)} ${y1.toFixed(1)}`;
};
const seg = (P: Panel, rad: number, a: number) => {
  const [x, y] = at(P, rad - 2, a);
  return `M ${P.cx} ${P.cy} L ${x.toFixed(1)} ${y.toFixed(1)}`;
};
const caption = ru
  ? `Одна пара координат запроса и ключа, игрушечная частота ω = 30° на позицию. До поворота (пунктир) q = (1, 0) и k = (0.8, 0.6), угол между ними 36.87°, скалярное произведение 0.8. RoPE поворачивает запрос в позиции m на угол mω, а ключ в позиции n — на угол nω. Слева и в середине позиции разные, (0, 1) и (3, 4), но сдвиг один и тот же, n − m = 1: оба вектора повёрнуты на разные углы, а угол между ними одинаков, 66.87°, и оценка одна и та же, ${scores[0]}. Справа сдвиг 2: угол 96.87°, оценка ${scores[2]}. Оценка равна cos(36.87° + 30° · (n − m)) и зависит только от сдвига.`
  : `One coordinate pair of a query and a key, with a toy frequency ω = 30° per position. Before rotation (dotted) q = (1, 0) and k = (0.8, 0.6), 36.87° apart, with dot product 0.8. RoPE rotates the query at position m by mω and the key at position n by nω. On the left and in the middle the positions differ, (0, 1) and (3, 4), but the offset is the same, n − m = 1: both vectors are turned by different amounts, the angle between them is the same 66.87°, and so is the score, ${scores[0]}. On the right the offset is 2: the angle is 96.87° and the score ${scores[2]}. The score is cos(36.87° + 30° · (n − m)) and depends on the offset only.`;
---

<Figure
  id={id}
  title={ru ? 'RoPE: оценка зависит только от сдвига между позициями' : 'RoPE: the score depends only on the offset between positions'}
  caption={caption}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{ru ? 'Повёрнутые запрос и ключ при трёх парах позиций' : 'Rotated query and key at three pairs of positions'}</title>
      <desc id={`${id}-${L.sfx}-d`}>{ru
        ? 'Три круга. В каждом синяя стрелка — повёрнутый запрос, красная — повёрнутый ключ, пунктирные серые стрелки — те же векторы до поворота, янтарная дуга — угол между повёрнутыми векторами. В первом круге позиции 0 и 1, во втором 3 и 4: стрелки направлены по-разному, но дуга одинакова, 66.87 градуса, и оценка 0.393. В третьем круге позиции 3 и 5: дуга шире, 96.87 градуса, оценка −0.120.'
        : 'Three circles. In each, a blue arrow is the rotated query, a red arrow the rotated key, dotted grey arrows the same vectors before rotation, and an amber arc the angle between the rotated vectors. The first circle has positions 0 and 1, the second 3 and 4: the arrows point in different directions but the arc is the same, 66.87 degrees, and the score is 0.393. The third circle has positions 3 and 5: the arc is wider, 96.87 degrees, and the score is −0.120.'}</desc>
      {cases.map((c, i) => {
        const P = L.panels[i];
        const r = L.r;
        const [qx, qy] = at(P, r + 15, c.aq);
        const [kx, ky] = at(P, r + 15, c.aq + c.gap);
        const lines = [`${t.off} = ${c.n - c.m}`, `${t.angle} ${gaps[i]}°`, `${t.score} ${scores[i]}`];
        return (
          <g>
            <text class="f-title" x={P.cx} y={P.cy + L.titleDy} text-anchor="middle">m = {c.m}, n = {c.n}</text>
            <circle cx={P.cx} cy={P.cy} r={r} class="f-grid" style="fill: none" />
            <path class="f-grid" d={`M ${P.cx - r - 6} ${P.cy} H ${P.cx + r + 6} M ${P.cx} ${P.cy - r - 6} V ${P.cy + r + 6}`} />
            <path class="f-thin f-muted f-dot" d={seg(P, r, 0)} marker-end="url(#f-arrow-muted)" />
            <path class="f-thin f-muted f-dot" d={seg(P, r, Math.atan2(k[1], k[0]))} marker-end="url(#f-arrow-muted)" />
            <path class="f-line f-amber" d={arc(P, r * 0.36, c.aq, c.aq + c.gap)} />
            <path class="f-line f-blue f-bold" d={seg(P, r, c.aq)} marker-end="url(#f-arrow-blue)" />
            <path class="f-line f-red f-bold" d={seg(P, r, c.aq + c.gap)} marker-end="url(#f-arrow-red)" />
            <text class="f-math f-t-blue f-halo" x={qx.toFixed(1)} y={(qy + 6).toFixed(1)} text-anchor="middle">q</text>
            <text class="f-math f-t-red f-halo" x={kx.toFixed(1)} y={(ky + 6).toFixed(1)} text-anchor="middle">k</text>
            {lines.map((s, j) => (
              <text class={j === 2 ? 'f-label' : 'f-small f-t-muted'} x={P.cx} y={P.cy + L.footDy + j * L.lineH} text-anchor="middle" font-weight={j === 2 ? 650 : undefined}>{s}</text>
            ))}
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
