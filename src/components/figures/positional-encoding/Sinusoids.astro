---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Sinusoidal positional encoding, d_model = 16, dimensions 0, 2, 6, 14 (the
// sine components) over positions 0..60. Wavelengths 2π · 10000^(2i/d).
const d = 16;
const dims = [0, 2, 6, 14];
const colors = ['f-blue', 'f-red', 'f-green', 'f-amber'];
const textColors = ['f-t-blue', 'f-t-red', 'f-t-green', 'f-t-amber'];
const maxPos = 60;
const pe = (pos: number, i: number) => Math.sin(pos / 10000 ** (i / d));
const wavelength = (i: number) => 2 * Math.PI * 10000 ** (i / d);

interface Layout { cls: string; w: number; h: number; left: number; right: number; top: number; bottom: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', w: 640, h: 300, left: 50, right: 610, top: 30, bottom: 230 },
  { cls: 'fig-narrow', w: 360, h: 330, left: 40, right: 345, top: 30, bottom: 240 },
];
---

<Figure
  id="sinusoidal-positions"
  title={ru ? 'Синусоидальное позиционное кодирование: четыре из шестнадцати измерений' : 'Sinusoidal positional encoding: four of the sixteen dimensions'}
  caption={ru ? `d = 16. Каждое чётное измерение 2i — это sin(pos / 10000^(2i/d)); соседнее нечётное измерение — косинус с той же частотой. У измерения 0 длина волны 2π ≈ ${wavelength(0).toFixed(1)} позиции, и оно повторяется каждые несколько токенов; у измерения 14 длина волны ${wavelength(14).toFixed(0)} позиций, и на протяжении последовательности оно почти не меняется. Любое отдельное измерение повторяется, так что у двух позиций может совпасть его значение, но никакие две позиции в рабочем диапазоне не совпадают по всему вектору. Вертикальные пунктирные линии отмечают позиции 0, 20 и 40.` : `d = 16. Each even dimension 2i is sin(pos / 10000^(2i/d)); the odd dimension next to it is the cosine with the same frequency. Dimension 0 has wavelength 2π ≈ ${wavelength(0).toFixed(1)} positions and repeats every few tokens; dimension 14 has wavelength ${wavelength(14).toFixed(0)} positions and barely moves over the sequence. Any single dimension repeats, so two positions can share its value, but no two positions in range share the whole vector. Vertical dashed lines mark positions 0, 20 and 40.`}
>
  {layouts.map((L) => {
    const sx = scale([0, maxPos], [L.left, L.right]);
    const sy = scale([-1.15, 1.15], [L.bottom, L.top]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`sinusoidal-positions-${L.w}-t sinusoidal-positions-${L.w}-d`}>
        <title id={`sinusoidal-positions-${L.w}-t`}>{ru ? 'Кривые синусоидального позиционного кодирования' : 'Sinusoidal positional encoding curves'}</title>
        <desc id={`sinusoidal-positions-${L.w}-d`}>{ru ? 'Четыре синусоиды на позициях от 0 до 60. Синяя кривая измерения 0 колеблется быстро, красная для измерения 2 — медленнее, зелёная для измерения 6 проходит около половины периода, а янтарная для измерения 14 растёт почти линейно и остаётся около нуля.' : 'Four sine curves over positions 0 to 60. The blue curve for dimension 0 oscillates rapidly, the red for dimension 2 more slowly, the green for dimension 6 completes about half a cycle, and the amber for dimension 14 rises almost linearly and stays near zero.'}</desc>
        <path class="f-axis" d={`M ${L.left} ${sy(0)} H ${L.right}`} />
        <path class="f-axis" d={`M ${L.left} ${L.top} V ${L.bottom}`} />
        {[0, 20, 40, 60].map((p) => (
          <g>
            <path class="f-grid f-dash" d={`M ${sx(p)} ${L.top} V ${L.bottom}`} />
            <text class="f-small f-t-muted" x={sx(p)} y={L.bottom + 18} text-anchor="middle">{p}</text>
          </g>
        ))}
        <text class="f-small f-t-muted" x={L.left - 8} y={sy(1) + 4} text-anchor="end">1</text>
        <text class="f-small f-t-muted" x={L.left - 8} y={sy(-1) + 4} text-anchor="end">−1</text>
        <text class="f-note" x={(L.left + L.right) / 2} y={L.bottom + 38} text-anchor="middle">{ru ? 'позиция' : 'position'}</text>
        {dims.map((i, k) => (
          <path class={`f-line ${colors[k]}`} d={plot((p) => pe(p, i), 0, maxPos, sx, sy, 600)} />
        ))}
        {dims.map((i, k) => (
          <text class={`f-small ${textColors[k]} f-halo`} x={L.right - (L.cls === 'fig-wide' ? 0 : 4)} y={L.top + 14 + k * 17} text-anchor="end">{ru ? 'изм.' : 'dim'} {i}, λ ≈ {wavelength(i) < 100 ? wavelength(i).toFixed(1) : wavelength(i).toFixed(0)}</text>
        ))}
      </svg>
    );
  })}
</Figure>
