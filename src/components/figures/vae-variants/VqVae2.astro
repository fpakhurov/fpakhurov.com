---
import BlockDiagram, { type DLayout } from '../BlockDiagram.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The two-level VQ-VAE of the notebook on 32×32 CIFAR-10 images, and how a new image is sampled.
const t = ru
  ? { x: 'изображение', xs: '32×32×3', eb: 'нижний энкодер', ebs: '÷4 → 8×8', et: 'верхний энкодер', ets: '÷2 → 4×4', qt: 'квантование верха', qts: 'коды 4×4 из 512', dt: 'верхний декодер', dts: '4×4 → 8×8', qb: 'квантование низа', qbs: 'коды 8×8 из 512', dec: 'декодер', decs: 'верх ↑ + низ', xh: 'восстановление', xhs: '32×32×3', p1: 'PixelCNN (верх)', p1s: '16 кодов по одному', p2: 'условный PixelCNN', p2s: '64 нижних кода', g3: 'декодер', g3s: 'новое изображение', train: 'обучение', gen: 'генерация' }
  : { x: 'image', xs: '32×32×3', eb: 'bottom encoder', ebs: '÷4 → 8×8', et: 'top encoder', ets: '÷2 → 4×4', qt: 'quantize top', qts: '4×4 codes of 512', dt: 'top decoder', dts: '4×4 → 8×8', qb: 'quantize bottom', qbs: '8×8 codes of 512', dec: 'decoder', decs: 'top ↑ + bottom', xh: 'reconstruction', xhs: '32×32×3', p1: 'PixelCNN (top)', p1s: '16 codes, one by one', p2: 'conditional PixelCNN', p2s: '64 bottom codes', g3: 'decoder', g3s: 'a new image', train: 'training', gen: 'generation' };
const desc = ru
  ? 'Обучение: изображение 32×32 проходит нижний энкодер до карты 8×8, верхний энкодер сжимает её до 4×4, верхняя карта квантуется, раскодируется до 8×8, объединяется с признаками нижнего энкодера и квантуется как нижняя карта; декодер восстанавливает изображение из увеличенных верхних кодов и нижних кодов. Генерация: PixelCNN сэмплирует 16 верхних кодов, условный PixelCNN — 64 нижних, декодер превращает их в изображение.'
  : 'Training: a 32×32 image goes through the bottom encoder to an 8×8 map, the top encoder compresses it to 4×4, the top map is quantized, decoded back to 8×8, combined with the bottom features and quantized as the bottom map; the decoder reconstructs the image from the upsampled top codes and the bottom codes. Generation: a PixelCNN samples 16 top codes, a conditional PixelCNN 64 bottom codes, and the decoder turns them into an image.';
const wide: DLayout = {
  cls: 'fig-wide', w: 720, h: 378, desc,
  nodes: [
    { id: 'x', x: 8, y: 34, w: 108, h: 52, label: t.x, sub: t.xs, tone: 'soft' },
    { id: 'eb', x: 130, y: 34, w: 146, h: 52, label: t.eb, sub: t.ebs, tone: 'blue' },
    { id: 'et', x: 290, y: 34, w: 146, h: 52, label: t.et, sub: t.ets, tone: 'blue' },
    { id: 'qt', x: 450, y: 34, w: 146, h: 52, label: t.qt, sub: t.qts, tone: 'amber' },
    { id: 'dt', x: 450, y: 124, w: 146, h: 52, label: t.dt, sub: t.dts, tone: 'blue' },
    { id: 'qb', x: 290, y: 124, w: 146, h: 52, label: t.qb, sub: t.qbs, tone: 'amber' },
    { id: 'dec', x: 290, y: 214, w: 146, h: 52, label: t.dec, sub: t.decs, tone: 'blue' },
    { id: 'xh', x: 130, y: 214, w: 146, h: 52, label: t.xh, sub: t.xhs, tone: 'soft' },
    { id: 'g1', x: 130, y: 318, w: 146, h: 52, label: t.p1, sub: t.p1s, tone: 'green' },
    { id: 'g2', x: 290, y: 318, w: 146, h: 52, label: t.p2, sub: t.p2s, tone: 'green' },
    { id: 'g3', x: 450, y: 318, w: 146, h: 52, label: t.g3, sub: t.g3s, tone: 'blue' },
  ],
  edges: [
    { from: 'x', to: 'eb' }, { from: 'eb', to: 'et' }, { from: 'et', to: 'qt' }, { from: 'qt', to: 'dt' },
    { from: 'dt', to: 'qb' }, { from: 'eb', to: 'qb' }, { from: 'qb', to: 'dec' },
    { from: 'qt', to: 'dec', via: [[626, 60], [626, 240]] }, { from: 'dec', to: 'xh' },
    { from: 'g1', to: 'g2' }, { from: 'g2', to: 'g3' },
  ],
  texts: [
    { x: 8, y: 20, text: t.train, cls: 'f-small f-t-muted' },
    { x: 8, y: 306, text: t.gen, cls: 'f-small f-t-muted' },
  ],
};
const narrow: DLayout = {
  cls: 'fig-narrow', w: 360, h: 760, desc,
  nodes: [
    { id: 'x', x: 100, y: 26, w: 160, h: 42, label: t.x, sub: t.xs, tone: 'soft' },
    { id: 'eb', x: 100, y: 92, w: 160, h: 46, label: t.eb, sub: t.ebs, tone: 'blue' },
    { id: 'et', x: 100, y: 162, w: 160, h: 46, label: t.et, sub: t.ets, tone: 'blue' },
    { id: 'qt', x: 100, y: 232, w: 160, h: 46, label: t.qt, sub: t.qts, tone: 'amber' },
    { id: 'dt', x: 100, y: 302, w: 160, h: 46, label: t.dt, sub: t.dts, tone: 'blue' },
    { id: 'qb', x: 100, y: 372, w: 160, h: 46, label: t.qb, sub: t.qbs, tone: 'amber' },
    { id: 'dec', x: 100, y: 442, w: 160, h: 46, label: t.dec, sub: t.decs, tone: 'blue' },
    { id: 'xh', x: 100, y: 512, w: 160, h: 46, label: t.xh, sub: t.xhs, tone: 'soft' },
    { id: 'g1', x: 100, y: 600, w: 160, h: 42, label: t.p1, sub: t.p1s, tone: 'green' },
    { id: 'g2', x: 100, y: 658, w: 160, h: 42, label: t.p2, sub: t.p2s, tone: 'green' },
    { id: 'g3', x: 100, y: 716, w: 160, h: 40, label: t.g3, sub: t.g3s, tone: 'blue' },
  ],
  edges: [
    { from: 'x', to: 'eb' }, { from: 'eb', to: 'et' }, { from: 'et', to: 'qt' }, { from: 'qt', to: 'dt' },
    { from: 'dt', to: 'qb' }, { from: 'eb', to: 'qb', via: [[70, 115], [70, 395]] }, { from: 'qb', to: 'dec' },
    { from: 'qt', to: 'dec', via: [[292, 255], [292, 465]] }, { from: 'dec', to: 'xh' },
    { from: 'g1', to: 'g2' }, { from: 'g2', to: 'g3' },
  ],
  texts: [
    { x: 8, y: 16, text: t.train, cls: 'f-small f-t-muted' },
    { x: 8, y: 590, text: t.gen, cls: 'f-small f-t-muted' },
  ],
};
---

<BlockDiagram
  id="vae-variants-vq-vae-2"
  title={ru ? 'VQ-VAE-2 из ноутбука: две карты кодов' : 'The VQ-VAE-2 of the notebook: two code maps'}
  svgTitle={ru ? 'Обучение и генерация в двухуровневом VQ-VAE' : 'Training and generation in a two-level VQ-VAE'}
  caption={ru
    ? 'Сверху — путь обучения для изображений CIFAR-10 32×32. Нижний энкодер уменьшает изображение в 4 раза, верхний — ещё в 2. Верхняя карта 4×4 квантуется первой; её раскодированная версия вместе с признаками нижнего энкодера определяет нижнюю карту 8×8. Декодер получает увеличенные верхние коды и нижние коды. Снизу — генерация: верхние коды сэмплируются PixelCNN по одному, нижние — условным PixelCNN, который видит верхние, и декодер превращает пару карт в изображение. Обе карты — индексы в словаре из 512 векторов размерности 64.'
    : 'Top: the training path for 32×32 CIFAR-10 images. The bottom encoder shrinks the image fourfold, the top encoder twofold more. The 4×4 top map is quantized first; its decoded version, together with the bottom encoder features, determines the 8×8 bottom map. The decoder receives the upsampled top codes and the bottom codes. Bottom: generation. A PixelCNN samples the top codes one by one, a conditional PixelCNN that sees them samples the bottom codes, and the decoder turns the pair of maps into an image. Both maps are indices into codebooks of 512 vectors of dimension 64.'}
  layouts={[wide, narrow]}
/>
