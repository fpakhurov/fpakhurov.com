---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A two-dimensional codebook and the cells it cuts the plane into; z_e is the worked example of the note.
const code: [number, number][] = [[0, 0], [2, 0], [0, 2]];
const ze: [number, number] = [1.4, 0.3];
const others: [number, number][] = [[1.8, -0.1], [0.3, 0.4], [-0.2, 0.5], [0.4, 1.6], [0.2, 2.3], [2.3, 0.6], [1.6, 1.9], [0.7, -0.3], [-0.4, 1.4]];
const nearest = (p: [number, number]) => code.map(([x, y]) => (p[0] - x) ** 2 + (p[1] - y) ** 2).reduce((best, d, k, all) => (d < all[best] ? k : best), 0);
const d2 = code.map(([x, y]) => (ze[0] - x) ** 2 + (ze[1] - y) ** 2);
if (nearest(ze) !== 1 || d2[1].toFixed(2) !== '0.45') throw new Error('VectorQuantization: example drifted from the note');
const tones = ['blue', 'green', 'amber'];
// Text with `_x` written as a subscript x.
const parts = (text: string) => text.split(/_([a-z])/).map((piece, i) => ({ piece, sub: i % 2 === 1 }));
const t = ru
  ? { ze: 'выход энкодера z_e', zq: 'z_q = e₂', lines: ['каждый выход энкодера заменяется', 'ближайшим вектором словаря:', 'плоскость делится на ячейки Вороного', '', '‖z_e − e₂‖² = 0.45 — наименьшее', '‖z_e − e₁‖² = 2.05', '‖z_e − e₃‖² = 4.85'] }
  : { ze: 'encoder output z_e', zq: 'z_q = e₂', lines: ['each encoder output is replaced', 'by the nearest codebook vector:', 'the plane splits into Voronoi cells', '', '‖z_e − e₂‖² = 0.45, the smallest', '‖z_e − e₁‖² = 2.05', '‖z_e − e₃‖² = 4.85'] };
const id = 'vae-variants-vector-quantization';
const layouts = [
  { sfx: 'w', cls: 'fig-wide fig-medium', W: 660, H: 320, x0: 20, size: 290, textX: 340, textY: 70 },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 540, x0: 30, size: 300, textX: 20, textY: 366 },
];
---

<Figure
  id={id}
  title={ru ? 'Векторное квантование: ближайший вектор словаря' : 'Vector quantization: the nearest codebook vector'}
  caption={ru
    ? 'Словарь e₁ = (0, 0), e₂ = (2, 0), e₃ = (0, 2) делит плоскость на три ячейки; точки — выходы энкодера, окрашенные по ячейке. Красный выход (1.4, 0.3) ближе всего к e₂, и декодер получает e₂. Слагаемое привязки тянет выход к e₂, обновление словаря сдвигает e₂ к среднему его ячейки.'
    : 'The codebook e₁ = (0, 0), e₂ = (2, 0), e₃ = (0, 2) splits the plane into three cells; dots are encoder outputs coloured by cell. The red output (1.4, 0.3) is closest to e₂, which the decoder receives. The commitment term pulls the output toward e₂; the codebook update moves e₂ toward its cell’s mean.'}
>
  {layouts.map((L) => {
    const sx = scale([-0.7, 2.8], [L.x0, L.x0 + L.size]);
    const sy = scale([-0.7, 2.8], [L.x0 + L.size, L.x0]);
    const lo = -0.7, hi = 2.8;
    // Cells: e1 = {x < 1, y < 1}, e2 = {x > 1, y < x}, e3 = {y > 1, y > x}.
    const cells = [
      `M ${sx(lo)} ${sy(lo)} H ${sx(1)} V ${sy(1)} H ${sx(lo)} Z`,
      `M ${sx(1)} ${sy(lo)} H ${sx(hi)} V ${sy(hi)} L ${sx(1)} ${sy(1)} Z`,
      `M ${sx(lo)} ${sy(1)} H ${sx(1)} L ${sx(hi)} ${sy(hi)} H ${sx(lo)} Z`,
    ];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{ru ? 'Ячейки словаря на плоскости' : 'Codebook cells in the plane'}</title>
        <desc id={`${id}-${L.sfx}-d`}>{ru ? 'Квадрат, разделённый на три ячейки линиями x = 1, y = 1 и y = x. В каждой ячейке свой вектор словаря и несколько выходов энкодера. Выход (1.4, 0.3) соединён пунктиром с ближайшим вектором e₂ = (2, 0).' : 'A square split into three cells by the lines x = 1, y = 1 and y = x. Each cell holds its codebook vector and a few encoder outputs. The output (1.4, 0.3) is joined by a dashed line to its nearest vector e₂ = (2, 0).'}</desc>
        {cells.map((d, k) => <path d={d} class={`f-fill-${tones[k]}`} />)}
        <rect class="f-thin f-muted" x={L.x0} y={L.x0} width={L.size} height={L.size} fill="none" />
        <path class="f-thin f-muted f-dash" d={`M ${sx(1)} ${sy(lo)} V ${sy(1)} H ${sx(lo)} M ${sx(1)} ${sy(1)} L ${sx(hi)} ${sy(hi)}`} />
        {others.map((p) => <circle cx={sx(p[0])} cy={sy(p[1])} r="3.5" style={`fill: var(--fig-${tones[nearest(p)]}); opacity: 0.8`} />)}
        {code.map(([x, y], k) => (
          <g>
            <rect x={sx(x) - 7} y={sy(y) - 7} width="14" height="14" rx="2" style={`fill: var(--fig-${tones[k]})`} />
            {k !== 1 && <text class="f-math f-halo" x={sx(x) + 12} y={sy(y) - 10}>{`e${['₁', '₂', '₃'][k]}`}</text>}
          </g>
        ))}
        <path class="f-line f-red f-dash" d={`M ${sx(ze[0])} ${sy(ze[1])} L ${sx(code[1][0]) - 8} ${sy(code[1][1]) - 3}`} marker-end="url(#f-arrow-red)" />
        <circle class="f-solid-red" cx={sx(ze[0])} cy={sy(ze[1])} r="5.5" />
        <text class="f-label f-t-red f-halo" x={sx(ze[0]) - 4} y={sy(ze[1]) - 12} text-anchor="middle">{parts(t.ze).map((p) => (p.sub ? <tspan baseline-shift="sub" font-size="72%">{p.piece}</tspan> : p.piece))}</text>
        <text class="f-label f-halo" x={sx(code[1][0]) + 4} y={sy(code[1][1]) + 42} text-anchor="middle">{parts(t.zq).map((p) => (p.sub ? <tspan baseline-shift="sub" font-size="72%">{p.piece}</tspan> : p.piece))}</text>
        {t.lines.map((line, i) => <text class={i >= 4 ? 'f-math' : 'f-label'} x={L.textX} y={L.textY + i * 22 + Math.max(0, i - 4) * 6}>{parts(line).map((p) => (p.sub ? <tspan baseline-shift="sub" font-size="72%">{p.piece}</tspan> : p.piece))}</text>)}
      </svg>
    );
  })}
</Figure>
