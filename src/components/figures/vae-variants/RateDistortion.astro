---
import Figure from '../Figure.astro';
import { polyline, scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One latent dimension: p(z) = N(0, 1), a fixed decoder p(x | z) = N(w z, s2), data x ~ N(0, w^2 + s2),
// and the encoder q(z | x) = N(a x, v) that maximizes the beta-weighted objective (formulas in the note).
const w = 1, s2 = 0.1, varx = w * w + s2;
const optimum = (beta: number) => {
  const a = w / (w * w + beta * s2);
  const v = (beta * s2) / (w * w + beta * s2);
  const rate = 0.5 * (v + a * a * varx - 1 - Math.log(v));
  const distortion = varx * (1 - w * a) ** 2 + w * w * v;
  return { rate, distortion };
};
const marks = [0.25, 1, 4, 16].map((beta) => ({ beta, ...optimum(beta) }));
if (marks[1].rate.toFixed(3) !== '1.199' || marks[2].distortion.toFixed(3) !== '0.376') throw new Error('RateDistortion: numbers drifted from the note');
const curve = Array.from({ length: 241 }, (_, i) => optimum(10 ** (-1.6 + (i / 240) * 3.6)));
const f2 = (v: number) => v.toFixed(2);
const t = ru
  ? { rate: 'скорость R, наты', dist: 'искажение E(x − wz)²', vae: 'обычный VAE', desc: 'Убывающая кривая: при росте β скорость падает, искажение растёт.' }
  : { rate: 'rate R, nats', dist: 'distortion E(x − wz)²', vae: 'plain VAE', desc: 'A decreasing curve: as β grows, the rate falls and the distortion rises.' };
const id = 'vae-variants-rate-distortion';
const layouts = [
  { sfx: 'w', cls: 'fig-wide fig-medium', W: 600, H: 340, left: 70, right: 560, top: 24, bottom: 286 },
  { sfx: 'n', cls: 'fig-narrow', W: 360, H: 330, left: 56, right: 340, top: 20, bottom: 270 },
];
---

<Figure
  id={id}
  title={ru ? 'β-VAE передвигает точку по кривой «скорость–искажение»' : 'β moves a VAE along the rate–distortion curve'}
  caption={ru
    ? 'Одна латентная координата, фиксированный декодер x | z ~ N(z, 0.1) и данные x ~ N(0, 1.1). Для каждого β энкодер выбран оптимально по формулам в тексте; кривая — все такие точки при β от 0.025 до 100. Скорость R — средняя KL от апостериорного распределения к априорному в натах, искажение — средняя квадратичная ошибка реконструкции. β = 1 (обычный VAE) даёт точное апостериорное распределение и искажение ровно 0.1, шум декодера. При β = 4 скорость падает меньше чем до половины, а ошибка растёт почти вчетверо.'
    : 'One latent dimension, a fixed decoder x | z ~ N(z, 0.1) and data x ~ N(0, 1.1). For each β the encoder is chosen optimally by the formulas in the text; the curve shows all such points for β from 0.025 to 100. The rate R is the average KL from the posterior to the prior in nats, the distortion the average squared reconstruction error. β = 1 (the plain VAE) recovers the exact posterior and a distortion of exactly 0.1, the decoder noise. At β = 4 the rate drops below half and the error grows almost fourfold.'}
>
  {layouts.map((L) => {
    const sx = scale([0, 2.6], [L.left, L.right]);
    const sy = scale([0, 1.2], [L.bottom, L.top]);
    const narrow = L.sfx === 'n';
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{ru ? 'Кривая «скорость–искажение» для β-VAE' : 'Rate–distortion curve of a β-VAE'}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc} {marks.map((m) => `β = ${m.beta}: R = ${f2(m.rate)}, D = ${f2(m.distortion)}`).join('; ')}.</desc>
        {[0, 0.4, 0.8, 1.2].map((y) => <line class="f-grid" x1={L.left} x2={L.right} y1={sy(y)} y2={sy(y)} />)}
        {[0, 0.4, 0.8, 1.2].map((y) => <text class="f-note" x={L.left - 10} y={sy(y) + 5} text-anchor="end">{y}</text>)}
        {[0, 0.5, 1, 1.5, 2, 2.5].map((x) => <text class="f-note" x={sx(x)} y={L.bottom + 20} text-anchor="middle">{x}</text>)}
        <path class="f-axis" d={`M ${L.left} ${L.bottom} H ${L.right + 12}`} marker-end="url(#f-arrow-muted)" />
        <path class="f-axis" d={`M ${L.left} ${L.bottom} V ${L.top - 10}`} marker-end="url(#f-arrow-muted)" />
        <text class="f-label" x={L.right + 12} y={L.bottom + 40} text-anchor="end">{t.rate}</text>
        <text class="f-label" transform={`translate(${L.left - (narrow ? 38 : 46)} ${(L.top + L.bottom) / 2}) rotate(-90)`} text-anchor="middle">{t.dist}</text>
        <path class="f-line f-blue f-bold" d={polyline(curve.filter((p) => p.rate <= 2.6 && p.distortion <= 1.2).map((p) => [sx(p.rate), sy(p.distortion)] as const))} />
        {marks.map((m) => {
          // Points near the axis get their labels above them; the others to the right of them.
          const low = m.distortion < 0.2;
          const lx = low ? sx(m.rate) - 4 : sx(m.rate) + 9, ly = low ? sy(m.distortion) - 42 : sy(m.distortion) - 9;
          return (
            <g>
              <circle class={m.beta === 1 ? 'f-solid-red' : 'f-solid-blue'} cx={sx(m.rate)} cy={sy(m.distortion)} r="5" />
              <text class={`f-label f-halo${m.beta === 1 ? ' f-t-red' : ''}`} x={lx} y={ly} text-anchor="start">{m.beta === 1 && !narrow ? `β = 1, ${t.vae}` : `β = ${m.beta}`}</text>
              {!narrow && <text class="f-note f-halo" x={lx} y={ly + 17} text-anchor="start">{`R ${f2(m.rate)}, D ${f2(m.distortion)}`}</text>}
            </g>
          );
        })}
      </svg>
    );
  })}
</Figure>
