---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale, polyline } from '../geometry';
import { exact, exactContour, gibbs, condMu, condTau, logGam } from '../variational-inference/ng';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Gibbs sampling for the normal model with unknown mean μ and precision λ (the eight points and normal–gamma prior of the
// variational-inference note). One sweep draws μ from its normal conditional, then λ from its gamma conditional.
const sweeps = 30;
const ch = gibbs(3, [1.7, 1.7], sweeps);
const [s0, s1, s2] = ch;
if (s1[0].toFixed(2) !== '0.87' || s2[1].toFixed(2) !== '0.91') throw new Error('GibbsSteps: the first sweep drifted from the note');
if (!ch.every(([m, v]) => m > -0.8 && m < 2 && v > 0 && v < 2)) throw new Error('GibbsSteps: the chain left the frame');
const cm = condMu(s0[1]), ct = condTau(s1[0]);
if (cm.m.toFixed(3) !== '0.478' || (1 / cm.sd ** 2).toFixed(1) !== '15.3' || ct.a !== 6.5) throw new Error('GibbsSteps: conditionals drifted from the note');
const gpdf = (v: number) => Math.exp(logGam(v, ct.a, ct.b));
const gmode = (ct.a - 1) / ct.b, gmax = gpdf(gmode);

const t = ru
  ? {
      title: 'Один проход Гиббса: сначала μ, потом λ',
      ex: 'точное апостериорное p(μ, λ | X)', chain: 'цепь Гиббса', cond: 'условные распределения',
      steps: [
        'старт в (μ, λ) = (1.7, 1.7)',
        'μ берётся из p(μ | λ, X) — нормального со средним 0.478 и обратной дисперсией 9λ: цепь сдвигается по горизонтали в μ = 0.87',
        'λ берётся из p(λ | μ, X) — гамма-распределения: цепь сдвигается по вертикали в λ = 0.91',
        `${sweeps} проходов: каждый ход вдоль оси, и точки расходятся по апостериорному распределению`,
      ],
      desc: 'Плоскость (μ, λ) с контурами точного апостериорного. Из точки справа вверху цепь идёт горизонтально к центру (над этим отрезком нарисован колокол условного распределения μ), затем вертикально вниз (справа от него — гамма-плотность λ), а дальше ступеньками блуждает по контурам.',
    }
  : {
      title: 'One Gibbs sweep: first μ, then λ',
      ex: 'exact posterior p(μ, λ | X)', chain: 'Gibbs chain', cond: 'conditional distributions',
      steps: [
        'start at (μ, λ) = (1.7, 1.7)',
        'draw μ from p(μ | λ, X), a normal with mean 0.478 and precision 9λ: the chain moves horizontally to μ = 0.87',
        'draw λ from p(λ | μ, X), a gamma distribution: the chain moves vertically to λ = 0.91',
        `${sweeps} sweeps: every move is along an axis, and the points spread over the posterior`,
      ],
      desc: 'The (μ, λ) plane with contours of the exact posterior. From a point at the upper right the chain moves horizontally towards the centre (above this segment, the bell of the conditional of μ), then vertically down (to its right, the gamma density of λ), and then wanders over the contours in steps.',
    };
const id = 'gibbs-steps';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 400, x0: 56, x1: 584, y0: 20, y1: 316, leg: [[56, 368], [300, 368], [56, 390]] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 470, x0: 44, x1: 344, y0: 20, y1: 300, leg: [[16, 364], [16, 388], [16, 412]] },
];
const ex1 = exactContour(0.5), ex2 = exactContour(2);
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? `Модель и данные — как в заметке о вариационном выводе: восемь наблюдений, априорное μ | λ ~ N(0, 1/λ), λ ~ Gamma(2, 2); синим — точное апостериорное распределение. Шаг 2: при λ = 1.7 условное распределение μ — нормальное со средним ${cm.m.toFixed(3)} и обратной дисперсией 9 · 1.7 = ${(1 / cm.sd ** 2).toFixed(1)} (жёлтый колокол); выпало μ = ${s1[0].toFixed(2)}. Шаг 3: при этом μ условное распределение λ — Gamma(${ct.a}, ${ct.b.toFixed(2)}) (жёлтая кривая справа от вертикального отрезка); выпало λ = ${s2[1].toFixed(2)}. Шаг 4: первые ${sweeps} проходов. Каждое обновление сохраняет апостериорное распределение, поэтому цепь, однажды попав в него, из него не выходит.`
    : `The model and data of the variational-inference note: eight observations, prior μ | λ ~ N(0, 1/λ), λ ~ Gamma(2, 2); blue, the exact posterior. Step 2: at λ = 1.7 the conditional of μ is a normal with mean ${cm.m.toFixed(3)} and precision 9 · 1.7 = ${(1 / cm.sd ** 2).toFixed(1)} (amber bell); the draw is μ = ${s1[0].toFixed(2)}. Step 3: at that μ the conditional of λ is Gamma(${ct.a}, ${ct.b.toFixed(2)}) (amber curve to the right of the vertical segment); the draw is λ = ${s2[1].toFixed(2)}. Step 4: the first ${sweeps} sweeps. Every update preserves the posterior, so a chain that has reached it stays in it.`}
>
  {layouts.map((L) => {
    const sx = scale([-0.8, 2.0], [L.x0, L.x1]), sy = scale([0, 2.0], [L.y1, L.y0]);
    const P = (c: [number, number][]) => polyline(c.map(([m, v]) => [sx(m), sy(v)]));
    const bellH = 40, gamW = 50;
    const bell = Array.from({ length: 121 }, (_, i) => {
      const m = cm.m - 3 * cm.sd + (6 * cm.sd * i) / 120;
      return [sx(m), sy(s0[1]) - bellH * Math.exp(-0.5 * ((m - cm.m) / cm.sd) ** 2)] as [number, number];
    });
    const gam = Array.from({ length: 121 }, (_, i) => {
      const v = 0.05 + (1.9 * i) / 120;
      return [sx(s1[0]) + (gamW * gpdf(v)) / gmax, sy(v)] as [number, number];
    });
    const last = ch[ch.length - 1];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        <defs>
          <marker id={`${id}-${L.W}-arr`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
            <path d="M 0 0 L 10 5 L 0 10 z" style="fill: var(--fig-red)" />
          </marker>
        </defs>
        {[0, 0.5, 1, 1.5, 2].map((v) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} />
            <text class="f-note" x={L.x0 - 6} y={sy(v) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        {[-0.5, 0, 0.5, 1, 1.5, 2].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{String(v).replace('-', '−')}</text>)}
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        <text class="f-label" x={L.x1} y={L.y1 + 40} text-anchor="end">μ</text>
        <text class="f-label" x={L.x0 + 8} y={L.y0 + 14}>λ</text>
        <path class="f-line f-blue" d={P(ex1)} />
        <path class="f-line f-blue f-dash" d={P(ex2)} />
        <g data-s="4">
          <path class="f-thin f-red" style="stroke-width: 1.1; stroke-opacity: .7" d={P(ch.slice(2))} />
          {ch.slice(2).filter((_, i) => i % 2 === 0).map(([m, v]) => <circle cx={sx(m)} cy={sy(v)} r="2.6" class="f-solid-red" />)}
          <Badge x={sx(last[0]) + 16} y={sy(last[1])} n={4} />
        </g>
        <g data-s="1">
          <circle cx={sx(s0[0])} cy={sy(s0[1])} r="4.5" class="f-solid-red" />
          <Badge x={sx(s0[0]) + 18} y={sy(s0[1])} n={1} />
        </g>
        <g data-s="2">
          <path class="f-line f-amber" d={polyline(bell)} />
          <path class="f-line f-red" marker-end={`url(#${id}-${L.W}-arr)`} d={`M ${sx(s0[0]) - 6} ${sy(s0[1])} H ${sx(s1[0]) + 4}`} />
          <Badge x={(sx(s0[0]) + sx(s1[0])) / 2 + 30} y={sy(s0[1]) + 18} n={2} />
        </g>
        <g data-s="3">
          <path class="f-line f-amber" d={polyline(gam)} />
          <path class="f-line f-red" marker-end={`url(#${id}-${L.W}-arr)`} d={`M ${sx(s1[0])} ${sy(s0[1]) + 4} V ${sy(s2[1]) - 4}`} />
          <circle cx={sx(s2[0])} cy={sy(s2[1])} r="3.5" class="f-solid-red" />
          <Badge x={sx(s1[0]) - 18} y={(sy(s0[1]) + sy(s2[1])) / 2} n={3} />
        </g>
        <path class="f-line f-blue" d={`M ${L.leg[0][0]} ${L.leg[0][1] - 4} h 22`} />
        <text class="f-small" x={L.leg[0][0] + 30} y={L.leg[0][1]}>{t.ex}</text>
        <path class="f-line f-red" d={`M ${L.leg[1][0]} ${L.leg[1][1] - 4} h 22`} />
        <text class="f-small" x={L.leg[1][0] + 30} y={L.leg[1][1]}>{t.chain}</text>
        <path class="f-line f-amber" d={`M ${L.leg[2][0]} ${L.leg[2][1] - 4} h 22`} />
        <text class="f-small" x={L.leg[2][0] + 30} y={L.leg[2][1]}>{t.cond}</text>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
