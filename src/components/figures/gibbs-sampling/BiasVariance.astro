---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { exact, vi, gibbs } from '../variational-inference/ng';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The posterior standard deviation of μ in the normal model, estimated by four Gibbs chains from dispersed starts (the running
// sample standard deviation after n sweeps, no burn-in), against the exact value and the mean-field value.
const starts: [number, number][] = [[-0.5, 0.3], [1.5, 0.3], [-0.5, 1.6], [1.5, 1.6]];
const nMax = 10000;
const runs = starts.map((s, i) => {
  const mus = gibbs(100 + i, s, nMax).filter((_, k) => k % 2 === 0).slice(1).map((p) => p[0]);
  let s1 = 0, s2 = 0;
  return mus.map((m, k) => { s1 += m; s2 += m * m; const n = k + 1; return n > 1 ? Math.sqrt((s2 - (s1 * s1) / n) / (n - 1)) : NaN; });
});
const sdVI = 1 / Math.sqrt(vi.lam);
const at = (n: number) => runs.map((r) => r[n - 1]);
if (exact.sdMu.toFixed(3) !== '0.449' || sdVI.toFixed(3) !== '0.410') throw new Error('BiasVariance: reference values drifted from the note');
if (at(nMax).map((v) => v.toFixed(3)).join(' ') !== '0.447 0.449 0.443 0.446') throw new Error('BiasVariance: chain estimates drifted from the note');
if (at(10).map((v) => v.toFixed(2)).join(' ') !== '0.53 0.41 0.36 0.28') throw new Error('BiasVariance: early estimates drifted from the note');
const lo = Math.min(...at(nMax)), hi = Math.max(...at(nMax));

const t = ru
  ? {
      title: 'Смещение против дисперсии: Гиббс и среднее поле',
      y: 'оценка ст. откл. μ', x: 'число проходов n', exW: 'точное: 0.449', viW: 'среднее поле: 0.410', exN: 'точное', viN: 'ср. поле', ch: 'четыре цепи Гиббса',
      desc: 'Четыре ломаные, которые при малом n разбросаны от 0.28 до 0.53 и к n = 10 000 сходятся к горизонтальной линии 0.449. Ниже неё — горизонтальная линия среднего поля, 0.410, до которой цепи не опускаются.',
    }
  : {
      title: 'Bias against variance: Gibbs and mean field',
      y: 'estimated sd of μ', x: 'sweeps n', exW: 'exact: 0.449', viW: 'mean field: 0.410', exN: 'exact', viN: 'mean field', ch: 'four Gibbs chains',
      desc: 'Four jagged lines spread from 0.28 to 0.53 at small n that converge by n = 10,000 to the horizontal line at 0.449. Below it, the horizontal mean-field line at 0.410, which the chains do not approach.',
    };
const id = 'bias-variance';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 330, x0: 56, x1: 462, y0: 30, y1: 270, wide: true },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 340, x0: 44, x1: 262, y0: 30, y1: 270, wide: false },
];
const ns = Array.from({ length: 160 }, (_, i) => Math.round(10 * 1000 ** (i / 159)));
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? `Апостериорное стандартное отклонение μ в нормальной модели двух предыдущих рисунков. Тонкие линии — оценки по четырём цепям Гиббса из разнесённых стартов: выборочное стандартное отклонение первых n значений μ, без отбрасывания начала. После 10 проходов оценки лежат между ${Math.min(...at(10)).toFixed(2)} и ${Math.max(...at(10)).toFixed(2)}, после 10 000 — между ${lo.toFixed(3)} и ${hi.toFixed(3)}: ошибка убывает примерно как 1/√n и сходится к точному значению ${exact.sdMu.toFixed(3)} (синяя линия). Среднее поле (красная линия) даёт ${sdVI.toFixed(3)} сразу и без шума, но это значение смещено вниз на ${(exact.sdMu - sdVI).toFixed(3)}, и никакое число итераций его не исправит.`
    : `The posterior standard deviation of μ in the normal model of the two previous figures. Thin lines: estimates from four Gibbs chains with dispersed starts, the sample standard deviation of the first n draws of μ, with nothing discarded. After 10 sweeps the estimates lie between ${Math.min(...at(10)).toFixed(2)} and ${Math.max(...at(10)).toFixed(2)}, after 10,000 between ${lo.toFixed(3)} and ${hi.toFixed(3)}: the error shrinks roughly like 1/√n towards the exact value ${exact.sdMu.toFixed(3)} (blue). Mean field (red) gives ${sdVI.toFixed(3)} at once and without noise, but the value is biased low by ${(exact.sdMu - sdVI).toFixed(3)}, and no number of iterations removes the bias.`}
>
  {layouts.map((L) => {
    const sx = (n: number) => scale([1, 4], [L.x0, L.x1])(Math.log10(n)), sy = scale([0.25, 0.6], [L.y1, L.y0]);
    const clip = `${id}-${L.W}-clip`;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        <defs><clipPath id={clip}><rect x={L.x0} y={L.y0} width={L.x1 - L.x0} height={L.y1 - L.y0} /></clipPath></defs>
        <text class="f-small f-t-muted" x={L.x0} y={L.y0 - 12}>{t.y}</text>
        {[0.3, 0.4, 0.5, 0.6].map((v) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} />
            <text class="f-note" x={L.x0 - 6} y={sy(v) + 4} text-anchor="end">{v.toFixed(1)}</text>
          </g>
        ))}
        {[10, 100, 1000, 10000].map((n) => <text class="f-note" x={sx(n)} y={L.y1 + 18} text-anchor="middle">{n === 10000 ? (ru ? '10 000' : '10,000') : String(n)}</text>)}
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 40} text-anchor="middle">{t.x}</text>
        <g clip-path={`url(#${clip})`}>
          {runs.map((r) => <path class="f-thin" style="stroke-width: 1.2; stroke-opacity: .75" d={polyline(ns.map((n) => [sx(n), sy(r[n - 1])]))} />)}
        </g>
        <path class="f-line f-blue f-dash" d={`M ${L.x0} ${sy(exact.sdMu)} H ${L.x1}`} />
        <path class="f-line f-red" d={`M ${L.x0} ${sy(sdVI)} H ${L.x1}`} />
        <text class="f-small f-t-blue" x={L.x1 + 8} y={sy(exact.sdMu) + 4}>{L.wide ? t.exW : t.exN}</text>
        <text class="f-small f-t-red" x={L.x1 + 8} y={sy(sdVI) + 4}>{L.wide ? t.viW : t.viN}</text>
        {L.wide && <text class="f-small f-t-muted" x={L.x1 + 8} y={sy(0.53) + 4}>{t.ch}</text>}
      </svg>
    );
  })}
</Figure>
