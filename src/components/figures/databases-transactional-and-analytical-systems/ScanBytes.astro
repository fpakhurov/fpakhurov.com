---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';
const copy = ru
  ? {
      title: 'Два поля из полной записи',
      caption: 'При полном чтении десяти миллионов строк построчный формат читает все 120 байт на строку. Поколоночный читает 12 байт на строку из двух нужных столбцов.',
      desc: 'Без сжатия и накладных расходов построчный формат читает 1200 МБ, а поколоночный 120 МБ.',
      labels: ['Строки · 1200 МБ', 'Столбцы · 120 МБ'],
      fields: 'Два поля',
      rest: 'Остальные поля',
    }
  : {
      title: 'Two fields out of a full record',
      caption: 'For a full scan of ten million rows, the row layout reads all 120 bytes per row. The column layout reads 12 bytes per row from the two needed columns.',
      desc: 'Ignoring compression and overhead, the row layout reads 1200 MB and the column layout reads 120 MB.',
      labels: ['Rows · 1200 MB', 'Columns · 120 MB'],
      fields: 'Two fields',
      rest: 'Other fields',
    };
const x = 20;
const width = 310;
const fieldsWidth = width * 12 / 120;
---
<Figure id="db-scan-bytes" title={copy.title} caption={copy.caption}>
  <svg viewBox="0 0 350 174" role="img" aria-labelledby="db-scan-bytes-title db-scan-bytes-desc" style="max-width: 540px; margin-inline: auto">
    <title id="db-scan-bytes-title">{copy.title}</title>
    <desc id="db-scan-bytes-desc">{copy.desc}</desc>
    <text class="f-label" x={x} y="20">{copy.labels[0]}</text>
    <rect class="f-fill-green" x={x} y="29" width={fieldsWidth} height="25" />
    <rect class="f-fill-blue" x={x + fieldsWidth} y="29" width={width - fieldsWidth} height="25" />
    <text class="f-label" x={x} y="91">{copy.labels[1]}</text>
    <rect class="f-fill-green" x={x} y="101" width={fieldsWidth} height="25" />
    <rect class="f-fill-green" x={x} y="142" width="15" height="15" />
    <text class="f-label" x={x + 23} y="154">{copy.fields}</text>
    <rect class="f-fill-blue" x="174" y="142" width="15" height="15" />
    <text class="f-label" x="197" y="154">{copy.rest}</text>
  </svg>
</Figure>
