---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A = [[2, 2], [−2, 1]] = U Σ Vᵀ with V = [v₁ v₂], v₁ = (2, 1)/√5, v₂ = (−1, 2)/√5, Σ = diag(3, 2), U = [u₁ u₂],
// u₁ = (2, −1)/√5, u₂ = (1, 2)/√5. Vᵀ and U are both the rotation by −26.57°. The point x = e₁ goes to
// Vᵀx = (0.894, −0.447), ΣVᵀx = (2.683, −0.894) and UΣVᵀx = (2, −2) = Ax.
type V2 = [number, number];
type M2 = [[number, number], [number, number]];
const r5 = Math.sqrt(5);
const A: M2 = [[2, 2], [-2, 1]];
const V: M2 = [[2 / r5, -1 / r5], [1 / r5, 2 / r5]];
const U: M2 = [[2 / r5, 1 / r5], [-1 / r5, 2 / r5]];
const S: M2 = [[3, 0], [0, 2]];
const mul = (M: M2, x: V2): V2 => [M[0][0] * x[0] + M[0][1] * x[1], M[1][0] * x[0] + M[1][1] * x[1]];
const tr = (M: M2): M2 => [[M[0][0], M[1][0]], [M[0][1], M[1][1]]];
const Vt = tr(V);
const full = (x: V2) => mul(U, mul(S, mul(Vt, x)));
const probe: V2[] = [[1, 0], [0, 1], [0.6, -0.8], [-0.28, 0.96]];
if (probe.some((x) => Math.hypot(full(x)[0] - mul(A, x)[0], full(x)[1] - mul(A, x)[1]) > 1e-12)) throw new Error('SvdSteps: U Σ Vᵀ does not reproduce A');
const AtA = [[A[0][0] ** 2 + A[1][0] ** 2, A[0][0] * A[0][1] + A[1][0] * A[1][1]], [0, A[0][1] ** 2 + A[1][1] ** 2]];
if (AtA[0].join() !== '8,2' || AtA[1][1] !== 5) throw new Error('SvdSteps: AᵀA drifted from the note');
const angle = (M: M2) => (Math.atan2(M[1][0], M[0][0]) * 180) / Math.PI;
if (angle(Vt).toFixed(2) !== '-26.57' || angle(U).toFixed(2) !== '-26.57') throw new Error('SvdSteps: the rotation angles drifted from the note');
const x0: V2 = [1, 0];
const x1 = mul(Vt, x0), x2 = mul(S, x1), x3 = mul(U, x2);
if ([...x1, ...x2, ...x3].map((v) => v.toFixed(3)).join() !== '0.894,-0.447,2.683,-0.894,2.000,-2.000') throw new Error('SvdSteps: the probe point drifted from the note');

const circle: V2[] = Array.from({ length: 181 }, (_, i) => { const t = (2 * Math.PI * i) / 180; return [Math.cos(t), Math.sin(t)]; });
const v1: V2 = [V[0][0], V[1][0]], v2: V2 = [V[0][1], V[1][1]];
// What each panel shows: the curve, the two tracked directions and the probe point.
const panels = [
  { curve: circle, a: v1, b: v2, p: x0 },
  { curve: circle.map((x) => mul(Vt, x)), a: mul(Vt, v1), b: mul(Vt, v2), p: x1 },
  { curve: circle.map((x) => mul(S, mul(Vt, x))), a: mul(S, mul(Vt, v1)), b: mul(S, mul(Vt, v2)), p: x2 },
  { curve: circle.map(full), a: full(v1), b: full(v2), p: x3 },
];
if (panels[3].a.map((v) => v.toFixed(3)).join() !== '2.683,-1.342' || panels[3].b.map((v) => v.toFixed(3)).join() !== '0.894,1.789') throw new Error('SvdSteps: σᵢuᵢ drifted from the note');

const t = ru
  ? {
      title: 'Сингулярное разложение: поворот, растяжение, поворот',
      desc: 'Четыре панели. Единичная окружность с векторами v₁ = (2, 1)/√5 и v₂ = (−1, 2)/√5 и точкой x = e₁. Шаг 1: Vᵀ поворачивает плоскость на −26.6°, v₁ и v₂ переходят в e₁ и e₂. Шаг 2: Σ растягивает оси в 3 и 2 раза, окружность становится эллипсом с полуосями 3 и 2 вдоль осей координат. Шаг 3: U поворачивает на −26.6°, полуоси переходят в 3u₁ и 2u₂, точка x переходит в Ax = (2, −2).',
      caption: 'A = [[2, 2], [−2, 1]] = UΣVᵀ, применённая к единичной окружности по частям. Vᵀ — поворот, переводящий правые сингулярные векторы v₁ = (2, 1)/√5 и v₂ = (−1, 2)/√5 в оси координат. Σ = diag(3, 2) растягивает оси в σ₁ = 3 и σ₂ = 2 раза. U — поворот, переводящий оси в левые сингулярные векторы u₁ = (2, −1)/√5 и u₂ = (1, 2)/√5. Здесь оба поворота — на −26.6°. Итог — эллипс с полуосями 3 вдоль u₁ и 2 вдоль u₂, образ окружности под действием A. Зелёная точка x = e₁ проходит через (0.894, −0.447) и (2.683, −0.894) и приходит в Ax = (2, −2). Масштаб во всех панелях одинаковый.',
      cap: ['x на единичной окружности', 'Vᵀx', 'ΣVᵀx', 'UΣVᵀx = Ax'],
      cn: ['x', 'Vᵀx', 'ΣVᵀx', 'Ax'],
      op: ['Vᵀ: поворот на −26.6°', 'Σ: растяжение в 3 и 2 раза', 'U: поворот на −26.6°'],
      steps: ['Vᵀ поворачивает v₁, v₂ на оси e₁, e₂', 'Σ растягивает оси в σ₁ = 3 и σ₂ = 2 раза', 'U поворачивает оси на u₁, u₂: получается образ окружности под действием A'],
    }
  : {
      title: 'The SVD: rotate, stretch, rotate',
      desc: 'Four panels. The unit circle with the vectors v₁ = (2, 1)/√5 and v₂ = (−1, 2)/√5 and the point x = e₁. Step 1: Vᵀ rotates the plane by −26.6°, taking v₁ and v₂ to e₁ and e₂. Step 2: Σ stretches the axes by 3 and 2, and the circle becomes an ellipse with half-axes 3 and 2 along the coordinate axes. Step 3: U rotates by −26.6°, the half-axes become 3u₁ and 2u₂, and the point x arrives at Ax = (2, −2).',
      caption: 'A = [[2, 2], [−2, 1]] = UΣVᵀ applied to the unit circle one factor at a time. Vᵀ is a rotation that takes the right singular vectors v₁ = (2, 1)/√5 and v₂ = (−1, 2)/√5 to the coordinate axes. Σ = diag(3, 2) stretches the axes by σ₁ = 3 and σ₂ = 2. U is a rotation that takes the axes to the left singular vectors u₁ = (2, −1)/√5 and u₂ = (1, 2)/√5. Here both rotations are by −26.6°. The result is an ellipse with half-axes 3 along u₁ and 2 along u₂, the image of the circle under A. The green point x = e₁ passes through (0.894, −0.447) and (2.683, −0.894) and arrives at Ax = (2, −2). All panels use the same scale.',
      cap: ['x on the unit circle', 'Vᵀx', 'ΣVᵀx', 'UΣVᵀx = Ax'],
      cn: ['x', 'Vᵀx', 'ΣVᵀx', 'Ax'],
      op: ['Vᵀ: rotate by −26.6°', 'Σ: stretch by 3 and 2', 'U: rotate by −26.6°'],
      steps: ['Vᵀ rotates v₁, v₂ onto the axes e₁, e₂', 'Σ stretches the axes by σ₁ = 3 and σ₂ = 2', 'U rotates the axes onto u₁, u₂: the result is the image of the circle under A'],
    };
const names = [['v₁', 'v₂'], ['e₁', 'e₂'], ['3e₁', '2e₂'], ['3u₁', '2u₂']];
type Lab = [number, number, 'start' | 'end' | 'middle'];
type Layout = {
  cls: string; sfx: string; W: number; H: number; s: number; c: V2[]; capY: number[]; full: boolean;
  la: Lab[]; lb: Lab[]; lp: Lab[];
  arrows: { from: V2; to: V2; badge: V2; text: V2; anchor: 'start' | 'end' | 'middle' }[];
};
const layouts: Layout[] = [
  {
    cls: 'fig-wide', sfx: 'w', W: 760, H: 222, s: 28, c: [[90, 130], [270, 130], [460, 130], [650, 130]], capY: [208, 208, 208, 208], full: true,
    la: [[6, -2, 'start'], [8, 4, 'start'], [-2, 18, 'end'], [6, 4, 'start']],
    lb: [[-6, -2, 'end'], [6, -2, 'start'], [6, 0, 'start'], [6, -2, 'start']],
    lp: [[2, 18, 'middle'], [0, 0, 'start'], [0, 0, 'start'], [8, 5, 'start']],
    arrows: [
      { from: [128, 36], to: [232, 36], badge: [180, 36], text: [180, 18], anchor: 'middle' },
      { from: [306, 36], to: [424, 36], badge: [365, 36], text: [365, 18], anchor: 'middle' },
      { from: [500, 36], to: [610, 36], badge: [555, 36], text: [555, 18], anchor: 'middle' },
    ],
  },
  {
    cls: 'fig-narrow', sfx: 'n', W: 360, H: 548, s: 26, c: [[90, 80], [270, 80], [180, 258], [180, 452]], capY: [128, 128, 336, 534], full: false,
    la: [[6, -6, 'start'], [6, 4, 'start'], [-2, 16, 'end'], [6, 4, 'start']],
    lb: [[-6, -2, 'end'], [6, -2, 'start'], [6, 0, 'start'], [6, -2, 'start']],
    lp: [[2, 17, 'middle'], [0, 0, 'start'], [0, 0, 'start'], [8, 5, 'start']],
    arrows: [
      { from: [122, 80], to: [238, 80], badge: [180, 80], text: [180, 62], anchor: 'middle' },
      { from: [332, 112], to: [332, 222], badge: [332, 167], text: [318, 172], anchor: 'end' },
      { from: [332, 300], to: [332, 410], badge: [332, 355], text: [318, 360], anchor: 'end' },
    ],
  },
];
const opShort = ['Vᵀ', 'Σ', 'U'];
const id = 'svd-steps';
---

<Figure id={id} title={t.title} caption={t.caption}>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
      {panels.map((P, k) => {
        const X = (v: V2): V2 => [L.c[k][0] + L.s * v[0], L.c[k][1] - L.s * v[1]];
        const A1 = X(P.a), B1 = X(P.b), Pp = X(P.p), O = X([0, 0]);
        const ax = 3.15 * L.s;
        return (
          <g data-s={k === 0 ? undefined : String(k)}>
            <path class="f-grid" d={`M ${O[0] - ax} ${O[1]} H ${O[0] + ax} M ${O[0]} ${O[1] - 2.3 * L.s} V ${O[1] + 2.3 * L.s}`} />
            {k === 0 ? null : <path class="f-thin f-muted f-dot" d={polyline(circle.map(X))} />}
            <path class="f-fill-amber" d={polyline(P.curve.map(X)) + ' Z'} style="stroke: var(--fig-amber); stroke-width: 1.5" />
            <path class="f-line f-red" d={polyline([O, A1])} marker-end="url(#f-arrow-red)" />
            <path class="f-line f-blue" d={polyline([O, B1])} marker-end="url(#f-arrow-blue)" />
            <circle cx={Pp[0]} cy={Pp[1]} r="4" class="f-solid-green" />
            <text class="f-small f-t-red f-halo" x={A1[0] + L.la[k][0]} y={A1[1] + L.la[k][1]} text-anchor={L.la[k][2]}>{names[k][0]}</text>
            <text class="f-small f-t-blue f-halo" x={B1[0] + L.lb[k][0]} y={B1[1] + L.lb[k][1]} text-anchor={L.lb[k][2]}>{names[k][1]}</text>
            {k === 0 ? <text class="f-small f-t-green f-halo" x={Pp[0] + L.lp[0][0]} y={Pp[1] + L.lp[0][1]} text-anchor="middle">x</text> : null}
            {k === 3 ? <text class="f-small f-t-green f-halo" x={Pp[0] + L.lp[3][0]} y={Pp[1] + L.lp[3][1]}>Ax</text> : null}
            <text class="f-small f-t-muted" x={L.c[k][0]} y={L.capY[k]} text-anchor="middle">{L.full ? t.cap[k] : t.cn[k]}</text>
          </g>
        );
      })}
      {L.arrows.map((a, i) => (
        <g data-s={String(i + 1)}>
          <path class="f-line f-muted" d={polyline([a.from, a.to])} marker-end="url(#f-arrow-muted)" />
          <text class="f-small f-halo" x={a.text[0]} y={a.text[1]} text-anchor={a.anchor}>{L.full ? t.op[i] : opShort[i]}</text>
          <Badge x={a.badge[0]} y={a.badge[1]} n={i + 1} />
        </g>
      ))}
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
