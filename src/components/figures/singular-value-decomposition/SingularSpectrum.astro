---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { imageExample, lowRank, frobenius } from './svd';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Left: the 64 singular values of the test image, on a log scale. Right: the relative error ‖A − A_k‖_F / ‖A‖_F of the
// rank-k approximation, which by Eckart–Young equals √(σ²_{k+1} + … + σ²_64) / √(σ²_1 + … + σ²_64); checked against
// the matrix itself for k = 10. A rank-k approximation stores k(m + n + 1) = 129k numbers, as many as the full matrix at k = 31.75.
const ex = imageExample();
const s = ex.d.s, err = ex.err;
if ([s[0].toFixed(1), s[1].toFixed(2), s[63].toExponential(1)].join() !== '38.3,8.39,1.6e-4') throw new Error('SingularSpectrum: singular values drifted from the note');
if ([1, 5, 10, 20, 30].map((k) => err[k].toFixed(4)).join() !== '0.2832,0.1213,0.0810,0.0448,0.0285') throw new Error('SingularSpectrum: errors drifted from the note');
const A10 = lowRank(ex.d, 10);
const direct = frobenius(ex.A.map((r, i) => r.map((v, j) => v - A10[i][j]))) / ex.norm;
if (Math.abs(direct - err[10]) > 1e-9 || Math.abs(Math.sqrt(s.reduce((a, v) => a + v * v, 0)) - ex.norm) > 1e-9) throw new Error('SingularSpectrum: Eckart–Young error formula fails');
const kEven = 64 * 64 / (64 + 64 + 1);

const t = ru
  ? {
      title: 'Сингулярные числа изображения и ошибка аппроксимации ранга k',
      desc: 'Слева: 64 сингулярных числа в логарифмической шкале, от 38.3 до 1.6·10⁻⁴; после первого быстрый спад, затем медленный хвост. Справа: относительная ошибка аппроксимации ранга k в логарифмической шкале: 28% при k = 1, 12% при k = 5, 4.5% при k = 20; вертикальный пунктир при k ≈ 32, где хранение аппроксимации стоит столько же, сколько вся матрица.',
      caption: 'То же изображение 64 × 64. Слева: сингулярные числа σᵢ, от σ₁ = 38.3 до σ₆₄ = 1.6·10⁻⁴. Первое велико, потому что у изображения есть постоянный фон. Справа: относительная ошибка ‖A − A_k‖_F / ‖A‖_F наилучшей аппроксимации ранга k. По теореме Эккарта–Янга она равна корню из суммы квадратов отброшенных σᵢ, делённому на корень из суммы всех; при k = 10 это совпадает с ошибкой, посчитанной по самой матрице. Пунктир отмечает k ≈ 32: с этого ранга хранить U_k, σ и V_k дороже, чем саму матрицу.',
      ls: 'σᵢ (лог. шкала)', li: 'номер i', rs: 'относительная ошибка (лог. шкала)', rk: 'ранг k', even: 'k(m + n + 1) = mn', k: (k: number, v: number) => `k = ${k}: ${v}%`,
    }
  : {
      title: 'The singular values of the image and the error of a rank-k approximation',
      desc: 'Left: the 64 singular values on a log scale, from 38.3 down to 1.6·10⁻⁴; a fast drop after the first, then a slow tail. Right: the relative error of the rank-k approximation on a log scale: 28% at k = 1, 12% at k = 5, 4.5% at k = 20; a vertical dashed line at k ≈ 32, where storing the approximation costs as much as the whole matrix.',
      caption: 'The same 64 × 64 image. Left: the singular values σᵢ, from σ₁ = 38.3 down to σ₆₄ = 1.6·10⁻⁴. The first is large because the image has a constant background. Right: the relative error ‖A − A_k‖_F / ‖A‖_F of the best rank-k approximation. By the Eckart–Young theorem it is the square root of the sum of the squared discarded σᵢ, divided by the square root of the sum of all of them; at k = 10 this matches the error computed from the matrix itself. The dashed line marks k ≈ 32: from that rank on, storing U_k, the σ and V_k costs more than the matrix.',
      ls: 'σᵢ (log scale)', li: 'index i', rs: 'relative error (log scale)', rk: 'rank k', even: 'k(m + n + 1) = mn', k: (k: number, v: number) => `k = ${k}: ${v}%`,
    };
const id = 'svd-spectrum';
const layouts = [
  { cls: 'fig-wide', sfx: 'w', W: 760, H: 300, P: [{ x: [76, 340], y: [40, 236] }, { x: [450, 714], y: [40, 236] }] },
  { cls: 'fig-narrow', sfx: 'n', W: 360, H: 620, P: [{ x: [66, 340], y: [40, 236] }, { x: [66, 340], y: [346, 542] }] },
];
const sTicks = [1, 0, -2, -4], sTickText = ['10', '1', '10⁻²', '10⁻⁴'];
const eTicks = [0, -2, -4], eTickText = ['1', '10⁻²', '10⁻⁴'];
const marks = [[1, 28], [5, 12], [20, 4.5]] as const;
---

<Figure id={id} title={t.title} caption={t.caption}>
  {layouts.map((L) => {
    const [P, Q] = L.P;
    const ax = scale([1, 64], P.x as [number, number]), ay = scale([-4.3, 1.8], [P.y[1], P.y[0]]);
    const bx = scale([0, 64], Q.x as [number, number]), by = scale([-5.6, 0.1], [Q.y[1], Q.y[0]]);
    const ks = Array.from({ length: 64 }, (_, k) => k); // err[64] = 0 has no logarithm
    const lastS = [ax(64), ay(Math.log10(s[63]))];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {sTicks.map((v) => <path class="f-grid" d={`M ${P.x[0]} ${ay(v)} H ${P.x[1]}`} />)}
        {eTicks.map((v) => <path class="f-grid" d={`M ${Q.x[0]} ${by(v)} H ${Q.x[1]}`} />)}
        <path class="f-axis" d={`M ${P.x[0]} ${P.y[0]} V ${P.y[1]} H ${P.x[1]} M ${Q.x[0]} ${Q.y[0]} V ${Q.y[1]} H ${Q.x[1]}`} />
        {sTicks.map((v, i) => <text class="f-note" x={P.x[0] - 8} y={ay(v) + 5} text-anchor="end">{sTickText[i]}</text>)}
        {eTicks.map((v, i) => <text class="f-note" x={Q.x[0] - 8} y={by(v) + 5} text-anchor="end">{eTickText[i]}</text>)}
        {[1, 32, 64].map((v) => <text class="f-note" x={ax(v)} y={P.y[1] + 19} text-anchor="middle">{v}</text>)}
        {[0, 32, 64].map((v) => <text class="f-note" x={bx(v)} y={Q.y[1] + 19} text-anchor="middle">{v}</text>)}
        <text class="f-small f-t-muted" x={(P.x[0] + P.x[1]) / 2} y={P.y[1] + 40} text-anchor="middle">{t.li}</text>
        <text class="f-small f-t-muted" x={(Q.x[0] + Q.x[1]) / 2} y={Q.y[1] + 40} text-anchor="middle">{t.rk}</text>
        <text class="f-small f-t-muted" x={P.x[0] - 44} y={P.y[0] - 18}>{t.ls}</text>
        <text class="f-small f-t-muted" x={Q.x[0] - 44} y={Q.y[0] - 18}>{t.rs}</text>

        <path class="f-thin f-blue" d={polyline(s.map((v, i) => [ax(i + 1), ay(Math.log10(v))]))} />
        {s.map((v, i) => <circle cx={ax(i + 1).toFixed(1)} cy={ay(Math.log10(v)).toFixed(1)} r="2.4" class="f-solid-blue" />)}
        <text class="f-small f-t-blue f-halo" x={ax(1) + 10} y={ay(Math.log10(s[0])) + 4}>σ₁ = 38.3</text>
        <text class="f-small f-t-blue f-halo" x={lastS[0] - 10} y={lastS[1] - 2} text-anchor="end">σ₆₄ = 1.6·10⁻⁴</text>

        <path class="f-thin f-muted f-dash" d={`M ${bx(kEven)} ${Q.y[0]} V ${Q.y[1]}`} />
        <text class="f-small f-t-muted f-halo" x={bx(kEven) + 5} y={Q.y[0] + 8}>{t.even}</text>
        <path class="f-line f-amber" d={polyline(ks.map((k) => [bx(k), by(Math.log10(err[k]))]))} />
        {marks.map(([k]) => <circle cx={bx(k)} cy={by(Math.log10(err[k]))} r="4" class="f-solid-red" />)}
        {marks.map(([k, v], i) => <text class="f-small f-t-red f-halo" x={bx(k) + 6 + 4 * i} y={by(Math.log10(err[k])) - 10}>{t.k(k, v)}</text>)}
      </svg>
    );
  })}
</Figure>
