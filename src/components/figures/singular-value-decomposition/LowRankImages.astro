---
import Figure from '../Figure.astro';
import { imageExample, lowRank, frobenius, pngDataUri } from './svd';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The 64 × 64 test image of the note and its rank-k approximations for k = 1, 5 and 20, computed by the SVD at build time.
// Storage of a rank-k approximation: k(m + n + 1) = 129k numbers against mn = 4096.
const ex = imageExample();
const ks = [1, 5, 20, 64];
const tiles = ks.map((k) => {
  const Ak = k === 64 ? ex.A : lowRank(ex.d, k);
  const diff = ex.A.map((r, i) => r.map((v, j) => v - Ak[i][j]));
  const rel = frobenius(diff) / ex.norm;
  return { k, uri: pngDataUri(Ak, 0, ex.max), rel, store: k === 64 ? 4096 : 129 * k };
});
if (tiles.slice(0, 3).map((x) => (100 * x.rel).toFixed(1)).join() !== '28.3,12.1,4.5') throw new Error('LowRankImages: errors drifted from the note');
if (tiles.slice(0, 3).some((x) => Math.abs(x.rel - ex.err[x.k]) > 1e-9)) throw new Error('LowRankImages: the error differs from the singular-value formula');

const pct = (v: number) => `${Math.round((100 * v) / 4096)}%`;
const fmtInt = (v: number) => (v >= 1000 && !ru ? `${Math.floor(v / 1000)},${String(v % 1000).padStart(3, '0')}` : String(v)); // Russian keeps four-digit numbers unseparated
const t = ru
  ? {
      title: 'Изображение 64 × 64 и его малоранговые аппроксимации',
      desc: 'Четыре квадратные картинки в оттенках серого. Ранг 1: размытая клетчатая сумма произведений строк и столбцов, ошибка 28.3%. Ранг 5: видны диск и прямоугольник, ошибка 12.1%. Ранг 20: почти неотличимо от оригинала, кроме полосы по диагонали, ошибка 4.5%. Справа оригинал ранга 64: константный фон с плавным пятном, светлый диск, прямоугольник и тонкая диагональная полоса.',
      caption: 'Синтетическое изображение 64 × 64 (справа) и его наилучшие аппроксимации ранга 1, 5 и 20 по сингулярному разложению, вычисленному при сборке страницы. Под каждой — относительная ошибка ‖A − A_k‖_F / ‖A‖_F и число хранимых чисел, 129k против 4096. Прямоугольник появляется уже при ранге 1, диагональная полоса — последней.',
      lab: (k: number) => (k === 64 ? 'оригинал, ранг 64' : `ранг k = ${k}`), err: (v: number) => (v === 0 ? 'ошибка 0' : `ошибка ${(100 * v).toFixed(1)}%`), st: (v: number) => `${fmtInt(v)} чисел, ${pct(v)}`,
    }
  : {
      title: 'A 64 × 64 image and its low-rank approximations',
      desc: 'Four grayscale squares. Rank 1: a blurred plaid made of a product of a column and a row, error 28.3%. Rank 5: the disc and the rectangle are visible, error 12.1%. Rank 20: almost the original except along the diagonal stripe, error 4.5%. Right: the original of rank 64, a constant background with a smooth bump, a bright disc, a rectangle and a thin diagonal stripe.',
      caption: 'A synthetic 64 × 64 image (right) and its best approximations of rank 1, 5 and 20, computed from the SVD when the page is built. Under each: the relative error ‖A − A_k‖_F / ‖A‖_F and the numbers stored, 129k against 4,096. The rectangle appears at rank 1, the diagonal stripe last.',
      lab: (k: number) => (k === 64 ? 'original, rank 64' : `rank k = ${k}`), err: (v: number) => (v === 0 ? 'error 0' : `error ${(100 * v).toFixed(1)}%`), st: (v: number) => `${fmtInt(v)} numbers, ${pct(v)}`,
    };
const id = 'svd-low-rank-images';
const layouts = [
  { cls: 'fig-wide', sfx: 'w', W: 760, H: 214, size: 128, pos: [[34, 10], [222, 10], [410, 10], [598, 10]] },
  { cls: 'fig-narrow', sfx: 'n', W: 360, H: 410, size: 128, pos: [[34, 10], [198, 10], [34, 214], [198, 214]] },
];
---

<Figure id={id} title={t.title} caption={t.caption}>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
      {tiles.map((T, i) => {
        const [x, y] = L.pos[i];
        const cx = x + L.size / 2;
        return (
          <g>
            <image href={T.uri} x={x} y={y} width={L.size} height={L.size} preserveAspectRatio="none" style="image-rendering: pixelated" />
            <rect x={x} y={y} width={L.size} height={L.size} style="fill: none; stroke: var(--line); stroke-width: 1" />
            <text class="f-label" x={cx} y={y + L.size + 22} text-anchor="middle">{t.lab(T.k)}</text>
            <text class="f-small" x={cx} y={y + L.size + 42} text-anchor="middle">{t.err(T.k === 64 ? 0 : T.rel)}</text>
            <text class="f-small f-t-muted" x={cx} y={y + L.size + 60} text-anchor="middle">{t.st(T.store)}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
