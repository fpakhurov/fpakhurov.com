---
import Figure from '../Figure.astro';
import { scale, plot } from '../geometry';
import { xs, ts, keep, beta, predict, sinc } from './rvm';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The fitted RVM of the Code section: 100 noisy points of sinc on [−10, 10], a bias and 100 Gaussian kernels of width 2.
// The predictive mean and the band (mean ± 2 predictive standard deviations) are recomputed here from the kept weights.
const rvx = keep.filter((k) => k > 0).map((k) => xs[k - 1]);
let ss = 0, lo = Infinity, hi = 0;
for (let i = 0; i < 1000; i++) {
  const x = -10 + (20 * i) / 999, p = predict(x);
  ss += (p.mean - sinc(x)) ** 2;
  lo = Math.min(lo, p.sd); hi = Math.max(hi, p.sd);
}
const rms = Math.sqrt(ss / 1000), noise = 1 / Math.sqrt(beta), far = predict(15).sd;
const chk = [keep.length, keep.includes(0) ? 'bias' : 'no bias', rvx.map((v) => v.toFixed(2)).join(','), rms.toFixed(4), noise.toFixed(4), lo.toFixed(4), hi.toFixed(4), far.toFixed(4)].join(' ');
if (chk !== '6 no bias -5.96,-3.13,-0.71,5.15,8.18,10.00 0.0403 0.0902 0.0903 0.0993 0.0903') throw new Error(`SincFit: the fit drifted (${chk})`);

const dom = { x: [-14, 14] as [number, number], y: [-0.5, 1.3] as [number, number] };
const t = ru
  ? { mean: 'среднее прогноза', band: '± 2 ст. откл.', truth: 'sin x / x', data: 'данные', rv: 'релевантные векторы', title: 'Метод релевантных векторов на функции sinc', desc: 'Сто зашумлённых точек функции sin x / x на отрезке от −10 до 10, среднее прогноза метода релевантных векторов и полоса ± 2 стандартных отклонения. Обведены шесть точек, ядра которых остались в модели. За краями данных среднее стремится к нулю, а полоса не расширяется.' }
  : { mean: 'predictive mean', band: 'mean ± 2 sd', truth: 'sin x / x', data: 'data', rv: 'relevance vectors', title: 'The relevance vector machine on the sinc function', desc: 'One hundred noisy points of sin x / x on −10 to 10, the predictive mean of the relevance vector machine and its band of ± 2 standard deviations. Six points whose kernels stayed in the model are circled. Beyond the data the mean decays to zero and the band does not widen.' };
const id = 'rvm-sinc';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 290, x0: 50, x1: 740, y0: 20, y1: 230, leg: { x: 60, y: 274, perRow: 5 } },
  { cls: 'fig-narrow', W: 360, H: 320, x0: 36, x1: 350, y0: 20, y1: 220, leg: { x: 36, y: 264, perRow: 2 } },
];
const items = [
  { kind: 'line', label: t.mean }, { kind: 'band', label: t.band }, { kind: 'truth', label: t.truth },
  { kind: 'dot', label: t.data }, { kind: 'ring', label: t.rv },
];
const textW = (s: string) => s.length * 6.5;
const legends = layouts.map((L) => {
  let cx = L.leg.x;
  return items.map((e, i) => {
    if (i % L.leg.perRow === 0) cx = L.leg.x;
    const x = cx, y = L.leg.y + Math.floor(i / L.leg.perRow) * 20;
    cx += 28 + textW(e.label) + 22;
    if (x + 28 + textW(e.label) > L.W - 4) throw new Error(`SincFit: legend entry "${e.label}" runs past the frame`);
    return { ...e, x, y };
  });
});
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? `Сто точек sin x / x на равномерной сетке от −10 до 10 с гауссовским шумом 0.1, свободный член и по одному гауссовскому ядру ширины 2 на точку: 101 признак. Максимизация обоснованности по 101 обратной дисперсии весов и обратной дисперсии шума оставила ${keep.length} ядер (обведены) и отбросила свободный член; оценка уровня шума ${noise.toFixed(3)}. Среднеквадратичное отклонение среднего прогноза от истинной функции на отрезке данных — ${rms.toFixed(3)}. Полоса — среднее ± 2 стандартных отклонения прогноза, от ${lo.toFixed(3)} до ${hi.toFixed(3)} на отрезке данных. За краями данных (пунктирные вертикали) она не расширяется: в точке x = 15 стандартное отклонение ${far.toFixed(3)}, равное оценке шума.`
    : `One hundred points of sin x / x on an even grid from −10 to 10 with Gaussian noise 0.1, a bias and one Gaussian kernel of width 2 per point: 101 features. Maximizing the evidence over the 101 precisions and the noise precision kept ${keep.length} kernels (circled) and pruned the bias; the estimated noise level is ${noise.toFixed(3)}. The RMS distance of the predictive mean from the true function over the data range is ${rms.toFixed(3)}. The band is the mean ± 2 predictive standard deviations, between ${lo.toFixed(3)} and ${hi.toFixed(3)} over the data. Beyond the data (dashed verticals) it does not widen: at x = 15 the standard deviation is ${far.toFixed(3)}, the estimated noise level itself.`}
>
  {layouts.map((L, li) => {
    const sx = scale(dom.x, [L.x0, L.x1]), sy = scale(dom.y, [L.y1, L.y0]);
    const clip = `${id}-${L.W}-clip`;
    const N = 280;
    const grid = Array.from({ length: N + 1 }, (_, i) => dom.x[0] + ((dom.x[1] - dom.x[0]) * i) / N);
    const pr = grid.map(predict);
    const band = grid.map((x, i) => `${i ? 'L' : 'M'} ${sx(x).toFixed(2)} ${sy(pr[i].mean + 2 * pr[i].sd).toFixed(2)}`).join(' ')
      + ' ' + grid.map((_, i) => N - i).map((i) => `L ${sx(grid[i]).toFixed(2)} ${sy(pr[i].mean - 2 * pr[i].sd).toFixed(2)}`).join(' ') + ' Z';
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        <defs><clipPath id={clip}><rect x={L.x0} y={L.y0} width={L.x1 - L.x0} height={L.y1 - L.y0} /></clipPath></defs>
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {[0, 0.5, 1].map((v) => <g><path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} /><text class="f-note" x={L.x0 - 6} y={sy(v) + 4} text-anchor="end">{String(v)}</text></g>)}
        {[-10, -5, 0, 5, 10].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{String(v).replace('-', '−')}</text>)}
        {[-10, 10].map((v) => <path class="f-thin f-dash f-muted" d={`M ${sx(v)} ${L.y0} V ${L.y1}`} />)}
        <g clip-path={`url(#${clip})`}>
          <path d={band} class="f-fill-blue" />
          <path class="f-line f-muted f-dash" d={plot(sinc, dom.x[0], dom.x[1], sx, sy, 400)} />
          <path class="f-line f-blue" d={plot((x) => predict(x).mean, dom.x[0], dom.x[1], sx, sy, 400)} />
          {xs.map((x, i) => <circle cx={sx(x)} cy={sy(ts[i])} r="2" style="fill: var(--ink); fill-opacity: 0.75" />)}
          {keep.filter((k) => k > 0).map((k) => <circle cx={sx(xs[k - 1])} cy={sy(ts[k - 1])} r="6.5" style="fill: none; stroke: var(--fig-red); stroke-width: 1.8" />)}
        </g>
        {legends[li].map((e) => (
          <g>
            {e.kind === 'line' && <path class="f-line f-blue" d={`M ${e.x} ${e.y - 4} h 22`} />}
            {e.kind === 'band' && <rect x={e.x} y={e.y - 10} width="22" height="12" class="f-fill-blue" />}
            {e.kind === 'truth' && <path class="f-line f-muted f-dash" d={`M ${e.x} ${e.y - 4} h 22`} />}
            {e.kind === 'dot' && <circle cx={e.x + 11} cy={e.y - 4} r="2" style="fill: var(--ink)" />}
            {e.kind === 'ring' && <circle cx={e.x + 11} cy={e.y - 4} r="6" style="fill: none; stroke: var(--fig-red); stroke-width: 1.8" />}
            <text class="f-small" x={e.x + 28} y={e.y}>{e.label}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
