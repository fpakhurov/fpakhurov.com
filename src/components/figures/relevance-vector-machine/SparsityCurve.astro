---
import Figure from '../Figure.astro';
import { scale, plot } from '../geometry';
import { ell } from './rvm';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// ℓ(α) = ½[ln(α/(α + s)) + q²/(α + s)], the part of the log evidence that depends on one precision α, relative to α = ∞.
// In u = α/s and r = q²/s it is ½[ln(u/(1 + u)) + r/(1 + u)]: one curve per value of r.
// For r > 1 it peaks at u = 1/(r − 1); for r ≤ 1 it increases all the way to 0 at u = ∞.
const rs = [8, 2, 0.36];
const peaks = rs.map((r) => (r > 1 ? { u: 1 / (r - 1), v: ell(1 / (r - 1), r) } : null));
const chk = peaks.map((p) => (p ? `${p.u.toFixed(4)} ${p.v.toFixed(4)}` : 'none')).join(' | ');
if (chk !== '0.1429 2.4603 | 1.0000 0.1534 | none') throw new Error(`SparsityCurve: the maxima drifted (${chk})`);
// For r ≤ 1 the curve has no interior maximum: it increases on a fine grid.
for (let la = -3; la < 4; la += 0.01) if (!(ell(10 ** (la + 0.01), 0.36) > ell(10 ** la, 0.36))) throw new Error('SparsityCurve: r = 0.36 must increase');

const dom = { x: [-2, 3] as [number, number], y: [-2.5, 2.8] as [number, number] };
const t = ru
  ? {
      x: 'α / s (логарифмическая шкала)', zero: 'α = ∞',
      lab: ['q²/s = 8: максимум при α = s/7', 'q²/s = 2: максимум при α = s', 'q²/s = 0.36: лучше всего α = ∞'],
      title: 'Обоснованность как функция одной обратной дисперсии', desc: 'Три кривые: при q²/s = 8 и q²/s = 2 у обоснованности есть максимум при конечном α, при q²/s = 0.36 она растёт до нуля при α → ∞, и признак отбрасывается.',
    }
  : {
      x: 'α / s (log scale)', zero: 'α = ∞',
      lab: ['q²/s = 8: maximum at α = s/7', 'q²/s = 2: maximum at α = s', 'q²/s = 0.36: best at α = ∞'],
      title: 'The evidence as a function of one precision', desc: 'Three curves: for q²/s = 8 and q²/s = 2 the evidence has a maximum at a finite α; for q²/s = 0.36 it rises towards zero as α → ∞, and the feature is pruned.',
    };
const id = 'rvm-sparsity';
const tones = ['green', 'blue', 'red'];
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 320, x0: 56, x1: 580, y0: 20, y1: 262, leg: { x: 336, y: 38 } },
  { cls: 'fig-narrow', W: 360, H: 380, x0: 44, x1: 350, y0: 20, y1: 262, leg: { x: 44, y: 324 } },
];
const textW = (s: string) => s.length * 6.5;
for (const L of layouts) for (const s of t.lab) if (L.leg.x + 30 + textW(s) > L.W - 2) throw new Error(`SparsityCurve: "${s}" runs past the frame`);
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? 'Часть логарифма обоснованности, зависящая от обратной дисперсии αᵢ одного веса при остальных фиксированных, отсчитанная от значения при αᵢ = ∞ (пунктир). Если q² > s (зелёная и синяя кривые), максимум находится в точке αᵢ = s²/(q² − s), отмеченной кружком. Если q² ≤ s (красная, второй признак игрушечного примера), кривая растёт до самой бесконечности, и вес отбрасывается.'
    : 'The part of the log evidence that depends on one precision αᵢ, the others held fixed, measured from its value at αᵢ = ∞ (dashed). When q² > s (green, blue) the maximum is at αᵢ = s²/(q² − s), marked with a dot. When q² ≤ s (red, the second feature of the toy) the curve rises all the way, and the weight is pruned.'}
>
  {layouts.map((L) => {
    const sx = scale(dom.x, [L.x0, L.x1]), sy = scale(dom.y, [L.y1, L.y0]);
    const clip = `${id}-${L.W}-clip`;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        <defs><clipPath id={clip}><rect x={L.x0} y={L.y0} width={L.x1 - L.x0} height={L.y1 - L.y0} /></clipPath></defs>
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {[-2, -1, 0, 1, 2].map((v) => <g><path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} /><text class="f-note" x={L.x0 - 6} y={sy(v) + 4} text-anchor="end">{String(v).replace('-', '−')}</text></g>)}
        {['10⁻²', '10⁻¹', '1', '10', '10²', '10³'].map((s, i) => <text class="f-note" x={sx(i - 2)} y={L.y1 + 18} text-anchor="middle">{s}</text>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 42} text-anchor="middle">{t.x}</text>
        <path class="f-thin f-dash f-muted" d={`M ${L.x0} ${sy(0)} H ${L.x1}`} />
        <text class="f-small f-t-muted f-halo" x={L.x0 + 6} y={sy(0) - 6}>{t.zero}</text>
        <g clip-path={`url(#${clip})`}>
          {rs.map((r, i) => <path class={`f-line f-${tones[i]}`} d={plot((la) => ell(10 ** la, r), dom.x[0], dom.x[1], sx, sy, 240)} />)}
        </g>
        {peaks.map((p, i) => p && <circle cx={sx(Math.log10(p.u))} cy={sy(p.v)} r="4.5" style={`fill: var(--fig-${tones[i]})`} />)}
        {t.lab.map((s, i) => (
          <g>
            <path class={`f-line f-${tones[i]}`} d={`M ${L.leg.x} ${L.leg.y + i * 20 - 4} h 22`} />
            <text class="f-small" x={L.leg.x + 30} y={L.leg.y + i * 20}>{s}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
