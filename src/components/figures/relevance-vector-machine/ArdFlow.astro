---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Op from '../seqflow/Op.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The toy of the note: two orthogonal features φ1 = (1, 1, 2, 2), φ2 = (1, −1, −1, 1), targets t, β = 100 known,
// both precisions start at 1. Orthogonal features keep Σ diagonal, so each weight is updated on its own.
const phi1 = [1, 1, 2, 2], phi2 = [1, -1, -1, 1], tv = [1.05, 0.92, 2.03, 2.02], beta = 100;
const dot = (a: number[], b: number[]) => a.reduce((s, v, i) => s + v * b[i], 0);
if (dot(phi1, phi2) !== 0) throw new Error('ArdFlow: the features must be orthogonal');
const sv = [beta * dot(phi1, phi1), beta * dot(phi2, phi2)], qv = [beta * dot(phi1, tv), beta * dot(phi2, tv)];
const step = (al: number[]) => {
  const Sd = al.map((a, i) => 1 / (a + sv[i]));
  const mu = Sd.map((s, i) => s * qv[i]);
  const g = al.map((a, i) => 1 - a * Sd[i]);
  return { Sd, mu, g, next: g.map((v, i) => v / mu[i] ** 2) };
};
const first = step([1, 1]);
const a2: number[] = [];
let al = [1, 1], crossed = 0;
for (let k = 1; k <= 40; k++) {
  al = step(al).next;
  a2.push(al[1]);
  if (!crossed && al[1] > 1e9) crossed = k;
}
const alpha1 = sv[0] ** 2 / (qv[0] ** 2 - sv[0]);
const chk = [Math.round(qv[0]), Math.round(qv[1]), first.mu[0].toFixed(3), first.mu[1].toFixed(4), first.g[0].toFixed(3), first.g[1].toFixed(4), first.next[0].toFixed(3), first.next[1].toFixed(1), a2[1].toFixed(1), a2[2].toFixed(1), crossed, alpha1.toFixed(4), al[0].toFixed(4)].join(' ');
if (chk !== '1007 12 1.006 0.0299 0.999 0.9975 0.987 1113.9 4205.2 12792.4 14 0.9871 0.9871') throw new Error(`ArdFlow: the toy drifted (${chk})`);
const big = (v: number) => (ru ? Math.round(v).toLocaleString('ru-RU').replace(/\s/g, ' ') : Math.round(v).toLocaleString('en-US'));
const seq = [big(a2[0]), big(a2[1]), big(a2[2]), '…', `${(a2[crossed - 1] / 1e9).toFixed(1)}·10⁹`];
const m = (s: string) => s.replace(/-/g, '−');

const t = ru
  ? {
      title: 'Автоматическое определение релевантности: своя обратная дисперсия у каждого веса',
      prior: 'по одной на вес', repeat: 'повторить', pruned: `φ₂ отброшен после ${crossed} обновлений`,
      steps: ['апостериорное распределение при текущих обратных дисперсиях', 'насколько вес определён данными: γᵢ = 1 − αᵢΣᵢᵢ', 'новые обратные дисперсии αᵢ = γᵢ/μᵢ², и всё повторяется', 'α₂ растёт неограниченно: φ₂ отбрасывается'],
      desc: 'Два ортогональных признака, четыре точки, β = 100, начальные обратные дисперсии (1, 1). Апостериорная ковариация diag(1/1001, 1/401), среднее (1.006, 0.030), γ = (0.999, 0.998), новые обратные дисперсии (0.987, 1114). При повторении α₁ остаётся 0.987, а α₂ растёт примерно в 2.8 раза за шаг и после 14 обновлений превышает 10⁹: вес второго признака равен нулю.',
    }
  : {
      title: 'Automatic relevance determination: one precision per weight',
      prior: 'one per weight', repeat: 'repeat', pruned: `φ₂ pruned after ${crossed} updates`,
      steps: ['the posterior for the current precisions', 'how well each weight is determined: γᵢ = 1 − αᵢΣᵢᵢ', 'new precisions αᵢ = γᵢ/μᵢ², then repeat', 'α₂ grows without bound: φ₂ is pruned'],
      desc: 'Two orthogonal features, four points, β = 100, starting precisions (1, 1). The posterior covariance is diag(1/1001, 1/401), the mean (1.006, 0.030), γ = (0.999, 0.998), and the new precisions (0.987, 1114). On repetition α₁ stays at 0.987 while α₂ grows by about 2.8 per step and passes 10⁹ after 14 updates: the second feature gets weight zero.',
    };
const id = 'rvm-ard-flow';
const caption = ru
  ? `Два ортогональных признака, четыре точки, известное β = 100, начальные обратные дисперсии (1, 1). Зелёным — данные, жёлтым — априорные обратные дисперсии, синим — апостериорное распределение, красным — итог. Первый признак почти совпадает с t, и его обратная дисперсия сразу устанавливается на ${alpha1.toFixed(3)} = s₁²/(q₁² − s₁). Второй объясняет только шум, и α₂ растёт, пока его вес не прижмётся к нулю.`
  : `Two orthogonal features, four points, a known β = 100, starting precisions (1, 1). Green: the data; amber: the prior precisions; blue: the posterior; red: the result. The first feature nearly equals t, and its precision settles at once at ${alpha1.toFixed(3)} = s₁²/(q₁² − s₁). The second fits only noise, and α₂ grows until its weight is pinned at zero.`;
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 370" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <Vec x={20} y={60} values={phi1.map(String)} tone="x" label="φ_1" />
    <Vec x={70} y={60} values={phi2.map((v) => m(String(v)))} tone="x" label="φ_2" />
    <Vec x={120} y={60} values={tv.map((v) => v.toFixed(2))} tone="x" cw={48} label="t" />
    <Box x={210} y={24} w={160} h={44} label="α = (1, 1)" sub={t.prior} tone="g" />
    <g data-s="1">
      <Arrow pts={[[170, 126], [198, 126]]} />
      <Arrow pts={[[290, 68], [290, 102]]} tone="amber" />
      <Box x={200} y={104} w={200} h={44} label="Σ = diag(1/1001, 1/401)" tone="h" />
      <Arrow pts={[[400, 126], [428, 126]]} />
      <Vec x={430} y={115} values={first.mu.map((v) => v.toFixed(3))} tone="h" dir="row" cw={56} label="μ" labelPos="above" />
      <Badge x={200} y={104} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[300, 148], [300, 186]]} tone="blue" />
      <Op x={300} y={200} sym="γᵢ = 1 − αᵢΣᵢᵢ" />
      <Arrow pts={[[361, 200], [428, 200]]} />
      <Vec x={430} y={189} values={first.g.map((v) => v.toFixed(3))} tone="h" dir="row" cw={56} label="γ" labelPos="below" />
      <Badge x={224} y={200} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[544, 126], [620, 126], [620, 187]]} tone="blue" />
      <Arrow pts={[[544, 200], [581, 200]]} tone="blue" />
      <Op x={620} y={200} sym="γᵢ / μᵢ²" />
      <Arrow pts={[[620, 213], [620, 248]]} />
      <Vec x={592} y={250} values={[first.next[0].toFixed(3), big(first.next[1])]} tone="g" dir="row" cw={56} label="α" labelPos="left" />
      <Arrow pts={[[706, 261], [740, 261], [740, 46], [372, 46]]} tone="amber" dashed />
      <text class="f-small f-t-amber f-halo" x="560" y="40" text-anchor="middle">{t.repeat}</text>
      <Badge x={672} y={200} n={3} />
    </g>
    <g data-s="4">
      <Vec x={130} y={310} values={seq} tone="g" dir="row" cw={64} label="α_2" labelPos="left" />
      <Arrow pts={[[452, 321], [500, 321]]} />
      <Vec x={540} y={310} values={['1.006', '0']} tone="y" dir="row" cw={56} label="w" labelPos="left" />
      <text class="f-small f-t-muted" x="130" y="356">{`${t.pruned}; α₁ → ${al[0].toFixed(3)} = s₁²/(q₁² − s₁)`}</text>
      <Badge x={60} y={321} n={4} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 630" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <Vec x={60} y={20} values={phi1.map(String)} tone="x" dir="row" cw={52} label="φ_1" labelPos="left" />
    <Vec x={60} y={52} values={phi2.map((v) => m(String(v)))} tone="x" dir="row" cw={52} label="φ_2" labelPos="left" />
    <Vec x={60} y={84} values={tv.map((v) => v.toFixed(2))} tone="x" dir="row" cw={52} label="t" labelPos="left" />
    <Box x={196} y={124} w={144} h={44} label="α = (1, 1)" sub={t.prior} tone="g" />
    <g data-s="1">
      <Arrow pts={[[100, 106], [100, 198]]} />
      <Arrow pts={[[250, 168], [250, 198]]} tone="amber" />
      <Box x={20} y={200} w={260} h={44} label="Σ = diag(1/1001, 1/401)" tone="h" />
      <Arrow pts={[[100, 244], [100, 268]]} />
      <Vec x={60} y={270} values={first.mu.map((v) => v.toFixed(3))} tone="h" dir="row" cw={60} label="μ" labelPos="left" />
      <Badge x={16} y={200} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[230, 244], [230, 316]]} tone="blue" />
      <Op x={180} y={330} sym="γᵢ = 1 − αᵢΣᵢᵢ" />
      <Arrow pts={[[150, 343], [150, 368]]} />
      <Vec x={60} y={370} values={first.g.map((v) => v.toFixed(3))} tone="h" dir="row" cw={60} label="γ" labelPos="left" />
      <Badge x={108} y={330} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[150, 392], [150, 407]]} tone="blue" />
      <Arrow pts={[[70, 292], [70, 302], [30, 302], [30, 420], [141, 420]]} tone="blue" />
      <Op x={180} y={420} sym="γᵢ / μᵢ²" />
      <Arrow pts={[[150, 433], [150, 458]]} />
      <Vec x={60} y={460} values={[first.next[0].toFixed(3), big(first.next[1])]} tone="g" dir="row" cw={60} label="α" labelPos="left" />
      <Arrow pts={[[180, 471], [350, 471], [350, 146], [342, 146]]} tone="amber" dashed />
      <Badge x={232} y={420} n={3} />
    </g>
    <g data-s="4">
      <Vec x={48} y={520} values={seq} tone="g" dir="row" cw={60} label="α_2" labelPos="left" />
      <Arrow pts={[[100, 542], [100, 568]]} />
      <Vec x={60} y={570} values={['1.006', '0']} tone="y" dir="row" cw={60} label="w" labelPos="left" />
      <text class="f-small f-t-muted" x="20" y="616">{t.pruned}</text>
      <Badge x={20} y={581} n={4} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
