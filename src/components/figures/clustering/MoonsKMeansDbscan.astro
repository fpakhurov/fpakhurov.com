---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { moons, lloyd, dbscan, ari, voronoiCell, type P } from './clusterData';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// 200 points on two interleaving half circles with Gaussian noise of standard deviation 0.07 (seed 1).
// Left: k-means with K = 2, started from the first two points. Right: DBSCAN with ε = 0.2 and minPts = 5.
const { pts, lab } = moons(1, 200, 0.07);
const km = lloyd(pts, [pts[0], pts[1]]);
const kmFinal = km[km.length - 1];
const kmAri = ari(lab, kmFinal.c);
const eps = 0.2, minPts = 5;
const db = dbscan(pts, eps, minPts);
const dbAri = ari(lab, db.lab);
const noise = db.lab.filter((v) => v < 0).length, border = db.lab.filter((v, i) => v >= 0 && !db.core[i]).length;
if (kmAri.toFixed(2) !== '0.28' || dbAri.toFixed(2) !== '0.96') throw new Error('MoonsKMeansDbscan: ARI drifted from the note');
if (db.clusters !== 2 || noise !== 4 || border !== 3) throw new Error('MoonsKMeansDbscan: DBSCAN result drifted from the note');

const dom = { x: [-1.4, 2.4] as [number, number], y: [-0.9, 1.4] as [number, number] };
const tones = ['blue', 'red'];
// The ε-ball is drawn around the core point nearest to (−0.7, 0.7), on the upper moon.
const ballAt = pts.reduce((best, p, i) => (db.core[i] && (p[0] + 0.7) ** 2 + (p[1] - 0.7) ** 2 < (pts[best][0] + 0.7) ** 2 + (pts[best][1] - 0.7) ** 2 ? i : best), pts.findIndex((_, i) => db.core[i]));
const t = ru
  ? { km: `k-средних, K = 2: ARI ${kmAri.toFixed(2)}`, db: `DBSCAN, ε = ${eps}, minPts = ${minPts}: ARI ${dbAri.toFixed(2)}`, core: 'основная', border: 'граничная', noise: 'шум' }
  : { km: `k-means, K = 2: ARI ${kmAri.toFixed(2)}`, db: `DBSCAN, ε = ${eps}, minPts = ${minPts}: ARI ${dbAri.toFixed(2)}`, core: 'core', border: 'border', noise: 'noise' };
const id = 'moons-kmeans-dbscan';
// Panel boxes [x, y, width, height]; the data box is 3.8 × 2.3.
const layouts = [
  { cls: 'fig-wide', W: 760, H: 290, boxes: [[10, 30, 362, 219.1], [388, 30, 362, 219.1]], leg: [398, 272] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 560, boxes: [[6, 30, 348, 210.6], [6, 296, 348, 210.6]], leg: [16, 530] },
];
---

<Figure
  id={id}
  title={ru ? 'Две луны: k-средних против DBSCAN' : 'Two moons: k-means against DBSCAN'}
  caption={ru
    ? `200 точек на двух переплетённых полуокружностях с шумом 0.07. k-средних делит плоскость прямой — серединным перпендикуляром к отрезку между двумя центроидами, — поэтому режет каждую луну пополам: скорректированный индекс Рэнда с истинной разметкой ${kmAri.toFixed(2)}. DBSCAN объединяет точки, связанные цепочками ε-окрестностей (пунктирный круг — одна такая окрестность): основных точек ${pts.length - noise - border} (в окрестности не меньше ${minPts} точек, включая саму точку), граничных ${border} (полые кружки), точек шума ${noise} (крестики). Две луны найдены целиком; ARI ${dbAri.toFixed(2)} меньше 1 только из-за точек шума.`
    : `200 points on two interleaving half circles with noise 0.07. k-means splits the plane by a straight line, the perpendicular bisector of the two centroids, so it cuts each moon in half: the adjusted Rand index against the true labels is ${kmAri.toFixed(2)}. DBSCAN joins points linked by chains of ε-neighbourhoods (the dashed circle is one of them): ${pts.length - noise - border} core points (at least ${minPts} points within ε, the point itself included), ${border} border points (hollow) and ${noise} noise points (crosses). Both moons are found whole; the ARI of ${dbAri.toFixed(2)} is below 1 only because of the noise points.`}
>
  {layouts.map((L) => {
    const panel = (i: number) => {
      const [bx, by, bw, bh] = L.boxes[i];
      return { bx, by, bw, bh, sx: scale(dom.x, [bx, bx + bw]), sy: scale(dom.y, [by + bh, by]) };
    };
    const A = panel(0), B = panel(1);
    const cellsA = kmFinal.mu.map((_, k) => voronoiCell(kmFinal.mu, k, dom.x[0], dom.x[1], dom.y[0], dom.y[1]));
    const r = (B.sx(eps) - B.sx(0));
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'k-средних и DBSCAN на двух лунах' : 'k-means and DBSCAN on two moons'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Слева k-средних разрезает обе луны прямой; справа DBSCAN выделяет каждую луну целиком и помечает четыре точки как шум.' : 'Left: k-means cuts both moons with a straight line. Right: DBSCAN finds each moon whole and marks four points as noise.'}</desc>
        <text class="f-small" x={A.bx + A.bw / 2} y={A.by - 10} text-anchor="middle">{t.km}</text>
        {cellsA.map((cell, k) => <path d={`${polyline(cell.map((p) => [A.sx(p[0]), A.sy(p[1])]))} Z`} style={`fill: var(--fig-${tones[k]}); fill-opacity: .07; stroke: var(--muted); stroke-width: .9`} />)}
        <rect x={A.bx} y={A.by} width={A.bw} height={A.bh} class="f-grid" />
        {pts.map((p, j) => <circle cx={A.sx(p[0]).toFixed(1)} cy={A.sy(p[1]).toFixed(1)} r="2.4" style={`fill: var(--fig-${tones[kmFinal.c[j]]}); fill-opacity: .75`} />)}
        {kmFinal.mu.map((m, k) => <circle cx={A.sx(m[0]).toFixed(1)} cy={A.sy(m[1]).toFixed(1)} r="6" style={`fill: var(--fig-${tones[k]}); stroke: var(--paper); stroke-width: 2`} />)}

        <text class="f-small" x={B.bx + B.bw / 2} y={B.by - 10} text-anchor="middle">{t.db}</text>
        <rect x={B.bx} y={B.by} width={B.bw} height={B.bh} class="f-grid" />
        <circle cx={B.sx(pts[ballAt][0])} cy={B.sy(pts[ballAt][1])} r={r} class="f-thin f-amber f-dash" />
        {pts.map((p, j) => {
          const c = db.lab[j], x = B.sx(p[0]), y = B.sy(p[1]);
          if (c === -1) return <path d={`M ${x - 3.5} ${y - 3.5} L ${x + 3.5} ${y + 3.5} M ${x - 3.5} ${y + 3.5} L ${x + 3.5} ${y - 3.5}`} class="f-thin f-muted" style="stroke-width: 1.6" />;
          return db.core[j]
            ? <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="2.4" style={`fill: var(--fig-${tones[c]}); fill-opacity: .75`} />
            : <circle cx={x.toFixed(1)} cy={y.toFixed(1)} r="3" style={`fill: var(--paper); stroke: var(--fig-${tones[c]}); stroke-width: 1.5`} />;
        })}
        <g>
          <circle cx={L.leg[0]} cy={L.leg[1] - 4} r="2.6" style="fill: var(--ink); fill-opacity: .75" />
          <text class="f-small" x={L.leg[0] + 9} y={L.leg[1]}>{t.core}</text>
          <circle cx={L.leg[0] + 70} cy={L.leg[1] - 4} r="3" style="fill: var(--paper); stroke: var(--ink); stroke-width: 1.5" />
          <text class="f-small" x={L.leg[0] + 79} y={L.leg[1]}>{t.border}</text>
          <path d={`M ${L.leg[0] + 156} ${L.leg[1] - 7.5} l 7 7 M ${L.leg[0] + 156} ${L.leg[1] - 0.5} l 7 -7`} class="f-thin f-muted" style="stroke-width: 1.6" />
          <text class="f-small" x={L.leg[0] + 169} y={L.leg[1]}>{t.noise}</text>
          <path d={`M ${L.leg[0] + 222} ${L.leg[1] - 4} h 22`} class="f-thin f-amber f-dash" />
          <text class="f-small" x={L.leg[0] + 250} y={L.leg[1]}>ε</text>
        </g>
      </svg>
    );
  })}
</Figure>
