---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { blobs, lloyd, voronoiCell, ari, type P } from './clusterData';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Lloyd's algorithm on 150 points from three Gaussian blobs (centres (−2.2, 1), (2.2, 1.4), (0.3, −1.9), standard
// deviation 0.7, seed 8), started from three data points of which two lie in the left blob. Each panel shows the
// centroids of one iteration, the cells of points nearest to each centroid, and the objective J of that assignment.
const { pts, lab } = blobs(8, [[-2.2, 1.0], [2.2, 1.4], [0.3, -1.9]], [0.7, 0.7, 0.7], [50, 50, 50]);
const hist = lloyd(pts, [pts[0], pts[1], pts[60]]);
const shown = [0, 1, 3, 5];
const Js = hist.map((h) => h.J);
if (hist.length !== 6) throw new Error('KMeansIterations: expected convergence after 5 updates');
if (shown.map((t) => Js[t].toFixed(1)).join() !== '821.0,476.7,158.1,144.6') throw new Error('KMeansIterations: J values drifted from the note');
if (!Js.every((J, t) => t === 0 || J <= Js[t - 1])) throw new Error('KMeansIterations: J must not increase');
const finalAri = ari(lab, hist[hist.length - 1].c);
if (finalAri !== 1) throw new Error('KMeansIterations: the final clustering should recover the three blobs');

const tones = ['blue', 'red', 'green'];
const dom = { x: [-4, 4] as [number, number], y: [-4, 3] as [number, number] };
const t = ru
  ? { titles: ['начало', 'итерация 1', 'итерация 3', 'итерация 5, сошлось'] }
  : { titles: ['start', 'iteration 1', 'iteration 3', 'iteration 5, converged'] };
const id = 'kmeans-iterations';
// Panel boxes: [x, y, width, height] in viewBox units; the data box is 8 × 7, so width / height = 8 / 7.
const layouts = [
  { cls: 'fig-wide', W: 760, H: 222, boxes: [0, 1, 2, 3].map((i) => [12 + i * 188, 30, 172, 150.5]) },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 418, boxes: [0, 1, 2, 3].map((i) => [6 + (i % 2) * 178, 30 + Math.floor(i / 2) * 206, 170, 148.75]) },
];
const panels = shown.map((s) => {
  const h = hist[s];
  const cells = h.mu.map((_, k) => voronoiCell(h.mu, k, dom.x[0], dom.x[1], dom.y[0], dom.y[1]));
  const trail = h.mu.map((_, k) => hist.slice(0, s + 1).map((r) => r.mu[k]));
  return { s, h, cells, trail: s === 0 ? [] : trail };
});
---

<Figure
  id={id}
  title={ru ? 'Алгоритм Ллойда: назначение и пересчёт центров' : "Lloyd's algorithm: assign, then move the centroids"}
  caption={ru
    ? `150 точек из трёх гауссовских облаков (стандартное отклонение 0.7). Старт — три точки выборки, две из них в левом облаке. На каждой панели: центроиды (крупные кружки) с пройденным путём, области точек, ближайших к каждому центроиду, и цвет точки — её кластер. Целевая функция J — сумма квадратов расстояний до своего центроида — не возрастает: ${shown.map((s) => Js[s].toFixed(1)).join(' → ')}. Синий центроид за три итерации переходит из левого облака в нижнее; после пятой итерации назначения не меняются, и кластеры совпадают с облаками.`
    : `150 points from three Gaussian blobs (standard deviation 0.7). The start is three data points, two of them in the left blob. Each panel shows the centroids (large dots) with the path they have travelled, the cells of points nearest to each centroid, and each point coloured by its cluster. The objective J, the sum of squared distances to the own centroid, never increases: ${shown.map((s) => Js[s].toFixed(1)).join(' → ')}. The blue centroid travels from the left blob to the bottom one in three iterations; after the fifth the assignments stop changing and the clusters are the blobs.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Четыре шага алгоритма k-средних' : 'Four stages of k-means'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? `Четыре панели с облаком точек и тремя центроидами; J уменьшается: ${shown.map((s) => Js[s].toFixed(1)).join(', ')}.` : `Four panels of a point cloud with three centroids; J decreases: ${shown.map((s) => Js[s].toFixed(1)).join(', ')}.`}</desc>
      {panels.map((pn, i) => {
        const [bx, by, bw, bh] = L.boxes[i];
        const sx = scale(dom.x, [bx, bx + bw]), sy = scale(dom.y, [by + bh, by]);
        const S = (p: P) => [sx(p[0]), sy(p[1])] as [number, number];
        return (
          <g>
            <text class="f-small" x={bx + bw / 2} y={by - 9} text-anchor="middle">{t.titles[i]}</text>
            {pn.cells.map((cell, k) => (
              <path d={`${polyline(cell.map(S))} Z`} style={`fill: var(--fig-${tones[k]}); fill-opacity: .07; stroke: var(--muted); stroke-width: .8; stroke-opacity: .6`} />
            ))}
            <rect x={bx} y={by} width={bw} height={bh} class="f-grid" />
            {pts.map((p, j) => (
              <circle cx={sx(p[0]).toFixed(1)} cy={sy(p[1]).toFixed(1)} r="2.1" style={`fill: var(--fig-${tones[pn.h.c[j]]}); fill-opacity: .7`} />
            ))}
            {pn.trail.map((tr, k) => <path d={polyline(tr.map(S))} class={`f-thin f-${tones[k]} f-dash`} />)}
            {pn.h.mu.map((m, k) => (
              <circle cx={sx(m[0]).toFixed(1)} cy={sy(m[1]).toFixed(1)} r="5.5" style={`fill: var(--fig-${tones[k]}); stroke: var(--paper); stroke-width: 1.8`} />
            ))}
            <text class="f-small f-t-muted" x={bx + bw / 2} y={by + bh + 19} text-anchor="middle">{`J = ${pn.h.J.toFixed(1)}`}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
