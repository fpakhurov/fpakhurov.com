---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// From a run to production. A run starts from pinned versions of code, data, configuration and environment, logs its
// parameters, metrics and model, and the model is registered as a new version of a named model that keeps a link back
// to the run. Deployment never names a file: it loads the version an alias points to, so promotion and rollback are
// both moves of the alias. A schematic: the run identifiers are made up; its parameters and accuracy are those of the
// first run of the Example section of the note.
const versions = [{ v: 1, run: '5a0b' }, { v: 2, run: '9d3f' }, { v: 3, run: '7c1e' }];
const champion = { before: 2, after: 3 };
if (versions[versions.length - 1].v !== champion.after) throw new Error('the new version is the last one');
const t = ru
  ? {
      title: 'От запуска к инференсу: отслеживание экспериментов, реестр моделей и псевдоним',
      inputs: [['код', 'коммит 4f2a9c1'], ['данные', 'снимок 2026-10-01'], ['конфигурация', 'params.yaml'], ['окружение', 'lockfile + образ']],
      run: 'запуск 7c1e', keys: ['параметры', 'метрики', 'артефакт'], vals: ['seed=0, trees=50', 'accuracy 0.947', 'model.pkl'],
      reg: 'реестр: cancer-rf', register: 'в реестр', alias: 'champion', move: 'перенос',
      serve: 'инференс', serveSub: '@champion', rollback: 'откат: вернуть псевдоним на v2',
      steps: [
        'запуск фиксирует версии кода, данных, конфигурации и окружения, с которых начался',
        'запуск записывает параметры и метрики, а обученную модель — как артефакт',
        'модель регистрируется как версия 3 модели cancer-rf со ссылкой на свой запуск',
        'после проверок псевдоним champion переносится с версии 2 на версию 3',
        'инференс загружает cancer-rf@champion; откат — перенос псевдонима обратно на версию 2',
      ],
      desc: 'Слева четыре входа запуска: код, данные, конфигурация, окружение. В центре запуск с параметрами, метриками и артефактом модели. Справа реестр моделей cancer-rf с версиями 1, 2 и 3, каждая со ссылкой на свой запуск; псевдоним champion переносится с версии 2 на версию 3. Крайний справа блок — инференс, который загружает модель по псевдониму.',
    }
  : {
      title: 'From a run to serving: tracking, the model registry and an alias',
      inputs: [['code', 'commit 4f2a9c1'], ['data', 'snapshot 2026-10-01'], ['config', 'params.yaml'], ['environment', 'lockfile + image']],
      run: 'run 7c1e', keys: ['params', 'metrics', 'artifact'], vals: ['seed=0, trees=50', 'accuracy 0.947', 'model.pkl'],
      reg: 'registry: cancer-rf', register: 'register', alias: 'champion', move: 'move',
      serve: 'serving', serveSub: '@champion', rollback: 'rollback: move the alias back to v2',
      steps: [
        'a run records the versions of code, data, configuration and environment it started from',
        'the run logs its parameters and metrics, and the trained model as an artifact',
        'the model is registered as version 3 of cancer-rf, with a link back to its run',
        'after validation, the alias champion moves from version 2 to version 3',
        'serving loads cancer-rf@champion; a rollback moves the alias back to version 2',
      ],
      desc: 'On the left, the four inputs of a run: code, data, configuration and environment. In the middle, the run with its parameters, metrics and model artifact. On the right, the model registry of cancer-rf with versions 1, 2 and 3, each linked to its run; the alias champion moves from version 2 to version 3. At the far right, serving, which loads the model by the alias.',
    };
const id = 'run-to-registry';
const caption = ru
  ? 'Каждый запуск начинается с зафиксированных версий кода, данных, конфигурации и окружения (1) и записывает параметры, метрики и модель (2). Выбранная модель становится новой неизменяемой версией именованной модели в реестре и хранит ссылку на свой запуск, а через него — на коммит и снимок данных (3). Инференс не ссылается на файл: он загружает версию, на которую указывает псевдоним champion. Продвижение — это перенос псевдонима после проверок (4), откат — перенос обратно (5).'
  : 'Every run starts from pinned versions of code, data, configuration and environment (1) and logs its parameters, metrics and model (2). The chosen model becomes a new immutable version of a named model in the registry and keeps a link to its run, and through it to the commit and the data snapshot (3). Serving never names a file: it loads the version the alias champion points to. Promotion is a move of the alias after validation (4), rollback a move back (5).';

const fits = (s: string, room: number, px: number) => {
  if (s.length * px > room) throw new Error(`"${s}" needs ${Math.round(s.length * px)} px, has ${room}`);
};
// Wide geometry.
const inX = 16, inW = 140, inH = 44, inY = [22, 78, 134, 190];
const run = { x: 186, y: 70, w: 196, h: 120 };
const reg = { x: 452, y: 30, w: 178, h: 196 };
const rowX = reg.x + 10, rowW = 92, rowH = 28, rowY = [74, 120, 166];
const tagX = rowX + rowW + 8, tagW = 62;
const srv = { x: 660, y: 157, w: 88, h: 46 };
t.inputs.forEach(([l, s]) => { fits(l, inW - 12, 7.5); fits(s, inW - 12, 6.5); fits(l, 160, 8.0); fits(s, 160, 7.3); });
fits(t.run, run.w - 20, 7.5);
t.keys.forEach((k, i) => { fits(k, 74, 6.5); fits(t.vals[i], run.w - 86, 6.5); });
fits(t.reg, reg.w - 16, 7.5);
fits(t.alias, tagW - 10, 6.5);
fits(t.serve, srv.w - 10, 7.5); fits(t.serveSub, srv.w - 10, 6.5);
fits(t.rollback, 760 - 8 - reg.x, 6.5);
fits(t.register, reg.x - 4 - (run.x + run.w + 4), 6.5);
if (tagX + tagW > reg.x + reg.w - 4) throw new Error('alias tag outside the registry');
if (srv.x + srv.w + 10 > 760) throw new Error('serving box');
// Narrow geometry: the same parts stacked.
const nIn = [[10, 34], [184, 34], [10, 88], [184, 88]];
const nRun = { x: 30, y: 168, w: 300, h: 104 };
const nReg = { x: 30, y: 312, w: 300, h: 176 };
const nRowX = nReg.x + 30, nRowW = 112, nRowY = [354, 398, 442];
const nTagX = nRowX + nRowW + 14, nTagW = 90;
const nSrv = { x: 100, y: 530, w: 160, h: 48 };
if (nTagX + nTagW > nReg.x + nReg.w - 4) throw new Error('narrow alias tag');
if (nTagX + nTagW / 2 < nSrv.x + 8 || nTagX + nTagW / 2 > nSrv.x + nSrv.w - 8) throw new Error('narrow serving arrow misses the box');
fits(t.alias, nTagW - 10, 7.3);
fits(t.rollback, 340, 7.3);
t.keys.forEach((k, i) => fits(k + ' ' + t.vals[i], nRun.w - 20, ru ? 8.2 : 7.3));
const vLabel = (v: { v: number; run: string }) => `v${v.v} ← ${v.run}`;
versions.forEach((v) => { fits(vLabel(v), rowW - 10, 6.5); fits(vLabel(v), nRowW - 10, 7.3); });
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 270" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <rect x={reg.x} y={reg.y} width={reg.w} height={reg.h} rx="9" style="fill: var(--fig-blue); fill-opacity: 0.06; stroke: var(--fig-blue); stroke-width: 1.3" />
    <text class="f-label" x={reg.x + 12} y={reg.y + 24} style="font-weight: 650">{t.reg}</text>
    {versions.slice(0, -1).map((v, i) => (
      <g>
        <rect x={rowX} y={rowY[i]} width={rowW} height={rowH} rx="5" style="fill: var(--paper-strong); stroke: var(--line); stroke-width: 1.2" />
        <text class="f-small" x={rowX + 8} y={rowY[i] + 18}>{vLabel(v)}</text>
      </g>
    ))}
    <g data-s="1">
      {t.inputs.map(([l, s], i) => <Box x={inX} y={inY[i]} w={inW} h={inH} label={l} sub={s} tone="x" />)}
      {inY.map((y) => <Arrow pts={[[inX + inW + 2, y + inH / 2], [run.x - 18, y + inH / 2], [run.x - 18, run.y + run.h / 2], [run.x - 2, run.y + run.h / 2]]} />)}
      <rect x={run.x} y={run.y} width={run.w} height={run.h} rx="9" style="fill: var(--fig-blue); fill-opacity: 0.12; stroke: var(--fig-blue); stroke-width: 1.3" />
      <text class="f-label" x={run.x + 12} y={run.y + 24} style="font-weight: 650">{t.run}</text>
      <Badge x={run.x + run.w} y={run.y} n={1} />
    </g>
    <g data-s="2">
      {t.keys.map((k, i) => (
        <g>
          <text class="f-small f-t-muted" x={run.x + 12} y={run.y + 52 + i * 24}>{k}</text>
          <text class="f-small" x={run.x + 86} y={run.y + 52 + i * 24}>{t.vals[i]}</text>
        </g>
      ))}
      <Badge x={run.x + 12} y={run.y + run.h} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[run.x + run.w + 2, run.y + run.h - 24], [rowX - 22, run.y + run.h - 24], [rowX - 22, rowY[2] + rowH / 2], [rowX - 2, rowY[2] + rowH / 2]]} tone="blue" />
      <text class="f-small f-t-blue f-halo" x={run.x + run.w + 4} y={run.y + run.h - 30}>{t.register}</text>
      <rect x={rowX} y={rowY[2]} width={rowW} height={rowH} rx="5" style="fill: var(--fig-amber); fill-opacity: 0.16; stroke: var(--fig-amber); stroke-width: 1.5" />
      <text class="f-small" x={rowX + 8} y={rowY[2] + 18} style="font-weight: 650">{vLabel(versions[2])}</text>
      <Badge x={rowX} y={rowY[2] + rowH} n={3} />
    </g>
    <g data-s="4">
      <rect x={tagX} y={rowY[champion.before - 1] + 4} width={tagW} height={rowH - 8} rx="10" style="fill: none; stroke: var(--muted); stroke-width: 1.2; stroke-dasharray: 4 3" />
      <text class="f-small f-t-muted" x={tagX + tagW / 2} y={rowY[champion.before - 1] + 18} text-anchor="middle">{t.alias}</text>
      <rect x={tagX} y={rowY[champion.after - 1] + 4} width={tagW} height={rowH - 8} rx="10" style="fill: var(--fig-green); fill-opacity: 0.2; stroke: var(--fig-green); stroke-width: 1.5" />
      <text class="f-small" x={tagX + tagW / 2} y={rowY[champion.after - 1] + 18} text-anchor="middle" style="font-weight: 650">{t.alias}</text>
      <Arrow pts={[[tagX + tagW / 2, rowY[champion.before - 1] + rowH - 2], [tagX + tagW / 2, rowY[champion.after - 1] + 2]]} tone="green" />
      <text class="f-small f-t-green f-halo" x={tagX + tagW / 2 + 6} y={(rowY[champion.before - 1] + rowH + rowY[champion.after - 1]) / 2 + 4}>{t.move}</text>
      <Badge x={tagX + tagW + 8} y={rowY[champion.before - 1] + 4} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[tagX + tagW + 2, rowY[champion.after - 1] + rowH / 2], [srv.x - 2, rowY[champion.after - 1] + rowH / 2]]} tone="red" />
      <Box x={srv.x} y={srv.y} w={srv.w} h={srv.h} label={t.serve} sub={t.serveSub} tone="y" />
      <text class="f-small f-t-muted" x={reg.x} y={reg.y + reg.h + 24}>{t.rollback}</text>
      <Badge x={srv.x + srv.w} y={srv.y} n={5} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 640" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <rect x={nReg.x} y={nReg.y} width={nReg.w} height={nReg.h} rx="9" style="fill: var(--fig-blue); fill-opacity: 0.06; stroke: var(--fig-blue); stroke-width: 1.3" />
    <text class="f-label" x={nReg.x + 14} y={nReg.y + 26} style="font-weight: 650">{t.reg}</text>
    {versions.slice(0, -1).map((v, i) => (
      <g>
        <rect x={nRowX} y={nRowY[i]} width={nRowW} height={rowH + 2} rx="5" style="fill: var(--paper-strong); stroke: var(--line); stroke-width: 1.2" />
        <text class="f-small" x={nRowX + 8} y={nRowY[i] + 20}>{vLabel(v)}</text>
      </g>
    ))}
    <g data-s="1">
      {t.inputs.map(([l, s], i) => <Box x={nIn[i][0]} y={nIn[i][1]} w={166} h={46} label={l} sub={s} tone="x" />)}
      <Arrow pts={[[180, 136], [180, nRun.y - 2]]} />
      <rect x={nRun.x} y={nRun.y} width={nRun.w} height={nRun.h} rx="9" style="fill: var(--fig-blue); fill-opacity: 0.12; stroke: var(--fig-blue); stroke-width: 1.3" />
      <text class="f-label" x={nRun.x + 14} y={nRun.y + 26} style="font-weight: 650">{t.run}</text>
      <Badge x={nRun.x + nRun.w} y={nRun.y} n={1} />
    </g>
    <g data-s="2">
      {t.keys.map((k, i) => (
        <g>
          <text class="f-small f-t-muted" x={nRun.x + 14} y={nRun.y + 50 + i * 20}>{k}</text>
          <text class="f-small" x={nRun.x + 14 + (k.length + 1) * (ru ? 8.2 : 7.3)} y={nRun.y + 50 + i * 20}>{t.vals[i]}</text>
        </g>
      ))}
      <Badge x={nRun.x} y={nRun.y + nRun.h} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[nReg.x + 14, nRun.y + nRun.h + 2], [nReg.x + 14, nRowY[2] + 15], [nRowX - 2, nRowY[2] + 15]]} tone="blue" />
      <text class="f-small f-t-blue f-halo" x={nReg.x + 22} y={nRun.y + nRun.h + 26}>{t.register}</text>
      <rect x={nRowX} y={nRowY[2]} width={nRowW} height={rowH + 2} rx="5" style="fill: var(--fig-amber); fill-opacity: 0.16; stroke: var(--fig-amber); stroke-width: 1.5" />
      <text class="f-small" x={nRowX + 8} y={nRowY[2] + 20} style="font-weight: 650">{vLabel(versions[2])}</text>
      <Badge x={nRowX + nRowW} y={nRowY[2] + rowH + 2} n={3} />
    </g>
    <g data-s="4">
      <rect x={nTagX} y={nRowY[champion.before - 1] + 3} width={nTagW} height={rowH - 4} rx="11" style="fill: none; stroke: var(--muted); stroke-width: 1.2; stroke-dasharray: 4 3" />
      <text class="f-small f-t-muted" x={nTagX + nTagW / 2} y={nRowY[champion.before - 1] + 20} text-anchor="middle">{t.alias}</text>
      <rect x={nTagX} y={nRowY[champion.after - 1] + 3} width={nTagW} height={rowH - 4} rx="11" style="fill: var(--fig-green); fill-opacity: 0.2; stroke: var(--fig-green); stroke-width: 1.5" />
      <text class="f-small" x={nTagX + nTagW / 2} y={nRowY[champion.after - 1] + 20} text-anchor="middle" style="font-weight: 650">{t.alias}</text>
      <Arrow pts={[[nTagX + nTagW / 2, nRowY[champion.before - 1] + rowH], [nTagX + nTagW / 2, nRowY[champion.after - 1] + 2]]} tone="green" />
      <Badge x={nTagX + nTagW} y={nRowY[champion.after - 1] + 3} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[nTagX + nTagW / 2, nRowY[champion.after - 1] + rowH + 2], [nTagX + nTagW / 2, nSrv.y - 2]]} tone="red" />
      <Box x={nSrv.x} y={nSrv.y} w={nSrv.w} h={nSrv.h} label={t.serve} sub={t.serveSub} tone="y" />
      <text class="f-small f-t-muted" x="180" y={nSrv.y + nSrv.h + 30} text-anchor="middle">{t.rollback}</text>
      <Badge x={nSrv.x + nSrv.w} y={nSrv.y} n={5} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
