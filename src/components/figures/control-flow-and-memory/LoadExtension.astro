---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Four bytes at address w = 0x10010000 and what each load leaves in a 32-bit register. Computed here from the bytes;
// the values are the ones the note's program prints.
const mem = [0xf6, 0x00, 0x80, 0xff];            // addresses w+0 .. w+3
const word = mem.reduce((v, b, i) => v + b * 2 ** (8 * i), 0);
const s32 = (v: number) => (v >= 2 ** 31 ? v - 2 ** 32 : v);
interface Load { ins: string; off: number; n: number; signed: boolean }
const loads: Load[] = [
  { ins: 'lb   a0, 0(t0)', off: 0, n: 1, signed: true },
  { ins: 'lbu  a0, 0(t0)', off: 0, n: 1, signed: false },
  { ins: 'lh   a0, 2(t0)', off: 2, n: 2, signed: true },
  { ins: 'lhu  a0, 2(t0)', off: 2, n: 2, signed: false },
  { ins: 'lw   a0, 0(t0)', off: 0, n: 4, signed: true },
];
const rows = loads.map((l) => {
  const src = mem.slice(l.off, l.off + l.n);              // least significant first
  const neg = (src[src.length - 1] & 0x80) !== 0;
  const fill = l.signed && neg ? 0xff : 0x00;
  const bytes = [0, 1, 2, 3].map((i) => (i < l.n ? { v: src[i], kind: 'src' } : { v: fill, kind: fill ? 'sign' : 'zero' }));
  const value = s32(bytes.reduce((v, b, i) => v + b.v * 2 ** (8 * i), 0));
  return { ...l, bytes: bytes.reverse(), value };      // most significant byte on the left
});
const values = rows.map((r) => r.value).join(' ');
if (values !== '-10 246 -128 65408 -8388362' || word !== 0xff8000f6) throw new Error(`LoadExtension: ${values}`);
const hex2 = (b: number) => b.toString(16).padStart(2, '0');
const fmtN = (v: number) => (v < 0 ? '−' : '') + Math.abs(v).toLocaleString('en-US').replace(/,/g, ru ? ' ' : ',');
const cls: Record<string, string> = { src: 'f-fill-blue', sign: 'f-fill-amber', zero: 'f-fill-paper' };
const stroke: Record<string, string> = { src: 'f-blue', sign: 'f-amber', zero: 'f-muted' };
const legend: [string, string][] = ru
  ? [['src', 'байты из памяти'], ['sign', 'копии знакового бита'], ['zero', 'нули']]
  : [['src', 'bytes from memory'], ['sign', 'copies of the sign bit'], ['zero', 'zeros']];
const t = ru ? { mem: 'память', reg: 'регистр a0 (старший байт слева)', addr: 'адрес' } : { mem: 'memory', reg: 'register a0 (most significant byte on the left)', addr: 'address' };

const layouts = [
  { cls: 'fig-wide', W: 760, H: 352, wide: true, lx: 20, cx: 200, cw: 60, ch: 28, top: 44, ry: 140, rh: 40, vx: 470, fs: 12.5 },
  { cls: 'fig-narrow', W: 360, H: 430, wide: false, lx: 8, cx: 104, cw: 44, ch: 26, top: 44, ry: 132, rh: 38, vx: 288, fs: 11 },
];
const id = 'control-flow-and-memory-load-extension';
---

<Figure
  id={id}
  title={ru ? 'Одни и те же байты, прочитанные пятью загрузками' : 'The same bytes read by five loads'}
  caption={ru
    ? 'Четыре байта f6 00 80 ff по адресам от w до w + 3; t0 = w. Строка регистра показывает 32-битный результат каждой загрузки, старший байт слева. lb и lbu читают один байт f6: lb копирует его старший бит (1) во все 24 старших бита и даёт −10, lbu заполняет их нулями и даёт 246. lh и lhu читают полуслово по адресу w + 2: байты 80 и ff, младший первым, то есть 0xff80, со знаком −128 и без знака 65 408. lw читает все четыре байта, и в регистре они стоят в порядке, обратном адресам: 0xff8000f6 = −8 388 362.'
    : 'Four bytes f6 00 80 ff at addresses w to w + 3, with t0 = w. Each register row shows the 32-bit result of one load, most significant byte on the left. lb and lbu read the single byte f6: lb copies its top bit (1) into all 24 upper bits and gives −10, lbu fills them with zeros and gives 246. lh and lhu read the halfword at w + 2: the bytes 80 and ff, least significant first, that is 0xff80, signed −128 and unsigned 65,408. lw reads all four bytes, in the order opposite to their addresses: 0xff8000f6 = −8,388,362.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Знаковое расширение и расширение нулями при загрузке' : 'Sign and zero extension on loads'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? `Память: байты f6, 00, 80, ff по возрастанию адресов. Результаты: ${rows.map((r) => `${r.ins.split(' ')[0]} даёт ${r.bytes.map((b) => hex2(b.v)).join(' ')}, то есть ${r.value}`).join('; ')}.`
        : `Memory: the bytes f6, 00, 80, ff in increasing address order. Results: ${rows.map((r) => `${r.ins.split(' ')[0]} gives ${r.bytes.map((b) => hex2(b.v)).join(' ')}, that is ${r.value}`).join('; ')}.`}</desc>
      <text class="f-label" x={L.lx} y={L.top + L.ch / 2 + 5} style="font-weight: 650">{t.mem}</text>
      {mem.map((b, i) => (
        <g>
          <text class="f-small f-t-muted" x={L.cx + i * L.cw + L.cw / 2} y={L.top - 8} text-anchor="middle" style={`font-size: ${L.fs}px`}>{`w+${i}`}</text>
          <rect class="f-fill-blue" x={L.cx + i * L.cw} y={L.top} width={L.cw} height={L.ch} />
          <rect class="f-thin f-blue" x={L.cx + i * L.cw} y={L.top} width={L.cw} height={L.ch} />
          <text class="f-small" x={L.cx + i * L.cw + L.cw / 2} y={L.top + L.ch / 2 + 4.5} text-anchor="middle" style={`font-family: var(--mono); font-size: ${L.fs + 0.5}px`}>{hex2(b)}</text>
        </g>
      ))}
      {L.wide && <text class="f-small f-t-muted" x={L.cx + 4 * L.cw + 14} y={L.top + L.ch / 2 + 4}>{ru ? 'адреса растут вправо →' : 'addresses grow to the right →'}</text>}
      <text class="f-small f-t-muted" x={L.cx} y={L.ry - 16} style={`font-size: ${L.fs}px`}>{L.wide ? t.reg : (ru ? 'регистр a0' : 'register a0')}</text>
      {rows.map((r, k) => {
        const y = L.ry + k * L.rh;
        return (
          <g>
            <text class="f-small" x={L.lx} y={y + L.ch / 2 + 4} style={`font-family: var(--mono); font-size: ${L.fs}px`}>{r.ins.replace(/ /g, ' ')}</text>
            {r.bytes.map((b, i) => (
              <g>
                <rect class={cls[b.kind]} x={L.cx + i * L.cw} y={y} width={L.cw} height={L.ch} />
                <rect class={`f-thin ${stroke[b.kind]}`} x={L.cx + i * L.cw} y={y} width={L.cw} height={L.ch} />
                <text class="f-small" x={L.cx + i * L.cw + L.cw / 2} y={y + L.ch / 2 + 4.5} text-anchor="middle" style={`font-family: var(--mono); font-size: ${L.fs + 0.5}px`}>{hex2(b.v)}</text>
              </g>
            ))}
            <text class="f-small" x={L.vx} y={y + L.ch / 2 + 4.5} style={`font-size: ${L.fs + 0.5}px; font-weight: 650`}>{`${L.wide ? '= ' : ''}${fmtN(r.value)}`}</text>
          </g>
        );
      })}
      {legend.map(([k, label], i) => {
        const lx = L.wide ? L.cx + i * 180 : L.lx, ly = L.wide ? L.H - 14 : L.H - 62 + i * 22;
        return (
          <g>
            <rect class={cls[k]} x={lx} y={ly - 10} width="14" height="12" />
            <rect class={`f-thin ${stroke[k]}`} x={lx} y={ly - 10} width="14" height="12" />
            <text class="f-small f-t-muted" x={lx + 20} y={ly}>{label}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
