---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Arrow from '../seqflow/Arrow.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The Collatz loop of the note as a control-flow graph: basic blocks (straight-line code that is entered only at its top
// and left only at its bottom) and the edges between them. The numbers quoted in the caption are recomputed here.
let n = 27, steps = 0, max = 27;
while (n !== 1) { n = n % 2 === 0 ? n / 2 : 3 * n + 1; steps += 1; if (n > max) max = n; }
if (steps !== 111 || max !== 9232) throw new Error(`CollatzFlow: ${steps} ${max}`);

interface Block { id: string; c: string; cRu: string; asm: string[]; s: number }
const blocks: Block[] = [
  { id: 'B0', c: 'n = 27; steps = 0; max = n', cRu: 'n = 27; steps = 0; max = n', asm: ['li   t0, 27', 'li   t1, 0', 'mv   t2, t0', 'li   t3, 1'], s: 1 },
  { id: 'B1', c: 'while (n != 1)', cRu: 'while (n != 1)', asm: ['loop: beq t0, t3, done'], s: 1 },
  { id: 'B2', c: 'if (n % 2 == 0)', cRu: 'if (n % 2 == 0)', asm: ['andi t4, t0, 1', 'bnez t4, odd'], s: 2 },
  { id: 'B3', c: 'n = n / 2', cRu: 'n = n / 2', asm: ['srli t0, t0, 1', 'j    next'], s: 3 },
  { id: 'B4', c: 'else n = 3n + 1', cRu: 'else n = 3n + 1', asm: ['odd: slli t4, t0, 1', 'add  t0, t0, t4', 'addi t0, t0, 1'], s: 4 },
  { id: 'B5', c: 'steps++; if (n > max)', cRu: 'steps++; if (n > max)', asm: ['next: addi t1, t1, 1', 'ble  t0, t2, loop'], s: 5 },
  { id: 'B6', c: 'max = n', cRu: 'max = n', asm: ['mv   t2, t0', 'j    loop'], s: 5 },
  { id: 'B7', c: 'print steps, max', cRu: 'печать steps, max', asm: ['done: …'], s: 1 },
];
type Kind = 'taken' | 'fall' | 'jump';
interface Edge { pts: [number, number][]; kind: Kind; label?: string; at?: [number, number]; anchor?: 'start' | 'middle' | 'end'; s: number }
interface Layout { cls: string; W: number; H: number; lh: number; mono: number; pos: Record<string, [number, number, number]>; edges: Edge[]; badges: [number, number][]; legend: [number, number, number, number] }
const le = ru ? 'n ≤ max' : 'n ≤ max';
const layouts: Layout[] = [
  {
    cls: 'fig-wide', W: 760, H: 600, lh: 16, mono: 12,
    pos: { B0: [290, 20, 180], B1: [290, 140, 180], B2: [290, 212, 180], B3: [80, 310, 180], B4: [520, 310, 180], B5: [290, 420, 180], B6: [290, 516, 180], B7: [60, 140, 180] },
    edges: [
      { pts: [[380, 112], [380, 137]], kind: 'fall', s: 1 },
      { pts: [[290, 162], [243, 162]], kind: 'taken', label: 'n == 1', at: [266, 154], anchor: 'middle', s: 1 },
      { pts: [[380, 184], [380, 209]], kind: 'fall', s: 2 },
      { pts: [[320, 272], [320, 290], [170, 290], [170, 307]], kind: 'fall', label: ru ? 'чётное' : 'even', at: [245, 284], anchor: 'middle', s: 3 },
      { pts: [[440, 272], [440, 290], [610, 290], [610, 307]], kind: 'taken', label: ru ? 'нечётное' : 'odd', at: [525, 284], anchor: 'middle', s: 4 },
      { pts: [[170, 370], [170, 400], [330, 400], [330, 417]], kind: 'jump', label: 'j next', at: [250, 394], anchor: 'middle', s: 3 },
      { pts: [[610, 386], [610, 400], [430, 400], [430, 417]], kind: 'fall', s: 4 },
      { pts: [[380, 480], [380, 513]], kind: 'fall', label: 'n > max', at: [388, 500], anchor: 'start', s: 5 },
      { pts: [[470, 456], [722, 456], [722, 156], [473, 156]], kind: 'taken', label: le, at: [600, 450], anchor: 'middle', s: 5 },
      { pts: [[470, 546], [740, 546], [740, 172], [473, 172]], kind: 'jump', label: 'j loop', at: [600, 540], anchor: 'middle', s: 5 },
    ],
    badges: [[272, 126], [490, 230], [62, 326], [490, 350], [272, 450]],
    legend: [40, 530, 0, 22],
  },
  {
    cls: 'fig-narrow seq-narrow', W: 360, H: 740, lh: 16, mono: 11,
    pos: { B0: [60, 20, 240], B1: [60, 140, 240], B2: [60, 212, 240], B3: [40, 310, 140], B4: [190, 310, 136], B5: [60, 420, 240], B6: [60, 516, 240], B7: [60, 612, 240] },
    edges: [
      { pts: [[180, 112], [180, 137]], kind: 'fall', s: 1 },
      { pts: [[60, 162], [20, 162], [20, 634], [57, 634]], kind: 'taken', label: 'n == 1', at: [26, 201], anchor: 'start', s: 1 },
      { pts: [[180, 184], [180, 209]], kind: 'fall', s: 2 },
      { pts: [[110, 272], [110, 307]], kind: 'fall', label: ru ? 'чёт.' : 'even', at: [116, 294], anchor: 'start', s: 3 },
      { pts: [[250, 272], [250, 307]], kind: 'taken', label: ru ? 'нечёт.' : 'odd', at: [256, 283], anchor: 'start', s: 4 },
      { pts: [[110, 370], [110, 417]], kind: 'jump', label: 'j next', at: [116, 402], anchor: 'start', s: 3 },
      { pts: [[258, 386], [258, 417]], kind: 'fall', s: 4 },
      { pts: [[180, 480], [180, 513]], kind: 'fall', label: 'n > max', at: [188, 501], anchor: 'start', s: 5 },
      { pts: [[300, 440], [338, 440], [338, 156], [303, 156]], kind: 'taken', label: le, at: [332, 300], anchor: 'end', s: 5 },
      { pts: [[300, 546], [350, 546], [350, 172], [303, 172]], kind: 'jump', label: 'j loop', at: [334, 502], anchor: 'end', s: 5 },
    ],
    badges: [[40, 126], [40, 242], [88, 396], [282, 404], [40, 450]],
    legend: [12, 682, 0, 24],
  },
];
const tone: Record<Kind, 'blue' | 'muted' | 'amber'> = { taken: 'blue', fall: 'muted', jump: 'amber' };
const textTone: Record<Kind, string> = { taken: 'f-t-blue', fall: 'f-t-muted', jump: 'f-t-amber' };
const legendItems: [Kind, string][] = ru
  ? [['taken', 'ветвление выполнено'], ['fall', 'к следующей команде'], ['jump', 'безусловный переход']]
  : [['taken', 'branch taken'], ['fall', 'falls through'], ['jump', 'unconditional jump']];
const nb = (s: string) => s.replace(/ /g, ' ');
const t = ru
  ? { steps: ['проверка цикла стоит первой; при n == 1 ветвление уводит из цикла к done', 'if: bnez перепрыгивает then-часть, когда n нечётное', 'then-часть заканчивается переходом j next через else-часть', 'else-часть просто продолжается в next: обе ветви сходятся', 'steps++, обновление max и обратные рёбра к проверке цикла'] }
  : { steps: ['the loop test comes first; when n == 1 the branch leaves the loop for done', 'if: bnez jumps over the then-part when n is odd', 'the then-part ends with j next, a jump over the else-part', 'the else-part simply falls through into next: both paths meet', 'steps++, the update of max, and the back edges to the loop test'] };
const id = 'control-flow-and-memory-collatz-flow';
---

<Figure
  id={id}
  title={ru ? 'Цикл с ветвлением внутри в виде графа базовых блоков' : 'A loop with a branch inside, as a graph of basic blocks'}
  caption={ru
    ? `Программа Коллатца из заметки: пока n ≠ 1, чётное n делится на 2, нечётное заменяется на 3n + 1; считаются шаги и наибольшее значение. Каждый блок — прямолинейный код, в который входят только сверху и выходят только снизу; серым над командами — соответствующий код на C. Синие рёбра — выполненные условные ветвления, серые — переход к следующей команде, янтарные — безусловные переходы j. Проверка цикла стоит в начале (1); if превращается в ветвление по обратному условию, которое перепрыгивает then-часть (2); then-часть заканчивается переходом через else-часть (3); обе ветви сходятся в next (4), откуда обратные рёбра ведут к проверке (5). Для n = 27 цикл делает ${steps} шагов, и наибольшее значение равно ${max}.`
    : `The Collatz program of this note: while n ≠ 1, an even n is halved and an odd n becomes 3n + 1; the program counts the steps and keeps the largest value. Each block is straight-line code that is entered only at its top and left only at its bottom; the grey line above the instructions is the C it implements. Blue edges are taken conditional branches, grey edges fall through to the next instruction, amber edges are unconditional jumps (j). The loop test comes first (1); the if becomes a branch on the opposite condition that jumps over the then-part (2); the then-part ends with a jump over the else-part (3); both paths meet at next (4), from where back edges return to the test (5). For n = 27 the loop runs ${steps} steps and the largest value is ${max}.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Граф потока управления цикла Коллатца' : 'Control-flow graph of the Collatz loop'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Восемь блоков ассемблерного кода: инициализация, проверка цикла beq, проверка чётности bnez, then-часть со сдвигом и переходом j next, else-часть с 3n + 1, блок next с увеличением счётчика и ble обратно к проверке, обновление max с j loop, и выход done. Рёбра показывают выполненные ветвления, переходы к следующей команде и безусловные переходы.'
        : 'Eight blocks of assembly: initialization, the loop test beq, the parity test bnez, the then-part with a shift and j next, the else-part computing 3n + 1, the next block with the step counter and ble back to the test, the update of max with j loop, and the exit done. Edges show taken branches, fall-throughs and unconditional jumps.'}</desc>
      {L.edges.map((e) => (
        <g data-s={String(e.s)}>
          <Arrow pts={e.pts} tone={tone[e.kind]} dashed={e.kind === 'jump'} />
          {e.label && e.at && <text class={`f-small ${textTone[e.kind]} f-halo`} x={e.at[0]} y={e.at[1]} text-anchor={e.anchor}>{e.label}</text>}
        </g>
      ))}
      {blocks.map((b) => {
        const [x, y, w] = L.pos[b.id];
        const h = L.lh * (b.asm.length + 1) + 12;
        return (
          <g data-s={String(b.s)}>
            <rect class="f-fill-paper f-thin" x={x} y={y} width={w} height={h} rx="6" />
            <text class="f-small f-t-muted" x={x + 8} y={y + 17}>{ru ? b.cRu : b.c}</text>
            {b.asm.map((line, k) => <text class="f-small" x={x + 8} y={y + 17 + (k + 1) * L.lh} style={`font-family: var(--mono); font-size: ${L.mono}px`}>{nb(line)}</text>)}
          </g>
        );
      })}
      {L.badges.map(([x, y], i) => <g data-s={String(i + 1)}><Badge x={x} y={y} n={i + 1} /></g>)}
      {legendItems.map(([k, label], i) => {
        const lx = L.legend[0] + (L.legend[2] ? (i % 2) * 170 : 0), ly = L.legend[1] + (L.legend[2] ? Math.floor(i / 2) : i) * L.legend[3];
        return (
          <g>
            <path class={`f-line f-${tone[k]}${k === 'jump' ? ' f-dash' : ''}`} d={`M ${lx} ${ly - 4} H ${lx + 26}`} />
            <text class="f-small f-t-muted" x={lx + 34} y={ly}>{label}</text>
          </g>
        );
      })}
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
