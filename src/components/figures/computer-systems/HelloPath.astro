---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import type { Tone } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The path of hello.c from source text to pixels, in the six steps listed under the figure in the note.
// The string "hello, world\n" is 12 printable characters (the space among them) and a newline: 13 bytes, the count passed to write.
const bytes = new TextEncoder().encode('hello, world\n').length;
if (bytes !== 13) throw new Error(`HelloPath: the string has ${bytes} bytes`);

const t = ru
  ? {
      boxes: [
        ['hello.c', 'исходный текст на диске'],
        ['компилятор', 'и компоновщик: C → код'],
        ['загрузчик', 'файл → память процесса'],
        ['процессор', 'выборка и исполнение'],
        ['ядро', `write(1, buf, ${bytes})`],
        ['терминал', 'байты → пиксели'],
      ],
      edges: ['cc hello.c', './hello', 'старт', 'ecall', `${bytes} байт`],
      rows: ['сборка', 'запуск'],
      steps: ['исходный текст: файл байтов в ASCII', 'препроцессор, компилятор, ассемблер и компоновщик строят исполняемый файл', 'ядро создаёт процесс и загружает в его память исполняемый файл', 'процессор выполняет main; printf вызывает write', 'системный вызов переводит процессор в ядро, ядро передаёт байты драйверу терминала', 'терминал превращает байты в глифы, а видеокарта превращает глифы в пиксели'],
    }
  : {
      boxes: [
        ['hello.c', 'source: bytes on disk'],
        ['compiler, linker', 'C → machine code'],
        ['loader', 'file → process memory'],
        ['processor', 'fetch, decode, execute'],
        ['kernel', `write(1, buf, ${bytes})`],
        ['terminal', 'bytes → pixels'],
      ],
      edges: ['cc hello.c', './hello', 'start', 'ecall', `${bytes} bytes`],
      rows: ['building', 'running'],
      steps: ['the source: a file of ASCII bytes', 'preprocessor, compiler, assembler and linker build an executable file', 'the kernel creates a process and loads the executable into its memory', 'the processor executes main; printf calls write', 'the system call switches into the kernel, which hands the bytes to the terminal driver', 'the terminal turns the bytes into glyphs, the graphics hardware into pixels'],
    };
const tones: Tone[] = ['x', 'n', 'n', 'h', 'g', 'y'];

interface Layout { cls: string; W: number; H: number; bw: number; bh: number; pos: [number, number][]; rowLabels: [number, number][] }
// Wide: a snake, steps 1–3 left to right, then 4–6 right to left. Narrow: one column.
const wide: Layout = {
  cls: 'fig-wide', W: 760, H: 252, bw: 180, bh: 54,
  pos: [[36, 44], [290, 44], [544, 44], [544, 178], [290, 178], [36, 178]],
  rowLabels: [[36, 26], [36, 160]],
};
const narrow: Layout = {
  cls: 'fig-narrow seq-narrow', W: 360, H: 548, bw: 250, bh: 56,
  pos: Array.from({ length: 6 }, (_, i) => [56, 20 + i * 88] as [number, number]),
  rowLabels: [],
};
// Edge from box i to box i + 1: [points, label position, anchor].
function edges(L: Layout) {
  return L.pos.slice(0, -1).map(([x, y], i) => {
    const [nx, ny] = L.pos[i + 1];
    const cy = y + L.bh / 2, ncy = ny + L.bh / 2, cx = x + L.bw / 2;
    if (ny === y) {
      const right = nx > x;
      const a: [number, number] = [right ? x + L.bw + 2 : x - 2, cy];
      const b: [number, number] = [right ? nx - 4 : nx + L.bw + 4, ncy];
      return { pts: [a, b], at: [(a[0] + b[0]) / 2, cy - 8] as [number, number], anchor: 'middle' as const };
    }
    const a: [number, number] = [cx, y + L.bh + 2];
    const b: [number, number] = [cx, ny - 4];
    return { pts: [a, b], at: [cx + 10, (a[1] + b[1]) / 2 + 5] as [number, number], anchor: 'start' as const };
  });
}
const layouts = [wide, narrow];
const id = 'hello-path';
---

<Figure
  id={id}
  title={ru ? 'Путь hello.c от исходного текста до пикселей' : 'The path of hello.c from source text to pixels'}
  caption={ru
    ? `Шесть шагов, пронумерованных как в списке под рисунком. Сверху — сборка: файл исходного текста (1) превращается в исполняемый файл (2). Снизу — запуск: ядро загружает файл в память нового процесса (3), процессор выполняет его команды (4), вызов write с ${bytes} байтами строки «hello, world\\n» уходит через системный вызов в ядро (5), и терминал рисует символы (6). Каждый блок — тема одного или нескольких разделов курса.`
    : `The six steps, numbered as in the list under the figure. Top row, building: the source file (1) becomes an executable (2). Bottom row, running: the kernel loads the file into a new process's memory (3), the processor executes its instructions (4), the call write with the ${bytes} bytes of "hello, world\\n" enters the kernel through a system call (5), and the terminal draws the characters (6). Each box is the subject of one or more sections of the course.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Шесть шагов от hello.c до экрана' : 'Six steps from hello.c to the screen'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Шесть блоков, соединённых стрелками: hello.c, компилятор и компоновщик, загрузчик, процессор, ядро, терминал. Стрелки подписаны: cc hello.c, ./hello, старт, ecall, 13 байт.'
        : 'Six boxes joined by arrows: hello.c, compiler and linker, loader, processor, kernel, terminal. The arrows are labelled cc hello.c, ./hello, start, ecall and 13 bytes.'}</desc>
      {L.rowLabels.map(([x, y], k) => <text class="f-small f-t-muted" x={x} y={y}>{t.rows[k]}</text>)}
      {edges(L).map((e, i) => (
        <g data-s={`${i + 2}`}>
          <Arrow pts={e.pts} label={t.edges[i]} at={e.at} anchor={e.anchor} labelTone="n" />
        </g>
      ))}
      {L.pos.map(([x, y], i) => (
        <g data-s={`${i + 1}`}>
          <Box x={x} y={y} w={L.bw} h={L.bh} label={t.boxes[i][0]} sub={t.boxes[i][1]} tone={tones[i]} />
          <Badge x={x + 2} y={y + 2} n={i + 1} />
        </g>
      ))}
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
