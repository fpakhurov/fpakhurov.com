---
import Figure from '../Figure.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Op from '../seqflow/Op.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The third trip around the fetch–decode–execute loop for the program of the note:
// addi a0, zero, 5; addi a1, zero, 7; add a2, a0, a1, loaded at 0x00400000.
// The machine words are decoded here and checked against the fields the figure prints.
const base = 0x00400000;
const words = [0x00500513, 0x00700593, 0x00b50633];
const field = (w: number, lo: number, n: number) => (w >>> lo) & ((1 << n) - 1);
const dec = words.map((w) => ({ op: field(w, 0, 7), rd: field(w, 7, 5), rs1: field(w, 15, 5), rs2: field(w, 20, 5), imm: w >>> 20 }));
const ok = dec[0].op === 0x13 && dec[0].rd === 10 && dec[0].imm === 5
  && dec[1].op === 0x13 && dec[1].rd === 11 && dec[1].imm === 7
  && dec[2].op === 0x33 && dec[2].rd === 12 && dec[2].rs1 === 10 && dec[2].rs2 === 11;
if (!ok) throw new Error('FetchExecute: the machine words do not decode to the program of the note');
const a0 = dec[0].imm, a1 = dec[1].imm, a2 = a0 + a1;
const hex = (v: number) => '0x' + v.toString(16).toUpperCase().padStart(8, '0');
const pc = base + 8, next = pc + 4;
if (hex(pc) !== '0x00400008' || hex(next) !== '0x0040000C' || a2 !== 12) throw new Error('FetchExecute: values drifted');

const t = ru
  ? { memory: 'память', proc: 'процессор', addr: 'адрес', word: 'слово', regs: 'регистры', alu: 'АЛУ',
      decoded: `add · rd = a2 · rs1 = a0 · rs2 = a1`, next: `PC ← PC + 4 = ${hex(next)}`,
      steps: ['выборка: слово по адресу из PC копируется в IR', 'декодирование: поля команды задают операцию и регистры', 'исполнение: АЛУ складывает значения a0 и a1', 'запись результата: 12 записывается в a2', 'следующая команда: PC увеличивается на 4'] }
  : { memory: 'memory', proc: 'processor', addr: 'address', word: 'word', regs: 'registers', alu: 'ALU',
      decoded: `add · rd = a2 · rs1 = a0 · rs2 = a1`, next: `PC ← PC + 4 = ${hex(next)}`,
      steps: ['fetch: the word at the address in PC is copied into IR', 'decode: the fields of the instruction name the operation and the registers', 'execute: the ALU adds the values of a0 and a1', 'write back: the result 12 is written into a2', 'next: PC advances by 4'] };

const mono = 'font-family: var(--mono)';
interface Layout {
  cls: string; W: number; H: number; fs: number;
  pcBox: [number, number, number]; mem: [number, number, number]; rowH: number; cols: [number, number];
  procTop: number; procLeft: number; ir: [number, number, number]; decoder: [number, number, number];
  regs: [number, number, number]; regH: number; alu: [number, number]; next: [number, number];
  badges: [number, number][];
}
const layouts: Layout[] = [
  {
    cls: 'fig-wide', W: 760, H: 400, fs: 12.5,
    pcBox: [12, 163, 108], mem: [146, 72, 214], rowH: 34, cols: [158, 260],
    procTop: 110, procLeft: 392, ir: [412, 140, 150], decoder: [412, 214, 324],
    regs: [412, 278, 150], regH: 30, alu: [664, 308], next: [26, 244],
    badges: [[372, 206], [412, 214], [702, 306], [702, 378], [14, 240]],
  },
  {
    cls: 'fig-narrow seq-narrow', W: 360, H: 586, fs: 14,
    pcBox: [8, 163, 110], mem: [136, 72, 216], rowH: 34, cols: [146, 252],
    procTop: 232, procLeft: 8, ir: [136, 258, 150], decoder: [16, 326, 328],
    regs: [28, 400, 150], regH: 32, alu: [278, 432], next: [34, 562],
    badges: [[234, 224], [16, 326], [312, 432], [298, 504], [18, 557]],
  },
];
const id = 'fetch-execute';
---

<Figure
  id={id}
  title={ru ? 'Один оборот цикла «выборка — декодирование — исполнение»' : 'One trip around the fetch–decode–execute loop'}
  caption={ru
    ? `Третья команда программы из трёх команд, загруженной с адреса 0x00400000. PC указывает на 0x00400008 (1); слово ${hex(words[2])} копируется в регистр команды IR. Декодер выделяет её поля (2): операцию add, регистр назначения a2 и регистры-источники a0 и a1, которым две предыдущие команды присвоили значения ${a0} и ${a1}. АЛУ складывает их (3), результат ${a2} записывается в a2 (4), и PC увеличивается на 4 (5). Память хранит только числа: слово становится командой потому, что на него указывает PC.`
    : `The third instruction of the three-instruction program loaded at 0x00400000. PC points at 0x00400008 (1), and the word ${hex(words[2])} is copied into the instruction register IR. The decoder extracts its fields (2): the operation add, the destination a2 and the sources a0 and a1, which the two previous instructions set to ${a0} and ${a1}. The ALU adds them (3), the result ${a2} is written into a2 (4), and PC advances by 4 (5). The memory holds only numbers; a word is an instruction because PC points at it.`}
>
  {layouts.map((L) => {
    const [mx, my, mw] = L.mem;
    const rowY = (i: number) => my + 26 + i * L.rowH;
    const cur = 2;
    const [ix, iy, iw] = L.ir;
    const [dx, dy, dw] = L.decoder;
    const [rx, ry, rw] = L.regs;
    const regRow = (i: number) => ry + 18 + i * L.regH;
    const [ax, ay] = L.alu;
    const [px, py, pw] = L.pcBox;
    const memBottom = rowY(2) + L.rowH + 4;
    const wide = L.W === 760;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Выборка, декодирование и исполнение команды add' : 'Fetching, decoding and executing an add instruction'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Слева PC со значением 0x00400008 указывает на третью строку памяти, где лежит слово 0x00B50633. Стрелка ведёт из памяти в регистр IR процессора, оттуда в декодер с полями add, a2, a0, a1. Регистры a0 = 5 и a1 = 7 поступают на сумматор АЛУ, результат 12 возвращается в a2. Внизу: PC становится 0x0040000C.'
          : 'On the left, PC holds 0x00400008 and points at the third row of memory, which holds the word 0x00B50633. An arrow leads from memory to the processor\'s instruction register IR, then to a decoder showing add, a2, a0 and a1. Registers a0 = 5 and a1 = 7 feed the ALU adder, whose result 12 goes back into a2. Below, PC becomes 0x0040000C.'}</desc>

        {/* memory */}
        <text class="f-small f-t-muted" x={mx} y={my - 10}>{t.memory}</text>
        <rect x={mx} y={my} width={mw} height={rowY(2) + L.rowH + 4 - my} rx="7" style="fill: var(--paper-strong); stroke: var(--line); stroke-width: 1.2" />
        <text class="f-small f-t-muted" x={L.cols[0]} y={my + 18}>{t.addr}</text>
        <text class="f-small f-t-muted" x={L.cols[1]} y={my + 18}>{t.word}</text>
        {words.map((w, i) => (
          <g>
            {i === cur && <rect x={mx + 4} y={rowY(i) + 4} width={mw - 8} height={L.rowH - 6} rx="5" style={`fill: ${toneVar.h}; fill-opacity: 0.14; stroke: ${toneVar.h}; stroke-width: 1.3`} />}
            <text class="f-small" x={L.cols[0]} y={rowY(i) + L.rowH / 2 + 5} style={mono}>{hex(base + 4 * i)}</text>
            <text class="f-small" x={L.cols[1]} y={rowY(i) + L.rowH / 2 + 5} style={mono}>{hex(w)}</text>
          </g>
        ))}

        {/* 1: PC points at the current row; the word goes to IR */}
        <g data-s="1">
          <text class="f-small f-t-muted" x={px} y={py - 8}>PC</text>
          <rect x={px} y={py} width={pw} height="40" rx="6" style={`fill: ${toneVar.g}; fill-opacity: 0.14; stroke: ${toneVar.g}; stroke-width: 1.3`} />
          <text class="f-small" x={px + pw / 2} y={py + 25} text-anchor="middle" style={mono}>{hex(pc)}</text>
          <Arrow pts={[[px + pw + 2, py + 20], [mx + 2, rowY(cur) + L.rowH / 2 + 1]]} tone="amber" />
          {wide ? <text class="f-small f-t-muted" x={ix} y={iy - 8}>IR</text> : <text class="f-small f-t-muted" x={ix - 8} y={iy + 25} text-anchor="end">IR</text>}
          <rect x={ix} y={iy} width={iw} height="40" rx="6" style={`fill: ${toneVar.h}; fill-opacity: 0.14; stroke: ${toneVar.h}; stroke-width: 1.3`} />
          <text class="f-small" x={ix + iw / 2} y={iy + 25} text-anchor="middle" style={mono}>{hex(words[cur])}</text>
          {wide
            ? <Arrow pts={[[mx + mw + 2, rowY(cur) + L.rowH / 2 + 1], [ix - 4, iy + 20]]} tone="blue" />
            : <Arrow pts={[[ix + iw / 2, memBottom + 2], [ix + iw / 2, iy - 4]]} tone="blue" />}
          <Badge x={L.badges[0][0]} y={L.badges[0][1]} n={1} />
        </g>

        {/* processor outline */}
        <text class="f-small f-t-muted" x={wide ? L.procLeft : L.W - 8} y={L.procTop - 8} text-anchor={wide ? 'start' : 'end'}>{t.proc}</text>
        <rect x={L.procLeft} y={L.procTop} width={L.W - L.procLeft - 8} height={L.H - L.procTop - (wide ? 8 : 50)} rx="9" style="fill: none; stroke: var(--line); stroke-width: 1.2; stroke-dasharray: 5 4" />

        {/* 2: decode */}
        <g data-s="2">
          <Arrow pts={[[ix + iw / 2, iy + 42], [ix + iw / 2, dy - 4]]} />
          <rect x={dx} y={dy} width={dw} height="36" rx="6" style="fill: var(--paper); stroke: var(--ink); stroke-width: 1.2" />
          <text class="f-small" x={dx + dw / 2} y={dy + 23} text-anchor="middle">{t.decoded}</text>
          <Badge x={L.badges[1][0]} y={L.badges[1][1]} n={2} />
        </g>

        {/* registers */}
        <text class="f-small f-t-muted" x={rx} y={ry - 8}>{t.regs}</text>
        {[['a0', a0], ['a1', a1], ['a2', a2]].map(([name, v], i) => (
          <g data-s={i === 2 ? '4' : '3'}>
            <rect x={rx} y={ry + i * L.regH} width={rw} height={L.regH} style={`fill: ${toneVar.h}; fill-opacity: ${i === 2 ? 0.3 : 0.12}; stroke: ${toneVar.h}; stroke-width: 1.2`} />
            <text class="f-small" x={rx + 12} y={regRow(i) + 2} style={mono}>{name}</text>
            <text class="f-small" x={rx + rw - 12} y={regRow(i) + 2} text-anchor="end" style={mono}>{v}</text>
          </g>
        ))}

        {/* 3: execute */}
        <g data-s="3">
          <Arrow pts={[[rx + rw + 2, regRow(0) - 3], [ax - 14, ay - 6]]} />
          <Arrow pts={[[rx + rw + 2, regRow(1) - 3], [ax - 14, ay + 4]]} />
          <Op x={ax} y={ay} sym="+" />
          <text class="f-small f-t-muted" x={ax} y={ay - 22} text-anchor="middle">{t.alu}</text>
          <Badge x={L.badges[2][0]} y={L.badges[2][1]} n={3} />
        </g>

        {/* 4: write back */}
        <g data-s="4">
          <Arrow pts={[[ax, ay + 14], [ax, regRow(2) + 22], [rx + rw + 22, regRow(2) + 22], [rx + rw + 22, regRow(2) - 3], [rx + rw + 4, regRow(2) - 3]]} tone="red" />
          <text class="f-small f-t-red" x={wide ? ax + 8 : rx + rw + 52} y={wide ? regRow(2) + 14 : regRow(2) + 40}>{a2}</text>
          <Badge x={L.badges[3][0]} y={L.badges[3][1]} n={4} />
        </g>

        {/* 5: next */}
        <g data-s="5">
          <text class="f-small" x={L.next[0]} y={L.next[1]} style={mono}>{t.next}</text>
          <Badge x={L.badges[4][0]} y={L.badges[4][1]} n={5} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
