---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? "Слот указывает на кортеж" : "A slot points to the tuple";
const caption = ru ? "Заголовок и массив слотов занимают начало страницы. Записи растут с другого конца. Размеры на схеме условны." : "The header and slot array occupy the front of the page. Record data grows from the other end. The layout is schematic.";
const desc = ru ? "Слот 2 хранит смещение до второго кортежа. При перемещении кортежа внутри страницы достаточно обновить слот." : "Slot 2 stores an offset to the second tuple. Moving that tuple within the page only requires updating the slot.";
---
<Figure id="db-slotted-page" title={title} caption={caption}>
  <svg viewBox="0 0 340 146" role="img" aria-labelledby="db-slotted-page-title db-slotted-page-desc" style="max-width: 550px; margin-inline: auto">
    <title id="db-slotted-page-title">{title}</title>
    <desc id="db-slotted-page-desc">{desc}</desc>
    <text class="f-label" x="46" y="29" text-anchor="middle">{ru ? 'Заголовок' : 'Header'}</text>
    <text class="f-label" x="113" y="29" text-anchor="middle">{ru ? 'Слоты' : 'Slots'}</text>
    <text class="f-label" x="193" y="29" text-anchor="middle">{ru ? 'Свободно' : 'Free space'}</text>
    <text class="f-label" x="285" y="29" text-anchor="middle">{ru ? 'Кортежи' : 'Tuples'}</text>
    <rect x="10" y="42" width="320" height="46" rx="6" fill="none" class="f-line" />
    <rect class="f-fill-blue" x="14" y="46" width="63" height="38" rx="3" />
    <rect class="f-fill-blue" x="82" y="46" width="29" height="38" rx="3" />
    <rect class="f-fill-green" x="115" y="46" width="29" height="38" rx="3" />
    <rect class="f-fill-green" x="242" y="46" width="40" height="38" rx="3" />
    <rect class="f-fill-blue" x="286" y="46" width="40" height="38" rx="3" />
    <text class="f-label" x="46" y="70" text-anchor="middle">24 B</text>
    <text class="f-label" x="96" y="70" text-anchor="middle">1</text>
    <text class="f-label" x="129" y="70" text-anchor="middle">2</text>
    <text class="f-label" x="262" y="70" text-anchor="middle">2</text>
    <text class="f-label" x="306" y="70" text-anchor="middle">1</text>
    <path class="f-line" d="M 129 90 V 108 H 262 V 90 M 256 96 L 262 90 L 268 96" fill="none" />
    <text class="f-label" x="195" y="133" text-anchor="middle">{ru ? 'Смещение из слота 2' : 'Offset from slot 2'}</text>
  </svg>
</Figure>
