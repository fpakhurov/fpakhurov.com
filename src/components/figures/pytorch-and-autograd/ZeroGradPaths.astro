---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Gradient descent on L(w) = (w − 3)²/2 from w = 0 with η = 0.1, with zero_grad (the gradient of the current step)
// and without it (the sum of all gradients so far). Values after steps 1, 2, 3, 10, 30, 60 as printed in the Code section.
const eta = 0.1, T = 60;
function run(zero: boolean) {
  let w = 0, acc = 0;
  const path = [0];
  for (let k = 0; k < T; k += 1) {
    const g = w - 3;
    acc = zero ? g : acc + g;
    w -= eta * acc;
    path.push(w);
  }
  return path;
}
const good = run(true), bad = run(false);
const at = (p: number[]) => [1, 2, 3, 10, 30, 60].map((k) => Number(p[k].toFixed(3))).join(' ');
if (at(good) !== '0.3 0.57 0.813 1.954 2.873 2.995' || at(bad) !== '0.3 0.87 1.653 5.982 5.935 0.16')
  throw new Error(`ZeroGradPaths: paths drifted from the Code section (${at(good)} / ${at(bad)})`);
// the oscillation: eigenvalues e^{±iθ} with cos θ = 1 − η/2, period 2π/θ
const theta = Math.acos(1 - eta / 2), period = (2 * Math.PI) / theta;
const lo = Math.min(...bad), hi = Math.max(...bad);
if (period.toFixed(1) !== '19.8' || lo.toFixed(2) !== '-0.04' || hi.toFixed(2) !== '6.04') throw new Error('ZeroGradPaths: oscillation drifted from the note');

const t = ru
  ? { title: 'Шаги без zero_grad: импульс без затухания', x: 'шаг', y: 'w', good: 'с zero_grad', bad: 'без zero_grad', min: 'минимум w = 3', per: `период ≈ ${period.toFixed(1)} шага`,
      desc: 'Две траектории веса за 60 шагов. С обнулением градиента вес монотонно приближается к 3. Без обнуления он колеблется между −0.04 и 6.04 с периодом около 20 шагов и не сходится.' }
  : { title: 'Steps without zero_grad: momentum that never decays', x: 'step', y: 'w', good: 'with zero_grad', bad: 'without zero_grad', min: 'minimum w = 3', per: `period ≈ ${period.toFixed(1)} steps`,
      desc: 'Two paths of the weight over 60 steps. With the gradient zeroed, the weight approaches 3 monotonically. Without zeroing, it oscillates between −0.04 and 6.04 with a period of about 20 steps and never converges.' };
const id = 'pytorch-zero-grad-paths';
const caption = ru
  ? `Градиентный спуск на L(w) = (w − 3)²/2 из w = 0 с шагом η = 0.1. С zero_grad (синяя линия) каждый шаг использует текущий градиент, и ошибка уменьшается в 0.9 раза за шаг: 2.995 после 60 шагов. Без zero_grad (красная) .grad хранит сумму всех прошлых градиентов, и пара (ошибка, накопленный градиент) за каждый шаг поворачивается матрицей с определителем 1: вес колеблется между ${lo.toFixed(2).replace('-', '−')} и ${hi.toFixed(2)} с периодом 2π/θ ≈ ${period.toFixed(1)} шага, где cos θ = 1 − η/2.`
  : `Gradient descent on L(w) = (w − 3)²/2 from w = 0 with step η = 0.1. With zero_grad (blue), each step uses the current gradient and the error shrinks by a factor 0.9 per step: 2.995 after 60 steps. Without zero_grad (red), .grad holds the sum of all past gradients, and the pair (error, accumulated gradient) is rotated at every step by a matrix of determinant 1: the weight swings between ${lo.toFixed(2).replace('-', '−')} and ${hi.toFixed(2)} with a period of 2π/θ ≈ ${period.toFixed(1)} steps, where cos θ = 1 − η/2.`;
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 300, px: [56, 560] as [number, number], py: [24, 240] as [number, number], lx: 584, ly: 60 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 400, px: [44, 344] as [number, number], py: [24, 240] as [number, number], lx: 44, ly: 312 },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => {
    const sx = scale([0, T], Ly.px), sy = scale([-0.5, 6.5], [Ly.py[1], Ly.py[0]]);
    const line = (p: number[]) => polyline(p.map((v, k) => [sx(k), sy(v)] as [number, number]));
    const peak = bad.indexOf(hi);
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
        {[0, 2, 4, 6].map((v) => <path class="f-grid" d={`M ${Ly.px[0]} ${sy(v)} H ${Ly.px[1]}`} />)}
        <path class="f-axis" d={`M ${Ly.px[0]} ${Ly.py[1]} H ${Ly.px[1]} M ${Ly.px[0]} ${Ly.py[0]} V ${Ly.py[1]}`} />
        {[0, 20, 40, 60].map((v) => <text class="f-note" x={sx(v)} y={Ly.py[1] + 18} text-anchor="middle">{v}</text>)}
        {[0, 2, 4, 6].map((v) => <text class="f-note" x={Ly.px[0] - 7} y={sy(v) + 5} text-anchor="end">{v}</text>)}
        <text class="f-small" x={(Ly.px[0] + Ly.px[1]) / 2} y={Ly.py[1] + 40} text-anchor="middle">{t.x}</text>
        <text class="f-math" x={Ly.px[0] - 34} y={Ly.py[0] + 8}>{t.y}</text>
        <path class="f-thin f-muted f-dash" d={`M ${Ly.px[0]} ${sy(3)} H ${Ly.px[1]}`} />
        <path class="f-line f-red" d={line(bad)} />
        <path class="f-line f-blue" style="stroke-width: 2.4" d={line(good)} />
        <path class="f-thin f-muted" d={`M ${sx(peak - period)} ${sy(hi) - 8} V ${sy(hi) - 14} H ${sx(peak)} V ${sy(hi) - 8}`} />
        <text class="f-small f-t-red f-halo" x={sx(peak - period / 2)} y={sy(hi) - 20} text-anchor="middle">{t.per}</text>
        <path class="f-line f-blue" style="stroke-width: 2.4" d={`M ${Ly.lx} ${Ly.ly - 4} h 26`} />
        <text class="f-small" x={Ly.lx + 34} y={Ly.ly}>{t.good}</text>
        <path class="f-line f-red" d={`M ${Ly.lx} ${Ly.ly + 22} h 26`} />
        <text class="f-small" x={Ly.lx + 34} y={Ly.ly + 26}>{t.bad}</text>
        <path class="f-thin f-muted f-dash" d={`M ${Ly.lx} ${Ly.ly + 48} h 26`} />
        <text class="f-small" x={Ly.lx + 34} y={Ly.ly + 52}>{t.min}</text>
        <text class="f-note" x={Ly.lx} y={Ly.ly + 84}>η = 0.1, w₀ = 0</text>
      </svg>
    );
  })}
</Figure>
