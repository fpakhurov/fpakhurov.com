---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Op from '../seqflow/Op.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import MathLabel from '../backpropagation/MathLabel.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The worked example: L = (ab + a)² at a = 2, b = −3, computed as c = ab, d = c + a, L = d².
const a = 2, b = -3;
const c = a * b, d = c + a, L = d * d;
const dL = 1, dd = 2 * d * dL, dc = dd, daViaD = dd, db = dc * a, daViaC = dc * b, da = daViaD + daViaC;
// closed form: L = a²(b + 1)², ∂L/∂a = 2a(b + 1)², ∂L/∂b = 2a²(b + 1)
if (da !== 2 * a * (b + 1) ** 2 || db !== 2 * a * a * (b + 1)) throw new Error('ScalarGraph: adjoints disagree with the closed form');
const quoted = [c, d, L, dd, dc, daViaD, db, daViaC, da].join(' ');
if (quoted !== '-6 -4 16 -8 -8 -8 -16 24 16') throw new Error(`ScalarGraph: the worked example drifted from the note (${quoted})`);
const m = (v: number) => String(v).replace('-', '−');

const t = ru
  ? {
      title: 'Граф вычислений для L = (ab + a)² и обратный проход',
      fwd: 'прямой проход: значения', bwd: 'обратный проход: сопряжённые величины', grad: 'градиент',
      sum: `${m(daViaD)} + ${m(daViaC)} = ${m(da)}`,
      steps: ['c = ab = −6', 'd = c + a = −4', 'L = d² = 16', 'L̄ = 1, d̄ = 2d · L̄ = −8', 'через сумму: c̄ = −8, первый вклад в ā равен −8', 'через произведение: b̄ = c̄ · a = −16, второй вклад в ā равен c̄ · b = 24, ā = 16'],
      desc: 'Сверху слева направо: листья a = 2 и b = −3, узел умножения даёт c = −6, узел сложения с a даёт d = −4, возведение в квадрат даёт L = 16. Снизу справа налево: L̄ = 1, d̄ = −8, c̄ = −8, b̄ = −16 и ā = −8 + 24 = 16, собранное из двух вкладов.',
    }
  : {
      title: 'The computational graph of L = (ab + a)² and its backward pass',
      fwd: 'forward pass: values', bwd: 'backward pass: adjoints', grad: 'gradient',
      sum: `${m(daViaD)} + ${m(daViaC)} = ${m(da)}`,
      steps: ['c = ab = −6', 'd = c + a = −4', 'L = d² = 16', 'L̄ = 1, d̄ = 2d · L̄ = −8', 'through the sum: c̄ = −8, the first contribution to ā is −8', 'through the product: b̄ = c̄ · a = −16, the second contribution to ā is c̄ · b = 24, ā = 16'],
      desc: 'Top, left to right: the leaves a = 2 and b = −3, a product node giving c = −6, a sum node with a giving d = −4, a square giving L = 16. Bottom, right to left: L̄ = 1, d̄ = −8, c̄ = −8, b̄ = −16, and ā = −8 + 24 = 16 collected from two contributions.',
    };
const id = 'pytorch-scalar-graph';
const caption = ru
  ? 'Разобранный пример из текста при a = 2, b = −3. Верхний ряд — прямой проход (1–3): каждый узел запоминает свои локальные производные (у произведения — второй множитель, у квадрата — 2d). Нижний ряд — обратный проход справа налево (4–6): каждый узел передаёт свою сопряжённую величину, умноженную на локальную производную, узлам, из которых он вычислен. Величина a используется дважды, в c и в d, и собирает два вклада: −8 через сумму и 24 через произведение, всего 16 = 2a(b + 1)².'
  : 'The worked example of the text at a = 2, b = −3. The top row is the forward pass (1–3): each node stores its local derivatives (the product stores the other factor, the square stores 2d). The bottom row is the backward pass from right to left (4–6): each node passes its adjoint times the local derivative to the nodes it was computed from. The value a is used twice, in c and in d, and collects two contributions: −8 through the sum and 24 through the product, 16 = 2a(b + 1)² in all.';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 380" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <text class="f-small f-t-muted" x="744" y="30" text-anchor="end">{t.fwd}</text>
    <text class="f-small f-t-muted" x="16" y="192">{t.bwd}</text>
    <g data-s="1">
      <Vec x={40} y={56} values={[m(a)]} tone="x" cw={48} label="a" labelPos="left" />
      <Vec x={40} y={130} values={[m(b)]} tone="x" cw={48} label="b" labelPos="left" />
      <Arrow pts={[[88, 67], [132, 100]]} />
      <Arrow pts={[[88, 141], [132, 118]]} />
      <Op x={146} y={110} sym="×" />
      <Arrow pts={[[159, 110], [196, 110]]} />
      <Vec x={198} y={99} values={[m(c)]} tone="h" cw={48} label="c" />
      <Badge x={146} y={82} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[64, 56], [64, 36], [330, 36], [330, 95]]} />
      <Arrow pts={[[246, 110], [315, 110]]} />
      <Op x={330} y={110} sym="+" />
      <Arrow pts={[[343, 110], [376, 110]]} />
      <Vec x={378} y={99} values={[m(d)]} tone="h" cw={48} label="d" />
      <Badge x={356} y={82} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[426, 110], [474, 110]]} />
      <Op x={500} y={110} sym="( )²" />
      <Arrow pts={[[526, 110], [566, 110]]} />
      <Vec x={568} y={99} values={[m(L)]} tone="y" cw={48} label="L" />
      <Badge x={500} y={82} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[592, 121], [592, 209]]} tone="red" />
      <Vec x={568} y={211} values={['1']} tone="y" cw={48} />
      <MathLabel x={592} y={252} anchor="middle" label="~L" />
      <Arrow pts={[[568, 222], [428, 222]]} tone="red" label="× 2d" at={[498, 213]} anchor="middle" labelTone="y" />
      <Vec x={378} y={211} values={[m(dd)]} tone="h" cw={48} />
      <MathLabel x={402} y={252} anchor="middle" label="~d" />
      <Badge x={498} y={244} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[378, 222], [248, 222]]} tone="red" label="× 1" at={[313, 213]} anchor="middle" labelTone="h" />
      <Vec x={198} y={211} values={[m(dc)]} tone="h" cw={48} />
      <MathLabel x={222} y={252} anchor="middle" label="~c" />
      <Arrow pts={[[414, 233], [414, 317], [146, 317]]} tone="red" label={`× 1: ${m(daViaD)}`} at={[300, 337]} anchor="middle" labelTone="x" />
      <Badge x={313} y={244} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[198, 222], [90, 222]]} tone="red" label={`× a: ${m(db)}`} at={[144, 213]} anchor="middle" labelTone="x" />
      <Vec x={40} y={211} values={[m(db)]} tone="x" cw={48} />
      <MathLabel x={34} y={227} anchor="end" label="~b" />
      <Arrow pts={[[222, 233], [222, 305], [146, 305]]} tone="red" label={`× b: ${m(daViaC)}`} at={[184, 297]} anchor="middle" labelTone="x" />
      <Vec x={40} y={300} values={[t.sum]} tone="x" cw={104} />
      <MathLabel x={34} y={316} anchor="end" label="~a" />
      <Badge x={92} y={268} n={6} />
    </g>
    <Legend x={290} y={370} step={120} />
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 440" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <g data-s="1">
      <Vec x={40} y={40} values={[m(a)]} tone="x" cw={44} label="a" labelPos="left" />
      <Vec x={120} y={40} values={[m(b)]} tone="x" cw={44} label="b" labelPos="left" />
      <Arrow pts={[[62, 62], [80, 90]]} />
      <Arrow pts={[[142, 62], [102, 90]]} />
      <Op x={91} y={104} sym="×" />
      <Arrow pts={[[91, 117], [91, 140]]} />
      <Vec x={69} y={142} values={[m(c)]} tone="h" cw={44} label="c" labelPos="left" />
      <Badge x={126} y={104} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[40, 51], [24, 51], [24, 212], [78, 212]]} />
      <Arrow pts={[[91, 164], [91, 199]]} />
      <Op x={91} y={212} sym="+" />
      <Arrow pts={[[91, 225], [91, 248]]} />
      <Vec x={69} y={250} values={[m(d)]} tone="h" cw={44} label="d" labelPos="left" />
      <Badge x={126} y={212} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[91, 272], [91, 300]]} />
      <Op x={91} y={314} sym="( )²" />
      <Arrow pts={[[91, 327], [91, 352]]} />
      <Vec x={69} y={354} values={[m(L)]} tone="y" cw={44} label="L" labelPos="left" />
      <Badge x={136} y={314} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[113, 365], [218, 365]]} tone="red" />
      <Vec x={220} y={354} values={['1']} tone="y" cw={44} />
      <MathLabel x={270} y={370} label="~L" />
      <Arrow pts={[[242, 354], [242, 274]]} tone="red" label="× 2d" at={[250, 318]} labelTone="y" />
      <Vec x={220} y={250} values={[m(dd)]} tone="h" cw={44} />
      <MathLabel x={270} y={266} label="~d" />
      <Badge x={300} y={318} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[242, 250], [242, 166]]} tone="red" label="× 1" at={[250, 212]} labelTone="h" />
      <Vec x={220} y={142} values={[m(dc)]} tone="h" cw={44} />
      <MathLabel x={270} y={158} label="~c" />
      <Arrow pts={[[264, 261], [340, 261], [340, 16], [250, 16], [250, 28]]} tone="red" label={`× 1: ${m(daViaD)}`} at={[334, 200]} anchor="end" labelTone="x" />
      <Badge x={300} y={212} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[230, 142], [230, 98]]} tone="red" label={`× a: ${m(db)}`} at={[224, 124]} anchor="end" labelTone="x" />
      <Vec x={196} y={74} values={[m(db)]} tone="x" cw={44} />
      <MathLabel x={246} y={90} label="~b" />
      <Arrow pts={[[264, 153], [320, 153], [320, 41], [302, 41]]} tone="red" label={`× b: ${m(daViaC)}`} at={[314, 132]} anchor="end" labelTone="x" />
      <Vec x={196} y={30} values={[t.sum]} tone="x" cw={104} />
      <MathLabel x={190} y={46} anchor="end" label="~a" />
      <Badge x={176} y={100} n={6} />
    </g>
    <Legend x={16} y={410} step={170} rows={2} />
  </svg>
  <Stepper steps={t.steps} />
</Figure>
