---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Predictions of shape (3, 1) minus targets of shape (3,): the targets are read as (1, 3), the result is (3, 3)
// with entries (ŷ_i − y_j)². The intended loss compares ŷ_i with y_i only.
const yhat = [1, 2, 3], y = [1, 2, 3];
const grid = yhat.map((a) => y.map((b) => (a - b) ** 2));
const sum = grid.flat().reduce((s, v) => s + v, 0);
const mean = sum / 9;
const right = yhat.map((a, i) => (a - y[i]) ** 2);
if (sum !== 12 || mean.toFixed(3) !== '1.333' || right.some((v) => v !== 0)) throw new Error('BroadcastTrap: values drifted from the note');
const S = (a: number[]) => a.map(String);

const t = ru
  ? {
      title: 'Ловушка broadcasting: (3, 1) минус (3,)',
      a: 'pred − target с формами (3, 1) и (3,)', b: 'после pred.squeeze(1): формы (3,) и (3,)',
      yhatA: 'ŷ: (3, 1)', yA: 'y: (3,), читается как (1, 3)', yN: 'y: (3,)', grid: '(ŷᵢ − yⱼ)²: форма (3, 3)', gridN: '(ŷᵢ − yⱼ)²: (3, 3)',
      meanA: `среднее = 12/9 = ${mean.toFixed(3)}`, meanB: 'среднее = 0', sq: '(ŷ − y)²', titleN: 'формы (3, 1) и (3,)', titleNB: 'после squeeze(1): (3,) и (3,)',
      desc: 'Слева: столбец предсказаний 1, 2, 3 формы (3, 1) и строка целей 1, 2, 3 формы (3,) дают таблицу 3 на 3 квадратов разностей с нулями на диагонали и средним 1.333. Справа: после squeeze(1) обе формы (3,), квадраты разностей равны нулю, среднее 0.',
    }
  : {
      title: 'The broadcasting trap: (3, 1) minus (3,)',
      a: 'pred − target with shapes (3, 1) and (3,)', b: 'after pred.squeeze(1): shapes (3,) and (3,)',
      yhatA: 'ŷ: (3, 1)', yA: 'y: (3,), read as (1, 3)', yN: 'y: (3,)', grid: '(ŷᵢ − yⱼ)²: shape (3, 3)', gridN: '(ŷᵢ − yⱼ)²: (3, 3)',
      meanA: `mean = 12/9 = ${mean.toFixed(3)}`, meanB: 'mean = 0', sq: '(ŷ − y)²', titleN: 'shapes (3, 1) and (3,)', titleNB: 'after squeeze(1): (3,) and (3,)',
      desc: 'Left: a column of predictions 1, 2, 3 of shape (3, 1) and a row of targets 1, 2, 3 of shape (3,) give a 3 by 3 table of squared differences with zeros on the diagonal and mean 1.333. Right: after squeeze(1) both shapes are (3,), the squared differences are zero, the mean is 0.',
    };
const id = 'pytorch-broadcast-trap';
const caption = ru
  ? 'Предсказания (1, 2, 3) совпадают с целями (1, 2, 3), так что правильная среднеквадратичная ошибка равна 0. Если предсказания хранятся столбцом формы (3, 1), а цели — вектором формы (3,), broadcasting дополняет форму целей слева до (1, 3) и растягивает обе: разность получает форму (3, 3) и сравнивает каждое предсказание с каждой целью. Среднее девяти квадратов равно 12/9 = 1.333, и обучение тянет все предсказания к среднему значению целей. Справа — то же после pred.squeeze(1).'
  : 'The predictions (1, 2, 3) equal the targets (1, 2, 3), so the correct mean squared error is 0. When the predictions are stored as a column of shape (3, 1) and the targets as a vector of shape (3,), broadcasting pads the targets\' shape on the left to (1, 3) and stretches both: the difference has shape (3, 3) and compares every prediction with every target. The mean of the nine squares is 12/9 = 1.333, and training pulls every prediction towards the mean of the targets. Right: the same after pred.squeeze(1).';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 226" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <text class="f-small f-t-muted" x="16" y="20">{t.a}</text>
    <Vec x={196} y={60} values={S(y)} tone="x" dir="row" cw={44} label={t.yA} />
    <Vec x={120} y={96} values={S(yhat)} tone="y" cw={44} label={t.yhatA} labelPos="left" />
    {grid.map((row, i) => <Vec x={196} y={96 + 22 * i} values={S(row)} tone="h" dir="row" cw={44} />)}
    <text class="f-small" x="262" y="182" text-anchor="middle">{t.grid}</text>
    <text class="f-small f-t-red" x="262" y="204" text-anchor="middle">{t.meanA}</text>
    <path class="f-thin f-muted" d="M 410 30 V 210" />
    <text class="f-small f-t-muted" x="430" y="20">{t.b}</text>
    <Vec x={540} y={52} values={S(yhat)} tone="y" dir="row" cw={44} label="ŷ" labelPos="left" />
    <Vec x={540} y={88} values={S(y)} tone="x" dir="row" cw={44} label="y" labelPos="left" />
    <Vec x={540} y={140} values={S(right)} tone="h" dir="row" cw={44} label={t.sq} labelPos="left" />
    <text class="f-small f-t-green" x="606" y="196" text-anchor="middle">{t.meanB}</text>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 404" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <text class="f-small f-t-muted" x="16" y="20">{t.titleN}</text>
    <Vec x={150} y={56} values={S(y)} tone="x" dir="row" cw={44} label={t.yN} />
    <Vec x={90} y={88} values={S(yhat)} tone="y" cw={44} />
    <text class="f-math" x="84" y="124" text-anchor="end">ŷ</text>
    {grid.map((row, i) => <Vec x={150} y={88 + 22 * i} values={S(row)} tone="h" dir="row" cw={44} />)}
    <text class="f-small" x="216" y="176" text-anchor="middle">{t.gridN}</text>
    <text class="f-small f-t-red" x="216" y="198" text-anchor="middle">{t.meanA}</text>
    <path class="f-thin f-muted" d="M 16 222 H 344" />
    <text class="f-small f-t-muted" x="16" y="248">{t.titleNB}</text>
    <Vec x={150} y={264} values={S(yhat)} tone="y" dir="row" cw={44} label="ŷ" labelPos="left" />
    <Vec x={150} y={296} values={S(y)} tone="x" dir="row" cw={44} label="y" labelPos="left" />
    <Vec x={150} y={338} values={S(right)} tone="h" dir="row" cw={44} label={t.sq} labelPos="left" />
    <text class="f-small f-t-green" x="216" y="390" text-anchor="middle">{t.meanB}</text>
  </svg>
</Figure>
