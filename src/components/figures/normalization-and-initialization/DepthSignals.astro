---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Theory at initialization, width → ∞, 50 layers or blocks, inputs of mean square 1 and correlation 0.
// Residual blocks x + F(x) with F(u) = W2 ReLU(W1 u), Var W1 = 2/n, Var W2 = 1/n, so E[F(u)^2] = E[u^2].
// Correlation after a He ReLU layer: the normalized arc-cosine kernel f(c) = (√(1 − c²) + (π − arccos c) c)/π.
const L = 50;
const f = (c: number) => (Math.sqrt(Math.max(0, 1 - c * c)) + (Math.PI - Math.acos(Math.max(-1, Math.min(1, c)))) * c) / Math.PI;
type Series = { key: string; q: number[]; c: number[] };
const run = (key: string, step: (Q: number, C: number) => [number, number]): Series => {
  let Q = 1, C = 0;
  const q = [Q], c = [C / Q];
  for (let l = 1; l <= L; l += 1) {
    [Q, C] = step(Q, C);
    q.push(Q); c.push(C / Q);
  }
  return { key, q, c };
};
const series = [
  run('plain', (Q, C) => [Q, Q * f(C / Q)]),                          // plain He stack: scale kept, correlation f(c)
  run('none', (Q, C) => [2 * Q, C + Q * f(C / Q)]),                   // residual without normalization: variances add
  run('pre', (Q, C) => [Q + 1, C + f(C / Q)]),                         // pre-norm: the branch sees mean square 1
  run('scaled', (Q, C) => [Q * (1 + 1 / L), C + (Q * f(C / Q)) / L]),  // branch scaled by 1/√L
];
const at = (k: string) => series.find((s) => s.key === k)!;
const chk = [at('none').q[L].toExponential(2), at('pre').q[L].toFixed(0), at('scaled').q[L].toFixed(2),
  at('plain').c[10].toFixed(3), at('plain').c[30].toFixed(3), at('plain').c[50].toFixed(3), at('none').c[50].toFixed(3),
  at('pre').c[10].toFixed(3), at('pre').c[50].toFixed(3), at('scaled').c[50].toFixed(3)].join(' ');
if (chk !== '1.13e+15 51 2.69 0.872 0.972 0.988 0.960 0.441 0.595 0.251') throw new Error(`DepthSignals: theory drifted from the note (${chk})`);

const tone: Record<string, string> = { plain: 'f-muted f-dash', none: 'f-red', pre: 'f-blue', scaled: 'f-green' };
const t = ru
  ? { title: 'Масштаб сигнала и различия между примерами с ростом глубины', x: 'слой или блок l', yq: 'средний квадрат xₗ (лог. шкала)', yc: 'косинус между двумя входами',
      lab: { plain: 'простая стопка, Хе', none: 'остаточная, без нормализации', pre: 'остаточная, pre-norm', scaled: 'остаточная, ветвь / √L' } as Record<string, string>,
      desc: 'Слева: средний квадрат сигнала через 50 слоёв в логарифмической шкале. Остаточная стопка без нормализации растёт как 2 в степени l, до 1.1·10^15; pre-norm — линейно, до 51; с ветвью, делённой на корень из L, — до 2.7; простая стопка с инициализацией Хе остаётся на 1. Справа: косинус между представлениями двух изначально ортогональных входов. В простой стопке он растёт к 1 (0.99 на 50-м слое), без нормализации — к 0.96, в pre-norm — до 0.59, с масштабированной ветвью — до 0.25.' }
  : { title: 'Scale and the difference between examples across depth', x: 'layer or block l', yq: 'mean square of xₗ (log scale)', yc: 'cosine between two inputs',
      lab: { plain: 'plain stack, He', none: 'residual, no normalization', pre: 'residual, pre-norm', scaled: 'residual, branch / √L' } as Record<string, string>,
      desc: 'Left: the mean square of the signal over 50 layers, on a log scale. A residual stack without normalization grows like 2 to the power l, to 1.1·10^15; pre-norm grows linearly, to 51; with the branch divided by the square root of L it reaches 2.7; a plain stack with He initialization stays at 1. Right: the cosine between the representations of two initially orthogonal inputs. In the plain stack it climbs to 1 (0.99 at layer 50), without normalization to 0.96, with pre-norm to 0.59, with the scaled branch to 0.25.' };
const id = 'norm-depth-signals';
const caption = ru
  ? 'Теория для бесконечной ширины при инициализации, 50 слоёв или блоков, входы со средним квадратом 1 и корреляцией 0. Остаточная ветвь F(u) = W₂ ReLU(W₁ u) с дисперсиями весов 2/n и 1/n возвращает средний квадрат своего входа. Слева: дисперсии складываются, поэтому без нормализации каждый блок удваивает сигнал, pre-norm добавляет 1 за блок, а ветвь, делённая на √L, умножает на 1 + 1/L, и (1.02)⁵⁰ = 2.69; простая стопка с инициализацией Хе остаётся на 1. Справа: простая стопка ReLU-слоёв отображает любые два входа почти в одно направление (0.87 после 10 слоёв, 0.99 после 50), тогда как тождественный путь остаточной стопки переносит их различие вверх. Код в конце заметки измеряет те же величины при ширине 256 и получает близкие числа.'
  : 'Theory for infinite width at initialization, 50 layers or blocks, inputs with mean square 1 and correlation 0. The residual branch F(u) = W₂ ReLU(W₁ u), with weight variances 2/n and 1/n, returns the mean square of its input. Left: variances add, so without normalization every block doubles the signal, pre-norm adds 1 per block, and a branch divided by √L multiplies it by 1 + 1/L, with (1.02)⁵⁰ = 2.69; the plain He stack stays at 1. Right: a plain ReLU stack maps any two inputs to almost the same direction (0.87 after 10 layers, 0.99 after 50), while the identity path of a residual stack carries their difference upwards. The Code section measures the same quantities at width 256 and gets close numbers.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 392, P: [{ x: [76, 330], y: [44, 270] }, { x: [458, 712], y: [44, 270] }], leg: [[76, 336], [76, 360], [430, 336], [430, 360]] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 748, P: [{ x: [64, 300], y: [44, 250] }, { x: [64, 300], y: [342, 548] }], leg: [[16, 640], [16, 664], [16, 688], [16, 712]] },
];
const supers = ['1', '10⁵', '10¹⁰', '10¹⁵'];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => {
    const [A, Bp] = Ly.P;
    const ax = scale([0, L], A.x as [number, number]), ay = scale([-0.6, 16], [A.y[1], A.y[0]]);
    const bx = scale([0, L], Bp.x as [number, number]), by = scale([0, 1], [Bp.y[1], Bp.y[0]]);
    const ls = Array.from({ length: L + 1 }, (_, l) => l);
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
        {[0, 5, 10, 15].map((v) => <path class="f-grid" d={`M ${A.x[0]} ${ay(v)} H ${A.x[1]}`} />)}
        {[0.25, 0.5, 0.75, 1].map((v) => <path class="f-grid" d={`M ${Bp.x[0]} ${by(v)} H ${Bp.x[1]}`} />)}
        <path class="f-axis" d={`M ${A.x[0]} ${A.y[0]} V ${A.y[1]} H ${A.x[1]} M ${Bp.x[0]} ${Bp.y[0]} V ${Bp.y[1]} H ${Bp.x[1]}`} />
        {[0, 5, 10, 15].map((v, i) => <text class="f-note" x={A.x[0] - 7} y={ay(v) + 5} text-anchor="end">{supers[i]}</text>)}
        {[0, 0.5, 1].map((v) => <text class="f-note" x={Bp.x[0] - 7} y={by(v) + 5} text-anchor="end">{v.toFixed(1)}</text>)}
        {[0, 25, 50].map((v) => <text class="f-note" x={ax(v)} y={A.y[1] + 18} text-anchor="middle">{v}</text>)}
        {[0, 25, 50].map((v) => <text class="f-note" x={bx(v)} y={Bp.y[1] + 18} text-anchor="middle">{v}</text>)}
        <text class="f-small f-t-muted" x={(A.x[0] + A.x[1]) / 2} y={A.y[1] + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={(Bp.x[0] + Bp.x[1]) / 2} y={Bp.y[1] + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={A.x[0] - 40} y={A.y[0] - 16}>{t.yq}</text>
        <text class="f-small f-t-muted" x={Bp.x[0] - 40} y={Bp.y[0] - 16}>{t.yc}</text>
        {series.map((s) => (
          <g>
            <path class={`f-line ${tone[s.key]}`} d={polyline(ls.map((l) => [ax(l), ay(Math.log10(s.q[l]))]))} />
            <path class={`f-line ${tone[s.key]}`} d={polyline(ls.map((l) => [bx(l), by(s.c[l])]))} />
          </g>
        ))}
        <text class="f-small f-t-red f-halo" x={ax(L) - 30} y={ay(Math.log10(at('none').q[L])) + 4} text-anchor="end">1.1·10¹⁵</text>
        <text class="f-small f-t-blue f-halo" x={ax(L) + 6} y={ay(Math.log10(at('pre').q[L])) - 6}>51</text>
        <text class="f-small f-t-green f-halo" x={ax(L) + 6} y={ay(Math.log10(at('scaled').q[L])) - 8}>2.7</text>
        <text class="f-small f-t-muted f-halo" x={bx(L) + 6} y={by(at('plain').c[L]) - 6}>0.99</text>
        <text class="f-small f-t-red f-halo" x={bx(L) + 6} y={by(at('none').c[L]) + 14}>0.96</text>
        <text class="f-small f-t-blue f-halo" x={bx(L) + 6} y={by(at('pre').c[L]) + 5}>0.59</text>
        <text class="f-small f-t-green f-halo" x={bx(L) + 6} y={by(at('scaled').c[L]) + 5}>0.25</text>
        {['plain', 'none', 'pre', 'scaled'].map((k, i) => (
          <g>
            <path class={`f-line ${tone[k]}`} d={`M ${Ly.leg[i][0]} ${Ly.leg[i][1] - 4} h 26`} />
            <text class="f-small" x={Ly.leg[i][0] + 34} y={Ly.leg[i][1]}>{t.lab[k]}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
