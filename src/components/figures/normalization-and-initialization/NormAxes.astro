---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A batch of N = 4 examples with C = 6 channels; each cell stands for the H × W positions of one channel of one example.
// Highlighted: the values that share one mean and one variance, for the statistic of example 2 (row index 1) and channel 2 (column index 1).
const N = 4, C = 6, G = 2, row = 1, col = 1;
type Panel = { key: string; on: (n: number, c: number) => boolean };
const panels: Panel[] = [
  { key: 'bn', on: (n, c) => c === col },
  { key: 'ln', on: (n) => n === row },
  { key: 'in', on: (n, c) => n === row && c === col },
  { key: 'gn', on: (n, c) => n === row && Math.floor(c / (C / G)) === Math.floor(col / (C / G)) },
];
const counts = panels.map((p) => {
  let k = 0;
  for (let n = 0; n < N; n += 1) for (let c = 0; c < C; c += 1) if (p.on(n, c)) k += 1;
  return k;
});
if (counts.join(' ') !== `${N} ${C} 1 ${C / G}`) throw new Error(`NormAxes: highlighted cells drifted (${counts.join(' ')})`);

const t = ru
  ? { title: 'Какие значения делят одно среднее и одну дисперсию', n: 'N', c: 'C →',
      name: { bn: 'BatchNorm', ln: 'LayerNorm', in: 'InstanceNorm', gn: `GroupNorm (G = ${G})` } as Record<string, string>,
      cnt: { bn: 'N · H · W значений', ln: 'C · H · W значений', in: 'H · W значений', gn: 'C/G · H · W значений' } as Record<string, string>,
      dep: { bn: 'зависит от батча', ln: 'один пример', in: 'один пример', gn: 'один пример' } as Record<string, string>,
      foot: ['Клетка — H × W позиций одного канала одного примера.', 'RMSNorm берёт множество LayerNorm и не вычитает среднее.'],
      footN: ['Клетка — H × W позиций', 'одного канала одного примера.', 'RMSNorm берёт множество LayerNorm', 'и не вычитает среднее.'],
      desc: 'Четыре сетки: 4 примера (строки) на 6 каналов (столбцы). У BatchNorm выделен один столбец — все примеры. У LayerNorm — одна строка, все каналы. У InstanceNorm — одна клетка. У GroupNorm с двумя группами — половина строки, три канала одного примера.' }
  : { title: 'Which values share one mean and one variance', n: 'N', c: 'C →',
      name: { bn: 'batch norm', ln: 'layer norm', in: 'instance norm', gn: `group norm (G = ${G})` } as Record<string, string>,
      cnt: { bn: 'N · H · W values', ln: 'C · H · W values', in: 'H · W values', gn: 'C/G · H · W values' } as Record<string, string>,
      dep: { bn: 'depends on the batch', ln: 'one example', in: 'one example', gn: 'one example' } as Record<string, string>,
      foot: ['Each cell is the H × W positions of one channel of one example.', 'RMSNorm uses the set of layer norm and does not subtract the mean.'],
      footN: ['Each cell is the H × W positions', 'of one channel of one example.', 'RMSNorm uses the set of layer norm', 'and does not subtract the mean.'],
      desc: 'Four grids of 4 examples (rows) by 6 channels (columns). Batch norm highlights one column, all examples. Layer norm highlights one row, all channels. Instance norm highlights one cell. Group norm with two groups highlights half a row, three channels of one example.' };
const id = 'norm-axes';
const caption = ru
  ? 'Батч из N = 4 примеров с C = 6 каналами; клетка обозначает все H × W позиций одного канала одного примера. Выделены значения, по которым вычисляются одно среднее и одна дисперсия. Слой во всех случаях вычисляет γ(x − μ)/√(σ² + ε) + β; различается только множество. Только у BatchNorm оно проходит через примеры, поэтому он зависит от размера батча и ведёт себя по-разному при обучении и оценке. GroupNorm с G = 1 совпадает с LayerNorm, с G = C — с InstanceNorm. В трансформере строка — это токен, а столбцы — его d признаков, и LayerNorm нормализует каждый токен отдельно.'
  : 'A batch of N = 4 examples with C = 6 channels; a cell stands for all H × W positions of one channel of one example. Highlighted: the values over which one mean and one variance are computed. The layer always computes γ(x − μ)/√(σ² + ε) + β; only the set changes. Only batch norm’s set runs across examples, which is why it depends on the batch size and behaves differently in training and evaluation. Group norm with G = 1 is layer norm, with G = C instance norm. In a Transformer a row is a token and the columns are its d features, so layer norm normalizes each token separately.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 272, cell: 22, pos: (i: number) => [52 + i * 184, 70], foot: [238, 258] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 500, cell: 20, pos: (i: number) => [40 + (i % 2) * 176, 66 + Math.floor(i / 2) * 196], foot: [420, 442, 464, 486] },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((Ly) => (
    <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
      <title id={`${id}-${Ly.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${Ly.sfx}-d`}>{t.desc}</desc>
      {panels.map((p, i) => {
        const [gx, gy] = Ly.pos(i);
        const w = C * Ly.cell, h = N * Ly.cell;
        return (
          <g>
            <text class="f-label" x={gx + w / 2} y={gy - 30} text-anchor="middle">{t.name[p.key]}</text>
            <text class="f-note" x={gx} y={gy - 8}>{t.c}</text>
            <text class="f-note" x={gx - 8} y={gy + Ly.cell * 0.7} text-anchor="end">{t.n}</text>
            {Array.from({ length: N }, (_, n) => Array.from({ length: C }, (_, c) => (
              <rect x={gx + c * Ly.cell} y={gy + n * Ly.cell} width={Ly.cell} height={Ly.cell}
                class={p.on(n, c) ? 'f-fill-blue' : 'f-box-soft'} style={p.on(n, c) ? 'stroke: var(--fig-blue); stroke-width: 1.3; fill-opacity: .5' : undefined} />
            )))}
            <text class="f-small" x={gx + w / 2} y={gy + h + 22} text-anchor="middle">{t.cnt[p.key]}</text>
            <text class={`f-small ${p.key === 'bn' ? 'f-t-red' : 'f-t-muted'}`} x={gx + w / 2} y={gy + h + 42} text-anchor="middle">{t.dep[p.key]}</text>
          </g>
        );
      })}
      {Ly.foot.map((fy, k) => <text class="f-small f-t-muted" x="16" y={fy}>{(Ly.foot.length === 2 ? t.foot : t.footN)[k]}</text>)}
    </svg>
  ))}
</Figure>
