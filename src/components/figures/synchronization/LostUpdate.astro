---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Two threads run counter++ (load, add, store) once each on a counter that holds 5, in the interleaving
// A load, B load, A add, B add, A store, B store. The state after every step is simulated here.
type Step = { who: 'A' | 'B'; op: 'lw' | 'addi' | 'sw' };
const order: Step[] = [
  { who: 'A', op: 'lw' }, { who: 'B', op: 'lw' }, { who: 'A', op: 'addi' },
  { who: 'B', op: 'addi' }, { who: 'A', op: 'sw' }, { who: 'B', op: 'sw' },
];
let mem = 5;
const reg: Record<'A' | 'B', number | null> = { A: null, B: null };
const rows = order.map((s) => {
  if (s.op === 'lw') reg[s.who] = mem;
  else if (s.op === 'addi') reg[s.who] = (reg[s.who] as number) + 1;
  else mem = reg[s.who] as number;
  return { ...s, a: reg.A, b: reg.B, mem };
});
if (mem !== 6) throw new Error(`LostUpdate: final counter ${mem}, expected 6`);

// All interleavings of the two three-step sequences: how many lose an update (the note quotes 18 of 20).
let lost = 0, total = 0;
for (let m = 0; m < 64; m++) {
  if ([0, 1, 2, 3, 4, 5].filter((k) => (m >> k) & 1).length !== 3) continue;
  total++;
  let x = 5; const r = { A: 0, B: 0 }, st = { A: 0, B: 0 };
  for (let k = 0; k < 6; k++) {
    const t = (m >> k) & 1 ? 'A' : 'B';
    const op = st[t]++;
    if (op === 0) r[t] = x; else if (op === 1) r[t] += 1; else x = r[t];
  }
  if (x === 6) lost++;
}
if (total !== 20 || lost !== 18) throw new Error(`LostUpdate: ${lost} of ${total} interleavings lose an update`);

const reg1 = (w: 'A' | 'B') => (w === 'A' ? 't0' : 't1');
const instr = (s: Step, short: boolean) => {
  const r = reg1(s.who);
  if (short) return `${s.op} ${r}`;
  return s.op === 'lw' ? `lw ${r}, 0(a1)` : s.op === 'addi' ? `addi ${r}, ${r}, 1` : `sw ${r}, 0(a1)`;
};
const show = (v: number | null) => (v === null ? '–' : String(v));
const t = ru
  ? {
      title: 'Потерянное обновление: два counter++ увеличили счётчик на 1',
      headA: 'поток A (ядро 1)', headB: 'поток B (ядро 2)', headAs: 'A', headBs: 'B', mem: 'counter',
      result: ['ожидалось 7, получено 6:', 'обновление A потеряно'],
      steps: ['A загружает 5 в t0', 'B загружает 5 в t1: A ещё не записал', 'A прибавляет 1: t0 = 6', 'B прибавляет 1: t1 = 6', 'A записывает 6', 'B записывает 6 поверх: обновление A потеряно'],
      desc: 'Шесть строк, по одной на шаг. В каждой — команда потока A или B, значения регистров t0 и t1 и значение counter в памяти. A загружает 5, B загружает 5, оба прибавляют 1, A записывает 6, B записывает 6. Итог 6 вместо 7.',
    }
  : {
      title: 'A lost update: two counter++ raised the counter by 1',
      headA: 'thread A (core 1)', headB: 'thread B (core 2)', headAs: 'A', headBs: 'B', mem: 'counter',
      result: ['expected 7, got 6:', "A's increment is lost"],
      steps: ['A loads 5 into t0', 'B loads 5 into t1: A has not stored yet', 'A adds 1: t0 = 6', 'B adds 1: t1 = 6', 'A stores 6', "B stores 6 over it: A's update is lost"],
      desc: 'Six rows, one per step. Each shows the instruction of thread A or B, the registers t0 and t1, and the value of counter in memory. A loads 5, B loads 5, both add 1, A stores 6, B stores 6. The result is 6 instead of 7.',
    };

interface Layout {
  cls: string; W: number; H: number; short: boolean; top: number; rowH: number; ch: number; badgeX: number;
  ax: number; aw: number; t0: [number, number]; m: [number, number]; t1: [number, number]; bx: number; headY: number; resY: number[];
}
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 334, short: false, top: 60, rowH: 40, ch: 26, badgeX: 22, ax: 150, aw: 130, t0: [265, 50], m: [350, 60], t1: [445, 50], bx: 610, headY: 40, resY: [316] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 384, short: true, top: 50, rowH: 46, ch: 28, badgeX: 14, ax: 72, aw: 70, t0: [112, 36], m: [166, 48], t1: [232, 36], bx: 310, headY: 32, resY: [342, 362] },
];
const id = 'synchronization-lost-update';
const mono = 'font-family: var(--mono)';
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? 'Каждый поток выполняет три команды counter++ на RISC-V; у каждого свои регистры (t0 у A, t1 у B), память общая. Синие стрелки — загрузки из памяти в регистр, красные — записи из регистра в память; жирная рамка — значение, изменённое на этом шаге. Обе загрузки происходят раньше обеих записей, поэтому оба потока вычисляют 6. Из 20 возможных чередований шести шагов обновление теряется в 18; правильный результат 7 дают только два, где один поток целиком выполняется раньше другого.'
    : 'Each thread runs the three RISC-V instructions of counter++; each has its own registers (t0 for A, t1 for B), and the memory is shared. Blue arrows are loads from memory into a register, red arrows stores from a register into memory; a bold outline marks the value changed in that step. Both loads happen before both stores, so both threads compute 6. Of the 20 possible interleavings of the six steps, 18 lose an update; only the 2 that run one thread entirely before the other give 7.'}
>
  {layouts.map((L) => {
    const cy = (i: number) => L.top + i * L.rowH;
    const cell = (x: number, w: number, y: number, v: string, tone: string, bold: boolean) => ({ x, w, y, v, tone, bold });
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        <text class="f-small f-t-muted" x={L.ax} y={L.headY} text-anchor="middle">{L.short ? t.headAs : t.headA}</text>
        <text class="f-small f-t-muted" x={L.t0[0] + L.t0[1] / 2} y={L.headY} text-anchor="middle" style={mono}>t0</text>
        <text class="f-small f-t-blue" x={L.m[0] + L.m[1] / 2} y={L.headY} text-anchor="middle" style={mono}>{t.mem}</text>
        <text class="f-small f-t-muted" x={L.t1[0] + L.t1[1] / 2} y={L.headY} text-anchor="middle" style={mono}>t1</text>
        <text class="f-small f-t-muted" x={L.bx} y={L.headY} text-anchor="middle">{L.short ? t.headBs : t.headB}</text>
        {rows.map((r, i) => {
          const y = cy(i), mid = y + L.ch / 2;
          const prev = i === 0 ? { a: null, b: null, mem: 5 } : rows[i - 1];
          const cells = [
            cell(L.t0[0], L.t0[1], y, show(r.a), 'var(--muted)', r.a !== prev.a),
            cell(L.m[0], L.m[1], y, String(r.mem), toneVar.h, r.mem !== prev.mem),
            cell(L.t1[0], L.t1[1], y, show(r.b), 'var(--muted)', r.b !== prev.b),
          ];
          const ix = r.who === 'A' ? L.ax : L.bx;
          const regEdge = r.who === 'A' ? L.t0[0] + L.t0[1] : L.t1[0];
          const memEdge = r.who === 'A' ? L.m[0] : L.m[0] + L.m[1];
          const dir = r.who === 'A' ? 1 : -1;
          const load = r.op === 'lw', store = r.op === 'sw';
          const from = load ? memEdge - 2 * dir : regEdge + 2 * dir, to = load ? regEdge + 3 * dir : memEdge - 3 * dir;
          return (
            <g data-s={`${i + 1}`}>
              <Badge x={L.badgeX} y={mid} n={i + 1} />
              <rect x={ix - L.aw / 2} y={y} width={L.aw} height={L.ch} rx="6" style={`fill: var(--paper-strong); stroke: var(--line); stroke-width: 1`} />
              <text class="f-small" x={ix} y={mid + 4.5} text-anchor="middle" style={mono}>{instr(r, L.short)}</text>
              {cells.map((c) => (
                <g>
                  <rect x={c.x} y={c.y} width={c.w} height={L.ch} style={`fill: ${c.tone}; fill-opacity: 0.12; stroke: ${c.tone}; stroke-width: ${c.bold ? 2.4 : 1}`} />
                  <text class="f-small" x={c.x + c.w / 2} y={c.y + L.ch / 2 + 4.5} text-anchor="middle">{c.v}</text>
                </g>
              ))}
              {(load || store) && <path class={`f-line ${load ? 'f-blue' : 'f-red'}`} d={`M ${from} ${mid} H ${to}`} marker-end={`url(#f-arrow-${load ? 'blue' : 'red'})`} />}
            </g>
          );
        })}
        <g data-s="6">
          {(L.short ? t.result : [t.result.join(' ')]).map((line, k) => (
            <text class="f-small f-t-red" x={L.short ? L.W / 2 : L.m[0] + L.m[1] / 2} y={L.resY[k]} text-anchor="middle">{line}</text>
          ))}
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
