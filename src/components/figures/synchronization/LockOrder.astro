---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Two transfers between accounts X and Y. Left: each thread locks its source account first, so the orders are
// opposite and the hold/wait graph has a cycle. Right: both lock X before Y, and the graph has no cycle.
const t = ru
  ? {
      title: 'Взаимная блокировка и порядок захвата',
      left: 'разный порядок: взаимная блокировка', right: 'один порядок, X раньше Y: цикла нет',
      lockX: 'мьютекс X', lockY: 'мьютекс Y', t1: 'поток 1', t2: 'поток 2', held: 'захвачен', waits: 'ждёт',
      codeL: ['поток 1: lock(X); lock(Y)', 'поток 2: lock(Y); lock(X)'], codeR: ['поток 1: lock(X); lock(Y)', 'поток 2: lock(X); lock(Y)'],
      desc: 'Две панели. Слева мьютекс X захвачен потоком 1, поток 1 ждёт мьютекс Y, Y захвачен потоком 2, поток 2 ждёт X: стрелки образуют цикл. Справа оба мьютекса захвачены потоком 1, а поток 2 ждёт X: цикла нет, поток 1 закончит и отпустит оба.',
    }
  : {
      title: 'Deadlock and lock ordering',
      left: 'opposite orders: deadlock', right: 'one order, X before Y: no cycle',
      lockX: 'lock X', lockY: 'lock Y', t1: 'thread 1', t2: 'thread 2', held: 'held by', waits: 'waits for',
      codeL: ['thread 1: lock(X); lock(Y)', 'thread 2: lock(Y); lock(X)'], codeR: ['thread 1: lock(X); lock(Y)', 'thread 2: lock(X); lock(Y)'],
      desc: 'Two panels. On the left, lock X is held by thread 1, thread 1 waits for lock Y, Y is held by thread 2, and thread 2 waits for X: the arrows form a cycle. On the right, both locks are held by thread 1 and thread 2 waits for X: there is no cycle, and thread 1 finishes and releases both.',
    };

// Node boxes relative to a panel's origin; edges as paths with a label position.
const box = { X: [20, 50], T1: [250, 50], Y: [250, 170], T2: [20, 170] } as const;
const BW = 100, BH = 40;
type Edge = { d: string; kind: 'held' | 'waits'; at: [number, number]; anchor: 'start' | 'middle' | 'end' };
const heldTop: Edge = { d: 'M 120 70 H 247', kind: 'held', at: [185, 62], anchor: 'middle' };
const leftEdges: Edge[] = [
  heldTop,
  { d: 'M 300 90 V 167', kind: 'waits', at: [292, 134], anchor: 'end' },
  { d: 'M 250 190 H 123', kind: 'held', at: [185, 182], anchor: 'middle' },
  { d: 'M 70 170 V 93', kind: 'waits', at: [78, 134], anchor: 'start' },
];
const rightEdges: Edge[] = [
  heldTop,
  { d: 'M 300 170 V 93', kind: 'held', at: [292, 134], anchor: 'end' },
  { d: 'M 70 170 V 93', kind: 'waits', at: [78, 134], anchor: 'start' },
];
const panels = [
  { title: t.left, edges: leftEdges, code: t.codeL, cycle: true },
  { title: t.right, edges: rightEdges, code: t.codeR, cycle: false },
];
// Check the claim of the figure: the left graph has a cycle, the right one does not.
const succ = (edges: Edge[]) => {
  const ends = (e: Edge) => {
    const n = e.d.match(/-?\d+(\.\d+)?/g)!.map(Number);
    const p0 = [n[0], n[1]], p1 = e.d.includes('H') ? [n[2], n[1]] : [n[0], n[2]];
    const at = (p: number[]) => (Object.keys(box) as (keyof typeof box)[]).find((k) => p[0] >= box[k][0] - 4 && p[0] <= box[k][0] + BW + 4 && p[1] >= box[k][1] - 4 && p[1] <= box[k][1] + BH + 4)!;
    return [at(p0), at(p1)];
  };
  return edges.map(ends);
};
const hasCycle = (edges: Edge[]) => {
  const g = succ(edges);
  const next = (n: string) => g.filter(([a]) => a === n).map(([, b]) => b);
  const seen = new Set<string>(), stack = new Set<string>();
  const dfs = (n: string): boolean => { if (stack.has(n)) return true; if (seen.has(n)) return false; seen.add(n); stack.add(n); const r = next(n).some(dfs); stack.delete(n); return r; };
  return Object.keys(box).some(dfs);
};
for (const p of panels) if (hasCycle(p.edges) !== p.cycle) throw new Error(`LockOrder: cycle check failed for "${p.title}"`);

const label = { X: t.lockX, Y: t.lockY, T1: t.t1, T2: t.t2 };
// Move a path given as 'M x y H x' or 'M x y V y' to a panel origin.
const shift = (d: string, ox: number, oy: number) => {
  const [, x, y, c, v] = d.split(' ');
  return `M ${Number(x) + ox} ${Number(y) + oy} ${c} ${Number(v) + (c === 'H' ? ox : oy)}`;
};
const isLock = (k: string) => k === 'X' || k === 'Y';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 286, origins: [[0, 0], [390, 0]] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 572, origins: [[0, 0], [0, 286]] },
];
const id = 'synchronization-lock-order';
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? 'Сплошная синяя стрелка ведёт от мьютекса к потоку, который его держит, пунктирная красная — от потока к мьютексу, которого он ждёт. Слева два перевода между счетами X и Y захватывают мьютексы в разном порядке, и после того как каждый захватил свой первый мьютекс, граф содержит цикл: ни один поток не продвинется. Справа оба захватывают X раньше Y; второй поток ждёт уже на первом мьютексе, ничего не держа, и цикла нет.'
    : 'A solid blue arrow leads from a lock to the thread that holds it, a dashed red arrow from a thread to the lock it waits for. On the left, two transfers between accounts X and Y take the locks in opposite orders, and after each has taken its first lock the graph has a cycle: neither thread can proceed. On the right, both take X before Y; the second thread waits at the first lock while holding nothing, and there is no cycle.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{t.title}</title>
      <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
      {L.W === 760 ? <path class="f-grid" d="M 380 10 V 276" /> : <path class="f-grid" d="M 10 280 H 350" />}
      {panels.map((p, k) => {
        const [ox, oy] = L.origins[k];
        return (
          <g>
            <text class={`f-small ${p.cycle ? 'f-t-red' : 'f-t-green'}`} x={ox + 185} y={oy + 24} text-anchor="middle" style="font-weight: 650">{p.title}</text>
            {p.edges.map((e) => (
              <g>
                <path class={`f-line ${e.kind === 'held' ? 'f-blue' : 'f-red f-dash'}`} d={shift(e.d, ox, oy)} marker-end={`url(#f-arrow-${e.kind === 'held' ? 'blue' : 'red'})`} />
                <text class={`f-small f-halo ${e.kind === 'held' ? 'f-t-blue' : 'f-t-red'}`} x={ox + e.at[0]} y={oy + e.at[1]} text-anchor={e.anchor}>{e.kind === 'held' ? t.held : t.waits}</text>
              </g>
            ))}
            {(Object.keys(box) as (keyof typeof box)[]).map((n) => (
              <g>
                <rect class={isLock(n) ? 'f-fill-amber' : 'f-fill-blue'} x={ox + box[n][0]} y={oy + box[n][1]} width={BW} height={BH} rx="7" />
                <rect class={`f-thin ${isLock(n) ? 'f-amber' : 'f-blue'}`} x={ox + box[n][0]} y={oy + box[n][1]} width={BW} height={BH} rx="7" fill="none" />
                <text class="f-label" x={ox + box[n][0] + BW / 2} y={oy + box[n][1] + BH / 2 + 5} text-anchor="middle">{label[n]}</text>
              </g>
            ))}
            {p.code.map((line, j) => <text class="f-small" x={ox + 20} y={oy + 244 + j * 18} style="font-family: var(--mono)">{line}</text>)}
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
