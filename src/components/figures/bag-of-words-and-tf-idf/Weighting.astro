---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The worked example of the note: three documents after stopword removal, a five-token vocabulary.
const vocab = ['cat', 'dog', 'sat', 'ran', 'fast'];
const docs = [['cat', 'sat'], ['dog', 'ran', 'fast'], ['cat', 'ran', 'fast', 'fast']];
const counts = docs.map((d) => vocab.map((t) => d.filter((x) => x === t).length));
const df = vocab.map((_, j) => counts.filter((row) => row[j] > 0).length);
const idf = df.map((n) => Math.log(docs.length / n));
const tfidf = counts.map((row, i) => row.map((c, j) => (c / docs[i].length) * idf[j]));
const maxW = Math.max(...tfidf.flat());
const maxIdf = Math.max(...idf);
const f3 = (v: number) => (v === 0 ? '0' : v.toFixed(3));
if (f3(idf[0]) !== '0.405' || f3(tfidf[2][4]) !== '0.203') throw new Error('bag-of-words Weighting: numbers drifted from the note');

interface Layout { cls: string; W: number; H: number; cw: number; ch: number; a: [number, number]; b: [number, number]; clf: [number, number, number, number]; arrowAB: string; arrowBC: string; labAB: [number, number]; stacked: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 700, H: 190, cw: 44, ch: 26, a: [40, 52], b: [362, 52], clf: [604, 58, 92, 74], arrowAB: 'M 268 91 H 334', arrowBC: 'M 588 91 H 600', labAB: [300, 84], stacked: false },
  { cls: 'fig-narrow', W: 360, H: 470, cw: 52, ch: 26, a: [40, 52], b: [40, 282], clf: [40, 398, 260, 60], arrowAB: 'M 170 178 V 240', arrowBC: 'M 170 366 V 392', labAB: [180, 205], stacked: true },
];
const id = 'bag-of-words-weighting';
const L0 = ru
  ? { counts: 'счётчики N(t, d)', tfidf: 'tf-idf', idf: 'idf', step: ['÷ длина', '× idf'], clf: ['линейная', 'модель'], clfSub: 'softmax', clfN: 'линейная модель', clfSubN: 'z = Wx + b → softmax → тема' }
  : { counts: 'counts N(t, d)', tfidf: 'tf-idf', idf: 'idf', step: ['÷ length', '× idf'], clf: ['linear', 'model'], clfSub: 'softmax', clfN: 'linear model', clfSubN: 'z = Wx + b → softmax → topic' };
---

<Figure
  id={id}
  title={ru ? 'От счётчиков через TF-IDF к линейной модели' : 'From counts through TF-IDF to a linear model'}
  caption={ru
    ? 'Разобранный пример заметки в виде матриц. Каждый документ становится строкой счётчиков по словарю (the удалено как стоп-слово). Деление на длину документа даёт tf, а умножение на idf — 1.099 для токенов, встречающихся в одном документе (dog, sat), и 0.405 для встречающихся в двух, — поднимает вес редких токенов: в d₁ слово sat теперь весит больше, чем cat. Чем темнее клетка, тем больше вес. Строки матрицы tf-idf, обычно ещё и нормированные к единичной длине, — входы линейного классификатора, который считает по одной оценке на класс и превращает оценки в вероятности через softmax. На AG News та же матрица имеет 120 000 строк и 29 350 столбцов, почти все нулевые.'
    : 'The worked example of the note as matrices. Each document becomes a row of counts over the vocabulary (the was removed as a stopword). Dividing by the length of the document gives tf; multiplying by idf, which is 1.099 for the tokens found in one document (dog, sat) and 0.405 for those found in two, raises the weight of rare tokens: in d₁, sat now outweighs cat. Darker cells carry more weight. The rows of the tf-idf matrix, usually also scaled to unit length, are the inputs of a linear classifier that computes one score per class and turns the scores into probabilities with a softmax. On AG News the same matrix has 120,000 rows and 29,350 columns, almost all of them zero.'}
>
  {layouts.map((L) => {
    const grid = (x0: number, y0: number, vals: number[][], kind: 'count' | 'weight', title: string) => (
      <g>
        <text class="f-title" x={x0} y={y0 - 30}>{title}</text>
        {vocab.map((t, j) => <text class="f-small f-t-muted" x={x0 + j * L.cw + L.cw / 2} y={y0 - 8} text-anchor="middle" font-family="var(--mono)">{t}</text>)}
        {vals.map((row, i) => (
          <g>
            <text class="f-small f-t-muted" x={x0 - 8} y={y0 + i * L.ch + 18} text-anchor="end">d<tspan dy="3" font-size="10">{i + 1}</tspan></text>
            {row.map((v, j) => (
              <g>
                {kind === 'weight' && v > 0 && <rect x={x0 + j * L.cw} y={y0 + i * L.ch} width={L.cw} height={L.ch} class="f-solid-blue" style={`fill-opacity: ${(0.12 + 0.6 * v / maxW).toFixed(2)}`} />}
                <rect class="f-thin f-muted" x={x0 + j * L.cw} y={y0 + i * L.ch} width={L.cw} height={L.ch} fill="none" />
                <text class={`f-small${v === 0 ? ' f-t-muted' : ''}`} x={x0 + j * L.cw + L.cw / 2} y={y0 + i * L.ch + 18} text-anchor="middle">{kind === 'count' ? v : f3(v)}</text>
              </g>
            ))}
          </g>
        ))}
      </g>
    );
    const [ax, ay] = L.a, [bx, by] = L.b;
    const iy = ay + 3 * L.ch + 12;
    const [cx, cy, cw, chh] = L.clf;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Матрица счётчиков, веса idf и матрица tf-idf' : 'Count matrix, idf weights and the tf-idf matrix'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? `Матрица счётчиков: ${counts.map((r, i) => `d${i + 1}: ${r.join(' ')}`).join('; ')} по токенам ${vocab.join(', ')}. Веса idf: ${idf.map(f3).join(', ')}. Матрица tf-idf: ${tfidf.map((r, i) => `d${i + 1}: ${r.map(f3).join(' ')}`).join('; ')}. Строки идут в линейную модель с softmax.`
          : `Count matrix over the tokens ${vocab.join(', ')}: ${counts.map((r, i) => `d${i + 1}: ${r.join(' ')}`).join('; ')}. Idf weights: ${idf.map(f3).join(', ')}. Tf-idf matrix: ${tfidf.map((r, i) => `d${i + 1}: ${r.map(f3).join(' ')}`).join('; ')}. The rows go to a linear model with a softmax.`}</desc>
        {grid(ax, ay, counts, 'count', L0.counts)}
        <text class="f-small f-t-amber" x={ax - 8} y={iy + 18} text-anchor="end">{L0.idf}</text>
        {idf.map((v, j) => (
          <g>
            <rect x={ax + j * L.cw} y={iy} width={L.cw} height={L.ch} class="f-solid-amber" style={`fill: var(--fig-amber); fill-opacity: ${(0.1 + 0.45 * v / maxIdf).toFixed(2)}`} />
            <rect class="f-thin f-amber" x={ax + j * L.cw} y={iy} width={L.cw} height={L.ch} fill="none" />
            <text class="f-small" x={ax + j * L.cw + L.cw / 2} y={iy + 18} text-anchor="middle">{f3(v)}</text>
          </g>
        ))}
        <path class="f-line f-muted" d={L.arrowAB} marker-end="url(#f-arrow-muted)" />
        {L0.step.map((s, i) => <text class="f-small f-t-amber f-halo" x={L.labAB[0]} y={L.labAB[1] + (L.stacked ? i * 15 : -8 + i * 30)} text-anchor={L.stacked ? 'start' : 'middle'}>{s}</text>)}
        {grid(bx, by, tfidf, 'weight', L0.tfidf)}
        <path class="f-line f-muted" d={L.arrowBC} marker-end="url(#f-arrow-muted)" />
        <rect class="f-fill-paper" x={cx} y={cy} width={cw} height={chh} rx="7" />
        <rect class="f-thin" x={cx} y={cy} width={cw} height={chh} rx="7" fill="none" />
        {L.stacked
          ? (<g><text class="f-label" x={cx + cw / 2} y={cy + 25} text-anchor="middle">{L0.clfN}</text><text class="f-small f-t-muted" x={cx + cw / 2} y={cy + 45} text-anchor="middle">{L0.clfSubN}</text></g>)
          : (<g>{L0.clf.map((s, i) => <text class="f-label" x={cx + cw / 2} y={cy + 22 + i * 17} text-anchor="middle">{s}</text>)}<text class="f-small f-t-muted" x={cx + cw / 2} y={cy + 60} text-anchor="middle">{L0.clfSub}</text></g>)}
      </svg>
    );
  })}
</Figure>
