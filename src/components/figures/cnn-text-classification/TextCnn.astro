---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// TextCNN on the preprocessed start of an AG News headline ("Oil prices soar to all-time record, posing new menace ...").
const tokens = ['oil', 'price', 'soar', 'time', 'record', 'posing', 'new', 'menace'];
const T = tokens.length, d = 6;
const widths = [
  { k: 3, tone: 'blue', start: 0, best: 1 },
  { k: 4, tone: 'green', start: 2, best: 0 },
  { k: 5, tone: 'amber', start: 3, best: 2 },
] as const;
const classes = ru ? ['World', 'Sports', 'Business', 'Sci/Tech'] : ['World', 'Sports', 'Business', 'Sci/Tech'];
const probs = [0.12, 0.02, 0.78, 0.08];
const shade = (a: number, b: number) => 0.15 + 0.7 * ((((Math.sin(a * 12.9898 + b * 78.233) * 43758.5453) % 1) + 1) % 1);

const t = ru
  ? { input: 'вход [T, d]', maps: 'карты признаков', mapsSub: 'по одному фильтру каждой ширины', pool: 'max по времени', concat: 'конкатенация', out: 'классы', filters: '×100', linear: 'linear + softmax', narrow: ['эмбеддинги [B, T, 100]', 'свёртки k = 3, 4, 5', 'по 100 фильтров каждая', 'max по времени: 3 × [B, 100]', 'конкатенация [B, 300]', 'dropout, linear → 4 класса'] }
  : { input: 'input [T, d]', maps: 'feature maps', mapsSub: 'one filter of each width shown', pool: 'max over time', concat: 'concatenate', out: 'classes', filters: '×100', linear: 'linear + softmax', narrow: ['embeddings [B, T, 100]', 'convolutions k = 3, 4, 5', '100 filters each', 'max over time: 3 × [B, 100]', 'concatenate [B, 300]', 'dropout, linear → 4 classes'] };
const id = 'cnn-textcnn';
// Wide geometry.
const mx = 96, my = 66, cw = 16, rh = 24, stripX = [262, 304, 346], stripW = 24, poolX = 430, catX = 512, outX = 600;
const rowC = (r: number) => my + r * rh + rh / 2;
const cellC = (k: number, i: number) => my + (i + (k - 1) / 2) * rh + rh / 2;
---

<Figure
  id={id}
  title={ru ? 'TextCNN: детекторы фраз и max-pooling' : 'TextCNN: phrase detectors and max-pooling'}
  caption={ru
    ? 'Как TextCNN читает документ. Строки входа — векторы токенов начала заголовка AG News после предобработки (цвета клеток условны). Свёртка шириной k скользит по k соседним строкам сразу и в каждой позиции даёт одно число на фильтр: насколько окно похоже на выученный шаблон. Показано по одному фильтру каждой ширины и одному окну каждого цвета; в модели их по 100 на ширину, и каждый пробегает все T − k + 1 позиций. Max-pooling оставляет от каждой карты признаков её наибольший отклик (обведён), где бы он ни был, поэтому выход имеет фиксированный размер 3 × 100 = 300 при любой длине документа, а положение фразы теряется. Линейный слой с softmax превращает 300 признаков в вероятности четырёх тем; значения вероятностей условны.'
    : 'How TextCNN reads a document. The rows of the input are the vectors of the tokens at the start of a preprocessed AG News headline (cell shades are illustrative). A convolution of width k looks at k neighbouring rows at once and produces, at every position, one number per filter: how much the window looks like a learned pattern. One filter of each width and one window of each colour are shown; the model has 100 filters per width, and each scans all T − k + 1 positions. Max-pooling keeps the largest response of each feature map (outlined), wherever it occurred, so the output has a fixed size of 3 × 100 = 300 whatever the length of the document, and the position of the phrase is lost. A linear layer with a softmax turns the 300 features into probabilities of the four topics; the probabilities are illustrative.'}
>
  <svg class="fig-wide" viewBox="0 0 700 300" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{ru ? 'Архитектура TextCNN' : 'TextCNN architecture'}</title>
    <desc id={`${id}-w-d`}>{ru
      ? `Матрица из ${T} строк (${tokens.join(', ')}) и ${d} столбцов. Окна шириной 3, 4 и 5 строк ведут к трём картам признаков из ${T - 2}, ${T - 3} и ${T - 4} клеток. Наибольшая клетка каждой карты идёт в max-pooling, три результата по 100 чисел конкатенируются в 300 признаков, линейный слой с softmax даёт вероятности World, Sports, Business и Sci/Tech, из которых наибольшая у Business.`
      : `A matrix of ${T} rows (${tokens.join(', ')}) and ${d} columns. Windows of 3, 4 and 5 rows lead to three feature maps of ${T - 2}, ${T - 3} and ${T - 4} cells. The largest cell of each map goes to max-pooling, the three results of 100 numbers are concatenated into 300 features, and a linear layer with a softmax gives probabilities of World, Sports, Business and Sci/Tech, the largest for Business.`}</desc>
    <text class="f-title" x={mx} y={my - 30}>{t.input}</text>
    {tokens.map((tok, r) => (
      <g>
        <text class="f-small" x={mx - 8} y={rowC(r) + 4} text-anchor="end" font-family="var(--mono)">{tok}</text>
        {Array.from({ length: d }, (_, c) => <rect x={mx + c * cw} y={my + r * rh + 2} width={cw} height={rh - 4} class="f-solid-muted" style={`fill-opacity: ${(0.12 + 0.4 * shade(r, c)).toFixed(2)}`} />)}
      </g>
    ))}
    <rect class="f-thin f-muted" x={mx} y={my} width={d * cw} height={T * rh} fill="none" />
    <text class="f-title" x={stripX[0] - 6} y={my - 30}>{t.maps}</text>
    <text class="f-small f-t-muted" x={stripX[0] - 6} y={my - 12}>{t.mapsSub}</text>
    {widths.map((w, wi) => {
      const bx = mx + d * cw + 8 + wi * 9;
      const y0 = my + w.start * rh + 3, y1 = my + (w.start + w.k) * rh - 3;
      const n = T - w.k + 1;
      const target = cellC(w.k, w.start);
      return (
        <g>
          <path class={`f-line f-${w.tone}`} d={`M ${bx - 4} ${y0} H ${bx} V ${y1} H ${bx - 4}`} />
          <path class={`f-thin f-${w.tone}`} d={`M ${bx} ${(y0 + y1) / 2} C ${bx + 40} ${(y0 + y1) / 2}, ${stripX[wi] - 40} ${target}, ${stripX[wi] - 4} ${target}`} marker-end={`url(#f-arrow-${w.tone})`} />
          <text class={`f-small f-t-${w.tone}`} x={stripX[wi] + stripW / 2} y={my + T * rh + 18} text-anchor="middle">k={w.k}</text>
          {Array.from({ length: n }, (_, i) => (
            <rect x={stripX[wi]} y={cellC(w.k, i) - 10} width={stripW} height={20} style={`fill: var(--fig-${w.tone}); fill-opacity: ${i === w.best ? 0.85 : (0.12 + 0.35 * shade(wi + 7, i)).toFixed(2)}`} />
          ))}
          <rect class={`f-line f-${w.tone}`} x={stripX[wi] - 2} y={cellC(w.k, w.best) - 12} width={stripW + 4} height={24} fill="none" />
          <path class={`f-thin f-${w.tone}`} d={`M ${stripX[wi] + stripW + 3} ${cellC(w.k, w.best)} C ${poolX - 30} ${cellC(w.k, w.best)}, ${poolX - 30} ${my + 40 + wi * 52}, ${poolX - 4} ${my + 40 + wi * 52}`} marker-end={`url(#f-arrow-${w.tone})`} />
          <rect class={`f-fill-${w.tone}`} x={poolX} y={my + 26 + wi * 52} width={56} height={28} rx="4" />
          <rect class={`f-thin f-${w.tone}`} x={poolX} y={my + 26 + wi * 52} width={56} height={28} rx="4" fill="none" />
          <text class="f-small" x={poolX + 28} y={my + 45 + wi * 52} text-anchor="middle">{t.filters}</text>
        </g>
      );
    })}
    <text class="f-small f-t-muted" x={poolX + 28} y={my + 8} text-anchor="middle">{t.pool}</text>
    <path class="f-line f-muted" d={`M ${poolX + 62} ${my + 40} H ${poolX + 70} V ${my + 144} H ${poolX + 62} M ${poolX + 70} ${my + 92} H ${catX - 4}`} marker-end="url(#f-arrow-muted)" />
    {widths.map((w, wi) => <rect x={catX} y={my + 52 + wi * 26} width={30} height={26} style={`fill: var(--fig-${w.tone}); fill-opacity: 0.35`} />)}
    <rect class="f-thin f-muted" x={catX} y={my + 52} width={30} height={78} fill="none" />
    <text class="f-small f-t-muted" x={catX + 15} y={my + 40} text-anchor="middle">300</text>
    <text class="f-small f-t-muted" x={catX + 15} y={my + 180} text-anchor="middle">{t.concat}</text>
    <path class="f-line f-muted" d={`M ${catX + 34} ${my + 91} H ${outX - 6}`} marker-end="url(#f-arrow-muted)" />
    <text class="f-small f-t-muted f-halo" x={(catX + 34 + outX) / 2} y={my + 82} text-anchor="middle">linear</text>
    <text class="f-title" x={outX} y={my - 30}>{t.out}</text>
    {classes.map((c, i) => (
      <g>
        <text class="f-small" x={outX} y={my + 22 + i * 40}>{c}</text>
        <rect x={outX} y={my + 28 + i * 40} width={Math.max(3, probs[i] * 90)} height={12} class={i === 2 ? 'f-solid-blue' : 'f-solid-muted'} style={i === 2 ? 'fill-opacity: .7' : 'fill-opacity: .35'} />
      </g>
    ))}
  </svg>
  <svg class="fig-narrow" viewBox="0 0 360 330" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{ru ? 'Архитектура TextCNN' : 'TextCNN architecture'}</title>
    <desc id={`${id}-n-d`}>{t.narrow.join('; ')}</desc>
    {[0, 1, 3, 4, 5].map((li, bi) => {
      const y = 10 + bi * 62 + (bi > 1 ? 0 : 0);
      const lines = li === 1 ? [t.narrow[1], t.narrow[2]] : [t.narrow[li]];
      return (
        <g>
          <rect class={bi === 1 ? 'f-fill-blue' : bi === 2 ? 'f-fill-green' : 'f-fill-paper'} x="40" y={y} width="280" height="44" rx="7" />
          <rect class={`f-thin ${bi === 1 ? 'f-blue' : bi === 2 ? 'f-green' : ''}`} x="40" y={y} width="280" height="44" rx="7" fill="none" />
          {lines.map((line, i) => <text class={i ? 'f-small f-t-muted' : 'f-label'} x="180" y={y + (lines.length > 1 ? 19 + i * 17 : 27)} text-anchor="middle">{line}</text>)}
          {bi < 4 && <path class="f-line f-muted" d={`M 180 ${y + 46} V ${y + 59}`} marker-end="url(#f-arrow-muted)" />}
        </g>
      );
    })}
  </svg>
</Figure>
