---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The deep-research loop: plan what is missing, search, read, keep notes with sources, and repeat until the chain of
// facts is complete; then write claims with citations and check every citation before the answer is returned.
const t = ru
  ? {
      title: 'Цикл исследовательского агента',
      q: 'вопрос', qs: 'в несколько шагов', web: 'веб или корпус', webs: 'страницы, статьи, данные',
      b: [['план', 'чего не хватает?'], ['поиск', 'запрос, выдача'], ['чтение', 'открыть, извлечь'], ['заметки', 'факт + источник'], ['написание', 'со ссылками']],
      check: 'проверка', checks: 'есть ли опора?', ans: 'ответ', anss: 'со ссылками',
      miss: 'не хватает звена: планировать снова', bad: 'утверждение без опоры: искать снова или убрать',
      miss1: 'не хватает:', miss2: 'план снова', bad1: 'нет опоры:', bad2: 'искать снова',
      steps: ['план: какого звена не хватает в цепочке фактов', 'поиск: запрос возвращает список документов', 'чтение: открыть документы и извлечь нужный факт', 'заметки: факт сохраняется вместе с источником; если звена не хватает, снова к плану', 'написание: ответ из утверждений, у каждого свои ссылки', 'проверка: источник существует и подтверждает утверждение; иначе снова искать или убрать утверждение'],
      desc: 'Слева сверху вопрос. В ряд пять шагов: план, поиск, чтение, заметки, написание ответа со ссылками. Поиск и чтение обращаются к вебу или корпусу внизу. Петля над рядом ведёт от заметок обратно к плану, пока не хватает звена. Под последним шагом проверка ссылок: если утверждения подтверждены, выходит ответ со ссылками; если нет, петля снизу ведёт обратно к плану.',
    }
  : {
      title: 'The loop of a research agent',
      q: 'question', qs: 'several hops away', web: 'the web or a corpus', webs: 'pages, papers, data',
      b: [['plan', 'what is missing?'], ['search', 'query → hits'], ['read', 'open, extract'], ['notes', 'fact + source'], ['write', 'claims + citations']],
      check: 'check', checks: 'exists? supports?', ans: 'answer', anss: 'with citations',
      miss: 'a link is missing: plan again', bad: 'unsupported claim: research it again, or drop it',
      miss1: 'missing:', miss2: 'plan again', bad1: 'unsupported:', bad2: 'search again',
      steps: ['plan: which link of the chain of facts is missing', 'search: a query returns a list of documents', 'read: open the documents and extract the fact needed', 'notes: keep the fact with its source; if a link is still missing, back to the plan', 'write: an answer made of claims, each with its citations', 'check: the source exists and supports the claim; otherwise research again or drop the claim'],
      desc: 'At the top left, the question. In a row, five steps: plan, search, read, notes, and a draft with citations. Search and read reach the web or a corpus below them. A loop above the row goes from the notes back to the plan while a link is missing. Below the draft, the citation check: if the claims are supported, the answer with citations goes out; if not, a loop along the bottom goes back to the plan.',
    };
const id = 'research-loop';
const caption = ru
  ? 'Вопрос, ответ на который требует нескольких шагов, нельзя закрыть одним поиском: каждый следующий запрос зависит от того, что нашлось при предыдущем чтении. Агент держит заметки, где каждый факт привязан к источнику, и пишет ответ только из них. Перед выдачей ответа каждую ссылку проверяют: существует ли источник и подтверждает ли он утверждение. Утверждение без опоры отправляет агента искать снова или вычёркивается.'
  : 'A question that takes several hops cannot be closed with one search: each query depends on what the previous reading found. The agent keeps notes in which every fact is tied to its source, and writes the answer from them only. Before the answer goes out, every citation is checked: does the source exist, and does it support the claim? An unsupported claim sends the agent back to research, or is struck out.';
const xs = [16, 166, 316, 466, 616], Y = 120, BW = 130, BH = 50;
const ny = [72, 130, 188, 246, 304], NH = 44;
if (ny[4] + NH + 14 !== 362) throw new Error('ResearchLoop: the narrow column drifted');
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 316" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <Box x={16} y={20} w={150} h={50} label={t.q} sub={t.qs} tone="x" />
    <Arrow pts={[[81, 70], [81, 118]]} tone="green" />
    <Box x={186} y={214} w={250} h={50} label={t.web} sub={t.webs} tone="h" />
    {xs.map((x, i) => (
      <g data-s={String(i + 1)}>
        {i !== 0 && <Arrow pts={[[x - 20, Y + 25], [x - 2, Y + 25]]} />}
        <Box x={x} y={Y} w={BW} h={BH} label={t.b[i][0]} sub={t.b[i][1]} tone={i === 3 ? 'h' : i === 4 ? 'y' : 'g'} />
        {(i === 1 || i === 2) && (
          <g>
            <Arrow pts={[[x + 55, Y + BH], [x + 55, 212]]} tone="red" />
            <Arrow pts={[[x + 75, 214], [x + 75, Y + BH + 2]]} tone="green" />
          </g>
        )}
        {i === 3 && (
          <g>
            <Arrow pts={[[x + 65, Y], [x + 65, 96], [101, 96], [101, Y - 2]]} tone="amber" />
            <text class="f-small f-t-amber f-halo" x="316" y="90" text-anchor="middle">{t.miss}</text>
          </g>
        )}
        <Badge x={x + BW - 12} y={Y} n={i + 1} />
      </g>
    ))}
    <g data-s="6">
      <Arrow pts={[[681, 170], [681, 212]]} />
      <Box x={616} y={214} w={130} h={50} label={t.check} sub={t.checks} tone="g" />
      <Arrow pts={[[616, 239], [598, 239]]} tone="red" />
      <Box x={466} y={214} w={130} h={50} label={t.ans} sub={t.anss} tone="y" />
      <Arrow pts={[[681, 264], [681, 288], [61, 288], [61, Y + BH + 2]]} tone="red" dashed />
      <text class="f-small f-t-red f-halo" x="381" y="306" text-anchor="middle">{t.bad}</text>
      <Badge x={734} y={214} n={6} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 490" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <Box x={56} y={8} w={180} h={44} label={t.q} sub={t.qs} tone="x" />
    <Arrow pts={[[146, 52], [146, 70]]} tone="green" />
    <Box x={252} y={130} w={92} h={102} label={ru ? 'веб' : 'web'} sub={ru ? 'или корпус' : 'or corpus'} tone="h" />
    {ny.map((y, i) => (
      <g data-s={String(i + 1)}>
        {i !== 0 && <Arrow pts={[[146, y - 14], [146, y - 2]]} />}
        <Box x={56} y={y} w={180} h={NH} label={t.b[i][0]} sub={t.b[i][1]} tone={i === 3 ? 'h' : i === 4 ? 'y' : 'g'} />
        {(i === 1 || i === 2) && (
          <g>
            <Arrow pts={[[236, y + 15], [250, y + 15]]} tone="red" />
            <Arrow pts={[[252, y + 30], [238, y + 30]]} tone="green" />
          </g>
        )}
        {i === 3 && (
          <g>
            <Arrow pts={[[56, y + 22], [40, y + 22], [40, 104], [54, 104]]} tone="amber" />
            <text class="f-small f-t-amber" x="244" y={y + 18}>{t.miss1}</text>
            <text class="f-small f-t-amber" x="244" y={y + 36}>{t.miss2}</text>
          </g>
        )}
        <Badge x={224} y={y} n={i + 1} />
      </g>
    ))}
    <g data-s="6">
      <Arrow pts={[[146, 348], [146, 360]]} />
      <Box x={56} y={362} w={180} h={NH} label={t.check} sub={t.checks} tone="g" />
      <Arrow pts={[[146, 406], [146, 428]]} tone="red" />
      <Box x={56} y={430} w={180} h={NH} label={t.ans} sub={t.anss} tone="y" />
      <Arrow pts={[[56, 384], [24, 384], [24, 88], [54, 88]]} tone="red" dashed />
      <text class="f-small f-t-red" x="244" y="380">{t.bad1}</text>
      <text class="f-small f-t-red" x="244" y="398">{t.bad2}</text>
      <Badge x={224} y={362} n={6} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
