---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One step of constrained decoding in the Code section of the note: after the prefix {"item": " the stand-in model
// gives these logits; the other 10 tokens of the 17-token vocabulary get -4. Only tokens that keep the call completable
// (lamp, chair, desk, and de, the start of de + sk) are allowed; the softmax is renormalized over them.
const shown: [string, number, boolean][] = [['lamps', 2.0, false], ['lamp', 1.5, true], ['Sure', 0.5, false], ['chair', 0.2, true], ['de', 0.0, true], ['desk', -0.5, true], ['}', -1.0, false]];
const OTHERS = 10, ZO = -4;
const e = shown.map(([, z]) => Math.exp(z));
const S = e.reduce((a, b) => a + b, 0) + OTHERS * Math.exp(ZO);
const before = [...e.map((v) => v / S), (OTHERS * Math.exp(ZO)) / S];
const allowed = shown.reduce((a, [, , ok], i) => a + (ok ? before[i] : 0), 0);
const after = [...shown.map(([, , ok], i) => (ok ? before[i] / allowed : 0)), 0];
const f3 = (v: number) => v.toFixed(3);
const quoted = [...before, ...after.slice(0, 7), allowed].map(f3).join(' ');
if (quoted !== '0.437 0.265 0.098 0.072 0.059 0.036 0.022 0.011 0.000 0.613 0.000 0.167 0.137 0.083 0.000 0.433')
  throw new Error(`LogitMask: numbers drifted from the note (${quoted})`);

const t = ru
  ? {
      title: 'Маска на логитах после префикса {"item": "',
      token: 'токен', z: 'логит z', zN: 'z', ok: 'можно', okN: 'ok', pb: 'p до маски', pa: 'p после маски', pbN: 'до', paN: 'после',
      others: `ещё ${OTHERS} токенов`, othersN: `ещё ${OTHERS}`, renorm: `÷ ${f3(allowed)}, масса разрешённых токенов`, renormN: `÷ ${f3(allowed)}`,
      steps: ['модель выдаёт логиты; softmax по всему словарю даёт вероятности до маски', 'маска запрещает токены, после которых вызов нельзя закончить: lamps, Sure, }', `оставшиеся вероятности делятся на их сумму ${f3(allowed)}`],
      desc: `Таблица из восьми строк: токен, его логит, разрешён ли он и две полосы вероятности. lamps: логит 2.0, запрещён, ${f3(before[0])} до маски. lamp: 1.5, разрешён, ${f3(before[1])} до и ${f3(after[1])} после. Sure: 0.5, запрещён. chair: 0.2, разрешён, ${f3(after[3])} после. de: 0.0, разрешён, ${f3(after[4])} после. desk: −0.5, разрешён, ${f3(after[5])} после. }: −1.0, запрещён. Ещё ${OTHERS} токенов вместе дают ${f3(before[7])} до маски и запрещены.`,
    }
  : {
      title: 'The mask on the logits after the prefix {"item": "',
      token: 'token', z: 'logit z', zN: 'z', ok: 'allowed', okN: 'ok', pb: 'p before masking', pa: 'p after masking', pbN: 'before', paN: 'after',
      others: `${OTHERS} other tokens`, othersN: `${OTHERS} others`, renorm: `÷ ${f3(allowed)}, the allowed mass`, renormN: `÷ ${f3(allowed)}`,
      steps: ['the model gives logits; the softmax over the whole vocabulary gives the probabilities before masking', 'the mask forbids the tokens after which the call cannot be completed: lamps, Sure, }', `the remaining probabilities are divided by their sum, ${f3(allowed)}`],
      desc: `A table of eight rows: the token, its logit, whether it is allowed, and two probability bars. lamps: logit 2.0, forbidden, ${f3(before[0])} before masking. lamp: 1.5, allowed, ${f3(before[1])} before and ${f3(after[1])} after. Sure: 0.5, forbidden. chair: 0.2, allowed, ${f3(after[3])} after. de: 0.0, allowed, ${f3(after[4])} after. desk: −0.5, allowed, ${f3(after[5])} after. }: −1.0, forbidden. The other ${OTHERS} tokens together have ${f3(before[7])} before masking and are forbidden.`,
    };
const id = 'logit-mask';
const caption = ru
  ? `Самый вероятный токен, lamps, ведёт в тупик: после lamp нужна кавычка, а не s. Маска ставит его логит в −∞, и его вероятность ${f3(before[0])} перераспределяется между разрешёнными токенами пропорционально их исходным вероятностям. Токен de разрешён, потому что desk можно написать как de и sk; товар desk получает ${f3(after[4])} + ${f3(after[5])} = ${f3(after[4] + after[5])}.`
  : `The most probable token, lamps, leads to a dead end: after lamp a quote must follow, not an s. The mask sets its logit to −∞, and its probability ${f3(before[0])} is shared among the allowed tokens in proportion to their original probabilities. The token de is allowed because desk can be written as de followed by sk; the item desk gets ${f3(after[4])} + ${f3(after[5])} = ${f3(after[4] + after[5])}.`;
const tokens = [...shown.map(([w]) => w), t.others];
const tokensN = [...shown.map(([w]) => w), t.othersN];
const zs = [...shown.map(([, z]) => (z < 0 ? `−${Math.abs(z).toFixed(1)}` : z.toFixed(1))), ZO < 0 ? `−${Math.abs(ZO).toFixed(1)}` : String(ZO)];
const oks = [...shown.map(([, , ok]) => ok), false];
const rowsW = tokens.map((_, i) => 70 + 28 * i), rowsN = tokens.map((_, i) => 70 + 30 * i);
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 310" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <text class="f-small f-t-muted" x="40" y="36">{t.token}</text>
    <path class="f-grid" d="M 30 46 H 744" />
    {rowsW.map((y, i) => <text class="f-small" x="40" y={y} style="font-family: var(--mono)">{tokens[i]}</text>)}
    <g data-s="1">
      <text class="f-small f-t-muted" x="190" y="36" text-anchor="end">{t.z}</text>
      <text class="f-small f-t-muted" x="300" y="36">{t.pb}</text>
      {rowsW.map((y, i) => (
        <g>
          <text class="f-small" x="190" y={y} text-anchor="end">{zs[i]}</text>
          <rect x="300" y={y - 11} width={before[i] * 360} height="14" style="fill: var(--muted); fill-opacity: 0.35" />
          <text class="f-small f-t-muted" x={306 + before[i] * 360} y={y}>{f3(before[i])}</text>
        </g>
      ))}
      <Badge x={128} y={31} n={1} />
    </g>
    <g data-s="2">
      <text class="f-small f-t-muted" x="250" y="36" text-anchor="middle">{t.ok}</text>
      {rowsW.map((y, i) => <text class={`f-label ${oks[i] ? 'f-t-green' : 'f-t-red'}`} x="250" y={y + 1} text-anchor="middle">{oks[i] ? '✓' : '✗'}</text>)}
      <Badge x={284} y={31} n={2} />
    </g>
    <g data-s="3">
      <text class="f-small f-t-muted" x="530" y="36">{t.pa}</text>
      {rowsW.map((y, i) => (
        <g>
          <rect x="530" y={y - 11} width={after[i] * 300} height="14" style="fill: var(--fig-blue); fill-opacity: 0.55" />
          <text class={`f-small ${oks[i] ? 'f-t-blue' : 'f-t-muted'}`} x={536 + after[i] * 300} y={y}>{f3(after[i])}</text>
        </g>
      ))}
      <text class="f-small f-t-blue" x="530" y="298">{t.renorm}</text>
      <Badge x={514} y={31} n={3} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 330" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <text class="f-small f-t-muted" x="10" y="44">{t.token}</text>
    <path class="f-grid" d="M 6 52 H 354" />
    {rowsN.map((y, i) => <text class="f-small" x="10" y={y + 6} style="font-family: var(--mono)">{tokensN[i]}</text>)}
    <g data-s="1">
      <text class="f-small f-t-muted" x="120" y="44" text-anchor="end">{t.zN}</text>
      <text class="f-small f-t-muted" x="156" y="44">{t.pbN}</text>
      {rowsN.map((y, i) => (
        <g>
          <text class="f-small" x="120" y={y + 6} text-anchor="end">{zs[i]}</text>
          <rect x="156" y={y - 6} width={before[i] * 90} height="14" style="fill: var(--muted); fill-opacity: 0.35" />
          <text class="f-small f-t-muted" x={160 + before[i] * 90} y={y + 6}>{f3(before[i])}</text>
        </g>
      ))}
      <Badge x={92} y={39} n={1} />
    </g>
    <g data-s="2">
      <text class="f-small f-t-muted" x="138" y="44" text-anchor="middle">{t.okN}</text>
      {rowsN.map((y, i) => <text class={`f-label ${oks[i] ? 'f-t-green' : 'f-t-red'}`} x="138" y={y + 7} text-anchor="middle">{oks[i] ? '✓' : '✗'}</text>)}
      <Badge x={138} y={20} n={2} />
    </g>
    <g data-s="3">
      <text class="f-small f-t-muted" x="248" y="44">{t.paN}</text>
      {rowsN.map((y, i) => (
        <g>
          <rect x="248" y={y - 6} width={after[i] * 90} height="14" style="fill: var(--fig-blue); fill-opacity: 0.55" />
          <text class={`f-small ${oks[i] ? 'f-t-blue' : 'f-t-muted'}`} x={252 + after[i] * 90} y={y + 6}>{f3(after[i])}</text>
        </g>
      ))}
      <text class="f-small f-t-blue" x="248" y="316">{t.renormN}</text>
      <Badge x={318} y={39} n={3} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
