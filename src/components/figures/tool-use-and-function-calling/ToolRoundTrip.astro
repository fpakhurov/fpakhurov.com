---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The round trip of the Code section: three parallel calls, one rejected by the schema, the fix, the calculator,
// the answer. Time runs downwards; the three lanes are the model, the runtime and the tools.
const PRICES = { lamp: 24.5, chair: 41.0, desk: 129.0 };
const total = 3 * PRICES.lamp + 2 * PRICES.chair + PRICES.desk;
const wait = Math.max(0.8, 0.8);                    // c2 and c3 run at the same time, 0.8 s each
if (total !== 284.5 || wait !== 0.8) throw new Error('ToolRoundTrip: numbers drifted from the note');
const f1 = (v: number) => v.toFixed(1);

const t = ru
  ? {
      title: 'Путь вызова инструмента туда и обратно: модель, среда выполнения, инструменты',
      model: 'модель', run: 'среда выполнения', runA: 'среда', runB: 'выполнения', tools: 'инструменты',
      s1: 'определения инструментов + вопрос', s1a: 'определения', s1b: '+ вопрос',
      s2a: 'три вызова get_price', s2b: 'c1 lamps · c2 chair · c3 desk',
      val: 'проверка', valSub: 'c1 ✗ нет в enum', valSubN: 'c1 ✗ enum',
      s4a: 'c2, c3 параллельно', s4aN: 'параллельно', s4b: `${f1(PRICES.chair)} · ${f1(PRICES.desk)} через 0.8 с`, s4bN: `${f1(PRICES.chair)}, ${f1(PRICES.desk)}`,
      s5a: 'c1 ошибка: lamp, chair или desk', s5b: `c2 ${f1(PRICES.chair)} · c3 ${f1(PRICES.desk)}`, s5aN: 'c1: ошибка', s5bN: 'c2, c3: цены',
      s6a: 'c4 lamp, затем c5 calculator', s6aN: 'c4 lamp', s6bN: 'c5 calculator', s6c: 'c4, c5', s6d: `${PRICES.lamp} · ${total}`, s6e: `${PRICES.lamp}, затем ${total}`, s6dN: `${PRICES.lamp}, ${total}`,
      ans: `${total} евро`, ansN: `ответ: ${total} евро`,
      steps: ['среда выполнения отправляет определения инструментов и вопрос', 'модель отвечает тремя вызовами с идентификаторами c1, c2, c3', 'проверка по схеме: c1 не проходит, lamps нет в enum', 'c2 и c3 выполняются одновременно; ход ждёт 0.8 с', 'три сообщения инструментов, по одному на вызов: ошибка для c1 и две цены', `модель исправляет вызов (c4), вызывает калькулятор (c5) и отвечает: ${total} евро`],
      desc: `Диаграмма последовательности с тремя дорожками: модель, среда выполнения, инструменты; время идёт сверху вниз. Среда выполнения передаёт модели определения и вопрос. Модель отвечает тремя вызовами get_price: c1 lamps, c2 chair, c3 desk. Проверка отклоняет c1. c2 и c3 выполняются параллельно и возвращают ${f1(PRICES.chair)} и ${f1(PRICES.desk)}. Модель получает ошибку для c1 и две цены, вызывает c4 get_price(lamp) и c5 calculator, получает ${PRICES.lamp} и ${total} и отвечает ${total} евро.`,
    }
  : {
      title: 'The round trip of a tool call: model, runtime, tools',
      model: 'model', run: 'runtime', runA: 'runtime', runB: undefined, tools: 'tools',
      s1: 'tool definitions + question', s1a: 'definitions', s1b: '+ question',
      s2a: 'three get_price calls', s2b: 'c1 lamps · c2 chair · c3 desk',
      val: 'validate', valSub: 'c1 ✗ not in enum', valSubN: 'c1 ✗ enum',
      s4a: 'c2, c3 in parallel', s4aN: 'in parallel', s4b: `${f1(PRICES.chair)} · ${f1(PRICES.desk)} after 0.8 s`, s4bN: `${f1(PRICES.chair)}, ${f1(PRICES.desk)}`,
      s5a: 'c1 error: use lamp, chair or desk', s5b: `c2 ${f1(PRICES.chair)} · c3 ${f1(PRICES.desk)}`, s5aN: 'c1: error', s5bN: 'c2, c3: prices',
      s6a: 'c4 lamp, then c5 calculator', s6aN: 'c4 lamp', s6bN: 'c5 calculator', s6c: 'c4, c5', s6d: `${PRICES.lamp} · ${total}`, s6e: `${PRICES.lamp}, then ${total}`, s6dN: `${PRICES.lamp}, ${total}`,
      ans: `${total} euros`, ansN: `answer: ${total} euros`,
      steps: ['the runtime sends the tool definitions and the question', 'the model replies with three calls, with identifiers c1, c2, c3', 'validation against the schema: c1 fails, lamps is not in the enum', 'c2 and c3 run at the same time; the turn waits 0.8 s', 'three tool messages, one per call: an error for c1 and two prices', `the model fixes the call (c4), calls the calculator (c5) and answers: ${total} euros`],
      desc: `A sequence diagram with three lanes: the model, the runtime and the tools; time runs downwards. The runtime passes the definitions and the question to the model. The model replies with three get_price calls: c1 lamps, c2 chair, c3 desk. Validation rejects c1. c2 and c3 run in parallel and return ${f1(PRICES.chair)} and ${f1(PRICES.desk)}. The model receives an error for c1 and the two prices, calls c4 get_price(lamp) and c5 calculator, receives ${PRICES.lamp} and ${total}, and answers ${total} euros.`,
    };
if (t.steps.length !== 6) throw new Error('ToolRoundTrip: the note lists six steps');
const id = 'tool-round-trip';
const caption = ru
  ? 'Модель только предлагает вызовы; проверяет и выполняет их среда выполнения. Идентификатор связывает каждый результат с его вызовом, поэтому порядок ответов не важен. Ошибка проверки возвращается как обычный результат: модель видит, какие значения допустимы, и исправляет вызов на следующем ходу. Калькулятору нужны цены, поэтому он вызывается позже, а не параллельно с ними.'
  : 'The model only proposes calls; the runtime checks and executes them. The identifier ties each result to its call, so the order of the results does not matter. The validation error goes back like any other result: the model sees which values are allowed and fixes the call on its next turn. The calculator needs the prices, so it is called later rather than in parallel with them.';
const W = { M: 110, R: 380, T: 650 }, N = { M: 60, R: 180, T: 300 };
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 432" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <Box x={50} y={14} w={120} h={34} label={t.model} tone="g" />
    <Box x={300} y={14} w={160} h={34} label={t.run} />
    <Box x={580} y={14} w={140} h={34} label={t.tools} tone="h" />
    {[W.M, W.R, W.T].map((x) => <path class="f-line f-muted f-dash" d={`M ${x} 48 V 424`} style="stroke-width: 1" />)}
    <g data-s="1">
      <Arrow pts={[[W.R - 2, 80], [W.M + 2, 80]]} tone="green" />
      <text class="f-small f-t-green" x="245" y="72" text-anchor="middle">{t.s1}</text>
      <Badge x={22} y={80} n={1} />
    </g>
    <g data-s="2">
      <text class="f-small f-t-red" x="245" y="108" text-anchor="middle">{t.s2a}</text>
      <text class="f-small f-t-red" x="245" y="122" text-anchor="middle">{t.s2b}</text>
      <Arrow pts={[[W.M + 2, 130], [W.R - 2, 130]]} tone="red" />
      <Badge x={22} y={130} n={2} />
    </g>
    <g data-s="3">
      <Box x={318} y={146} w={124} h={42} label={t.val} sub={t.valSub} />
      <Badge x={300} y={167} n={3} />
    </g>
    <g data-s="4">
      <text class="f-small" x="515" y="204" text-anchor="middle">{t.s4a}</text>
      <Arrow pts={[[W.R + 2, 212], [W.T - 2, 212]]} />
      <text class="f-small f-t-blue" x="515" y="236" text-anchor="middle">{t.s4b}</text>
      <Arrow pts={[[W.T - 2, 244], [W.R + 2, 244]]} tone="blue" />
      <Badge x={740} y={228} n={4} />
    </g>
    <g data-s="5">
      <text class="f-small f-t-green" x="245" y="276" text-anchor="middle">{t.s5a}</text>
      <text class="f-small f-t-green" x="245" y="290" text-anchor="middle">{t.s5b}</text>
      <Arrow pts={[[W.R - 2, 298], [W.M + 2, 298]]} tone="green" />
      <Badge x={22} y={298} n={5} />
    </g>
    <g data-s="6">
      <text class="f-small f-t-red" x="245" y="328" text-anchor="middle">{t.s6a}</text>
      <Arrow pts={[[W.M + 2, 336], [W.R - 2, 336]]} tone="red" />
      <text class="f-small" x="515" y="328" text-anchor="middle">{t.s6c}</text>
      <Arrow pts={[[W.R + 2, 336], [W.T - 2, 336]]} />
      <text class="f-small f-t-blue" x="515" y="352" text-anchor="middle">{t.s6d}</text>
      <Arrow pts={[[W.T - 2, 360], [W.R + 2, 360]]} tone="blue" />
      <text class="f-small f-t-green" x="245" y="368" text-anchor="middle">{t.s6e}</text>
      <Arrow pts={[[W.R - 2, 376], [W.M + 2, 376]]} tone="green" />
      <Box x={40} y={390} w={140} h={32} label={t.ans} tone="y" />
      <Badge x={22} y={356} n={6} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 512" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <Box x={8} y={8} w={104} h={40} label={t.model} tone="g" />
    <Box x={128} y={8} w={104} h={40} label={t.runA} sub={t.runB} subGap={15} />
    <Box x={248} y={8} w={104} h={40} label={t.tools} tone="h" />
    {[N.M, N.R, N.T].map((x) => <path class="f-line f-muted f-dash" d={`M ${x} 48 V 462`} style="stroke-width: 1" />)}
    <g data-s="1">
      <text class="f-small f-t-green" x="120" y="66" text-anchor="middle">{t.s1a}</text>
      <text class="f-small f-t-green" x="120" y="82" text-anchor="middle">{t.s1b}</text>
      <Arrow pts={[[N.R - 2, 90], [N.M + 2, 90]]} tone="green" />
      <Badge x={344} y={90} n={1} />
    </g>
    <g data-s="2">
      <text class="f-small f-t-red" x="120" y="112" text-anchor="middle">c1 lamps</text>
      <text class="f-small f-t-red" x="120" y="128" text-anchor="middle">c2 chair</text>
      <text class="f-small f-t-red" x="120" y="144" text-anchor="middle">c3 desk</text>
      <Arrow pts={[[N.M + 2, 152], [N.R - 2, 152]]} tone="red" />
      <Badge x={344} y={152} n={2} />
    </g>
    <g data-s="3">
      <Box x={126} y={164} w={108} h={44} label={t.val} sub={t.valSubN} />
      <Badge x={344} y={186} n={3} />
    </g>
    <g data-s="4">
      <text class="f-small" x="240" y="230" text-anchor="middle">c2, c3</text>
      <text class="f-small" x="240" y="246" text-anchor="middle">{t.s4aN}</text>
      <Arrow pts={[[N.R + 2, 254], [N.T - 2, 254]]} />
      <text class="f-small f-t-blue" x="240" y="276" text-anchor="middle">{t.s4bN}</text>
      <Arrow pts={[[N.T - 2, 284], [N.R + 2, 284]]} tone="blue" />
      <Badge x={344} y={269} n={4} />
    </g>
    <g data-s="5">
      <text class="f-small f-t-green" x="120" y="308" text-anchor="middle">{t.s5aN}</text>
      <text class="f-small f-t-green" x="120" y="324" text-anchor="middle">{t.s5bN}</text>
      <Arrow pts={[[N.R - 2, 332], [N.M + 2, 332]]} tone="green" />
      <Badge x={344} y={332} n={5} />
    </g>
    <g data-s="6">
      <text class="f-small f-t-red" x="120" y="356" text-anchor="middle">{t.s6aN}</text>
      <text class="f-small f-t-red" x="120" y="372" text-anchor="middle">{t.s6bN}</text>
      <Arrow pts={[[N.M + 2, 380], [N.R - 2, 380]]} tone="red" />
      <text class="f-small" x="240" y="392" text-anchor="middle">{t.s6c}</text>
      <Arrow pts={[[N.R + 2, 400], [N.T - 2, 400]]} />
      <text class="f-small f-t-blue" x="240" y="418" text-anchor="middle">{t.s6dN}</text>
      <Arrow pts={[[N.T - 2, 426], [N.R + 2, 426]]} tone="blue" />
      <text class="f-small f-t-green" x="120" y="442" text-anchor="middle">{t.s6dN}</text>
      <Arrow pts={[[N.R - 2, 450], [N.M + 2, 450]]} tone="green" />
      <Box x={20} y={464} w={320} h={36} label={t.ansN} tone="y" />
      <Badge x={344} y={413} n={6} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
