---
import Figure from '../Figure.astro';
import { normals } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A toy "7" on a 16 x 16 pixel grid, intensities in [0, 1] like ToTensor() output.
const G = 16;
const stroke: [number, number][] = [[0.24, 0.26], [0.76, 0.26], [0.44, 0.84]];
function distToStroke(px: number, py: number) {
  let best = Infinity;
  for (let i = 0; i < stroke.length - 1; i += 1) {
    const [ax, ay] = stroke[i];
    const [bx, by] = stroke[i + 1];
    const dx = bx - ax;
    const dy = by - ay;
    const t = Math.max(0, Math.min(1, ((px - ax) * dx + (py - ay) * dy) / (dx * dx + dy * dy)));
    best = Math.min(best, Math.hypot(px - (ax + t * dx), py - (ay + t * dy)));
  }
  return best;
}
const radius = 0.06;
const cells: { i: number; j: number; d: number }[] = [];
for (let j = 0; j < G; j += 1) {
  for (let i = 0; i < G; i += 1) {
    cells.push({ i, j, d: distToStroke((i + 0.5) / G, (j + 0.5) / G) });
  }
}
const clean = cells.map(({ d }) => (d < radius ? 1 : Math.exp(-(((d - radius) / 0.035) ** 2))));
// Notebook: add_noise(x, noise_factor=0.2) = x + 0.2 * randn_like(x); no clipping.
const eps = normals(G * G, 7);
const noisy = clean.map((v, k) => v + 0.2 * eps[k]);
// Reconstruction: the clean digit, slightly blurred (MSE-trained AEs give soft edges).
const recon = cells.map(({ d }) => 0.92 * Math.exp(-((Math.max(0, d - 0.03) / 0.06) ** 2)));

const clamp01 = (v: number) => Math.max(0, Math.min(1, v));
type Pixel = { x: number; y: number; s: number; o: number };
// Display like a grey-scale image: values are clipped to [0, 1] for drawing only.
function pixels(values: number[], x0: number, y0: number, size: number): Pixel[] {
  const s = size / G;
  return cells
    .map(({ i, j }, k) => ({
      x: x0 + i * s,
      y: y0 + j * s,
      s: s + 0.15,
      o: clamp01(values[k]),
    }))
    .filter((p) => p.o > 0.03);
}

// ---------- wide layout ----------
const T = 78; // thumbnail size
const ty = 62;
const xs = { clean: 24, noisy: 214, recon: 578 };
const ae = { x: 330, y: ty - 6, w: 190, h: T + 12 };
const wideImgs = [
  { key: 'clean', x: xs.clean, px: pixels(clean, xs.clean, ty, T) },
  { key: 'noisy', x: xs.noisy, px: pixels(noisy, xs.noisy, ty, T) },
  { key: 'recon', x: xs.recon, px: pixels(recon, xs.recon, ty, T) },
];
const midY = ty + T / 2;
const hour = (x: number, y: number, w: number, h: number) => {
  const encW = w * 0.4;
  const zW = w * 0.2;
  const inset = h * 0.32;
  const enc = `M ${x} ${y} L ${x + encW} ${y + inset} L ${x + encW} ${y + h - inset} L ${x} ${y + h} Z`;
  const dx = x + encW + zW;
  const dec = `M ${dx} ${y + inset} L ${dx + encW} ${y} L ${dx + encW} ${y + h} L ${dx} ${y + h - inset} Z`;
  return { enc, dec, zx: x + encW + 4, zw: zW - 8, zy: y + inset, zh: h - 2 * inset, encC: x + encW / 2, decC: dx + encW / 2 };
};
const hw = hour(ae.x, ae.y, ae.w, ae.h);

// ---------- narrow layout ----------
const nT = 84;
const ncx = 196;
const nY = { clean: 14, noisy: 176, ae: 318, recon: 456 };
const nAe = { x: ncx - 95, y: nY.ae, w: 190, h: 86 };
const nh = hour(nAe.x, nAe.y, nAe.w, nAe.h);
const narrowImgs = [
  { key: 'clean', y: nY.clean, px: pixels(clean, ncx - nT / 2, nY.clean, nT) },
  { key: 'noisy', y: nY.noisy, px: pixels(noisy, ncx - nT / 2, nY.noisy, nT) },
  { key: 'recon', y: nY.recon, px: pixels(recon, ncx - nT / 2, nY.recon, nT) },
];
---

<Figure
  id="autoencoders-denoising"
  title={ru ? "Шумоподавляющий автоэнкодер: искажаем вход, сравниваем с чистым изображением" : "Denoising autoencoder: corrupt the input, score against the clean image"}
  caption={ru ? "При обучении сеть видит только искажённый вход, а функция потерь сравнивает её выход с чистым изображением, поэтому копирование входа штрафуется. Пиксельные изображения — программно построенная игрушечная цифра с уровнем шума из ноутбука (σ = 0.2, без обрезки значений); кроме того, в шумоподавляющей модели ноутбука во время обучения после каждого блока применяется Dropout2d(0.3)." : "During training the network sees only the corrupted input, but the loss compares its output with the clean image, so copying the input is penalised. The pixel images are a computed toy digit with the notebook's noise level (σ = 0.2, no clipping); the notebook's denoising blocks also apply Dropout2d(0.3) after every block during training."}
>
  <svg class="fig-wide fig-bp-640" viewBox="0 0 680 252" role="img" aria-labelledby="autoencoders-denoising-t autoencoders-denoising-d">
    <title id="autoencoders-denoising-t">{ru ? "Шаг обучения шумоподавляющего автоэнкодера" : "Denoising autoencoder training step"}</title>
    <desc id="autoencoders-denoising-d">{ru ? "Слева направо: чистое изображение цифры x; стрелка с подписью «добавить шум», x с тильдой равно x плюс 0.2 эпсилон, где эпсилон — стандартный нормальный шум, ведёт к зашумлённому изображению x с тильдой в крапинку; стрелка входит в автоэнкодер в форме песочных часов — энкодер f фи, код z, декодер g тета — с дропаутом в каждом блоке; стрелка выходит к гладкой реконструкции x с крышкой. Красная стрелка внизу идёт от x с крышкой обратно к чистому x и подписана: MSE от x с крышкой и x, цель — чистое изображение, а не x с тильдой." : "Left to right: a clean digit image x; an arrow labelled add noise, x tilde equals x plus 0.2 epsilon with epsilon standard normal, leading to the speckled noisy image x tilde; an arrow into an hourglass-shaped autoencoder, encoder f phi, code z, decoder g theta, with dropout in every block; an arrow out to the smooth reconstruction x hat. A red arrow below runs from x hat back to the clean x, labelled MSE of x hat and x, the target is the clean image, not x tilde."}</desc>

    {wideImgs.map((img) => (
      <g>
        <rect class="f-box-soft" x={img.x} y={ty} width={T} height={T} />
        {img.px.map((p) => (
          <rect x={p.x} y={p.y} width={p.s} height={p.s} fill="var(--ink)" fill-opacity={p.o} />
        ))}
        <rect x={img.x} y={ty} width={T} height={T} fill="none" stroke="var(--line)" stroke-width="1.2" />
      </g>
    ))}
    <text class="f-math f-t-red" x={xs.clean + T / 2} y={ty - 30} text-anchor="middle">x</text>
    <text class="f-note" x={xs.clean + T / 2} y={ty - 12} text-anchor="middle">{ru ? "чистая цифра" : "clean image"}</text>
    <text class="f-math" x={xs.noisy + T / 2} y={ty - 30} text-anchor="middle">x̃</text>
    <text class="f-note" x={xs.noisy + T / 2} y={ty - 12} text-anchor="middle">{ru ? "искажённый вход" : "corrupted input"}</text>
    <text class="f-math f-t-blue" x={xs.recon + T / 2} y={ty - 30} text-anchor="middle">x̂</text>
    <text class="f-note" x={xs.recon + T / 2} y={ty - 12} text-anchor="middle">{ru ? "реконструкция" : "reconstruction"}</text>

    <!-- corrupt -->
    <path class="f-line" d={`M ${xs.clean + T + 8} ${midY} H ${xs.noisy - 8}`} marker-end="url(#f-arrow)" />
    <text class="f-label" x={(xs.clean + T + xs.noisy) / 2} y={midY - 10} text-anchor="middle">{ru ? "добавить шум" : "add noise"}</text>
    <text class="f-small" x={(xs.clean + T + xs.noisy) / 2} y={midY + 24} text-anchor="middle"><tspan font-family="var(--serif)" font-style="italic" font-size="17">x̃</tspan> = <tspan font-family="var(--serif)" font-style="italic" font-size="17">x</tspan> + 0.2·ε</text>
    <text class="f-small f-t-muted" x={(xs.clean + T + xs.noisy) / 2} y={midY + 43} text-anchor="middle">ε ~ N(0, I)</text>

    <!-- autoencoder -->
    <path class="f-line" d={`M ${xs.noisy + T + 8} ${midY} H ${ae.x - 8}`} marker-end="url(#f-arrow)" />
    <path class="f-fill-blue" d={hw.enc} stroke="var(--fig-blue)" stroke-width="1.4" />
    <path class="f-fill-blue" d={hw.dec} stroke="var(--fig-blue)" stroke-width="1.4" />
    <rect class="f-fill-amber" x={hw.zx} y={hw.zy} width={hw.zw} height={hw.zh} stroke="var(--fig-amber)" stroke-width="1.4" />
    <path class="f-thin f-muted" d={`M ${hw.zx - 4} ${midY} H ${hw.zx}`} />
    <path class="f-thin f-muted" d={`M ${hw.zx + hw.zw} ${midY} H ${hw.zx + hw.zw + 4}`} />
    <text class="f-math f-t-blue" x={hw.encC - 4} y={midY + 6} text-anchor="middle">f<tspan dy="4" font-size="13">φ</tspan></text>
    <text class="f-math f-t-amber" x={hw.zx + hw.zw / 2} y={midY + 6} text-anchor="middle">z</text>
    <text class="f-math f-t-blue" x={hw.decC + 4} y={midY + 6} text-anchor="middle">g<tspan dy="4" font-size="13">θ</tspan></text>
    <text class="f-note" x={ae.x + ae.w / 2} y={ae.y + ae.h + 20} text-anchor="middle">{ru ? "Dropout2d(0.3) после каждого блока" : "Dropout2d(0.3) after every block"}</text>
    <path class="f-line" d={`M ${ae.x + ae.w + 8} ${midY} H ${xs.recon - 8}`} marker-end="url(#f-arrow)" />

    <!-- loss -->
    <path class="f-line f-red" d={`M ${xs.recon + T / 2} ${ty + T + 8} C ${xs.recon + T / 2} ${ty + T + 92}, ${xs.clean + T / 2} ${ty + T + 92}, ${xs.clean + T / 2} ${ty + T + 10}`} marker-end="url(#f-arrow-red)" />
    <text class="f-label f-t-red" x={340} y={ty + T + 98} text-anchor="middle">{ru ? 'потери = ' : 'loss = '}MSE(<tspan font-family="var(--serif)" font-style="italic" font-size="17">x̂</tspan>, <tspan font-family="var(--serif)" font-style="italic" font-size="17">x</tspan>){ru ? ': цель — чистый ' : ': target is the clean '}<tspan font-family="var(--serif)" font-style="italic" font-size="17">x</tspan>{ru ? ', а не ' : ', not '}<tspan font-family="var(--serif)" font-style="italic" font-size="17">x̃</tspan></text>
  </svg>

  <svg class="fig-narrow fig-bp-640" viewBox="0 0 360 594" role="img" aria-labelledby="autoencoders-denoising-nt autoencoders-denoising-nd">
    <title id="autoencoders-denoising-nt">{ru ? "Шаг обучения шумоподавляющего автоэнкодера" : "Denoising autoencoder training step"}</title>
    <desc id="autoencoders-denoising-nd">{ru ? "Сверху вниз: чистая цифра x; стрелка с подписью «добавить шум», x с тильдой равно x плюс 0.2 эпсилон; зашумлённое изображение x с тильдой; автоэнкодер в форме песочных часов f фи, z, g тета с дропаутом в каждом блоке; реконструкция x с крышкой. Красная стрелка слева идёт от x с крышкой обратно вверх к чистому x и подписана: MSE от x с крышкой и x." : "Top to bottom: the clean digit x; an arrow labelled add noise, x tilde equals x plus 0.2 epsilon; the noisy image x tilde; an hourglass autoencoder f phi, z, g theta with dropout in every block; the reconstruction x hat. A red arrow on the left runs from x hat back up to the clean x, labelled MSE of x hat and x."}</desc>

    {narrowImgs.map((img) => (
      <g>
        <rect class="f-box-soft" x={ncx - nT / 2} y={img.y} width={nT} height={nT} />
        {img.px.map((p) => (
          <rect x={p.x} y={p.y} width={p.s} height={p.s} fill="var(--ink)" fill-opacity={p.o} />
        ))}
        <rect x={ncx - nT / 2} y={img.y} width={nT} height={nT} fill="none" stroke="var(--line)" stroke-width="1.2" />
      </g>
    ))}
    <text class="f-math f-t-red" x={ncx + nT / 2 + 12} y={nY.clean + 30}>x</text>
    <text class="f-note" x={ncx + nT / 2 + 12} y={nY.clean + 50}>{ru ? "чистое" : "clean"}</text>
    <text class="f-math" x={ncx + nT / 2 + 12} y={nY.noisy + 30}>x̃</text>
    <text class="f-note" x={ncx + nT / 2 + 12} y={nY.noisy + 50}>{ru ? "искажённое" : "corrupted"}</text>
    <text class="f-math f-t-blue" x={ncx + nT / 2 + 12} y={nY.recon + 30}>x̂</text>
    <text class="f-note" x={ncx + nT / 2 + 12} y={nY.recon + 50}>{ru ? "реконструкция" : "reconstruction"}</text>

    <path class="f-line" d={`M ${ncx} ${nY.clean + nT + 8} V ${nY.noisy - 8}`} marker-end="url(#f-arrow)" />
    <text class="f-label" x={ncx + 12} y={nY.clean + nT + 30}>{ru ? "добавить шум" : "add noise"}</text>
    <text class="f-small" x={ncx + 12} y={nY.clean + nT + 52}><tspan font-family="var(--serif)" font-style="italic" font-size="17">x̃</tspan> = <tspan font-family="var(--serif)" font-style="italic" font-size="17">x</tspan> + 0.2·ε, ε ~ N(0, I)</text>

    <path class="f-line" d={`M ${ncx} ${nY.noisy + nT + 8} V ${nAe.y - 8}`} marker-end="url(#f-arrow)" />
    <path class="f-fill-blue" d={nh.enc} stroke="var(--fig-blue)" stroke-width="1.4" />
    <path class="f-fill-blue" d={nh.dec} stroke="var(--fig-blue)" stroke-width="1.4" />
    <rect class="f-fill-amber" x={nh.zx} y={nh.zy} width={nh.zw} height={nh.zh} stroke="var(--fig-amber)" stroke-width="1.4" />
    <text class="f-math f-t-blue" x={nh.encC - 4} y={nAe.y + nAe.h / 2 + 6} text-anchor="middle">f<tspan dy="4" font-size="13">φ</tspan></text>
    <text class="f-math f-t-amber" x={nh.zx + nh.zw / 2} y={nAe.y + nAe.h / 2 + 6} text-anchor="middle">z</text>
    <text class="f-math f-t-blue" x={nh.decC + 4} y={nAe.y + nAe.h / 2 + 6} text-anchor="middle">g<tspan dy="4" font-size="13">θ</tspan></text>
    <text class="f-note" x={ncx - 10} y={nAe.y + nAe.h + 30} text-anchor="end">Dropout2d(0.3)</text>
    <path class="f-line" d={`M ${ncx} ${nAe.y + nAe.h + 8} V ${nY.recon - 8}`} marker-end="url(#f-arrow)" />

    <path class="f-line f-red" d={`M ${ncx - nT / 2 - 8} ${nY.recon + nT / 2} C 40 ${nY.recon + nT / 2}, 24 ${nY.recon}, 24 ${nY.recon - 30} V ${nY.clean + 80} C 24 ${nY.clean + 60}, 40 ${nY.clean + nT / 2}, ${ncx - nT / 2 - 8} ${nY.clean + nT / 2}`} marker-end="url(#f-arrow-red)" />
    <text class="f-label f-t-red" x="34" y={nY.recon + nT + 34}>{ru ? 'потери = ' : 'loss = '}MSE(<tspan font-family="var(--serif)" font-style="italic" font-size="17">x̂</tspan>, <tspan font-family="var(--serif)" font-style="italic" font-size="17">x</tspan>){ru ? ' относительно чистого ' : ' against the clean '}<tspan font-family="var(--serif)" font-style="italic" font-size="17">x</tspan></text>
  </svg>
</Figure>
