---
import Figure from '../Figure.astro';
import { normals, seeded, scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Illustrative activations of 16 sigmoid units for one input.
const n = 16;
const g = normals(n, 11);
// Centred so the bars average 0.5, like sigmoids of BatchNorm outputs.
const gMean = g.reduce((a, b) => a + b, 0) / n;
const dense = g.map((v) => Math.min(0.95, Math.max(0.08, 0.5 + 0.17 * (v - gMean))));
const r = seeded(5);
// One strongly active unit and the rest near zero. rho is a target for each unit's batch mean, not for the mean over units of one input.
const active: Record<number, number> = { 9: 0.7 };
const sparse = Array.from({ length: n }, (_, i) => active[i] ?? 0.005 + 0.02 * r());

const PW = 290;
const PH = 210;
const pad = { l: 34, r: 8, t: 44, b: 34 };
const bx = (i: number) => pad.l + 6 + i * ((PW - pad.l - pad.r - 12) / n);
const bw = (PW - pad.l - pad.r - 12) / n - 4;
const by = scale([0, 1], [PH - pad.b, pad.t]);

const panels = [
  { key: 'dense', title: (ru ? "плотный код" : "dense code"), values: dense, cls: 'f-fill-blue', note: (ru ? "каждый нейрон частично активен, около 0.5" : "every unit partly active, around 0.5") },
  { key: 'sparse', title: (ru ? "разреженный код" : "sparse code"), values: sparse, cls: 'f-fill-blue', note: (ru ? "на этом входе активен 1 нейрон из 16" : "1 of 16 units active for this input") },
];
const layouts = [
  { cls: 'fig-wide fig-bp-640', vb: `0 0 620 ${PH + 64}`, pos: [{ dx: 8, dy: 0 }, { dx: 322, dy: 0 }], sfx: '', footY: PH + 46, footX: 310 },
  { cls: 'fig-narrow fig-bp-640', vb: `0 0 360 ${2 * PH + 90}`, pos: [{ dx: 30, dy: 0 }, { dx: 30, dy: PH + 14 }], sfx: '-n', footY: 2 * PH + 46, footX: 180 },
];
---

<Figure
  id="autoencoders-sparse"
  title={ru ? "Плотный и разреженный коды: к чему стремится штраф за разреженность" : "Dense and sparse codes: what the sparsity penalty aims for"}
  caption={ru ? "Иллюстративные активации 16 сигмоидных нейронов для одного входа. При инициализации сигмоиды от выходов BatchNorm в среднем близки к 0.5, как в плотном коде. KL-штраф подталкивает среднюю по батчу частоту срабатывания каждого нейрона к малой целевой частоте ρ (0.05 в ноутбуке); ρ — цель не для отдельного столбца. Вместе с функцией потерь реконструкции это должно приводить к тому, что каждый вход задействует лишь несколько сильно активных нейронов, как в разреженном коде. Одному штрафу удовлетворило бы и слабое срабатывание каждого нейрона на уровне около 0.05 на каждом входе." : "Illustrative activations of 16 sigmoid units for a single input. At initialization, sigmoids of BatchNorm outputs average roughly 0.5, as in the dense code. The KL penalty pushes each unit's average firing rate over a batch toward a small target ρ (0.05 in the notebook); ρ is not a target for any single bar. Combined with the reconstruction loss, this is meant to make each input use only a few strongly active units, as in the sparse code. The penalty alone would also be satisfied by every unit firing weakly at about 0.05 for every input."}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={L.vb} role="img" aria-labelledby={`autoencoders-sparse-t${L.sfx} autoencoders-sparse-d${L.sfx}`}>
      <title id={`autoencoders-sparse-t${L.sfx}`}>{ru ? "Плотные и разреженные активации" : "Dense versus sparse activations"}</title>
      <desc id={`autoencoders-sparse-d${L.sfx}`}>{ru ? "Две столбчатые диаграммы активаций 16 нейронов от 0 до 1. В плотном коде почти каждый столбец около 0.5. В разреженном коде один столбец высокий, около 0.7, а все остальные близки к нулю. Подпись внизу: KL-штраф равен бета, умноженному на сумму по нейронам KL между ро и средней активацией ро с крышкой j." : "Two bar charts of 16 unit activations between 0 and 1. In the dense code almost every bar is around 0.5. In the sparse code one bar is high, about 0.7, and all other bars are close to zero. A note below says the KL penalty is beta times the sum over units of KL between rho and the average activation rho hat j."}</desc>
      {panels.map((P, k) => (
        <g transform={`translate(${L.pos[k].dx} ${L.pos[k].dy})`}>
          <text class="f-title" x={pad.l} y="18">{P.title}</text>
          <text class="f-note" x={pad.l} y="36">{P.note}</text>
          {[0.5, 1].map((v) => <line class="f-grid" x1={pad.l} x2={PW - pad.r} y1={by(v)} y2={by(v)} />)}
          {[0, 0.5, 1].map((v) => <text class="f-note" x={pad.l - 6} y={by(v) + 5} text-anchor="end">{v}</text>)}
          {P.values.map((v, i) => (
            <rect class={P.cls} x={bx(i)} y={by(v)} width={bw} height={by(0) - by(v)} stroke="var(--fig-blue)" stroke-width="1.1" />
          ))}
          <path class="f-axis" d={`M ${pad.l} ${by(0)} H ${PW - pad.r}`} />
          <text class="f-small" x={(pad.l + PW - pad.r) / 2} y={by(0) + 20} text-anchor="middle">{ru ? 'скрытые нейроны j = 1 … 16' : 'hidden units j = 1 … 16'}</text>
        </g>
      ))}
      {L.sfx === '' ? (
        <text class="f-label" x={L.footX} y={L.footY} text-anchor="middle">{ru ? 'штраф: β · Σ' : 'penalty: β · Σ'}<tspan dy="4" font-size="12">j</tspan><tspan dy="-4"> KL(ρ ‖ </tspan><tspan font-family="var(--serif)" font-style="italic" font-size="17">ρ̂</tspan><tspan dy="4" font-size="12">j</tspan><tspan dy="-4">),  </tspan><tspan font-family="var(--serif)" font-style="italic" font-size="17">ρ̂</tspan><tspan dy="4" font-size="12">j</tspan><tspan dy="-4">{ru ? ' = среднее нейрона j по батчу;  ρ = цель' : ' = batch mean of unit j;  ρ = target'}</tspan></text>
      ) : (
        <g>
          <text class="f-label" x={L.footX} y={L.footY} text-anchor="middle">{ru ? 'штраф: β · Σ' : 'penalty: β · Σ'}<tspan dy="4" font-size="12">j</tspan><tspan dy="-4"> KL(ρ ‖ </tspan><tspan font-family="var(--serif)" font-style="italic" font-size="17">ρ̂</tspan><tspan dy="4" font-size="12">j</tspan><tspan dy="-4">)</tspan></text>
          <text class="f-note" x={L.footX} y={L.footY + 26} text-anchor="middle"><tspan font-family="var(--serif)" font-style="italic" font-size="17">ρ̂</tspan><tspan dy="4" font-size="11">j</tspan><tspan dy="-4">{ru ? ' = среднее нейрона j по батчу,  ρ = цель' : ' = batch mean of unit j,  ρ = target'}</tspan></text>
        </g>
      )}
    </svg>
  ))}
</Figure>
