---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Tensor shapes of the course notebook's convolutional AutoEncoder (channels, spatial size).
// Encoder: 4 x Block(stride=2) then Conv2d(32, 32, 3, padding=1).
// Decoder: 4 x Block(upsample=True) then Conv2d(16, 1, 3, padding=1) and a sigmoid.
type Tensor = { c: number; h: number; role: 'data' | 'hidden' | 'latent' | 'output' };
const tensors: Tensor[] = [
  { c: 1, h: 64, role: 'data' },
  { c: 16, h: 32, role: 'hidden' },
  { c: 32, h: 16, role: 'hidden' },
  { c: 32, h: 8, role: 'hidden' },
  { c: 32, h: 4, role: 'hidden' },
  { c: 32, h: 4, role: 'latent' },
  { c: 32, h: 8, role: 'hidden' },
  { c: 32, h: 16, role: 'hidden' },
  { c: 32, h: 32, role: 'hidden' },
  { c: 16, h: 64, role: 'hidden' },
  { c: 1, h: 64, role: 'output' },
];
// Operation between tensor i and i + 1.
const ops = ['s2', 's2', 's2', 's2', ru ? 'св.' : 'conv', '×2', '×2', '×2', '×2', ru ? 'вых.' : 'out'];
const zIndex = 5;

// Bar length grows with log2 of the spatial size (not to scale), thickness with the channel count.
const length = (h: number) => 24 + 22 * Math.log2(h / 4);
const thickness = (c: number) => (c === 1 ? 8 : c === 16 ? 12 : 16);
const fillClass = (role: Tensor['role']) =>
  role === 'latent' ? 'f-fill-amber' : role === 'data' ? 'f-fill-red' : 'f-fill-blue';
const strokeVar = (role: Tensor['role']) =>
  role === 'latent' ? 'var(--fig-amber)' : role === 'data' ? 'var(--fig-red)' : 'var(--fig-blue)';

// ---------- wide layout: bars left to right ----------
const W = { x0: 44, step: 59.2, cy: 176 };
const wx = (i: number) => W.x0 + i * W.step;
const wide = tensors.map((t, i) => {
  const w = thickness(t.c);
  const hgt = length(t.h);
  return { ...t, x: wx(i), w, hgt, top: W.cy - hgt / 2, bottom: W.cy + hgt / 2 };
});
const wideArrows = ops.map((op, i) => {
  const a = wide[i];
  const b = wide[i + 1];
  return { op, x1: a.x + a.w / 2 + 5, x2: b.x - b.w / 2 - 5, mid: (a.x + b.x) / 2 };
});
const labelY = 260;
const encL = wide[0].x - 14;
const encR = wide[zIndex].x + 2;
const decL = wide[zIndex].x + 10;
const decR = wide[10].x + 14;
const bracketY = 78;
const xIn = wide[0];
const xOut = wide[10];
const mseY = 318;

// ---------- narrow layout: bars top to bottom ----------
const N = { cx: 160, y0: 74, step: 42, gap: 34 };
const ny = (i: number) => N.y0 + i * N.step + (i > zIndex ? N.gap : 0);
const narrow = tensors.map((t, i) => {
  const hgt = thickness(t.c);
  const len = length(t.h);
  return { ...t, y: ny(i), hgt, len, left: N.cx - len / 2, right: N.cx + len / 2 };
});
const narrowArrows = ops.map((op, i) => {
  const a = narrow[i];
  const b = narrow[i + 1];
  return { op, y1: a.y + a.hgt / 2 + 4, y2: b.y - b.hgt / 2 - 4, mid: (a.y + b.y) / 2 };
});
const nIn = narrow[0];
const nOut = narrow[10];
const decHeaderY = narrow[zIndex].y + 36;
const nLegendY = nOut.y + 46;
const shapeText = (t: Tensor) => `${t.c}×${t.h}×${t.h}`;
---

<Figure
  id="autoencoders-pipeline"
  title={ru ? "Свёрточный автоэнкодер слой за слоем" : "The convolutional autoencoder, layer by layer"}
  caption={ru ? "Каждая полоса — один тензор; её длина растёт с пространственным размером (логарифмическая шкала, без соблюдения масштаба), а толщина — с числом каналов. Четыре блока с шагом 2 сжимают вход 64×64 до 32×4×4 = 512 чисел, последняя свёртка 3×3 даёт код z, четыре блока «повышение разрешения + свёртка» возвращают размер 64×64, а выходная свёртка с сигмоидой даёт x̂. Функция потерь сравнивает выход со входом." : "Each bar is one tensor; its length grows with the spatial size (log scale, not to scale) and its thickness with the number of channels. Four stride-2 blocks take the 64×64 input down to 32×4×4 = 512 numbers, a final 3×3 convolution gives the code z, four upsample-and-convolve blocks bring it back to 64×64, and an output convolution with a sigmoid gives x̂. The loss compares the output with the input."}
>
  <svg class="fig-wide fig-bp-640" viewBox="0 0 680 414" role="img" aria-labelledby="autoencoders-pipeline-t autoencoders-pipeline-d">
    <title id="autoencoders-pipeline-t">{ru ? "Конвейер автоэнкодера с формами тензоров" : "Autoencoder pipeline with tensor shapes"}</title>
    <desc id="autoencoders-pipeline-d">{ru ? "Ряд из одиннадцати тензоров слева направо. Вход x формы 1 на 64 на 64; после свёрток с шагом 2 — 16 на 32 на 32, 32 на 16 на 16, 32 на 8 на 8 и 32 на 4 на 4; после обычной свёртки 3 на 3 — узкое место z формы 32 на 4 на 4, то есть 512 чисел. Затем декодер четыре раза повышает разрешение вдвое и применяет свёртку: 32 на 8 на 8, 32 на 16 на 16, 32 на 32 на 32, 16 на 64 на 64, а последняя свёртка с сигмоидой даёт реконструкцию x с крышкой формы 1 на 64 на 64. Красная стрелка от x с крышкой обратно к x подписана: MSE — сравнение выхода со входом." : "A row of eleven tensors from left to right. Input x of shape 1 by 64 by 64; after stride-2 convolutions 16 by 32 by 32, 32 by 16 by 16, 32 by 8 by 8 and 32 by 4 by 4; after a plain 3 by 3 convolution the bottleneck z of shape 32 by 4 by 4, which is 512 numbers. The decoder then upsamples by two and convolves four times: 32 by 8 by 8, 32 by 16 by 16, 32 by 32 by 32, 16 by 64 by 64, and a final convolution with a sigmoid gives the reconstruction x hat of shape 1 by 64 by 64. A red arrow from x hat back to x is labelled MSE: compare output with input."}</desc>

    <!-- Encoder and decoder brackets -->
    <path class="f-thin f-blue" d={`M ${encL} ${bracketY + 10} V ${bracketY} H ${encR} V ${bracketY + 10}`} />
    <text class="f-label f-t-blue" x={(encL + encR) / 2} y={bracketY - 30} text-anchor="middle">{ru ? 'энкодер f' : 'encoder f'}<tspan dy="4" font-size="12">φ</tspan><tspan dy="-4">{ru ? ': понижение разрешения' : ': downsample'}</tspan></text>
    <text class="f-note" x={(encL + encR) / 2} y={bracketY - 10} text-anchor="middle">{ru ? "обучаемые фильтры, шаг 2" : "learned filters, stride 2"}</text>
    <path class="f-thin f-blue" d={`M ${decL} ${bracketY + 10} V ${bracketY} H ${decR} V ${bracketY + 10}`} />
    <text class="f-label f-t-blue" x={(decL + decR) / 2} y={bracketY - 30} text-anchor="middle">{ru ? 'декодер g' : 'decoder g'}<tspan dy="4" font-size="12">θ</tspan><tspan dy="-4">{ru ? ': повышение разрешения' : ': upsample'}</tspan></text>
    <text class="f-note" x={(decL + decR) / 2} y={bracketY - 10} text-anchor="middle">{ru ? "билинейное ×2, затем свёртка" : "bilinear ×2, then conv"}</text>

    <!-- Arrows with operation labels -->
    {wideArrows.map((a) => (
      <g>
        <path class="f-thin f-muted" d={`M ${a.x1} ${W.cy} H ${a.x2}`} marker-end="url(#f-arrow-muted)" />
        <text class="f-small f-t-muted" x={a.mid} y={W.cy - 9} text-anchor="middle">{a.op}</text>
      </g>
    ))}

    <!-- Tensors -->
    {wide.map((t) => (
      <g>
        {t.c > 1 && (
          <rect x={t.x - t.w / 2 + 4} y={t.top - 4} width={t.w} height={t.hgt} fill="var(--paper)" stroke={strokeVar(t.role)} stroke-width="1" />
        )}
        <rect x={t.x - t.w / 2} y={t.top} width={t.w} height={t.hgt} fill="var(--paper)" />
        <rect class={fillClass(t.role)} x={t.x - t.w / 2} y={t.top} width={t.w} height={t.hgt} stroke={strokeVar(t.role)} stroke-width="1.3" />
        <text class="f-small" x={t.x} y={labelY} text-anchor="middle">{t.h}×{t.h}</text>
        <text class="f-note" x={t.x} y={labelY + 17} text-anchor="middle" font-size="12">{t.c} {ru ? 'кан.' : 'ch'}</text>
      </g>
    ))}

    <!-- Input, output and code labels -->
    <text class="f-math f-t-red" x={xIn.x} y={xIn.top - 12} text-anchor="middle">x</text>
    <text class="f-math f-t-blue" x={xOut.x} y={xOut.top - 12} text-anchor="middle">x̂</text>
    <text class="f-label f-t-amber" x={wide[zIndex].x + 10} y={bracketY + 40} text-anchor="middle">z: 32×4×4 = 512</text>
    <path class="f-thin f-amber" d={`M ${wide[zIndex].x + 8} ${bracketY + 48} Q ${wide[zIndex].x + 12} ${bracketY + 70} ${wide[zIndex].x + 3} ${wide[zIndex].top - 8}`} stroke="var(--fig-amber)" />
    <path d={`M ${wide[zIndex].x - 1.2} ${wide[zIndex].top - 13.5} L ${wide[zIndex].x + 3} ${wide[zIndex].top - 5} L ${wide[zIndex].x + 7.4} ${wide[zIndex].top - 13}`} fill="none" stroke="var(--fig-amber)" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />

    <!-- Reconstruction loss: compare output with the input -->
    <path class="f-line f-red" d={`M ${xOut.x} ${labelY + 28} C ${xOut.x} ${mseY + 26}, ${xIn.x} ${mseY + 26}, ${xIn.x} ${labelY + 30}`} marker-end="url(#f-arrow-red)" />
    <text class="f-label f-t-red" x={340} y={mseY + 36} text-anchor="middle">MSE(<tspan font-family="var(--serif)" font-style="italic" font-size="17">x̂</tspan>, <tspan font-family="var(--serif)" font-style="italic" font-size="17">x</tspan>){ru ? ': сравнение выхода со входом' : ': compare output with input'}</text>

    <!-- Legend -->
    <text class="f-note" x={340} y={386} text-anchor="middle">{ru ? "s2: свёртка 3×3, шаг 2 → BN → LeakyReLU(0.2)   ·   св.: свёртка 3×3, шаг 1" : "s2: conv 3×3, stride 2 → BN → LeakyReLU(0.2)   ·   conv: conv 3×3, stride 1"}</text>
    <text class="f-note" x={340} y={405} text-anchor="middle">{ru ? "×2: билинейное ×2 → свёртка 3×3 → BN → LeakyReLU(0.2)   ·   вых.: свёртка 3×3 → сигмоида" : "×2: bilinear upsample ×2 → conv 3×3 → BN → LeakyReLU(0.2)   ·   out: conv 3×3 → sigmoid"}</text>
  </svg>

  <svg class="fig-narrow fig-bp-640" viewBox="0 0 360 652" role="img" aria-labelledby="autoencoders-pipeline-nt autoencoders-pipeline-nd">
    <title id="autoencoders-pipeline-nt">{ru ? "Конвейер автоэнкодера с формами тензоров" : "Autoencoder pipeline with tensor shapes"}</title>
    <desc id="autoencoders-pipeline-nd">{ru ? "Тензоры расположены сверху вниз. Энкодер: x формы 1 на 64 на 64, затем после свёрток с шагом 2 — 16 на 32 на 32, 32 на 16 на 16, 32 на 8 на 8, 32 на 4 на 4, и после свёртки 3 на 3 — код z формы 32 на 4 на 4, 512 чисел. Декодер: повышение разрешения вдвое и свёртка дают 32 на 8 на 8, 32 на 16 на 16, 32 на 32 на 32, 16 на 64 на 64, а последняя свёртка с сигмоидой даёт x с крышкой формы 1 на 64 на 64. Красная стрелка слева идёт от x с крышкой обратно вверх к x и подписана MSE." : "Tensors stacked from top to bottom. Encoder: x of shape 1 by 64 by 64, then 16 by 32 by 32, 32 by 16 by 16, 32 by 8 by 8, 32 by 4 by 4 after stride-2 convolutions, and the code z of shape 32 by 4 by 4, 512 numbers, after a 3 by 3 convolution. Decoder: upsample by two and convolve to 32 by 8 by 8, 32 by 16 by 16, 32 by 32 by 32, 16 by 64 by 64, and a final convolution with sigmoid gives x hat of shape 1 by 64 by 64. A red arrow on the left runs from x hat back up to x, labelled MSE."}</desc>

    <text class="f-label f-t-blue" x="40" y="30">{ru ? 'энкодер f' : 'encoder f'}<tspan dy="4" font-size="12">φ</tspan><tspan dy="-4">{ru ? ': понижение разрешения' : ': downsample'}</tspan></text>
    <text class="f-note" x="40" y="52">{ru ? "обучаемые фильтры, шаг 2" : "learned filters, stride 2"}</text>
    <text class="f-label f-t-blue" x="40" y={decHeaderY - 8}>{ru ? 'декодер g' : 'decoder g'}<tspan dy="4" font-size="12">θ</tspan><tspan dy="-4">:</tspan></text>
    {ru ? (
      <text class="f-note" x="40" y={decHeaderY + 14}>билинейное ×2<tspan x="40" dy="17">+ свёртка</tspan></text>
    ) : (
      <text class="f-note" x="40" y={decHeaderY + 14}>upsample + conv</text>
    )}

    {narrowArrows.map((a, i) => (
      <g>
        <path class="f-thin f-muted" d={`M ${N.cx} ${i === zIndex ? a.y1 : a.y1} V ${a.y2}`} marker-end="url(#f-arrow-muted)" />
        <text class="f-small f-t-muted" x={N.cx + 9} y={(i === zIndex ? a.y2 - 4 : a.mid + 4)}>{a.op}</text>
      </g>
    ))}

    {narrow.map((t) => (
      <g>
        {t.c > 1 && (
          <rect x={t.left + 4} y={t.y - t.hgt / 2 - 4} width={t.len} height={t.hgt} fill="var(--paper)" stroke={strokeVar(t.role)} stroke-width="1" />
        )}
        <rect x={t.left} y={t.y - t.hgt / 2} width={t.len} height={t.hgt} fill="var(--paper)" />
        <rect class={fillClass(t.role)} x={t.left} y={t.y - t.hgt / 2} width={t.len} height={t.hgt} stroke={strokeVar(t.role)} stroke-width="1.3" />
        <text class="f-small" x={236} y={t.y + 4}>{shapeText(t)}</text>
      </g>
    ))}

    <text class="f-math f-t-red" x={nIn.left - 10} y={nIn.y + 6} text-anchor="end">x</text>
    <text class="f-math f-t-blue" x={nOut.left - 10} y={nOut.y + 6} text-anchor="end">x̂</text>
    <text class="f-label f-t-amber" x={narrow[zIndex].left - 12} y={narrow[zIndex].y + 5} text-anchor="end">z</text>
    <text class="f-note f-t-amber" x={300} y={narrow[zIndex].y + 4}>= 512</text>

    <path class="f-line f-red" d={`M ${nOut.left - 30} ${nOut.y} C 18 ${nOut.y}, 16 ${nOut.y - 20}, 16 ${nOut.y - 40} V ${nIn.y + 40} C 16 ${nIn.y + 20}, 18 ${nIn.y}, ${nIn.left - 30} ${nIn.y}`} marker-end="url(#f-arrow-red)" />
    <text class="f-label f-t-red f-halo" x="26" y={(narrow[3].y + narrow[4].y) / 2 + 5}>MSE(<tspan font-family="var(--serif)" font-style="italic" font-size="17">x̂</tspan>, <tspan font-family="var(--serif)" font-style="italic" font-size="17">x</tspan>)</text>

    <text class="f-note" x="16" y={nLegendY}>{ru ? "s2: свёртка 3×3, шаг 2 → BN → LeakyReLU" : "s2: conv 3×3, stride 2 → BN → LeakyReLU"}</text>
    <text class="f-note" x="16" y={nLegendY + 19}>{ru ? "×2: билин. ×2 → свёртка 3×3 → BN → LeakyReLU" : "×2: bilinear ×2 → conv 3×3 → BN → LeakyReLU"}</text>
    <text class="f-note" x="16" y={nLegendY + 38}>{ru ? "св.: свёртка 3×3, шаг 1" : "conv: conv 3×3, stride 1"}</text>
    <text class="f-note" x="16" y={nLegendY + 57}>{ru ? "вых.: свёртка 3×3 → сигмоида" : "out: conv 3×3 → sigmoid"}</text>
  </svg>
</Figure>
