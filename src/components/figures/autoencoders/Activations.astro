---
import Figure from '../Figure.astro';
import { plot, scale, sigmoid } from '../geometry';

// Each panel is drawn in local coordinates (PW x PH) and translated into place.
const PW = 280;
const PH = 230;
const pad = { l: 18, r: 18, t: 40, b: 30 };

const leaky = (x: number) => (x >= 0 ? x : 0.2 * x);

// LeakyReLU panel: x in [-3, 3], y in [-1, 3]
const rx = scale([-3, 3], [pad.l, PW - pad.r]);
const ry = scale([-1, 3], [PH - pad.b, pad.t]);
const leakyPath = plot(leaky, -3, 3, rx, ry, 120);

// Sigmoid panel: x in [-6, 6], y in [-0.25, 1.15]
const sxs = scale([-6, 6], [pad.l, PW - pad.r]);
const sys = scale([-0.25, 1.15], [PH - pad.b, pad.t]);
const sigPath = plot(sigmoid, -6, 6, sxs, sys, 200);

const panels = [
  { key: 'leaky', title: 'LeakyReLU(x) = max(0.2x, x)' },
  { key: 'sigmoid', title: 'σ(x) = 1 / (1 + e⁻ˣ)' },
];
const wide = [{ dx: 10, dy: 0 }, { dx: 330, dy: 0 }];
const narrow = [{ dx: 40, dy: 0 }, { dx: 40, dy: PH + 30 }];
const layouts = [
  { cls: 'fig-wide fig-bp-640', vb: `0 0 620 ${PH + 8}`, pos: wide, sfx: '' },
  { cls: 'fig-narrow fig-bp-640', vb: `0 0 360 ${2 * PH + 40}`, pos: narrow, sfx: '-n' },
];
---

<Figure
  id="autoencoders-activations"
  title="LeakyReLU and sigmoid"
  caption="LeakyReLU with slope 0.2, the activation of the convolutional blocks. It is the identity for positive inputs and keeps slope 0.2, instead of ReLU's zero slope, for negative ones. The sigmoid squashes every input into (0, 1), the range of pixel intensities, which is why every model here puts it on the decoder output; it equals 0.5 at x = 0."
  origin="expanded"
  pages="1"
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={L.vb} role="img" aria-labelledby={`autoencoders-activations-t${L.sfx} autoencoders-activations-d${L.sfx}`}>
      <title id={`autoencoders-activations-t${L.sfx}`}>LeakyReLU and sigmoid activation functions</title>
      <desc id={`autoencoders-activations-d${L.sfx}`}>Two plots. Left or top: LeakyReLU, a line of slope 1 for positive x and a line of slope 0.2 for negative x, meeting at the origin. Right or bottom: the sigmoid, an S-shaped curve rising from 0 to 1, passing through 0.5 at x equal to 0, with dashed asymptotes at 0 and 1.</desc>

      <g transform={`translate(${L.pos[0].dx} ${L.pos[0].dy})`}>
        <text class="f-title" x={PW / 2} y="18" text-anchor="middle">{panels[0].title}</text>
        {[1, 2, 3].map((v) => <line class="f-grid" x1={rx(0) + 2} x2={rx(3)} y1={ry(v)} y2={ry(v)} />)}
        <path class="f-axis" d={`M ${rx(-3)} ${ry(0)} H ${rx(3) + 8}`} marker-end="url(#f-arrow-muted)" />
        <path class="f-axis" d={`M ${rx(0)} ${ry(-1)} V ${ry(3) - 8}`} marker-end="url(#f-arrow-muted)" />
        <text class="f-math" x={rx(3) + 4} y={ry(0) + 22} text-anchor="end">x</text>
        {[1, 2].map((v) => <text class="f-note" x={rx(0) - 7} y={ry(v) + 5} text-anchor="end">{v}</text>)}
        <path class="f-line f-red f-bold" d={leakyPath} />
        <text class="f-label f-t-red" x={rx(1.55)} y={ry(2.45)} text-anchor="end">slope 1</text>
        <text class="f-label f-t-red" x={rx(-1.5)} y={ry(-0.3) + 24} text-anchor="middle">slope 0.2</text>
      </g>

      <g transform={`translate(${L.pos[1].dx} ${L.pos[1].dy})`}>
        <text class="f-title" x={PW / 2} y="18" text-anchor="middle">{panels[1].title}</text>
        <path class="f-thin f-muted f-dash" d={`M ${sxs(-6)} ${sys(1)} H ${sxs(6)}`} />
        <path class="f-axis" d={`M ${sxs(-6)} ${sys(0)} H ${sxs(6) + 8}`} marker-end="url(#f-arrow-muted)" />
        <path class="f-axis" d={`M ${sxs(0)} ${sys(-0.25)} V ${sys(1.15) - 8}`} marker-end="url(#f-arrow-muted)" />
        <text class="f-math" x={sxs(6) + 4} y={sys(0) + 22} text-anchor="end">x</text>
        <text class="f-note" x={sxs(0) - 7} y={sys(1) - 6} text-anchor="end">1</text>
        <text class="f-note" x={sxs(0) - 7} y={sys(0) + 17} text-anchor="end">0</text>
        <path class="f-line f-red f-bold" d={sigPath} />
        <line class="f-thin f-muted f-dash" x1={sxs(-6)} x2={sxs(0)} y1={sys(0.5)} y2={sys(0.5)} />
        <circle class="f-solid-red" cx={sxs(0)} cy={sys(0.5)} r="4.5" />
        <text class="f-label" x={sxs(-3.3)} y={sys(0.5) - 9} text-anchor="middle">0.5 at x = 0</text>
        <text class="f-small f-t-muted" x={sxs(1.2)} y={sys(1) - 8}>→ 1 as x → ∞</text>
        <text class="f-small f-t-muted" x={sxs(-5.9)} y={sys(0) - 9}>→ 0</text>
      </g>
    </svg>
  ))}
</Figure>
