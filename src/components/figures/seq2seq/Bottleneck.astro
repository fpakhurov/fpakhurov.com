---
import Figure from '../Figure.astro';

// Encoder–decoder with a single vector handed over. Source has 4 tokens,
// target 3 tokens plus the end symbol.
const src = ['Ein', 'Mann', 'liest', '.'];
const trg = ['[CLS]', 'A', 'man', 'reads'];
const out = ['A', 'man', 'reads', '[SEP]'];
const cellW = 54;
const cellH = 34;
const gap = 18;

interface Layout { cls: string; w: number; h: number; encX: number; encY: number; decX: number; decY: number; vertical: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', w: 700, h: 250, encX: 30, encY: 110, decX: 400, decY: 110, vertical: false },
  { cls: 'fig-narrow', w: 360, h: 430, encX: 30, encY: 90, decX: 30, decY: 310, vertical: true },
];
---

<Figure
  id="seq2seq-bottleneck"
  title="Encoder–decoder: the whole source passes through one vector"
  caption="The encoder reads the source tokens left to right (and, when bidirectional, also right to left) and its final state is the only thing handed to the decoder. The decoder starts from that state and from the start symbol, and at each step predicts the next target token from its own state. Everything the decoder will ever know about the source has to fit into the vector in the middle, whatever the source length."
>
  {layouts.map((L) => {
    const encCells = src.map((_, i) => L.encX + i * (cellW + gap));
    const decCells = trg.map((_, i) => L.decX + i * (cellW + gap));
    const encEnd = encCells[encCells.length - 1] + cellW;
    const vecX = L.vertical ? L.encX + 2 * (cellW + gap) - 12 : encEnd + 36;
    const vecY = L.vertical ? L.encY + cellH + 56 : L.encY;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`seq2seq-bottleneck-${L.w}-t seq2seq-bottleneck-${L.w}-d`}>
        <title id={`seq2seq-bottleneck-${L.w}-t`}>Sequence-to-sequence model with a single context vector</title>
        <desc id={`seq2seq-bottleneck-${L.w}-d`}>Four encoder cells read the German tokens Ein, Mann, liest and a full stop, connected by arrows. The last cell feeds a single highlighted box labelled the context vector. From it, four decoder cells start at the start symbol and emit A, man, reads and the end symbol, each cell receiving the previous output as input.</desc>
        <text class="f-title" x={L.encX} y={L.encY - 42}>encoder</text>
        {src.map((tok, i) => (
          <g>
            <text class="f-label" x={encCells[i] + cellW / 2} y={L.encY + cellH + 22} text-anchor="middle">{tok}</text>
            <path class="f-thin" d={`M ${encCells[i] + cellW / 2} ${L.encY + cellH + 8} V ${L.encY + cellH + 2}`} marker-end="url(#f-arrow)" />
            <rect class="f-box" x={encCells[i]} y={L.encY} width={cellW} height={cellH} rx="6" />
            <text class="f-math" x={encCells[i] + cellW / 2} y={L.encY + 23} text-anchor="middle">h<tspan dy="5" font-size="12">{i + 1}</tspan></text>
            {i < src.length - 1 && <path class="f-line" d={`M ${encCells[i] + cellW} ${L.encY + cellH / 2} H ${encCells[i + 1] - 3}`} marker-end="url(#f-arrow)" />}
          </g>
        ))}
        {/* context vector */}
        {L.vertical
          ? <path class="f-line f-red" d={`M ${encEnd - cellW / 2} ${L.encY + cellH + 30} V ${L.encY + cellH + 34} H ${vecX + 24} V ${vecY - 3}`} marker-end="url(#f-arrow-red)" />
          : <path class="f-line f-red" d={`M ${encEnd} ${L.encY + cellH / 2} H ${vecX - 3}`} marker-end="url(#f-arrow-red)" />}
        <rect class="f-box f-fill-red" x={vecX} y={vecY} width="48" height={cellH} rx="6" />
        <text class="f-math f-t-red" x={vecX + 24} y={vecY + 23} text-anchor="middle">h<tspan dy="5" font-size="12">4</tspan></text>
        <text class="f-small f-t-red" x={vecX + 24} y={vecY - 10} text-anchor="middle">one vector</text>
        {L.vertical
          ? <path class="f-line f-red" d={`M ${vecX + 24} ${vecY + cellH} V ${L.decY - 3}`} marker-end="url(#f-arrow-red)" />
          : <path class="f-line f-red" d={`M ${vecX + 48} ${vecY + cellH / 2} H ${decCells[0] - 3}`} marker-end="url(#f-arrow-red)" />}
        {/* decoder */}
        <text class="f-title" x={L.decX} y={L.decY - 42}>decoder</text>
        {trg.map((tok, i) => (
          <g>
            <text class="f-label" x={decCells[i] + cellW / 2} y={L.decY + cellH + 22} text-anchor="middle">{tok}</text>
            <path class="f-thin" d={`M ${decCells[i] + cellW / 2} ${L.decY + cellH + 8} V ${L.decY + cellH + 2}`} marker-end="url(#f-arrow)" />
            <rect class="f-box" x={decCells[i]} y={L.decY} width={cellW} height={cellH} rx="6" />
            <text class="f-math" x={decCells[i] + cellW / 2} y={L.decY + 23} text-anchor="middle">s<tspan dy="5" font-size="12">{i + 1}</tspan></text>
            <path class="f-thin f-blue" d={`M ${decCells[i] + cellW / 2} ${L.decY - 2} V ${L.decY - 14}`} marker-end="url(#f-arrow-blue)" />
            <text class="f-label f-t-blue" x={decCells[i] + cellW / 2} y={L.decY - 20} text-anchor="middle">{out[i]}</text>
            {i < trg.length - 1 && <path class="f-line" d={`M ${decCells[i] + cellW} ${L.decY + cellH / 2} H ${decCells[i + 1] - 3}`} marker-end="url(#f-arrow)" />}
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
