---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Badge from '../seqflow/Badge.astro';
import Arrow from '../seqflow/Arrow.astro';
import Box from '../seqflow/Box.astro';
import NewMark from '../seqflow/NewMark.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// An illustrative pair in the spirit of Multi30k; the words are not a model output.
const src = ['Zwei', 'Männer', 'laufen'];
const decIn = ['[CLS]', 'Two', 'men', 'run'];
const decOut = ['Two', 'men', 'run', '[SEP]'];
const t = ru
  ? { enc: 'энкодер', dec: 'декодер', ctx: 'контекст s₀', back: 'назад на вход',
      steps: ['энкодер читает исходные токены', 'последнее состояние → s₀ декодера', 'первый шаг: [CLS] → «Two»', 'выход подаётся на вход следующего шага', 'остановка на [SEP]'] }
  : { enc: 'encoder', dec: 'decoder', ctx: 'context s₀', back: 'fed back',
      steps: ['the encoder reads the source tokens', 'its last state becomes the decoder’s s₀', 'first step: [CLS] → “Two”', 'each output is fed back as the next input', 'stop at [SEP]'] };
const id = 'seq2seq-flow';
const cw = 70, ch = 36;
const layouts = [
  { cls: 'fig-wide', W: 770, H: 300, encX: [10, 100, 190], ctxX: 290, decX: [380, 475, 570, 665], encY: 110, decY: 110, legend: [8, 290], step: 130, rows: 1 },
  { cls: 'fig-narrow seq-narrow', W: 380, H: 560, encX: [10, 100, 190], ctxX: 300, decX: [10, 100, 190, 280], encY: 70, decY: 360, legend: [8, 528], step: 190, rows: 2 },
];
---

<Figure
  id={id}
  title={ru ? 'Кодировщик и декодер: что куда идёт' : 'Encoder and decoder: what goes where'}
  caption={ru
    ? 'Иллюстративная пара предложений. Энкодер — та же рекуррентная ячейка, что в заметке о RNN, — читает немецкие токены по одному (1). Его последнее состояние, единственный вектор, который получит декодер, становится начальным состоянием s₀ (2). Декодер — вторая рекуррентная сеть, языковая модель над английским: из стартового символа и s₀ он предсказывает первое слово (3), подаёт его себе на вход и предсказывает следующее (4), пока не выдаст символ конца (5). При обучении вместо собственных предсказаний на вход подаются правильные слова (teacher forcing).'
    : 'An illustrative sentence pair. The encoder, the same recurrent cell as in the RNN note, reads the German tokens one at a time (1). Its last state, the only vector the decoder will receive, becomes the initial state s₀ (2). The decoder is a second recurrent network, a language model over English: from the start symbol and s₀ it predicts the first word (3), feeds it back as its next input and predicts the next (4), until it emits the end symbol (5). In training, the gold words are fed in instead of the model’s own predictions (teacher forcing).'}
>
  {layouts.map((L) => {
    const narrow = L.cls.includes('narrow');
    const encLast = L.encX[2] + cw;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Энкодер–декодер на трёх и четырёх шагах' : 'An encoder–decoder over three and four steps'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? `Энкодер из трёх ячеек читает ${src.join(', ')}; его последнее состояние становится s₀. Декодер из четырёх ячеек получает на вход ${decIn.join(', ')} и выдаёт ${decOut.join(', ')}; каждый выход подаётся на вход следующей ячейки.`
          : `An encoder of three cells reads ${src.join(', ')}; its last state becomes s₀. A decoder of four cells takes ${decIn.join(', ')} as inputs and outputs ${decOut.join(', ')}; each output is fed to the next cell.`}</desc>
        <text class="f-small f-t-muted" x={L.encX[0]} y={L.encY - 50}>{t.enc}</text>
        <text class="f-small f-t-muted" x={L.decX[0]} y={L.decY - (narrow ? 86 : 70)}>{t.dec}</text>
        <g data-s="1">
          {src.map((w, i) => (
            <g>
              <Vec x={L.encX[i]} y={L.encY + 70} values={[w]} tone="x" cw={cw} />
              <Arrow pts={[[L.encX[i] + cw / 2, L.encY + 70], [L.encX[i] + cw / 2, L.encY + ch + 2]]} />
              <Box x={L.encX[i]} y={L.encY} w={cw} h={ch} label="LSTM" tone="h" />
              {i > 0 && <Arrow pts={[[L.encX[i - 1] + cw, L.encY + ch / 2], [L.encX[i] - 2, L.encY + ch / 2]]} tone="blue" bold />}
            </g>
          ))}
          <Badge x={L.encX[0] + 4} y={L.encY + 58} n={1} />
        </g>
        <g data-s="2">
          <NewMark x={L.ctxX - (narrow ? 26 : 14)} y={L.encY - (narrow ? 40 : 26)} w={narrow ? 88 : 66} h={narrow ? 106 : 92} />
          <Arrow pts={[[encLast, L.encY + ch / 2], [L.ctxX - 2, L.encY + ch / 2]]} tone="blue" bold />
          <Vec x={L.ctxX} y={L.encY - 15} values={['', '', '']} tone="h" cw={36} bold />
          <text class="f-small f-t-blue" x={L.ctxX + 18} y={narrow ? L.encY - 22 : L.encY + 84} text-anchor="middle">{t.ctx}</text>
          {narrow
            ? <Arrow pts={[[L.ctxX + 18, L.encY + 51], [L.ctxX + 18, L.decY - 70], [4, L.decY - 70], [4, L.decY + ch / 2], [L.decX[0] - 2, L.decY + ch / 2]]} tone="blue" bold />
            : <Arrow pts={[[L.ctxX + 36, L.decY + ch / 2], [L.decX[0] - 2, L.decY + ch / 2]]} tone="blue" bold />}
          <Badge x={L.ctxX + 48} y={narrow ? L.encY + 40 : L.encY + 2} n={2} />
        </g>
        {decIn.map((w, j) => {
          const x = L.decX[j], step = j === 0 ? 3 : j === 3 ? 5 : 4;
          return (
            <g data-s={String(step)}>
              <Vec x={x} y={L.decY + 70} values={[w]} tone={j === 0 ? 'n' : 'x'} cw={cw} />
              <Arrow pts={[[x + cw / 2, L.decY + 70], [x + cw / 2, L.decY + ch + 2]]} />
              <Box x={x} y={L.decY} w={cw} h={ch} label="LSTM" tone="h" />
              {j > 0 && <Arrow pts={[[L.decX[j - 1] + cw, L.decY + ch / 2], [x - 2, L.decY + ch / 2]]} tone="blue" bold />}
              <Arrow pts={[[x + cw / 2, L.decY], [x + cw / 2, L.decY - 34]]} />
              <Vec x={x} y={L.decY - 56} values={[decOut[j]]} tone="y" cw={cw} />
              {j < 3 && <Arrow pts={[[x + cw, L.decY - 45], [x + cw + 11, L.decY - 45], [x + cw + 11, L.decY + 81], [L.decX[j + 1] - 2, L.decY + 81]]} tone="red" dashed />}
              <Badge x={x + cw - 2} y={L.decY - 2} n={step} />
            </g>
          );
        })}
        <text class="f-small f-t-red" x={L.decX[1] + cw + 16} y={L.decY + 112}>{t.back}</text>
        <Legend x={L.legend[0]} y={L.legend[1]} step={L.step} rows={L.rows} />
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
