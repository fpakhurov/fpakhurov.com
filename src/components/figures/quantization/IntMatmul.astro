---
import BlockDiagram, { type DLayout } from '../BlockDiagram.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A quantized linear layer: everything between the two float ends is integer arithmetic.
const t = ru
  ? { x: 'X', xSub: 'вход, float', q: 'квантовать', qSub: 'шаг и нуль X', w: 'W, int8', wSub: 'квантована заранее', mm: 'int8 × int8', mmSub: 'накопление в int32', corr: 'суммы, константа', corrSub: 'нулевые точки', sc: '× два шага + b', scSub: 'выход Y, float' }
  : { x: 'X', xSub: 'input, float', q: 'quantize', qSub: 'scale and zero of X', w: 'W, int8', wSub: 'quantized in advance', mm: 'int8 × int8', mmSub: 'int32 accumulate', corr: 'sums, constant', corrSub: 'zero points', sc: '× both scales + b', scSub: 'output Y, float' };
const desc = ru
  ? 'Вход X во float квантуется со своим шагом и нулевой точкой; заранее квантованные веса хранятся в int8. Целочисленное произведение с накоплением в int32, поправки на суммы строк и столбцов и константа, затем одно умножение на произведение двух шагов и прибавление смещения дают выход Y во float.'
  : 'The float input X is quantized with its own scale and zero point; the weights are quantized in advance and stored in int8. The integer product accumulated in int32, the corrections by row and column sums and a constant, then one multiplication by the product of the two scales and the bias give the float output Y.';
const wide: DLayout = {
  cls: 'fig-wide', w: 700, h: 190, desc,
  nodes: [
    { id: 'x', x: 8, y: 20, w: 84, h: 48, label: t.x, sub: t.xSub, tone: 'soft' },
    { id: 'q', x: 116, y: 20, w: 116, h: 48, label: t.q, sub: t.qSub, tone: 'amber' },
    { id: 'w', x: 116, y: 120, w: 116, h: 48, label: t.w, sub: t.wSub, tone: 'blue' },
    { id: 'mm', x: 262, y: 66, w: 134, h: 56, label: t.mm, sub: t.mmSub, tone: 'blue' },
    { id: 'corr', x: 420, y: 66, w: 124, h: 56, label: t.corr, sub: t.corrSub, tone: 'blue' },
    { id: 'sc', x: 568, y: 66, w: 124, h: 56, label: t.sc, sub: t.scSub, tone: 'soft' },
  ],
  edges: [{ from: 'x', to: 'q' }, { from: 'q', to: 'mm' }, { from: 'w', to: 'mm' }, { from: 'mm', to: 'corr' }, { from: 'corr', to: 'sc' }],
};
const narrow: DLayout = {
  cls: 'fig-narrow', w: 360, h: 380, desc,
  nodes: [
    { id: 'x', x: 8, y: 8, w: 150, h: 48, label: t.x, sub: t.xSub, tone: 'soft' },
    { id: 'q', x: 8, y: 86, w: 150, h: 48, label: t.q, sub: t.qSub, tone: 'amber' },
    { id: 'w', x: 200, y: 86, w: 150, h: 48, label: t.w, sub: t.wSub, tone: 'blue' },
    { id: 'mm', x: 90, y: 164, w: 180, h: 52, label: t.mm, sub: t.mmSub, tone: 'blue' },
    { id: 'corr', x: 90, y: 242, w: 180, h: 52, label: t.corr, sub: t.corrSub, tone: 'blue' },
    { id: 'sc', x: 90, y: 320, w: 180, h: 52, label: t.sc, sub: t.scSub, tone: 'soft' },
  ],
  edges: [{ from: 'x', to: 'q' }, { from: 'q', to: 'mm' }, { from: 'w', to: 'mm' }, { from: 'mm', to: 'corr' }, { from: 'corr', to: 'sc' }],
};
---

<BlockDiagram
  id="quantized-linear"
  title={ru ? 'Квантованный линейный слой' : 'A quantized linear layer'}
  svgTitle={ru ? 'Целочисленное умножение матриц с одним масштабированием' : 'An integer matrix product with one rescaling'}
  caption={ru
    ? 'Формула из текста как конвейер. Синие блоки — целочисленная арифметика: произведение int8 × int8 с накоплением в int32, поправки на суммы строк и столбцов, умноженные на нулевые точки, и постоянный член. Вещественные числа появляются только на концах: вход квантуется по своему диапазону, а результат один раз умножается на произведение двух шагов и к нему прибавляется смещение. Веса квантуются заранее и читаются из памяти вчетверо меньшими, чем во float32; ускорение даёт быстрое ядро int8 × int8 на целевом оборудовании.'
    : 'The formula of the text as a pipeline. Blue blocks are integer arithmetic: the int8 × int8 product accumulated in int32, the corrections by row and column sums times the zero points, and the constant term. Floats appear only at the ends: the input is quantized from its range, and the result is rescaled once by the product of the two scales and the bias is added. The weights are quantized in advance and read from memory at a quarter of their float32 size; the speed-up comes from a fast int8 × int8 kernel on the target hardware.'}
  layouts={[wide, narrow]}
/>
