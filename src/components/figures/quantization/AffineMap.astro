---
import Figure from '../Figure.astro';
import { scale } from '../geometry';

// Affine int8 quantization of the range [a, b] = [-2, 3]: s = (b - a) / 255,
// z = round((b * (-128) - a * 127) / (b - a)). Points show round-trip error.
const a = -2;
const b = 3;
const aq = -128;
const bq = 127;
const s = (b - a) / (bq - aq);
const z = Math.trunc((b * aq - a * bq) / (b - a));
const quantize = (x: number) => Math.max(aq, Math.min(bq, Math.round(x / s + z)));
const dequantize = (q: number) => s * (q - z);
const samples = [-2, -0.8, 0, 0.37, 1, 3];
const rows = samples.map((x) => ({ x, q: quantize(x), back: dequantize(quantize(x)) }));

interface Layout { cls: string; w: number; h: number; left: number; right: number; realY: number; intY: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', w: 640, h: 230, left: 60, right: 580, realY: 60, intY: 160 },
  { cls: 'fig-narrow', w: 360, h: 230, left: 30, right: 330, realY: 60, intY: 160 },
];
const f = (v: number) => v.toFixed(4).replace(/\.?0+$/, '');
---

<Figure
  id="affine-quantization"
  title="Affine int8 quantization of the range [−2, 3]"
  caption={`With a = −2 and b = 3 the scale is s = (b − a)/255 = ${f(s)} and the zero point z = ${z}, so that x = s (x_q − z) maps −128 to ${f(dequantize(aq))} and 127 to ${f(dequantize(bq))}. Each real value (top line) is rounded to the nearest of the 256 integer levels (bottom line); dequantizing it lands within s/2 = ${f(s / 2)} of the original. 0.37 becomes ${quantize(0.37)} and comes back as ${f(dequantize(quantize(0.37)))}. Values outside [a, b] are clipped to the ends.`}
>
  {layouts.map((L) => {
    const sx = scale([a, b], [L.left, L.right]);
    const sq = scale([aq, bq], [L.left, L.right]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`affine-quantization-${L.w}-t affine-quantization-${L.w}-d`}>
        <title id={`affine-quantization-${L.w}-t`}>Real values mapped to int8 levels</title>
        <desc id={`affine-quantization-${L.w}-d`}>Two horizontal number lines. The top one spans the real range from minus 2 to 3; the bottom one spans the integers from minus 128 to 127. Arrows connect sample real values to their integer levels, and labels give the rounded integer and the dequantized value.</desc>
        <text class="f-note" x={L.left} y={L.realY - 26}>real x ∈ [{a}, {b}]</text>
        <path class="f-axis" d={`M ${L.left} ${L.realY} H ${L.right}`} />
        {[-2, -1, 0, 1, 2, 3].map((t) => (
          <g>
            <path class="f-axis" d={`M ${sx(t)} ${L.realY - 5} V ${L.realY + 5}`} />
            <text class="f-small f-t-muted" x={sx(t)} y={L.realY - 10} text-anchor="middle">{t}</text>
          </g>
        ))}
        <text class="f-note" x={L.left} y={L.intY + 40}>int8 x_q ∈ [{aq}, {bq}], z = {z}</text>
        <path class="f-axis" d={`M ${L.left} ${L.intY} H ${L.right}`} />
        {[-128, -64, 0, 64, 127].map((t) => (
          <g>
            <path class="f-axis" d={`M ${sq(t)} ${L.intY - 5} V ${L.intY + 5}`} />
            <text class="f-small f-t-muted" x={sq(t)} y={L.intY + 22} text-anchor="middle">{t}</text>
          </g>
        ))}
        <path class="f-thin f-dash f-muted" d={`M ${sq(z)} ${L.intY - 8} V ${L.realY + 8}`} />
        <text class="f-small f-t-muted" x={sq(z) + 4} y={(L.realY + L.intY) / 2 + 4}>z ↔ 0</text>
        {rows.map((row) => (
          <g>
            <circle class="f-solid-blue" cx={sx(row.x)} cy={L.realY} r="4" />
            <path class="f-thin f-blue" d={`M ${sx(row.x)} ${L.realY + 6} L ${sq(row.q)} ${L.intY - 7}`} marker-end="url(#f-arrow-blue)" />
            <circle class="f-solid-green" cx={sq(row.q)} cy={L.intY} r="3.5" />
          </g>
        ))}
        <text class="f-small f-t-blue f-halo" x={sx(0.37)} y={L.realY - 10} text-anchor="middle">0.37</text>
        <text class="f-small f-t-green f-halo" x={sq(quantize(0.37)) + 6} y={L.intY + 22} text-anchor="start">{quantize(0.37)} → {f(dequantize(quantize(0.37)))}</text>
      </svg>
    );
  })}
</Figure>
