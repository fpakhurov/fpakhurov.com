---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Op from '../seqflow/Op.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { sigmoid, moderated } from './laplace';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The worked example of the note: logistic regression with one weight and no bias, prior N(0, 1),
// five points; Newton's method from w = 0, the Laplace precision at the mode, the prediction at x* = 3.
const x = [-1.5, -0.5, 0.5, 1, 2], tv = [0, 1, 0, 1, 1], alpha = 1, xStar = 3;
const iters = [0];
for (let k = 0; k < 6; k++) {
  const w = iters[iters.length - 1];
  const g = x.reduce((s, xi, i) => s + xi * (tv[i] - sigmoid(w * xi)), 0) - alpha * w;
  const h = x.reduce((s, xi) => s + xi * xi * sigmoid(w * xi) * (1 - sigmoid(w * xi)), 0) + alpha;
  iters.push(w + g / h);
}
const wHat = iters[iters.length - 1];
const A = x.reduce((s, xi) => s + xi * xi * sigmoid(wHat * xi) * (1 - sigmoid(wHat * xi)), 0) + alpha;
const muA = xStar * wHat, s2 = (xStar * xStar) / A, kappa = 1 / Math.sqrt(1 + (Math.PI * s2) / 8);
const mapP = sigmoid(muA), modP = moderated(muA, s2);
// The exact predictive probability under the true posterior, by the trapezoidal rule on [−20, 20].
let num = 0, den = 0;
for (let i = 0; i <= 40000; i++) {
  const w = -20 + i * 0.001, wt = i === 0 || i === 40000 ? 0.5 : 1;
  const lp = x.reduce((s, xi, k) => s + Math.log(tv[k] ? sigmoid(w * xi) : 1 - sigmoid(w * xi)), 0) - (alpha * w * w) / 2;
  num += wt * Math.exp(lp) * sigmoid(xStar * w); den += wt * Math.exp(lp);
}
const exact = num / den;
const chk = [iters[1].toFixed(3), iters[2].toFixed(3), wHat.toFixed(4), A.toFixed(3), (1 / Math.sqrt(A)).toFixed(3), muA.toFixed(3), s2.toFixed(3), kappa.toFixed(3), mapP.toFixed(3), modP.toFixed(3), exact.toFixed(3)].join(' ');
if (chk !== '0.596 0.630 0.6305 2.490 0.634 1.891 3.614 0.643 0.869 0.771 0.790') throw new Error(`LaplaceFlow: the worked example drifted (${chk})`);
const m = (s: string) => s.replace(/-/g, '−');

const t = ru
  ? {
      title: 'Приближение Лапласа для логистической регрессии с одним весом',
      newtonSub: 'шаги Ньютона для ln p(w | t)', newtonShort: 'шаги Ньютона', sd: `ст. откл. ${(1 / Math.sqrt(A)).toFixed(3)}`,
      tail: `подстановка MAP σ(μₐ) = ${mapP.toFixed(3)}; точный ответ ${exact.toFixed(3)}`, tailShort: `MAP ${mapP.toFixed(3)}; точно ${exact.toFixed(3)}`,
      steps: ['шаги Ньютона к моде ŵ', 'кривизна в моде — обратная дисперсия A', 'активация в x* = 3 гауссовская', 'смягчённая вероятность σ(κμₐ)'],
      desc: `Пять точек, один вес, априорное распределение N(0, 1). Метод Ньютона из нуля: 0.596, 0.630, мода ŵ = 0.6305. Обратная дисперсия приближения A = 2.490, стандартное отклонение 0.634. В точке x* = 3 активация a = wx* распределена как N(1.891, 3.614); κ = 0.643, смягчённая вероятность σ(κμₐ) = 0.771 против 0.869 у подстановки MAP; точный ответ 0.790.`,
    }
  : {
      title: 'The Laplace approximation for logistic regression with one weight',
      newtonSub: 'Newton steps on ln p(w | t)', newtonShort: 'Newton steps', sd: `sd = ${(1 / Math.sqrt(A)).toFixed(3)}`,
      tail: `MAP plug-in σ(μₐ) = ${mapP.toFixed(3)}; exact posterior ${exact.toFixed(3)}`, tailShort: `MAP σ(μₐ) = ${mapP.toFixed(3)}; exact ${exact.toFixed(3)}`,
      steps: ['Newton steps to the mode ŵ', 'the curvature at the mode: the precision A', 'the activation at x* = 3 is Gaussian', 'the moderated probability σ(κμₐ)'],
      desc: `Five points, one weight, prior N(0, 1). Newton's method from zero: 0.596, 0.630, the mode ŵ = 0.6305. The precision of the approximation is A = 2.490, the standard deviation 0.634. At x* = 3 the activation a = wx* is N(1.891, 3.614); κ = 0.643 and the moderated probability σ(κμₐ) = 0.771 against 0.869 for the MAP plug-in; the exact answer is 0.790.`,
    };
const id = 'laplace-flow';
const caption = ru
  ? `Логистическая регрессия p(t = 1 | x) = σ(wx) без свободного члена, пять точек, априорное распределение N(0, 1). Зелёным — данные, жёлтым — априорное распределение, синим — апостериорное и его приближение, красным — прогноз. Логарифм апостериорной плотности вогнут, и метод Ньютона сходится за три шага. Приближение — N(${wHat.toFixed(3)}, 1/${A.toFixed(3)}). В точке x* = 3 неопределённость веса умножается на 3, дисперсия активации — на 9, и смягчённая вероятность ${modP.toFixed(3)} ближе к точному ${exact.toFixed(3)}, чем подстановка моды ${mapP.toFixed(3)}.`
  : `Logistic regression p(t = 1 | x) = σ(wx) without a bias, five points, prior N(0, 1). Green: the data; amber: the prior; blue: the posterior and its approximation; red: the prediction. The log-posterior is concave and Newton's method converges in three steps. The approximation is N(${wHat.toFixed(3)}, 1/${A.toFixed(3)}). At x* = 3 the weight uncertainty is multiplied by 3 and the activation variance by 9, and the moderated probability ${modP.toFixed(3)} is closer to the exact ${exact.toFixed(3)} than the plug-in of the mode, ${mapP.toFixed(3)}.`;
const it3 = [iters[0], iters[1], iters[2], wHat].map((v, i) => (i === 3 ? v.toFixed(4) : i === 0 ? '0' : v.toFixed(3)));
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 310" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <Vec x={44} y={30} values={x.map((v) => m(String(v)))} tone="x" dir="row" cw={46} label="x" labelPos="left" />
    <Vec x={44} y={64} values={tv.map(String)} tone="x" dir="row" cw={46} label="t" labelPos="left" />
    <Box x={310} y={26} w={120} h={44} label="α = 1" sub="N(0, 1/α)" tone="g" />
    <g data-s="1">
      <Arrow pts={[[150, 86], [150, 128]]} />
      <Arrow pts={[[370, 70], [370, 100], [240, 100], [240, 128]]} tone="amber" />
      <Box x={40} y={130} w={230} h={44} label="w ← w − ℓ′(w)/ℓ″(w)" sub={t.newtonSub} />
      <Arrow pts={[[270, 152], [328, 152]]} />
      <Vec x={330} y={141} values={it3} tone="h" dir="row" cw={58} label="w" labelPos="above" />
      <Badge x={40} y={126} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[562, 152], [588, 152]]} />
      <Box x={590} y={130} w={160} h={44} label={`A = −ℓ″(ŵ) = ${A.toFixed(3)}`} sub={t.sd} tone="h" />
      <Badge x={590} y={126} n={2} />
    </g>
    <g data-s="3">
      <Vec x={44} y={220} values={[String(xStar)]} tone="x" dir="row" label="x_*" labelPos="left" />
      <Arrow pts={[[86, 231], [143, 231]]} />
      <Arrow pts={[[670, 174], [670, 198], [220, 198], [220, 216]]} tone="blue" />
      <Op x={220} y={231} sym="μₐ = 3ŵ,  s² = 9/A" />
      <Arrow pts={[[297, 231], [328, 231]]} />
      <Box x={330} y={209} w={190} h={44} label={`a ~ N(${muA.toFixed(3)}, ${s2.toFixed(3)})`} tone="h" />
      <Badge x={220} y={258} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[520, 231], [558, 231]]} />
      <Box x={560} y={209} w={190} h={44} label={`σ(κμₐ) = ${modP.toFixed(3)}`} sub={`κ = ${kappa.toFixed(3)}`} tone="y" />
      <text class="f-small f-t-muted" x="330" y="290">{t.tail}</text>
      <Badge x={560} y={205} n={4} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 580" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <Vec x={60} y={20} values={x.map((v) => m(String(v)))} tone="x" dir="row" cw={50} label="x" labelPos="left" />
    <Vec x={60} y={52} values={tv.map(String)} tone="x" dir="row" cw={50} label="t" labelPos="left" />
    <Box x={200} y={92} w={140} h={44} label="α = 1" sub="N(0, 1/α)" tone="g" />
    <g data-s="1">
      <Arrow pts={[[100, 74], [100, 158]]} />
      <Arrow pts={[[270, 136], [270, 158]]} tone="amber" />
      <Box x={20} y={160} w={260} h={44} label="w ← w − ℓ′(w)/ℓ″(w)" sub={t.newtonShort} />
      <Arrow pts={[[150, 204], [150, 234]]} />
      <Vec x={40} y={236} values={it3} tone="h" dir="row" cw={64} label="w" labelPos="left" />
      <Badge x={20} y={156} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[150, 258], [150, 288]]} />
      <Box x={20} y={290} w={260} h={44} label={`A = −ℓ″(ŵ) = ${A.toFixed(3)}`} sub={t.sd} tone="h" />
      <Badge x={20} y={286} n={2} />
    </g>
    <g data-s="3">
      <Vec x={60} y={370} values={[String(xStar)]} tone="x" dir="row" label="x_*" labelPos="left" />
      <Arrow pts={[[100, 381], [138, 381]]} />
      <Arrow pts={[[215, 334], [215, 366]]} tone="blue" />
      <Op x={215} y={381} sym="μₐ = 3ŵ,  s² = 9/A" />
      <Arrow pts={[[215, 394], [215, 418]]} />
      <Box x={20} y={420} w={260} h={44} label={`a ~ N(${muA.toFixed(3)}, ${s2.toFixed(3)})`} tone="h" />
      <Badge x={302} y={381} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[150, 464], [150, 492]]} />
      <Box x={20} y={494} w={260} h={44} label={`σ(κμₐ) = ${modP.toFixed(3)}`} sub={`κ = ${kappa.toFixed(3)}`} tone="y" />
      <text class="f-small f-t-muted" x="20" y="566">{t.tailShort}</text>
      <Badge x={20} y={490} n={4} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
