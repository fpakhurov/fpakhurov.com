---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { xs, ts, sigmoid, moderated, fit2, exactGrid, exactPredict } from './laplace';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Six points in one dimension, features (1, x), prior N(0, I). Three predictive probabilities of class 1:
// the plug-in of the mode, the moderated output (Laplace plus the probit approximation), and the exact
// posterior predictive computed on a grid over the two weights.
const { w, S } = fit2();
const grid = exactGrid(w, S);
const act = (x: number) => ({ m: w[0] + w[1] * x, v: S[0][0] + 2 * x * S[0][1] + x * x * S[1][1] });
const mapP = (x: number) => sigmoid(act(x).m);
const modP = (x: number) => { const a = act(x); return moderated(a.m, a.v); };
const chk = [w[0].toFixed(4), w[1].toFixed(4), ...[0, 1, 3].map((x) => `${mapP(x).toFixed(3)}/${modP(x).toFixed(3)}/${exactPredict(grid, x).toFixed(3)}`)].join(' ');
if (chk !== '0.0099 0.6940 0.502/0.502/0.502 0.669/0.649/0.663 0.890/0.790/0.814') throw new Error(`ModeratedOutput: the example drifted (${chk})`);
// The boundary p = 1/2 is the same for the plug-in and the moderated output: κ > 0 does not change the sign of μₐ.
const x0 = -w[0] / w[1];
if (Math.abs(mapP(x0) - 0.5) > 1e-12 || Math.abs(modP(x0) - 0.5) > 1e-12) throw new Error('ModeratedOutput: the boundaries differ');

const dom = { x: [-5, 5] as [number, number], y: [0, 1] as [number, number] };
const N = 80;
const gx = Array.from({ length: N + 1 }, (_, i) => dom.x[0] + ((dom.x[1] - dom.x[0]) * i) / N);
const curves = [
  { cls: 'f-line f-red', ys: gx.map(mapP), label: ru ? 'подстановка моды σ(μₐ)' : 'plug-in of the mode σ(μₐ)' },
  { cls: 'f-line f-blue', ys: gx.map(modP), label: ru ? 'смягчённый выход σ(κμₐ)' : 'moderated σ(κμₐ)' },
  { cls: 'f-line f-bold', ys: gx.map((x) => exactPredict(grid, x)), label: ru ? 'точный апостериорный прогноз' : 'exact posterior predictive' },
];
const t = ru
  ? { title: 'Смягчённый выход байесовской логистической регрессии', x: 'x', desc: 'Три кривые вероятности класса 1 над осью x от −5 до 5: подстановка моды быстро уходит к 0 и 1, смягчённый выход остаётся ближе к 1/2, точный прогноз лежит между ними. Все три пересекают 1/2 в одной точке.' }
  : { title: 'The moderated output of Bayesian logistic regression', x: 'x', desc: 'Three curves of the probability of class 1 over x from −5 to 5: the plug-in of the mode goes quickly to 0 and 1, the moderated output stays closer to 1/2, and the exact predictive lies between them. All three cross 1/2 at the same point.' };
const id = 'laplace-moderated';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 300, x0: 50, x1: 580, y0: 20, y1: 250, leg: { x: 60, y: 44 } },
  { cls: 'fig-narrow', W: 360, H: 350, x0: 36, x1: 350, y0: 20, y1: 250, leg: { x: 36, y: 296 } },
];
const textW = (s: string) => s.length * 6.5;
for (const L of layouts) for (const c of curves) if (L.leg.x + 30 + textW(c.label) > L.W - 2) throw new Error(`ModeratedOutput: "${c.label}" runs past the frame`);
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? `Шесть точек, по три каждого класса (кружки внизу — класс 0, вверху — класс 1), признаки (1, x), априорное распределение N(0, I). Мода апостериорного распределения ŵ = (${w[0].toFixed(3)}, ${w[1].toFixed(3)}). Подстановка моды (красная) уверенно уходит к 0 и 1 вдали от данных. Приближение Лапласа делает активацию гауссовской с дисперсией, растущей как x², и смягчённый выход (синий) остаётся ближе к 1/2: в x = 3 он равен ${modP(3).toFixed(3)} против ${mapP(3).toFixed(3)}. Точный апостериорный прогноз (чёрный), посчитанный на сетке по двум весам, — ${exactPredict(grid, 3).toFixed(3)}: смягчение направлено верно, но здесь заходит немного слишком далеко. Граница p = 1/2 у всех трёх общая.`
    : `Six points, three of each class (dots at the bottom: class 0; at the top: class 1), features (1, x), prior N(0, I). The posterior mode is ŵ = (${w[0].toFixed(3)}, ${w[1].toFixed(3)}). The plug-in of the mode (red) heads confidently to 0 and 1 away from the data. The Laplace approximation makes the activation Gaussian with a variance that grows like x², and the moderated output (blue) stays closer to 1/2: at x = 3 it is ${modP(3).toFixed(3)} against ${mapP(3).toFixed(3)}. The exact posterior predictive (black), computed on a grid over the two weights, is ${exactPredict(grid, 3).toFixed(3)}: the moderation goes in the right direction but here slightly too far. The boundary p = 1/2 is shared by all three.`}
>
  {layouts.map((L) => {
    const sx = scale(dom.x, [L.x0, L.x1]), sy = scale(dom.y, [L.y1, L.y0]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {[0, 0.5, 1].map((v) => <g><path class={v === 0.5 ? 'f-thin f-dash f-muted' : 'f-grid'} d={`M ${L.x0} ${sy(v)} H ${L.x1}`} /><text class="f-note" x={L.x0 - 6} y={sy(v) + 4} text-anchor="end">{String(v)}</text></g>)}
        {[-4, -2, 0, 2, 4].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{String(v).replace('-', '−')}</text>)}
        <text class="f-small f-t-muted" x={L.x1} y={L.y1 + 18} text-anchor="end">{t.x}</text>
        {curves.map((c) => <path class={c.cls} d={polyline(gx.map((x, i) => [sx(x), sy(c.ys[i])]))} />)}
        {xs.map((x, i) => <circle cx={sx(x)} cy={sy(ts[i])} r="4" style={`fill: var(--paper); stroke: var(--ink); stroke-width: 1.6`} />)}
        {curves.map((c, i) => (
          <g>
            <path class={c.cls} d={`M ${L.leg.x} ${L.leg.y + i * 20 - 4} h 22`} />
            <text class="f-small" x={L.leg.x + 30} y={L.leg.y + i * 20}>{c.label}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
