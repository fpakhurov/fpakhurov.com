---
import Figure from '../Figure.astro';
import { scale, plot, gaussian } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Left: the skewed posterior Beta(4, 2), a coin after 3 heads and 1 tail under a uniform prior, and its Laplace
// approximation N(3/4, 1/A) with A = 3/p² + 1/(1 − p)² at p = 3/4. Right: a bimodal posterior over θ when only θ²
// is observed, t = 2 with noise standard deviation 0.5 and prior N(0, 2²), and the Laplace approximation at θ > 0.
const betaPdf = (p: number) => (p <= 0 || p >= 1 ? 0 : 20 * p ** 3 * (1 - p));
const mode1 = 0.75, A1 = 3 / mode1 ** 2 + 1 / (1 - mode1) ** 2, sd1 = 1 / Math.sqrt(A1);
const Z1 = mode1 ** 3 * (1 - mode1) * Math.sqrt((2 * Math.PI) / A1);
// Laplace mass above 1: the normal tail beyond (1 − 3/4)/sd, by Simpson's rule on the density.
const simpson = (f: (x: number) => number, a: number, b: number, n = 4000) => {
  const h = (b - a) / n;
  let s = f(a) + f(b);
  for (let i = 1; i < n; i++) s += (i % 2 ? 4 : 2) * f(a + i * h);
  return (s * h) / 3;
};
const above = simpson((p) => gaussian(p, mode1, sd1), 1, 3);
const logp2 = (th: number) => -((2 - th * th) ** 2) / (2 * 0.25) - (th * th) / 8;
const Z2 = simpson((th) => Math.exp(logp2(th)), -6, 6);
const pdf2 = (th: number) => Math.exp(logp2(th)) / Z2;
const mode2 = Math.sqrt(2 - 1 / 32), H2 = 8 * (2 - mode2 ** 2) - 16 * mode2 ** 2 - 0.25, sd2 = 1 / Math.sqrt(-H2);
const sdExact2 = Math.sqrt(simpson((th) => th * th * pdf2(th), -6, 6));
const massPos = simpson(pdf2, 0, 6);
const chk = [A1.toFixed(3), sd1.toFixed(4), (Z1 / 0.05).toFixed(3), above.toFixed(4), mode2.toFixed(4), H2.toFixed(2), sd2.toFixed(4), sdExact2.toFixed(3), massPos.toFixed(3)].join(' ');
if (chk !== '21.333 0.2165 1.145 0.1241 1.4031 -31.50 0.1782 1.377 0.500') throw new Error(`LaplaceMisses: the examples drifted (${chk})`);
// The first derivative of the log-posterior vanishes at the second mode.
if (Math.abs((logp2(mode2 + 1e-6) - logp2(mode2 - 1e-6)) / 2e-6) > 1e-4) throw new Error('LaplaceMisses: not a mode');

const t = ru
  ? { titles: ['асимметричное: Beta(4, 2)', 'двухмодальное: знак θ не определён'], exact: 'точное апостериорное', lap: 'приближение Лапласа', title: 'Чего не видит приближение Лапласа', desc: 'Слева: асимметричная плотность Beta(4, 2) на отрезке от 0 до 1 и симметричная гауссиана с центром в 0.75, у которой 12% массы правее 1. Справа: апостериорное распределение с двумя одинаковыми пиками в ±1.40 и гауссиана Лапласа, накрывающая только правый пик.' }
  : { titles: ['skewed: Beta(4, 2)', 'bimodal: the sign of θ is unknown'], exact: 'exact posterior', lap: 'Laplace approximation', title: 'What the Laplace approximation misses', desc: 'Left: the skewed density Beta(4, 2) on 0 to 1 and a symmetric Gaussian centred at 0.75 with 12% of its mass beyond 1. Right: a posterior with two equal peaks at ±1.40 and the Laplace Gaussian, which covers only the right peak.' };
const id = 'laplace-misses';
const panels = [
  { dom: { x: [0, 1.2] as [number, number], y: [0, 2.4] as [number, number] }, ticks: [0, 0.5, 1], exact: betaPdf, lap: (x: number) => gaussian(x, mode1, sd1), cut: 1 },
  { dom: { x: [-2.5, 2.5] as [number, number], y: [0, 2.4] as [number, number] }, ticks: [-2, -1, 0, 1, 2], exact: pdf2, lap: (x: number) => gaussian(x, mode2, sd2), cut: null },
];
const layouts = [
  { cls: 'fig-wide', W: 760, H: 300, boxes: [[44, 360, 40, 236], [424, 740, 40, 236]], leg: { x: 240, y: 286 }, legStep: 200 },
  { cls: 'fig-narrow', W: 360, H: 560, boxes: [[36, 350, 40, 236], [36, 350, 296, 492]], leg: { x: 20, y: 536 }, legStep: 168 },
];
const fmtN = (v: number) => String(v).replace('-', '−');
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? `Слева: Beta(4, 2), монета после трёх орлов и одной решки при равномерном априорном распределении, и её приближение Лапласа N(0.75, 0.2165²), у которого ${(100 * above).toFixed(1)}% массы правее 1 (заштриховано). Справа: наблюдается только θ² (t = 2, σ шума 0.5, априорное распределение N(0, 2²)); гауссиана Лапласа у правой моды со стандартным отклонением ${sd2.toFixed(3)} накрывает один из двух пиков.`
    : `Left: Beta(4, 2), a coin after three heads and one tail under a uniform prior, and its Laplace approximation N(0.75, 0.2165²), with ${(100 * above).toFixed(1)}% of its mass above 1 (shaded). Right: only θ² is observed (t = 2, noise 0.5, prior N(0, 2²)); the Laplace Gaussian at the right mode, standard deviation ${sd2.toFixed(3)}, covers one of two peaks.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{t.title}</title>
      <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
      {panels.map((P, k) => {
        const [x0, x1, y0, y1] = L.boxes[k];
        const sx = scale(P.dom.x, [x0, x1]), sy = scale(P.dom.y, [y1, y0]);
        const clip = `${id}-${L.W}-clip-${k}`;
        return (
          <g>
            <defs><clipPath id={clip}><rect x={x0} y={y0} width={x1 - x0} height={y1 - y0} /></clipPath></defs>
            <text class="f-small" x={x0} y={y0 - 12}>{t.titles[k]}</text>
            <path class="f-axis" d={`M ${x0} ${y1} H ${x1}`} />
            {[1, 2].map((v) => <g><path class="f-grid" d={`M ${x0} ${sy(v)} H ${x1}`} /><text class="f-note" x={x0 - 6} y={sy(v) + 4} text-anchor="end">{String(v)}</text></g>)}
            {P.ticks.map((v) => <text class="f-note" x={sx(v)} y={y1 + 18} text-anchor="middle">{fmtN(v)}</text>)}
            <g clip-path={`url(#${clip})`}>
              {P.cut !== null && <path class="f-fill-blue" d={`${plot(P.lap, P.cut, P.dom.x[1], sx, sy, 60)} L ${sx(P.dom.x[1])} ${sy(0)} L ${sx(P.cut)} ${sy(0)} Z`} />}
              {P.cut !== null && <path class="f-thin f-dash f-muted" d={`M ${sx(P.cut)} ${y0} V ${y1}`} />}
              <path class="f-line f-blue" d={plot(P.lap, P.dom.x[0], P.dom.x[1], sx, sy, 300)} />
              <path class="f-line f-bold" d={plot(P.exact, P.dom.x[0], P.dom.x[1], sx, sy, 300)} />
            </g>
          </g>
        );
      })}
      {[{ c: 'f-line f-bold', s: t.exact }, { c: 'f-line f-blue', s: t.lap }].map((e, i) => (
        <g>
          <path class={e.c} d={`M ${L.leg.x + i * L.legStep} ${L.leg.y - 4} h 22`} />
          <text class="f-small" x={L.leg.x + i * L.legStep + 30} y={L.leg.y}>{e.s}</text>
        </g>
      ))}
    </svg>
  ))}
</Figure>
