---
import Figure from '../Figure.astro';
import { polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The polar map (r, θ) ↦ (r cos θ, r sin θ) on the quarter r ∈ [0, 2], θ ∈ [0°, 90°]. One cell, r ∈ [1.375, 1.625] and
// θ ∈ [20°, 40°], has area Δr Δθ = 0.25 · 0.349 = 0.0873 on the left and r Δr Δθ = 1.5 · 0.0873 = 0.1309 on the right.
type V = [number, number];
const R0 = 1.375, R1 = 1.625, T0 = (20 * Math.PI) / 180, T1 = (40 * Math.PI) / 180;
const rect = (R1 - R0) * (T1 - T0), sector = 0.5 * (R1 * R1 - R0 * R0) * (T1 - T0);
const arc = (r: number, a: number, b: number, n = 40): V[] => Array.from({ length: n + 1 }, (_, i) => { const t = a + ((b - a) * i) / n; return [r * Math.cos(t), r * Math.sin(t)]; });
const cell: V[] = arc(R1, T0, T1).concat(arc(R0, T1, T0));
const shoelace = Math.abs(cell.reduce((acc, p, i) => { const q = cell[(i + 1) % cell.length]; return acc + p[0] * q[1] - q[0] * p[1]; }, 0)) / 2;
if (rect.toFixed(4) !== '0.0873' || sector.toFixed(4) !== '0.1309' || Math.abs(sector - 1.5 * rect) > 1e-12) throw new Error('PolarChange: cell areas drifted from the note');
if (Math.abs(shoelace - sector) > 2e-4) throw new Error('PolarChange: the drawn cell does not have the stated area');
const rs = Array.from({ length: 9 }, (_, i) => 0.25 * i);
const ths = Array.from({ length: 10 }, (_, i) => (i * 10 * Math.PI) / 180);
const id = 'polar-change';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 326, unit: 110, lx: 60, rx: 450, base: 250, ax: [300, 420], short: false },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 215, unit: 68, lx: 26, rx: 204, base: 160, ax: [168, 198], short: true },
];
const t = ru
  ? { la: 'площадь Δr·Δθ = 0.0873', ra: 'площадь r·Δr·Δθ = 0.1309', rb: '= 1.5 · 0.0873', map1: 'x = r cos θ', map2: 'y = r sin θ', las: 'Δr·Δθ = 0.0873', ras: 'r·Δr·Δθ = 0.1309' }
  : { la: 'area Δr·Δθ = 0.0873', ra: 'area r·Δr·Δθ = 0.1309', rb: '= 1.5 · 0.0873', map1: 'x = r cos θ', map2: 'y = r sin θ', las: 'Δr·Δθ = 0.0873', ras: 'r·Δr·Δθ = 0.1309' };
---

<Figure
  id={id}
  title={ru ? 'Полярная замена переменных' : 'The polar change of variables'}
  caption={ru
    ? 'Слева прямоугольник 0 ≤ r ≤ 2, 0° ≤ θ ≤ 90° в координатах (r, θ) с шагами сетки Δr = 0.25 и Δθ = 10°; справа его образ при отображении (r cos θ, r sin θ) — четверть круга. Выделенная клетка с центром в r = 1.5 имеет площадь 0.0873 слева и 1.5 · 0.0873 = 0.1309 справа. Чем дальше клетка, тем сильнее она растягивается.'
    : 'Left, the rectangle 0 ≤ r ≤ 2, 0° ≤ θ ≤ 90° in (r, θ), with grid steps Δr = 0.25 and Δθ = 10°; right, its image under (r cos θ, r sin θ), a quarter disc. The highlighted cell, centred at r = 1.5, has area 0.0873 on the left and 1.5 · 0.0873 = 0.1309 on the right. Cells farther out stretch more.'}
>
  {layouts.map((L) => {
    const lp = (r: number, th: number): V => [L.lx + L.unit * r, L.base - L.unit * th];
    const rp = ([x, y]: V): V => [L.rx + L.unit * x, L.base - L.unit * y];
    const cellL: V[] = [lp(R0, T0), lp(R1, T0), lp(R1, T1), lp(R0, T1), lp(R0, T0)];
    const ty = L.base + (L.short ? 40 : 46);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Прямоугольная сетка в координатах (r, θ) и её образ — полярная сетка' : 'A rectangular grid in (r, θ) and its image, a polar grid'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Слева прямоугольная сетка с одной закрашенной клеткой; справа четверть круга с дугами и лучами, та же клетка стала изогнутым сектором большей площади.' : 'Left, a rectangular grid with one shaded cell; right, a quarter disc of arcs and rays, where the same cell has become a curved sector of larger area.'}</desc>
        {rs.map((r) => <path class="f-grid" d={polyline([lp(r, 0), lp(r, Math.PI / 2)])} />)}
        {ths.map((th) => <path class="f-grid" d={polyline([lp(0, th), lp(2, th)])} />)}
        <path class="f-grid" d={polyline([lp(0, Math.PI / 2), lp(2, Math.PI / 2)])} />
        <path class="f-fill-amber" d={polyline(cellL) + ' Z'} style="stroke: var(--fig-amber); stroke-width: 1.6" />
        <path class="f-axis" d={polyline([lp(0, Math.PI / 2), lp(0, 0), lp(2, 0)])} />
        {rs.slice(1).map((r) => <path class="f-grid" d={polyline(arc(r, 0, Math.PI / 2).map(rp))} />)}
        {ths.map((th) => <path class="f-grid" d={polyline([rp([0, 0]), rp([2 * Math.cos(th), 2 * Math.sin(th)])])} />)}
        <path class="f-fill-amber" d={polyline(cell.map(rp)) + ' Z'} style="stroke: var(--fig-amber); stroke-width: 1.6" />
        <path class="f-axis" d={polyline([rp([0, 2]), rp([0, 0]), rp([2, 0])])} />
        <path class="f-line" d={`M ${L.ax[0]} ${L.base - L.unit * 0.8} L ${L.ax[1]} ${L.base - L.unit * 0.8}`} marker-end="url(#f-arrow)" />
        {!L.short && <text class="f-small" x={(L.ax[0] + L.ax[1]) / 2} y={L.base - L.unit * 0.8 - 26} text-anchor="middle">{t.map1}</text>}
        {!L.short && <text class="f-small" x={(L.ax[0] + L.ax[1]) / 2} y={L.base - L.unit * 0.8 - 10} text-anchor="middle">{t.map2}</text>}
        <text class="f-small f-t-muted" x={lp(0, 0)[0]} y={L.base + 16} text-anchor="middle">0</text>
        <text class="f-small f-t-muted" x={lp(1, 0)[0]} y={L.base + 16} text-anchor="middle">1</text>
        <text class="f-small f-t-muted" x={lp(2, 0)[0]} y={L.base + 16} text-anchor="middle">2</text>
        <text class="f-label f-math" x={lp(2, 0)[0] + 8} y={L.base + 5}>r</text>
        <text class="f-label f-math" x={lp(0, Math.PI / 2)[0] + 4} y={lp(0, Math.PI / 2)[1] - 8} text-anchor="middle">θ</text>
        {!L.short && <text class="f-small f-t-muted" x={L.lx - 6} y={lp(0, Math.PI / 2)[1] + 4} text-anchor="end">90°</text>}
        <text class="f-small f-t-muted" x={rp([1, 0])[0]} y={L.base + 16} text-anchor="middle">1</text>
        <text class="f-small f-t-muted" x={rp([2, 0])[0]} y={L.base + 16} text-anchor="middle">2</text>
        <text class="f-label f-math" x={rp([2, 0])[0] + 8} y={L.base + 5}>x</text>
        <text class="f-label f-math" x={rp([0, 2])[0] - 6} y={rp([0, 2])[1] - 8} text-anchor="middle">y</text>
        <text class="f-small f-t-amber" x={L.lx + L.unit} y={ty} text-anchor="middle">{L.short ? t.las : t.la}</text>
        <text class="f-small f-t-amber" x={L.rx + L.unit} y={ty} text-anchor="middle">{L.short ? t.ras : t.ra}</text>
        {!L.short && <text class="f-small f-t-muted" x={L.rx + L.unit} y={ty + 20} text-anchor="middle">{t.rb}</text>}
      </svg>
    );
  })}
</Figure>
