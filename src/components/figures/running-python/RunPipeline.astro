---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar, type Tone } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// What `python area.py` does with the three-line file of the note, in CPython 3.14.7.
// The bytecode of line 3 is the output of dis for that file (LOAD_SMALL_INT and PUSH_NULL are 3.14 instructions).
const source = ['width = 3', 'height = 4', 'print(width * height)'];
const line3 = ['LOAD_NAME print', 'PUSH_NULL', 'LOAD_NAME width', 'LOAD_NAME height', 'BINARY_OP *', 'CALL 1'];
if (3 * 4 !== 12) throw new Error('width * height');
if (line3.length !== 6) throw new Error('six instructions for line 3');

interface Row { tone: Tone; title: string; cols: string[][]; note: [string, string] }
const rows: Row[] = ru
  ? [
      { tone: 'x', title: 'area.py: исходный код', cols: [source], note: ['обычный текстовый файл;', 'пока ничего не выполнено'] },
      { tone: 'g', title: 'компилятор', cols: [['текст → токены →', 'дерево → байт-код']], note: ['сначала проверяет весь файл;', 'SyntaxError останавливает всё здесь'] },
      { tone: 'h', title: 'объект кода: байт-код строки 3', cols: [line3.slice(0, 3), line3.slice(3)], note: ['для импортируемого модуля сохраняется', 'в __pycache__/area.cpython-314.pyc'] },
      { tone: 'h', title: 'цикл интерпретатора (код на C)', cols: [['взять команду, выполнить её,', 'перейти к следующей']], note: ['BINARY_OP * умножает 3 на 4,', 'CALL 1 вызывает print'] },
      { tone: 'y', title: 'вывод', cols: [['12']], note: ['print пишет 12 в терминал;', 'файл закончился, программа завершается'] },
    ]
  : [
      { tone: 'x', title: 'area.py: the source', cols: [source], note: ['a plain text file;', 'nothing has run yet'] },
      { tone: 'g', title: 'the compiler', cols: [['text → tokens →', 'syntax tree → bytecode']], note: ['checks the whole file first;', 'a SyntaxError stops everything here'] },
      { tone: 'h', title: 'a code object: bytecode of line 3', cols: [line3.slice(0, 3), line3.slice(3)], note: ['for an imported module, it is saved', 'as __pycache__/area.cpython-314.pyc'] },
      { tone: 'h', title: 'the interpreter loop (C code)', cols: [['fetch an instruction, run it,', 'go on to the next one']], note: ['BINARY_OP * multiplies 3 by 4,', 'CALL 1 calls print'] },
      { tone: 'y', title: 'output', cols: [['12']], note: ['print writes 12 to the terminal;', 'the file ends, so the program ends'] },
    ];
const steps = ru
  ? ['исходный код — это текстовый файл', 'компилятор проверяет и переводит весь файл', 'результат — объект кода с байт-кодом', 'цикл интерпретатора выполняет команды по одной', 'print выводит 12, и программа завершается']
  : ['the source is a text file', 'the compiler checks and translates the whole file', 'the result is a code object holding bytecode', 'the interpreter loop runs the instructions one by one', 'print writes 12, and the program ends'];

interface Layout { cls: string; W: number; bx: number; bw: number; head: number; lh: number; gap: number; colW: number; noteX: number | null; mono: number; sans: number; badgeX: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, bx: 40, bw: 350, head: 20, lh: 18, gap: 22, colW: 160, noteX: 408, mono: 7.5, sans: 6.5, badgeX: 20 },
  { cls: 'fig-narrow seq-narrow', W: 360, bx: 34, bw: 318, head: 22, lh: 20, gap: 22, colW: 150, noteX: null, mono: 8.4, sans: 7.3, badgeX: 17 },
];
// Row geometry, and build-time checks that every label fits inside its box or inside the viewBox.
const geom = layouts.map((L) => {
  let y = 10;
  const ys = rows.map((r) => {
    const h = L.head + 12 + Math.max(...r.cols.map((c) => c.length)) * L.lh;
    const top = y;
    y += h + L.gap;
    return { top, h };
  });
  for (const r of rows) {
    if (10 + r.title.length * L.sans > L.bw - 8) throw new Error(`title "${r.title}" overflows at ${L.W}`);
    r.cols.forEach((c, i) => {
      const avail = r.cols.length > 1 ? L.colW - 6 : L.bw - 20;
      for (const s of c) if (s.length * L.mono > avail) throw new Error(`"${s}" overflows column ${i} at ${L.W}`);
    });
    if (L.noteX !== null) for (const s of r.note) if (L.noteX + s.length * L.sans > L.W - 4) throw new Error(`note "${s}" overflows`);
  }
  return { ys, H: y - L.gap + 10 };
});
const id = 'run-pipeline';
---

<Figure
  id={id}
  title={ru ? 'Что происходит при запуске python area.py' : 'What happens when you run python area.py'}
  caption={ru
    ? 'Путь трёхстрочного файла area.py в CPython 3.14.7. Файл — обычный текст (1). Компилятор читает его целиком и переводит в байт-код (2); синтаксическая ошибка в любой строке обнаруживается здесь, до выполнения первой строки. Байт-код хранится в объекте кода (3); показаны первые шесть из девяти команд, которые dis перечисляет для третьей строки. Цикл интерпретатора, написанный на C, выполняет команды одну за другой (4), и print выводит 12 (5). Зелёным отмечен вход, жёлтым — преобразование, синим — то, что выполняется, красным — результат.'
    : 'The path of the three-line file area.py in CPython 3.14.7. The file is plain text (1). The compiler reads all of it and translates it into bytecode (2); a syntax error on any line is found here, before the first line runs. The bytecode is held in a code object (3); the first six of the nine instructions that dis lists for line 3 are shown. The interpreter loop, written in C, runs the instructions one after another (4), and print writes 12 (5). Green marks the input, amber the translation, blue what runs, red the result.'}
>
  {layouts.map((L, li) => {
    const { ys, H } = geom[li];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Пять стадий запуска файла на Python' : 'Five stages of running a Python file'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Пять блоков сверху вниз, соединённых стрелками: исходный текст area.py, компилятор, объект кода с байт-кодом третьей строки, цикл интерпретатора и вывод 12.'
          : 'Five boxes from top to bottom joined by arrows: the source text of area.py, the compiler, a code object with the bytecode of line 3, the interpreter loop, and the output 12.'}</desc>
        {rows.map((r, k) => {
          const { top, h } = ys[k];
          return (
            <g data-s={String(k + 1)}>
              <rect x={L.bx} y={top} width={L.bw} height={h} rx="7" style={`fill: ${toneVar[r.tone]}; fill-opacity: 0.12; stroke: ${toneVar[r.tone]}; stroke-width: 1.3`} />
              <text class="f-small" x={L.bx + 10} y={top + L.head - 2} style="font-weight: 650">{r.title}</text>
              {r.cols.map((c, ci) => c.map((s, si) => (
                <text class="f-small" x={L.bx + 10 + ci * L.colW} y={top + L.head + 4 + (si + 1) * L.lh - 4} style="font-family: var(--mono)">{s}</text>
              )))}
              {L.noteX !== null && r.note.map((s, i) => (
                <text class="f-small f-t-muted" x={L.noteX!} y={top + 20 + i * 19}>{s}</text>
              ))}
              {k < rows.length - 1 && <path class="f-line f-muted" d={`M ${L.bx + L.bw / 2} ${top + h + 2} V ${ys[k + 1].top - 3}`} marker-end="url(#f-arrow-muted)" />}
              <Badge x={L.badgeX} y={top + Math.min(h / 2, 22)} n={k + 1} />
            </g>
          );
        })}
      </svg>
    );
  })}
  <Stepper steps={steps} />
</Figure>
