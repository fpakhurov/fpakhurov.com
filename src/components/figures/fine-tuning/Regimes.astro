---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Three fine-tuning regimes on SST-2 with GPT-2 small: what is trained in each phase, at what rate.
type Phase = { head: boolean; body: boolean; lr: string };
const rows: { name: string; phases: Phase[]; acc: number }[] = [
  { name: ru ? 'полное дообучение' : 'full fine-tuning', acc: 0.890, phases: [{ head: true, body: true, lr: 'η = 2·10⁻⁶' }] },
  { name: ru ? 'линейное зондирование' : 'linear probing', acc: 0.737, phases: [{ head: true, body: false, lr: 'η = 10⁻⁴' }] },
  { name: 'LP-FT', acc: 0.900, phases: [{ head: true, body: false, lr: 'η = 10⁻⁴' }, { head: true, body: true, lr: 'η = 2·10⁻⁶' }] },
];
const t = ru
  ? { head: 'выходной слой φ, 1536', body: 'тело θ, 124 млн', headN: 'слой φ', bodyN: 'тело θ', legendT: 'обучается', legendF: 'заморожено', acc: 'доля верных' }
  : { head: 'head φ, 1,536', body: 'body θ, 124 M', headN: 'head φ', bodyN: 'body θ', legendT: 'trained', legendF: 'frozen', acc: 'accuracy' };
const id = 'fine-tuning-regimes';
interface Layout { cls: string; W: number; H: number; narrow: boolean; px: number[]; pw: number; rowH: number; top: number; accX: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 700, H: 296, narrow: false, px: [200, 400], pw: 170, rowH: 78, top: 30, accX: 600 },
  { cls: 'fig-narrow', W: 360, H: 380, narrow: true, px: [8, 196], pw: 156, rowH: 108, top: 30, accX: 352 },
];
---

<Figure
  id={id}
  title={ru ? 'Три режима дообучения: что и когда обучается' : 'Three fine-tuning regimes: what is trained, and when'}
  caption={ru
    ? 'GPT-2 small на SST-2, по 1000 шагов на фазу. Полное дообучение с первого шага обучает и тело модели, и случайно инициализированный выходной слой с маленьким шагом. Линейное зондирование замораживает тело и обучает только выходной слой (1536 весов) с шагом побольше. LP-FT сначала делает линейное зондирование, а затем дообучает всё, начиная с уже обученного выходного слоя, поэтому первые шаги не портят предобученные признаки градиентом от случайного слоя. Справа — доля правильных ответов на валидации SST-2 (872 фразы, одна фраза — 0.11 пункта).'
    : 'GPT-2 small on SST-2, 1,000 steps per phase. Full fine-tuning trains the body and a randomly initialized head from the first step at a small learning rate. Linear probing freezes the body and trains only the head (1,536 weights) at a larger rate. LP-FT probes first and then fine-tunes everything starting from the trained head, so the first steps do not distort the pretrained features with gradients from a random layer. On the right, accuracy on the SST-2 validation set (872 phrases; one phrase is 0.11 points).'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Режимы дообучения' : 'Fine-tuning regimes'}</title>
      <desc id={`${id}-${L.W}-d`}>{rows.map((r) => `${r.name}: ${r.phases.map((p) => `${p.body ? (ru ? 'тело и слой обучаются' : 'body and head trained') : (ru ? 'обучается только слой' : 'only the head trained')}, ${p.lr}`).join(' → ')}; ${r.acc.toFixed(3)}`).join('. ')}.</desc>
      {rows.map((r, ri) => {
        const y = L.top + ri * L.rowH;
        const by = L.narrow ? y + 14 : y;
        return (
          <g>
            <text class="f-label" x={L.narrow ? 8 : 10} y={L.narrow ? y + 4 : y + 30}>{r.name}</text>
            <text class="f-label" x={L.accX} y={L.narrow ? y + 4 : y + 30} text-anchor={L.narrow ? 'end' : 'start'} style="font-weight: 650">{r.acc.toFixed(3)}</text>
            {r.phases.map((p, pi) => {
              const x = L.px[pi];
              return (
                <g>
                  <rect class={p.head ? 'f-box f-fill-amber' : 'f-box-soft'} x={x} y={by} width={L.pw} height="18" rx="4" />
                  <text class="f-small" x={x + L.pw / 2} y={by + 13} text-anchor="middle">{L.narrow ? t.headN : t.head}</text>
                  <rect class={p.body ? 'f-box f-fill-blue' : 'f-box-soft'} x={x} y={by + 22} width={L.pw} height="30" rx="4" />
                  <text class={`f-small${p.body ? '' : ' f-t-muted'}`} x={x + L.pw / 2} y={by + 42} text-anchor="middle">{L.narrow ? t.bodyN : t.body}</text>
                  <text class="f-small f-t-muted" x={x + L.pw / 2} y={by + 68} text-anchor="middle">{p.lr}</text>
                  {pi === 1 && <path class="f-line f-muted" d={`M ${L.px[0] + L.pw + 4} ${by + 26} H ${x - 4}`} marker-end="url(#f-arrow-muted)" />}
                </g>
              );
            })}
          </g>
        );
      })}
      {[[true, t.legendT], [false, t.legendF]].map(([on, label], i) => {
        const lx = (L.narrow ? 8 : 200) + i * 140, ly = L.H - 12;
        return (
          <g>
            {on && <rect class="f-box f-fill-amber" x={lx} y={ly - 10} width="14" height="12" rx="2" />}
            <rect class={on ? 'f-box f-fill-blue' : 'f-box-soft'} x={on ? lx + 18 : lx} y={ly - 10} width="14" height="12" rx="2" />
            <text class="f-small" x={lx + (on ? 38 : 20)} y={ly}>{label}</text>
          </g>
        );
      })}
      {!L.narrow && <text class="f-small f-t-muted" x={L.accX} y={L.top - 12}>{t.acc}</text>}
    </svg>
  ))}
</Figure>
