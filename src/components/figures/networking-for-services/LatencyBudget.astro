---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Latency budget of one request, from the click to the last byte of a small response, in four cases.
// A toy setup: the resolver answers from its cache in 5 ms, the round trip between client and proxy is 40 ms,
// the proxy adds 1 ms (its own work and a pooled connection to a backend in the same data centre), and the
// backend takes 60 ms. Every round trip before the request is a handshake.
const dns = 5, rtt = 40, proxy = 1, backend = 60;
type Kind = 'dns' | 'hs' | 'req' | 'srv';
interface Seg { kind: Kind; ms: number; en: string; ru: string }
const S = {
  dns: { kind: 'dns', ms: dns, en: '', ru: '' },
  tcp: { kind: 'hs', ms: rtt, en: 'TCP', ru: 'TCP' },
  tls: { kind: 'hs', ms: rtt, en: 'TLS', ru: 'TLS' },
  quic: { kind: 'hs', ms: rtt, en: 'QUIC+TLS', ru: 'QUIC+TLS' },
  req: { kind: 'req', ms: rtt, en: 'request', ru: 'запрос' },
  srv: { kind: 'srv', ms: proxy + backend, en: 'proxy + backend', ru: 'прокси + бэкенд' },
} satisfies Record<string, Seg>;
const rows = [
  { en: 'new connection, HTTP/2', ru: 'новое соединение, HTTP/2', segs: [S.dns, S.tcp, S.tls, S.req, S.srv], total: 186 },
  { en: 'new connection, HTTP/3', ru: 'новое соединение, HTTP/3', segs: [S.dns, S.quic, S.req, S.srv], total: 146 },
  { en: 'resumed session, 0-RTT', ru: 'возобновление, 0-RTT', segs: [S.dns, S.req, S.srv], total: 106 },
  { en: 'connection already open', ru: 'соединение уже открыто', segs: [S.req, S.srv], total: 101 },
];
for (const r of rows) {
  const sum = r.segs.reduce((a, s) => a + s.ms, 0);
  if (sum !== r.total) throw new Error(`${r.en}: ${sum} ms, text says ${r.total}`);
}
const fill: Record<Kind, string> = { dns: 'var(--muted)', hs: 'var(--fig-amber)', req: 'var(--fig-blue)', srv: 'var(--fig-green)' };
const legend: [Kind, string][] = ru
  ? [['dns', 'DNS'], ['hs', 'рукопожатия'], ['req', 'запрос и ответ'], ['srv', 'прокси и бэкенд']]
  : [['dns', 'DNS'], ['hs', 'handshakes'], ['req', 'request and response'], ['srv', 'proxy and backend']];
const axis = ru ? 'время от щелчка, мс' : 'time from the click, ms';
const ticks = [0, 50, 100, 150, 200];

interface Layout { cls: string; W: number; H: number; x0: number; x1: number; y0: number; pitch: number; labelAbove: boolean; inner: boolean; legendStep: number; legendRows: number; legendX: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 286, x0: 236, x1: 736, y0: 56, pitch: 46, labelAbove: false, inner: true, legendStep: 180, legendRows: 1, legendX: 16 },
  { cls: 'fig-narrow', W: 360, H: 374, x0: 16, x1: 320, y0: 92, pitch: 60, labelAbove: true, inner: false, legendStep: 170, legendRows: 2, legendX: 16 },
];
const px = (L: Layout) => (L.x1 - L.x0) / 200;
// Label checks: about 6.5 px per f-small character.
const lw = (s: string) => s.length * 6.5;
for (const L of layouts) {
  for (const r of rows) {
    const name = ru ? r.ru : r.en;
    if (!L.labelAbove && lw(name) > L.x0 - 22) throw new Error(`row label too long: ${name}`);
    if (L.labelAbove && lw(name) > L.W - 2 * L.x0) throw new Error(`narrow row label too long: ${name}`);
    for (const s of r.segs) {
      const text = L.inner ? `${ru ? s.ru : s.en} ${s.ms}`.trim() : String(s.ms);
      if (s.kind !== 'dns' && lw(text) + 6 > s.ms * px(L)) throw new Error(`segment label does not fit: ${text}`);
    }
    if (L.x0 + r.total * px(L) + 8 + lw(`${r.total} ms`) > L.W) throw new Error('total label outside');
  }
  for (const [, l] of legend) if (lw(l) + 22 > L.legendStep) throw new Error(`legend: ${l}`);
  const perRow = Math.ceil(legend.length / L.legendRows);
  if (L.legendX + (perRow - 1) * L.legendStep + 20 + Math.max(...legend.map(([, l]) => lw(l))) > L.W) throw new Error('legend outside');
}
const id = 'latency-budget';
---

<Figure
  id={id}
  title={ru ? 'Бюджет задержки одного запроса в четырёх случаях' : 'The latency budget of one request, in four cases'}
  caption={ru
    ? 'Игрушечная постановка: резолвер отвечает из кэша за 5 мс, круговое обращение между клиентом и прокси занимает 40 мс, прокси добавляет 1 мс, бэкенд работает 60 мс. Новое соединение HTTP/2 платит три круговых обращения до первого байта ответа (TCP, TLS, сам запрос): 186 мс. QUIC совмещает транспортное и криптографическое рукопожатие: 146 мс. Возобновлённая сессия с 0-RTT отправляет запрос в первом же пакете: 106 мс. Уже открытое соединение не платит ни DNS, ни рукопожатий: 101 мс. Сервер везде занимает одни и те же 61 мс; меняется только число круговых обращений.'
    : 'A toy setup: the resolver answers from its cache in 5 ms, the round trip between client and proxy is 40 ms, the proxy adds 1 ms and the backend takes 60 ms. A new HTTP/2 connection pays three round trips before the first byte of the response (TCP, TLS, the request itself): 186 ms. QUIC merges the transport and the cryptographic handshake: 146 ms. A resumed session with 0-RTT sends the request in its first packet: 106 ms. A connection that is already open pays neither DNS nor handshakes: 101 ms. The server takes the same 61 ms in every case; only the number of round trips changes.'}
>
  {layouts.map((L) => {
    const sx = scale([0, 200], [L.x0, L.x1]);
    const yAxis = L.y0 + rows.length * L.pitch - 10;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Составные полосы времени для четырёх случаев' : 'Stacked time bars for four cases'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Четыре горизонтальные полосы, ось времени от 0 до 200 мс. Новое соединение HTTP/2: DNS 5, TCP 40, TLS 40, запрос 40, прокси и бэкенд 61, всего 186 мс. Новое соединение HTTP/3: DNS 5, QUIC и TLS 40, запрос 40, прокси и бэкенд 61, всего 146. Возобновление с 0-RTT: DNS 5, запрос 40, прокси и бэкенд 61, всего 106. Открытое соединение: запрос 40, прокси и бэкенд 61, всего 101.'
          : 'Four horizontal bars on a time axis from 0 to 200 ms. New HTTP/2 connection: DNS 5, TCP 40, TLS 40, request 40, proxy and backend 61, total 186 ms. New HTTP/3 connection: DNS 5, QUIC and TLS 40, request 40, proxy and backend 61, total 146. Resumed session with 0-RTT: DNS 5, request 40, proxy and backend 61, total 106. Connection already open: request 40, proxy and backend 61, total 101.'}</desc>
        {legend.map(([k, label], i) => {
          const perRow = Math.ceil(legend.length / L.legendRows);
          const lx = L.legendX + (i % perRow) * L.legendStep, ly = 22 + Math.floor(i / perRow) * 22;
          return (
            <g>
              <rect x={lx} y={ly - 10} width="14" height="12" style={`fill: ${fill[k]}; fill-opacity: 0.4; stroke: ${fill[k]}; stroke-width: 1.2`} />
              <text class="f-small f-t-muted" x={lx + 20} y={ly}>{label}</text>
            </g>
          );
        })}
        {ticks.map((v) => (
          <g>
            <path class="f-grid" d={`M ${sx(v)} ${L.y0 - 14} V ${yAxis}`} />
            <text class="f-note" x={sx(v)} y={yAxis + 18} text-anchor="middle">{v}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${L.x0} ${yAxis} H ${L.x1}`} />
        <text class="f-note" x={(L.x0 + L.x1) / 2} y={yAxis + 40} text-anchor="middle">{axis}</text>
        {rows.map((r, i) => {
          const y = L.y0 + i * L.pitch;
          let acc = 0;
          return (
            <g>
              {L.labelAbove
                ? <text class="f-small" x={L.x0} y={y - 6}>{ru ? r.ru : r.en}</text>
                : <text class="f-small" x={L.x0 - 12} y={y + 17} text-anchor="end">{ru ? r.ru : r.en}</text>}
              {r.segs.map((s) => {
                const xa = sx(acc);
                acc += s.ms;
                const w = sx(acc) - xa;
                const text = L.inner ? `${ru ? s.ru : s.en} ${s.ms}`.trim() : String(s.ms);
                return (
                  <g>
                    <rect x={xa} y={y} width={w} height="26" style={`fill: ${fill[s.kind]}; fill-opacity: 0.4; stroke: ${fill[s.kind]}; stroke-width: 1.2`} />
                    {s.kind !== 'dns' && <text class="f-small" x={xa + w / 2} y={y + 17.5} text-anchor="middle">{text}</text>}
                  </g>
                );
              })}
              <text class="f-small" x={sx(r.total) + 8} y={y + 17.5} style="font-weight: 650">{ru ? `${r.total} мс` : `${r.total} ms`}</text>
            </g>
          );
        })}
      </svg>
    );
  })}
</Figure>
