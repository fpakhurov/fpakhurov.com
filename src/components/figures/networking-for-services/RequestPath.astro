---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One HTTPS request from a browser to a backend: a DNS answer from the resolver cache, the TCP and TLS handshakes
// with the reverse proxy, the HTTP request, the health checks that took web2 out of rotation, and the forwarded
// request on a pooled connection to web3. Addresses are from documentation and private ranges.
const t = ru
  ? {
      title: 'Путь одного HTTPS-запроса: DNS, TCP, TLS, прокси, бэкенд',
      client: 'клиент', clientSub: 'браузер',
      resolver: 'DNS-резолвер', resolverSub: 'ответ из кэша', resolverSubN: 'кэш',
      proxy: 'обратный прокси', proxySub: 'здесь завершается TLS',
      q: 'A? www.example.com', a: '203.0.113.10, TTL 300',
      tcp: 'TCP: 1 круговое обращение', tls: 'TLS 1.3: SNI, ALPN, серт.', req: 'GET / HTTP/2', resp: '200 OK',
      hc: 'GET /healthz', down: 'сбой: выведен из ротации', pool: 'готовое соединение',
      steps: [
        'клиент спрашивает резолвер об имени; ответ берётся из кэша, вместе с оставшимся TTL',
        'TCP-рукопожатие с адресом прокси: одно круговое обращение',
        'рукопожатие TLS 1.3: имя сервера (SNI), протокол (ALPN), сертификат, ключи; ещё одно круговое обращение',
        'запрос HTTP/2 приходит на прокси, который читает Host и путь',
        'прокси сам опрашивает /healthz каждого бэкенда; web2 не отвечает и выведен из ротации',
        'прокси передаёт запрос на web3 по уже открытому соединению, и ответ идёт обратно тем же путём',
      ],
      desc: 'Слева клиент, над ним DNS-резолвер, в центре обратный прокси, справа три бэкенда web1, web2, web3. Клиент спрашивает резолвер адрес www.example.com и получает 203.0.113.10 с TTL 300. Затем три стрелки к прокси: TCP-рукопожатие, рукопожатие TLS 1.3 и запрос GET по HTTP/2, и стрелка ответа 200 OK обратно. Прокси проверяет каждый бэкенд запросом GET /healthz; web2 не проходит проверку и выведен из ротации. Запрос уходит на web3 по готовому соединению.',
    }
  : {
      title: 'The path of one HTTPS request: DNS, TCP, TLS, proxy, backend',
      client: 'client', clientSub: 'browser',
      resolver: 'DNS resolver', resolverSub: 'answers from cache', resolverSubN: 'cache',
      proxy: 'reverse proxy', proxySub: 'TLS ends here',
      q: 'A? www.example.com', a: '203.0.113.10, TTL 300',
      tcp: 'TCP: 1 round trip', tls: 'TLS 1.3: SNI, ALPN, cert', req: 'GET / HTTP/2', resp: '200 OK',
      hc: 'GET /healthz', down: 'fails: out of rotation', pool: 'pooled connection',
      steps: [
        'the client asks the resolver for the name; the answer comes from its cache, with the TTL that is left',
        'the TCP handshake with the address of the proxy: one round trip',
        'the TLS 1.3 handshake: server name (SNI), protocol (ALPN), certificate, keys; one more round trip',
        'the HTTP/2 request reaches the proxy, which reads the Host and the path',
        'the proxy probes /healthz on every backend on its own; web2 fails and is out of rotation',
        'the proxy forwards the request to web3 over a connection that is already open, and the response returns the same way',
      ],
      desc: 'On the left the client, above it a DNS resolver, in the middle a reverse proxy, on the right three backends web1, web2 and web3. The client asks the resolver for www.example.com and gets 203.0.113.10 with a TTL of 300. Then three arrows to the proxy: the TCP handshake, the TLS 1.3 handshake and an HTTP/2 GET, and a response arrow 200 OK back. The proxy checks every backend with GET /healthz; web2 fails the check and is out of rotation. The request goes to web3 over a pooled connection.',
    };

// Label widths: about 6.5 px per f-small character in the wide layout, 7.3 in the narrow one (14 px text),
// and 7.5 / 8.0 per f-label character.
const fits = (s: string, room: number, px: number, what: string) => {
  if (s.length * px > room) throw new Error(`${what}: "${s}" needs ${s.length * px} px, has ${room}`);
};
// Wide: labels over the arrows between client (right edge 140) and proxy (left edge 330), centred at 244,
// clear of the badges at x = 152.
for (const s of [t.tcp, t.tls, t.req, t.resp]) fits(s, 2 * (328 - 244), 6.5, 'wide arrow label');
fits(t.q, 198 - 64, 6.5, 'wide query');
fits(t.a, 248 - 104, 6.5, 'wide answer');
fits(t.down, 2 * (760 - 670), 6.5, 'wide down');
fits(t.pool, 588 - 470, 6.5, 'wide pool');
for (const s of [t.client, t.proxy, t.resolver]) fits(s, 148, 7.5, 'wide box');
fits(t.proxySub, 148, 6.5, 'wide proxy sub');
fits(t.resolverSub, 168, 6.5, 'wide resolver sub');
// Narrow: arrow labels to the right of the arrow bundle, from x = 114 to the edge.
for (const s of [t.tcp, t.tls, t.req, t.resp]) fits(s, 350 - 114, 7.3, 'narrow arrow label');
for (const s of [t.q, t.a]) fits(s, 340, 7.3, 'narrow dns');
fits(t.down, 2 * Math.min(180 - 10, 350 - 180), 7.3, 'narrow down');
fits(t.pool, 350 - 150, 7.3, 'narrow pool');
for (const s of [t.client, t.resolver]) fits(s, 148, 8.0, 'narrow box');
fits(t.proxy, 338, 8.0, 'narrow proxy');
const id = 'request-path';
const caption = ru
  ? 'Клиент знает только имя. Резолвер превращает его в адрес прокси (1); с прокси клиент открывает TCP-соединение (2) и TLS-сессию (3), и лишь затем отправляет запрос (4). Прокси сам решает, какой бэкенд ответит: он исключает тот, что не прошёл проверку здоровья (5), и передаёт запрос по соединению, открытому заранее (6). Шаги 2 и 3 стоят по одному круговому обращению между клиентом и прокси, поэтому прокси ставят близко к пользователям, а соединения используют повторно.'
  : 'The client knows only a name. The resolver turns it into the address of the proxy (1); with the proxy the client opens a TCP connection (2) and a TLS session (3), and only then sends the request (4). The proxy decides which backend answers: it leaves out the one that failed its health check (5) and forwards the request over a connection opened in advance (6). Steps 2 and 3 cost one round trip each between client and proxy, which is why proxies are placed near users and connections are reused.';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 292" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <Box x={16} y={100} w={124} h={110} label={t.client} sub={t.clientSub} tone="x" />
    <Box x={330} y={100} w={150} h={110} label={t.proxy} sub={t.proxySub} tone="h" />
    <g data-s="1">
      <Box x={200} y={14} w={170} h={48} label={t.resolver} sub={t.resolverSub} tone="n" />
      <Arrow pts={[[60, 98], [60, 30], [198, 30]]} />
      <text class="f-small f-halo" x="64" y="23">{t.q}</text>
      <Arrow pts={[[250, 64], [250, 84], [96, 84], [96, 98]]} tone="green" />
      <text class="f-small f-t-green f-halo" x="104" y="79">{t.a}</text>
      <Badge x={370} y={14} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[142, 118], [328, 118]]} tone="amber" />
      <text class="f-small f-t-amber f-halo" x="244" y="112" text-anchor="middle">{t.tcp}</text>
      <Badge x={152} y={108} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[142, 143], [328, 143]]} tone="amber" />
      <text class="f-small f-t-amber f-halo" x="244" y="137" text-anchor="middle">{t.tls}</text>
      <Badge x={152} y={133} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[142, 168], [328, 168]]} tone="blue" />
      <text class="f-small f-t-blue f-halo" x="244" y="162" text-anchor="middle">{t.req}</text>
      <Badge x={152} y={158} n={4} />
      <Box x={596} y={14} w={148} h={48} label="web1" sub="10.0.1.11:8080" tone="n" />
      <Box x={596} y={121} w={148} h={48} label="web2" sub="10.0.2.12:8080" tone="n" />
      <Box x={596} y={228} w={148} h={48} label="web3" sub="10.0.3.13:8080" tone="n" />
    </g>
    <g data-s="5">
      <Arrow pts={[[482, 112], [594, 40]]} tone="amber" dashed />
      <Arrow pts={[[482, 145], [594, 145]]} tone="amber" dashed />
      <Arrow pts={[[482, 172], [594, 242]]} tone="amber" dashed />
      <text class="f-small f-t-amber f-halo" x="537" y="138" text-anchor="middle">{t.hc}</text>
      <rect x="596" y="121" width="148" height="48" rx="7" style="fill: var(--fig-red); fill-opacity: 0.12; stroke: var(--fig-red); stroke-width: 1.8" />
      <text class="f-small f-t-red f-halo" x="670" y="190" text-anchor="middle">{t.down}</text>
      <Badge x={470} y={84} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[482, 200], [594, 264]]} tone="green" bold />
      <text class="f-small f-t-green f-halo" x="588" y="286" text-anchor="end">{t.pool}</text>
      <Arrow pts={[[328, 193], [142, 193]]} tone="green" />
      <text class="f-small f-t-green f-halo" x="244" y="187" text-anchor="middle">{t.resp}</text>
      <Badge x={460} y={276} n={6} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 512" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <Box x={10} y={10} w={150} h={50} label={t.client} sub={t.clientSub} tone="x" />
    <Box x={10} y={250} w={340} h={56} label={t.proxy} sub={t.proxySub} tone="h" />
    <g data-s="1">
      <Box x={200} y={10} w={150} h={50} label={t.resolver} sub={t.resolverSubN} tone="n" />
      <Arrow pts={[[162, 26], [198, 26]]} />
      <Arrow pts={[[198, 46], [162, 46]]} tone="green" />
      <text class="f-small f-halo" x="180" y="82" text-anchor="middle">{t.q}</text>
      <text class="f-small f-t-green f-halo" x="180" y="102" text-anchor="middle">{t.a}</text>
      <Badge x={338} y={10} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[40, 62], [40, 248]]} tone="amber" />
      <Badge x={100} y={136} n={2} />
      <text class="f-small f-t-amber f-halo" x="114" y="141">{t.tcp}</text>
    </g>
    <g data-s="3">
      <Arrow pts={[[60, 62], [60, 248]]} tone="amber" />
      <Badge x={100} y={164} n={3} />
      <text class="f-small f-t-amber f-halo" x="114" y="169">{t.tls}</text>
    </g>
    <g data-s="4">
      <Arrow pts={[[80, 62], [80, 248]]} tone="blue" />
      <Badge x={100} y={192} n={4} />
      <text class="f-small f-t-blue f-halo" x="114" y="197">{t.req}</text>
      <Box x={10} y={400} w={108} h={50} label="web1" sub="10.0.1.11" tone="n" />
      <Box x={126} y={400} w={108} h={50} label="web2" sub="10.0.2.12" tone="n" />
      <Box x={242} y={400} w={108} h={50} label="web3" sub="10.0.3.13" tone="n" />
    </g>
    <g data-s="5">
      <Arrow pts={[[64, 308], [64, 398]]} tone="amber" dashed />
      <Arrow pts={[[180, 308], [180, 398]]} tone="amber" dashed />
      <Arrow pts={[[284, 308], [284, 398]]} tone="amber" dashed />
      <text class="f-small f-t-amber f-halo" x="122" y="350" text-anchor="middle">{t.hc}</text>
      <rect x="126" y="400" width="108" height="50" rx="7" style="fill: var(--fig-red); fill-opacity: 0.12; stroke: var(--fig-red); stroke-width: 1.8" />
      <text class="f-small f-t-red f-halo" x="180" y="474" text-anchor="middle">{t.down}</text>
      <Badge x={36} y={350} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[22, 248], [22, 62]]} tone="green" />
      <Badge x={100} y={220} n={6} />
      <text class="f-small f-t-green f-halo" x="114" y="225">{t.resp}</text>
      <Arrow pts={[[326, 308], [326, 398]]} tone="green" bold />
      <text class="f-small f-t-green f-halo" x="350" y="500" text-anchor="end">{t.pool}</text>
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
