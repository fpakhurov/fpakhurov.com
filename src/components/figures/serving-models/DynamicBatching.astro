---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Seven requests through a dynamic batcher with a maximum batch of 4 and a maximum queue delay of 5 ms,
// on one instance whose batch of b takes 8 + 0.5 b ms (the cost model of the note). The schedule is computed
// with the rule of the note: a batch starts at the later of "the instance is free" and the earlier of
// "the oldest request has waited the delay" and "the batch is full".
const A = 8, C = 0.5, MAXB = 4, DELAY = 5;
const arrive = [0, 2, 4.5, 7, 9, 11, 13.5];
interface Batch { start: number; end: number; idx: number[] }
const batches: Batch[] = [];
let head = 0, free = 0;
while (head < arrive.length) {
  const last = Math.min(head + MAXB, arrive.length) - 1;
  const full = last - head + 1 === MAXB ? arrive[last] : Infinity;
  const start = Math.max(free, Math.min(arrive[head] + DELAY, full));
  const idx: number[] = [];
  for (let i = head; i < arrive.length && idx.length < MAXB && arrive[i] <= start; i++) idx.push(i);
  const end = start + A + C * idx.length;
  batches.push({ start, end, idx });
  free = end; head += idx.length;
}
if (batches.length !== 2) throw new Error(`expected two batches, got ${batches.length}`);
const [b1, b2] = batches;
if (b1.start !== 5 || b1.idx.length !== 3 || b1.end !== 14.5) throw new Error('batch 1 of the text: start 5, 3 requests, end 14.5');
if (b2.start !== 14.5 || b2.idx.length !== 4 || b2.end !== 24.5) throw new Error('batch 2 of the text: start 14.5, full, end 24.5');
const startOf = (i: number) => (b1.idx.includes(i) ? b1 : b2);
// Requests that wait in the queue at all (every one here does; r1 waits for the timer).
const waits = arrive.map((a, i) => startOf(i).start > a);
if (!waits.every(Boolean)) throw new Error('every request of the example waits');
const T = 26;

const t = ru
  ? { title: 'Динамическое группирование в батчи: таймер задержки и полный батч', wait: 'ждёт', run: 'в батче', timer: `макс. задержка ${DELAY} мс`, idle: 'простой', gpu: 'GPU', axis: 'время, мс',
      b1: `батч 1: ${b1.idx.length} запроса, ${b1.end - b1.start} мс`, b2: `батч 2: ${b2.idx.length} запроса (полный), ${b2.end - b2.start} мс`,
      b1n: 'батч 1', b2n: 'батч 2', b1d: `${b1.idx.length} запроса, ${b1.end - b1.start} мс`, b2d: `${b2.idx.length} запроса, полный, ${b2.end - b2.start} мс`,
      steps: ['запросы приходят по одному и ждут в очереди; экземпляр модели простаивает', `первый запрос запускает таймер батча: ${DELAY} мс`, `таймер истёк, когда ждут три запроса из 4 возможных; батч стартует, экземпляр занят ${b1.end - b1.start} мс`, 'пока батч выполняется, приходят новые запросы; к его концу ждут четыре', 'полный батч не ждёт таймера: он стартует, как только экземпляр освободится'],
      desc: 'Семь строк, по одной на запрос, на общей оси времени от 0 до 26 мс, и под ними строка GPU. Запросы 1–3 приходят в 0, 2 и 4.5 мс и ждут до 5 мс, когда истекает таймер первого; затем они обслуживаются одним батчем до 14.5 мс. Запросы 4–7 приходят в 7, 9, 11 и 13.5 мс, ждут, пока GPU занят, и в 14.5 мс уходят полным батчем из четырёх, который выполняется до 24.5 мс.' }
  : { title: 'Dynamic batching: the delay timer and the full batch', wait: 'waiting', run: 'in a batch', timer: `max delay ${DELAY} ms`, idle: 'idle', gpu: 'GPU', axis: 'time, ms',
      b1: `batch 1: ${b1.idx.length} requests, ${b1.end - b1.start} ms`, b2: `batch 2: ${b2.idx.length} requests (full), ${b2.end - b2.start} ms`,
      b1n: 'batch 1', b2n: 'batch 2', b1d: `${b1.idx.length} requests, ${b1.end - b1.start} ms`, b2d: `${b2.idx.length} requests, full, ${b2.end - b2.start} ms`,
      steps: ['requests arrive one by one and wait in the queue; the model instance is idle', `the first request starts the timer of the batch: ${DELAY} ms`, `the timer expires with three of at most 4 requests waiting; the batch starts, and the instance is busy for ${b1.end - b1.start} ms`, 'new requests arrive while the batch runs; when it ends, four are waiting', 'a full batch does not wait for the timer: it starts as soon as the instance is free'],
      desc: 'Seven rows, one per request, on a shared time axis from 0 to 26 ms, and a GPU row below them. Requests 1 to 3 arrive at 0, 2 and 4.5 ms and wait until 5 ms, when the timer of the first expires; they are then served as one batch until 14.5 ms. Requests 4 to 7 arrive at 7, 9, 11 and 13.5 ms, wait while the GPU is busy, and leave at 14.5 ms as a full batch of four that runs until 24.5 ms.' };

interface Layout { cls: string; W: number; H: number; x0: number; x1: number; top: number; pitch: number; gpuY: number; axisY: number; sans: number; wide: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 292, x0: 80, x1: 740, top: 52, pitch: 18, gpuY: 186, axisY: 236, sans: 6.5, wide: true },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 356, x0: 40, x1: 350, top: 60, pitch: 20, gpuY: 210, axisY: 300, sans: 7.3, wide: false },
];
const fits = (s: string, room: number, px: number, what: string) => {
  if (s.length * px > room) throw new Error(`${what}: "${s}" needs ${(s.length * px).toFixed(0)} px, has ${room.toFixed(0)}`);
};
for (const L of layouts) {
  const sx = (v: number) => L.x0 + (v / T) * (L.x1 - L.x0);
  fits(t.timer, L.x1 - L.x0 - 40, L.sans, 'timer');
  fits(t.idle, sx(b1.start) - sx(0) - 4, L.sans, 'idle');
  if (L.wide) {
    fits(t.b1, sx(b1.end) - sx(b1.start) - 8, L.sans, 'wide batch 1');
    fits(t.b2, sx(b2.end) - sx(b2.start) - 8, L.sans, 'wide batch 2');
  } else {
    fits(t.b1n, sx(b1.end) - sx(b1.start) - 8, L.sans, 'narrow batch 1');
    fits(t.b2n, sx(b2.end) - sx(b2.start) - 8, L.sans, 'narrow batch 2');
    const c1 = (sx(b1.start) + sx(b1.end)) / 2, w1 = t.b1d.length * L.sans;
    if (c1 - w1 / 2 < 2 || c1 + w1 / 2 > L.W - 2) throw new Error('narrow batch 1 detail');
    fits(t.b2d, L.W - 6, L.sans, 'narrow batch 2 detail');
  }
  // legend: two items in one row, right of the timer label in the wide layout, above it in the narrow one
  const legX1 = L.wide ? 520 : L.x0;
  if (legX1 + 20 + t.wait.length * L.sans + 24 + 20 + t.run.length * L.sans > L.W - 4) throw new Error('legend');
  // the badge of step 2 sits right of the timer label
  if (sx(0) + t.timer.length * L.sans + 16 + 10 > L.W) throw new Error('timer badge');
  if (L.wide && sx(0) + t.timer.length * L.sans + 30 > legX1) throw new Error('timer label meets the legend');
}
const id = 'dynamic-batching';
const caption = ru
  ? `Семь запросов проходят через батчер с максимальным размером батча ${MAXB} и максимальной задержкой в очереди ${DELAY} мс; батч из b запросов обслуживается ${A} + ${C}·b мс. Пунктир — ожидание в очереди, сплошная полоса — время в батче. Первые три запроса стартуют по таймеру самого раннего из них (2, 3), неполным батчем. Пока он выполняется, набираются четыре следующих (4), и полный батч стартует сразу, как только освободился экземпляр (5): под нагрузкой батчи формирует сама очередь, а таймер нужен только при слабом трафике.`
  : `Seven requests pass through a batcher with a maximum batch of ${MAXB} and a maximum queue delay of ${DELAY} ms; a batch of b requests takes ${A} + ${C}·b ms. Dashes are time waiting in the queue, solid bars time in a batch. The first three requests start on the timer of the oldest of them (2, 3), as a batch that is not full. While it runs, the next four collect (4), and the full batch starts the moment the instance is free (5): under load the queue itself forms the batches, and the timer matters only when traffic is light.`;
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sx = (v: number) => L.x0 + (v / T) * (L.x1 - L.x0);
    const lane = (i: number) => L.top + i * L.pitch;
    const gpuH = 24;
    const legX1 = L.wide ? 520 : L.x0;
    const legX2 = legX1 + 20 + t.wait.length * L.sans + 24;
    const badge2X = sx(0) + t.timer.length * L.sans + 16;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        <line x1={legX1} x2={legX1 + 14} y1={12} y2={12} class="f-line f-amber f-dash" />
        <text class="f-small f-t-muted" x={legX1 + 20} y={16}>{t.wait}</text>
        <line x1={legX2} x2={legX2 + 14} y1={12} y2={12} style="stroke: var(--fig-blue); stroke-width: 6; stroke-opacity: 0.6" />
        <text class="f-small f-t-muted" x={legX2 + 20} y={16}>{t.run}</text>
        {[0, 5, 10, 15, 20, 25].map((v) => (
          <g>
            <line class="f-grid" x1={sx(v)} x2={sx(v)} y1={lane(0) - 8} y2={L.axisY} />
            <text class="f-small f-t-muted" x={sx(v)} y={L.axisY + 16} text-anchor="middle">{String(v)}</text>
          </g>
        ))}
        <line class="f-axis" x1={L.x0} x2={L.x1} y1={L.axisY} y2={L.axisY} />
        <text class="f-small f-t-muted" x={L.x1} y={L.axisY + 34} text-anchor="end">{t.axis}</text>
        <text class="f-small" x={L.x0 - 8} y={L.gpuY + gpuH / 2 + 5} text-anchor="end" style="font-weight: 650">{t.gpu}</text>
        <g data-s="1">
          <text class="f-small f-t-muted" x={(sx(0) + sx(b1.start)) / 2} y={L.gpuY + gpuH / 2 + 5} text-anchor="middle">{t.idle}</text>
          <rect x={sx(0)} y={L.gpuY} width={sx(b1.start) - sx(0)} height={gpuH} rx="3" style="fill: none; stroke: var(--muted); stroke-width: 1; stroke-dasharray: 3 3" />
        </g>
        {arrive.map((a, i) => {
          const b = startOf(i);
          const first = b === b1;
          return (
            <g>
              <g data-s={first ? '1' : '4'}>
                <text class="f-small f-t-muted" x={L.x0 - 8} y={lane(i) + 4.5} text-anchor="end">{`r${i + 1}`}</text>
                <circle cx={sx(a)} cy={lane(i)} r="4" style="fill: var(--fig-green)" />
              </g>
              <g data-s={first ? '2' : '4'}>
                {waits[i] && <line x1={sx(a) + 4} x2={sx(b.start)} y1={lane(i)} y2={lane(i)} class="f-line f-amber f-dash" />}
              </g>
              <g data-s={first ? '3' : '5'}>
                <line x1={sx(b.start)} x2={sx(b.end)} y1={lane(i)} y2={lane(i)} style="stroke: var(--fig-blue); stroke-width: 6; stroke-opacity: 0.6" />
              </g>
            </g>
          );
        })}
        <g data-s="2">
          <path class="f-line f-amber" d={`M ${sx(0)} ${lane(0) - 14} v -6 H ${sx(DELAY)} v 6`} />
          <text class="f-small f-t-amber" x={sx(0)} y={lane(0) - 24}>{t.timer}</text>
          <Badge x={badge2X} y={lane(0) - 28} n={2} />
        </g>
        <g data-s="3">
          <rect x={sx(b1.start)} y={L.gpuY} width={sx(b1.end) - sx(b1.start)} height={gpuH} rx="3" style="fill: var(--fig-blue); fill-opacity: 0.22; stroke: var(--fig-blue); stroke-width: 1.3" />
          <text class="f-small f-t-blue" x={(sx(b1.start) + sx(b1.end)) / 2} y={L.gpuY + gpuH / 2 + 5} text-anchor="middle">{L.wide ? t.b1 : t.b1n}</text>
          {!L.wide && <text class="f-small f-t-blue" x={(sx(b1.start) + sx(b1.end)) / 2} y={L.gpuY + gpuH + 20} text-anchor="middle">{t.b1d}</text>}
          <Badge x={sx(b1.start) + 12} y={L.gpuY - 12} n={3} />
        </g>
        <g data-s="4">
          <Badge x={sx(11.2)} y={lane(6)} n={4} />
        </g>
        <g data-s="5">
          <rect x={sx(b2.start)} y={L.gpuY} width={sx(b2.end) - sx(b2.start)} height={gpuH} rx="3" style="fill: var(--fig-blue); fill-opacity: 0.32; stroke: var(--fig-blue); stroke-width: 1.8" />
          <text class="f-small f-t-blue" x={(sx(b2.start) + sx(b2.end)) / 2} y={L.gpuY + gpuH / 2 + 5} text-anchor="middle" style="font-weight: 650">{L.wide ? t.b2 : t.b2n}</text>
          {!L.wide && <text class="f-small f-t-blue" x={L.W - 6} y={L.gpuY + gpuH + 40} text-anchor="end">{t.b2d}</text>}
          <Badge x={sx(b2.start) + 12} y={L.gpuY - 12} n={5} />
        </g>
        <g data-s="1"><Badge x={sx(3)} y={lane(4)} n={1} /></g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
