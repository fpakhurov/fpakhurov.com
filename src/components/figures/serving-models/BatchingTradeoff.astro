---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { scale, plot } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One model instance whose batch of b requests takes s(b) = a + c b milliseconds (a = 8, c = 0.5).
// Throughput X(b) = 1000 b / s(b) requests per second; the smallest batch that keeps up with a load lambda
// is b = lambda a / (1 - lambda c), with lambda in requests per millisecond.
const a = 8, c = 0.5, BMAX = 32;
const s = (b: number) => a + c * b;
const X = (b: number) => (1000 * b) / s(b);
const bMin = (perSec: number) => { const l = perSec / 1000; return (l * a) / (1 - l * c); };
const loads = [400, 1000];
const need = loads.map(bMin);
if (Math.abs(need[0] - 4) > 1e-9 || Math.abs(need[1] - 16) > 1e-9) throw new Error(`smallest batches ${need}`);
if (Math.round(X(1)) !== 118 || X(4) !== 400 || X(16) !== 1000 || Math.round(X(32)) !== 1333) throw new Error('throughputs of the text');
if (s(1) !== 8.5 || s(4) !== 10 || s(16) !== 16 || s(32) !== 24) throw new Error('batch times of the text');
const limit = 1000 / c;
if (limit !== 2000) throw new Error('limit');

// Russian keeps four-digit numbers unseparated (glossary); none here has five digits.
const fmtN = (v: number) => (ru ? String(Math.round(v)) : Math.round(v).toLocaleString('en-US'));
const t = ru
  ? { title: 'Батчирование: пропускная способность растёт, время батча тоже', a: 'запросов в секунду на экземпляр', b: 'время одного батча, мс', x: 'размер батча b',
      lim: `предел 1/c = ${fmtN(limit)}`, load: (l: number, b: number) => `${fmtN(l)}/с: b ≥ ${b}`, ms: (v: number) => `${v} мс`,
      steps: [`пропускная способность одного экземпляра b/(a + cb): от ${Math.round(X(1))} запросов в секунду при b = 1 к пределу ${fmtN(limit)}`, `время одного батча a + cb: от ${s(1)} до ${s(BMAX)} мс, его платит каждый запрос батча`, `нагрузкам ${loads[0]} и ${fmtN(loads[1])} запросов в секунду нужны батчи не меньше ${need[0]} и ${need[1]}: ${s(need[0])} и ${s(need[1])} мс на батч`],
      desc: `Две панели с размером батча от 1 до ${BMAX} по горизонтали. Слева пропускная способность: вогнутая кривая от ${Math.round(X(1))} до ${fmtN(X(BMAX))} запросов в секунду под пунктиром предела ${fmtN(limit)}; горизонтали на ${loads[0]} и ${fmtN(loads[1])} пересекают её при b = ${need[0]} и ${need[1]}. Справа время батча: прямая от ${s(1)} до ${s(BMAX)} мс, отмечены ${s(need[0])} мс при b = ${need[0]} и ${s(need[1])} мс при b = ${need[1]}.` }
  : { title: 'Batching: throughput grows, and so does the time of a batch', a: 'requests per second, one instance', b: 'time of one batch, ms', x: 'batch size b',
      lim: `limit 1/c = ${fmtN(limit)}`, load: (l: number, b: number) => `${fmtN(l)}/s: b ≥ ${b}`, ms: (v: number) => `${v} ms`,
      steps: [`throughput of one instance, b/(a + cb): from ${Math.round(X(1))} requests per second at b = 1 towards the limit of ${fmtN(limit)}`, `the time of one batch, a + cb: from ${s(1)} to ${s(BMAX)} ms, paid by every request in the batch`, `loads of ${loads[0]} and ${fmtN(loads[1])} requests per second need batches of at least ${need[0]} and ${need[1]}: ${s(need[0])} and ${s(need[1])} ms per batch`],
      desc: `Two panels with the batch size from 1 to ${BMAX} horizontally. Left, throughput: a concave curve from ${Math.round(X(1))} to ${fmtN(X(BMAX))} requests per second below a dashed limit at ${fmtN(limit)}; horizontal lines at ${loads[0]} and ${fmtN(loads[1])} meet it at b = ${need[0]} and ${need[1]}. Right, the time of a batch: a straight line from ${s(1)} to ${s(BMAX)} ms, with ${s(need[0])} ms marked at b = ${need[0]} and ${s(need[1])} ms at b = ${need[1]}.` };

interface Layout { cls: string; W: number; H: number; A: [number, number, number, number]; B: [number, number, number, number]; sans: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 300, A: [64, 44, 356, 250], B: [446, 44, 738, 250], sans: 6.5 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 520, A: [52, 44, 344, 214], B: [52, 300, 344, 470], sans: 7.3 },
];
const geo = layouts.map((L) => {
  const [ax0, ay0, ax1, ay1] = L.A, [bx0, by0, bx1, by1] = L.B;
  const sxA = scale([1, BMAX], [ax0, ax1]), syA = scale([0, 2200], [ay1, ay0]);
  const sxB = scale([1, BMAX], [bx0, bx1]), syB = scale([0, 30], [by1, by0]);
  // Load labels sit right of each intersection, under the curve: the curve must stay above the label box.
  const loadLabels = loads.map((l, i) => {
    const txt = t.load(l, need[i]);
    const x = sxA(need[i]) + 8, y = syA(l) + 16, w = txt.length * L.sans;
    if (x + w > ax1) throw new Error(`load label ${i} leaves panel A at ${L.W}`);
    for (let px = x; px <= x + w; px += 2) {
      const b = 1 + ((px - ax0) / (ax1 - ax0)) * (BMAX - 1);
      if (syA(X(b)) > y - 14) throw new Error(`load label ${i} meets the curve at ${L.W}`);
    }
    return { txt, x, y };
  });
  if (sxA(need[0]) + 8 + loadLabels[0].txt.length * L.sans > sxA(need[1]) - 4) throw new Error(`load label 0 meets the drop line at b = ${need[1]}`);
  const limW = t.lim.length * L.sans;
  if (ax1 - limW < ax0 + 4) throw new Error('limit label');
  // Batch-time labels below and right of each point, under the rising line.
  const msPts = [need[0], need[1], BMAX].map((b) => {
    const txt = t.ms(s(b)), w = txt.length * L.sans;
    const right = b === BMAX;
    // the last point sits at the right edge: its label goes above and left of it, over the line
    const x = right ? sxB(b) - 8 : sxB(b) + 6, y = right ? syB(s(b)) - 8 : syB(s(b)) + 18;
    const l = right ? x - w : x;
    if (l < bx0 || l + w > bx1 + 2) throw new Error(`ms label ${b} at ${L.W}`);
    for (let px = l; px <= l + w; px += 2) {
      const bb = 1 + ((px - bx0) / (bx1 - bx0)) * (BMAX - 1);
      if (right ? syB(s(bb)) < y + 3 : syB(s(bb)) > y - 13) throw new Error(`ms label ${b} meets the line at ${L.W}`);
    }
    return { b, txt, x, y, anchor: right ? 'end' : 'start' };
  });
  for (let i = 0; i + 1 < msPts.length; i++) {
    const p = msPts[i], q = msPts[i + 1];
    if (p.anchor === 'start' && q.anchor === 'start' && p.x + p.txt.length * L.sans > q.x - 4 && Math.abs(p.y - q.y) < 14) throw new Error(`ms labels ${p.b} and ${q.b} overlap`);
  }
  for (const title of [t.a, t.b]) if (title.length * L.sans > ax1 - ax0 + 40) throw new Error(`panel title at ${L.W}`);
  return { sxA, syA, sxB, syB, loadLabels, msPts, curve: plot(X, 1, BMAX, sxA, syA, 120) };
});
const id = 'batching-tradeoff';
const caption = ru
  ? `Один экземпляр модели, батч из b запросов обслуживается за ${a} + ${c}·b мс. Слева — сколько запросов в секунду он выдерживает при батчах размера b (1): фиксированная часть ${a} мс платится раз за батч, поэтому пропускная способность растёт почти пропорционально b, пока c·b мало по сравнению с ${a} мс, и стремится к 1/c = ${fmtN(limit)}. Справа — время одного батча (2), которое ждёт каждый запрос батча после его старта. Нагрузке ${loads[0]} запросов в секунду нужны батчи от ${need[0]}, нагрузке ${fmtN(loads[1])} — от ${need[1]} (3); без батчирования экземпляр выдерживает ${Math.round(X(1))}.`
  : `One model instance; a batch of b requests takes ${a} + ${c}·b ms. Left, the requests per second it sustains with batches of size b (1): the fixed ${a} ms is paid once per batch, so throughput grows almost in proportion to b while c·b is small against ${a} ms, and approaches 1/c = ${fmtN(limit)}. Right, the time of one batch (2), which every request in the batch waits once the batch has started. A load of ${loads[0]} requests per second needs batches of at least ${need[0]}, a load of ${fmtN(loads[1])} at least ${need[1]} (3); without batching the instance sustains ${Math.round(X(1))}.`;
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L, li) => {
    const g = geo[li];
    const [ax0, ay0, ax1, ay1] = L.A, [bx0, by0, bx1, by1] = L.B;
    const bt = [1, 8, 16, 24, 32];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        <text class="f-small" x={ax0} y={ay0 - 18} style="font-weight: 650">{t.a}</text>
        <text class="f-small" x={bx0} y={by0 - 18} style="font-weight: 650">{t.b}</text>
        {[0, 500, 1000, 1500, 2000].map((v) => (
          <g>
            <line class="f-grid" x1={ax0} x2={ax1} y1={g.syA(v)} y2={g.syA(v)} />
            <text class="f-small f-t-muted" x={ax0 - 6} y={g.syA(v) + 4} text-anchor="end">{fmtN(v)}</text>
          </g>
        ))}
        {[0, 10, 20, 30].map((v) => (
          <g>
            <line class="f-grid" x1={bx0} x2={bx1} y1={g.syB(v)} y2={g.syB(v)} />
            <text class="f-small f-t-muted" x={bx0 - 6} y={g.syB(v) + 4} text-anchor="end">{String(v)}</text>
          </g>
        ))}
        {bt.map((b) => (
          <g>
            <text class="f-small f-t-muted" x={g.sxA(b)} y={ay1 + 16} text-anchor="middle">{String(b)}</text>
            <text class="f-small f-t-muted" x={g.sxB(b)} y={by1 + 16} text-anchor="middle">{String(b)}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${ax0} ${ay0} V ${ay1} H ${ax1}`} />
        <path class="f-axis" d={`M ${bx0} ${by0} V ${by1} H ${bx1}`} />
        <text class="f-small f-t-muted" x={ax1} y={ay1 + 34} text-anchor="end">{t.x}</text>
        <text class="f-small f-t-muted" x={bx1} y={by1 + 34} text-anchor="end">{t.x}</text>
        <g data-s="1">
          <line class="f-line f-dash" x1={ax0} x2={ax1} y1={g.syA(limit)} y2={g.syA(limit)} />
          <text class="f-small f-t-muted" x={ax1} y={g.syA(limit) + 16} text-anchor="end">{t.lim}</text>
          <path d={g.curve} style="fill: none; stroke: var(--fig-blue); stroke-width: 2.4" />
          <Badge x={g.sxA(26)} y={g.syA(X(26)) - 18} n={1} />
        </g>
        <g data-s="2">
          <path d={`M ${g.sxB(1)} ${g.syB(s(1))} L ${g.sxB(BMAX)} ${g.syB(s(BMAX))}`} style="fill: none; stroke: var(--fig-red); stroke-width: 2.4" />
          {g.msPts.map((p) => (
            <g>
              <circle cx={g.sxB(p.b)} cy={g.syB(s(p.b))} r="3.5" style="fill: var(--fig-red)" />
              <text class="f-small f-t-red" x={p.x} y={p.y} text-anchor={p.anchor}>{p.txt}</text>
            </g>
          ))}
          <Badge x={g.sxB(8)} y={g.syB(s(8)) - 18} n={2} />
        </g>
        <g data-s="3">
          {loads.map((l, i) => (
            <g>
              <path class="f-line f-amber f-dash" d={`M ${ax0} ${g.syA(l)} H ${g.sxA(need[i])} V ${ay1}`} />
              <circle cx={g.sxA(need[i])} cy={g.syA(l)} r="4" style="fill: var(--fig-amber)" />
              <text class="f-small f-t-amber" x={g.loadLabels[i].x} y={g.loadLabels[i].y}>{g.loadLabels[i].txt}</text>
              <path class="f-line f-amber f-dash" d={`M ${g.sxB(need[i])} ${by1} V ${g.syB(s(need[i]))}`} />
            </g>
          ))}
          <Badge x={g.sxA(need[1]) + 10} y={ay1 - 14} n={3} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
