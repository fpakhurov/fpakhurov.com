---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? "Факт с тремя измерениями" : "A fact with three dimensions";
const caption = ru ? "Одна строка факта описывает одну позицию завершённого заказа. Измерения описывают товар, магазин и день." : "One fact row represents one completed order line. The dimensions describe its product, store and day.";
const desc = ru ? "Измерения даты, товара и магазина связаны с фактом позиции продажи. Факт хранит количество и сумму в копейках." : "Date, product and store dimensions connect to the central sales-line fact. The fact records quantity and amount in cents.";
---
<Figure id="bd-sales-star" title={title} caption={caption}>
  <svg viewBox="0 0 340 193" role="img" aria-labelledby="bd-sales-star-title bd-sales-star-desc" style="max-width: 550px; margin-inline: auto">
    <title id="bd-sales-star-title">{title}</title>
    <desc id="bd-sales-star-desc">{desc}</desc>
    <rect class="f-fill-blue" x="119" y="12" width="102" height="32" rx="5" />
    <text class="f-label" x="170" y="33" text-anchor="middle">{ru ? 'Дата' : 'Date'}</text>
    <rect class="f-fill-blue" x="8" y="92" width="76" height="38" rx="5" />
    <text class="f-label" x="46" y="116" text-anchor="middle">{ru ? 'Магазин' : 'Store'}</text>
    <rect class="f-fill-blue" x="256" y="92" width="76" height="38" rx="5" />
    <text class="f-label" x="294" y="116" text-anchor="middle">{ru ? 'Товар' : 'Product'}</text>
    <path class="f-line" d="M 170 46 V 67 M 86 111 H 101 M 239 111 H 254" fill="none" />
    <rect class="f-fill-green" x="103" y="69" width="134" height="86" rx="6" />
    <text class="f-label" x="170" y="94" text-anchor="middle">{ru ? 'Позиция' : 'Sales line'}</text>
    <text class="f-label" x="170" y="119" text-anchor="middle">{ru ? 'Количество' : 'Quantity'}</text>
    <text class="f-label" x="170" y="141" text-anchor="middle">{ru ? 'Сумма' : 'Amount'}</text>
  </svg>
</Figure>
