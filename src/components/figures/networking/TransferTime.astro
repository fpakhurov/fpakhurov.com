---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Time to deliver one message of S bytes over a link with one-way latency L and bandwidth B: T = L + 8S/B.
// Link A is near and slow (2 ms, 100 Mbit/s), link B far and fast (38 ms, 1 Gbit/s). Both axes are logarithmic.
const A = { L: 0.002, B: 100e6 };
const Bl = { L: 0.038, B: 1e9 };
const T = (l: { L: number; B: number }, S: number) => l.L + (8 * S) / l.B;
const cross = (Bl.L - A.L) / (8 / A.B - 8 / Bl.B); // bytes
const tCross = T(A, cross);
if (Math.abs(cross - 500000) > 1e-6) throw new Error(`crossover at ${cross} bytes`);
if (Math.abs(tCross - 0.042) > 1e-9) throw new Error(`crossover time ${tCross}`);
if (Math.abs(T(A, 1e3) - 0.00208) > 1e-12 || Math.abs(T(Bl, 1e3) - 0.038008) > 1e-12) throw new Error('1 kB times');
if (Math.abs(T(A, 1e9) - 80.002) > 1e-9 || Math.abs(T(Bl, 1e9) - 8.038) > 1e-9) throw new Error('1 GB times');

const lx: [number, number] = [2, 10]; // log10 bytes
const ly: [number, number] = [-4, 3]; // log10 seconds
const xTicks = ru ? ['100 Б', '10 кБ', '1 МБ', '100 МБ', '10 ГБ'] : ['100 B', '10 kB', '1 MB', '100 MB', '10 GB'];
const yTicks = ru ? ['0.1 мс', '1 мс', '10 мс', '100 мс', '1 с', '10 с', '100 с', '1000 с'] : ['0.1 ms', '1 ms', '10 ms', '100 ms', '1 s', '10 s', '100 s', '1000 s'];
const t = ru
  ? { a: 'A: 2 мс, 100 Мбит/с', b: 'B: 38 мс, 1 Гбит/с', x: 'размер сообщения', cross: '500 кБ, 42 мс',
      lat: '← доминирует задержка', bw: 'доминирует пропускная способность →', latN: '← задержка', bwN: 'полоса →' }
  : { a: 'A: 2 ms, 100 Mbit/s', b: 'B: 38 ms, 1 Gbit/s', x: 'message size', cross: '500 kB, 42 ms',
      lat: '← latency dominates', bw: 'bandwidth dominates →', latN: '← latency', bwN: 'bandwidth →' };
interface Layout { cls: string; W: number; H: number; box: [number, number, number, number]; legend: [number, number]; lat: string; bw: string }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 340, box: [86, 20, 730, 280], legend: [104, 40], lat: t.lat, bw: t.bw },
  { cls: 'fig-narrow', W: 360, H: 360, box: [62, 20, 340, 290], legend: [74, 40], lat: t.latN, bw: t.bwN },
];
const plots = layouts.map((L) => {
  const [x0, y0, x1, y1] = L.box;
  const sx = scale(lx, [x0, x1]);
  const sy = scale(ly, [y1, y0]);
  const path = (l: { L: number; B: number }) =>
    Array.from({ length: 121 }, (_, k) => lx[0] + ((lx[1] - lx[0]) * k) / 120)
      .map((e, k) => `${k ? 'L' : 'M'} ${sx(e).toFixed(1)} ${sy(Math.log10(T(l, 10 ** e))).toFixed(1)}`)
      .join(' ');
  return { L, sx, sy, pa: path(A), pb: path(Bl), cx: sx(Math.log10(cross)), cy: sy(Math.log10(tCross)) };
});
const id = 'transfer-time';
---

<Figure
  id={id}
  title={ru ? 'Время передачи: задержка против пропускной способности' : 'Transfer time: latency against bandwidth'}
  caption={ru
    ? 'Время доставки одного сообщения из S байт, T = L + 8S/B, по двум линиям: A близкая и медленная (задержка L = 2 мс, пропускная способность B = 100 Мбит/с), B далёкая и быстрая (38 мс, 1 Гбит/с). Для малых сообщений время почти равно задержке, и A выигрывает в 18 раз на 1 кБ; для больших оно почти равно 8S/B, и B выигрывает в 10 раз на 1 ГБ. Кривые пересекаются при S = 500 кБ, T = 42 мс. Модель не учитывает рукопожатие TCP, окно и потери. Обе оси логарифмические.'
    : 'The time to deliver one message of S bytes, T = L + 8S/B, over two links: A is near and slow (latency L = 2 ms, bandwidth B = 100 Mbit/s), B far and fast (38 ms, 1 Gbit/s). For small messages the time is almost the latency, and A wins by a factor of 18 at 1 kB; for large ones it is almost 8S/B, and B wins by a factor of 10 at 1 GB. The curves cross at S = 500 kB, T = 42 ms. The model leaves out the TCP handshake, the window and losses. Both axes are logarithmic.'}
>
  {plots.map(({ L, sx, sy, pa, pb, cx, cy }) => {
    const [x0, y0, x1, y1] = L.box;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Время передачи по двум линиям в зависимости от размера сообщения' : 'Transfer time over two links against message size'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'График в логарифмических осях: размер сообщения от 100 байт до 10 гигабайт, время от 0.1 миллисекунды до 1000 секунд. Кривая линии A начинается на 2 мс и растёт круче, кривая линии B начинается на 38 мс и растёт медленнее. Они пересекаются при 500 килобайтах и 42 мс; левее быстрее A, правее B.'
          : 'A log-log plot: message size from 100 bytes to 10 gigabytes, time from 0.1 millisecond to 1000 seconds. The curve of link A starts at 2 ms and rises more steeply; the curve of link B starts at 38 ms and rises less steeply. They cross at 500 kilobytes and 42 ms; to the left A is faster, to the right B.'}</desc>
        <path class="f-axis" d={`M ${x0} ${y0} V ${y1} H ${x1}`} />
        {yTicks.map((label, k) => (
          <g>
            <path class="f-grid" d={`M ${x0} ${sy(ly[0] + k)} H ${x1}`} />
            <text class="f-note" x={x0 - 8} y={sy(ly[0] + k) + 5} text-anchor="end">{label}</text>
          </g>
        ))}
        {xTicks.map((label, k) => (
          <g>
            <path class="f-axis" d={`M ${sx(lx[0] + 2 * k)} ${y1} v 5`} />
            <text class="f-note" x={sx(lx[0] + 2 * k)} y={y1 + 20} text-anchor={k === 0 ? 'start' : k === xTicks.length - 1 ? 'end' : 'middle'}>{label}</text>
          </g>
        ))}
        <text class="f-note" x={(x0 + x1) / 2} y={y1 + 42} text-anchor="middle">{t.x}</text>
        <path class="f-line f-blue f-bold" d={pa} />
        <path class="f-line f-red f-bold" d={pb} />
        <path class="f-thin f-muted f-dash" d={`M ${cx} ${cy} V ${y1}`} />
        <circle cx={cx} cy={cy} r="4.5" class="f-solid-muted" />
        <text class="f-small f-halo" x={cx + 10} y={cy + 20}>{t.cross}</text>
        <text class="f-small f-t-muted f-halo" x={cx - 8} y={y1 - 10} text-anchor="end">{L.lat}</text>
        <text class="f-small f-t-muted f-halo" x={cx + 8} y={y1 - 10}>{L.bw}</text>
        <g>
          <path class="f-line f-blue f-bold" d={`M ${L.legend[0]} ${L.legend[1]} h 22`} />
          <text class="f-small f-halo" x={L.legend[0] + 30} y={L.legend[1] + 4.5}>{t.a}</text>
          <path class="f-line f-red f-bold" d={`M ${L.legend[0]} ${L.legend[1] + 22} h 22`} />
          <text class="f-small f-halo" x={L.legend[0] + 30} y={L.legend[1] + 26.5}>{t.b}</text>
        </g>
      </svg>
    );
  })}
</Figure>
