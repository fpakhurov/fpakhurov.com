---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The subnet 192.168.10.77/26: the address, the mask, the network address (address AND mask) and the broadcast
// address (address OR NOT mask), all as 32 bits. The first 26 bits are the network part, the last 6 the host part.
const prefix = 26;
const toInt = (s: string) => s.split('.').reduce((a, o) => a * 256 + Number(o), 0);
const toDotted = (v: number) => [24, 16, 8, 0].map((sh) => Math.floor(v / 2 ** sh) % 256).join('.');
const bits = (v: number) => Array.from({ length: 32 }, (_, i) => Math.floor(v / 2 ** (31 - i)) % 2);
const addr = toInt('192.168.10.77');
const mask = 2 ** 32 - 2 ** (32 - prefix);
const hostMask = 2 ** (32 - prefix) - 1;
const net = addr - (addr % 2 ** (32 - prefix));
const bcast = net + hostMask;
if (toDotted(mask) !== '255.255.255.192') throw new Error(`mask ${toDotted(mask)}`);
if (toDotted(net) !== '192.168.10.64' || toDotted(bcast) !== '192.168.10.127') throw new Error(`network ${toDotted(net)}, broadcast ${toDotted(bcast)}`);
const hosts = 2 ** (32 - prefix) - 2;
if (hosts !== 62) throw new Error(`hosts ${hosts}`);
const other = toInt('192.168.10.130');
const otherNet = other - (other % 2 ** (32 - prefix));
if (otherNet === net) throw new Error('192.168.10.130 should be outside the subnet');
const rowsV = [addr, mask, net, bcast];
const dotted = rowsV.map(toDotted);
const t = ru
  ? {
      label: ['адрес', 'маска /26', 'сеть', 'широковещательный'],
      labelNarrow: ['адрес', 'маска /26', 'адрес сети', 'широковещательный адрес'],
      netPart: `сеть: ${prefix} бит`, hostPart: `узел: ${32 - prefix} бит`,
      hosts: `узлы: от .65 до .126, 2⁶ − 2 = ${hosts} адреса`,
      other: '192.168.10.130: последний октет 10000010 начинается с 10, а не с 01 — другая подсеть',
      otherNarrow: ['192.168.10.130: октет 10000010', 'начинается с 10, а не с 01: другая подсеть'],
      hostsNarrow: [`узлы: от .65 до .126,`, `2⁶ − 2 = ${hosts} адреса`],
      steps: [
        'адрес 192.168.10.77 — это 32 бита; префикс /26 говорит, что первые 26 бит задают сеть',
        'маска: 26 единиц, затем 6 нулей, в записи 255.255.255.192',
        'адрес сети: побитовое И адреса и маски сохраняет 26 бит сети и обнуляет биты узла: 192.168.10.64',
        'широковещательный адрес: все биты узла равны единице: 192.168.10.127',
        `узлы: 2⁶ − 2 = ${hosts} адреса от .65 до .126; адрес 192.168.10.130 лежит в другой подсети`,
      ],
    }
  : {
      label: ['address', 'mask /26', 'network', 'broadcast'],
      labelNarrow: ['address', 'mask /26', 'network address', 'broadcast address'],
      netPart: `network: ${prefix} bits`, hostPart: `host: ${32 - prefix} bits`,
      hosts: `hosts: .65 to .126, 2⁶ − 2 = ${hosts} addresses`,
      other: '192.168.10.130: last octet 10000010 starts with 10, not 01, so it is on another subnet',
      otherNarrow: ['192.168.10.130: octet 10000010 starts', 'with 10, not 01: another subnet'],
      hostsNarrow: [`hosts: .65 to .126,`, `2⁶ − 2 = ${hosts} addresses`],
      steps: [
        'the address 192.168.10.77 is 32 bits; the prefix /26 says that the first 26 bits name the network',
        'the mask: 26 ones, then 6 zeros, written 255.255.255.192',
        'network address: address AND mask keeps the 26 network bits and clears the host bits: 192.168.10.64',
        'broadcast address: all host bits set to one: 192.168.10.127',
        `hosts: 2⁶ − 2 = ${hosts} addresses, .65 to .126; the address 192.168.10.130 is on another subnet`,
      ],
    };
const rowBits = rowsV.map(bits);
const tone = (i: number) => (i < prefix ? toneVar.h : toneVar.g);
// Wide: all 32 bits, cells of 13 with a gap of 6 between bytes.
const cw = 13, x0 = 270, bg = 6, ch = 24;
const cx = (i: number) => x0 + i * cw + Math.floor(i / 8) * bg;
const wideRowY = (k: number) => 52 + k * 44;
const splitX = (cx(prefix - 1) + cw + cx(prefix)) / 2;
// Narrow: the first three octets as text, the last octet as 8 cells of 26.
const nw = 26, nx0 = 130, nch = 28;
const narrowRowY = (k: number) => 64 + k * 70;
const head = rowsV.map((v) => toDotted(v).split('.').slice(0, 3).join('.') + '.');
const last = rowBits.map((b) => b.slice(24));
const nSplit = nx0 + (prefix - 24) * nw;
const id = 'subnet-bits';
---

<Figure
  id={id}
  title={ru ? 'Подсеть 192.168.10.77/26 по битам' : 'The subnet 192.168.10.77/26, bit by bit'}
  caption={ru
    ? `Префикс /26 делит 32 бита адреса на 26 бит сети (синие) и 6 бит узла (жёлтые) (1). Маска состоит из 26 единиц и 6 нулей (2). Побитовое И адреса и маски даёт адрес сети 192.168.10.64 (3), а единицы во всех битах узла — широковещательный адрес 192.168.10.127 (4). Между ними ${hosts} адреса узлов, от .65 до .126; адрес 192.168.10.130 отличается уже в битах сети и лежит в другой подсети (5).`
    : `The prefix /26 splits the 32 bits of the address into 26 network bits (blue) and 6 host bits (amber) (1). The mask is 26 ones and 6 zeros (2). The bitwise AND of address and mask is the network address 192.168.10.64 (3), and setting every host bit to one gives the broadcast address 192.168.10.127 (4). Between them lie ${hosts} host addresses, .65 to .126; the address 192.168.10.130 differs already in the network bits and is on another subnet (5).`}
>
  <svg class="fig-wide" viewBox="0 0 760 290" role="img" aria-labelledby={`${id}-760-t ${id}-760-d`}>
    <title id={`${id}-760-t`}>{ru ? 'Адрес, маска, адрес сети и широковещательный адрес в двоичном виде' : 'Address, mask, network address and broadcast address in binary'}</title>
    <desc id={`${id}-760-d`}>{ru
      ? 'Четыре строки по 32 клетки с битами. Первые 26 клеток синие, последние 6 жёлтые. Адрес 192.168.10.77, маска 255.255.255.192, адрес сети 192.168.10.64 и широковещательный адрес 192.168.10.127. Строки различаются только в последних шести битах.'
      : 'Four rows of 32 bit cells. The first 26 cells are blue, the last 6 amber. The address 192.168.10.77, the mask 255.255.255.192, the network address 192.168.10.64 and the broadcast address 192.168.10.127. The rows differ only in the last six bits.'}</desc>
    <g data-s="1">
      <path class="f-thin f-blue" d={`M ${cx(0)} 30 V 25 H ${splitX - 3} V 30`} />
      <text class="f-small f-t-blue" x={(cx(0) + splitX) / 2} y="19" text-anchor="middle">{t.netPart}</text>
      <path class="f-thin f-amber" d={`M ${splitX + 3} 30 V 25 H ${cx(31) + cw} V 30`} />
      <text class="f-small f-t-amber" x={(splitX + cx(31) + cw) / 2} y="19" text-anchor="middle">{t.hostPart}</text>
    </g>
    {rowBits.map((b, k) => (
      <g data-s={String(k + 1)}>
        <text class="f-small" x="30" y={wideRowY(k) + 17} style="font-weight: 650">{t.label[k]}</text>
        <text class="f-small f-t-muted" x={x0 - 10} y={wideRowY(k) + 17} text-anchor="end">{dotted[k]}</text>
        {b.map((v, i) => (
          <g>
            <rect x={cx(i)} y={wideRowY(k)} width={cw} height={ch} style={`fill: ${tone(i)}; fill-opacity: ${v ? 0.3 : 0.06}; stroke: ${tone(i)}; stroke-width: 0.8`} />
            <text class="f-small" x={cx(i) + cw / 2} y={wideRowY(k) + 17} text-anchor="middle">{v}</text>
          </g>
        ))}
        <Badge x={14} y={wideRowY(k) + 12} n={k + 1} />
      </g>
    ))}
    <path class="f-line f-dash f-muted" d={`M ${splitX} 34 V ${wideRowY(3) + ch + 6}`} />
    <g data-s="5">
      <text class="f-small" x="30" y="248">{t.hosts}</text>
      <text class="f-small f-t-muted" x="30" y="272">{t.other}</text>
      <Badge x={14} y={244} n={5} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 418" role="img" aria-labelledby={`${id}-360-t ${id}-360-d`}>
    <title id={`${id}-360-t`}>{ru ? 'Адрес, маска, адрес сети и широковещательный адрес: последний октет в двоичном виде' : 'Address, mask, network address and broadcast address: the last octet in binary'}</title>
    <desc id={`${id}-360-d`}>{ru
      ? 'Четыре строки. Первые три октета записаны десятичными числами, последний октет — восемью клетками с битами: первые две синие (сеть), последние шесть жёлтые (узел). Адрес 01001101, маска 11000000, адрес сети 01000000, широковещательный адрес 01111111.'
      : 'Four rows. The first three octets are written in decimal and the last octet as eight bit cells: the first two blue (network), the last six amber (host). Address 01001101, mask 11000000, network address 01000000, broadcast address 01111111.'}</desc>
    <g data-s="1">
      <path class="f-thin f-blue" d={`M ${nx0} 34 V 29 H ${nSplit - 3} V 34`} />
      <text class="f-small f-t-blue" x={nx0} y="21">{ru ? 'сеть' : 'network'}</text>
      <path class="f-thin f-amber" d={`M ${nSplit + 3} 34 V 29 H ${nx0 + 8 * nw} V 34`} />
      <text class="f-small f-t-amber" x={nx0 + 8 * nw} y="21" text-anchor="end">{ru ? 'узел: 6 бит' : 'host: 6 bits'}</text>
    </g>
    {last.map((b, k) => (
      <g data-s={String(k + 1)}>
        <text class="f-small" x="30" y={narrowRowY(k) - 8} style="font-weight: 650">{t.labelNarrow[k]}</text>
        <text class="f-small f-t-muted" x={352} y={narrowRowY(k) - 8} text-anchor="end">{dotted[k]}</text>
        <text class="f-small" x={nx0 - 8} y={narrowRowY(k) + 19} text-anchor="end">{head[k]}</text>
        {b.map((v, i) => (
          <g>
            <rect x={nx0 + i * nw} y={narrowRowY(k)} width={nw} height={nch} style={`fill: ${tone(24 + i)}; fill-opacity: ${v ? 0.3 : 0.06}; stroke: ${tone(24 + i)}; stroke-width: 0.8`} />
            <text class="f-small" x={nx0 + i * nw + nw / 2} y={narrowRowY(k) + 19} text-anchor="middle">{v}</text>
          </g>
        ))}
        <Badge x={14} y={narrowRowY(k) - 13} n={k + 1} />
      </g>
    ))}
    <path class="f-line f-dash f-muted" d={`M ${nSplit} 38 V ${narrowRowY(3) + nch + 6}`} />
    <g data-s="5">
      {t.hostsNarrow.map((line, i) => <text class="f-small" x="30" y={340 + i * 20}>{line}</text>)}
      {t.otherNarrow.map((line, i) => <text class="f-small f-t-muted" x="8" y={388 + i * 20}>{line}</text>)}
      <Badge x={14} y={336} n={5} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
