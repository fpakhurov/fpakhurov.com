---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar, type Tone } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// One full TCP segment on Ethernet: 1,460 bytes of data, a 20-byte TCP header, a 20-byte IPv4 header (no options),
// a 14-byte Ethernet header and a 4-byte frame check sequence. On the wire every frame also costs an 8-byte
// preamble with start delimiter and a 12-byte interframe gap.
const data = 1460, tcpH = 20, ipH = 20, ethH = 14, fcs = 4, preamble = 8, gap = 12;
const segment = data + tcpH, packet = segment + ipH, frame = packet + ethH + fcs, wire = frame + preamble + gap;
const share = data / wire;
if (packet !== 1500) throw new Error(`IP packet is ${packet} bytes, not the 1,500-byte MTU`);
if (frame !== 1518 || wire !== 1538) throw new Error(`frame ${frame}, wire ${wire}`);
if ((100 * share).toFixed(1) !== '94.9') throw new Error(`payload share ${share}`);

// Russian: four-digit numbers unseparated, longer ones with a no-break space between thousands.
const n = (v: number) => (ru ? (v < 10000 ? String(v) : String(v).replace(/\B(?=(\d{3})+(?!\d))/g, '\u00a0')) : v.toLocaleString('en-US'));
const B = ru ? 'Б' : 'B';
type Part = { key: 'eth' | 'ip' | 'tcp' | 'data' | 'fcs'; tone: Tone; size: number };
const parts: Part[] = [
  { key: 'eth', tone: 'y', size: ethH },
  { key: 'ip', tone: 'g', size: ipH },
  { key: 'tcp', tone: 'h', size: tcpH },
  { key: 'data', tone: 'x', size: data },
  { key: 'fcs', tone: 'y', size: fcs },
];
// Which parts each row holds, top (application) to bottom (link).
const rows: Part['key'][][] = [['data'], ['tcp', 'data'], ['ip', 'tcp', 'data'], ['eth', 'ip', 'tcp', 'data', 'fcs']];
const t = ru
  ? {
      layer: ['приложение', 'транспорт (TCP)', 'сеть (IP)', 'канал (Ethernet)'],
      total: [`${n(data)} ${B}`, `сегмент ${n(segment)} ${B}`, `пакет ${n(packet)} ${B}`, `кадр ${n(frame)} ${B}`],
      name: { eth: 'Ethernet', ip: 'IP', tcp: 'TCP', data: 'данные', fcs: 'FCS' } as Record<string, string>,
      nameNarrow: { eth: 'Eth', ip: 'IP', tcp: 'TCP', data: 'данные', fcs: 'FCS' } as Record<string, string>,
      wire: [`в линии ещё 8 ${B} преамбулы и 12 ${B} паузы: ${n(wire)} ${B}, из них данных ${(100 * share).toFixed(1)}%`],
      wireNarrow: [`+ 8 ${B} преамбулы + 12 ${B} паузы:`, `${n(wire)} ${B} в линии, данных ${(100 * share).toFixed(1)}%`],
      recv: ['приём: каждый уровень снимает свой заголовок, в обратном порядке, и передаёт остаток вверх'],
      recvNarrow: ['приём: каждый уровень снимает', 'свой заголовок, в обратном порядке'],
      steps: [
        `приложение передаёт TCP ${n(data)} байт данных`,
        'TCP добавляет 20-байтный заголовок: порты, номера последовательности и подтверждения, окно',
        'IP добавляет 20-байтный заголовок: адреса отправителя и получателя, TTL, номер протокола',
        'Ethernet добавляет 14-байтный заголовок с MAC-адресами и 4-байтную контрольную сумму (FCS)',
        'получатель снимает заголовки в обратном порядке и отдаёт данные вверх',
      ],
    }
  : {
      layer: ['application', 'transport (TCP)', 'internet (IP)', 'link (Ethernet)'],
      total: [`${n(data)} ${B}`, `segment ${n(segment)} ${B}`, `packet ${n(packet)} ${B}`, `frame ${n(frame)} ${B}`],
      name: { eth: 'Ethernet', ip: 'IP', tcp: 'TCP', data: 'data', fcs: 'FCS' } as Record<string, string>,
      nameNarrow: { eth: 'Eth', ip: 'IP', tcp: 'TCP', data: 'data', fcs: 'FCS' } as Record<string, string>,
      wire: [`on the wire also an 8 ${B} preamble and a 12 ${B} gap: ${n(wire)} ${B}, of which ${(100 * share).toFixed(1)} % is data`],
      wireNarrow: [`+ 8 ${B} preamble + 12 ${B} gap:`, `${n(wire)} ${B} on the wire, ${(100 * share).toFixed(1)} % data`],
      recv: ['receiving: each layer removes its own header, in reverse order, and passes the rest up'],
      recvNarrow: ['receiving: each layer removes', 'its own header, in reverse order'],
      steps: [
        `the application hands ${n(data)} bytes of data to TCP`,
        'TCP adds a 20-byte header: ports, sequence and acknowledgement numbers, window',
        'IP adds a 20-byte header: source and destination addresses, TTL, protocol number',
        'Ethernet adds a 14-byte header with the MAC addresses and a 4-byte checksum (FCS)',
        'the receiver strips the headers in reverse order and passes the data up',
      ],
    };

interface Layout {
  cls: string; W: number; H: number; wide: boolean;
  x: Record<Part['key'], [number, number]>;
  rowY: (k: number) => number; bh: number;
  labelAt: (k: number) => [number, number]; badgeAt: (k: number) => [number, number];
  totalAt: (k: number) => [number, number, 'start' | 'end'];
  arrowX: number; arrow: (k: number) => [number, number];
  wireY: number; recvY: number; lineGap: number; names: Record<string, string>;
  wire: string[]; recv: string[];
}
const layouts: Layout[] = [
  {
    cls: 'fig-wide', W: 760, H: 348, wide: true,
    x: { eth: [160, 225], ip: [225, 290], tcp: [290, 355], data: [355, 575], fcs: [575, 630] },
    rowY: (k) => 26 + k * 66, bh: 40,
    labelAt: (k) => [36, 26 + k * 66 + 25], badgeAt: (k) => [18, 26 + k * 66 + 20],
    totalAt: (k) => [644, 26 + k * 66 + 25, 'start'],
    arrowX: 465, arrow: (k) => [26 + k * 66 + 42, 26 + (k + 1) * 66 - 3],
    wireY: 300, recvY: 330, lineGap: 18, names: t.name, wire: t.wire, recv: t.recv,
  },
  {
    cls: 'fig-narrow seq-narrow', W: 360, H: 494, wide: false,
    x: { eth: [8, 64], ip: [64, 112], tcp: [112, 166], data: [166, 300], fcs: [300, 352] },
    rowY: (k) => 44 + k * 92, bh: 42,
    labelAt: (k) => [32, 44 + k * 92 - 11], badgeAt: (k) => [16, 44 + k * 92 - 16],
    totalAt: (k) => [352, 44 + k * 92 - 11, 'end'],
    arrowX: 233, arrow: (k) => [44 + k * 92 + 44, 44 + k * 92 + 66],
    wireY: 392, recvY: 448, lineGap: 20, names: t.nameNarrow, wire: t.wireNarrow, recv: t.recvNarrow,
  },
];
const hasArrow = rows.map((_, k) => k !== rows.length - 1);
const partOf = (key: Part['key']) => parts.find((p) => p.key === key)!;
const id = 'encapsulation';
---

<Figure
  id={id}
  title={ru ? 'Инкапсуляция: каждый уровень оборачивает данные своим заголовком' : 'Encapsulation: each layer wraps the data in its own header'}
  caption={ru
    ? `Один полный TCP-сегмент в сети Ethernet. Приложение отдаёт ${n(data)} байт (1); TCP добавляет 20-байтный заголовок, получается сегмент из ${n(segment)} байт (2); IP добавляет ещё 20 байт, и пакет в ${n(packet)} байт ровно заполняет MTU Ethernet (3); Ethernet добавляет 14 байт заголовка спереди и 4 байта контрольной суммы сзади, получается кадр из ${n(frame)} байт (4). Получатель снимает заголовки в обратном порядке (5). Ширины прямоугольников не пропорциональны размерам: данные в 73 раза длиннее заголовка TCP.`
    : `One full TCP segment on Ethernet. The application hands over ${n(data)} bytes (1); TCP adds a 20-byte header, giving a ${n(segment)}-byte segment (2); IP adds another 20 bytes, and the ${n(packet)}-byte packet exactly fills the Ethernet MTU (3); Ethernet adds a 14-byte header in front and a 4-byte checksum behind, giving a ${n(frame)}-byte frame (4). The receiver strips the headers in reverse order (5). The boxes are not drawn to scale: the data is 73 times as long as the TCP header.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Заголовки четырёх уровней вокруг данных приложения' : 'The headers of four layers around the application data'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? `Четыре строки, сверху вниз: приложение, TCP, IP, Ethernet. В первой строке только данные, ${n(data)} байт. В каждой следующей слева добавляется заголовок: TCP 20 байт, IP 20 байт, Ethernet 14 байт, а в последней строке справа ещё 4 байта FCS. Справа подписаны размеры: сегмент ${n(segment)}, пакет ${n(packet)}, кадр ${n(frame)} байт. Внизу: с преамбулой и паузой кадр занимает в линии ${n(wire)} байт, из них ${(100 * share).toFixed(1)}% — данные.`
        : `Four rows, top to bottom: application, TCP, IP, Ethernet. The first row holds only the data, ${n(data)} bytes. Each row below adds a header on the left: TCP 20 bytes, IP 20 bytes, Ethernet 14 bytes, and the last row also has a 4-byte FCS on the right. Sizes are written at the right: segment ${n(segment)}, packet ${n(packet)}, frame ${n(frame)} bytes. Below: with the preamble and gap the frame occupies ${n(wire)} bytes on the wire, ${(100 * share).toFixed(1)} percent of it data.`}</desc>
      {rows.map((keys, k) => (
        <g data-s={String(k + 1)}>
          <text class="f-small" x={L.labelAt(k)[0]} y={L.labelAt(k)[1]} style="font-weight: 650">{t.layer[k]}</text>
          <text class="f-small f-t-muted" x={L.totalAt(k)[0]} y={L.totalAt(k)[1]} text-anchor={L.totalAt(k)[2]}>{t.total[k]}</text>
          {keys.map((key) => {
            const p = partOf(key);
            const [x0, x1] = L.x[key];
            const y = L.rowY(k);
            return (
              <g>
                <rect x={x0} y={y} width={x1 - x0} height={L.bh} style={`fill: ${toneVar[p.tone]}; fill-opacity: 0.14; stroke: ${toneVar[p.tone]}; stroke-width: 1.3`} />
                <text class="f-small" x={(x0 + x1) / 2} y={y + 17} text-anchor="middle" style="font-weight: 650">{L.names[key]}</text>
                <text class="f-small f-t-muted" x={(x0 + x1) / 2} y={y + 34} text-anchor="middle">{`${n(p.size)} ${B}`}</text>
              </g>
            );
          })}
          {hasArrow[k] && <path class="f-line f-muted" d={`M ${L.arrowX} ${L.arrow(k)[0]} V ${L.arrow(k)[1]}`} marker-end="url(#f-arrow-muted)" />}
          <Badge x={L.badgeAt(k)[0]} y={L.badgeAt(k)[1]} n={k + 1} />
        </g>
      ))}
      <g data-s="4">
        {L.wire.map((line, i) => (
          <text class="f-small f-t-muted" x={L.wide ? 160 : 8} y={L.wireY + i * L.lineGap}>{line}</text>
        ))}
      </g>
      <g data-s="5">
        {L.recv.map((line, i) => (
          <text class="f-small" x={L.wide ? 36 : 32} y={L.recvY + i * L.lineGap}>{line}</text>
        ))}
        <Badge x={L.wide ? 18 : 16} y={L.recvY - 4} n={5} />
      </g>
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
