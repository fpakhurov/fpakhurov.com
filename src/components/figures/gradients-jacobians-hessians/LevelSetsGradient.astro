---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// q(x) = x₁² + x₁x₂ + 2x₂² = xᵀAx with A = [[1, 0.5], [0.5, 2]], gradient 2Ax = (2x₁ + x₂, x₁ + 4x₂).
// Level sets are ellipses with axes along the eigenvectors of A. At (1, 1): q = 4, ∇q = (3, 5), |∇q| = √34.
const A = [[1, 0.5], [0.5, 2]];
const q = ([a, b]: [number, number]) => a * a + a * b + 2 * b * b;
const grad = ([a, b]: [number, number]) => [2 * a + b, a + 4 * b] as [number, number];
const tr = A[0][0] + A[1][1], dt = A[0][0] * A[1][1] - A[0][1] * A[1][0];
const lam = [(tr - Math.sqrt(tr * tr - 4 * dt)) / 2, (tr + Math.sqrt(tr * tr - 4 * dt)) / 2];
// eigenvector of the small eigenvalue: (A − λI)v = 0 → v = (A₀₁, λ − A₀₀)
const v0n = Math.hypot(A[0][1], lam[0] - A[0][0]);
const v0: [number, number] = [A[0][1] / v0n, (lam[0] - A[0][0]) / v0n], v1: [number, number] = [-v0[1], v0[0]];
const ellipse = (c: number, m = 180) => Array.from({ length: m + 1 }, (_, i) => {
  const th = (2 * Math.PI * i) / m, a = Math.sqrt(c / lam[0]) * Math.cos(th), b = Math.sqrt(c / lam[1]) * Math.sin(th);
  return [a * v0[0] + b * v1[0], a * v0[1] + b * v1[1]] as [number, number];
});
const P: [number, number] = [1, 1], G = grad(P);
if (q(P) !== 4 || G.join() !== '3,5' || Math.hypot(...G).toFixed(3) !== '5.831') throw new Error('LevelSetsGradient: the point drifted from the note');
if (Math.abs(q(ellipse(4)[37]) - 4) > 1e-9) throw new Error('LevelSetsGradient: the ellipse is not a level set');
const angle = (Math.acos((G[0] + G[1]) / (Math.hypot(...G) * Math.SQRT2)) * 180) / Math.PI;
if (angle.toFixed(0) !== '14') throw new Error('LevelSetsGradient: angle drifted from the note');
const levels = [1, 2, 4, 7];
const k = 0.11; // arrow length per unit of gradient
const arrowsAt = ellipse(4, 10).slice(0, 10).filter((p) => Math.hypot(p[0] - P[0], p[1] - P[1]) > 0.5);
const tangent: [number, number] = [5 / Math.sqrt(34), -3 / Math.sqrt(34)];
const id = 'level-sets-gradient';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 320, x0: 16, x1: 436, y0: 14, y1: 294, short: false },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 330, x0: 10, x1: 350, y0: 10, y1: 237, short: true },
];
const t = ru
  ? { g: '∇q(1, 1) = (3, 5)', gs: '∇q', tan: 'касательная: D = 0', tans: 'D = 0', min: 'минимум', l1: 'Стрелки: градиенты на линии q = 4,', l2: 'каждая перпендикулярна ей.', l3: 'Точечная линия: направление к минимуму.' }
  : { g: '∇q(1, 1) = (3, 5)', gs: '∇q', tan: 'tangent: D = 0', tans: 'D = 0', min: 'minimum', l1: 'Arrows: gradients on the line q = 4,', l2: 'each perpendicular to it.', l3: 'Dotted: the direction to the minimum.' };
---

<Figure
  id={id}
  title={ru ? 'Линии уровня и градиенты' : 'Level sets and gradients'}
  caption={ru
    ? 'Линии уровня q(x) = x₁² + x₁x₂ + 2x₂² для q = 1, 2, 4, 7 — эллипсы с осями вдоль собственных векторов матрицы квадратичной формы. Серые стрелки — градиенты в точках линии q = 4 (длина пропорциональна |∇q|): каждая перпендикулярна линии и смотрит наружу, в сторону роста. В точке (1, 1) градиент (3, 5) имеет длину √34 = 5.83, а производная вдоль касательной равна нулю. Направление спуска −∇q отклонено на 14° от направления к минимуму в начале координат: так начинается зигзаг градиентного спуска на вытянутых линиях уровня.'
    : 'Level sets of q(x) = x₁² + x₁x₂ + 2x₂² for q = 1, 2, 4, 7: ellipses with axes along the eigenvectors of the matrix of the quadratic form. The grey arrows are gradients at points of the level set q = 4 (length proportional to |∇q|): each is perpendicular to the curve and points outward, uphill. At (1, 1) the gradient (3, 5) has length √34 = 5.83 and the derivative along the tangent is zero. The descent direction −∇q is 14° away from the direction to the minimum at the origin, which is how the zigzag of gradient descent on elongated level sets begins.'}
>
  {layouts.map((L) => {
    const ux = 3.15, uy = (ux * (L.y1 - L.y0)) / (L.x1 - L.x0);
    const sx = scale([-ux, ux], [L.x0, L.x1]), sy = scale([-uy, uy], [L.y1, L.y0]);
    const S = (p: [number, number]) => [sx(p[0]), sy(p[1])] as [number, number];
    const seg = (a: [number, number], b: [number, number]) => `M ${S(a)[0].toFixed(1)} ${S(a)[1].toFixed(1)} L ${S(b)[0].toFixed(1)} ${S(b)[1].toFixed(1)}`;
    const tip: [number, number] = [P[0] + k * G[0], P[1] + k * G[1]];
    const ta: [number, number] = [P[0] - 0.75 * tangent[0], P[1] - 0.75 * tangent[1]], tb: [number, number] = [P[0] + 0.75 * tangent[0], P[1] + 0.75 * tangent[1]];
    const ty = L.short ? L.y1 + 30 : L.y0 + 150, tx = L.short ? L.x0 : L.x1 + 24;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Эллиптические линии уровня с перпендикулярными им градиентами' : 'Elliptical level sets with gradients perpendicular to them'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Четыре вложенных наклонённых эллипса вокруг начала координат. На третьем эллипсе стрелки направлены наружу под прямым углом к кривой; в точке (1, 1) выделены красная стрелка градиента и пунктирная касательная.' : 'Four nested tilted ellipses around the origin. On the third ellipse arrows point outward at right angles to the curve; at (1, 1) a red gradient arrow and a dashed tangent are highlighted.'}</desc>
        <path class="f-grid" d={`M ${L.x0} ${sy(0)} H ${L.x1} M ${sx(0)} ${L.y0} V ${L.y1}`} />
        {levels.map((c) => <path class={c === 4 ? 'f-line f-blue' : 'f-thin f-blue'} d={polyline(ellipse(c).map(S))} />)}
        {levels.map((c) => {
          const p = ellipse(c, 360)[306];
          return <text class="f-small f-t-blue f-halo" x={S(p)[0] + 4} y={S(p)[1] + 14}>{`q = ${c}`}</text>;
        })}
        {arrowsAt.map((p) => <path class="f-thin f-muted" d={seg(p, [p[0] + k * grad(p)[0], p[1] + k * grad(p)[1]])} marker-end="url(#f-arrow-muted)" />)}
        <path class="f-thin f-muted f-dot" d={seg(P, [0, 0])} />
        <circle cx={sx(0)} cy={sy(0)} r="3.5" class="f-fill-ink" />
        <text class="f-small f-halo" x={sx(0) - 6} y={sy(0) + 16} text-anchor="end">{t.min}</text>
        <path class="f-line f-dash" d={seg(ta, tb)} />
        <path class="f-line f-red f-bold" d={seg(P, tip)} marker-end="url(#f-arrow-red)" />
        <circle cx={S(P)[0]} cy={S(P)[1]} r="4" class="f-solid-red" />
        <text class="f-small f-t-red f-halo" x={S(tip)[0] + 8} y={S(tip)[1] + 4}>{L.short ? t.gs : t.g}</text>
        <text class="f-small f-halo" x={S(tb)[0] + 6} y={S(tb)[1] + 6}>{L.short ? t.tans : t.tan}</text>
        <text class="f-small f-t-muted" x={tx} y={ty}>{t.l1}</text>
        <text class="f-small f-t-muted" x={tx} y={ty + 20}>{t.l2}</text>
        <text class="f-small f-t-muted" x={tx} y={ty + 40}>{t.l3}</text>
      </svg>
    );
  })}
</Figure>
