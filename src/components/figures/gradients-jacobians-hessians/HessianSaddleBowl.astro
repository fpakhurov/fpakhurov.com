---
import Figure from '../Figure.astro';
import { polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// c(x) = x₁³ − 3x₁ + x₂². Critical points (±1, 0); Hessian diag(6x₁, 2): diag(6, 2) at (1, 0), a minimum with c = −2;
// diag(−6, 2) at (−1, 0), a saddle with c = 2. A level set c = L is x₂ = ±√g(x₁) with g(x₁) = L + 3x₁ − x₁³.
const c = (a: number, b: number) => a ** 3 - 3 * a + b * b;
const hess = (a: number) => [6 * a, 2];
if (c(1, 0) !== -2 || c(-1, 0) !== 2 || hess(1).join() !== '6,2' || hess(-1).join() !== '-6,2') throw new Error('HessianSaddleBowl: critical points drifted from the note');
const X0 = -2.3, X1 = 2.3, Y = 1.6;
const levels = [-1.5, -0.75, 0.25, 1.25, 2, 3];
// pieces of the level set: maximal intervals of [X0, X1] where g ≥ 0, each drawn as upper branch then lower branch
const pieces = (L: number) => {
  const g = (x: number) => L + 3 * x - x ** 3;
  const N = 2000, cuts: number[] = [X0];
  for (let i = 0; i < N; i += 1) {
    let a = X0 + ((X1 - X0) * i) / N, b = X0 + ((X1 - X0) * (i + 1)) / N;
    if (g(a) * g(b) < 0) {
      for (let k = 0; k < 60; k += 1) { const m = (a + b) / 2; if (g(a) * g(m) <= 0) b = m; else a = m; }
      cuts.push((a + b) / 2);
    }
  }
  cuts.push(X1);
  const out: [number, number][][] = [];
  for (let i = 0; i + 1 < cuts.length; i += 1) {
    const a = cuts[i], b = cuts[i + 1];
    if (g((a + b) / 2) <= 0) continue;
    const xs = Array.from({ length: 161 }, (_, j) => a + ((b - a) * (1 - Math.cos((Math.PI * j) / 160))) / 2);
    for (const extra of [-1, 1]) if (extra > a && extra < b) xs.push(extra);
    xs.sort((u, v) => u - v);
    const up = xs.map((x) => [x, Math.sqrt(Math.max(g(x), 0))] as [number, number]);
    out.push(up.concat(up.slice().reverse().map(([x, y]) => [x, -y] as [number, number])));
  }
  return out;
};
const ovalCheck = pieces(-1.5);
if (ovalCheck.length !== 2) throw new Error('HessianSaddleBowl: expected an oval and a left branch at level −1.5');
const id = 'hessian-saddle-bowl';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 330, x0: 16, y0: 12, unit: 95, tx: 476, ty: 70, short: false },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 350, x0: 10, y0: 10, unit: 73.9, tx: 10, ty: 272, short: true },
];
const t = ru
  ? { min: 'минимум в (1, 0): ∇²c = diag(6, 2)', minr: 'оба собственных значения > 0: чаша', sad: 'седло в (−1, 0): ∇²c = diag(−6, 2)', sadr: 'знаки разные: вверх по x₂, вниз по x₁', lev: 'оранжевая линия: уровень c = 2 через седло', mins: 'минимум: diag(6, 2), чаша', sads: 'седло: diag(−6, 2)', levs: 'оранжевая: уровень c = 2' }
  : { min: 'minimum at (1, 0): ∇²c = diag(6, 2)', minr: 'both eigenvalues > 0: a bowl', sad: 'saddle at (−1, 0): ∇²c = diag(−6, 2)', sadr: 'mixed signs: up along x₂, down along x₁', lev: 'amber: the level c = 2 through the saddle', mins: 'minimum: diag(6, 2), a bowl', sads: 'saddle: diag(−6, 2)', levs: 'amber: the level c = 2' };
// eigenvector arrows: green where the Hessian's eigenvalue is positive, red where it is negative
const arrows = [
  { x: 1, y: 0, dx: 0.5, dy: 0, cls: 'f-line f-green', mk: 'f-arrow-green' },
  { x: 1, y: 0, dx: 0, dy: 0.5, cls: 'f-line f-green', mk: 'f-arrow-green' },
  { x: -1, y: 0, dx: -0.5, dy: 0, cls: 'f-line f-red', mk: 'f-arrow-red' },
  { x: -1, y: 0, dx: 0, dy: 0.5, cls: 'f-line f-green', mk: 'f-arrow-green' },
];
// text rows beside (wide) or under (narrow) the plot; the wide layout leaves a gap between the two groups
const rows = (short: boolean, y0: number) => short
  ? [[t.mins, 'f-t-green'], [t.sads, 'f-t-red'], [t.levs, 'f-t-amber']].map(([s, cls], i) => ({ s, cls, y: y0 + 22 * i }))
  : [[t.min, 'f-t-green', 0], [t.minr, 'f-t-muted', 22], [t.sad, 'f-t-red', 70], [t.sadr, 'f-t-muted', 92], [t.lev, 'f-t-amber', 140]].map(([s, cls, dy]) => ({ s: String(s), cls: String(cls), y: y0 + Number(dy) }));
---

<Figure
  id={id}
  title={ru ? 'Чаша и седло одной функции' : 'A bowl and a saddle of one function'}
  caption={ru
    ? 'Линии уровня c(x) = x₁³ − 3x₁ + x₂² для c = −1.5, −0.75, 0.25, 1.25, 2, 3. Около (1, 0) гессиан diag(6, 2) положительно определён: линии уровня — овалы вокруг минимума c = −2, функция растёт по обоим собственным направлениям (зелёные стрелки). В (−1, 0) гессиан diag(−6, 2) имеет собственные значения разных знаков: вдоль x₁ функция убывает (красная стрелка), вдоль x₂ растёт, и линия уровня c = 2 (оранжевая) пересекает сама себя в седловой точке.'
    : 'Level sets of c(x) = x₁³ − 3x₁ + x₂² for c = −1.5, −0.75, 0.25, 1.25, 2, 3. Near (1, 0) the Hessian diag(6, 2) is positive definite: the level sets are ovals around the minimum c = −2, and the function rises along both eigenvector directions (green arrows). At (−1, 0) the Hessian diag(−6, 2) has eigenvalues of both signs: along x₁ the function falls (red arrow), along x₂ it rises, and the level set c = 2 (amber) crosses itself at the saddle point.'}
>
  {layouts.map((L) => {
    const sx = (x: number) => L.x0 + L.unit * (x - X0), sy = (y: number) => L.y0 + L.unit * (Y - y);
    const S = (q: [number, number][]) => polyline(q.map(([x, y]) => [sx(x), sy(y)]));
    const clip = `${id}-clip-${L.W}`;
    const w = L.unit * (X1 - X0), h = L.unit * 2 * Y;
    const lines = rows(L.short, L.ty);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Линии уровня кубической функции с минимумом и седлом' : 'Level sets of a cubic function with a minimum and a saddle'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Справа вложенные овалы вокруг минимума; слева линии, огибающие седло, и одна линия уровня, пересекающая себя в седле крестом. Стрелки показывают собственные направления гессиана.' : 'On the right, nested ovals around the minimum; on the left, curves bending around the saddle and one level set crossing itself there in an X. Arrows show the eigenvector directions of the Hessian.'}</desc>
        <defs><clipPath id={clip}><rect x={L.x0} y={L.y0} width={w} height={h} /></clipPath></defs>
        <rect class="f-box-soft" x={L.x0} y={L.y0} width={w} height={h} style="fill: none" />
        <path class="f-grid" d={`M ${sx(X0)} ${sy(0)} H ${sx(X1)} M ${sx(0)} ${sy(-Y)} V ${sy(Y)}`} />
        <g clip-path={`url(#${clip})`}>
          {levels.flatMap((lv) => pieces(lv).map((pc) => <path class={lv === 2 ? 'f-line f-amber' : 'f-thin f-blue'} d={S(pc)} />))}
        </g>
        {arrows.map((a) => <path class={a.cls} d={`M ${sx(a.x)} ${sy(a.y)} L ${sx(a.x + a.dx)} ${sy(a.y + a.dy)}`} marker-end={`url(#${a.mk})`} />)}
        <circle cx={sx(1)} cy={sy(0)} r="4" class="f-solid-green" />
        <circle cx={sx(-1)} cy={sy(0)} r="4" class="f-solid-red" />
        <text class="f-small f-t-green f-halo" x={sx(1.55)} y={sy(0) - 6}>{'λ = 6'}</text>
        <text class="f-small f-t-green f-halo" x={sx(1) + 6} y={sy(0.55)}>{'λ = 2'}</text>
        <text class="f-small f-t-red f-halo" x={sx(-1.55)} y={sy(0) - 6} text-anchor="end">{'λ = −6'}</text>
        <text class="f-small f-t-green f-halo" x={sx(-1) + 6} y={sy(0.55)}>{'λ = 2'}</text>
        {lines.map((r) => <text class={`f-small ${r.cls}`} x={L.tx} y={r.y}>{r.s}</text>)}
      </svg>
    );
  })}
</Figure>
