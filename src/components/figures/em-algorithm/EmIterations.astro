---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { sample, em, ellipse, type Comp, type P } from './gmm';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// EM for a three-component Gaussian mixture on 300 points drawn from three Gaussians (120, 80 and 100 points; an
// elongated, a small and a wide one; seed 1). The start is deliberately poor: the three means are the first three data
// points, all from the elongated component, with identity covariances and equal weights.
const { pts } = sample(1, [[-2.3, 1.2], [2.0, 2.0], [1.2, -1.8]], [[1.0, 0.75, 0.9], [0.25, 0, 0.25], [1.6, -0.2, 0.5]], [120, 80, 100]);
const n = pts.length;
const init: Comp[] = [0, 1, 2].map((i) => ({ pi: 1 / 3, mu: [...pts[i]] as P, S: [1, 0, 1] }));
const hist = em(pts, init, 25);
const shown = [0, 1, 5, 25];
const avg = hist.map((h) => h.ll / n);
if (shown.map((t) => avg[t].toFixed(3)).join() !== '-7.020,-3.881,-3.434,-3.223') throw new Error('EmIterations: log-likelihoods drifted from the note');
if (!avg.every((v, t) => t === 0 || v >= avg[t - 1] - 1e-12)) throw new Error('EmIterations: the log-likelihood must not decrease');
const fin = hist[25].comps;
if (fin.map((c) => c.pi.toFixed(2)).join() !== '0.26,0.40,0.33') throw new Error('EmIterations: final weights drifted from the note');

const tones = ['blue', 'red', 'green'];
const dom = { x: [-5.5, 5.5] as [number, number], y: [-4.5, 5] as [number, number] };
const t = ru
  ? { titles: ['начало', 'итерация 1', 'итерация 5', 'итерация 25'], ll: 'ℓ / n' }
  : { titles: ['start', 'iteration 1', 'iteration 5', 'iteration 25'], ll: 'ℓ / n' };
const id = 'em-iterations';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 222, boxes: [0, 1, 2, 3].map((i) => [12 + i * 188, 30, 172, 148.5]) },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 414, boxes: [0, 1, 2, 3].map((i) => [6 + (i % 2) * 178, 30 + Math.floor(i / 2) * 204, 170, 146.8]) },
];
const fmt = (v: number) => v.toFixed(3).replace('-', '−');
---

<Figure
  id={id}
  title={ru ? 'EM для смеси трёх гауссиан' : 'EM for a mixture of three Gaussians'}
  caption={ru
    ? `300 точек из трёх гауссиан: вытянутой (120 точек), маленькой (80) и широкой (100). Старт: три средних — первые три точки выборки, все из вытянутого облака, ковариации единичные, веса по 1/3. Эллипсы — расстояния Махаланобиса 1 и 2 для каждой компоненты; цвет точки — компонента с наибольшей ответственностью, насыщенность — величина этой ответственности. Средний логарифм правдоподобия ℓ/n не убывает: ${shown.map((s) => fmt(avg[s])).join(' → ')}. К 25-й итерации веса ${fin.map((c) => c.pi.toFixed(2)).join(', ')} близки к истинным 0.40, 0.27, 0.33 (в другом порядке).`
    : `300 points from three Gaussians: an elongated one (120 points), a small one (80) and a wide one (100). Start: the three means are the first three data points, all from the elongated cloud, with identity covariances and weights 1/3. The ellipses are Mahalanobis distances 1 and 2 of each component; each point takes the colour of the component with the largest responsibility, faded when that responsibility is low. The average log-likelihood ℓ/n never decreases: ${shown.map((s) => fmt(avg[s])).join(' → ')}. By iteration 25 the weights ${fin.map((c) => c.pi.toFixed(2)).join(', ')} are close to the true 0.40, 0.27, 0.33 (in another order).`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Четыре шага EM-алгоритма' : 'Four stages of EM'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? `Четыре панели: облако точек и эллипсы трёх компонент; средний логарифм правдоподобия растёт: ${shown.map((s) => fmt(avg[s])).join(', ')}.` : `Four panels of a point cloud with the ellipses of three components; the average log-likelihood rises: ${shown.map((s) => fmt(avg[s])).join(', ')}.`}</desc>
      <defs>
        {L.boxes.map(([bx, by, bw, bh], i) => <clipPath id={`${id}-${L.W}-clip-${i}`}><rect x={bx} y={by} width={bw} height={bh} /></clipPath>)}
      </defs>
      {shown.map((s, i) => {
        const [bx, by, bw, bh] = L.boxes[i];
        const sx = scale(dom.x, [bx, bx + bw]), sy = scale(dom.y, [by + bh, by]);
        const S = (p: P) => [sx(p[0]), sy(p[1])] as [number, number];
        const h = hist[s];
        return (
          <g>
            <text class="f-small" x={bx + bw / 2} y={by - 9} text-anchor="middle">{t.titles[i]}</text>
            <rect x={bx} y={by} width={bw} height={bh} class="f-grid" />
            <g clip-path={`url(#${id}-${L.W}-clip-${i})`}>
              {pts.map((p, j) => {
                const r = h.r[j], k = r.indexOf(Math.max(...r));
                return <circle cx={sx(p[0]).toFixed(1)} cy={sy(p[1]).toFixed(1)} r="1.9" style={`fill: var(--fig-${tones[k]}); fill-opacity: ${(0.15 + 0.65 * (Math.max(...r) - 1 / 3) * 1.5).toFixed(2)}`} />;
              })}
              {h.comps.map((c, k) => (
                <g>
                  <path d={polyline(ellipse(c.mu, c.S, 1).map(S))} class={`f-line f-${tones[k]}`} />
                  <path d={polyline(ellipse(c.mu, c.S, 2).map(S))} class={`f-thin f-${tones[k]} f-dash`} />
                  <circle cx={sx(c.mu[0]).toFixed(1)} cy={sy(c.mu[1]).toFixed(1)} r="3.5" style={`fill: var(--fig-${tones[k]}); stroke: var(--paper); stroke-width: 1.4`} />
                </g>
              ))}
            </g>
            <text class="f-small f-t-muted" x={bx + bw / 2} y={by + bh + 19} text-anchor="middle">{`${t.ll} = ${fmt(avg[s])}`}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
