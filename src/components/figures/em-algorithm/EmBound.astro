---
import Figure from '../Figure.astro';
import { scale, plot } from '../geometry';
import { loglik, bound, resp, emStep, xs } from './gmm';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The mixture ½ N(0, 1) + ½ N(θ, 1) with one unknown mean θ, fitted to seven points by EM from θ0 = 0.6.
// Each E-step builds the lower bound L(q, θ) with q the posterior at the current θ: it touches ℓ there.
// Each M-step moves θ to the maximum of that bound, the responsibility-weighted mean of the points.
const th: number[] = [0.6];
for (let i = 0; i < 60; i++) th.push(emStep(th[th.length - 1]));
const ll = th.map(loglik);
if (th.slice(0, 3).map((v) => v.toFixed(3)).join() !== '0.600,1.662,2.168' || th[60].toFixed(3) !== '2.540') throw new Error('EmBound: EM steps drifted from the note');
if (ll.slice(0, 3).map((v) => v.toFixed(2)).join() !== '-16.35,-12.83,-12.14' || ll[60].toFixed(2) !== '-12.00') throw new Error('EmBound: log-likelihoods drifted from the note');
const r0 = resp(th[0]), r1 = resp(th[1]);
if (Math.abs(bound(th[0], r0) - ll[0]) > 1e-9 || Math.abs(bound(th[1], r1) - ll[1]) > 1e-9) throw new Error('EmBound: the bound must touch ℓ');
if (!(bound(th[1], r0) > bound(th[1] - 0.01, r0) && bound(th[1], r0) > bound(th[1] + 0.01, r0))) throw new Error('EmBound: θ1 must maximize the first bound');

const dom = { x: [-1, 5] as [number, number], y: [-24, -11] as [number, number] };
const t = ru
  ? { x: 'неизвестное среднее θ', ll: 'ℓ(θ)', b0: 'L(q₀, θ)', b1: 'L(q₁, θ)', data: 'данные' }
  : { x: 'unknown mean θ', ll: 'ℓ(θ)', b0: 'L(q₀, θ)', b1: 'L(q₁, θ)', data: 'data' };
const id = 'em-bound';
const layouts = [
  { cls: 'fig-wide fig-medium', W: 600, H: 330, x0: 56, x1: 580, y0: 20, y1: 262 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 330, x0: 44, x1: 350, y0: 20, y1: 262 },
];
const marks = [
  { v: th[0], label: 'θ₀', tone: 'red' },
  { v: th[1], label: 'θ₁', tone: 'amber' },
  { v: th[2], label: 'θ₂', tone: 'muted' },
];
---

<Figure
  id={id}
  title={ru ? 'EM как подъём по нижней оценке' : 'EM climbs a lower bound'}
  caption={ru
    ? `Смесь ½ N(0, 1) + ½ N(θ, 1) с одним неизвестным средним θ, семь точек (засечки внизу). Чёрная кривая — логарифм правдоподобия ℓ(θ). E-шаг в точке θ₀ = 0.6 строит нижнюю оценку L(q₀, θ) (красная): q₀ — апостериорное распределение принадлежностей при θ₀, и оценка касается ℓ в θ₀. M-шаг переходит в максимум оценки, θ₁ = ${th[1].toFixed(3)}; там ℓ уже выше, чем на оценке. Следующая оценка L(q₁, θ) (жёлтая) касается ℓ в θ₁, её максимум — θ₂ = ${th[2].toFixed(3)}. ℓ растёт: ${ll.slice(0, 3).map((v) => v.toFixed(2)).join(' → ')}, и EM сходится к максимуму ℓ в θ = ${th[60].toFixed(2)} (ℓ = ${ll[60].toFixed(2)}).`
    : `The mixture ½ N(0, 1) + ½ N(θ, 1) with one unknown mean θ, seven points (ticks at the bottom). Black: the log-likelihood ℓ(θ). The E-step at θ₀ = 0.6 builds the lower bound L(q₀, θ) (red), with q₀ the posterior over memberships at θ₀; the bound touches ℓ at θ₀. The M-step moves to the maximum of the bound, θ₁ = ${th[1].toFixed(3)}, where ℓ is already above the bound. The next bound L(q₁, θ) (amber) touches ℓ at θ₁ and peaks at θ₂ = ${th[2].toFixed(3)}. ℓ rises, ${ll.slice(0, 3).map((v) => v.toFixed(2)).join(' → ')}, and EM converges to the maximum of ℓ at θ = ${th[60].toFixed(2)} (ℓ = ${ll[60].toFixed(2)}).`}
>
  {layouts.map((L) => {
    const sx = scale(dom.x, [L.x0, L.x1]), sy = scale(dom.y, [L.y1, L.y0]);
    const clip = `${id}-${L.W}-clip`;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Логарифм правдоподобия и две нижние оценки' : 'The log-likelihood and two lower bounds'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Кривая ℓ(θ) с максимумом около 2.54 и две параболы под ней, касающиеся её в 0.6 и в 1.66; максимумы парабол — следующие точки EM.' : 'The curve ℓ(θ) peaking near 2.54 and two parabolas below it, touching it at 0.6 and at 1.66; the peaks of the parabolas are the next EM iterates.'}</desc>
        <defs><clipPath id={clip}><rect x={L.x0} y={L.y0} width={L.x1 - L.x0} height={L.y1 - L.y0} /></clipPath></defs>
        <path class="f-axis" d={`M ${L.x0} ${L.y1} H ${L.x1}`} />
        {[-1, 0, 1, 2, 3, 4, 5].map((v) => <text class="f-note" x={sx(v)} y={L.y1 + 18} text-anchor="middle">{String(v).replace('-', '−')}</text>)}
        {[-23, -20, -17, -14, -11].map((v) => <g><path class="f-grid" d={`M ${L.x0} ${sy(v)} H ${L.x1}`} /><text class="f-note" x={L.x0 - 6} y={sy(v) + 4} text-anchor="end">{String(v).replace('-', '−')}</text></g>)}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y1 + 40} text-anchor="middle">{t.x}</text>
        {xs.map((x) => <path class="f-thin" d={`M ${sx(x)} ${L.y1} v -9`} style="stroke-width: 1.8" />)}
        <g clip-path={`url(#${clip})`}>
          <path class="f-line f-red" d={plot((v) => bound(v, r0), dom.x[0], dom.x[1], sx, sy)} />
          <path class="f-line f-amber" d={plot((v) => bound(v, r1), dom.x[0], dom.x[1], sx, sy)} />
          <path class="f-line f-bold" d={plot(loglik, dom.x[0], dom.x[1], sx, sy)} />
        </g>
        {marks.map((m) => <path class={`f-thin f-${m.tone} f-dash`} d={`M ${sx(m.v)} ${L.y1} V ${sy(loglik(m.v))}`} />)}
        {marks.map((m, i) => <text class={`f-small f-t-${m.tone} f-halo`} x={sx(m.v) + (i === 2 ? 4 : -4)} y={L.y1 - 14} text-anchor={i === 2 ? 'start' : 'end'}>{m.label}</text>)}
        <circle cx={sx(th[0])} cy={sy(ll[0])} r="4" class="f-solid-red" />
        <circle cx={sx(th[1])} cy={sy(ll[1])} r="4" style="fill: var(--fig-amber)" />
        <circle cx={sx(th[1])} cy={sy(bound(th[1], r0))} r="3.5" style="fill: var(--paper); stroke: var(--fig-red); stroke-width: 1.6" />
        {[{ c: 'f-line f-bold', label: t.ll }, { c: 'f-line f-red', label: t.b0 }, { c: 'f-line f-amber', label: t.b1 }].map((e, i) => (
          <g>
            <path class={e.c} d={`M ${L.x0 + 10} ${L.y0 + 12 + i * 18} h 22`} />
            <text class="f-small" x={L.x0 + 38} y={L.y0 + 16.5 + i * 18}>{e.label}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
