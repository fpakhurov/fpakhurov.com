---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { isoLoss, optimum, aExp, check, pow10 } from './fit';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Iso-FLOP curves of the Chinchilla fit: for a fixed budget C, every model size N gets D = C / (6N) tokens,
// and the fitted loss L(N, C / 6N) has one minimum. The minima of the six budgets lie on a straight line in log N.
const exps = [19, 20, 21, 22, 23, 24];
const mins = exps.map((k) => ({ k, ...optimum(10 ** k) }));
const id = 'scaling-laws-isoflop';

// Numbers quoted in the caption and in the note.
const m21 = mins[2];
const m23 = mins[4];
check('IsoFlop', 'N at 1e21', m21.N, 1.824e9, 2e-3);
check('IsoFlop', 'D at 1e21', m21.D, 9.136e10, 2e-3);
check('IsoFlop', 'L at 1e21', m21.L, 2.3289, 1e-4);
check('IsoFlop', 'N at 1e23', m23.N, 1.460e10, 2e-3);
check('IsoFlop', 'L at 1e23', m23.L, 2.0050, 1e-4);
check('IsoFlop', 'N step per decade', 10 ** aExp, 2.83, 2e-3);
check('IsoFlop', 'D step per decade', 10 ** (1 - aExp), 3.53, 2e-3);
check('IsoFlop', 'D/N at 1e19', mins[0].D / mins[0].N, 32.1, 3e-3);
check('IsoFlop', 'D/N at 1e24', mins[5].D / mins[5].N, 97.7, 3e-3);

const fmtN = (n: number) => (n >= 1e9 ? `${(n / 1e9).toFixed(n >= 1e10 ? 0 : 1)}B` : `${Math.round(n / 1e6)}M`);
const yMax = 3.3;
const yMin = 1.8;
const logs = Array.from({ length: 241 }, (_, i) => 8 + (4 * i) / 240);

const layouts = [
  { cls: 'fig-wide fig-bp-640', sfx: 'w', W: 760, H: 400, L: 72, R: 530, T: 40, B: 340, legendX: 590, legendY: 70, narrow: false },
  { cls: 'fig-narrow fig-bp-640', sfx: 'n', W: 360, H: 510, L: 58, R: 306, T: 40, B: 330, legendX: 58, legendY: 410, narrow: true },
].map((o) => {
  const sx = scale([8, 12], [o.L, o.R]);
  const sy = scale([yMin, yMax], [o.B, o.T]);
  const curves = exps.map((k) => {
    // Sample in log N and cut each curve where it leaves the frame at the top, interpolating the crossing.
    const pts: (readonly [number, number])[] = [];
    logs.forEach((x, i) => {
      const y = isoLoss(10 ** k, 10 ** x);
      if (i > 0) {
        const xp = logs[i - 1];
        const yp = isoLoss(10 ** k, 10 ** xp);
        if ((yp - yMax) * (y - yMax) < 0) {
          const xc = xp + ((yMax - yp) / (y - yp)) * (x - xp);
          pts.push([xc, yMax]);
        }
      }
      if (y <= yMax) pts.push([x, y]);
    });
    const last = pts[pts.length - 1];
    const top = last[1] === yMax;
    return {
      k,
      d: polyline(pts.map(([x, y]) => [sx(x), sy(y)] as const)),
      // Label where the curve leaves the frame: above the frame if it exits at the top, right of the frame otherwise.
      lx: top ? sx(last[0]) : o.R + 6,
      ly: top ? o.T - 8 : sy(last[1]) + 4,
      anchor: top ? 'middle' : 'start',
    };
  });
  const dots = mins.map((m) => ({ ...m, x: sx(Math.log10(m.N)), y: sy(m.L) }));
  return { ...o, sx, sy, curves, dots, frontier: polyline(dots.map((d) => [d.x, d.y] as const)) };
});

const t = ru
  ? {
      title: 'Изо-FLOP-кривые подгонки Chinchilla',
      xAxis: 'параметры N (логарифмическая шкала)',
      yAxis: 'потери по подгонке, нат на токен',
      legend: [['один бюджет C,', 'D = C / (6N)'], ['минимум кривой:', 'оптимальные N и D'], ['граница', 'оптимальных моделей']],
    }
  : {
      title: 'Iso-FLOP curves of the Chinchilla fit',
      xAxis: 'parameters N (log scale)',
      yAxis: 'fitted loss, nats per token',
      legend: [['one budget C,', 'D = C / (6N)'], ['minimum of a curve:', 'compute-optimal N, D'], ['compute-optimal', 'frontier']],
    };
const xticks = [8, 9, 10, 11, 12].map((v) => ({ v, label: ['100M', '1B', '10B', '100B', '1T'][v - 8] }));
const yticks = [1.8, 2.1, 2.4, 2.7, 3.0, 3.3];
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? `Каждая кривая — один бюджет обучения C от ${pow10(19)} до ${pow10(24)} FLOP. Точка кривой — модель с N параметрами, обученная на D = C / (6N) токенах; высота — потери по подгонке L(N, D) = 1.69 + 406.4 / N^0.34 + 410.7 / D^0.28. Слева от минимума модель слишком мала, справа ей не хватает токенов. Минимумы (красные точки) ложатся на прямую: при C = ${pow10(21)} оптимум N = ${fmtN(m21.N)}, D = ${(m21.D / 1e9).toFixed(0)}B, L = ${m21.L.toFixed(3)}; при C = ${pow10(23)} — N = ${fmtN(m23.N)}, L = ${m23.L.toFixed(3)}. Каждое увеличение бюджета в 10 раз умножает оптимальное N на ${(10 ** aExp).toFixed(2)}, а D на ${(10 ** (1 - aExp)).toFixed(2)}. Подпись на конце каждой кривой — её C.`
    : `Each curve is one training budget C, from ${pow10(19)} to ${pow10(24)} FLOPs. A point on it is a model of N parameters trained on D = C / (6N) tokens; its height is the fitted loss L(N, D) = 1.69 + 406.4 / N^0.34 + 410.7 / D^0.28. Left of the minimum the model is too small, right of it the model runs out of tokens. The minima (red dots) lie on a straight line: at C = ${pow10(21)} the optimum is N = ${fmtN(m21.N)}, D = ${(m21.D / 1e9).toFixed(0)}B, L = ${m21.L.toFixed(3)}; at C = ${pow10(23)}, N = ${fmtN(m23.N)}, L = ${m23.L.toFixed(3)}. Each tenfold increase of the budget multiplies the optimal N by ${(10 ** aExp).toFixed(2)} and D by ${(10 ** (1 - aExp)).toFixed(2)}. The label at the end of each curve gives its C.`}
>
  {layouts.map((o) => (
    <svg class={o.cls} viewBox={`0 0 ${o.W} ${o.H}`} role="img" aria-labelledby={`${id}-${o.sfx}-t ${id}-${o.sfx}-d`}>
      <title id={`${id}-${o.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${o.sfx}-d`}>{ru
        ? 'Шесть U-образных кривых функции потерь от числа параметров на логарифмической оси, по одной на бюджет от 10^19 до 10^24 FLOP. Чем больше бюджет, тем ниже кривая и тем правее её минимум. Минимумы отмечены красными точками и соединены красной пунктирной прямой.'
        : 'Six U-shaped curves of loss against the number of parameters on a log axis, one per budget from 10^19 to 10^24 FLOPs. A larger budget gives a lower curve with its minimum further right. The minima are marked with red dots and joined by a red dashed straight line.'}</desc>
      {yticks.map((v) => <line class="f-grid" x1={o.L} x2={o.R} y1={o.sy(v)} y2={o.sy(v)} />)}
      {xticks.map((tk) => <line class="f-grid" x1={o.sx(tk.v)} x2={o.sx(tk.v)} y1={o.T} y2={o.B} />)}
      <path class="f-axis" d={`M ${o.L} ${o.B} H ${o.R + 12}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-axis" d={`M ${o.L} ${o.B} V ${o.T - 12}`} marker-end="url(#f-arrow-muted)" />
      {yticks.map((v) => <text class="f-note" x={o.L - 8} y={o.sy(v) + 4} text-anchor="end">{v.toFixed(1)}</text>)}
      {xticks.map((tk) => <text class="f-note" x={o.sx(tk.v)} y={o.B + 18} text-anchor="middle">{tk.label}</text>)}
      <text class="f-note" x={o.R} y={o.B + 38} text-anchor="end">{t.xAxis}</text>
      <text class="f-note" transform={`translate(${o.L - 44} ${(o.T + o.B) / 2}) rotate(-90)`} text-anchor="middle">{t.yAxis}</text>

      {o.curves.map((c) => <path class="f-line f-blue" d={c.d} />)}
      {o.curves.map((c) => <text class="f-small f-t-blue" x={c.lx} y={c.ly} text-anchor={c.anchor}>{pow10(c.k)}</text>)}
      <path class="f-line f-red f-dash" d={o.frontier} />
      {o.dots.map((d) => <circle class="f-solid-red" cx={d.x} cy={d.y} r="4.5" />)}

      <g>
        <line class="f-line f-blue" x1={o.legendX} x2={o.legendX + 24} y1={o.legendY - 4} y2={o.legendY - 4} />
        <circle class="f-solid-red" cx={o.legendX + 12} cy={o.legendY + (o.narrow ? 26 : 48) - 4} r="4.5" />
        <line class="f-line f-red f-dash" x1={o.legendX} x2={o.legendX + 24} y1={o.legendY + (o.narrow ? 52 : 96) - 4} y2={o.legendY + (o.narrow ? 52 : 96) - 4} />
        {t.legend.map((g, i) => (o.narrow
          ? <text class="f-small" x={o.legendX + 34} y={o.legendY + i * 26}>{`${g[0]} ${g[1]}`}</text>
          : <text class="f-small" x={o.legendX + 34} y={o.legendY + i * 48}>{g[0]}<tspan x={o.legendX + 34} dy="16">{g[1]}</tspan></text>))}
      </g>
    </svg>
  ))}
</Figure>
