---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { loss, tokensFor, check } from './fit';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Reach one target loss (Chinchilla's fitted loss) with models of different sizes. A model of N parameters needs
// D(N) training tokens, so training costs 6 N D(N); serving D_inf tokens afterwards costs 2 N D_inf.
const target = loss(70e9, 1.4e12);
const D_INF = 1e13;
const train = (N: number) => 6 * N * tokensFor(N, target);
const serve = (N: number) => 2 * N * D_INF;
const total = (N: number) => train(N) + serve(N);
const argmin = (f: (n: number) => number) => {
  let best = 1e10;
  for (let k = 0; k <= 4000; k += 1) {
    const n = 10 ** (9 + k / 2000);
    if (f(n) < f(best)) best = n;
  }
  return best;
};
const nTrain = argmin(train);
const nTotal = argmin(total);
const id = 'scaling-laws-inference-cost';

// Numbers quoted in the caption and in the note.
check('InferenceCost', 'target loss', target, 1.9366, 5e-5);
check('InferenceCost', 'training-optimal N', nTrain, 3.0e10, 1e-2);
check('InferenceCost', 'training-optimal tokens', tokensFor(nTrain, target), 2.73e12, 1e-2);
check('InferenceCost', 'training-optimal cost', train(nTrain), 4.92e23, 2e-3);
check('InferenceCost', 'total-optimal N', nTotal, 1.58e10, 1e-2);
check('InferenceCost', 'total-optimal tokens', tokensFor(nTotal, target), 6.05e12, 1e-2);
check('InferenceCost', 'total-optimal cost', total(nTotal), 8.92e23, 2e-3);
check('InferenceCost', 'total cost at the training-optimal size', total(nTrain), 1.09e24, 5e-3);
check('InferenceCost', 'Chinchilla training cost', train(70e9), 5.88e23, 1e-3);

const yMax = 16; // in units of 1e23 FLOPs
const logs = Array.from({ length: 241 }, (_, i) => Math.log10(8e9) + ((Math.log10(2e11) - Math.log10(8e9)) * i) / 240);

const layouts = [
  { cls: 'fig-wide fig-bp-640', sfx: 'w', W: 760, H: 390, L: 72, R: 560, T: 34, B: 330, narrow: false },
  { cls: 'fig-narrow fig-bp-640', sfx: 'n', W: 360, H: 470, L: 58, R: 300, T: 34, B: 320, narrow: true },
].map((o) => {
  const sx = scale([Math.log10(8e9), Math.log10(2e11)], [o.L, o.R]);
  const sy = scale([0, yMax], [o.B, o.T]);
  // Sample in log N, keep the part inside the frame, interpolate the crossing of the top edge.
  const curve = (f: (n: number) => number) => {
    const pts: (readonly [number, number])[] = [];
    logs.forEach((x, i) => {
      const y = f(10 ** x) / 1e23;
      if (i > 0) {
        const xp = logs[i - 1];
        const yp = f(10 ** xp) / 1e23;
        if ((yp - yMax) * (y - yMax) < 0) pts.push([xp + ((yMax - yp) / (y - yp)) * (x - xp), yMax]);
      }
      if (y <= yMax) pts.push([x, y]);
    });
    return { d: polyline(pts.map(([x, y]) => [sx(x), sy(y)] as const)), end: pts[pts.length - 1] };
  };
  const pt = (n: number, f: (n: number) => number) => ({ x: sx(Math.log10(n)), y: sy(f(n) / 1e23) });
  return {
    ...o,
    sx,
    sy,
    trainCurve: curve(train),
    totalCurve: curve(total),
    serveCurve: curve(serve),
    a: pt(nTrain, train),
    b: pt(nTotal, total),
    c: pt(70e9, train),
    bOld: pt(nTrain, total),
  };
});

const fmtB = (n: number) => `${Math.round(n / 1e9)}B`;
const f1 = (v: number) => (v / 1e23).toFixed(1);
const t = ru
  ? {
      title: 'Минимум общих затрат смещается к меньшей модели',
      xAxis: 'параметры N (логарифмическая шкала)',
      yAxis: 'FLOP, в единицах 10²³',
      train: 'только обучение, 6N·D(N)',
      total: 'обучение + инференс',
      serve: 'инференс, 2N·D_inf',
    }
  : {
      title: 'The minimum of the total cost moves to a smaller model',
      xAxis: 'parameters N (log scale)',
      yAxis: 'FLOPs, units of 10²³',
      train: 'training only, 6N·D(N)',
      total: 'training + inference',
      serve: 'inference, 2N·D_inf',
    };
const xticks = [1e10, 2e10, 5e10, 1e11, 2e11];
const yticks = [0, 4, 8, 12, 16];
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? `Во всех точках кривых достигаются одни и те же потери по подгонке, ${target.toFixed(3)} (как у Chinchilla: 70B параметров, 1.4T токенов). Модели с N параметрами для этого нужно D(N) обучающих токенов; синяя кривая — стоимость обучения 6N·D(N), её минимум — ${fmtB(nTrain)} параметров и ${(tokensFor(nTrain, target) / 1e12).toFixed(2)}T токенов, ${f1(train(nTrain))} × 10²³ FLOP (сама Chinchilla, пустой кружок, потратила ${f1(train(70e9))} × 10²³). Жёлтый пунктир — стоимость обслуживания 10¹³ токенов по 2N FLOP на токен; красная кривая — сумма. Её минимум — ${fmtB(nTotal)} параметров и ${(tokensFor(nTotal, target) / 1e12).toFixed(2)}T токенов: обучение дороже (${f1(train(nTotal))} × 10²³), но в сумме ${f1(total(nTotal))} × 10²³ против ${f1(total(nTrain))} × 10²³ у модели, оптимальной только для обучения (пустой красный кружок). Это расчёт по подогнанной формуле, а не измерение.`
    : `Every point on these curves reaches the same fitted loss, ${target.toFixed(3)} (Chinchilla's: 70B parameters, 1.4T tokens). A model of N parameters needs D(N) training tokens; the blue curve is the training cost 6N·D(N), lowest at ${fmtB(nTrain)} parameters on ${(tokensFor(nTrain, target) / 1e12).toFixed(2)}T tokens, ${f1(train(nTrain))} × 10²³ FLOPs (Chinchilla itself, the open circle, spent ${f1(train(70e9))} × 10²³). The amber dashed line is the cost of serving 10¹³ tokens at 2N FLOPs per token; the red curve is the sum. Its minimum is ${fmtB(nTotal)} parameters on ${(tokensFor(nTotal, target) / 1e12).toFixed(2)}T tokens: training costs more (${f1(train(nTotal))} × 10²³), but the total is ${f1(total(nTotal))} × 10²³ against ${f1(total(nTrain))} × 10²³ for the training-optimal model (the open red circle). An illustration on the fitted formula, not a measurement.`}
>
  {layouts.map((o) => (
    <svg class={o.cls} viewBox={`0 0 ${o.W} ${o.H}`} role="img" aria-labelledby={`${id}-${o.sfx}-t ${id}-${o.sfx}-d`}>
      <title id={`${id}-${o.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${o.sfx}-d`}>{ru
        ? 'Три кривые затрат от числа параметров на логарифмической оси. Синяя, стоимость обучения, U-образная с минимумом около 30B. Жёлтая пунктирная, стоимость инференса, растёт пропорционально N. Красная, их сумма, имеет минимум левее, около 16B.'
        : 'Three cost curves against the number of parameters on a log axis. The blue one, the training cost, is U-shaped with its minimum near 30B. The amber dashed one, the inference cost, grows in proportion to N. The red one, their sum, has its minimum further left, near 16B.'}</desc>
      {yticks.map((v) => <line class="f-grid" x1={o.L} x2={o.R} y1={o.sy(v)} y2={o.sy(v)} />)}
      {xticks.map((v) => <line class="f-grid" x1={o.sx(Math.log10(v))} x2={o.sx(Math.log10(v))} y1={o.T} y2={o.B} />)}
      <path class="f-axis" d={`M ${o.L} ${o.B} H ${o.R + 12}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-axis" d={`M ${o.L} ${o.B} V ${o.T - 12}`} marker-end="url(#f-arrow-muted)" />
      {yticks.map((v) => <text class="f-note" x={o.L - 8} y={o.sy(v) + 4} text-anchor="end">{v}</text>)}
      {xticks.map((v) => <text class="f-note" x={o.sx(Math.log10(v))} y={o.B + 18} text-anchor="middle">{fmtB(v)}</text>)}
      <text class="f-note" x={o.R} y={o.B + 38} text-anchor="end">{t.xAxis}</text>
      <text class="f-note" transform={`translate(${o.L - 40} ${(o.T + o.B) / 2}) rotate(-90)`} text-anchor="middle">{t.yAxis}</text>

      <path class="f-line f-amber f-dash" d={o.serveCurve.d} />
      <path class="f-line f-blue f-bold" d={o.trainCurve.d} />
      <path class="f-line f-red f-bold" d={o.totalCurve.d} />

      <circle class="f-solid-blue" cx={o.a.x} cy={o.a.y} r="5" />
      <circle class="f-solid-red" cx={o.b.x} cy={o.b.y} r="5" />
      <circle class="f-fill-paper f-red f-line" cx={o.bOld.x} cy={o.bOld.y} r="5" />
      <circle class="f-fill-paper f-blue f-line" cx={o.c.x} cy={o.c.y} r="5" />
      <text class="f-small f-t-blue f-halo" x={o.a.x + 6} y={o.a.y + 22}>{`${fmtB(nTrain)}: ${f1(train(nTrain))}`}</text>
      <text class="f-small f-t-red f-halo" x={o.b.x - 6} y={o.b.y + 24}>{`${fmtB(nTotal)}: ${f1(total(nTotal))}`}</text>
      <text class="f-small f-t-red f-halo" x={o.bOld.x + 10} y={o.bOld.y + 16}>{f1(total(nTrain))}</text>
      {o.narrow
        ? <text class="f-small f-t-blue f-halo" x={o.c.x + 8} y={o.c.y + 18}>{f1(train(70e9))}</text>
        : <text class="f-small f-t-blue f-halo" x={o.c.x + 4} y={o.c.y + 22} text-anchor="middle">{`Chinchilla: ${f1(train(70e9))}`}</text>}

      {o.narrow
        ? (
          <g>
            <line class="f-line f-blue f-bold" x1={o.L} x2={o.L + 24} y1={o.B + 66} y2={o.B + 66} />
            <text class="f-small" x={o.L + 32} y={o.B + 70}>{t.train}</text>
            <line class="f-line f-red f-bold" x1={o.L} x2={o.L + 24} y1={o.B + 92} y2={o.B + 92} />
            <text class="f-small" x={o.L + 32} y={o.B + 96}>{t.total}</text>
            <line class="f-line f-amber f-dash" x1={o.L} x2={o.L + 24} y1={o.B + 118} y2={o.B + 118} />
            <text class="f-small" x={o.L + 32} y={o.B + 122}>{t.serve}</text>
          </g>
        )
        : (
          <g>
            <text class="f-small f-t-blue" x={o.R + 8} y={o.sy(o.trainCurve.end[1]) + 4}>{t.train}</text>
            <text class="f-small f-t-red" x={o.sx(o.totalCurve.end[0])} y={o.T - 8} text-anchor="middle">{t.total}</text>
            <text class="f-small f-t-amber" x={o.sx(o.serveCurve.end[0]) + 8} y={o.T + 10}>{t.serve}</text>
          </g>
        )}
    </svg>
  ))}
</Figure>
