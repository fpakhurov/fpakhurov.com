---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { E, alpha, beta, paramTerm, dataTerm, loss, optimum, GOPHER_C, check } from './fit';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Gopher and Chinchilla on the Chinchilla fit: the loss above E, split into the parameter term A / N^alpha and the
// data term B / D^beta, for the two trained models and for the minimum of the fit at the same budget.
const opt = optimum(GOPHER_C);
const rows = [
  { key: 'gopher', name: 'Gopher', N: 280e9, D: 300e9 },
  { key: 'chinchilla', name: 'Chinchilla', N: 70e9, D: 1.4e12 },
  { key: 'optimum', name: ru ? 'Минимум подгонки' : 'Minimum of the fit', N: opt.N, D: opt.D },
].map((r) => ({ ...r, p: paramTerm(r.N), d: dataTerm(r.D), L: loss(r.N, r.D), C: 6 * r.N * r.D }));
const [gopher, chinchilla, best] = rows;
const id = 'scaling-laws-gopher-chinchilla';

// Numbers quoted in the caption and in the note.
check('GopherChinchilla', 'Gopher parameter term', gopher.p, 0.0521, 1e-3);
check('GopherChinchilla', 'Gopher data term', gopher.d, 0.2511, 1e-3);
check('GopherChinchilla', 'Gopher L', gopher.L, 1.9933, 5e-5);
check('GopherChinchilla', 'Chinchilla parameter term', chinchilla.p, 0.0835, 1e-3);
check('GopherChinchilla', 'Chinchilla data term', chinchilla.d, 0.1632, 1e-3);
check('GopherChinchilla', 'Chinchilla L', chinchilla.L, 1.9366, 5e-5);
check('GopherChinchilla', 'optimum N', best.N, 3.22e10, 2e-3);
check('GopherChinchilla', 'optimum D', best.D, 2.98e12, 2e-3);
check('GopherChinchilla', 'optimum L', best.L, 1.9307, 5e-5);
check('GopherChinchilla', 'term ratio at the optimum', best.p / best.d, beta / alpha, 1e-6);
check('GopherChinchilla', 'Gopher 6ND', gopher.C, 5.04e23, 1e-6);
check('GopherChinchilla', 'Chinchilla 6ND', chinchilla.C, 5.88e23, 1e-6);

const sizeLabel = (n: number) => (n >= 1e12 ? `${(n / 1e12).toFixed(1)}T` : `${Math.round(n / 1e9)}B`);
const f3 = (v: number) => v.toFixed(3);
const sci = (v: number) => `${(v / 1e23).toFixed(1)} × 10²³`;
const t = ru
  ? {
      title: 'Gopher и Chinchilla при одном бюджете: из чего складываются потери',
      detail: (r: (typeof rows)[number]) => `${sizeLabel(r.N)} параметров, ${sizeLabel(r.D)} токенов, 6ND = ${sci(r.C)}`,
      legend: ['слагаемое параметров 406.4 / N^0.34', 'слагаемое данных 410.7 / D^0.28'],
      axis: 'потери сверх E = 1.69, нат на токен',
    }
  : {
      title: 'Gopher and Chinchilla on one budget: where the loss comes from',
      detail: (r: (typeof rows)[number]) => `${sizeLabel(r.N)} parameters, ${sizeLabel(r.D)} tokens, 6ND = ${sci(r.C)}`,
      legend: ['parameter term 406.4 / N^0.34', 'data term 410.7 / D^0.28'],
      axis: 'loss above E = 1.69, nats per token',
    };

const layouts = [
  { cls: 'fig-wide fig-bp-640', sfx: 'w', W: 760, H: 380, L: 24, R: 620, top: 34, step: 96, barDy: 16, barH: 30, narrow: false },
  { cls: 'fig-narrow fig-bp-640', sfx: 'n', W: 360, H: 460, L: 12, R: 286, top: 30, step: 116, barDy: 36, barH: 30, narrow: true },
].map((o) => {
  const sx = scale([0, 0.32], [o.L, o.R]);
  return {
    ...o,
    sx,
    bars: rows.map((r, i) => {
      const y = o.top + i * o.step;
      return { ...r, y, by: y + o.barDy, x0: sx(0), x1: sx(r.p), x2: sx(r.p + r.d) };
    }),
    axisY: o.top + 3 * o.step - 8,
  };
});
const ticks = [0, 0.1, 0.2, 0.3];
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? `Длина полосы — потери по подгонке сверх неустранимого слагаемого E = 1.69, разложенные на слагаемое параметров (синее) и слагаемое данных (жёлтое). Gopher (280B параметров, 300B токенов) и Chinchilla (70B, 1.4T) обучены почти при одном бюджете. У Gopher самое маленькое слагаемое параметров, ${f3(gopher.p)}, но на параметр пришлось 1.1 токена, и слагаемое данных равно ${f3(gopher.d)}. Chinchilla мирится с большим слагаемым параметров (${f3(chinchilla.p)}) ради гораздо меньшего слагаемого данных (${f3(chinchilla.d)}), и её потери L = ${chinchilla.L.toFixed(3)} на ${(gopher.L - chinchilla.L).toFixed(3)} ниже, чем у Gopher (${gopher.L.toFixed(3)}). Минимум подгонки при C = 5.76 × 10²³ FLOP — ${sizeLabel(best.N)} параметров и ${sizeLabel(best.D)} токенов, L = ${best.L.toFixed(3)}; в нём два слагаемых относятся как β : α = 0.28 : 0.34. Оценка 6ND даёт для двух обученных моделей ${sci(gopher.C)} и ${sci(chinchilla.C)} FLOP; более подробный подсчёт в статье даёт обеим 5.76 × 10²³.`
    : `Each bar is the fitted loss above the irreducible term E = 1.69, split into the parameter term (blue) and the data term (amber). Gopher (280B parameters, 300B tokens) and Chinchilla (70B, 1.4T) used about the same budget. Gopher has the smallest parameter term, ${f3(gopher.p)}, but it saw 1.1 tokens per parameter and its data term is ${f3(gopher.d)}. Chinchilla gives up some of the parameter term (${f3(chinchilla.p)}) for a much smaller data term (${f3(chinchilla.d)}) and ends at L = ${chinchilla.L.toFixed(3)}, ${(gopher.L - chinchilla.L).toFixed(3)} below Gopher's ${gopher.L.toFixed(3)}. The minimum of the fit at C = 5.76 × 10²³ FLOPs is ${sizeLabel(best.N)} parameters and ${sizeLabel(best.D)} tokens, L = ${best.L.toFixed(3)}; there the two terms stand in the ratio β : α = 0.28 : 0.34. The 6ND shortcut gives ${sci(gopher.C)} and ${sci(chinchilla.C)} FLOPs for the two trained models; the paper's more detailed count puts both at 5.76 × 10²³.`}
>
  {layouts.map((o) => (
    <svg class={o.cls} viewBox={`0 0 ${o.W} ${o.H}`} role="img" aria-labelledby={`${id}-${o.sfx}-t ${id}-${o.sfx}-d`}>
      <title id={`${id}-${o.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${o.sfx}-d`}>{ru
        ? `Три горизонтальные полосы. Gopher: синий отрезок ${f3(gopher.p)} и жёлтый ${f3(gopher.d)}, всего ${f3(gopher.p + gopher.d)}. Chinchilla: ${f3(chinchilla.p)} и ${f3(chinchilla.d)}, всего ${f3(chinchilla.p + chinchilla.d)}. Минимум подгонки: ${f3(best.p)} и ${f3(best.d)}, всего ${f3(best.p + best.d)}.`
        : `Three horizontal bars. Gopher: a blue segment of ${f3(gopher.p)} and an amber one of ${f3(gopher.d)}, ${f3(gopher.p + gopher.d)} in all. Chinchilla: ${f3(chinchilla.p)} and ${f3(chinchilla.d)}, ${f3(chinchilla.p + chinchilla.d)} in all. Minimum of the fit: ${f3(best.p)} and ${f3(best.d)}, ${f3(best.p + best.d)} in all.`}</desc>
      {ticks.map((v) => <line class="f-grid" x1={o.sx(v)} x2={o.sx(v)} y1={o.top + 4} y2={o.axisY} />)}
      {ticks.map((v) => <text class="f-note" x={o.sx(v)} y={o.axisY + 18} text-anchor="middle">{v.toFixed(1)}</text>)}
      <text class="f-note" x={o.R} y={o.axisY + 38} text-anchor="end">{t.axis}</text>

      {o.bars.map((b) => (
        <g>
          {o.narrow
            ? <text class="f-label" x={o.L} y={b.y}><tspan font-weight="650">{b.name}</tspan><tspan x={o.L} dy="19">{t.detail(b)}</tspan></text>
            : <text class="f-label" x={o.L} y={b.y}><tspan font-weight="650">{b.name}</tspan><tspan dx="10" style="fill: var(--muted)">{t.detail(b)}</tspan></text>}
          <rect class="f-fill-blue f-blue" x={b.x0} y={b.by} width={b.x1 - b.x0} height={o.barH} />
          <rect class="f-fill-amber f-amber" x={b.x1} y={b.by} width={b.x2 - b.x1} height={o.barH} />
          <text class="f-small f-t-blue" x={(b.x0 + b.x1) / 2} y={b.by + o.barH / 2 + 4.5} text-anchor="middle">{f3(b.p)}</text>
          <text class="f-small f-t-amber" x={(b.x1 + b.x2) / 2} y={b.by + o.barH / 2 + 4.5} text-anchor="middle">{f3(b.d)}</text>
          <text class="f-small" x={b.x2 + 8} y={b.by + o.barH / 2 + 4.5}>{`L = ${b.L.toFixed(3)}`}</text>
        </g>
      ))}

      {t.legend.map((g, i) => (
        <g>
          <rect class={i === 0 ? 'f-fill-blue f-blue' : 'f-fill-amber f-amber'} x={o.narrow ? o.L : o.L + i * 300} y={o.axisY + (o.narrow ? 58 + i * 24 : 58) - 11} width="18" height="12" />
          <text class="f-small" x={(o.narrow ? o.L : o.L + i * 300) + 26} y={o.axisY + (o.narrow ? 58 + i * 24 : 58)}>{g}</text>
        </g>
      ))}
    </svg>
  ))}
</Figure>
