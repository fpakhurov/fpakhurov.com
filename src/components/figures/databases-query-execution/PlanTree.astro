---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? "Строки идут от чтения к сортировке" : "Rows flow from scan to sort";
const caption = ru ? "Просмотр посещает шесть строк и возвращает две. Сортировка меняет порядок этих строк, а их число сохраняется." : "The scan visits six rows and returns two. The sort orders those two and returns them without changing their count.";
const desc = ru ? "Последовательный просмотр с фильтром по магазину 2 передаёт сортировке две строки. В результате заказы 201 и 202." : "A sequential scan with a shop 2 filter sends two rows to Sort. The sorted result has orders 201 and 202.";
---
<Figure id="db-plan-tree" title={title} caption={caption}>
  <svg viewBox="0 0 340 195" role="img" aria-labelledby="db-plan-tree-title db-plan-tree-desc" style="max-width: 550px; margin-inline: auto">
    <title id="db-plan-tree-title">{title}</title>
    <desc id="db-plan-tree-desc">{desc}</desc>
    <rect class="f-fill-blue" x="48" y="14" width="244" height="41" rx="6" />
    <text class="f-label" x="170" y="39" text-anchor="middle">Seq Scan · shop_id = 2</text>
    <path class="f-line" d="M 170 57 V 82 M 165 77 L 170 82 L 175 77" fill="none" />
    <text class="f-label" x="204" y="75">{ru ? '2 строки' : '2 rows'}</text>
    <rect class="f-fill-green" x="48" y="85" width="244" height="41" rx="6" />
    <text class="f-label" x="170" y="110" text-anchor="middle">Sort · total_cents DESC</text>
    <path class="f-line" d="M 170 128 V 153 M 165 148 L 170 153 L 175 148" fill="none" />
    <text class="f-label" x="170" y="175" text-anchor="middle">201 · 2400 → 202 · 800</text>
  </svg>
</Figure>
