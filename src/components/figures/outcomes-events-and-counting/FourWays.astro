---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Choosing k = 2 items from n = 4 (a, b, c, d): every cell (first, second) of a 4 × 4 grid is an ordered pair;
// each rule keeps the cells it counts.
const n = 4, items = ['a', 'b', 'c', 'd'];
const rules = [
  { keep: (_i: number, _j: number) => true, order: ['ordered', 'с порядком'], repl: ['with replacement', 'с возвращением'], formula: 'nᵏ' },
  { keep: (i: number, j: number) => i !== j, order: ['ordered', 'с порядком'], repl: ['without replacement', 'без возвращения'], formula: 'n!/(n−k)!' },
  { keep: (i: number, j: number) => i < j, order: ['unordered', 'без порядка'], repl: ['without replacement', 'без возвращения'], formula: 'C(n, k)' },
  { keep: (i: number, j: number) => i <= j, order: ['unordered', 'без порядка'], repl: ['with replacement', 'с возвращением'], formula: 'C(n+k−1, k)' },
];
const counts = rules.map((r) => items.flatMap((_, i) => items.map((__, j) => r.keep(i, j))).filter(Boolean).length);
if (counts.join() !== '16,12,6,10') throw new Error('FourWays: counts drifted from the note');
const cells = rules.map((r) => items.flatMap((_, i) => items.map((__, j) => ({ i, j, on: r.keep(i, j) }))));
const lang = ru ? 1 : 0;
const id = 'four-ways-to-choose';
const cell = 26;
const layouts = [
  { cls: 'fig-wide', W: 760, H: 214, pos: (k: number) => [16 + k * 188, 58] },
  { cls: 'fig-narrow seq-narrow', W: 380, H: 420, pos: (k: number) => [16 + (k % 2) * 188, 60 + Math.floor(k / 2) * 208] },
];
---

<Figure
  id={id}
  title={ru ? 'Четыре способа выбрать 2 предмета из 4' : 'Four ways to choose 2 items out of 4'}
  caption={ru
    ? `Клетка (строка, столбец) — упорядоченная пара «первый выбор, второй выбор» из a, b, c, d. С порядком и с возвращением подходят все ${counts[0]} клеток; без возвращения исключается диагональ, остаётся ${counts[1]}; без порядка пары (a, b) и (b, a) — один исход, поэтому остаётся треугольник над диагональю, ${counts[2]}; без порядка и с возвращением к нему добавляется диагональ, ${counts[3]}. Последние ${counts[3]} исходов не равновероятны, если выбор делается случайно: (a, b) получается двумя способами, (a, a) — одним.`
    : `Cell (row, column) is the ordered pair "first choice, second choice" from a, b, c, d. Ordered with replacement keeps all ${counts[0]} cells; without replacement drops the diagonal, ${counts[1]}; unordered counts (a, b) and (b, a) as one outcome, leaving the triangle above the diagonal, ${counts[2]}; unordered with replacement adds the diagonal back, ${counts[3]}. These last ${counts[3]} outcomes are not equally likely when the choice is random: (a, b) arises in two ways, (a, a) in one.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Сетки 4 × 4 для четырёх правил подсчёта' : '4 × 4 grids for the four counting rules'}</title>
      <desc id={`${id}-${L.W}-d`}>{rules.map((r, k) => `${r.order[lang]}, ${r.repl[lang]}: ${counts[k]}`).join('; ')}.</desc>
      {rules.map((r, k) => {
        const [x0, y0] = L.pos(k);
        return (
          <g>
            <text class="f-small" x={x0} y={y0 - 40}>{r.order[lang]},</text>
            <text class="f-small" x={x0} y={y0 - 23}>{r.repl[lang]}</text>
            {items.map((it, j) => <text class="f-note" x={x0 + 24 + j * cell + cell / 2 - 1} y={y0 - 5} text-anchor="middle">{it}</text>)}
            {items.map((it, i) => <text class="f-note" x={x0 + 12} y={y0 + i * cell + cell / 2 + 4} text-anchor="middle">{it}</text>)}
            {cells[k].map((c) => <rect x={x0 + 24 + c.j * cell} y={y0 + c.i * cell} width={cell - 2} height={cell - 2} rx="3" style={`fill: var(--fig-blue); fill-opacity: ${c.on ? 0.5 : 0}; stroke: var(--line); stroke-width: 1`} />)}
            <text class="f-label" x={x0} y={y0 + n * cell + 22}>{`${r.formula} = ${counts[k]}`}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
