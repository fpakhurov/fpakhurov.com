---
// Original finite scheduler diagram, Fedor Pakhurov project with Codex assistance.
// All displayed multiplicities are enumerated here, not measured or source data.
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
const ru = pageLang(Astro.url) === 'ru';
const labels = ['a', 'b', 'c', 'd', 'e'];
const schedules = labels.flatMap(a => labels.flatMap(b => labels.map(c => [a, b, c])));
const fibres = new Map<string, number>();
for (const tuple of schedules) {
  const key = [...tuple].sort().join('');
  fibres.set(key, (fibres.get(key) ?? 0) + 1);
}
const rows = [1, 2, 3].map(kinds => {
  const selected = [...fibres].filter(([key]) => new Set(key).size === kinds);
  const sizes = new Set(selected.map(([, size]) => size));
  if (sizes.size !== 1) throw new Error('Unequal sizes within a multiplicity shape');
  return { kinds, allocations: selected.length, weight: selected[0][1], total: selected.reduce((s, [, n]) => s + n, 0) };
});
if (JSON.stringify(rows.map(r => [r.allocations, r.weight, r.total])) !== '[[5,1,5],[20,3,60],[10,6,60]]') throw new Error('Scheduler counts drifted');
const fourCounts = [schedules.length, schedules.filter(s => new Set(s).size === 3).length,
  new Set(schedules.filter(s => new Set(s).size === 3).map(s => [...s].sort().join(''))).size, fibres.size];
if (fourCounts.join(',') !== '125,60,10,35') throw new Error('Four counting spaces drifted');
const names = ru ? ['Порядок, повторы', 'Порядок, без повторов', 'Множества', 'Мультимножества'] : ['Ordered, repeats', 'Ordered, no repeats', 'Subsets', 'Multisets'];
const examples = ['aaa', 'aab', 'abc'];
---

<Figure id="four-ways-to-choose"
  title={ru ? '35 записей имеют 125 упорядоченных прообразов' : '35 allocations have 125 ordered predecessors'}
  caption={ru ? 'При равномерном выборе расписания вес одной записи равен числу её порядков: 1, 3 или 6 из 125. Число записей и их вероятности — разные величины.' : 'Under uniform schedule sampling, one allocation has the weight of its 1, 3 or 6 orders out of 125. The number of records and their probabilities are different quantities.'}>
  <div class="counting-spaces" aria-label={ru ? 'Четыре пространства подсчёта' : 'Four counting spaces'}>
    {fourCounts.map((n, i) => <div><span>{names[i]}</span><strong>{n}</strong></div>)}
  </div>
  <div class="counting-rows">
    {rows.map((r, i) => <div class="counting-row">
      <div><code>{examples[i]}</code><span>{ru ? `Разных типов: ${r.kinds}` : `Distinct types: ${r.kinds}`}</span></div>
      <p>{ru ? `${r.allocations} записей × ${r.weight} ${r.weight === 1 ? 'порядок' : r.weight === 3 ? 'порядка' : 'порядков'} = ${r.total} расписаний` : `${r.allocations} allocations × ${r.weight} ${r.weight === 1 ? 'order' : 'orders'} = ${r.total} schedules`}</p>
      <div class="order-dots" role="img" aria-label={ru ? `${r.weight} ${r.weight === 1 ? 'порядок' : r.weight === 3 ? 'порядка' : 'порядков'} у каждой записи этого вида` : `${r.weight} ${r.weight === 1 ? 'order' : 'orders'} for each allocation of this shape`}>
        {Array.from({length:r.weight}, () => <span aria-hidden="true"></span>)}
      </div>
    </div>)}
  </div>
</Figure>

<style>
  .counting-spaces {display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.6rem;margin-bottom:1.25rem}
  .counting-spaces div {border-bottom:2px solid var(--fig-blue);padding:.3rem 0 .6rem;min-width:0}
  .counting-spaces span {display:block;font-size:.875rem;line-height:1.35}
  .counting-spaces strong {display:block;font-size:1.4rem;font-variant-numeric:tabular-nums;margin-top:.35rem}
  .counting-rows {display:grid;gap:.75rem}
  .counting-row {display:grid;grid-template-columns:7.5rem 1fr 8rem;gap:.7rem;align-items:center;border-top:1px solid var(--line);padding-top:.7rem}
  .counting-row > div:first-child {display:flex;flex-direction:column;gap:.25rem}
  .counting-row code {font-size:1rem;background:none;padding:0}
  .counting-row span,.counting-row p {font-size:.875rem;line-height:1.4;margin:0}
  .order-dots {display:flex;flex-wrap:wrap;gap:.3rem}
  .order-dots span {width:.9rem;height:.9rem;border-radius:50%;background:var(--fig-blue)}
  @media(max-width:560px) {
    .counting-spaces {grid-template-columns:repeat(2,minmax(0,1fr))}
    .counting-row {grid-template-columns:5.5rem 1fr}
    .order-dots {grid-column:2}
  }
</style>
