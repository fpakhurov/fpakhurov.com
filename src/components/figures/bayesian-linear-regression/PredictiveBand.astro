---
import Figure from '../Figure.astro';
import { scale, plot } from '../geometry';
import { posterior, predictive, cubic, xs, ts } from './blr';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Cubic features, prior N(0, I) on the four weights (α = 1), the true noise precision β = 25 (standard deviation 0.2),
// fitted to the first n of 32 noisy points of sin(2.5 x). The band is the predictive mean ± 2 predictive standard deviations.
const alpha = 1, beta = 25;
const ns = [2, 8, 32];
const fits = ns.map((n) => posterior(xs.slice(0, n).map(cubic), ts.slice(0, n), alpha, beta));
const sdAt = (k: number, x: number) => Math.sqrt(predictive(cubic(x), fits[k].mu, fits[k].S, beta).variance);
const chk = fits.map((_, k) => [-1.5, -1, 0, 1, 1.5].map((x) => sdAt(k, x).toFixed(3)).join(' ')).join(' | ');
if (chk !== '1.786 0.435 0.488 1.831 4.163 | 1.585 0.364 0.228 0.747 2.501 | 0.594 0.234 0.206 0.255 0.668') throw new Error(`PredictiveBand: the predictive standard deviations drifted (${chk})`);
// More data never widens the band: on a grid, every standard deviation shrinks from n = 2 to 8 to 32.
for (let i = 0; i <= 60; i++) {
  const x = -1.5 + i * 0.05;
  if (!(sdAt(1, x) <= sdAt(0, x) + 1e-12 && sdAt(2, x) <= sdAt(1, x) + 1e-12)) throw new Error('PredictiveBand: a band widened with more data');
}

const dom = { x: [-1.5, 1.5] as [number, number], y: [-3, 3] as [number, number] };
const t = ru
  ? { mean: 'среднее прогноза', band: '± 2 ст. откл.', truth: 'sin 2.5x', data: 'данные', n: 'n =', title: 'Предсказательная полоса сужается с ростом выборки', desc: 'Три панели для 2, 8 и 32 точек: среднее прогноза кубической модели и полоса ± 2 стандартных отклонения. При двух точках слева полоса узкая только возле них и широкая вдали; при 32 точках она узкая на всём отрезке данных и расширяется за его краями.' }
  : { mean: 'predictive mean', band: 'mean ± 2 sd', truth: 'sin 2.5x', data: 'data', n: 'n =', title: 'The predictive band narrows as the data grow', desc: 'Three panels for 2, 8 and 32 points: the predictive mean of a cubic model and the band of ± 2 predictive standard deviations. With two points on the left the band is narrow only near them and wide elsewhere; with 32 points it is narrow over the whole range of the data and widens beyond its ends.' };
const id = 'blr-predictive-band';
const fmtN = (v: number) => String(v).replace('-', '−');

// Panels: [left, right, top, bottom] in each layout.
const layouts = [
  { cls: 'fig-wide', W: 760, H: 290, panels: ns.map((_, k) => [44 + k * 242, 250 + k * 242, 30, 226]), yTicksAll: false, legend: { x: 150, y: 274, rows: 1 } },
  { cls: 'fig-narrow', W: 360, H: 610, panels: ns.map((_, k) => [40, 346, 28 + k * 180, 168 + k * 180]), yTicksAll: true, legend: { x: 40, y: 572, rows: 2 } },
];
const legendItems = [
  { kind: 'line', label: t.mean },
  { kind: 'band', label: t.band },
  { kind: 'truth', label: t.truth },
  { kind: 'dot', label: t.data },
];
const textW = (s: string) => s.length * 6.5;
// Legend entries placed one after another; the narrow layout puts two per row.
const legends = layouts.map((L) => {
  const perRow = Math.ceil(legendItems.length / L.legend.rows);
  let cx = L.legend.x;
  return legendItems.map((e, i) => {
    if (i % perRow === 0) cx = L.legend.x;
    const x = cx, y = L.legend.y + Math.floor(i / perRow) * 20;
    cx += 28 + textW(e.label) + 22;
    if (x + 28 + textW(e.label) > L.W - 4) throw new Error(`PredictiveBand: legend entry "${e.label}" runs past the frame`);
    return { ...e, x, y };
  });
});
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? `Кубические признаки 1, x, x², x³, априорное распределение N(0, I) на четыре веса (α = 1), обратная дисперсия шума β = 25 (стандартное отклонение 0.2) известна. Модель обучена на первых n из 32 зашумлённых точек функции sin 2.5x (пунктир). Полоса — среднее прогноза ± 2 стандартных отклонения прогноза. Стандартное отклонение в точке x = 0 равно ${sdAt(0, 0).toFixed(3)}, ${sdAt(1, 0).toFixed(3)} и ${sdAt(2, 0).toFixed(3)} при n = 2, 8, 32 и не может опуститься ниже уровня шума 0.2; в точке x = 1.5, за краем данных, — ${sdAt(0, 1.5).toFixed(2)}, ${sdAt(1, 1.5).toFixed(2)} и ${sdAt(2, 1.5).toFixed(2)}. Ни в одной точке полоса не расширяется при добавлении данных.`
    : `Cubic features 1, x, x², x³, a prior N(0, I) on the four weights (α = 1), the noise precision β = 25 (standard deviation 0.2) known. The model is fitted to the first n of 32 noisy points of sin 2.5x (dashed). The band is the predictive mean ± 2 predictive standard deviations. The standard deviation at x = 0 is ${sdAt(0, 0).toFixed(3)}, ${sdAt(1, 0).toFixed(3)} and ${sdAt(2, 0).toFixed(3)} for n = 2, 8, 32, and it cannot fall below the noise level 0.2; at x = 1.5, beyond the data, it is ${sdAt(0, 1.5).toFixed(2)}, ${sdAt(1, 1.5).toFixed(2)} and ${sdAt(2, 1.5).toFixed(2)}. At no point does the band widen when data are added.`}
>
  {layouts.map((L, li) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{t.title}</title>
      <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
      {L.panels.map(([x0, x1, y0, y1], k) => {
        const sx = scale(dom.x, [x0, x1]), sy = scale(dom.y, [y1, y0]);
        const clip = `${id}-${L.W}-clip-${k}`;
        const fit = fits[k];
        const N = 120;
        const grid = Array.from({ length: N + 1 }, (_, i) => dom.x[0] + ((dom.x[1] - dom.x[0]) * i) / N);
        const pr = grid.map((x) => predictive(cubic(x), fit.mu, fit.S, beta));
        const up = grid.map((x, i) => `${i ? 'L' : 'M'} ${sx(x).toFixed(2)} ${sy(pr[i].mean + 2 * Math.sqrt(pr[i].variance)).toFixed(2)}`).join(' ');
        const lo = grid.map((x, i) => i).reverse().map((i) => `L ${sx(grid[i]).toFixed(2)} ${sy(pr[i].mean - 2 * Math.sqrt(pr[i].variance)).toFixed(2)}`).join(' ');
        return (
          <g>
            <defs><clipPath id={clip}><rect x={x0} y={y0} width={x1 - x0} height={y1 - y0} /></clipPath></defs>
            <rect x={x0} y={y0} width={x1 - x0} height={y1 - y0} style="fill: none; stroke: var(--line); stroke-width: 1" />
            {[-2, 0, 2].map((v) => <path class="f-grid" d={`M ${x0} ${sy(v)} H ${x1}`} />)}
            {(k === 0 || L.yTicksAll) && [-2, 0, 2].map((v) => <text class="f-small f-t-muted" x={x0 - 6} y={sy(v) + 4} text-anchor="end">{fmtN(v)}</text>)}
            {[-1, 0, 1].map((v) => <text class="f-small f-t-muted" x={sx(v)} y={y1 + 16} text-anchor="middle">{fmtN(v)}</text>)}
            <g clip-path={`url(#${clip})`}>
              <path d={`${up} ${lo} Z`} class="f-fill-blue" />
              <path class="f-line f-muted f-dash" d={plot((x) => Math.sin(2.5 * x), dom.x[0], dom.x[1], sx, sy)} />
              <path class="f-line f-blue" d={plot((x) => predictive(cubic(x), fit.mu, fit.S, beta).mean, dom.x[0], dom.x[1], sx, sy)} />
              {xs.slice(0, ns[k]).map((x, i) => <circle cx={sx(x)} cy={sy(ts[i])} r="2.6" style="fill: var(--ink)" />)}
            </g>
            <text class="f-small f-halo" x={x0 + 8} y={y0 + 16}>{`${t.n} ${ns[k]}`}</text>
          </g>
        );
      })}
      {legends[li].map((e) => (
        <g>
          {e.kind === 'line' && <path class="f-line f-blue" d={`M ${e.x} ${e.y - 4} h 22`} />}
          {e.kind === 'band' && <rect x={e.x} y={e.y - 10} width="22" height="12" class="f-fill-blue" />}
          {e.kind === 'truth' && <path class="f-line f-muted f-dash" d={`M ${e.x} ${e.y - 4} h 22`} />}
          {e.kind === 'dot' && <circle cx={e.x + 11} cy={e.y - 4} r="2.6" style="fill: var(--ink)" />}
          <text class="f-small" x={e.x + 28} y={e.y}>{e.label}</text>
        </g>
      ))}
    </svg>
  ))}
</Figure>
