---
import Figure from '../Figure.astro';
import Vec from '../seqflow/Vec.astro';
import Op from '../seqflow/Op.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { posterior, predictive } from './blr';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The worked example of the note: a line w0 + w1 x through x = (−1, 0, 1), t = (−1, 0.5, 2), α = 1, β = 4.
const x = [-1, 0, 1], tv = [-1, 0.5, 2], alpha = 1, beta = 4;
const Phi = x.map((v) => [1, v]);
const { mu, S } = posterior(Phi, tv, alpha, beta);
const xStar = [0, 1, 3];
const pred = xStar.map((v) => predictive([1, v], mu, S, beta));
const chk = [(1 / S[0][0]).toFixed(3), (1 / S[1][1]).toFixed(3), Math.abs(S[0][1]).toFixed(3), ...mu.map((v) => v.toFixed(3)), ...pred.map((p) => p.mean.toFixed(3)), ...pred.map((p) => p.variance.toFixed(3))].map(String).join(' ');
if (chk !== '13.000 9.000 0.000 0.462 1.333 0.462 1.795 4.462 0.327 0.438 1.327') throw new Error(`BlrFlow: the worked example drifted (${chk})`);
const f3 = (v: number) => v.toFixed(3);
const m = (s: string) => s.replace(/-/g, '−');

const t = ru
  ? {
      title: 'Байесовская линейная регрессия: от априорного распределения к прогнозу',
      prior: 'вклад априорного, α = 1', data: 'вклад данных, β = 4', post: 'обратная ковариация', mean: 'среднее прогноза', variance: 'дисперсия прогноза',
      steps: ['обратная ковариация априорного распределения αI', 'обратные ковариации складываются: Σ⁻¹ = αI + βΦᵀΦ', 'апостериорное среднее μ = Σ βΦᵀt', 'среднее и дисперсия прогноза в новых точках'],
      desc: 'Прямая w₀ + w₁x по трём точкам x = (−1, 0, 1), t = (−1, 0.5, 2). Матрица обратной ковариации априорного распределения αI = diag(1, 1) и вклад данных βΦᵀΦ = diag(12, 8) складываются в апостериорную матрицу обратной ковариации diag(13, 9). Апостериорное среднее μ = Σ βΦᵀt = (0.462, 1.333). В новых точках 0, 1, 3 среднее прогноза 0.462, 1.795, 4.462, дисперсия 0.327, 0.438, 1.327.',
    }
  : {
      title: 'Bayesian linear regression from the prior to the prediction',
      prior: 'prior precision, α = 1', data: 'data precision, β = 4', post: 'posterior precision', mean: 'predictive mean', variance: 'predictive variance',
      steps: ['prior precision αI', 'precisions add: Σ⁻¹ = αI + βΦᵀΦ', 'posterior mean μ = Σ βΦᵀt', 'predictive mean and variance at new inputs'],
      desc: 'A line w₀ + w₁x through three points x = (−1, 0, 1), t = (−1, 0.5, 2). The prior precision αI = diag(1, 1) and the data precision βΦᵀΦ = diag(12, 8) add to the posterior precision diag(13, 9). The posterior mean is μ = Σ βΦᵀt = (0.462, 1.333). At the new inputs 0, 1, 3 the predictive mean is 0.462, 1.795, 4.462 and the variance 0.327, 0.438, 1.327.',
    };
const id = 'blr-flow';
const caption = ru
  ? 'Признаки φ(x) = (1, x), три точки, α = 1, β = 4. Зелёным — данные, жёлтым — априорное распределение, синим — апостериорное, красным — прогноз. Поскольку x центрированы, матрица ΦᵀΦ = diag(3, 2) диагональна, и всё считается вручную: апостериорная дисперсия Σ = diag(1/13, 1/9), среднее μ = (6/13, 12/9). Дисперсия прогноза 1/β + 1/13 + x²/9 складывается из шума 0.25 и неопределённости весов; вторая часть растёт с квадратом расстояния от центра данных, поэтому в точке x = 3 дисперсия в четыре раза больше, чем в x = 0.'
  : 'Features φ(x) = (1, x), three points, α = 1, β = 4. Green: the data; amber: the prior; blue: the posterior; red: the prediction. Because the inputs are centred, ΦᵀΦ = diag(3, 2) is diagonal and everything can be done by hand: the posterior covariance is Σ = diag(1/13, 1/9) and the mean μ = (6/13, 12/9). The predictive variance 1/β + 1/13 + x²/9 adds the noise 0.25 to the uncertainty of the weights; the second part grows with the squared distance from the centre of the data, so at x = 3 the variance is four times that at x = 0.';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 350" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <Vec x={24} y={70} values={x.map((v) => m(String(v)))} tone="x" label="x" />
    <Vec x={74} y={70} values={tv.map((v) => m(String(v)))} tone="x" label="t" />
    <g data-s="1">
      <Box x={170} y={30} w={170} h={44} label="αI = diag(1, 1)" sub={t.prior} tone="g" />
      <Badge x={160} y={30} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[116, 122], [168, 122]]} />
      <Box x={170} y={100} w={170} h={44} label="βΦᵀΦ = diag(12, 8)" sub={t.data} />
      <Arrow pts={[[340, 52], [380, 52], [380, 72]]} tone="amber" />
      <Arrow pts={[[340, 122], [380, 122], [380, 102]]} />
      <Op x={380} y={87} sym="+" />
      <Arrow pts={[[393, 87], [418, 87]]} />
      <Box x={420} y={65} w={160} h={44} label="Σ⁻¹ = diag(13, 9)" sub={t.post} tone="h" />
      <Badge x={352} y={87} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[94, 138], [94, 212], [168, 212]]} />
      <Box x={170} y={190} w={170} h={44} label="βΦᵀt = (6, 12)" />
      <Arrow pts={[[340, 212], [479, 212]]} />
      <Arrow pts={[[500, 109], [500, 197]]} tone="blue" />
      <Op x={500} y={212} sym="Σ ·" />
      <Arrow pts={[[520, 212], [598, 212]]} />
      <Vec x={600} y={190} values={mu.map(f3)} tone="h" cw={56} label="μ" />
      <Badge x={535} y={190} n={3} />
    </g>
    <g data-s="4">
      <Vec x={24} y={290} values={xStar.map(String)} tone="x" dir="row" label="x_*" />
      <Arrow pts={[[146, 301], [198, 301]]} />
      <Arrow pts={[[628, 236], [628, 262], [268, 262], [268, 286]]} tone="blue" />
      <Op x={268} y={301} sym="μᵀφ,  1/β + φᵀΣφ" />
      <Arrow pts={[[338, 301], [378, 301]]} />
      <text class="f-small f-t-muted" x="461" y="282" text-anchor="middle">{t.mean}</text>
      <Vec x={380} y={290} values={pred.map((p) => f3(p.mean))} tone="y" dir="row" cw={54} />
      <text class="f-small f-t-muted" x="643" y="282" text-anchor="middle">{t.variance}</text>
      <Vec x={562} y={290} values={pred.map((p) => f3(p.variance))} tone="y" dir="row" cw={54} />
      <Badge x={268} y={330} n={4} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 530" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <Vec x={110} y={20} values={x.map((v) => m(String(v)))} tone="x" dir="row" label="x" labelPos="left" />
    <Vec x={110} y={60} values={tv.map((v) => m(String(v)))} tone="x" dir="row" label="t" labelPos="left" />
    <g data-s="2">
      <Arrow pts={[[150, 82], [150, 100], [93, 100], [93, 118]]} />
      <Box x={10} y={120} w={166} h={44} label="βΦᵀΦ = diag(12, 8)" sub="β = 4" />
      <Arrow pts={[[93, 164], [93, 197]]} />
      <Op x={93} y={212} sym="+" />
      <Arrow pts={[[93, 225], [93, 258]]} />
      <Box x={6} y={260} w={172} h={44} label="Σ⁻¹ = diag(13, 9)" sub={t.post} tone="h" />
      <Badge x={60} y={212} n={2} />
    </g>
    <g data-s="1">
      <Arrow pts={[[118, 212], [108, 212]]} tone="amber" />
      <Box x={118} y={190} w={136} h={44} label="αI = diag(1, 1)" sub="α = 1" tone="g" />
      <Badge x={118} y={186} n={1} />
    </g>
    <g data-s="3">
      <Arrow pts={[[190, 82], [190, 100], [269, 100], [269, 118]]} />
      <Box x={186} y={120} w={166} h={44} label="βΦᵀt = (6, 12)" />
      <Arrow pts={[[269, 164], [269, 267]]} />
      <Arrow pts={[[178, 282], [249, 282]]} tone="blue" />
      <Op x={269} y={282} sym="Σ ·" />
      <Arrow pts={[[269, 295], [269, 318]]} />
      <Vec x={213} y={320} values={mu.map(f3)} tone="h" dir="row" cw={56} label="μ" labelPos="left" />
      <Badge x={306} y={282} n={3} />
    </g>
    <g data-s="4">
      <Vec x={40} y={390} values={xStar.map(String)} tone="x" dir="row" label="x_*" labelPos="left" />
      <Arrow pts={[[160, 401], [190, 401]]} />
      <Arrow pts={[[269, 342], [269, 386]]} tone="blue" />
      <Op x={260} y={401} sym="μᵀφ,  1/β + φᵀΣφ" />
      <Arrow pts={[[260, 414], [260, 436], [121, 436], [121, 458]]} />
      <Vec x={40} y={460} values={pred.map((p) => f3(p.mean))} tone="y" dir="row" cw={54} />
      <text class="f-small f-t-muted" x="210" y="476">{t.mean}</text>
      <Vec x={40} y={496} values={pred.map((p) => f3(p.variance))} tone="y" dir="row" cw={54} />
      <text class="f-small f-t-muted" x="210" y="512">{t.variance}</text>
      <Badge x={343} y={401} n={4} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
