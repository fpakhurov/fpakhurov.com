---
import Figure from '../Figure.astro';
import { polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// X = [[2, 1], [0.5, 1.5]]: its columns span a parallelogram of area det X = 2.5. The change dX = [[0.1, 0.05], [−0.05, 0.1]]
// gives det(X + dX) = 2.8875. First order: det X · (1 + tr(X⁻¹dX)) = 2.5 · 1.15 = 2.875; the remainder is det(dX) = 0.0125.
type M2 = [[number, number], [number, number]];
const det = (m: M2) => m[0][0] * m[1][1] - m[0][1] * m[1][0];
const inv = (m: M2): M2 => { const d = det(m); return [[m[1][1] / d, -m[0][1] / d], [-m[1][0] / d, m[0][0] / d]]; };
const X: M2 = [[2, 1], [0.5, 1.5]], dX: M2 = [[0.1, 0.05], [-0.05, 0.1]];
const Y: M2 = [[X[0][0] + dX[0][0], X[0][1] + dX[0][1]], [X[1][0] + dX[1][0], X[1][1] + dX[1][1]]];
const Xi = inv(X);
const trace = Xi[0][0] * dX[0][0] + Xi[0][1] * dX[1][0] + Xi[1][0] * dX[0][1] + Xi[1][1] * dX[1][1];
const first = det(X) * (1 + trace);
const quoted = [det(X), trace, first, det(Y), det(dX)].map((v) => v.toFixed(4)).join();
if (quoted !== '2.5000,0.1500,2.8750,2.8875,0.0125') throw new Error(`LogDetArea: numbers drifted from the note (${quoted})`);
if (Math.abs(det(Y) - (first + det(dX))) > 1e-12) throw new Error('LogDetArea: the 2 × 2 identity does not hold');
type V = [number, number];
const col = (m: M2, j: number): V => [m[0][j], m[1][j]];
const para = (m: M2): V[] => { const a = col(m, 0), b = col(m, 1); return [[0, 0], a, [a[0] + b[0], a[1] + b[1]], b, [0, 0]]; };
const id = 'log-det-area';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 300, x0: 30, y0: 16, unit: 100, tx: 430, ty: 70, short: false },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 370, x0: 14, y0: 12, unit: 92, tx: 14, ty: 272, short: true },
];
const XMIN = -0.15, XMAX = 3.35, YMAX = 2.25, YMIN = -0.2;
const t = ru
  ? { c1: 'Xe₁ = (2, 0.5)', c2: 'Xe₂ = (1, 1.5)', c1s: 'Xe₁', c2s: 'Xe₂', r1: 'det X = 2.5 (синяя площадь)', r2: 'det(X + dX) = 2.8875 (красный контур)', r3: 'первый порядок: 2.5 · (1 + tr(X⁻¹dX))', r4: '= 2.5 · 1.15 = 2.875', r5: 'остаток: det(dX) = 0.0125' }
  : { c1: 'Xe₁ = (2, 0.5)', c2: 'Xe₂ = (1, 1.5)', c1s: 'Xe₁', c2s: 'Xe₂', r1: 'det X = 2.5 (blue area)', r2: 'det(X + dX) = 2.8875 (red outline)', r3: 'first order: 2.5 · (1 + tr(X⁻¹dX))', r4: '= 2.5 · 1.15 = 2.875', r5: 'remainder: det(dX) = 0.0125' };
const rows = [[t.r1, 'f-t-blue'], [t.r2, 'f-t-red'], [t.r3, ''], [t.r4, ''], [t.r5, 'f-t-muted']];
---

<Figure
  id={id}
  title={ru ? 'Дифференциал определителя как изменение площади' : 'The differential of the determinant as a change of area'}
  caption={ru
    ? 'Столбцы X = [[2, 1], [0.5, 1.5]] натягивают параллелограмм площади det X = 2.5 (синий). После изменения dX = [[0.1, 0.05], [−0.05, 0.1]] столбцы X + dX натягивают параллелограмм площади 2.8875 (красный контур). Формула d det X = det X · tr(X⁻¹dX) предсказывает 2.5 · (1 + 0.15) = 2.875: относительное изменение площади равно tr(X⁻¹dX). Остаток 0.0125 = det(dX) — член второго порядка.'
    : 'The columns of X = [[2, 1], [0.5, 1.5]] span a parallelogram of area det X = 2.5 (blue). After the change dX = [[0.1, 0.05], [−0.05, 0.1]] the columns of X + dX span a parallelogram of area 2.8875 (red outline). The formula d det X = det X · tr(X⁻¹dX) predicts 2.5 · (1 + 0.15) = 2.875: the relative change of the area is tr(X⁻¹dX). The remainder 0.0125 = det(dX) is the second-order term.'}
>
  {layouts.map((L) => {
    const sx = (x: number) => L.x0 + L.unit * (x - XMIN), sy = (y: number) => L.y0 + L.unit * (YMAX - y);
    const S = (q: V[]) => polyline(q.map(([x, y]) => [sx(x), sy(y)]));
    const a = col(X, 0), b = col(X, 1), a2 = col(Y, 0), b2 = col(Y, 1);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Два близких параллелограмма, натянутых на столбцы матрицы до и после малого изменения' : 'Two nearby parallelograms spanned by the columns of a matrix before and after a small change'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? 'Закрашенный синий параллелограмм с вершиной в начале координат и чуть больший красный контур поверх него; рядом подписи с площадями.' : 'A filled blue parallelogram with a corner at the origin and a slightly larger red outline over it, with the areas written beside it.'}</desc>
        <path class="f-grid" d={`M ${sx(XMIN)} ${sy(0)} H ${sx(XMAX)} M ${sx(0)} ${sy(YMIN)} V ${sy(YMAX)}`} />
        <path class="f-fill-blue" d={S(para(X)) + ' Z'} style="stroke: var(--fig-blue); stroke-width: 1.2" />
        <path class="f-line f-red f-dash" d={S(para(Y))} />
        <path class="f-line f-blue" d={`M ${sx(0)} ${sy(0)} L ${sx(a[0])} ${sy(a[1])}`} marker-end="url(#f-arrow-blue)" />
        <path class="f-line f-blue" d={`M ${sx(0)} ${sy(0)} L ${sx(b[0])} ${sy(b[1])}`} marker-end="url(#f-arrow-blue)" />
        <path class="f-thin f-red" d={`M ${sx(a[0])} ${sy(a[1])} L ${sx(a2[0])} ${sy(a2[1])}`} marker-end="url(#f-arrow-red)" />
        <path class="f-thin f-red" d={`M ${sx(b[0])} ${sy(b[1])} L ${sx(b2[0])} ${sy(b2[1])}`} marker-end="url(#f-arrow-red)" />
        <text class="f-small f-t-blue f-halo" x={sx(a[0]) - 4} y={sy(a[1]) + 22} text-anchor="middle">{L.short ? t.c1s : t.c1}</text>
        <text class="f-small f-t-blue f-halo" x={sx(b[0]) - 10} y={sy(b[1]) - 6} text-anchor="end">{L.short ? t.c2s : t.c2}</text>
        <text class="f-small f-halo" x={sx(0) - 4} y={sy(0) + 16} text-anchor="end">0</text>
        {rows.map(([s, cls], i) => <text class={`f-small ${cls}`} x={L.tx} y={L.ty + 22 * i}>{s}</text>)}
      </svg>
    );
  })}
</Figure>
