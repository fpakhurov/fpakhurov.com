---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? "Одинаковый объём и разные задачи" : "Equal total bytes and unequal tasks";
const caption = ru ? "В обоих случаях передаётся 240 ГБ. Нижнюю границу этапа в модели 1 ГБ/с задаёт самая длинная полоса." : "Both layouts deliver 240 GB. The longest bar in each group determines the stage bound in the 1 GB/s model.";
const desc = ru ? "В равномерном случае четыре задачи читают по 60 ГБ. При перекосе одна читает 120 ГБ, три другие по 40 ГБ." : "Four balanced tasks each consume 60 GB. In the skewed layout one consumes 120 GB and the other three consume 40 GB each.";
const layouts = [[60, 60, 60, 60], [120, 40, 40, 40]];
const names = ru ? ['Баланс', 'Перекос'] : ['Balanced', 'Skewed'];
---
<Figure id="bd-shuffle-skew" title={title} caption={caption}>
  <svg viewBox="0 0 340 195" role="img" aria-labelledby="bd-shuffle-skew-title bd-shuffle-skew-desc" style="max-width: 550px; margin-inline: auto">
    <title id="bd-shuffle-skew-title">{title}</title>
    <desc id="bd-shuffle-skew-desc">{desc}</desc>
    {layouts.map((parts, i) => (
      <g transform={`translate(${i * 164} 0)`}>
        <text class="f-label" x="24" y="25">{names[i]}</text>
        {parts.map((bytes, j) => (
          <g transform={`translate(0 ${j * 37})`}>
            <rect class={bytes === 120 ? 'f-fill-amber' : 'f-fill-blue'} x="24" y="38" width={bytes * 0.92} height="24" rx="4" />
            <text class="f-label" x={31 + bytes * 0.92} y="55">{bytes}</text>
          </g>
        ))}
      </g>
    ))}
  </svg>
</Figure>
