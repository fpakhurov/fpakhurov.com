---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// @logged above def add(a, b) is add = logged(add) without ever binding the undecorated function to the name.
// Replayed here: the wrapper keeps the original in its closure and returns what it returns.
{
  const original = (a: number, b: number) => a + b;
  const logged = (func: (a: number, b: number) => number) => (a: number, b: number) => func(a, b);
  const add = logged(original);
  if (add(2, 3) !== 5 || add === original) throw new Error('replay');
}
// Code lines and the step each belongs to.
const code: [string, number][] = [
  ['def logged(func):', 1],
  ['    def wrapper(*args, **kwargs):', 3],
  ['        print("calling", ...)', 5],
  ['        return func(*args, **kwargs)', 5],
  ['    return wrapper', 4],
  ['', 0],
  ['@logged', 2],
  ['def add(a, b):', 1],
  ['    return a + b', 5],
];
const t = ru
  ? { names: 'имена модуля', objects: 'объекты', fLogged: 'функция logged', fWrap: 'функция wrapper', closure: '__closure__: (ячейка,)', cell: 'ячейка func', fOrig: 'функция add (исходная)',
      call: ['add(2, 3) вызывает wrapper;', 'wrapper берёт func из ячейки → 5'],
      steps: ['def logged связывает имя logged; def add создаёт исходную функцию, но имя add ещё не связано', 'Python вызывает logged, передавая исходную функцию; параметр func хранится в ячейке', 'def wrapper создаёт новую функцию, чьё замыкание держит эту ячейку', 'logged возвращает wrapper, и имя add связывается с ним', 'add(2, 3) выполняет wrapper, который через ячейку вызывает исходную функцию и возвращает 5'] }
  : { names: 'module names', objects: 'objects', fLogged: 'function logged', fWrap: 'function wrapper', closure: '__closure__: (cell,)', cell: 'cell: func', fOrig: 'function add (the original)',
      call: ['add(2, 3) runs wrapper;', 'wrapper gets func from its cell → 5'],
      steps: ['def logged binds the name logged; def add creates the original function, but add is not bound yet', 'Python calls logged(the original); its parameter func lives in a cell', 'def wrapper creates a new function whose closure holds that cell', 'logged returns wrapper, and the name add is bound to it', 'add(2, 3) runs wrapper, which calls the original through the cell and returns 5'] };

interface Box { x: number; y: number; w: number; h: number }
interface Layout {
  cls: string; W: number; H: number; codeX: number; codeY0: number; lh: number;
  head: [number, number, number]; nameX: number; nameW: number; nLogged: number; nAdd: number;
  fLogged: Box; fWrap: Box; cell: Box; fOrig: Box; callX: number; callY: number; mono: number; sans: number;
}
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 352, codeX: 40, codeY0: 52, lh: 21, head: [26, 400, 520], nameX: 400, nameW: 74, nLogged: 52, nAdd: 175,
    fLogged: { x: 520, y: 52, w: 220, h: 34 }, fWrap: { x: 520, y: 150, w: 220, h: 50 }, cell: { x: 520, y: 228, w: 130, h: 30 }, fOrig: { x: 520, y: 286, w: 220, h: 34 },
    callX: 40, callY: 300, mono: 7.5, sans: 6.5 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 560, codeX: 16, codeY0: 30, lh: 22, head: [222, 8, 120], nameX: 8, nameW: 82, nLogged: 246, nAdd: 336,
    fLogged: { x: 120, y: 246, w: 232, h: 34 }, fWrap: { x: 120, y: 322, w: 232, h: 54 }, cell: { x: 120, y: 404, w: 150, h: 30 }, fOrig: { x: 120, y: 462, w: 232, h: 34 },
    callX: 8, callY: 524, mono: 8.4, sans: 7.3 },
];
for (const L of layouts) {
  for (const [s] of code) if (L.codeX + s.length * L.mono > (L.W === 760 ? L.nameX - 12 : L.W - 4)) throw new Error(`code "${s}" at ${L.W}`);
  const fits = (b: Box, s: string, w: number) => { if (10 + s.length * w > b.w - 6) throw new Error(`"${s}" overflows its box at ${L.W}`); };
  fits(L.fLogged, t.fLogged, L.sans); fits(L.fWrap, t.fWrap, L.sans); fits(L.fWrap, t.closure, L.mono); fits(L.cell, t.cell, L.sans); fits(L.fOrig, t.fOrig, L.sans);
  for (const s of t.call) if (L.callX + s.length * L.sans > (L.W === 760 ? 500 : L.W - 4)) throw new Error(`call "${s}" at ${L.W}`);
  if (L.codeY0 + (code.length - 1) * L.lh > (L.W === 760 ? L.callY - 20 : L.head[0] - 16)) throw new Error(`code runs into what follows at ${L.W}`);
  if (L.fOrig.y + L.fOrig.h > L.H - 4) throw new Error('original box below the viewBox');
}
const id = 'decorator-wrap';
const box = (b: Box, tone: string, weight = 1.3) => `fill: ${tone}; fill-opacity: 0.14; stroke: ${tone}; stroke-width: ${weight}`;
---

<Figure
  id={id}
  title={ru ? 'Декоратор: add = logged(add)' : 'A decorator: add = logged(add)'}
  caption={ru
    ? 'Что делает @logged над def add. Определение создаёт исходную функцию (1), но вместо того чтобы связать её с именем add, Python передаёт её в logged (2). Внутри logged параметр func живёт в ячейке, и def wrapper создаёт новую функцию, замыкание которой держит эту ячейку (3). logged возвращает wrapper, и имя add связывается с ним (4). Вызов add(2, 3) выполняет wrapper; тот печатает строку, вызывает исходную функцию через ячейку и возвращает её результат 5 (5). Зелёным показаны имена, синим — объекты функций, жёлтым — ячейка замыкания, красным — путь вызова.'
    : 'What @logged above def add does. The definition creates the original function (1), but instead of binding it to the name add, Python passes it to logged (2). Inside logged, the parameter func lives in a cell, and def wrapper creates a new function whose closure holds that cell (3). logged returns wrapper, and the name add is bound to it (4). Calling add(2, 3) runs wrapper, which prints a line, calls the original through the cell and returns its result, 5 (5). Green marks names, blue function objects, amber the closure cell, red the path of the call.'}
>
  {layouts.map((L) => {
    const wide = L.W === 760;
    const midY = (b: Box) => b.y + b.h / 2;
    const nameBox = (y: number, label: string, step: number) => (
      <g data-s={String(step)}>
        <rect x={L.nameX} y={y} width={L.nameW} height={30} rx="5" style={box({ x: 0, y: 0, w: 0, h: 0 }, toneVar.x)} />
        <text class="f-label" x={L.nameX + L.nameW / 2} y={y + 20} text-anchor="middle" style="font-family: var(--mono)">{label}</text>
      </g>
    );
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Имя add после декорирования ссылается на wrapper' : 'After decoration the name add refers to wrapper'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Код декоратора logged и функции add. Справа имена модуля logged и add и объекты: функция logged, функция wrapper с замыканием, ячейка func и исходная функция add. Имя add указывает на wrapper, wrapper — на ячейку, ячейка — на исходную функцию. Красный пунктир показывает путь вызова add(2, 3).'
          : 'The code of the decorator logged and the function add. On the right, the module names logged and add, and the objects: the function logged, the function wrapper with its closure, the cell func, and the original function add. The name add points to wrapper, wrapper to the cell, and the cell to the original function. A red dashed path shows the call add(2, 3).'}</desc>
        {code.map(([s, step], i) => s && (
          <text class="f-small" x={L.codeX} y={L.codeY0 + i * L.lh} data-s={String(step)} style="font-family: var(--mono)">{s}</text>
        ))}
        <text class="f-small f-t-muted" x={L.nameX} y={L.head[0]} style="font-weight: 650">{wide ? t.names : `${t.names} → ${t.objects}`}</text>
        {wide && <text class="f-small f-t-muted" x={L.fLogged.x} y={L.head[0]} style="font-weight: 650">{t.objects}</text>}
        {nameBox(L.nLogged, 'logged', 1)}
        {nameBox(L.nAdd, 'add', 4)}
        <g data-s="1">
          <rect x={L.fLogged.x} y={L.fLogged.y} width={L.fLogged.w} height={L.fLogged.h} rx="6" style={box(L.fLogged, toneVar.h)} />
          <text class="f-small" x={L.fLogged.x + 10} y={midY(L.fLogged) + 4.5}>{t.fLogged}</text>
          <path class="f-line f-green" d={`M ${L.nameX + L.nameW + 2} ${L.nLogged + 15} H ${L.fLogged.x - 4}`} marker-end="url(#f-arrow-green)" />
        </g>
        <g data-s="1">
          <rect x={L.fOrig.x} y={L.fOrig.y} width={L.fOrig.w} height={L.fOrig.h} rx="6" style={box(L.fOrig, toneVar.h)} />
          <text class="f-small" x={L.fOrig.x + 10} y={midY(L.fOrig) + 4.5}>{t.fOrig}</text>
        </g>
        <g data-s="2">
          <rect x={L.cell.x} y={L.cell.y} width={L.cell.w} height={L.cell.h} rx="6" style={box(L.cell, toneVar.g)} />
          <text class="f-small" x={L.cell.x + 10} y={midY(L.cell) + 4.5}>{t.cell}</text>
          <path class="f-line f-amber" d={`M ${L.cell.x + 30} ${L.cell.y + L.cell.h + 1} V ${L.fOrig.y - 3}`} marker-end="url(#f-arrow-amber)" />
          <Badge x={L.cell.x + L.cell.w + 18} y={midY(L.cell)} n={2} />
        </g>
        <g data-s="3">
          <rect x={L.fWrap.x} y={L.fWrap.y} width={L.fWrap.w} height={L.fWrap.h} rx="6" style={box(L.fWrap, toneVar.h)} />
          <text class="f-small" x={L.fWrap.x + 10} y={L.fWrap.y + 20}>{t.fWrap}</text>
          <text class="f-small f-t-muted" x={L.fWrap.x + 10} y={L.fWrap.y + 39} style="font-family: var(--mono)">{t.closure}</text>
          <path class="f-line f-amber" d={`M ${L.cell.x + 30} ${L.fWrap.y + L.fWrap.h + 1} V ${L.cell.y - 3}`} marker-end="url(#f-arrow-amber)" />
          <Badge x={L.fWrap.x + L.fWrap.w - 14} y={L.fWrap.y + 16} n={3} />
        </g>
        <g data-s="4">
          <path class="f-line f-green" d={`M ${L.nameX + L.nameW + 2} ${L.nAdd + 15} L ${L.fWrap.x - 4} ${midY(L.fWrap)}`} marker-end="url(#f-arrow-green)" />
          <Badge x={L.nameX + L.nameW / 2} y={L.nAdd - 14} n={4} />
        </g>
        <g data-s="1">
          <Badge x={L.fOrig.x + L.fOrig.w - 14} y={L.fOrig.y - 10} n={1} />
        </g>
        <g data-s="5">
          <path class="f-line f-red f-dash" d={`M ${L.nameX + L.nameW / 2} ${L.nAdd + 32} V ${L.fOrig.y + L.fOrig.h / 2} H ${L.fOrig.x - 4}`} marker-end="url(#f-arrow-red)" />
          {t.call.map((s, i) => (
            <text class="f-small f-t-red" x={L.callX} y={L.callY + i * 19}>{s}</text>
          ))}
          <Badge x={L.callX + 8} y={L.callY - 24} n={5} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
