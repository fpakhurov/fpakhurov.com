---
import Figure from '../Figure.astro';
import { polyline, scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Calls made by fib(n) = fib(n-1) + fib(n-2), without and with functools.cache.
// Without a cache: c(0) = c(1) = 1 and c(n) = 1 + c(n-1) + c(n-2), which equals 2 F(n+1) - 1 (F the Fibonacci numbers).
// With a cache: each n from 0 to n is computed once, n + 1 calls that miss the cache.
const N = 30;
const F = [0, 1];
for (let i = 2; i <= N + 1; i++) F.push(F[i - 1] + F[i - 2]);
const naive: number[] = [1, 1];
for (let n = 2; n <= N; n++) naive.push(1 + naive[n - 1] + naive[n - 2]);
naive.forEach((c, n) => { if (c !== 2 * F[n + 1] - 1) throw new Error(`c(${n})`); });
if (naive[30] !== 2692537 || naive[10] !== 177) throw new Error('counts');
const cached = naive.map((_, n) => n + 1);
const fmtInt = (v: number) => v.toLocaleString('en-US').replace(/,/g, ru ? ' ' : ',');

const t = ru
  ? { x: 'n', y: 'число вызовов (лог. шкала)', naive: `без кэша: ${fmtInt(naive[30])}`, cached: `с functools.cache: ${cached[30]}`, naiveS: 'без кэша', cachedS: 'с кэшем' }
  : { x: 'n', y: 'calls (log scale)', naive: `no cache: ${fmtInt(naive[30])}`, cached: `functools.cache: ${cached[30]}`, naiveS: 'no cache', cachedS: 'cached' };

interface Layout { cls: string; W: number; H: number; x0: number; x1: number; y0: number; y1: number; sans: number; short: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 290, x0: 70, x1: 560, y0: 250, y1: 20, sans: 6.5, short: false },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 300, x0: 58, x1: 260, y0: 252, y1: 22, sans: 7.3, short: true },
];
const decades = [0, 1, 2, 3, 4, 5, 6, 7];
for (const L of layouts) {
  const lab = L.short ? [t.naiveS, fmtInt(naive[30]), `${t.cachedS}: ${cached[30]}`] : [t.naive, t.cached];
  for (const s of lab) if (L.x1 + 10 + s.length * L.sans > L.W - 2) throw new Error(`label "${s}" at ${L.W}`);
}
const id = 'fib-calls';
---

<Figure
  id={id}
  title={ru ? 'Сколько вызовов делает рекурсивный fib(n)' : 'How many calls the recursive fib(n) makes'}
  caption={ru
    ? `Число вызовов функции fib(n) = fib(n − 1) + fib(n − 2) при n от 0 до ${N}, по логарифмической шкале. Без кэша каждый вызов порождает ещё два, и число вызовов равно 2F(n + 1) − 1, где F — числа Фибоначчи: ${fmtInt(naive[30])} при n = 30. С functools.cache каждое значение вычисляется один раз, и число вызовов, не нашедших результата в кэше, равно n + 1: ${cached[30]} при n = 30. Числа вычислены при сборке страницы по этим формулам и совпадают со счётчиком в разделе «Код».`
    : `The number of calls of fib(n) = fib(n − 1) + fib(n − 2) for n from 0 to ${N}, on a log scale. Without a cache each call starts two more, and the number of calls is 2F(n + 1) − 1, where F are the Fibonacci numbers: ${fmtInt(naive[30])} at n = 30. With functools.cache each value is computed once, and the calls that miss the cache number n + 1: ${cached[30]} at n = 30. The counts are computed when the page is built from these formulas and agree with the counter in the Code section.`}
>
  {layouts.map((L) => {
    const sx = scale([0, N], [L.x0, L.x1]);
    const sy = scale([0, 7], [L.y0, L.y1]);
    const ptsN = naive.map((c, n) => [sx(n), sy(Math.log10(c))] as const);
    const ptsC = cached.map((c, n) => [sx(n), sy(Math.log10(c))] as const);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Экспоненциальный рост против линейного' : 'Exponential growth against linear'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? `Две кривые на логарифмической шкале. Без кэша число вызовов растёт как прямая линия, то есть экспоненциально, до ${fmtInt(naive[30])} при n = 30. С кэшем оно растёт линейно и при n = 30 равно ${cached[30]}.`
          : `Two curves on a log scale. Without a cache the number of calls rises along a straight line, that is exponentially, to ${fmtInt(naive[30])} at n = 30. With a cache it grows linearly and is ${cached[30]} at n = 30.`}</desc>
        {decades.map((d) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(d)} H ${L.x1}`} />
            <text class="f-small f-t-muted" x={L.x0 - 8} y={sy(d) + 4} text-anchor="end">{d === 0 ? '1' : `10${'⁰¹²³⁴⁵⁶⁷'[d]}`}</text>
          </g>
        ))}
        {[0, 10, 20, 30].map((n) => (
          <text class="f-small f-t-muted" x={sx(n)} y={L.y0 + 18} text-anchor="middle">{n}</text>
        ))}
        <path class="f-axis" d={`M ${L.x0} ${L.y1} V ${L.y0} H ${L.x1}`} />
        <text class="f-small f-t-muted" x={L.x1 + 4} y={L.y0 + 18}>{t.x}</text>
        <text class="f-small f-t-muted" x={L.x0} y={L.y1 - 6}>{t.y}</text>
        <path class="f-line f-red" d={polyline(ptsN)} />
        <path class="f-line f-blue" d={polyline(ptsC)} />
        {L.short ? (
          <g>
            <text class="f-small f-t-red" x={L.x1 + 10} y={sy(Math.log10(naive[30])) + 2}>{t.naiveS}</text>
            <text class="f-small f-t-red" x={L.x1 + 10} y={sy(Math.log10(naive[30])) + 20}>{fmtInt(naive[30])}</text>
            <text class="f-small f-t-blue" x={L.x1 + 10} y={sy(Math.log10(cached[30])) + 4}>{t.cachedS}: {cached[30]}</text>
          </g>
        ) : (
          <g>
            <text class="f-small f-t-red" x={L.x1 + 10} y={sy(Math.log10(naive[30])) + 4}>{t.naive}</text>
            <text class="f-small f-t-blue" x={L.x1 + 10} y={sy(Math.log10(cached[30])) + 4}>{t.cached}</text>
          </g>
        )}
      </svg>
    );
  })}
</Figure>
