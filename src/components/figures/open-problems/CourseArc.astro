---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The seven sections of the course as one chain: each one keeps the agent-environment loop of the first note and adds
// what the previous sections could not do.
const t = ru
  ? {
      title: 'Курс как одна цепочка',
      boxes: [['агенты', 'известный мир: поиск, MDP'], ['RL', 'учиться по награде'], ['LLM как стратегия', 'рассуждения, инструменты'], ['память и планы', 'больше одного окна'],
        ['агенты в работе', 'код, веб, поиск, команды'], ['обучение', 'RLHF, GRPO, агентный RL'], ['оценка и безопасность', 'мерить, защищать, следить']],
      steps: ['агент, среда, мера качества; поиск и MDP, когда мир известен', 'обучение с подкреплением, когда мир неизвестен: Q-обучение, градиент по стратегии, модели мира', 'языковая модель становится стратегией: цепочка рассуждений, инструменты, цикл ReAct', 'память, планирование, рефлексия, рабочие процессы и протоколы для задач длиннее окна', 'агенты в реальных средах: репозиторий, экран, веб, несколько агентов', 'обучение языковых моделей с подкреплением: от одного ответа до многошаговых задач', 'оценка, защита от инъекций, выравнивание и надзор'],
      desc: 'Семь блоков, соединённых стрелками: агенты и среды, обучение с подкреплением, языковая модель как стратегия, память и планирование, агенты в работе, обучение агентов, оценка и безопасность. В каждом блоке под названием указано, что он добавляет.',
    }
  : {
      title: 'The course as one chain',
      boxes: [['agents', 'known world: search, MDPs'], ['RL', 'learn from reward'], ['LLM as a policy', 'reason, call tools, loop'], ['memory and planning', 'beyond one context window'],
        ['agents at work', 'code, web, research, teams'], ['training', 'RLHF, GRPO, agentic RL'], ['evaluation, safety', 'measure, defend, oversee']],
      steps: ['agent, environment, performance measure; search and MDPs when the world is known', 'reinforcement learning when it is not: Q-learning, policy gradients, world models', 'a language model becomes the policy: chain of thought, tools, the ReAct loop', 'memory, planning, reflection, workflows and protocols for tasks longer than a window', 'agents in real environments: a repository, a screen, the web, several agents', 'reinforcement learning on language models, from single answers to multi-step tasks', 'evaluation, defence against injection, alignment and oversight'],
      desc: 'Seven boxes joined by arrows: agents and environments, reinforcement learning, the language model as a policy, memory and planning, agents at work, training agents, evaluation and safety. Under each name, what that section adds.',
    };
const id = 'course-arc';
const caption = ru
  ? 'Каждый раздел сохраняет цикл «агент — среда» из первой заметки и добавляет то, чего не умели предыдущие: незнакомый мир, текст как действия, длинные задачи, реальные среды, обучение на наградах, а в конце — способы понять, работает ли агент и безопасен ли он.'
  : 'Every section keeps the agent–environment loop of the first note and adds what the earlier ones could not do: an unknown world, text as actions, long tasks, real environments, training on rewards, and at the end ways to know whether the agent works and is safe.';
const W = { xs: [14, 200, 386, 572], w: 174, h: 50, y1: 30, y2: 140 };
const row2 = [572, 386, 200];
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 210" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    {W.xs.map((x, i) => (
      <g data-s={String(i + 1)}>
        {i > 0 && <Arrow pts={[[x - 12, W.y1 + 25], [x - 2, W.y1 + 25]]} />}
        <Box x={x} y={W.y1} w={W.w} h={W.h} label={t.boxes[i][0]} sub={t.boxes[i][1]} tone={i === 0 ? 'x' : 'h'} />
        <Badge x={x + W.w - 12} y={W.y1} n={i + 1} />
      </g>
    ))}
    {row2.map((x, j) => (
      <g data-s={String(j + 5)}>
        {j === 0 ? <Arrow pts={[[659, W.y1 + W.h], [659, W.y2 - 2]]} /> : <Arrow pts={[[x + W.w + 12, W.y2 + 25], [x + W.w + 2, W.y2 + 25]]} />}
        <Box x={x} y={W.y2} w={W.w} h={W.h} label={t.boxes[j + 4][0]} sub={t.boxes[j + 4][1]} tone={j === 2 ? 'y' : 'h'} />
        <Badge x={x + W.w - 12} y={W.y2} n={j + 5} />
      </g>
    ))}
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 456" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    {t.boxes.map((b, i) => (
      <g data-s={String(i + 1)}>
        {i > 0 && <Arrow pts={[[180, 8 + i * 64 - 16], [180, 8 + i * 64 - 2]]} />}
        <Box x={60} y={8 + i * 64} w={240} h={48} label={b[0]} sub={b[1]} tone={i === 0 ? 'x' : i === 6 ? 'y' : 'h'} />
        <Badge x={288} y={8 + i * 64} n={i + 1} />
      </g>
    ))}
  </svg>
  <Stepper steps={t.steps} />
</Figure>
