---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Success of an n-step task with per-step success p = 0.99, three ways (the formulas of the note and the Code section):
//  none:        p^n
//  recovery:    (1 - (1 - p)(1 - rho))^n, an error noticed and repaired with probability rho = 0.6
//  checkpoints: every m = 10 steps a verifier checks the segment; it catches a bad one with d = 0.9, rejects a good one
//               with f = 0.05; a rejected segment is redone, at most r = 2 times. Segment success
//               s(1 - f) sum_{j<=r} (s f + (1 - s) d)^j with s = p^m; the task needs n/m segments.
const p = 0.99, rho = 0.6, m = 10, d = 0.9, f = 0.05, r = 2;
const none = (n: number) => p ** n;
const recover = (n: number) => (1 - (1 - p) * (1 - rho)) ** n;
const s = p ** m, again = s * f + (1 - s) * d;
const seg = s * (1 - f) * Array.from({ length: r + 1 }, (_, j) => again ** j).reduce((a, b) => a + b, 0);
const check = (n: number) => seg ** (n / m);
const quoted = [10, 100, 300, 1000].map((n) => [none(n), recover(n), check(n)].map((v) => v.toFixed(3)).join('/')).join(' ');
if (quoted !== '0.904/0.961/0.987 0.366/0.670/0.875 0.049/0.300/0.670 0.000/0.018/0.264') throw new Error(`ErrorCompounding: numbers drifted from the note (${quoted})`);
const nHalf = Math.log(0.5) / Math.log(p);

const t = ru
  ? { title: 'Как ошибки накапливаются за n шагов и что с этим делают проверка и восстановление', x: 'число шагов n (логарифмическая шкала)', y: 'доля успешных задач',
      none: 'без восстановления: pⁿ', rec: 'восстановление, ρ = 0.6', chk: 'проверка каждые 10 шагов',
      half: `0.5 при n = ${nHalf.toFixed(0)}`,
      desc: 'Три убывающие кривые для вероятности успеха шага 0.99 и числа шагов от 1 до 1000 на логарифмической шкале. Без восстановления доля падает до 0.366 при 100 шагах и почти до нуля при 1000. С восстановлением после ошибок с вероятностью 0.6 — 0.670 при 100 шагах. С проверкой каждые 10 шагов и повтором отрезка — 0.875 при 100 шагах и 0.264 при 1000.' }
  : { title: 'How errors compound over n steps, and what verification and recovery do', x: 'number of steps n (log scale)', y: 'share of tasks that succeed',
      none: 'no recovery: pⁿ', rec: 'recovery, ρ = 0.6', chk: 'checkpoint every 10 steps',
      half: `0.5 at n = ${nHalf.toFixed(0)}`,
      desc: 'Three falling curves for per-step success 0.99 and 1 to 1000 steps on a log scale. With no recovery the success rate is 0.366 at 100 steps and near zero at 1000. With errors repaired with probability 0.6 it is 0.670 at 100 steps. With a verifier every 10 steps and redone segments it is 0.875 at 100 steps and 0.264 at 1000.' };
const id = 'error-compounding';
const caption = ru
  ? `Шаг удаётся с вероятностью p = 0.99. Без восстановления задача из n шагов удаётся с вероятностью pⁿ: половина задач проваливается уже при ${nHalf.toFixed(0)} шагах. Восстановление после замеченной ошибки (ρ = 0.6) делает окончательный отказ шага в 2.5 раза реже. Проверка каждые 10 шагов (ловит плохой отрезок с вероятностью 0.9, ложно бракует хороший с 0.05, до двух повторов) сдвигает кривую дальше всего, но и она падает: при 1000 шагах остаётся ${check(1000).toFixed(3)}, потому что пропущенные проверкой ошибки тоже накапливаются.`
  : `A step succeeds with probability p = 0.99. With no recovery, an n-step task succeeds with probability pⁿ: half the tasks fail by ${nHalf.toFixed(0)} steps. Repairing a noticed error (ρ = 0.6) makes a step fail for good 2.5 times less often. A verifier every 10 steps (catches a bad segment with probability 0.9, wrongly rejects a good one with 0.05, at most two redos) moves the curve furthest, and it falls too: at 1000 steps ${check(1000).toFixed(3)} remains, because the errors the verifier misses compound as well.`;

const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [70, 740] as [number, number], py: [40, 270] as [number, number], leg: [96, 196, 22] as [number, number, number] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 410, px: [52, 344] as [number, number], py: [40, 250] as [number, number], leg: [20, 326, 26] as [number, number, number] },
];
const yTicks = [0, 0.25, 0.5, 0.75, 1.0], xTicks = [1, 10, 100, 1000];
const ns = Array.from({ length: 61 }, (_, i) => 10 ** (i / 20));
const series = [
  { f: none, cls: 'f-red', txt: 'f-t-red', lab: 0, from: 1 },
  { f: recover, cls: 'f-amber', txt: 'f-t-amber', lab: 1, from: 1 },
  { f: check, cls: 'f-blue', txt: 'f-t-blue', lab: 2, from: 10 },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sx = scale([0, 3], L.px), sy = scale([0, 1], [L.py[1], L.py[0]]);
    const X = (n: number) => sx(Math.log10(n));
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {yTicks.map((v) => <path class="f-grid" d={`M ${L.px[0]} ${sy(v)} H ${L.px[1]}`} />)}
        <path class="f-axis" d={`M ${L.px[0]} ${L.py[0] - 6} V ${L.py[1]} H ${L.px[1]}`} />
        {yTicks.map((v) => <text class="f-small" x={L.px[0] - 7} y={sy(v) + 4} text-anchor="end">{v.toFixed(2)}</text>)}
        {xTicks.map((v) => <text class="f-small" x={X(v)} y={L.py[1] + 18} text-anchor="middle">{String(v)}</text>)}
        <text class="f-small f-t-muted" x={(L.px[0] + L.px[1]) / 2} y={L.py[1] + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.px[0] - 40} y={L.py[0] - 20}>{t.y}</text>
        {series.map((S) => <path class={`f-line ${S.cls}`} d={polyline(ns.filter((n) => n >= S.from - 1e-9).map((n) => [X(n), sy(S.f(n))] as [number, number]))} />)}
        <circle cx={X(nHalf)} cy={sy(0.5)} r="3.4" style="fill: var(--fig-red)" />
        <text class="f-small f-t-red f-halo" x={X(nHalf) - 8} y={sy(0.5) + 18} text-anchor="end">{t.half}</text>
        {[100, 1000].map((n) => <circle cx={X(n)} cy={sy(check(n))} r="3.4" style="fill: var(--fig-blue)" />)}
        <text class="f-small f-t-blue f-halo" x={X(1000) - 8} y={sy(check(1000)) - 10} text-anchor="end">{check(1000).toFixed(3)}</text>
        {series.map((S) => (
          <g>
            <path class={`f-line ${S.cls}`} d={`M ${L.leg[0]} ${L.leg[1] + S.lab * L.leg[2] - 4} h 22`} />
            <text class={`f-small ${S.txt}`} x={L.leg[0] + 30} y={L.leg[1] + S.lab * L.leg[2]}>{[t.none, t.rec, t.chk][S.lab]}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
