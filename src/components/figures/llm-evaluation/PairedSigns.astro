---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const ru = pageLang(Astro.url) === 'ru';
const ticks = ['−1/2', '−1/3', '−1/6', '0', '1/6', '1/3', '1/2'];
const title = ru ? "64 назначения знаков в парах" : "The 64 possible paired sign assignments";
const caption = ru ? "Шесть несовпавших исходов дают семь средних разностей по двенадцати примерам. Столбцы считают назначения при указанной гипотезе взаимозаменяемости." : "Six discordant items give seven possible mean differences over twelve items. The bars count assignments under the stated exchangeability null.";
const description = ru ? "Частоты 1, 6, 15, 20, 15, 6, 1 для разностей от минус половины до плюс половины." : "Assignment counts 1, 6, 15, 20, 15, 6, 1 at differences minus one half through plus one half.";
---
<Figure id="evaluation-paired-signs" title={title} caption={caption}>
  <svg viewBox="0 0 320 265" role="img" aria-labelledby="evaluation-paired-signs-title evaluation-paired-signs-desc">
    <title id="evaluation-paired-signs-title">{title}</title>
    <desc id="evaluation-paired-signs-desc">{description}</desc>
    <text x="20" y="20">{ru ? 'Число назначений' : 'Assignment count'}</text>
    <line x1="20" y1="205" x2="310" y2="205" class="axis" />
    {cases.paired.sign_distribution.map((r, i) => <g><rect data-case="sign" data-index={i} data-value={r.assignments} x={29 + i * 40} y={205 - r.assignments * 7} width="22" height={r.assignments * 7} class="blue" /><text x={40 + i * 40} y={198 - r.assignments * 7} text-anchor="middle" class="number">{r.assignments}</text><text x={40 + i * 40} y="228" text-anchor="middle" class="number">{ticks[i]}</text></g>)}
    <text x="160" y="256" text-anchor="middle">{ru ? 'Средняя разность A − B' : 'Mean difference A − B'}</text>
  </svg>
</Figure>
<style>
  svg { display: block; width: 100%; max-width: 34rem; height: auto; margin-inline: auto; }
  text { font: 15px var(--sans, sans-serif); fill: var(--ink); }
  .axis { stroke: var(--line); stroke-width: 1; }
  .blue { fill: var(--fig-blue); }
  .orange { fill: var(--fig-amber); }
  .muted { fill: var(--muted); }
  .outline { fill: none; stroke: var(--fig-blue); stroke-width: 2; }
  .number { font-variant-numeric: tabular-nums; }
</style>
