---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const ru = pageLang(Astro.url) === 'ru';
const x = (v) => v * 0.24;
const title = ru ? "Быстрая середина и медленный хвост" : "A fast middle can coexist with a slow tail";
const caption = ru ? "Десять заданных времён завершения. По ближайшему рангу p50 = 150 мс, p90 = 300 мс, p95 = 900 мс." : "Ten constructed completion times. Nearest-rank p50 = 150 ms, p90 = 300 ms, p95 = 900 ms.";
const description = ru ? "Времена завершения по возрастанию, от 80 до 900 миллисекунд. Последнее наблюдение втрое больше девятого." : "Completion times in ascending order, from 80 to 900 milliseconds. The final observation is three times the ninth.";
---
<Figure id="evaluation-latency-tail" title={title} caption={caption}>
  <svg viewBox="0 0 320 370" role="img" aria-labelledby="evaluation-latency-tail-title evaluation-latency-tail-desc">
    <title id="evaluation-latency-tail-title">{title}</title>
    <desc id="evaluation-latency-tail-desc">{description}</desc>
    <text x="12" y="20">{ru ? 'Ранг' : 'Rank'}</text><text x="78" y="20">{ru ? 'Время, мс' : 'Time, ms'}</text>
    {cases.latency.milliseconds.map((v, i) => <g><text x="20" y={53 + i * 29} class="number">{i + 1}</text><rect data-case="latency" data-index={i} data-value={v} x="62" y={40 + i * 29} width={x(v)} height="16" class={i === 9 ? 'orange' : 'blue'} /><text x={68 + x(v)} y={53 + i * 29} class="number">{v}</text></g>)}
    <text x="62" y="356">0</text><text x="278" y="356" text-anchor="middle">900</text>
  </svg>
</Figure>
<style>
  svg { display: block; width: 100%; max-width: 34rem; height: auto; margin-inline: auto; }
  text { font: 15px var(--sans, sans-serif); fill: var(--ink); }
  .axis { stroke: var(--line); stroke-width: 1; }
  .blue { fill: var(--fig-blue); }
  .orange { fill: var(--fig-amber); }
  .muted { fill: var(--muted); }
  .outline { fill: none; stroke: var(--fig-blue); stroke-width: 2; }
  .number { font-variant-numeric: tabular-nums; }
</style>
