---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const ru = pageLang(Astro.url) === 'ru';
const names = ru ? ['Неотрицательные', 'С отрицательными', 'Все примеры', 'Среднее групп'] : ['Nonnegative', 'Signed inputs', 'All items', 'Equal-group mean'];
const values = ['a', 'b'].map(k => [cases.rates[k].groups.nonnegative.rate, cases.rates[k].groups.signed.rate, cases.rates[k].micro, cases.rates[k].macro]);
const bars = names.flatMap((_, i) => values.map((row, j) => ({i, j, value: row[i], y: 47 + i * 77 + j * 21})));
const title = ru ? "Одинаковый итог скрывает разные ошибки" : "A shared total hides different failures";
const caption = ru ? "Синий: A. Оранжевый: B. Среднее групп меняет веса, а не исходы проверок." : "Blue: A. Orange: B. The equal-group mean changes the weights, not the underlying outcomes.";
const description = ru ? "У A и B общий результат 8/12. Для входов с отрицательными числами доли 0 и 2/3; средние групп 4/9 и 2/3." : "A and B both pass 8/12 overall. Their signed-input rates are 0 and 2/3; equal-group means are 4/9 and 2/3.";
---
<Figure id="evaluation-stratum-rates" title={title} caption={caption}>
  <svg viewBox="0 0 320 360" role="img" aria-labelledby="evaluation-stratum-rates-title evaluation-stratum-rates-desc">
    <title id="evaluation-stratum-rates-title">{title}</title>
    <desc id="evaluation-stratum-rates-desc">{description}</desc>
    <text x="20" y="18">{ru ? 'Доля успехов' : 'Pass rate'}</text>
    {names.map((name, i) => <text x="20" y={41 + i * 77}>{name}</text>)}
    {bars.map(b => <g><rect data-case="rate" data-index={b.i} data-series={b.j} data-value={b.value} x="20" y={b.y} width={b.value * 240} height="13" class={b.j ? 'orange' : 'blue'} /><text x={26 + b.value * 240} y={b.y + 12} class="number">{b.value.toFixed(3)}</text></g>)}
    <text x="20" y="350">0</text><text x="260" y="350" text-anchor="middle">1</text>
  </svg>
</Figure>
<style>
  svg { display: block; width: 100%; max-width: 34rem; height: auto; margin-inline: auto; }
  text { font: 15px var(--sans, sans-serif); fill: var(--ink); }
  .axis { stroke: var(--line); stroke-width: 1; }
  .blue { fill: var(--fig-blue); }
  .orange { fill: var(--fig-amber); }
  .muted { fill: var(--muted); }
  .outline { fill: none; stroke: var(--fig-blue); stroke-width: 2; }
  .number { font-variant-numeric: tabular-nums; }
</style>
