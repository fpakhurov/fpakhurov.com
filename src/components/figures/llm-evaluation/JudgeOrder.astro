---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';
import cases from './cases.json';
const ru = pageLang(Astro.url) === 'ru';
const label = (v) => v === 'tie' ? (ru ? 'ничья' : 'tie') : v;
const title = ru ? "Меняем порядок, сохраняем кандидата" : "Reverse presentation, preserve identity";
const caption = ru ? "AB и BA — порядки показа. Ячейки называют выбранного кандидата; в первой строке победитель меняется." : "AB and BA are display orders. Entries name the selected candidate; the first row reverses its winner.";
const description = ru ? "Пример 1 выбирает A при порядке AB и B при BA. В примерах 2 и 4 остаются B и A, в третьем сохраняется ничья." : "Item one selects A in AB order and B in BA order. Items two and four keep B and A; item three stays tied.";
---
<Figure id="evaluation-judge-order" title={title} caption={caption}>
  <svg viewBox="0 0 320 245" role="img" aria-labelledby="evaluation-judge-order-title evaluation-judge-order-desc">
    <title id="evaluation-judge-order-title">{title}</title>
    <desc id="evaluation-judge-order-desc">{description}</desc>
    <text x="20" y="24">{ru ? 'Пример' : 'Item'}</text><text x="150" y="24" text-anchor="middle">AB</text><text x="260" y="24" text-anchor="middle">BA</text>
    {cases.judge_order.map((r, i) => <g data-case="judge" data-index={i} data-ab={r.order_ab} data-ba={r.order_ba}>
      {r.order_ab !== r.order_ba && <rect x="12" y={43 + i * 46} width="296" height="38" rx="4" class="outline" />}
      <text x="20" y={68 + i * 46}>{r.item}</text><text x="150" y={68 + i * 46} text-anchor="middle">{label(r.order_ab)}</text><text x="260" y={68 + i * 46} text-anchor="middle">{label(r.order_ba)}</text>
    </g>)}
  </svg>
</Figure>
<style>
  svg { display: block; width: 100%; max-width: 34rem; height: auto; margin-inline: auto; }
  text { font: 15px var(--sans, sans-serif); fill: var(--ink); }
  .axis { stroke: var(--line); stroke-width: 1; }
  .blue { fill: var(--fig-blue); }
  .orange { fill: var(--fig-amber); }
  .muted { fill: var(--muted); }
  .outline { fill: none; stroke: var(--fig-blue); stroke-width: 2; }
  .number { font-variant-numeric: tabular-nums; }
</style>
