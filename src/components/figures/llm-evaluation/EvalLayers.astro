---
import BlockDiagram, { type DLayout } from '../BlockDiagram.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Which instrument measures which part of an LLM system, and what calibrates the judge.
const t = ru
  ? { q: 'запрос', ret: 'поиск', gen: 'генератор', genSub: 'модель + промпт', ans: 'ответ', mRet: 'эталонная выборка', mRetSub: 'Hit@k, MRR', mGen: 'бенчмарки', mGenSub: 'единый формат', mAns: 'модель-судья', mAnsSub: 'рубрика, шкала 1–4', ppl: 'люди', pplSub: 'попарно, κ', cal: 'согласие r, κ', wf: 'вся система', wfSub: 'успех по этапам · задержка · стоимость · надёжность · прогон при каждом изменении' }
  : { q: 'query', ret: 'retriever', gen: 'generator', genSub: 'model + prompt', ans: 'answer', mRet: 'golden set', mRetSub: 'Hit@k, MRR', mGen: 'benchmarks', mGenSub: 'one fixed format', mAns: 'model judge', mAnsSub: 'rubric, scale 1–4', ppl: 'people', pplSub: 'pairwise, κ', cal: 'agreement r, κ', wf: 'the whole workflow', wfSub: 'success by stage · latency · cost · reliability · rerun on every change' };
const desc = ru
  ? 'Верхний ряд — система: запрос, поиск, генератор, ответ. Под каждым этапом — его инструмент оценки: эталонная выборка с Hit@k и MRR для поиска, бенчмарки в едином формате для базовой модели генератора, модель-судья с рубрикой для ответа. Судью калибруют по людям через согласие r и κ. Внизу — оценка всей системы: успех по этапам, задержка, стоимость, надёжность, прогон при каждом изменении.'
  : 'Top row, the system: query, retriever, generator, answer. Under each stage, its instrument: a golden set with Hit@k and MRR for the retriever, benchmarks in one fixed format for the generator\'s base model, a model judge with a rubric for the answer. The judge is calibrated against people through agreement r and κ. At the bottom, the whole workflow: success by stage, latency, cost, reliability, rerun on every change.';
const wide: DLayout = {
  cls: 'fig-wide', w: 720, h: 262, desc,
  nodes: [
    { id: 'q', x: 8, y: 30, w: 76, h: 44, label: t.q, tone: 'soft' },
    { id: 'ret', x: 108, y: 30, w: 150, h: 44, label: t.ret, tone: 'blue' },
    { id: 'gen', x: 286, y: 24, w: 150, h: 56, label: t.gen, sub: t.genSub, tone: 'blue' },
    { id: 'ans', x: 464, y: 30, w: 136, h: 44, label: t.ans, tone: 'soft' },
    { id: 'mRet', x: 108, y: 118, w: 150, h: 52, label: t.mRet, sub: t.mRetSub, tone: 'amber' },
    { id: 'mGen', x: 286, y: 118, w: 150, h: 52, label: t.mGen, sub: t.mGenSub, tone: 'amber' },
    { id: 'mAns', x: 464, y: 118, w: 136, h: 52, label: t.mAns, sub: t.mAnsSub, tone: 'amber' },
    { id: 'ppl', x: 626, y: 118, w: 86, h: 52, label: t.ppl, sub: t.pplSub, tone: 'green' },
    { id: 'wf', x: 8, y: 206, w: 704, h: 48, label: t.wf, sub: t.wfSub },
  ],
  edges: [
    { from: 'q', to: 'ret' }, { from: 'ret', to: 'gen' }, { from: 'gen', to: 'ans' },
    { from: 'ret', to: 'mRet', tone: 'muted', dashed: true },
    { from: 'gen', to: 'mGen', tone: 'muted', dashed: true },
    { from: 'ans', to: 'mAns', tone: 'muted', dashed: true },
    { from: 'ppl', to: 'mAns', tone: 'green', label: t.cal, at: [669, 192] },
  ],
};
const narrow: DLayout = {
  cls: 'fig-narrow', w: 360, h: 396, desc,
  nodes: [
    { id: 'q', x: 8, y: 8, w: 140, h: 36, label: t.q, tone: 'soft' },
    { id: 'ret', x: 8, y: 66, w: 140, h: 48, label: t.ret, tone: 'blue' },
    { id: 'gen', x: 8, y: 134, w: 140, h: 48, label: t.gen, sub: t.genSub, tone: 'blue' },
    { id: 'ans', x: 8, y: 202, w: 140, h: 48, label: t.ans, tone: 'soft' },
    { id: 'mRet', x: 180, y: 66, w: 172, h: 48, label: t.mRet, sub: t.mRetSub, tone: 'amber' },
    { id: 'mGen', x: 180, y: 134, w: 172, h: 48, label: t.mGen, sub: t.mGenSub, tone: 'amber' },
    { id: 'mAns', x: 180, y: 202, w: 172, h: 48, label: t.mAns, sub: t.mAnsSub, tone: 'amber' },
    { id: 'ppl', x: 180, y: 278, w: 172, h: 44, label: t.ppl, sub: t.pplSub, tone: 'green' },
    { id: 'wf', x: 8, y: 340, w: 344, h: 48, label: t.wf, sub: ru ? 'успех, задержка, стоимость, надёжность' : 'success, latency, cost, reliability' },
  ],
  edges: [
    { from: 'q', to: 'ret' }, { from: 'ret', to: 'gen' }, { from: 'gen', to: 'ans' },
    { from: 'ret', to: 'mRet', tone: 'muted', dashed: true },
    { from: 'gen', to: 'mGen', tone: 'muted', dashed: true },
    { from: 'ans', to: 'mAns', tone: 'muted', dashed: true },
    { from: 'ppl', to: 'mAns', tone: 'green', label: t.cal, at: [172, 270], anchor: 'end' },
  ],
};
---

<BlockDiagram
  id="eval-layers"
  title={ru ? 'Что чем измеряется в LLM-системе' : 'What measures what in an LLM system'}
  svgTitle={ru ? 'Этапы системы и инструменты их оценки' : 'System stages and their evaluation instruments'}
  caption={ru
    ? 'Каждый этап системы получает свой инструмент, потому что ошибки этапов независимы и их нужно приписывать тому этапу, который их вызвал. Поиск измеряется на эталонной выборке, базовая модель генератора — на бенчмарках, где каждую модель прогоняют через один и тот же формат промпта и правило подсчёта, а свободный ответ, у которого нет эталона, — моделью-судьёй по рубрике. Судья сам по себе ничего не стоит, пока его согласие с людьми не измерено; люди — эталон, но шумный. Вся система оценивается сверх этого по успеху задачи, задержке, стоимости и надёжности на наборе, который перезапускается при каждом изменении промпта, модели, индекса или инструмента.'
    : 'Each stage of the system gets its own instrument, because the stages fail independently and each failure has to be attributed to the stage that caused it. The retriever is measured on a golden set, the generator\'s base model on benchmarks that run every model through the same prompt format and scoring rule, and the free-text answer, which has no reference, by a model judge with a rubric. The judge is worth nothing until its agreement with people is measured; people are the reference, and a noisy one. On top of that, the whole workflow is scored on task success, latency, cost and reliability, on a suite rerun on every change to a prompt, a model, an index or a tool.'}
  layouts={[wide, narrow]}
/>
