---
import Figure from '../Figure.astro';

const { lang = 'en' } = Astro.props;
const ru = lang === 'ru';
const title = ru ? 'Каждая позиция чая даёт две пары' : 'Each tea line contributes two pairs';
const caption = ru
  ? 'Строки — позиции, столбцы — предложения. Сумма количеств по шести ячейкам равна 8, хотя в трёх позициях продано 4 единицы.'
  : 'Rows are order lines and columns are offers. Quantities sum to 8 across the six cells, even though the three lines sold 4 units.';
const desc = ru
  ? 'У позиций 101/1, 102/1 и 103/2 количество 2, 1 и 1. Каждая позиция сопоставляется с обоими поставщиками.'
  : 'Lines 101/1, 102/1 and 103/2 have quantities 2, 1 and 1. Each line matches both suppliers.';
const lines = [
  ['101/1', 2],
  ['102/1', 1],
  ['103/2', 1],
] as const;
const suppliers = ['A', 'B'];
const rowLabel = ru ? 'Позиция' : 'Line';
const columnLabel = ru ? 'Поставщик' : 'Supplier';
---
<Figure id="sql-tea-pairs" title={title} caption={caption}>
  <svg viewBox="0 0 340 176" role="img" aria-labelledby="sql-tea-pairs-title sql-tea-pairs-desc" style="max-width: 550px; margin-inline: auto">
    <title id="sql-tea-pairs-title">{title}</title>
    <desc id="sql-tea-pairs-desc">{desc}</desc>
    <text class="f-label" x="55" y="31" text-anchor="middle">{rowLabel}</text>
    {suppliers.map((supplier, i) => (
      <text class="f-label" x={146 + i * 118} y="31" text-anchor="middle">{columnLabel} {supplier}</text>
    ))}
    {lines.map(([line, quantity], i) => (
      <g transform={`translate(0 ${i * 38})`}>
        <text class="f-label" x="55" y="64" text-anchor="middle">{line}</text>
        {suppliers.map((_, j) => (
          <g transform={`translate(${j * 118} 0)`}>
            <rect class="f-fill-blue" x="98" y="44" width="96" height="29" rx="5" />
            <text class="f-label" x="146" y="64" text-anchor="middle">{quantity}</text>
          </g>
        ))}
      </g>
    ))}
  </svg>
</Figure>
