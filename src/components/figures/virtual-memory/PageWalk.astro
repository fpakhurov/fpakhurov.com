---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The Sv32 walk of the note's worked example (and of its Python code): a load from virtual address 0x10010008.
// satp.PPN = 0x80000 points to the root table; root PTE 64 points to a leaf table at PPN 0x80001; leaf PTE 16 maps
// the page to frame 0x8F0E2 with V, R, W, U, A and D set.
const PAGE = 4096;
const va = 0x10010008;
const vpn1 = va >>> 22, vpn0 = (va >>> 12) & 0x3ff, off = va & 0xfff;
const satpPpn = 0x80000;
const rootPteAddr = satpPpn * PAGE + vpn1 * 4;
const rootPte = (0x80001 << 10) | 0x01; // V only: a pointer
const leafPteAddr = (rootPte >>> 10) * PAGE + vpn0 * 4;
const flags = { V: 1, R: 2, W: 4, X: 8, U: 16, G: 32, A: 64, D: 128 };
const leafPte = ((0x8f0e2 << 10) | flags.V | flags.R | flags.W | flags.U | flags.A | flags.D) >>> 0;
const pa = (leafPte >>> 10) * PAGE + off;
const h = (v: number, w: number) => '0x' + v.toString(16).toUpperCase().padStart(w, '0');
if (vpn1 !== 0x40 || vpn0 !== 0x10 || off !== 0x8) throw new Error(`split ${vpn1} ${vpn0} ${off}`);
if (rootPteAddr !== 0x80000100 || rootPte !== 0x20000401) throw new Error(`root PTE ${h(rootPteAddr, 8)} ${h(rootPte, 8)}`);
if (leafPteAddr !== 0x80001040 || leafPte !== 0x23c388d7) throw new Error(`leaf PTE ${h(leafPteAddr, 8)} ${h(leafPte, 8)}`);
if (pa !== 0x8f0e2008) throw new Error(`PA ${h(pa, 8)}`);
if ((rootPte & (flags.R | flags.W | flags.X)) !== 0 || (leafPte & flags.R) === 0) throw new Error('pointer and leaf bits');

const t = ru
  ? {
      va: `виртуальный адрес ${h(va, 8)}`, vaA: 'виртуальный адрес', vaB: h(va, 8),
      f: [[`VPN[1] ${h(vpn1, 3)}`, 'биты 31–22'], [`VPN[0] ${h(vpn0, 3)}`, 'биты 21–12'], [`смещение ${h(off, 3)}`, 'биты 11–0']],
      tlb: 'TLB', tlbSub: `${h(va >>> 12, 5)}: промах`, tlbN: `TLB: промах для VPN ${h(va >>> 12, 5)}`,
      satp: 'satp', satpSub: `PPN ${h(satpPpn, 5)}`, ppn: 'PTE.PPN',
      heads: [['корневая таблица', `по адресу ${h(satpPpn * PAGE, 8)}`], ['таблица нижнего уровня', `по адресу ${h(0x80001 * PAGE, 8)}`], [`кадр ${h(0x8f0e2, 5)}`, 'одна страница 4 КиБ']],
      headsN: ['корневая', 'нижний уровень', `кадр ${h(0x8f0e2, 5)}`],
      fN: [[h(vpn1, 3), 'VPN[1]'], [h(vpn0, 3), 'VPN[0]'], [h(off, 3), 'смещение']],
      word: 'слово', pa: h(pa, 8), paSub: 'физический', paN: `PA ${h(pa, 8)}`, paNSub: `PPN ${h(0x8f0e2, 5)} ∥ смещение ${h(off, 3)}`,
      d1: `PTE ${h(rootPte, 8)}: PPN ${h(0x80001, 5)}, установлен только V → указатель на следующую таблицу`,
      d2: `PTE ${h(leafPte, 8)}: PPN ${h(0x8f0e2, 5)}, биты D A U W R V → лист: чтение и запись из режима U`,
      d1N: `${h(rootPte, 8)}: указатель`, d2N: `${h(leafPte, 8)}: лист`,
      i1: `VPN[1] = ${vpn1}`, i0: `VPN[0] = ${vpn0}`, iOff: `смещение = ${h(off, 3)}`,
      steps: [
        `в TLB нет записи для VPN ${h(va >>> 12, 5)}: промах, и аппаратура обходит таблицу страниц`,
        `satp указывает на корневую таблицу; VPN[1] = ${h(vpn1, 3)} выбирает PTE ${vpn1}: указатель (R = W = X = 0)`,
        `PPN этого PTE, ${h(0x80001, 5)}, указывает на таблицу нижнего уровня; VPN[0] = ${h(vpn0, 3)} выбирает PTE ${vpn0}: лист`,
        `листовой PTE даёт кадр ${h(0x8f0e2, 5)} и права R W U; доступ проверяется, перевод записывается в TLB`,
        `физический адрес — номер кадра, к которому приписано неизменённое смещение: ${h(pa, 8)}`,
      ],
    }
  : {
      va: `virtual address ${h(va, 8)}`, vaA: 'virtual address', vaB: h(va, 8),
      f: [[`VPN[1] ${h(vpn1, 3)}`, 'bits 31–22'], [`VPN[0] ${h(vpn0, 3)}`, 'bits 21–12'], [`offset ${h(off, 3)}`, 'bits 11–0']],
      tlb: 'TLB', tlbSub: `${h(va >>> 12, 5)}: miss`, tlbN: `TLB: miss for VPN ${h(va >>> 12, 5)}`,
      satp: 'satp', satpSub: `PPN ${h(satpPpn, 5)}`, ppn: 'PTE.PPN',
      heads: [['root page table', `at ${h(satpPpn * PAGE, 8)}`], ['leaf page table', `at ${h(0x80001 * PAGE, 8)}`], [`frame ${h(0x8f0e2, 5)}`, 'one 4 KiB page']],
      headsN: ['root table', 'leaf table', `frame ${h(0x8f0e2, 5)}`],
      fN: [[h(vpn1, 3), 'VPN[1]'], [h(vpn0, 3), 'VPN[0]'], [h(off, 3), 'offset']],
      word: 'word', pa: h(pa, 8), paSub: 'physical', paN: `PA ${h(pa, 8)}`, paNSub: `PPN ${h(0x8f0e2, 5)} ∥ offset ${h(off, 3)}`,
      d1: `root PTE ${h(rootPte, 8)}: PPN ${h(0x80001, 5)}, only V set → a pointer to the next table`,
      d2: `leaf PTE ${h(leafPte, 8)}: PPN ${h(0x8f0e2, 5)}, bits D A U W R V → a leaf, user read and write`,
      d1N: `${h(rootPte, 8)}: a pointer`, d2N: `${h(leafPte, 8)}: a leaf`,
      i1: `VPN[1] = ${vpn1}`, i0: `VPN[0] = ${vpn0}`, iOff: `offset = ${h(off, 3)}`,
      steps: [
        `the TLB has no entry for VPN ${h(va >>> 12, 5)}: a miss, so the hardware walks the page table`,
        `satp points to the root table; VPN[1] = ${h(vpn1, 3)} selects PTE ${vpn1}, a pointer (R = W = X = 0)`,
        `that PTE's PPN ${h(0x80001, 5)} locates the leaf table; VPN[0] = ${h(vpn0, 3)} selects PTE ${vpn0}, a leaf`,
        `the leaf PTE gives frame ${h(0x8f0e2, 5)} and the rights R W U; the access is checked and the translation goes into the TLB`,
        `the physical address is the frame number joined with the unchanged offset: ${h(pa, 8)}`,
      ],
    };

const rowsOf = [
  ['[0]', '⋮', `[${vpn1}] ${h(rootPte, 8)}`, '⋮', '[1023]'],
  ['[0]', '⋮', `[${vpn0}] ${h(leafPte, 8)}`, '⋮', '[1023]'],
  ['+0x000', '⋮', `${h(off, 3).replace('0x', '+0x')} ${t.word}`, '⋮', '+0xFFF'],
];
const rowsN = [
  ['[0]', '⋯', `[${vpn1}]`, '⋯', '[1023]'],
  ['[0]', '⋯', `[${vpn0}]`, '⋯', '[1023]'],
  ['+0x000', '⋯', h(off, 3).replace('0x', '+0x'), '⋯', '+0xFFF'],
];
const path = (pts: [number, number][]) => pts.map((p, i) => `${i ? 'L' : 'M'} ${p[0]} ${p[1]}`).join(' ');
const halo = 'fill: none; stroke: var(--paper); stroke-width: 7';
const cellStyle = (sel: boolean, tone: string) =>
  `fill: ${sel ? tone : 'var(--paper-strong)'}; fill-opacity: ${sel ? 0.22 : 1}; stroke: ${sel ? tone : 'var(--line)'}; stroke-width: ${sel ? 1.6 : 1}`;

// Wide layout: three tables side by side; each index comes down from its field of the address and enters the
// selected row from the left, each pointer leaves the selected row on the right and enters row 0 of the next table.
const tables = [{ x: 180, w: 130 }, { x: 350, w: 130 }, { x: 520, w: 130 }];
const ry = (r: number) => 100 + 22 * r;
const rowC = (r: number) => ry(r) + 11;
const idxX = [168, 336, 506];
const ptrX = [322, 494];
// Narrow layout: three stacked strips, each fed by a base on the left and an index from above.
const cw = [56, 30, 64, 30, 58];
const cx0 = 112;
const cellX = (k: number) => cx0 + cw.slice(0, k).reduce((a, v) => a + v, 0);
const strips = [160, 262, 368];
const id = 'page-walk';
---

<Figure
  id={id}
  title={ru ? 'Обход двухуровневой таблицы страниц Sv32' : 'A walk of the two-level Sv32 page table'}
  caption={ru
    ? `Загрузка по виртуальному адресу ${h(va, 8)} в Sv32: 10 бит VPN[1], 10 бит VPN[0] и 12 бит смещения. TLB не содержит перевода (1), поэтому аппаратура читает таблицы. Регистр satp хранит номер физической страницы (PPN) корневой таблицы; VPN[1] = ${vpn1} выбирает в ней 4-байтовую запись по адресу ${h(rootPteAddr, 8)} (2). У этой записи установлен только бит V, значит, это указатель: её PPN ${h(0x80001, 5)} указывает на таблицу нижнего уровня, где VPN[0] = ${vpn0} выбирает запись по адресу ${h(leafPteAddr, 8)} (3). Эта запись — лист: R, W и U разрешают пользователю чтение и запись, A и D отмечают обращение и запись. Её PPN ${h(0x8f0e2, 5)} — номер кадра, права проверяются, а перевод сохраняется в TLB (4). Физический адрес — PPN, к которому приписано неизменённое смещение: ${h(pa, 8)} (5). Перевод стоил двух обращений к памяти до самой загрузки; при попадании в TLB шаги 2–4 не нужны. Цвета: зелёный — части виртуального адреса, синий — таблицы и регистры, красный — результат.`
    : `A load from virtual address ${h(va, 8)} under Sv32: 10 bits of VPN[1], 10 bits of VPN[0] and 12 bits of offset. The TLB has no translation (1), so the hardware reads the tables. The satp register holds the physical page number of the root table; VPN[1] = ${vpn1} selects its 4-byte entry at ${h(rootPteAddr, 8)} (2). That entry has only V set, so it is a pointer: its PPN ${h(0x80001, 5)} locates the leaf table, where VPN[0] = ${vpn0} selects the entry at ${h(leafPteAddr, 8)} (3). That entry is a leaf: R, W and U allow the user to read and write, and A and D record that the page was accessed and written. Its PPN ${h(0x8f0e2, 5)} is the frame number; the rights are checked and the translation is kept in the TLB (4). The physical address is the PPN joined with the unchanged offset, ${h(pa, 8)} (5). The translation cost two memory reads before the load itself; on a TLB hit, steps 2 to 4 are skipped. Colours: green for parts of the virtual address, blue for tables and registers, red for the result.`}
>
  <svg class="fig-wide" viewBox="0 0 760 316" role="img" aria-labelledby={`${id}-760-t ${id}-760-d`}>
    <title id={`${id}-760-t`}>{ru ? 'Перевод виртуального адреса через две таблицы страниц' : 'Translating a virtual address through two page tables'}</title>
    <desc id={`${id}-760-d`}>{ru
      ? `Вверху виртуальный адрес ${h(va, 8)}, разбитый на VPN[1] ${h(vpn1, 3)}, VPN[0] ${h(vpn0, 3)} и смещение ${h(off, 3)}, и TLB с промахом. Ниже три столбца: корневая таблица, таблица нижнего уровня и кадр физической памяти. Регистр satp указывает на начало корневой таблицы, VPN[1] выбирает в ней запись 64 со значением ${h(rootPte, 8)}, её PPN указывает на начало таблицы нижнего уровня, VPN[0] выбирает запись 16 со значением ${h(leafPte, 8)}, её PPN указывает на кадр ${h(0x8f0e2, 5)}, а смещение выбирает в кадре байт 8. Справа физический адрес ${h(pa, 8)}.`
      : `At the top, the virtual address ${h(va, 8)} split into VPN[1] ${h(vpn1, 3)}, VPN[0] ${h(vpn0, 3)} and offset ${h(off, 3)}, and a TLB that misses. Below, three columns: the root page table, the leaf page table and a frame of physical memory. The satp register points to the start of the root table, VPN[1] selects its entry 64 with value ${h(rootPte, 8)}, whose PPN points to the start of the leaf table, VPN[0] selects its entry 16 with value ${h(leafPte, 8)}, whose PPN points to frame ${h(0x8f0e2, 5)}, and the offset selects byte 8 of the frame. On the right, the physical address ${h(pa, 8)}.`}</desc>

    <g data-s="1">
      <text class="f-label" x="385" y="14" text-anchor="middle">{t.va}</text>
      {t.f.map(([l, s], i) => <Box x={160 + 150 * i} y={24} w={150} h={44} label={l} sub={s} tone="x" />)}
      <Box x={10} y={24} w={110} h={44} label={t.tlb} sub={t.tlbSub} tone="h" />
      <path class="f-line f-green" d="M 160 46 L 123 46" marker-end="url(#f-arrow-green)" />
      <Badge x={65} y={12} n={1} />
    </g>
    {/* index lines from the fields, drawn first: pointers and the satp line cross them */}
    <g data-s="2">
      <path class="f-line f-green" d={path([[idxX[0], 68], [idxX[0], rowC(2)], [tables[0].x - 2, rowC(2)]])} marker-end="url(#f-arrow-green)" />
    </g>
    <g data-s="3">
      <path class="f-line f-green" d={path([[idxX[1], 68], [idxX[1], rowC(2)], [tables[1].x - 2, rowC(2)]])} marker-end="url(#f-arrow-green)" />
    </g>
    <g data-s="5">
      <path class="f-line f-green" d={path([[idxX[2], 68], [idxX[2], rowC(2)], [tables[2].x - 2, rowC(2)]])} marker-end="url(#f-arrow-green)" />
    </g>
    {tables.map((T, k) => (
      <g data-s={String([2, 3, 4][k])}>
        {rowsOf[k].map((r, i) => (
          <g>
            <rect x={T.x} y={ry(i)} width={T.w} height="22" style={cellStyle(i === 2, k === 2 ? toneVar.y : toneVar.h)} />
            <text class={`f-small${i === 2 ? '' : ' f-t-muted'}`} x={T.x + 6} y={ry(i) + 15.5}>{r}</text>
          </g>
        ))}
        <text class="f-small f-t-muted" x={T.x + T.w / 2} y="228" text-anchor="middle">{t.heads[k][0]}</text>
        <text class="f-small f-t-muted" x={T.x + T.w / 2} y="244" text-anchor="middle">{t.heads[k][1]}</text>
      </g>
    ))}
    <g data-s="2">
      <Box x={10} y={96} w={110} h={40} label={t.satp} sub={t.satpSub} tone="h" />
      <path d={path([[120, rowC(0)], [tables[0].x - 2, rowC(0)]])} style={halo} />
      <path class="f-line f-blue" d={path([[120, rowC(0)], [tables[0].x - 2, rowC(0)]])} marker-end="url(#f-arrow-blue)" />
      <text class="f-small" x="10" y="282">{t.d1}</text>
      <Badge x={tables[0].x - 14} y={226} n={2} />
    </g>
    <g data-s="3">
      <path d={path([[tables[0].x + tables[0].w, rowC(2)], [ptrX[0], rowC(2)], [ptrX[0], rowC(0)], [tables[1].x - 2, rowC(0)]])} style={halo} />
      <path class="f-line f-blue" d={path([[tables[0].x + tables[0].w, rowC(2)], [ptrX[0], rowC(2)], [ptrX[0], rowC(0)], [tables[1].x - 2, rowC(0)]])} marker-end="url(#f-arrow-blue)" />
      <Badge x={tables[1].x - 14} y={226} n={3} />
    </g>
    <g data-s="4">
      <path d={path([[tables[1].x + tables[1].w, rowC(2)], [ptrX[1], rowC(2)], [ptrX[1], rowC(0)], [tables[2].x - 2, rowC(0)]])} style={halo} />
      <path class="f-line f-blue" d={path([[tables[1].x + tables[1].w, rowC(2)], [ptrX[1], rowC(2)], [ptrX[1], rowC(0)], [tables[2].x - 2, rowC(0)]])} marker-end="url(#f-arrow-blue)" />
      <text class="f-small" x="10" y="302">{t.d2}</text>
      <Badge x={tables[2].x - 14} y={226} n={4} />
    </g>
    <g data-s="5">
      <path class="f-line f-red" d={path([[tables[2].x + tables[2].w, rowC(2)], [663, rowC(2)]])} marker-end="url(#f-arrow-red)" />
      <Box x={665} y={130} w={90} h={50} label={t.pa} sub={t.paSub} tone="y" />
      <Badge x={710} y={112} n={5} />
    </g>
  </svg>

  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 492" role="img" aria-labelledby={`${id}-360-t ${id}-360-d`}>
    <title id={`${id}-360-t`}>{ru ? 'Перевод виртуального адреса через две таблицы страниц' : 'Translating a virtual address through two page tables'}</title>
    <desc id={`${id}-360-d`}>{ru
      ? `Сверху вниз: промах в TLB; виртуальный адрес ${h(va, 8)}, разбитый на VPN[1], VPN[0] и смещение; корневая таблица, в которую указывает satp и в которой VPN[1] выбирает запись 64; таблица нижнего уровня, на которую указывает PPN этой записи и в которой VPN[0] выбирает запись 16; кадр ${h(0x8f0e2, 5)}, в котором смещение выбирает байт 8; физический адрес ${h(pa, 8)}.`
      : `From top to bottom: a TLB miss; the virtual address ${h(va, 8)} split into VPN[1], VPN[0] and offset; the root table, located by satp, in which VPN[1] selects entry 64; the leaf table, located by that entry's PPN, in which VPN[0] selects entry 16; frame ${h(0x8f0e2, 5)}, in which the offset selects byte 8; the physical address ${h(pa, 8)}.`}</desc>
    <g data-s="1">
      <Box x={10} y={8} w={340} h={34} label={t.tlbN} tone="h" />
      <text class="f-label" x="180" y="64" text-anchor="middle">{t.va}</text>
      {t.fN.map(([l, s], i) => <Box x={10 + 113 * i} y={72} w={i === 2 ? 114 : 113} h={46} label={l} sub={s} tone="x" />)}
      <Badge x={24} y={25} n={1} />
    </g>
    {strips.map((y, k) => (
      <g data-s={String([2, 3, 5][k])}>
        <text class="f-small f-t-muted" x={cx0} y={y - 6}>{t.headsN[k]}</text>
        {rowsN[k].map((r, i) => (
          <g>
            <rect x={cellX(i)} y={y} width={cw[i]} height="30" style={cellStyle(i === 2, k === 2 ? toneVar.y : toneVar.h)} />
            <text class={`f-small${i === 2 ? '' : ' f-t-muted'}`} x={cellX(i) + cw[i] / 2} y={y + 20} text-anchor="middle">{r}</text>
          </g>
        ))}
        <text class="f-small f-t-green" x={cellX(2) + cw[2] / 2} y={y - 26} text-anchor="middle">{[t.i1, t.i0, t.iOff][k]}</text>
        <path class="f-line f-green" d={`M ${cellX(2) + cw[2] / 2} ${y - 22} L ${cellX(2) + cw[2] / 2} ${y - 2}`} marker-end="url(#f-arrow-green)" />
        <Box x={10} y={y - 5} w={88} h={40} label={k === 0 ? t.satp : t.ppn} sub={k === 0 ? h(satpPpn, 5) : h([0, 0x80001, 0x8f0e2][k], 5)} tone="h" />
        <path class="f-line f-blue" d={`M 98 ${y + 15} L 110 ${y + 15}`} marker-end="url(#f-arrow-blue)" />
      </g>
    ))}
    <g data-s="2">
      <text class="f-small" x="112" y="218">{t.d1N}</text>
      <Badge x={54} y={140} n={2} />
    </g>
    <g data-s="3">
      <path class="f-line f-blue" d="M 230 190 L 230 198 L 54 198 L 54 255" marker-end="url(#f-arrow-blue)" />
      <Badge x={24} y={236} n={3} />
    </g>
    <g data-s="4">
      <text class="f-small" x="112" y="320">{t.d2N}</text>
      <path class="f-line f-blue" d="M 230 292 L 230 300 L 54 300 L 54 361" marker-end="url(#f-arrow-blue)" />
      <Badge x={24} y={340} n={4} />
    </g>
    <g data-s="5">
      <path class="f-line f-red" d={`M ${cellX(2) + cw[2] / 2} 398 L ${cellX(2) + cw[2] / 2} 434`} marker-end="url(#f-arrow-red)" />
      <Box x={60} y={436} w={290} h={46} label={t.paN} sub={t.paNSub} tone="y" />
      <Badge x={24} y={459} n={5} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
