---
import Figure from '../Figure.astro';
import { plot, scale, sigmoid } from '../geometry';

// Generator losses; the generator minimizes both.
// Top panel: as functions of d = D(G(z)). Bottom panel: as functions of the logit ℓ, d = σ(ℓ).
const sat = (d: number) => Math.log(1 - d); // minimax ("saturating") loss
const nonSat = (d: number) => -Math.log(d); // non-saturating loss used in practice
const softplus = (t: number) => (t > 30 ? t : Math.log1p(Math.exp(t)));
const satL = (l: number) => -softplus(l); // ln(1 − σ(ℓ))
const nonSatL = (l: number) => softplus(-l); // −ln σ(ℓ)
const fmt = (v: number, digits: number) => v.toFixed(digits).replace('-', '−');
const clipTo = (lo: number, hi: number) => (f: (t: number) => number) => (t: number) => {
  const v = f(t);
  return v >= lo && v <= hi ? v : NaN;
};

const left = 62;
const right = 548;

// Top panel (against d)
const aTop = 34;
const aBot = 250;
const aLo = -4;
const aHi = 4.5;
const sx = scale([0, 1], [left, right]);
const sy = scale([aLo, aHi], [aBot, aTop]);
const clipA = clipTo(aLo, aHi);
const satPath = plot(clipA(sat), 0, 0.999, sx, sy, 500);
const nonSatPath = plot(clipA(nonSat), 0.001, 1, sx, sy, 800);

// Tangents at d0, where the discriminator confidently rejects a fake.
const d0 = 0.05;
const satSlope = -1 / (1 - d0);
const nonSatSlope = -1 / d0;
const tangentA = (f: (d: number) => number, k: number, a: number, b: number) =>
  `M ${sx(a)} ${sy(f(d0) + k * (a - d0))} L ${sx(b)} ${sy(f(d0) + k * (b - d0))}`;
const satTangent = tangentA(sat, satSlope, 0, 0.2);
const nonSatTangent = tangentA(nonSat, nonSatSlope, 0.012, 0.088);

// Bottom panel (against the logit)
const bTop = 352;
const bBot = 568;
const lLo = -6;
const lHi = 3;
const bLo = -3.5;
const bHi = 6.5;
const sxL = scale([lLo, lHi], [left, right]);
const syL = scale([bLo, bHi], [bBot, bTop]);
const clipB = clipTo(bLo, bHi);
const satLPath = plot(clipB(satL), lLo, lHi, sxL, syL, 400);
const nonSatLPath = plot(clipB(nonSatL), lLo, lHi, sxL, syL, 400);
const l0 = Math.log(d0 / (1 - d0)); // logit of d0
const dl0 = sigmoid(l0);
const satLSlope = -dl0; // ∂ℓ ln(1 − σ(ℓ)) = −σ(ℓ)
const nonSatLSlope = -(1 - dl0); // ∂ℓ (−ln σ(ℓ)) = −(1 − σ(ℓ))
const tangentB = (f: (l: number) => number, k: number, a: number, b: number) =>
  `M ${sxL(a)} ${syL(f(l0) + k * (a - l0))} L ${sxL(b)} ${syL(f(l0) + k * (b - l0))}`;
const satLTangent = tangentB(satL, satLSlope, l0 - 2, l0 + 2);
const nonSatLTangent = tangentB(nonSatL, nonSatLSlope, l0 - 1.6, l0 + 1.6);
const lFake = Math.log(0.15 / 0.85); // logit of the shaded boundary d = 0.15

const id = 'gans-saturation';
const tick = (t: number) => (t < 0 ? `−${-t}` : `${t}`);
---

<Figure
  id={id}
  title="Saturating and non-saturating generator losses"
  caption={`Top: both losses decrease in d = D(G(z)), so minimizing either pushes D(G(z)) up. Where D confidently rejects fakes, at d = ${d0}, the minimax loss ln(1 − d) has slope ${fmt(satSlope, 2)}: bounded, but not zero. The loss −ln d has slope ${fmt(nonSatSlope, 0)} there. Bottom: the same losses against the discriminator's logit ℓ, with d = σ(ℓ), which is the path the gradient takes back into the networks. Here ln(1 − σ(ℓ)) saturates: its slope −d is ${fmt(satLSlope, 2)} and tends to 0 as D grows more confident. The loss −ln σ(ℓ) stays almost linear, with slope −(1 − d) = ${fmt(nonSatLSlope, 2)}.`}
  origin="illustrative"
  pages="24–25"
>
  <svg class="fig-medium" viewBox="0 0 600 612" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>The two generator losses against d and against the discriminator logit</title>
    <desc id={`${id}-d`}>Two stacked panels. Top: the horizontal axis is d = D(G(z)) from 0 to 1, with the region near 0 shaded and labelled D says fake. The amber curve ln(1 − d) starts at 0 for d = 0 and falls to minus infinity as d approaches 1; at d = 0.05 its tangent has slope about −1.05, labelled shallow. The blue curve minus ln d starts at plus infinity near d = 0 and falls to 0 at d = 1; at d = 0.05 its tangent has slope −20, labelled steep. Bottom: the horizontal axis is the logit ℓ from −6 to 3. The amber curve ln(1 − σ(ℓ)) is almost flat at 0 for very negative logits and bends down for positive ones; its slope at the logit of 0.05 is −0.05, labelled saturated. The blue curve −ln σ(ℓ) is almost a straight line with slope −1 for negative logits and flattens towards 0 for positive ones; its slope there is −0.95.</desc>

    <!-- ===== Top panel: against d ===== -->
    <rect x={sx(0)} y={aTop} width={sx(0.15) - sx(0)} height={aBot - aTop} fill="var(--muted)" opacity="0.13" />
    <text class="f-note" x={sx(0.075)} y={sy(-3.2)} text-anchor="middle">D says</text>
    <text class="f-note" x={sx(0.075)} y={sy(-3.2) + 16} text-anchor="middle">“fake”</text>

    {[-4, -2, 0, 2, 4].map((t) => <line class="f-grid" x1={left} x2={right} y1={sy(t)} y2={sy(t)} />)}
    {[-4, -2, 0, 2, 4].map((t) => <text class="f-note" x={left - 10} y={sy(t) + 5} text-anchor="end">{tick(t)}</text>)}
    <line class="f-axis" x1={left} x2={right} y1={sy(0)} y2={sy(0)} />
    <path class="f-axis" d={`M ${left} ${aBot} H ${right + 22}`} marker-end="url(#f-arrow-muted)" />
    <path class="f-axis" d={`M ${left} ${aBot} V ${aTop - 12}`} marker-end="url(#f-arrow-muted)" />
    {[0, 0.25, 0.5, 0.75, 1].map((t) => <text class="f-note" x={sx(t)} y={aBot + 22} text-anchor="middle">{t}</text>)}
    <text class="f-math" x={right + 22} y={aBot + 44} text-anchor="end">d = D(G(z))</text>
    <text class="f-label" transform={`translate(${left - 40} ${(aTop + aBot) / 2}) rotate(-90)`} text-anchor="middle">generator loss</text>

    <path class="f-line f-amber f-bold" d={satPath} />
    <path class="f-line f-blue f-bold" d={nonSatPath} />
    <path class="f-thin f-dash" d={satTangent} />
    <path class="f-thin f-dash" d={nonSatTangent} />
    <circle class="f-solid-muted" cx={sx(d0)} cy={sy(sat(d0))} r="4" />
    <circle class="f-solid-muted" cx={sx(d0)} cy={sy(nonSat(d0))} r="4" />

    <text class="f-label f-t-blue f-halo" x={sx(0.17)} y={sy(3.75)}>steep: slope −1/d = {fmt(nonSatSlope, 0)}</text>
    <path class="f-thin f-blue" d={`M ${sx(0.165)} ${sy(3.75) - 4} Q ${sx(0.1)} ${sy(3.75) - 4} ${sx(d0) + 7} ${sy(nonSat(d0)) - 5}`} marker-end="url(#f-arrow-blue)" />
    <text class="f-label f-t-amber f-halo" x={sx(0.2)} y={sy(-1.45)}>shallow: slope {fmt(satSlope, 2)}</text>
    <path class="f-thin f-amber" d={`M ${sx(0.195)} ${sy(-1.45) - 5} Q ${sx(0.09)} ${sy(-1.3)} ${sx(d0) + 3} ${sy(sat(d0)) + 6}`} />

    <text class="f-math f-t-blue f-halo" x={sx(0.36)} y={sy(2.35)}>−<tspan style="font-style: normal">ln</tspan> D(G(z))</text>
    <text class="f-note f-halo" x={sx(0.36)} y={sy(2.35) + 18}>non-saturating (used in code)</text>
    <text class="f-math f-t-amber f-halo" x={sx(0.44)} y={sy(-2.75)}><tspan style="font-style: normal">ln</tspan>(1 − D(G(z)))</text>
    <text class="f-note f-halo" x={sx(0.44)} y={sy(-2.75) + 18}>minimax / saturating</text>

    <!-- ===== Bottom panel: against the logit ===== -->
    <rect x={sxL(lLo)} y={bTop} width={sxL(lFake) - sxL(lLo)} height={bBot - bTop} fill="var(--muted)" opacity="0.13" />

    {[-2, 0, 2, 4, 6].map((t) => <line class="f-grid" x1={left} x2={right} y1={syL(t)} y2={syL(t)} />)}
    {[-2, 0, 2, 4, 6].map((t) => <text class="f-note" x={left - 10} y={syL(t) + 5} text-anchor="end">{tick(t)}</text>)}
    <line class="f-axis" x1={left} x2={right} y1={syL(0)} y2={syL(0)} />
    <path class="f-axis" d={`M ${left} ${bBot} H ${right + 22}`} marker-end="url(#f-arrow-muted)" />
    <path class="f-axis" d={`M ${left} ${bBot} V ${bTop - 12}`} marker-end="url(#f-arrow-muted)" />
    {[-6, -4, -2, 0, 2].map((t) => <text class="f-note" x={sxL(t)} y={bBot + 22} text-anchor="middle">{tick(t)}</text>)}
    <text class="f-math" x={right + 22} y={bBot + 44} text-anchor="end">logit ℓ,  d = σ(ℓ)</text>
    <text class="f-label" transform={`translate(${left - 40} ${(bTop + bBot) / 2}) rotate(-90)`} text-anchor="middle">generator loss</text>

    <path class="f-line f-amber f-bold" d={satLPath} />
    <path class="f-line f-blue f-bold" d={nonSatLPath} />
    <path class="f-thin f-dash" d={satLTangent} />
    <path class="f-thin f-dash" d={nonSatLTangent} />
    <circle class="f-solid-muted" cx={sxL(l0)} cy={syL(satL(l0))} r="4" />
    <circle class="f-solid-muted" cx={sxL(l0)} cy={syL(nonSatL(l0))} r="4" />

    <text class="f-label f-t-amber f-halo" x={sxL(-5.8)} y={syL(-1.25)}>saturated: slope −d = {fmt(satLSlope, 2)}</text>
    <text class="f-note f-halo" x={sxL(-5.8)} y={syL(-1.25) + 18}>→ 0 as D grows confident</text>
    <text class="f-note" x={sxL(-5.8)} y={syL(-3.1)}>D says “fake”</text>
    <text class="f-label f-t-blue f-halo" x={sxL(-2.1)} y={syL(4.9)}>linear: slope −(1 − d) = {fmt(nonSatLSlope, 2)}</text>

    <text class="f-math f-t-blue f-halo" x={sxL(0.5)} y={syL(1.9)}>−<tspan style="font-style: normal">ln</tspan> σ(ℓ)</text>
    <text class="f-math f-t-amber f-halo" x={sxL(-1.5)} y={syL(-2.7)}><tspan style="font-style: normal">ln</tspan>(1 − σ(ℓ))</text>
  </svg>
</Figure>
