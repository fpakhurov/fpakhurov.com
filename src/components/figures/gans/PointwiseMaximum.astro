---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';

// For one fixed x the integrand is a·ln y + b·ln(1 − y) with a = p_data(x), b = p_g(x), y = D(x).
const cases = [
  { a: 0.6, b: 0.3, cls: 'f-line f-green f-bold', dot: 'f-solid-green' },
  { a: 0.45, b: 0.45, cls: 'f-line f-muted f-dash', dot: 'f-solid-muted' },
];
const f = (a: number, b: number) => (y: number) => a * Math.log(y) + b * Math.log(1 - y);

const left = 64;
const right = 440;
const top = 30;
const bottom = 268;
const yLo = -2.6;
const sx = scale([0, 1], [left, right]);
const sy = scale([yLo, 0], [bottom, top]);
const clip = (g: (y: number) => number) => (y: number) => (g(y) >= yLo ? g(y) : NaN);

const curves = cases.map((c) => {
  const g = f(c.a, c.b);
  const ystar = c.a / (c.a + c.b);
  return { ...c, d: plot(clip(g), 0.0001, 0.9999, sx, sy, 4000), ystar, fmax: g(ystar) };
});
const [main, equal] = curves;
const id = 'gans-pointwise-max';
---

<Figure
  id={id}
  title="Each point x is a one-variable maximization"
  caption={`With a = p_data(x) and b = p_g(x) fixed, a ln y + b ln(1 − y) is concave in y = D(x) and peaks at y* = a / (a + b). Solid: a = 0.6, b = 0.3, so y* = 2/3 and the maximum is ${main.fmax.toFixed(3).replace('-', '−')}. Dashed: a = b = 0.45, so y* = ½.`}
  origin="expanded"
  pages="23"
>
  <svg class="fig-compact" viewBox="0 0 480 328" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>a ln y plus b ln(1 minus y) over y between 0 and 1</title>
    <desc id={`${id}-d`}>Two concave curves on y from 0 to 1, both falling to minus infinity at the ends. The solid green curve for a = 0.6 and b = 0.3 peaks at y = 2/3 with value {main.fmax.toFixed(3).replace('-', '−')}. The dashed curve for a = b = 0.45 peaks at y = 1/2 with value {equal.fmax.toFixed(3).replace('-', '−')}. Dotted vertical lines drop from the two peaks to the y axis.</desc>

    {[0, -1, -2].map((t) => <line class="f-grid" x1={left} x2={right} y1={sy(t)} y2={sy(t)} />)}
    {[0, -1, -2].map((t) => <text class="f-note" x={left - 10} y={sy(t) + 5} text-anchor="end">{t === 0 ? '0' : `−${-t}`}</text>)}
    <path class="f-axis" d={`M ${left} ${bottom} H ${right + 20}`} marker-end="url(#f-arrow-muted)" />
    <path class="f-axis" d={`M ${left} ${bottom} V ${top - 14}`} marker-end="url(#f-arrow-muted)" />
    {[0, 0.5, 1].map((t) => <text class="f-note" x={sx(t)} y={bottom + 22} text-anchor="middle">{t === 0.5 ? '½' : t}</text>)}
    <text class="f-note" x={sx(2 / 3)} y={bottom + 22} text-anchor="middle">⅔</text>
    <text class="f-math" x={right + 20} y={bottom + 50} text-anchor="end">y = D(x)</text>

    {curves.map((c) => (
      <g>
        <path class={c.cls} d={c.d} />
        <line class="f-thin f-muted f-dot" x1={sx(c.ystar)} x2={sx(c.ystar)} y1={sy(c.fmax)} y2={bottom} />
        <circle class={c.dot} cx={sx(c.ystar)} cy={sy(c.fmax)} r="4.5" />
      </g>
    ))}

    <text class="f-label f-t-green" x={sx(0.9)} y={sy(-0.12)} text-anchor="middle">maximum at</text>
    <text class="f-math f-t-green" x={sx(0.9)} y={sy(-0.12) + 22} text-anchor="middle">y* = a/(a+b)</text>
    <path class="f-thin f-green" d={`M ${sx(0.84)} ${sy(-0.12) + 30} Q ${sx(0.76)} ${sy(-0.5)} ${sx(2 / 3) + 8} ${sy(main.fmax) - 3}`} marker-end="url(#f-arrow-green)" />
    <text class="f-note" x={sx(0.33)} y={sy(-0.25)} text-anchor="middle">a = b ⇒ y* = ½</text>
    <path class="f-thin f-muted" d={`M ${sx(0.38)} ${sy(-0.25) + 6} Q ${sx(0.45)} ${sy(-0.45)} ${sx(0.5) - 6} ${sy(equal.fmax) - 6}`} marker-end="url(#f-arrow-muted)" />
  </svg>
</Figure>
