---
import Figure from '../Figure.astro';
import { plot, scale, gaussian } from '../geometry';
import { mixture } from './densities';

// Data: a fixed two-mode density. Generator: three stages of p_g.
const pdata = mixture([[0.55, -1, 0.45], [0.45, 0.6, 0.4]]);
const pg0 = (x: number) => gaussian(x, 2.8, 0.45);
const pg1 = mixture([[0.5, -0.45, 0.55], [0.5, 1.3, 0.55]]);
const optimal = (pg: (x: number) => number) => (x: number) => pdata(x) / (pdata(x) + pg(x));

// An untrained discriminator: an arbitrary wiggly function in (0, 1).
const dRandom = (x: number) => Math.min(0.95, Math.max(0.05, 0.6 - 0.07 * x + 0.09 * Math.sin(4.3 * x) + 0.05 * Math.sin(9.1 * x + 1)));
const dStar0 = optimal(pg0);
const dHalf = () => 0.5;

const x0 = -3;
const x1 = 4.5;

type Stage = {
  title: string;
  sub?: string;
  pg: (x: number) => number;
  d: (x: number) => number;
  dLabel: [number, number, string];
  ghost?: (x: number) => number;
  note?: string;
};
const stages: Stage[] = [
  { title: '1. At the beginning', pg: pg0, d: dRandom, dLabel: [-2.9, 1.1, 'D(x)'] },
  { title: '2. After updating θ', sub: 'd', pg: pg0, d: dStar0, dLabel: [-2.9, 1.1, 'D ≈ D*'] },
  { title: '3. After updating θ', sub: 'g', pg: pg1, d: dStar0, dLabel: [-2.9, 1.1, 'D unchanged'], ghost: pg0 },
  { title: '4. Finally', pg: pdata, d: dHalf, dLabel: [2.2, 0.62, 'D(x) = ½'] },
];

function panel(s: Stage, px: number, py: number, w: number) {
  const left = px + 14;
  const right = px + w - 14;
  const top = py + 40;
  const bottom = py + 168;
  const sx = scale([x0, x1], [left, right]);
  const sy = scale([0, 1.2], [bottom, top]);
  return {
    ...s,
    left, right, top, bottom, px, py, w,
    data: plot(pdata, x0, x1, sx, sy, 200),
    gen: plot(s.pg, x0, x1, sx, sy, 200),
    disc: plot(s.d, x0, x1, sx, sy, 300),
    ghostPath: s.ghost ? plot(s.ghost, x0, x1, sx, sy, 200) : '',
    sx, sy,
  };
}

const id = 'gans-evolution';
const wide = [panel(stages[0], 0, 0, 335), panel(stages[1], 345, 0, 335), panel(stages[2], 0, 205, 335), panel(stages[3], 345, 205, 335)];
const narrow = stages.map((s, i) => panel(s, 5, i * 205, 350));
---

<Figure
  id={id}
  title="How the two players move during training"
  caption="Red: data density p_data; blue: generator density p_g; green: discriminator output D(x) on the same 0–1 scale. A discriminator step pushes D towards D* = p_data / (p_data + p_g). A generator step moves p_g towards where D is high, while D itself is unchanged. In panel 3 the dashed blue curve is p_g before the generator step. At the equilibrium p_g = p_data and D(x) = ½ everywhere. Curves are computed from explicit densities."
  origin="redrawn"
  pages="24"
>
  {[{ cls: 'fig-wide', s: 'w', vb: '0 0 680 380', panels: wide }, { cls: 'fig-narrow', s: 'n', vb: '0 0 360 790', panels: narrow }].map((v) => (
    <svg class={v.cls} viewBox={v.vb} role="img" aria-labelledby={`${id}-${v.s}-t ${id}-${v.s}-d`}>
      <title id={`${id}-${v.s}-t`}>Four stages of GAN training</title>
      <desc id={`${id}-${v.s}-d`}>Four panels with the same red two-mode data density. Panel 1, at the beginning: the blue generator density is a narrow bell far to the right and the green discriminator curve is an arbitrary wiggle around 0.6. Panel 2, after updating the discriminator parameters: the green curve is the optimal discriminator, near 1 over the data and dropping to 0 over the generator bell. Panel 3, after updating the generator parameters: the blue density has moved left onto the data; the old bell is drawn dashed, with an arrow pointing left from it, while the green curve is the same as in panel 2. Panel 4, finally: the blue density coincides with the red one and the green discriminator is the flat line one half.</desc>
      {v.panels.map((p, i) => (
        <g>
          <rect class="f-box-soft" x={p.px + 2} y={p.py + 2} width={p.w - 4} height="186" rx="6" />
          <text class="f-title" x={p.px + 14} y={p.py + 24}>{p.title}{p.sub && <tspan dy="4" font-size="12">{p.sub}</tspan>}</text>
          <line class="f-axis" x1={p.left} x2={p.right} y1={p.bottom} y2={p.bottom} />
          <line class="f-grid" x1={p.left} x2={p.right} y1={p.sy(0.5)} y2={p.sy(0.5)} />
          <line class="f-grid" x1={p.left} x2={p.right} y1={p.sy(1)} y2={p.sy(1)} />
          {p.ghostPath && <path class="f-thin f-blue f-dash" d={p.ghostPath} />}
          {p.ghostPath && <path class="f-line f-blue" d={`M ${p.sx(2.42)} ${p.sy(0.72)} H ${p.sx(1.68)}`} marker-end="url(#f-arrow-blue)" />}
          <path class="f-line f-red" d={p.data} />
          <path class={i === 3 ? 'f-line f-blue f-dash' : 'f-line f-blue'} d={p.gen} />
          <path class="f-line f-green f-bold" d={p.disc} />
          <text class="f-small f-t-green f-halo" x={p.sx(p.dLabel[0])} y={p.sy(p.dLabel[1])}>{p.dLabel[2]}</text>
          {i < 3 && <text class="f-small f-t-red f-halo" x={p.sx(-1.8)} y={p.sy(0.22)} text-anchor="end">p<tspan dy="4" font-size="10">data</tspan></text>}
          {i < 2 && <text class="f-small f-t-blue f-halo" x={p.sx(3.35)} y={p.sy(0.86)}>p<tspan dy="4" font-size="10">g</tspan></text>}
          {i === 2 && <text class="f-small f-t-blue f-halo" x={p.sx(0.12)} y={p.sy(0.62)}>p<tspan dy="4" font-size="10">g</tspan></text>}
          {i === 3 && <text class="f-small f-halo" x={p.sx(-2.9)} y={p.sy(0.86)}><tspan class="f-t-blue">p<tspan dy="4" font-size="10">g</tspan></tspan><tspan dy="-4"> = </tspan><tspan class="f-t-red">p<tspan dy="4" font-size="10">data</tspan></tspan></text>}
        </g>
      ))}
    </svg>
  ))}
</Figure>
