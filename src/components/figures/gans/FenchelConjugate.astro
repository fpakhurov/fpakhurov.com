---
import Figure from '../Figure.astro';
import { plot, scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Convex f(u) = ½(u − 1)², half the Pearson χ² generator: f(1) = 0. Slope t = 1.
// f*(t) = sup_u [t·u − f(u)]; the sup is at f′(u*) = t, i.e. u* = 1 + t.
// Closed form: f*(t) = t + t²/2, so f*(1) = 3/2.
const f = (u: number) => 0.5 * (u - 1) ** 2;
const t = 1;
const us = 1 + t;
const fu = f(us);
const fstar = t * us - fu; // = 1.5
const tangent = (u: number) => t * u - fstar;
const through0 = (u: number) => t * u;

const U: [number, number] = [-0.6, 3.6];
const Y: [number, number] = [-2.2, 3.8];

// Wide: explanatory labels inside the plot. Narrow: same curves, short labels; the caption carries the explanation.
const layouts = [
  { cls: 'fig-medium fig-wide', s: 'w', vb: '0 0 600 380', L: 50, R: 560, T: 24, B: 340, full: true },
  { cls: 'fig-narrow', s: 'n', vb: '0 0 380 360', L: 36, R: 340, T: 24, B: 320, full: false },
].map((v) => {
  const sx = scale(U, [v.L, v.R]);
  const sy = scale(Y, [v.B, v.T]);
  return {
    ...v,
    sx,
    sy,
    fPath: plot(f, -0.6, 3.55, sx, sy, 200),
    tanPath: plot(tangent, -0.12, 3.6, sx, sy, 2),
    zeroPath: plot(through0, -0.5, 3.3, sx, sy, 2),
  };
});

// Slope triangle on the tangent line.
const tri0 = 2.85;
const tri1 = 3.3;
const id = 'gans-fenchel';
---

<Figure
  id={id}
  title={ru ? "Сопряжённая по Фенхелю функция как свободный член касательной" : "The convex conjugate read off a tangent line"}
  caption={ru ? `Выпуклая функция f(u) = ½(u − 1)² с f(1) = 0 (синяя) и наклон t = ${t}. Прямая с наклоном t, касающаяся f ровно в одной точке (янтарная), касается её в u* = ${us}, где f′(u*) = t. Её свободный член равен −f*(t) = −${fstar}. Эквивалентно, f*(t) = max по u от t·u − f(u) — это наибольший вертикальный зазор между прямой t·u, проходящей через начало координат (штриховая), и f; он достигается в той же точке u* (зелёная стрелка). В замкнутой форме f*(t) = t + t²/2.` : `A convex f(u) = ½(u − 1)² with f(1) = 0 (blue) and slope t = ${t}. The line with slope t that touches f at exactly one point (amber) touches it at u* = ${us}, where f′(u*) = t. Its intercept is −f*(t) = −${fstar}. Equivalently, f*(t) = max over u of t·u − f(u) is the largest vertical gap between the line t·u through the origin (dashed) and f, reached at the same u* (green). In closed form f*(t) = t + t²/2.`}
>
  {layouts.map((v) => (
    <svg class={v.cls} viewBox={v.vb} role="img" aria-labelledby={`${id}-${v.s}-t ${id}-${v.s}-d`}>
      <title id={`${id}-${v.s}-t`}>{ru ? "Геометрический смысл сопряжённой по Фенхелю функции" : "Geometric meaning of the convex conjugate"}</title>
      <desc id={`${id}-${v.s}-d`}>{ru ? "Выпуклая парабола f от u с минимумом 0 при u, равном 1. Янтарная прямая с наклоном t, равным 1, касается параболы в единственной точке u со звёздочкой, равной 2, на высоте одна вторая и пересекает вертикальную ось в точке минус 1.5 с подписью минус f со звёздочкой от t. Штриховая прямая y равно t u проходит через начало координат; при u со звёздочкой вертикальный зазор между штриховой прямой и параболой равен 1.5 и отмечен зелёной двусторонней стрелкой с подписью f со звёздочкой от t, наибольший зазор. Маленький треугольник наклона на касательной показывает подъём t на единицу смещения по горизонтали." : "A convex parabola f of u with minimum 0 at u equals 1. An amber straight line with slope t equals 1 touches the parabola at the single point u star equals 2, height one half, and crosses the vertical axis at minus 1.5, labelled minus f star of t. A dashed line y equals t u passes through the origin; at u star the vertical gap between the dashed line and the parabola is 1.5, marked by a green double arrow labelled f star of t, the largest gap. A small slope triangle on the tangent line shows rise t over run 1."}</desc>

      <path class="f-axis" d={`M ${v.L} ${v.sy(0)} H ${v.R + 24}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-axis" d={`M ${v.sx(0)} ${v.B} V ${v.T - 6}`} marker-end="url(#f-arrow-muted)" />
      <text class="f-math" x={v.R + 24} y={v.sy(0) + 26} text-anchor="end">u</text>
      <text class="f-math" x={v.sx(0) - 10} y={v.T + 8} text-anchor="end">y</text>
      <text class="f-note" x={v.sx(0) + 7} y={v.sy(0) + 18}>0</text>

      <path class="f-line f-muted f-dash" d={v.zeroPath} />
      <path class="f-line f-blue f-bold" d={v.fPath} />
      <path class="f-line f-amber f-bold" d={v.tanPath} />

      <text class="f-math f-t-blue" x={v.sx(-0.55)} y={v.sy(1.65)}>f(u)</text>
      <text class="f-math f-t-muted" x={v.sx(v.full ? 2.85 : 2.7)} y={v.sy(3.25)} text-anchor="end">y = t u</text>
      <text class="f-math f-t-amber" x={v.sx(0.25)} y={v.sy(-1.95)}>y = t u − f*(t)</text>

      <!-- slope triangle -->
      <path class="f-thin f-amber" d={`M ${v.sx(tri0)} ${v.sy(tangent(tri0))} H ${v.sx(tri1)} V ${v.sy(tangent(tri1))}`} />
      <text class="f-note" x={(v.sx(tri0) + v.sx(tri1)) / 2} y={v.sy(tangent(tri0)) + 18} text-anchor="middle">1</text>
      <text class="f-note f-t-amber" x={v.sx(tri1) + 7} y={(v.sy(tangent(tri0)) + v.sy(tangent(tri1))) / 2 + 5}>t</text>

      <!-- u* and the touching point -->
      <line class="f-thin f-muted f-dash" x1={v.sx(us)} x2={v.sx(us)} y1={v.sy(0)} y2={v.sy(fu)} />
      <text class="f-math" x={v.sx(us)} y={v.sy(0) + 24} text-anchor="middle">u*</text>
      <circle cx={v.sx(us)} cy={v.sy(fu)} r="5" fill="var(--fig-amber)" />
      {v.full && (
        <g>
          <text class="f-label" x={v.sx(0.2)} y={v.sy(3.45)}>{ru ? "прямая с наклоном t касается f" : "slope-t line touches f"}</text>
          <text class="f-label" x={v.sx(0.2)} y={v.sy(3.45) + 20}>{ru ? "в одной точке: f′(u*) = t" : "at one point: f′(u*) = t"}</text>
          <path class="f-thin" d={`M ${v.sx(0.75)} ${v.sy(3.45) + 30} Q ${v.sx(0.9)} ${v.sy(0.9)} ${v.sx(us) - 8} ${v.sy(fu) - 3}`} marker-end="url(#f-arrow)" />
        </g>
      )}

      <!-- the gap f*(t) -->
      <line class="f-line f-green" x1={v.sx(us)} x2={v.sx(us)} y1={v.sy(fu) - 7} y2={v.sy(through0(us)) + 7} marker-start="url(#f-arrow-green)" marker-end="url(#f-arrow-green)" />
      {v.full ? (
        <g>
          <text class="f-label f-t-green" x={v.sx(2.3)} y={v.sy(-0.62)}>{ru ? "f*(t) = наибольший" : "f*(t) = largest gap"}</text>
          <text class="f-label f-t-green" x={v.sx(2.3)} y={v.sy(-0.62) + 20}>{ru ? "зазор между t u и f(u)" : "between t u and f(u)"}</text>
          <path class="f-thin f-green" d={`M ${v.sx(2.45)} ${v.sy(-0.62) - 16} Q ${v.sx(2.45)} ${v.sy(0.6)} ${v.sx(us) + 6} ${v.sy(1.25)}`} marker-end="url(#f-arrow-green)" />
        </g>
      ) : (
        <text class="f-math f-t-green" x={v.sx(us) - 10} y={v.sy(1.25) + 6} text-anchor="end">f*(t)</text>
      )}

      <!-- intercept -->
      <circle cx={v.sx(0)} cy={v.sy(-fstar)} r="4.5" fill="var(--fig-amber)" />
      <text class="f-math f-t-amber f-halo" x={v.sx(0) - 10} y={v.sy(-fstar) - 6} text-anchor="end">−f*(t)</text>
    </svg>
  ))}
</Figure>
