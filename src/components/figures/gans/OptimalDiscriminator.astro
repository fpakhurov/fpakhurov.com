---
import Figure from '../Figure.astro';
import { plot, area, scale, gaussian } from '../geometry';
import { mixture, maxOf, roots } from './densities';

// Two 1-D densities: a two-component "data" mixture and a single-Gaussian generator.
const pdata = mixture([[0.6, -1.5, 0.6], [0.4, 0.6, 0.5]]);
const pg = (x: number) => gaussian(x, 1.8, 0.85);
const dstar = (x: number) => pdata(x) / (pdata(x) + pg(x));

const x0 = -4;
const x1 = 5;
const left = 62;
const right = 560;
const sx = scale([x0, x1], [left, right]);

// Top panel: densities. Bottom panel: D*(x) in [0, 1].
const tTop = 40;
const tBot = 200;
const yMax = Math.max(maxOf(pdata, x0, x1), maxOf(pg, x0, x1)) * 1.12;
const syT = scale([0, yMax], [tBot, tTop]);
const bTop = 262;
const bBot = 392;
const syB = scale([0, 1], [bBot, bTop]);

const dataPath = plot(pdata, x0, x1, sx, syT, 240);
const dataArea = area(pdata, x0, x1, sx, syT, 240);
const genPath = plot(pg, x0, x1, sx, syT, 240);
const genArea = area(pg, x0, x1, sx, syT, 240);
const dPath = plot(dstar, x0, x1, sx, syB, 300);

const cross = roots((x) => pdata(x) - pg(x), x0, x1);
const xc = cross[0];
const id = 'gans-optimal-d';
const xTicks = [-4, -2, 0, 2, 4];
---

<Figure
  id={id}
  title="The optimal discriminator compares the two densities"
  caption={`For a fixed generator, the best discriminator is D*(x) = p_data(x) / (p_data(x) + p_g(x)). It is close to 1 where only real data live, close to 0 where only generated samples live, and exactly ½ where the densities are equal (here at x ≈ ${xc.toFixed(2)}). Densities: p_data = 0.6·N(−1.5, 0.6²) + 0.4·N(0.6, 0.5²), p_g = N(1.8, 0.85²).`}
  origin="illustrative"
  pages="23"
>
  <svg class="fig-medium" viewBox="0 0 600 440" role="img" aria-labelledby={`${id}-t ${id}-d`}>
    <title id={`${id}-t`}>Two densities and the optimal discriminator</title>
    <desc id={`${id}-d`}>Top panel: the data density p_data, red, with a tall mode at minus 1.5 and a smaller one at 0.6, and the generator density p_g, blue, a single bell at 1.8. They cross at x about {xc.toFixed(2)}. Bottom panel: D star of x, green, equals almost 1 on the left where only data has mass, falls through one half exactly at the crossing point, and approaches 0 on the right where only the generator has mass. A dashed vertical line links the crossing in both panels.</desc>

    <!-- Top panel -->
    <path class="f-axis" d={`M ${left} ${tBot} H ${right + 22}`} marker-end="url(#f-arrow-muted)" />
    <path class="f-axis" d={`M ${left} ${tBot} V ${tTop - 14}`} marker-end="url(#f-arrow-muted)" />
    <text class="f-label" transform={`translate(${left - 22} ${(tTop + tBot) / 2}) rotate(-90)`} text-anchor="middle">density</text>
    <path class="f-fill-red" d={dataArea} />
    <path class="f-fill-blue" d={genArea} />
    <path class="f-line f-red" d={dataPath} />
    <path class="f-line f-blue" d={genPath} />
    <text class="f-math f-t-red" x={sx(-2.55)} y={syT(0.36)} text-anchor="end">p<tspan dy="5" font-size="13" style="font-style: normal">data</tspan><tspan dy="-5">(x)</tspan></text>
    <text class="f-math f-t-blue" x={sx(2.75)} y={syT(0.37)}>p<tspan dy="5" font-size="13">g</tspan><tspan dy="-5">(x)</tspan></text>
    <circle class="f-solid-muted" cx={sx(xc)} cy={syT(pg(xc))} r="4" />
    <text class="f-note" x={sx(xc)} y={tTop - 8} text-anchor="middle">p<tspan dy="4" font-size="11">data</tspan><tspan dy="-4"> = p</tspan><tspan dy="4" font-size="11">g</tspan></text>

    <!-- Bottom panel -->
    <line class="f-grid" x1={left} x2={right} y1={syB(1)} y2={syB(1)} />
    <line class="f-thin f-muted f-dash" x1={left} x2={right} y1={syB(0.5)} y2={syB(0.5)} />
    <path class="f-axis" d={`M ${left} ${bBot} H ${right + 22}`} marker-end="url(#f-arrow-muted)" />
    <path class="f-axis" d={`M ${left} ${bBot} V ${bTop - 14}`} marker-end="url(#f-arrow-muted)" />
    {[0, 0.5, 1].map((t) => <text class="f-note" x={left - 10} y={syB(t) + 5} text-anchor="end">{t === 0.5 ? '½' : t}</text>)}
    {xTicks.map((t) => <text class="f-note" x={sx(t)} y={bBot + 22} text-anchor="middle">{t < 0 ? `−${-t}` : t}</text>)}
    <text class="f-math" x={right + 22} y={bBot + 24} text-anchor="end">x</text>
    <path class="f-line f-green f-bold" d={dPath} />
    <text class="f-math f-t-green" x={sx(-3.9)} y={syB(1) - 10}>D*(x)</text>

    <!-- Shared crossing line -->
    <line class="f-thin f-muted f-dash" x1={sx(xc)} x2={sx(xc)} y1={tTop + 4} y2={bBot} />
    <circle class="f-solid-green" cx={sx(xc)} cy={syB(0.5)} r="5" />

    <text class="f-label f-t-green f-halo" x={sx(2.3)} y={syB(0.5) - 34}>D* = ½ where p<tspan dy="4" font-size="12">data</tspan><tspan dy="-4"> = p</tspan><tspan dy="4" font-size="12">g</tspan></text>
    <path class="f-thin f-green" d={`M ${sx(2.35)} ${syB(0.5) - 28} Q ${sx(1.6)} ${syB(0.5) - 16} ${sx(xc) + 8} ${syB(0.5) - 4}`} marker-end="url(#f-arrow-green)" />

    <text class="f-label f-t-muted" x={sx(-2.7)} y={syB(0.72)} text-anchor="middle">≈ 1: only real data</text>
    <text class="f-label f-t-muted" x={sx(3.6)} y={syB(0.16)} text-anchor="middle">≈ 0: only generated</text>
  </svg>
</Figure>
