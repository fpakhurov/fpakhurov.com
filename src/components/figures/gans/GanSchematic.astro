---
import Figure from '../Figure.astro';
import { plot, scale, gaussian } from '../geometry';
import { mixture, maxOf } from './densities';

// The three small density sketches from page 21, generated from real densities.
const pz = (z: number) => gaussian(z, 0, 1);
const pg = mixture([[0.6, -0.6, 0.6], [0.4, 1.0, 0.55]]);
const pdata = mixture([[0.55, -0.7, 0.45], [0.45, 0.9, 0.5]]);

type Sketch = { ox: number; oy: number; w: number; h: number; f: (x: number) => number; a: number; b: number; label: string; sub: string; axis: string; cls: string };

// A tiny axes box with origin (ox, oy); the curve peaks at 70% of the height to leave room for the label.
function sketch(s: Sketch) {
  const top = maxOf(s.f, s.a, s.b);
  const sx = scale([s.a, s.b], [s.ox + 6, s.ox + s.w - 10]);
  const sy = scale([0, top / 0.7], [s.oy, s.oy - s.h]);
  return { ...s, d: plot(s.f, s.a, s.b, sx, sy, 120) };
}

const id = 'gans-schematic';

// Wide layout: generator column at x = 260, discriminator column at x = 450.
const wide = {
  sketches: [
    sketch({ ox: 40, oy: 165, w: 150, h: 78, f: pg, a: -2.6, b: 3, label: 'p', sub: 'g', axis: 'x', cls: 'f-blue' }),
    sketch({ ox: 40, oy: 380, w: 150, h: 78, f: pz, a: -3.2, b: 3.2, label: 'p', sub: 'z', axis: 'z', cls: 'f-muted' }),
    sketch({ ox: 515, oy: 380, w: 150, h: 78, f: pdata, a: -2.6, b: 3, label: 'p', sub: 'data', axis: 'x', cls: 'f-red' }),
  ],
};
const narrow = {
  sketches: [
    sketch({ ox: 22, oy: 92, w: 130, h: 62, f: pz, a: -3.2, b: 3.2, label: 'p', sub: 'z', axis: 'z', cls: 'f-muted' }),
    sketch({ ox: 22, oy: 252, w: 130, h: 62, f: pg, a: -2.6, b: 3, label: 'p', sub: 'g', axis: 'x', cls: 'f-blue' }),
    sketch({ ox: 22, oy: 512, w: 130, h: 62, f: pdata, a: -2.6, b: 3, label: 'p', sub: 'data', axis: 'x', cls: 'f-red' }),
  ],
};
const arg = (axis: string) => `(${axis})`;
---

<Figure
  id={id}
  title="The GAN game as a picture"
  caption="Noise z is pushed through the generator G (parameters θ_g); its outputs G(z) have the distribution p_g and are shown to the discriminator with the label y = 0. Real data x ~ p_data arrive with the label y = 1. The discriminator D (parameters θ_d) outputs the probability that its input is original data. The small plots sketch the noise density, the generator's density and the data density."
  origin="redrawn"
  pages="21"
>
  <svg class="fig-wide" viewBox="0 0 680 405" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>Generator and discriminator data flow</title>
    <desc id={`${id}-w-d`}>On the left, a noise node z drawn from p_z(z), sketched as a broad bell curve, feeds upward into a box G with parameters theta g. G outputs a node G(z), the generated data, whose density p_g(x) is sketched as a two-humped curve. An arrow labelled y equals 0, fake, goes from G(z) to the discriminator node D with parameters theta d. From below, the original data node x, drawn from p_data(x) and sketched as another two-humped curve, sends an arrow labelled y equals 1, real, into D. D outputs P(input is original).</desc>

    {wide.sketches.map((s) => (
      <g>
        <path class="f-axis" d={`M ${s.ox} ${s.oy} H ${s.ox + s.w}`} marker-end="url(#f-arrow-muted)" />
        <path class="f-axis" d={`M ${s.ox} ${s.oy} V ${s.oy - s.h}`} marker-end="url(#f-arrow-muted)" />
        <path class={`f-line ${s.cls}`} d={s.d} />
        <text class="f-math" x={s.ox + 10} y={s.oy - s.h + 10}>{s.label}<tspan dy="5" font-size="13">{s.sub}</tspan><tspan dy="-5">{arg(s.axis)}</tspan></text>
        <text class="f-math" x={s.ox + s.w + 2} y={s.oy + 20} text-anchor="end">{s.axis}</text>
      </g>
    ))}

    <!-- Generator column -->
    <circle class="f-box" cx="260" cy="330" r="21" />
    <text class="f-math" x="260" y="336" text-anchor="middle">z</text>
    <text class="f-label" x="260" y="374" text-anchor="middle">noise</text>
    <text class="f-math" x="260" y="396" text-anchor="middle">z ~ p<tspan dy="5" font-size="13">z</tspan><tspan dy="-5">(z)</tspan></text>
    <path class="f-line" d="M 260 308 V 254" marker-end="url(#f-arrow)" />

    <rect class="f-box" x="230" y="206" width="60" height="46" rx="4" />
    <text class="f-math f-upright" x="260" y="236" text-anchor="middle">G</text>
    <text class="f-math f-t-blue" x="178" y="235" text-anchor="middle">θ<tspan dy="5" font-size="13">g</tspan></text>
    <path class="f-line f-blue" d="M 194 229 H 227" marker-end="url(#f-arrow-blue)" />
    <path class="f-line" d="M 260 204 V 154" marker-end="url(#f-arrow)" />

    <circle class="f-box" cx="260" cy="125" r="27" />
    <text class="f-math" x="260" y="131" text-anchor="middle">G(z)</text>
    <text class="f-label" x="260" y="86" text-anchor="middle">generated data</text>

    <!-- Fake branch -->
    <path class="f-line f-blue" d="M 289 125 H 421" marker-end="url(#f-arrow-blue)" />
    <text class="f-math" x="355" y="114" text-anchor="middle">y = 0</text>
    <text class="f-note" x="355" y="146" text-anchor="middle">fake</text>

    <!-- Discriminator -->
    <circle class="f-box" cx="450" cy="125" r="27" />
    <text class="f-math f-upright" x="450" y="131" text-anchor="middle">D</text>
    <text class="f-math f-t-green" x="508" y="56">θ<tspan dy="5" font-size="13">d</tspan></text>
    <path class="f-line f-green" d="M 503 52 Q 470 50 466 96" marker-end="url(#f-arrow-green)" />
    <path class="f-line" d="M 479 125 H 517" marker-end="url(#f-arrow)" />
    <text class="f-label" x="523" y="130">P(input is original)</text>

    <!-- Real branch -->
    <circle class="f-box" cx="450" cy="330" r="21" />
    <text class="f-math" x="450" y="336" text-anchor="middle">x</text>
    <text class="f-label" x="450" y="374" text-anchor="middle">original data</text>
    <text class="f-math" x="450" y="396" text-anchor="middle">x ~ p<tspan dy="5" font-size="13" style="font-style: normal">data</tspan><tspan dy="-5">(x)</tspan></text>
    <path class="f-line f-red" d="M 450 307 V 155" marker-end="url(#f-arrow-red)" />
    <text class="f-math" x="462" y="236">y = 1</text>
    <text class="f-note" x="462" y="258">real</text>
  </svg>

  <svg class="fig-narrow" viewBox="0 0 360 560" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>Generator and discriminator data flow</title>
    <desc id={`${id}-n-d`}>A vertical chain. At the top, the noise node z drawn from p_z(z), sketched as a bell curve, feeds into the box G with parameters theta g, which outputs G(z), the generated data with density p_g(x). An arrow labelled y equals 0, fake, goes down to the discriminator D with parameters theta d. From the bottom, the original data node x drawn from p_data(x) sends an arrow labelled y equals 1, real, up into D. D outputs P(input is original), written to its left.</desc>

    {narrow.sketches.map((s) => (
      <g>
        <path class="f-axis" d={`M ${s.ox} ${s.oy} H ${s.ox + s.w}`} marker-end="url(#f-arrow-muted)" />
        <path class="f-axis" d={`M ${s.ox} ${s.oy} V ${s.oy - s.h}`} marker-end="url(#f-arrow-muted)" />
        <path class={`f-line ${s.cls}`} d={s.d} />
        <text class="f-math" x={s.ox + 10} y={s.oy - s.h + 10}>{s.label}<tspan dy="5" font-size="13">{s.sub}</tspan><tspan dy="-5">{arg(s.axis)}</tspan></text>
        <text class="f-math" x={s.ox + s.w + 2} y={s.oy + 20} text-anchor="end">{s.axis}</text>
      </g>
    ))}

    <circle class="f-box" cx="220" cy="52" r="21" />
    <text class="f-math" x="220" y="58" text-anchor="middle">z</text>
    <text class="f-label" x="252" y="46">noise</text>
    <text class="f-math" x="252" y="70">z ~ p<tspan dy="5" font-size="13">z</tspan></text>
    <path class="f-line" d="M 220 75 V 110" marker-end="url(#f-arrow)" />

    <rect class="f-box" x="192" y="112" width="56" height="42" rx="4" />
    <text class="f-math f-upright" x="220" y="140" text-anchor="middle">G</text>
    <text class="f-math f-t-blue" x="290" y="140" text-anchor="middle">θ<tspan dy="5" font-size="13">g</tspan></text>
    <path class="f-line f-blue" d="M 276 133 H 251" marker-end="url(#f-arrow-blue)" />
    <path class="f-line" d="M 220 156 V 186" marker-end="url(#f-arrow)" />

    <circle class="f-box" cx="220" cy="214" r="26" />
    <text class="f-math" x="220" y="220" text-anchor="middle">G(z)</text>
    <text class="f-label" x="254" y="206">generated</text>
    <text class="f-label" x="254" y="226">data</text>

    <path class="f-line f-blue" d="M 220 242 V 316" marker-end="url(#f-arrow-blue)" />
    <text class="f-math" x="232" y="278">y = 0</text>
    <text class="f-note" x="232" y="298">fake</text>

    <circle class="f-box" cx="220" cy="346" r="27" />
    <text class="f-math f-upright" x="220" y="352" text-anchor="middle">D</text>
    <text class="f-math f-t-green" x="292" y="318">θ<tspan dy="5" font-size="13">d</tspan></text>
    <path class="f-line f-green" d="M 288 326 Q 262 330 249 340" marker-end="url(#f-arrow-green)" />
    <path class="f-line" d="M 191 346 H 150" marker-end="url(#f-arrow)" />
    <text class="f-label" x="142" y="340" text-anchor="end">P(input is</text>
    <text class="f-label" x="142" y="360" text-anchor="end">original)</text>

    <path class="f-line f-red" d="M 220 450 V 376" marker-end="url(#f-arrow-red)" />
    <text class="f-math" x="232" y="410">y = 1</text>
    <text class="f-note" x="232" y="430">real</text>

    <circle class="f-box" cx="220" cy="472" r="21" />
    <text class="f-math" x="220" y="478" text-anchor="middle">x</text>
    <text class="f-label" x="250" y="468">original data</text>
    <text class="f-math" x="250" y="492">x ~ p<tspan dy="5" font-size="13" style="font-style: normal">data</tspan></text>
  </svg>
</Figure>
