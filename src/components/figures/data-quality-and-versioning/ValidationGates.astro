---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Where validation gates sit in the fraud pipeline: four gates on the path of the data, one comparing
// training with serving. Failing batches go to quarantine; failing requests go to the fallback rules.
const L = ru
  ? { producer: ['источник', 'checkout'], raw: ['сырые', 'по приходу'], transform: ['обработка', 'очистка'], clean: ['чистые', 'публикуются'],
      training: ['обучение', 'выборка'], request: ['запрос', 'платёж'], model: ['модель', 'считает риск'] }
  : { producer: ['producer', 'checkout'], raw: ['raw zone', 'by arrival'], transform: ['transform', 'dedupe, join'], clean: ['clean', 'published'],
      training: ['training', 'set, model'], request: ['request', 'live payment'], model: ['model', 'scores'] };
const t = ru
  ? { gates: ['контракт', 'набор проверок', 'обучающая выборка', 'запрос', 'сравнить статистики'],
      gatesN: ['контракт', 'набор', 'выборка', 'запрос', 'сравнить статистики'],
      quarantine: 'карантин: хранится, не публикуется', qN: ['карантин:', 'хранится,', 'не публикуется'],
      fallback: ['запасной путь', 'решают правила'], decision: 'решение',
      offline: 'данные: от источника до обучения', online: 'инференс: каждый запрос',
      steps: ['при приёме: партиция проверяется по контракту источника; не прошедшая уходит в карантин', 'после обработки: набор проверок на дубликаты, пропуски и распределения по срезам; только потом публикация', 'перед обучением: размер, доля меток, только зрелые метки, нет данных периода оценки', 'при инференсе: каждый запрос проверяется по схеме и диапазонам; не прошедший решают правила', 'статистики признаков в продакшене сравниваются с обучающими: расхождение и дрейф'] }
  : { gates: ['contract', 'suite', 'training set', 'request', 'compare statistics'],
      gatesN: ['contract', 'suite', 'train set', 'request', 'compare statistics'],
      quarantine: 'quarantine: kept, not published', qN: ['quarantine:', 'kept, not', 'published'],
      fallback: ['fallback', 'rules decide'], decision: 'decision',
      offline: 'data: from producer to training', online: 'serving: every request',
      steps: ['at ingestion: each batch is checked against the producer contract; a failing one goes to quarantine', 'after transformation: the suite checks duplicates, missingness and distributions per slice; only then is the partition published', 'before training: size, label rate, only mature labels, no rows from the evaluation period', 'at serving: each request is checked for schema and ranges; a failing one is decided by the rules', 'the statistics of features in production are compared with those of training: skew and drift'] };

const green = toneVar.x, blue = toneVar.h, amber = toneVar.g, red = toneVar.y;
const boxStyle = (tone: string) => `fill: ${tone}; fill-opacity: 0.1; stroke: ${tone}; stroke-width: 1.2`;
const D = 15; // half-diagonal of a gate diamond
const diamond = (cx: number, cy: number) => `M ${cx} ${cy - D} L ${cx + D} ${cy} L ${cx} ${cy + D} L ${cx - D} ${cy} Z`;

// Wide layout: the data row on top, the serving row below, quarantine between them on the left.
const W = 760, BW = 92, BH = 48, G = 16, RY = 64, SY = 248;
const bx = { producer: 20 } as Record<string, number>;
const gx: number[] = [];
bx.producer = 20;
gx[0] = bx.producer + BW + G + D;
bx.raw = gx[0] + D + G;
bx.transform = bx.raw + BW + 24;
gx[1] = bx.transform + BW + G + D;
bx.clean = gx[1] + D + G;
gx[2] = bx.clean + BW + G + D;
bx.training = gx[2] + D + G;
bx.model = bx.training;
gx[3] = bx.model - G - D;
bx.request = gx[3] - D - G - BW;
const g5x = bx.training + BW / 2, g5y = (RY + BH + SY) / 2;
if (bx.training + BW > W - 60) throw new Error(`data row too wide: ${bx.training + BW}`);
for (const [k, [a, b]] of Object.entries(L)) {
  if (a.length * 7.5 > BW - 10 || b.length * 6.5 > BW - 10) throw new Error(`box ${k} does not fit`);
}
const gateLabelY = (k: number) => (k < 3 ? RY - 14 : SY - 14);
const gy = [0, 1, 2, 3].map((k) => (k < 3 ? RY + BH / 2 : SY + BH / 2));
const gateCx = (k: number) => gx[k];
// Gate labels above the gates must not overlap each other.
for (let k = 0; k < 2; k++) {
  if (gateCx(k) + (t.gates[k].length * 6.5) / 2 + 6 > gateCx(k + 1) - (t.gates[k + 1].length * 6.5) / 2) throw new Error(`gate labels ${k}`);
}
const QX0 = 80, QX1 = 450, QY = 150, QH = 40;
if (t.quarantine.length * 7.5 > QX1 - QX0 - 20) throw new Error('quarantine text');
if (!(QX0 < gx[0] && gx[1] < QX1)) throw new Error('quarantine under gates 1-2');
const FBW = 124, FBY = 318, FBH = 42;
if (t.fallback[0].length * 7.5 > FBW - 10 || t.fallback[1].length * 6.5 > FBW - 10) throw new Error('fallback text');
if (g5x - 22 - t.gates[4].length * 6.5 < QX1 + 10) throw new Error('compare label runs into quarantine');
if (bx.model + BW + 4 + t.decision.length * 6.5 > W - 4) throw new Error('decision label');
if (bx.request < 20 + t.online.length * 6.5 + 20) throw new Error('online label runs into request');
const H = FBY + FBH + 14;
const rowBoxes = [['producer', 1], ['raw', 1], ['transform', 2], ['clean', 2], ['training', 3]].map(([k, step]) => {
  const key = String(k) as keyof typeof L;
  return { x: bx[key], step: String(step), label: L[key][0], sub: L[key][1], tone: key === 'producer' ? green : blue };
});

// Narrow layout: one column; quarantine, fallback and the comparison on the right.
const NW = 360, NX = 20, NBW = 170, NBH = 36, NG = 8, NCX = NX + NBW / 2;
const seq: { kind: 'box' | 'gate'; key: string | number }[] = [
  { kind: 'box', key: 'producer' }, { kind: 'gate', key: 0 }, { kind: 'box', key: 'raw' }, { kind: 'box', key: 'transform' },
  { kind: 'gate', key: 1 }, { kind: 'box', key: 'clean' }, { kind: 'gate', key: 2 }, { kind: 'box', key: 'training' },
];
const ny: Record<string, number> = {};
let yy = 40;
for (const s of seq) {
  if (s.kind === 'box') { ny[s.key as string] = yy; yy += NBH + NG; }
  else { ny[`g${s.key}`] = yy + D; yy += 2 * D + NG; }
}
const nG5y = ny.training + NBH + 34;
const nOnlineY = nG5y + 34;
ny.request = nOnlineY + 14;
ny.g3 = ny.request + NBH + NG + D;
ny.model = ny.g3 + D + NG;
const nDecisionY = ny.model + NBH + 30;
const NH = nDecisionY + 18;
for (const k of [0, 1, 2, 3]) if (NCX - D - 6 - t.gatesN[k].length * 7.3 < 4) throw new Error(`narrow gate label ${k}`);
for (const [k, [a]] of Object.entries(L)) if (a.length * 8.0 > NBW - 12) throw new Error(`narrow box ${k}`);
const NQX = 206, NQW = 136;
for (const s of t.qN) if (s.length * 7.3 > NQW - 10) throw new Error(`narrow quarantine ${s}`);
const NFX = 200, NFW = 124;
for (const s of t.fallback) if (s.length * 7.3 > NFW - 8) throw new Error(`narrow fallback ${s}`);
const NG5X = 340;
if (NG5X - D - 6 - t.gatesN[4].length * 7.3 < 4) throw new Error('narrow compare label');
if (nG5y - 12 < ny.training + NBH + 4 || nG5y + 6 > nOnlineY - 14) throw new Error('narrow compare label crowds its neighbours');
if (NFX + NFW > NG5X - 6) throw new Error('narrow fallback hits the comparison line');
// The narrow column as drawable items: each with its top, bottom, step and either a box label or a gate number.
const nItems = seq.map((s, i) => {
  const isBox = s.kind === 'box';
  const key = String(s.key);
  const gate = isBox ? -1 : Number(s.key);
  const top = isBox ? ny[key] : ny[`g${key}`] - D;
  const step = isBox ? (key === 'producer' || key === 'raw' ? 1 : key === 'training' ? 3 : 2) : gate + 1;
  const label = isBox ? L[key as keyof typeof L][0] : t.gatesN[gate];
  return { isBox, top, bottom: isBox ? top + NBH : top + 2 * D, cy: top + (isBox ? NBH / 2 : D), step: String(step), label, gate, tone: key === 'producer' ? green : blue };
});
const id = 'validation-gates';
---

<Figure
  id={id}
  title={ru ? 'Где стоят проверки данных' : 'Where data are validated'}
  caption={ru
    ? 'Ромбы — гейты валидации в конвейере мошенничества. При приёме партиция проверяется по контракту источника (1), после обработки — набором проверок конвейера (2); не прошедшая партиция уходит в карантин: хранится для разбора и пересборки, но не публикуется, и потребители читают прошлую версию. Перед обучением проверяется выборка целиком (3), при инференсе — каждый запрос, и не прошедший запрос решают правила (4). Пятый гейт сравнивает статистики признаков в продакшене с обучающими (5).'
    : 'Diamonds are validation gates in the fraud pipeline. At ingestion each batch is checked against the producer contract (1), after transformation by the pipeline suite (2); a failing batch goes to quarantine: kept for diagnosis and reprocessing but not published, while consumers read the previous version. Before training the training set as a whole is checked (3), at serving every request, and a failing request is decided by the rules (4). The fifth gate compares the statistics of features in production with those of training (5).'}
>
  <svg class="fig-wide fig-bp-640" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`${id}-760-t ${id}-760-d`}>
    <title id={`${id}-760-t`}>{ru ? 'Пять гейтов валидации в конвейере' : 'Five validation gates in a pipeline'}</title>
    <desc id={`${id}-760-d`}>{ru
      ? 'Верхний ряд: источник, гейт 1, сырые данные, обработка, гейт 2, чистые данные, гейт 3, обучение. От гейтов 1 и 2 красные стрелки ведут вниз в карантин. Нижний ряд: запрос, гейт 4, модель, решение; от гейта 4 стрелка вниз к запасным правилам. Пунктир между обучением и моделью с гейтом 5: сравнение статистик.'
      : 'Top row: producer, gate 1, raw zone, transform, gate 2, clean, gate 3, training. From gates 1 and 2 red arrows lead down to quarantine. Bottom row: request, gate 4, model, decision; from gate 4 an arrow leads down to the fallback rules. A dashed line between training and the model carries gate 5: compare statistics.'}</desc>
    <text class="f-small f-t-muted" x={20} y={26} style="font-weight: 650">{t.offline}</text>
    <text class="f-small f-t-muted" x={20} y={SY + BH / 2 + 4} style="font-weight: 650">{t.online} →</text>
    {rowBoxes.map((r) => (
      <g data-s={r.step}>
        <rect x={r.x} y={RY} width={BW} height={BH} rx="7" style={boxStyle(r.tone)} />
        <text class="f-label" x={r.x + BW / 2} y={RY + 21} text-anchor="middle">{r.label}</text>
        <text class="f-small f-t-muted" x={r.x + BW / 2} y={RY + 38} text-anchor="middle">{r.sub}</text>
      </g>
    ))}
    <g data-s="1">
      <path class="f-line f-muted" d={`M ${bx.producer + BW + 1} ${RY + BH / 2} H ${gx[0] - D - 2}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-line f-muted" d={`M ${gx[0] + D + 1} ${RY + BH / 2} H ${bx.raw - 2}`} marker-end="url(#f-arrow-muted)" />
    </g>
    <g data-s="2">
      <path class="f-line f-muted" d={`M ${bx.raw + BW + 1} ${RY + BH / 2} H ${bx.transform - 2}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-line f-muted" d={`M ${bx.transform + BW + 1} ${RY + BH / 2} H ${gx[1] - D - 2}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-line f-muted" d={`M ${gx[1] + D + 1} ${RY + BH / 2} H ${bx.clean - 2}`} marker-end="url(#f-arrow-muted)" />
    </g>
    <g data-s="3">
      <path class="f-line f-muted" d={`M ${bx.clean + BW + 1} ${RY + BH / 2} H ${gx[2] - D - 2}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-line f-muted" d={`M ${gx[2] + D + 1} ${RY + BH / 2} H ${bx.training - 2}`} marker-end="url(#f-arrow-muted)" />
    </g>
    <g data-s="1 2">
      <rect x={QX0} y={QY} width={QX1 - QX0} height={QH} rx="7" style={boxStyle(red)} />
      <text class="f-label" x={(QX0 + QX1) / 2} y={QY + QH / 2 + 5} text-anchor="middle">{t.quarantine}</text>
    </g>
    {[0, 1].map((k) => (
      <g data-s={String(k + 1)}><path class="f-line f-red f-dash" d={`M ${gx[k]} ${RY + BH / 2 + D + 1} V ${QY - 3}`} marker-end="url(#f-arrow-red)" /></g>
    ))}
    <g data-s="4">
      <rect x={bx.request} y={SY} width={BW} height={BH} rx="7" style={boxStyle(green)} />
      <text class="f-label" x={bx.request + BW / 2} y={SY + 21} text-anchor="middle">{L.request[0]}</text>
      <text class="f-small f-t-muted" x={bx.request + BW / 2} y={SY + 38} text-anchor="middle">{L.request[1]}</text>
      <rect x={bx.model} y={SY} width={BW} height={BH} rx="7" style={boxStyle(blue)} />
      <text class="f-label" x={bx.model + BW / 2} y={SY + 21} text-anchor="middle">{L.model[0]}</text>
      <text class="f-small f-t-muted" x={bx.model + BW / 2} y={SY + 38} text-anchor="middle">{L.model[1]}</text>
      <path class="f-line f-muted" d={`M ${bx.request + BW + 1} ${SY + BH / 2} H ${gx[3] - D - 2}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-line f-muted" d={`M ${gx[3] + D + 1} ${SY + BH / 2} H ${bx.model - 2}`} marker-end="url(#f-arrow-muted)" />
      <path class="f-line f-red" d={`M ${bx.model + BW + 1} ${SY + BH / 2} H ${W - 14}`} marker-end="url(#f-arrow-red)" />
      <text class="f-small f-t-red" x={bx.model + BW + 4} y={SY + BH / 2 - 8}>{t.decision}</text>
      <path class="f-line f-red f-dash" d={`M ${gx[3]} ${SY + BH / 2 + D + 1} V ${FBY - 3}`} marker-end="url(#f-arrow-red)" />
      <rect x={gx[3] - FBW / 2} y={FBY} width={FBW} height={FBH} rx="7" style={boxStyle(amber)} />
      <text class="f-label" x={gx[3]} y={FBY + 18} text-anchor="middle">{t.fallback[0]}</text>
      <text class="f-small f-t-muted" x={gx[3]} y={FBY + 35} text-anchor="middle">{t.fallback[1]}</text>
    </g>
    <g data-s="5">
      <path class="f-line f-amber f-dash" d={`M ${g5x} ${RY + BH + 2} V ${SY - 2}`} />
      <text class="f-small f-halo" x={g5x - D - 8} y={g5y + 4.5} text-anchor="end">{t.gates[4]}</text>
    </g>
    {[0, 1, 2, 3].map((k) => (
      <g data-s={String(k + 1)}>
        <path d={diamond(gx[k], gy[k])} style={`fill: ${amber}; fill-opacity: 0.25; stroke: ${amber}; stroke-width: 1.5`} />
        <Badge x={gx[k]} y={gy[k]} n={k + 1} />
        <text class="f-small" x={gx[k]} y={gateLabelY(k)} text-anchor="middle" style="font-weight: 650">{t.gates[k]}</text>
      </g>
    ))}
    <g data-s="5">
      <path d={diamond(g5x, g5y)} style={`fill: ${amber}; fill-opacity: 0.25; stroke: ${amber}; stroke-width: 1.5`} />
      <Badge x={g5x} y={g5y} n={5} />
    </g>
  </svg>

  <svg class="fig-narrow seq-narrow fig-bp-640" viewBox={`0 0 ${NW} ${NH}`} role="img" aria-labelledby={`${id}-360-t ${id}-360-d`}>
    <title id={`${id}-360-t`}>{ru ? 'Пять гейтов валидации в конвейере' : 'Five validation gates in a pipeline'}</title>
    <desc id={`${id}-360-d`}>{ru
      ? 'Сверху вниз: источник, гейт 1, сырые данные, обработка, гейт 2, чистые данные, гейт 3, обучение; от гейтов 1 и 2 стрелки ведут вправо в карантин. Ниже: запрос, гейт 4, модель, решение; от гейта 4 стрелка вправо к запасным правилам. Справа пунктир от обучения к модели с гейтом 5: сравнение статистик.'
      : 'Top to bottom: producer, gate 1, raw zone, transform, gate 2, clean, gate 3, training; from gates 1 and 2 arrows lead right to quarantine. Below: request, gate 4, model, decision; from gate 4 an arrow leads right to the fallback rules. On the right, a dashed line from training to the model carries gate 5: compare statistics.'}</desc>
    <text class="f-small f-t-muted" x={NX} y={24} style="font-weight: 650">{t.offline}</text>
    {nItems.map((it, i) => (
      <g data-s={it.step}>
        {i > 0 && <path class="f-line f-muted" d={`M ${NCX} ${nItems[i - 1].bottom + 1} V ${it.top - 2}`} marker-end="url(#f-arrow-muted)" />}
        {it.isBox
          ? <g>
              <rect x={NX} y={it.top} width={NBW} height={NBH} rx="7" style={boxStyle(it.tone)} />
              <text class="f-label" x={NCX} y={it.top + 24} text-anchor="middle">{it.label}</text>
            </g>
          : <g>
              <path d={diamond(NCX, it.cy)} style={`fill: ${amber}; fill-opacity: 0.25; stroke: ${amber}; stroke-width: 1.5`} />
              <Badge x={NCX} y={it.cy} n={it.gate + 1} />
              <text class="f-small" x={NCX - D - 6} y={it.cy + 5} text-anchor="end" style="font-weight: 650">{it.label}</text>
            </g>}
      </g>
    ))}
    <g data-s="1 2">
      <rect x={NQX} y={ny.g0 + 14} width={NQW} height={ny.g1 - ny.g0 - 28} rx="7" style={boxStyle(red)} />
      {t.qN.map((s, k) => <text class="f-small" x={NQX + NQW / 2} y={(ny.g0 + ny.g1) / 2 - 16 + k * 20} text-anchor="middle">{s}</text>)}
    </g>
    <g data-s="1"><path class="f-line f-red f-dash" d={`M ${NCX + D + 1} ${ny.g0} H ${NQX + NQW / 2} V ${ny.g0 + 11}`} marker-end="url(#f-arrow-red)" /></g>
    <g data-s="2"><path class="f-line f-red f-dash" d={`M ${NCX + D + 1} ${ny.g1} H ${NQX + NQW / 2} V ${ny.g1 - 11}`} marker-end="url(#f-arrow-red)" /></g>
    <text class="f-small f-t-muted" x={NX} y={nOnlineY} style="font-weight: 650">{t.online}</text>
    <g data-s="4">
      <rect x={NX} y={ny.request} width={NBW} height={NBH} rx="7" style={boxStyle(green)} />
      <text class="f-label" x={NCX} y={ny.request + 24} text-anchor="middle">{L.request[0]}</text>
      <path class="f-line f-muted" d={`M ${NCX} ${ny.request + NBH + 1} V ${ny.g3 - D - 2}`} marker-end="url(#f-arrow-muted)" />
      <path d={diamond(NCX, ny.g3)} style={`fill: ${amber}; fill-opacity: 0.25; stroke: ${amber}; stroke-width: 1.5`} />
      <Badge x={NCX} y={ny.g3} n={4} />
      <text class="f-small" x={NCX - D - 6} y={ny.g3 + 5} text-anchor="end" style="font-weight: 650">{t.gatesN[3]}</text>
      <path class="f-line f-muted" d={`M ${NCX} ${ny.g3 + D + 1} V ${ny.model - 2}`} marker-end="url(#f-arrow-muted)" />
      <rect x={NX} y={ny.model} width={NBW} height={NBH} rx="7" style={boxStyle(blue)} />
      <text class="f-label" x={NCX} y={ny.model + 24} text-anchor="middle">{L.model[0]}</text>
      <path class="f-line f-red" d={`M ${NCX} ${ny.model + NBH + 1} V ${nDecisionY - 14}`} marker-end="url(#f-arrow-red)" />
      <text class="f-small f-t-red" x={NCX + 10} y={nDecisionY - 2}>{t.decision}</text>
      <path class="f-line f-red f-dash" d={`M ${NCX + D + 1} ${ny.g3} H ${NFX - 3}`} marker-end="url(#f-arrow-red)" />
      <rect x={NFX} y={ny.g3 - 22} width={NFW} height={44} rx="7" style={boxStyle(amber)} />
      <text class="f-small" x={NFX + NFW / 2} y={ny.g3 - 4} text-anchor="middle" style="font-weight: 650">{t.fallback[0]}</text>
      <text class="f-small f-t-muted" x={NFX + NFW / 2} y={ny.g3 + 15} text-anchor="middle">{t.fallback[1]}</text>
    </g>
    <g data-s="5">
      <path class="f-line f-amber f-dash" d={`M ${NX + NBW + 2} ${ny.training + NBH / 2} H ${NG5X} V ${ny.model + NBH / 2} H ${NX + NBW + 3}`} marker-end="url(#f-arrow-amber)" />
      <path d={diamond(NG5X, nG5y)} style={`fill: ${amber}; fill-opacity: 0.25; stroke: ${amber}; stroke-width: 1.5`} />
      <Badge x={NG5X} y={nG5y} n={5} />
      <text class="f-small f-halo" x={NG5X - D - 6} y={nG5y + 5} text-anchor="end">{t.gatesN[4]}</text>
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
