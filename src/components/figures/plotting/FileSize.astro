---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// File size in bytes of a scatter plot of n normal points (figsize 4 x 3 inches, 100 dpi, marker size 4), saved with savefig.
// Measured once on Matplotlib 3.11.2, NumPy 2.5.4, CPython 3.14.7, macOS (arm64), and embedded here.
const ns = [10, 100, 1_000, 10_000, 100_000];
const series = [
  { key: 'SVG', tone: 'red', bytes: [12623, 19903, 115941, 1070755, 10645865] },
  { key: 'PDF', tone: 'amber', bytes: [5942, 7320, 21894, 157638, 1512635] },
  { key: 'PNG', tone: 'blue', bytes: [7754, 6641, 19638, 20133, 17680] },
] as const;
// The claims of the note: about 106 bytes per point for SVG and 15 for PDF; PNG under about 20 KB at every n.
const perPoint = (b: readonly number[]) => (b[4] - b[3]) / (ns[4] - ns[3]);
if (Math.round(perPoint(series[0].bytes)) !== 106 || Math.round(perPoint(series[1].bytes)) !== 15) throw new Error('bytes per point');
if (Math.max(...series[2].bytes) > 20_500) throw new Error('PNG stays near 20 KB');
if ((series[0].bytes[4] / 1e6).toFixed(1) !== '10.6') throw new Error('SVG at 100 000 points: 10.6 MB');

const t = ru
  ? { x: 'число точек n', y: 'байты', labels: { SVG: 'SVG: ~106 байт на точку', PDF: 'PDF: ~15 байт на точку', PNG: 'PNG: 400 × 300 пикселей' } }
  : { x: 'number of points n', y: 'bytes', labels: { SVG: 'SVG: ~106 bytes per point', PDF: 'PDF: ~15 bytes per point', PNG: 'PNG: 400 × 300 pixels' } };
interface Layout { cls: string; W: number; H: number; x0: number; x1: number; y0: number; y1: number; legend: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 290, x0: 80, x1: 540, y0: 240, y1: 30, legend: false },
  { cls: 'fig-narrow', W: 360, H: 330, x0: 56, x1: 340, y0: 220, y1: 30, legend: true },
];
const yticks = [1e3, 1e4, 1e5, 1e6, 1e7];
const ylab = ru ? ['1 КБ', '10 КБ', '100 КБ', '1 МБ', '10 МБ'] : ['1 KB', '10 KB', '100 KB', '1 MB', '10 MB'];
const sans = 6.5;
const id = 'file-size';
const sup = ['', '', '²', '³', '⁴', '⁵'];
const plots = layouts.map((L) => {
  const sx = scale([1, 5], [L.x0, L.x1]);
  const sy = scale([3, Math.log10(2e7)], [L.y0, L.y1]);
  const ends = series.map((s) => sy(Math.log10(s.bytes[4])));
  for (const s of series) {
    const w = t.labels[s.key].length * sans;
    if (!L.legend && L.x1 + 10 + w > L.W - 4) throw new Error(`label ${s.key} overflows`);
    if (L.legend && L.x0 + 28 + w > L.W - 4) throw new Error(`legend ${s.key} overflows`);
  }
  if (!L.legend) for (let k = 0; k + 1 < ends.length; k += 1) if (ends[k + 1] - ends[k] < 15) throw new Error('end labels collide');
  if (L.legend && L.y0 + 48 + series.length * 18 > L.H - 4) throw new Error('legend does not fit');
  return { sx, sy, ends, paths: series.map((s) => polyline(s.bytes.map((b, j) => [sx(Math.log10(ns[j])), sy(Math.log10(b))]))) };
});
---

<Figure
  id={id}
  title={ru ? 'Размер файла: растр против вектора' : 'File size: raster against vector'}
  caption={ru
    ? 'Размер файла с диаграммой рассеяния из n точек, сохранённой в трёх форматах, обе оси логарифмические. Рисунок 4 × 3 дюйма при 100 dpi; измерено один раз в Matplotlib 3.11.2 на macOS. PNG хранит 400 × 300 пикселей, и его размер при любом n не превышает примерно 20 КБ. SVG и PDF хранят каждую точку как фигуру и растут линейно: примерно на 106 и 15 байт на точку.'
    : 'The size of a file holding a scatter plot of n points, saved in three formats, both axes logarithmic. The figure is 4 × 3 inches at 100 dpi; measured once with Matplotlib 3.11.2 on macOS. A PNG stores 400 × 300 pixels and stays under about 20 KB at every n. SVG and PDF store every point as a shape and grow linearly, by about 106 and 15 bytes per point.'}
>
  {layouts.map((L, li) => {
    const { sx, sy, ends, paths } = plots[li];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Размер файла PNG, SVG и PDF в зависимости от числа точек' : 'PNG, SVG and PDF file size against the number of points'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Линия PNG не поднимается выше примерно 20 КБ. Линии SVG и PDF растут от нескольких килобайт при 10 точках до 10.6 МБ и 1.5 МБ при 100 000 точек.'
          : 'The PNG line stays below about 20 KB. The SVG and PDF lines rise from a few kilobytes at 10 points to 10.6 MB and 1.5 MB at 100 000 points.'}</desc>
        {yticks.map((v, k) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(Math.log10(v))} H ${L.x1}`} />
            <text class="f-small f-t-muted" x={L.x0 - 8} y={sy(Math.log10(v)) + 4} text-anchor="end">{ylab[k]}</text>
          </g>
        ))}
        {[1, 2, 3, 4, 5].map((k) => <text class="f-small f-t-muted" x={sx(k)} y={L.y0 + 18} text-anchor="middle">{k === 1 ? '10' : `10${sup[k]}`}</text>)}
        <path class="f-axis" d={`M ${L.x0} ${L.y1 - 6} V ${L.y0} H ${L.x1 + 6}`} />
        {series.map((s, k) => (
          <g>
            <path class={`f-line f-${s.tone}`} d={paths[k]} />
            {s.bytes.map((b, j) => <circle cx={sx(Math.log10(ns[j]))} cy={sy(Math.log10(b))} r="3.2" style={`fill: var(--fig-${s.tone})`} />)}
            {!L.legend && <text class={`f-small f-t-${s.tone}`} x={L.x1 + 10} y={ends[k] + 4}>{t.labels[s.key]}</text>}
            {L.legend && (
              <g>
                <path class={`f-line f-${s.tone}`} d={`M ${L.x0} ${L.y0 + 44 + k * 18} h 20`} />
                <text class={`f-small f-t-${s.tone}`} x={L.x0 + 28} y={L.y0 + 48 + k * 18}>{t.labels[s.key]}</text>
              </g>
            )}
          </g>
        ))}
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.legend ? L.y0 + 34 : L.H - 6} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.x0 - 8} y={L.y1 - 12}>{t.y}</text>
      </svg>
    );
  })}
</Figure>
