---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The artist tree of a figure made with fig, ax = plt.subplots(); ax.plot(...); ax.scatter(...); ax.set_title(...); ax.legend()
// (Matplotlib 3.11.2): fig.axes == [ax], ax.lines holds the Line2D, ax.collections the PathCollection, ax.title is a Text.
const children = [
  { name: 'XAxis', reach: 'ax.xaxis', tone: 'muted' },
  { name: 'YAxis', reach: 'ax.yaxis', tone: 'muted' },
  { name: 'Line2D', reach: 'ax.lines[0]', tone: 'green' },
  { name: 'PathCollection', reach: 'ax.collections[0]', tone: 'green' },
  { name: 'Text', reach: 'ax.title', tone: 'red' },
  { name: 'Legend', reach: 'ax.get_legend()', tone: 'red' },
];
const t = ru
  ? { fig: 'Figure', axes: 'Axes', title: 'squares', legend: 'data', backend: 'бэкенд рисует дерево: Agg → PNG; svg, pdf → векторный файл', figNote: 'холст', axesNote: 'область графика' }
  : { fig: 'Figure', axes: 'Axes', title: 'squares', legend: 'data', backend: 'a backend renders the tree: Agg → PNG; svg, pdf → vector files', figNote: 'the canvas', axesNote: 'a plotting area' };

interface Layout { cls: string; W: number; H: number; F: [number, number, number, number]; A: [number, number, number, number];
  treeX: number; treeY: number; kidY0: number; kidDy: number; reachX: number; backendY: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 330, F: [20, 20, 330, 270], A: [74, 62, 250, 170], treeX: 390, treeY: 24, kidY0: 136, kidDy: 28, reachX: 616, backendY: 318 },
  { cls: 'fig-narrow', W: 360, H: 560, F: [16, 16, 328, 230], A: [64, 54, 252, 136], treeX: 16, treeY: 268, kidY0: 380, kidDy: 26, reachX: 214, backendY: 548 },
];
const sans = 6.5, mono = 7.5;
for (const L of layouts) {
  const kidX = L.treeX + 80;
  for (const c of children) {
    if (kidX + c.name.length * mono > L.reachX - 10) throw new Error(`${c.name} runs into its accessor at ${L.W}`);
    if (L.reachX + c.reach.length * mono > L.W - 4) throw new Error(`${c.reach} overflows at ${L.W}`);
  }
  if (L.kidY0 + (children.length - 1) * L.kidDy + 12 > L.backendY - 14) throw new Error('tree runs into the backend note');
  // the backend note may wrap into two lines in the narrow layout
  const lines = L.W === 760 ? [t.backend] : t.backend.split(': ');
  for (const s of lines) if (8 + s.length * sans > L.W - 4) throw new Error(`"${s}" overflows at ${L.W}`);
  if (L.F[0] + L.F[2] > (L.W === 760 ? L.treeX - 20 : L.W - 4)) throw new Error('mock figure runs into the tree');
  if (L.W !== 760 && L.F[1] + L.F[3] + 16 > L.treeY) throw new Error('mock figure runs into the tree (narrow)');
}
const id = 'figure-tree';
const tone = { fig: 'var(--fig-amber)', axes: 'var(--fig-blue)' };
---

<Figure
  id={id}
  title={ru ? 'Рисунок Matplotlib — это дерево художников (artists)' : 'A Matplotlib figure is a tree of artists'}
  caption={ru
    ? 'Слева — нарисованный рисунок, справа — дерево объектов, из которых он состоит. Figure (янтарный) — весь холст; в нём Axes (синий) — область со своими координатами. Внутри Axes — художники данных (зелёный: линия Line2D из ax.plot и точки PathCollection из ax.scatter), две оси XAxis и YAxis с делениями и подписями, заголовок Text и легенда (красный). Справа от каждого узла — как до него добраться из кода. Бэкенд обходит дерево и отрисовывает каждый объект в пиксели или в векторные фигуры.'
    : 'Left: the drawn figure; right: the tree of objects it is made of. The Figure (amber) is the whole canvas; it holds an Axes (blue), a plotting area with its own coordinates. Inside the Axes are the data artists (green: the Line2D from ax.plot and the PathCollection of points from ax.scatter), the two rulers XAxis and YAxis with their ticks and labels, the title Text and the Legend (red). Next to each node is how to reach it from code. A backend walks the tree and renders each object to pixels or to vector shapes.'}
>
  {layouts.map((L) => {
    const [fx, fy, fw, fh] = L.F, [ax, ay, aw, ah] = L.A;
    const sx = scale([0, 2], [ax + 14, ax + aw - 14]), sy = scale([0, 4], [ay + ah - 12, ay + 14]);
    const curve = polyline(Array.from({ length: 41 }, (_, k) => { const x = k / 20; return [sx(x), sy(x * x)] as [number, number]; }));
    const pts: [number, number][] = [[0.3, 0.4], [0.7, 0.3], [1.1, 1.6], [1.4, 1.7], [1.7, 3.2]];
    const kidX = L.treeX + 80;
    const axesNode = [L.treeX + 40, L.treeY + 56] as const;
    const backendLines = L.W === 760 ? [t.backend] : [t.backend.split(': ')[0] + ':', t.backend.split(': ')[1]];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Части рисунка и дерево объектов Figure, Axes и художников' : 'The parts of a figure and the tree of Figure, Axes and artists'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Нарисованный рисунок: холст, внутри область графика с заголовком squares, кривой, пятью точками, легендой и делениями на осях. Дерево: Figure, под ним Axes, под Axes шесть узлов: XAxis, YAxis, Line2D, PathCollection, Text, Legend.'
          : 'A drawn figure: a canvas, inside it a plotting area with the title squares, a curve, five points, a legend and ticks on both axes. The tree: Figure, below it Axes, below the Axes six nodes: XAxis, YAxis, Line2D, PathCollection, Text, Legend.'}</desc>
        <rect x={fx} y={fy} width={fw} height={fh} rx="6" style={`fill: ${tone.fig}; fill-opacity: 0.06; stroke: ${tone.fig}; stroke-width: 1.4`} />
        <text class="f-small f-t-amber" x={fx + 8} y={fy + 16}>{`Figure · ${t.figNote}`}</text>
        <rect x={ax} y={ay} width={aw} height={ah} style={`fill: var(--paper); stroke: ${tone.axes}; stroke-width: 1.4`} />
        <text class="f-small f-t-blue" x={ax + aw - 6} y={ay + ah - 6} text-anchor="end">{`Axes · ${t.axesNote}`}</text>
        <text class="f-small f-t-red" x={ax + aw / 2} y={ay - 8} text-anchor="middle" style="font-weight: 650">{t.title}</text>
        <path class="f-line f-green" d={curve} />
        {pts.map(([x, y]) => <circle cx={sx(x)} cy={sy(y)} r="3.4" class="f-solid-green" />)}
        {[0, 1, 2].map((v) => (
          <g>
            <path class="f-axis" d={`M ${sx(v)} ${ay + ah} v 5`} />
            <text class="f-small f-t-muted" x={sx(v)} y={ay + ah + 18} text-anchor="middle">{v}</text>
          </g>
        ))}
        {[0, 2, 4].map((v) => (
          <g>
            <path class="f-axis" d={`M ${ax} ${sy(v)} h -5`} />
            <text class="f-small f-t-muted" x={ax - 9} y={sy(v) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        <text class="f-small f-t-muted" x={ax + aw / 2} y={ay + ah + 34} text-anchor="middle">x</text>
        <text class="f-small f-t-muted" x={ax - 26} y={ay + ah / 2 + 4} text-anchor="middle">y</text>
        <rect x={ax + 10} y={ay + 10} width={70} height={24} rx="3" style="fill: var(--paper); stroke: var(--fig-red); stroke-width: 1.1" />
        <path class="f-line f-green" d={`M ${ax + 16} ${ay + 22} h 18`} />
        <text class="f-small" x={ax + 40} y={ay + 26}>{t.legend}</text>

        <rect x={L.treeX} y={L.treeY} width={110} height={30} rx="6" style={`fill: ${tone.fig}; fill-opacity: 0.16; stroke: ${tone.fig}; stroke-width: 1.3`} />
        <text class="f-small" x={L.treeX + 55} y={L.treeY + 19.5} text-anchor="middle" style="font-family: var(--mono)">Figure</text>
        <text class="f-small f-t-muted" x={L.treeX + 124} y={L.treeY + 19.5} style="font-family: var(--mono)">fig</text>
        <path class="f-thin f-muted" d={`M ${L.treeX + 20} ${L.treeY + 30} V ${axesNode[1] + 15} H ${axesNode[0]}`} />
        <rect x={axesNode[0]} y={axesNode[1]} width={100} height={30} rx="6" style={`fill: ${tone.axes}; fill-opacity: 0.16; stroke: ${tone.axes}; stroke-width: 1.3`} />
        <text class="f-small" x={axesNode[0] + 50} y={axesNode[1] + 19.5} text-anchor="middle" style="font-family: var(--mono)">Axes</text>
        <text class="f-small f-t-muted" x={axesNode[0] + 114} y={axesNode[1] + 19.5} style="font-family: var(--mono)">fig.axes[0], ax</text>
        <path class="f-thin f-muted" d={`M ${axesNode[0] + 20} ${axesNode[1] + 30} V ${L.kidY0 + (children.length - 1) * L.kidDy - 4}`} />
        {children.map((c, k) => {
          const y = L.kidY0 + k * L.kidDy;
          return (
            <g>
              <path class="f-thin f-muted" d={`M ${axesNode[0] + 20} ${y - 4} H ${kidX - 6}`} />
              <text class={`f-small f-t-${c.tone}`} x={kidX} y={y} style="font-family: var(--mono); font-weight: 600">{c.name}</text>
              <text class="f-small f-t-muted" x={L.reachX} y={y} style="font-family: var(--mono)">{c.reach}</text>
            </g>
          );
        })}
        {backendLines.map((s, k) => <text class="f-small f-t-muted" x={8} y={L.backendY - (backendLines.length - 1 - k) * 17}>{s}</text>)}
      </svg>
    );
  })}
</Figure>
