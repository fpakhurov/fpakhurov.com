---
import Figure from '../Figure.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The word 0x12345678 stored at address 0x100 in both byte orders.
const word = 0x12345678, base = 0x100;
const msbFirst = [24, 16, 8, 0].map((s) => (word >>> s) & 0xff);            // register order, most significant first
const big = msbFirst;                                                         // big-endian: MSB at the lowest address
const little = [...msbFirst].reverse();                                       // little-endian: LSB at the lowest address
const hx = (b: number) => b.toString(16).padStart(2, '0');
if (big.map(hx).join(' ') !== '12 34 56 78' || little.map(hx).join(' ') !== '78 56 34 12') throw new Error('ByteOrder: bytes drifted');
const tone = (b: number) => (b === msbFirst[0] ? 'blue' : b === msbFirst[3] ? 'red' : 'none');
const fill: Record<string, string> = {
  blue: 'fill: var(--fig-blue); fill-opacity: 0.16; stroke: var(--fig-blue); stroke-width: 1.4',
  red: 'fill: var(--fig-red); fill-opacity: 0.16; stroke: var(--fig-red); stroke-width: 1.4',
  none: 'fill: var(--paper-strong); stroke: var(--line); stroke-width: 1.2',
};
const addrs = [0, 1, 2, 3].map((i) => '0x' + (base + i).toString(16));

const t = ru
  ? { reg: 'слово 0x12345678 в регистре', msb: 'старший байт', lsb: 'младший байт', msbS: 'старший', lsbS: 'младший', big: 'big-endian: старший байт первым', little: 'little-endian: RISC-V, x86, ARM',
      load: (b: number) => `lbu из 0x100 → 0x${hx(b)}`,
      steps: ['слово в регистре: старший байт 0x12, младший 0x78', 'big-endian: старший байт по младшему адресу', 'little-endian: младший байт по младшему адресу', 'загрузка одного байта по адресу слова даёт разные байты'] }
  : { reg: 'the word 0x12345678 in a register', msb: 'most significant byte', lsb: 'least significant byte', msbS: 'MSB', lsbS: 'LSB', big: 'big-endian: MSB first', little: 'little-endian: RISC-V, x86, ARM',
      load: (b: number) => `lbu from 0x100 → 0x${hx(b)}`,
      steps: ['the word in a register: most significant byte 0x12, least significant 0x78', 'big-endian: the most significant byte at the lowest address', 'little-endian: the least significant byte at the lowest address', 'loading one byte from the address of the word gives different bytes'] };

interface Row { x: number; y: number; bytes: number[]; title: string; s: string }
interface Layout { cls: string; W: number; H: number; cw: number; ch: number; reg: [number, number]; regTitle: number; rows: Row[]; arrows: boolean; badges: [number, number][] }
const layouts: Layout[] = [
  {
    cls: 'fig-wide', W: 760, H: 248, cw: 60, ch: 34, reg: [260, 52], regTitle: 18, arrows: true,
    rows: [{ x: 40, y: 150, bytes: big, title: t.big, s: '2' }, { x: 464, y: 150, bytes: little, title: t.little, s: '3' }],
    badges: [[252, 13], [26, 203], [450, 203], [26, 229]],
  },
  {
    cls: 'fig-narrow seq-narrow', W: 360, H: 420, cw: 60, ch: 34, reg: [60, 64], regTitle: 20, arrows: false,
    rows: [{ x: 52, y: 176, bytes: big, title: t.big, s: '2' }, { x: 52, y: 320, bytes: little, title: t.little, s: '3' }],
    badges: [[38, 81], [26, 127], [26, 271], [26, 231]],
  },
];
const mono = 'font-family: var(--mono)';
const id = 'byte-order';
---

<Figure
  id={id}
  title={ru ? 'Порядок байтов: слово 0x12345678 по адресу 0x100' : 'Byte order: the word 0x12345678 at address 0x100'}
  caption={ru
    ? 'Сверху — слово в регистре; синим выделен старший байт 0x12, красным — младший 0x78. При порядке big-endian по младшему адресу хранится старший байт, и байты лежат в памяти в том порядке, в каком мы записываем число (2). При порядке little-endian, принятом в RISC-V, x86 и ARM, по младшему адресу хранится младший байт (3). Поэтому загрузка одного байта по адресу слова 0x100 даёт 0x12 в одном случае и 0x78 в другом (4).'
    : 'Top: the word in a register, with the most significant byte 0x12 in blue and the least significant byte 0x78 in red. Big-endian stores the most significant byte at the lowest address, so memory holds the bytes in the order we write the number (2). Little-endian, used by RISC-V, x86 and ARM, stores the least significant byte at the lowest address (3). Loading one byte from the address of the word, 0x100, therefore gives 0x12 in one case and 0x78 in the other (4).'}
>
  {layouts.map((L) => {
    const [rx, ry] = L.reg;
    const regCx = (i: number) => rx + i * L.cw + L.cw / 2;
    const rowCx = (r: Row, i: number) => r.x + i * L.cw + L.cw / 2;
    const at = (r: Row, b: number) => r.bytes.indexOf(b);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Байты слова в памяти при двух порядках' : 'The bytes of a word in memory in the two byte orders'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Регистр с байтами 12 34 56 78. Ниже две строки памяти по адресам от 0x100 до 0x103: big-endian хранит 12 34 56 78, little-endian хранит 78 56 34 12. Под строками: загрузка байта по адресу 0x100 даёт 0x12 и 0x78 соответственно.'
          : 'A register holding the bytes 12 34 56 78. Below, two rows of memory at addresses 0x100 to 0x103: big-endian holds 12 34 56 78, little-endian holds 78 56 34 12. Under the rows, loading the byte at 0x100 gives 0x12 and 0x78 respectively.'}</desc>

        {L.arrows && (
          <g>
            {L.rows.map((r) => (
              <g data-s={r.s}>
                <Arrow pts={[[regCx(0), ry + L.ch + 2], [rowCx(r, at(r, msbFirst[0])), r.y - 26]]} tone="blue" />
                <Arrow pts={[[regCx(3), ry + L.ch + 2], [rowCx(r, at(r, msbFirst[3])), r.y - 26]]} tone="red" />
              </g>
            ))}
          </g>
        )}

        <g data-s="1">
          <text class="f-small f-t-muted" x={rx + 2 * L.cw} y={L.regTitle} text-anchor="middle">{t.reg}</text>
          {L.arrows
            ? <text class="f-small f-t-blue" x={rx - 10} y={ry + 22} text-anchor="end">{t.msb}</text>
            : <text class="f-small f-t-blue" x={rx} y={ry - 8}>{t.msbS}</text>}
          {L.arrows
            ? <text class="f-small f-t-red" x={rx + 4 * L.cw + 10} y={ry + 22}>{t.lsb}</text>
            : <text class="f-small f-t-red" x={rx + 4 * L.cw} y={ry - 8} text-anchor="end">{t.lsbS}</text>}
          {msbFirst.map((b, i) => (
            <g>
              <rect x={rx + i * L.cw} y={ry} width={L.cw} height={L.ch} style={fill[tone(b)]} />
              <text class="f-label" x={regCx(i)} y={ry + 23} text-anchor="middle" style={mono}>{hx(b)}</text>
            </g>
          ))}
          <Badge x={L.badges[0][0]} y={L.badges[0][1]} n={1} />
        </g>

        {L.rows.map((r, k) => (
          <g data-s={r.s}>
            <text class="f-small" x={r.x} y={L.arrows ? r.y + L.ch + 24 : r.y - 44}>{r.title}</text>
            {r.bytes.map((b, i) => (
              <g>
                <text class="f-small f-t-muted" x={rowCx(r, i)} y={r.y - 8} text-anchor="middle" style={mono}>{addrs[i]}</text>
                <rect x={r.x + i * L.cw} y={r.y} width={L.cw} height={L.ch} style={fill[tone(b)]} />
                <text class="f-label" x={rowCx(r, i)} y={r.y + 23} text-anchor="middle" style={mono}>{hx(b)}</text>
              </g>
            ))}
            <Badge x={L.badges[k + 1][0]} y={L.badges[k + 1][1]} n={k + 2} />
          </g>
        ))}

        <g data-s="4">
          {L.rows.map((r) => (
            <text class="f-small" x={r.x} y={r.y + L.ch + (L.arrows ? 50 : 26)} style={mono}>{t.load(r.bytes[0])}</text>
          ))}
          <Badge x={L.badges[3][0]} y={L.badges[3][1]} n={4} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
