---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The 16 patterns of 4 bits on a circle, 0000 at the top, +1 clockwise. Inside: the unsigned value U; outside:
// the two's complement value T = U − 16·(top bit). The two seams are where each reading jumps.
const w = 4, n = 1 << w;
const cells = Array.from({ length: n }, (_, u) => {
  const bits = u.toString(2).padStart(w, '0');
  const s = u >= n / 2 ? u - n : u;
  return { u, bits, s, label: s >= 0 ? String(s) : `−${-s}` };
});
const check = [cells[0b1101].s, cells[0b1101].u, cells[0b1000].s, cells[0b0111].s, cells[0b1111].s];
if (check.join(' ') !== '-3 13 -8 7 -1') throw new Error(`NumberWheel: values drifted: ${check}`);
// the worked example: 0111 + 0001 and 1101 + 0011, taken modulo 16
if ((0b0111 + 0b0001) % n !== 0b1000 || (0b1101 + 0b0011) % n !== 0) throw new Error('NumberWheel: sums drifted');

const t = ru
  ? { inside: 'внутри: без знака', outside: 'снаружи: дополнительный код', uwrap: ['без знака:', '15 + 1 → 0'], swrap: ['со знаком:', '7 + 1 → −8'], plus: '+1: шаг по часовой стрелке' }
  : { inside: 'inside: unsigned', outside: "outside: two's complement", uwrap: ['unsigned wraps:', '15 + 1 → 0'], swrap: ['signed overflow:', '7 + 1 → −8'], plus: '+1: one step clockwise' };

interface Layout { cls: string; W: number; H: number; cx: number; cy: number; rb: number; ru: number; rs: number; legend: [number, number]; uw: [number, number, 'start' | 'end']; sw: [number, number, 'start' | 'end']; lstep: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 400, cx: 380, cy: 200, rb: 128, ru: 92, rs: 166, legend: [16, 30], uw: [470, 26, 'start'], sw: [470, 384, 'start'], lstep: 22 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 470, cx: 180, cy: 250, rb: 108, ru: 74, rs: 146, legend: [12, 24], uw: [348, 72, 'end'], sw: [348, 440, 'end'], lstep: 22 },
];
const pt = (L: Layout, r: number, k: number): [number, number] => {
  const a = (2 * Math.PI * k) / n - Math.PI / 2;
  return [L.cx + r * Math.cos(a), L.cy + r * Math.sin(a)];
};
const f = (v: number) => v.toFixed(1);
const mono = 'font-family: var(--mono)';
const id = 'number-wheel';
---

<Figure
  id={id}
  title={ru ? 'Шестнадцать 4-битных кодов на круге: два прочтения' : 'The sixteen 4-bit patterns on a circle, read two ways'}
  caption={ru
    ? 'Коды 0000–1111 по кругу; прибавление единицы сдвигает на шаг по часовой стрелке, и 4-битный сумматор считает по модулю 16. Синие числа внутри — значения без знака, красные снаружи — значения в дополнительном коде (старший бит весит −8). Каждое прочтение разрывается в одном месте: без знака — между 1111 и 0000 (15 + 1 даёт 0), со знаком — между 0111 и 1000 (7 + 1 даёт −8). Вне разрывов оба прочтения растут на единицу за шаг, поэтому один сумматор годится для обоих.'
    : "The patterns 0000 to 1111 around a circle; adding one moves one step clockwise, and a 4-bit adder counts modulo 16. Blue numbers inside are the unsigned values, red numbers outside the two's complement values (the top bit weighs −8). Each reading has one seam: unsigned between 1111 and 0000 (15 + 1 gives 0), signed between 0111 and 1000 (7 + 1 gives −8). Away from its seam each reading goes up by one per step, so one adder serves both."}
>
  {layouts.map((L) => {
    const seamU = [pt(L, L.ru - 24, -0.5), pt(L, L.ru + 8, -0.5)];
    const seamS = [pt(L, L.rb + 22, 7.5), pt(L, L.rs + 20, 7.5)];
    const arc0 = pt(L, L.rb + 22, 1.25), arc1 = pt(L, L.rb + 22, 2.25);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Круг 4-битных чисел без знака и со знаком' : 'A circle of 4-bit unsigned and signed values'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Шестнадцать кодов по кругу, 0000 сверху. Внутри числа от 0 до 15, снаружи от 0 до 7 и затем от −8 до −1. Синяя черта между 1111 и 0000 отмечает разрыв прочтения без знака, красная между 0111 и 1000 — разрыв прочтения со знаком.'
          : 'Sixteen bit patterns around a circle, 0000 at the top. Inside, the numbers 0 to 15; outside, 0 to 7 and then −8 to −1. A blue bar between 1111 and 0000 marks the unsigned seam, a red bar between 0111 and 1000 the signed seam.'}</desc>
        <circle cx={L.cx} cy={L.cy} r={L.rb} class="f-grid" />
        {cells.map((c, k) => {
          const [bx, by] = pt(L, L.rb, k), [ux, uy] = pt(L, L.ru, k), [sx, sy] = pt(L, L.rs, k);
          return (
            <g>
              <circle cx={f(bx)} cy={f(by)} r="3" class="f-solid-muted" />
              <text class="f-small f-halo" x={f(bx)} y={f(by + 16)} text-anchor="middle" style={mono}>{c.bits}</text>
              <text class="f-small f-t-blue" x={f(ux)} y={f(uy + 5)} text-anchor="middle">{c.u}</text>
              <text class="f-small f-t-red" x={f(sx)} y={f(sy + 5)} text-anchor="middle">{c.label}</text>
            </g>
          );
        })}
        <path class="f-line f-blue f-bold" d={`M ${f(seamU[0][0])} ${f(seamU[0][1])} L ${f(seamU[1][0])} ${f(seamU[1][1])}`} />
        <path class="f-line f-red f-bold" d={`M ${f(seamS[0][0])} ${f(seamS[0][1])} L ${f(seamS[1][0])} ${f(seamS[1][1])}`} />
        <path class="f-line f-muted" d={`M ${f(arc0[0])} ${f(arc0[1])} A ${L.rb + 22} ${L.rb + 22} 0 0 1 ${f(arc1[0])} ${f(arc1[1])}`} marker-end="url(#f-arrow-muted)" />
        <text class="f-small f-t-muted" x={L.legend[0]} y={L.legend[1] + 2 * L.lstep}>{t.plus}</text>
        <text class="f-small f-t-blue" x={L.uw[0]} y={L.uw[1]} text-anchor={L.uw[2]}>{t.uwrap[0]}</text>
        <text class="f-small f-t-blue" x={L.uw[0]} y={L.uw[1] + 18} text-anchor={L.uw[2]}>{t.uwrap[1]}</text>
        <text class="f-small f-t-red" x={L.sw[0]} y={L.sw[1] - 18} text-anchor={L.sw[2]}>{t.swrap[0]}</text>
        <text class="f-small f-t-red" x={L.sw[0]} y={L.sw[1]} text-anchor={L.sw[2]}>{t.swrap[1]}</text>
        <text class="f-small f-t-blue" x={L.legend[0]} y={L.legend[1]}>{t.inside}</text>
        <text class="f-small f-t-red" x={L.legend[0]} y={L.legend[1] + L.lstep}>{t.outside}</text>
      </svg>
    );
  })}
</Figure>
