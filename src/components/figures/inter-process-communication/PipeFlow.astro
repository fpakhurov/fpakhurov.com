---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// parent | tr a-z A-Z, as in the Code section: the file tables of the two processes and the pipe buffer in the kernel.
// Later steps draw over earlier cells (a closed descriptor, the redirected standard input).
const msg = 'bytes through a pipe\n';
const out = msg.toUpperCase().trim();
if (msg.length !== 21 || out !== 'BYTES THROUGH A PIPE') throw new Error('PipeFlow: message drifted');
const t = ru
  ? {
      title: 'Канал между родителем и потомком, выполняющим tr',
      parent: 'родитель', child: 'потомок (копия родителя)', childTr: 'потомок: tr a-z A-Z', kernel: 'ядро', buffer: 'буфер канала',
      term: 'терминал', rd: 'канал: чтение', wr: 'канал: запись', closed: 'закрыт', write: 'write', read: 'read',
      stdout: `stdout: ${out}`, eof: 'read() → 0: конец файла',
      steps: ['pipe(): ядро создаёт буфер, родитель получает дескрипторы 3 (чтение) и 4 (запись)', 'fork(): таблица файлов копируется, у потомка тоже оба конца', 'каждый закрывает ненужный ему конец; потомок делает dup2(3, 0) и exec tr', 'родитель пишет 21 байт в дескриптор 4, tr читает их из дескриптора 0 и печатает', 'родитель закрывает конец для записи: следующий read в tr возвращает 0, и tr завершается'],
      desc: 'Слева таблица дескрипторов родителя, справа потомка, посередине буфер канала в ядре. После pipe у родителя дескриптор 3 — конец для чтения, 4 — для записи. После fork у потомка та же таблица. Затем родитель закрывает 3, потомок закрывает 3 и 4, а его дескриптор 0 указывает на конец для чтения, и он выполняет tr. Родитель пишет в 4, байты проходят через буфер в дескриптор 0 потомка, tr печатает их заглавными. Когда родитель закрывает 4, read в tr возвращает 0.',
    }
  : {
      title: 'A pipe between a parent and a child that runs tr',
      parent: 'parent', child: 'child (copy of the parent)', childTr: 'child: tr a-z A-Z', kernel: 'kernel', buffer: 'pipe buffer',
      term: 'terminal', rd: 'pipe: read end', wr: 'pipe: write end', closed: 'closed', write: 'write', read: 'read',
      stdout: `stdout: ${out}`, eof: 'read() → 0: end of file',
      steps: ['pipe(): the kernel creates a buffer; the parent gets descriptors 3 (read) and 4 (write)', 'fork(): the file table is copied, so the child holds both ends too', 'each closes the end it does not use; the child does dup2(3, 0) and execs tr', 'the parent writes 21 bytes to descriptor 4; tr reads them from descriptor 0 and prints them', 'the parent closes the write end: the next read in tr returns 0 and tr exits'],
      desc: 'On the left the descriptor table of the parent, on the right that of the child, in the middle the pipe buffer in the kernel. After pipe, the parent\'s descriptor 3 is the read end and 4 the write end. After fork the child has the same table. Then the parent closes 3, the child closes 3 and 4, its descriptor 0 now refers to the read end, and it runs tr. The parent writes to 4, the bytes pass through the buffer to the child\'s descriptor 0, and tr prints them in capitals. When the parent closes 4, read in tr returns 0.',
    };
const values = [t.term, t.term, t.term, t.rd, t.wr];

interface Layout {
  cls: string; W: number; H: number;
  P: [number, number, number, number]; C: [number, number, number, number];
  rowY0: number; rowH: number; rowStep: number; numW: number;
  buf: [number, number]; cellW: number; bufLabel: [number, number, 'start' | 'middle' | 'end']; kernel: [number, number, 'start' | 'middle' | 'end'] | null;
  writeArrow: string; readArrow: string; writeAt: [number, number]; readAt: [number, number];
  outAt: [number, number, 'start' | 'middle' | 'end']; eofAt: [number, number, 'start' | 'middle' | 'end'];
  badges: [number, number][];
}
const layouts: Layout[] = [
  {
    cls: 'fig-wide', W: 760, H: 312, P: [20, 50, 230, 200], C: [510, 50, 230, 200],
    rowY0: 90, rowH: 20, rowStep: 28, numW: 26,
    buf: [300, 150], cellW: 20, bufLabel: [380, 138, 'middle'], kernel: [380, 40, 'middle'],
    writeArrow: 'M 238 212 L 297 168', readArrow: 'M 463 158 L 521 104', writeAt: [262, 206], readAt: [452, 124],
    outAt: [625, 274, 'middle'], eofAt: [625, 296, 'middle'],
    badges: [[318, 132], [497, 40], [727, 40], [380, 196], [10, 212]],
  },
  {
    cls: 'fig-narrow seq-narrow', W: 360, H: 604, P: [20, 30, 320, 196], C: [20, 340, 320, 196],
    rowY0: 66, rowH: 22, rowStep: 30, numW: 26,
    buf: [40, 262], cellW: 20, bufLabel: [210, 278, 'start'], kernel: null,
    writeArrow: 'M 120 228 V 259', readArrow: 'M 120 286 V 337', writeAt: [128, 248], readAt: [128, 316],
    outAt: [20, 562, 'start'], eofAt: [20, 586, 'start'],
    badges: [[312, 273], [335, 328], [335, 360], [98, 248], [335, 586]],
  },
];
const id = 'ipc-pipe-flow';
const bufCells = 8;
const shown = msg.slice(0, bufCells).replace(' ', '␣');
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? 'Дескрипторы — номера строк в таблице файлов каждого процесса; канал — буфер в ядре, на который указывают два из них. Красная стрелка — write родителя в дескриптор 4, синяя — read потомка из дескриптора 0. Если не закрыть ненужные концы, потомок никогда не увидит конца файла: у него самого останется открытый конец для записи. На машине из раздела «Код» в буфер поместилось 65 536 байт.'
    : "Descriptors are row numbers in each process's file table; the pipe is a buffer in the kernel that two of them refer to. The red arrow is the parent's write to descriptor 4, the blue one the child's read from descriptor 0. Without closing the unused ends the child would never see end of file, because it would still hold a write end itself. The buffer held 65,536 bytes on the machine of the Code section."}
>
  {layouts.map((L) => {
    const cellsOf = (B: [number, number, number, number]) => ({ nx: B[0] + 14, vx: B[0] + 14 + L.numW + 4, vw: B[2] - 28 - L.numW - 4, dy: B[1] - L.P[1] });
    const rowY = (k: number, c: { dy: number }) => L.rowY0 + c.dy + k * L.rowStep;
    const pc = cellsOf(L.P), cc = cellsOf(L.C);
    const over = (c: { vx: number; vw: number; dy: number }, k: number, text: string, tone: string) => ({ x: c.vx, y: rowY(k, c), w: c.vw, text, tone });
    const step3 = [over(pc, 3, t.closed, 'muted'), over(cc, 3, t.closed, 'muted'), over(cc, 4, t.closed, 'muted'), over(cc, 0, t.rd, 'blue')];
    const step5 = [over(pc, 4, t.closed, 'muted')];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        {/* parent: always shown; its rows 3 and 4 appear with step 1 */}
        <rect x={L.P[0]} y={L.P[1]} width={L.P[2]} height={L.P[3]} rx="9" style={`fill: none; stroke: ${toneVar.h}; stroke-width: 1.4`} />
        <text class="f-label" x={L.P[0] + 12} y={L.P[1] + 22}>{t.parent}</text>
        {values.map((v, k) => (
          <g data-s={k === 3 || k === 4 ? '1' : undefined}>
            <rect x={pc.nx} y={rowY(k, pc)} width={L.numW} height={L.rowH} style="fill: var(--paper-strong); stroke: var(--line)" />
            <text class="f-small" x={pc.nx + L.numW / 2} y={rowY(k, pc) + L.rowH / 2 + 4.5} text-anchor="middle">{k}</text>
            <rect x={pc.vx} y={rowY(k, pc)} width={pc.vw} height={L.rowH} style={`fill: var(--paper); stroke: ${k === 3 || k === 4 ? toneVar.g : 'var(--line)'}`} />
            <text class="f-small" x={pc.vx + 8} y={rowY(k, pc) + L.rowH / 2 + 4.5}>{v}</text>
          </g>
        ))}
        {/* 1: the buffer in the kernel */}
        <g data-s="1">
          {L.kernel && <text class="f-small f-t-muted" x={L.kernel[0]} y={L.kernel[1]} text-anchor={L.kernel[2]}>{t.kernel}</text>}
          <text class="f-small" x={L.bufLabel[0]} y={L.bufLabel[1]} text-anchor={L.bufLabel[2]}>{t.buffer}</text>
          {Array.from({ length: bufCells }, (_, i) => (
            <rect x={L.buf[0] + i * L.cellW} y={L.buf[1]} width={L.cellW} height="22" style={`fill: ${toneVar.g}; fill-opacity: 0.12; stroke: ${toneVar.g}; stroke-width: 1`} />
          ))}
          <Badge x={L.badges[0][0]} y={L.badges[0][1]} n={1} />
        </g>
        {/* 2: the child, a copy */}
        <g data-s="2">
          <rect x={L.C[0]} y={L.C[1]} width={L.C[2]} height={L.C[3]} rx="9" style={`fill: none; stroke: ${toneVar.h}; stroke-width: 1.4`} />
          <text class="f-label" x={L.C[0] + 12} y={L.C[1] + 22}>{t.child}</text>
          {values.map((v, k) => (
            <g>
              <rect x={cc.nx} y={rowY(k, cc)} width={L.numW} height={L.rowH} style="fill: var(--paper-strong); stroke: var(--line)" />
              <text class="f-small" x={cc.nx + L.numW / 2} y={rowY(k, cc) + L.rowH / 2 + 4.5} text-anchor="middle">{k}</text>
              <rect x={cc.vx} y={rowY(k, cc)} width={cc.vw} height={L.rowH} style={`fill: var(--paper); stroke: ${k === 3 || k === 4 ? toneVar.g : 'var(--line)'}`} />
              <text class="f-small" x={cc.vx + 8} y={rowY(k, cc) + L.rowH / 2 + 4.5}>{v}</text>
            </g>
          ))}
          <Badge x={L.badges[1][0]} y={L.badges[1][1]} n={2} />
        </g>
        {/* 3: close the unused ends, redirect the child's stdin, exec tr */}
        <g data-s="3">
          {step3.map((o) => (
            <g>
              <rect x={o.x} y={o.y} width={o.w} height={L.rowH} style={`fill: var(--paper); stroke: ${o.tone === 'blue' ? toneVar.h : 'var(--line)'}; stroke-width: ${o.tone === 'blue' ? 2 : 1}`} />
              <text class={`f-small ${o.tone === 'blue' ? 'f-t-blue' : 'f-t-muted'}`} x={o.x + 8} y={o.y + L.rowH / 2 + 4.5}>{o.text}</text>
            </g>
          ))}
          <rect x={L.C[0] + 6} y={L.C[1] + 5} width={L.C[2] - 12} height="24" style="fill: var(--paper)" />
          <text class="f-label" x={L.C[0] + 12} y={L.C[1] + 22} style="font-family: var(--mono)">{t.childTr}</text>
          <Badge x={L.badges[2][0]} y={L.badges[2][1]} n={3} />
        </g>
        {/* 4: write, read, print */}
        <g data-s="4">
          <path class="f-line f-red" d={L.writeArrow} marker-end="url(#f-arrow-red)" />
          <path class="f-line f-blue" d={L.readArrow} marker-end="url(#f-arrow-blue)" />
          <text class="f-small f-t-red f-halo" x={L.writeAt[0]} y={L.writeAt[1]} style="font-family: var(--mono)">{t.write}</text>
          <text class="f-small f-t-blue f-halo" x={L.readAt[0]} y={L.readAt[1]} style="font-family: var(--mono)">{t.read}</text>
          {Array.from(shown).map((ch, i) => (
            <text class="f-small" x={L.buf[0] + i * L.cellW + L.cellW / 2} y={L.buf[1] + 15.5} text-anchor="middle" style="font-family: var(--mono)">{ch}</text>
          ))}
          <text class="f-small" x={L.outAt[0]} y={L.outAt[1]} text-anchor={L.outAt[2]} style="font-family: var(--mono)">{t.stdout}</text>
          <Badge x={L.badges[3][0]} y={L.badges[3][1]} n={4} />
        </g>
        {/* 5: the last write end closes */}
        <g data-s="5">
          {step5.map((o) => (
            <g>
              <rect x={o.x} y={o.y} width={o.w} height={L.rowH} style="fill: var(--paper); stroke: var(--line)" />
              <text class="f-small f-t-muted" x={o.x + 8} y={o.y + L.rowH / 2 + 4.5}>{o.text}</text>
            </g>
          ))}
          <text class="f-small f-t-blue" x={L.eofAt[0]} y={L.eofAt[1]} text-anchor={L.eofAt[2]}>{t.eof}</text>
          <Badge x={L.badges[4][0]} y={L.badges[4][1]} n={5} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
