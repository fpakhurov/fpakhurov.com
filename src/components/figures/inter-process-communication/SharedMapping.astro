---
import Figure from '../Figure.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Two address spaces map one shared-memory object. Each page table sends a different virtual range to the same
// physical frame; every other region of the two processes maps to frames of its own (not drawn).
const t = ru
  ? {
      title: 'Разделяемая память: один физический кадр в двух адресных пространствах',
      a: 'процесс A', b: 'процесс B', phys: 'физическая память', aS: 'виртуальные адреса', bS: 'виртуальные адреса',
      stack: 'стек', heap: 'куча', code: 'код', shared: 'shared', ptA: 'таблица страниц A', ptB: 'таблица страниц B',
      note: ['оба: shm_open("/acos-demo"),', 'затем mmap(..., MAP_SHARED, ...)'],
      desc: 'Три вертикальные полосы: адресное пространство процесса A, физическая память и адресное пространство процесса B. В каждом процессе есть стек, куча, код и область shared, но у A она ниже, а у B выше. Стрелки от обеих областей shared ведут к одному и тому же выделенному кадру физической памяти.',
    }
  : {
      title: 'Shared memory: one physical frame in two address spaces',
      a: 'process A', b: 'process B', phys: 'physical memory', aS: 'virtual addresses', bS: 'virtual addresses',
      stack: 'stack', heap: 'heap', code: 'code', shared: 'shared', ptA: "A's page table", ptB: "B's page table",
      note: ['both: shm_open("/acos-demo"),', 'then mmap(..., MAP_SHARED, ...)'],
      desc: 'Three vertical bars: the address space of process A, physical memory, and the address space of process B. Each process has a stack, a heap, code and a shared region, lower in A and higher in B. Arrows from both shared regions lead to the same highlighted frame of physical memory.',
    };
// Regions as [top, bottom] in a bar that spans 50..270 (high addresses at the top).
const regionsA: [string, number, number, boolean][] = [[t.stack, 50, 80, false], [t.shared, 120, 160, true], [t.heap, 190, 220, false], [t.code, 240, 270, false]];
const regionsB: [string, number, number, boolean][] = [[t.stack, 50, 80, false], [t.shared, 90, 130, true], [t.heap, 190, 220, false], [t.code, 240, 270, false]];
const frames = 11, frameH = 20, sharedFrame = 5;
const midA = (120 + 160) / 2, midB = (90 + 130) / 2, frameMid = 50 + sharedFrame * frameH + frameH / 2;
if (midA === midB) throw new Error('SharedMapping: the two mappings should sit at different virtual addresses');

interface Layout { cls: string; W: number; H: number; A: [number, number]; P: [number, number]; B: [number, number]; arrowLabels: boolean; noteY: number[]; noteX: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 318, A: [40, 120], P: [320, 120], B: [600, 120], arrowLabels: true, noteY: [296, 312], noteX: 380 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 340, A: [14, 90], P: [135, 90], B: [256, 90], arrowLabels: false, noteY: [302, 324], noteX: 180 },
];
const id = 'ipc-shared-mapping';
const blue = toneVar.h;
---

<Figure
  id={id}
  title={t.title}
  caption={ru
    ? 'После shm_open и mmap с MAP_SHARED таблицы страниц двух процессов переводят разные виртуальные адреса в один и тот же физический кадр (выделен синим). Запись одного процесса сразу видна другому, без копирования через ядро; ни ожидания, ни взаимного исключения ядро при этом не обеспечивает. Поскольку адреса области различаются, указатель, записанный в неё одним процессом, бессмыслен для другого: в разделяемых структурах хранят смещения.'
    : "After shm_open and mmap with MAP_SHARED, the page tables of the two processes translate different virtual addresses to the same physical frame (blue). A store by one process is visible to the other at once, with no copy through the kernel; the kernel provides no waiting and no mutual exclusion either. Because the region sits at different addresses, a pointer stored in it by one process is meaningless to the other: shared structures store offsets."}
>
  {layouts.map((L) => {
    const bar = (x: number, w: number, regions: [string, number, number, boolean][]) => regions.map(([name, y0, y1, sh]) => ({ x, w, y0, y1, name, sh }));
    const all = [...bar(L.A[0], L.A[1], regionsA), ...bar(L.B[0], L.B[1], regionsB)];
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{t.title}</title>
        <desc id={`${id}-${L.W}-d`}>{t.desc}</desc>
        <text class="f-small" x={L.A[0] + L.A[1] / 2} y="22" text-anchor="middle" style="font-weight: 650">{t.a}</text>
        <text class="f-small" x={L.P[0] + L.P[1] / 2} y="22" text-anchor="middle" style="font-weight: 650">{t.phys}</text>
        <text class="f-small" x={L.B[0] + L.B[1] / 2} y="22" text-anchor="middle" style="font-weight: 650">{t.b}</text>
        {L.arrowLabels && <text class="f-small f-t-muted" x={L.A[0] + L.A[1] / 2} y="40" text-anchor="middle">{t.aS}</text>}
        {L.arrowLabels && <text class="f-small f-t-muted" x={L.B[0] + L.B[1] / 2} y="40" text-anchor="middle">{t.bS}</text>}
        {[L.A, L.B].map(([x, w]) => <rect x={x} y="50" width={w} height="220" style="fill: var(--paper-strong); stroke: var(--line)" />)}
        {all.map((r) => (
          <g>
            <rect x={r.x} y={r.y0} width={r.w} height={r.y1 - r.y0} style={r.sh ? `fill: ${blue}; fill-opacity: 0.2; stroke: ${blue}; stroke-width: 2` : 'fill: var(--paper); stroke: var(--muted)'} />
            <text class={`f-small ${r.sh ? 'f-t-blue' : 'f-t-muted'}`} x={r.x + r.w / 2} y={(r.y0 + r.y1) / 2 + 4.5} text-anchor="middle" style={r.sh ? 'font-family: var(--mono)' : undefined}>{r.name}</text>
          </g>
        ))}
        {Array.from({ length: frames }, (_, i) => (
          <rect x={L.P[0]} y={50 + i * frameH} width={L.P[1]} height={frameH} style={i === sharedFrame ? `fill: ${blue}; fill-opacity: 0.3; stroke: ${blue}; stroke-width: 2` : 'fill: var(--paper); stroke: var(--line)'} />
        ))}
        <path class="f-line f-blue" d={`M ${L.A[0] + L.A[1] + 2} ${midA} L ${L.P[0] - 3} ${frameMid}`} marker-end="url(#f-arrow-blue)" />
        <path class="f-line f-blue" d={`M ${L.B[0] - 2} ${midB} L ${L.P[0] + L.P[1] + 3} ${frameMid}`} marker-end="url(#f-arrow-blue)" />
        {L.arrowLabels && <text class="f-small f-t-blue f-halo" x={(L.A[0] + L.A[1] + L.P[0]) / 2} y={midA - 10} text-anchor="middle">{t.ptA}</text>}
        {L.arrowLabels && <text class="f-small f-t-blue f-halo" x={(L.B[0] + L.P[0] + L.P[1]) / 2 + 8} y={midB - 2} text-anchor="middle">{t.ptB}</text>}
        {t.note.map((line, k) => <text class="f-small f-t-muted" x={L.noteX} y={L.noteY[k]} text-anchor="middle" style="font-family: var(--mono)">{line}</text>)}
      </svg>
    );
  })}
</Figure>
