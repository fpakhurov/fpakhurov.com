---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// bne t0, t1, -12 encoded by hand: the 13-bit offset, its four pieces, the register fields, the hex word and the bytes.
const off = -12, rs1 = 5, rs2 = 6, funct3 = 0b001, opcode = 0b1100011;
const bit = (v: number, k: number) => (v >> k) & 1;
const offBits = Array.from({ length: 13 }, (_, i) => bit(off, 12 - i)); // bits 12..0
const word = ((bit(off, 12) << 31) | (((off >> 5) & 0x3f) << 25) | (rs2 << 20) | (rs1 << 15) | (funct3 << 12) | (((off >> 1) & 0xf) << 8) | (bit(off, 11) << 7) | opcode) >>> 0;
const hex = word.toString(16).padStart(8, '0');
if (hex !== 'fe629ae3') throw new Error(`BranchEncoding: ${hex}`);
if (offBits.join('') !== '1111111110100') throw new Error(`BranchEncoding: offset bits ${offBits.join('')}`);
const wordBits = Array.from({ length: 32 }, (_, i) => bit(word, 31 - i)); // bits 31..0
const bytes = [0, 1, 2, 3].map((k) => ((word >>> (8 * k)) & 0xff).toString(16).padStart(2, '0'));
if (bytes.join(' ') !== 'e3 9a 62 fe') throw new Error('BranchEncoding: bytes');

// the four pieces of the offset and where they go: [offset hi, offset lo, word hi, word lo, tone]
type Tone = 'red' | 'green' | 'amber' | 'blue';
const pieces: { oh: number; ol: number; wh: number; wl: number; tone: Tone; label: string }[] = [
  { oh: 12, ol: 12, wh: 31, wl: 31, tone: 'red', label: '12' },
  { oh: 10, ol: 5, wh: 30, wl: 25, tone: 'amber', label: '10:5' },
  { oh: 4, ol: 1, wh: 11, wl: 8, tone: 'blue', label: '4:1' },
  { oh: 11, ol: 11, wh: 7, wl: 7, tone: 'green', label: '11' },
];
const toneOfWordBit = (b: number) => pieces.find((p) => b <= p.wh && b >= p.wl)?.tone;
const toneOfOffBit = (b: number) => pieces.find((p) => b <= p.oh && b >= p.ol)?.tone;
const rest = [
  { hi: 24, lo: 20, en: 'rs2 = x6 (t1)', short: 'x6' },
  { hi: 19, lo: 15, en: 'rs1 = x5 (t0)', short: 'x5' },
  { hi: 14, lo: 12, en: 'bne', short: 'bne' },
  { hi: 6, lo: 0, en: 'opcode BRANCH', short: 'BRANCH' },
];
const t = ru
  ? { off: 'смещение', word: 'слово', mem: 'в памяти, младший байт первым:', notStored: 'бит 0: не хранится',
      steps: ['смещение −12 как 13-битное число в дополнительном коде; бит 0 всегда 0 и не хранится', 'его биты расходятся по четырём местам: 12 в бит 31, 10:5 в биты 30:25, 4:1 в биты 11:8, 11 в бит 7', 'номера регистров, funct3 = 001 для bne и код операции BRANCH заполняют остальное', 'в группах по четыре бита слово равно 0xfe629ae3', 'в памяти младший байт идёт первым: e3 9a 62 fe'] }
  : { off: 'offset', word: 'word', mem: 'in memory, least significant byte first:', notStored: 'bit 0: not stored',
      steps: ['the offset −12 as a 13-bit two’s-complement number; bit 0 is always 0 and is not stored', 'its bits go to four places: 12 to bit 31, 10:5 to bits 30:25, 4:1 to bits 11:8, 11 to bit 7', 'the register numbers, funct3 = 001 for bne and the BRANCH opcode fill the rest', 'in groups of four bits the word is 0xfe629ae3', 'in memory the least significant byte comes first: e3 9a 62 fe'] };

const layouts = [
  { cls: 'fig-wide', W: 760, H: 344, wide: true, ax: 200, aw: 26, ay: 44, bx: 100, bw: 20, by: 176, h: 26, fs: 12.5, mono: 12.5 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 344, wide: false, ax: 62, aw: 22, ay: 44, bx: 13, bw: 10.4, by: 176, h: 24, fs: 11, mono: 11 },
];
const id = 'risc-v-instructions-branch-encoding';
---

<Figure
  id={id}
  title={ru ? 'Кодирование bne t0, t1, −12 вручную' : 'Encoding bne t0, t1, −12 by hand'}
  caption={ru
    ? 'Ветвление назад на 12 байт, к началу цикла из четырёх команд. Смещение −12 записывается 13 битами в дополнительном коде, 1111111110100 (1); бит 0 у смещения ветвления всегда 0, поэтому не хранится. Остальные 12 бит раскладываются в B-формате по четырём местам: бит 12 (знак) в бит 31, биты 10:5 в биты 30:25, биты 4:1 в биты 11:8, бит 11 в бит 7 (2). Номера регистров t1 = x6 и t0 = x5, funct3 = 001 (bne) и код операции ветвлений 1100011 занимают те же места, что и в любом другом формате (3). Сгруппированное по четыре бита, слово равно 0xfe629ae3 (4), а в памяти хранится как байты e3 9a 62 fe (5).'
    : 'A branch back by 12 bytes, to the start of a four-instruction loop. The offset −12 is written as a 13-bit two’s-complement number, 1111111110100 (1); bit 0 of a branch offset is always 0 and is not stored. The other 12 bits are placed by the B format in four places: bit 12 (the sign) in bit 31, bits 10:5 in bits 30:25, bits 4:1 in bits 11:8 and bit 11 in bit 7 (2). The register numbers t1 = x6 and t0 = x5, funct3 = 001 (bne) and the branch opcode 1100011 occupy the same places as in every other format (3). Grouped by four bits, the word is 0xfe629ae3 (4), and memory holds it as the bytes e3 9a 62 fe (5).'}
>
  {layouts.map((L) => {
    const ax = (b: number) => L.ax + (12 - b) * L.aw;   // left edge of offset bit b
    const bx = (b: number) => L.bx + (31 - b) * L.bw;   // left edge of word bit b
    const ms = `font-family: var(--mono); font-size: ${L.mono}px`;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Биты смещения −12 и их места в слове команды bne' : 'The bits of the offset −12 and their places in the bne instruction word'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Вверху 13 бит смещения −12: 1111111110100, бит 0 зачёркнут. Цветные линии ведут от бита 12 к биту 31 слова, от битов 10:5 к битам 30:25, от битов 4:1 к битам 11:8 и от бита 11 к биту 7. Внизу 32 бита слова 11111110011000101001101011100011, сгруппированные по четыре в шестнадцатеричные цифры fe629ae3, и байты в памяти e3 9a 62 fe.'
          : 'At the top, the 13 bits of the offset −12: 1111111110100, with bit 0 crossed out. Coloured lines lead from bit 12 to word bit 31, from bits 10:5 to bits 30:25, from bits 4:1 to bits 11:8 and from bit 11 to bit 7. At the bottom, the 32 bits of the word 11111110011000101001101011100011, grouped by four into the hex digits fe629ae3, and the bytes in memory e3 9a 62 fe.'}</desc>

        {/* 1: the offset */}
        <g data-s="1">
          <text class="f-label" x={L.wide ? 20 : 8} y={L.ay + L.h / 2 + 5} style="font-weight: 650">{L.wide ? `${t.off} −12` : '−12'}</text>
          {offBits.map((v, i) => {
            const b = 12 - i, tone = toneOfOffBit(b);
            return (
              <g>
                <rect class={tone ? `f-fill-${tone}` : 'f-fill-paper'} x={ax(b)} y={L.ay} width={L.aw} height={L.h} />
                <rect class={`f-thin ${tone ? `f-${tone}` : 'f-muted'}`} x={ax(b)} y={L.ay} width={L.aw} height={L.h} />
                <text class="f-small" x={ax(b) + L.aw / 2} y={L.ay + L.h / 2 + 4.5} text-anchor="middle" style={ms}>{v}</text>
                <text class="f-small f-t-muted" x={ax(b) + L.aw / 2} y={L.ay - 7} text-anchor="middle" style={`font-size: ${L.fs - 1}px`}>{b}</text>
              </g>
            );
          })}
          <path class="f-line f-muted" d={`M ${ax(0) + 3} ${L.ay + L.h - 3} L ${ax(0) + L.aw - 3} ${L.ay + 3}`} />
          {L.wide && <text class="f-small f-t-muted" x={ax(0) + L.aw + 8} y={L.ay + L.h / 2 + 4}>{t.notStored}</text>}
          <Badge x={L.wide ? ax(12) - 22 + 0 : ax(12) - 14} y={L.wide ? L.ay - 14 : L.ay - 22} n={1} />
        </g>

        {/* 2: the pieces move */}
        <g data-s="2">
          {pieces.map((p) => {
            const x1 = (ax(p.oh) + ax(p.ol) + L.aw) / 2, x2 = (bx(p.wh) + bx(p.wl) + L.bw) / 2;
            return <path class={`f-line f-${p.tone}`} d={`M ${x1} ${L.ay + L.h + 22} C ${x1} ${L.ay + L.h + 60}, ${x2} ${L.by - 52}, ${x2} ${L.by - 4}`} marker-end={`url(#f-arrow-${p.tone})`} />;
          })}
          {pieces.map((p) => (
            <text class={`f-small f-t-${p.tone} f-halo`} x={(ax(p.oh) + ax(p.ol) + L.aw) / 2} y={L.ay + L.h + 16} text-anchor="middle" style={`font-size: ${L.fs}px; font-weight: 650`}>{p.label}</text>
          ))}
          {wordBits.map((v, i) => {
            const b = 31 - i, tone = toneOfWordBit(b);
            return tone ? (
              <g>
                <rect class={`f-fill-${tone}`} x={bx(b)} y={L.by} width={L.bw} height={L.h} />
                <text class="f-small" x={bx(b) + L.bw / 2} y={L.by + L.h / 2 + 4.5} text-anchor="middle" style={ms}>{v}</text>
              </g>
            ) : null;
          })}
          <Badge x={L.wide ? 690 : 40} y={L.wide ? 130 : 112} n={2} />
        </g>

        {/* the word frame, always shown */}
        {L.wide && <text class="f-label" x="20" y={L.by + L.h / 2 + 5} style="font-weight: 650">{t.word}</text>}
        {wordBits.map((_, i) => <rect class="f-thin f-muted" x={bx(31 - i)} y={L.by} width={L.bw} height={L.h} />)}

        {/* 3: registers, funct3 and opcode */}
        <g data-s="3">
          {wordBits.map((v, i) => {
            const b = 31 - i;
            return toneOfWordBit(b) ? null : <text class="f-small" x={bx(b) + L.bw / 2} y={L.by + L.h / 2 + 4.5} text-anchor="middle" style={ms}>{v}</text>;
          })}
          {rest.map((f) => (
            <g>
              <path class="f-thin f-muted" d={`M ${bx(f.hi) + 1} ${L.by + L.h + 4} V ${L.by + L.h + 9} H ${bx(f.lo) + L.bw - 1} V ${L.by + L.h + 4}`} />
              <text class="f-small f-t-muted" x={(bx(f.hi) + bx(f.lo) + L.bw) / 2} y={L.by + L.h + 23} text-anchor="middle" style={`font-size: ${L.fs}px`}>{L.wide ? f.en : f.short}</text>
            </g>
          ))}
          <Badge x={bx(9) + L.bw / 2} y={L.by + L.h + 19} n={3} />
        </g>

        {/* 4: hex digits */}
        <g data-s="4">
          {[0, 1, 2, 3, 4, 5, 6, 7].map((k) => {
            const x = L.bx + k * 4 * L.bw, y = L.by + L.h + 58;
            return (
              <g>
                <path class="f-thin f-blue" d={`M ${x + 2} ${y - 12} V ${y - 6} H ${x + 4 * L.bw - 2} V ${y - 12}`} />
                <text class="f-label f-t-blue" x={x + 2 * L.bw} y={y + 12} text-anchor="middle" style="font-family: var(--mono); font-weight: 650">{hex[k]}</text>
              </g>
            );
          })}
          <text class="f-label f-t-blue" x={L.bx} y={L.by + L.h + 100} style="font-family: var(--mono); font-weight: 650">{`= 0x${hex}`}</text>
          <Badge x={L.bx + 140} y={L.by + L.h + 95} n={4} />
        </g>

        {/* 5: bytes in memory */}
        <g data-s="5">
          <text class="f-small" x={L.bx} y={L.by + L.h + 128} style={`font-size: ${L.fs}px`}>{L.wide ? `${t.mem} ` : ''}<tspan style={`${ms}; font-weight: 650`}>{bytes.join(' ')}</tspan></text>
          <Badge x={L.wide ? L.bx + 395 : L.bx + 108} y={L.by + L.h + 124} n={5} />
        </g>
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
