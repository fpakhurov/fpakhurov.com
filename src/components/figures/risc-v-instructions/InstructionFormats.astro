---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The six RV32I instruction formats, field by field, bit 31 on the left. Immediate pieces are labelled by the bits of the
// immediate they hold (as in the specification), so the scrambling of B and J is visible: in every format the sign of
// the immediate is instruction bit 31, and rs1, rs2 and rd never move.
type Kind = 'op' | 'rs' | 'rd' | 'imm';
interface Field { hi: number; lo: number; kind: Kind; en: string; short?: string }
const F = (hi: number, lo: number, kind: Kind, en: string, short?: string): Field => ({ hi, lo, kind, en, short });
const formats: { name: string; ex: string; fields: Field[] }[] = [
  { name: 'R', ex: 'add', fields: [F(31, 25, 'op', 'funct7', 'f7'), F(24, 20, 'rs', 'rs2'), F(19, 15, 'rs', 'rs1'), F(14, 12, 'op', 'funct3', 'f3'), F(11, 7, 'rd', 'rd'), F(6, 0, 'op', 'opcode')] },
  { name: 'I', ex: 'addi, lw', fields: [F(31, 20, 'imm', '11:0'), F(19, 15, 'rs', 'rs1'), F(14, 12, 'op', 'funct3', 'f3'), F(11, 7, 'rd', 'rd'), F(6, 0, 'op', 'opcode')] },
  { name: 'S', ex: 'sw', fields: [F(31, 25, 'imm', '11:5'), F(24, 20, 'rs', 'rs2'), F(19, 15, 'rs', 'rs1'), F(14, 12, 'op', 'funct3', 'f3'), F(11, 7, 'imm', '4:0'), F(6, 0, 'op', 'opcode')] },
  { name: 'B', ex: 'beq', fields: [F(31, 31, 'imm', '12'), F(30, 25, 'imm', '10:5'), F(24, 20, 'rs', 'rs2'), F(19, 15, 'rs', 'rs1'), F(14, 12, 'op', 'funct3', 'f3'), F(11, 8, 'imm', '4:1'), F(7, 7, 'imm', '11'), F(6, 0, 'op', 'opcode')] },
  { name: 'U', ex: 'lui', fields: [F(31, 12, 'imm', '31:12'), F(11, 7, 'rd', 'rd'), F(6, 0, 'op', 'opcode')] },
  { name: 'J', ex: 'jal', fields: [F(31, 31, 'imm', '20'), F(30, 21, 'imm', '10:1'), F(20, 20, 'imm', '11'), F(19, 12, 'imm', '19:12'), F(11, 7, 'rd', 'rd'), F(6, 0, 'op', 'opcode')] },
];
for (const f of formats) {
  const bits = f.fields.reduce((s, x) => s + x.hi - x.lo + 1, 0);
  if (bits !== 32) throw new Error(`InstructionFormats: ${f.name} has ${bits} bits`);
  f.fields.forEach((x, i) => { if (i && f.fields[i - 1].lo !== x.hi + 1) throw new Error(`InstructionFormats: gap in ${f.name}`); });
  // the sign bit of every immediate is instruction bit 31
  if (f.fields[0].kind !== 'imm' && f.name !== 'R') throw new Error(`InstructionFormats: ${f.name} sign`);
}
const fill: Record<Kind, string> = { op: 'f-fill-paper', rs: 'f-fill-blue', rd: 'f-fill-red', imm: 'f-fill-amber' };
const stroke: Record<Kind, string> = { op: 'f-muted', rs: 'f-blue', rd: 'f-red', imm: 'f-amber' };
const ticks = [31, 24, 19, 14, 11, 6, 0];
const legend: [Kind, string][] = ru
  ? [['op', 'код операции, funct'], ['rs', 'регистры-источники'], ['rd', 'регистр-приёмник'], ['imm', 'биты константы']]
  : [['op', 'opcode, funct'], ['rs', 'source registers'], ['rd', 'destination register'], ['imm', 'immediate bits']];

const layouts = [
  { cls: 'fig-wide', W: 760, H: 322, wide: true, x0: 100, bw: 20, top: 46, rowH: 40, h: 26, fs: 12.5 },
  { cls: 'fig-narrow', W: 360, H: 384, wide: false, x0: 30, bw: 10, top: 40, rowH: 46, h: 24, fs: 11 },
];
const id = 'risc-v-instructions-formats';
---

<Figure
  id={id}
  title={ru ? 'Шесть форматов команд RV32I' : 'The six instruction formats of RV32I'}
  caption={ru
    ? 'Каждая строка — 32-битное слово команды, бит 31 слева. Поля регистров rs1, rs2 и rd стоят на одних и тех же местах во всех форматах, где они есть; код операции всегда в битах 6–0, funct3 (f3 на узкой схеме) — в битах 14–12. Куски константы (янтарные) подписаны номерами битов константы, которые они хранят. В S-формате константа разрезана на биты 11:5 и 4:0, потому что место между ними занимает rs2. B-формат — это S, в котором бит 0 не хранится (смещение чётное), а освободившееся место занимает бит 11; J-формат в том же духе переставляет биты формата U. Знаковый бит любой константы — бит 31 команды.'
    : 'Each row is a 32-bit instruction word, bit 31 on the left. The register fields rs1, rs2 and rd sit in the same place in every format that has them; the opcode is always bits 6–0 and funct3 (f3 in the narrow layout) bits 14–12. The pieces of the immediate (amber) are labelled with the bits of the immediate they hold. In the S format the immediate is cut into bits 11:5 and 4:0, because rs2 occupies the place between them. The B format is S with bit 0 not stored (the offset is even) and bit 11 moved into the freed slot; the J format rearranges U in the same spirit. The sign bit of every immediate is instruction bit 31.'}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Поля форматов R, I, S, B, U и J' : 'The fields of the R, I, S, B, U and J formats'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Шесть полос по 32 бита. R: funct7, rs2, rs1, funct3, rd, opcode. I: imm[11:0], rs1, funct3, rd, opcode. S: imm[11:5], rs2, rs1, funct3, imm[4:0], opcode. B: imm[12], imm[10:5], rs2, rs1, funct3, imm[4:1], imm[11], opcode. U: imm[31:12], rd, opcode. J: imm[20], imm[10:1], imm[11], imm[19:12], rd, opcode.'
        : 'Six strips of 32 bits. R: funct7, rs2, rs1, funct3, rd, opcode. I: imm[11:0], rs1, funct3, rd, opcode. S: imm[11:5], rs2, rs1, funct3, imm[4:0], opcode. B: imm[12], imm[10:5], rs2, rs1, funct3, imm[4:1], imm[11], opcode. U: imm[31:12], rd, opcode. J: imm[20], imm[10:1], imm[11], imm[19:12], rd, opcode.'}</desc>
      {ticks.map((b) => (
        <text class="f-small f-t-muted" x={L.x0 + (31 - b) * L.bw + L.bw / 2} y={L.top - 10} text-anchor="middle" style={`font-size: ${L.fs}px`}>{b}</text>
      ))}
      {formats.map((f, r) => {
        const y = L.top + r * L.rowH;
        return (
          <g>
            <text class="f-label" x={L.wide ? 14 : 8} y={y + L.h / 2 + 5} style="font-weight: 650">{f.name}</text>
            {L.wide && <text class="f-small f-t-muted" x="34" y={y + L.h / 2 + 4}>{f.ex}</text>}
            {f.fields.map((x) => {
              const fx = L.x0 + (31 - x.hi) * L.bw, fw = (x.hi - x.lo + 1) * L.bw;
              const one = x.hi === x.lo;
              const label = L.wide ? x.en : x.short ?? x.en;
              return (
                <g>
                  <rect class={fill[x.kind]} x={fx} y={y} width={fw} height={L.h} />
                  <rect class={`f-thin ${stroke[x.kind]}`} x={fx} y={y} width={fw} height={L.h} />
                  {one && !L.wide
                    ? <text class="f-small f-t-amber" x={fx + fw / 2} y={y + L.h + 12} text-anchor="middle" style={`font-size: ${L.fs}px; font-weight: 650`}>{label}</text>
                    : <text class={`f-small ${x.kind === 'imm' ? 'f-t-amber' : ''}`} x={fx + fw / 2} y={y + L.h / 2 + 4.5} text-anchor="middle" style={`font-size: ${L.fs}px${x.kind === 'imm' ? '; font-weight: 650' : ''}`}>{label}</text>}
                </g>
              );
            })}
          </g>
        );
      })}
      {legend.map(([k, txt], i) => {
        const lx = L.wide ? L.x0 + i * 160 : 8 + (i % 2) * 176, ly = L.wide ? L.H - 14 : L.H - 34 + Math.floor(i / 2) * 22;
        return (
          <g>
            <rect class={fill[k]} x={lx} y={ly - 10} width="14" height="12" />
            <rect class={`f-thin ${stroke[k]}`} x={lx} y={ly - 10} width="14" height="12" />
            <text class="f-small f-t-muted" x={lx + 20} y={ly}>{txt}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
