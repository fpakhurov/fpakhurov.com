---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Measured once: CPython 3.14.7, Apple M1, macOS 26. Building a dict of n keys of a small class whose __eq__ compares
// one field; nanoseconds per insertion (best of 5 runs, 3 for the constant hash). "good": __hash__ = hash(field);
// "constant": __hash__ returns 42 for every key, so every key collides with every other.
const data: [number, number, number][] = [[250, 66, 6320], [500, 64, 11576], [1000, 57, 21349], [2000, 53, 42587], [4000, 53, 86624]];
const slope = Math.log10(data[4][2] / data[0][2]) / Math.log10(16);
if (!(slope > 0.9 && slope < 1.05)) throw new Error(`DictWorstCase: slope ${slope}`);
if (Math.max(...data.map((d) => d[1])) > 70) throw new Error('DictWorstCase: good hash should stay flat');

const t = ru
  ? { x: 'число ключей n (лог. шкала)', y: 'нс на вставку (лог. шкала)', good: '__hash__ по значению: в среднем O(1)', bad: '__hash__ = 42: O(n) на вставку' }
  : { x: 'number of keys n (log scale)', y: 'ns per insertion (log scale)', good: '__hash__ from the value: O(1) on average', bad: '__hash__ = 42: O(n) per insertion' };
interface Layout { cls: string; W: number; H: number; x0: number; x1: number; y0: number; y1: number; sans: number; labels: [number, number][] }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 300, x0: 90, x1: 720, y0: 248, y1: 30, sans: 6.5, labels: [[110, 234], [150, 124]] },
  { cls: 'fig-narrow', W: 360, H: 320, x0: 56, x1: 340, y0: 248, y1: 30, sans: 6.5, labels: [[64, 234], [80, 124]] },
];
for (const L of layouts) for (const [i, s] of [t.good, t.bad].entries()) if (L.labels[i][0] + s.length * L.sans > L.W - 4) throw new Error(`"${s}" overflows at ${L.W}`);
const id = 'dict-worst-case';
---

<Figure
  id={id}
  title={ru ? 'Средний и худший случай: когда все ключи сталкиваются' : 'Average and worst case: when every key collides'}
  caption={ru
    ? 'Время одной вставки при построении словаря из n ключей, обе оси логарифмические; измерено один раз на Apple M1, CPython 3.14.7. Ключи — объекты маленького класса; синяя линия: __hash__ возвращает хеш поля, и вставка стоит около 55–65 нс при любом n. Красная: __hash__ всегда возвращает 42, каждый новый ключ проходит мимо всех прежних и сравнивается с каждым через __eq__, и время вставки растёт пропорционально n: в 16 раз больше ключей — в 13.7 раза дольше на вставку, 87 мкс при 4000 ключах.'
    : 'The time of one insertion while building a dict of n keys, both axes logarithmic; measured once on an Apple M1, CPython 3.14.7. The keys are instances of a small class. Blue: __hash__ returns the hash of a field, and an insertion costs about 55 to 65 ns at any n. Red: __hash__ always returns 42, every new key probes past all earlier ones and is compared with each through __eq__, and the time per insertion grows in proportion to n: 16 times more keys, 13.7 times longer per insertion, 87 μs at 4000 keys.'}
>
  {layouts.map((L) => {
    const sx = scale([Math.log10(200), Math.log10(5000)], [L.x0, L.x1]), sy = scale([1, 5], [L.y0, L.y1]);
    const line = (k: number) => polyline(data.map((d) => [sx(Math.log10(d[0])), sy(Math.log10(d[k]))]));
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Время вставки в словарь в зависимости от числа ключей' : 'Insertion time against the number of keys'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Синяя линия лежит горизонтально около 60 нс. Красная поднимается по прямой от 6.3 мкс при 250 ключах до 87 мкс при 4000.'
          : 'The blue line lies flat near 60 ns. The red line rises straight from 6.3 μs at 250 keys to 87 μs at 4000.'}</desc>
        {[1, 2, 3, 4, 5].map((e) => (
          <g>
            <path class="f-grid" d={`M ${L.x0} ${sy(e)} H ${L.x1}`} />
            <text class="f-small f-t-muted" x={L.x0 - 8} y={sy(e) + 4} text-anchor="end">{`10${'⁰¹²³⁴⁵'[e]}`}</text>
          </g>
        ))}
        {data.map((d) => <text class="f-small f-t-muted" x={sx(Math.log10(d[0]))} y={L.y0 + 18} text-anchor="middle">{d[0]}</text>)}
        <path class="f-axis" d={`M ${L.x0} ${L.y1 - 6} V ${L.y0} H ${L.x1 + 6}`} />
        <text class="f-small f-t-muted" x={(L.x0 + L.x1) / 2} y={L.y0 + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.x0 - 40} y={L.y1 - 14}>{t.y}</text>
        <path class="f-line f-blue" d={line(1)} />
        <path class="f-line f-red" d={line(2)} />
        {data.map((d) => <circle cx={sx(Math.log10(d[0]))} cy={sy(Math.log10(d[1]))} r="3.2" class="f-solid-blue" />)}
        {data.map((d) => <circle cx={sx(Math.log10(d[0]))} cy={sy(Math.log10(d[2]))} r="3.2" class="f-solid-red" />)}
        <text class="f-small f-t-blue f-halo" x={L.labels[0][0]} y={L.labels[0][1]}>{t.good}</text>
        <text class="f-small f-t-red f-halo" x={L.labels[1][0]} y={L.labels[1][1]}>{t.bad}</text>
      </svg>
    );
  })}
</Figure>
