---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// d = {17: 'a', 3: 'b', 9: 'c'} in CPython 3.14.7. Integers hash to themselves, so the layout is deterministic;
// the index array below was read from the dict's memory with ctypes: [-1, 0, -1, 1, -1, -1, 2, -1].
// Insertion and lookup are replayed here with the probe rule of Objects/dictobject.c (PERTURB_SHIFT = 5).
const keys = [17, 3, 9], vals = ['a', 'b', 'c'];
const size = 8, mask = size - 1;
const probe = (h: number) => {           // the slots visited for hash h, until an empty one
  const seq: number[] = [];
  let i = h & mask, perturb = h;
  for (let n = 0; n < size; n += 1) { seq.push(i); perturb >>= 5; i = (i * 5 + perturb + 1) & mask; }
  return seq;
};
const index = Array(size).fill(-1);
keys.forEach((k, e) => { const slot = probe(k).find((s) => index[s] === -1)!; index[slot] = e; });
if (index.join() !== '-1,0,-1,1,-1,-1,2,-1') throw new Error(`DictLookup: index ${index}`);
const path = probe(9).slice(0, 2);
if (path.join() !== '1,6') throw new Error(`DictLookup: probe ${path}`);
if (Math.floor((2 * size) / 3) !== 5) throw new Error('usable fraction');

const t = ru
  ? { idx: 'индексы', ent: 'записи, в порядке вставки', cols: ['хеш', 'ключ', 'значение'], empty: '· = пусто (−1)',
      notes: [['hash(9) = 9'], ['9 & 7 = 1: ячейка 1'], ['запись 0: хеш 17 ≠ 9,', 'коллизия'], ['perturb = 9 >> 5 = 0', 'далее: (5·1 + 1 + 0) & 7 = 6'], ['запись 2: хеш 9, ключ 9 == 9', "d[9] → 'c'"]],
      steps: ['вычислить хеш ключа', 'младшие 3 бита хеша выбирают ячейку индексов', 'ячейка ведёт к записи с другим ключом', 'следующая ячейка по правилу пробирования', 'хеш и ключ совпали: вернуть значение'] }
  : { idx: 'indices', ent: 'entries, in insertion order', cols: ['hash', 'key', 'value'], empty: '· = empty (−1)',
      notes: [['hash(9) = 9'], ['9 & 7 = 1: slot 1'], ['entry 0: hash 17 ≠ 9,', 'a collision'], ['perturb = 9 >> 5 = 0', 'next: (5·1 + 1 + 0) & 7 = 6'], ['entry 2: hash 9, key 9 == 9', "d[9] → 'c'"]],
      steps: ['hash the key', 'the low 3 bits of the hash pick a slot of the index array', 'the slot leads to an entry with another key', 'the next slot, by the probe rule', 'hash and key match: return the value'] };

interface Layout {
  cls: string; W: number; H: number; sans: number; mono: number; code: [number, number][];
  ix: number; iy: number; iw: number; ih: number; ex: number; colW: number[]; eh: number; headY: number; entTitle: [number, number];
  notes: [number, number][]; emptyAt: [number, number]; bend: number;
}
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 330, sans: 6.5, mono: 7.5, code: [[40, 30], [40, 54]],
    ix: 330, iy: 70, iw: 44, ih: 28, ex: 520, colW: [60, 60, 70], eh: 28, headY: 60, entTitle: [520, 30],
    notes: [[40, 130], [40, 156], [520, 184], [40, 220], [520, 244]], emptyAt: [330, 316], bend: 46 },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 516, sans: 7.3, mono: 8.4, code: [[16, 22], [16, 44]],
    ix: 60, iy: 98, iw: 44, ih: 28, ex: 170, colW: [56, 56, 72], eh: 28, headY: 88, entTitle: [16, 66],
    notes: [[34, 344], [34, 366], [34, 390], [34, 434], [34, 478]], emptyAt: [170, 200], bend: 34 },
];
const code = ["d = {17: 'a', 3: 'b', 9: 'c'}", 'd[9]'];
for (const L of layouts) {
  const right = L.W - 4;
  const ew = L.colW.reduce((a, b) => a + b, 0);
  if (L.ex + ew > right) throw new Error(`entries overflow at ${L.W}`);
  for (const s of code) if (L.code[0][0] + s.length * L.mono > (L.W > 400 ? L.entTitle[0] - 10 : right)) throw new Error(`code overflows at ${L.W}`);
  t.notes.forEach((lines, k) => lines.forEach((s) => {
    const x = L.notes[k][0];
    if (x + s.length * L.mono > right) throw new Error(`note "${s}" overflows at ${L.W}`);
    if (x < L.ix + L.iw && x + s.length * L.mono > L.ix - 50 && L.notes[k][1] > L.iy - 10 && L.notes[k][1] < L.iy + size * L.ih + 14) throw new Error(`note "${s}" runs into the index array`);
  }));
  if (L.entTitle[0] + t.ent.length * L.sans > right) throw new Error('entries title overflows');
  if (L.W < 400 && L.iy + size * L.ih > L.notes[0][1] - 20) throw new Error('narrow notes overlap the index array');
  if (L.notes[4][1] + 20 + 10 > L.H) throw new Error('notes run off the bottom');
}
const id = 'dict-lookup';
---

<Figure
  id={id}
  title={ru ? 'Поиск ключа в словаре: индексы, записи и пробирование' : 'Looking up a key in a dict: indices, entries and probing'}
  caption={ru
    ? 'Словарь {17: \'a\', 3: \'b\', 9: \'c\'} в CPython 3.14.7. Таблица индексов из 8 ячеек хранит номера записей; записи (хеш, ключ, значение) лежат в отдельном массиве в порядке вставки. Целые числа хешируются сами в себя, поэтому раскладку можно проверить: ячейки 1, 3 и 6 указывают на записи 0, 1 и 2, как показывает чтение памяти словаря. Поиск d[9]: хеш 9 (1), ячейка 9 & 7 = 1 (2), но там запись ключа 17 (3); правило пробирования ведёт в ячейку 6 (4), где хеш и ключ совпадают (5). Ключ 9 при вставке прошёл тот же путь.'
    : 'The dict {17: \'a\', 3: \'b\', 9: \'c\'} in CPython 3.14.7. An index array of 8 slots holds entry numbers; the entries (hash, key, value) sit in a separate array in insertion order. Integers hash to themselves, so the layout can be checked: slots 1, 3 and 6 point to entries 0, 1 and 2, as reading the dict\'s memory confirms. Looking up d[9]: the hash is 9 (1), the slot 9 & 7 = 1 (2), but it holds the entry of key 17 (3); the probe rule leads to slot 6 (4), where hash and key match (5). Key 9 followed the same path when it was inserted.'}
>
  {layouts.map((L) => {
    const sy = (s: number) => L.iy + s * L.ih;
    const ey = (e: number) => L.iy + e * L.eh;
    const colX = L.colW.map((_, c) => L.ex + L.colW.slice(0, c).reduce((a, b) => a + b, 0));
    const rows = keys.map((k, e) => [String(k), String(k), `'${vals[e]}'`]);
    const labX = L.ix + L.iw + 6, arrX = L.ix + L.iw + 22;
    const bend = L.bend;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Индексы и записи словаря при поиске d[9]' : 'The indices and entries of a dict during the lookup d[9]'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Столбец из восьми ячеек индексов, в ячейках 1, 3 и 6 стоят числа 0, 1 и 2, остальные пусты. Справа таблица записей: 17, 17, a; 3, 3, b; 9, 9, c. Стрелка из ячейки 1 к записи 0, дуга от ячейки 1 к ячейке 6 и стрелка из ячейки 6 к записи 2.'
          : 'A column of eight index slots; slots 1, 3 and 6 hold 0, 1 and 2, the others are empty. To the right, a table of entries: 17, 17, a; 3, 3, b; 9, 9, c. An arrow goes from slot 1 to entry 0, an arc from slot 1 to slot 6, and an arrow from slot 6 to entry 2.'}</desc>
        {code.map((s, i) => <text class="f-small" x={L.code[i][0]} y={L.code[i][1]} style="font-family: var(--mono)">{s}</text>)}
        <text class="f-small f-t-muted" x={L.ix + L.iw / 2} y={L.headY - 2} text-anchor="middle" style="font-weight: 650">{t.idx}</text>
        <text class="f-small f-t-muted" x={L.entTitle[0]} y={L.entTitle[1]} style="font-weight: 650">{t.ent}</text>
        {t.cols.map((c, j) => <text class="f-small f-t-muted" x={colX[j] + L.colW[j] / 2} y={L.headY - 2} text-anchor="middle">{c}</text>)}
        {index.map((v, s) => (
          <g>
            <rect x={L.ix} y={sy(s)} width={L.iw} height={L.ih} style={`fill: ${toneVar.g}; fill-opacity: ${v === -1 ? 0.04 : 0.16}; stroke: ${toneVar.g}; stroke-width: 1.2`} />
            <text class="f-small" x={L.ix + L.iw / 2} y={sy(s) + L.ih / 2 + 4.5} text-anchor="middle">{v === -1 ? '·' : String(v)}</text>
            <text class="f-small f-t-muted" x={labX} y={sy(s) + L.ih / 2 + 4.5}>{s}</text>
          </g>
        ))}
        {rows.map((r, e) => (
          <g>
            {r.map((v, j) => (
              <g>
                <rect x={colX[j]} y={ey(e)} width={L.colW[j]} height={L.eh} style={`fill: ${toneVar.h}; fill-opacity: 0.12; stroke: ${toneVar.h}; stroke-width: 1.2`} />
                <text class="f-small" x={colX[j] + L.colW[j] / 2} y={ey(e) + L.eh / 2 + 4.5} text-anchor="middle">{v}</text>
              </g>
            ))}
            <text class="f-small f-t-muted" x={L.ex - 6} y={ey(e) + L.eh / 2 + 4.5} text-anchor="end">{e}</text>
          </g>
        ))}
        <text class="f-small f-t-muted" x={L.emptyAt[0]} y={L.emptyAt[1]}>{t.empty}</text>
        <g data-s="2"><rect x={L.ix} y={sy(1)} width={L.iw} height={L.ih} style="fill: none; stroke: var(--fig-amber); stroke-width: 2.6" /></g>
        <g data-s="3">
          <path class="f-line f-red" d={`M ${arrX} ${sy(1) + L.ih / 2} L ${L.ex - 18} ${ey(0) + L.eh / 2}`} marker-end="url(#f-arrow-red)" />
          <rect x={L.ex} y={ey(0)} width={L.colW[0]} height={L.eh} style="fill: none; stroke: var(--fig-red); stroke-width: 2.4" />
        </g>
        <g data-s="4">
          <path class="f-line f-amber" d={`M ${L.ix - 4} ${sy(1) + L.ih / 2} C ${L.ix - 4 - bend} ${sy(1) + L.ih / 2} ${L.ix - 4 - bend} ${sy(6) + L.ih / 2} ${L.ix - 6} ${sy(6) + L.ih / 2}`} marker-end="url(#f-arrow-amber)" />
          <rect x={L.ix} y={sy(6)} width={L.iw} height={L.ih} style="fill: none; stroke: var(--fig-amber); stroke-width: 2.6" />
        </g>
        <g data-s="5">
          <path class="f-line f-green" d={`M ${arrX} ${sy(6) + L.ih / 2} L ${L.ex - 18} ${ey(2) + L.eh / 2}`} marker-end="url(#f-arrow-green)" />
          <rect x={L.ex} y={ey(2)} width={L.colW.reduce((a, b) => a + b, 0)} height={L.eh} style="fill: none; stroke: var(--fig-green); stroke-width: 2.4" />
        </g>
        {t.notes.map((lines, k) => (
          <g data-s={String(k + 1)}>
            <Badge x={L.notes[k][0] - 16} y={L.notes[k][1] - 5} n={k + 1} />
            {lines.map((s, i) => <text class="f-small" x={L.notes[k][0]} y={L.notes[k][1] + i * 20} style="font-family: var(--mono)">{s}</text>)}
          </g>
        ))}
      </svg>
    );
  })}
  <Stepper steps={t.steps} />
</Figure>
