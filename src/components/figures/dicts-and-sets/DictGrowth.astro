---
import Figure from '../Figure.astro';
import { scale, polyline, type Point } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Measured once on CPython 3.14.7, 64-bit macOS (arm64): inserting the keys 1, 2, 3, ... (ints) into an empty dict,
// the number of keys at which sys.getsizeof(d) changed and its new value. An empty dict is 64 bytes.
const measured: [number, number][] = [[1, 224], [6, 352], [11, 632], [22, 1168], [43, 2264], [86, 4688], [171, 9304], [342, 18512], [683, 36952], [1366, 73808]];
// Model from Objects/dictobject.c (3.14): an index array of m slots (1-byte indices up to m = 128, 2-byte up to 2^15),
// USABLE_FRACTION(m) = 2m/3 entries of 24 bytes (hash, key, value), a 32-byte keys header and the 64-byte dict object.
// A full table is replaced by one of the smallest power of two m >= max(8, 3 * used).
const usable = (m: number) => Math.floor((2 * m) / 3);
const bytes = (m: number) => 64 + 32 + m * (m <= 128 ? 1 : 2) + usable(m) * 24;
const pow2 = (x: number) => { let m = 8; while (m < x) m *= 2; return m; };
const N = 1400;
const sizeAt: number[] = [64], loadAt: number[] = [0], model: [number, number][] = [];
let m = 0;
for (let n = 1; n <= N; n += 1) {
  if (m === 0 || n - 1 >= usable(m)) { m = pow2(3 * (n - 1)); model.push([n, bytes(m)]); }
  sizeAt.push(bytes(m)); loadAt.push(n / m);
}
if (JSON.stringify(model) !== JSON.stringify(measured)) throw new Error(`DictGrowth: model ${JSON.stringify(model)}`);
const maxLoad = Math.max(...loadAt), minAfter = Math.min(...loadAt.slice(6));
if (!(maxLoad <= 2 / 3 && minAfter > 0.3)) throw new Error(`DictGrowth: load ${maxLoad} ${minAfter}`);

const t = ru
  ? { tl: 'sys.getsizeof(d), КБ', tr: 'коэффициент заполнения n / m', x: 'число ключей n', two: 'предел 2/3', third: '≈ 1/3 после расширения' }
  : { tl: 'sys.getsizeof(d), KB', tr: 'load factor n / m', x: 'number of keys n', two: 'limit 2/3', third: '≈ 1/3 after a resize' };
interface Panel { x: [number, number]; y: [number, number] }
interface Layout { cls: string; W: number; H: number; A: Panel; B: Panel }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 320, A: { x: [64, 350], y: [44, 262] }, B: { x: [450, 736], y: [44, 262] } },
  { cls: 'fig-narrow', W: 360, H: 640, A: { x: [56, 340], y: [44, 262] }, B: { x: [56, 340], y: [372, 590] } },
];
const paths = (ax: (v: number) => number, ay: (v: number) => number, bx: (v: number) => number, by: (v: number) => number) => {
  const stair: Point[] = [[ax(0), ay(sizeAt[0] / 1000)]];
  const saw: Point[] = [[bx(1), by(loadAt[1])]];
  for (let n = 1; n <= N; n += 1) {
    if (sizeAt[n] !== sizeAt[n - 1]) { stair.push([ax(n), ay(sizeAt[n - 1] / 1000)], [ax(n), ay(sizeAt[n] / 1000)]); saw.push([bx(n), by(loadAt[n - 1])], [bx(n), by(loadAt[n])]); }
  }
  stair.push([ax(N), ay(sizeAt[N] / 1000)]); saw.push([bx(N), by(loadAt[N])]);
  return { stair: polyline(stair), saw: polyline(saw) };
};
const id = 'dict-growth';
---

<Figure
  id={id}
  title={ru ? 'Как растёт словарь: размер и коэффициент заполнения' : 'How a dict grows: size and load factor'}
  caption={ru
    ? 'Ключи 1, 2, 3, … вставляются в пустой словарь, CPython 3.14.7 на 64-битной macOS (arm64). Слева: sys.getsizeof(d); красные точки — измеренные значения в моменты изменения, синяя линия — модель: 64 байта объекта, 32 байта заголовка таблицы, m байтовых индексов (по 2 байта начиная с m = 256) и 2m/3 записей по 24 байта. Все 10 расширений, при 6, 11, 22, 43, 86, 171, 342, 683 и 1366 ключах, совпадают с моделью. Справа: доля занятых ячеек индексов n/m никогда не превышает 2/3 и сразу после расширения падает примерно до 1/3.'
    : 'The keys 1, 2, 3, … inserted into an empty dict, CPython 3.14.7 on 64-bit macOS (arm64). Left: sys.getsizeof(d); the red dots are measured values where it changes, the blue line is the model: a 64-byte object, a 32-byte table header, m one-byte indices (two bytes from m = 256 on) and 2m/3 entries of 24 bytes. All 10 resizes, at 6, 11, 22, 43, 86, 171, 342, 683 and 1366 keys, agree with the model. Right: the fraction of index slots in use, n/m, never exceeds 2/3 and drops to about 1/3 right after each resize.'}
>
  {layouts.map((L) => {
    const { A, B } = L;
    const ax = scale([0, N], A.x), ay = scale([0, 80], [A.y[1], A.y[0]]);
    const bx = scale([0, N], B.x), by = scale([0, 1], [B.y[1], B.y[0]]);
    const { stair, saw } = paths(ax, ay, bx, by);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Размер словаря и коэффициент заполнения в зависимости от числа ключей' : 'Dict size and load factor against the number of keys'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Слева ступенчатая линия размера, каждая ступенька примерно вдвое выше предыдущей, последняя — 73.8 КБ после 1366 ключей. Справа пилообразная кривая коэффициента заполнения, поднимается до 2/3 и падает примерно до 1/3 при каждом расширении.'
          : 'Left, a staircase of sizes, each step about twice the previous one, the last at 73.8 KB after 1366 keys. Right, a sawtooth of the load factor that rises to 2/3 and falls to about 1/3 at every resize.'}</desc>
        {[0, 20, 40, 60, 80].map((v) => (
          <g>
            <path class="f-grid" d={`M ${A.x[0]} ${ay(v)} H ${A.x[1]}`} />
            <text class="f-small f-t-muted" x={A.x[0] - 8} y={ay(v) + 4} text-anchor="end">{v}</text>
          </g>
        ))}
        {[0, 1 / 3, 2 / 3, 1].map((v, i) => (
          <g>
            <path class="f-grid" d={`M ${B.x[0]} ${by(v)} H ${B.x[1]}`} />
            <text class="f-small f-t-muted" x={B.x[0] - 8} y={by(v) + 4} text-anchor="end">{['0', '1/3', '2/3', '1'][i]}</text>
          </g>
        ))}
        {[0, 700, 1400].map((v) => (
          <g>
            <text class="f-small f-t-muted" x={ax(v)} y={A.y[1] + 18} text-anchor="middle">{v}</text>
            <text class="f-small f-t-muted" x={bx(v)} y={B.y[1] + 18} text-anchor="middle">{v}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${A.x[0]} ${A.y[0] - 6} V ${A.y[1]} H ${A.x[1] + 6} M ${B.x[0]} ${B.y[0] - 6} V ${B.y[1]} H ${B.x[1] + 6}`} />
        <text class="f-small" x={A.x[0] - 40} y={A.y[0] - 18} style="font-weight: 650">{t.tl}</text>
        <text class="f-small" x={B.x[0] - 40} y={B.y[0] - 18} style="font-weight: 650">{t.tr}</text>
        <text class="f-small f-t-muted" x={(A.x[0] + A.x[1]) / 2} y={A.y[1] + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={(B.x[0] + B.x[1]) / 2} y={B.y[1] + 38} text-anchor="middle">{t.x}</text>
        <path class="f-line f-blue" d={stair} />
        {measured.map(([n, b]) => <circle cx={ax(n)} cy={ay(b / 1000)} r="3.4" class="f-solid-red" />)}
        <path class="f-line f-red f-dash" d={`M ${B.x[0]} ${by(2 / 3)} H ${B.x[1]}`} />
        <path class="f-line f-blue" d={saw} />
        <text class="f-small f-t-red f-halo" x={B.x[1] - 4} y={by(2 / 3) - 22} text-anchor="end">{t.two}</text>
        <text class="f-small f-t-blue f-halo" x={B.x[1] - 4} y={by(0.2)} text-anchor="end">{t.third}</text>
      </svg>
    );
  })}
</Figure>
