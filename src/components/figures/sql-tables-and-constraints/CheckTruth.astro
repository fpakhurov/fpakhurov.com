---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const id = 'sql-check-truth';
const ru = pageLang(Astro.url) === 'ru';
const title = ru ? 'Один предикат при чтении и записи' : 'One predicate for reading and writing';
const rows = [
  ['2', 'TRUE', true, true],
  ['0', 'FALSE', false, false],
  ['NULL', 'NULL', false, true],
] as const;
const labels = ['quantity', '> 0', 'WHERE', 'CHECK'];
const columns = [57, 127, 199, 278];
---
<Figure id={id} title={title} caption={ru
  ? 'WHERE пропускает только TRUE. CHECK отклоняет FALSE. В последней строке пропуск остановит отдельное ограничение NOT NULL.'
  : 'WHERE keeps TRUE. CHECK rejects FALSE. A separate NOT NULL constraint rejects the missing value in the last row.'}>
  <svg class="fig-compact" viewBox="0 0 330 152" role="img" aria-labelledby={id + '-title ' + id + '-desc'}>
    <title id={id + '-title'}>{title}</title>
    <desc id={id + '-desc'}>{ru
      ? 'Количество 2 проходит оба условия, 0 не проходит ни одного, NULL не проходит WHERE и удовлетворяет CHECK.'
      : 'Quantity 2 passes both checks, 0 passes neither, and NULL is excluded by WHERE and allowed by CHECK.'}</desc>
    <path d="M 18 34 H 312 M 18 67 H 312 M 18 101 H 312" class="f-axis" />
    {labels.map((label, index) => (
      <text x={columns[index]} y="24" class="f-title" text-anchor="middle">{label}</text>
    ))}
    {rows.map(([quantity, predicate, keep, accept], index) => (
      <g>
        <text x={columns[0]} y={57 + 34 * index} text-anchor="middle">{quantity}</text>
        <text x={columns[1]} y={57 + 34 * index} text-anchor="middle">{predicate}</text>
        {[keep, accept].map((pass, column) => (
          <text x={columns[2 + column]} y={57 + 34 * index} text-anchor="middle"
            class={pass ? 'f-t-green' : 'f-t-red'}>{pass ? (ru ? 'да' : 'pass') : (ru ? 'нет' : 'fail')}</text>
        ))}
      </g>
    ))}
  </svg>
</Figure>
