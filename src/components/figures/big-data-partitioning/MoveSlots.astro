---
import Figure from '../Figure.astro';

const ru = Astro.props.lang === 'ru';
const title = ru ? 'Три слота меняют владельца' : 'Three slots change owner';
const caption = ru
  ? 'Правило выбора слота не меняется. На новый узел D передаём только 9, 10 и 11.'
  : 'The slot function stays fixed. Only slots 9, 10 and 11 move to D.';
const rows = [
  { node: 'A', before: '0, 3, 6, 9', after: '0, 3, 6' },
  { node: 'B', before: '1, 4, 7, 10', after: '1, 4, 7' },
  { node: 'C', before: '2, 5, 8, 11', after: '2, 5, 8' },
  { node: 'D', before: '–', after: '9, 10, 11' },
];
---
<Figure id="big-data-move-slots" title={title} caption={caption}>
  <svg viewBox="0 0 340 168" role="img" aria-labelledby="move-slots-title move-slots-desc" style="max-width: 510px; margin-inline: auto">
    <title id="move-slots-title">{title}</title>
    <desc id="move-slots-desc">{caption}</desc>
    <text class="f-label" x="111" y="22" text-anchor="middle">{ru ? 'До' : 'Before'}</text>
    <text class="f-label" x="263" y="22" text-anchor="middle">{ru ? 'После' : 'After'}</text>
    {rows.map(({node, before, after}, i) => (
      <g transform={`translate(0 ${34 + i * 32})`}>
        <text class="f-label" x="16" y="19">{node}</text>
        <rect class="f-fill-blue" x="39" y="0" width="145" height="28" rx="5" />
        <rect class={node === 'D' ? 'f-fill-green' : 'f-fill-blue'} x="191" y="0" width="145" height="28" rx="5" />
        <text class="f-label" x="111" y="19" text-anchor="middle">{before}</text>
        <text class="f-label" x="263" y="19" text-anchor="middle">{after}</text>
      </g>
    ))}
  </svg>
</Figure>
