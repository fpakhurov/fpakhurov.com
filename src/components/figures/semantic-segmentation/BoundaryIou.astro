---
import Figure from '../Figure.astro';
import { scale, plot } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A disk of radius R predicted as a concentric disk one pixel smaller or one pixel larger (continuous areas).
// IoU of the smaller prediction: ((R − 1)/R)²; of the larger: (R/(R + 1))². Pixel accuracy of the smaller one in a 64 × 64 image.
const shrink = (R: number) => ((R - 1) / R) ** 2;
const grow = (R: number) => (R / (R + 1)) ** 2;
const acc = (R: number) => 1 - (Math.PI * (R * R - (R - 1) ** 2)) / (64 * 64);
const q = [shrink(4).toFixed(2), grow(4).toFixed(2), acc(4).toFixed(4), shrink(20).toFixed(2), grow(20).toFixed(2), acc(20).toFixed(4)].join(' ');
if (q !== '0.56 0.64 0.9946 0.90 0.91 0.9701') throw new Error(`BoundaryIou: values drifted (${q})`);

const t = ru
  ? { title: 'Ошибка в один пиксель на границе: IoU и доля верных пикселей', x: 'радиус объекта R, пикселей', y: 'метрика', s: 'IoU, на 1 пиксель меньше', g: 'IoU, на 1 пиксель больше', a: 'доля верных пикселей (64 × 64)',
      m4: `R = 4: IoU ${shrink(4).toFixed(2)}`, desc: 'Три кривые от радиуса круга R от 2 до 24 пикселей. IoU предсказания на пиксель меньше растёт от 0.25 при R = 2 до 0.92 при R = 24; IoU предсказания на пиксель больше идёт чуть выше. Доля верных пикселей для изображения 64 на 64 всё время выше 0.95.' }
  : { title: 'A one-pixel error at the boundary: IoU against pixel accuracy', x: 'object radius R, pixels', y: 'metric', s: 'IoU, 1 pixel too small', g: 'IoU, 1 pixel too large', a: 'pixel accuracy (64 × 64)',
      m4: `R = 4: IoU ${shrink(4).toFixed(2)}`, desc: 'Three curves against the disk radius R from 2 to 24 pixels. The IoU of a prediction one pixel too small rises from 0.25 at R = 2 to 0.92 at R = 24; the IoU of a prediction one pixel too large runs slightly above it. The pixel accuracy in a 64 by 64 image stays above 0.95 throughout.' };
const id = 'seg-boundary-iou';
const caption = ru
  ? `Круг радиуса R предсказан концентрическим кругом на пиксель меньше (IoU = ((R − 1)/R)²) или больше (IoU = (R/(R + 1))²). Для R = 4, размера кругов из раздела с кодом, IoU равно ${shrink(4).toFixed(2)} и ${grow(4).toFixed(2)}, а доля верных пикселей в изображении 64 × 64 — ${acc(4).toFixed(4)}; для R = 20 IoU ${shrink(20).toFixed(2)} и ${grow(20).toFixed(2)}. Ошибка на границе стоит малому объекту почти половину IoU и почти ничего не стоит доле верных пикселей; поэтому сегментацию сравнивают по IoU, а точные границы — задача обходных связей.`
  : `A disk of radius R predicted as a concentric disk one pixel smaller (IoU = ((R − 1)/R)²) or larger (IoU = (R/(R + 1))²). For R = 4, the size of the disks of the Code section, the IoU is ${shrink(4).toFixed(2)} and ${grow(4).toFixed(2)} while the pixel accuracy in a 64 × 64 image is ${acc(4).toFixed(4)}; for R = 20 the IoU is ${shrink(20).toFixed(2)} and ${grow(20).toFixed(2)}. A boundary error costs a small object almost half its IoU and costs pixel accuracy almost nothing, which is why segmentation is compared by IoU, and why exact boundaries are the job of the skip connections.`;
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 320, px: [70, 470] as [number, number], py: [30, 250] as [number, number], lx: 510, ly: 120 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 400, px: [50, 340] as [number, number], py: [30, 250] as [number, number], lx: 20, ly: 324 },
];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sx = scale([0, 24], L.px), sy = scale([0, 1], [L.py[1], L.py[0]]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {[0.25, 0.5, 0.75, 1].map((v) => <path class="f-grid" d={`M ${L.px[0]} ${sy(v)} H ${L.px[1]}`} />)}
        <path class="f-axis" d={`M ${L.px[0]} ${L.py[0]} V ${L.py[1]} H ${L.px[1]}`} />
        {[0, 4, 8, 12, 16, 20, 24].map((v) => <text class="f-note" x={sx(v)} y={L.py[1] + 18} text-anchor="middle">{v}</text>)}
        {[0, 0.25, 0.5, 0.75, 1].map((v) => <text class="f-note" x={L.px[0] - 7} y={sy(v) + 5} text-anchor="end">{v}</text>)}
        <text class="f-small" x={(L.px[0] + L.px[1]) / 2} y={L.py[1] + 40} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.px[0]} y={L.py[0] - 12}>{t.y}</text>
        <path class="f-line f-muted f-dash" d={plot(acc, 2, 24, sx, sy, 120)} />
        <path class="f-line f-blue" d={plot(grow, 2, 24, sx, sy, 120)} />
        <path class="f-line f-red" d={plot(shrink, 2, 24, sx, sy, 120)} />
        <circle cx={sx(4)} cy={sy(shrink(4))} r="4" class="f-solid-red" />
        <text class="f-small f-halo" x={sx(4) + 10} y={sy(shrink(4)) + 18}>{t.m4}</text>
        <path class="f-line f-red" d={`M ${L.lx} ${L.ly - 4} h 24`} />
        <text class="f-small" x={L.lx + 32} y={L.ly}>{t.s}</text>
        <path class="f-line f-blue" d={`M ${L.lx} ${L.ly + 18} h 24`} />
        <text class="f-small" x={L.lx + 32} y={L.ly + 22}>{t.g}</text>
        <path class="f-line f-muted f-dash" d={`M ${L.lx} ${L.ly + 40} h 24`} />
        <text class="f-small" x={L.lx + 32} y={L.ly + 44}>{t.a}</text>
      </svg>
    );
  })}
</Figure>
