---
import Figure from '../Figure.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// A toy street scene on a 12 × 8 grid: sky (rows 0–2), buildings (rows 3–5), road (rows 6–7), and two cars side by side.
const COLS = 12, ROWS = 8;
const car1 = (r: number, c: number) => r >= 4 && r <= 6 && c >= 2 && c <= 5;
const car2 = (r: number, c: number) => r >= 4 && r <= 6 && c >= 6 && c <= 9;
const stuff = (r: number) => (r <= 2 ? 'sky' : r <= 5 ? 'building' : 'road');
type Cell = { r: number; c: number; fill: string };
const fills: Record<string, string> = {
  sky: 'fill: var(--fig-blue); fill-opacity: 0.22', building: 'fill: var(--muted); fill-opacity: 0.25', road: 'fill: var(--fig-green); fill-opacity: 0.25',
  car: 'fill: var(--fig-red); fill-opacity: 0.6', car1: 'fill: var(--fig-red); fill-opacity: 0.6', car2: 'fill: var(--fig-amber); fill-opacity: 0.7', none: 'fill: none',
};
const cells = (mode: 'semantic' | 'instance' | 'panoptic'): Cell[] => {
  const out: Cell[] = [];
  for (let r = 0; r < ROWS; r += 1) for (let c = 0; c < COLS; c += 1) {
    const thing = car1(r, c) ? 'car1' : car2(r, c) ? 'car2' : '';
    const fill = mode === 'semantic' ? (thing ? 'car' : stuff(r)) : mode === 'instance' ? (thing || 'none') : (thing || stuff(r));
    out.push({ r, c, fill });
  }
  return out;
};
const nCar = cells('semantic').filter((x) => x.fill === 'car').length;
if (nCar !== 24 || cells('instance').filter((x) => x.fill === 'car1').length !== 12) throw new Error('ThreeTasks: scene drifted');

const t = ru
  ? { title: 'Семантическая, экземплярная и паноптическая сегментация', sem: 'семантическая', ins: 'экземплярная', pan: 'паноптическая',
      legend: [['sky', 'небо'], ['building', 'здания'], ['road', 'дорога'], ['car', 'машина'], ['car1', 'машина 1'], ['car2', 'машина 2']] as [string, string][],
      desc: 'Одна и та же игрушечная сцена 12 на 8 клеток в трёх разметках. Семантическая: у каждой клетки класс — небо, здания, дорога или машина; две соседние машины сливаются в одно пятно. Экземплярная: размечены только две машины, каждая своим цветом; фон не размечен. Паноптическая: классы фона как в семантической и отдельные машины как в экземплярной.' }
  : { title: 'Semantic, instance and panoptic segmentation', sem: 'semantic', ins: 'instance', pan: 'panoptic',
      legend: [['sky', 'sky'], ['building', 'building'], ['road', 'road'], ['car', 'car'], ['car1', 'car 1'], ['car2', 'car 2']] as [string, string][],
      desc: 'The same toy scene of 12 by 8 cells under three labellings. Semantic: every cell has a class, sky, building, road or car; the two adjacent cars merge into one blob. Instance: only the two cars are labelled, each in its own colour; the rest is unlabelled. Panoptic: the background classes as in the semantic map and the separate cars as in the instance map.' };
const id = 'seg-three-tasks';
const caption = ru
  ? 'Семантическая сегментация отвечает «какой класс у пикселя» и не различает две соседние машины: это 24 клетки класса «машина». Экземплярная отвечает «какому объекту принадлежит пиксель», но только для счётных объектов (things). Паноптическая даёт каждому пикселю и класс, и, для объектов, номер экземпляра; аморфные области (stuff) — небо, дорога — получают только класс.'
  : 'Semantic segmentation answers "which class is this pixel" and cannot tell the two adjacent cars apart: they are 24 cells of class car. Instance segmentation answers "which object does this pixel belong to", but only for countable things. Panoptic segmentation gives every pixel a class and, for things, an instance id; amorphous stuff such as sky and road gets only a class.';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 236, cell: 18, panels: [[16, 36], [272, 36], [528, 36]], lx: 16, ly: 214, lstepX: 120, lstepY: 0, perRow: 6 },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 296, cell: 13, panels: [[16, 34], [190, 34], [16, 180]], lx: 194, ly: 190, lstepX: 0, lstepY: 19, perRow: 1 },
];
const modes: ['semantic', 'instance', 'panoptic'] = ['semantic', 'instance', 'panoptic'];
const names = [t.sem, t.ins, t.pan];
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
      <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
      <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
      {modes.map((m, k) => (
        <g>
          <text class="f-small" x={L.panels[k][0]} y={L.panels[k][1] - 10}>{names[k]}</text>
          {cells(m).map((x) => (
            <rect x={L.panels[k][0] + x.c * L.cell} y={L.panels[k][1] + x.r * L.cell} width={L.cell} height={L.cell} style={`${fills[x.fill]}; stroke: var(--line); stroke-width: 0.8`} />
          ))}
        </g>
      ))}
      {t.legend.map(([key, label], i) => (
        <g>
          <rect x={L.lx + (i % L.perRow) * L.lstepX} y={L.ly + Math.floor(i / L.perRow) * L.lstepY - 10} width="14" height="12" style={`${fills[key]}; stroke: var(--line); stroke-width: 0.8`} />
          <text class="f-small f-t-muted" x={L.lx + (i % L.perRow) * L.lstepX + 20} y={L.ly + Math.floor(i / L.perRow) * L.lstepY}>{label}</text>
        </g>
      ))}
    </svg>
  ))}
</Figure>
