---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Output stride of the last four stages for a 512 × 512 input: a classification ResNet (strides 4, 8, 16, 32)
// against DeepLabv3 at output stride 16 (the last stage keeps stride 16 and dilates its 3 × 3 convolutions by 2).
const input = 512;
const plain = [4, 8, 16, 32], dilated = [4, 8, 16, 16], rates = [1, 1, 1, 2];
const sizes = (st: number[]) => st.map((s) => input / s);
// A 3 × 3 layer at jump j with dilation r widens the receptive field by 2rj input pixels. The last stage of the plain
// network reads at jump 32 with r = 1, the dilated one at jump 16 with r = 2: the same widening at twice the resolution.
const widen = (j: number, r: number) => 2 * r * j;
const q = [sizes(plain).join(','), sizes(dilated).join(','), widen(32, 1), widen(16, 2)].join(' ');
if (q !== '128,64,32,16 128,64,32,32 64 64') throw new Error(`DilatedBackbone: values drifted (${q})`);
const side = (n: number) => Math.round(6 * Math.sqrt(n));   // drawn side of an n × n map

const t = ru
  ? {
      title: 'Расширенные свёртки сохраняют разрешение: DeepLab и ASPP',
      cls: 'классификационная сеть', dl: 'DeepLabv3, выходной шаг 16', st: (s: number) => `шаг ${s}`, r2: 'r = 2',
      b1: '1 × 1', b6: '3 × 3, r = 6', b12: '3 × 3, r = 12', b18: '3 × 3, r = 18', pool: 'глобальный пулинг', cat: 'конкатенация', catS: 'свёртка 1 × 1', out: 'K классов', outS: '↑ × 16',
      steps: ['классификационная сеть пять раз уменьшает разрешение: последняя карта — 1/32 изображения, 16 × 16 для 512 × 512', 'DeepLab убирает шаг последней стадии и расширяет её свёртки в 2 раза: рецептивное поле то же, а карта остаётся 32 × 32', 'ASPP: параллельные свёртки 3 × 3 с r = 6, 12, 18, свёртка 1 × 1 и пулинг по всему изображению смотрят на разные масштабы сразу', 'ветви конкатенируются, свёртка 1 × 1 даёт K оценок классов, билинейная интерполяция возвращает размер изображения'],
      desc: 'Сверху: четыре стадии классификационной сети с шагами 4, 8, 16, 32 и картами 128, 64, 32 и 16 клеток для входа 512 на 512. Снизу: DeepLabv3 с теми же стадиями, но последняя сохраняет шаг 16 и использует расширение 2, её карта 32 на 32. Справа модуль ASPP: пять параллельных ветвей — свёртка 1 на 1, три свёртки 3 на 3 с расширениями 6, 12 и 18 и глобальный пулинг по изображению — сходятся в конкатенацию со свёрткой 1 на 1 и дают K классов с увеличением в 16 раз.',
    }
  : {
      title: 'Dilated convolutions keep the resolution: DeepLab and ASPP',
      cls: 'classification network', dl: 'DeepLabv3, output stride 16', st: (s: number) => `stride ${s}`, r2: 'r = 2',
      b1: '1 × 1', b6: '3 × 3, r = 6', b12: '3 × 3, r = 12', b18: '3 × 3, r = 18', pool: 'image pooling', cat: 'concatenate', catS: '1 × 1 convolution', out: 'K classes', outS: '↑ × 16',
      steps: ['a classification network halves the resolution five times: its last map is 1/32 of the image, 16 × 16 for 512 × 512', 'DeepLab drops the stride of the last stage and dilates its convolutions by 2: the same field of view, and the map stays 32 × 32', 'ASPP: parallel 3 × 3 convolutions with r = 6, 12, 18, a 1 × 1 convolution and pooling over the whole image look at several scales at once', 'the branches are concatenated, a 1 × 1 convolution gives K class scores, and bilinear upsampling returns to the image size'],
      desc: 'Top: four stages of a classification network with strides 4, 8, 16, 32 and maps of 128, 64, 32 and 16 cells for a 512 by 512 input. Bottom: DeepLabv3 with the same stages, except that the last keeps stride 16 and uses dilation 2, so its map is 32 by 32. Right: the ASPP module, five parallel branches, a 1 by 1 convolution, three 3 by 3 convolutions with dilations 6, 12 and 18, and image pooling, merging into a concatenation with a 1 by 1 convolution that outputs K classes, upsampled 16 times.',
    };
const id = 'seg-deeplab';
const caption = ru
  ? 'Стороны квадратов растут с размером карты. Свёртка 3 × 3 на шаге j с расширением r расширяет рецептивное поле на 2rj пикселей входа: на последней стадии это 64 пикселя и у классификационной сети (j = 32, r = 1), и у DeepLab (j = 16, r = 2), но DeepLab выдаёт карту, вдвое более плотную по каждой оси. Параметров не прибавляется, а вычислений на последней стадии в 4 раза больше. Ветви ASPP в DeepLabv3 по 256 каналов; при выходном шаге 8 расширения удваиваются.'
  : 'Square sides grow with the map size. A 3 × 3 convolution at jump j with dilation r widens the field of view by 2rj input pixels: in the last stage that is 64 pixels both for the classification network (j = 32, r = 1) and for DeepLab (j = 16, r = 2), but DeepLab produces a map twice as dense along each axis. No parameters are added, and the last stage costs 4 times as much. The ASPP branches of DeepLabv3 have 256 channels each; at output stride 8 the rates are doubled.';
// four squares per row, left to right with a fixed gap
const placed = (st: number[]) => {
  let x = 20;
  return st.map((s, i) => {
    const m = { x, side: side(input / s), s, r: st === dilated ? rates[i] : 1 };
    x += m.side + 36;
    return m;
  });
};
const A = placed(plain), B = placed(dilated);
const last = B[3];
const branches = [t.b1, t.b6, t.b12, t.b18, t.pool];
const stroke = (r: number) => (r === 1 ? 'stroke: var(--fig-blue); stroke-width: 1.2' : 'stroke: var(--fig-amber); stroke-width: 2.4');
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 320" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <g data-s="1">
      <text class="f-small f-t-muted" x={36} y={24}>{t.cls}</text>
      {A.map((m) => (
        <g>
          <rect x={m.x} y={84 - m.side / 2} width={m.side} height={m.side} class="f-fill-blue" style={stroke(1)} />
          <text class="f-small" x={m.x + m.side / 2} y={139} text-anchor="middle">{t.st(m.s)}</text>
        </g>
      ))}
      <Badge x={20} y={20} n={1} />
    </g>
    <g data-s="2">
      <text class="f-small f-t-muted" x={36} y={178}>{t.dl}</text>
      {B.map((m) => (
        <g>
          <rect x={m.x} y={234 - m.side / 2} width={m.side} height={m.side} class="f-fill-blue" style={stroke(m.r)} />
          <text class="f-small" x={m.x + m.side / 2} y={289} text-anchor="middle">{t.st(m.s)}</text>
          {m.r === 1 ? null : <text class="f-small f-t-amber" x={m.x + m.side / 2} y={307} text-anchor="middle">{t.r2}</text>}
        </g>
      ))}
      <Badge x={20} y={174} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[last.x + last.side, 234], [430, 234]]} head={false} />
      <path class="f-thin f-muted" d="M 430 74 V 258" />
      {branches.map((b, i) => (
        <g>
          <Arrow pts={[[430, 74 + i * 46], [450, 74 + i * 46]]} />
          <Box x={452} y={56 + i * 46} w={150} h={36} label={b} tone={i === 4 ? 'n' : 'g'} />
        </g>
      ))}
      <Badge x={452} y={48} n={3} />
    </g>
    <g data-s="4">
      <path class="f-thin f-muted" d={[0, 1, 2, 3, 4].map((i) => `M 602 ${74 + i * 46} H 612`).join(' ') + ' M 612 74 V 258'} />
      <Arrow pts={[[612, 140], [624, 140]]} />
      <Box x={626} y={118} w={124} h={44} label={t.cat} sub={t.catS} />
      <Arrow pts={[[688, 162], [688, 186]]} />
      <Box x={626} y={188} w={124} h={44} label={t.out} sub={t.outS} tone="y" />
      <Badge x={626} y={110} n={4} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 560" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <g data-s="1">
      <text class="f-small f-t-muted" x={36} y={28}>{t.cls}</text>
      {A.map((m) => (
        <g>
          <rect x={m.x} y={86 - m.side / 2} width={m.side} height={m.side} class="f-fill-blue" style={stroke(1)} />
          <text class="f-small" x={m.x + m.side / 2} y={146} text-anchor="middle">{String(m.s)}</text>
        </g>
      ))}
      <Badge x={20} y={23} n={1} />
    </g>
    <g data-s="2">
      <text class="f-small f-t-muted" x={36} y={190}>{t.dl}</text>
      {B.map((m) => (
        <g>
          <rect x={m.x} y={248 - m.side / 2} width={m.side} height={m.side} class="f-fill-blue" style={stroke(m.r)} />
          <text class={m.r === 1 ? 'f-small' : 'f-small f-t-amber'} x={m.x + m.side / 2} y={308} text-anchor="middle">{m.r === 1 ? String(m.s) : `${m.s}, ${t.r2}`}</text>
        </g>
      ))}
      <Badge x={20} y={185} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[last.x + last.side, 248], [346, 248], [346, 330], [95, 330], [95, 346]]} />
      {branches.map((b, i) => (
        <Box x={i % 2 === 0 ? 16 : 186} y={348 + Math.floor(i / 2) * 46} w={158} h={36} label={b} tone={i === 4 ? 'n' : 'g'} />
      ))}
      <Badge x={16} y={348} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[174, 458], [184, 458]]} />
      <Box x={186} y={436} w={158} h={44} label={t.cat} sub={t.catS} />
      <Arrow pts={[[265, 480], [265, 500]]} />
      <Box x={186} y={502} w={158} h={44} label={t.out} sub={t.outS} tone="y" />
      <Badge x={186} y={436} n={4} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
