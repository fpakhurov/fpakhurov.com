---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Legend from '../seqflow/Legend.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The tiny U-Net of the Code section: c = 8 channels at full resolution, doubled at each of two poolings; K = 3 classes on 32 × 32 images.
const c = 8, size = 32, K = 3;
const shape = (ch: number, s: number) => `${ch} × ${s}²`;
const S = {
  x: shape(1, size), e1: shape(c, size), e2: shape(2 * c, size / 2), m: shape(4 * c, size / 4),
  d2: shape(2 * c, size / 2), d1: shape(c, size), y: shape(K, size),
};
if ([S.e1, S.e2, S.m, S.y].join(' ') !== '8 × 32² 16 × 16² 32 × 8² 3 × 32²') throw new Error('UNetFlow: shapes drifted');

const t = ru
  ? {
      title: 'U-Net: энкодер, декодер и обходные связи',
      x: 'изображение', e1: 'энкодер 1', e2: 'энкодер 2', m: 'узкое место', d2: 'декодер 2', d1: 'декодер 1', head: 'свёртка 1×1',
      pool: 'max pool 2 × 2', up: 'up-conv 2 × 2', skip: 'копия, конкатенация', cat: 'конкат.',
      steps: ['энкодер: две свёртки 3 × 3, затем max-пулинг 2 × 2 вдвое уменьшает разрешение, следующий блок вдвое увеличивает число каналов', 'узкое место: на карте 8 × 8 каждый нейрон видит большую часть изображения — это контекст, который отличает круг от квадрата', 'декодер: транспонированная свёртка 2 × 2 с шагом 2 вдвое увеличивает разрешение', 'обходные связи: карта энкодера того же размера конкатенируется с картой декодера и возвращает мелкие детали', 'свёртка 1 × 1 превращает признаки каждого пикселя в K = 3 логита классов'],
      desc: 'U-образная схема. Слева сверху вниз: изображение 1 × 32², энкодер 1 с картой 8 × 32², энкодер 2 с картой 16 × 16², внизу узкое место 32 × 8². Справа снизу вверх: декодер 2 с картой 16 × 16², декодер 1 с картой 8 × 32² и свёртка 1 × 1 с выходом 3 × 32². Горизонтальные пунктирные стрелки копируют карты энкодера в декодер того же разрешения.',
    }
  : {
      title: 'U-Net: an encoder, a decoder and skip connections',
      x: 'image', e1: 'encoder 1', e2: 'encoder 2', m: 'bottleneck', d2: 'decoder 2', d1: 'decoder 1', head: '1 × 1 conv',
      pool: 'max pool 2 × 2', up: 'up-conv 2 × 2', skip: 'copy, concatenate', cat: 'concat',
      steps: ['encoder: two 3 × 3 convolutions, then 2 × 2 max pooling halves the resolution and the next block doubles the channels', 'bottleneck: on the 8 × 8 map each unit sees most of the image, the context that tells a disk from a square', 'decoder: a 2 × 2 transposed convolution with stride 2 doubles the resolution', 'skip connections: the encoder map of the same size is concatenated with the decoder map and brings back fine detail', 'a 1 × 1 convolution turns each pixel’s features into K = 3 class logits'],
      desc: 'A U-shaped diagram. Down the left: the image 1 × 32², encoder 1 with an 8 × 32² map, encoder 2 with 16 × 16², and at the bottom the bottleneck with 32 × 8². Up the right: decoder 2 with 16 × 16², decoder 1 with 8 × 32², and a 1 × 1 convolution with output 3 × 32². Horizontal dashed arrows copy the encoder maps into the decoder level of the same resolution.',
    };
const id = 'seg-unet';
const caption = ru
  ? 'Маленькая U-Net из раздела с кодом; размеры — каналы × разрешение. Путь вниз собирает контекст ценой разрешения, путь вверх возвращает разрешение, а обходные связи передают декодеру то, что потерялось при пулинге: точные границы. Транспонированная свёртка 2 × 2 с шагом 2 покрывает выход ровно один раз, без шахматного узора. В оригинальной U-Net пять уровней, от 64 до 1024 каналов, и свёртки без дополнения.'
  : 'The small U-Net of the Code section; shapes are channels × resolution. The way down gathers context at the cost of resolution, the way up restores the resolution, and the skip connections hand the decoder what pooling threw away: exact boundaries. A 2 × 2 transposed convolution with stride 2 covers each output pixel exactly once, so it leaves no checkerboard. The original U-Net has five levels, 64 to 1024 channels, and unpadded convolutions.';
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 340" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <g data-s="1">
      <Box x={10} y={40} w={92} h={46} label={t.x} sub={S.x} tone="x" />
      <Arrow pts={[[102, 63], [116, 63]]} />
      <Box x={118} y={40} w={110} h={46} label={t.e1} sub={S.e1} tone="h" />
      <Arrow pts={[[160, 86], [160, 138]]} />
      <text class="f-small f-t-muted" x={152} y={116} text-anchor="end">{t.pool}</text>
      <Box x={140} y={140} w={110} h={46} label={t.e2} sub={S.e2} tone="h" />
      <Badge x={118} y={40} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[195, 186], [195, 263], [288, 263]]} />
      <text class="f-small f-t-muted" x={187} y={228} text-anchor="end">{t.pool}</text>
      <Box x={290} y={240} w={130} h={46} label={t.m} sub={S.m} tone="h" />
      <Badge x={290} y={240} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[420, 263], [505, 263], [505, 188]]} tone="amber" />
      <text class="f-small f-t-muted" x={513} y={228}>{t.up}</text>
      <Box x={450} y={140} w={110} h={46} label={t.d2} sub={S.d2} tone="h" />
      <Arrow pts={[[530, 140], [530, 88]]} tone="amber" />
      <text class="f-small f-t-muted" x={538} y={116}>{t.up}</text>
      <Box x={470} y={40} w={110} h={46} label={t.d1} sub={S.d1} tone="h" />
      <Badge x={450} y={140} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[228, 63], [468, 63]]} tone="blue" dashed />
      <text class="f-small f-t-blue" x={348} y={55} text-anchor="middle">{t.skip}</text>
      <Arrow pts={[[250, 163], [448, 163]]} tone="blue" dashed />
      <text class="f-small f-t-blue" x={349} y={155} text-anchor="middle">{t.skip}</text>
      <Badge x={242} y={44} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[580, 63], [612, 63]]} />
      <Box x={614} y={40} w={120} h={46} label={t.head} sub={S.y} tone="y" />
      <Badge x={614} y={40} n={5} />
    </g>
    <Legend x={210} y={326} step={120} rows={1} />
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 424" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <g data-s="1">
      <Box x={10} y={16} w={100} h={46} label={t.x} sub={S.x} tone="x" />
      <Arrow pts={[[60, 62], [60, 98]]} />
      <Box x={10} y={100} w={100} h={46} label={t.e1} sub={S.e1} tone="h" />
      <Arrow pts={[[50, 146], [50, 198]]} />
      <text class="f-small f-t-muted" x={44} y={178} text-anchor="end">÷2</text>
      <Box x={30} y={200} w={100} h={46} label={t.e2} sub={S.e2} tone="h" />
      <Badge x={10} y={100} n={1} />
    </g>
    <g data-s="2">
      <Arrow pts={[[80, 246], [80, 323], [118, 323]]} />
      <text class="f-small f-t-muted" x={74} y={290} text-anchor="end">÷2</text>
      <Box x={120} y={300} w={120} h={46} label={t.m} sub={S.m} tone="h" />
      <Badge x={120} y={300} n={2} />
    </g>
    <g data-s="3">
      <Arrow pts={[[240, 323], [280, 323], [280, 248]]} tone="amber" />
      <text class="f-small f-t-muted" x={288} y={290}>×2</text>
      <Box x={230} y={200} w={100} h={46} label={t.d2} sub={S.d2} tone="h" />
      <Arrow pts={[[310, 200], [310, 148]]} tone="amber" />
      <text class="f-small f-t-muted" x={318} y={178}>×2</text>
      <Box x={250} y={100} w={100} h={46} label={t.d1} sub={S.d1} tone="h" />
      <Badge x={230} y={200} n={3} />
    </g>
    <g data-s="4">
      <Arrow pts={[[110, 123], [248, 123]]} tone="blue" dashed />
      <text class="f-small f-t-blue" x={180} y={116} text-anchor="middle">{t.cat}</text>
      <Arrow pts={[[130, 223], [228, 223]]} tone="blue" dashed />
      <text class="f-small f-t-blue" x={179} y={216} text-anchor="middle">{t.cat}</text>
      <Badge x={140} y={106} n={4} />
    </g>
    <g data-s="5">
      <Arrow pts={[[300, 100], [300, 64]]} />
      <Box x={250} y={16} w={100} h={46} label={t.head} sub={S.y} tone="y" />
      <Badge x={250} y={16} n={5} />
    </g>
    <Legend x={16} y={386} step={170} rows={2} />
  </svg>
  <Stepper steps={t.steps} />
</Figure>
