---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The scripted agent of the Code section. It searches (1 step), opens the files that mention the function in a random
// order until it finds the definition (1, 2 or 3 steps, equally likely), and then:
//  - with verification: writes a reproduction test (1 step) and repeats "sample a fix, edit, run the tests" until the
//    visible tests pass, then submits. A fix is correct with c = 3/8 (edit, test, submit: 3 steps, resolved), wrong but
//    passing the visible tests with h = 1/8 (3 steps, not resolved), wrong and caught by the tests with 3/8 (edit, test:
//    2 steps, retry), a syntax error caught by the linter with 1/8 (1 step, retry);
//  - without verification: edits once and submits (2 steps), resolved with probability c = 3/8.
// P(resolved within B steps) is computed exactly by propagating the distribution of the step count.
const c = 3 / 8, h = 1 / 8, caught = 3 / 8, lint = 1 / 8, Bmax = 30;
function successByBudget(verify: boolean): number[] {
  const done = new Array(Bmax + 1).fill(0);
  let frontier = new Map<number, number>();
  for (const k of [1, 2, 3]) frontier.set(1 + k + (verify ? 1 : 0), 1 / 3);
  if (!verify) {
    for (const [s, p] of frontier) if (s + 2 <= Bmax) done[s + 2] += p * c;
  } else {
    while (frontier.size) {
      const next = new Map<number, number>();
      for (const [s, p] of frontier) {
        if (s + 3 <= Bmax) done[s + 3] += p * c;
        for (const [cost, q] of [[2, caught], [1, lint]] as [number, number][]) {
          if (s + cost <= Bmax) next.set(s + cost, (next.get(s + cost) ?? 0) + p * q);
        }
      }
      frontier = next;
    }
  }
  const cum: number[] = [];
  done.reduce((acc, v, i) => ((cum[i] = acc + v), acc + v), 0);
  return cum;
}
const ver = successByBudget(true), raw = successByBudget(false);
const limit = c / (c + h);
const quoted = [6, 8, 10, 15, 20, 30].map((B) => ver[B].toFixed(3)).join(' ') + ' | ' + [4, 5, 6].map((B) => raw[B].toFixed(3)).join(' ');
if (quoted !== '0.125 0.455 0.612 0.729 0.747 0.750 | 0.125 0.250 0.375') throw new Error(`StepBudget: numbers drifted from the note (${quoted})`);
if (Math.abs(limit - 0.75) > 1e-12 || Math.abs(raw[Bmax] - c) > 1e-12) throw new Error('StepBudget: limits drifted');

const t = ru
  ? { title: 'Доля решённых задач в зависимости от бюджета шагов', x: 'бюджет шагов B', y: 'доля решённых',
      ver: 'правка, тесты, повтор (с линтером)', raw: 'отправить первую правку (без тестов)',
      lim: 'предел c/(c+h) = 0.75', limRaw: 'c = 0.375',
      desc: 'Две ступенчатые кривые доли решённых задач при бюджете шагов от 0 до 30. Агент без тестов отправляет первую правку: его кривая доходит до 0.375 уже при 6 шагах и дальше не растёт. Агент, который проверяет правки тестами, начинает с 0.125 при 6 шагах, достигает 0.612 при 10 шагах и приближается к пределу 0.75.' }
  : { title: 'Success rate against the step budget', x: 'step budget B', y: 'success rate',
      ver: 'edit, test, retry (linter on)', raw: 'submit the first edit (no tests)',
      lim: 'limit c/(c+h) = 0.75', limRaw: 'c = 0.375',
      desc: 'Two staircase curves of the success rate for step budgets from 0 to 30. The agent without tests submits its first edit: its curve reaches 0.375 at 6 steps and stays there. The agent that checks its edits with tests starts at 0.125 at 6 steps, reaches 0.612 at 10 steps and approaches the limit 0.75.' };
const id = 'step-budget';
const caption = ru
  ? `Точные вероятности для заскриптованного агента из раздела «Код»: каждая предложенная правка верна с вероятностью c = 3/8, неверна, но проходит видимые тесты с h = 1/8, ловится тестами с 3/8 и линтером с 1/8. Проверка стоит шагов: при малом бюджете агент с тестами решает меньше задач, чем агент, отправляющий первую правку. С ростом бюджета он повторяет попытки и приближается к c/(c+h) = 0.75, вдвое выше. При B = 10 доля равна ${ver[10].toFixed(3)}.`
  : `Exact probabilities for the scripted agent of the Code section: each proposed fix is correct with probability c = 3/8, wrong but passing the visible tests with h = 1/8, caught by the tests with 3/8 and by the linter with 1/8. Verification costs steps: with a small budget the agent that tests solves fewer tasks than the one that submits its first edit. With a larger budget it retries and approaches c/(c+h) = 0.75, twice as high. At B = 10 the rate is ${ver[10].toFixed(3)}.`;

const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 330, px: [70, 740] as [number, number], py: [40, 270] as [number, number], leg: [420, 200, 22] as [number, number, number] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 400, px: [52, 344] as [number, number], py: [40, 250] as [number, number], leg: [52, 330, 24] as [number, number, number] },
];
const yTicks = [0, 0.2, 0.4, 0.6, 0.8], xTicks = [0, 5, 10, 15, 20, 25, 30];
const stairs = (v: number[], sx: (x: number) => number, sy: (y: number) => number) =>
  polyline(v.flatMap((y, B) => (B < Bmax ? [[sx(B), sy(y)], [sx(B + 1), sy(y)]] : [[sx(B), sy(y)]]) as [number, number][]));
---

<Figure id={id} title={t.title} caption={caption}>
  {layouts.map((L) => {
    const sx = scale([0, Bmax], L.px), sy = scale([0, 0.8], [L.py[1], L.py[0]]);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.sfx}-t ${id}-${L.sfx}-d`}>
        <title id={`${id}-${L.sfx}-t`}>{t.title}</title>
        <desc id={`${id}-${L.sfx}-d`}>{t.desc}</desc>
        {yTicks.map((v) => <path class="f-grid" d={`M ${L.px[0]} ${sy(v)} H ${L.px[1]}`} />)}
        <path class="f-axis" d={`M ${L.px[0]} ${L.py[0] - 6} V ${L.py[1]} H ${L.px[1]}`} />
        {yTicks.map((v) => <text class="f-small" x={L.px[0] - 7} y={sy(v) + 4} text-anchor="end">{v.toFixed(1)}</text>)}
        {xTicks.map((v) => <text class="f-small" x={sx(v)} y={L.py[1] + 18} text-anchor="middle">{String(v)}</text>)}
        <text class="f-small f-t-muted" x={(L.px[0] + L.px[1]) / 2} y={L.py[1] + 38} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={L.px[0] - 40} y={L.py[0] - 20}>{t.y}</text>
        <path class="f-line f-blue f-dash" d={`M ${sx(0)} ${sy(limit)} H ${L.px[1]}`} style="stroke-width: 1.1" />
        <text class="f-small f-t-blue f-halo" x={L.px[1]} y={sy(limit) - 8} text-anchor="end">{t.lim}</text>
        <text class="f-small f-t-red f-halo" x={L.px[1]} y={sy(c) - 8} text-anchor="end">{t.limRaw}</text>
        <path class="f-line f-red" d={stairs(raw, sx, sy)} />
        <path class="f-line f-blue" d={stairs(ver, sx, sy)} />
        <circle cx={sx(10)} cy={sy(ver[10])} r="3.2" class="f-solid-blue" />
        <text class="f-small f-t-blue f-halo" x={sx(10) + 6} y={sy(ver[10]) + 16}>{ver[10].toFixed(3)}</text>
        {[[t.ver, 'f-line f-blue', 'f-t-blue'], [t.raw, 'f-line f-red', 'f-t-red']].map(([label, cl, tc], i) => (
          <g>
            <path class={cl} d={`M ${L.leg[0]} ${L.leg[1] + i * L.leg[2] - 4} h 22`} />
            <text class={`f-small ${tc}`} x={L.leg[0] + 30} y={L.leg[1] + i * L.leg[2]}>{label}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
