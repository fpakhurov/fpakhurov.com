---
import Figure from '../Figure.astro';
import Box from '../seqflow/Box.astro';
import Arrow from '../seqflow/Arrow.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The loop of a coding agent on one SWE-bench-style task: localize, reproduce, edit, test (back to edit on a failure),
// submit, and the hidden grading. Steps 1-4 run inside a sandbox that holds the repository and a shell.
const t = ru
  ? {
      title: 'Цикл агента для программирования на одной задаче',
      issue: 'описание', issueSub: 'медиана, чётное n',
      s1: 'локализация', s1s: 'поиск, открытие',
      s2: 'воспроизведение', s2s: 'написать тест',
      s3: 'правка', s3s: 'замена + линтер',
      s4: 'тесты', s4s: 'видимые тесты',
      s5: 'отправка', s5s: 'патч',
      s6: 'оценивание', s6s: 'скрытые F2P + P2P',
      repo: 'репозиторий и оболочка', repoSub: 'файлы, история git, Python, запуск тестов',
      repoN: 'репозиторий', repoNs: 'и оболочка',
      sandbox: 'песочница: контейнер на задачу', fail1: 'тесты', fail2: 'упали', fail: 'тесты упали',
      act: 'действие', obs: 'наблюдение',
      steps: ['локализация: найти и открыть файл, где определена функция из описания', 'воспроизведение: превратить пример из описания в тест', 'правка: заменить строку; правку с синтаксической ошибкой линтер отклоняет', 'тесты: запустить видимые тесты; при неудаче вернуться к правке', 'отправка: патч — это разница между репозиторием и его исходным состоянием', 'оценивание: скрытые тесты FAIL_TO_PASS и PASS_TO_PASS определяют, решена ли задача'],
      desc: 'Слева сверху описание проблемы. Внутри песочницы четыре шага в ряд: локализация, воспроизведение, правка, тесты; каждый шаг посылает действие в репозиторий с оболочкой и получает наблюдение. Стрелка от тестов назад к правке означает повтор при неудаче. Когда тесты пройдены, агент отправляет патч, и вне песочницы его оценивают скрытые тесты FAIL_TO_PASS и PASS_TO_PASS.',
    }
  : {
      title: 'The loop of a coding agent on one task',
      issue: 'issue', issueSub: 'even-length median',
      s1: 'localize', s1s: 'search, open',
      s2: 'reproduce', s2s: 'write a test',
      s3: 'edit', s3s: 'str_replace + lint',
      s4: 'test', s4s: 'run visible tests',
      s5: 'submit', s5s: 'the patch',
      s6: 'grader', s6s: 'hidden F2P + P2P',
      repo: 'repository and shell', repoSub: 'files, git history, Python, test runner',
      repoN: 'repository', repoNs: 'and shell',
      sandbox: 'sandbox: one container per task', fail1: 'tests', fail2: 'fail', fail: 'tests fail',
      act: 'action', obs: 'observation',
      steps: ['localize: find and open the file that defines the function named in the issue', 'reproduce: turn the example of the issue into a test', 'edit: replace a line; the linter rejects an edit with a syntax error', 'test: run the visible tests; on a failure go back to the edit', 'submit: the patch is the difference between the repository and its starting state', 'grade: the hidden FAIL_TO_PASS and PASS_TO_PASS tests decide whether the task is resolved'],
      desc: 'At the top left, the issue. Inside a sandbox, four steps in a row: localize, reproduce, edit, test; each step sends an action to the repository and shell and receives an observation. An arrow from test back to edit marks the retry after a failure. After the tests pass the agent submits the patch, and outside the sandbox the hidden FAIL_TO_PASS and PASS_TO_PASS tests grade it.',
    };
const id = 'coding-agent-loop';
const caption = ru
  ? 'Шаги 1–4 выполняются в песочнице, где есть копия репозитория и оболочка; каждое действие агента (красные стрелки) возвращает наблюдение (зелёные): список совпадений поиска, текст файла, результат линтера, вывод тестов. Петля «правка — тесты» повторяется, пока видимые тесты не пройдут или не кончится бюджет шагов. Тесты, по которым задачу оценивают, агенту не показывают: тест воспроизведения он пишет сам, по примеру из описания.'
  : 'Steps 1–4 run in a sandbox that holds a copy of the repository and a shell; every action of the agent (red arrows) returns an observation (green): the hits of a search, the text of a file, the verdict of the linter, the output of the tests. The edit–test loop repeats until the visible tests pass or the step budget runs out. The tests that grade the task are not shown to the agent: it writes its reproduction test itself, from the example in the issue.';

const W = { xs: [16, 166, 316, 466], y: 122, w: 130, h: 50 };
const labels = [[t.s1, t.s1s], [t.s2, t.s2s], [t.s3, t.s3s], [t.s4, t.s4s]];
const N = { x: 62, w: 164, h: 46, ys: [78, 144, 210, 276] };
if (N.ys[3] + N.h > 64 + 290 - 20) throw new Error('CodingAgentLoop: the narrow column runs into the sandbox label');
---

<Figure id={id} title={t.title} caption={caption}>
  <svg class="fig-wide" viewBox="0 0 760 300" role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>{t.title}</title>
    <desc id={`${id}-w-d`}>{t.desc}</desc>
    <rect x="8" y="80" width="598" height="206" rx="10" style="fill: none; stroke: var(--muted); stroke-width: 1.2; stroke-dasharray: 6 4" />
    <text class="f-small f-t-muted" x="596" y="278" text-anchor="end">{t.sandbox}</text>
    <Box x={16} y={14} w={130} h={44} label={t.issue} sub={t.issueSub} tone="x" />
    <g>
      <path class="f-line f-red" d="M 440 32 h 22" /><text class="f-small f-t-red" x="468" y="36">{t.act}</text>
      <path class="f-line f-green" d="M 540 32 h 22" /><text class="f-small f-t-green" x="568" y="36">{t.obs}</text>
    </g>
    <Box x={16} y={206} w={580} h={46} label={t.repo} sub={t.repoSub} tone="h" />
    {W.xs.map((x, i) => (
      <g data-s={String(i + 1)}>
        {i === 0 ? <Arrow pts={[[81, 58], [81, 120]]} tone="green" /> : <Arrow pts={[[x - 20, W.y + 25], [x - 2, W.y + 25]]} />}
        <Box x={x} y={W.y} w={W.w} h={W.h} label={labels[i][0]} sub={labels[i][1]} tone="g" />
        <Arrow pts={[[x + 53, W.y + W.h], [x + 53, 204]]} tone="red" />
        <Arrow pts={[[x + 77, 206], [x + 77, W.y + W.h + 2]]} tone="green" />
        <Badge x={x + W.w - 12} y={W.y} n={i + 1} />
        {i === 3 && (
          <g>
            <Arrow pts={[[x + 50, W.y], [x + 50, 102], [x - 85, 102], [x - 85, W.y - 2]]} tone="amber" />
            <text class="f-small f-t-amber f-halo" x={x - 18} y="97" text-anchor="middle">{t.fail}</text>
          </g>
        )}
      </g>
    ))}
    <g data-s="5">
      <Arrow pts={[[596, 147], [620, 147]]} />
      <Box x={622} y={122} w={124} h={50} label={t.s5} sub={t.s5s} tone="y" />
      <Badge x={734} y={122} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[684, 172], [684, 204]]} tone="red" />
      <Box x={622} y={206} w={124} h={50} label={t.s6} sub={t.s6s} tone="y" />
      <Badge x={734} y={206} n={6} />
    </g>
  </svg>
  <svg class="fig-narrow seq-narrow" viewBox="0 0 360 430" role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>{t.title}</title>
    <desc id={`${id}-n-d`}>{t.desc}</desc>
    <rect x="4" y="64" width="350" height="290" rx="10" style="fill: none; stroke: var(--muted); stroke-width: 1.2; stroke-dasharray: 6 4" />
    <text class="f-small f-t-muted" x="344" y="346" text-anchor="end">{t.sandbox}</text>
    <Box x={N.x} y={8} w={N.w} h={44} label={t.issue} sub={t.issueSub} tone="x" />
    <Box x={250} y={78} w={96} h={244} label={t.repoN} sub={t.repoNs} tone="h" />
    {N.ys.map((y, i) => (
      <g data-s={String(i + 1)}>
        {i === 0 ? <Arrow pts={[[144, 52], [144, 76]]} tone="green" /> : <Arrow pts={[[144, y - 20], [144, y - 2]]} />}
        <Box x={N.x} y={y} w={N.w} h={N.h} label={labels[i][0]} sub={labels[i][1]} tone="g" />
        <Arrow pts={[[226, y + 15], [248, y + 15]]} tone="red" />
        <Arrow pts={[[250, y + 31], [228, y + 31]]} tone="green" />
        <Badge x={N.x + N.w - 12} y={y} n={i + 1} />
        {i === 3 && (
          <g>
            <Arrow pts={[[N.x, y + 23], [48, y + 23], [48, N.ys[2] + 23], [N.x - 2, N.ys[2] + 23]]} tone="amber" />
            <text class="f-small f-t-amber" x="44" y={N.ys[2] + 58} text-anchor="end">{t.fail1}</text>
            <text class="f-small f-t-amber" x="44" y={N.ys[2] + 74} text-anchor="end">{t.fail2}</text>
          </g>
        )}
      </g>
    ))}
    <g data-s="5">
      <Arrow pts={[[90, 322], [90, 372]]} />
      <Box x={N.x} y={374} w={N.w} h={46} label={t.s5} sub={t.s5s} tone="y" />
      <Badge x={N.x + N.w - 12} y={374} n={5} />
    </g>
    <g data-s="6">
      <Arrow pts={[[226, 397], [248, 397]]} tone="red" />
      <Box x={250} y={374} w={96} h={46} label={t.s6} sub="F2P + P2P" tone="y" />
      <Badge x={334} y={374} n={6} />
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
