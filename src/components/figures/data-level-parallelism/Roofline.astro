---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The roofline of an NVIDIA A100 (40 GB): attainable FLOP/s = min(P, I * B) with B = 1.555 TB/s and two peaks,
// 19.5 TFLOP/s in FP32 and 312 TFLOP/s on the FP16 tensor cores. Both axes are log10.
const B = 1.555; // TB/s
const P32 = 19.5, P16 = 312; // TFLOP/s
const att = (I: number, P: number) => Math.min(P, I * B);
const mm = (n: number, size: number) => (2 * n ** 3) / (3 * n * n * size);
const kernels = [
  { key: 'add', I: 1 / 12, P: P32 },
  { key: 'saxpy', I: 2 / 12, P: P32 },
  { key: 'mm64', I: mm(64, 4), P: P32 },
  { key: 'mm32', I: mm(4096, 4), P: P32 },
  { key: 'mm16', I: mm(4096, 2), P: P16 },
].map((k) => ({ ...k, A: att(k.I, k.P) }));
const r32 = P32 / B, r16 = P16 / B;
const fx = (v: number, d: number) => v.toFixed(d);
if (fx(r32, 1) !== '12.5' || fx(r16, 1) !== '200.6') throw new Error(`ridge points ${r32} ${r16}`);
const got = kernels.map((k) => `${fx(k.I, 3)}:${fx(k.A, 3)}`).join(' ');
if (got !== '0.083:0.130 0.167:0.259 10.667:16.587 682.667:19.500 1365.333:312.000') throw new Error(`kernels ${got}`);

const names = ru
  ? { add: ['сложение векторов', 'сложение'], saxpy: ['saxpy', 'saxpy'], mm64: ['matmul n = 64', 'n = 64'], mm32: ['matmul n = 4096, fp32', 'n = 4096 fp32'], mm16: ['matmul n = 4096, fp16', 'n = 4096 fp16'] }
  : { add: ['vector add', 'add'], saxpy: ['saxpy', 'saxpy'], mm64: ['matmul n = 64', 'n = 64'], mm32: ['matmul n = 4096, fp32', 'n = 4096 fp32'], mm16: ['matmul n = 4096, fp16', 'n = 4096 fp16'] };
const t = ru
  ? { x: 'арифметическая интенсивность I, FLOP/байт', xs: 'I, FLOP/байт', y: 'TFLOP/с', p32: 'пик FP32: 19.5 TFLOP/с', p32s: 'FP32 19.5', p16: 'пик тензорных ядер FP16: 312', p16s: 'FP16 312', mem: 'память: 1.555 ТБ/с', mems: '1.555 ТБ/с', ridge: 'перегиб' }
  : { x: 'arithmetic intensity I, FLOP/byte', xs: 'I, FLOP/byte', y: 'TFLOP/s', p32: 'FP32 peak: 19.5 TFLOP/s', p32s: 'FP32 19.5', p16: 'FP16 tensor peak: 312', p16s: 'FP16 312', mem: 'memory: 1.555 TB/s', mems: '1.555 TB/s', ridge: 'ridge' };

// label placement per kernel: [dx, dy, anchor] relative to the point
type Place = [number, number, 'start' | 'middle' | 'end'];
interface Layout { cls: string; W: number; H: number; wide: boolean; box: [number, number, number, number]; place: Record<string, Place>; memAt: [number, number] }
const layouts: Layout[] = [
  {
    cls: 'fig-wide', W: 760, H: 348, wide: true, box: [72, 24, 740, 300], memAt: [96, 292],
    place: { add: [8, 16, 'start'], saxpy: [-6, -22, 'end'], mm64: [12, 20, 'start'], mm32: [0, 24, 'middle'], mm16: [0, 24, 'middle'] },
  },
  {
    cls: 'fig-narrow', W: 360, H: 380, wide: false, box: [52, 24, 340, 330], memAt: [100, 300],
    place: { add: [8, 14, 'start'], saxpy: [-8, -6, 'end'], mm64: [-6, -8, 'end'], mm32: [0, 22, 'middle'], mm16: [0, 26, 'middle'] },
  },
];
const xt = [-2, -1, 0, 1, 2, 3, 4];
const yt = [-2, -1, 0, 1, 2, 3];
const tickX = (l: number) => (l === 4 ? '10⁴' : String(10 ** l).replace(/^0\./, '0.'));
const id = 'roofline';
---

<Figure
  id={id}
  title={ru ? 'Модель roofline для NVIDIA A100' : 'The roofline of an NVIDIA A100'}
  caption={ru
    ? `Достижимая производительность min(P, I·B) в зависимости от арифметической интенсивности I для A100 (40 ГБ): наклонная крыша — пропускная способность памяти B = 1.555 ТБ/с, горизонтальные — пики 19.5 TFLOP/с в FP32 и 312 TFLOP/с на тензорных ядрах FP16. Точки перегиба при I = 12.5 и 200.6 FLOP/байт отделяют задачи, ограниченные памятью, от ограниченных вычислениями. Сложение векторов (I = 0.083) и saxpy (0.167) лежат на крыше памяти, далеко от пика; произведение матриц n × n, если каждая матрица проходит через память один раз, имеет I = n/6 в FP32: при n = 64 это 10.7, ещё чуть ниже точки перегиба, при n = 4096 — 683, и задача упирается в пик. Обе оси логарифмические.`
    : `Attainable performance min(P, I·B) against arithmetic intensity I for an A100 (40 GB): the slanted roof is the memory bandwidth B = 1.555 TB/s, the flat roofs are the peaks of 19.5 TFLOP/s in FP32 and 312 TFLOP/s on the FP16 tensor cores. The ridge points at I = 12.5 and 200.6 FLOP/byte separate memory-bound from compute-bound work. Vector addition (I = 0.083) and saxpy (0.167) sit on the memory roof, far below the peak; an n × n matrix product in which each matrix crosses the memory boundary once has I = n/6 in FP32: 10.7 for n = 64, still just below the ridge, and 683 for n = 4,096, which reaches the peak. Both axes are logarithmic.`}
>
  {layouts.map((L) => {
    const [x0, y0, x1, y1] = L.box;
    const sx = scale([-2, 4], [x0, x1]);
    const sy = scale([-2, 3], [y1, y0]);
    const X = (I: number) => sx(Math.log10(I)), Y = (v: number) => sy(Math.log10(v));
    const memLine = `M ${X(0.01)} ${Y(0.01 * B)} L ${X(r16)} ${Y(P16)}`;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Достижимая производительность A100 в зависимости от арифметической интенсивности' : 'Attainable performance of an A100 against arithmetic intensity'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Логарифмический график. Наклонная линия памяти поднимается слева направо и упирается в горизонтальную линию 19.5 TFLOP/с при интенсивности 12.5 и в линию 312 TFLOP/с при 200.6. Точки сложения векторов и saxpy лежат на наклонной линии около 0.1 TFLOP/с; произведение матриц 64 × 64 чуть ниже первой точки перегиба, 4096 × 4096 — на горизонтальных линиях.'
          : 'A log-log plot. The slanted memory line rises from left to right and meets the flat line at 19.5 TFLOP/s at intensity 12.5 and the flat line at 312 TFLOP/s at 200.6. The points for vector addition and saxpy lie on the slanted line near 0.1 TFLOP/s; the 64 × 64 matrix product lies just below the first ridge, the 4,096 × 4,096 products on the flat lines.'}</desc>
        {xt.map((l) => (
          <g>
            <path class="f-grid" d={`M ${sx(l)} ${y0} V ${y1}`} />
            <text class="f-small f-t-muted" x={sx(l)} y={y1 + 18} text-anchor="middle">{tickX(l)}</text>
          </g>
        ))}
        {yt.map((l) => (
          <g>
            <path class="f-grid" d={`M ${x0} ${sy(l)} H ${x1}`} />
            <text class="f-small f-t-muted" x={x0 - 6} y={sy(l) + 4.5} text-anchor="end">{String(10 ** l)}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${x0} ${y0} V ${y1} H ${x1}`} />
        <text class="f-small f-t-muted" x={x1} y={y1 + 36} text-anchor="end">{L.wide ? t.x : t.xs}</text>
        <text class="f-small f-t-muted f-halo" x={x0 + 6} y={y0 + 14}>{t.y}</text>
        {[r32, r16].map((r) => (
          <g>
            <path class="f-line f-muted f-dot" d={`M ${X(r)} ${y1} V ${Y(r === r32 ? P32 : P16)}`} />
            <text class="f-small f-t-muted f-halo" x={X(r) + 4} y={y1 - 8}>{L.wide ? `${t.ridge} ${fx(r, 1)}` : fx(r, 1)}</text>
          </g>
        ))}
        <path class="f-line f-red f-bold" d={memLine} />
        <path class="f-line f-blue f-bold" d={`M ${X(r32)} ${Y(P32)} H ${x1}`} />
        <path class="f-line f-blue f-bold" d={`M ${X(r16)} ${Y(P16)} H ${x1}`} />
        <text class="f-small f-t-blue f-halo" x={x1} y={Y(P32) - 8} text-anchor="end">{L.wide ? t.p32 : t.p32s}</text>
        <text class="f-small f-t-blue f-halo" x={x1} y={Y(P16) - 8} text-anchor="end">{L.wide ? t.p16 : t.p16s}</text>
        <text class="f-small f-t-red f-halo" x={L.memAt[0]} y={L.memAt[1]}>{L.wide ? t.mem : t.mems}</text>
        {kernels.map((k) => {
          const [dx, dy, anc] = L.place[k.key];
          const px = X(k.I), py = Y(k.A);
          return (
            <g>
              <circle cx={px} cy={py} r="4.5" class="f-solid-green" />
              <text class="f-small f-halo" x={px + dx} y={py + dy} text-anchor={anc}>{names[k.key as keyof typeof names][L.wide ? 0 : 1]}</text>
            </g>
          );
        })}
      </svg>
    );
  })}
</Figure>
