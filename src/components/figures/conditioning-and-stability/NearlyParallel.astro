---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

type V = [number, number];
// Two 2 × 2 systems with the solution (1, 1); the second right-hand side entry is raised by 0.05.
// Left: x1 + x2 = 2, x1 − x2 = 0. Right: x1 + x2 = 2, x1 + 1.1 x2 = 2.1.
const solve = (a: number[][], b: V): V => { const d = a[0][0] * a[1][1] - a[0][1] * a[1][0]; return [(b[0] * a[1][1] - a[0][1] * b[1]) / d, (a[0][0] * b[1] - a[1][0] * b[0]) / d]; };
const cond = (a: number[][]) => {
  // singular values of a 2 × 2 matrix from the eigenvalues of aᵀa
  const p = a[0][0] ** 2 + a[1][0] ** 2, q = a[0][0] * a[0][1] + a[1][0] * a[1][1], r = a[0][1] ** 2 + a[1][1] ** 2;
  const m = (p + r) / 2, dd = Math.sqrt(((p - r) / 2) ** 2 + q * q);
  return Math.sqrt((m + dd) / (m - dd));
};
const delta = 0.05;
const systems = [
  { key: 'good', A: [[1, 1], [1, -1]], b: [2, 0] as V },
  { key: 'bad', A: [[1, 1], [1, 1.1]], b: [2, 2.1] as V },
].map((sy) => {
  const x = solve(sy.A, sy.b), xp = solve(sy.A, [sy.b[0], sy.b[1] + delta]);
  const move = Math.hypot(xp[0] - x[0], xp[1] - x[1]);
  const amp = (move / Math.hypot(x[0], x[1])) / (delta / Math.hypot(sy.b[0], sy.b[1]));
  return { ...sy, x, xp, move, amp, kappa: cond(sy.A), arrow: move > 0.1 };
});
const got = systems.map((s) => [s.x.map((v) => v.toFixed(3)).join(','), s.xp.map((v) => v.toFixed(3)).join(','), s.move.toFixed(3), s.amp.toFixed(1), s.kappa.toFixed(1)].join(' ')).join(' | ');
if (got !== '1.000,1.000 1.025,0.975 0.035 1.0 1.0 | 1.000,1.000 0.500,1.500 0.707 29.0 42.1') throw new Error(`NearlyParallel: numbers drifted: ${got}`);

// a line a1 x1 + a2 x2 = c across the plotting window, as two end points
const dom = { x: [-0.2, 2.2] as V, y: [-0.2, 2.2] as V };
const seg = (a1: number, a2: number, c: number): V[] => (Math.abs(a2) > Math.abs(a1)
  ? [[dom.x[0], (c - a1 * dom.x[0]) / a2], [dom.x[1], (c - a1 * dom.x[1]) / a2]]
  : [[(c - a2 * dom.y[0]) / a1, dom.y[0]], [(c - a2 * dom.y[1]) / a1, dom.y[1]]]);

const id = 'nearly-parallel';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 380, unit: 128, boxes: [[40, 34], [420, 34]] as V[] },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 800, unit: 128, boxes: [[26, 34], [26, 432]] as V[] },
];
const T = ru
  ? [{ t: 'κ = 1: прямые перпендикулярны', m: 'решение сдвинулось на 0.035' }, { t: 'κ = 42: прямые почти параллельны', m: 'решение сдвинулось на 0.707' }]
  : [{ t: 'κ = 1: perpendicular lines', m: 'the solution moves by 0.035' }, { t: 'κ = 42: nearly parallel lines', m: 'the solution moves by 0.707' }];
---

<Figure
  id={id}
  title={ru ? 'Малое изменение данных, большое изменение решения' : 'A small change in the data, a large change in the solution'}
  caption={ru
    ? 'Две системы 2 × 2 с решением (1, 1), изображённые как пары прямых; у пунктирной прямой правая часть увеличена на 0.05. Слева прямые перпендикулярны (κ = 1): пересечение сдвигается на 0.035. Справа x₁ + x₂ = 2 и x₁ + 1.1x₂ = 2.1 (κ = 42.1): пересечение уходит в (0.5, 1.5), относительное изменение в 29 раз больше.'
    : 'Two 2 × 2 systems with solution (1, 1), drawn as two lines; the dashed line has its right-hand side raised by 0.05. Left, perpendicular lines (κ = 1): the intersection moves by 0.035. Right, x₁ + x₂ = 2 and x₁ + 1.1x₂ = 2.1 (κ = 42.1): it moves to (0.5, 1.5), a relative change 29 times larger.'}
>
  {layouts.map((Ly) => (
    <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
      <title id={`${id}-${Ly.sfx}-t`}>{ru ? 'Пересечение прямых при хорошей и плохой обусловленности' : 'Intersecting lines for a well and a badly conditioned system'}</title>
      <desc id={`${id}-${Ly.sfx}-d`}>{ru
        ? 'Две панели. Слева две перпендикулярные прямые; сдвинутая пунктирная прямая пересекает первую почти в той же точке. Справа две почти параллельные прямые; сдвинутая пунктирная прямая пересекает первую далеко от исходной точки, стрелка показывает большой сдвиг решения.'
        : 'Two panels. Left, two perpendicular lines; the shifted dashed line crosses the first one almost at the same point. Right, two nearly parallel lines; the shifted dashed line crosses the first one far from the original point, and an arrow shows the large move of the solution.'}</desc>
      {systems.map((s, j) => {
        const [bx, by] = Ly.boxes[j];
        const w = Ly.unit * (dom.x[1] - dom.x[0]), h = Ly.unit * (dom.y[1] - dom.y[0]);
        const sx = scale(dom.x, [bx, bx + w]), sy = scale(dom.y, [by + h, by]);
        const S = (v: V): V => [sx(v[0]), sy(v[1])];
        const clip = `${id}-${Ly.sfx}-${s.key}`;
        return (
          <g>
            <defs><clipPath id={clip}><rect x={bx} y={by} width={w} height={h} /></clipPath></defs>
            <rect x={bx} y={by} width={w} height={h} class="f-box-soft" style="fill: none" />
            <text class="f-small" x={bx + w / 2} y={by - 12} text-anchor="middle">{T[j].t}</text>
            <g clip-path={`url(#${clip})`}>
              <path class="f-axis" style="stroke-opacity: .5" d={`M ${bx} ${sy(0)} H ${bx + w} M ${sx(0)} ${by} V ${by + h}`} />
              <path class="f-line f-blue" d={polyline(seg(s.A[0][0], s.A[0][1], s.b[0]).map(S))} />
              <path class="f-line f-green" d={polyline(seg(s.A[1][0], s.A[1][1], s.b[1]).map(S))} />
              <path class="f-line f-green f-dash" d={polyline(seg(s.A[1][0], s.A[1][1], s.b[1] + delta).map(S))} />
            </g>
            {s.arrow && <path class="f-line f-red f-bold" d={polyline([S(s.x), S(s.xp)])} marker-end="url(#f-arrow-red)" />}
            <circle cx={S(s.x)[0]} cy={S(s.x)[1]} r="5" class="f-solid-blue" style="fill: var(--ink)" />
            <circle cx={S(s.xp)[0]} cy={S(s.xp)[1]} r="4.5" class="f-solid-red" />
            <text class="f-small f-halo" x={S(s.x)[0] - 12} y={S(s.x)[1] + 5} text-anchor="end">(1, 1)</text>
            <text class="f-small f-t-red" x={bx} y={by + h + 22}>{T[j].m}</text>
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
