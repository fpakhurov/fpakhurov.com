---
import Figure from '../Figure.astro';
import { scale, polyline } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

type V = [number, number];
// Hilbert matrices H_ij = 1/(i + j − 1), n = 3..13. b = H·1 in floating point, solved by Gaussian elimination with
// partial pivoting written out operation by operation (the Code section repeats it), error = ‖x̂ − 1‖ / ‖1‖.
// κ = λmax(H) · λmax(H⁻¹) by power iteration, with H⁻¹ from its exact integer formula.
const gepp = (A0: number[][], b0: number[]) => {
  const n = A0.length, A = A0.map((r) => r.slice()), b = b0.slice();
  for (let k = 0; k < n; k += 1) {
    let p = k;
    for (let i = k + 1; i < n; i += 1) if (Math.abs(A[i][k]) > Math.abs(A[p][k])) p = i;
    [A[k], A[p]] = [A[p], A[k]]; [b[k], b[p]] = [b[p], b[k]];
    for (let i = k + 1; i < n; i += 1) {
      const m = A[i][k] / A[k][k];
      for (let j = k; j < n; j += 1) A[i][j] = A[i][j] - m * A[k][j];
      b[i] = b[i] - m * b[k];
    }
  }
  const x = new Array(n).fill(0);
  for (let i = n - 1; i >= 0; i -= 1) { let s = b[i]; for (let j = i + 1; j < n; j += 1) s = s - A[i][j] * x[j]; x[i] = s / A[i][i]; }
  return x;
};
const power = (M: number[][]) => {
  const n = M.length; let v = new Array(n).fill(1), lam = 0;
  for (let it = 0; it < 2000; it += 1) {
    const w = M.map((row) => row.reduce((s, mij, j) => s + mij * v[j], 0));
    lam = w.reduce((s, wi, i) => s + wi * v[i], 0) / v.reduce((s, vi) => s + vi * vi, 0);
    const sc = Math.max(...w.map(Math.abs)); v = w.map((t) => t / sc);
  }
  return lam;
};
const comb = (n: number, k: number) => { if (k < 0 || k > n) return 0n; let r = 1n; for (let i = 1; i <= k; i += 1) r = (r * BigInt(n - k + i)) / BigInt(i); return r; };
const hilbInv = (n: number) => Array.from({ length: n }, (_, a) => Array.from({ length: n }, (_, c) => {
  const i = a + 1, j = c + 1, sgn = (i + j) % 2 === 0 ? 1n : -1n;
  return Number(sgn * BigInt(i + j - 1) * comb(n + i - 1, n - j) * comb(n + j - 1, n - i) * comb(i + j - 2, i - 1) ** 2n);
}));
const u = 2 ** -53;
const rows = Array.from({ length: 11 }, (_, k) => {
  const n = k + 3;
  const H = Array.from({ length: n }, (_, i) => Array.from({ length: n }, (_, j) => 1 / (i + j + 1)));
  const kappa = power(H) * power(hilbInv(n));
  const b = H.map((row) => row.reduce((s, h) => s + h * 1, 0));
  const x = gepp(H, b);
  const err = Math.sqrt(x.reduce((s, t) => s + (t - 1) * (t - 1), 0)) / Math.sqrt(n);
  return { n, kappa, err };
});
const got = rows.map((r) => `${r.n}:${r.kappa.toExponential(2)}:${r.err.toExponential(1)}`).join(' ');
const want = '3:5.24e+2:8.0e-15 4:1.55e+4:3.9e-13 5:4.77e+5:3.5e-13 6:1.50e+7:3.1e-10 7:4.75e+8:1.4e-8 8:1.53e+10:2.2e-7 9:4.93e+11:1.0e-5 10:1.60e+13:1.6e-4 11:5.23e+14:4.6e-3 12:1.71e+16:1.7e-1 13:5.63e+17:2.0e+0';
if (got !== want) throw new Error(`ErrorVsCondition: numbers drifted: ${got}`);
const everyBelow = rows.every((r) => r.err <= r.kappa * u);
if (!everyBelow) throw new Error('ErrorVsCondition: an error exceeds kappa * u');

const pts = rows.map((r) => ({ n: r.n, X: Math.log10(r.kappa), Y: Math.log10(r.err) }));
const lu = Math.log10(u);
const labelled = [3, 6, 9, 11, 13];
const labels = pts.filter((p) => labelled.includes(p.n)).map((p) => ({ ...p, left: p.n === 13 }));
const id = 'error-vs-condition';
const layouts = [
  { sfx: 'w', cls: 'fig-wide', W: 760, H: 360, px: [70, 730] as V, py: [30, 300] as V, lg: [86, 82] as V },
  { sfx: 'n', cls: 'fig-narrow seq-narrow', W: 360, H: 480, px: [56, 340] as V, py: [30, 330] as V, lg: [20, 404] as V },
];
const T = ru
  ? { xl: 'число обусловленности κ', yl: 'относительная ошибка', ku: 'κu', ul: 'u = 1.1 · 10⁻¹⁶', all: '100%: верных знаков нет', pts: 'матрицы Гильберта, n = 3…13', n: 'n = ' }
  : { xl: 'condition number κ', yl: 'relative error', ku: 'κu', ul: 'u = 1.1 · 10⁻¹⁶', all: '100%: no correct digits', pts: 'Hilbert matrices, n = 3…13', n: 'n = ' };
const sup = (v: number) => '10' + String(v).split('').map((ch) => ({ '-': '⁻', '0': '⁰', '1': '¹', '2': '²', '3': '³', '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹' } as Record<string, string>)[ch]).join('');
const xticks = [0, 4, 8, 12, 16].map((v) => ({ v, s: v === 0 ? '1' : sup(v) }));
const yticks = [0, -4, -8, -12, -16].map((v) => ({ v, s: v === 0 ? '1' : sup(v) }));
---

<Figure
  id={id}
  title={ru ? 'Ошибка решения растёт с числом обусловленности' : 'The error of a solve grows with the condition number'}
  caption={ru
    ? 'Относительная ошибка ‖x̂ − 1‖/‖1‖ в зависимости от κ(H) для систем Гильберта Hx = H·1 порядков от 3 до 13, решённых методом Гаусса с выбором ведущего элемента по столбцу в двойной точности; обе оси логарифмические. Каждая точка лежит под пунктиром κu. При n = 10 остаются четыре верных знака, при n = 13, где κ больше 1/u, — ни одного.'
    : 'Relative error ‖x̂ − 1‖/‖1‖ against κ(H) for Hilbert systems Hx = H·1 of orders 3 to 13, solved by elimination with partial pivoting in double precision; both axes logarithmic. Every point lies below the dashed line κu. At n = 10 four digits remain; at n = 13, with κ beyond 1/u, none.'}
>
  {layouts.map((Ly) => {
    const sx = scale([0, 18], Ly.px), sy = scale([-18, 1], [Ly.py[1], Ly.py[0]]);
    const clip = `${id}-${Ly.sfx}-clip`;
    return (
      <svg class={Ly.cls} viewBox={`0 0 ${Ly.W} ${Ly.H}`} role="img" aria-labelledby={`${id}-${Ly.sfx}-t ${id}-${Ly.sfx}-d`}>
        <title id={`${id}-${Ly.sfx}-t`}>{ru ? 'Относительная ошибка в зависимости от числа обусловленности' : 'Relative error against the condition number'}</title>
        <desc id={`${id}-${Ly.sfx}-d`}>{ru
          ? 'График в логарифмических осях: одиннадцать точек поднимаются слева направо почти вдоль наклонной пунктирной прямой κu, оставаясь под ней; последняя точка достигает уровня 100% ошибки.'
          : 'A log–log plot: eleven points rise from left to right almost along the slanted dashed line κu, staying below it; the last point reaches the level of 100% error.'}</desc>
        <defs><clipPath id={clip}><rect x={Ly.px[0]} y={Ly.py[0]} width={Ly.px[1] - Ly.px[0]} height={Ly.py[1] - Ly.py[0]} /></clipPath></defs>
        <rect x={Ly.px[0]} y={Ly.py[0]} width={Ly.px[1] - Ly.px[0]} height={sy(0) - Ly.py[0]} class="f-fill-red" style="fill-opacity: .07" />
        {yticks.map((t) => <path class="f-grid" d={`M ${Ly.px[0]} ${sy(t.v)} H ${Ly.px[1]}`} />)}
        <path class="f-axis" d={`M ${Ly.px[0]} ${Ly.py[0]} V ${Ly.py[1]} H ${Ly.px[1]}`} />
        {xticks.map((t) => <text class="f-note" x={sx(t.v)} y={Ly.py[1] + 18} text-anchor="middle">{t.s}</text>)}
        {yticks.map((t) => <text class="f-note" x={Ly.px[0] - 6} y={sy(t.v) + 5} text-anchor="end">{t.s}</text>)}
        <text class="f-small" x={(Ly.px[0] + Ly.px[1]) / 2} y={Ly.py[1] + 40} text-anchor="middle">{T.xl}</text>
        <text class="f-small" x={Ly.px[0] + 8} y={sy(0) + 16}>{T.all}</text>
        <g clip-path={`url(#${clip})`}>
          <path class="f-line f-red f-dash" d={polyline([[sx(0), sy(lu)], [sx(18), sy(18 + lu)]])} />
          <path class="f-thin f-muted f-dot" d={`M ${Ly.px[0]} ${sy(lu)} H ${Ly.px[1]}`} />
          <path class="f-thin f-blue" d={polyline(pts.map((p) => [sx(p.X), sy(p.Y)] as V))} />
        </g>
        {pts.map((p) => <circle cx={sx(p.X)} cy={sy(p.Y)} r="4.5" class="f-solid-blue" />)}
        {labels.map((p) => <text class="f-note f-halo" x={sx(p.X) + (p.left ? -8 : 8)} y={sy(p.Y) + (p.left ? -6 : 18)} text-anchor={p.left ? 'end' : 'start'}>{T.n + p.n}</text>)}
        <text class="f-small f-t-red f-halo" x={sx(9.3)} y={sy(9.3 + lu) - 10} text-anchor="end">{T.ku}</text>
        <text class="f-small f-t-muted f-halo" x={Ly.px[1] - 4} y={sy(lu) + 18} text-anchor="end">{T.ul}</text>
        <text class="f-small" x={Ly.px[0] - 40} y={Ly.py[0] - 12}>{T.yl}</text>
        <circle cx={Ly.lg[0] + 5} cy={Ly.lg[1] - 4} r="4.5" class="f-solid-blue" />
        <text class="f-small" x={Ly.lg[0] + 16} y={Ly.lg[1]}>{T.pts}</text>
        <path class="f-line f-red f-dash" d={`M ${Ly.lg[0]} ${Ly.lg[1] + 20} h 22`} />
        <text class="f-small" x={Ly.lg[0] + 30} y={Ly.lg[1] + 24}>{T.ku}</text>
      </svg>
    );
  })}
</Figure>
