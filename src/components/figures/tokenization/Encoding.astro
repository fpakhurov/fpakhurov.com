---
import Figure from '../Figure.astro';
import { toy, encodeByMerges, encodeLongestMatch, encodeCharBase } from './bpe';

// Encoding new words with the eight merges learned in the worked example.
const replayWord = 'singers';
const replay = encodeByMerges(replayWord);
const contrastWord = 'sneering';
const byMerges = encodeByMerges(contrastWord).units;
const byMatch = encodeLongestMatch(contrastWord);
const unkWord = 'king';
const charBase = encodeCharBase(unkWord);
const byteBase = encodeByMerges(unkWord).units; // with bytes as the base, k is a known unit
const piecesWord = 'rising';
const pieces = encodeByMerges(piecesWord).units;
const firedRules = (w: string) => encodeByMerges(w).trace.filter((t) => t.fired).map((t) => t.rule);

const blocks = [
  { title: `Two encoders, one vocabulary: ${contrastWord}`, rows: [
    { label: 'merges in order', units: byMerges },
    { label: 'longest match', units: byMatch },
  ] },
  { title: `A letter outside the base: ${unkWord}`, rows: [
    { label: `${toy.alphabet.length} letters`, units: charBase },
    { label: '256 bytes', units: byteBase },
  ] },
  { title: `Pieces are not morphemes: ${piecesWord}`, rows: [
    { label: 'merges in order', units: pieces },
  ] },
];

interface Layout { cls: string; W: number; H: number; lx: number; ly: number; segX: number; rx: number; ry: number; boxX: number; rowH: number; stacked: boolean; charW: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 700, H: 300, lx: 16, ly: 22, segX: 190, rx: 380, ry: 22, boxX: 506, rowH: 34, stacked: false, charW: 8.6 },
  { cls: 'fig-narrow', W: 360, H: 616, lx: 10, ly: 22, segX: 176, rx: 10, ry: 340, boxX: 128, rowH: 34, stacked: true, charW: 8.2 },
];
const boxW = (t: string, cw: number) => (t === '[UNK]' ? 5 : t.length) * cw + 10;
const id = 'tokenization-encoding';
---

<Figure
  id="encoding"
  title="Encoding words the corpus never contained"
  caption={`All examples use the ${toy.merges.length} merges and the ${toy.vocabulary.length}-token vocabulary of the worked example. Replay panel: ${replayWord} is split into characters and the merges are replayed in the order they were learned; rules ${firedRules(replayWord).join(', ')} fire (full ink), the others find no matching pair (muted), and the result is ${replay.units.join(' · ')}. Two encoders: the same vocabulary used with greedy longest match from the left gives a different segmentation of ${contrastWord}, because replaying the merges lets rule 4 (r + ing) claim the r before rule 6 (e + r) is reached, while longest match works from the left and takes er first. Letter outside the base: k is not one of the ${toy.alphabet.length} training letters, so a character base must emit [UNK]; a byte base contains every byte value and never does. Last panel: merges follow frequency, not meaning, so ${piecesWord} contains the piece sing.`}
>
  {layouts.map((L) => {
    const lineH = 23;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>Applying learned merges to new words</title>
        <desc id={`${id}-${L.W}-d`}>Left: the word {replayWord} passes through the {toy.merges.length} merge rules in order and ends as {replay.units.join(', ')}. Right: {contrastWord} becomes {byMerges.join(', ')} when merges are replayed but {byMatch.join(', ')} under longest match; {unkWord} becomes {charBase.join(', ')} with a character base and {byteBase.join(', ')} with a byte base; {piecesWord} becomes {pieces.join(', ')}.</desc>

        <text class="f-title" x={L.lx} y={L.ly}>Replaying the merges on “{replayWord}”</text>
        <text class="f-small" x={L.lx + 14} y={L.ly + 30} font-family="var(--mono)">start</text>
        <text class="f-small" x={L.segX} y={L.ly + 30} font-family="var(--mono)">{[...replayWord].join(' ')}</text>
        {replay.trace.map((t, i) => {
          const y = L.ly + 30 + (i + 1) * lineH;
          const tok = t.pair[0] + t.pair[1];
          return (
            <g>
              <text class={`f-small${t.fired ? '' : ' f-t-muted'}`} x={L.lx + 6} y={y} text-anchor="end">{t.rule}</text>
              <text class={`f-small${t.fired ? '' : ' f-t-muted'}`} x={L.lx + 14} y={y} font-family="var(--mono)">{t.pair[0]} + {t.pair[1]} → {tok}</text>
              {t.fired ? (
                <text class="f-small" x={L.segX} y={y} font-family="var(--mono)">
                  {t.units.map((u, j) => <tspan fill={u === tok ? 'var(--fig-blue)' : undefined} font-weight={u === tok ? '700' : '400'}>{(j ? ' ' : '') + u}</tspan>)}
                </text>
              ) : (
                <text class="f-small f-t-muted" x={L.segX} y={y}>no match</text>
              )}
            </g>
          );
        })}
        {(() => {
          const y = L.ly + 30 + (replay.trace.length + 1) * lineH + 14;
          let x = L.lx + 14;
          return (
            <g>
              {replay.units.map((u) => {
                const w = boxW(u, L.charW);
                const g = (
                  <g>
                    <rect class="f-box f-fill-blue" x={x} y={y - 20} width={w} height="28" rx="4" />
                    <text class="f-label" x={x + w / 2} y={y - 1} text-anchor="middle" font-family="var(--mono)">{u}</text>
                  </g>
                );
                x += w + 4;
                return g;
              })}
            </g>
          );
        })()}

        {!L.stacked && <line class="f-grid" x1={L.rx - 18} x2={L.rx - 18} y1={L.ry - 8} y2={L.H - 10} />}
        {(() => {
          let y = L.ry;
          return blocks.map((b) => {
            const head = y;
            y += 20 + b.rows.length * L.rowH + 22;
            return (
              <g>
                <text class="f-title" x={L.rx} y={head}>{b.title}</text>
                {b.rows.map((r, ri) => {
                  const ry = head + 14 + ri * L.rowH;
                  let x = L.boxX;
                  return (
                    <g>
                      <text class="f-note" x={L.rx} y={ry + 19}>{r.label}</text>
                      {r.units.map((u) => {
                        const unk = u === '[UNK]';
                        const w = boxW(u, L.charW);
                        const g = (
                          <g>
                            <rect class={unk ? 'f-box f-fill-red' : u.length > 1 ? 'f-box f-fill-blue' : 'f-box-soft'} x={x} y={ry} width={w} height="28" rx="4" />
                            <text class={`f-label${unk ? ' f-t-red' : ''}`} x={x + w / 2} y={ry + 19} text-anchor="middle" font-family="var(--mono)">{u}</text>
                          </g>
                        );
                        x += w + 4;
                        return g;
                      })}
                    </g>
                  );
                })}
              </g>
            );
          });
        })()}
      </svg>
    );
  })}
</Figure>
