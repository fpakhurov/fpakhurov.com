---
import Figure from '../Figure.astro';

// BPE on the three-word corpus "deep learning engineer".
// Pair counts are computed here from the splits so that the figure cannot
// disagree with the text.
const words = ['deep', 'learning', 'engineer'];

function countPairs(splits: string[][]) {
  const counts = new Map<string, number>();
  for (const s of splits) for (let i = 0; i + 1 < s.length; i += 1) {
    const key = `${s[i]}|${s[i + 1]}`;
    counts.set(key, (counts.get(key) ?? 0) + 1);
  }
  return [...counts.entries()].sort((a, b) => b[1] - a[1]);
}
function merge(splits: string[][], a: string, b: string) {
  return splits.map((s) => {
    const out: string[] = [];
    for (let i = 0; i < s.length; i += 1) {
      if (s[i] === a && s[i + 1] === b) { out.push(a + b); i += 1; } else out.push(s[i]);
    }
    return out;
  });
}

const step0 = words.map((w) => [...w]);
const pairs0 = countPairs(step0);
const step1 = merge(step0, 'e', 'e');
const pairs1 = countPairs(step1);
const step2 = merge(step1, 'i', 'n');
const steps = [
  { title: 'Initial splits', splits: step0, merged: '', top: pairs0.slice(0, 3) },
  { title: 'After merge 1: e + e → ee', splits: step1, merged: 'ee', top: pairs1.slice(0, 3) },
  { title: 'After merge 2: i + n → in', splits: step2, merged: 'in', top: countPairs(step2).slice(0, 1) },
];
const fmtPair = ([key, n]: [string, number]) => `${key.replace('|', '')}: ${n}`;

const cell = 30;
const rowH = 40;
const wide = { cls: 'fig-wide', w: 640, h: 3 * 150 + 20, colX: [20, 330] };
const narrow = { cls: 'fig-narrow', w: 360, h: 3 * 230 + 10, colX: [16, 16] };
---

<Figure
  id="bpe-merges"
  title="Two BPE merges on the corpus “deep learning engineer”"
  caption="Each word is first split into characters. At every step the most frequent adjacent pair over all words is counted; ties (ee, in and ng all occur twice at the start) are broken by the order in which the pairs were first seen, so ee from deep wins the first round and in from learning the second. The chosen pair is merged everywhere it occurs and added to the vocabulary. After two merges the vocabulary holds the 9 characters plus the units ee and in, and every remaining pair occurs once."
>
  {[wide, narrow].map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.w} ${L.h}`} role="img" aria-labelledby={`bpe-merges-${L.w}-t bpe-merges-${L.w}-d`}>
      <title id={`bpe-merges-${L.w}-t`}>Byte-pair encoding merge steps</title>
      <desc id={`bpe-merges-${L.w}-d`}>Three stages. In each, the words deep, learning and engineer are shown as rows of boxes, one box per current unit, with the most frequent pairs listed beside them. In stage two the unit ee is highlighted inside deep and engineer; in stage three the unit in is highlighted inside learning and engineer.</desc>
      {steps.map((step, si) => {
        const top = si * (L.cls === 'fig-wide' ? 150 : 230) + 10;
        return (
          <g>
            <text class="f-title" x={L.colX[0]} y={top + 14}>{step.title}</text>
            {step.splits.map((units, wi) => {
              const y = top + 28 + wi * rowH;
              return (
                <g>
                  {units.map((u, ui) => {
                    const x = L.colX[0] + ui * (cell + 4);
                    const hl = u === step.merged;
                    return (
                      <g>
                        <rect class={hl ? 'f-box f-fill-blue' : 'f-box-soft'} x={x} y={y} width={u.length > 1 ? cell + 10 : cell} height={cell} rx="5" />
                        <text class={hl ? 'f-label f-t-blue' : 'f-label'} x={x + (u.length > 1 ? cell + 10 : cell) / 2} y={y + 20} text-anchor="middle" font-family="var(--mono)">{u}</text>
                      </g>
                    );
                  })}
                </g>
              );
            })}
            {L.cls === 'fig-wide' ? (
              <g>
                <text class="f-note" x={L.colX[1]} y={top + 46}>most frequent pairs</text>
                {step.top.map((p, pi) => (
                  <text class={pi === 0 && si < 2 ? 'f-label f-t-blue' : 'f-label'} x={L.colX[1]} y={top + 70 + pi * 22} font-family="var(--mono)">{fmtPair(p)}{pi === 0 && si < 2 ? '  ← merge' : ''}</text>
                ))}
                {si === 2 && <text class="f-label" x={L.colX[1]} y={top + 92}>all pairs now occur once</text>}
              </g>
            ) : (
              <g>
                <text class="f-note" x={L.colX[0]} y={top + 28 + 3 * rowH + 12}>most frequent pairs: {si < 2 ? step.top.map(fmtPair).join('   ') : 'all occur once'}</text>
              </g>
            )}
          </g>
        );
      })}
    </svg>
  ))}
</Figure>
