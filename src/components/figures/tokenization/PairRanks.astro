---
import Figure from '../Figure.astro';
import { wordpieceFirstStep } from './bpe';

// First merge on the toy corpus: BPE ranks pairs by count, WordPiece by c(a,b) / (c(a) c(b)).
const { unit, pairs } = wordpieceFirstStep();
const name = (p: { pair: readonly [string, string] }) => `${p.pair[0]} ${p.pair[1]}`;
const byName = (a: { pair: readonly [string, string] }, b: { pair: readonly [string, string] }) => (name(a) < name(b) ? -1 : 1);
const left = [...pairs].sort((a, b) => b.count - a.count || byName(a, b));
const right = [...pairs].sort((a, b) => b.score - a.score || b.count - a.count || byName(a, b));
const maxC = left[0].count;
const maxS = right[0].score;
const bpePick = left[0];
const wpPick = right[0];
const f3 = (s: number) => s.toFixed(3);

const layouts = [
  { cls: 'fig-wide', W: 680, top: 62, rowH: 26, lLab: 24, lBar: 112, barW: 130, rLab: 430, rBar: 520, lineL: 300, lineR: 420, tCls: 'f-label' },
  { cls: 'fig-narrow', W: 360, top: 62, rowH: 26, lLab: 6, lBar: 70, barW: 42, rLab: 200, rBar: 264, lineL: 140, lineR: 194, tCls: 'f-small' },
];
const id = 'tokenization-pair-ranks';
const rowCls = (p: typeof pairs[number]) => (p === bpePick ? 'f-t-blue' : p === wpPick ? 'f-t-red' : '');
---

<Figure
  id="pair-ranks"
  title="BPE and WordPiece choose different first merges"
  caption={`All adjacent pairs of the toy corpus before the first merge, written WordPiece style: a character that does not start a word carries ##, so s at the start and ##s inside a word are different units. Left: ranked by the frequency-weighted count c(a, b), which BPE maximizes; ${name(bpePick)} wins with ${bpePick.count}. Right: ranked by the reconstructed WordPiece score c(a, b) / (c(a) c(b)); ${name(wpPick)} wins with ${wpPick.count} / (${unit.get(wpPick.pair[0])} · ${unit.get(wpPick.pair[1])}) = ${f3(wpPick.score)}, because ##e and ##r never occur apart, while ${name(bpePick)} scores ${bpePick.count} / (${unit.get(bpePick.pair[0])} · ${unit.get(bpePick.pair[1])}) = ${f3(bpePick.score)}. Lines join the same pair in both rankings; pairs with equal scores are listed by count.`}
>
  {layouts.map((L) => {
    const H = L.top + pairs.length * L.rowH + 10;
    const yOf = (i: number) => L.top + i * L.rowH;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>Pair rankings by count and by WordPiece score</title>
        <desc id={`${id}-${L.W}-d`}>Two ranked lists of the same {pairs.length} pairs with bars. By count: {left.map((p) => `${name(p)} ${p.count}`).join(', ')}. By score: {right.map((p) => `${name(p)} ${f3(p.score)}`).join(', ')}. Lines connect each pair's two positions; the count leader drops to rank {right.indexOf(bpePick) + 1} by score and the score leader has {wpPick.count === Math.min(...pairs.map((p) => p.count)) ? 'the lowest count' : 'count'}, {wpPick.count}.</desc>
        <text class="f-title f-t-blue" x={L.lLab} y="20">BPE</text>
        <text class="f-note" x={L.lLab} y="40">count c(a, b)</text>
        <text class="f-title f-t-red" x={L.rLab} y="20">WordPiece</text>
        <text class="f-note" x={L.rLab} y="40">c(a, b) / (c(a) c(b))</text>
        {left.map((p) => {
          const i = left.indexOf(p);
          const j = right.indexOf(p);
          const hl = p === bpePick || p === wpPick;
          return <path class={`f-thin ${p === bpePick ? 'f-blue' : p === wpPick ? 'f-red' : 'f-muted'}${hl ? ' f-bold' : ''}`} d={`M ${L.lineL} ${yOf(i) - 5} C ${(L.lineL + L.lineR) / 2} ${yOf(i) - 5} ${(L.lineL + L.lineR) / 2} ${yOf(j) - 5} ${L.lineR} ${yOf(j) - 5}`} />;
        })}
        {left.map((p, i) => (
          <g>
            <text class={`${L.tCls} ${rowCls(p)}`} x={L.lLab} y={yOf(i)} font-family="var(--mono)">{name(p)}</text>
            <rect class={p === bpePick ? 'f-solid-blue' : 'f-solid-muted'} opacity={p === bpePick ? 0.85 : 0.45} x={L.lBar} y={yOf(i) - 13} width={(L.barW * p.count) / maxC} height="12" rx="2" />
            <text class={`f-small ${rowCls(p)}`} x={L.lBar + (L.barW * p.count) / maxC + 6} y={yOf(i)}>{p.count}</text>
          </g>
        ))}
        {right.map((p, i) => (
          <g>
            <text class={`${L.tCls} ${rowCls(p)}`} x={L.rLab} y={yOf(i)} font-family="var(--mono)">{name(p)}</text>
            <rect class={p === wpPick ? 'f-solid-red' : 'f-solid-muted'} opacity={p === wpPick ? 0.85 : 0.45} x={L.rBar} y={yOf(i) - 13} width={(L.barW * p.score) / maxS} height="12" rx="2" />
            <text class={`f-small ${rowCls(p)}`} x={L.rBar + (L.barW * p.score) / maxS + 6} y={yOf(i)}>{f3(p.score)}</text>
          </g>
        ))}
      </svg>
    );
  })}
</Figure>
