---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { toy } from './bpe';

// Corpus length L_k after each merge of the toy run; each drop equals the merged pair's count.
const { initial, steps, alphabet, counts } = toy;
const words = counts.reduce((a, b) => a + b, 0);
const bars = [
  { k: 0, L: initial.length, prev: initial.length, token: '', vocab: alphabet.length },
  ...steps.map((s, i) => ({ k: s.k, L: s.length, prev: i ? steps[i - 1].length : initial.length, token: s.token, vocab: s.vocab })),
];
const allExact = steps.every((s, i) => (i ? steps[i - 1].length : initial.length) - s.length === s.count);

const layouts = [
  { cls: 'fig-wide', W: 660, H: 340, Lx: 66, R: 520, T: 34, B: 236, labelR: true, tokCls: 'f-small' },
  { cls: 'fig-narrow', W: 360, H: 344, Lx: 46, R: 326, T: 34, B: 226, labelR: false, tokCls: 'f-small' },
].map((v) => {
  const sy = scale([0, 112], [v.B, v.T]);
  const slot = (v.R - v.Lx) / bars.length;
  return { ...v, sy, slot, bw: slot * 0.62 };
});
const id = 'tokenization-compression';
---

<Figure
  id="compression"
  title="Each merge shortens the corpus by the count of the merged pair"
  caption={`Corpus length L in tokens after k merges of the run in the previous figure. The red cap on each bar is what the merge removed: every occurrence of the pair turns two tokens into one, so L falls by exactly the pair count c (${steps.map((s) => s.count).join(', ')}). The first merges remove the most; later ones remove three tokens each. Below the axis: the length L after step k, the token added and the vocabulary size |V|. Dashed lines mark the two extremes, ${initial.length} tokens as characters and ${words} as one token per word.${allExact ? '' : ' (Some occurrences overlapped.)'}`}
>
  {layouts.map((v) => (
    <svg class={v.cls} viewBox={`0 0 ${v.W} ${v.H}`} role="img" aria-labelledby={`${id}-${v.W}-t ${id}-${v.W}-d`}>
      <title id={`${id}-${v.W}-t`}>Corpus length after each BPE merge</title>
      <desc id={`${id}-${v.W}-d`}>A bar chart of corpus length against merge step. The bars fall {bars.map((b) => b.L).join(', ')}. A red cap on each bar shows the tokens removed by that merge, equal to its count. A dashed line at {initial.length} marks characters and a dashed line at {words} marks one token per word. Under each bar the new token and the vocabulary size, which rises from {alphabet.length} to {bars[bars.length - 1].vocab}.</desc>
      {[0, 50, 100].map((t) => (
        <g>
          <line class="f-grid" x1={v.Lx} x2={v.R} y1={v.sy(t)} y2={v.sy(t)} />
          <text class="f-note" x={v.Lx - 8} y={v.sy(t) + 5} text-anchor="end">{t}</text>
        </g>
      ))}
      <text class="f-math" x={v.Lx - 8} y={v.T - 14} text-anchor="end">L</text>
      {bars.map((b) => {
        const x = v.Lx + b.k * v.slot + (v.slot - v.bw) / 2;
        const cx = x + v.bw / 2;
        return (
          <g>
            <rect class="f-box f-fill-blue" x={x} y={v.sy(b.L)} width={v.bw} height={v.sy(0) - v.sy(b.L)} />
            {b.k > 0 && <rect class="f-fill-red" x={x} y={v.sy(b.prev)} width={v.bw} height={v.sy(b.L) - v.sy(b.prev)} />}
            {b.k > 0 && <rect class="f-thin f-red f-dash" x={x} y={v.sy(b.prev)} width={v.bw} height={v.sy(b.L) - v.sy(b.prev)} fill="none" />}
            {b.k > 0 && <text class="f-small f-t-red" x={cx} y={v.sy(b.prev) - 6} text-anchor="middle">−{b.prev - b.L}</text>}
            <text class="f-small" x={cx} y={v.B + 20} text-anchor="middle">{b.k}</text>
            <text class="f-small" x={cx} y={v.B + 42} text-anchor="middle">{b.L}</text>
            <text class={`${v.tokCls} f-t-blue`} x={cx} y={v.B + 64} text-anchor="middle" font-family="var(--mono)" transform={v.labelR || !b.token ? undefined : `rotate(-40 ${cx} ${v.B + 64})`}>{b.token || (v.labelR ? '—' : '')}</text>
            <text class="f-small f-t-muted" x={cx} y={v.B + (v.labelR ? 86 : 104)} text-anchor="middle">{b.vocab}</text>
          </g>
        );
      })}
      <line class="f-axis" x1={v.Lx} x2={v.R} y1={v.B} y2={v.B} />
      <text class="f-note" x={v.Lx - 8} y={v.B + 20} text-anchor="end">k</text>
      <text class="f-note" x={v.Lx - 8} y={v.B + 42} text-anchor="end">L</text>
      <text class="f-note" x={v.Lx - 8} y={v.B + 64} text-anchor="end">new</text>
      <text class="f-note" x={v.Lx - 8} y={v.B + (v.labelR ? 86 : 104)} text-anchor="end">|V|</text>
      {[initial.length, words].map((t) => (
        <line class="f-thin f-muted f-dash" x1={v.Lx} x2={v.R + (v.labelR ? 8 : 4)} y1={v.sy(t)} y2={v.sy(t)} />
      ))}
      {v.labelR ? (
        <g>
          <text class="f-note" x={v.R + 14} y={v.sy(initial.length) + 5}>characters ({initial.length})</text>
          <text class="f-note" x={v.R + 14} y={v.sy(words) - 4}>one token</text>
          <text class="f-note" x={v.R + 14} y={v.sy(words) + 13}>per word ({words})</text>
        </g>
      ) : (
        <g>
          <text class="f-note" x={v.R + 8} y={v.sy(initial.length) + 5}>{initial.length}</text>
          <text class="f-note" x={v.R + 8} y={v.sy(words) + 5}>{words}</text>
        </g>
      )}
    </svg>
  ))}
</Figure>
