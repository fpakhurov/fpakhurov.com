---
import Figure from '../Figure.astro';
import { lattice, unigramVocab } from './unigram';

// Segmentation lattice of one word under a unigram tokenizer with toy probabilities, solved by Viterbi.
const { word, arcs, best, back, ways, path, pathCost, longest, longestCost } = lattice;
const n = word.length;
const f1 = (x: number) => x.toFixed(1);
const onPath = new Set(path);
const chars = arcs.filter((a) => a.to - a.from === 1);
const multi = arcs.filter((a) => a.to - a.from > 1);
const seg = (as: typeof path) => as.map((a) => a.token).join(' · ');

const layouts = [
  { cls: 'fig-wide', W: 680, x0: 112, dx: 88, unit: 41, baseY: 214, r: 12, lab: 'f-label', small: 'f-small' },
  { cls: 'fig-narrow', W: 360, x0: 30, dx: 50, unit: 44, baseY: 220, r: 10, lab: 'f-small', small: 'f-small' },
];
const id = 'tokenization-unigram-lattice';
---

<Figure
  id="unigram-lattice"
  title="The most probable segmentation is a shortest path"
  caption={`The word ${word} as a lattice: node j is the position after j characters, and every substring that is in the vocabulary is an arc from its start to its end, labelled with the token and its cost −ln p(t). The probabilities are toy values for ${unigramVocab.length} tokens. Single characters run along the baseline, longer tokens arch above it, higher for longer tokens. A segmentation is a path from node 0 to node ${n}, and its cost is −ln P, so the most probable segmentation is the cheapest path; there are ${ways} paths here. Under each node is the best cost of reaching it, computed left to right as the minimum over incoming arcs of (best cost at the arc's start + arc cost). The blue path ${seg(path)} costs ${f1(pathCost)}. Greedy longest match takes ${seg(longest)} at cost ${f1(longestCost)}: node 5 is reached most cheaply through ${back[5]!.token}, but that prefix does not extend to the cheapest full path.`}
>
  {layouts.map((v) => {
    const H = v.baseY + 92;
    const xOf = (j: number) => v.x0 + j * v.dx;
    const hOf = (span: number) => v.unit * (span - 1);
    return (
      <svg class={v.cls} viewBox={`0 0 ${v.W} ${H}`} role="img" aria-labelledby={`${id}-${v.W}-t ${id}-${v.W}-d`}>
        <title id={`${id}-${v.W}-t`}>Viterbi lattice for the word {word}</title>
        <desc id={`${id}-${v.W}-d`}>Seven nodes for positions 0 to {n} of {word}. Arcs with costs: {arcs.map((a) => `${a.token} from ${a.from} to ${a.to}, ${f1(a.cost)}`).join('; ')}. Best cost at each node: {best.map((b, j) => `${j}: ${f1(b)}`).join(', ')}. The best path, highlighted, is {seg(path)} with cost {f1(pathCost)}; greedy longest match gives {seg(longest)} with cost {f1(longestCost)}.</desc>
        {multi.map((a) => {
          const x1 = xOf(a.from);
          const x2 = xOf(a.to);
          const h = hOf(a.to - a.from);
          const hl = onPath.has(a);
          return <path class={hl ? 'f-line f-blue f-bold' : 'f-thin f-muted'} d={`M ${x1} ${v.baseY} Q ${(x1 + x2) / 2} ${v.baseY - 2 * h} ${x2} ${v.baseY}`} />;
        })}
        {chars.map((a) => {
          const hl = onPath.has(a);
          return <line class={hl ? 'f-line f-blue f-bold' : 'f-thin'} x1={xOf(a.from)} x2={xOf(a.to)} y1={v.baseY} y2={v.baseY} />;
        })}
        {multi.map((a) => {
          const cx = (xOf(a.from) + xOf(a.to)) / 2;
          const y = v.baseY - hOf(a.to - a.from);
          const hl = onPath.has(a);
          return (
            <g>
              <text class={`${v.lab} f-halo${hl ? ' f-t-blue' : ''}`} x={cx} y={y - 3} text-anchor="middle" font-family="var(--mono)" font-weight={hl ? '700' : undefined}>{a.token}</text>
              <text class={`${v.small} f-halo${hl ? ' f-t-blue' : ' f-t-muted'}`} x={cx} y={y + 12} text-anchor="middle">{f1(a.cost)}</text>
            </g>
          );
        })}
        {chars.map((a) => {
          const cx = (xOf(a.from) + xOf(a.to)) / 2;
          return (
            <g>
              <text class={v.lab} x={cx} y={v.baseY + 22} text-anchor="middle" font-family="var(--mono)">{a.token}</text>
              <text class={`${v.small} f-t-muted`} x={cx} y={v.baseY + 38} text-anchor="middle">{f1(a.cost)}</text>
            </g>
          );
        })}
        {best.map((_, j) => {
          return (
            <g>
              <circle class="f-box" cx={xOf(j)} cy={v.baseY} r={v.r} />
              <text class="f-small" x={xOf(j)} y={v.baseY + 4.5} text-anchor="middle">{j}</text>
            </g>
          );
        })}
        {v.cls === 'fig-wide'
          ? <text class="f-note" x={v.x0 - 26} y={v.baseY + 62} text-anchor="end">best cost</text>
          : <text class="f-note" x="4" y={v.baseY + 60}>best cost to reach each node</text>}
        {best.map((b, j) => {
          const final = j === 0 || path.some((a) => a.to === j);
          return (
            <text class={`${v.small}${final ? ' f-t-blue' : ''}`} x={xOf(j)} y={v.baseY + (v.cls === 'fig-wide' ? 62 : 80)} text-anchor="middle" font-weight={final ? '700' : undefined}>{f1(b)}</text>
          );
        })}
        {v.cls === 'fig-wide' && <text class="f-note" x={v.x0 - 26} y={v.baseY + 84} text-anchor="end">via</text>}
        {v.cls === 'fig-wide' && back.map((a, j) => a && <text class="f-small f-t-muted" x={xOf(j)} y={v.baseY + 84} text-anchor="middle" font-family="var(--mono)">{a.token}</text>)}
      </svg>
    );
  })}
</Figure>
