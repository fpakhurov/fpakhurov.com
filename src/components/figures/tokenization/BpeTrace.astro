---
import Figure from '../Figure.astro';
import { toy } from './bpe';

// Eight BPE merges on the toy corpus, computed in bpe.ts.
const { initial, steps, words, counts, alphabet } = toy;
const rows = [
  { k: 0, merge: '—', count: '', L: initial.length, splits: initial.splits, token: '', tie: false },
  ...steps.map((s) => ({
    k: s.k,
    merge: `${s.pair[0]} + ${s.pair[1]} → ${s.token}`,
    count: String(s.count),
    L: s.length,
    splits: s.splits,
    token: s.token,
    tie: s.ties.length > 1,
  })),
];
const tieSteps = steps.filter((s) => s.ties.length > 1);
const last = steps[steps.length - 1];
const totalWords = counts.reduce((a, b) => a + b, 0);

// Monospace column widths from the longest segmentation of each word.
const charW = { wide: 7.9, narrow: 8.2 };
const colChars = words.map((_, w) => Math.max(...rows.map((r) => r.splits[w].join(' ').length), words[w].length + 3));

const W = 730;
const wordX0 = 246;
const gapW = 16;
const wideX: number[] = [];
colChars.reduce((x, c, i) => { wideX[i] = x; return x + c * charW.wide + gapW; }, wordX0);
const rowH = 22;
const top = 50;
const H = top + rows.length * rowH + 6;

// Narrow: three lines per step, words in two groups of three.
const nW = 360;
const nGroups = [[0, 1, 2], [3, 4, 5]];
const nX: number[] = [];
nGroups.forEach((g) => g.reduce((x, w) => { nX[w] = x; return x + colChars[w] * charW.narrow + 20; }, 34));
const nStep = 62;
const nTop = 58;
const nH = nTop + rows.length * nStep - 4;

const id = 'tokenization-bpe-trace';
// Tokens of one segmentation, with the token created at this step marked for highlighting.
const seg = (units: string[], token: string, k: number) =>
  units.map((u, i) => ({ text: (i ? ' ' : '') + u, isNew: k > 0 && u === token }));
---

<Figure
  id="bpe-trace"
  title="Eight BPE merges on a six-word corpus"
  caption={`Corpus: ${words.map((w, i) => `${w} ×${counts[i]}`).join(', ')} (${totalWords} running words, ${initial.length} characters, alphabet of ${alphabet.length} letters). Each row is one merge k: the pair with the largest frequency-weighted count c, its merged token, the corpus length L in tokens after the merge, and the current segmentation of every word type, with the new token in blue. The vocabulary grows by one per row, from ${alphabet.length} to ${last.vocab}. Amber rows had a tie for the top count (${tieSteps.map((s) => `${s.ties.length} pairs at step ${s.k}`).join(', ')}); the alphabetically first pair is merged. After ${steps.length} merges the corpus is ${last.length} tokens for ${totalWords} words.`}
>
  <svg class="fig-wide fig-bp-640" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby={`${id}-w-t ${id}-w-d`}>
    <title id={`${id}-w-t`}>BPE training trace</title>
    <desc id={`${id}-w-d`}>A table with one row per merge step from 0 to {steps.length}. Columns give the merge rule, its count, the corpus length in tokens and the segmentations of the six word types. The merges are {steps.map((s) => `${s.pair[0]} plus ${s.pair[1]} with count ${s.count}`).join('; ')}. The corpus length falls from {initial.length} to {last.length}.</desc>
    <text class="f-note" x="26" y="24" text-anchor="end">k</text>
    <text class="f-note" x="38" y="24">merge</text>
    <text class="f-note" x="184" y="24" text-anchor="end">c</text>
    <text class="f-note" x="228" y="24" text-anchor="end">L</text>
    {words.map((w, i) => <text class="f-note" x={wideX[i]} y="24">{w} ×{counts[i]}</text>)}
    <line class="f-axis" x1="8" x2={W - 6} y1="34" y2="34" />
    {rows.map((r, ri) => {
      const y = top + ri * rowH;
      return (
        <g>
          {r.tie && <rect class="f-fill-amber" x="6" y={y - 15} width={W - 12} height={rowH - 1} rx="3" />}
          <text class="f-small" x="26" y={y} text-anchor="end">{r.k}</text>
          <text class="f-small" x="38" y={y} font-family="var(--mono)">{r.merge}</text>
          <text class="f-small" x="184" y={y} text-anchor="end">{r.count}</text>
          <text class="f-small" x="228" y={y} text-anchor="end">{r.L}</text>
          {r.splits.map((u, w) => <text class="f-small" x={wideX[w]} y={y} font-family="var(--mono)">{seg(u, r.token, r.k).map((t) => <tspan fill={t.isNew ? 'var(--fig-blue)' : undefined} font-weight={t.isNew ? '700' : '400'}>{t.text}</tspan>)}</text>)}
        </g>
      );
    })}
  </svg>

  <svg class="fig-narrow fig-bp-640" viewBox={`0 0 ${nW} ${nH}`} role="img" aria-labelledby={`${id}-n-t ${id}-n-d`}>
    <title id={`${id}-n-t`}>BPE training trace</title>
    <desc id={`${id}-n-d`}>For each merge step from 0 to {steps.length}: the merge rule, its count, the corpus length in tokens, and the segmentations of the six word types in two lines of three. The corpus length falls from {initial.length} to {last.length}.</desc>
    {nGroups.map((g, gi) => g.map((w) => <text class="f-note" x={nX[w]} y={18 + gi * 18}>{words[w]} ×{counts[w]}</text>))}
    <line class="f-axis" x1="6" x2={nW - 6} y1="44" y2="44" />
    {rows.map((r, ri) => {
      const y = nTop + ri * nStep + 12;
      return (
        <g>
          {r.tie && <rect class="f-fill-amber" x="4" y={y - 16} width={nW - 8} height={nStep - 6} rx="3" />}
          <text class="f-small" x="20" y={y} text-anchor="end">{r.k}</text>
          <text class="f-small" x="34" y={y} font-family="var(--mono)">{r.merge}</text>
          <text class="f-small" x={nW - 10} y={y} text-anchor="end">{r.k ? `c = ${r.count} · ` : ''}L = {r.L}</text>
          {nGroups.map((g, gi) => g.map((w) => (
            <text class="f-small" x={nX[w]} y={y + 18 + gi * 17} font-family="var(--mono)">{seg(r.splits[w], r.token, r.k).map((t) => <tspan fill={t.isNew ? 'var(--fig-blue)' : undefined} font-weight={t.isNew ? '700' : '400'}>{t.text}</tspan>)}</text>
          )))}
        </g>
      );
    })}
  </svg>
</Figure>
