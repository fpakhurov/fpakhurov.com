---
import Figure from '../Figure.astro';
import { toy, encodeByMerges } from './bpe';
import { pageLang } from '../../../utils/lang';
import { plural } from './ru';

const ru = pageLang(Astro.url) === 'ru';

// The full tokenizer around the BPE model of the worked example, from a raw string to a padded batch.
const raw = 'Singers SING';
const normalized = raw.toLowerCase();
const words = normalized.split(' ');
const pieces = words.map((w) => encodeByMerges(w).units);
const specials = ['[PAD]', '[UNK]', '[CLS]', '[SEP]'];
const ids = new Map<string, number>([...specials, ...toy.vocabulary].map((t, i) => [t, i]));
const seqA = ['[CLS]', ...pieces.flat(), '[SEP]'];
const second = 'songs';
const seqB0 = ['[CLS]', ...encodeByMerges(second).units, '[SEP]'];
const seqB = [...seqB0, ...Array(seqA.length - seqB0.length).fill('[PAD]')];
const maskOf = (seq: string[]) => seq.map((t) => (t === '[PAD]' ? 0 : 1));
const maskB = maskOf(seqB);

interface Layout { cls: string; W: number; stacked: boolean; labX: number; cx: number; charW: number; tCls: string; rowGap: number }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 680, stacked: false, labX: 16, cx: 190, charW: 8.6, tCls: 'f-label', rowGap: 18 },
  { cls: 'fig-narrow', W: 360, stacked: true, labX: 8, cx: 8, charW: 7.9, tCls: 'f-small', rowGap: 14 },
];
const bw = (t: string, cw: number) => t.length * cw + 10;
const stages = [
  { name: ru ? 'сырой текст' : 'raw text', note: '', kind: 'text', text: raw },
  { name: ru ? 'нормализация' : 'normalize', note: ru ? 'нижний регистр' : 'lowercase', kind: 'text', text: normalized },
  { name: ru ? 'предтокенизация' : 'pre-tokenize', note: ru ? 'по пробелам' : 'split on spaces', kind: 'groups', groups: words.map((w) => [w]) },
  { name: ru ? 'модель' : 'model', note: ru ? `${toy.merges.length} ${plural(toy.merges.length, 'слияние', 'слияния', 'слияний')}` : `${toy.merges.length} learned merges`, kind: 'groups', groups: pieces, learned: true },
  { name: ru ? 'постобработка' : 'post-process', note: ru ? 'спецтокены, id' : 'special tokens, ids', kind: 'ids', seqs: [seqA] },
  { name: ru ? 'батч' : 'batch', note: ru ? 'паддинг, маска' : 'padding, mask', kind: 'ids', seqs: [seqA, seqB], mask: true },
] as const;
const id = 'tokenization-pipeline';

function build(L: Layout) {
  let y = 14;
  const out = stages.map((s) => {
    const head = y;
    const top = L.stacked ? head + (s.note ? 40 : 22) : head;
    let h = 30;
    if (s.kind === 'ids') h = s.seqs.length * ('mask' in s ? 72 : 50) - ('mask' in s ? 6 : 0);
    y = top + h + L.rowGap + (L.stacked ? 6 : 0);
    return { s, head, top, h };
  });
  return { out, H: y + 4 };
}
// Column widths for aligned id rows: the widest token in each position over both sequences.
const colW = (cw: number) => seqA.map((_, i) => Math.max(bw(seqA[i], cw), bw(seqB[i], cw)));
---

<Figure
  id="pipeline"
  title={ru ? 'От строки к батчу идентификаторов' : 'From a string to a batch of ids'}
  caption={ru ? `Токенизатор разобранного примера внутри полного конвейера. Обучается только этап модели; нормализация (здесь — приведение к нижнему регистру) и предварительная токенизация (здесь — разбиение на слова по пробелам) — фиксированные правила, применяемые до неё, а постобработка добавляет граничные токены [CLS] и [SEP] и отображает каждый токен в его строку таблицы эмбеддингов. Идентификаторы (id): ${specials.map((t, i) => `${t} = ${i}`).join(', ')}, затем ${toy.vocabulary.length} токенов словаря по порядку (${toy.vocabulary[0]} = 4, ${toy.vocabulary[1]} = 5, …, ${toy.vocabulary[toy.vocabulary.length - 1]} = ${ids.get(toy.vocabulary[toy.vocabulary.length - 1])}). В батче более короткая последовательность (${second}) дополняется токеном [PAD] = 0, а маска внимания отмечает настоящие токены единицей. Декодирование проходит этапы в обратном порядке лишь частично: приведение к нижнему регистру нельзя отменить, а для склейки кусков нужна метка границы слова (## в WordPiece у BERT, Ġ или ▁ для пробела перед словом), которой у этого игрушечного токенизатора нет.` : `The tokenizer of the worked example inside a full pipeline. Only the model stage is learned; normalization (here lowercasing) and pre-tokenization (here splitting on spaces) are fixed rules applied before it, and post-processing adds the boundary tokens [CLS] and [SEP] and maps every token to its row in the embedding table. Ids: ${specials.map((t, i) => `${t} = ${i}`).join(', ')}, then the ${toy.vocabulary.length} tokens of the vocabulary in order (${toy.vocabulary[0]} = 4, ${toy.vocabulary[1]} = 5, …, ${toy.vocabulary[toy.vocabulary.length - 1]} = ${ids.get(toy.vocabulary[toy.vocabulary.length - 1])}). In a batch the shorter sequence (${second}) is padded with [PAD] = 0 and the attention mask marks real tokens with 1. Decoding runs the stages backwards only partly: lowercasing cannot be undone, and joining the pieces needs a word-boundary mark (## in BERT's WordPiece, Ġ or ▁ for a leading space) that this toy tokenizer does not have.`}
>
  {layouts.map((L) => {
    const { out, H } = build(L);
    const cols = colW(L.charW);
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Конвейер токенизатора' : 'Tokenizer pipeline'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru ? `Шесть этапов сверху вниз. Сырой текст ${raw}; в нижнем регистре ${normalized}; разбиение на слова ${words.join(', ')}; выученные слияния превращают их в ${pieces.map((p) => p.join(' ')).join(' | ')}; постобработка даёт ${seqA.join(' ')} с идентификаторами ${seqA.map((t) => ids.get(t)).join(' ')}; батч добавляет ${seqB.join(' ')} с идентификаторами ${seqB.map((t) => ids.get(t)).join(' ')} и маски внимания ${maskOf(seqA).join(' ')} и ${maskB.join(' ')}.` : <>Six stages from top to bottom. Raw text {raw}; lowercased {normalized}; split into the words {words.join(', ')}; the learned merges turn them into {pieces.map((p) => p.join(' ')).join(' | ')}; post-processing gives {seqA.join(' ')} with ids {seqA.map((t) => ids.get(t)).join(' ')}; a batch adds {seqB.join(' ')} with ids {seqB.map((t) => ids.get(t)).join(' ')} and attention masks {maskOf(seqA).join(' ')} and {maskB.join(' ')}.</>}</desc>
        {out.map(({ s, head, top }, si) => {
          const learned = 'learned' in s && s.learned;
          return (
            <g>
              <text class={`f-title${learned ? ' f-t-blue' : ''}`} x={L.labX} y={head + 19}>{s.name}</text>
              {s.note && <text class="f-note" x={L.labX} y={head + (L.stacked ? 36 : 38)}>{s.note}</text>}
              {si > 0 && !L.stacked && <path class="f-thin f-muted" d={`M ${L.cx - 22} ${head - 14} V ${head + 2}`} marker-end="url(#f-arrow-muted)" />}
              {s.kind === 'text' && <text class={L.tCls} x={L.cx} y={top + 20} font-family="var(--mono)">{s.text}</text>}
              {s.kind === 'groups' && (() => {
                let x = L.cx;
                return s.groups.map((g) => {
                  const els = g.map((t) => {
                    const w = bw(t, L.charW);
                    const el = (
                      <g>
                        <rect class={learned ? (t.length > 1 ? 'f-box f-fill-blue' : 'f-box-soft') : 'f-box'} x={x} y={top} width={w} height="28" rx="4" />
                        <text class={L.tCls} x={x + w / 2} y={top + 19} text-anchor="middle" font-family="var(--mono)">{t}</text>
                      </g>
                    );
                    x += w + 3;
                    return el;
                  });
                  x += 14;
                  return els;
                });
              })()}
              {s.kind === 'ids' && s.seqs.map((seq, qi) => {
                const y = top + qi * ('mask' in s ? 72 : 50);
                let x = L.cx;
                return seq.map((t, i) => {
                  const w = cols[i];
                  const special = t.startsWith('[');
                  const el = (
                    <g>
                      <rect class={t === '[PAD]' ? 'f-box-soft' : special ? 'f-box f-fill-amber' : 'f-box'} x={x} y={y} width={w} height="26" rx="4" />
                      <text class={`f-small${t === '[PAD]' ? ' f-t-muted' : ''}`} x={x + w / 2} y={y + 17} text-anchor="middle" font-family="var(--mono)">{t}</text>
                      <text class="f-small f-t-muted" x={x + w / 2} y={y + 42} text-anchor="middle">{ids.get(t)}</text>
                      {'mask' in s && <text class={`f-small ${maskOf(seq)[i] ? 'f-t-blue' : 'f-t-muted'}`} x={x + w / 2} y={y + 62} text-anchor="middle">{maskOf(seq)[i]}</text>}
                    </g>
                  );
                  x += w + 3;
                  return el;
                });
              })}
              {s.kind === 'ids' && s.seqs.map((_, qi) => <text class="f-note" x={L.cx + cols.reduce((a, b) => a + b + 3, 0) + 6} y={top + qi * ('mask' in s ? 72 : 50) + 42}>{ru ? 'id' : 'ids'}</text>)}
              {'mask' in s && s.seqs.map((_, qi) => <text class="f-note" x={L.cx + cols.reduce((a, b) => a + b + 3, 0) + 6} y={top + qi * 72 + 62}>{ru ? 'маска' : 'mask'}</text>)}
            </g>
          );
        })}
      </svg>
    );
  })}
</Figure>
