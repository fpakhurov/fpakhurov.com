---
import Figure from '../Figure.astro';
import { polyline, scale } from '../geometry';
import { fertility, wordLevel } from './bpe';
import { pageLang } from '../../../utils/lang';
import { fmtInt } from './ru';

const ru = pageLang(Astro.url) === 'ru';

// Tokens per word against |V| on a log axis, BPE trained on our own English text (see bpe.ts).
const lx = (v: number) => Math.log10(v);
const lastRow = fertility[fertility.length - 1];
const pct = (wordLevel.heldOutUnk * 100).toFixed(1);
const pctS = ru ? `${pct}%` : `${pct} %`;
const fmt = (v: number) => fmtInt(v, ru);
const xTicks = [30, 100, 300, 1000, 3000];
const yTicks = [1, 2, 3, 4, 5];

const layouts = [
  { cls: 'fig-wide', W: 640, H: 360, L: 64, R: 600, T: 24, B: 300, narrow: false },
  { cls: 'fig-narrow', W: 360, H: 380, L: 48, R: 340, T: 24, B: 300, narrow: true },
].map((v) => {
  const sx = (x: number) => scale([lx(20), lx(4000)], [v.L, v.R])(lx(x));
  const sy = scale([0.4, 5.3], [v.B, v.T]);
  return {
    ...v, sx, sy,
    train: polyline(fertility.map((r) => [sx(r[1]), sy(r[2])])),
    held: polyline(fertility.map((r) => [sx(r[1]), sy(r[3])])),
  };
});
const id = 'tokenization-fertility';
---

<Figure
  id="fertility"
  title={ru ? 'Число токенов на слово падает с ростом словаря' : 'Tokens per word fall as the vocabulary grows'}
  caption={ru ? `BPE, обученный на прозе 11 заметок курса «Генеративные модели» этого сайта (только буквы в нижнем регистре, ${fmt(26990)} словоупотреблений, ${fmt(2790)} типов слов) и проверенный на остальных четырёх заметках (${fmt(8908)} слов). По горизонтальной оси — размер словаря |V| = 26 букв + слияния в логарифмической шкале; по вертикальной — среднее число токенов на слово. На обучающем тексте (синяя кривая) оно падает с ${fertility[0][2].toFixed(2)} на уровне символов до ${lastRow[2].toFixed(2)} после ${fmt(lastRow[0])} слияний; на отложенном тексте (красная) доходит до ${lastRow[3].toFixed(2)}, потому что поздние слияния строят целые слова, частые при обучении и отсутствующие в другом тексте. Каждое удвоение |V| даёт всё меньший выигрыш. Отдельная точка на уровне одного токена на слово — словарь из типов слов обучающего текста: ровно один токен на слово, но ${pctS} слов отложенного текста в нём нет. Это наше собственное небольшое измерение, иллюстрация, а не бенчмарк.` : `BPE trained on the prose of 11 Generative Models notes of this site (lowercased letters only, 26,990 running words, 2,790 word types) and evaluated on the other four notes (8,908 words). The horizontal axis is the vocabulary size |V| = 26 letters + merges, on a log scale; the vertical axis is the average number of tokens per word. On the training text (blue) the curve falls from ${fertility[0][2].toFixed(2)} at the character level to ${lastRow[2].toFixed(2)} after ${lastRow[0].toLocaleString('en-US')} merges; on held-out text (red) it reaches ${lastRow[3].toFixed(2)}, because the late merges build whole words that are frequent in training and absent elsewhere. Each doubling of |V| buys less. The single point at one token per word is a word vocabulary of the training types: exactly one token per word, but ${pct} % of held-out words are not in it. Our own small measurement, an illustration rather than a benchmark.`}
>
  {layouts.map((v) => (
    <svg class={v.cls} viewBox={`0 0 ${v.W} ${v.H}`} role="img" aria-labelledby={`${id}-${v.W}-t ${id}-${v.W}-d`}>
      <title id={`${id}-${v.W}-t`}>{ru ? 'Число токенов на слово в зависимости от размера словаря' : 'Tokens per word against vocabulary size'}</title>
      <desc id={`${id}-${v.W}-d`}>{ru ? `Две убывающие кривые на логарифмической оси размера словаря от 20 до ${fmt(4000)}. Обучающий текст, синяя: ${fertility.map((r) => `${r[2]} при ${r[1]}`).join(', ')}. Отложенный текст, красная: ${fertility.map((r) => `${r[3]} при ${r[1]}`).join(', ')}. Начиная примерно с 200 записей красная кривая лежит выше синей. Отдельная точка при размере словаря ${fmt(wordLevel.vocab)} и одном токене на слово подписана долей неизвестных слов, ${pct} процента.` : <>Two falling curves on a log-scaled vocabulary axis from 20 to 4,000. Training text, blue: {fertility.map((r) => `${r[2]} at ${r[1]}`).join(', ')}. Held-out text, red: {fertility.map((r) => `${r[3]} at ${r[1]}`).join(', ')}. The red curve lies above the blue one from about 200 entries on. A single point at vocabulary {wordLevel.vocab} and one token per word is labelled with {pct} percent unknown words.</>}</desc>
      {yTicks.map((t) => (
        <g>
          <line class="f-grid" x1={v.L} x2={v.R} y1={v.sy(t)} y2={v.sy(t)} />
          <text class="f-note" x={v.L - 10} y={v.sy(t) + 5} text-anchor="end">{t}</text>
        </g>
      ))}
      {xTicks.map((t) => (
        <g>
          <line class="f-grid" x1={v.sx(t)} x2={v.sx(t)} y1={v.T} y2={v.B} />
          <text class="f-note" x={v.sx(t)} y={v.B + 22} text-anchor="middle">{fmt(t)}</text>
        </g>
      ))}
      <line class="f-axis" x1={v.L} x2={v.R} y1={v.B} y2={v.B} />
      <line class="f-axis" x1={v.L} x2={v.L} y1={v.B} y2={v.T} />
      <text class="f-note" x={(v.L + v.R) / 2} y={v.B + 46} text-anchor="middle">{ru ? 'размер словаря |V| (логарифмическая шкала)' : 'vocabulary size |V| (log scale)'}</text>
      <text class="f-note" x={ru ? v.L - 40 : v.L} y={v.T - 8} text-anchor={ru ? 'start' : 'middle'}>{ru ? 'токенов на слово' : 'tokens / word'}</text>

      <path class="f-line f-red f-bold" d={v.held} />
      <path class="f-line f-blue f-bold" d={v.train} />
      {fertility.map((r) => <circle class="f-solid-red" cx={v.sx(r[1])} cy={v.sy(r[3])} r="3.2" />)}
      {fertility.map((r) => <circle class="f-solid-blue" cx={v.sx(r[1])} cy={v.sy(r[2])} r="3.2" />)}

      <circle class="f-fill-ink" cx={v.sx(wordLevel.vocab)} cy={v.sy(1)} r="5" />
      <text class="f-small f-halo" x={v.sx(wordLevel.vocab) + 6} y={v.sy(1) + 26} text-anchor="end">{ru ? 'слова' : 'words'}: {pctS} [UNK]</text>

      {[
        { cls: 'blue', text: ru ? `обучающий текст: ${lastRow[2].toFixed(2)} при |V| = ${fmt(lastRow[1])}` : `training text: ${lastRow[2].toFixed(2)} at |V| = ${lastRow[1].toLocaleString('en-US')}`, y: ru ? (v.narrow ? 1.6 : 1.25) : 1.75 },
        { cls: 'red', text: ru ? `отложенный текст: ${lastRow[3].toFixed(2)}` : `held-out text: ${lastRow[3].toFixed(2)}`, y: ru ? (v.narrow ? 1.3 : 0.85) : 1.35 },
      ].map((e) => (
        <g>
          <line class={`f-line f-bold f-${e.cls}`} x1={v.sx(24)} x2={v.sx(36)} y1={v.sy(e.y) - 5} y2={v.sy(e.y) - 5} />
          <text class={`${v.narrow ? 'f-small' : 'f-label'} f-t-${e.cls}`} x={v.sx(40)} y={v.sy(e.y)}>{v.narrow ? e.text.replace(/ (at|при) .*/, '') : e.text}</text>
        </g>
      ))}
      <text class="f-label f-t-blue f-halo" x={v.sx(fertility[0][1]) + 10} y={v.sy(fertility[0][2]) + (v.narrow ? 4 : 2)}>{ru ? 'символы' : 'characters'} {fertility[0][2].toFixed(2)}</text>
    </svg>
  ))}
</Figure>
