---
import Figure from '../Figure.astro';
import { fertility, phrase, wordLevel } from './bpe';
import { pageLang } from '../../../utils/lang';
import { fmtInt } from './ru';

const ru = pageLang(Astro.url) === 'ru';

// One phrase cut at four granularities. The subword rows come from BPE trained on our own
// English text (see `fertility` in bpe.ts); the word row uses the word types of the same text.
const at = (m: number) => fertility.find((r) => r[0] === m)!;
const pct = (wordLevel.heldOutUnk * 100).toFixed(1);
const pctS = ru ? `${pct}%` : `${pct} %`;
const perWord = (m: number) => (ru ? `${at(m)[3].toFixed(2)} токена на слово` : `${at(m)[3].toFixed(2)} tokens per word`);
const perWordShort = (m: number) => (ru ? `${at(m)[3].toFixed(2)} на слово` : `${at(m)[3].toFixed(2)} per word`);
const rows = [
  { name: ru ? 'Символы' : 'Characters', isWords: false, words: phrase.chars, vocab: at(0)[1], heldOut: perWord(0), short: perWordShort(0) },
  { name: ru ? 'BPE, 100 слияний' : 'BPE, 100 merges', isWords: false, words: phrase.bpe100, vocab: at(100)[1], heldOut: perWord(100), short: perWordShort(100) },
  { name: ru ? 'BPE, 2000 слияний' : 'BPE, 2,000 merges', isWords: false, words: phrase.bpe2000, vocab: at(2000)[1], heldOut: perWord(2000), short: perWordShort(2000) },
  { name: ru ? 'Слова' : 'Words', isWords: true, words: phrase.words, vocab: wordLevel.vocab, heldOut: ru ? `${pctS} слов — [UNK]` : `${pctS} of words [UNK]`, short: `${pctS} [UNK]` },
].map((r) => {
  const groups = r.words.map((w) => w.split(' '));
  return { ...r, groups, T: groups.reduce((a, g) => a + g.length, 0) };
});
const fmtV = (v: number) => fmtInt(v, ru);
const heldLabel = ru ? 'отложенный текст:' : 'held-out';

interface Layout { cls: string; W: number; x0: number; maxW: number; charW: number; pad: number; gap: number; wordGap: number; boxH: number; lineGap: number; tokCls: string; split: boolean }
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 680, x0: 20, maxW: 640, charW: 9, pad: 9, gap: 3, wordGap: 16, boxH: 28, lineGap: 8, tokCls: 'f-label', split: false },
  { cls: 'fig-narrow', W: 360, x0: 12, maxW: 336, charW: 7.6, pad: 7, gap: 2, wordGap: 11, boxH: 24, lineGap: 6, tokCls: 'f-small', split: true },
];

function flow(groups: string[][], L: Layout) {
  const boxes: { x: number; line: number; w: number; t: string }[] = [];
  let x = 0;
  let line = 0;
  const width = (t: string) => (t === '[UNK]' ? 5 : t.length) * L.charW + L.pad;
  groups.forEach((g) => {
    const gw = g.reduce((a, t) => a + width(t), 0) + (g.length - 1) * L.gap;
    if (x > 0 && x + gw > L.maxW) { x = 0; line += 1; }
    g.forEach((t) => { boxes.push({ x, line, w: width(t), t }); x += width(t) + L.gap; });
    x += L.wordGap - L.gap;
  });
  return { boxes, lines: line + 1 };
}

const built = layouts.map((L) => {
  let y = 10;
  const placed = rows.map((r) => {
    const f = flow(r.groups, L);
    const head = y;
    const top = head + (L.split ? 42 : 24);
    y = top + f.lines * (L.boxH + L.lineGap) + (L.split ? 18 : 22);
    return { ...r, ...f, head, top };
  });
  return { L, placed, H: y - 8 };
});
const id = 'tokenization-granularity';
---

<Figure
  id="granularity"
  title={ru ? 'Одна фраза, четыре словаря' : 'One phrase, four vocabularies'}
  caption={ru ? `Фраза «the decoder learns tokenization», разрезанная на токены словарями возрастающего размера; все они выучены на одном и том же английском обучающем тексте (${fmtV(26990)} словоупотреблений). Каждый прямоугольник — один токен; синие прямоугольники — многосимвольные токены, выученные BPE. T — число токенов во фразе, а значение для отложенного текста в каждой подписи — среднее число токенов на слово на другом тексте из того же источника. Символы дают длинные последовательности; словарь слов даёт один токен на слово, но в нём нет записи для «tokenization»: это слово ни разу не встретилось при обучении, и ту же участь разделяют ${pctS} слов отложенного текста. BPE находится посередине: при 2000 слияниях частые слова остаются целыми, а слово, не встречавшееся при обучении, собирается из четырёх известных кусков.` : `The phrase “the decoder learns tokenization” cut into tokens by vocabularies of increasing size, all learned from the same English training text (${fmtV(26990)} running words). Each box is one token; blue boxes are multi-character tokens learned by BPE. T counts the tokens of the phrase, and the held-out figure in each label is the average number of tokens per word on other text from the same source. Characters give long sequences; the word vocabulary gives one token per word but has no entry for “tokenization”, which never occurred in training, and ${pct} % of held-out words share that fate. BPE sits in between: with 2,000 merges the frequent words are whole and the unseen one is spelled from four known pieces.`}
>
  {built.map(({ L, placed, H }) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Одна и та же фраза в виде символов, двух словарей BPE и слов' : 'The same phrase as characters, two BPE vocabularies and words'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? `Четыре ряда прямоугольников-токенов для фразы the decoder learns tokenization. Символы: ${placed[0].T} токенов при словаре из 26. BPE со 100 слияниями: ${placed[1].T} токенов, словарь 126. BPE с 2000 слияниями: ${placed[2].T} токенов, словарь 2026; tokenization превращается в to, k, en, ization. Слова: ${placed[3].T} токена, словарь ${fmtV(wordLevel.vocab)}, и tokenization превращается в неизвестный токен.` : <>Four rows of token boxes for the phrase the decoder learns tokenization. Characters: {placed[0].T} tokens with a vocabulary of 26. BPE with 100 merges: {placed[1].T} tokens, vocabulary 126. BPE with 2,000 merges: {placed[2].T} tokens, vocabulary 2,026; tokenization becomes to, k, en, ization. Words: {placed[3].T} tokens, vocabulary {fmtV(wordLevel.vocab)}, and tokenization becomes the unknown token.</>}</desc>
      {placed.map((r) => (
        <g>
          <text class="f-title" x={L.x0} y={r.head + 14}>{r.name}</text>
          {L.split ? (
            <text class="f-note" x={L.x0} y={r.head + 33}>|V| = {fmtV(r.vocab)} · T = {r.T} · {heldLabel} {r.short}</text>
          ) : (
            <text class="f-note" x={L.x0 + L.maxW} y={r.head + 14} text-anchor="end">|V| = {fmtV(r.vocab)} · T = {r.T} · {heldLabel} {r.heldOut}</text>
          )}
          {r.boxes.map((b) => {
            const unk = b.t === '[UNK]';
            const multi = !unk && b.t.length > 1 && !r.isWords;
            const x = L.x0 + b.x;
            const y = r.top + b.line * (L.boxH + L.lineGap);
            return (
              <g>
                <rect class={unk ? 'f-box f-fill-red' : multi ? 'f-box f-fill-blue' : r.isWords ? 'f-box' : 'f-box-soft'} x={x} y={y} width={b.w} height={L.boxH} rx="4" />
                <text class={`${L.tokCls}${unk ? ' f-t-red' : ''}`} x={x + b.w / 2} y={y + L.boxH / 2 + 5} text-anchor="middle" font-family="var(--mono)">{b.t}</text>
              </g>
            );
          })}
        </g>
      ))}
    </svg>
  ))}
</Figure>
