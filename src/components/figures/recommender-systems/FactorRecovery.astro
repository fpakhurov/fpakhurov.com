---
import Figure from '../Figure.astro';
import { makeData, als, itemMeans, rmseMissing } from './recovery';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// 20 users × 30 items. True ratings 3 + p_u · q_i with rank-2 factors (entries N(0, 0.9²), seed 1), clipped to [1, 5]
// in 35 cells, so the truth is only approximately 3 plus a rank-2 matrix.
// About 40% of the cells are observed, with noise of standard deviation 0.25. Rank-2 ALS (penalty 1 per row solve,
// 60 sweeps) fits the observed cells only; the error is measured on the cells it never saw.
const users = 20, items = 30;
const { truth, obs, R } = makeData(1, users, items, 0.4);
const fit = als(R, obs, 1).fit;
const nObs = obs.flat().filter(Boolean).length;
const errMean = rmseMissing(itemMeans(R, obs), truth, obs);
const errAls = rmseMissing(fit, truth, obs);
const nClip = truth.flat().filter((v) => v === 1 || v === 5).length;
const checks = [nObs, errMean.toFixed(2), errAls.toFixed(2), nClip].join();
if (checks !== '247,0.94,0.31,35') throw new Error(`FactorRecovery: values drifted from the note (${checks})`);
const share = Math.round((100 * nObs) / (users * items));
const op = (v: number) => (0.06 + 0.86 * (Math.min(5, Math.max(1, v)) - 1) / 4).toFixed(3);
const panels = [
  { M: R, title: ru ? `наблюдаемые оценки (${share}%)` : `observed ratings (${share}%)`, sub: ru ? 'с шумом, пропуски пустые' : 'noisy; gaps left blank' },
  { M: fit, title: ru ? 'восстановление ALS, ранг 2' : 'ALS reconstruction, rank 2', sub: ru ? `ошибка на пропусках ${errAls.toFixed(2)}` : `error on the gaps ${errAls.toFixed(2)}` },
  { M: truth, title: ru ? 'истинная матрица' : 'true matrix', sub: ru ? `3 + ранг 2, обрезано ${nClip} клеток` : `3 + rank 2, ${nClip} cells clipped` },
];
const t = ru ? { users: 'пользователей', items: 'фильмов', scale: 'оценка' } : { users: 'users', items: 'films', scale: 'rating' };
const id = 'factor-recovery';
const layouts = [
  { cls: 'fig-wide', W: 760, H: 262, c: 7, origins: [[34, 46], [278, 46], [522, 46]], leg: [278, 236] },
  { cls: 'fig-narrow seq-narrow', W: 360, H: 704, c: 8, origins: [[60, 48], [60, 268], [60, 488]], leg: [60, 686] },
];
---

<Figure
  id={id}
  title={ru ? 'Матрица низкого ранга восстанавливается по 40% клеток' : 'A low-rank matrix recovered from 40% of its cells'}
  caption={ru
    ? `20 пользователей и 30 фильмов; истинные оценки 3 + p_u · q_i с векторами размерности 2, обрезанные до [1, 5]. Видно ${nObs} клеток из 600 (${share}%), с шумом со стандартным отклонением 0.25. Метод чередующихся наименьших квадратов (ALS) с рангом 2 подгоняется только по видимым клеткам, а на невидимых ошибается в среднем на ${errAls.toFixed(2)} балла (корень из среднего квадрата ошибки) против ${errMean.toFixed(2)} у предсказания средней оценкой фильма. Цвет — оценка, от 1 (светлый) до 5 (тёмный); предсказания вне [1, 5] показаны цветом ближайшего края шкалы.`
    : `20 users and 30 films; true ratings 3 + p_u · q_i with two-dimensional vectors, clipped to [1, 5]. ${nObs} of the 600 cells are seen (${share}%), with noise of standard deviation 0.25. Alternating least squares with rank 2 fits only the seen cells, and on the unseen ones it is off by ${errAls.toFixed(2)} stars (root mean squared error), against ${errMean.toFixed(2)} for predicting each film's mean rating. Colour is the rating, from 1 (light) to 5 (dark); predictions outside [1, 5] take the colour of the nearer end.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Три тепловые карты матрицы оценок' : 'Three heat maps of a rating matrix'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru ? `Слева разреженная матрица с пропусками, в центре восстановленная, справа истинная; восстановленная почти совпадает с истинной.` : `Left: the sparse matrix with gaps; middle: the reconstruction; right: the truth, which the reconstruction nearly matches.`}</desc>
      {panels.map((pn, k) => {
        const [ox, oy] = L.origins[k];
        return (
          <g>
            <text class="f-small" x={ox} y={oy - 24}>{pn.title}</text>
            <text class="f-small f-t-muted" x={ox} y={oy - 8}>{pn.sub}</text>
            {pn.M.map((row, u) => row.map((v, i) => (Number.isNaN(v)
              ? <rect x={ox + i * L.c} y={oy + u * L.c} width={L.c} height={L.c} style="fill: var(--paper); stroke: var(--line); stroke-width: .4" />
              : <rect x={ox + i * L.c} y={oy + u * L.c} width={L.c} height={L.c} style={`fill: var(--fig-blue); fill-opacity: ${op(v)}; stroke: var(--paper); stroke-width: .4`} />)))}
            <rect x={ox} y={oy} width={items * L.c} height={users * L.c} style="fill: none; stroke: var(--muted); stroke-width: .8" />
            <text class="f-small f-t-muted" x={ox + (items * L.c) / 2} y={oy + users * L.c + 16} text-anchor="middle">{`${items} ${t.items}`}</text>
            {(k === 0 || !L.cls.includes('fig-wide')) && (
              <text class="f-small f-t-muted" x={ox - 8} y={oy + (users * L.c) / 2} text-anchor="middle" transform={`rotate(-90 ${ox - 8} ${oy + (users * L.c) / 2})`}>{`${users} ${t.users}`}</text>
            )}
          </g>
        );
      })}
      <text class="f-small f-t-muted" x={L.leg[0]} y={L.leg[1] + 4}>{t.scale}</text>
      {[1, 2, 3, 4, 5].map((v, j) => (
        <g>
          <rect x={L.leg[0] + 52 + j * 34} y={L.leg[1] - 7} width="14" height="14" style={`fill: var(--fig-blue); fill-opacity: ${op(v)}; stroke: var(--line); stroke-width: .6`} />
          <text class="f-small" x={L.leg[0] + 70 + j * 34} y={L.leg[1] + 4}>{v}</text>
        </g>
      ))}
    </svg>
  ))}
</Figure>
