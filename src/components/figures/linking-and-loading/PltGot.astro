---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Lazy binding of bump() in prog-dyn, linked with ld.lld for riscv64 Linux against libcounter.so (the Code section
// of the note). Addresses from llvm-objdump: the calls in main go to bump@plt at 0x1400; its slot in .got.plt is at
// 0x3540 and initially holds 0x13e0, the address of the PLT header (PLT0); .got.plt[0] and [1], at 0x3530 and 0x3538,
// are filled by the dynamic linker with its resolver and its link map. Addresses are offsets from the load base.
const A = { callSite: 0x13b0, plt: 0x1400, plt0: 0x13e0, slot: 0x3540, got0: 0x3530, bumpInLib: 0x131c };
if (A.callSite + 80 !== A.plt) throw new Error('jalr 80(ra) from 0x13b0 must reach bump@plt');
if (0x3400 + 320 !== A.slot) throw new Error('auipc t3, 2 at 0x1400 plus 320 must reach the slot');
if (A.got0 + 16 !== A.slot) throw new Error('the slot of bump is the third entry of .got.plt');
const hex = (v: number) => '0x' + v.toString(16);
const t = ru
  ? {
      main: ['main (prog-dyn)', `${hex(A.callSite).slice(2)}: auipc ra, 0`, `jalr 80(ra) → ${hex(A.plt)}`],
      plt: [`bump@plt, ${hex(A.plt)}`, `t3 ← слот ${hex(A.slot)}`, 'jalr t1, t3'],
      slot: [`слот .got.plt, ${hex(A.slot)}`, `сначала: ${hex(A.plt0)} (PLT0)`, 'потом: адрес bump'],
      plt0: [`PLT0, ${hex(A.plt0)}`, 't0 ← .got.plt[1] (link map)', 'переход на .got.plt[0]'],
      res: ['резолвер (ld.so)', 'найти bump в libcounter.so', 'записать адрес в слот'],
      bump: ['bump (libcounter.so)', `база библиотеки + ${hex(A.bumpInLib)}`],
      l2: 'чтение слота', l3: 'первый вызов', l4: 'записать', l6: 'следующие вызовы',
      steps: [
        `main вызывает bump через PLT: переход на ${hex(A.plt)}`,
        `заглушка bump@plt читает слот ${hex(A.slot)} и переходит по записанному в нём адресу`,
        `при первом вызове там адрес PLT0, ${hex(A.plt0)}: PLT0 вычисляет номер слота и передаёт управление резолверу динамического компоновщика`,
        'резолвер ищет символ bump в загруженных библиотеках и записывает его адрес в слот',
        'резолвер переходит на bump; bump возвращается прямо в main',
        'следующие вызовы: заглушка читает из слота адрес bump и сразу переходит туда',
      ],
    }
  : {
      main: ['main (prog-dyn)', `${hex(A.callSite).slice(2)}: auipc ra, 0`, `jalr 80(ra) → ${hex(A.plt)}`],
      plt: [`bump@plt, ${hex(A.plt)}`, `t3 ← slot ${hex(A.slot)}`, 'jalr t1, t3'],
      slot: [`.got.plt slot, ${hex(A.slot)}`, `at first: ${hex(A.plt0)} (PLT0)`, 'later: address of bump'],
      plt0: [`PLT0, ${hex(A.plt0)}`, 't0 ← .got.plt[1] (link map)', 'jump to .got.plt[0]'],
      res: ['resolver (ld.so)', 'find bump in libcounter.so', 'write its address to the slot'],
      bump: ['bump (libcounter.so)', `library base + ${hex(A.bumpInLib)}`],
      l2: 'load slot', l3: 'first call', l4: 'write', l6: 'later calls',
      steps: [
        `main calls bump through the PLT: a jump to ${hex(A.plt)}`,
        `the stub bump@plt reads the slot at ${hex(A.slot)} and jumps to the address in it`,
        `on the first call that is PLT0, ${hex(A.plt0)}: PLT0 works out the slot number and jumps to the dynamic linker's resolver`,
        'the resolver looks up the symbol bump in the loaded libraries and writes its address into the slot',
        'the resolver jumps to bump; bump returns straight to main',
        'later calls: the stub reads the address of bump from the slot and jumps there directly',
      ],
    };
if (t.steps.length !== 6) throw new Error('six steps');
type Key = 'main' | 'plt' | 'slot' | 'plt0' | 'res' | 'bump';
type B = [number, number, number, number];
const tone: Record<Key, string> = { main: 'var(--fig-green)', plt: 'var(--fig-blue)', plt0: 'var(--fig-blue)', slot: 'var(--fig-amber)', res: 'var(--muted)', bump: 'var(--fig-red)' };
const stepOf: Record<Key, string> = { main: '1', plt: '2 6', slot: '2 4 6', plt0: '3', res: '4', bump: '5 6' };
interface Arrow { d: string; s: string; cls: string; head: string; label?: string; at?: [number, number]; anchor?: 'start' | 'end' | 'middle' }
interface Layout { cls: string; W: number; H: number; box: Record<Key, B>; arrows: Arrow[]; badges: [number, number, number][] }
const ink = 'url(#f-arrow)', blue = 'url(#f-arrow-blue)', amber = 'url(#f-arrow-amber)', red = 'url(#f-arrow-red)';
const layouts: Layout[] = [
  {
    cls: 'fig-wide', W: 760, H: 340,
    box: { main: [20, 20, 250, 76], plt: [20, 140, 250, 76], plt0: [20, 256, 250, 76], slot: [320, 140, 200, 76], res: [520, 256, 230, 76], bump: [520, 20, 230, 60] },
    arrows: [
      { d: 'M 100 98 V 137', s: '1', cls: 'f-line', head: ink },
      { d: 'M 272 178 H 317', s: '2', cls: 'f-line f-amber', head: amber, label: t.l2, at: [295, 134], anchor: 'middle' },
      { d: 'M 100 218 V 253', s: '3', cls: 'f-line f-blue', head: blue, label: t.l3, at: [108, 240] },
      { d: 'M 272 294 H 517', s: '3', cls: 'f-line f-blue', head: blue },
      { d: 'M 600 254 V 236 H 420 V 219', s: '4', cls: 'f-line f-amber', head: amber, label: t.l4, at: [430, 250] },
      { d: 'M 680 254 V 83', s: '5', cls: 'f-line f-red', head: red },
      { d: 'M 240 138 V 118 H 620 V 83', s: '6', cls: 'f-line f-red f-dash', head: red, label: t.l6, at: [300, 112] },
    ],
    badges: [[84, 118, 1], [295, 196, 2], [84, 236, 3], [520, 236, 4], [696, 168, 5], [250, 112, 6]],
  },
  {
    cls: 'fig-narrow seq-narrow', W: 360, H: 552,
    box: { main: [40, 8, 280, 72], plt: [40, 100, 280, 72], slot: [40, 192, 280, 72], plt0: [40, 284, 280, 72], res: [40, 376, 280, 72], bump: [40, 476, 280, 60] },
    arrows: [
      { d: 'M 180 82 V 97', s: '1', cls: 'f-line', head: ink },
      { d: 'M 180 174 V 189', s: '2', cls: 'f-line f-amber', head: amber },
      { d: 'M 180 266 V 281', s: '3', cls: 'f-line f-blue', head: blue },
      { d: 'M 180 358 V 373', s: '3', cls: 'f-line f-blue', head: blue },
      { d: 'M 38 412 H 22 V 228 H 37', s: '4', cls: 'f-line f-amber', head: amber },
      { d: 'M 180 450 V 473', s: '5', cls: 'f-line f-red', head: red },
      { d: 'M 322 136 H 340 V 506 H 323', s: '6', cls: 'f-line f-red f-dash', head: red },
    ],
    badges: [[160, 90, 1], [160, 182, 2], [160, 274, 3], [22, 320, 4], [160, 462, 5], [340, 320, 6]],
  },
];
const id = 'plt-got';
---

<Figure
  id={id}
  title={ru ? 'Ленивое связывание через PLT и GOT' : 'Lazy binding through the PLT and the GOT'}
  caption={ru
    ? `Вызов функции bump из разделяемой библиотеки в программе prog-dyn для riscv64 Linux (компоновщик ld.lld); адреса — смещения от базы загрузки программы. Код вызывает не bump, а короткую заглушку bump@plt (1), которая переходит по адресу из своего слота в .got.plt (2). Сначала в слоте адрес общей заглушки PLT0, и первый вызов попадает в резолвер динамического компоновщика (3), который находит bump, записывает её адрес в слот (4) и передаёт ей управление (5). Со второго вызова слот уже указывает на bump, и путь короче (6). Код остаётся только для чтения и общим для всех процессов; меняется лишь слот, лежащий в данных процесса.`
    : `A call to bump, a function in a shared library, in the program prog-dyn for riscv64 Linux (linker ld.lld); addresses are offsets from the program's load base. The code calls not bump but a short stub, bump@plt (1), which jumps to the address in its slot in .got.plt (2). At first the slot holds the address of the common stub PLT0, so the first call ends up in the dynamic linker's resolver (3), which finds bump, writes its address into the slot (4) and transfers control to it (5). From the second call on, the slot points at bump and the path is shorter (6). The code stays read-only and shared between processes; only the slot, in the process's own data, changes.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Путь вызова через PLT при первом и последующих вызовах' : 'The path of a call through the PLT on the first and later calls'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? `Блоки: main, заглушка bump@plt, слот .got.plt по адресу ${hex(A.slot)}, общая заглушка PLT0, резолвер ld.so и функция bump в библиотеке. Сплошные стрелки показывают первый вызов: main, bump@plt, чтение слота, PLT0, резолвер, запись в слот, bump. Пунктирная стрелка ведёт от bump@plt прямо к bump для следующих вызовов.`
        : `Boxes: main, the stub bump@plt, the .got.plt slot at ${hex(A.slot)}, the common stub PLT0, the ld.so resolver, and the function bump in the library. Solid arrows show the first call: main, bump@plt, a read of the slot, PLT0, the resolver, a write into the slot, bump. A dashed arrow leads from bump@plt straight to bump for later calls.`}</desc>
      {L.arrows.map((a) => (
        <g data-s={a.s}>
          <path class={a.cls} d={a.d} marker-end={a.head} />
          {a.label && a.at && <text class={`f-small f-halo ${a.cls.includes('amber') ? 'f-t-amber' : a.cls.includes('blue') ? 'f-t-blue' : 'f-t-red'}`} x={a.at[0]} y={a.at[1]} text-anchor={a.anchor ?? 'start'}>{a.label}</text>}
        </g>
      ))}
      {(Object.keys(L.box) as Key[]).map((k) => {
        const b = L.box[k], lines = t[k];
        return (
          <g data-s={stepOf[k]}>
            <rect x={b[0]} y={b[1]} width={b[2]} height={b[3]} rx="7" style={`fill: ${tone[k]}; fill-opacity: 0.12; stroke: ${tone[k]}; stroke-width: 1.3`} />
            <text class="f-small" x={b[0] + 10} y={b[1] + 19} style="font-weight: 600">{lines[0]}</text>
            {lines.slice(1).map((line, i) => (
              <text class="f-small f-t-muted" x={b[0] + 10} y={b[1] + 40 + i * 20} style="font-family: var(--mono, ui-monospace, monospace)">{line}</text>
            ))}
          </g>
        );
      })}
      {L.badges.map(([x, y, n]) => <g data-s={String(n)}><Badge x={x} y={y} n={n} /></g>)}
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
