---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// Static linking of start.o, main.o and counter.o for riscv64 Linux with ld.lld (LLVM 17), as dumped by llvm-objdump
// and llvm-readelf in the note's Code section. The linker resolves the undefined symbols, places the sections at
// addresses, and patches each relocation: R_RISCV_CALL_PLT with S - P, R_RISCV_HI20 and R_RISCV_LO12_I with the
// upper 20 and lower 12 bits of S, where the lower part is sign-extended (hence the + 0x800).
const S = { start: 0x11190, main: 0x111a0, bump: 0x111d8, counter: 0x121fc, calls: 0x12200 };
const P = { call1: S.main + 0x0c, call2: S.main + 0x18, lui: S.main + 0x20, lw: S.main + 0x24 };
const hi = (v: number) => (v + 0x800) >> 12;
const lo = (v: number) => v - (hi(v) << 12);
const callOff = S.bump - P.call1;
if (callOff !== 44 || hi(callOff) !== 0 || S.bump - P.call2 !== 32) throw new Error('call offsets');
if (hi(S.counter) !== 18 || lo(S.counter) !== 508 || lo(S.calls) !== 512) throw new Error('hi/lo of counter');
const hex = (v: number) => v.toString(16);

const t = ru
  ? {
      ld: 'компоновщик', mainO: 'main.o', counterO: 'counter.o', startO: 'start.o', prog: 'prog',
      mainLines: ['.text, 56 байт:', '0c: auipc ra, 0  ← CALL bump', '10: jalr ra', '20: lui a1, 0    ← HI20 counter', '24: lw a1, 0(a1) ← LO12 counter', 'символы: main T, bump U, counter U'],
      counterLines: ['.text: bump, 36 байт', '.data: counter = 5, 4 байта', '.bss: calls, 4 байта (не в файле)', 'символы: bump T, counter D, calls b'],
      startLines: ['_start: call main; exit'],
      progLines: [`.text  ${hex(S.start)}: _start, main, bump`, `${hex(P.call1)}: auipc ra, 0`, `${hex(P.call1 + 4)}: jalr ${callOff}(ra)`, `${hex(P.lui)}: lui a1, ${hi(S.counter)}`, `${hex(P.lw)}: lw a1, ${lo(S.counter)}(a1)`, `.data  ${hex(S.counter)}: counter`, `.bss   ${hex(S.calls)}: calls`],
      steps: ['разрешение символов: bump и counter, неопределённые в main.o, найдены в counter.o', 'размещение: секции .text, .data и .bss всех файлов сливаются и получают адреса', `перемещение: в каждое отмеченное место вписывается адрес; вызов получает смещение ${callOff}, загрузка counter — ${hi(S.counter)} и ${lo(S.counter)}`],
    }
  : {
      ld: 'linker', mainO: 'main.o', counterO: 'counter.o', startO: 'start.o', prog: 'prog',
      mainLines: ['.text, 56 bytes:', '0c: auipc ra, 0  ← CALL bump', '10: jalr ra', '20: lui a1, 0    ← HI20 counter', '24: lw a1, 0(a1) ← LO12 counter', 'symbols: main T, bump U, counter U'],
      counterLines: ['.text: bump, 36 bytes', '.data: counter = 5, 4 bytes', '.bss: calls, 4 bytes (not in file)', 'symbols: bump T, counter D, calls b'],
      startLines: ['_start: call main; exit'],
      progLines: [`.text  ${hex(S.start)}: _start, main, bump`, `${hex(P.call1)}: auipc ra, 0`, `${hex(P.call1 + 4)}: jalr ${callOff}(ra)`, `${hex(P.lui)}: lui a1, ${hi(S.counter)}`, `${hex(P.lw)}: lw a1, ${lo(S.counter)}(a1)`, `.data  ${hex(S.counter)}: counter`, `.bss   ${hex(S.calls)}: calls`],
      steps: ['symbol resolution: bump and counter, undefined in main.o, are found in counter.o', 'layout: the .text, .data and .bss sections of all files are merged and given addresses', `relocation: an address is written into each marked place; the call gets the offset ${callOff}, the load of counter ${hi(S.counter)} and ${lo(S.counter)}`],
    };
// Which step each line belongs to: symbol lines are step 1, section lines 2, instruction lines 3.
const mainStep = [2, 3, 3, 3, 3, 1], counterStep = [2, 2, 2, 1], progStep = [2, 3, 3, 3, 3, 2, 2];
type Box = { x: number; y: number; w: number; title: string; lines: string[]; steps: number[]; tone: string };
interface Layout { cls: string; W: number; H: number; lh: number; boxes: Box[]; arrows: { d: string; s: number }[]; ld: [number, number]; badges: [number, number, number][] }
const boxH = (b: Box, lh: number) => 30 + b.lines.length * lh;
const green = 'var(--fig-green)', blue = 'var(--fig-blue)', red = 'var(--fig-red)';
const wideBoxes: Box[] = [
  { x: 8, y: 20, w: 300, title: t.mainO, lines: t.mainLines, steps: mainStep, tone: green },
  { x: 8, y: 198, w: 300, title: t.counterO, lines: t.counterLines, steps: counterStep, tone: green },
  { x: 8, y: 334, w: 300, title: t.startO, lines: t.startLines, steps: [2], tone: green },
  { x: 452, y: 96, w: 300, title: t.prog, lines: t.progLines, steps: progStep, tone: red },
];
const narrowBoxes: Box[] = [
  { x: 8, y: 8, w: 344, title: t.mainO, lines: t.mainLines, steps: mainStep, tone: green },
  { x: 8, y: 182, w: 344, title: t.counterO, lines: t.counterLines, steps: counterStep, tone: green },
  { x: 8, y: 320, w: 344, title: t.startO, lines: t.startLines, steps: [2], tone: green },
  { x: 8, y: 432, w: 344, title: t.prog, lines: t.progLines, steps: progStep, tone: red },
];
const layouts: Layout[] = [
  {
    cls: 'fig-wide', W: 760, H: 394, lh: 22, boxes: wideBoxes, ld: [380, 210],
    arrows: [
      { d: 'M 310 100 C 380 100, 380 190, 449 190', s: 2 },
      { d: 'M 310 250 C 380 250, 380 220, 449 220', s: 2 },
      { d: 'M 310 360 C 390 360, 390 250, 449 250', s: 2 },
    ],
    badges: [[330, 46, 1], [380, 178, 2], [430, 76, 3]],
  },
  {
    cls: 'fig-narrow seq-narrow', W: 360, H: 628, lh: 22, boxes: narrowBoxes, ld: [214, 410],
    arrows: [{ d: 'M 180 378 V 429', s: 2 }],
    badges: [[336, 30, 1], [160, 404, 2], [336, 456, 3]],
  },
];
const id = 'linker-flow';
---

<Figure
  id={id}
  title={ru ? 'Что компоновщик делает с тремя объектными файлами' : 'What the linker does with three object files'}
  caption={ru
    ? `Статическая компоновка программы из раздела «Код» для riscv64 Linux (ld.lld из LLVM 17). Слева объектные файлы с адресами от нуля: в main.o вызов bump и загрузка counter содержат нули и записи перемещения (CALL, HI20, LO12). Компоновщик находит определения неопределённых символов (1), сливает одноимённые секции и назначает им адреса (2) и вписывает адреса в отмеченные команды (3). Вызов получает смещение ${hex(S.bump)} − ${hex(P.call1)} = ${callOff}; адрес counter, 0x${hex(S.counter)}, делится на старшие 20 бит, ${hi(S.counter)}, для lui и младшие 12, ${lo(S.counter)}, для lw.`
    : `Static linking of the program in the Code section for riscv64 Linux (ld.lld from LLVM 17). On the left, the object files with addresses starting at zero: in main.o the call to bump and the load of counter hold zeros and relocation entries (CALL, HI20, LO12). The linker finds the definitions of the undefined symbols (1), merges sections of the same name and gives them addresses (2), and writes the addresses into the marked instructions (3). The call gets the offset ${hex(S.bump)} − ${hex(P.call1)} = ${callOff}; the address of counter, 0x${hex(S.counter)}, is split into its upper 20 bits, ${hi(S.counter)}, for lui and its lower 12, ${lo(S.counter)}, for lw.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Объектные файлы и исполняемый файл после компоновки' : 'Object files and the executable after linking'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? `Блоки main.o, counter.o и start.o со строками их секций, команд с записями перемещения и символов; стрелки ведут к блоку prog, где те же команды стоят по адресам ${hex(P.call1)} и ${hex(P.lui)} с вписанными числами ${callOff}, ${hi(S.counter)} и ${lo(S.counter)}, а counter и calls лежат по адресам ${hex(S.counter)} и ${hex(S.calls)}.`
        : `Boxes for main.o, counter.o and start.o listing their sections, the instructions with relocation entries, and their symbols; arrows lead to a box for prog, where the same instructions sit at ${hex(P.call1)} and ${hex(P.lui)} with the numbers ${callOff}, ${hi(S.counter)} and ${lo(S.counter)} filled in, and counter and calls sit at ${hex(S.counter)} and ${hex(S.calls)}.`}</desc>
      {L.arrows.map((a) => <path data-s={String(a.s)} class="f-line f-muted" d={a.d} marker-end="url(#f-arrow-muted)" />)}
      <text data-s="2" class="f-small f-t-muted f-halo" x={L.ld[0]} y={L.ld[1]} text-anchor="middle">{t.ld}</text>
      {L.boxes.map((b) => (
        <g>
          <rect x={b.x} y={b.y} width={b.w} height={boxH(b, L.lh)} rx="7" style={`fill: ${b.tone}; fill-opacity: 0.08; stroke: ${b.tone}; stroke-width: 1.3`} />
          <text class="f-small" x={b.x + 10} y={b.y + 19} style="font-weight: 600">{b.title}</text>
          {b.lines.map((line, i) => (
            <text data-s={String(b.steps[i])} class={`f-small ${b.steps[i] === 3 ? 'f-t-blue' : b.steps[i] === 1 ? 'f-t-amber' : ''}`} x={b.x + 10} y={b.y + 40 + i * L.lh} style="font-family: var(--mono, ui-monospace, monospace)">{line}</text>
          ))}
        </g>
      ))}
      {L.badges.map(([x, y, n]) => <g data-s={String(n)}><Badge x={x} y={y} n={n} /></g>)}
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
