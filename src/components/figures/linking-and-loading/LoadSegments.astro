---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// How execve turns the static executable prog of the note (riscv64, ld.lld) into a process image. Numbers from
// llvm-readelf -l: three LOAD segments; the third has FileSiz 4 and MemSiz 8, so 4 bytes of .bss are zero-filled.
const seg = [
  { off: 0x0, vaddr: 0x10000, filesz: 0x190, memsz: 0x190, flags: 'r--' },
  { off: 0x190, vaddr: 0x11190, filesz: 0x6c, memsz: 0x6c, flags: 'r-x' },
  { off: 0x1fc, vaddr: 0x121fc, filesz: 0x4, memsz: 0x8, flags: 'rw-' },
];
const fileSize = 1528, entry = 0x11190;
// A segment may start mid-page, but its offset and address must agree modulo the page size (0x1000).
seg.forEach((s) => { if ((s.off - s.vaddr) % 0x1000 !== 0) throw new Error('offset and address disagree modulo the page'); });
if (seg[1].filesz !== 108 || seg[2].memsz - seg[2].filesz !== 4 || fileSize.toString(16) !== '5f8' || seg[1].vaddr !== entry) throw new Error('segments');
const hex = (v: number, w = 3) => '0x' + v.toString(16).padStart(w, '0');
const rng = (a: number, b: number) => `${hex(a)}–${hex(b)}`;
const t = ru
  ? {
      file: 'файл prog, 1528 байт', mem: 'память процесса',
      fileRows: [[rng(0, 0x190), 'заголовки ELF'], [rng(0x190, 0x1fc), '.text, 108 байт'], [rng(0x1fc, 0x200), '.data, 4 байта'], [rng(0x200, fileSize), 'символы, строки']],
      memRows: [[`${hex(0x10000)}  r--`, 'заголовки'], [`${hex(0x11190)}  r-x`, '.text; точка входа'], [`${hex(0x121fc)}  rw-`, '.data из файла'], [`${hex(0x12200)}  rw-`, '.bss: 4 нулевых байта']],
      stack: ['стек', 'argv, envp, auxv'], entry: `pc ← ${hex(entry)}, точка входа`,
      steps: ['ядро читает заголовок ELF и таблицу программных заголовков', 'каждый сегмент LOAD отображается по своему адресу со своими правами r, w, x', 'память сегмента за концом его данных в файле заполняется нулями: это .bss', 'ядро строит стек: argc, argv, переменные окружения и вспомогательный вектор', `процесс начинает выполнение с точки входа, ${hex(entry)}`],
    }
  : {
      file: 'file prog, 1,528 bytes', mem: 'process memory',
      fileRows: [[rng(0, 0x190), 'ELF + program headers'], [rng(0x190, 0x1fc), '.text, 108 bytes'], [rng(0x1fc, 0x200), '.data, 4 bytes'], [rng(0x200, fileSize), 'symbols, strings']],
      memRows: [[`${hex(0x10000)}  r--`, 'headers'], [`${hex(0x11190)}  r-x`, '.text; entry point'], [`${hex(0x121fc)}  rw-`, '.data from the file'], [`${hex(0x12200)}  rw-`, '.bss: 4 zero bytes']],
      stack: ['stack', 'argv, envp, auxv'], entry: `pc ← ${hex(entry)}, the entry point`,
      steps: ['the kernel reads the ELF header and the table of program headers', 'each LOAD segment is mapped at its address with its r, w, x permissions', 'memory of a segment beyond its bytes in the file is filled with zeros: that is .bss', 'the kernel builds the stack: argc, argv, the environment and the auxiliary vector', `the process starts at the entry address, ${hex(entry)}`],
    };
interface Layout { cls: string; W: number; H: number; fx: number; mx: number; cw: number; top: number; labels: boolean; badges: [number, number, number][] }
const rowY = (L: Layout, i: number) => L.top + i * 48;
const layouts: Layout[] = [
  { cls: 'fig-wide', W: 760, H: 340, fx: 20, mx: 440, cw: 300, top: 40, labels: true, badges: [[10, 62, 1], [370, 122, 2], [750, 206, 3], [750, 284, 4], [430, 326, 5]] },
  { cls: 'fig-narrow', W: 360, H: 340, fx: 22, mx: 198, cw: 154, top: 40, labels: false, badges: [[11, 62, 1], [187, 30, 2], [187, 206, 3], [187, 284, 4], [11, 326, 5]] },
];
const loadTone = ['var(--fig-blue)', 'var(--fig-blue)', 'var(--fig-green)'];
const id = 'load-segments';
---

<Figure
  id={id}
  title={ru ? 'Как загрузчик превращает исполняемый файл в образ процесса' : 'How the loader turns an executable file into a process image'}
  caption={ru
    ? `Загрузка статического исполняемого файла prog из раздела «Код» (riscv64 Linux). Слева байты файла, справа адреса в памяти процесса. Программные заголовки описывают три сегмента LOAD: заголовки (только чтение), код (чтение и исполнение) и данные (чтение и запись). Смещение сегмента в файле и его адрес совпадают по модулю размера страницы, 0x1000, поэтому ядро может отобразить страницы файла, не копируя их. У сегмента данных 4 байта в файле и 8 в памяти: остаток — .bss, заполненный нулями. Таблица символов и строки в память не загружаются. Затем ядро строит стек и передаёт управление на точку входа.`
    : `Loading the static executable prog of the Code section (riscv64 Linux). On the left, the bytes of the file; on the right, addresses in the process's memory. The program headers describe three LOAD segments: the headers (read-only), the code (read and execute) and the data (read and write). A segment's offset in the file and its address agree modulo the page size, 0x1000, so the kernel can map the file's pages without copying them. The data segment has 4 bytes in the file and 8 in memory: the rest is .bss, filled with zeros. The symbol table and the strings are not loaded. The kernel then builds the stack and transfers control to the entry address.`}
>
  {layouts.map((L) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Сегменты файла и области памяти' : 'File segments and memory regions'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? `Слева четыре части файла: заголовки до 0x190, код до 0x1fc, данные до 0x200 и не загружаемые символы до 0x5f8. Справа области памяти: 0x10000 только чтение, 0x11190 чтение и исполнение, 0x121fc данные, 0x12200 обнулённый .bss, ниже стек. Стрелки соединяют три первые части файла с тремя областями памяти.`
        : `On the left, four parts of the file: headers up to 0x190, code up to 0x1fc, data up to 0x200, and symbols up to 0x5f8 that are not loaded. On the right, memory regions: 0x10000 read-only, 0x11190 read and execute, 0x121fc data, 0x12200 the zeroed .bss, and the stack below. Arrows connect the first three parts of the file to the first three regions.`}</desc>
      <text class="f-small" x={L.fx} y={24} style="font-weight: 600">{t.file}</text>
      <text class="f-small" x={L.mx} y={24} style="font-weight: 600">{t.mem}</text>
      {seg.map((s, i) => (
        <g data-s="2">
          <path class="f-line f-muted" d={`M ${L.fx + L.cw + 2} ${rowY(L, i) + 22} H ${L.mx - 3}`} marker-end="url(#f-arrow-muted)" />
          {L.labels && <text class="f-small f-t-muted f-halo" x={(L.fx + L.cw + L.mx) / 2} y={rowY(L, i) + 16} text-anchor="middle">LOAD {s.flags}</text>}
        </g>
      ))}
      {t.fileRows.map((r, i) => (
        <g data-s={i === 0 ? '1' : i === 3 ? undefined : '2'}>
          <rect class={i === 3 ? 'f-box-soft f-dash' : ''} x={L.fx} y={rowY(L, i)} width={L.cw} height="44" rx="5" style={i === 3 ? '' : `fill: ${loadTone[i]}; fill-opacity: 0.12; stroke: ${loadTone[i]}; stroke-width: 1.2`} />
          <text class="f-small f-t-muted" x={L.fx + 8} y={rowY(L, i) + 17} style="font-family: var(--mono, ui-monospace, monospace)">{r[0]}</text>
          <text class="f-small" x={L.fx + 8} y={rowY(L, i) + 35}>{r[1]}</text>
        </g>
      ))}
      {t.memRows.map((r, i) => (
        <g data-s={i === 3 ? '3' : '2'}>
          <rect x={L.mx} y={rowY(L, i)} width={L.cw} height="44" rx="5" style={`fill: ${i === 3 ? 'var(--fig-green)' : loadTone[i]}; fill-opacity: ${i === 3 ? 0.05 : 0.12}; stroke: ${i === 3 ? 'var(--fig-green)' : loadTone[i]}; stroke-width: 1.2`} />
          <text class="f-small f-t-muted" x={L.mx + 8} y={rowY(L, i) + 17} style="font-family: var(--mono, ui-monospace, monospace)">{r[0]}</text>
          <text class="f-small" x={L.mx + 8} y={rowY(L, i) + 35}>{r[1]}</text>
        </g>
      ))}
      <path class="f-thin f-muted f-dot" d={`M ${L.mx + L.cw / 2} ${rowY(L, 4) - 2} V ${rowY(L, 4) + 18}`} />
      <g data-s="4">
        <rect x={L.mx} y={rowY(L, 4) + 22} width={L.cw} height="44" rx="5" style="fill: var(--fig-red); fill-opacity: 0.1; stroke: var(--fig-red); stroke-width: 1.2" />
        <text class="f-small" x={L.mx + 8} y={rowY(L, 4) + 39} style="font-weight: 600">{t.stack[0]}</text>
        <text class="f-small" x={L.mx + 8} y={rowY(L, 4) + 57}>{t.stack[1]}</text>
      </g>
      <text data-s="5" class="f-small f-t-red" x={L.labels ? 446 : 26} y={330} style="font-family: var(--mono, ui-monospace, monospace)">{t.entry}</text>
      {L.badges.map(([x, y, n]) => <g data-s={String(n)}><Badge x={x} y={y} n={n} /></g>)}
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
