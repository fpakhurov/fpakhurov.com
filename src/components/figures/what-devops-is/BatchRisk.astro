---
import Figure from '../Figure.astro';
import { scale } from '../geometry';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// k independent changes deployed together, each faulty with probability p:
// the deployment fails unless all k are good, P = 1 - (1 - p)^k.
const fail = (p: number, k: number) => 1 - (1 - p) ** k;
const check = (p: number, k: number, want: number) => {
  if (Math.abs(fail(p, k) - want) > 5e-5) throw new Error(`P(fail) p=${p} k=${k}: ${fail(p, k)}`);
};
check(0.05, 1, 0.05); check(0.05, 10, 0.4013); check(0.05, 20, 0.6415); check(0.05, 50, 0.9231);
check(0.01, 50, 0.395); check(0.1, 10, 0.6513);
// Given a failure, the expected number of faulty changes in the batch is kp / P.
if (Math.abs((10 * 0.05) / fail(0.05, 10) - 1.246) > 5e-4) throw new Error('E[faulty | fail] at k = 10');

const curves = [
  { p: 0.01, cls: 'f-green', tcls: 'f-t-green' },
  { p: 0.05, cls: 'f-blue', tcls: 'f-t-blue' },
  { p: 0.1, cls: 'f-red', tcls: 'f-t-red' },
];
const marks = [10, 20];
const K = 50;
const t = ru
  ? { x: 'k — число изменений в выкладке', y: 'P(выкладка неудачна)', yN: 'P(неудача)', p: (p: number) => `p = ${p.toFixed(2)}` }
  : { x: 'k, changes in one deployment', y: 'P(deployment fails)', yN: 'P(fails)', p: (p: number) => `p = ${p.toFixed(2)}` };

interface Layout { cls: string; W: number; H: number; box: [number, number, number, number]; yLabel: string }
const layouts: Layout[] = [
  { cls: 'fig-wide fig-bp-640', W: 760, H: 320, box: [70, 30, 650, 260], yLabel: t.y },
  { cls: 'fig-narrow fig-bp-640', W: 360, H: 330, box: [52, 34, 290, 260], yLabel: t.yN },
];
const plots = layouts.map((L) => {
  const [x0, y0, x1, y1] = L.box;
  const sx = scale([1, K], [x0, x1]);
  const sy = scale([0, 1], [y1, y0]);
  const path = (p: number) => Array.from({ length: K }, (_, i) => i + 1)
    .map((k, i) => `${i ? 'L' : 'M'} ${sx(k).toFixed(1)} ${sy(fail(p, k)).toFixed(1)}`).join(' ');
  // Curve labels at the right ends must not overlap: at least 14 px apart.
  const ends = curves.map((c) => sy(fail(c.p, K))).sort((a, b) => a - b);
  for (let i = 1; i < ends.length; i++) if (ends[i] - ends[i - 1] < 14) throw new Error(`end labels overlap at ${L.W}`);
  if (x1 + 8 + t.p(0.1).length * 6.5 > L.W - 4) throw new Error(`end labels overflow at ${L.W}`);
  if (x0 + t.x.length * 6.5 / 2 > L.W || (x0 + x1) / 2 + t.x.length * 6.5 / 2 > L.W - 4) throw new Error('x label');
  if (L.yLabel.length * 6.5 > x0 + (x1 - x0) * 0.6) throw new Error('y label');
  return { L, sx, sy, path };
});
const id = 'batch-risk';
---

<Figure
  id={id}
  title={ru ? 'Вероятность неудачной выкладки растёт с размером пакета' : 'The chance that a deployment fails grows with the batch'}
  caption={ru
    ? 'Выкладка из k независимых изменений, каждое из которых ошибочно с вероятностью p, удачна, только если все k без ошибок, поэтому P(неудача) = 1 − (1 − p)^k. При p = 0.05 одно изменение ломает выкладку в 5% случаев, пакет из 10 — в 40%, из 20 — в 64%, из 50 — в 92%. Число ошибочных изменений от пакетирования не зависит (в среднем kp); меняется то, сколько корректных изменений откатывается вместе с ними и сколько усилий уходит на поиск виновника.'
    : 'A deployment of k independent changes, each faulty with probability p, succeeds only if all k are good, so P(fails) = 1 − (1 − p)^k. At p = 0.05 one change breaks a deployment 5% of the time, a batch of 10 40% of the time, 20 changes 64%, 50 changes 92%. Batching does not change how many changes are faulty (kp on average); it changes how many good changes are rolled back with them and how much searching it takes to find the culprit.'}
>
  {plots.map(({ L, sx, sy, path }) => {
    const [x0, y0, x1, y1] = L.box;
    return (
      <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
        <title id={`${id}-${L.W}-t`}>{ru ? 'Вероятность неудачи выкладки в зависимости от числа изменений' : 'Probability that a deployment fails against the number of changes in it'}</title>
        <desc id={`${id}-${L.W}-d`}>{ru
          ? 'Три возрастающие кривые от k = 1 до k = 50 для p = 0.01, 0.05 и 0.10. При p = 0.05 отмечены точки k = 10 (40%) и k = 20 (64%). Кривая для p = 0.10 почти достигает единицы к k = 50, для p = 0.01 доходит до 39%.'
          : 'Three rising curves from k = 1 to k = 50 for p = 0.01, 0.05 and 0.10. On the p = 0.05 curve the points k = 10 (40%) and k = 20 (64%) are marked. The curve for p = 0.10 almost reaches one by k = 50; the one for p = 0.01 reaches 39%.'}</desc>
        {[0, 0.25, 0.5, 0.75, 1].map((v) => (
          <g>
            <path class="f-grid" d={`M ${x0} ${sy(v)} H ${x1}`} />
            <text class="f-note" x={x0 - 8} y={sy(v) + 5} text-anchor="end">{`${Math.round(v * 100)}%`}</text>
          </g>
        ))}
        {[1, 10, 20, 30, 40, 50].map((k) => (
          <g>
            <path class="f-axis" d={`M ${sx(k)} ${y1} v 5`} />
            <text class="f-note" x={sx(k)} y={y1 + 20} text-anchor="middle">{k}</text>
          </g>
        ))}
        <path class="f-axis" d={`M ${x0} ${y0} V ${y1} H ${x1}`} />
        <text class="f-note" x={(x0 + x1) / 2} y={y1 + 42} text-anchor="middle">{t.x}</text>
        <text class="f-small f-t-muted" x={x0} y={y0 - 14}>{L.yLabel}</text>
        {curves.map((c) => (
          <g>
            <path class={`f-line ${c.cls} f-bold`} d={path(c.p)} />
            <text class={`f-small ${c.tcls}`} x={x1 + 8} y={sy(fail(c.p, K)) + 4.5} style="font-weight: 650">{t.p(c.p)}</text>
          </g>
        ))}
        {marks.map((k) => (
          <g>
            <path class="f-thin f-muted f-dash" d={`M ${sx(k)} ${sy(fail(0.05, k))} V ${y1}`} />
            <circle cx={sx(k)} cy={sy(fail(0.05, k))} r="4.5" class="f-solid-blue" />
            <text class="f-small f-halo" x={sx(k) + 8} y={sy(fail(0.05, k)) + 18}>{`${Math.round(100 * fail(0.05, k))}%`}</text>
          </g>
        ))}
        <circle cx={sx(1)} cy={sy(0.05)} r="4.5" class="f-solid-blue" />
      </svg>
    );
  })}
</Figure>
