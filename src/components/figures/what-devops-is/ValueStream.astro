---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The value stream of one change in the example of the note: five stages after the commit,
// each preceded by a queue. Hours of work and of waiting; the totals are asserted below.
const stages = [
  { en: 'review', ru: 'ревью', work: 0.5, wait: 18 },
  { en: 'CI', ru: 'CI', work: 0.3, wait: 0.5 },
  { en: 'staging QA', ru: 'проверка', work: 2, wait: 96 },
  { en: 'approval', ru: 'одобрение', work: 0.2, wait: 48 },
  { en: 'deploy', ru: 'выкладка', work: 0.5, wait: 2 },
];
const work = stages.reduce((s, x) => s + x.work, 0);
const wait = stages.reduce((s, x) => s + x.wait, 0);
const lead = work + wait;
if (Math.abs(work - 3.5) > 1e-9 || Math.abs(wait - 164.5) > 1e-9 || Math.abs(lead - 168) > 1e-9) throw new Error(`totals ${work} ${wait} ${lead}`);
const efficiency = work / lead;
if ((100 * efficiency).toFixed(1) !== '2.1') throw new Error(`flow efficiency ${efficiency}`);
// Little's law with the arrival rate of the note: 10 changes a day, 7 days each, 70 in flight.
if (10 * (lead / 24) !== 70) throw new Error('Little: 70 changes in flight');

const hours = (h: number) => `${h} ${ru ? 'ч' : 'h'}`;
const t = ru
  ? { commit: 'коммит', prod: 'продакшен', waitWord: 'ожидание', workWord: 'работа',
      bar: 'тот же путь в масштабе времени', total: `время выполнения ${hours(lead)} = 7 дней`, eff: `работа ${hours(work)} = 2.1%`,
      seg: { 0: '18 ч', 2: '96 ч: еженедельный релиз', 3: '48 ч: совет по изменениям' } as Record<number, string>,
      segN: { 2: '96 ч', 3: '48 ч' } as Record<number, string>,
      steps: ['изменение 18 ч ждёт ревьюера; само ревью занимает 0.5 ч', 'CI ждёт свободного исполнителя 0.5 ч и работает 0.3 ч', 'еженедельный релизный поезд: 96 ч ожидания перед 2 ч проверки на стенде', 'еженедельный совет по изменениям: 48 ч ожидания и 0.2 ч на одобрение', 'следующее окно изменений: 2 ч ожидания и 0.5 ч на выкладку', 'всего 168 ч от коммита до продакшена, из них 3.5 ч работы: 2.1%'] }
  : { commit: 'commit', prod: 'production', waitWord: 'waiting', workWord: 'work',
      bar: 'the same path to scale in time', total: `lead time ${hours(lead)} = 7 days`, eff: `work ${hours(work)} = 2.1%`,
      seg: { 0: '18 h', 2: '96 h: weekly release train', 3: '48 h: change board' } as Record<number, string>,
      segN: { 2: '96 h', 3: '48 h' } as Record<number, string>,
      steps: ['the change waits 18 h for a reviewer; the review itself takes 0.5 h', 'CI waits 0.5 h for a free runner and runs for 0.3 h', 'the weekly release train: 96 h of waiting before 2 h of testing on staging', 'the weekly change board: 48 h of waiting and 0.2 h of approval', 'the next change window: 2 h of waiting and 0.5 h to deploy', 'in all, 168 h from commit to production, of which 3.5 h is work: 2.1%'] };

// Character widths for the label checks: f-small 6.5 px and f-label 7.5 px in the wide layout;
// 7.3 and 8.0 in the narrow one, whose class seq-narrow enlarges the text.
interface Layout { cls: string; W: number; H: number; wide: boolean; small: number; label: number }
const wideL: Layout = { cls: 'fig-wide fig-bp-640', W: 760, H: 262, wide: true, small: 6.5, label: 7.5 };
const narrowL: Layout = { cls: 'fig-narrow seq-narrow fig-bp-640', W: 360, H: 584, wide: false, small: 7.3, label: 8.0 };

// Wide: a row of gaps (queues) and boxes (stages).
const W0 = 22, GAP = 54, BOX = 86, ROW = 72, BH = 48;
const gapX = (i: number) => W0 + i * (GAP + BOX);
const boxX = (i: number) => gapX(i) + GAP;
const end = boxX(4) + BOX;
if (end + 22 > wideL.W - 8) throw new Error('row too wide');
for (const s of stages) {
  if ((ru ? s.ru : s.en).length * wideL.label > BOX - 10) throw new Error(`stage label ${s.en}`);
  if (hours(s.wait).length * wideL.small > GAP - 6) throw new Error(`wait label ${s.wait}`);
}
// The bar: 168 h over the full width.
const BX0 = 22, BX1 = 738, BY = 176, BHt = 24;
const bscale = (BX1 - BX0) / lead;
const segs: { x: number; w: number; kind: 'wait' | 'work'; stage: number }[] = [];
{
  let x = BX0;
  stages.forEach((s, i) => {
    segs.push({ x, w: s.wait * bscale, kind: 'wait', stage: i }); x += s.wait * bscale;
    segs.push({ x, w: s.work * bscale, kind: 'work', stage: i }); x += s.work * bscale;
  });
  if (Math.abs(x - BX1) > 1e-6) throw new Error('bar does not end at the right edge');
}
for (const [k, label] of Object.entries(t.seg)) {
  const s = segs.find((g) => g.kind === 'wait' && g.stage === Number(k))!;
  if (label.length * wideL.small > s.w - 10) throw new Error(`bar label ${label} does not fit`);
}
if ((t.total.length + t.eff.length) * wideL.small + 40 > BX1 - BX0) throw new Error('totals line');

// Narrow: a column; each stage is a queue (arrow with its wait) and a box.
const NX = 64, NW = 232, NTOP = 46, NQ = 38, NB = 40;
const nRowY = (i: number) => NTOP + i * (NQ + NB);
const nEnd = nRowY(5);
const NBX0 = 20, NBX1 = 340, NBY = nEnd + 52;
const nscale = (NBX1 - NBX0) / lead;
const nsegs = segs.map((g) => ({ ...g, x: NBX0 + (g.x - BX0) * (nscale / bscale), w: g.w * (nscale / bscale) }));
for (const s of stages) {
  const lab = `${ru ? s.ru : s.en} · ${hours(s.work)}`;
  if (lab.length * narrowL.label > NW - 20) throw new Error(`narrow stage ${lab}`);
  if (NX + 30 + `${hours(s.wait)} ${t.waitWord}`.length * narrowL.small > narrowL.W - 6) throw new Error('narrow wait label');
}
for (const [k, label] of Object.entries(t.segN)) {
  const s = nsegs.find((g) => g.kind === 'wait' && g.stage === Number(k))!;
  if (label.length * narrowL.small > s.w - 8) throw new Error(`narrow bar label ${label}`);
}
if (NBX0 + t.total.length * narrowL.small > narrowL.W - 6 || NBX0 + t.eff.length * narrowL.small > narrowL.W - 6) throw new Error('narrow totals');
if (NBY + BHt + 66 > narrowL.H) throw new Error('narrow height');

// Squares drawn in a queue: one for under 2 h, two for under a day, three for longer waits.
const queueSize = (h: number) => (h >= 24 ? 3 : h >= 2 ? 2 : 1);
const amber = toneVar.g, blue = toneVar.h;
const id = 'value-stream';
---

<Figure
  id={id}
  title={ru ? 'Поток создания ценности одного изменения: работа и очереди' : 'The value stream of one change: work and queues'}
  caption={ru
    ? 'Путь одного изменения от коммита до продакшена в примере из заметки. Перед каждым этапом — очередь (жёлтые прямоугольники), под этапом — время работы. Изменение ждёт ревьюера 18 ч (1), исполнителя CI 0.5 ч (2), еженедельный релизный поезд 96 ч (3), еженедельный совет по изменениям 48 ч (4) и окно изменений 2 ч (5). Полоса внизу рисует тот же путь в масштабе: работа (синие засечки) занимает 3.5 ч из 168, то есть эффективность потока 2.1% (6). Ускорять этапы почти бесполезно; сокращать нужно очереди.'
    : 'The path of one change from commit to production in the example of the note. Each stage is preceded by a queue (amber squares); the time under a stage is its work. The change waits 18 h for a reviewer (1), 0.5 h for a CI runner (2), 96 h for the weekly release train (3), 48 h for the weekly change board (4) and 2 h for a change window (5). The bar at the bottom draws the same path to scale: work (blue ticks) is 3.5 h of the 168, a flow efficiency of 2.1% (6). Making the stages faster barely helps; the queues are what to shorten.'}
>
  <svg class={wideL.cls} viewBox={`0 0 ${wideL.W} ${wideL.H}`} role="img" aria-labelledby={`${id}-760-t ${id}-760-d`}>
    <title id={`${id}-760-t`}>{ru ? 'Пять этапов с очередями и полоса времени в масштабе' : 'Five stages with queues, and a time bar to scale'}</title>
    <desc id={`${id}-760-d`}>{ru
      ? 'Слева направо: коммит, затем пять пар очередь и этап: ревью, CI, проверка, одобрение, выкладка, затем продакшен. Над каждой очередью написано время ожидания: 18, 0.5, 96, 48 и 2 часа; в каждом этапе — время работы: 0.5, 0.3, 2, 0.2 и 0.5 часа. Ниже горизонтальная полоса длиной 168 часов почти целиком из ожидания, с пятью тонкими синими отрезками работы общей длиной 3.5 часа.'
      : 'Left to right: the commit, then five pairs of queue and stage: review, CI, staging QA, approval, deploy, then production. Above each queue is its waiting time: 18, 0.5, 96, 48 and 2 hours; inside each stage its working time: 0.5, 0.3, 2, 0.2 and 0.5 hours. Below, a horizontal bar of 168 hours made almost entirely of waiting, with five thin blue slivers of work adding up to 3.5 hours.'}</desc>
    <circle cx={W0} cy={ROW + BH / 2} r="5" class="f-solid-muted" />
    <text class="f-small f-t-muted" x={W0 - 4} y={ROW + BH + 22}>{t.commit}</text>
    <path class="f-line f-muted" d={`M ${end} ${ROW + BH / 2} H ${end + 22}`} marker-end="url(#f-arrow-muted)" />
    <text class="f-small f-t-muted" x={end + 26} y={ROW + BH + 22} text-anchor="end">{t.prod}</text>
    {stages.map((s, i) => {
      const gx = gapX(i), bx = boxX(i), cy = ROW + BH / 2;
      const n = queueSize(s.wait);
      return (
        <g data-s={String(i + 1)}>
          <text class="f-small f-t-amber" x={gx + GAP / 2} y={ROW - 12} text-anchor="middle" style="font-weight: 650">{hours(s.wait)}</text>
          {Array.from({ length: n }, (_, k) => (
            <rect x={gx + GAP / 2 - (n * 15 - 3) / 2 + k * 15} y={cy - 14} width="12" height="8" rx="1.5" style={`fill: ${amber}; fill-opacity: 0.3; stroke: ${amber}; stroke-width: 1`} />
          ))}
          <path class="f-line f-muted" d={`M ${gx + (i === 0 ? 7 : 2)} ${cy} H ${bx - 2}`} marker-end="url(#f-arrow-muted)" />
          <rect x={bx} y={ROW} width={BOX} height={BH} rx="7" style={`fill: ${blue}; fill-opacity: 0.12; stroke: ${blue}; stroke-width: 1.3`} />
          <text class="f-label" x={bx + BOX / 2} y={ROW + 24} text-anchor="middle">{ru ? s.ru : s.en}</text>
          <text class="f-small f-t-blue" x={bx + BOX / 2} y={ROW + 41} text-anchor="middle">{hours(s.work)}</text>
          <Badge x={bx + 2} y={ROW + 2} n={i + 1} />
        </g>
      );
    })}
    <text class="f-small f-t-muted" x={BX0} y={BY - 16} style="font-weight: 650">{t.bar}</text>
    {segs.map((g) => (
      <g data-s={String(g.stage + 1)}>
        {g.kind === 'wait'
          ? <rect x={g.x} y={BY} width={g.w} height={BHt} style={`fill: ${amber}; fill-opacity: 0.22; stroke: var(--paper); stroke-width: 0.6`} />
          : <g>
              <rect x={g.x} y={BY} width={Math.max(g.w, 1.2)} height={BHt} style={`fill: ${blue}`} />
              <path d={`M ${g.x + g.w / 2} ${BY - 2} l -4 -6 h 8 z`} style={`fill: ${blue}`} />
            </g>}
        {g.kind === 'wait' && t.seg[g.stage] && <text class="f-small" x={g.x + 6} y={BY + 16.5}>{t.seg[g.stage]}</text>}
      </g>
    ))}
    <g data-s="6">
      <text class="f-small" x={BX0} y={BY + BHt + 22} style="font-weight: 650">{t.total}</text>
      <text class="f-small f-t-blue" x={BX1} y={BY + BHt + 22} text-anchor="end" style="font-weight: 650">{t.eff}</text>
      <rect x={BX0} y={BY + BHt + 36} width="14" height="10" style={`fill: ${amber}; fill-opacity: 0.22; stroke: ${amber}; stroke-width: 1`} />
      <text class="f-small f-t-muted" x={BX0 + 20} y={BY + BHt + 45}>{t.waitWord}</text>
      <rect x={BX0 + 110} y={BY + BHt + 36} width="14" height="10" style={`fill: ${blue}`} />
      <text class="f-small f-t-muted" x={BX0 + 130} y={BY + BHt + 45}>{t.workWord}</text>
    </g>
  </svg>

  <svg class={narrowL.cls} viewBox={`0 0 ${narrowL.W} ${narrowL.H}`} role="img" aria-labelledby={`${id}-360-t ${id}-360-d`}>
    <title id={`${id}-360-t`}>{ru ? 'Пять этапов с очередями и полоса времени в масштабе' : 'Five stages with queues, and a time bar to scale'}</title>
    <desc id={`${id}-360-d`}>{ru
      ? 'Сверху вниз: коммит, затем пять пар очередь и этап: ревью, CI, проверка, одобрение, выкладка, затем продакшен. У каждой очереди написано время ожидания: 18, 0.5, 96, 48 и 2 часа; в каждом этапе — время работы. Внизу полоса длиной 168 часов почти целиком из ожидания, с тонкими синими отрезками работы общей длиной 3.5 часа.'
      : 'Top to bottom: the commit, then five pairs of queue and stage: review, CI, staging QA, approval, deploy, then production. Beside each queue is its waiting time: 18, 0.5, 96, 48 and 2 hours; inside each stage its working time. At the bottom, a bar of 168 hours made almost entirely of waiting, with thin blue slivers of work adding up to 3.5 hours.'}</desc>
    <circle cx={NX + 16} cy={NTOP - 18} r="5" class="f-solid-muted" />
    <text class="f-small f-t-muted" x={NX + 30} y={NTOP - 13}>{t.commit}</text>
    {stages.map((s, i) => {
      const y = nRowY(i), ax = NX + 16;
      const n = queueSize(s.wait);
      return (
        <g data-s={String(i + 1)}>
          <path class="f-line f-muted" d={`M ${ax} ${y - (i === 0 ? 11 : 2)} V ${y + NQ - 2}`} marker-end="url(#f-arrow-muted)" />
          {Array.from({ length: n }, (_, k) => (
            <rect x={ax - 30 - k * 14} y={y + NQ / 2 - 6} width="10" height="12" rx="1.5" style={`fill: ${amber}; fill-opacity: 0.3; stroke: ${amber}; stroke-width: 1`} />
          ))}
          <text class="f-small f-t-amber" x={ax + 14} y={y + NQ / 2 + 5} style="font-weight: 650">{hours(s.wait)} <tspan class="f-t-muted" style="font-weight: 400">{t.waitWord}</tspan></text>
          <rect x={NX} y={y + NQ} width={NW} height={NB} rx="7" style={`fill: ${blue}; fill-opacity: 0.12; stroke: ${blue}; stroke-width: 1.3`} />
          <text class="f-label" x={NX + NW / 2} y={y + NQ + 26} text-anchor="middle">{ru ? s.ru : s.en} · <tspan class="f-t-blue">{hours(s.work)}</tspan></text>
          <Badge x={NX - 22} y={y + NQ + NB / 2} n={i + 1} />
        </g>
      );
    })}
    <path class="f-line f-muted" d={`M ${NX + 16} ${nEnd} V ${nEnd + 16}`} marker-end="url(#f-arrow-muted)" />
    <text class="f-small f-t-muted" x={NX + 30} y={nEnd + 16}>{t.prod}</text>
    {nsegs.map((g) => (
      <g data-s={String(g.stage + 1)}>
        {g.kind === 'wait'
          ? <rect x={g.x} y={NBY} width={g.w} height={BHt} style={`fill: ${amber}; fill-opacity: 0.22; stroke: var(--paper); stroke-width: 0.6`} />
          : <g>
              <rect x={g.x} y={NBY} width={Math.max(g.w, 1.2)} height={BHt} style={`fill: ${blue}`} />
              <path d={`M ${g.x + g.w / 2} ${NBY - 2} l -4 -6 h 8 z`} style={`fill: ${blue}`} />
            </g>}
        {g.kind === 'wait' && t.segN[g.stage] && <text class="f-small" x={g.x + 5} y={NBY + 17}>{t.segN[g.stage]}</text>}
      </g>
    ))}
    <text class="f-small f-t-muted" x={NBX0} y={NBY - 14} style="font-weight: 650">{ru ? 'в масштабе времени' : 'to scale in time'}</text>
    <g data-s="6">
      <text class="f-small" x={NBX0} y={NBY + BHt + 24} style="font-weight: 650">{t.total}</text>
      <text class="f-small f-t-blue" x={NBX0} y={NBY + BHt + 46} style="font-weight: 650">{t.eff}</text>
    </g>
  </svg>
  <Stepper steps={t.steps} />
</Figure>
