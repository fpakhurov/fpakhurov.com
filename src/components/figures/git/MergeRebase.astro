---
import Figure from '../Figure.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The branches of the note, with the hashes git printed. Before: discount forked at ff2de94,
// main moved on to 64e3131. Merge adds one commit with two parents; rebase copies the two
// discount commits onto 64e3131 as new commits with new hashes.
type Lane = 'main' | 'side';
interface C { id: string; lane: Lane; col: number; tone: 'base' | 'main' | 'side' | 'new' | 'old' }
interface Panel { key: string; head: string; cmd: string; commits: C[]; edges: [string, string][]; tags: [string, string][] }
const panels: Panel[] = [
  { key: 'before', head: ru ? 'до' : 'before', cmd: '',
    commits: [
      { id: 'ff2de94', lane: 'main', col: 0, tone: 'base' }, { id: '64e3131', lane: 'main', col: 1.4, tone: 'main' },
      { id: '5059e4d', lane: 'side', col: 1, tone: 'side' }, { id: '3e85af1', lane: 'side', col: 2, tone: 'side' }],
    edges: [['64e3131', 'ff2de94'], ['5059e4d', 'ff2de94'], ['3e85af1', '5059e4d']],
    tags: [['64e3131', 'main'], ['3e85af1', 'discount']] },
  { key: 'merge', head: ru ? 'слияние' : 'merge', cmd: 'git merge discount',
    commits: [
      { id: 'ff2de94', lane: 'main', col: 0, tone: 'base' }, { id: '64e3131', lane: 'main', col: 1.4, tone: 'main' },
      { id: '5059e4d', lane: 'side', col: 1, tone: 'side' }, { id: '3e85af1', lane: 'side', col: 2, tone: 'side' },
      { id: '7b46679', lane: 'main', col: 3, tone: 'new' }],
    edges: [['64e3131', 'ff2de94'], ['5059e4d', 'ff2de94'], ['3e85af1', '5059e4d'], ['7b46679', '64e3131'], ['7b46679', '3e85af1']],
    tags: [['7b46679', 'main'], ['3e85af1', 'discount']] },
  { key: 'rebase', head: ru ? 'перебазирование' : 'rebase', cmd: 'git rebase main',
    commits: [
      { id: 'ff2de94', lane: 'main', col: 0, tone: 'base' }, { id: '64e3131', lane: 'main', col: 1, tone: 'main' },
      { id: 'e51616d', lane: 'main', col: 2, tone: 'new' }, { id: '39e52f2', lane: 'main', col: 3, tone: 'new' },
      { id: '5059e4d', lane: 'side', col: 1, tone: 'old' }, { id: '3e85af1', lane: 'side', col: 2, tone: 'old' }],
    edges: [['64e3131', 'ff2de94'], ['e51616d', '64e3131'], ['39e52f2', 'e51616d'], ['5059e4d', 'ff2de94'], ['3e85af1', '5059e4d']],
    tags: [['64e3131', 'main'], ['39e52f2', 'discount-rebased']] },
];
// The merge commit has two parents; the rebased commits have one each and new names.
const parents = (p: Panel, id: string) => p.edges.filter((e) => e[0] === id).length;
if (parents(panels[1], '7b46679') !== 2) throw new Error('a merge commit has two parents');
if (panels[2].commits.filter((c) => c.tone === 'new').some((c) => panels[0].commits.some((d) => d.id === c.id))) throw new Error('rebased commits get new hashes');
const t = ru
  ? { old: 'старые коммиты держит reflog', parents: 'два родителя' }
  : { old: 'old commits, kept by the reflog', parents: 'two parents' };
// The rebase panel is wider than the other two, for its long branch name.
const panelW = (L: Layout, key: string) => (L.W === 760 && key === 'rebase' ? 262 : L.pw);

interface Layout { cls: string; W: number; H: number; origin: (i: number) => [number, number]; pw: number; dx: number; laneY: Record<Lane, number>; x0: number }
const wideL: Layout = { cls: 'fig-wide fig-bp-640', W: 760, H: 224, origin: (i) => [[4, 248, 498][i], 0], pw: 244, dx: 62, laneY: { main: 96, side: 160 }, x0: 24 };
const narrowL: Layout = { cls: 'fig-narrow fig-bp-640', W: 360, H: 648, origin: (i) => [0, i * 214], pw: 360, dx: 84, laneY: { main: 96, side: 160 }, x0: 40 };
const toneColor: Record<C['tone'], string> = { base: toneVar.n, main: toneVar.h, side: toneVar.x, new: toneVar.g, old: toneVar.x };
const MONO = 7.5, SMALL = 6.5;
const drawn = [wideL, narrowL].map((L) => {
  const ps = panels.map((p, i) => {
    const [ox, oy] = L.origin(i);
    const pos = Object.fromEntries(p.commits.map((c) => [c.id, [ox + L.x0 + c.col * L.dx, oy + L.laneY[c.lane]] as [number, number]]));
    const right = ox + panelW(L, p.key) - 6;
    for (const c of p.commits) {
      const [x] = pos[c.id];
      if (x + (c.id.length * MONO) / 2 > right) throw new Error(`hash ${c.id} leaves panel ${p.key} at ${L.W}`);
    }
    // Hash labels in one lane must not touch.
    for (const lane of ['main', 'side'] as Lane[]) {
      const xs = p.commits.filter((c) => c.lane === lane).map((c) => pos[c.id][0]).sort((a, b) => a - b);
      for (let k = 1; k < xs.length; k++) if (xs[k] - xs[k - 1] < 7 * MONO + 6) throw new Error(`hash labels touch in ${p.key} at ${L.W}`);
    }
    const tags = p.tags.map(([cid, name]) => {
      const [x, y] = pos[cid];
      const w = name.length * MONO;
      const anchorEnd = x + w / 2 > right;
      const tx = anchorEnd ? right : x;
      if ((anchorEnd ? tx - w : tx - w / 2) < ox + 2) throw new Error(`tag ${name} at ${L.W}`);
      // Tags sit above the main lane and below the hash labels of the side lane.
      const side = p.commits.find((c) => c.id === cid)!.lane === 'side';
      return { name, x: tx, y: side ? y + 46 : y - 22, anchor: anchorEnd ? 'end' : 'middle' };
    });
    const oldText = t.old;
    if (p.key === 'merge') {
      const [mx] = pos['7b46679'];
      if (mx + 30 > right + 2 || mx + 30 - t.parents.length * SMALL < ox + 2) throw new Error(`two-parents note at ${L.W}`);
    }
    if (p.key === 'rebase' && ox + L.x0 + oldText.length * SMALL > right) throw new Error(`old-commits note at ${L.W}`);
    const lines = p.edges.map(([a, b]) => {
      const [x1, y1] = pos[a], [x2, y2] = pos[b];
      const len = Math.hypot(x2 - x1, y2 - y1);
      const ux = (x2 - x1) / len, uy = (y2 - y1) / len;
      const old = p.commits.find((c) => c.id === a)!.tone === 'old';
      return { d: `M ${x1 + ux * 12} ${y1 + uy * 12} L ${x2 - ux * 15} ${y2 - uy * 15}`, old };
    });
    return { p, ox, oy, pos, tags, lines, oldText };
  });
  return { L, ps };
});
if (498 + 262 !== wideL.W) throw new Error('panels fill the width');
const id = 'merge-vs-rebase';
---

<Figure
  id={id}
  title={ru ? 'Слияние и перебазирование на графе коммитов' : 'Merge and rebase on the commit graph'}
  caption={ru
    ? 'Граф из заметки с настоящими сокращёнными хешами; стрелки указывают от коммита к его родителю, время идёт слева направо. До: ветка discount ответвилась от ff2de94, main ушла вперёд к 64e3131. Слияние добавляет один новый коммит 7b46679 с двумя родителями, а старые коммиты не меняются. Перебазирование переносит изменения двух коммитов discount на 64e3131 и создаёт новые коммиты e51616d и 39e52f2: те же изменения и сообщения, но другие родители, а значит и другие хеши. Старые коммиты остаются в хранилище, пока на них указывает ветка или reflog; в примере заметки на них по-прежнему указывает ветка discount.'
    : 'The graph of the note with the real abbreviated hashes; arrows point from a commit to its parent, and time runs left to right. Before: the branch discount forked at ff2de94, and main moved on to 64e3131. A merge adds one new commit, 7b46679, with two parents, and leaves every old commit as it was. A rebase replays the changes of the two discount commits on top of 64e3131 as new commits, e51616d and 39e52f2: the same changes and messages, but different parents, and so different hashes. The old commits stay in the object store while a branch or the reflog still points to them; in the example of the note, the branch discount still does.'}
>
  {drawn.map(({ L, ps }) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Граф до, после слияния и после перебазирования' : 'The graph before, after a merge and after a rebase'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'Три панели. До: ff2de94, от него вверху 64e3131 ветки main, внизу 5059e4d и 3e85af1 ветки discount. Слияние: то же плюс новый коммит 7b46679 со стрелками к 64e3131 и к 3e85af1; на него указывает main. Перебазирование: в одну линию ff2de94, 64e3131 и новые e51616d и 39e52f2, на последний указывает discount-rebased; внизу бледные старые 5059e4d и 3e85af1.'
        : 'Three panels. Before: ff2de94, with 64e3131 of main above it and 5059e4d and 3e85af1 of discount below. Merge: the same plus a new commit 7b46679 with arrows to 64e3131 and to 3e85af1; main points to it. Rebase: in one line ff2de94, 64e3131 and the new e51616d and 39e52f2, the last one pointed to by discount-rebased; below them the faded old 5059e4d and 3e85af1.'}</desc>
      {ps.map(({ p, ox, oy, pos, tags, lines, oldText }) => (
        <g>
          <text class="f-small" x={ox + 10} y={oy + 22} style="font-weight: 650">{p.head}</text>
          {p.cmd && <text class="f-small f-t-muted" x={ox + 10} y={oy + 42} style="font-family: var(--mono)">{p.cmd}</text>}
          {lines.map((e) => <path class={`f-line ${e.old ? 'f-muted f-dash' : 'f-muted'}`} d={e.d} marker-end="url(#f-arrow-muted)" />)}
          {p.commits.map((c) => (
            <g style={c.tone === 'old' ? 'opacity: 0.45' : ''}>
              <circle cx={pos[c.id][0]} cy={pos[c.id][1]} r={c.tone === 'new' ? 11 : 10} style={`fill: ${toneColor[c.tone]}; fill-opacity: ${c.tone === 'new' ? 0.3 : 0.2}; stroke: ${toneColor[c.tone]}; stroke-width: ${c.tone === 'new' ? 2.4 : 1.4}`} />
              <text class="f-small" x={pos[c.id][0]} y={pos[c.id][1] + 28} text-anchor="middle" style="font-family: var(--mono)">{c.id}</text>
            </g>
          ))}
          {tags.map((g) => <text class="f-small f-t-blue" x={g.x} y={g.y} text-anchor={g.anchor} style="font-family: var(--mono); font-weight: 650">{g.name}</text>)}
          {p.key === 'merge' && <text class="f-small f-t-amber" x={pos['7b46679'][0] + 30} y={pos['7b46679'][1] + 46} text-anchor="end">{t.parents}</text>}
          {p.key === 'rebase' && <text class="f-small f-t-muted" x={ox + L.x0} y={oy + L.laneY.side + 48}>{oldText}</text>}
        </g>
      ))}
    </svg>
  ))}
</Figure>
