---
import Figure from '../Figure.astro';
import Badge from '../seqflow/Badge.astro';
import Stepper from '../seqflow/Stepper.astro';
import { toneVar } from '../seqflow/tones';
import { pageLang } from '../../../utils/lang';

const ru = pageLang(Astro.url) === 'ru';

// The repository of the note after its second commit, with the real (abbreviated) object names
// printed by git cat-file and git ls-tree. Every edge is a hash stored inside the object it leaves.
type Kind = 'commit' | 'tree' | 'blob' | 'ref';
interface Node { id: string; kind: Kind; label: string; note?: string; step: number }
const nodes: Node[] = [
  { id: 'HEAD', kind: 'ref', label: 'HEAD', step: 4 },
  { id: 'main', kind: 'ref', label: 'main', step: 4 },
  { id: 'c2', kind: 'commit', label: '1702a7d', note: 'Round the total', step: 3 },
  { id: 'c1', kind: 'commit', label: 'aba6e65', note: 'Add README and total()', step: 3 },
  { id: 't2', kind: 'tree', label: '6aca1b5', step: 2 },
  { id: 't1', kind: 'tree', label: 'f31a99c', step: 2 },
  { id: 's2', kind: 'tree', label: '9f77762', step: 2 },
  { id: 's1', kind: 'tree', label: '54955cd', step: 2 },
  { id: 'readme', kind: 'blob', label: '9688330', note: 'Shop service', step: 1 },
  { id: 'app2', kind: 'blob', label: 'b733279', step: 1 },
  { id: 'app1', kind: 'blob', label: 'aa11c87', step: 1 },
];
const edges: [string, string, string, number][] = [
  ['HEAD', 'main', '', 4], ['main', 'c2', '', 4], ['c2', 'c1', 'parent', 3],
  ['c2', 't2', '', 3], ['c1', 't1', '', 3],
  ['t2', 's2', 'src', 2], ['t2', 'readme', 'README.md', 2], ['t1', 's1', 'src', 2], ['t1', 'readme', 'README.md', 2],
  ['s2', 'app2', 'app.py', 2], ['s1', 'app1', 'app.py', 2],
];
// Count: 2 commits, 4 trees, 3 blobs = the 9 objects that git count-objects reported.
const count = (k: Kind) => nodes.filter((n) => n.kind === k).length;
if (count('commit') + count('tree') + count('blob') !== 9) throw new Error('nine objects');
// The README blob is shared: two trees point at it.
if (edges.filter((e) => e[1] === 'readme').length !== 2) throw new Error('README is stored once and used twice');
const index = [['9688330', 'README.md'], ['b733279', 'src/app.py']];
if (index[1][0] !== nodes.find((n) => n.id === 'app2')!.label) throw new Error('the index matches HEAD');

const tone: Record<Kind, string> = { commit: toneVar.h, tree: toneVar.g, blob: toneVar.x, ref: toneVar.n };
const kindName: Record<Kind, string> = ru
  ? { commit: 'коммит', tree: 'дерево', blob: 'blob', ref: 'ссылка' }
  : { commit: 'commit', tree: 'tree', blob: 'blob', ref: 'ref' };
const t = ru
  ? { index: 'индекс (.git/index)', note: { c2: 'Round the total', c1: 'Add README and total()', readme: '«Shop service»' } as Record<string, string>,
      steps: ['blob: содержимое файла; имя — хеш содержимого, поэтому README хранится один раз', 'дерево: список имён, режимов и хешей; поддерево src — тоже дерево', 'коммит: корневое дерево, родитель, автор и сообщение', 'ветка main — файл с хешем коммита; HEAD указывает на ветку', 'индекс: следующее дерево; сейчас совпадает с деревом HEAD'] }
  : { index: 'the index (.git/index)', note: { c2: 'Round the total', c1: 'Add README and total()', readme: '"Shop service"' } as Record<string, string>,
      steps: ['blob: the content of a file, named by its hash, so README is stored once', 'tree: a list of names, modes and hashes; the subdirectory src is a tree too', 'commit: a root tree, a parent, an author and a message', 'the branch main is a file holding a commit hash; HEAD points to the branch', 'the index: the next tree to commit; now the same as the tree of HEAD'] };

interface Layout { cls: string; W: number; H: number; pos: Record<string, [number, number]>; nw: number; nh: number; rw: number; mono: number; notes: boolean; idx: [number, number, number]; legend: [number, number] }
const wide: Layout = {
  cls: 'fig-wide fig-bp-640', W: 760, H: 384, nw: 96, nh: 44, rw: 70, mono: 9, notes: true,
  pos: { HEAD: [52, 46], main: [52, 112], c2: [190, 112], c1: [190, 252], t2: [340, 112], t1: [340, 252], s2: [500, 52], s1: [500, 312], readme: [660, 182], app2: [660, 52], app1: [660, 312] },
  idx: [16, 306, 270], legend: [300, 20],
};
const narrow: Layout = {
  cls: 'fig-narrow seq-narrow fig-bp-640', W: 360, H: 576, nw: 96, nh: 46, rw: 70, mono: 10.2, notes: false,
  pos: { HEAD: [60, 32], main: [60, 92], c2: [60, 172], c1: [300, 172], t2: [60, 262], t1: [300, 262], s2: [60, 352], s1: [300, 352], readme: [180, 352], app2: [60, 446], app1: [300, 446] },
  idx: [16, 492, 328], legend: [150, 32],
};
// Blobs are narrower in the narrow layout, where three share a row.
const nodeW = (L: Layout, n: Node) => (n.kind === 'ref' ? L.rw : !L.notes && n.kind === 'blob' ? 84 : L.nw);
const legendKinds: Kind[] = ['commit', 'tree', 'blob'];
const drawn = [wide, narrow].map((L) => {
  const box = (n: Node) => {
    const [x, y] = L.pos[n.id];
    const w = nodeW(L, n);
    return { x: x - w / 2, y: y - L.nh / 2, w, h: L.nh, cx: x, cy: y };
  };
  const byId = Object.fromEntries(nodes.map((n) => [n.id, box(n)]));
  for (const n of nodes) {
    const b = byId[n.id];
    if (b.x < 2 || b.x + b.w > L.W - 2 || b.y < 2) throw new Error(`${n.id} outside at ${L.W}`);
    if (n.label.length * L.mono > b.w - 8) throw new Error(`${n.id} label at ${L.W}`);
  }
  for (const a of nodes) for (const c of nodes) {
    if (a.id >= c.id) continue;
    const A = byId[a.id], C = byId[c.id];
    if (Math.abs(A.cx - C.cx) < (A.w + C.w) / 2 + 4 && Math.abs(A.cy - C.cy) < L.nh + 4) throw new Error(`${a.id} overlaps ${c.id} at ${L.W}`);
  }
  // An edge leaves the side of a box that faces its target and enters the opposite side of the target.
  const paths = edges.map(([a, b, label, step]) => {
    const A = byId[a], B = byId[b];
    const dx = B.cx - A.cx, dy = B.cy - A.cy;
    const horizontal = Math.abs(dx) * L.nh > Math.abs(dy) * A.w;
    const sx = horizontal ? A.cx + Math.sign(dx) * A.w / 2 : A.cx + Math.sign(dx) * Math.min(A.w / 3, Math.abs(dx));
    const sy = horizontal ? A.cy : A.cy + Math.sign(dy) * A.h / 2;
    const ex = horizontal ? B.cx - Math.sign(dx) * (B.w / 2 + 3) : B.cx - Math.sign(dx) * Math.min(B.w / 3, Math.abs(dx));
    const ey = horizontal ? B.cy : B.cy - Math.sign(dy) * (B.h / 2 + 3);
    return { d: `M ${sx} ${sy} L ${ex} ${ey}`, mx: (sx + ex) / 2, my: (sy + ey) / 2, label, step };
  });
  const [ix, iy, iw] = L.idx;
  for (const [h, f] of index) if (ix + 12 + (h.length + 2 + f.length) * L.mono * 0.85 > ix + iw) throw new Error(`index line at ${L.W}`);
  if (iy + 76 > L.H) throw new Error(`index below the figure at ${L.W}`);
  const legendW = L.notes ? 80 : 0;
  const legend = legendKinds.map((k, i) => ({ k, x: L.legend[0] + i * legendW, y: L.legend[1] + (L.notes ? 0 : i * 20) }));
  return { L, byId, paths, legend, ix, iy, iw };
});
const id = 'git-object-graph';
---

<Figure
  id={id}
  title={ru ? 'Объекты Git после двух коммитов' : 'The Git objects after two commits'}
  caption={ru
    ? 'Репозиторий из заметки после второго коммита, с настоящими сокращёнными именами объектов. Каждая стрелка — хеш, записанный внутри объекта, из которого она выходит. Файлы — это blob-объекты (1), каталоги — деревья (2), снимки — коммиты, ссылающиеся на корневое дерево и на родителя (3). Ветка main — файл с хешем последнего коммита, HEAD указывает на ветку (4). Второй коммит изменил только app.py, поэтому новыми стали один blob, два дерева и коммит, а blob файла README (9688330) используется обоими деревьями: всего 9 объектов. Индекс (5) — следующее дерево; после коммита он совпадает с деревом HEAD.'
    : 'The repository of the note after its second commit, with the real abbreviated object names. Each arrow is a hash stored inside the object it leaves. Files are blobs (1), directories are trees (2), and snapshots are commits that name a root tree and a parent (3). The branch main is a file holding the hash of the latest commit, and HEAD points to the branch (4). The second commit changed only app.py, so it added one blob, two trees and a commit, while the README blob (9688330) is shared by both root trees: 9 objects in all. The index (5) is the next tree; after a commit it is the same as the tree of HEAD.'}
>
  {drawn.map(({ L, byId, paths, legend, ix, iy, iw }) => (
    <svg class={L.cls} viewBox={`0 0 ${L.W} ${L.H}`} role="img" aria-labelledby={`${id}-${L.W}-t ${id}-${L.W}-d`}>
      <title id={`${id}-${L.W}-t`}>{ru ? 'Граф объектов: ссылки, коммиты, деревья и blob-объекты' : 'The object graph: refs, commits, trees and blobs'}</title>
      <desc id={`${id}-${L.W}-d`}>{ru
        ? 'HEAD указывает на ветку main, main — на коммит 1702a7d, который ссылается на родителя aba6e65. Каждый коммит указывает на своё корневое дерево: 6aca1b5 и f31a99c. Оба дерева указывают на один и тот же blob 9688330 файла README.md и на свои поддеревья src, 9f77762 и 54955cd, которые указывают на две версии app.py: b733279 и aa11c87. Внизу индекс с двумя строками: 9688330 README.md и b733279 src/app.py.'
        : 'HEAD points to the branch main, main to the commit 1702a7d, which names its parent aba6e65. Each commit points to its root tree: 6aca1b5 and f31a99c. Both trees point to the same blob 9688330 of README.md and to their own src subtrees, 9f77762 and 54955cd, which point to the two versions of app.py: b733279 and aa11c87. At the bottom the index, with two lines: 9688330 README.md and b733279 src/app.py.'}</desc>
      {legend.map(({ k, x, y }) => (
        <g>
          <rect x={x} y={y - 10} width="14" height="12" style={`fill: ${tone[k]}; fill-opacity: 0.14; stroke: ${tone[k]}; stroke-width: 1.2`} />
          <text class="f-small f-t-muted" x={x + 20} y={y}>{kindName[k]}</text>
        </g>
      ))}
      {paths.map((e) => (
        <g data-s={String(e.step)}>
          <path class="f-line f-muted" d={e.d} marker-end="url(#f-arrow-muted)" />
          {e.label && <text class="f-small f-t-muted f-halo" x={e.mx} y={e.my - 5} text-anchor="middle" style="font-family: var(--mono)">{e.label}</text>}
        </g>
      ))}
      {nodes.map((n) => (
        <g data-s={String(n.step)}>
          <rect x={byId[n.id].x} y={byId[n.id].y} width={byId[n.id].w} height={byId[n.id].h} rx={n.kind === 'ref' ? 14 : 6} style={`fill: ${tone[n.kind]}; fill-opacity: ${n.kind === 'ref' ? 0.08 : 0.14}; stroke: ${tone[n.kind]}; stroke-width: 1.3`} />
          {n.kind === 'ref'
            ? <text class="f-label" x={byId[n.id].cx} y={byId[n.id].cy + 5} text-anchor="middle" style="font-family: var(--mono)">{n.label}</text>
            : <g>
                <text class="f-small f-t-muted" x={byId[n.id].cx} y={byId[n.id].y + 16} text-anchor="middle">{kindName[n.kind]}</text>
                <text class="f-label" x={byId[n.id].cx} y={byId[n.id].y + 36} text-anchor="middle" style="font-family: var(--mono)">{n.label}</text>
              </g>}
          {t.note[n.id] && (L.notes || n.kind === 'blob') && <text class="f-small f-t-muted f-halo" x={byId[n.id].cx} y={byId[n.id].y + byId[n.id].h + 16} text-anchor="middle">{t.note[n.id]}</text>}
        </g>
      ))}
      <g data-s="1"><Badge x={byId.app2.x + 2} y={byId.app2.y + 2} n={1} /></g>
      <g data-s="2"><Badge x={byId.t2.x + 2} y={byId.t2.y + 2} n={2} /></g>
      <g data-s="3"><Badge x={byId.c2.x + 2} y={byId.c2.y + 2} n={3} /></g>
      <g data-s="4"><Badge x={byId.HEAD.x + 2} y={byId.HEAD.y + 2} n={4} /></g>
      <g data-s="5">
        <rect x={ix} y={iy} width={iw} height={70} rx="6" style="fill: var(--paper-strong); stroke: var(--line); stroke-width: 1.2" />
        <text class="f-small f-t-muted" x={ix + 12} y={iy + 20} style="font-weight: 650">{t.index}</text>
        {index.map(([h, f], i) => (
          <text class="f-small" x={ix + 12} y={iy + 42 + i * 19} style="font-family: var(--mono)"><tspan class="f-t-green">{h}</tspan>{`  ${f}`}</text>
        ))}
        <Badge x={ix + 2} y={iy + 2} n={5} />
      </g>
    </svg>
  ))}
  <Stepper steps={t.steps} />
</Figure>
