---
import { channelLabel, contactChannels, externalLink, type Lang } from '../config/profile';

interface Props { lang?: Lang }
const { lang = 'en' } = Astro.props;
const reveal = lang === 'ru' ? 'Показать адрес' : 'Show address';
const number = (index: number) => `${String(index + 1).padStart(2, '0')} /`;
---

<ul class="contact-links shell" aria-label={lang === 'ru' ? 'Контакты' : 'Contact channels'}>
  {contactChannels.map((item, index) => (
    <li>
      {item.kind === 'email' ? (
        /* The address is assembled on click, so it never appears whole in the HTML. */
        <button type="button" class="contact-row" data-email-user={item.user} data-email-domain={item.domain} aria-label={`${item.name}: ${reveal.toLowerCase()}`}>
          <span class="contact-index">{number(index)}</span>
          <strong>{item.name}</strong>
          <span class="contact-value">{reveal}</span>
          <span class="contact-arrow" aria-hidden="true">→</span>
        </button>
      ) : (
        <a class="contact-row" href={item.href} aria-label={channelLabel(item, lang)} {...externalLink}>
          <span class="contact-index">{number(index)}</span>
          <strong>{item.name}</strong>
          <span class="contact-value">{item.value}</span>
          <span class="contact-arrow" aria-hidden="true">↗</span>
        </a>
      )}
    </li>
  ))}
</ul>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-email-user]')) {
    button.addEventListener('click', () => {
      const address = `${button.dataset.emailUser}@${button.dataset.emailDomain}`;
      const link = document.createElement('a');
      link.className = button.className;
      link.href = `mailto:${address}`;
      link.innerHTML = button.innerHTML;
      link.querySelector('.contact-value')!.textContent = address;
      link.setAttribute('aria-label', `${button.querySelector('strong')!.textContent}: ${address}`);
      button.replaceWith(link);
      link.focus();
    }, { once: true });
  }
</script>
