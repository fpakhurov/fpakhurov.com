---
import NoteFigure from './NoteFigure.astro';

// Schematic points share a deterministic pattern. The contours and
// transforms illustrate two independent contributions, not an empirical FID.
const points = [
  [-.95, -.2], [-.7, .5], [-.65, -.65], [-.35, .1], [-.25, .85],
  [0, -.35], [.15, .4], [.3, -.8], [.55, .65], [.7, -.15], [.9, .15],
];
const panels = [
  { id: 'fid-mean', title: 'Shift the center', subtitle: 'Keep the same covariance', mode: 'mean' },
  { id: 'fid-covariance', title: 'Change the geometry', subtitle: 'Keep the same mean', mode: 'covariance' },
];
---

<NoteFigure
  label="Feature-space sketch"
  title="FID compares both the center and the spread"
  caption="Schematic two-dimensional features after the same fixed extractor. Solid dark contours summarize real features; dashed blue contours summarize generated features. The first panel isolates mean mismatch, the second covariance mismatch. The illustration expands the formula on pages 17–18; it is not measured data."
>
  <div class="fid-legend" aria-hidden="true">
    <span><i class="real-key"></i>Real features</span>
    <span><i class="generated-key"></i>Generated features</span>
  </div>
  <div class="fid-panels">
    {panels.map((panel) => (
      <svg viewBox="0 0 320 355" role="img" aria-labelledby={`${panel.id}-title ${panel.id}-desc`}>
        <title id={`${panel.id}-title`}>{panel.title}</title>
        <desc id={`${panel.id}-desc`}>
          {panel.mode === 'mean'
            ? 'Real and generated feature clouds have identical elliptical contours, but different centers. An arrow between the centers shows the mean displacement, which contributes the squared Euclidean mean difference to FID.'
            : 'Real and generated feature clouds share a center, but the generated ellipse has a different width and orientation. Arrows to the contours show covariance mismatch, which contributes the Gaussian covariance distance to FID.'}
        </desc>
        <defs>
          <marker id={`${panel.id}-arrow`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
            <path d="M 1 1 L 8 5 L 1 9" class="annotation-head" />
          </marker>
        </defs>
        <text x="160" y="20" text-anchor="middle" class="panel-title">{panel.title}</text>
        <text x="160" y="43" text-anchor="middle" class="muted">{panel.subtitle}</text>
        <path d="M 32 264 H 286 M 40 272 V 66" class="axis" />
        <text x="281" y="285" text-anchor="end" class="axis-label">feature 1</text>
        <text x="45" y="73" class="axis-label">feature 2</text>

        {panel.mode === 'mean' ? (
          <g>
            <ellipse cx="112" cy="175" rx="63" ry="42" class="real-contour" />
            <ellipse cx="210" cy="145" rx="63" ry="42" class="generated-contour" />
            {points.map(([x, y]) => (
              <g>
                <circle cx={112 + x * 48} cy={175 - y * 31} r="2.4" class="real-point" />
                <circle cx={210 + x * 48} cy={145 - y * 31} r="2.4" class="generated-point" />
              </g>
            ))}
            <circle cx="112" cy="175" r="4" class="real-center" />
            <circle cx="210" cy="145" r="4" class="generated-center" />
            <path d="M 121 172 L 201 148" class="annotation" marker-end={`url(#${panel.id}-arrow)`} />
            <text x="96" y="204" class="mean-label">μᵣ</text>
            <text x="214" y="133" class="mean-label accent">μɡ</text>
            <path d="M 156 302 C 140 281, 142 223, 160 160" class="annotation" marker-end={`url(#${panel.id}-arrow)`} />
            <text x="160" y="326" text-anchor="middle" class="annotation-label">Mean displacement</text>
            <text x="160" y="348" text-anchor="middle" class="muted">Contribution: ‖μᵣ − μɡ‖²</text>
          </g>
        ) : (
          <g>
            <ellipse cx="160" cy="172" rx="82" ry="34" class="real-contour" />
            <ellipse cx="160" cy="172" rx="67" ry="49" transform="rotate(-48 160 172)" class="generated-contour" />
            {points.map(([x, y]) => (
              <g>
                <circle cx={160 + x * 60} cy={172 - y * 25} r="2.4" class="real-point" />
                <circle cx={160 + x * 49} cy={172 - y * 35} r="2.4" transform="rotate(-48 160 172)" class="generated-point" />
              </g>
            ))}
            <circle cx="160" cy="172" r="4" class="generated-center" />
            <text x="168" y="194" class="mean-label">μᵣ = μɡ</text>
            <path d="M 251 91 C 238 96, 224 109, 201 122" class="annotation" marker-end={`url(#${panel.id}-arrow)`} />
            <text x="266" y="88" text-anchor="end" class="annotation-label">Orientation</text>
            <path d="M 120 302 C 91 267, 91 226, 103 196" class="annotation" marker-end={`url(#${panel.id}-arrow)`} />
            <text x="160" y="326" text-anchor="middle" class="annotation-label">Spread and correlation</text>
            <text x="160" y="348" text-anchor="middle" class="muted">Contribution: covariance term</text>
          </g>
        )}
      </svg>
    ))}
  </div>
</NoteFigure>

<style>
  .fid-legend { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-bottom: 1.25rem; color: var(--muted); font-size: .8rem; }
  .fid-legend span { display: inline-flex; align-items: center; gap: .5rem; }
  .fid-legend i { display: inline-block; width: 1.3rem; height: 0; border-top: 1.5px solid var(--ink); }
  .fid-legend .generated-key { border-top-color: var(--accent); border-top-style: dashed; }
  .fid-panels { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  svg { display: block; width: 100%; max-width: 360px; height: auto; margin-inline: auto; }
  text { fill: var(--ink); font-family: var(--sans); font-size: 14px; }
  .panel-title { font-size: 15px; font-weight: 600; }
  .muted, .axis-label { fill: var(--muted); font-size: 13px; }
  .axis { fill: none; stroke: var(--line); stroke-width: 1; }
  .real-contour { fill: none; stroke: var(--ink); stroke-width: 1.5; }
  .generated-contour { fill: none; stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 5 4; }
  .real-point { fill: var(--ink); opacity: .4; }
  .generated-point { fill: var(--accent); opacity: .6; }
  .real-center { fill: var(--ink); }
  .generated-center { fill: var(--accent); }
  .mean-label { font-size: 17px; }
  .annotation, .annotation-head { fill: none; stroke: var(--accent); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .annotation-label, .accent { fill: var(--accent); }
  @container (max-width: 580px) { .fid-panels { grid-template-columns: 1fr; gap: 2rem; } }
</style>
