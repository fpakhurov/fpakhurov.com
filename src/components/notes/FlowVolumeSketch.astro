---
import NoteFigure from './NoteFigure.astro';
const panels = [
  { key: 'unit', title: 'Start with a unit square', map: 'z ∈ [0, 1]²', top: 160, size: 60, density: 'pZ = 1', footer: 'Area: 1', detail: 'Uniform probability mass: 1', reflected: false, expanded: false },
  { key: 'expand', title: 'Stretch both coordinates', map: 'f(z) = (2z₁, 2z₂)', top: 100, size: 120, density: 'pX = ¼', footer: 'det Jf = 4; area = 4', detail: 'Density is divided by 4', reflected: false, expanded: true },
  { key: 'reflect', title: 'Stretch and reflect', map: 'f(z) = (2z₁, −2z₂)', top: 220, size: 120, density: 'pX = ¼', footer: 'det Jf = −4; area = 4', detail: 'Use |det Jf| = 4', reflected: true, expanded: true },
];
---

<NoteFigure
  label="Change of variables"
  title="Larger volume means smaller density"
  caption="Exact redraw of the square-stretch and reflection examples on pages 32 and 35. The starting distribution is uniform on [0,1]². Multiplying both coordinates by 2 gives area 4 and density 1/4 on the image square. Reflecting the second coordinate changes the signed determinant from 4 to −4, but the absolute determinant, area, and density remain the same. Grid lines mark unit distances; density is zero outside each square."
>
  <div class="volume-panels">
    {panels.map((panel) => (
      <svg viewBox="0 0 280 430" role="img" aria-labelledby={`flow-volume-${panel.key}-title flow-volume-${panel.key}-desc`}>
        <title id={`flow-volume-${panel.key}-title`}>{panel.title}</title>
        <desc id={`flow-volume-${panel.key}-desc`}>{panel.key === 'unit'
          ? 'The original unit square has area one and uniform density one. Its total probability mass is one.'
          : panel.reflected
            ? 'The reflected square spans x1 from zero to two and x2 from minus two to zero. The determinant of the forward map is minus four, the area is four, and the density is one quarter.'
            : 'The stretched square spans x1 and x2 from zero to two. The forward determinant is four, area is four, and uniform density is one quarter.'}</desc>
        <defs><marker id={`flow-volume-${panel.key}-head`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M 1 1 L 8 5 L 1 9" class="arrow-head" /></marker></defs>
        <text x="140" y="26" text-anchor="middle" class="panel-title">{panel.title}</text>
        <text x="140" y="51" text-anchor="middle" class="muted">{panel.map}</text>
        <rect x="80" y={panel.top} width={panel.size} height={panel.size} class:list={['square', { 'base-square': !panel.expanded }]} />
        {panel.expanded && <path d={`M 140 ${panel.top} v 120 M 80 ${panel.top + 60} h 120`} class="grid" />}
        <path d="M 43 220 H 233 M 80 351 V 81" class="axis" marker-end={`url(#flow-volume-${panel.key}-head)`} />
        <text x="242" y="224" class="muted">{panel.expanded ? 'x₁' : 'z₁'}</text>
        <text x="64" y="82" text-anchor="end" class="muted">{panel.expanded ? 'x₂' : 'z₂'}</text>
        <text x="66" y="239" text-anchor="end" class="tick">0</text>
        <path d="M 140 216 v 8 M 200 216 v 8" class="axis" />
        <text x="140" y="243" text-anchor="middle" class="tick">1</text><text x="200" y="243" text-anchor="middle" class="tick">2</text>
        {panel.reflected ? (
          <g><path d="M 76 280 h 8 M 76 340 h 8" class="axis" /><text x="66" y="285" text-anchor="end" class="tick">−1</text><text x="66" y="345" text-anchor="end" class="tick">−2</text></g>
        ) : (
          <g><path d="M 76 160 h 8 M 76 100 h 8" class="axis" /><text x="66" y="165" text-anchor="end" class="tick">1</text><text x="66" y="105" text-anchor="end" class="tick">2</text></g>
        )}
        <rect x={panel.expanded ? 105 : 88} y={panel.reflected ? 267 : panel.expanded ? 145 : 176} width={panel.expanded ? 70 : 45} height="27" rx="2" class="density-label" />
        <text x={panel.expanded ? 140 : 110} y={panel.reflected ? 286 : panel.expanded ? 164 : 195} text-anchor="middle" class="density">{panel.density}</text>
        {panel.expanded && <path d={panel.reflected ? 'M 236 125 C 255 182, 254 266, 211 289' : 'M 232 291 C 250 240, 246 174, 211 152'} class="annotation" marker-end={`url(#flow-volume-${panel.key}-head)`} />}
        {panel.expanded && <text x="232" y={panel.reflected ? 109 : 315} text-anchor="middle" class="accent">×4 area</text>}
        <text x="140" y="386" text-anchor="middle">{panel.footer}</text>
        <text x="140" y="413" text-anchor="middle" class="muted">{panel.detail}</text>
      </svg>
    ))}
  </div>
  <p class="volume-rule">Preserve mass: <span>pZ(z) dz = pX(x) dx</span></p>
</NoteFigure>

<style>
  .volume-panels { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; }
  svg { display: block; width: 100%; height: auto; }
  text { fill: var(--ink); font-family: var(--sans); font-size: 16px; }
  .panel-title { font-weight: 600; font-size: 16px; }
  .muted { fill: var(--muted); font-size: 14px; }
  .accent { fill: var(--accent); font-size: 14px; }
  .tick { fill: var(--muted); font-size: 13px; }
  .square { fill: none; stroke: var(--accent); stroke-width: 2; }
  .base-square { stroke: var(--ink); }
  .grid { fill: none; stroke: var(--accent); stroke-width: 1; stroke-dasharray: 3 3; opacity: .5; }
  .axis { fill: none; stroke: var(--muted); stroke-width: 1; }
  .annotation, .arrow-head { fill: none; stroke: var(--accent); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .density-label { fill: var(--paper); }
  .density { font-size: 14px; }
  .volume-rule { margin: .8rem 0 0; padding-top: .8rem; border-top: 1px solid var(--line); color: var(--muted); text-align: center; font-size: .95rem; }
  .volume-rule span { color: var(--ink); white-space: nowrap; }
  @container (max-width: 580px) {
    .volume-panels { grid-template-columns: 1fr; gap: 1.25rem; }
    svg { max-width: 320px; margin-inline: auto; }
    .volume-rule span { display: block; margin-top: .25rem; }
  }
</style>
