---
import NoteFigure from './NoteFigure.astro';
const states = [
  { y: 61, symbol: 'x₀', detail: 'data' },
  { y: 149, symbol: 'x₁', detail: 'first noisy state' },
  { y: 237, symbol: '…', detail: 'intermediate states' },
  { y: 325, symbol: 'xT', detail: 'terminal state' },
];
---

<NoteFigure
  label="Forward noising"
  title="Add noise step by step, or jump to one chosen timestep"
  caption="The Markov-chain arrows reconstruct pages 38–40. Each sequential transition contracts the current state and adds fresh independent Gaussian noise. The right panel expands the direct noisy-sample formula: choosing t lets us draw its marginal from x₀ without traversing earlier states. These are distribution diagrams, not trained image samples; a finite terminal state is near the Gaussian prior only when the schedule removes enough signal."
>
  <div class="forward-panels">
    <svg viewBox="0 0 360 430" role="img" aria-labelledby="ddpm-forward-chain-title ddpm-forward-chain-desc">
      <title id="ddpm-forward-chain-title">A fixed chain gradually adds noise to data</title>
      <desc id="ddpm-forward-chain-desc">Data x zero passes through known forward transitions to x one and later states, ending at x T. Every transition multiplies the old state by the square root of alpha and adds the square root of beta times independent standard Gaussian noise. No neural network is needed to sample these forward transitions.</desc>
      <defs><marker id="ddpm-forward-chain-head" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M 1 1 L 8 5 L 1 9" class="arrow" /></marker></defs>
      <text x="180" y="24" text-anchor="middle" class="heading">Sequential noising</text>
      {states.map((state) => (
        <g>
          <rect x="33" y={state.y} width="116" height="49" rx="4" class="box" />
          <text x="91" y={state.y + 32} text-anchor="middle" class="symbol">{state.symbol}</text>
          <text x="168" y={state.y + 31} class="muted">{state.detail}</text>
        </g>
      ))}
      {[110,198,286].map((y) => <path d={'M 91 ' + (y + 6) + ' V ' + (y + 33)} class="arrow" marker-end="url(#ddpm-forward-chain-head)" />)}
      <text x="119" y="134" class="accent">q(x₁ | x₀)</text>
      <text x="119" y="222" class="accent">q: known steps</text>
      <text x="119" y="310" class="accent">continue to T</text>
      <text x="180" y="404" text-anchor="middle">Contract signal + add fresh noise</text>
    </svg>
    <svg viewBox="0 0 360 430" role="img" aria-labelledby="ddpm-forward-direct-title ddpm-forward-direct-desc">
      <title id="ddpm-forward-direct-title">Sample a chosen noisy timestep from the original datum</title>
      <desc id="ddpm-forward-direct-desc">Choose data x zero, a timestep t and an independent standard normal epsilon. The timestep selects the accumulated alpha product. Combine square root alpha bar times x zero with square root one minus alpha bar times epsilon to obtain x t. This samples the correct marginal at t, not a full correlated Markov trajectory.</desc>
      <defs><marker id="ddpm-forward-direct-head" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M 1 1 L 8 5 L 1 9" class="arrow" /></marker></defs>
      <text x="180" y="24" text-anchor="middle" class="heading">One direct noisy draw</text>
      <rect x="23" y="61" width="74" height="49" rx="4" class="box" />
      <rect x="143" y="61" width="74" height="49" rx="4" class="box" />
      <rect x="263" y="61" width="74" height="49" rx="4" class="box" />
      <text x="60" y="93" text-anchor="middle" class="symbol">x₀</text>
      <text x="180" y="93" text-anchor="middle" class="symbol">t</text>
      <text x="300" y="93" text-anchor="middle" class="symbol">ε</text>
      <text x="60" y="134" text-anchor="middle" class="muted">data</text>
      <text x="180" y="134" text-anchor="middle" class="muted">schedule</text>
      <text x="300" y="134" text-anchor="middle" class="muted">N(0, I)</text>
      {[60,180,300].map((x) => <path d={'M ' + x + ' 146 V 177'} class="arrow" marker-end="url(#ddpm-forward-direct-head)" />)}
      <rect x="23" y="183" width="314" height="82" rx="4" class="combine" />
      <text x="180" y="211" text-anchor="middle">Combine signal and noise</text>
      <text x="180" y="243" text-anchor="middle" class="formula">√α̅t x₀ + √(1 − α̅t) ε</text>
      <path d="M 180 271 V 304" class="arrow" marker-end="url(#ddpm-forward-direct-head)" />
      <rect x="122" y="310" width="116" height="49" rx="4" class="box" />
      <text x="180" y="341" text-anchor="middle" class="symbol">xt</text>
      <text x="180" y="387" text-anchor="middle" class="muted">No earlier states needed</text>
      <text x="180" y="411" text-anchor="middle" class="muted">Correct marginal at the selected t</text>
    </svg>
  </div>
</NoteFigure>

<style>
  .forward-panels { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  svg { display: block; width: 100%; max-width: 390px; margin-inline: auto; height: auto; }
  text { fill: var(--ink); font-size: 15px; font-family: var(--sans); }
  .heading { font-size: 17px; font-weight: 600; }
  .symbol { font-size: 23px; }
  .muted { fill: var(--muted); font-size: 13px; }
  .accent { fill: var(--accent); font-size: 14px; }
  .formula { fill: var(--accent); font-size: 18px; }
  .box { fill: var(--paper); stroke: var(--line); stroke-width: 1.3; }
  .combine { fill: var(--paper); stroke: var(--accent); stroke-width: 1.3; }
  .arrow { fill: none; stroke: var(--accent); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  @container (max-width: 580px) { .forward-panels { grid-template-columns: 1fr; gap: 2rem; } }
</style>
