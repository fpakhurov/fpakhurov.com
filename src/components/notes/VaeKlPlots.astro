---
import NoteFigure from './NoteFigure.astro';
const panels = [
  { key: 'mean', heading: 'Shift the mean · variance = 1', lo: -2, hi: 2, ticks: [-2, -1, 0, 1, 2], xLabel: 'Mean μ', formula: 'KL = μ² / 2', fn: (v: number) => v * v / 2 },
  { key: 'variance', heading: 'Change the variance · mean = 0', lo: -4, hi: 2, ticks: [-4, -2, 0, 2], xLabel: 'Log variance ℓ = log σ²', formula: 'KL = (exp(ℓ) − 1 − ℓ) / 2', fn: (v: number) => (Math.exp(v) - 1 - v) / 2 }
];
const x = (v: number, lo: number, hi: number) => 48 + (v - lo) / (hi - lo) * 248;
const y = (kl: number) => 236 - kl * 64;
const curve = (p: typeof panels[number]) => Array.from({ length: 181 }, (_, i) => {
  const v = p.lo + (p.hi - p.lo) * i / 180;
  return `${i ? 'L' : 'M'} ${x(v, p.lo, p.hi).toFixed(3)} ${y(p.fn(v)).toFixed(3)}`;
}).join(' ');
---

<NoteFigure
  label="Exact KL plots"
  title="Both a shifted mean and a changed variance incur a soft cost"
  caption="Exact one-coordinate slices of KL(N(μ, σ²) || N(0, 1)), expanding pages 29–30. Left fixes variance at 1; right fixes mean at 0 and uses log variance on the horizontal axis. Both costs vanish at the prior parameters. KL over a diagonal latent vector is the sum of these coordinate contributions; these plots are functions, not training measurements."
>
  <div class="kl-panels">
    {panels.map((panel) => (
      <svg viewBox="0 0 340 330" role="img" aria-labelledby={`vae-kl-${panel.key}-title vae-kl-${panel.key}-desc`}>
        <title id={`vae-kl-${panel.key}-title`}>{panel.heading}</title>
        <desc id={`vae-kl-${panel.key}-desc`}>{panel.formula}. The cost is nonnegative and has its minimum at zero on the horizontal axis.</desc>
        <text x="170" y="23" text-anchor="middle" class="heading">{panel.heading}</text>
        <text x="48" y="54" class="muted">KL, nats</text>
        {[1, 2].map((tick) => <g><line x1="48" x2="296" y1={y(tick)} y2={y(tick)} class="grid" /><text x="35" y={y(tick) + 5} text-anchor="end" class="muted">{tick}</text></g>)}
        <path d="M 48 70 V 236 H 306" class="axis" />
        <text x="35" y="241" text-anchor="end" class="muted">0</text>
        <path d={curve(panel)} class="curve" />
        {panel.ticks.map((tick) => <g><line x1={x(tick, panel.lo, panel.hi)} x2={x(tick, panel.lo, panel.hi)} y1="236" y2="242" class="axis" /><text x={x(tick, panel.lo, panel.hi)} y="262" text-anchor="middle" class="muted">{tick}</text></g>)}
        <circle cx={x(0, panel.lo, panel.hi)} cy="236" r="4" class="point" />
        <text x="170" y="289" text-anchor="middle" class="muted">{panel.xLabel}</text>
        <text x="170" y="321" text-anchor="middle" class="accent">{panel.formula}</text>
      </svg>
    ))}
  </div>
</NoteFigure>

<style>
  .kl-panels { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  svg { display: block; width: 100%; max-width: 370px; height: auto; margin-inline: auto; }
  text { fill: var(--ink); font-family: var(--sans); font-size: 14px; }
  .heading { font-size: 14px; font-weight: 600; }
  .muted { fill: var(--muted); font-size: 13px; }
  .accent { fill: var(--accent); font-size: 13px; }
  .axis { fill: none; stroke: var(--muted); stroke-width: 1; }
  .grid { stroke: var(--line); stroke-width: 1; }
  .curve { fill: none; stroke: var(--accent); stroke-width: 2.1; }
  .point { fill: var(--accent); }
  @container (max-width: 580px) { .kl-panels { grid-template-columns: 1fr; gap: 1.5rem; } }
</style>
