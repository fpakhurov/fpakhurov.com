---
import NoteFigure from './NoteFigure.astro';

// Plot the actual functions rather than tracing the imprecise hand sketches.
const reluX = (a: number) => 153 + a * 68.5;
const reluY = (value: number) => 266 - value * 80;
const reluPath = `M ${reluX(-1.5)} ${reluY(0)} L ${reluX(0)} ${reluY(0)} L ${reluX(2)} ${reluY(2)}`;
const sigmoidX = (a: number) => 173 + a * 20;
const sigmoidY = (value: number) => 266 - value * 166;
const sigmoidPath = Array.from({ length: 241 }, (_, index) => {
  const a = -6 + index / 20;
  return `${index === 0 ? 'M' : 'L'} ${sigmoidX(a).toFixed(3)} ${sigmoidY(1 / (1 + Math.exp(-a))).toFixed(3)}`;
}).join(' ');
---

<NoteFigure
  label="Figure 03"
  title="Two activation shapes"
  caption="Redrawn from the activation sketches on page 1, using the exact ReLU and sigmoid formulas. The arrows explain the shapes; the handwritten sketch does not assign these activations to particular layers."
>
  <div class="activation-panels">
    <svg viewBox="0 0 330 350" role="img" aria-labelledby="activation-relu-title activation-relu-desc">
      <title id="activation-relu-title">Rectified linear unit, ReLU</title>
      <desc id="activation-relu-desc">The graph of max zero a is zero for negative a and rises linearly with slope one for positive a. The output axis marks one half, one and two.</desc>
      <defs><marker id="activation-relu-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M 1 1 L 8 5 L 1 9" fill="none" stroke="var(--muted)" stroke-width="1.5" /></marker></defs>
      <text x="19" y="28" font-size="17">ReLU</text><text x="19" y="53" font-size="14" fill="var(--muted)">max(0, a)</text>
      <g stroke="var(--line)" stroke-width="1" stroke-dasharray="3 5"><path d="M 50 226 H 297" /><path d="M 50 186 H 297" /><path d="M 50 106 H 297" /></g>
      <g fill="none" stroke="var(--muted)" stroke-width="1.3"><path d="M 42 266 H 305 M 153 282 V 91" /><path d="M 149 226 H 157 M 149 186 H 157 M 149 106 H 157 M 84.5 262 V 270 M 221.5 262 V 270" /></g>
      <g font-size="12.5" fill="var(--muted)"><text x="153" y="82" text-anchor="end">output</text><text x="140" y="230" text-anchor="end">0.5</text><text x="140" y="190" text-anchor="end">1</text><text x="140" y="110" text-anchor="end">2</text><text x="84.5" y="287" text-anchor="middle">−1</text><text x="153" y="287" text-anchor="middle">0</text><text x="221.5" y="287" text-anchor="middle">1</text><text x="308" y="270" font-style="italic">a</text></g>
      <path d={reluPath} fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
      <text x="180" y="78" font-size="13">linear for a &gt; 0</text>
      <path d="M 234 86 Q 252 119 248 151" fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#activation-relu-arrow)" />
      <text x="26" y="326" font-size="13">zero for a &lt; 0</text>
      <path d="M 99 313 Q 128 294 116 272" fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#activation-relu-arrow)" />
    </svg>
    <svg viewBox="0 0 330 350" role="img" aria-labelledby="activation-sigmoid-title activation-sigmoid-desc">
      <title id="activation-sigmoid-title">Sigmoid activation</title>
      <desc id="activation-sigmoid-desc">The sigmoid S curve tends to zero for large negative a and one for large positive a. At a equals zero, its output is one half. Dashed horizontal lines mark one half and one; the solid horizontal axis marks zero.</desc>
      <defs><marker id="activation-sigmoid-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M 1 1 L 8 5 L 1 9" fill="none" stroke="var(--muted)" stroke-width="1.5" /></marker></defs>
      <text x="19" y="28" font-size="17">Sigmoid</text><text x="19" y="53" font-size="14" fill="var(--muted)">1 / (1 + exp(−a))</text>
      <g stroke="var(--line)" stroke-width="1" stroke-dasharray="3 5"><path d="M 50 100 H 297" /><path d="M 50 183 H 297" /></g>
      <g fill="none" stroke="var(--muted)" stroke-width="1.3"><path d="M 42 266 H 305 M 173 282 V 88" /><path d="M 169 100 H 177 M 169 183 H 177 M 53 262 V 270 M 293 262 V 270" /></g>
      <g font-size="12.5" fill="var(--muted)"><text x="173" y="78" text-anchor="end">output</text><text x="40" y="104" text-anchor="end">1</text><text x="40" y="187" text-anchor="end">0.5</text><text x="40" y="270" text-anchor="end">0</text><text x="53" y="287" text-anchor="middle">−6</text><text x="173" y="287" text-anchor="middle">0</text><text x="293" y="287" text-anchor="middle">6</text><text x="308" y="270" font-style="italic">a</text></g>
      <path d={sigmoidPath} fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" />
      <circle cx="173" cy="183" r="3.5" fill="var(--accent)" />
      <text x="213" y="218" font-size="13">σ(0) = 0.5</text>
      <path d="M 231 204 Q 215 186 181 183" fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#activation-sigmoid-arrow)" />
      <text x="192" y="77" font-size="13">approaches 1</text>
      <path d="M 263 82 Q 279 84 284 97" fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#activation-sigmoid-arrow)" />
      <text x="25" y="326" font-size="13">approaches 0</text>
      <path d="M 94 313 Q 87 287 67 273" fill="none" stroke="var(--muted)" stroke-width="1.2" marker-end="url(#activation-sigmoid-arrow)" />
    </svg>
  </div>
</NoteFigure>

<style>
  .activation-panels { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .activation-panels > svg + svg { border-left: 1px solid var(--line); }
  @container (max-width: 580px) {
    .activation-panels { grid-template-columns: 1fr; }
    .activation-panels > svg { max-width: 390px; margin-inline: auto; }
    .activation-panels > svg + svg { border-left: 0; border-top: 1px solid var(--line); }
  }
</style>
