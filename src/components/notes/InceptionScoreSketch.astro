---
import NoteFigure from './NoteFigure.astro';

const cases = [
  { id: 'same', name: 'Confident, same label', rows: [[1, 0], [1, 0]], marginal: [1, 0], meanNote: 'one label across the set', marginalEntropy: 'H(Y) = 0', score: 'IS = exp(0 − 0) = 1', description: 'Both images receive probabilities A equals one and B equals zero. Their conditional entropy is zero, but their average prediction also concentrates on A. The marginal entropy is zero and the Inception Score is one.' },
  { id: 'varied', name: 'Confident, varied labels', rows: [[1, 0], [0, 1]], marginal: [.5, .5], meanNote: 'labels vary across the set', marginalEntropy: 'H(Y) = ln 2', score: 'IS = exp(ln 2 − 0) = 2', description: 'The first image receives probabilities A equals one and B equals zero; the second receives A equals zero and B equals one. Both predictions have zero entropy. Their average is one half for each label, so the marginal entropy is the natural logarithm of two and the Inception Score is two.' },
];
const barWidth = 152;
const probabilityText = (value: number) => value === .5 ? '½' : String(value);
---

<NoteFigure
  label="Confidence + diversity"
  title="Sharp predictions need variety across images"
  caption="Two equally weighted generated images and a classifier with labels A and B. Solid and hatched bar segments encode the exact probabilities, and arrows show their average. These idealized examples expand the confidence/diversity explanation on pages 15–17."
>
  <div class="inception-panels">
    {cases.map((example) => <div class="inception-panel">
      <h3>{example.name}</h3>
      <svg viewBox="0 0 332 378" role="img" aria-labelledby={`is-${example.id}-title is-${example.id}-desc`}>
        <title id={`is-${example.id}-title`}>{example.name}: conditional versus marginal predictions</title>
        <desc id={`is-${example.id}-desc`}>{example.description}</desc>
        <defs>
          <marker id={`is-${example.id}-arrow`} markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M 1 1 Q 3 4 6 4 M 1 7 Q 3 4 6 4" /></marker>
          <pattern id={`is-${example.id}-hatch`} width="6" height="6" patternUnits="userSpaceOnUse"><path d="M -1 1 L 1 -1 M 0 6 L 6 0 M 5 7 L 7 5" /></pattern>
        </defs>
        <text class="label-key" x="68" y="22">A</text>
        <rect class="class-a key" x="86" y="10" width="22" height="13" />
        <text class="label-key" x="171" y="22">B</text>
        <rect class="class-b key" x="190" y="10" width="22" height="13" fill={`url(#is-${example.id}-hatch)`} />
        <text class="section-label" x="166" y="59" text-anchor="middle">individual predictions p(y | x)</text>
        {example.rows.map((probabilities, row) => <g>
          <text class="sample-label" x="30" y={91 + row * 45}>x{row + 1}</text>
          <rect class="bar-outline" x="74" y={73 + row * 45} width={barWidth} height="25" />
          <rect class="class-a" x="74" y={73 + row * 45} width={barWidth * probabilities[0]} height="25" />
          <rect class="class-b" x={74 + barWidth * probabilities[0]} y={73 + row * 45} width={barWidth * probabilities[1]} height="25" fill={`url(#is-${example.id}-hatch)`} />
          <text class="probability" x="242" y={91 + row * 45}>({probabilityText(probabilities[0])}, {probabilityText(probabilities[1])})</text>
        </g>)}
        <text class="conditional-entropy" x="166" y="172" text-anchor="middle">H(Y | X) = 0 · both confident</text>
        <path class="note-arrow" d="M 308 147 Q 322 192 296 222" marker-end={`url(#is-${example.id}-arrow)`} />
        <text class="annotation" x="174" y="204" text-anchor="middle">average the probabilities</text>
        <text class="sample-label" x="29" y="248">p(y)</text>
        <rect class="bar-outline" x="74" y="229" width={barWidth} height="25" />
        <rect class="class-a" x="74" y="229" width={barWidth * example.marginal[0]} height="25" />
        <rect class="class-b" x={74 + barWidth * example.marginal[0]} y="229" width={barWidth * example.marginal[1]} height="25" fill={`url(#is-${example.id}-hatch)`} />
        <text class="probability" x="242" y="248">({probabilityText(example.marginal[0])}, {probabilityText(example.marginal[1])})</text>
        <text class="annotation" x="166" y="284" text-anchor="middle">{example.meanNote}</text>
        <text class="marginal-entropy" x="166" y="316" text-anchor="middle">{example.marginalEntropy}</text>
        <line class="divider" x1="32" x2="300" y1="331" y2="331" />
        <text class="score" x="166" y="366" text-anchor="middle">{example.score}</text>
      </svg>
    </div>)}
  </div>
</NoteFigure>

<style>
  .inception-panels { display: grid; gap: 1.75rem; }
  .inception-panel { min-width: 0; }
  .inception-panel h3 { margin: 0 0 .75rem; font-family: inherit; font-size: 1rem; font-weight: 500; letter-spacing: 0; text-align: center; }
  svg { display: block; width: 100%; max-width: 390px; margin-inline: auto; }
  text { fill: var(--ink); font-family: inherit; }
  .label-key, .sample-label { font-size: 16px; }
  .section-label { font-size: 16px; }
  .probability { font-size: 15px; }
  .class-a { fill: var(--accent); }
  .class-b { stroke: var(--ink); stroke-width: 1; }
  pattern path { fill: none; stroke: var(--ink); stroke-width: 1; }
  .bar-outline { fill: none; stroke: var(--line); stroke-width: 1.2; }
  .key { stroke-width: 1; }
  .conditional-entropy { font-size: 16px; }
  .annotation { fill: var(--muted); font-size: 15px; font-style: italic; }
  .marginal-entropy { font-size: 19px; }
  .score { fill: var(--accent); font-size: 19px; }
  .divider { stroke: var(--line); }
  .note-arrow, marker path { fill: none; stroke: var(--ink); stroke-width: 1.3; stroke-linecap: round; }
  :global(.prose .inception-example-table) { max-width: 100%; overflow-x: auto; }
  :global(.inception-example-table table) { min-width: 680px; }
  :global(.inception-example-table:focus-visible) { outline: 2px solid var(--accent); outline-offset: 4px; }
  @container (min-width: 640px) { .inception-panels { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }
</style>
