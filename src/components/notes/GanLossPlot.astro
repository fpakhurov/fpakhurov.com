---
import NoteFigure from './NoteFigure.astro';

const sigmoid = (a: number) => 1 / (1 + Math.exp(-a));
const panels = [
  { id: 'gan-loss-value', title: 'Per-sample loss', mode: 'value', min: -6.5, max: 6.5, ticks: [-6, -3, 0, 3, 6] },
  { id: 'gan-loss-derivative', title: 'Derivative with respect to a', mode: 'derivative', min: -1.08, max: .08, ticks: [-1, -.5, 0] },
];
const plot = { left: 51, right: 305, top: 79, bottom: 290 };
const x = (a: number) => plot.left + (a + 6) / 12 * (plot.right - plot.left);
const y = (v: number, panel: typeof panels[number]) => plot.bottom - (v - panel.min) / (panel.max - panel.min) * (plot.bottom - plot.top);
const value = (a: number, mode: string, nonSaturating: boolean) => mode === 'value'
  ? (nonSaturating ? Math.log1p(Math.exp(-a)) : -Math.log1p(Math.exp(a)))
  : (nonSaturating ? sigmoid(a) - 1 : -sigmoid(a));
const curve = (panel: typeof panels[number], nonSaturating: boolean) => Array.from({ length: 145 }, (_, i) => {
  const a = -6 + i / 12;
  return `${i === 0 ? 'M' : 'L'} ${x(a).toFixed(2)} ${y(value(a, panel.mode, nonSaturating), panel).toFixed(2)}`;
}).join(' ');
---

<NoteFigure
  label="Loss and gradient"
  title="A confident rejection gives different generator gradients"
  caption="Exact functions of the discriminator logit a, where q = σ(a). The minimax loss is ln(1 − q); the non-saturating loss is −ln q. The shaded region has q below about 0.12. Its minimax derivative is small, whereas the non-saturating derivative is close to −1. Both losses are minimized by increasing a. These are logit derivatives, not complete generator parameter gradients."
>
  <div class="gan-loss-legend" aria-hidden="true">
    <span><i class="minimax-key"></i>Minimax</span>
    <span><i class="non-saturating-key"></i>Non-saturating</span>
  </div>
  <div class="gan-loss-panels">
    {panels.map((panel) => (
      <svg viewBox="0 0 345 390" role="img" aria-labelledby={`${panel.id}-title ${panel.id}-desc`}>
        <title id={`${panel.id}-title`}>{panel.title}</title>
        <desc id={`${panel.id}-desc`}>{panel.mode === 'value'
          ? 'The minimax loss minus log one plus exp a decreases from nearly zero at logit minus six to about minus six at logit six. The non-saturating loss log one plus exp minus a decreases from about six to nearly zero. Logits below minus two are shaded to indicate confident rejection of generated samples.'
          : 'The minimax derivative minus sigmoid a is nearly zero for negative logits and approaches minus one for positive logits. The non-saturating derivative sigmoid a minus one is near minus one for negative logits and approaches zero for positive logits. Both derivatives equal minus one half at logit zero.'}</desc>
        <defs>
          <marker id={`${panel.id}-arrow`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M 1 1 L 8 5 L 1 9" class="annotation-head" /></marker>
        </defs>
        <text x="172" y="21" text-anchor="middle" class="panel-title">{panel.title}</text>
        <text x="172" y="45" text-anchor="middle" class="muted">{panel.mode === 'value' ? 'ln(1 − σ(a)) and −ln σ(a)' : '−q and q − 1'}</text>
        <rect x={plot.left} y={plot.top} width={x(-2) - plot.left} height={plot.bottom - plot.top} class="rejection-region" />
        {panel.ticks.map((tick) => (
          <g>
            <path d={`M ${plot.left} ${y(tick, panel)} H ${plot.right}`} class="grid" />
            <text x="43" y={y(tick, panel) + 4} text-anchor="end" class="tick-label">{tick === -.5 ? '−0.5' : tick < 0 ? `−${-tick}` : tick}</text>
          </g>
        ))}
        <path d={`M ${plot.left} ${plot.top} V ${plot.bottom} H ${plot.right}`} class="axis" />
        <path d={`M ${x(0)} ${plot.top} V ${plot.bottom}`} class="zero-logit" />
        {[-6, -3, 0, 3, 6].map((tick) => (
          <g>
            <path d={`M ${x(tick)} ${plot.bottom} v 5`} class="axis" />
            <text x={x(tick)} y="313" text-anchor="middle" class="tick-label">{tick < 0 ? `−${-tick}` : tick}</text>
          </g>
        ))}
        <path d={curve(panel, false)} class="minimax" />
        <path d={curve(panel, true)} class="non-saturating" />
        <text x="178" y="338" text-anchor="middle" class="axis-label">Discriminator logit a</text>
        <path d="M 126 359 H 231" class="annotation" marker-end={`url(#${panel.id}-arrow)`} />
        <text x="178" y="383" text-anchor="middle" class="annotation-label">Gradient descent increases a</text>
        {panel.mode === 'derivative' && (
          <g>
            <text x="65" y="70" class="annotation-label">q ≈ 0: weak minimax signal</text>
            <path d={`M 114 73 L ${x(-4)} ${y(-sigmoid(-4), panel) - 4}`} class="annotation" marker-end={`url(#${panel.id}-arrow)`} />
          </g>
        )}
      </svg>
    ))}
  </div>
</NoteFigure>

<style>
  .gan-loss-legend { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; margin-bottom: 1rem; color: var(--muted); font-size: .8rem; }
  .gan-loss-legend span { display: inline-flex; align-items: center; gap: .5rem; }
  .gan-loss-legend i { width: 1.3rem; border-top: 1.6px solid var(--ink); }
  .gan-loss-legend .non-saturating-key { border-color: var(--accent); border-top-style: dashed; }
  .gan-loss-panels { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  svg { display: block; max-width: 390px; height: auto; width: 100%; margin-inline: auto; }
  text { fill: var(--ink); font-size: 14px; }
  .panel-title { font-size: 15px; font-weight: 600; }
  .muted, .tick-label { fill: var(--muted); font-size: 13px; }
  .rejection-region { fill: var(--accent); opacity: .055; }
  .grid { stroke: var(--line); stroke-width: .7; fill: none; }
  .axis, .zero-logit { stroke: var(--muted); stroke-width: 1; fill: none; }
  .zero-logit { stroke-dasharray: 3 4; opacity: .5; }
  .minimax { stroke: var(--ink); stroke-width: 1.8; fill: none; }
  .non-saturating { stroke: var(--accent); stroke-width: 1.8; stroke-dasharray: 5 4; fill: none; }
  .annotation, .annotation-head { fill: none; stroke: var(--accent); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .annotation-label { fill: var(--accent); font-size: 13px; }
  .axis-label { font-size: 14px; }
  @container (max-width: 580px) { .gan-loss-panels { grid-template-columns: 1fr; gap: 2rem; } }
</style>
