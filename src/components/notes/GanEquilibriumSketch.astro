---
import NoteFigure from './NoteFigure.astro';

const normal = (x: number, mean: number, sd: number) => Math.exp(-.5 * ((x - mean) / sd) ** 2) / (sd * Math.sqrt(2 * Math.PI));
// Every density below is normalized on the real line. This is a constructed
// sequence, not the result of running GAN optimization.
const data = (x: number) => .65 * normal(x, -1.2, .65) + .35 * normal(x, 1, .5);
const initialGenerator = (x: number) => normal(x, 1.5, .7);
const shiftedGenerator = (x: number) => normal(x, .45, .9);
const initialDiscriminator = (x: number) => Math.min(.96, Math.max(.04, .5 - .09 * x + .06 * Math.sin(5 * x)));
const optimalDiscriminator = (x: number) => data(x) / (data(x) + initialGenerator(x));
const panels = [
  { id: 'gan-equilibrium-initial', title: '1. Initial state', subtitle: 'Different densities; illustrative D', generated: initialGenerator, discriminator: initialDiscriminator, footer: 'D has not yet fitted these samples.' },
  { id: 'gan-equilibrium-fit-d', title: '2. Optimize D for fixed G', subtitle: 'D*(x) = p_data / (p_data + p_g)', generated: initialGenerator, discriminator: optimalDiscriminator, footer: 'D is high where real data dominates.' },
  { id: 'gan-equilibrium-shift-g', title: '3. Move G; hold D fixed', subtitle: 'Generated density shifts left', generated: shiftedGenerator, discriminator: optimalDiscriminator, footer: 'The plotted D is unchanged from panel 2.' },
  { id: 'gan-equilibrium-match', title: '4. Ideal agreement', subtitle: 'p_g = p_data; D*(x) = ½', generated: data, discriminator: () => .5, footer: 'Neither source is distinguishable by x.' },
];
const graph = { left: 41, right: 294, top: 94, bottom: 279 };
const px = (x: number) => graph.left + (x + 4) / 8 * (graph.right - graph.left);
const py = (value: number, probability: boolean) => graph.bottom - value / (probability ? 1 : .6) * (graph.bottom - graph.top);
const path = (fn: (x: number) => number, probability = false) => Array.from({ length: 161 }, (_, i) => {
  const x = -4 + i / 20;
  return `${i === 0 ? 'M' : 'L'} ${px(x).toFixed(2)} ${py(fn(x), probability).toFixed(2)}`;
}).join(' ');
---

<NoteFigure
  label="Training sketch"
  title="The optimal discriminator changes when the generator changes"
  caption="An illustrative reconstruction of the four stages on page 24. Black and dashed blue curves are normalized Gaussian densities, read on the left axis; the dotted brown curve is D(x), read on the right axis. Panel 3 holds panel 2's discriminator fixed while shifting the generator. Panel 4 depicts the ideal equilibrium, not a claim that this sequence or neural-network training converges to it."
>
  <div class="gan-equilibrium-legend" aria-hidden="true">
    <span><i class="data-key"></i>p_data · density</span>
    <span><i class="generated-key"></i>p_g · density</span>
    <span><i class="discriminator-key"></i>D(x) · probability</span>
  </div>
  <div class="gan-equilibrium-panels">
    {panels.map((panel, index) => (
      <svg viewBox="0 0 342 363" role="img" aria-labelledby={`${panel.id}-title ${panel.id}-desc`}>
        <title id={`${panel.id}-title`}>{panel.title}</title>
        <desc id={`${panel.id}-desc`}>{[
          'The real density is a mixture of two Gaussian peaks. The generated density is a Gaussian centered farther to the right. An illustrative initial discriminator varies independently of the exact density ratio. Density uses the left vertical scale from zero to 0.6; probability uses the right vertical scale from zero to one.',
          'The real and generated densities are unchanged. The discriminator is now the exact real density divided by the sum of real and generated densities. It is high in the left mode and low where generated samples dominate. The discriminator uses the right probability axis.',
          'The generated Gaussian shifts left and broadens. The real density is unchanged and the discriminator remains exactly the one fitted in the preceding panel. It is not the optimum for this new generator. The plot is an illustrative generator step, not an optimization experiment.',
          'The generated density equals the real two-component Gaussian mixture. The optimal discriminator is a horizontal line at probability one half on the right axis. Matching density curves use the left axis. This is the ideal equilibrium of the original GAN game.',
        ][index]}</desc>
        <defs>
          <marker id={`${panel.id}-arrow`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M 1 1 L 8 5 L 1 9" class="annotation-head" /></marker>
        </defs>
        <text x="171" y="21" text-anchor="middle" class="panel-title">{panel.title}</text>
        <text x="171" y="46" text-anchor="middle" class="muted">{panel.subtitle}</text>
        <text x="41" y="77" class="axis-label">Density</text>
        <text x="294" y="77" text-anchor="end" class="probability-label">P(real)</text>
        {[0, .3, .6].map((tick) => (
          <g>
            <path d={`M ${graph.left} ${py(tick, false)} H ${graph.right}`} class="grid" />
            <text x="33" y={py(tick, false) + 4} text-anchor="end" class="tick-label">{tick.toFixed(1)}</text>
          </g>
        ))}
        {[0, .5, 1].map((tick) => (
          <g>
            <path d={`M ${graph.right} ${py(tick, true)} h 4`} class="probability-axis" />
            <text x="304" y={py(tick, true) + 4} class="probability-label">{tick === .5 ? '½' : tick}</text>
          </g>
        ))}
        <path d={`M ${graph.left} ${graph.top} V ${graph.bottom} H ${graph.right}`} class="axis" />
        <path d={`M ${graph.right} ${graph.top} V ${graph.bottom}`} class="probability-axis" />
        {[-4, -2, 0, 2, 4].map((tick) => (
          <g>
            <path d={`M ${px(tick)} ${graph.bottom} v 4`} class="axis" />
            <text x={px(tick)} y="301" text-anchor="middle" class="tick-label">{tick < 0 ? `−${-tick}` : tick}</text>
          </g>
        ))}
        <path d={path(data)} class="real-density" />
        <path d={path(panel.generated)} class="generated-density" />
        <path d={path(panel.discriminator, true)} class="discriminator" />
        {index === 2 && (
          <g>
            <path d={`M ${px(1.5)} 267 H ${px(.45)}`} class="annotation" marker-end={`url(#${panel.id}-arrow)`} />
            <text x={px(2.25)} y="259" class="annotation-label">shift G</text>
          </g>
        )}
        <text x="171" y="323" text-anchor="middle" class="axis-label">Data-space coordinate x</text>
        <text x="171" y="352" text-anchor="middle" class="footer">{panel.footer}</text>
      </svg>
    ))}
  </div>
</NoteFigure>

<style>
  .gan-equilibrium-legend, .gan-equilibrium-panels { --gan-probability: #9a541f; }
  .gan-equilibrium-legend { display: flex; flex-wrap: wrap; gap: .5rem 1.2rem; margin-bottom: 1rem; color: var(--muted); font-size: .8rem; }
  .gan-equilibrium-legend span { display: inline-flex; align-items: center; gap: .45rem; }
  .gan-equilibrium-legend i { width: 1.3rem; border-top: 1.6px solid var(--ink); }
  .gan-equilibrium-legend .generated-key { border-color: var(--accent); border-top-style: dashed; }
  .gan-equilibrium-legend .discriminator-key { border-color: var(--gan-probability); border-top-style: dotted; }
  .gan-equilibrium-panels { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  svg { display: block; width: 100%; max-width: 390px; height: auto; margin-inline: auto; }
  text { fill: var(--ink); font-size: 14px; }
  .panel-title { font-size: 15px; font-weight: 600; }
  .muted, .tick-label { fill: var(--muted); font-size: 12px; }
  .axis-label { font-size: 13px; }
  .probability-label { fill: var(--gan-probability); font-size: 13px; }
  .grid { fill: none; stroke: var(--line); stroke-width: .7; }
  .axis { fill: none; stroke: var(--muted); stroke-width: 1; }
  .probability-axis { fill: none; stroke: var(--gan-probability); stroke-width: 1; opacity: .65; }
  .real-density { fill: none; stroke: var(--ink); stroke-width: 1.8; }
  .generated-density { fill: none; stroke: var(--accent); stroke-width: 1.8; stroke-dasharray: 5 4; }
  .discriminator { fill: none; stroke: var(--gan-probability); stroke-width: 1.8; stroke-dasharray: 1 4; stroke-linecap: round; }
  .annotation, .annotation-head { fill: none; stroke: var(--accent); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .annotation-label { fill: var(--accent); font-size: 12px; }
  .footer { fill: var(--muted); font-size: 12px; }
  @media (prefers-color-scheme: dark) { .gan-equilibrium-legend, .gan-equilibrium-panels { --gan-probability: #e5a777; } }
  @container (max-width: 580px) { .gan-equilibrium-panels { grid-template-columns: 1fr; gap: 2rem; } }
</style>
