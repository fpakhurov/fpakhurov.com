---
import NoteFigure from './NoteFigure.astro';

const stages = [
  { id: 'gaussian-sampling-noise', heading: '01 · Draw independent noise', name: 'Z', formula: 'Z ∼ N(0, I)', annotation: 'Spherical covariance', description: 'Independent standard-normal coordinates form a circular cloud around zero.' },
  { id: 'gaussian-sampling-transform', heading: '02 · Multiply by A', name: 'AZ', formula: 'Cov(AZ) = AAᵀ = Σ', annotation: 'A sets the shape', description: 'A linear transformation changes the circular cloud into a correlated, elliptical cloud. Its mean stays zero, and its covariance becomes A A transpose.' },
  { id: 'gaussian-sampling-shift', heading: '03 · Add the mean μ', name: 'X = μ + AZ', formula: 'X ∼ N(μ, Σ)', annotation: 'μ moves the center', description: 'Adding the mean vector translates the correlated cloud from zero to mu without changing its shape or covariance.' },
];
---

<NoteFigure
  label="Sampling sketch"
  title="From independent noise to a correlated Gaussian"
  caption="A two-dimensional sketch of X = μ + AZ, with AAᵀ = Σ. The clouds and the displacement by μ are schematic: no numerical mean or matrix factor is assumed. A controls the covariance; adding μ changes only the mean. Redrawn from the transformation on pages 3–4."
>
  <div class="sampling-stages">
    {stages.map((stage, index) => (
      <div class="sampling-stage">
        <p class="stage-heading">{stage.heading}</p>
        <svg viewBox="0 0 240 266" role="img" aria-labelledby={`${stage.id}-title ${stage.id}-desc`}>
          <title id={`${stage.id}-title`}>{stage.name}: {stage.annotation}</title>
          <desc id={`${stage.id}-desc`}>{stage.description} {stage.formula}.</desc>
          <defs>
            <marker id={`${stage.id}-arrow`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
              <path d="M 1 1 L 8 5 L 1 9" class="arrowhead" />
            </marker>
            <marker id={`${stage.id}-annotation`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
              <path d="M 1 1 L 8 5 L 1 9" class="annotation-head" />
            </marker>
          </defs>
          <text x="120" y="26" text-anchor="middle" class="variable">{stage.name}</text>
          <g class="axis" marker-end={`url(#${stage.id}-arrow)`}>
            <path d="M 26 151 L 217 151" />
            <path d="M 80 183 L 80 39" />
          </g>
          {index === 0 ? (
            <g class="cloud">
              <circle cx="80" cy="151" r="24" />
              <circle cx="80" cy="151" r="49" />
            </g>
          ) : (
            <g class="cloud" transform={index === 2 ? 'translate(54 -48)' : undefined}>
              <ellipse cx="80" cy="151" rx="32" ry="16" transform="rotate(-35 80 151)" />
              <ellipse cx="80" cy="151" rx="63" ry="32" transform="rotate(-35 80 151)" />
            </g>
          )}
          {index === 2 ? (
            <g>
              <path d="M 80 151 L 134 103" class="annotation" marker-end={`url(#${stage.id}-annotation)`} />
              <circle cx="134" cy="103" r="2.6" class="mean-point" />
              <text x="117" y="137" class="mean-label">μ</text>
              <text x="143" y="107" class="mean-label">mean</text>
            </g>
          ) : <circle cx="80" cy="151" r="2.6" class="mean-point" />}
          <text x="68" y="169" class="zero-label">0</text>
          <path
            d={index === 0 ? 'M 177 196 C 182 161, 155 132, 130 124' : index === 1 ? 'M 177 195 C 200 159, 170 119, 124 99' : 'M 174 195 C 195 159, 176 132, 140 113'}
            class="annotation"
            marker-end={`url(#${stage.id}-annotation)`}
          />
          <text x="120" y="221" text-anchor="middle" class="annotation-label">{stage.annotation}</text>
          <text x="120" y="250" text-anchor="middle" class="formula">{stage.formula}</text>
        </svg>
        {index < 2 && <span class="step-arrow" aria-hidden="true">→</span>}
      </div>
    ))}
  </div>
</NoteFigure>

<style>
  .sampling-stages { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .sampling-stage { position: relative; min-width: 0; }
  .stage-heading { margin: 0 0 .5rem; font-family: var(--mono); font-size: .68rem; line-height: 1.5; color: var(--muted); }
  svg { display: block; width: 100%; max-width: 280px; height: auto; margin-inline: auto; overflow: visible; }
  text { fill: var(--ink); font-family: var(--sans); font-size: 15px; }
  .variable { font-family: var(--serif); font-size: 21px; font-style: italic; }
  .formula { font-size: 14px; }
  .zero-label { fill: var(--muted); font-size: 13px; }
  .mean-label { fill: var(--accent); font-size: 14px; }
  .axis, .arrowhead { fill: none; stroke: var(--muted); stroke-width: 1.1; }
  .cloud { fill: none; stroke: var(--ink); stroke-width: 1.3; }
  .mean-point { fill: var(--accent); }
  .annotation, .annotation-head { fill: none; stroke: var(--accent); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .annotation-label { fill: var(--accent); }
  .step-arrow { position: absolute; top: 45%; right: -1rem; color: var(--accent); font-size: 1.3rem; line-height: 1; }
  @container (max-width: 660px) {
    .sampling-stages { grid-template-columns: 1fr; gap: 2.5rem; }
    .stage-heading { text-align: center; font-size: .72rem; }
    .step-arrow { top: auto; bottom: -1.8rem; right: 50%; transform: translateX(50%) rotate(90deg); }
  }
</style>
