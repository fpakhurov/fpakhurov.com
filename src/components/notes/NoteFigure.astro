---
interface Props {
  label?: string;
  title: string;
  caption: string;
}

const { label = 'Sketch', title, caption } = Astro.props;
const id = `figure-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
---

<figure class="note-figure" id={id}>
  <div class="note-figure-header">
    <span class="note-figure-label">{label}</span>
    <p class="note-figure-title">{title}</p>
  </div>
  <div class="note-figure-body"><slot /></div>
  <figcaption>{caption}</figcaption>
</figure>
