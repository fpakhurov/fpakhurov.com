---
import NoteFigure from './NoteFigure.astro';
const panels = [
  { key: 'clean', title: 'Original data', abar: 1, variance: '0.25', mean: '±2' },
  { key: 'middle', title: 'Partly noised', abar: 0.35, variance: '0.7375', mean: '±1.183' },
  { key: 'late', title: 'Near Gaussian noise', abar: 0.005, variance: '0.99625', mean: '±0.141' },
];
const normal = (x: number, mean: number, variance: number) =>
  Math.exp(-((x - mean) ** 2) / (2 * variance)) / Math.sqrt(2 * Math.PI * variance);
const curve = (abar: number | null) => Array.from({ length: 201 }, (_, i) => {
  const x = -4 + i * 8 / 200;
  const variance = abar === null ? 1 : 1 - 0.75 * abar;
  const mean = abar === null ? 0 : 2 * Math.sqrt(abar);
  const density = abar === null ? normal(x, 0, 1) : 0.5 * normal(x, -mean, variance) + 0.5 * normal(x, mean, variance);
  return (i === 0 ? 'M ' : 'L ') + (34 + (x + 4) * 29).toFixed(2) + ' ' + (224 - density * 390).toFixed(2);
}).join(' ');
---

<NoteFigure
  label="Exact density sketch"
  title="Structure fades as the accumulated signal shrinks"
  caption="The three density sketches redraw page 40 with an exact one-dimensional example: equal-weight Gaussians centered at −2 and +2, each with variance 0.25. At a chosen α̅, each component has mean ±2√α̅ and variance 1 − 0.75α̅. Blue curves show the complete noisy data marginal; the dashed curve is N(0,1). These α̅ values are illustrative noise levels, not the seminar notebook's configured schedule or measured samples. Printed component means are rounded; every panel uses the same axes."
>
  <div class="density-panels">
    {panels.map((panel) => (
      <svg viewBox="0 0 300 340" role="img" aria-labelledby={'ddpm-density-' + panel.key + '-title ddpm-density-' + panel.key + '-desc'}>
        <title id={'ddpm-density-' + panel.key + '-title'}>{panel.title}</title>
        <desc id={'ddpm-density-' + panel.key + '-desc'}>An equal-weight mixture of two Gaussian components, with accumulated signal factor {panel.abar}, component means {panel.mean} and component variance {panel.variance}. A dashed standard-normal reference uses the same axes. The mixture progressively approaches that reference as the accumulated signal tends to zero.</desc>
        <text x="150" y="25" text-anchor="middle" class="heading">{panel.title}</text>
        <text x="150" y="50" text-anchor="middle" class="accent">α̅ = {panel.abar}</text>
        <path d="M 34 68 V 224 H 266" class="axis" />
        {[0.2, 0.4].map((tick) => (
          <g>
            <path d={'M 30 ' + (224 - tick * 390) + ' H 266'} class="grid" />
            <text x="25" y={228 - tick * 390} text-anchor="end" class="tick">{tick}</text>
          </g>
        ))}
        <path d={curve(null)} class="reference" />
        <path d={curve(panel.abar)} class="density" />
        {[-4, -2, 0, 2, 4].map((tick) => (
          <g>
            <path d={'M ' + (34 + (tick + 4) * 29) + ' 224 v 5'} class="axis" />
            <text x={34 + (tick + 4) * 29} y="247" text-anchor="middle" class="tick">{tick}</text>
          </g>
        ))}
        <text x="34" y="61" text-anchor="middle" class="tick">p</text>
        <text x="277" y="228" class="tick">x</text>
        <text x="150" y="282" text-anchor="middle" class="muted">Component means: {panel.mean}</text>
        <text x="150" y="307" text-anchor="middle" class="muted">Component variance: {panel.variance}</text>
        <text x="150" y="333" text-anchor="middle" class="accent">{panel.key === 'clean' ? 'Two distinct modes' : panel.key === 'middle' ? 'Contract + smooth' : 'Small residual signal remains'}</text>
      </svg>
    ))}
  </div>
  <div class="density-legend">
    <span><i class="mixture-key"></i>Noisy data marginal</span>
    <span><i class="reference-key"></i>Standard-normal reference</span>
  </div>
</NoteFigure>

<style>
  .density-panels { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; }
  svg { display: block; width: 100%; height: auto; }
  text { fill: var(--ink); font-family: var(--sans); font-size: 16px; }
  .heading { font-weight: 600; font-size: 16px; }
  .accent { fill: var(--accent); font-size: 14px; }
  .muted { fill: var(--muted); font-size: 14px; }
  .tick { fill: var(--muted); font-size: 13px; }
  .axis { fill: none; stroke: var(--muted); stroke-width: 1; }
  .grid { fill: none; stroke: var(--line); stroke-width: .8; }
  .density { fill: none; stroke: var(--accent); stroke-width: 2; }
  .reference { fill: none; stroke: var(--muted); stroke-width: 1.4; stroke-dasharray: 4 4; }
  .density-legend { display: flex; flex-wrap: wrap; gap: .6rem 1.5rem; justify-content: center; margin-top: 1rem; color: var(--muted); font-size: .8rem; }
  .density-legend span { display: inline-flex; align-items: center; gap: .5rem; }
  .density-legend i { display: inline-block; width: 24px; border-top: 2px solid var(--accent); }
  .density-legend .reference-key { border-color: var(--muted); border-top-style: dashed; }
  @container (max-width: 580px) { .density-panels { grid-template-columns: 1fr; gap: 1.5rem; } svg { max-width: 340px; margin-inline: auto; } }
</style>
