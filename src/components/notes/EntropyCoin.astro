---
import NoteFigure from './NoteFigure.astro';

const coins = [
  { id: 'fair', name: 'Fair coin', heads: 5, split: 'P(H) = 0.5 · P(T) = 0.5', terms: '0.5 × 1 + 0.5 × 1', entropy: '1 bit per flip' },
  { id: 'biased', name: 'Biased coin', heads: 9, split: 'P(H) = 0.9 · P(T) = 0.1', terms: '0.9 × 0.152 + 0.1 × 3.322', entropy: '≈ 0.469 bits per flip' },
];
const positions = [[61, 47], [112, 42], [167, 51], [219, 43], [271, 50], [68, 96], [119, 103], [169, 94], [218, 103], [272, 98]];
---

<NoteFigure
  label="Expected surprise"
  title="One rare outcome does not make every flip surprising"
  caption="The notebook's 5/5 and 9/1 symbol sketches, redrawn as heads (○) and tails (×). Ten symbols visualize the probability proportions; a particular sequence of ten flips need not contain these counts."
>
  <div class="coin-panels">
    {coins.map((coin) => <div class="coin-panel">
      <h3>{coin.name}</h3>
      <svg viewBox="0 0 332 330" role="img" aria-labelledby={`entropy-${coin.id}-title entropy-${coin.id}-desc`}>
        <title id={`entropy-${coin.id}-title`}>{coin.name}: probability-weighted surprise</title>
        <desc id={`entropy-${coin.id}-desc`}>{coin.heads === 5 ? 'Five circles for heads and five crosses for tails represent equally likely outcomes. Each outcome carries one bit of surprise, so their weighted average is one bit per flip.' : 'Nine circles for heads and one cross for tails represent probabilities 0.9 and 0.1. Their surprisal values are approximately 0.152 and 3.322 bits. Weighting by probability gives approximately 0.469 bits per flip.'}</desc>
        <defs><marker id={`entropy-${coin.id}-arrow`} markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M 1 1 Q 3 4 6 4 M 1 7 Q 3 4 6 4" /></marker></defs>
        <path class="symbol-box" d="M 29 20 Q 164 16 303 22 L 301 125 Q 167 130 29 126 Z" />
        {positions.map(([cx, cy], index) => index < coin.heads
          ? <circle class="head-symbol" cx={cx} cy={cy} r="8" />
          : <path class="tail-symbol" d={`M ${cx - 7} ${cy - 8} L ${cx + 7} ${cy + 8} M ${cx + 7} ${cy - 8} L ${cx - 7} ${cy + 8}`} />)}
        <text class="counts" x="166" y="154" text-anchor="middle">{coin.heads} heads / {10 - coin.heads} tails</text>
        <text class="probabilities" x="166" y="182" text-anchor="middle">{coin.split}</text>
        <path class="note-arrow" d="M 267 191 Q 299 212 267 235" marker-end={`url(#entropy-${coin.id}-arrow)`} />
        <text class="annotation" x="151" y="216" text-anchor="middle">weight each surprise</text>
        <text class="sum" x="166" y="253" text-anchor="middle">{coin.terms}</text>
        <line class="underline" x1="55" x2="277" y1="269" y2="269" />
        <text class="result" x="166" y="307" text-anchor="middle">{coin.entropy}</text>
      </svg>
    </div>)}
  </div>
</NoteFigure>

<style>
  .coin-panels { display: grid; gap: 1.75rem; }
  .coin-panel { min-width: 0; }
  .coin-panel h3 { margin: 0 0 .3rem; text-align: center; font-family: inherit; font-size: 1rem; font-weight: 500; letter-spacing: 0; }
  svg { display: block; width: 100%; max-width: 390px; margin-inline: auto; }
  text { fill: var(--ink); font-family: inherit; }
  .symbol-box { fill: none; stroke: var(--line); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .head-symbol { fill: none; stroke: var(--ink); stroke-width: 2; }
  .tail-symbol { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linecap: round; }
  .counts { font-size: 18px; }
  .probabilities { font-size: 16px; }
  .annotation { fill: var(--muted); font-size: 16px; font-style: italic; }
  .sum { font-size: 17px; }
  .result { fill: var(--accent); font-size: 21px; }
  .underline { stroke: var(--line); }
  .note-arrow, marker path { fill: none; stroke: var(--ink); stroke-width: 1.3; stroke-linecap: round; }
  @container (min-width: 640px) { .coin-panels { grid-template-columns: 1fr 1fr; gap: 1.25rem; } }
</style>
