---
import NoteFigure from './NoteFigure.astro';

const cx = 144;
const cy = 220;
const sx = 40;
const sz = 35;
const rho = 0.6;
const fixed = (v: number) => v.toFixed(2);
const pathFrom = (points: [number, number][]) => points.map(([x, y], i) => `${i === 0 ? 'M' : 'L'} ${fixed(x)} ${fixed(y)}`).join(' ');
const contours = [0.65, 1.25, 1.8].map((radius) => {
  const points: [number, number][] = Array.from({ length: 97 }, (_, i) => {
    const angle = i * 2 * Math.PI / 96;
    return [cx + sx * radius * Math.cos(angle), cy - sz * radius * (rho * Math.cos(angle) + Math.sqrt(1 - rho * rho) * Math.sin(angle))];
  });
  return `${pathFrom(points)} Z`;
});
const xMarginal = pathFrom(Array.from({ length: 81 }, (_, i): [number, number] => {
  const x = 50 + i * 188 / 80;
  return [x, 105 - 38 * Math.exp(-0.5 * ((x - cx) / sx) ** 2)];
}));
const zMarginal = pathFrom(Array.from({ length: 81 }, (_, i): [number, number] => {
  const y = 130 + i * 180 / 80;
  return [260 + 38 * Math.exp(-0.5 * ((y - cy) / sz) ** 2), y];
}));
---

<NoteFigure
  label="Probability sketch"
  title="Marginalize a joint density; infer a latent distribution"
  caption="Expanded from pages 26–27. The correlated Gaussian on the left is an editorial toy illustrating joint contours and marginal density profiles; it is not an assumption about a trained VAE or a recorded result. On the right, the arrows describe conditional distributions: qφ(z | x) approximates the model's exact posterior pθ(z | x), while pθ(x | z) is the decoder likelihood. These arrows need not be inverse deterministic maps."
>
  <div class="bayes-panels">
    <svg viewBox="0 0 340 425" role="img" aria-labelledby="vae-bayes-joint-title vae-bayes-joint-desc">
      <title id="vae-bayes-joint-title">Joint density contours with two marginal density profiles</title>
      <desc id="vae-bayes-joint-desc">Three tilted contours illustrate a correlated two-dimensional Gaussian joint density p theta of x and z. Integrating out z gives the marginal density of x, shown above. Integrating out x gives the prior density of z, shown to the right. This is an illustrative Gaussian toy, not fitted VAE output.</desc>
      <defs>
        <marker id="vae-bayes-joint-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M 1 1 L 8 5 L 1 9" class="axis-head" />
        </marker>
      </defs>
      <text x="170" y="21" text-anchor="middle" class="heading">Joint density and its marginals</text>
      <text x="144" y="48" text-anchor="middle" class="marginal-label">pθ(x)</text>
      <path d="M 50 105 H 238" class="axis" />
      <path d={xMarginal} class="marginal" />
      <text x="282" y="115" text-anchor="middle" class="marginal-label">p(z)</text>
      <path d="M 260 130 V 310" class="axis" />
      <path d={zMarginal} class="marginal" />
      <g class="axis" marker-end="url(#vae-bayes-joint-arrow)">
        <path d="M 50 310 H 238" />
        <path d="M 50 310 V 130" />
      </g>
      <text x="238" y="332" text-anchor="end" class="symbol">x</text>
      <text x="34" y="142" text-anchor="middle" class="symbol">z</text>
      <text x="144" y="144" text-anchor="middle">pθ(x, z)</text>
      <g class="contours">{contours.map((d) => <path d={d} />)}</g>
      <circle cx={cx} cy={cy} r="2.5" class="center" />
      <text x="170" y="365" text-anchor="middle">Integrate out z → pθ(x)</text>
      <text x="170" y="389" text-anchor="middle">Integrate out x → p(z)</text>
      <text x="170" y="416" text-anchor="middle" class="muted">Gaussian toy; not a VAE assumption</text>
    </svg>

    <svg viewBox="0 0 340 425" role="img" aria-labelledby="vae-bayes-conditional-title vae-bayes-conditional-desc">
      <title id="vae-bayes-conditional-title">Inference and generation connect data and latent spaces</title>
      <desc id="vae-bayes-conditional-desc">An irregular shape represents data space, and concentric latent contours represent a standard Gaussian prior. The inference arrow points from an observation x to its approximate posterior q phi of z given x. The decoder arrow points from z to the conditional distribution p theta of x given z. Approximate inference is distinguished from the exact posterior.</desc>
      <defs>
        <marker id="vae-bayes-inference-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M 1 1 L 8 5 L 1 9" class="inference-head" />
        </marker>
        <marker id="vae-bayes-generation-arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
          <path d="M 1 1 L 8 5 L 1 9" class="generation-head" />
        </marker>
      </defs>
      <text x="170" y="21" text-anchor="middle" class="heading">Two conditional directions</text>
      <text x="170" y="54" text-anchor="middle" class="inference-label">Inference: qφ(z | x)</text>
      <path d="M 123 142 C 156 81, 204 81, 231 142" class="inference" marker-end="url(#vae-bayes-inference-arrow)" />
      <text x="77" y="118" text-anchor="middle">Data space</text>
      <text x="260" y="118" text-anchor="middle">Latent space</text>
      <path d="M 44 149 C 32 134, 57 126, 70 139 C 81 147, 96 127, 110 144 C 124 159, 103 169, 112 184 C 123 202, 96 220, 80 207 C 67 197, 43 217, 35 196 C 28 181, 54 173, 44 149 Z" class="data-region" />
      <g class="prior-contours">
        <circle cx="260" cy="170" r="20" />
        <circle cx="260" cy="170" r="40" />
      </g>
      <circle cx="260" cy="170" r="2.5" class="prior-center" />
      <text x="76" y="247" text-anchor="middle">pθ(x)</text>
      <text x="260" y="247" text-anchor="middle">p(z) = N(0, I)</text>
      <path d="M 232 195 C 198 279, 154 279, 121 195" class="generation" marker-end="url(#vae-bayes-generation-arrow)" />
      <text x="170" y="297" text-anchor="middle">Generation: pθ(x | z)</text>
      <text x="170" y="352" text-anchor="middle" class="muted">qφ(z | x) approximates</text>
      <text x="170" y="376" text-anchor="middle" class="muted">the exact posterior pθ(z | x)</text>
      <text x="170" y="416" text-anchor="middle" class="muted">Arrows describe distributions</text>
    </svg>
  </div>
</NoteFigure>

<style>
  .bayes-panels { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  svg { display: block; width: 100%; max-width: 360px; height: auto; margin-inline: auto; }
  text { fill: var(--ink); font-family: var(--sans); font-size: 14px; }
  .heading { font-size: 15px; font-weight: 600; }
  .symbol { font-size: 17px; font-style: italic; }
  .muted { fill: var(--muted); }
  .marginal-label, .inference-label { fill: var(--accent); }
  .axis, .axis-head { fill: none; stroke: var(--muted); stroke-width: 1.2; }
  .contours, .data-region { fill: none; stroke: var(--ink); stroke-width: 1.5; }
  .center { fill: var(--ink); }
  .marginal, .prior-contours, .inference, .inference-head { fill: none; stroke: var(--accent); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .prior-center { fill: var(--accent); }
  .generation, .generation-head { fill: none; stroke: var(--ink); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  @container (max-width: 660px) { .bayes-panels { grid-template-columns: 1fr; gap: 2rem; } }
</style>
