---
import NoteFigure from './NoteFigure.astro';

// A fixed seed makes the illustrations stable across builds. Box–Muller draws
// standard-normal pairs; the second panel applies a Cholesky factor of Σ.
let state = 4711;
const uniform = () => {
  state ^= state << 13;
  state ^= state >>> 17;
  state ^= state << 5;
  return ((state >>> 0) + 1) / 4294967297;
};
const samples = Array.from({ length: 64 }, () => {
  const radius = Math.sqrt(-2 * Math.log(uniform()));
  const angle = 2 * Math.PI * uniform();
  return [radius * Math.cos(angle), radius * Math.sin(angle)];
});
const center = { x: 160, y: 173 };
const scale = 34;
const panels = [
  { id: 'gaussian-covariance-independent', covariance: 0, title: 'Independent coordinates', subtitle: 'Cov(X₁, X₂) = 0' },
  { id: 'gaussian-covariance-correlated', covariance: 0.5, title: 'Positive covariance', subtitle: 'Cov(X₁, X₂) = 0.5' },
];
---

<NoteFigure
  label="Covariance sketch"
  title="The same variances can hide a different geometry"
  caption="Both Gaussians have mean (0, 0) and unit marginal variances. Only the covariance changes. Dots are simulated samples using the same underlying standard-normal pairs; curves mark Mahalanobis radii 1 and 2. The comparison expands the sketch on page 2."
>
  <div class="covariance-panels">
    {panels.map((panel) => (
      <svg viewBox="0 0 320 355" role="img" aria-labelledby={`${panel.id}-title ${panel.id}-desc`}>
        <title id={`${panel.id}-title`}>{panel.title}</title>
        <desc id={`${panel.id}-desc`}>
          {panel.covariance === 0
            ? 'A zero-mean Gaussian with covariance equal to the identity. Circular density contours and simulated points show independent coordinates, each with variance one.'
            : 'A zero-mean Gaussian with covariance matrix [[1, 0.5], [0.5, 1]]. Elliptical density contours and simulated points tilt along x1 equals x2, showing positive covariance while both marginal variances stay one.'}
        </desc>
        <defs>
          <marker id={`${panel.id}-arrow`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto-start-reverse">
            <path d="M 1 1 L 8 5 L 1 9" class="arrowhead" />
          </marker>
          <marker id={`${panel.id}-annotation`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto">
            <path d="M 1 1 L 8 5 L 1 9" class="annotation-head" />
          </marker>
        </defs>
        <text x="160" y="20" text-anchor="middle" class="panel-title">{panel.title}</text>
        <text x="160" y="42" text-anchor="middle" class="panel-subtitle">{panel.subtitle}</text>

        <g class="axis" marker-end={`url(#${panel.id}-arrow)`}>
          <path d="M 47 173 L 280 173" />
          <path d="M 160 284 L 160 60" />
        </g>
        {[-2, 2].map((tick) => (
          <g>
            <path d={`M ${center.x + tick * scale} 169 L ${center.x + tick * scale} 177`} class="tick" />
            <path d={`M 156 ${center.y - tick * scale} L 164 ${center.y - tick * scale}`} class="tick" />
            <text x={center.x + tick * scale} y="192" text-anchor="middle" class="tick-label">{tick}</text>
            <text x="147" y={center.y - tick * scale + 4} text-anchor="end" class="tick-label">{tick}</text>
          </g>
        ))}
        <text x="149" y="191" text-anchor="end" class="tick-label">0</text>
        <text x="289" y="179" class="axis-label">x₁</text>
        <text x="166" y="62" class="axis-label">x₂</text>

        {panel.covariance === 0 ? (
          <g class="contour">
            <circle cx={center.x} cy={center.y} r={scale} />
            <circle cx={center.x} cy={center.y} r={2 * scale} />
          </g>
        ) : (
          <g>
            <path d="M 83 250 L 237 96" class="principal-direction" />
            <g class="contour" transform={`rotate(-45 ${center.x} ${center.y})`}>
              {[1, 2].map((radius) => (
                <ellipse cx={center.x} cy={center.y} rx={scale * radius * Math.sqrt(1.5)} ry={scale * radius * Math.sqrt(0.5)} />
              ))}
            </g>
          </g>
        )}
        <g class="samples">
          {samples.map(([z1, z2]) => {
            const x1 = z1;
            const x2 = panel.covariance * z1 + Math.sqrt(1 - panel.covariance ** 2) * z2;
            return <circle cx={center.x + scale * x1} cy={center.y - scale * x2} r="2.25" />;
          })}
        </g>

        {panel.covariance === 0 ? (
          <g>
            <path d="M 117 305 C 80 301, 80 270, 105 229" class="annotation" marker-end={`url(#${panel.id}-annotation)`} />
            <text x="160" y="321" text-anchor="middle" class="annotation-label">No preferred direction</text>
            <text x="160" y="342" text-anchor="middle" class="panel-subtitle">Circular contours</text>
          </g>
        ) : (
          <g>
            <path d="M 258 295 C 296 256, 271 176, 224 112" class="annotation" marker-end={`url(#${panel.id}-annotation)`} />
            <text x="160" y="321" text-anchor="middle" class="annotation-label">x₁ and x₂ tend to rise together</text>
            <text x="160" y="342" text-anchor="middle" class="panel-subtitle">Long axis: x₁ = x₂</text>
          </g>
        )}
      </svg>
    ))}
  </div>
</NoteFigure>

<style>
  .covariance-panels { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  svg { display: block; width: 100%; max-width: 360px; height: auto; margin-inline: auto; overflow: visible; }
  text { fill: var(--ink); font-family: var(--sans); font-size: 14px; }
  .panel-title { font-size: 15px; font-weight: 600; }
  .panel-subtitle, .tick-label { fill: var(--muted); font-size: 13px; }
  .axis-label { font-size: 15px; font-style: italic; }
  .axis, .tick, .arrowhead { fill: none; stroke: var(--muted); stroke-width: 1.2; }
  .contour { fill: none; stroke: var(--ink); stroke-width: 1.3; opacity: .7; }
  .principal-direction { fill: none; stroke: var(--muted); stroke-width: 1; stroke-dasharray: 4 5; }
  .samples { fill: var(--accent); opacity: .7; }
  .annotation, .annotation-head { fill: none; stroke: var(--accent); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .annotation-label { fill: var(--accent); }
  @container (max-width: 580px) { .covariance-panels { grid-template-columns: 1fr; gap: 2rem; } }
</style>
