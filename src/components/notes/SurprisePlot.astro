---
import NoteFigure from './NoteFigure.astro';

const x = (p: number) => 58 + 344 * p;
const y = (bits: number) => 296 - 41 * bits;
// Sample in probability space; the first visible point is exactly six bits.
const curve = Array.from({ length: 241 }, (_, i) => {
  const p = 2 ** -6 + (1 - 2 ** -6) * i / 240;
  return `${i === 0 ? 'M' : 'L'} ${x(p).toFixed(3)} ${y(-Math.log2(p)).toFixed(3)}`;
}).join(' ');
const rare = { x: x(0.1), y: y(-Math.log2(0.1)) };
const common = { x: x(0.9), y: y(-Math.log2(0.9)) };
---

<NoteFigure
  label="From probability to information"
  title="Rare outcomes carry more surprise"
  caption="Redrawn from the notebook's surprise curve, with calculated points added. The curve is I(p) = −log₂ p; the zero-probability limit lies beyond the visible vertical scale."
>
  <svg viewBox="0 0 450 405" role="img" aria-labelledby="surprise-plot-title surprise-plot-desc">
    <title id="surprise-plot-title">Surprisal as a function of probability</title>
    <desc id="surprise-plot-desc">The decreasing curve I(p) equals minus log base two of p. At probability 0.1 it gives 3.322 bits, at 0.9 it gives 0.152 bits, and at 1 it gives zero. Surprisal grows without bound as probability approaches zero.</desc>
    <defs>
      <marker id="surprise-axis-arrow" markerWidth="7" markerHeight="7" refX="5" refY="3.5" orient="auto"><path d="M 1 1 L 5 3.5 L 1 6" /></marker>
      <marker id="surprise-note-arrow" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M 1 1 Q 3 4 6 4 M 1 7 Q 3 4 6 4" /></marker>
    </defs>
    {[2, 4, 6].map((bits) => <line class="grid" x1="58" x2="402" y1={y(bits)} y2={y(bits)} />)}
    <path class="axis" d="M 58 296 L 58 37 M 58 296 L 425 296" marker-end="url(#surprise-axis-arrow)" />
    {[0, 2, 4, 6].map((bits) => <g><line class="axis" x1="52" x2="58" y1={y(bits)} y2={y(bits)} /><text class="tick" x="43" y={y(bits) + 6} text-anchor="end">{bits}</text></g>)}
    {[0, 0.5, 1].map((p) => <g><line class="axis" x1={x(p)} x2={x(p)} y1="296" y2="302" /><text class="tick" x={x(p)} y="325" text-anchor="middle">{p}</text></g>)}
    <text class="axis-label" x="16" y="18">Surprise I(p), bits</text>
    <text class="axis-label" x="230" y="350" text-anchor="middle">Probability p</text>
    <path class="curve" d={curve} />
    <path class="guide" d={`M 58 ${rare.y} L ${rare.x} ${rare.y} L ${rare.x} 296`} />
    <circle class="point" cx={rare.x} cy={rare.y} r="4.5" />
    <circle class="point" cx={common.x} cy={common.y} r="4.5" />
    <circle class="point" cx="402" cy="296" r="4.5" />
    <text class="annotation" x="145" y="133">p = 0.1</text>
    <text class="value" x="145" y="157">3.322 bits</text>
    <path class="annotation-arrow" d="M 143 167 Q 120 186 99 166" marker-end="url(#surprise-note-arrow)" />
    <text class="annotation" x="220" y="221">p = 0.9</text>
    <text class="value" x="220" y="245">0.152 bits</text>
    <path class="annotation-arrow" d="M 305 251 Q 336 261 362 283" marker-end="url(#surprise-note-arrow)" />
    <text class="annotation" x="122" y="42">p → 0: I → ∞</text>
    <path class="annotation-arrow" d="M 120 51 Q 95 73 67 58" marker-end="url(#surprise-note-arrow)" />
    <text class="annotation" x="267" y="387">p = 1: zero surprise</text>
    <path class="annotation-arrow" d="M 395 367 Q 428 341 407 304" marker-end="url(#surprise-note-arrow)" />
  </svg>
</NoteFigure>

<style>
  svg { display: block; width: 100%; max-width: 640px; margin-inline: auto; overflow: visible; }
  text { fill: var(--ink); font-family: inherit; }
  .axis, marker path { fill: none; stroke: var(--ink); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .grid { stroke: var(--line); stroke-width: 1; }
  .tick { fill: var(--muted); font-size: 17px; }
  .axis-label { fill: var(--muted); font-size: 17px; }
  .curve { fill: none; stroke: var(--accent); stroke-width: 2.7; stroke-linecap: round; stroke-linejoin: round; }
  .guide { fill: none; stroke: var(--muted); stroke-width: 1; stroke-dasharray: 3 5; }
  .point { fill: var(--accent); stroke: var(--paper); stroke-width: 1.5; }
  .annotation { font-size: 17px; }
  .value { fill: var(--accent); font-size: 18px; }
  .annotation-arrow { fill: none; stroke: var(--ink); stroke-width: 1.3; stroke-linecap: round; }
</style>
