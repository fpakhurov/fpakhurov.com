---
import NoteFigure from './NoteFigure.astro';
const stages = [
  { key: 'batch', title: 'Current batch', desc: 'For one channel, the batch values one, three, and five have mean three and variance eight thirds.' },
  { key: 'normalize', title: 'Center and scale', desc: 'Subtract three and divide by s, where s is the square root of eight thirds plus epsilon. The normalized values are minus two over s, zero, and two over s.' },
  { key: 'affine', title: 'Learn scale and shift', desc: 'A learned gamma and beta transform each normalized value as y equals gamma times x hat plus beta. Evaluation normally uses running statistics rather than current-batch statistics.' },
];
---

<NoteFigure
  label="Batch normalization"
  title="Normalize a channel, then learn its scale and shift"
  caption="Diagram expanding the BatchNorm fragment at the bottom of page 13 and top of page 14, with an exact scalar example added for clarity. Here N = 3 and H = W = 1. For image activations, compute training statistics over N, H, and W independently for each channel. The normalized mean is zero, but its variance is (8/3)/(8/3 + ε), so ε prevents an exact unit-variance claim. The learned affine transform and the usual running-statistics evaluation behavior are implementation context."
>
  <div class="bn-scope">Image activations: <strong>N × C × H × W</strong> → reduce <strong>N, H, W</strong> for each channel.</div>
  <div class="bn-stages">
    {stages.map((stage) => (
      <svg viewBox="0 0 280 365" role="img" aria-labelledby={`bn-${stage.key}-title bn-${stage.key}-desc`}>
        <title id={`bn-${stage.key}-title`}>{stage.title}</title>
        <desc id={`bn-${stage.key}-desc`}>{stage.desc}</desc>
        <defs><marker id={`bn-${stage.key}-head`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M 1 1 L 8 5 L 1 9" class="arrow-head" /></marker></defs>
        <text x="140" y="25" text-anchor="middle" class="stage-title">{stage.title}</text>
        {stage.key === 'batch' ? (
          <g>
            <text x="140" y="60" text-anchor="middle" class="muted">One channel; three examples</text>
            {[1, 3, 5].map((value, i) => <g><circle cx={55 + 85 * i} cy="110" r="24" class="value" /><text x={55 + 85 * i} y="116" text-anchor="middle">{value}</text></g>)}
            <path d="M 55 141 V 159 H 225 V 141 M 140 159 V 196" class="arrow" marker-end="url(#bn-batch-head)" />
            <rect x="25" y="201" width="230" height="117" rx="4" class="box" />
            <text x="140" y="232" text-anchor="middle">μB = (1 + 3 + 5) / 3 = 3</text>
            <text x="140" y="267" text-anchor="middle">σB² = (4 + 0 + 4) / 3</text>
            <text x="140" y="298" text-anchor="middle" class="accent">= 8/3</text>
            <text x="140" y="349" text-anchor="middle" class="muted">Training variance: divide by N</text>
          </g>
        ) : stage.key === 'normalize' ? (
          <g>
            <text x="140" y="61" text-anchor="middle">x̂ = (x − μB) / s</text>
            <text x="140" y="88" text-anchor="middle" class="muted">s = √(8/3 + ε)</text>
            <rect x="35" y="123" width="210" height="54" rx="4" class="box" />
            <text x="140" y="156" text-anchor="middle">[1, 3, 5] − 3</text>
            <path d="M 140 181 V 218" class="arrow" marker-end="url(#bn-normalize-head)" />
            <text x="166" y="205" class="muted">÷ s</text>
            <rect x="35" y="223" width="210" height="54" rx="4" class="accent-box" />
            <text x="140" y="256" text-anchor="middle" class="accent">[−2/s, 0, 2/s]</text>
            <text x="140" y="317" text-anchor="middle">Mean: 0</text>
            <text x="140" y="346" text-anchor="middle" class="muted">Variance: (8/3) / (8/3 + ε)</text>
          </g>
        ) : (
          <g>
            <text x="140" y="61" text-anchor="middle" class="muted">Two learned values per channel</text>
            <rect x="36" y="84" width="87" height="48" rx="4" class="accent-box" /><text x="79.5" y="114" text-anchor="middle" class="accent">γ: scale</text>
            <rect x="157" y="84" width="87" height="48" rx="4" class="accent-box" /><text x="200.5" y="114" text-anchor="middle" class="accent">β: shift</text>
            <path d="M 80 138 V 160 H 200 V 138 M 140 160 V 194" class="arrow" marker-end="url(#bn-affine-head)" />
            <rect x="35" y="199" width="210" height="57" rx="4" class="box" />
            <text x="140" y="234" text-anchor="middle">y = γx̂ + β</text>
            <text x="140" y="298" text-anchor="middle">Same activation shape</text>
            <text x="140" y="329" text-anchor="middle" class="muted">γ and β need not preserve</text>
            <text x="140" y="352" text-anchor="middle" class="muted">zero mean or unit variance.</text>
          </g>
        )}
      </svg>
    ))}
  </div>
  <div class="bn-modes">
    <p><strong>Training</strong><span>Use current-batch statistics; update running estimates.</span></p>
    <p><strong>Evaluation</strong><span>Use running estimates with the usual PyTorch settings.</span></p>
  </div>
</NoteFigure>

<style>
  .bn-scope { margin: 0 0 1.2rem; text-align: center; color: var(--muted); font-size: .95rem; }
  .bn-scope strong { font-weight: 500; color: var(--ink); }
  .bn-stages { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; }
  svg { display: block; width: 100%; height: auto; }
  text { fill: var(--ink); font-family: var(--sans); font-size: 16px; }
  .stage-title { font-weight: 600; }
  .muted { fill: var(--muted); font-size: 15px; }
  .accent { fill: var(--accent); }
  .value, .box { fill: var(--paper); stroke: var(--line); stroke-width: 1.5; }
  .value { stroke: var(--ink); }
  .accent-box { fill: var(--paper); stroke: var(--accent); stroke-width: 1.5; }
  .arrow, .arrow-head { fill: none; stroke: var(--muted); stroke-width: 1.4; stroke-linecap: round; stroke-linejoin: round; }
  .bn-modes { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .bn-modes p { margin: 0; font-size: .95rem; }
  .bn-modes strong, .bn-modes span { display: block; }
  .bn-modes strong { font-weight: 500; color: var(--ink); margin-bottom: .3rem; }
  .bn-modes span { color: var(--muted); }
  @container (max-width: 580px) {
    .bn-stages { grid-template-columns: 1fr; gap: 1.4rem; }
    svg { max-width: 310px; margin-inline: auto; }
    .bn-modes { grid-template-columns: 1fr; gap: 1rem; }
  }
</style>
