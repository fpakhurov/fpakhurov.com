---
import NoteFigure from './NoteFigure.astro';
const chains = [
  { key: 'grow', title: 'w = 2: grow', multiplier: '×2', derivatives: ['2', '4', '8'], accent: true },
  { key: 'shrink', title: 'w = ½: shrink', multiplier: '×½', derivatives: ['½', '¼', '⅛'], accent: false },
];
---

<NoteFigure
  label="Gradient chain"
  title="Repeated derivatives can grow or shrink"
  caption="Redraw of the repeated RNN sketch on page 14, extended with a shrinking case. These are exact scalar examples: hₖ = whₖ₋₁, so ∂hₖ/∂h₀ = wᵏ. The same derivative applies along a strictly positive ReLU path with no activation derivative other than 1. General networks multiply full Jacobians, including activation derivatives; the diagram does not imply that inspecting individual matrix entries is enough to predict gradient behavior."
>
  <div class="gradient-model">At each step: <strong>hₖ = whₖ₋₁</strong> · Through K steps: <strong>∂hK/∂h₀ = wᴷ</strong></div>
  <div class="gradient-chains">
    {chains.map((chain) => (
      <svg viewBox="0 0 360 385" role="img" aria-labelledby={`gradient-${chain.key}-title gradient-${chain.key}-desc`}>
        <title id={`gradient-${chain.key}-title`}>{chain.title}</title>
        <desc id={`gradient-${chain.key}-desc`}>{chain.accent
          ? 'A scalar recurrent chain multiplies its state by two at every step. Derivatives with respect to the initial state are two, four, and eight after one, two, and three steps.'
          : 'A scalar recurrent chain multiplies its state by one half at every step. Derivatives with respect to the initial state are one half, one quarter, and one eighth after one, two, and three steps.'}</desc>
        <defs><marker id={`gradient-${chain.key}-head`} viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M 1 1 L 8 5 L 1 9" class:list={['arrow-head', { accent: chain.accent }]} /></marker></defs>
        <text x="180" y="26" text-anchor="middle" class="panel-title">{chain.title}</text>
        <text x="95" y="61" text-anchor="middle" class="muted">State</text>
        <text x="265" y="61" text-anchor="middle" class="muted">Derivative to h₀</text>
        {[0, 1, 2, 3].map((step) => (
          <g>
            <rect x="45" y={79 + 78 * step} width="100" height="37" rx="3" class="state" />
            <text x="95" y={103 + 78 * step} text-anchor="middle">{['h₀', 'h₁', 'h₂', 'h₃'][step]}</text>
            {step < 3 && <g><path d={`M 95 ${121 + 78 * step} V ${151 + 78 * step}`} class:list={['arrow', { accent: chain.accent }]} marker-end={`url(#gradient-${chain.key}-head)`} /><text x="116" y={141 + 78 * step} class="muted">{chain.multiplier}</text></g>}
            {step > 0 && <g><path d={`M 153 ${98 + 78 * step} H 190`} class="leader" /><text x="264" y={103 + 78 * step} text-anchor="middle" class:list={['derivative', { accent: chain.accent }]}>{`∂${['h₀', 'h₁', 'h₂', 'h₃'][step]}/∂h₀ = ${chain.derivatives[step - 1]}`}</text></g>}
          </g>
        ))}
        <text x="180" y="378" text-anchor="middle" class="muted">{chain.accent ? 'Each step doubles the sensitivity.' : 'Each step halves the sensitivity.'}</text>
      </svg>
    ))}
  </div>
  <p class="gradient-rule">Backpropagation multiplies local derivatives along a path.</p>
</NoteFigure>

<style>
  .gradient-model { color: var(--muted); text-align: center; margin-bottom: 1rem; font-size: .95rem; }
  .gradient-model strong { color: var(--ink); font-weight: 500; white-space: nowrap; }
  .gradient-chains { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
  svg { display: block; width: 100%; height: auto; }
  text { fill: var(--ink); font-family: var(--sans); font-size: 17px; }
  .panel-title { font-weight: 600; }
  .muted { fill: var(--muted); font-size: 15px; }
  .derivative { font-size: 17px; }
  .state { fill: var(--paper); stroke: var(--line); stroke-width: 1.5; }
  .arrow, .arrow-head { fill: none; stroke: var(--ink); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
  .leader { fill: none; stroke: var(--line); stroke-width: 1.5; stroke-dasharray: 3 3; }
  text.accent { fill: var(--accent); }
  path.accent { stroke: var(--accent); }
  .gradient-rule { margin: 1rem 0 0; padding-top: 1rem; border-top: 1px solid var(--line); text-align: center; color: var(--muted); font-size: .95rem; }
  @container (max-width: 580px) {
    .gradient-chains { grid-template-columns: 1fr; gap: 1.4rem; }
    svg { max-width: 360px; margin-inline: auto; }
  }
</style>
