---
import NoteFigure from './NoteFigure.astro';
const kernels = [
  { key: '00', input: 0, output: 0, y: 70, label: 'W₀₀' },
  { key: '01', input: 1, output: 0, y: 150, label: 'W₀₁' },
  { key: '10', input: 0, output: 1, y: 230, label: 'W₁₀' },
  { key: '11', input: 1, output: 1, y: 310, label: 'W₁₁' },
];
---

<NoteFigure
  label="Convolution channels"
  title="Each output channel combines every input channel"
  caption="Diagram expanding the convolution aside on page 15, using two input and two output channels as an illustration. For an ordinary groups = 1 Conv2d, each output channel sums one filtered map from every input channel and adds one learned bias. Each Wⱼ꜀ is a learned kH × kW kernel reused at every spatial position. PyTorch implements cross-correlation, without reversing the kernel; the diagram shows channel connectivity rather than a measured activation map."
>
  <div class="conv-panels">
    <svg viewBox="0 0 430 405" role="img" aria-labelledby="conv-channel-title conv-channel-desc">
      <title id="conv-channel-title">Two inputs feed both output channels</title>
      <desc id="conv-channel-desc">Input channel zero passes through kernels W zero zero and W one zero. Input channel one passes through W zero one and W one one. The first pair is summed with bias b zero for output y zero. The second pair is summed with bias b one for output y one.</desc>
      <defs>
        <marker id="conv-channel-ink-head" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M 1 1 L 8 5 L 1 9" class="ink-arrow" /></marker>
        <marker id="conv-channel-accent-head" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="5" markerHeight="5" orient="auto"><path d="M 1 1 L 8 5 L 1 9" class="accent-arrow" /></marker>
      </defs>
      <text x="215" y="25" text-anchor="middle" class="panel-title">2 input channels → 2 output channels</text>
      <text x="59" y="68" text-anchor="middle" class="muted">Inputs</text>
      <text x="208" y="44" text-anchor="middle" class="muted">Filter each channel</text>
      {[0, 1].map((input) => <g><rect x="29" y={109 + 160 * input} width="60" height="42" rx="3" class:list={['channel', { 'accent-channel': input === 1 }]} /><text x="59" y={136 + 160 * input} text-anchor="middle" class:list={{ accent: input === 1 }}>{['x₀', 'x₁'][input]}</text></g>)}
      {kernels.map((kernel) => (
        <g>
          <path d={`M 95 ${130 + 160 * kernel.input} C 121 ${130 + 160 * kernel.input}, 132 ${kernel.y}, 163 ${kernel.y}`} class={kernel.input === 0 ? 'ink-arrow' : 'accent-arrow'} marker-end={`url(#conv-channel-${kernel.input === 0 ? 'ink' : 'accent'}-head)`} />
          <rect x="168" y={kernel.y - 20} width="79" height="40" rx="3" class:list={['kernel', { 'accent-channel': kernel.input === 1 }]} />
          <text x="207.5" y={kernel.y + 6} text-anchor="middle" class:list={{ accent: kernel.input === 1 }}>{kernel.label}</text>
          <path d={`M 253 ${kernel.y} Q 273 ${kernel.y}, 291 ${110 + 160 * kernel.output}`} class={kernel.input === 0 ? 'ink-arrow' : 'accent-arrow'} marker-end={`url(#conv-channel-${kernel.input === 0 ? 'ink' : 'accent'}-head)`} />
        </g>
      ))}
      {[0, 1].map((output) => (
        <g>
          <text x="303" y={63 + 160 * output} text-anchor="middle" class="muted">{['b₀', 'b₁'][output]}</text>
          <path d={`M 303 ${70 + 160 * output} V ${94 + 160 * output}`} class="ink-arrow" marker-end="url(#conv-channel-ink-head)" />
          <circle cx="303" cy={110 + 160 * output} r="14" class="sum" /><text x="303" y={116 + 160 * output} text-anchor="middle">+</text>
          <path d={`M 321 ${110 + 160 * output} H 347`} class="ink-arrow" marker-end="url(#conv-channel-ink-head)" />
          <rect x="352" y={90 + 160 * output} width="55" height="40" rx="3" class="channel" /><text x="379.5" y={116 + 160 * output} text-anchor="middle">{['y₀', 'y₁'][output]}</text>
        </g>
      ))}
      <text x="215" y="375" text-anchor="middle">yⱼ = Σ꜀ (Wⱼ꜀ ⋆ x꜀) + bⱼ</text>
      <text x="215" y="401" text-anchor="middle" class="muted">One bias per output channel</text>
    </svg>
    <svg viewBox="0 0 430 405" role="img" aria-labelledby="conv-tensor-title conv-tensor-desc">
      <title id="conv-tensor-title">The learned kernel tensor has four dimensions</title>
      <desc id="conv-tensor-desc">A two by two arrangement of kernels has output channels as rows and input channels as columns. Each kernel contains kH by kW learned numbers. The same kernel is used at all spatial positions. The complete weight tensor has shape output channels by input channels by kernel height by kernel width.</desc>
      <text x="215" y="25" text-anchor="middle" class="panel-title">A tensor of learned kernels</text>
      <text x="215" y="57" text-anchor="middle">W: Cout × Cin × kH × kW</text>
      <text x="179" y="95" text-anchor="middle" class="muted">input 0</text><text x="295" y="95" text-anchor="middle" class="muted">input 1</text>
      {[0, 1].map((output) => <text x="105" y={151 + 116 * output} text-anchor="end" class="muted">{`output ${output}`}</text>)}
      {kernels.map((kernel) => (
        <g>
          <rect x={143 + 116 * kernel.input} y={111 + 116 * kernel.output} width="72" height="72" class:list={['kernel-grid', { 'accent-channel': kernel.input === 1 }]} />
          {[1, 2].map((offset) => <path d={`M ${143 + 116 * kernel.input + 24 * offset} ${111 + 116 * kernel.output} v 72 M ${143 + 116 * kernel.input} ${111 + 116 * kernel.output + 24 * offset} h 72`} class="grid-lines" />)}
          <rect x={154 + 116 * kernel.input} y={135 + 116 * kernel.output} width="50" height="24" class="kernel-label" />
          <text x={179 + 116 * kernel.input} y={153 + 116 * kernel.output} text-anchor="middle" class:list={{ accent: kernel.input === 1 }}>{kernel.label}</text>
        </g>
      ))}
      <text x="215" y="340" text-anchor="middle" class="muted">Each small grid: kH × kW weights</text>
      <text x="215" y="378" text-anchor="middle">Reuse the same kernel</text>
      <text x="215" y="401" text-anchor="middle" class="muted">at every spatial position.</text>
    </svg>
  </div>
  <div class="conv-settings">
    <p><strong>Learned during training</strong><span>Kernel values W and biases b.</span></p>
    <p><strong>Chosen for this layer</strong><span>Kernel size, stride, padding, dilation, and groups.</span></p>
  </div>
</NoteFigure>

<style>
  .conv-panels { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  svg { display: block; width: 100%; height: auto; }
  text { fill: var(--ink); font-family: var(--sans); font-size: 17px; }
  .panel-title { font-weight: 600; }
  .muted { fill: var(--muted); font-size: 15px; }
  text.accent { fill: var(--accent); }
  .channel, .sum, .kernel, .kernel-grid { fill: var(--paper); stroke: var(--ink); stroke-width: 1.4; }
  .kernel { stroke: var(--line); }
  .accent-channel { stroke: var(--accent); }
  .ink-arrow, .accent-arrow { fill: none; stroke: var(--ink); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .accent-arrow { stroke: var(--accent); }
  .grid-lines { fill: none; stroke: var(--line); stroke-width: 1; }
  .kernel-label { fill: var(--paper); }
  .conv-settings { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--line); }
  .conv-settings p { margin: 0; font-size: .95rem; }
  .conv-settings strong, .conv-settings span { display: block; }
  .conv-settings strong { margin-bottom: .3rem; color: var(--ink); font-weight: 500; }
  .conv-settings span { color: var(--muted); }
  @container (max-width: 580px) {
    .conv-panels { grid-template-columns: 1fr; gap: 1.5rem; }
    .conv-settings { grid-template-columns: 1fr; gap: 1rem; }
    svg { max-width: 430px; margin-inline: auto; }
  }
</style>
