---
import { practiceForNote } from '../utils/biasedPractice';

interface Props { noteId: string; lang: 'en' | 'ru' }
const { noteId, lang } = Astro.props;
const targets = practiceForNote(noteId, lang);
const headingId = `biased-practice-${noteId.replace('/', '-')}`;
const action = lang === 'ru' ? 'Проверить себя в BIASED' : 'Practice on BIASED';
---

{targets.length > 0 && <aside class="biased-practice" aria-labelledby={headingId} data-biased-practice={noteId}>
  <h2 id={headingId}>{lang === 'ru' ? 'Закрепить материал' : 'Put it into practice'}</h2>
  <p>{lang === 'ru' ? 'Вопросы с разбором по этой теме на BIASED.' : 'Questions with explanations on BIASED, matched to this topic.'}</p>
  <ul>
    {targets.map((target) => <li><a href={target.href} aria-label={targets.length === 1 ? `${action}: ${target.title}` : undefined}>
      <span>{targets.length === 1 ? action : target.title}</span>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
    </a></li>)}
  </ul>
</aside>}

<style>
  .biased-practice { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  h2 { margin: 0; font-size: 1.1rem; font-weight: 600; line-height: 1.4; }
  p { margin: .4rem 0 1rem; color: var(--muted); font-size: .9rem; line-height: 1.6; }
  ul { display: grid; gap: .6rem; padding: 0; margin: 0; list-style: none; }
  li { min-width: 0; }
  a { display: flex; align-items: center; justify-content: space-between; gap: .8rem; min-height: 44px; width: fit-content; max-width: 100%; padding: .65rem .9rem; border: 1px solid var(--line); border-radius: var(--radius-small); color: var(--accent); font-size: .9rem; font-weight: 550; line-height: 1.5; text-decoration: none; }
  a:hover { background: var(--paper-strong); border-color: var(--accent); }
  a span { min-width: 0; overflow-wrap: anywhere; }
  svg { flex-shrink: 0; }
</style>
