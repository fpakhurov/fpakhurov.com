source-material/**/*.pdf
source-material/**/*.png
source-material/**/*.jpg
source-material/**/*.jpeg
source-material/**/*.heic
source-material/**/*.mp4
source-material/**/*.m4a

# temporary figure screenshot pages
public/_figs-*
scripts/notes/shots/
