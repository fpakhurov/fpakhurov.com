{
  "name": "fpakhurov.com",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run practice:check && npm run rights:check && astro check && NODE_OPTIONS=--max-old-space-size=4096 astro build && node scripts/check-content-withdrawal.mjs --dist dist",
    "preview": "astro preview",
    "check": "npm run practice:check && astro check",
    "practice:generate": "node scripts/generate-biased-practice.mjs",
    "practice:check": "node scripts/validate-biased-practice.mjs",
    "rights:check": "node scripts/check-content-withdrawal.mjs && node scripts/check-source-rights.mjs",
    "rights:test": "node --test scripts/check-source-rights.test.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.0",
    "@astrojs/markdown-remark": "^7.3.0",
    "@astrojs/sitemap": "^3.5.0",
    "astro": "^7.2.10",
    "katex": "^0.16.22",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "typescript": "^5.9.0"
  }
}
